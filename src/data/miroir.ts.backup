// ==================== SURAH 77: AL-MURSALAT - MISSING VERSES 16-49 ====================

MIROIR["77:16"] = {
  reference: "77:16",
  theme: ["destruction", "précédents", "négation"],
  emotion: "Avertissement, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Halak", "Al-Awwalin"],
  mirrorVersion: `« N'avons-Nous pas fait périr les anciens ? » Le miroir me montre l'histoire des destructions passées. « Alam nuhliki al-awwalin » — n'avons-Nous pas fait périr les anciens ? La question rhétorique. Le miroir m'avertit : les peuples précédents ont été détruits pour leur négation.`,
  reflection: `Les anciens ont péri pour leur négation. L'histoire enseigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam nuhliki al-awwalin » — n'avons-Nous pas fait périr les anciens ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire des anciens ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage de l'histoire protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la mémoire des destructions passées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire est protégé." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire des anciens. Ne permets pas que je l'oublie. Protège-moi de leur sort.`
};

MIROIR["77:17"] = {
  reference: "77:17",
  theme: ["succession", "générations", "continuité"],
  emotion: "Réalité, conséquence",
  difficulty: "débutant",
  relatedNames: ["Al-Akharin", "At-Tawabi"],
  mirrorVersion: `« Puis Nous ferons suivre les derniers. » Le miroir me montre la continuité du châtiment. « Thumma nutbi'uhumu al-akhirin » — puis Nous ferons suivre les derniers. La succession. Le miroir m'avertit : les derniers suivront les premiers dans le châtiment s'ils nient.`,
  reflection: `Les derniers suivront les premiers. La négation a les mêmes conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nutbi'uhumu al-akhirin » — puis Nous ferons suivre les derniers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je ferai partie des suivis ou des suivants ? La foi détermine." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi brise la chaîne de la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit les lois de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi échappe à la succession du châtiment." }
  ],
  munajat: `Ya Rabb, je ne veux pas suivre les négateurs. Donne-moi la foi qui me sauve.`
};

MIROIR["77:18"] = {
  reference: "77:18",
  theme: ["traitement", "coutume", "justice"],
  emotion: "Équité, constance",
  difficulty: "débutant",
  relatedNames: ["As-Sunnah", "Al-Mujrimin"],
  mirrorVersion: `« Ainsi traitons-Nous les criminels. » Le miroir me montre la constance du traitement divin. « Kadhalika naf'al bi-al-mujrimin » — ainsi traitons-Nous les criminels. La règle. Le miroir m'enseigne : Allah est constant dans Sa justice.`,
  reflection: `Le traitement des criminels est constant. La justice divine est équitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika naf'al bi-al-mujrimin » — ainsi traitons-Nous les criminels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je commets des crimes ? Ou est-ce que je m'éloigne du mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement du mal évite le traitement des criminels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit aux lois constantes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite le mal évite le sort des criminels." }
  ],
  munajat: `Ya Rabb, je m'éloigne du mal. Ne permets pas que je sois traité comme les criminels. Sauve-moi par ma foi.`
};

MIROIR["77:19"] = {
