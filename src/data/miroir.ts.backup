    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je renie les bienfaits par mon comportement ? Ou est-ce que je les honore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur des bienfaits est la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ingratitude attire la perte des bienfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore les bienfaits les préserve." }
  ],
  munajat: `Ya Rabb, je veux honorer Tes bienfaits. Ne permets pas que je les renie par mon comportement. Préserve mes bienfaits par ma gratitude.`
};

MIROIR["16:57"] = {
  reference: "16:57",
  theme: ["filles", "attribution", "injustice"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Banat", "Ash-Shirk"],
  mirrorVersion: `« Ils attribuent à Allah des filles, gloire à Lui ! » Le miroir me montre l'injustice de l'attribution. « Wa yaj'aluna li-Allahi al-banati » — ils attribuent à Allah des filles, gloire à Lui ! L'attribution fausse est une insulte. Le miroir m'interroge : est-ce que j'attribue correctement à Allah ?`,
  reflection: `L'attribution fausse est une insulte. Attribuer correctement est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaj'aluna li-Allahi al-banati subhanahu wa lahum ma yashtarun » — ils attribuent à Allah des filles, gloire à Lui ! Et ils ont ce qu'ils désirent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue correctement à Allah ? Ou est-ce que je Le décris mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La description correcte d'Allah est la connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est au-dessus de toute description imparfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui décrit Allah correctement Le connaît vraiment." }
  ],
  munajat: `Ya Subhan, Tu es au-dessus de toute description imparfaite. Ne permets pas que je Te décrive mal. Donne-moi la connaissance correcte de Toi.`
};

MIROIR["16:97"] = {
  reference: "16:97",
  theme: ["bonne œuvre", "vie", "récompense"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["As-Salih", "Al-Hayat"],
  mirrorVersion: `« Quiconque fait une bonne œuvre, homme ou femme, en étant croyant, Nous lui ferons vivre une bonne vie. » Le miroir me montre la promesse d'une bonne vie. « Man 'amila salihan min dhakarin aw untha wa huwa mu'minun » — quiconque fait une bonne œuvre, homme ou femme, en étant croyant. La foi et les œuvres amènent la bonne vie. Le miroir m'interroge : est-ce que ma vie est bonne grâce à ma foi ?`,
  reflection: `La foi et les œuvres amènent la bonne vie. Les cultiver est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man 'amila salihan min dhakarin aw untha wa huwa mu'minun fa-nuhyiyannahu hayatan tayyibatan » — quiconque fait une bonne œuvre, homme ou femme, en étant croyant, Nous lui ferons vivre une bonne vie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie est bonne grâce à ma foi ? Ou est-ce que je manque de foi et d'œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne vie est le fruit de la foi et des œuvres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La bonne vie est promise aux croyants sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi et fait le bien vit vraiment." }
  ],
  munajat: `Ya Rabb, je veux une bonne vie par ma foi et mes œuvres. Ne permets pas que je manque de l'un ou l'autre. Donne-moi la vie bonne que Tu promets.`
};

MIROIR["16:106"] = {
  reference: "16:106",
  theme: ["hypocrisie", "cœur", "colère"],
  emotion: "Mise en garde, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nifaq", "Al-Ghadab"],
  mirrorVersion: `« Quiconque renie Allah après avoir cru, sauf celui qui est contraint et dont le cœur reste ferme dans la foi. » Le miroir me montre le danger de l'hypocrisie. « Man kafara bi-Allahi min ba'di imanihi » — quiconque renie Allah après avoir cru. La foi doit être protégée. Le miroir m'interroge : est-ce que je protège ma foi de tout reniement ?`,
  reflection: `La foi doit être protégée. Ne pas la compromettre est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kafara bi-Allahi min ba'di imanihi illa man ukriha wa qalbuhu mutma'innun bi-al-iman » — quiconque renie Allah après avoir cru, sauf celui qui est contraint et dont le cœur reste ferme dans la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je protège ma foi de tout reniement ? Ou est-ce que je la compromise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection de la foi est le devoir suprême." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est le trésor le plus précieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa foi protège son éternité." }
  ],
  munajat: `Ya Rabb, je protège ma foi de tout reniement. Ne permets pas que je la compromette. Garde mon cœur ferme dans la foi.`
};

MIROIR["16:125"] = {
