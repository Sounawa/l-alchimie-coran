  theme: ["présence", "piété", "compagnie"],
  emotion: "Réconfort, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'iyyah", "Al-Muttaqun"],
  mirrorVersion: `« Allah est avec ceux qui Le craignent et qui font le bien. » Le miroir me montre la compagnie d'Allah. « Inna Allaha ma'a alladhina ittaqaw wa alladhina hum muhsinun » — Allah est avec ceux qui Le craignent et qui font le bien. Sa présence accompagne les pieux. Le miroir m'interroge : est-ce que je sens Sa présence ?`,
  reflection: `Sa présence accompagne les pieux. Être pieux pour la sentir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha ma'a alladhina ittaqaw wa alladhina hum muhsinun » — Allah est avec ceux qui Le craignent et qui font le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sens Sa présence ? Ou est-ce que je me sens seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété attire Sa présence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah accompagne toujours les pieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux n'est jamais seul." }
  ],
  munajat: `Ya Rabb, je veux sentir Ta présence. Ne permets pas que je me sente seul. Accompagne-moi par ma piété.`
};

