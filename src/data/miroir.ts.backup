    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment cherche la protection." }
  ],
  munajat: `Ya Rabb, l'image est terrifiante. Je cherche Ta protection. Épargne-moi ce châtiment.`
};

