    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le repos le trouve au Paradis." }
  ],
  munajat: `Ya Rabb, donne-moi le repos du Paradis. Fais que je sois accoudé sur les lits.`
};

