    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les deux faces est complet." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message complet. Fais que je sois motivé par l'espoir et la crainte. Ne permets pas le déséquilibre.`
};

MIROIR["41:5"] = {
  reference: "41:5",
  theme: ["voiles", "cœurs", "obstruction"],
  emotion: "Réalité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qulub", "Al-Akinnah"],
  mirrorVersion: `« Nos cœurs sont voilés contre ce à quoi tu nous invites. » Le miroir constate : « Qulubuna fi akinnatin » — nos cœurs sont voilés contre ce à quoi tu nous invites. Le voile est sur le cœur. Le miroir m'enseigne : le voile est une conséquence du rejet.`,
  reflection: `Le voile est une conséquence du rejet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulubuna fi akinnatin » — nos cœurs sont voilés contre ce à quoi tu nous invites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels voiles recouvrent mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile du cœur peut être levé par le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur voilé ne peut recevoir la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière pour le lever du voile est essentielle." }
  ],
  munajat: `Ya Rabb, lève les voiles de mon cœur. Fais que je reçoive Ton invitation. Ne permets pas que mon cœur soit voilé.`
};

// ==================== SURAH 42: ASH-SHURA - MISSING ENTRIES ====================

MIROIR["42:3"] = {
  reference: "42:3",
  theme: ["révélation", "puissant", "sage"],
  emotion: "Certitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« C'est ainsi qu'Allah, le Puissant, le Sage, t'inspire. » Le miroir affirme : « Kadhalika yuhi ilayka Allahu al-'aziz al-hakim » — c'est ainsi qu'Allah, le Puissant, le Sage, t'inspire. La révélation vient du Puissant Sage. Le miroir m'enseigne : la révélation est un acte de puissance et de sagesse.`,
  reflection: `La révélation est un acte de puissance et de sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika yuhi ilayka Allahu al-'aziz al-hakim » — c'est ainsi qu'Allah, le Puissant, le Sage, t'inspire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la source de la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance et la sagesse de la révélation garantissent sa perfection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est parfaite dans sa source et son contenu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de la source augmente la confiance." }
  ],
  munajat: `Ya 'Aziz, ya Hakim, merci pour la révélation. Fais que je la reconnaisse comme venant de Toi. Ne permets pas le doute.`
};

MIROIR["42:4"] = {
  reference: "42:4",
  theme: ["trône", "ciel", "grandeur"],
  emotion: "Révérence, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-'Arsh", "Al-Samawat"],
  mirrorVersion: `« À Lui appartient tout ce qui est dans les cieux et sur la terre. » Le miroir proclame : « Lahu ma fi al-samawati wa ma fi al-ard » — à Lui appartient tout ce qui est dans les cieux et sur la terre. La propriété universelle. Le miroir m'enseigne : tout appartient à Allah.`,
  reflection: `Tout appartient à Allah. La propriété universelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu ma fi al-samawati wa ma fi al-ard » — à Lui appartient tout ce qui est dans les cieux et sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que tout ce que j'ai appartient à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la propriété divine change l'usage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est propriété d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la propriété divine libère de l'attachement." }
  ],
  munajat: `Ya Rabb, tout T'appartient. Fais que je gère ce que j'ai comme un gérant fidèle. Ne permets pas l'appropriation.`
};

MIROIR["42:5"] = {
  reference: "42:5",
  theme: ["cieux", "anges", "gloire"],
  emotion: "Émerveillement, louange",
  difficulty: "débutant",
  relatedNames: ["Al-Sama'", "Al-Mala'ikah"],
  mirrorVersion: `« Les cieux sont près de se fendre par en haut. » Le miroir décrit : « Takadu al-samawatu yatafattarna min al-fawqi » — les cieux sont près de se fendre par en haut. La grandeur d'Allah dépasse la création. Le miroir m'enseigne : la création tremble devant la grandeur.`,
  reflection: `La création tremble devant la grandeur d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Takadu al-samawatu yatafattarna min al-fawqi » — les cieux sont près de se fendre par en haut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la grandeur d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tremblement des cieux montre l'insuffisance de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création témoigne de la grandeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation de la grandeur inspire l'humilité." }
  ],
  munajat: `Ya Rabb, Ta grandeur me dépasse. Fais que je me prosterne devant elle. Ne permets pas l'arrogance.`
};

// ==================== SURAH 43: AZ-ZUKHRUF - MISSING ENTRIES ====================

MIROIR["43:3"] = {
  reference: "43:3",
  theme: ["langue", "arabe", "compréhension"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Lisan", "Al-'Arabiyyah"],
  mirrorVersion: `« Nous en avons fait un Coran arabe afin que vous raisonniez. » Le miroir explique : « Inna ja'alnahu Qur'anan 'arabiyyan la'allakum ta'qilun » — nous en avons fait un Coran arabe afin que vous raisonniez. La langue arabe est un moyen de compréhension. Le miroir m'enseigne : la langue n'est pas un obstacle mais un pont.`,
  reflection: `La langue n'est pas un obstacle mais un pont.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ja'alnahu Qur'anan 'arabiyyan la'allakum ta'qilun » — nous en avons fait un Coran arabe afin que vous raisonniez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends la langue du Coran pour mieux comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La langue arabe est la clé de la compréhension directe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La langue du Coran est préservée pour tous les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'apprentissage de la langue arabe est un acte d'adoration." }
  ],
  munajat: `Ya Rabb, apprends-moi la langue du Coran. Fais que je comprenne directement. Ne permets pas que la langue soit un obstacle.`
};

MIROIR["43:4"] = {
  reference: "43:4",
  theme: ["table", "préservation", "haut"],
  emotion: "Révérence, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Lawh", "Al-Mahfuz"],
  mirrorVersion: `« Il est dans la Mère du Livre, auprès de Nous, sublime et plein de sagesse. » Le miroir révèle : « Wa innahu fi ummi al-kitabi ladayna la-'aliyyun hakim » — il est dans la Mère du Livre, auprès de Nous, sublime et plein de sagesse. Le Coran est préservé. Le miroir m'enseigne : la préservation garantit l'authenticité.`,
  reflection: `La préservation garantit l'authenticité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innahu fi ummi al-kitabi ladayna la-'aliyyun hakim » — il est dans la Mère du Livre, auprès de Nous, sublime et plein de sagesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la préservation parfaite du Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préservation céleste assure la préservation terrestre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le seul livre parfaitement préservé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance dans la préservation permet la soumission totale." }
  ],
  munajat: `Ya Rabb, je crois en la préservation de Ton Livre. Fais que je m'y soumette totalement. Ne permets pas le doute.`
};

// ==================== SURAH 44: AD-DUKHAN - MISSING ENTRIES ====================

MIROIR["44:3"] = {
  reference: "44:3",
  theme: ["nuit", "bénédiction", "révélation"],
  emotion: "Gratitude, mystère",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Mubarak"],
  mirrorVersion: `« Nous l'avons fait descendre en une nuit bénie. » Le miroir révèle : « Inna anzalnahu fi laylatin mubarakah » — nous l'avons fait descendre en une nuit bénie. La nuit de la révélation est bénie. Le miroir m'enseigne : la bénédiction se cache dans la nuit.`,
  reflection: `La bénédiction se cache dans la nuit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna anzalnahu fi laylatin mubarakah » — nous l'avons fait descendre en une nuit bénie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je recherche les nuits bénies ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit bénie est un cadeau pour ceux qui la cherchent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit de Laylat al-Qadr est meilleure que mille mois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La recherche des nuits bénies est un acte de foi." }
  ],
  munajat: `Ya Rabb, fais-moi vivre les nuits bénies. Donne-moi la Laylat al-Qadr. Ne permets pas que je les manque.`
};

MIROIR["44:4"] = {
  reference: "44:4",
  theme: ["sagesse", "nuit", "décret"],
  emotion: "Mystère, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hikmah", "Al-Qadar"],
  mirrorVersion: `« En elle, tout ordre sage est décidé. » Le miroir explique : « Fiha yufraqu kullu amrin hakim » — en elle, tout ordre sage est décidé. La nuit du décret est la nuit des décisions. Le miroir m'enseigne : les décisions divines sont sages.`,
  reflection: `Les décisions divines sont sages.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fiha yufraqu kullu amrin hakim » — en elle, tout ordre sage est décidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les décisions divines comme sages ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse des décisions divines dépasse notre compréhension." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret annuel est pris dans la nuit bénie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La soumission au décret sage est le sommet de la foi." }
  ],
  munajat: `Ya Rabb, j'accepte Tes décisions sages. Fais que je me soumette au décret. Ne permets pas la rébellion.`
};

// ==================== SURAH 45: AL-JATHIYAH - MISSING ENTRIES ====================

MIROIR["45:3"] = {
  reference: "45:3",
  theme: ["signes", "cieux", "terre"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Samawat"],
  mirrorVersion: `« Il y a dans les cieux et la terre des signes pour les croyants. » Le miroir montre : « Inna fi al-samawati wa al-ardi la-ayatin lil-mu'minin » — il y a dans les cieux et la terre des signes pour les croyants. Les signes sont partout pour ceux qui croient. Le miroir m'enseigne : la foi ouvre les yeux.`,
  reflection: `La foi ouvre les yeux aux signes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fi al-samawati wa al-ardi la-ayatin lil-mu'minin » — il y a dans les cieux et la terre des signes pour les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes vois-je autour de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont visibles pour ceux qui ont la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est un signe d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation des signes augmente la foi." }
  ],
  munajat: `Ya Rabb, ouvre mes yeux aux signes. Fais que je contemple Ta création. Ne permets pas la cécité.`
};

MIROIR["45:4"] = {
  reference: "45:4",
  theme: ["création", "dispersion", "signes"],
  emotion: "Émerveillement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Nashr"],
  mirrorVersion: `« Et dans votre propre création, et dans ce qu'Il dissémine comme créatures. » Le miroir révèle : « Wa fi khalqikum wa ma yabuthu min dabbatin » — et dans votre propre création, et dans ce qu'Il dissémine comme créatures. L'homme et les animaux sont des signes. Le miroir m'enseigne : je suis moi-même un signe.`,
  reflection: `Je suis moi-même un signe d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi khalqikum wa ma yabuthu min dabbatin ayatun li-qawmin yuqinun » — et dans votre propre création, et dans ce qu'Il dissémine comme créatures, il y a des signes pour des gens qui ont la certitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma propre création m'enseigne sur le Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La créature est le miroir du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature porte la signature de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation de soi-même mène à la connaissance d'Allah." }
  ],
  munajat: `Ya Khaliq, je suis Ton signe. Fais que je me connaisse pour Te connaître. Ne permets pas l'ignorance de moi-même.`
};

// ==================== SURAH 46: AL-AHQAF - MISSING ENTRIES ====================

MIROIR["46:3"] = {
  reference: "46:3",
  theme: ["création", "but", "vérité"],
  emotion: "Sens, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Haqq"],
  mirrorVersion: `« Nous n'avons créé les cieux, la terre et ce qui est entre eux qu'en toute vérité. » Le miroir affirme : « Ma khalaqna al-samawati wa al-arda wa ma baynahuma illa bi-al-haqq » — nous n'avons créé les cieux, la terre et ce qui est entre eux qu'en toute vérité. La création a un but. Le miroir m'enseigne : rien n'est sans raison.`,
  reflection: `Rien n'est sans raison. La création a un but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma khalaqna al-samawati wa al-arda wa ma baynahuma illa bi-al-haqq » — nous n'avons créé les cieux, la terre et ce qui est entre eux qu'en toute vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le but de ma création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité de la création est son sens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création porte un sens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La recherche du sens est un acte de foi." }
  ],
  munajat: `Ya Rabb, montre-moi le sens de ma création. Fais que je vive en vérité. Ne permets pas le vide existentiel.`
};

MIROIR["46:4"] = {
  reference: "46:4",
  theme: ["divinités", "création", "question"],
  emotion: "Questionnement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alihah", "Al-Khalq"],
  mirrorVersion: `« Dis : Voyez-vous ce que vous invoquez en dehors d'Allah ? » Le miroir interroge : « Qul ara'aytum ma tad'una min duni Allah » — dis : Voyez-vous ce que vous invoquez en dehors d'Allah ? La question force l'examen. Le miroir m'enseigne : l'examen des divinités révèle leur nullité.`,
  reflection: `L'examen des divinités révèle leur nullité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ara'aytum ma tad'una min duni Allah » — dis : Voyez-vous ce que vous invoquez en dehors d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'invoque en dehors d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'examen des fausses divinités mène au tawhid." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah mérite l'invocation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La question honnête mène à la vérité." }
  ],
  munajat: `Ya Rabb, j'examine ce que j'invoque. Fais que je n'invoque que Toi. Ne permets pas l'association.`
};

// ==================== SURAH 47: MUHAMMAD - MISSING ENTRIES ====================

MIROIR["47:3"] = {
  reference: "47:3",
  theme: ["guidance", "mécréance", "satan"],
  emotion: "Vérité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Shaytan"],
  mirrorVersion: `« Cela parce que ceux qui ont mécru ont suivi le Faux. » Le miroir explique : « Dhalika bi-anna alladhina kafaru ittaba'u al-batil » — cela parce que ceux qui ont mécru ont suivi le Faux. Le résultat révèle la cause. Le miroir m'enseigne : la mécréance suit le faux.`,
  reflection: `La mécréance suit le faux. La foi suit la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-anna alladhina kafaru ittaba'u al-batil » — cela parce que ceux qui ont mécru ont suivi le Faux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la vérité ou le faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le résultat de la vie révèle ce qu'on a suivi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité et le faux sont les deux chemins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le discernement entre vérité et faux est essentiel." }
  ],
  munajat: `Ya Rabb, je veux suivre la vérité. Donne-moi le discernement. Ne permets pas que je suive le faux.`
};

MIROIR["47:4"] = {
  reference: "47:4",
  theme: ["combat", "rencontre", "libération"],
  emotion: "Gravité, engagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qital", "Al-Fida'"],
  mirrorVersion: `« Lorsque vous rencontrez les mécréants, frappez-les au cou. » Le miroir ordonne : « Fa-idha laqaytumu alladhina kafaru fa-darba al-a'naq » — lorsque vous rencontrez les mécréants, frappez-les au cou. Le combat est une réalité. Le miroir m'enseigne : la défense de la foi peut demander le combat.`,
  reflection: `La défense de la foi peut demander le combat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha laqaytumu alladhina kafaru fa-darba al-a'naq » — lorsque vous rencontrez les mécréants, frappez-les au cou." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à défendre ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le combat extérieur reflète le combat intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La défense de la vérité est un devoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La force dans la défense vient de la foi." }
  ],
  munajat: `Ya Rabb, donne-moi la force de défendre ma foi. Ne permets pas la lâcheté. Fais que je sois parmi les défenseurs de la vérité.`
};

// ==================== SURAH 48: AL-FATH - MISSING ENTRIES ====================

MIROIR["48:3"] = {
  reference: "48:3",
  theme: ["victoire", "secours", "force"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Nasr", "Al-'Izzah"],
  mirrorVersion: `« Et qu'Allah te secoure d'un secours puissant. » Le miroir promet : « Wa yansuraka Allahu nasran 'azizan » — et qu'Allah te secoure d'un secours puissant. Le secours divin est certain. Le miroir m'enseigne : la victoire vient d'Allah.`,
  reflection: `La victoire vient d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yansuraka Allahu nasran 'azizan » — et qu'Allah te secoure d'un secours puissant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quel secours ai-je besoin ? Est-ce que je le demande à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secours puissant d'Allah est pour ceux qui Lui font confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le secours d'Allah est disponible pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance totale attire le secours total." }
  ],
  munajat: `Ya Rabb, donne-moi Ton secours puissant. Fais que je Te fasse confiance totalement. Ne permets pas le doute.`
};

// ==================== SURAH 49: AL-HUJURAT - MISSING ENTRIES ====================

MIROIR["49:3"] = {
  reference: "49:3",
  theme: ["voix", "respect", "cœurs"],
  emotion: "Humilité, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Sawt", "Al-Qulub"],
  mirrorVersion: `« Ceux qui baissent leurs voix devant le Messager d'Allah, ce sont ceux dont Allah a éprouvé les cœurs pour la piété. » Le miroir évalue : « Inna alladhina yaghudduna aswatihim 'inda rasuli Allahi ula'ika alladhina imtahana Allahu qulubahum lil-taqwa » — ceux qui baissent leurs voix devant le Messager d'Allah, ce sont ceux dont Allah a éprouvé les cœurs pour la piété. Le comportement révèle le cœur. Le miroir m'enseigne : la piété se manifeste dans les détails.`,
  reflection: `La piété se manifeste dans les détails.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina yaghudduna aswatihim 'inda rasuli Allahi ula'ika alladhina imtahana Allahu qulubahum lil-taqwa » — ceux qui baissent leurs voix devant le Messager d'Allah, ce sont ceux dont Allah a éprouvé les cœurs pour la piété." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je parle du Prophète ? Est-ce avec respect ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect du Prophète est le signe de la piété du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le respect est la manifestation extérieure de la foi intérieure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La voix basse devant le Prophète élève le cœur." }
  ],
  munajat: `Ya Rabb, apprends-moi le respect envers Ton Prophète. Fais que mon cœur soit éprouvé pour la piété. Ne permets pas l'irrespect.`
};

// ==================== SURAH 50: QAF - MISSING ENTRIES ====================

MIROIR["50:2"] = {
  reference: "50:2",
  theme: ["étonnement", "messager", "résurrection"],
  emotion: "Questionnement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ajib", "Al-Ba'th"],
  mirrorVersion: `« Mais ils s'étonnèrent qu'un avertisseur soit venu à eux. » Le miroir constate : « Bal 'ajibu an ja'ahum mundhirun minhum » — mais ils s'étonnèrent qu'un avertisseur soit venu à eux. L'étonnement de la guidance. Le miroir m'enseigne : l'étonnement peut voiler l'accueil.`,
  reflection: `L'étonnement peut voiler l'accueil.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal 'ajibu an ja'ahum mundhirun minhum fa-qala al-kafiruna hadha sha'un 'ajib » — mais ils s'étonnèrent qu'un avertisseur soit venu à eux. Les mécréants dirent : C'est une chose étonnante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'étonne de la guidance ? Ou est-ce que je l'accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement de la guidance est le signe de l'éloignement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est un cadeau — pas une étrangeté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'accueil de la guidance sans étonnement est la foi." }
  ],
  munajat: `Ya Rabb, j'accueille Ta guidance sans étonnement. Fais que je la reconnaisse comme normale. Ne permets pas la surprise négative.`
};

MIROIR["50:3"] = {
  reference: "50:3",
  theme: ["résurrection", "doute", "question"],
  emotion: "Questionnement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-Mawt"],
  mirrorVersion: `« Quand nous serons morts et devenus poussière ? » Le miroir rapporte le doute : « A-idha mitna wa kunna turaban » — quand nous serons morts et devenus poussière ? La résurrection semble impossible. Le miroir m'enseigne : le doute de la résurrection vient de la limite de l'imagination.`,
  reflection: `Le doute de la résurrection vient de la limite de l'imagination.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-idha mitna wa kunna turaban dhalika raj'un ba'id » — quand nous serons morts et devenus poussière ? C'est un retour impossible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la résurrection ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité humaine n'est pas l'impossibilité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est une promesse certaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi en la résurrection guide la vie présente." }
  ],
  munajat: `Ya Rabb, je crois en la résurrection. Fais que je vive en conséquence. Ne permets pas le doute.`
};

MIROIR["17:83"] = {
  reference: "17:83",
  theme: ["bienfait", "ingratitude", "éloignement"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Al-Kufr"],
  mirrorVersion: `« Quand Nous comblons l'homme de bienfaits, il se détourne et s'éloigne. » Le miroir me montre l'ingratitude de l'homme. « Wa idha an'amna 'ala al-insani a'rada » — quand Nous comblons l'homme de bienfaits, il se détourne. Le bienfait au lieu de rapprocher éloigne souvent. Le miroir m'interroge : est-ce que le bienfait me rapproche ou m'éloigne d'Allah ?`,
  reflection: `Le bienfait peut rapprocher ou éloigner. L'ingratitude transforme le bienfait en éloignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha an'amna 'ala al-insani a'rada wa na'a bi-janibihi » — quand Nous comblons l'homme de bienfaits, il se détourne et s'éloigne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que le bienfait me rapproche ou m'éloigne d'Allah ? Comment réagis-je aux bienfaits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bienfait avec gratitude rapproche d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bienfait est un test : il rapproche ou éloigne selon la réaction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui que le bienfait rapproche d'Allah a compris le sens du bienfait." }
  ],
  munajat: `Ya Rabb, que les bienfaits me rapprochent de Toi. Ne permets pas qu'ils m'éloignent. Donne-moi la gratitude qui transforme le bienfait en rapprochement.`
};

MIROIR["17:84"] = {
  reference: "17:84",
  theme: ["action", "état", "chemin"],
  emotion: "Responsabilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-'Amal", "As-Sabil"],
  mirrorVersion: `« Dis : "Chacun agit selon sa manière, et votre Seigneur connaît mieux qui suit le meilleur chemin." » Le miroir me montre la diversité des actions. « Qul kullun ya'malu 'ala shakilatihi » — dis : Chacun agit selon sa manière. Les actions révèlent les états. Le miroir m'interroge : comment j'agis selon ma manière ?`,
  reflection: `Les actions révèlent les états. Le Seigneur connaît qui suit le meilleur chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul kullun ya'malu 'ala shakilatihi fa-rabbukum a'lamu bi-man huwa ahdā sabilan » — dis : Chacun agit selon sa manière, et votre Seigneur connaît mieux qui suit le meilleur chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'agis selon ma manière ? Quel chemin je suis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La manière d'agir révèle la manière d'être." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun a sa manière, Allah connaît le meilleur chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le meilleur chemin est reconnu par Allah." }
  ],
  munajat: `Ya Rabb, je veux suivre le meilleur chemin. Fais que ma manière d'agir reflète la meilleure manière d'être. Connaïs-moi comme celui qui suit le meilleur chemin.`
};

MIROIR["17:85"] = {
  reference: "17:85",
  theme: ["esprit", "science", "question"],
  emotion: "Humilité, mystère",
  difficulty: "avancé",
  relatedNames: ["Ar-Ruh", "Al-'Ilm"],
  mirrorVersion: `« Ils t'interrogent sur l'esprit. Dis : "L'esprit relève de l'ordre de mon Seigneur." » Le miroir me montre la limite de la connaissance humaine. « Yas'alunaka 'ani al-ruhi » — ils t'interrogent sur l'esprit. L'esprit est un mystère divin. Le miroir m'interroge : est-ce que j'accepte les mystères de la création ?`,
  reflection: `L'esprit est un mystère divin. La connaissance humaine a des limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yas'alunaka 'ani al-ruhi quli al-ruhu min amri rabbi » — ils t'interrogent sur l'esprit. Dis : L'esprit relève de l'ordre de mon Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les mystères de la création ? Ou est-ce que je veux tout comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des mystères est une forme de connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il y a des mystères que Dieu seul connaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les mystères respecte la grandeur divine." }
  ],
  munajat: `Ya Rabb, j'accepte les mystères de Ta création. Ne permets pas que je conteste ce que je ne peux pas comprendre. Donne-moi l'humilité devant Tes mystères.`
};

MIROIR["17:86"] = {
  reference: "17:86",
  theme: ["retrait", "révélation", "successeur"],
  emotion: "Gratitude, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["An-Naza'", "Al-Wahy"],
  mirrorVersion: `« Si Nous voulions, Nous retirerions ce que Nous t'avons révélé. » Le miroir me montre la possibilité du retrait de la guidance. « La-in shi'na la-nadhhabanna bi-lladhi awhayna ilayka » — si Nous voulions, Nous retirerions ce que Nous t'avons révélé. La guidance est un don qui peut être retiré. Le miroir m'interroge : est-ce que je préserve la guidance reçue ?`,
  reflection: `La guidance est un don qui peut être retiré. La préservation de la guidance est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in shi'na la-nadhhabanna bi-lladhi awhayna ilayka thumma la tajidu laka 'alayna wakiyan » — si Nous voulions, Nous retirerions ce que Nous t'avons révélé, puis tu ne trouverais personne pour te protéger contre Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la guidance reçue ? Ou est-ce que je la néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préservation de la guidance garantit sa continuation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est un don précieux à préserver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve sa guidance la garde." }
  ],
  munajat: `Ya Rabb, je préserve la guidance reçue. Ne permets pas que je la néglige. Garde Ta révélation avec moi.`
};

MIROIR["17:87"] = {
  reference: "17:87",
  theme: ["miséricorde", "révélation", "grâce"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "Al-Fadl"],
  mirrorVersion: `« C'est une miséricorde de ton Seigneur. » Le miroir me montre l'origine de la guidance. « Illa rahmatan min rabbika » — c'est une miséricorde de ton Seigneur. La révélation est une miséricorde. Le miroir m'interroge : est-ce que je reconnais la révélation comme miséricorde ?`,
  reflection: `La révélation est une miséricorde de ton Seigneur. Sa grâce est immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa rahmatan min rabbika inna fadlahu kana 'alayka kabira » — c'est une miséricorde de ton Seigneur. Sa grâce sur toi est immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la révélation comme miséricorde ? Ou est-ce que je la vois comme un fardeau ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la révélation comme miséricorde sanctifie la lecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la plus grande miséricorde de Dieu pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la révélation comme miséricorde la chérit." }
  ],
  munajat: `Ya Rahman, merci pour Ta révélation comme miséricorde. Ne permets pas que je la voie comme un fardeau. Donne-moi de reconnaître Ta grâce immense.`
};

MIROIR["17:88"] = {
  reference: "17:88",
  theme: ["défi", "coran", "impuissance"],
  emotion: "Certitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Mu'jizah"],
  mirrorVersion: `« Si les hommes et les djinns s'unissaient pour produire quelque chose de semblable à ce Coran, ils ne produiraient rien de semblable. » Le miroir me montre l'inimitabilité du Coran. « La-in ij-tama'a al-insu wa al-jinnu » — si les hommes et les djinns s'unissaient. Le Coran est inimitable. Le miroir m'interroge : est-ce que je reconnais l'inimitabilité du Coran ?`,
  reflection: `Le Coran est inimitable. Même tous unis, les hommes et les djinns ne peuvent rien produire de semblable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul la-in ij-tama'a al-insu wa al-jinnu 'ala an ya'tu bi-mithli hadha al-qur'ani » — dis : Si les hommes et les djinns s'unissaient pour produire quelque chose de semblable à ce Coran, ils ne produiraient rien de semblable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'inimitabilité du Coran ? Ou est-ce que je doute de son origine divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inimitabilité du Coran prouve son origine divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le miracle éternel du Prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'inimitabilité du Coran reconnaît son origine divine." }
  ],
  munajat: `Ya Rabb, je reconnais l'inimitabilité de Ton Coran. Ne permets pas que je doute de son origine divine. Donne-moi la certitude de son miracle éternel.`
};

MIROIR["17:89"] = {
  reference: "17:89",
  theme: ["explication", "avertissement", "éloignement"],
  emotion: "Tristesse, patience",
  difficulty: "débutant",
  relatedNames: ["At-Tasriff", "Al-Indhar"],
  mirrorVersion: `« Nous avons certes exposé aux gens dans ce Coran toutes sortes d'exemples. » Le miroir me montre la diversité des exemples. « Wa laqad sarrafna li-al-nasi fi hadha al-qur'ani » — nous avons certes exposé aux gens dans ce Coran toutes sortes d'exemples. Les exemples sont multiples pour guider. Le miroir m'interroge : est-ce que je tire profit des exemples du Coran ?`,
  reflection: `Les exemples du Coran sont multiples pour guider. L'éloignement des gens est constant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad sarrafna li-al-nasi fi hadha al-qur'ani min kulli mathalin » — nous avons certes exposé aux gens dans ce Coran toutes sortes d'exemples." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tire profit des exemples du Coran ? Ou est-ce que je m'éloigne comme beaucoup ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les exemples du Coran sont pour ceux qui veulent comprendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La diversité des exemples répond à la diversité des besoins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire profit des exemples du Coran est guidé." }
  ],
  munajat: `Ya Rabb, je tire profit des exemples de Ton Coran. Ne permets pas que je m'éloigne. Guide-moi par la diversité de Tes exemples.`
};

MIROIR["17:90"] = {
  reference: "17:90",
  theme: ["demande", "signes", "condition"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["At-Talab", "Al-Ayat"],
  mirrorVersion: `« Ils disent : "Nous ne croirons pas en toi jusqu'à ce que tu fasses jaillir une source de la terre." » Le miroir me montre les conditions des mécréants. « Lan nu'mina laka hatta tafjura lana » — nous ne croirons pas en toi jusqu'à ce que tu fasses jaillir. Les conditions impossibles sont des excuses. Le miroir m'interroge : est-ce que je mets des conditions à ma foi ?`,
  reflection: `Les conditions impossibles sont des excuses. La foi ne devrait pas avoir de conditions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu lan nu'mina laka hatta tafjura lana mina al-ardi yanbu'an » — ils disent : Nous ne croirons pas en toi jusqu'à ce que tu fasses jaillir pour nous une source de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mets des conditions à ma foi ? Ou est-ce que j'accepte la révélation sans condition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans condition est la vraie foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mécréants demandent toujours plus de signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sans condition a la foi complète." }
  ],
  munajat: `Ya Rabb, je crois sans condition. Ne permets pas que je demande des conditions impossibles. Donne-moi la foi qui accepte Ta révélation sans réserve.`
};

MIROIR["17:91"] = {
  reference: "17:91",
  theme: ["jardin", "palmeraies", "condition"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jannah", "An-Nakhl"],
  mirrorVersion: `« Ou que tu aies un jardin de palmiers et de vignes. » Le miroir me montre les conditions matérielles des mécréants. « Aw takuna laka jannatun min nakhilin wa 'inab » — ou que tu aies un jardin de palmiers et de vignes. Les biens matériels sont demandés comme preuve. Le miroir m'interroge : est-ce que je demande des biens matériels comme preuve de la prophétie ?`,
  reflection: `Les biens matériels ne sont pas une preuve de la prophétie. La foi dépasse les biens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw takuna laka jannatun min nakhilin wa 'inab fa-tufajjira al-anhara khilalaha tafjira » — ou que tu aies un jardin de palmiers et de vignes, et que tu fasses jaillir des rivières en son milieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des biens matériels comme preuve ? Ou est-ce que je me contente de la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation est plus précieuse que les biens matériels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes n'ont pas besoin de richesses pour être véridiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la révélation sans demander de biens a la foi." }
  ],
  munajat: `Ya Rabb, j'accepte Ta révélation sans demander de biens. Ne permets pas que je cherche la preuve dans les richesses. Donne-moi la foi qui se contente de la vérité.`
};

MIROIR["17:92"] = {
  reference: "17:92",
  theme: ["ciel", "morcellement", "condition"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sama'", "Al-Kisaf"],
  mirrorVersion: `« Ou que tu fasses tomber sur nous le ciel en morceaux. » Le miroir me montre les conditions spectaculaires des mécréants. « Aw tusaqqita al-sama'a kama za'umta 'alayna kisafan » — ou que tu fasses tomber sur nous le ciel en morceaux. Le spectaculaire est demandé comme preuve. Le miroir m'interroge : est-ce que je demande du spectaculaire comme preuve ?`,
  reflection: `Le spectaculaire n'est pas nécessaire pour la foi. Les signes existent pour ceux qui regardent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw tusaqqita al-sama'a 'alayna kisafan aw ta'tiya bi-Allahi wa al-mala'ikati qabilan » — ou que tu fasses tomber sur nous le ciel en morceaux, ou que tu fasses venir Allah et les anges face à face." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande du spectaculaire comme preuve ? Ou est-ce que je vois les signes existants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes existants suffisent pour celui qui veut croire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le spectaculaire demandé sera vu le Jour du Jugement, mais trop tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sans demander du spectaculaire a la foi." }
  ],
  munajat: `Ya Rabb, je crois sans demander du spectaculaire. Ne permets pas que je sois parmi ceux qui demandent des preuves impossibles. Donne-moi la foi dans les signes existants.`
};

MIROIR["17:93"] = {
  reference: "17:93",
  theme: ["maison", "or", "condition"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bayt", "Ad-Dhahab"],
  mirrorVersion: `« Ou que tu aies une maison en or. » Le miroir me montre les conditions de richesse des mécréants. « Aw yakuna laka baytun min zuhruf » — ou que tu aies une maison en or. La richesse est demandée comme preuve. Le miroir m'interroge : est-ce que je demande la richesse comme preuve de la vérité ?`,
  reflection: `La richesse n'est pas une preuve de la vérité. Les prophètes sont envoyés comme des hommes ordinaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw takuna laka baytun min zuhrufin aw tarqa fi al-sama'i » — ou que tu aies une maison en or, ou que tu montes au ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la richesse comme preuve ? Ou est-ce que j'accepte le prophète comme un homme ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le prophète est envoyé comme un homme pour enseigner aux hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont les meilleurs exemples parce qu'ils sont humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le prophète comme homme accepte la guidance." }
  ],
  munajat: `Ya Rabb, j'accepte Ton prophète comme un homme ordinaire. Ne permets pas que je demande la richesse comme preuve. Donne-moi la foi qui accepte la guidance sous n'importe quelle forme.`
};

MIROIR["17:94"] = {
  reference: "17:94",
  theme: ["obstacle", "humanité", "messager"],
  emotion: "Compréhension, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Sahib", "Al-Rasul"],
  mirrorVersion: `« Rien n'a empêché les gens de croire quand la guidance leur est venue, si ce n'est qu'ils disent : "Allah a-t-Il envoyé un homme comme messager ?" » Le miroir me montre l'obstacle de l'humanité du prophète. « Ma mana'a al-nasa an yu'minu » — rien n'a empêché les gens de croire. L'humanité du prophète est un obstacle pour eux. Le miroir m'interroge : est-ce que l'humanité du prophète est un obstacle pour moi ?`,
  reflection: `L'humanité du prophète est un obstacle pour les mécréants. Pour le croyant, c'est une facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma mana'a al-nasa an yu'minu idh ja'ahumu al-huda illa an qalu a-ba'atha Allahu basharan rasula » — rien n'a empêché les gens de croire quand la guidance leur est venue, si ce n'est qu'ils disent : Allah a-t-Il envoyé un homme comme messager ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'humanité du prophète est un obstacle pour moi ? Ou est-ce que je vois sa perfection dans son humanité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humanité du prophète est sa perfection pour nous guider." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont choisis parmi les hommes pour guider les hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la perfection dans l'humanité du prophète comprend le message." }
  ],
  munajat: `Ya Rabb, je vois la perfection dans l'humanité de Ton prophète. Ne permets pas que son humanité soit un obstacle. Fais que je le suis comme le meilleur exemple.`
};

MIROIR["17:95"] = {
  reference: "17:95",
  theme: ["anges", "messager", "condition"],
  emotion: "Sagesse, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ikah", "Al-Rasul"],
  mirrorVersion: `« Dis : "S'il y avait sur terre des anges marchant tranquillement, Nous aurions fait descendre sur eux du ciel un ange comme messager." » Le miroir me montre la sagesse de l'envoi d'un messager humain. « Law kana fi al-ardi mala'ikatun » — s'il y avait sur terre des anges. Le messager correspond à la nature des destinataires. Le miroir m'interroge : est-ce que j'accepte que le messager corresponde à ma nature ?`,
  reflection: `Le messager correspond à la nature des destinataires. Un messager humain pour des destinataires humains.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul law kana fi al-ardi mala'ikatun yamshuna mutma'innina la-nazzalna 'alayhim mina al-sama'i malakan rasula » — dis : S'il y avait sur terre des anges marchant tranquillement, Nous aurions fait descendre sur eux du ciel un ange comme messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que le messager corresponde à ma nature ? Ou est-ce que je veux un messager différent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adéquation entre le messager et le destinataire est la sagesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dieu envoie le messager qui convient à ceux à qui Il envoie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'adéquation du messager accepte la sagesse divine." }
  ],
  munajat: `Ya Rabb, j'accepte que Ton messager corresponde à ma nature humaine. Ne permets pas que je demande un messager différent. Donne-moi de suivre le messager que Tu as choisi pour moi.`
};

MIROIR["17:96"] = {
  reference: "17:96",
  theme: ["témoin", "proximité", "science"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Muhit"],
  mirrorVersion: `« Dis : "Allah suffit comme témoin entre moi et vous. Il est parfaitement Connaisseur et Clairvoyant sur Ses serviteurs." » Le miroir me montre la suffisance d'Allah comme témoin. « Kafa bi-Allahi shahidan » — Allah suffit comme témoin. Le témoignage d'Allah est suffisant. Le miroir m'interroge : est-ce que je me contente du témoignage d'Allah ?`,
  reflection: `Le témoignage d'Allah est suffisant. Il connaît et voit tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul kafa bi-Allahi shahidan bayni wa baynikum innahu kana bi-'ibadihi khabiran basira » — dis : Allah suffit comme témoin entre moi et vous. Il est parfaitement Connaisseur et Clairvoyant sur Ses serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me contente du témoignage d'Allah ? Ou est-ce que je cherche l'approbation des hommes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le contentement du témoignage d'Allah libère de l'approbation des hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le témoin parfait qui connaît et voit tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se contente du témoignage d'Allah n'a pas besoin d'autres témoins." }
  ],
  munajat: `Ya Shahid, Tu es mon témoin suffisant. Ne permets pas que je cherche l'approbation des hommes. Donne-moi de me contenter de Ton témoignage.`
};

MIROIR["17:97"] = {
  reference: "17:97",
  theme: ["guidance", "égarement", "allié"],
  emotion: "Espoir, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Celui qu'Allah guide est le bien guidé, et celui qu'Il égare, tu ne trouveras pour lui aucun allié. » Le miroir me montre le résultat de la guidance et de l'égarement. « Man yahdi Allahu fa-huwa al-muhtadi » — celui qu'Allah guide est le bien guidé. La guidance dépend d'Allah. Le miroir m'interroge : est-ce que je demande la guidance à Allah ?`,
  reflection: `La guidance dépend d'Allah. La demande de guidance est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yahdi Allahu fa-huwa al-muhtadi wa man yudlil falan tajida lahum awliya'a min dunihi » — celui qu'Allah guide est le bien guidé, et celui qu'Il égare, tu ne trouveras pour lui aucun allié en dehors de Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la guidance à Allah ? Ou est-ce que je compte sur moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de guidance à Allah est la condition de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est un don d'Allah, l'égarement est une conséquence du rejet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la guidance à Allah la reçoit." }
  ],
  munajat: `Ya Hadi, guide-moi. Je demande Ta guidance. Ne permets pas que je compte sur moi-même. Donne-moi d'être parmi les bien guidés.`
};

MIROIR["17:98"] = {
  reference: "17:98",
  theme: ["résurrection", "châtiment", "mécréants"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-Jahannam"],
  mirrorVersion: `« Voilà leur rétribution : l'Enfer, pour avoir mécru et traité Nos signes et Nos messagers de mensonges. » Le miroir me montre la rétribution des mécréants. « Dhalika jazauhum annahum kafaru » — voilà leur rétribution : ils ont mécru. La mécréance a une rétribution. Le miroir m'interroge : est-ce que j'évite la mécréance pour éviter la rétribution ?`,
  reflection: `La mécréance a une rétribution. La foi a une récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika jazauhum annahum kafaru bi-ayatina wa qalu a-idha kunna 'izaman wa rufatan a-inna la-mab'uthuna khalqan jadid » — voilà leur rétribution : l'Enfer, pour avoir mécru et traité Nos signes de mensonges, et dit : Quand nous serons ossements et poussière, serons-nous ressuscités en une nouvelle création ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite la mécréance pour éviter la rétribution ? Ou est-ce que je persiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite la rétribution de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La rétribution est proportionnelle à l'acte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et ne traite pas les signes de mensonges est sauvé." }
  ],
  munajat: `Ya Rabb, je crois en Tes signes et Tes messagers. Ne permets pas que je les traite de mensonges. Sauve-moi de la rétribution des mécréants.`
};

MIROIR["17:99"] = {
  reference: "17:99",
  theme: ["création", "résurrection", "facilité"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Ba'th"],
  mirrorVersion: `« N'ont-ils pas vu qu'Allah qui a créé les cieux et la terre est capable de créer des semblables ? » Le miroir me montre la facilité de la résurrection. « A-wa lam yaraw anna Allaha alladhi khalaqa al-samawati wa al-arda » — n'ont-ils pas vu qu'Allah qui a créé les cieux et la terre. La création prouve la résurrection. Le miroir m'interroge : est-ce que je vois la création comme preuve de la résurrection ?`,
  reflection: `La création prouve la résurrection. Celui qui peut créer peut ressusciter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yaraw anna Allaha alladhi khalaqa al-samawati wa al-arda qadirun 'ala an yakhluqa mithlahum » — n'ont-ils pas vu qu'Allah qui a créé les cieux et la terre est capable de créer des semblables ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la création comme preuve de la résurrection ? Ou est-ce que je ne vois pas le lien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création et la résurrection sont deux faces de la même puissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Celui qui peut créer les cieux et la terre peut ressusciter les morts." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la création comprend la résurrection." }
  ],
  munajat: `Ya Khaliq, Tu as créé les cieux et la terre. Tu peux me ressusciter. Donne-moi la certitude de la résurrection par la preuve de la création.`
};

MIROIR["17:100"] = {
  reference: "17:100",
  theme: ["trésors", "réserve", "avarice"],
  emotion: "Mise en garde, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kunuz", "Al-Infaq"],
  mirrorVersion: `« Dis : "Si vous possédiez les trésors de la miséricorde de mon Seigneur, vous les auriez retenus par crainte de les dépenser." » Le miroir me montre l'avarice des hommes. « Law antum tamlikuna khaza'ina rahmati rabbi » — si vous possédiez les trésors de la miséricorde de mon Seigneur. L'avarice est naturelle aux hommes. Le miroir m'interroge : est-ce que je suis avare ou généreux ?`,
  reflection: `L'avarice est naturelle aux hommes. La générosité demande un effort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul law antum tamlikuna khaza'ina rahmati rabbi idhan la-amsaktum khashyata al-infaq » — dis : Si vous possédiez les trésors de la miséricorde de mon Seigneur, vous les auriez retenus par crainte de les dépenser." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis avare ou généreux ? Comment je dépense ce que j'ai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité transcende la nature avare." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est naturellement avare, la foi le rend généreux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est généreux a transcendé sa nature avare." }
  ],
  munajat: `Ya Rabb, je veux être généreux. Ne permets pas l'avarice dans mon cœur. Donne-moi de dépenser sans crainte de manquer.`
};

MIROIR["17:101"] = {
  reference: "17:101",
  theme: ["moïse", "signes", "pharaon"],
  emotion: "Leçon, guidance",
  difficulty: "débutant",
  relatedNames: ["Musa", "Al-Ayat"],
  mirrorVersion: `« Nous avons donné à Moïse neuf signes évidents. » Le miroir me montre les signes donnés à Moïse. « Wa laqad atayna Musa tis'a ayatin bayyinat » — nous avons donné à Moïse neuf signes évidents. Les signes sont donnés aux prophètes. Le miroir m'interroge : est-ce que je tire leçon des signes des prophètes ?`,
  reflection: `Les signes sont donnés aux prophètes. Les leçons sont pour ceux qui suivent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad atayna Musa tis'a ayatin bayyinat fas'al bani isra'ila idh ja'ahum » — nous avons donné à Moïse neuf signes évidents. Interroge les Enfants d'Israël quand il vint à eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tire leçon des signes des prophètes ? Ou est-ce que j'oublie les leçons du passé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes du passé enseignent pour le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes donnés aux prophètes sont des leçons pour les générations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire leçon des signes des prophètes est guidé." }
  ],
  munajat: `Ya Rabb, je tire leçon des signes donnés à Moïse. Ne permets pas que j'oublie les leçons du passé. Guide-moi par les signes des prophètes.`
};

MIROIR["17:102"] = {
  reference: "17:102",
  theme: ["moïse", "pharaon", "science"],
  emotion: "Vérité, certitude",
  difficulty: "débutant",
  relatedNames: ["Musa", "Fir'awn"],
  mirrorVersion: `« Moïse dit : "Tu sais que ces signes, seul le Seigneur des cieux et de la terre les a fait descendre comme preuves." » Le miroir me montre la certitude de Moïse. « Qad 'alimta ma anzala ha'ula'i illa rabbu al-samawati » — tu sais que ces signes, seul le Seigneur des cieux et de la terre les a fait descendre. La vérité est connue même des ennemis. Le miroir m'interroge : est-ce que je reconnais la vérité même quand elle me défie ?`,
  reflection: `La vérité est connue même des ennemis. La reconnaissance de la vérité est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala laqad 'alimta ma anzala ha'ula'i illa rabbu al-samawati wa al-ardi basa'ira » — il dit : Tu sais que ces signes, seul le Seigneur des cieux et de la terre les a fait descendre comme preuves." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité même quand elle me défie ? Ou est-ce que je refuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la vérité libère de l'orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est évidente pour celui qui veut voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité même quand elle le défie est vraiment libre." }
  ],
  munajat: `Ya Rabb, je reconnais la vérité même quand elle me défie. Ne permets pas que je refuse la vérité par orgueil. Libère-moi par la reconnaissance de la vérité.`
};

MIROIR["17:103"] = {
  reference: "17:103",
  theme: ["expulsion", "pharaon", "naufrage"],
  emotion: "Justice, leçon",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "Al-Gharq"],
  mirrorVersion: `« Pharaon voulut les expulser du pays, et Nous le noyâmes, lui et ceux qui étaient avec lui. » Le miroir me montre le destin de Pharaon. « Fa-arada an yastafizzahum mina al-ardi » — Pharaon voulut les expulser du pays. L'intention mauvaise a des conséquences. Le miroir m'interroge : est-ce que je crains les conséquences de mes mauvaises intentions ?`,
  reflection: `L'intention mauvaise a des conséquences. La justice divine est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-arada an yastafizzahum mina al-ardi fa-aghraqnahu wa man ma'ahu jami'an » — Pharaon voulut les expulser du pays, et Nous le noyâmes, lui et ceux qui étaient avec lui, tous ensemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les conséquences de mes mauvaises intentions ? Ou est-ce que je persiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les mauvaises intentions attirent les mauvaises conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine atteint toujours les oppresseurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les mauvaises intentions évite les mauvaises conséquences." }
  ],
  munajat: `Ya Rabb, je crains les conséquences de mes mauvaises intentions. Ne permets pas que je persiste dans le mal. Sauve-moi du destin des oppresseurs.`
};

MIROIR["17:104"] = {
  reference: "17:104",
  theme: ["israël", "terre", "rassemblement"],
  emotion: "Promesse, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Bani Isra'il", "Al-Ard"],
  mirrorVersion: `« Et après lui, Nous dîmes aux Enfants d'Israël : "Habitez la terre." » Le miroir me montre la promesse aux Enfants d'Israël. « Wa qulna min ba'dihi li-bani isra'ila skunu al-arda » — et après lui, Nous dîmes aux Enfants d'Israël : Habitez la terre. La promesse divine est réalisée. Le miroir m'interroge : est-ce que je fais confiance aux promesses d'Allah ?`,
  reflection: `La promesse divine est réalisée. La confiance dans les promesses est la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qulna min ba'dihi li-bani isra'ila skunu al-arda fa-idha ja'a wa'du al-akhirati ji'na bikum lafifan » — et après lui, Nous dîmes aux Enfants d'Israël : Habitez la terre. Puis quand la promesse de l'au-delà viendra, Nous vous ferons venir en foule." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance aux promesses d'Allah ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance dans les promesses divines est la certitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les promesses d'Allah sont toujours réalisées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance aux promesses d'Allah ne sera jamais déçu." }
  ],
  munajat: `Ya Rabb, je fais confiance à Tes promesses. Ne permets pas que je doute. Réalise Tes promesses pour moi comme Tu les as réalisées pour les Enfants d'Israël.`
};

MIROIR["17:105"] = {
  reference: "17:105",
  theme: ["vérité", "révélation", "bonne nouvelle"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "At-Tanil"],
  mirrorVersion: `« C'est en toute vérité que Nous l'avons fait descendre, et c'est en toute vérité qu'il est descendu. » Le miroir me montre la vérité de la révélation. « Wa bi-al-haqqi anzalnahu » — c'est en toute vérité que Nous l'avons fait descendre. La révélation est vérité. Le miroir m'interroge : est-ce que je traite le Coran comme vérité ?`,
  reflection: `La révélation est vérité. Son traitement comme vérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa bi-al-haqqi anzalnahu wa bi-al-haqqi nazala » — c'est en toute vérité que Nous l'avons fait descendre, et c'est en toute vérité qu'il est descendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite le Coran comme vérité ? Ou est-ce que je le traite comme un livre ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le traitement du Coran comme vérité sanctifie la lecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité de la révélation est absolue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traite le Coran comme vérité reçoit la vérité." }
  ],
  munajat: `Ya Haqq, je traite Ton Coran comme vérité. Ne permets pas que je le traite comme un livre ordinaire. Donne-moi de recevoir la vérité par Ta révélation.`
};

MIROIR["17:106"] = {
  reference: "17:106",
  theme: ["coran", "division", "récitation"],
  emotion: "Sagesse, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "At-Tanzil"],
  mirrorVersion: `« Et c'est un Coran que Nous avons divisé pour que tu le récites aux gens lentement. » Le miroir me montre la sagesse de la division du Coran. « Wa Qur'anan faraqnahu » — et c'est un Coran que Nous avons divisé. La division facilite la récitation et la méditation. Le miroir m'interroge : est-ce que je récite le Coran lentement pour méditer ?`,
  reflection: `La division du Coran facilite la récitation et la méditation. La lenteur dans la récitation est une sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Qur'anan faraqnahu li-taqra'ahu 'ala al-nasi 'ala mukth » — et c'est un Coran que Nous avons divisé pour que tu le récites aux gens lentement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je récite le Coran lentement pour méditer ? Ou est-ce que je me précipite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lenteur dans la récitation permet la méditation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran a été révélé progressivement pour être intégré progressivement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui récite lentement médite profondément." }
  ],
  munajat: `Ya Rabb, je récite Ton Coran lentement pour méditer. Ne permets pas que je me précipite. Donne-moi de méditer profondément Ta révélation.`
};

MIROIR["17:107"] = {
  reference: "17:107",
  theme: ["prosternation", "coran", "humilité"],
  emotion: "Humilité, adoration",
  difficulty: "débutant",
  relatedNames: ["As-Sujud", "Al-Qur'an"],
  mirrorVersion: `« Dis : "Croyez-y ou ne croyez pas, ceux qui ont reçu la science avant lui se prosternent quand on le leur récite." » Le miroir me montre la réaction des savants. « Qulu amunu bihi aw la tu'minu » — dis : Croyez-y ou ne croyez pas. Les savants se prosternent. La prosternation est la réponse des savants. Le miroir m'interroge : est-ce que je me prosterne face au Coran ?`,
  reflection: `La prosternation est la réponse des savants face au Coran. L'humilité devant la révélation est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul amunu bihi aw la tu'minu inna alladhina utu al-'ilma min qablihi idha tutla 'alayhim yakhirruna li-al-adhan sujjadan » — dis : Croyez-y ou ne croyez pas, ceux qui ont reçu la science avant lui se prosternent, le menton contre terre, quand on le leur récite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prosterne face au Coran ? Ou est-ce que je reste indifférent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation devant le Coran est l'humilité maximale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les savants reconnaissent la grandeur du Coran par la prosternation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne devant le Coran reconnaît sa grandeur." }
  ],
  munajat: `Ya Rabb, je me prosterne devant Ton Coran. Ne permets pas l'indifférence. Donne-moi l'humilité des savants face à Ta révélation.`
};

MIROIR["17:108"] = {
  reference: "17:108",
  theme: ["gloire", "larmes", "humilité"],
  emotion: "Émotion, adoration",
  difficulty: "débutant",
  relatedNames: ["At-Tasbih", "Al-Buka'"],
  mirrorVersion: `« Ils disent : "Gloire à notre Seigneur ! La promesse de notre Seigneur est certainement accomplie." » Le miroir me montre la réaction des croyants. « Wa yaquluna subhana rabbina » — ils disent : Gloire à notre Seigneur. La glorification accompagne la reconnaissance. Le miroir m'interroge : est-ce que je glorifie Allah quand j'entends le Coran ?`,
  reflection: `La glorification accompagne la reconnaissance. La promesse d'Allah est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna subhana rabbina inna wa'da rabbina la-maf'ul » — ils disent : Gloire à notre Seigneur ! La promesse de notre Seigneur est certainement accomplie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Allah quand j'entends le Coran ? Ou est-ce que je reste silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification devant le Coran sanctifie l'audition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les croyants réagissent par la glorification et la reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah devant le Coran a le cœur vivant." }
  ],
  munajat: `Ya Subhan, je Te glorifie quand j'entends Ton Coran. Ne permets pas le silence de l'indifférence. Donne-moi le cœur vivant des croyants.`
};

MIROIR["17:109"] = {
  reference: "17:109",
  theme: ["prosternation", "larmes", "humilité"],
  emotion: "Émotion, soumission",
  difficulty: "débutant",
  relatedNames: ["As-Sujud", "Al-Buka'"],
  mirrorVersion: `« Ils tombent sur leurs mentons en pleurant, et cela augmente leur humilité. » Le miroir me montre l'humilité des croyants. « Wa yakhirruna li-al-adhan yabkuna » — ils tombent sur leurs mentons en pleurant. Les larmes d'humilité sont précieuses. Le miroir m'interroge : est-ce que mes yeux pleurent d'humilité devant le Coran ?`,
  reflection: `Les larmes d'humilité sont précieuses. L'humilité augmente par la récitation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yakhirruna li-al-adhan yabkuna wa yaziduhum khushu'an » — ils tombent sur leurs mentons en pleurant, et cela augmente leur humilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes yeux pleurent d'humilité devant le Coran ? Ou sont-ils secs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les larmes d'humilité sont le signe du cœur vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humilité augmente par le contact avec le Coran." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pleure d'humilité devant le Coran a le cœur le plus proche d'Allah." }
  ],
  munajat: `Ya Rabb, donne-moi des larmes d'humilité devant Ton Coran. Ne permets pas que mes yeux soient secs. Augmente mon humilité par Ta révélation.`
};

MIROIR["17:111"] = {
  reference: "17:111",
  theme: ["gloire", "enfants", "unicité"],
  emotion: "Glorification, adoration",
  difficulty: "débutant",
  relatedNames: ["As-Subhan", "Al-Wahid"],
  mirrorVersion: `« Et dis : "Louange à Allah qui ne S'est pas donné d'enfant, qui n'a point d'associé dans la royauté." » Le miroir me montre la glorification d'Allah. « Wa qul al-hamdu li-Allahi alladhi lam yattakhidh waladan » — et dis : Louange à Allah qui ne S'est pas donné d'enfant. La transcendance d'Allah est parfaite. Le miroir m'interroge : est-ce que je glorifie Allah pour Sa transcendance ?`,
  reflection: `La transcendance d'Allah est parfaite. La glorification est la reconnaissance de Sa perfection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qul al-hamdu li-Allahi alladhi lam yattakhidh waladan wa lam yakun lahu sharikun fi al-mulki » — et dis : Louange à Allah qui ne S'est pas donné d'enfant, qui n'a point d'associé dans la royauté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Allah pour Sa transcendance ? Ou est-ce que je L'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification de la transcendance d'Allah est l'adoration parfaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est Unique, sans enfant et sans associé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie la transcendance d'Allah Le connaît vraiment." }
  ],
  munajat: `Ya Subhan, Tu es Unique, sans enfant et sans associé. Je Te glorifie pour Ta transcendance. Fais que je Te connaisse dans Ta perfection.`
};

// ==================== SURAH 39 (AZ-ZUMAR) - COMPLETE COVERAGE ====================

MIROIR["39:1"] = {
  reference: "39:1",
  theme: ["sagesse", "révélation", "adoration"],
  emotion: "Révérence, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Aziz", "Al-Hakim"],
  mirrorVersion: `« La révélation du Livre vient d'Allah, le Puissant, le Sage. » Le miroir me montre l'origine de la guidance. « Tanzil al-kitabi min Allahi al-azizi al-hakim » — la révélation du Livre vient d'Allah, le Puissant, le Sage. Cette puissance et cette sagesse sont les attributs de Celui qui révèle. Le miroir m'interroge : est-ce que je reconnais la source de la guidance ?`,
  reflection: `La révélation vient d'Allah le Puissant et Sage. La reconnaissance de Sa source sanctifie la lecture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitabi min Allahi al-azizi al-hakim » — la révélation du Livre vient d'Allah, le Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la source de la guidance ? Ou est-ce que je prends le Coran pour un livre ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la source divine sanctifie la lecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute révélation divine porte les attributs de son Auteur : puissance et sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source reçoit la lumière de la révélation." }
  ],
  munajat: `Ya Aziz, Ya Hakim, je reconnais que Ton Livre vient de Toi. Ne permets pas que je l'oublie. Donne-moi de lire avec la conscience de Ta puissance et Ta sagesse.`
};

MIROIR["39:2"] = {
  reference: "39:2",
  theme: ["foi", "guidance", "sincérité"],
  emotion: "Certitude, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Nous t'avons fait descendre le Livre en toute vérité. Adore donc Allah en Lui vouant un culte exclusif. » Le miroir me montre le lien entre vérité et adoration exclusive. « Inna anzalnaka al-kitaba bi-al-haqqi fa'bud Allaha mukhlisan lahu al-din » — Nous t'avons fait descendre le Livre en toute vérité. Adore donc Allah en Lui vouant un culte exclusif. La vérité de la révélation appelle la sincérité de l'adoration. Le miroir m'interroge : mon adoration est-elle exclusive ?`,
  reflection: `La vérité de la révélation appelle la sincérité de l'adoration. L'exclusivité est le cœur de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna anzalnaka al-kitaba bi-al-haqqi fa'bud Allaha mukhlisan lahu al-din » — Nous t'avons fait descendre le Livre en toute vérité. Adore donc Allah en Lui vouant un culte exclusif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon adoration est-elle exclusive ? Ou est-ce que je partage mon cœur avec d'autres divinités ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité dans l'adoration est la réponse à la vérité de la révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration exclusive est le droit d'Allah sur Sa création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah exclusivement réalise le but de sa création." }
  ],
  munajat: `Ya Allah, je T'adore exclusivement. Ne permets pas que je partage mon cœur avec d'autres. Donne-moi la sincérité de l'adoration pure.`
};

MIROIR["39:3"] = {
  reference: "39:3",
  theme: ["sincérité", "adoration", "intercession"],
  emotion: "Clarté, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Khaliq"],
  mirrorVersion: `« C'est à Allah qu'appartient la religion pure. Ceux qui prennent des protecteurs en dehors de Lui disent : "Nous ne les adorons que pour qu'ils nous rapprochent d'Allah." » Le miroir me montre l'erreur de l'intermédiaire. « Ala lillahi al-dinu al-khalisu » — c'est à Allah qu'appartient la religion pure. Les intermédiaires sont une illusion. Le miroir m'interroge : quels intermédiaires ai-je entre moi et Allah ?`,
  reflection: `La religion pure appartient à Allah seul. Les intermédiaires sont une illusion que le Coran dénonce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala lillahi al-dinu al-khalisu walladhina ittakhadhu min dunihi awliya'a ma na'buduhum illa li-yuqarribuna ila Allahi zulfan » — c'est à Allah qu'appartient la religion pure. Ceux qui prennent des protecteurs en dehors de Lui disent : Nous ne les adorons que pour qu'ils nous rapprochent d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels intermédiaires ai-je entre moi et Allah ? Sont-ils légitimes ou sont-ils des obstacles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rapprochement d'Allah passe par la suppression des intermédiaires." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah juge entre les hommes sur leurs différends concernant les intermédiaires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui supprime les intermédiaires rencontre Allah directement." }
  ],
  munajat: `Ya Wahid, je viens à Toi directement sans intermédiaire. Ne permets pas que je m'égarre dans les voies détournées. Donne-moi le rapprochement direct.`
};

MIROIR["39:4"] = {
  reference: "39:4",
  theme: ["transcendance", "unicité", "création"],
  emotion: "Émerveillement, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Khaliq"],
  mirrorVersion: `« Si Allah avait voulu prendre un enfant, Il aurait choisi ce qu'Il voulait parmi ce qu'Il crée. Gloire à Lui ! C'est Lui Allah, l'Unique, le Dominateur Suprême. » Le miroir me montre la transcendance absolue d'Allah. « Law arada Allahu an yattakhidha waladan la-stafa mimma yakhluqu ma yasha' » — si Allah avait voulu prendre un enfant, Il aurait choisi ce qu'Il voulait. Mais Sa gloire est au-dessus de cela. Le miroir m'interroge : est-ce que je conçois Allah dans Sa transcendance parfaite ?`,
  reflection: `Allah est au-dessus de toute comparaison humaine. Sa transcendance est le fondement de l'unicité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law arada Allahu an yattakhidha waladan la-stafa mimma yakhluqu ma yasha' subhanahu huwa Allahu al-wahidu al-qahhar » — si Allah avait voulu prendre un enfant, Il aurait choisi ce qu'Il voulait parmi ce qu'Il crée. Gloire à Lui ! C'est Lui Allah, l'Unique, le Dominateur Suprême." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je conçois Allah dans Sa transcendance parfaite ? Ou est-ce que Je L'imagine à mon image ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transcendance d'Allah est la libération de toute anthropomorphisme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Créateur de tout, sans besoin de progéniture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la transcendance d'Allah se libère des limites de l'imagination." }
  ],
  munajat: `Ya Subhan, Tu es au-dessus de tout ce que je peux imaginer. Ne permets pas que je Te limite. Donne-moi de Te connaître dans Ta transcendance parfaite.`
};

MIROIR["39:5"] = {
  reference: "39:5",
  theme: ["création", "nuit", "jour"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Il a créé les cieux et la terre en toute vérité. Il enroule la nuit sur le jour et enroule le jour sur la nuit. » Le miroir me montre l'harmonie de la création. « Khalaqa al-samawati wa al-arda bi-al-haqqi yukawwiru al-layla 'ala al-nahari wa yukawwiru al-nahara 'ala al-layl » — Il a créé les cieux et la terre en toute vérité. Il enroule la nuit sur le jour et le jour sur la nuit. L'alternance est un signe. Le miroir m'interroge : est-ce que je contemple les signes de la création ?`,
  reflection: `L'alternance du jour et de la nuit est un signe de la sagesse du Créateur. La contemplation sanctifie le regard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa al-samawati wa al-arda bi-al-haqqi yukawwiru al-layla 'ala al-nahari wa yukawwiru al-nahara 'ala al-layl » — Il a créé les cieux et la terre en toute vérité. Il enroule la nuit sur le jour et enroule le jour sur la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les signes de la création ? Ou est-ce que je passe à côté sans voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contemplation de la création mène à la connaissance du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alternance du jour et de la nuit est un rythme cosmique qui témoigne de la sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les signes de la création voit Allah partout." }
  ],
  munajat: `Ya Khaliq, je contemple Tes signes dans la création. Ne permets pas que je sois aveugle. Donne-moi de voir Ta sagesse dans chaque alternance.`
};

MIROIR["39:6"] = {
  reference: "39:6",
  theme: ["création", "bénevisions", "unicité"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Razzaq"],
  mirrorVersion: `« Il vous a créés d'un seul être, puis Il en a tiré son épouse. Et Il a fait descendre pour vous huit couples de bétail. » Le miroir me montre la générosité du Créateur. « Khalaqakum min nafsin wahidatin thumma ja'ala minha zawjaha wa anzala lakum min al-an'ami thamaniyata azwaj » — Il vous a créés d'un seul être, puis Il en a tiré son épouse. Et Il a fait descendre pour vous huit couples de bétail. La provision est un don. Le miroir m'interroge : est-ce que je reconnais les bienfaits ?`,
  reflection: `La création et la provision sont des dons d'Allah. La reconnaissance est la réponse du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqakum min nafsin wahidatin thumma ja'ala minha zawjaha wa anzala lakum min al-an'ami thamaniyata azwaj » — Il vous a créés d'un seul être, puis Il en a tiré son épouse. Et Il a fait descendre pour vous huit couples de bétail." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les bienfaits ? Ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des bienfaits multiplie les bénédictions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création de l'humanité à partir d'un seul être est un miracle de la puissance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les bienfaits voit la main d'Allah dans chaque détail." }
  ],
  munajat: `Ya Razzaq, je reconnais Tes bienfaits. Ne permets pas que je les oublie. Donne-moi un cœur reconnaissant pour chaque provision.`
};

MIROIR["39:7"] = {
  reference: "39:7",
  theme: ["indépendance", "mércielle", "péché"],
  emotion: "Humilité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Hamid"],
  mirrorVersion: `« Si vous êtes ingrats, Allah Se suffit à Lui-même et Il est digne de louange. » Le miroir me montre l'indépendance d'Allah. « In takfuru fa inna Allaha ghaniyyun 'ankum » — si vous êtes ingrats, Allah Se suffit à Lui-même. Mon ingratitude ne L'atteint pas. Mais Sa miséricorde m'atteint. Le miroir m'interroge : est-ce que je réalise que ma gratitude est pour mon propre bien ?`,
  reflection: `Allah Se suffit à Lui-même. Ma gratitude ou mon ingratitude ne change rien à Lui, mais change tout pour moi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In takfuru fa inna Allaha ghaniyyun 'ankum wa la yarda li'ibadihi al-kufra wa in tashkuru yardahu lakum » — si vous êtes ingrats, Allah Se suffit à Lui-même et Il n'agrée pas l'ingratitude pour Ses serviteurs. Et si vous êtes reconnaissants, Il l'agrée pour vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que ma gratitude est pour mon propre bien ? Ou est-ce que je pense rendre service à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude ne nuit qu'à l'ingrat lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Riche par excellence, et nous sommes les pauvres par essence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise l'indépendance d'Allah adore par amour, non par besoin." }
  ],
  munajat: `Ya Ghani, Tu Te suffis à Toi-même et je suis le pauvre. Ne permets pas que je sois ingrat. Donne-moi de T'adorer par amour et reconnaissance.`
};

MIROIR["39:8"] = {
  reference: "39:8",
  theme: ["détresse", "ingratitude", "mércielle"],
  emotion: "Espoir, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujib", "Al-Ghani"],
  mirrorVersion: `« Quand l'homme touche par un mal, il invoque son Seigneur en se tournant vers Lui. Puis quand Il lui accorde un bienfait de Sa part, il oublie ce qu'il invoquait auparavant. » Le miroir me montre l'inconstance humaine. « Wa idha massa al-insana darrun da'a rabbahu muniban ilayhi » — quand l'homme touche par un mal, il invoque son Seigneur. Mais quand le bien vient, il oublie. Le miroir m'interroge : est-ce que je suis constant dans ma reconnaissance ?`,
  reflection: `L'homme invoque dans la détresse et oublie dans l'aisance. La constance est la marque du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha massa al-insana darrun da'a rabbahu muniban ilayhi thumma idha khawwalahu ni'matan minhu nasiya alladhi kana da'a ilayhi » — quand l'homme touche par un mal, il invoque son Seigneur en se tournant vers Lui. Puis quand Il lui accorde un bienfait, il oublie ce qu'il invoquait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis constant dans ma reconnaissance ? Ou est-ce que j'oublie quand le bien vient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance dans la gratitude est le remède à l'oubli." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'inconstance humaine est une maladie du cœur que le Coran diagnostique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste constant dans la reconnaissance atteint la proximité divine." }
  ],
  munajat: `Ya Mujib, Tu réponds à mon invocation dans la détresse. Ne permets pas que je T'oublie dans l'aisance. Donne-moi la constance de la reconnaissance.`
};

MIROIR["39:9"] = {
  reference: "39:9",
  theme: ["science", "nuit", "méditation"],
  emotion: "Humilité, aspiration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Aziz"],
  mirrorVersion: `« Est-ce que celui qui passe ses nuits en prosternation et debout, craignant l'au-delà et espérant la miséricorde de son Seigneur... est égal à celui qui ne le fait pas ? » Le miroir me montre la différence entre le croyant sincere et l'ignorant. « Amman huwa qanitun ana' al-layli sajidan wa qa'iman yahdharu al-akhirata wa yarju rahmata rabbihi » — celui qui passe ses nuits en prosternation... est-il égal à celui qui ne le fait pas ? La question est rhétorique. Le miroir m'interroge : dans quel camp suis-je ?`,
  reflection: `La prière nocturne et la crainte de l'au-delà distinguent le croyant. L'égalité n'existe pas entre les deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amman huwa qanitun ana' al-layli sajidan wa qa'iman yahdharu al-akhirata wa yarju rahmata rabbihi qul hal yastawi alladhina ya'lamuna wa alladhina la ya'lamun » — est-ce que celui qui passe ses nuits en prosternation... est égal à celui qui ne le fait pas ? Dis : Sont-ils égaux ceux qui savent et ceux qui ne savent pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quel camp suis-je ? Celui qui prie la nuit ou celui qui dort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La différence entre les deux est la différence entre la lumière et l'obscurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seuls les détenteurs de raison se souviennent et tirent les leçons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe ses nuits en adoration connaît des secrets que l'ignorant ignore." }
  ],
  munajat: `Ya Alim, je veux être parmi ceux qui passent leurs nuits en adoration. Ne permets pas que je sois parmi les ignorants. Donne-moi la science qui mène à l'action.`
};

MIROIR["39:10"] = {
  reference: "39:10",
  theme: ["piété", "promesse", "bénefaite"],
  emotion: "Espoir, réconfort",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Haqq"],
  mirrorVersion: `« Dis : Ô Mes serviteurs qui avez cru ! Craignez votre Seigneur. Ceux qui font le bien ici-bas auront une bonne récompense. » Le miroir me montre la promesse divine. « Qul ya 'ibadi alladhina amanu ittaqu rabbakum » — dis : Ô Mes serviteurs qui avez cru ! Craignez votre Seigneur. La crainte précède la récompense. Le miroir m'interroge : est-ce que je crains Allah comme Il le mérite ?`,
  reflection: `La crainte d'Allah ouvre la porte de la bonne récompense. La terre d'Allah est vaste pour ceux qui craignent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya 'ibadi alladhina amanu ittaqu rabbakum lilladhina ahsanu fi hadhihi al-dunya hasanatun wa ardu Allahi wasi'atun » — dis : Ô Mes serviteurs qui avez cru ! Craignez votre Seigneur. Ceux qui font le bien ici-bas auront une bonne récompense. La terre d'Allah est vaste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah comme Il le mérite ? Ou est-ce que ma crainte est faible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah est la clé de toutes les ouvertures." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre d'Allah est vaste pour ceux quicraignent et patientent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah vraiment reçoit une récompense sans mesure." }
  ],
  munajat: `Ya Wali, je crains Ton châtiment et j'espère Ta récompense. Ne permets pas que je sois parmi les négligents. Donne-moi de faire le bien et d'obtenir la bonne récompense.`
};

// ============ SURAH 14 (IBRAHIM) - Missing Entries ============

MIROIR["14:16"] = {
  reference: "14:16",
  theme: ["enfer", "jugement", "mécréance"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Jahannam"],
  mirrorVersion: `« Derrière lui, il y a l'Enfer, et il sera abreuvé d'une eau purulente. » Le miroir me montre le destin de ceux qui rejettent la vérité. « Min wara'ihi jahannam » — derrière lui, il y a l'Enfer. La mécréance n'est pas sans conséquences. Le miroir m'interroge : est-ce que je prends au sérieux la réalité de l'au-delà ?`,
  reflection: `L'Enfer attend ceux qui rejettent la vérité. La prise au sérieux de l'au-delà est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min wara'ihi jahannam wa yusqa min ma'in sadid » — derrière lui, il y a l'Enfer, et il sera abreuvé d'une eau purulente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux la réalité de l'au-delà ? Ou est-ce que je vis comme si cette vie était éternelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de l'au-delà transforme le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a une conséquence dans l'au-delà." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend l'au-delà au sérieux transforme sa vie." }
  ],
  munajat: `Ya Rabb, je prends au sérieux la réalité de l'au-delà. Ne permets pas que je vive comme si cette vie était éternelle. Donne-moi la conscience de Ta justice.`
};

MIROIR["14:17"] = {
  reference: "14:17",
  theme: ["châtiment", "enfer", "impossibilité"],
  emotion: "Mise en garde, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nar", "Al-Qahhar"],
  mirrorVersion: `« Il essaye de l'avaler, mais ne peut le faire. La mort lui viendra de toutes parts, mais il ne mourra pas. » Le miroir me montre l'intensité du châtiment. « Yatasajjahu » — il essaye de l'avaler. La soif est insupportable mais l'eau est impossible à boire. Le miroir m'interroge : est-ce que je crains un tel destin ?`,
  reflection: `Le châtiment est proportionnel au rejet. La mort même est refusée comme échappatoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatasajjahu wa la yukadu yusighuhu wa ya'tihi al-mawtu min kulli makanin wa ma huwa bi-mayyit » — il essaye de l'avaler, mais ne peut le faire. La mort lui viendra de toutes parts, mais il ne mourra pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains un tel destin ? Ou est-ce que je suis indifférent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience du châtiment éloigne de la mécréance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine atteint toujours les obstinés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment évite ce qui y mène." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Ne permets pas que je sois indifférent. Protège-moi de tout ce qui mène à l'Enfer.`
};

MIROIR["14:18"] = {
  reference: "14:18",
  theme: ["œuvres", "vanité", "mécréance"],
  emotion: "Réalité, déception",
  difficulty: "débutant",
  relatedNames: ["Al-A'mal", "Al-Hisab"],
  mirrorVersion: `« Les œuvres de ceux qui ont mécru en leur Seigneur sont comme de la cendre que le vent souffle avec violence. » Le miroir me montre la vanité des œuvres sans foi. « Ka-ramadin ishtaddat bihi al-rih » — comme de la cendre que le vent souffle avec violence. Les œuvres sans foi s'envolent. Le miroir m'interroge : est-ce que mes œuvres sont accompagnées de foi ?`,
  reflection: `Les œuvres sans foi sont vaines. La foi donne valeur aux œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalu alladhina kafaru bi-rabbihim a'maluhum ka-ramadin ishtaddat bihi al-rih » — les œuvres de ceux qui ont mécru en leur Seigneur sont comme de la cendre que le vent souffle avec violence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes œuvres sont accompagnées de foi ? Ou sont-elles vides de sens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi transforme les œuvres en trésors éternels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seules les œuvres avec foi ont valeur auprès d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre avec foi construit pour l'éternité." }
  ],
  munajat: `Ya Rabb, je veux que mes œuvres soient accompagnées de foi. Ne permets pas qu'elles soient vides de sens. Donne valeur à mes efforts par ma sincérité.`
};

MIROIR["14:19"] = {
  reference: "14:19",
  theme: ["création", "témérité", "vérité"],
  emotion: "Certitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« N'as-tu pas vu qu'Allah a créé les cieux et la terre avec vérité ? » Le miroir me montre la grandeur de la création. « Alam tara anna Allaha khalaqa al-samawati wa al-arda bi-al-haqq » — n'as-tu pas vu qu'Allah a créé les cieux et la terre avec vérité. La création n'est pas un jeu. Le miroir m'interroge : est-ce que je contemple la création comme signe ?`,
  reflection: `La création est un signe de vérité. La contemplation mène à la reconnaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna Allaha khalaqa al-samawati wa al-arda bi-al-haqq » — n'as-tu pas vu qu'Allah a créé les cieux et la terre avec vérité ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple la création comme signe ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contemplation de la création mène à la connaissance du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création témoigne de la vérité d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la création découvre le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu as créé les cieux et la terre avec vérité. Ouvre mes yeux à la contemplation. Fais que je Te découvre dans Tes signes.`
};

MIROIR["14:20"] = {
  reference: "14:20",
  theme: ["transformation", "volonté", "création"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Mutakabbir"],
  mirrorVersion: `« S'Il veut, Il vous fera disparaître et fera venir de nouvelles créatures. » Le miroir me montre la puissance absolue d'Allah. « In yasha' yudhhibkum » — s'Il veut, Il vous fera disparaître. Ma présence n'est pas nécessaire à la création. Le miroir m'interroge : est-ce que je reconnais ma totale dépendance ?`,
  reflection: `Ma présence dépend entièrement de Sa volonté. L'humilité est la reconnaissance de cette dépendance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yasha' yudhhibkum wa ya'ti bi-khalqin jadid » — s'Il veut, Il vous fera disparaître et fera venir de nouvelles créatures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ma totale dépendance ? Ou est-ce que je me crois indispensable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de ma fragilité m'attire Sa miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah n'a besoin de rien, nous avons besoin de Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se reconnaît dépendant est indépendant par Allah." }
  ],
  munajat: `Ya Rabb, je reconnais ma totale dépendance. Ne permets pas l'arrogance dans mon cœur. Fais que je vive dans l'humilité de ma fragilité.`
};

MIROIR["14:21"] = {
  reference: "14:21",
  theme: ["jugement", "regret", "responsabilité"],
  emotion: "Réalité, remise en question",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hisab", "Al-Muta'al"],
  mirrorVersion: `« Ils comparaîtront tous devant Allah. Les faibles diront à ceux qui s'enorgueillissaient : "Nous vous avons suivis. Pouvez-vous nous être d'une quelconque utilité contre le châtiment d'Allah ?" » Le miroir me montre le jour où les excuses ne serviront à rien. « Barazu li-Allahi jami'an » — ils comparaîtront tous devant Allah. Le suivisme aura des conséquences. Le miroir m'interroge : qui est-ce que je suis vraiment ?`,
  reflection: `Le suivisme aveugle mène au regret. La responsabilité personnelle est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa barazu li-Allahi jami'an fa-qala al-du'afa'u li-alladhina istakbaru » — ils comparaîtront tous devant Allah. Les faibles diront à ceux qui s'enorgueillissaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je suis vraiment ? Est-ce que je suis la vérité ou les gens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai leader mène à Allah, pas à lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun est responsable de ses choix de suivi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Allah n'a pas à regretter son suivi." }
  ],
  munajat: `Ya Rabb, je veux Te suivre et non les gens. Ne permets pas que je sois du nombre de ceux qui suivent aveuglément. Guide-moi par la vérité.`
};

MIROIR["14:22"] = {
  reference: "14:22",
  theme: ["satan", "tromperie", "regret"],
  emotion: "Mise en garde, clarté",
  difficulty: "débutant",
  relatedNames: ["Ash-Shaytan", "Al-Khadim"],
  mirrorVersion: `« Et quand le destin sera décidé, Satan dira : "Allah vous a fait une vraie promesse, et moi je vous ai fait une fausse promesse." » Le miroir me montre la vérité sur Satan. « Wa qala al-shaytanu lamma qudiya al-amru » — et quand le destin sera décidé, Satan dira. Sa tromperie sera exposée. Le miroir m'interroge : est-ce que je me laisse tromper par ses fausses promesses ?`,
  reflection: `Satan est l'ennemi déclaré. Ses promesses sont fausses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala al-shaytanu lamma qudiya al-amru inna Allaha wa'adakum wa'da al-haqqi wa wa'attukum fa-akhlaftukum » — et quand le destin sera décidé, Satan dira : Allah vous a fait une vraie promesse, et moi je vous ai fait une fausse promesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse tromper par les fausses promesses ? Ou est-ce que je reconnais la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'ennemi protège de sa tromperie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Satan est l'ennemi de l'humanité depuis le début." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les ruses de Satan les évite." }
  ],
  munajat: `Ya Rabb, je ne veux pas être trompé par Satan. Protège-moi de ses ruses. Fais que je reconnaisse la vérité de Tes promesses.`
};

MIROIR["14:23"] = {
  reference: "14:23",
  theme: ["paradis", "foi", "récompense"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Mu'minun"],
  mirrorVersion: `« Ceux qui ont cru et accompli de bonnes œuvres seront introduits dans des jardins sous lesquels coulent les rivières. » Le miroir me montre la récompense des croyants. « Wa udkhila alladhina amanu wa 'amilu al-salihati jannatin tajri » — ceux qui ont cru et accompli de bonnes œuvres seront introduits. La foi et les œuvres mènent au paradis. Le miroir m'interroge : est-ce que je travaille pour cette récompense ?`,
  reflection: `La foi et les œuvres sont les clés du paradis. L'espoir motive l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa udkhila alladhina amanu wa 'amilu al-salihati jannatin tajri min tahtiha al-anharu khalidina fiha » — ceux qui ont cru et accompli de bonnes œuvres seront introduits dans des jardins sous lesquels coulent les rivières, pour y demeurer éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille pour cette récompense ? Ou est-ce que je néglige mes obligations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir du paradis transforme les efforts en investissements." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis est la destination des croyants sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le paradis y entre." }
  ],
  munajat: `Ya Rabb, je veux entrer dans Ton paradis. Ne permets pas que je néglige mes obligations. Donne-moi la foi et les œuvres qui y mènent.`
};

MIROIR["14:25"] = {
  reference: "14:25",
  theme: ["parabole", "bonne parole", "fruits"],
  emotion: "Espérance, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Kalimah", "Ath-Thamarah"],
  mirrorVersion: `« Elle donne ses fruits à chaque saison, par la permission de son Seigneur. » Le miroir me montre la fécondité de la bonne parole. « Tu'ti ukulaha kulla hinin » — elle donne ses fruits à chaque saison. La bonne parole est constamment productive. Le miroir m'interroge : est-ce que ma parole est bonne et féconde ?`,
  reflection: `La bonne parole est féconde en tout temps. La persévérance dans le bien porte ses fruits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tu'ti ukulaha kulla hinin bi-idhni rabbih » — elle donne ses fruits à chaque saison, par la permission de son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma parole est bonne et féconde ? Ou est-ce qu'elle est vide et stérile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne parole transforme l'environnement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole bonne et sincère est bénie par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive la bonne parole récolte ses fruits." }
  ],
  munajat: `Ya Rabb, je veux que ma parole soit bonne et féconde. Bénis mes paroles et fais qu'elles portent des fruits en tout temps.`
};

MIROIR["14:26"] = {
  reference: "14:26",
  theme: ["parabole", "mauvaise parole", "racine"],
  emotion: "Mise en garde, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Kalimah", "As-Sayyi'ah"],
  mirrorVersion: `« Et la mauvaise parole est comme un mauvais arbre, déraciné de la surface de la terre et qui n'a point de stabilité. » Le miroir me montre la fragilité de la mauvaise parole. « Wa mathalu kalimatin khabithatin » — et la mauvaise parole est comme un mauvais arbre. Elle n'a pas de fondation solide. Le miroir m'interroge : est-ce que j'évite les mauvaises paroles ?`,
  reflection: `La mauvaise parole n'a pas de fondation. Elle s'effondre tôt ou tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mathalu kalimatin khabithatin ka-shajaratin khabithatin ijtuththat min fawqi al-ardi ma laha min qarar » — et la mauvaise parole est comme un mauvais arbre, déraciné de la surface de la terre et qui n'a point de stabilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite les mauvaises paroles ? Ou est-ce que je les laisse sortir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement des mauvaises paroles purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mauvaise parole finit par s'effondrer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les mauvaises paroles préserve son cœur." }
  ],
  munajat: `Ya Rabb, je veux éviter les mauvaises paroles. Protège ma langue du mal. Fais que mes paroles soient bonnes et stables.`
};

MIROIR["14:27"] = {
  reference: "14:27",
  theme: ["stabilité", "foi", "vie", "mort"],
  emotion: "Confiance, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Thabit", "Al-Mu'min"],
  mirrorVersion: `« Allah affermit ceux qui ont cru par une parole ferme dans la vie présente et dans l'au-delà. » Le miroir me montre la stabilité accordée aux croyants. « Yuthabbitu Allahu alladhina amanu bi-al-qawli al-thabit » — Allah affermit ceux qui ont cru par une parole ferme. La foi apporte la stabilité. Le miroir m'interroge : est-ce que je cherche ma stabilité dans la foi ?`,
  reflection: `La foi apporte la stabilité dans cette vie et l'au-delà. La fermeté est un don d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuthabbitu Allahu alladhina amanu bi-al-qawli al-thabiti fi al-hayati al-dunya wa fi al-akhirah » — Allah affermit ceux qui ont cru par une parole ferme dans la vie présente et dans l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche ma stabilité dans la foi ? Ou est-ce que je la cherche ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stabilité dans la foi transcende les épreuves." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fermeté dans la foi est accordée aux croyants sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la stabilité dans la foi la trouve." }
  ],
  munajat: `Ya Rabb, je cherche ma stabilité dans la foi. Affermis-moi par Ta parole ferme. Ne permets pas que je sois instable dans ma conviction.`
};

MIROIR["14:28"] = {
  reference: "14:28",
  theme: ["ingratitude", "miséricorde", "conséquences"],
  emotion: "Mise en garde, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ni'mah", "Al-Kufr"],
  mirrorVersion: `« N'as-tu pas vu ceux qui troquent les bienfaits d'Allah contre la mécréance ? » Le miroir me montre l'ingratitude des hommes. « Alam tara ila alladhina baddalu ni'mata Allahi kufran » — n'as-tu pas vu ceux qui troquent les bienfaits d'Allah contre la mécréance. L'ingratitude est un mauvais échange. Le miroir m'interroge : est-ce que je suis reconnaissant pour les bienfaits ?`,
  reflection: `L'ingratitude est un mauvais échange. La reconnaissance des bienfaits est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara ila alladhina baddalu ni'mata Allahi kufran wa ahaqqa bi-qawmihim dara al-bawar » — n'as-tu pas vu ceux qui troquent les bienfaits d'Allah contre la mécréance et qui font périr leur peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les bienfaits ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des bienfaits attire plus de bienfaits." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ingratitude mène à la perte des bienfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant préserve et augmente ses bienfaits." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour Tes bienfaits. Ne permets pas l'ingratitude dans mon cœur. Fais que je les reconnaisse et les préserve.`
};

MIROIR["39:11"] = {
  reference: "39:11",
  theme: ["adoration", "sincérité", "obéissance"],
  emotion: "Dévotion, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Dis : Il m'a été ordonné d'adorer Allah en Lui vouant un culte exclusif. » Le miroir me montre l'ordre divin. « Qul inni umirtu an a'buda Allaha mukhlisan lahu al-din » — dis : Il m'a été ordonné d'adorer Allah en Lui vouant un culte exclusif. L'exclusivité est un ordre, pas une option. Le miroir m'interroge : est-ce que mon adoration est exclusive ?`,
  reflection: `L'adoration exclusive est un ordre divin. La sincérité est la clé de l'acceptation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inni umirtu an a'buda Allaha mukhlisan lahu al-din » — dis : Il m'a été ordonné d'adorer Allah en Lui vouant un culte exclusif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon adoration est exclusive ? Ou est-ce que je partage mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité de l'adoration est le secret de l'acceptation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration exclusive est le droit d'Allah sur chaque créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore exclusivement Allah réalise le but de son existence." }
  ],
  munajat: `Ya Haqq, je T'adore exclusivement. Ne permets pas que je partage mon adoration. Donne-moi la sincérité totale dans mon culte.`
};

MIROIR["39:12"] = {
  reference: "39:12",
  theme: ["soumission", "islam", "obéissance"],
  emotion: "Soumission, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Muslim", "Ar-Rabb"],
  mirrorVersion: `« Et il m'a été ordonné d'être le premier des soumis. » Le miroir me montre la priorité dans la soumission. « Wa umirtu li-akuna awwala al-muslimin » — et il m'a été ordonné d'être le premier des soumis. La soumission est un honneur. Le miroir m'interroge : suis-je parmi les soumis ?`,
  reflection: `Être le premier des soumis est un honneur. La soumission à Allah est le chemin de la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa umirtu li-akuna awwala al-muslimin » — et il m'a été ordonné d'être le premier des soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les soumis ? Ou est-ce que je résiste encore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission est le chemin de la liberté véritable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le premier des soumis montre le chemin à tous les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet totalement à Allah trouve la paix totale." }
  ],
  munajat: `Ya Rabb, je me soumets à Toi. Ne permets pas que je résiste. Donne-moi d'être parmi les soumis sincères.`
};

MIROIR["39:13"] = {
  reference: "39:13",
  theme: ["châtiment", "grandeur", "mise en garde"],
  emotion: "Crainte révérencielle",
  difficulty: "débutant",
  relatedNames: ["Al-Azim", "Al-Kabir"],
  mirrorVersion: `« Dis : Je crains, si je désobéis à mon Seigneur, le châtiment d'un jour immense. » Le miroir me montre la crainte du Prophète lui-même. « Qul inni akhafu in 'asaytu rabbi 'adhaba yawmin 'azim » — dis : Je crains, si je désobéis à mon Seigneur, le châtiment d'un jour immense. Si le Prophète craint, que dire de moi ? Le miroir m'interroge : quelle est ma crainte d'Allah ?`,
  reflection: `Le Prophète lui-même craint le châtiment d'un jour immense. Sa crainte est un exemple pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inni akhafu in 'asaytu rabbi 'adhaba yawmin 'azim » — dis : Je crains, si je désobéis à mon Seigneur, le châtiment d'un jour immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma crainte d'Allah ? Est-elle comparable à celle du Prophète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment est le moteur de l'obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour immense est le Jour du Jugement où tous comparaîtront." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment dans ce monde sera sauvé dans l'autre." }
  ],
  munajat: `Ya Azim, je crains Ton châtiment. Ne permets pas que je sois insouciant. Donne-moi la crainte qui mène à l'obéissance.`
};

MIROIR["39:14"] = {
  reference: "39:14",
  theme: ["adoration", "exclusivité", "mort"],
  emotion: "Dévotion totale",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Qayyum"],
  mirrorVersion: `« Dis : C'est Allah que j'adore en Lui vouant exclusivement mon culte. » Le miroir me montre l'exclusivité absolue. « Qul Allaha a'budu mukhlisan lahu dini » — dis : C'est Allah que j'adore en Lui vouant exclusivement mon culte. Mon culte est pour Lui seul. Le miroir m'interroge : à qui appartient mon cœur ?`,
  reflection: `L'adoration exclusive est la declaration de foi pure. Le cœur ne doit appartenir qu'à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul Allaha a'budu mukhlisan lahu dini » — dis : C'est Allah que j'adore en Lui vouant exclusivement mon culte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui appartient mon cœur ? Est-ce qu'il appartient à Allah exclusivement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité du cœur est la vraie richesse spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration exclusive est le pacte primordial entre Allah et l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur appartient exclusivement à Allah ne craint personne d'autre." }
  ],
  munajat: `Ya Wahid, mon cœur T'appartient exclusivement. Ne permets pas qu'il soit partagé. Donne-moi l'exclusivité de l'adoration.`
};

MIROIR["39:15"] = {
  reference: "39:15",
  theme: ["liberté", "mésiance", "châtiment"],
  emotion: "Liberté, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hakam"],
  mirrorVersion: `« Adorez ce que vous voulez en dehors de Lui ! » Le miroir me montre la liberté de choix. « Fa'budu ma shi'tum min dunihi » — adorez ce que vous voulez en dehors de Lui. La liberté est donnée, mais les conséquences suivent. Le miroir m'interroge : quel est mon choix ?`,
  reflection: `La liberté de choix est donnée, mais les conséquences sont inévitables. Le choix appartient à chacun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'budu ma shi'tum min dunihi qul inna al-khasirina alladhina khasiru anfusahum wa ahlihim yawma al-qiyamati » — adorez ce que vous voulez en dehors de Lui ! Dis : Les perdants sont ceux qui se perdent eux-mêmes et leurs familles le Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon choix ? Est-ce que je choisis Allah ou d'autres divinités ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix de la bonne voie est le gain éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les perdants sont ceux qui choisissent les idoles au lieu d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit Allah ne perd jamais." }
  ],
  munajat: `Ya Khaliq, je Te choisis Toi seul. Ne permets pas que je choisisse d'autres que Toi. Donne-moi la guidance du bon choix.`
};

MIROIR["39:16"] = {
  reference: "39:16",
  theme: ["enfer", "châtiment", "mise en garde"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jalil", "Al-Qahhar"],
  mirrorVersion: `« Ils auront au-dessus d'eux des voiles de feu et au-dessous d'eux des voiles de feu. » Le miroir me montre l'enfer des perdants. « Lahum min fawqihim zulalun min al-nari wa min tahtihim zulalun » — ils auront au-dessus d'eux des voiles de feu et au-dessous d'eux des voiles de feu. L'image est terrifiante. Le miroir m'interroge : est-ce que je crains ce châtiment ?`,
  reflection: `L'enfer est une réalité pour les perdants. La crainte de ce châtiment doit motiver l'obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum min fawqihim zulalun min al-nari wa min tahtihim zulalun » — ils auront au-dessus d'eux des voiles de feu et au-dessous d'eux des voiles de feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce châtiment ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte de l'enfer est le moteur de l'évitement des péchés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah effraie Ses serviteurs pour qu'ils se réveillent de leur insouciance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'enfer dans ce monde ne le verra pas dans l'autre." }
  ],
  munajat: `Ya Jalil, je crains Ton châtiment. Ne permets pas que je sois insouciant. Donne-moi la crainte qui mène au salut.`
};

MIROIR["39:17"] = {
  reference: "39:17",
  theme: ["guidance", "bonne nouvelle", "liberté"],
  emotion: "Espoir, réjouissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Bashir"],
  mirrorVersion: `« Annonce la bonne nouvelle à Mes serviteurs qui écoutent la parole et suivent ce qu'elle a de meilleur. » Le miroir me montre la récompense des écoutants. « Wa alladhina ijtanaba al-taghuuta an ya'buduha wa anabu ila Allahi lahum al-bushra » — ceux qui évitent le culte des idoles et reviennent à Allah, à eux la bonne nouvelle. Le miroir m'interroge : suis-je parmi ces serviteurs ?`,
  reflection: `Éviter les idoles et revenir à Allah mérite la bonne nouvelle. L'écoute de la parole est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina ijtanaba al-taghuuta an ya'buduha wa anabu ila Allahi lahum al-bushra fabashshir 'ibad » — ceux qui évitent le culte des idoles et reviennent à Allah, à eux la bonne nouvelle. Annonce-la à Mes serviteurs !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi ces serviteurs qui évitent les idoles et reviennent à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour à Allah est la plus belle des nouvelles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La bonne nouvelle est pour ceux qui écoutent et suivent le meilleur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la bonne nouvelle dans ce monde sera parmi les heureux dans l'autre." }
  ],
  munajat: `Ya Bashir, annonce-moi la bonne nouvelle. Ne permets pas que je sois parmi les perdants. Donne-moi d'écouter Ta parole et de suivre le meilleur.`
};

MIROIR["39:18"] = {
  reference: "39:18",
  theme: ["écoute", "obéissance", "guidance"],
  emotion: "Sagesse, réjouissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Rashid"],
  mirrorVersion: `« Ceux qui écoutent la parole et suivent ce qu'elle a de meilleur. Ce sont eux qu'Allah a guidés. » Le miroir me montre le critère de la guidance. « Alladhina yastami'una al-qawla fa-yattabi'una ahsanahu » — ceux qui écoutent la parole et suivent ce qu'elle a de meilleur. La guidance suit l'écoute et le suivi du meilleur. Le miroir m'interroge : suis-je parmi les guidés ?`,
  reflection: `Écouter et suivre le meilleur est le chemin de la guidance. Allah guide ceux qui font cela.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yastami'una al-qawla fa-yattabi'una ahsanahu ula'ika alladhina hadahumu Allahu wa ula'ika hum ulu al-albab » — ceux qui écoutent la parole et suivent ce qu'elle a de meilleur. Ce sont eux qu'Allah a guidés. Ce sont eux les doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les guidés qui écoutent et suivent le meilleur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance n'est pas un don passif, elle suit une action : écouter et suivre le meilleur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les doués d'intelligence sont ceux qui écoutent et suivent le meilleur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute vraiment et suit le meilleur atteint la guidance parfaite." }
  ],
  munajat: `Ya Hadi, je veux être parmi les guidés. Ne permets pas que je sois sourd à Ta parole. Donne-moi d'écouter et de suivre le meilleur.`
};

MIROIR["39:19"] = {
  reference: "39:19",
  theme: ["châtiment", "indignation", "question"],
  emotion: "Crainte, interrogation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Adl"],
  mirrorVersion: `« Celui contre qui la parole de ton Seigneur s'est réalisée, peux-tu le sauver du feu ? » Le miroir me montre la réalité du décret. « Afaman haqqa 'alayhi kalimatu rabbika » — celui contre qui la parole de ton Seigneur s'est réalisée. Le décret divin est irréversible. Le miroir m'interroge : suis-je concerné par ce décret ?`,
  reflection: `Le décret divin s'accomplit sur ceux qui méritent le châtiment. Nul ne peut sauver celui qui est condamné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaman haqqa 'alayhi kalimatu rabbika afa anta tunqidhu man fi al-nar » — celui contre qui la parole de ton Seigneur s'est réalisée, peux-tu le sauver du feu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je concerné par ce décret de châtiment ? Ou suis-je parmi les sauvés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le décret divin ne peut être changé, mais on peut changer avant qu'il ne s'accomplisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah s'accomplit toujours, que ce soit en bien ou en mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le décret négatif œuvre pour changer son destin." }
  ],
  munajat: `Ya Hakam, je crains Ton décret. Ne permets pas que je sois parmi les condamnés. Donne-moi d'œuvrer pour changer mon destin avant qu'il ne soit scellé.`
};

MIROIR["39:20"] = {
  reference: "39:20",
  theme: ["paradis", "récompense", "espérance"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wadud"],
  mirrorVersion: `« Mais ceux qui ont craint leur Seigneur auront des chambres avec d'autres chambres au-dessus, sous lesquelles coulent les rivières. » Le miroir me montre la récompense des craignants. « Lakin alladhina ittaqaw rabbahum lahum ghurafun min fawqiha ghurafun mabniyyatun tajri min tahtiha al-anhar » — ceux qui ont craint leur Seigneur auront des chambres superposées sous lesquelles coulent les rivières. L'image est magnifique. Le miroir m'interroge : est-ce que j'aspire à ces chambres ?`,
  reflection: `La crainte d'Allah dans ce monde mène aux chambres du paradis dans l'autre. La récompense est à la mesure de la crainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakin alladhina ittaqaw rabbahum lahum ghurafun min fawqiha ghurafun mabniyyatun tajri min tahtiha al-anhar wa'da Allahi » — mais ceux qui ont craint leur Seigneur auront des chambres avec d'autres chambres au-dessus, sous lesquelles coulent les rivières. Promesse d'Allah !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à ces chambres du paradis ? Ou est-ce que je néglige la crainte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte dans ce monde mène aux chambres dans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah ne manque pas à Sa promesse pour ceux qui craignent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint vraiment Allah obtient la plus belle récompense." }
  ],
  munajat: `Ya Karim, j'aspire aux chambres du paradis. Ne permets pas que je néglige la crainte. Donne-moi de Te craindre et d'obtenir Ta promesse.`
};

MIROIR["39:21"] = {
  reference: "39:21",
  theme: ["création", "signes", "résurrection"],
  emotion: "Émerveillement, méditation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« N'as-tu pas vu qu'Allah a fait descendre du ciel une eau, puis Il l'a fait jaillir en sources dans la terre ? » Le miroir me montre le cycle de l'eau comme signe. « Alam tara anna Allaha anzala mina al-sama'i ma'an fasalakahu yanabi'a fi al-ard » — n'as-tu pas vu qu'Allah a fait descendre du ciel une eau, puis Il l'a fait jaillir en sources dans la terre ? Le signe est clair. Le miroir m'interroge : est-ce que je médite sur les signes ?`,
  reflection: `Le cycle de l'eau est un signe de la résurrection. La méditation sur les signes mène à la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna Allaha anzala mina al-sama'i ma'an fasalakahu yanabi'a fi al-ard thumma yukhriju bihi zar'an mukhtalifan alwanuhu » — n'as-tu pas vu qu'Allah a fait descendre du ciel une eau, puis Il l'a fait jaillir en sources dans la terre ? Puis Il en fait sortir des récoltes aux couleurs différentes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les signes de la création ? Ou est-ce que je passe sans voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation sur la création mène à la compréhension de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort et la vie de la terre sont un signe de la mort et vie de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur le cycle de l'eau comprend le cycle de la vie." }
  ],
  munajat: `Ya Muhyi, je médite sur Tes signes. Ne permets pas que je sois aveugle. Donne-moi de comprendre la résurrection à travers Ta création.`
};

MIROIR["39:22"] = {
  reference: "39:22",
  theme: ["cœur", "islam", "lumière"],
  emotion: "Paix, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Nur", "Al-Hadi"],
  mirrorVersion: `« Celui dont Allah a ouvert le cœur à l'Islam est-il dans une lumière venant de son Seigneur ? » Le miroir me montre le don de l'ouverture du cœur. « Afaman sharaha Allahu sadrahu li-il-islami fa-huwa 'ala nurin min rabbihi » — celui dont Allah a ouvert le cœur à l'Islam est sur une lumière venant de son Seigneur. L'ouverture du cœur est un don. Le miroir m'interroge : mon cœur est-il ouvert à l'Islam ?`,
  reflection: `L'ouverture du cœur à l'Islam est un don divin. La lumière qui en résulte est la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaman sharaha Allahu sadrahu li-il-islami fa-huwa 'ala nurin min rabbihi » — celui dont Allah a ouvert le cœur à l'Islam est-il dans une lumière venant de son Seigneur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il ouvert à l'Islam ? Ou est-il fermé et endurci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture du cœur est la condition de la lumière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Malheur à ceux dont les cœurs sont endurcis contre le rappel d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est ouvert vit dans la lumière permanente." }
  ],
  munajat: `Ya Nur, ouvre mon cœur à l'Islam. Ne permets pas qu'il soit endurci. Donne-moi la lumière de la guidance.`
};

MIROIR["39:23"] = {
  reference: "39:23",
  theme: ["coran", "révélation", "beauté"],
  emotion: "Émerveillement, émotion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Hamid"],
  mirrorVersion: `« Allah a fait descendre le plus beau des récits, un Livre dont certains versets se ressemblent et se répètent. » Le miroir me montre la beauté du Coran. « Allahu nazzala ahsana al-hadithi kitaban mutashabihan mathaniya » — Allah a fait descendre le plus beau des récits. La beauté est dans l'harmonie. Le miroir m'interroge : est-ce que je ressens la beauté du Coran ?`,
  reflection: `Le Coran est le plus beau des récits. Sa beauté fait frissonner les peaux de ceux qui craignent Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu nazzala ahsana al-hadithi kitaban mutashabihan mathaniya taqsha'irru minhu juludu alladhina yakhshawna rabbahum » — Allah a fait descendre le plus beau des récits, un Livre dont certains versets se ressemblent et se répètent. Les peaux de ceux qui craignent leur Seigneur frissonnent à l'entendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je ressens la beauté du Coran ? Ma peau frissonne-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le frisson de la peau est le signe du cœur vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la parole d'Allah, le plus beau des récits révélés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont la peau frissonne à l'écoute du Coran a le cœur éveillé." }
  ],
  munajat: `Ya Hakim, fais-moi ressentir la beauté de Ton Coran. Ne permets pas que mon cœur soit froid. Donne-moi le frisson de la crainte et de l'amour.`
};

MIROIR["39:24"] = {
  reference: "39:24",
  theme: ["protection", "châtiment", "comparaison"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Jabbar"],
  mirrorVersion: `« Celui qui se protégera de son visage contre le pire châtiment le Jour de la Résurrection... est-il comme celui qui se protège par de bonnes œuvres ? » Le miroir me montre l'importance de la protection. « Afaman yattaqi bi-wajhihi su'a al-adhabi yawma al-qiyamati » — celui qui se protégera de son visage contre le pire châtiment. L'image est saisissante. Le miroir m'interroge : comment me protège-je ?`,
  reflection: `Se protéger du châtiment par les bonnes œuvres est la vraie protection. La comparaison est frappante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaman yattaqi bi-wajhihi su'a al-adhabi yawma al-qiyamati wa qila lil-zalimina dhuqu ma kuntum taksibun » — celui qui se protégera de son visage contre le pire châtiment le Jour de la Résurrection... Et il sera dit aux injustes : Goûtez ce que vous avez acquis !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment me protège-je du châtiment ? Par les bonnes œuvres ou par la négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection par les bonnes œuvres est la seule protection valable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les injustes goûteront le fruit de leurs actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se protège par les bonnes œuvres sera protégé." }
  ],
  munajat: `Ya Hafiz, protège-moi du châtiment. Ne permets pas que je sois parmi les injustes. Donne-moi de me protéger par les bonnes œuvres.`
};

MIROIR["39:25"] = {
  reference: "39:25",
  theme: ["mésiance", "châtiment", "leçons"],
  emotion: "Mise en garde, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Hakam"],
  mirrorVersion: `« Ceux qui ont vécu avant eux ont crié au mensonge, et le châtiment leur est venu par où ils ne le soupçonnaient pas. » Le miroir me montre l'histoire des négateurs. « Kadhdhaba alladhina min qablihim fa-atahum al-adhabu min haythu la yash'urun » — ceux qui ont vécu avant eux ont crié au mensonge, et le châtiment leur est venu par où ils ne le soupçonnaient pas. L'histoire est un avertissement. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire des peuples passés est un avertissement. Le châtiment vient de là où on ne l'attend pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhaba alladhina min qablihim fa-atahum al-adhabu min haythu la yash'urun » — ceux qui ont vécu avant eux ont crié au mensonge, et le châtiment leur est venu par où ils ne le soupçonnaient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les mêmes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage de l'histoire est la protection contre la répétition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment vient souvent de là où on ne l'attend pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs du passé." }
  ],
  munajat: `Ya Adl, je Tire les leçons de l'histoire. Ne permets pas que je sois parmi les négateurs. Donne-moi la sagesse de l'apprentissage.`
};

MIROIR["14:29"] = {
  reference: "14:29",
  theme: ["enfer", "consequences", "destination"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Jahannam"],
  mirrorVersion: `« Ils sont entrés dans l'Enfer et quelle mauvaise demeure ! » Le miroir me montre la destination des ingrats. « Jahannam wa sa'at mahqir » — l'Enfer et quelle mauvaise demeure. L'ingratitude a une conséquence terrible. Le miroir m'interroge : est-ce que je crains cette destination ?`,
  reflection: `L'ingratitude mène à l'Enfer. La peur de cette destination motive la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jahannam wa sa'at mahqir » — l'Enfer et quelle mauvaise demeure !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains cette destination ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de l'Enfer éloigne de l'ingratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque ingratitude est un pas vers cette destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer évite ce qui y mène." }
  ],
  munajat: `Ya Rabb, je crains l'Enfer. Ne permets pas que j'y entre. Protège-moi de l'ingratitude qui y mène.`
};

MIROIR["14:30"] = {
  reference: "14:30",
  theme: ["associés", "égarement", "chemin"],
  emotion: "Mise en garde, clarté",
  difficulty: "débutant",
  relatedNames: ["Ash-Shirk", "Ad-Dalal"],
  mirrorVersion: `« Ils ont donné à Allah des égaux afin d'égarer les hommes de Son chemin. » Le miroir me montre l'objectif des associateurs. « Wa ja'alu li-Allahi andadan li-yudillu 'an sabilih » — ils ont donné à Allah des égaux afin d'égarer les hommes de Son chemin. L'égarement est organisé. Le miroir m'interroge : est-ce que je suis sur le droit chemin malgré les tentations ?`,
  reflection: `L'égarement est organisé par les ennemis du chemin. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alu li-Allahi andadan li-yudillu 'an sabilih » — ils ont donné à Allah des égaux afin d'égarer les hommes de Son chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sur le droit chemin malgré les tentations ? Ou est-ce que je me laisse égarer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance contre l'égarement protège le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le droit chemin existe malgré les tentatives de l'obscurcir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste vigilant sur le chemin y demeure." }
  ],
  munajat: `Ya Rabb, je veux rester sur le droit chemin. Ne permets pas que je sois égaré. Protège-moi des tentations qui m'éloignent de Toi.`
};

MIROIR["14:31"] = {
  reference: "14:31",
  theme: ["dépense", "croyants", "bienfait"],
  emotion: "Motivation, générosité",
  difficulty: "débutant",
  relatedNames: ["An-Nafaqah", "Al-Mu'minun"],
  mirrorVersion: `« Dis à Mes serviteurs qui ont cru qu'ils accomplissent la prière et qu'ils dépensent de ce que Nous leur avons donné. » Le miroir me montre les obligations des croyants. « An yuqimu al-salata wa yunfiqu mimma razaqnahum » — qu'ils accomplissent la prière et qu'ils dépensent. La foi demande des actes. Le miroir m'interroge : est-ce que j'accomplis ces obligations ?`,
  reflection: `La foi demande la prière et la dépense. Ces actes sont inséparables de la croyance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul li-'ibadi alladhina amanu an yuqimu al-salata wa yunfiqu mimma razaqnahum sirran wa 'alaniyatan » — dis à Mes serviteurs qui ont cru qu'ils accomplissent la prière et qu'ils dépensent de ce que Nous leur avons donné, en secret et publiquement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accomplis la prière et la dépense ? Ou est-ce que je néglige ces obligations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière et la dépense fortifient la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les obligations des croyants sont claires et accessibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accomplit ces obligations vivifie sa foi." }
  ],
  munajat: `Ya Rabb, je veux accomplir la prière et la dépense. Ne permets pas que je néglige ces obligations. Fortifie ma foi par ces actes.`
};

MIROIR["14:32"] = {
  reference: "14:32",
  theme: ["création", "bienfaits", "soumission"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Razzaq"],
  mirrorVersion: `« C'est Allah qui a créé les cieux et la terre et fait descendre l'eau du ciel. » Le miroir me montre les bienfaits évidents d'Allah. « Allahu alladhi khalaqa al-samawati wa al-arda » — c'est Allah qui a créé les cieux et la terre. La création est un bienfait. Le miroir m'interroge : est-ce que je reconnais ces bienfaits ?`,
  reflection: `La création et la provision sont des bienfaits évidents. La reconnaissance est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi khalaqa al-samawati wa al-arda wa anzala mina al-sama'i ma'an » — c'est Allah qui a créé les cieux et la terre et fait descendre l'eau du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ces bienfaits ? Ou est-ce que je les tiens pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des bienfaits attire la bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est un bienfait d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les bienfaits les voit partout." }
  ],
  munajat: `Ya Rabb, je reconnais Tes bienfaits dans la création. Ne permets pas que je les ignore. Ouvre mes yeux à Tes signes partout.`
};

MIROIR["14:33"] = {
  reference: "14:33",
  theme: ["soleil", "lune", "obéissance"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Ash-Shams", "Al-Qamar"],
  mirrorVersion: `« Il a assujetti le soleil et la lune à votre service. » Le miroir me montre la soumission des astres. « Wa sakhkhara lakumu al-shamsa wa al-qamara » — Il a assujetti le soleil et la lune à votre service. L'univers entier sert l'homme. Le miroir m'interroge : est-ce que je suis reconnaissant pour cette soumission ?`,
  reflection: `L'univers est au service de l'homme. La reconnaissance de ce service est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sakhkhara lakumu al-shamsa wa al-qamara dha'ibayni » — Il a assujetti le soleil et la lune à votre service, tous deux poursuivant leur cours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour cette soumission ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance du service de l'univers mène à l'adoration du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les astres obéissent à Allah et servent l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le service de l'univers sert son Créateur." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour le service du soleil et de la lune. Ne permets pas que j'ignore cette grâce. Fais que je T'adore en reconnaissance.`
};

MIROIR["14:35"] = {
  reference: "14:35",
  theme: ["ibrahim", "invocation", "sanctuaire"],
  emotion: "Foi, espérance",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Bayt"],
  mirrorVersion: `« Et quand Abraham dit : "Seigneur, rends ce pays sûr, et préserve-moi ainsi que mes enfants de l'adoration des idoles." » Le miroir me montre l'invocation d'Abraham. « Rabbij'al hadha al-balada amin » — Seigneur, rends ce pays sûr. Abraham prie pour la sécurité et la foi. Le miroir m'interroge : est-ce que je prie pour la sécurité et la foi de ma famille ?`,
  reflection: `Abraham prie pour la sécurité et la protection contre l'idolâtrie. La prière pour sa famille est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qala Ibrahimu rabbij'al hadha al-balada aminan wa ijnubni wa baniyya an na'bud al-asnam » — et quand Abraham dit : Seigneur, rends ce pays sûr, et préserve-moi ainsi que mes enfants de l'adoration des idoles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour la sécurité et la foi de ma famille ? Ou est-ce que je néglige cette responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour la famille est un acte de responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sécurité et la foi sont des dons qu'on demande à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour sa famille protège son avenir." }
  ],
  munajat: `Ya Rabb, je prie pour la sécurité et la foi de ma famille. Préserve-nous de l'idolâtrie sous toutes ses formes. Exauce mon invocation comme Tu as exaucé celle d'Abraham.`
};

MIROIR["14:36"] = {
  reference: "14:36",
  theme: ["idolâtrie", "égarement", "protection"],
  emotion: "Supplication, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Asnam", "Ad-Dalal"],
  mirrorVersion: `« Seigneur, elles ont égaré beaucoup de gens. Celui qui me suit est des miens. » Le miroir me montre la conscience d'Abraham de l'égarement. « Rabbi innahunna adlalna kathiran mina al-nas » — Seigneur, elles ont égaré beaucoup de gens. L'idolâtrie égare. Le miroir m'interroge : est-ce que je suis conscient de ce qui égare autour de moi ?`,
  reflection: `L'idolâtrie sous toutes ses formes égare. La protection contre l'égarement est une prière constante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi innahunna adlalna kathiran mina al-nas » — Seigneur, elles ont égaré beaucoup de gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient de ce qui égare autour de moi ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de l'égarement protège de sa contamination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'idolâtrie est l'égarement le plus grave." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande protection contre l'égarement est guidé." }
  ],
  munajat: `Ya Rabb, je demande protection contre tout ce qui égare. Préserve-moi et ma famille de l'idolâtrie sous toutes ses formes. Guide-nous sur le droit chemin.`
};

MIROIR["14:37"] = {
  reference: "14:37",
  theme: ["ibrahim", "implantation", "prière"],
  emotion: "Supplication, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Ibrahim", "Al-Bayt"],
  mirrorVersion: `« Seigneur, j'ai établi une partie de ma descendance dans une vallée sans cultures, près de Ta Maison sacrée. » Le miroir me montre le sacrifice d'Abraham. « Rabbi inni askantu min dhurriyyati » — Seigneur, j'ai établi une partie de ma descendance. Abraham sacrifie pour l'adoration. Le miroir m'interroge : est-ce que je sacrifie pour l'adoration d'Allah ?`,
  reflection: `Abraham sacrifie le confort pour l'adoration. Le sacrifice pour Allah est un acte de foi suprême.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi inni askantu min dhurriyyati bi-wadin ghayri dhi zar'in 'inda baytika al-muharram » — Seigneur, j'ai établi une partie de ma descendance dans une vallée sans cultures, près de Ta Maison sacrée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sacrifie pour l'adoration d'Allah ? Ou est-ce que je cherche mon confort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice pour Allah attire Ses bénédictions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vallée stérile est devenue bénie par la prière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sacrifie pour Allah reçoit plus qu'il n'a donné." }
  ],
  munajat: `Ya Rabb, je veux sacrifier pour Ton adoration. Ne permets pas que je cherche mon confort au détriment de ma foi. Bénis mes sacrifices comme Tu as béni ceux d'Abraham.`
};

MIROIR["14:38"] = {
  reference: "14:38",
  theme: ["connaissance", "secret", "manifeste"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Khabir"],
  mirrorVersion: `« Seigneur, Tu sais ce que nous cachons et ce que nous divulguons. » Le miroir me montre la conscience d'Abraham de la connaissance divine. « Rabbana ta'lamu ma nukhfi wa ma nu'lin » — Seigneur, Tu sais ce que nous cachons et ce que nous divulguons. Rien n'est caché à Allah. Le miroir m'interroge : est-ce que je vis avec cette conscience ?`,
  reflection: `Allah connaît tout, caché et manifeste. Vivre avec cette conscience purifie l'intention.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana ta'lamu ma nukhfi wa ma nu'lin » — Seigneur, Tu sais ce que nous cachons et ce que nous divulguons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec cette conscience ? Ou est-ce que j'oublie Sa connaissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de Sa connaissance purifie les actes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans les cieux et la terre n'échappe à Sa connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec cette conscience purifie son cœur." }
  ],
  munajat: `Ya 'Alim, Tu connais ce que je cache et ce que je divulgue. Fais que je vive avec cette conscience. Purifie mon intention par la conscience de Ta connaissance.`
};

MIROIR["14:39"] = {
  reference: "14:39",
  theme: ["gratitude", "enfants", "vieillesse"],
  emotion: "Gratitude, louange",
  difficulty: "débutant",
  relatedNames: ["Ash-Shukr", "Al-Wahid"],
  mirrorVersion: `« Louange à Allah qui, malgré ma vieillesse, m'a donné Isma'il et Ishaq. » Le miroir me montre la gratitude d'Abraham. « Al-hamdu li-Allahi alladhi wahaba li 'ala al-kibari isma'ila wa ishaq » — louange à Allah qui m'a donné Isma'il et Ishaq malgré ma vieillesse. La gratitude accompagne les bienfaits. Le miroir m'interroge : est-ce que je suis reconnaissant pour mes bienfaits ?`,
  reflection: `La gratitude accompagne chaque bienfait. La reconnaissance est le premier devoir du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hamdu li-Allahi alladhi wahaba li 'ala al-kibari isma'ila wa ishaq » — louange à Allah qui, malgré ma vieillesse, m'a donné Isma'il et Ishaq." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour mes bienfaits ? Ou est-ce que je les tiens pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude transforme les bienfaits en bénédictions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque bienfait est un don qui mérite gratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant voit ses bienfaits multipliés." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour tous Tes bienfaits. Ne permets pas que je les ignore. Fais que ma gratitude augmente mes bénédictions.`
};

MIROIR["14:40"] = {
  reference: "14:40",
  theme: ["prière", "descendance", "exaucement"],
  emotion: "Supplication, détermination",
  difficulty: "débutant",
  relatedNames: ["As-Salah", "Al-Mujib"],
  mirrorVersion: `« Seigneur, fais que j'accomplisse la prière et une partie de ma descendance. » Le miroir me montre la prière d'Abraham pour la prière. « Rabbi ij'alni muqima al-salati » — Seigneur, fais que j'accomplisse la prière. La prière est la demande suprême. Le miroir m'interroge : est-ce que je prie pour la prière ?`,
  reflection: `La prière pour la prière est la meilleure des demandes. La transmission de la prière à la descendance est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi ij'alni muqima al-salati wa min dhurriyyati » — Seigneur, fais que j'accomplisse la prière et une partie de ma descendance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour la prière ? Ou est-ce que je prie pour autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour la prière est la clé de la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière est le pilier de la religion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour la prière reçoit la constance." }
  ],
  munajat: `Ya Rabb, fais que j'accomplisse la prière et ma descendance. Ne permets pas que je néglige ce pilier. Donne-moi la constance dans la prière.`
};

MIROIR["14:41"] = {
  reference: "14:41",
  theme: ["pardon", "parents", "croyants"],
  emotion: "Supplication, tendresse",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Seigneur, pardonne-moi, à mes parents et aux croyants, le jour où les comptes seront rendus. » Le miroir me montre la prière d'Abraham pour le pardon. « Rabbana ighfir li wa li-walidayya wa li-l-mu'minina » — Seigneur, pardonne-moi, à mes parents et aux croyants. Le pardon est demandé pour tous. Le miroir m'interroge : est-ce que je prie pour le pardon de tous ?`,
  reflection: `Le pardon est demandé pour soi, ses parents et les croyants. La prière collective pour le pardon est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana ighfir li wa li-walidayya wa li-l-mu'minina yawma yaqumu al-hisab » — Seigneur, pardonne-moi, à mes parents et aux croyants, le jour où les comptes seront rendus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour le pardon de tous ? Ou est-ce que je prie seulement pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour le pardon des autres attire le pardon pour soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pardon divin englobe tous ceux qui le demandent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour le pardon des autres est pardonné." }
  ],
  munajat: `Ya Ghafur, pardonne-moi, à mes parents et à tous les croyants. Ne permets pas que je sois égoïste dans mes demandes. Inclus tous les croyants dans mes prières.`
};

MIROIR["14:43"] = {
  reference: "14:43",
  theme: ["jugement", "terre", "vision"],
  emotion: "Mise en garde, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qiyamah", "Al-Hisab"],
  mirrorVersion: `« Ils courront, les têtes levées, leurs regards ne revenant pas vers eux, et leurs cœurs vides. » Le miroir me montre la terreur du Jour du Jugement. « Muhit'in qila'uhum » — leurs cœurs vides. Le vide du cœur ce jour-là est terrifiant. Le miroir m'interroge : est-ce que je remplis mon cœur de foi aujourd'hui ?`,
  reflection: `Le cœur vide ce jour-là est le résultat d'un cœur vide de foi aujourd'hui. Remplir son cœur de foi est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muhit'in qila'uhum la yarji'u ilayhim anfusuhum » — les cœurs vides, leurs regards ne revenant pas vers eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remplis mon cœur de foi aujourd'hui ? Ou est-ce que je le laisse vide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur rempli de foi aujourd'hui sera rempli de paix demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour du Jugement révèle l'état des cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remplit son cœur de foi aujourd'hui sera sauvé demain." }
  ],
  munajat: `Ya Rabb, je veux remplir mon cœur de foi. Ne permets pas qu'il soit vide. Donne-moi un cœur plein de Ta présence.`
};

MIROIR["14:44"] = {
  reference: "14:44",
  theme: ["avertissement", "jugement", "appel"],
  emotion: "Mise en garde, urgence",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Qiyamah"],
  mirrorVersion: `« Avertis les gens du jour où le châtiment les atteindra. » Le miroir me montre l'urgence de l'avertissement. « Wa andhiri al-nasa yawma ya'tihimu al-'adhab » — avertis les gens du jour où le châtiment les atteindra. L'avertissement est un devoir. Le miroir m'interroge : est-ce que j'avertis ceux qui m'entourent ?`,
  reflection: `L'avertissement est un acte de miséricorde. Ne pas avertir est une négligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa andhiri al-nasa yawma ya'tihimu al-'adhab » — avertis les gens du jour où le châtiment les atteindra." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'avertis ceux qui m'entourent ? Ou est-ce que je les laisse dans l'insouciance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est un acte d'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment vient à ceux qui n'ont pas été avertis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avertit les autres se prépare lui-même." }
  ],
  munajat: `Ya Rabb, aide-moi à avertir ceux qui m'entourent. Ne permets pas que je les laisse dans l'insouciance. Fais de moi un avertisseur par mes paroles et mes actes.`
};

MIROIR["14:45"] = {
  reference: "14:45",
  theme: ["demeure", "injustice", "témoignage"],
  emotion: "Réalité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Masakin", "Ath-Thamud"],
  mirrorVersion: `« Vous avez habité les demeures de ceux qui ont été injustes envers eux-mêmes. » Le miroir me montre le témoignage de l'histoire. « Wa sakantum fi masakini alladhina zalamu anfusahum » — vous avez habité les demeures de ceux qui ont été injustes envers eux-mêmes. Les ruines sont des témoins. Le miroir m'interroge : est-ce que je tire leçon des ruines ?`,
  reflection: `Les ruines des peuples passés sont des leçons. L'histoire témoigne contre l'injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sakantum fi masakini alladhina zalamu anfusahum » — vous avez habité les demeures de ceux qui ont été injustes envers eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tire leçon des ruines ? Ou est-ce que je passe sans réfléchir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La leçon des ruines protège de la même fin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ruines sont des témoins silencieux de la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire leçon des ruines préserve son avenir." }
  ],
  munajat: `Ya Rabb, je tire leçon des ruines des peuples passés. Ne permets pas que je passe sans réfléchir. Fais que l'histoire me serve de leçon.`
};

MIROIR["14:46"] = {
  reference: "14:46",
  theme: ["complot", "rusé", "connaissance"],
  emotion: "Confiance, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Makr", "Al-Alim"],
  mirrorVersion: `« Ils ont ourdi leur complot, mais leur complot est connu d'Allah. » Le miroir me montre la futilité des complots. « Wa qad makaru makrahum » — ils ont ourdi leur complot. Mais Allah connaît tout. Le miroir m'interroge : est-ce que je crains les complots ou Allah ?`,
  reflection: `Les complots des hommes sont connus d'Allah. Sa connaissance protège les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad makaru makrahum wa 'inda Allahi makrahum wa in kana makruhum li-tazula minhu al-jibal » — ils ont ourdi leur complot, mais leur complot est connu d'Allah, même si leur complot était pour faire disparaître les montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les complots ou Allah ? Qui est le plus puissant à mes yeux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah neutralise les complots." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le meilleur des stratèges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah n'a rien à craindre des complots." }
  ],
  munajat: `Ya Rabb, je me confie en Toi contre tous les complots. Ne permets pas que je craigne les hommes. Fais que ma confiance en Toi soit totale.`
};

MIROIR["14:47"] = {
  reference: "14:47",
  theme: ["promesse", "messager", "vérité"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Wa'd"],
  mirrorVersion: `« Ne pense pas qu'Allah manquera à Sa promesse envers Ses messagers. » Le miroir me montre la certitude de la promesse divine. « Fa-la tahsabanna Allaha mukhlifa wa'dahu rusulahu » — ne pense pas qu'Allah manquera à Sa promesse. La promesse d'Allah est certaine. Le miroir m'interroge : est-ce que j'ai confiance en Sa promesse ?`,
  reflection: `La promesse d'Allah est certaine. La confiance en Sa promesse est la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la tahsabanna Allaha mukhlifa wa'dahu rusulahu » — ne pense pas qu'Allah manquera à Sa promesse envers Ses messagers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai confiance en Sa promesse ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Sa promesse apaise le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est plus certaine que l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en Sa promesse la voit s'accomplir." }
  ],
  munajat: `Ya Rabb, j'ai confiance en Ta promesse. Ne permets pas que je doute. Fais que je vive dans la certitude de Ta vérité.`
};

MIROIR["14:48"] = {
  reference: "14:48",
  theme: ["transformation", "terre", "jugement"],
  emotion: "Mise en garde, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ard", "Al-Qiyamah"],
  mirrorVersion: `« Le jour où la terre sera remplacée par une autre terre, ainsi que les cieux. » Le miroir me montre la transformation cosmique. « Yawma tubaddalu al-ardu ghayra al-ardi » — le jour où la terre sera remplacée par une autre terre. Tout sera transformé. Le miroir m'interroge : est-ce que je suis prêt pour ce jour ?`,
  reflection: `La transformation du Jour du Jugement est totale. Être prêt est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tubaddalu al-ardu ghayra al-ardi wa al-samawatu wa barazu li-Allahi al-wahidu al-qahhar » — le jour où la terre sera remplacée par une autre terre, ainsi que les cieux, et ils comparaîtront devant Allah, l'Unique, le Dominateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour ce jour ? Ou est-ce que je vis comme s'il n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour ce jour commence maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création sera transformée ce jour-là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour ce jour n'a rien à craindre." }
  ],
  munajat: `Ya Rabb, je veux être prêt pour le Jour du Jugement. Ne permets pas que je vive dans l'insouciance. Prépare-moi pour ce jour grandiose.`
};

MIROIR["14:49"] = {
  reference: "14:49",
  theme: ["criminels", "chaînes", "jugement"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mujrimun", "Al-Aghlal"],
  mirrorVersion: `« Ce jour-là, tu verras les criminels enchaînés les uns aux autres. » Le miroir me montre le destin des criminels. « Tara al-mujrimina yawma'idhin muqarranina fi al-asfad » — tu verras les criminels enchaînés. Le crime a des conséquences. Le miroir m'interroge : est-ce que j'évite le crime dans toutes ses formes ?`,
  reflection: `Le crime a des conséquences visibles au Jour du Jugement. L'évitement du crime est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tara al-mujrimina yawma'idhin muqarranina fi al-asfad » — ce jour-là, tu verras les criminels enchaînés les uns aux autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite le crime dans toutes ses formes ? Ou est-ce que je le minimise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement du crime purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le crime sera exposé au Jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite le crime préserve son honneur." }
  ],
  munajat: `Ya Rabb, je veux éviter le crime dans toutes ses formes. Ne permets pas que je minimise le mal. Protège-moi de tout ce qui mène à l'enchaînement.`
};

MIROIR["14:50"] = {
  reference: "14:50",
  theme: ["vêtements", "poix", "châtiment"],
  emotion: "Mise en garde, effroi",
  difficulty: "débutant",
  relatedNames: ["Sarihum", "Al-Qatiran"],
  mirrorVersion: `« Leurs vêtements seront de poix, et le feu couvrira leurs visages. » Le miroir me montre l'intensité du châtiment. « Saribuhum min qatiran » — leurs vêtements seront de poix. La poix brûle et colle. Le miroir m'interroge : est-ce que je crains ce châtiment ?`,
  reflection: `Le châtiment est intense et approprié. La crainte motive l'évitement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Saribuhum min qatiran wa taghsha wujuhahumu al-nar » — leurs vêtements seront de poix, et le feu couvrira leurs visages." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce châtiment ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment motive la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment correspond aux actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment l'évite." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Ne permets pas que je sois insouciant. Protège-moi du feu qui couvre les visages.`
};

MIROIR["14:51"] = {
  reference: "14:51",
  theme: ["rétribution", "œuvres", "justice"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Adl"],
  mirrorVersion: `« Afin qu'Allah rétribue chaque âme selon ce qu'elle a acquis. » Le miroir me montre la justice parfaite. « Li-yajziya Allahu kulla nafsin ma kasabat » — afin qu'Allah rétribue chaque âme selon ce qu'elle a acquis. La rétribution est personnelle. Le miroir m'interroge : est-ce que je suis conscient que je serai rétribué pour mes actes ?`,
  reflection: `La rétribution est personnelle et juste. Chaque acte sera rétribué.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yajziya Allahu kulla nafsin ma kasabat » — afin qu'Allah rétribue chaque âme selon ce qu'elle a acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient que je serai rétribué pour mes actes ? Ou est-ce que je vis sans responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la rétribution transforme les actes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite et inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est conscient de la rétribution agit avec sagesse." }
  ],
  munajat: `Ya Rabb, je suis conscient que je serai rétribué pour mes actes. Ne permets pas que je vive sans responsabilité. Fais que chaque acte soit pour Toi.`
};

MIROIR["14:52"] = {
  reference: "14:52",
  theme: ["message", "avertissement", "invitation"],
  emotion: "Clarté, urgence",
  difficulty: "débutant",
  relatedNames: ["Ar-Risalah", "An-Nadhir"],
  mirrorVersion: `« Voici un message pour les gens, afin qu'ils soient avertis et qu'ils sachent qu'Il n'y a qu'un seul Dieu. » Le miroir me montre l'universalité du message. « Hadha balaghun li-l-nas » — voici un message pour les gens. Le message est universel. Le miroir m'interroge : est-ce que je transmets ce message ?`,
  reflection: `Le message est universel. La transmission est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadha balaghun li-l-nas wa li-yundharu bihi wa li-ya'lamu annama ilahun wahid » — voici un message pour les gens, afin qu'ils soient avertis et qu'ils sachent qu'Il n'y a qu'un seul Dieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transmets ce message ? Ou est-ce que je le garde pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transmission du message est un acte de miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message est pour tous les hommes sans exception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui transmet le message participe à la miséricorde divine." }
  ],
  munajat: `Ya Rabb, je veux transmettre Ton message. Ne permets pas que je le garde pour moi. Fais de moi un porteur de Ta parole.`
};

MIROIR["39:26"] = {
  reference: "39:26",
  theme: ["humiliation", "châtiment", "mise en garde"],
  emotion: "Crainte, honte",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhill", "Al-Mu'izz"],
  mirrorVersion: `« Allah leur a fait goûter l'humiliation dans la vie présente. » Le miroir me montre le goût de l'humiliation. « Fa-adhaqahumu Allahu al-dhulla fi al-hayati al-dunya » — Allah leur a fait goûter l'humiliation dans la vie présente. L'humiliation précède le châtiment de l'au-delà. Le miroir m'interroge : est-ce que je goûte l'humiliation pour mes péchés ?`,
  reflection: `L'humiliation dans la vie présente est un avant-goût du châtiment. Le croyant en tire les leçons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-adhaqahumu Allahu al-dhulla fi al-hayati al-dunya wa la'adhabu al-akhirati akbaru » — Allah leur a fait goûter l'humiliation dans la vie présente. Le châtiment de l'au-delà est plus grand." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je goûte l'humiliation pour mes péchés ? Ou est-ce que je reste arrogant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation dans ce monde peut être une miséricorde si elle mène au repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment de l'au-delà est plus grand que celui de ce monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte l'humiliation ici-bas et se repent échappe au châtiment ultérieur." }
  ],
  munajat: `Ya Mudhill, Tu m'humilies pour me réveiller. Ne permets pas que je reste arrogant. Donne-moi le repentir avant le châtiment.`
};

MIROIR["39:27"] = {
  reference: "39:27",
  theme: ["coran", "exemples", "guidance"],
  emotion: "Clarté, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Bayan"],
  mirrorVersion: `« Nous avons certainement proposé aux hommes dans ce Coran toutes sortes d'exemples. » Le miroir me montre la diversité des enseignements. « Wa laqad darabna li-nasi fi hadha al-qur'ani min kulli mathal » — Nous avons certainement proposé aux hommes dans ce Coran toutes sortes d'exemples. Les exemples sont pour la compréhension. Le miroir m'interroge : est-ce que je comprends les exemples du Coran ?`,
  reflection: `Les exemples du Coran sont variés pour toucher tous les cœurs. La compréhension est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad darabna li-nasi fi hadha al-qur'ani min kulli mathal » — Nous avons certainement proposé aux hommes dans ce Coran toutes sortes d'exemples." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends les exemples du Coran ? Ou est-ce que je passe sans réfléchir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compréhension des exemples est le chemin de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque exemple du Coran est une porte vers une vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les exemples du Coran comprend la vie." }
  ],
  munajat: `Ya Bayan, donne-moi de comprendre Tes exemples. Ne permets pas que je passe sans réfléchir. Ouvre mon cœur aux leçons du Coran.`
};

MIROIR["39:28"] = {
  reference: "39:28",
  theme: ["coran", "pureté", "déviation"],
  emotion: "Gratitude, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-Haqq"],
  mirrorVersion: `« Un Coran arabe sans aucune déviation, afin qu'ils soient pieux. » Le miroir me montre la pureté du Coran. « Qur'anan 'arabiyyan ghayra dhi 'iwaj » — un Coran arabe sans aucune déviation. La pureté du texte garantit la clarté du message. Le miroir m'interroge : est-ce que j'accepte le Coran sans déviation ?`,
  reflection: `Le Coran est sans déviation ni contradiction. L'accepter tel quel est le chemin de la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qur'anan 'arabiyyan ghayra dhi 'iwaj la'allahum yattaqun » — un Coran arabe sans aucune déviation, afin qu'ils soient pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le Coran sans déviation ? Ou est-ce que je veux le modifier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation du Coran tel quel est la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté du Coran est la garantie de sa préservation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le Coran sans déviation atteint la piété." }
  ],
  munajat: `Ya Haqq, j'accepte Ton Coran sans déviation. Ne permets pas que je le modifie selon mes désirs. Donne-moi la piété par Ta révélation pure.`
};

MIROIR["39:29"] = {
  reference: "39:29",
  theme: ["association", "unicité", "exemple"],
  emotion: "Clarté, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Qahhar"],
  mirrorVersion: `« Allah propose une parabole : un homme appartenant à plusieurs associés qui se disputent, et un homme appartenant exclusivement à un seul homme. » Le miroir me montre la différence entre l'associateur et le monothéiste. « Daraba Allahu mathalan rajulan fihi shuraka'u mutashakishuna wa rajulan salaman li-rajulin » — Allah propose une parabole : un homme appartenant à plusieurs associés qui se disputent, et un homme appartenant exclusivement à un seul. L'exemple est frappant. Le miroir m'interroge : à qui appartiens-je ?`,
  reflection: `L'associateur est déchiré entre plusieurs maîtres. Le monothéiste est en paix avec un seul Maître.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Daraba Allahu mathalan rajulan fihi shuraka'u mutashakishuna wa rajulan salaman li-rajulin hal yastawiani mathalan » — Allah propose une parabole : un homme appartenant à plusieurs associés qui se disputent, et un homme appartenant exclusivement à un seul homme. Sont-ils égaux en parabole ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui appartiens-je ? À Allah seul ou à plusieurs idoles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appartenance exclusive à Allah est la paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La louange appartient à Allah qui guide vers cette vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appartient exclusivement à Allah connaît la paix parfaite." }
  ],
  munajat: `Ya Wahid, j'appartiens à Toi exclusivement. Ne permets pas que je sois déchiré entre plusieurs maîtres. Donne-moi la paix de l'appartenance exclusive.`
};

MIROIR["39:30"] = {
  reference: "39:30",
  theme: ["mort", "prophète", "réalité"],
  emotion: "Humilité, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Hayy"],
  mirrorVersion: `« En vérité, tu mourras et ils mourront aussi. » Le miroir me montre la réalité de la mort. « Innaka mayyitun wa innahum mayyitun » — en vérité, tu mourras et ils mourront aussi. Personne n'échappe à la mort, même le Prophète. Le miroir m'interroge : est-ce que je me prépare à la mort ?`,
  reflection: `La mort est la destinée de tous, prophètes et communautés. La préparation est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka mayyitun wa innahum mayyitun » — en vérité, tu mourras et ils mourront aussi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare à la mort ? Ou est-ce que je vis comme si j'étais éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation à la mort est la clé de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est la seule certitude après la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare à la mort vivra vraiment." }
  ],
  munajat: `Ya Mumit, je sais que je mourrai. Ne permets pas que je l'oublie. Donne-moi de me préparer à la rencontre avec Toi.`
};

MIROIR["39:31"] = {
  reference: "39:31",
  theme: ["jugement", "dispute", "responsabilité"],
  emotion: "Crainte, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Adl"],
  mirrorVersion: `« Ensuite, le Jour de la Résurrection, vous disputerez auprès de votre Seigneur. » Le miroir me montre la dispute du Jour du Jugement. « Thumma yawma al-qiyamati 'inda rabbikum takhtasimun » — ensuite, le Jour de la Résurrection, vous disputerez auprès de votre Seigneur. La dispute est inévitable. Le miroir m'interroge : serai-je du côté des gagnants ou des perdants ?`,
  reflection: `La dispute du Jour du Jugement est réelle. Les opprimés y trouveront justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yawma al-qiyamati 'inda rabbikum takhtasimun » — ensuite, le Jour de la Résurrection, vous disputerez auprès de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Serai-je du côté des gagnants ou des perdants dans cette dispute ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La dispute du Jour du Jugement rétablit la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun rendra compte de ses actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait justice ici-bas n'aura pas besoin de disputer là-bas." }
  ],
  munajat: `Ya Hakam, je veux être du côté des gagnants. Ne permets pas que je sois opprimé ou oppresseur. Donne-moi la justice qui mène au salut.`
};

MIROIR["39:32"] = {
  reference: "39:32",
  theme: ["mensonge", "ingratitude", "châtiment"],
  emotion: "Mise en garde, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Shahid"],
  mirrorVersion: `« Qui est plus injuste que celui qui ment contre Allah et traite de mensonge la vérité quand elle lui vient ? » Le miroir me montre le pire des injustes. « Fa-man azlamu mimman kadhaba 'ala Allahi wa kadhdhaba bi-al-haqqi idha ja'ahu » — qui est plus injuste que celui qui ment contre Allah et traite de mensonge la vérité ? L'injustice est clairement définie. Le miroir m'interroge : est-ce que je traite la vérité de mensonge ?`,
  reflection: `Le plus grand crime est de mentir sur Allah et de traiter la vérité de mensonge. L'enfer attend ces gens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man azlamu mimman kadhaba 'ala Allahi wa kadhdhaba bi-al-haqqi idha ja'ahu alaysa fi jahannama mathwan lil-kafirin » — qui est plus injuste que celui qui ment contre Allah et traite de mensonge la vérité quand elle lui vient ? N'y a-t-il pas dans l'enfer une demeure pour les mécréants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite la vérité de mensonge ? Ou est-ce que je l'accepte avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la vérité est le chemin du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfer est la demeure de ceux qui traitent la vérité de mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité même quand elle lui déplaît est sur la bonne voie." }
  ],
  munajat: `Ya Haqq, j'accepte Ta vérité. Ne permets pas que je la traite de mensonge. Donne-moi l'humilité devant Ta révélation.`
};

MIROIR["39:33"] = {
  reference: "39:33",
  theme: ["vérité", "croyance", "récompense"],
  emotion: "Espoir, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Siddiq", "Al-Hadi"],
  mirrorVersion: `« Et celui qui vient avec la vérité et celui qui la confirme... ceux-là sont les pieux. » Le miroir me montre le statut des véridiques. « Wa alladhi ja'a bi-al-haqqi wa saddaqahu » — et celui qui vient avec la vérité et celui qui la confirme. Les deux sont honorés. Le miroir m'interroge : suis-je parmi ceux qui confirment la vérité ?`,
  reflection: `Celui qui apporte la vérité et celui qui la confirme sont les pieux. La confirmation est aussi noble que l'apport.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhi ja'a bi-al-haqqi wa saddaqahu ula'ika hum al-muttaqun » — et celui qui vient avec la vérité et celui qui la confirme... ceux-là sont les pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi ceux qui confirment la vérité ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confirmation de la vérité est la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les pieux ont leur récompense auprès de leur Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui confirme la vérité la fait vivre et grandir." }
  ],
  munajat: `Ya Siddiq, je confirme Ta vérité. Ne permets pas que je la rejette. Donne-moi d'être parmi les pieux qui confirment.`
};

MIROIR["39:34"] = {
  reference: "39:34",
  theme: ["récompense", "paradis", "demande"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wahhab"],
  mirrorVersion: `« Ils auront ce qu'ils voudront auprès de leur Seigneur. C'est la récompense des bienfaisants. » Le miroir me montre la récompense illimitée. « Lahum ma yasha'una 'inda rabbihim » — ils auront ce qu'ils voudront auprès de leur Seigneur. Le désir est exaucé. Le miroir m'interroge : que veux-je auprès de mon Seigneur ?`,
  reflection: `Les bienfaisants auront ce qu'ils veulent au paradis. La bienfaisance ici-bas mène à la satisfaction là-bas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum ma yasha'una 'inda rabbihim dhalika jazau al-muhsinin » — ils auront ce qu'ils voudront auprès de leur Seigneur. C'est la récompense des bienfaisants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que veux-je auprès de mon Seigneur ? Quel est mon désir le plus profond ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction des désirs au paradis est la récompense de la bienfaisance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La bienfaisance est la clé de la satisfaction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est bienfaisant verra tous ses désirs exaucés." }
  ],
  munajat: `Ya Karim, je veux être parmi les bienfaisants. Ne permets pas que je sois avare. Donne-moi la bienfaisance qui mène à la satisfaction.`
};

MIROIR["39:35"] = {
  reference: "39:35",
  theme: ["pardon", "récompense", "effacement"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Shakur"],
  mirrorVersion: `« Afin qu'Allah leur efface les pires de leurs actions et les récompense selon ce qu'elles avaient de meilleur. » Le miroir me montre la générosité du pardon. « Li-yukaffira Allahu 'anhum aswa alladhi 'amilu » — afin qu'Allah leur efface les pires de leurs actions. L'effacement précède la récompense. Le miroir m'interroge : est-ce que j'espère cet effacement ?`,
  reflection: `Allah efface les mauvaises actions et récompense les meilleures. La générosité divine est immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yukaffira Allahu 'anhum aswa alladhi 'amilu wa yajziyahum ajrahum bi-ahsani alladhi kanu ya'malun » — afin qu'Allah leur efface les pires de leurs actions et les récompense selon ce qu'elles avaient de meilleur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère cet effacement ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effacement des péchés est le premier don avant la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est Généreux au-delà de toute mesure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère l'effacement le reçoit par la miséricorde divine." }
  ],
  munajat: `Ya Ghaffur, efface mes mauvaises actions. Ne permets pas qu'elles me pèsent. Donne-moi la récompense selon ce que j'ai de meilleur.`
};

MIROIR["39:36"] = {
  reference: "39:36",
  theme: ["suffisance", "mércielle", "protection"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Ghani"],
  mirrorVersion: `« Allah ne suffit-Il pas à Son serviteur ? » Le miroir me montre la suffisance d'Allah. « A-laysa Allahu bi-kafin 'abdahu » — Allah ne suffit-Il pas à Son serviteur ? La question est rhétorique. La réponse est évidente. Le miroir m'interroge : est-ce qu'Allah me suffit ?`,
  reflection: `Allah suffit à Son serviteur. Ceux qui croient en Lui ne craignent rien d'autre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-laysa Allahu bi-kafin 'abdahu » — Allah ne suffit-Il pas à Son serviteur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'Allah me suffit ? Ou est-ce que je cherche d'autres protecteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La suffisance d'Allah est la paix du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le meilleur Protecteur et le meilleur Secoureur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qu'Allah suffit n'a besoin de rien d'autre." }
  ],
  munajat: `Ya Wakil, Tu me suffis. Ne permets pas que je cherche d'autres protecteurs. Donne-moi la confiance en Ta suffisance.`
};

MIROIR["39:37"] = {
  reference: "39:37",
  theme: ["guidance", "égarement", "mércielle"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Et quiconque Allah guide, nul ne peut l'égarer. » Le miroir me montre la protection de la guidance. « Wa man yahdi Allahu fa-la mudilla lahu » — et quiconque Allah guide, nul ne peut l'égarer. La guidance divine est définitive. Le miroir m'interroge : est-ce que je suis parmi les guidés ?`,
  reflection: `La guidance d'Allah est une protection contre l'égarement. Nul ne peut égarer celui qu'Allah guide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yahdi Allahu fa-la mudilla lahu alaysa Allahu bi-'azizin dhi intiqam » — et quiconque Allah guide, nul ne peut l'égarer. Allah n'est-Il pas Puissant et Détenteur du châtiment ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les guidés ? Ou est-ce que je risque l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est un don qu'on ne peut perdre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La puissance d'Allah garantit la protection des guidés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est guidé par Allah ne peut plus s'égarer." }
  ],
  munajat: `Ya Hadi, guide-moi et protège-moi de l'égarement. Ne permets pas que je sois égaré. Donne-moi la guidance définitive.`
};

MIROIR["39:38"] = {
  reference: "39:38",
  theme: ["création", "bénéfice", "nuisance"],
  emotion: "Révérence, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Si tu leur demandes qui a créé les cieux et la terre, ils diront certes : Allah. Dis : Voyez-vous ceux que vous invoquez en dehors d'Allah ? » Le miroir me montre l'aveu des associateurs. « Wa la-in sa'altahum man khalaqa al-samawati wa al-arda » — si tu leur demandes qui a créé les cieux et la terre, ils diront : Allah. L'aveu est là. Le miroir m'interroge : est-ce que mon aveu est suivi d'actes ?`,
  reflection: `Même les associateurs avouent qu'Allah est le Créateur. Mais l'aveu sans l'adoration exclusive est insuffisant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in sa'altahum man khalaqa al-samawati wa al-arda la-yaqulunna Allahu qul afara'aytum ma tad'una min duni Allahi in arada niya Allahu bi-durrin hal mushrika'tun shay'an » — si tu leur demandes qui a créé les cieux et la terre, ils diront certes : Allah. Dis : Voyez-vous ceux que vous invoquez en dehors d'Allah ? Si Allah voulait me nuire, est-ce qu'ils pourraient lever Son nuisement ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon aveu qu'Allah est le Créateur est suivi d'adoration exclusive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveu de la création doit mener à l'adoration exclusive." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne peut nuire ou profiter en dehors d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que seul Allah peut nuire ou profiter ne craint personne d'autre." }
  ],
  munajat: `Ya Khaliq, Tu es le seul qui peut nuire ou profiter. Ne permets pas que j'invoque d'autres que Toi. Donne-moi l'adoration exclusive.`
};

MIROIR["39:39"] = {
  reference: "39:39",
  theme: ["délai", "mésiance", "vérité"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wakil"],
  mirrorVersion: `« Dis : Ô mon peuple, agissez selon votre manière ! J'agirai selon la mienne. Bientôt vous saurez. » Le miroir me montre la séparation des chemins. « Qul ya qawmi'malu 'ala makanatikum inni 'amil » — dis : Ô mon peuple, agissez selon votre manière ! J'agirai selon la mienne. Les chemins sont distincts. Le miroir m'interroge : sur quel chemin suis-je ?`,
  reflection: `Chacun agit selon sa manière. Le résultat montrera qui est sur la bonne voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya qawmi'malu 'ala makanatikum inni 'amilun sawfa ta'lamun » — dis : Ô mon peuple, agissez selon votre manière ! J'agirai selon la mienne. Bientôt vous saurez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quel chemin suis-je ? Celui du Prophète ou celui des négateurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité se révèle par les résultats." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps départage les voies et révèle la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sur la bonne voie le verra par les résultats." }
  ],
  munajat: `Ya Haqq, je suis le chemin du Prophète. Ne permets pas que je m'écarte. Donne-moi de voir la vérité par les résultats.`
};

MIROIR["39:40"] = {
  reference: "39:40",
  theme: ["châtiment", "humiliation", "vérité"],
  emotion: "Mise en garde, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Mudhill"],
  mirrorVersion: `« Sur qui viendra un châtiment qui l'humiliera, et sur qui s'abattra un châtiment durable. » Le miroir me montre l'issue finale. « Man ya'tihi 'adhabun yukhzih » — sur qui viendra un châtiment qui l'humiliera. La question est un avertissement. Le miroir m'interroge : suis-je concerné par cet avertissement ?`,
  reflection: `Le châtiment humiliant et durable attend les négateurs. La question est un avertissement pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man ya'tihi 'adhabun yukhzihi wa yahillu 'alayhi 'adhabun muqim » — sur qui viendra un châtiment qui l'humiliera, et sur qui s'abattra un châtiment durable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je concerné par cet avertissement ? Ou suis-je protégé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde pour ceux qui écoutent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment humiliant et durable est la conséquence de la négation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement échappe au châtiment." }
  ],
  munajat: `Ya Adl, je crains Ton châtiment. Ne permets pas que je sois humilié. Donne-moi de T'écouter et d'échapper au châtiment.`
};

MIROIR["39:41"] = {
  reference: "39:41",
  theme: ["révélation", "humanité", "responsabilité"],
  emotion: "Gravité, mission",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mubin"],
  mirrorVersion: `« Nous t'avons fait descendre le Livre pour les hommes en toute vérité. Quiconque se guide le fait pour lui-même. » Le miroir me montre la responsabilité individuelle. « Inna anzalnaka al-kitaba li-nasi bi-al-haqqi » — Nous t'avons fait descendre le Livre pour les hommes en toute vérité. Le Livre est pour tous. Le miroir m'interroge : que fais-je de ce Livre ?`,
  reflection: `Le Coran est descendu pour tous les hommes. La guidance ou l'égarement est une responsabilité individuelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna anzalnaka al-kitaba li-nasi bi-al-haqqi famani ihtada fa-li-nafsihi wa man dalla fa-innama yadillu 'alayha » — Nous t'avons fait descendre le Livre pour les hommes en toute vérité. Quiconque se guide le fait pour lui-même. Quiconque s'égare s'égare à son propre détriment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que fais-je de ce Livre ? Est-ce qu'il me guide ou est-ce que je m'en écarte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est un gain pour soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tu n'es pas leur garant, mais le porteur du message." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se guide par le Coran guide son âme vers le salut." }
  ],
  munajat: `Ya Hadi, je me guide par Ton Livre. Ne permets pas que je m'en écarte. Donne-moi la responsabilité de ma propre guidance.`
};

MIROIR["39:42"] = {
  reference: "39:42",
  theme: ["âme", "mort", "sommeil"],
  emotion: "Méditation, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Muhyi"],
  mirrorVersion: `« Allah reçoit les âmes au moment de leur mort et celles qui ne meurent pas pendant leur sommeil. » Le miroir me montre le mystère de l'âme. « Allahu yatawaffa al-anfusa hina mawtiha » — Allah reçoit les âmes au moment de leur mort. La mort est un rendez-vous. Le miroir m'interroge : suis-je prêt pour ce rendez-vous ?`,
  reflection: `Allah reçoit les âmes pendant le sommeil et la mort. Il retient celles dont Il décrète la mort et renvoie les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu yatawaffa al-anfusa hina mawtiha wa allati lam tamut fi manamiha » — Allah reçoit les âmes au moment de leur mort et celles qui ne meurent pas pendant leur sommeil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le rendez-vous de la mort ? Ou est-ce que je fuis cette réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sommeil est une petite mort, la mort est un grand sommeil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il y a des signes pour les gens qui réfléchissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le mystère de l'âme comprend la vie et la mort." }
  ],
  munajat: `Ya Mumit, Tu reçois les âmes. Ne permets pas que je sois surpris par la mort. Donne-moi de me préparer au rendez-vous avec Toi.`
};

MIROIR["39:43"] = {
  reference: "39:43",
  theme: ["intercession", "mésiance", "fausses divinités"],
  emotion: "Clarté, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Shafi"],
  mirrorVersion: `« Ont-ils pris des intercesseurs en dehors d'Allah ? Dis : Même s'ils ne possédaient rien et ne raisonnaient pas ? » Le miroir me montre l'erreur de l'intercession par les idoles. « Am ittakhadhu min duni Allahi shufa'a' » — ont-ils pris des intercesseurs en dehors d'Allah ? L'intercession est un droit divin. Le miroir m'interroge : à qui je demande l'intercession ?`,
  reflection: `L'intercession appartient à Allah seul. Les idoles ne possèdent rien et ne peuvent intercéder.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am ittakhadhu min duni Allahi shufa'a' qul awa law kanu la yamlikuna shay'an wa la ya'qilun » — ont-ils pris des intercesseurs en dehors d'Allah ? Dis : Même s'ils ne possédaient rien et ne raisonnaient pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je demande l'intercession ? À Allah seul ou à d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession par Allah seul est la vraie intercession." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les idoles ne possèdent rien et ne peuvent rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que l'intercession appartient à Allah seul ne cherche pas d'autres intercesseurs." }
  ],
  munajat: `Ya Wahid, à Toi seul appartient l'intercession. Ne permets pas que je la cherche ailleurs. Donne-moi de m'adresser directement à Toi.`
};

MIROIR["39:44"] = {
  reference: "39:44",
  theme: ["intercession", "permission", "royauté"],
  emotion: "Vérité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Ghani"],
  mirrorVersion: `« Dis : L'intercession appartient entièrement à Allah. À Lui la royauté des cieux et de la terre. » Le miroir me montre la royauté d'Allah sur l'intercession. « Qul lillahi al-shafa'atu jami'an » — dis : L'intercession appartient entièrement à Allah. L'exclusivité est totale. Le miroir m'interroge : est-ce que je reconnais cette exclusivité ?`,
  reflection: `L'intercession appartient entièrement à Allah. Sa royauté sur les cieux et la terre est complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul lillahi al-shafa'atu jami'an lahu mulku al-samawati wa al-ard » — dis : L'intercession appartient entièrement à Allah. À Lui la royauté des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que l'intercession appartient entièrement à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'exclusivité divine est la clé de l'intercession." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "C'est vers Lui que vous serez ramenés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'exclusivité divine obtient l'intercession." }
  ],
  munajat: `Ya Malik, à Toi appartient l'intercession. Ne permets pas que je l'attribue à d'autres. Donne-moi de Te reconnaître comme seul Intercesseur.`
};

MIROIR["39:45"] = {
  reference: "39:45",
  theme: ["unicité", "coeur", "réaction"],
  emotion: "Vérité, diagnostic",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Et quand Allah est mentionné seul, les cœurs de ceux qui ne croient pas en l'au-delà se crispent. » Le miroir me montre la réaction des cœurs. « Wa idha dhukira Allahu wahdahu i'shazat qulubu alladhina la yu'minuna bi-al-akhirati » — et quand Allah est mentionné seul, les cœurs de ceux qui ne croient pas en l'au-delà se crispent. La crispation est un diagnostic. Le miroir m'interroge : comment réagit mon cœur ?`,
  reflection: `La mention d'Allah seul crispe les cœurs des associateurs. La réaction du cœur révèle la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha dhukira Allahu wahdahu i'shazat qulubu alladhina la yu'minuna bi-al-akhirati wa idha dhukira alladhina min dunihi idha hum yastabshirun » — et quand Allah est mentionné seul, les cœurs de ceux qui ne croient pas en l'au-delà se crispent. Et quand on mentionne ceux qui sont en dehors de Lui, voilà qu'ils se réjouissent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagit mon cœur quand Allah est mentionné seul ? Se réjouit-il ou se crispe-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réaction du cœur est le test de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les associateurs se réjouissent de leurs idoles, mais pas d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur se réjouit d'Allah seul est le vrai croyant." }
  ],
  munajat: `Ya Wahid, mon cœur se réjouit de Ta mention. Ne permets pas qu'il se crispe. Donne-moi la foi en l'unicité absolue.`
};

MIROIR["39:46"] = {
  reference: "39:46",
  theme: ["invocation", "jugement", "justice"],
  emotion: "Supplication, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Alim"],
  mirrorVersion: `« Dis : Ô Allah, Créateur des cieux et de la terre, Connaisseur de l'invisible et du visible, c'est Toi qui jugeras entre Tes serviteurs. » Le miroir me montre la supplication parfaite. « Qul Allaha khalaqa al-samawati wa al-ard » — dis : Ô Allah, Créateur des cieux et de la terre. L'invocation commence par la reconnaissance. Le miroir m'interroge : est-ce que j'invoque avec reconnaissance ?`,
  reflection: `L'invocation parfaite reconnaît Allah comme Créateur et Juge. Il tranche entre les serviteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul Allaha khalaqa al-samawati wa al-ard 'alima al-ghayba wa al-shahadati anta tahkumu bayna 'ibadika fi ma kanu fihi yakhtalifun » — dis : Ô Allah, Créateur des cieux et de la terre, Connaisseur de l'invisible et du visible, c'est Toi qui jugeras entre Tes serviteurs sur ce en quoi ils divergent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque avec reconnaissance de Ses attributs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des attributs divins précède la demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah tranche entre Ses serviteurs sur leurs différends." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque avec reconnaissance reçoit la réponse." }
  ],
  munajat: `Ya Fattah, Tu es le Créateur et le Juge. Ne permets pas que j'oublie Tes attributs. Donne-moi de T'invoquer avec reconnaissance parfaite.`
};

MIROIR["39:47"] = {
  reference: "39:47",
  theme: ["rançon", "jugement", "regret"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Hakam"],
  mirrorVersion: `« Si les injustes possédaient tout ce qui se trouve sur la terre, ils le donneraient pour se racheter du châtiment. » Le miroir me montre le regret des injustes. « Wa law anna lilladhina zalamu ma fi al-ardi jami'an wa mithlahu ma'ahu » — si les injustes possédaient tout ce qui se trouve sur la terre et autant encore. La rançon est impossible. Le miroir m'interroge : est-ce que je commets des injustices en pensant pouvoir me racheter ?`,
  reflection: `Les injustes voudraient se racheter mais ils ne le pourront pas. Le regret vient trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law anna lilladhina zalamu ma fi al-ardi jami'an wa mithlahu ma'ahu la-ftadaw bihi min su'i al-adhabi yawma al-qiyamati » — si les injustes possédaient tout ce qui se trouve sur la terre et autant encore, ils le donneraient pour se racheter du pire châtiment le Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je commets des injustices en pensant pouvoir me racheter ? Ou est-ce que je crains le jour où la rançon sera impossible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret de ce monde ne peut rien contre le châtiment de l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah leur montre le regret mais ils ne peuvent rien faire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'injustice ici-bas n'aura pas besoin de rançon là-bas." }
  ],
  munajat: `Ya Adl, je veux éviter l'injustice. Ne permets pas que je sois parmi les injustes. Donne-moi la justice qui mène au salut.`
};

MIROIR["39:48"] = {
  reference: "39:48",
  theme: ["mauvaises actions", "châtiment", "moquerie"],
  emotion: "Réalité, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Shahid"],
  mirrorVersion: `« Et leur apparaîtra ce qu'ils ne soupçonnaient pas : les mauvaises actions qu'ils ont commises. » Le miroir me montre la révélation des péchés. « Wa bada lahum sayyi'atu ma kasabu » — et leur apparaîtra les mauvaises actions qu'ils ont commises. La révélation est totale. Le miroir m'interroge : qu'apparaîtra-t-il de mes actions ?`,
  reflection: `Les mauvaises actions apparaîtront à leurs auteurs. La moquerie se retournera contre eux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa bada lahum sayyi'atu ma kasabu wa haqa bihim ma kanu bihi yastahzi'un » — et leur apparaîtra ce qu'ils ne soupçonnaient pas : les mauvaises actions qu'ils ont commises. Et les atteindra ce dont ils se moquaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'apparaîtra-t-il de mes actions ? Serai-je parmi ceux dont les mauvaises actions apparaîtront ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation des péchés est le début du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce dont ils se moquaient les atteindra." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache ses péchés ici-bas les verra révélés là-bas, à moins qu'il ne se repente." }
  ],
  munajat: `Ya Hasib, cache mes mauvaises actions. Ne permets pas qu'elles apparaissent. Donne-moi le repentir qui efface les péchés.`
};

MIROIR["39:49"] = {
  reference: "39:49",
  theme: ["épreuve", "ingratitude", "détresse"],
  emotion: "Mise en garde, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Manna", "Al-Mudill"],
  mirrorVersion: `« Quand l'homme touche par un malheur, il Nous invoque. Puis quand Nous lui accordons un bienfait de Notre part, il dit : Je l'ai obtenu grâce à ma science. » Le miroir me montre l'ingratitude humaine. « Fa-idha massa al-insana darrun da'ana » — quand l'homme touche par un malheur, il Nous invoque. L'invocation dans la détresse est naturelle. Mais la gratitude après le bienfait manque. Le miroir m'interroge : comment réagis-je après le bienfait ?`,
  reflection: `L'homme invoque dans la détresse mais attribue le bienfait à lui-même. C'est une épreuve et un oubli.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha massa al-insana darrun da'ana thumma idha khawwalnahu ni'matan minna qala innama utituha 'ala 'ilmin » — quand l'homme touche par un malheur, il Nous invoque. Puis quand Nous lui accordons un bienfait de Notre part, il dit : Je l'ai obtenu grâce à ma science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je après le bienfait ? Est-ce que j'attribue à Allah ou à moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attribution du bienfait à Allah est la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "C'est plutôt une épreuve, mais la plupart d'entre eux ne savent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attribue tout bienfait à Allah passe l'épreuve." }
  ],
  munajat: `Ya Manna, j'attribute tout bienfait à Toi. Ne permets pas que je l'attribute à moi-même. Donne-moi la reconnaissance constante.`
};

MIROIR["39:50"] = {
  reference: "39:50",
  theme: ["prédécesseurs", "ingratitude", "punition"],
  emotion: "Rappel, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Adl"],
  mirrorVersion: `« Ceux qui ont vécu avant eux disaient la même chose, et leurs actions ne leur ont servi à rien. » Le miroir me montre l'histoire des ingrats. « Qad qalaha alladhina min qablihim » — ceux qui ont vécu avant eux disaient la même chose. L'histoire se répète. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `Les prédécesseurs disaient la même chose et leurs actions ne leur ont servi à rien. L'histoire est un enseignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad qalaha alladhina min qablihim fa-ma aghna 'anhum ma kanu yaksibun » — ceux qui ont vécu avant eux disaient la même chose, et leurs actions ne leur ont servi à rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les mêmes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage de l'histoire est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les actions des ingrats ne leur servent à rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des erreurs des prédécesseurs ne les répète pas." }
  ],
  munajat: `Ya Alim, j'apprends de l'histoire. Ne permets pas que je répète les erreurs. Donne-moi la sagesse du passé.`
};

MIROIR["39:51"] = {
  reference: "39:51",
  theme: ["conséquence", "méfait", "punition"],
  emotion: "Réalité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Hasib"],
  mirrorVersion: `« Ils ont donc subi les conséquences de leurs méfaits. » Le miroir me montre la loi de la conséquence. « Fa-asabahum sayyi'atu ma kasabu » — ils ont donc subi les conséquences de leurs méfaits. La loi est inévitable. Le miroir m'interroge : quelles conséquences m'attendent ?`,
  reflection: `Les méfaits entraînent des conséquences. La justice divine s'applique à tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-asabahum sayyi'atu ma kasabu wa alladhina zalamu min ha'ula'i sayyusibuhum sayyi'atu ma kasabu wa ma hum bi-mu'jizin » — ils ont donc subi les conséquences de leurs méfaits. Et les injustes parmi ceux-ci subiront aussi les conséquences de leurs méfaits, et ils ne pourront s'opposer à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles conséquences m'attendent ? Serai-je parmi ceux qui subissent les conséquences de leurs méfaits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement des méfaits est la protection contre les conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne peut s'opposer à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les méfaits évite leurs conséquences." }
  ],
  munajat: `Ya Adl, je veux éviter les méfaits. Ne permets pas que je subisse leurs conséquences. Donne-moi la droiture qui mène au salut.`
};

MIROIR["39:52"] = {
  reference: "39:52",
  theme: ["provision", "générosité", "sagesse"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Wasi"],
  mirrorVersion: `« Ne savent-ils pas qu'Allah donne largement ou restreint Sa provision à qui Il veut ? » Le miroir me montre la sagesse de la provision. « A-wa lam ya'lamu anna Allaha yabsutu al-rizqa li-man yasha'u wa yaqdir » — ne savent-ils pas qu'Allah donne largement ou restreint Sa provision à qui Il veut ? La provision est un don. Le miroir m'interroge : est-ce que je me contente de ma provision ?`,
  reflection: `Allah donne largement ou restreint Sa provision selon Sa sagesse. Le contenuement est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam ya'lamu anna Allaha yabsutu al-rizqa li-man yasha'u wa yaqdir inna fi dhalika la-ayatin li-qawmin yu'minun » — ne savent-ils pas qu'Allah donne largement ou restreint Sa provision à qui Il veut ? Il y a certes là des signes pour des gens qui croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me contente de ma provision ? Ou est-ce que je réclame toujours plus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le contenuement de la provision est la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision est selon la sagesse d'Allah, pas selon les désirs humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se contente de sa provision est riche." }
  ],
  munajat: `Ya Razzaq, je me contente de ma provision. Ne permets pas que je réclame. Donne-moi la gratitude pour ce que Tu m'as donné.`
};

// ============ SURAH 15 (AL-HIJR) - Missing Entries ============

MIROIR["15:21"] = {
  reference: "15:21",
  theme: ["provision", "réserve", "décret"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Hafiz"],
  mirrorVersion: `« Il n'y a rien dont Nous n'ayons des réserves, et Nous ne le faisons descendre que selon une mesure déterminée. » Le miroir me montre la gestion divine de la provision. « Wa min kulli shay'in khalaqna naw'an » — de toute chose Nous avons créé une espèce. La provision est mesurée. Le miroir m'interroge : est-ce que je fais confiance à la mesure d'Allah ?`,
  reflection: `La provision est mesurée par Allah. La confiance en Sa mesure est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in min shay'in illa 'indana khaza'inuhu wa ma nunazziluhu illa bi-qadarin ma'lum » — il n'y a rien dont Nous n'ayons des réserves, et Nous ne le faisons descendre que selon une mesure déterminée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la mesure d'Allah ? Ou est-ce que je me plains de ce que je reçois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en la mesure divine apaise le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute provision vient d'Allah selon Sa sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mesure d'Allah trouve la paix." }
  ],
  munajat: `Ya Razzaq, je fais confiance à Ta mesure. Ne permets pas que je me plaigne. Donne-moi la reconnaissance pour ce que Tu m'as accordé.`
};

MIROIR["15:22"] = {
  reference: "15:22",
  theme: ["vent", "fertilisation", "provision"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Riyah", "Al-Ghayth"],
  mirrorVersion: `« Nous envoyons les vents fertilisateurs et Nous faisons descendre du ciel une eau dont Nous vous abreuvons. » Le miroir me montre les bienfaits naturels. « Wa arsalna al-riyaha lawaqiha » — Nous envoyons les vents fertilisateurs. Les vents préparent la pluie. Le miroir m'interroge : est-ce que je contemple les bienfaits de la nature ?`,
  reflection: `Les vents et la pluie sont des bienfaits organisés. La contemplation de la nature mène à la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa arsalna al-riyaha lawaqiha fa-anzalna mina al-sama'i ma'an fa-asqaynakumuh » — Nous envoyons les vents fertilisateurs et Nous faisons descendre du ciel une eau dont Nous vous abreuvons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les bienfaits de la nature ? Ou est-ce que je les tiens pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contemplation des bienfaits mène à la connaissance du Bienfaiteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature est un système de bienfaits organisés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les bienfaits découvre le Bienfaiteur." }
  ],
  munajat: `Ya Rabb, je contemple les bienfaits de la nature. Ne permets pas que je les ignore. Ouvre mes yeux aux signes partout autour de moi.`
};

MIROIR["15:23"] = {
  reference: "15:23",
  theme: ["vie", "mort", "héritage"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Warith"],
  mirrorVersion: `« C'est Nous qui donnons la vie et la mort, et Nous sommes l'Héritier. » Le miroir me montre la souveraineté d'Allah sur la vie et la mort. « Wa nahnu nuhyi wa numitu » — c'est Nous qui donnons la vie et la mort. Allah est le Maître de l'existence. Le miroir m'interroge : est-ce que je reconnais Sa souveraineté sur ma vie ?`,
  reflection: `La vie et la mort sont entre les mains d'Allah. Reconnaître Sa souveraineté est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nahnu nuhyi wa numitu wa nahnu al-warithun » — c'est Nous qui donnons la vie et la mort, et Nous sommes l'Héritier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Sa souveraineté sur ma vie ? Ou est-ce que je vis comme si j'étais mon propre maître ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de Sa souveraineté libère de l'anxiété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout appartient à Allah, qui en hérite à la fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît Sa souveraineté trouve la vraie liberté." }
  ],
  munajat: `Ya Rabb, je reconnais Ta souveraineté sur ma vie et ma mort. Ne permets pas que je vive comme si j'étais mon propre maître. Fais que je T'appartiens totalement.`
};

MIROIR["15:24"] = {
  reference: "15:24",
  theme: ["connaissance", "prédécesseurs", "successeurs"],
  emotion: "Certitude, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Khallaq"],
  mirrorVersion: `« Nous connaissons ceux d'entre vous qui avancent les premiers, et Nous connaissons ceux qui viennent après. » Le miroir me montre la connaissance parfaite d'Allah. « Wa laqad 'alimna al-mustaqdimina minkum » — Nous connaissons ceux d'entre vous qui avancent les premiers. Allah connaît tous les temps. Le miroir m'interroge : est-ce que je vis avec la conscience de Sa connaissance ?`,
  reflection: `Allah connaît tous les temps et toutes les générations. Vivre avec cette conscience purifie les actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad 'alimna al-mustaqdimina minkum wa laqad 'alimna al-muta'akhkhirin » — Nous connaissons ceux d'entre vous qui avancent les premiers, et Nous connaissons ceux qui viennent après." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de Sa connaissance ? Ou est-ce que j'oublie qu'Il me voit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de Sa connaissance transforme chaque instant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance d'Allah englobe tous les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec Sa connaissance vit en Sa présence." }
  ],
  munajat: `Ya 'Alim, Tu me connais et connais tous les temps. Ne permets pas que j'oublie Ta présence. Fais que je vive chaque instant avec la conscience de Ta connaissance.`
};

MIROIR["15:25"] = {
  reference: "15:25",
  theme: ["rassemblement", "résurrection", "certitude"],
  emotion: "Espérance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Hashr", "Al-Ba'th"],
  mirrorVersion: `« Ton Seigneur les rassemblera. Il est Sage et Omniscient. » Le miroir me montre la certitude du rassemblement. « Wa inna rabbaka huwa yahshuruhum » — ton Seigneur les rassemblera. Le rassemblement est certain. Le miroir m'interroge : est-ce que je me prépare pour ce rassemblement ?`,
  reflection: `Le rassemblement est certain. La préparation est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna rabbaka huwa yahshuruhum innahu hakimun 'alim » — ton Seigneur les rassemblera. Il est Sage et Omniscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour ce rassemblement ? Ou est-ce que je vis comme s'il n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le rassemblement commence maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les hommes seront rassemblés devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le rassemblement n'a rien à craindre." }
  ],
  munajat: `Ya Rabb, je me prépare pour le rassemblement. Ne permets pas que je l'oublie. Fais que chaque jour soit une préparation pour ce moment.`
};

MIROIR["15:26"] = {
  reference: "15:26",
  theme: ["création", "argile", "homme"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Insan"],
  mirrorVersion: `« Nous avons créé l'homme d'argile sonnante, issue d'une boue noire. » Le miroir me montre l'origine humble de l'homme. « Wa laqad khalaqna al-insana min salsalin min hama'in masnun » — Nous avons créé l'homme d'argile sonnante. L'homme vient de la terre. Le miroir m'interroge : est-ce que je me souviens de mon origine humble ?`,
  reflection: `L'homme vient de la terre. L'humilité est la reconnaissance de son origine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad khalaqna al-insana min salsalin min hama'in masnun » — Nous avons créé l'homme d'argile sonnante, issue d'une boue noire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine humble ? Ou est-ce que je m'enorgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité rappelle l'origine et prépare le retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les hommes viennent de la même argile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de son origine reste humble." }
  ],
  munajat: `Ya Rabb, je me souviens de mon origine humble. Ne permets pas l'orgueil dans mon cœur. Fais que je reste humble comme l'argile dont Tu m'as créé.`
};

MIROIR["15:27"] = {
  reference: "15:27",
  theme: ["djinns", "création", "feu"],
  emotion: "Connaissance, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jann", "An-Nar"],
  mirrorVersion: `« Quant aux djinns, Nous les avons créés auparavant du feu d'une chaleur ardente. » Le miroir me montre la diversité de la création. « Wa al-janna khalaqnahu min qablu min nari al-samum » — quant aux djinns, Nous les avons créés auparavant du feu. La création est diverse. Le miroir m'interroge : est-ce que je reconnais la diversité de la création ?`,
  reflection: `La création est diverse. Les djinns sont une création différente de l'homme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-janna khalaqnahu min qablu min nari al-samum » — quant aux djinns, Nous les avons créés auparavant du feu d'une chaleur ardente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la diversité de la création ? Ou est-ce que je limite ma vision ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la diversité élargit la compréhension." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah a créé des mondes visibles et invisibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la diversité honore le Créateur." }
  ],
  munajat: `Ya Rabb, je reconnais la diversité de Ta création. Ne permets pas que je limite ma vision. Ouvre mes yeux aux mondes que Tu as créés.`
};

MIROIR["15:29"] = {
  reference: "15:29",
  theme: ["souffle", "dignité", "adoration"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Ruh", "Al-Insan"],
  mirrorVersion: `« Quand Je l'aurai bien formé et lui aurai insufflé Mon souffle, prosternez-vous devant lui. » Le miroir me montre la dignité accordée à l'homme. « Fa-idha sawwaytuhu wa nafakhtu fihi min ruhi » — quand Je l'aurai bien formé et lui aurai insufflé Mon souffle. L'homme reçoit le souffle divin. Le miroir m'interroge : est-ce que j'honore cette dignité ?`,
  reflection: `L'homme reçoit le souffle divin. Honorer cette dignité est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha sawwaytuhu wa nafakhtu fihi min ruhi faqa'u lahu sajidin » — quand Je l'aurai bien formé et lui aurai insufflé Mon souffle, prosternez-vous devant lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'honore cette dignité ? Ou est-ce que je la souille par mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur de la dignité se manifeste par l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est honoré par le souffle divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore sa dignité adore son Créateur." }
  ],
  munajat: `Ya Rabb, je veux honorer la dignité que Tu m'as accordée. Ne permets pas que je la souille. Fais que chaque souffle soit une adoration.`
};

MIROIR["15:30"] = {
  reference: "15:30",
  theme: ["anges", "prosternation", "obéissance"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "As-Sujud"],
  mirrorVersion: `« Les anges se prosternèrent tous ensemble. » Le miroir me montre l'obéissance parfaite des anges. « Fa-sajada al-mala'ikatu kulluhum ajma'un » — les anges se prosternèrent tous ensemble. L'obéissance est totale. Le miroir m'interroge : est-ce que mon obéissance est aussi totale ?`,
  reflection: `Les anges obéissent parfaitement. L'obéissance totale est le modèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sajada al-mala'ikatu kulluhum ajma'un » — les anges se prosternèrent tous ensemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon obéissance est aussi totale ? Ou est-ce que je réserve une partie de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance totale élève l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont le modèle de l'obéissance parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit totalement s'approche du statut angélique." }
  ],
  munajat: `Ya Rabb, je veux obéir totalement comme les anges. Ne permets pas que je réserve une partie de moi. Fais que mon obéissance soit complète.`
};

MIROIR["15:31"] = {
  reference: "15:31",
  theme: ["iblis", "refus", "orgueil"],
  emotion: "Mise en garde, vigilance",
  difficulty: "débutant",
  relatedNames: ["Iblis", "Al-Kibr"],
  mirrorVersion: `« Excepté Iblis qui refusa de se joindre aux prosternés. » Le miroir me montre le danger de l'orgueil. « Ila iblisa aba an yakuna ma'a al-sajidin » — excepté Iblis qui refusa de se joindre aux prosternés. Le refus vient de l'orgueil. Le miroir m'interroge : est-ce que je refuse de me prosterner par orgueil ?`,
  reflection: `L'orgueil mène au refus de se prosterner. L'humilité est le remède.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila iblisa aba an yakuna ma'a al-sajidin » — excepté Iblis qui refusa de se joindre aux prosternés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je refuse de me prosterner par orgueil ? Ou est-ce que je m'humilie devant Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité guérit l'orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le refus de se prosterner est la marque d'Iblis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie devant Allah est élevé." }
  ],
  munajat: `Ya Rabb, je veux m'humilier devant Toi. Ne permets pas l'orgueil dans mon cœur. Fais que je me prosterne avec les prosternés.`
};

MIROIR["15:32"] = {
  reference: "15:32",
  theme: ["question", "iblis", "raison"],
  emotion: "Interrogation, clarté",
  difficulty: "débutant",
  relatedNames: ["Iblis", "As-Su'al"],
  mirrorVersion: `« O Iblis, qu'est-ce qui t'empêche de te prosterner ? » Le miroir me montre la question d'Allah à Iblis. « Ya iblisu ma laka alla takuna ma'a al-sajidin » — O Iblis, qu'est-ce qui t'empêche de te prosterner ? La question expose le refus. Le miroir m'interroge : qu'est-ce qui m'empêche de me prosterner ?`,
  reflection: `La question expose le refus. S'interroger sur ses obstacles est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya iblisu ma laka alla takuna ma'a al-sajidin » — O Iblis, qu'est-ce qui t'empêche de te prosterner ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de me prosterner ? Quels sont mes obstacles à l'adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'identification des obstacles permet de les surmonter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah questionne pour donner l'occasion de se repentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui identifie ses obstacles peut les surmonter." }
  ],
  munajat: `Ya Rabb, identifie les obstacles à mon adoration. Ne permets pas qu'ils me séparent de Toi. Aide-moi à les surmonter et à me prosterner.`
};

MIROIR["15:33"] = {
  reference: "15:33",
  theme: ["refus", "argile", "supériorité"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Iblis", "At-Tin"],
  mirrorVersion: `« Je ne me prosternerai pas devant un homme que Tu as créé d'argile sonnante. » Le miroir me montre l'argument d'Iblis. « Lam akun li-asjuda li-basharin khalaqtahu min salsalin » — je ne me prosternerai pas devant un homme que Tu as créé d'argile. Le mépris de la création. Le miroir m'interroge : est-ce que je méprise ce qu'Allah a honoré ?`,
  reflection: `Iblis méprise ce qu'Allah a honoré. Le respect de la création d'Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lam akun li-asjuda li-basharin khalaqtahu min salsalin min hama'in masnun » — je ne me prosternerai pas devant un homme que Tu as créé d'argile sonnante, issue d'une boue noire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je méprise ce qu'Allah a honoré ? Ou est-ce que je respecte Sa création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect de la création honore le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Celui qui méprise la création méprise le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la création respecte le Créateur." }
  ],
  munajat: `Ya Rabb, je respecte Ta création. Ne permets pas le mépris dans mon cœur. Fais que je voie Ta main dans tout ce que Tu as créé.`
};

MIROIR["15:34"] = {
  reference: "15:34",
  theme: ["expulsion", "maudit", "orgueil"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Iblis", "Al-La'nah"],
  mirrorVersion: `« Sors de là ! Tu es banni ! » Le miroir me montre la conséquence de l'orgueil. « Fa-khruj minha fa-innaka rajim » — sors de là ! Tu es banni. L'orgueil mène à l'expulsion. Le miroir m'interroge : est-ce que je crains cette expulsion ?`,
  reflection: `L'orgueil mène à l'expulsion. La crainte de cette conséquence motive l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-khruj minha fa-innaka rajim » — sors de là ! Tu es banni !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains cette expulsion ? Ou est-ce que je persiste dans l'orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité évite l'expulsion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil est la porte de l'expulsion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie n'est pas banni." }
  ],
  munajat: `Ya Rabb, je crains l'expulsion. Ne permets pas l'orgueil dans mon cœur. Fais que je m'humilie pour rester près de Toi.`
};

MIROIR["15:35"] = {
  reference: "15:35",
  theme: ["malédiction", "jour", "châtiment"],
  emotion: "Mise en garde, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-La'nah", "Al-Maw'ud"],
  mirrorVersion: `« La malédiction est sur toi jusqu'au Jour du Jugement. » Le miroir me montre la durée de la malédiction. « Wa inna 'alayka al-la'nata ila yawmi al-din » — la malédiction est sur toi jusqu'au Jour du Jugement. La malédiction est éternelle. Le miroir m'interroge : est-ce que je crains la malédiction éternelle ?`,
  reflection: `La malédiction est éternelle pour les obstinés. La crainte motive le repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna 'alayka al-la'nata ila yawmi al-din » — la malédiction est sur toi jusqu'au Jour du Jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la malédiction éternelle ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir évite la malédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La malédiction est le destin des orgueilleux obstinés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent n'est pas maudit." }
  ],
  munajat: `Ya Rabb, je crains la malédiction éternelle. Ne permets pas l'obstination dans mon cœur. Fais que je me repente avant qu'il ne soit trop tard.`
};

MIROIR["39:54"] = {
  reference: "39:54",
  theme: ["repentir", "mércielle", "mort"],
  emotion: "Espoir, urgence",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Et revenez repentants à votre Seigneur, et soumettez-vous à Lui, avant que ne vous vienne le châtiment. » Le miroir me montre l'urgence du repentir. « Wa anibu ila rabbikum wa aslimu lahu min qabli an ya'tiyakumu al-adhab » — et revenez repentants à votre Seigneur, et soumettez-vous à Lui, avant que ne vous vienne le châtiment. Le repentir est urgent. Le miroir m'interroge : est-ce que je me repens maintenant ?`,
  reflection: `Le repentir est urgent avant que le châtiment vienne. La mort peut survenir à tout moment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anibu ila rabbikum wa aslimu lahu min qabli an ya'tiyakumu al-adhabu thumma la tunsarun » — et revenez repentants à votre Seigneur, et soumettez-vous à Lui, avant que ne vous vienne le châtiment. Ensuite, vous ne serez pas secourus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens maintenant ? Ou est-ce que je repousse à plus tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir immédiat est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne sera secouru après le châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent maintenant sera protégé." }
  ],
  munajat: `Ya Tawwab, je me repens maintenant. Ne permets pas que je repousse. Donne-moi le repentir sincère avant qu'il ne soit trop tard.`
};

MIROIR["39:55"] = {
  reference: "39:55",
  theme: ["coran", "obéissance", "ignorance"],
  emotion: "Urgence, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Nur"],
  mirrorVersion: `« Et suivez ce qui a été descendu vers vous de la part de votre Seigneur, avant que ne vienne le châtiment à l'improviste. » Le miroir me montre l'urgence de suivre le Coran. « Wa ittabi'u ahsana ma unzila ilaykum min rabbikum » — et suivez ce qui a été descendu vers vous de la part de votre Seigneur. Le suivi est la guidance. Le miroir m'interroge : est-ce que je suis le Coran ?`,
  reflection: `Suivre le Coran est urgent avant que le châtiment vienne à l'improviste. L'ignorance n'est pas une excuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ittabi'u ahsana ma unzila ilaykum min rabbikum min qabli an ya'tiyakumu al-adhabu baghtatan wa antum la tash'urun » — et suivez ce qui a été descendu vers vous de la part de votre Seigneur, avant que ne vienne le châtiment à l'improviste, alors que vous ne le sentez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le Coran ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le suivi du Coran est la protection contre le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment peut venir à l'improviste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Coran est en sécurité." }
  ],
  munajat: `Ya Hadi, je suis Ton Coran. Ne permets pas que je l'ignore. Donne-moi d'obéir à Ta révélation avant qu'il ne soit trop tard.`
};

MIROIR["39:56"] = {
  reference: "39:56",
  theme: ["regret", "repentir", "âme"],
  emotion: "Regret, supplication",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« De peur que l'âme ne dise : Quel regret pour mes manquements envers Allah ! » Le miroir me montre le regret de l'âme. « An taqula nafsu ya hasrata 'ala ma farrattu fi janbi Allah » — de peur que l'âme ne dise : Quel regret pour mes manquements envers Allah ! Le regret vient trop tard. Le miroir m'interroge : est-ce que j'évite ce regret ?`,
  reflection: `Le regret de l'âme pour ses manquements envers Allah est profond. Il vaut mieux l'éviter maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An taqula nafsu ya hasrata 'ala ma farrattu fi janbi Allahi wa in kuntu la-mina al-sakhirin » — de peur que l'âme ne dise : Quel regret pour mes manquements envers Allah ! J'étais vraiment parmi les moqueurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite ce regret ? Ou est-ce que je serai parmi les regretteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement du regret se fait par l'action maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le regret est inutile quand le temps est écoulé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit maintenant évite le regret." }
  ],
  munajat: `Ya Tawwab, je veux éviter le regret. Ne permets pas que je sois parmi les regretteurs. Donne-moi d'agir maintenant pour éviter les manquements.`
};

MIROIR["39:57"] = {
  reference: "39:57",
  theme: ["guidance", "regret", "mércielle"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Ar-Rahman"],
  mirrorVersion: `« Ou qu'elle ne dise : Si Allah m'avait guidée, j'aurais été parmi les pieux. » Le miroir me montre l'excuse des égarés. « Aw taqula law hadani Allahu la-kuntu mina al-muttaqin » — ou qu'elle ne dise : Si Allah m'avait guidée, j'aurais été parmi les pieux. L'excuse est rejetée. Le miroir m'interroge : est-ce que je cherche la guidance ?`,
  reflection: `L'excuse "Si Allah m'avait guidée" est rejetée car la guidance est disponible pour ceux qui la cherchent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw taqula law hadani Allahu la-kuntu mina al-muttaqin » — ou qu'elle ne dise : Si Allah m'avait guidée, j'aurais été parmi les pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la guidance ? Ou est-ce que j'attends passivement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance se cherche activement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah guide ceux qui Le cherchent sincèrement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la guidance la trouve." }
  ],
  munajat: `Ya Hadi, je cherche Ta guidance. Ne permets pas que je sois parmi les égarés. Donne-moi d'être parmi les pieux par Ta guidance.`
};

MIROIR["39:58"] = {
  reference: "39:58",
  theme: ["châtiment", "regret", "mércielle"],
  emotion: "Crainte, supplication",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahim", "Al-Ghaffur"],
  mirrorVersion: `« Ou qu'elle ne dise, en voyant le châtiment : Si je pouvais retourner, je serais parmi les bienfaisants ! » Le miroir me montre le vœu des damnés. « Aw taqula hina tara al-adaba law anna li karratan fa-akuna mina al-muhsinin » — ou qu'elle ne dise, en voyant le châtiment : Si je pouvais retourner ! Le retour est impossible. Le miroir m'interroge : est-ce que j'agis maintenant comme si je pouvais retourner ?`,
  reflection: `Le vœu de retour est impossible après la mort. Il faut agir maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw taqula hina tara al-adaba law anna li karratan fa-akuna mina al-muhsinin » — ou qu'elle ne dise, en voyant le châtiment : Si je pouvais retourner, je serais parmi les bienfaisants !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'agis maintenant ? Ou est-ce que je serai parmi ceux qui voudront retourner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'action maintenant vaut mieux que le regret après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour est impossible après la mort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit maintenant n'aura pas besoin de souhaiter le retour." }
  ],
  munajat: `Ya Rahim, j'agis maintenant. Ne permets pas que je sois parmi ceux qui souhaitent le retour. Donne-moi d'être parmi les bienfaisants dès maintenant.`
};

MIROIR["39:59"] = {
  reference: "39:59",
  theme: ["signes", "mésiance", "orgueil"],
  emotion: "Réalité, jugement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Haqq"],
  mirrorVersion: `« Mais si ! Mes signes te sont venus et tu les as traités de mensonges, tu t'es enflé d'orgueil et tu as été parmi les mécréants. » Le miroir me montre le verdict divin. « Bala qad ja'atka ayati fa-kadhdhabta biha » — mais si ! Mes signes te sont venus et tu les as traités de mensonges. L'orgueil a aveuglé. Le miroir m'interroge : est-ce que je traite les signes de mensonges ?`,
  reflection: `Les signes sont venus mais l'orgueil a empêché de les accepter. Le verdict est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bala qad ja'atka ayati fa-kadhdhabta biha wa istakbarta wa kunta mina al-kafirin » — mais si ! Mes signes te sont venus et tu les as traités de mensonges, tu t'es enflé d'orgueil et tu as été parmi les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite les signes de mensonges ? Ou est-ce que je les accepte avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des signes avec humilité est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil est la barrière entre l'homme et la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes avec humilité est parmi les croyants." }
  ],
  munajat: `Ya Haqq, j'accepte Tes signes avec humilité. Ne permets pas que je sois orgueilleux. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["39:60"] = {
  reference: "39:60",
  theme: ["jugement", "mensonge", "visage"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Hakam"],
  mirrorVersion: `« Et au Jour de la Résurrection, tu verras ceux qui ont menti contre Allah, leurs visages noircis. » Le miroir me montre la punition des menteurs. « Wa yawma al-qiyamati tara alladhina kadhabu 'ala Allahi wujuhuhum muswaddatun » — et au Jour de la Résurrection, tu verras ceux qui ont menti contre Allah, leurs visages noircis. L'image est saisissante. Le miroir m'interroge : est-ce que je mens contre Allah ?`,
  reflection: `Les menteurs contre Allah auront les visages noircis au Jour du Jugement. Le mensonge est grave.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma al-qiyamati tara alladhina kadhabu 'ala Allahi wujuhuhum muswaddatun alaysa fi jahannama mathwan lil-mutakabbirin » — et au Jour de la Résurrection, tu verras ceux qui ont menti contre Allah, leurs visages noircis. N'y a-t-il pas dans l'enfer une demeure pour les orgueilleux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mens contre Allah ? Ou est-ce que je suis véridique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La véracité avec Allah est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfer est la demeure des orgueilleux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique avec Allah a le visage illuminé." }
  ],
  munajat: `Ya Adl, je suis véridique avec Toi. Ne permets pas que je mente. Donne-moi la véracité qui mène au salut.`
};

MIROIR["39:61"] = {
  reference: "39:61",
  theme: ["salut", "piété", "lumière"],
  emotion: "Espoir, réjouissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Najat"],
  mirrorVersion: `« Et Allah sauvera ceux qui ont été pieux en les faisant gagner. Nul mal ne les touchera et ils ne seront point affligés. » Le miroir me montre le salut des pieux. « Wa yunajji Allahu alladhina ittaqaw bi-mafazihim » — et Allah sauvera ceux qui ont été pieux en les faisant gagner. Le salut est certain. Le miroir m'interroge : suis-je parmi les pieux ?`,
  reflection: `Les pieux seront sauvés et aucun mal ne les touchera. La piété est la clé du salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yunajji Allahu alladhina ittaqaw bi-mafazihim la yamassuhumu al-su' wa la hum yahzanun » — et Allah sauvera ceux qui ont été pieux en les faisant gagner. Nul mal ne les touchera et ils ne seront point affligés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les pieux ? Ou suis-je en danger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété est la clé du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Meilleur Protecteur des pieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux est sauvé de tout mal." }
  ],
  munajat: `Ya Wali, sauve-moi par ma piété. Ne permets pas que je sois touché par le mal. Donne-moi d'être parmi les pieux qui sont sauvés.`
};

MIROIR["39:62"] = {
  reference: "39:62",
  theme: ["création", "puissance", "souveraineté"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Warith"],
  mirrorVersion: `« Allah est le Créateur de toute chose, et Il est le Garant de toute chose. » Le miroir me montre la souveraineté absolue d'Allah. « Allahu khaliqu kulli shay'in wa huwa 'ala kulli shay'in wakil » — Allah est le Créateur de toute chose, et Il est le Garant de toute chose. La création et la garantie sont ensemble. Le miroir m'interroge : est-ce que je me fie à ce Garant ?`,
  reflection: `Allah est le Créateur et le Garant de toute chose. La confiance en Lui est la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu khaliqu kulli shay'in wa huwa 'ala kulli shay'in wakil » — Allah est le Créateur de toute chose, et Il est le Garant de toute chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me fie à ce Garant ? Ou est-ce que je m'inquiète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah est la paix du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les clés des cieux et de la terre Lui appartiennent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se fie à Allah est en sécurité." }
  ],
  munajat: `Ya Wakil, je me fie à Toi. Ne permets pas que je m'inquiète. Donne-moi la confiance en Ton garantie parfaite.`
};

MIROIR["39:63"] = {
  reference: "39:63",
  theme: ["clés", "souveraineté", "mésiance"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Ghani"],
  mirrorVersion: `« À Lui appartiennent les clés des cieux et de la terre. » Le miroir me montre la maîtrise absolue. « Lahu maqalidu al-samawati wa al-ard » — à Lui appartiennent les clés des cieux et de la terre. Les clés symbolisent le contrôle total. Le miroir m'interroge : est-ce que je reconnais Sa maîtrise ?`,
  reflection: `Les clés des cieux et de la terre appartiennent à Allah. Ceux qui mécroient en Ses signes sont les perdants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu maqalidu al-samawati wa al-ard wa alladhina kafaru bi-ayati Allahi ula'ika hum al-khasirun » — à Lui appartiennent les clés des cieux et de la terre. Et ceux qui mécroient en Ses signes, ce sont eux les perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Sa maîtrise ? Ou est-ce que je mécrois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de Sa maîtrise est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les perdants sont ceux qui mécroient en Ses signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît Sa maîtrise n'est jamais perdant." }
  ],
  munajat: `Ya Malik, je reconnais Ta maîtrise. Ne permets pas que je sois parmi les perdants. Donne-moi la foi en Tes signes.`
};

MIROIR["39:64"] = {
  reference: "39:64",
  theme: ["adoration", "association", "question"],
  emotion: "Interpellation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Haqq"],
  mirrorVersion: `« Dis : Me commanderez-vous d'adorer autre qu'Allah, ô ignorants ? » Le miroir me montre l'absurdité de l'association. « Qul a-fa-ghayra Allahi ta'murunni a'budu ayyuha al-jahlun » — dis : Me commanderez-vous d'adorer autre qu'Allah, ô ignorants ? La question est cinglante. Le miroir m'interroge : est-ce que j'adore autre qu'Allah ?`,
  reflection: `Adorer autre qu'Allah est l'ignorance suprême. La question du Coran interpelle tous les associateurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul a-fa-ghayra Allahi ta'murunni a'budu ayyuha al-jahlun » — dis : Me commanderez-vous d'adorer autre qu'Allah, ô ignorants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore autre qu'Allah ? Ou est-ce que je Lui suis exclusif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité de l'adoration est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration d'autre qu'Allah est l'ignorance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah exclusivement est le savant." }
  ],
  munajat: `Ya Wahid, je T'adore exclusivement. Ne permets pas que j'adore autre que Toi. Donne-moi la sagesse de l'unicité.`
};

MIROIR["39:65"] = {
  reference: "39:65",
  theme: ["association", "annulation", "mise en garde"],
  emotion: "Gravité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Al-Wahid"],
  mirrorVersion: `« En effet, il t'a été révélé, ainsi qu'à ceux qui t'ont précédé : Si tu associes, ton œuvre sera vaine. » Le miroir me montre l'annulation par l'association. « Wa laqad uhiya ilayka wa ila alladhina min qablika la-in ashrakta la-yahbatanna 'amaluka » — en effet, il t'a été révélé : Si tu associes, ton œuvre sera vaine. L'association annule tout. Le miroir m'interroge : est-ce que j'évite l'association ?`,
  reflection: `L'association annule toutes les œuvres. La mise en garde est pour tous les prophètes et leurs suivants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad uhiya ilayka wa ila alladhina min qablika la-in ashrakta la-yahbatanna 'amaluka wa la-takunanna mina al-khasirin » — en effet, il t'a été révélé, ainsi qu'à ceux qui t'ont précédé : Si tu associes, ton œuvre sera vaine et tu seras certainement parmi les perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite l'association ? Ou est-ce que je risque l'annulation de mes œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement de l'association préserve les œuvres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'association est le plus grand péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'association préserve ses œuvres." }
  ],
  munajat: `Ya Ghafur, j'évite l'association. Ne permets pas que mes œuvres soient vaines. Donne-moi l'unicité parfaite.`
};

MIROIR["39:66"] = {
  reference: "39:66",
  theme: ["adoration", "gratitude", "guidance"],
  emotion: "Soumission, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Hadi"],
  mirrorVersion: `« Plutôt, adore Allah seul et sois parmi les reconnaissants. » Le miroir me montre la voie droite. « Bali Allaha fa'bud wa kun mina al-shakirin » — plutôt, adore Allah seul et sois parmi les reconnaissants. L'adoration et la gratitude vont ensemble. Le miroir m'interroge : suis-je parmi les reconnaissants ?`,
  reflection: `Adorer Allah seul et être reconnaissant est la voie droite. La gratitude accompagne l'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bali Allaha fa'bud wa kun mina al-shakirin » — plutôt, adore Allah seul et sois parmi les reconnaissants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les reconnaissants ? Ou est-ce que j'oublie de remercier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude est le complément de l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration exclusive avec gratitude est la voie parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant atteint le sommet de l'adoration." }
  ],
  munajat: `Ya Shakir, je suis reconnaissant. Ne permets pas que j'oublie de Te remercier. Donne-moi d'être parmi les reconnaissants.`
};

MIROIR["39:67"] = {
  reference: "39:67",
  theme: ["grandeur", "transcendance", "mésiance"],
  emotion: "Émerveillement, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Azim", "Al-Kabir"],
  mirrorVersion: `« Ils n'ont pas estimé Allah à Sa juste valeur. La terre entière sera saisie dans Sa poigne le Jour de la Résurrection. » Le miroir me montre la transcendance absolue. « Ma qadaru Allaha haqqa qadrihi wa al-ardu jami'an qabdatuhu yawma al-qiyamati » — ils n'ont pas estimé Allah à Sa juste valeur. La terre entière sera saisie dans Sa poigne. L'image est vertigineuse. Le miroir m'interroge : est-ce que j'estime Allah à Sa juste valeur ?`,
  reflection: `Les hommes n'estiment pas Allah à Sa juste valeur. Sa grandeur dépasse toute imagination.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma qadaru Allaha haqqa qadrihi wa al-ardu jami'an qabdatuhu yawma al-qiyamati wa al-samawatu matwiyyatun bi-yaminihi subhanahu wa ta'ala 'amma yushrikun » — ils n'ont pas estimé Allah à Sa juste valeur. La terre entière sera saisie dans Sa poigne le Jour de la Résurrection, et les cieux seront pliés dans Sa main droite. Gloire à Lui ! Il est très élevé au-dessus de ce qu'ils associent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'estime Allah à Sa juste valeur ? Ou est-ce que je Le sous-estime ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'estimation d'Allah à Sa juste valeur est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est très élevé au-dessus de ce qu'ils associent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui estime Allah à Sa juste valeur Le connaît vraiment." }
  ],
  munajat: `Ya Azim, je veux T'estimer à Ta juste valeur. Ne permets pas que je Te sous-estime. Donne-moi de Te connaître dans Ta grandeur.`
};

MIROIR["39:68"] = {
  reference: "39:68",
  theme: ["trompette", "résurrection", "puissance"],
  emotion: "Stupéfaction, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« Et on soufflera dans la Trompe, et voilà que ceux qui sont dans les cieux et ceux qui sont sur la terre seront foudroyés. » Le miroir me montre le souffle de la fin. « Wa nufikha fi al-suri fa-sa'iqa man fi al-samawati wa man fi al-ardi » — et on soufflera dans la Trompe, et voilà que ceux qui sont dans les cieux et ceux qui sont sur la terre seront foudroyés. L'instant est terrifiant. Le miroir m'interroge : suis-je prêt pour ce moment ?`,
  reflection: `Le souffle de la Trompe foudroiera tous les êtres. Seuls ceux qu'Allah veut seront épargnés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nufikha fi al-suri fa-sa'iqa man fi al-samawati wa man fi al-ardi illa man sha'a Allahu » — et on soufflera dans la Trompe, et voilà que ceux qui sont dans les cieux et ceux qui sont sur la terre seront foudroyés, sauf ceux qu'Allah veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ce moment ? Ou serai-je parmi les foudroyés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour ce moment est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Puis on y soufflera de nouveau, et les voilà debout, regardant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour ce moment n'a rien à craindre." }
  ],
  munajat: `Ya Muhyi, je me prépare pour ce moment. Ne permets pas que je sois surpris. Donne-moi d'être parmi ceux que Tu veux épargner.`
};

MIROIR["39:69"] = {
  reference: "39:69",
  theme: ["jugement", "lumière", "justice"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Nur"],
  mirrorVersion: `« La terre resplendira de la lumière de son Seigneur. Le Livre sera déposé. » Le miroir me montre le Jour du Jugement. « Wa ashraqati al-ardu bi-nuri rabbaha wa wudi'a al-kitab » — la terre resplendira de la lumière de son Seigneur. Le Livre sera déposé. La lumière et le Livre sont là. Le miroir m'interroge : que dira mon Livre ?`,
  reflection: `La lumière d'Allah illuminera la terre au Jour du Jugement. Les prophètes et les témoins seront présents.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ashraqati al-ardu bi-nuri rabbaha wa wudi'a al-kitab wa ji'a bi-al-nabiyyina wa al-shuhada'i wa qudiya baynahum bi-al-haqqi wa hum la yuzlamun » — la terre resplendira de la lumière de son Seigneur. Le Livre sera déposé. On fera venir les prophètes et les témoins, et on décidera entre eux avec justice, et ils ne seront point lésés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que dira mon Livre ? Serai-je parmi les justes ou les injustes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice parfaite sera rendue à tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne sera lésé au Jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a un bon Livre resplendira avec la lumière." }
  ],
  munajat: `Ya Adl, je veux un bon Livre. Ne permets pas que je sois lésé. Donne-moi la justice qui mène au salut.`
};

MIROIR["39:70"] = {
  reference: "39:70",
  theme: ["rétribution", "œuvres", "comptabilité"],
  emotion: "Certitude, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Shakur"],
  mirrorVersion: `« Et chaque âme sera pleinement rétribuée pour ce qu'elle a fait. » Le miroir me montre la rétribution complète. « Wa wuffiyat kullu nafsin ma 'amilat » — et chaque âme sera pleinement rétribuée pour ce qu'elle a fait. La rétribution est exacte. Le miroir m'interroge : que serai-je rétribué ?`,
  reflection: `Chaque âme sera rétribuée selon ses œuvres. Allah connaît parfaitement ce qu'elles font.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wuffiyat kullu nafsin ma 'amilat wa huwa a'lamu bima yaf'alun » — et chaque âme sera pleinement rétribuée pour ce qu'elle a fait. Et Il sait mieux ce qu'elles font." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que serai-je rétribué ? Serai-je satisfait de ma rétribution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rétribution exacte est la justice parfaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît parfaitement toutes les actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien reçoit le bien." }
  ],
  munajat: `Ya Hasib, je veux une bonne rétribution. Ne permets pas que je sois déçu. Donne-moi d'agir pour le bien.`
};

MIROIR["39:71"] = {
  reference: "39:71",
  theme: ["enfer", "mérciance", "regret"],
  emotion: "Effroi, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Adl"],
  mirrorVersion: `« Et ceux qui ont mécru seront conduits par groupes à l'enfer. » Le miroir me montre la marche vers l'enfer. « Wa siqa alladhina kafaru ila jahannama zumaran » — et ceux qui ont mécru seront conduits par groupes à l'enfer. L'image est effrayante. Le miroir m'interroge : serai-je parmi ces groupes ?`,
  reflection: `Les mécréants seront conduits par groupes à l'enfer. Les portes s'ouvriront et les gardiens les interrogeront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa siqa alladhina kafaru ila jahannama zumaran hatta idha ja'uha futihat abwabuha » — et ceux qui ont mécru seront conduits par groupes à l'enfer. Puis quand ils y arriveront, ses portes s'ouvriront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Serai-je parmi ces groupes ? Ou serai-je épargné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi épargne de ce destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les gardiens diront : Des messagers ne vous sont-ils pas venus ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute les messagers n'est pas conduit à l'enfer." }
  ],
  munajat: `Ya Rahim, épargne-moi de l'enfer. Ne permets pas que je sois parmi les groupes des mécréants. Donne-moi la foi qui sauve.`
};

MIROIR["39:72"] = {
  reference: "39:72",
  theme: ["enfer", "éternité", "châtiment"],
  emotion: "Effroi, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Khuld"],
  mirrorVersion: `« Il sera dit : Entrez par les portes de l'enfer pour y demeurer éternellement. » Le miroir me montre l'entrée en enfer. « Qila al-khulu abwaba jahannama khalidina fiha » — il sera dit : Entrez par les portes de l'enfer pour y demeurer éternellement. L'éternité est terrifiante. Le miroir m'interroge : comment éviter cette entrée ?`,
  reflection: `L'entrée en enfer est éternelle. Quel mauvais lieu de séjour pour les orgueilleux !`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qila al-khulu abwaba jahannama khalidina fiha fa-bi'sa mathwa al-mutakabbirin » — il sera dit : Entrez par les portes de l'enfer pour y demeurer éternellement. Quel mauvais lieu de séjour pour les orgueilleux !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment éviter cette entrée ? Serai-je parmi les orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité est la protection contre l'enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfer est le lieu des orgueilleux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble évite l'enfer." }
  ],
  munajat: `Ya Rahim, je veux éviter l'enfer. Ne permets pas que j'y entre. Donne-moi l'humilité qui mène au paradis.`
};

MIROIR["39:73"] = {
  reference: "39:73",
  theme: ["paradis", "récompense", "accueil"],
  emotion: "Espoir, réjouissance",
  difficulty: "débutant",
  relatedNames: ["Al-Firdaws", "Al-Karim"],
  mirrorVersion: `« Et ceux qui ont craint leur Seigneur seront conduits par groupes au paradis. » Le miroir me montre la marche vers le paradis. « Wa siqa alladhina ittaqaw rabbahum ila al-jannati zumaran » — et ceux qui ont craint leur Seigneur seront conduits par groupes au paradis. L'image est joyeuse. Le miroir m'interroge : serai-je parmi ces groupes ?`,
  reflection: `Les pieux seront conduits par groupes au paradis. Les portes s'ouvriront et les gardiens les accueilleront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa siqa alladhina ittaqaw rabbahum ila al-jannati zumaran hatta idha ja'uha wa futihat abwabuha » — et ceux qui ont craint leur Seigneur seront conduits par groupes au paradis. Puis quand ils y arriveront, ses portes s'ouvriront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Serai-je parmi ces groupes ? Ou serai-je laissé en arrière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah mène au paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les gardiens diront : Que la paix soit sur vous ! Vous avez été bons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant entrera au paradis." }
  ],
  munajat: `Ya Karim, je veux entrer au paradis. Ne permets pas que je sois laissé en arrière. Donne-moi la crainte qui mène aux portes du paradis.`
};

MIROIR["39:74"] = {
  reference: "39:74",
  theme: ["paradis", "louange", "promesse"],
  emotion: "Gratitude, réjouissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wadi", "Al-Haqq"],
  mirrorVersion: `« Et ils diront : Louange à Allah qui nous a réalisé Sa promesse ! » Le miroir me montre la louange des habitants du paradis. « Wa qalu al-hamdu lillahi alladhi sadaqana wa'dahu » — et ils diront : Louange à Allah qui nous a réalisé Sa promesse ! La promesse est tenue. Le miroir m'interroge : serai-je parmi ceux qui disent cette louange ?`,
  reflection: `Les habitants du paradis louent Allah pour Sa promesse tenue. Ils ont hérité du paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu al-hamdu lillahi alladhi sadaqana wa'dahu wa awathana al-arda natakhabu mina al-jannati haythu nasha' » — et ils diront : Louange à Allah qui nous a réalisé Sa promesse et nous a fait hériter de la terre ! Nous nous installons dans le paradis là où nous voulons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Serai-je parmi ceux qui disent cette louange ? Ou serai-je privé de cette joie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah est certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Quelle excellente récompense pour ceux qui font le bien !" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la promesse maintenant la verra réalisée." }
  ],
  munajat: `Ya Wadi, je veux voir Ta promesse réalisée. Ne permets pas que je sois privé. Donne-moi d'être parmi les habitants du paradis qui Te louent.`
};

MIROIR["39:75"] = {
  reference: "39:75",
  theme: ["anges", "louange", "trône"],
  emotion: "Révérence, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ika", "Al-Arsh"],
  mirrorVersion: `« Et tu verras les anges faisant cercle autour du Trône, célébrant les louanges de leur Seigneur. » Le miroir me montre la scène céleste. « Wa tara al-mala'ikata haffina min hawli al-arshi yusabbihuna bi-hamdi rabbihim » — et tu verras les anges faisant cercle autour du Trône, célébrant les louanges de leur Seigneur. L'image est magnifique. Le miroir m'interroge : est-ce que je participe à cette louange ?`,
  reflection: `Les anges entourent le Trône et célèbrent les louanges d'Allah. Le jugement sera équitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tara al-mala'ikata haffina min hawli al-arshi yusabbihuna bi-hamdi rabbihim wa qudiya baynahum bi-al-haqqi wa qila al-hamdu lillahi rabbi al-alamin » — et tu verras les anges faisant cercle autour du Trône, célébrant les louanges de leur Seigneur. Il sera décidé entre eux en toute justice, et il sera dit : Louange à Allah, Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe à cette louange ? Ou est-ce que je reste silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La participation à la louange angélique est un honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement sera équitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue Allah maintenant sera parmi les louangeurs." }
  ],
  munajat: `Ya Rabb al-alamin, je participe à Ta louange. Ne permets pas que je reste silencieux. Donne-moi d'être parmi les louangeurs éternels.`
};

MIROIR["15:36"] = {
  reference: "15:36",
  theme: ["délai", "repentir", "tentation"],
  emotion: "Mise en garde, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Iblis", "Al-Ajal"],
  mirrorVersion: `« Seigneur, donne-moi un délai jusqu'au jour où ils seront ressuscités. » Le miroir me montre la demande d'Iblis. « Rabbi fa-anzirni ila yawmi yub'athun » — Seigneur, donne-moi un délai. Iblis demande du temps pour égarer. Le miroir m'interroge : est-ce que je suis conscient du temps limité que j'ai ?`,
  reflection: `Le temps est limité. L'utiliser pour le bien est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi fa-anzirni ila yawmi yub'athun » — Seigneur, donne-moi un délai jusqu'au jour où ils seront ressuscités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient du temps limité que j'ai ? Ou est-ce que je vis comme si j'avais l'éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience du temps limité motive l'action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est une miséricorde pour les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise son temps pour le bien gagne l'éternité." }
  ],
  munajat: `Ya Rabb, je suis conscient du temps limité que j'ai. Ne permets pas que je le gaspille. Fais que chaque instant compte pour Toi.`
};

MIROIR["15:37"] = {
  reference: "15:37",
  theme: ["délai", "permission", "sagesse"],
  emotion: "Confiance, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ajal", "Al-Hikmah"],
  mirrorVersion: `« Tu es de ceux à qui un délai est accordé. » Le miroir me montre la permission accordée. « Fa-innaka mina al-munzarin » — tu es de ceux à qui un délai est accordé. Le délai est accordé avec sagesse. Le miroir m'interroge : est-ce que j'utilise le délai qui m'est accordé ?`,
  reflection: `Le délai est accordé avec sagesse. L'utiliser pour le bien est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innaka mina al-munzarin » — tu es de ceux à qui un délai est accordé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise le délai qui m'est accordé ? Ou est-ce que je le gaspille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'utilisation du délai détermine le destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le délai est une miséricorde pour se repentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise son délai pour le bien est sauvé." }
  ],
  munajat: `Ya Rabb, je veux utiliser le délai que Tu m'accordes. Ne permets pas que je le gaspille. Fais que chaque jour soit un pas vers Toi.`
};

MIROIR["15:38"] = {
  reference: "15:38",
  theme: ["temps", "jour", "connu"],
  emotion: "Certitude, préparation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waqt", "Al-Ma'lum"],
  mirrorVersion: `« Jusqu'au jour du temps connu. » Le miroir me montre la limite du temps. « Ila yawmi al-waqti al-ma'lum » — jusqu'au jour du temps connu. Le temps a une limite connue d'Allah. Le miroir m'interroge : est-ce que je vis avec la conscience de cette limite ?`,
  reflection: `Le temps a une limite connue d'Allah. La conscience de cette limite motive la préparation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila yawmi al-waqti al-ma'lum » — jusqu'au jour du temps connu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de cette limite ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la limite donne valeur au temps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fin du temps est connue d'Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la conscience de la limite prépare son éternité." }
  ],
  munajat: `Ya Rabb, je vis avec la conscience de la limite du temps. Ne permets pas que je l'oublie. Fais que je prépare mon éternité chaque jour.`
};

MIROIR["15:39"] = {
  reference: "15:39",
  theme: ["égarement", "tentation", "voie"],
  emotion: "Vigilance, prudence",
  difficulty: "débutant",
  relatedNames: ["Iblis", "As-Sabil"],
  mirrorVersion: `« Seigneur, parce que Tu m'as égaré, je leur enjoliverai la vie terrestre et les égarerai tous. » Le miroir me montre la menace d'Iblis. « Rabbi bima aghwaytani » — Seigneur, parce que Tu m'as égaré. Iblis promet d'égarer tous les hommes. Le miroir m'interroge : est-ce que je me protège contre cette égarement ?`,
  reflection: `Iblis promet d'égarer tous les hommes. La protection contre l'égarement est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi bima aghwaytani la-uzayyinanna lahum fi al-ardi wa la-ughwiyannahum ajma'in » — Seigneur, parce que Tu m'as égaré, je leur enjoliverai la vie terrestre et les égarerai tous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me protège contre cet égarement ? Ou est-ce que je suis vulnérable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection contre l'égarement vient d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'égarement est la stratégie d'Iblis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande protection à Allah est protégé." }
  ],
  munajat: `Ya Rabb, je demande Ta protection contre l'égarement d'Iblis. Ne permets pas que je sois de ceux qu'il égare. Protège-moi de ses tentations.`
};

MIROIR["15:40"] = {
  reference: "15:40",
  theme: ["serviteurs", "protection", "sincérité"],
  emotion: "Espérance, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Ibad", "Al-Mukhlasin"],
  mirrorVersion: `« Excepté Tes serviteurs sincères parmi eux. » Le miroir me montre l'exception à l'égarement. « Ila 'ibadika minhum al-mukhlasin » — excepté Tes serviteurs sincères. La sincérité protège. Le miroir m'interroge : est-ce que je suis de ces serviteurs sincères ?`,
  reflection: `La sincérité protège de l'égarement. Être sincère est la clé de la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila 'ibadika minhum al-mukhlasin » — excepté Tes serviteurs sincères parmi eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis de ces serviteurs sincères ? Ou est-ce que mon cœur est partagé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité totale protège de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les serviteurs sincères sont protégés par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère est protégé de toute tentation." }
  ],
  munajat: `Ya Rabb, je veux être de Tes serviteurs sincères. Ne permets pas que mon cœur soit partagé. Donne-moi la sincérité totale qui protège de l'égarement.`
};

MIROIR["15:41"] = {
  reference: "15:41",
  theme: ["voie", "droiture", "guidance"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sirat", "Al-Mustaqim"],
  mirrorVersion: `« Voici une voie droite menant à Moi. » Le miroir me montre la voie d'Allah. « Hadha siratun 'alayya mustaqim » — voici une voie droite menant à Moi. La voie existe et mène à Allah. Le miroir m'interroge : est-ce que je suis sur cette voie ?`,
  reflection: `La voie droite mène à Allah. La suivre est essentiel.`,
  tajalli: [
