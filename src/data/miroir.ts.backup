  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yut'imuna al-ta'ama 'ala hubbihi miskinan wa yatiman wa asira » — et ils nourrissent, par amour pour Allah, le pauvre, l'orphelin et le prisonnier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nourris par amour pour Allah ? La charité est-elle ma pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La charité par amour pour Allah purifie." },
