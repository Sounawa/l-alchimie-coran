    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour le rassemblement ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le rassemblement commence maintenant." },
