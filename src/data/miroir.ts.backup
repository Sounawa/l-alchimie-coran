    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La précision divine est dans chaque verset." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attention aux détails du Livre ouvre les trésors." }
  ],
  munajat: `Ya Rabb, merci pour les versets détaillés. Fais que je les lise avec attention. Ne permets pas que je les néglige.`
};

MIROIR["41:4"] = {
