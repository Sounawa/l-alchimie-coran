// === SURAH 11 (HUD) - Missing verses 12-87, 89, 91-123 ===

MIROIR["11:12"] = {
  reference: "11:12",
  theme: ["révélation", "patience", "sagesse"],
  emotion: "Confiance, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Il se peut que tu négliges une partie de ce qui t'est révélé et que ta poitrine s'en sente serrée. » Le miroir me montre la charge du message. Le Prophète lui-même ressentait le poids de la révélation — la responsabilité de transmettre. « Tas'a sadruka » — ta poitrine se serre. L'angoisse de l'accomplissement. Le miroir me rappelle que même les prophètes connaissaient l'angoisse, et que cette angoisse n'était pas un échec — elle était la mesure de leur responsabilité.`,
  reflection: `Le poids de la responsabilité est le signe de l'importance de la mission. L'angoisse n'est pas faiblesse — elle est conscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'allaaka taarikum ba'da ma yuuhaa ilayka wa daaa'iqum bihi sadruk » — il se peut que tu négliges une partie de ce qui t'est révélé et que ta poitrine s'en sente serrée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui pèse sur ma poitrine ? Quelle responsabilité me serre le cœur ? Le miroir me montre que le poids est proportionnel à l'importance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le poids devient légèreté quand il est partagé avec Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création porte une charge proportionnelle à sa mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte pour Allah n'est jamais écrasé." }
  ],
  munajat: `Ya Hakim, Tu connais le poids que je porte. Allège ma poitrine. Fais que ma charge devienne légèreté par Ta présence.`
};

MIROIR["11:13"] = {
  reference: "11:13",
  theme: ["coran", "défi", "vérité"],
  emotion: "Certitude, défi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Muhaymin"],
  mirrorVersion: `« Ou ils disent : 'Il l'a forgé.' Dis : 'Apportez donc dix sourates semblables à celle-ci, forgées.' » Le miroir me montre le défi éternel du Coran. « Iftaraahu » — il l'a forgé. L'accusation de mensonge. La réponse divine : le défi de produire semblable. Le miroir m'invite à contempler l'inimitabilité du texte sacré — non comme un argument polémique, mais comme une invitation à la beauté.`,
  reflection: `Le Coran se suffit à lui-même comme preuve. Sa beauté est son argument.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yaquuluunafariyaahu qul fa'tuu bi 'ashri suwarim mistlihi muftaraayaat » — ou ils disent : il l'a forgé. Dis : apportez donc dix sourates semblables." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la beauté du Coran ? Ou est-ce que je le traite comme un texte ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le défi du Coran est une invitation, pas une condamnation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté du Coran reflète la beauté de son Auteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte au Coran n'a plus besoin d'autres preuves." }
  ],
  munajat: `Ya Haqq, fais que je reconnaisse Ta parole quand je la lis. Ouvre mon cœur à la beauté du Coran.`
};

MIROIR["11:14"] = {
  reference: "11:14",
  theme: ["invocation", "réponse", "vérité"],
  emotion: "Attente, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Haqq"],
  mirrorVersion: `« S'ils ne vous répondent pas, sachez alors qu'il est descendu avec la science d'Allah. » Le miroir me montre l'épreuve de la vérité. L'absence de réponse est elle-même une réponse. « Fa'lamuu annamaa unzila bi 'ilmil laah » — sachez qu'il est descendu avec la science d'Allah. Le silence des détracteurs devient preuve. Le miroir m'enseigne que la vérité se suffit.`,
  reflection: `Quand les arguments s'épuisent, la vérité reste debout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-il lam yastajeebu lakum fa'lamuu annamaa unzila bi 'ilmil laah » — s'ils ne vous répondent pas, sachez qu'il est descendu avec la science d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle vérité je porte qui se suffit à elle-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité n'a pas besoin de défenseurs — elle se défend elle-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est construit sur la vérité — elle est son fondement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la vérité n'a pas besoin de la prouver." }
  ],
  munajat: `Ya Mujib, je m'en remets à Ta vérité. Fais que je sois du côté de ce qui est vrai.`
};

MIROIR["11:15"] = {
  reference: "11:15",
  theme: ["monde", "récompense", "choix"],
  emotion: "Clarté, décision",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Akhirah"],
  mirrorVersion: `« Quiconque désire la vie immédiate et sa parure, Nous lui en donnerons la récompense complète. » Le miroir me montre le choix fondamental. « Man kana yuriidul hayaatad dunyaa » — quiconque désire la vie immédiate. Le désir détermine la destination. « Nuwaffiya ilayhi a'maalihim » — Nous leur donnerons la récompense complète. Justice absolue. Le miroir m'interroge : que désire-je vraiment ?`,
  reflection: `Le désir est le compas de l'âme. On reçoit ce qu'on désire vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kana yuriidul hayaatad dunyaa wa zeenatahaa nuwaffiya ilayhi a'maalihim » — quiconque désire la vie immédiate et sa parure, Nous lui en donnerons la récompense complète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je désire vraiment ? La vie immédiate ou l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui désire l'au-delà reçoit le monde en plus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond au désir sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai désir est caché — seul Allah le connaît." }
  ],
  munajat: `Ya Rabb, purifie mon désir. Fais que je Te désire Toi, au-dessus de tout.`
};

MIROIR["11:16"] = {
  reference: "11:16",
  theme: ["au-delà", "perte", "réalité"],
  emotion: "Réalité, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hasibu"],
  mirrorVersion: `« Ceux-là qui n'auront dans l'au-delà que le Feu. » Le miroir me montre la conséquence du choix. « Ulaaa'ikal lazeena laysa lahum fil aakhirati illan naar » — ceux-là n'auront dans l'au-delà que le Feu. Le choix du monde exclusif mène à la perte de l'éternité. Le miroir m'avertit : chaque choix a une conséquence éternelle.`,
  reflection: `Le choix d'aujourd'hui construit la réalité de demain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ulaaa'ikal lazeena laysa lahum fil aakhirati illan naar » — ceux-là n'auront dans l'au-delà que le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel feu je risque par mes choix actuels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis est le choix qui commence maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers enregistre chaque choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le choix caché du cœur est le choix qui compte." }
  ],
  munajat: `Ya Rabb, préserve-moi du choix qui mène au feu. Guide-moi vers le choix qui mène à Toi.`
};

MIROIR["11:17"] = {
  reference: "11:17",
  theme: ["guidance", "preuve", "lumière"],
  emotion: "Certitude, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Est-ce que celui qui se fonde sur une preuve venant de son Seigneur est comparable à celui dont les mauvaises actions ont été enjolivées ? » Le miroir me montre le contraste saisissant. « Basharatum min Rabbihi » — une preuve de son Seigneur. La guidance est une preuve, pas une opinion. « Zuyyina lahu suuu'u 'amalih » — les mauvaises actions ont été enjolivées. L'aveuglement spirituel. Le miroir m'invite à vérifier : sur quoi je me fonde ?`,
  reflection: `La guidance est une lumière venue d'Allah. L'égarement est une illusion embellie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaman kaana 'alaa bayyinatim mir Rabbihi wa yatluuhu shaahidum minh » — est-ce que celui qui se fonde sur une preuve venant de son Seigneur... est comparable ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma preuve ? Sur quoi je me fonde vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La preuve d'Allah est plus proche que je ne pense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une preuve de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la preuve n'a plus de doute." }
  ],
  munajat: `Ya Nur, illumine ma preuve. Fais que je me fonde sur Ta lumière, pas sur mes illusions.`
};

MIROIR["11:18"] = {
  reference: "11:18",
  theme: ["mensonge", "châtiment", "justice"],
  emotion: "Crainte, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Muntaqim"],
  mirrorVersion: `« Qui est plus injuste que celui qui invente un mensonge contre Allah ? » Le miroir me montre l'ultime injustice. « Azlamu mimmaniftaraa 'alal laahil kazib » — qui est plus injuste que celui qui invente un mensonge contre Allah ? Attribuer le faux au Vrai. « Ulaaa'ika yu'raduuna 'ala Rabbihim » — ceux-là seront présentés à leur Seigneur. Le confrontation finale. Le miroir m'avertit : l'injustice a une fin.`,
  reflection: `Le mensonge contre Allah est l'injustice suprême. La vérité triomphe toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man azlamu mimmaniftarà 'alal laahil kazib » — qui est plus injuste que celui qui invente un mensonge contre Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah ce qu'Il n'a pas dit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité sur Allah est plus belle que tout mensonge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas — il proclame la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah ne Lui attribue que la vérité." }
  ],
  munajat: `Ya 'Adl, préserve-moi du mensonge. Fais que je ne Te attribue que la vérité.`
};

MIROIR["11:19"] = {
  reference: "11:19",
  theme: ["obstruction", "égarement", "responsabilité"],
  emotion: "Vigilance, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sirat", "Al-Hadi"],
  mirrorVersion: `« Ceux qui détournent du chemin d'Allah et cherchent à le rendre tortueux. » Le miroir me montre l'obstruction active. « As-sabiil » — le chemin. Le chemin d'Allah est droit. « Yabghuunahaa 'iwajan » — ils cherchent à le rendre tortueux. La distorsion délibérée. Le miroir m'interroge : est-ce que j'obstrue le chemin pour les autres ?`,
  reflection: `Le chemin d'Allah est droit. Celui qui le tord s'écarte lui-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allazeena yasudduuna 'an sabiilillaahi wa yabghuunahaa 'iwajan » — ceux qui détournent du chemin d'Allah et cherchent à le rendre tortueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aide ou j'obstrue le chemin des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui ouvre le chemin l'ouvre pour lui-même aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un chemin vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le chemin est ouvert — seul l'être humain peut l'obstruer." }
  ],
  munajat: `Ya Hadi, fais que je sois un ouvreur de chemin, pas un obstructionneur. Guide-moi sur le chemin droit.`
};

MIROIR["11:20"] = {
  reference: "11:20",
  theme: ["fuite", "impuissance", "réalité"],
  emotion: "Réalité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muhit"],
  mirrorVersion: `« Ils ne pourront fuir sur terre et ils n'auront pas d'alliés en dehors d'Allah. » Le miroir me montre l'impuissance finale. « Maa bi mu'sirina fil ardi » — ils ne pourront fuir sur terre. Nulle part où courir. « Wamaa lahum min duunillaahi min awliyaa' » — pas d'alliés en dehors d'Allah. La solitude absolue de ceux qui s'opposent. Le miroir m'enseigne que la vraie protection est en Allah seul.`,
  reflection: `Nul refuge hors d'Allah. La vraie sécurité est en Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Maa bi mu'sirina fil ardi wa maa lahum min duunillaahi min awliyaa' » — ils ne pourront fuir sur terre et ils n'auront pas d'alliés en dehors d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche refuge ? En Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui cherche refuge en Allah trouve tous les refuges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier cherche refuge en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le refuge en Allah est le seul refuge éternel." }
  ],
  munajat: `Ya Muhit, je cherche refuge en Toi. Fais que je ne cherche nul autre refuge que Toi.`
};

MIROIR["11:21"] = {
  reference: "11:21",
  theme: ["perte", "réalité", "au-delà"],
  emotion: "Regret, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Khasiru", "Al-Haqq"],
  mirrorVersion: `« Ceux-là sont les perdants. » Le miroir me montre le verdict final. « Ulaaa'ikal lazeena khasiruu anfusahum » — ceux-là sont ceux qui se sont perdus eux-mêmes. La perte la plus grande : se perdre soi-même. « Wa dalla 'anhum maa kaanuu yaftaruun » — et ce qu'ils inventaient les a abandonnés. Les illusions s'effondrent. Le miroir m'avertit : il n'y a pas de plus grande perte que de se perdre soi-même.`,
  reflection: `La plus grande perte est la perte de soi. Les illusions finissent par abandonner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ulaaa'ikal lazeena khasiruu anfusahum wa dalla 'anhum maa kaanuu yaftaruun » — ceux-là sont les perdants qui se sont perdus eux-mêmes, et ce qu'ils inventaient les a abandonnés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je risque de perdre ? Moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui se trouve en Allah ne se perd jamais." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne perd jamais — il retourne à son Origine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie perte est invisible jusqu'au Jour Dernier." }
  ],
  munajat: `Ya Rabb, préserve-moi de la perte de moi-même. Fais que je me trouve en Toi.`
};

MIROIR["11:22"] = {
  reference: "11:22",
  theme: ["au-delà", "certitude", "réalité"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Akhirah", "Al-Waajid"],
  mirrorVersion: `« Ce sont eux qui, dans l'au-delà, seront les plus grands perdants. » Le miroir me montre l'échelle du temps. « Fil aakhirati humul aksaruna khasaa'ir » — dans l'au-delà, ils seront les plus grands perdants. La perte éternelle dépasse toute perte temporelle. Le miroir change ma perspective : qu'est-ce qui compte vraiment à l'échelle de l'éternité ?`,
  reflection: `La perte temporelle est récupérable. La perte éternelle est irréversible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fil aakhirati humul aksaruna khasaa'ir » — ce sont eux qui, dans l'au-delà, seront les plus grands perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je perds à l'échelle de l'éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui gagne dans l'au-delà a tout gagné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers l'au-delà." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie victoire est invisible aux yeux du monde." }
  ],
  munajat: `Ya Rabb, fais que je gagne dans l'au-delà. Préserve-moi de la perte éternelle.`
};

MIROIR["11:23"] = {
  reference: "11:23",
  theme: ["foi", "œuvres", "récompense"],
  emotion: "Espérance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Falaah"],
  mirrorVersion: `« Ceux qui ont cru, fait de bonnes œuvres et se sont soumis à leur Seigneur. » Le miroir me montre le chemin de la réussite. « Aamanuu » — ils ont cru. La foi. « 'Amilus saalihaat » — fait de bonnes œuvres. L'action. « Wa akhbatuu ilaa Rabbihim » — se sont soumis à leur Seigneur. La soumission. Trois étapes, une destination. « Ulaaa'ika as-haabul jannah » — ceux-là sont les compagnons du Paradis. Le miroir me montre la voie claire.`,
  reflection: `La foi, l'action, la soumission — les trois piliers de la réussite éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innal lazeena aamanuu wa 'amilus saalihaati wa akhbatuu ilaa Rabbihim ulaaa'ika as-haabul jannah » — ceux qui ont cru, fait de bonnes œuvres et se sont soumis... ceux-là sont les compagnons du Paradis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je sur ce chemin ? Foi, action, soumission ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission est le sommet, pas le début." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est soumis — seul l'être humain a le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie soumission est un délice, pas une contrainte." }
  ],
  munajat: `Ya Rabb, je crois, j'agis, je me soumets. Accorde-moi la compagnie du Paradis.`
};

MIROIR["11:24"] = {
  reference: "11:24",
  theme: ["parabole", "vision", "réalité"],
  emotion: "Clarté, discrimination",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Furqan"],
  mirrorVersion: `« Ces deux groupes sont comme l'aveugle et le sourd comparés au voyant et à l'entendant. » Le miroir me montre le contraste sensoriel. « Kal-a'maa wal asammu » — comme l'aveugle et le sourd. « Wal basiiru was samee'u » — le voyant et l'entendant. La différence n'est pas dans les yeux physiques — elle est dans le cœur. Le miroir m'interroge : suis-je voyant ou aveugle spirituellement ?`,
  reflection: `La vue physique ne garantit pas la vue spirituelle. Le cœur peut être aveugle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalul fariiiqaini kal-a'maa wal asammu wal basiiru was samee'u » — ces deux groupes sont comme l'aveugle et le sourd comparés au voyant et à l'entendant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur voit-il ? Mon cœur entend-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveugle physique peut voir spirituellement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe pour celui qui voit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vue du cœur est la vraie vue." }
  ],
  munajat: `Ya Basir, ouvre les yeux de mon cœur. Fais que je voie la réalité, pas l'illusion.`
};

MIROIR["11:25"] = {
  reference: "11:25",
  theme: ["noé", "avertissement", "mission"],
  emotion: "Solennité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Hadi"],
  mirrorVersion: `« Et Nous avons envoyé Noé à son peuple. » Le miroir me montre l'archétype du prophète. « Wa laqad arsalnaa Nuuhan ilaa qawmih » — et Nous avons envoyé Noé à son peuple. La mission prophétique commence. « Innee lakum nadheerum mubeen » — je suis pour vous un avertisseur explicite. Le miroir m'invite à écouter l'avertissement qui traverse les âges.`,
  reflection: `Noé est l'archétype de la patience prophétique. 950 ans d'appel, peu de réponses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad arsalnaa Nuuhan ilaa qawmih innee lakum nadheerum mubeen » — et Nous avons envoyé Noé à son peuple : je suis pour vous un avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends l'avertissement ? Est-ce que je le transmets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est un acte de miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est averti par ses signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avertit par amour ne s'épuise jamais." }
  ],
  munajat: `Ya Nadhir, fais que j'entende Ton avertissement. Donne-moi la patience de Noé.`
};

MIROIR["11:26"] = {
  reference: "11:26",
  theme: ["adoration", "unicité", "avertissement"],
  emotion: "Urgence, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Waahid", "Al-Qahhar"],
  mirrorVersion: `« N'adorez qu'Allah. Je crains pour vous le châtiment d'un jour douloureux. » Le miroir me montre l'essence du message. « Allaa ta'buduu illal laah » — n'adorez qu'Allah. L'unicité de l'adoration. « Innee akhaafu 'alaikum 'azaaba yawmin aleem » — je crains pour vous le châtiment d'un jour douloureux. L'avertissement motivé par la compassion. Le miroir m'interroge : qu'est-ce que j'adore vraiment ?`,
  reflection: `L'adoration exclusive d'Allah est le fondement. Tout le reste est idole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allaa ta'buduu illal laah innee akhaafu 'alaikum 'azaaba yawmin aleem » — n'adorez qu'Allah. Je crains pour vous le châtiment d'un jour douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore en dehors d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah libère de toute autre adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier adore Allah par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration sincère est le bonheur même." }
  ],
  munajat: `Ya Waahid, je T'adore Toi seul. Libère-moi de toute idole. Crains pour moi le Jour Douloureux.`
};

MIROIR["11:27"] = {
  reference: "11:27",
  theme: ["rejet", "orgueil", "mépris"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mutakabbir", "Al-Hadi"],
  mirrorVersion: `« Les notables de son peuple dirent : 'Nous te voyons dans un égarement manifeste.' » Le miroir me montre le rejet orgueilleux. « Malau min qawmih » — les notables de son peuple. Le pouvoir s'oppose souvent à la vérité. « Innaka lafee dalaalim mubeen » — tu es dans un égarement manifeste. L'accusation inversée. Le miroir m'avertit : le pouvoir n'a pas toujours raison.`,
  reflection: `Les notables peuvent se tromper. La majorité n'est pas preuve de vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faqaalal malau lazina kafaru min qawmih in naa naraka fee dalaalim mubeen » — les notables de son peuple dirent : nous te voyons dans un égarement manifeste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le pouvoir ou la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est vu comme égarement peut être la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne suit pas les notables — il suit son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vérité peut être portée par un seul contre tous." }
  ],
  munajat: `Ya Rabb, préserve-moi du rejet orgueilleux. Fais que je reconnaisse la vérité où qu'elle soit.`
};

MIROIR["11:28"] = {
  reference: "11:28",
  theme: ["preuve", "guidance", "sagesse"],
  emotion: "Confiance, calme",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Il dit : 'Ô mon peuple, voyez-vous si je me fonde sur une preuve de mon Seigneur...' » Le miroir me montre la réponse paisible. « Ara'aytum » — voyez-vous ? L'invitation au dialogue. « Basharatim mir Rabbi » — une preuve de mon Seigneur. La confiance dans la révélation. Noé ne s'énerve pas — il expose logiquement. Le miroir m'enseigne la réponse calme face à l'accusation.`,
  reflection: `La preuve intérieure est plus solide que l'argument extérieur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala yaa qawmi ara'aytum in kuntu 'alaa bayyinatim mir Rabbi » — il dit : ô mon peuple, voyez-vous si je me fonde sur une preuve de mon Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle preuve je porte ? Comment je la défends ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La preuve silencieuse est plus forte que le bruit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une preuve silencieuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la preuve n'a pas besoin de crier." }
  ],
  munajat: `Ya Hakim, donne-moi Ta preuve. Apprends-moi à répondre avec calme et sagesse.`
};

MIROIR["11:29"] = {
  reference: "11:29",
  theme: [" désintéressement", "sincérité", "liberté"],
  emotion: "Liberté, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaniyy", "Al-Mughni"],
  mirrorVersion: `« Ô mon peuple, je ne vous demande pas de richesse. Ma récompense n'incombe qu'à Allah. » Le miroir me montre le désintéressement prophétique. « Maa astaghfukum 'alaa maali » — je ne vous demande pas de richesse. L'indépendance financière du message. « Ajriya illaa 'alal laah » — ma récompense n'incombe qu'à Allah. Le miroir m'interroge : que recherche-je en transmettant ?`,
  reflection: `Le vrai messager ne cherche pas de profit matériel. Sa récompense est en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaa qawmi laa as-alukum 'alayhi maalan in ajriya illaa 'alal laah » — ô mon peuple, je ne vous demande pas de richesse. Ma récompense n'incombe qu'à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends en retour de ce que je fais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui ne demande rien reçoit tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne sans attendre de retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La récompense d'Allah est le trésor caché." }
  ],
  munajat: `Ya Ghaniyy, enrichis mon cœur du désintéressement. Fais que je cherche ma récompense en Toi seul.`
};

MIROIR["11:30"] = {
  reference: "11:30",
  theme: ["intercession", "protégés", "justice"],
  emotion: "Humilité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Khallaq"],
  mirrorVersion: `« Ô mon peuple, qui me secourra contre Allah si je les chasse ? » Le miroir me montre la conscience de la responsabilité. « Man yansurunee minal laah » — qui me secourra contre Allah ? La conscience de la puissance divine. « In akhadhtu 'anihim » — si je les chasse. Les protégés d'Allah ne peuvent être rejetés. Le miroir m'enseigne la prudence envers ceux qu'Allah protège.`,
  reflection: `Personne ne peut nous protéger contre Allah. Ses protégés sont sous Sa garde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaa qawmi man yansurunee minal laah » — ô mon peuple, qui me secourra contre Allah si je les chasse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont les protégés d'Allah que je risque de rejeter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui protège les protégés d'Allah est protégé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers protège les créatures de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection d'Allah est invisible mais réelle." }
  ],
  munajat: `Ya Waliyy, fais que je reconnaisse Tes protégés. Préserve-moi de les repousser.`
};

MIROIR["11:31"] = {
  reference: "11:31",
  theme: ["humilité", "limites", "science"],
  emotion: "Humilité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Je ne vous dis pas que je détiens les trésors d'Allah, ni que je connais l'invisible. » Le miroir me montre l'humilité prophétique. « Maa aqulu lakum 'indee khazaaa'inul laah » — je ne détiens pas les trésors d'Allah. La reconnaissance des limites. « Wa laa a'lamul ghayb » — je ne connais pas l'invisible. L'aveu d'ignorance. Le miroir m'invite à reconnaître mes limites avec fierté.`,
  reflection: `Le vrai savant connaît ses limites. L'ignorant prétend tout savoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laa aqulu lakum 'indee khazaaa'inul laah wa laa a'lamul ghayb » — je ne vous dis pas que je détiens les trésors d'Allah, ni que je connais l'invisible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je prétends savoir que je ne sais pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveu d'ignorance est le début de la science." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères — seul Allah les connaît tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît ses limites connaît vraiment." }
  ],
  munajat: `Ya 'Alim, enseigne-moi mes limites. Fais que je reconnaisse ce que je ne sais pas.`
};

MIROIR["11:32"] = {
  reference: "11:32",
  theme: ["défi", "moquerie", "patience"],
  emotion: "Calme, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Qawiyy"],
  mirrorVersion: `« Ils dirent : 'Ô Noé, tu as disputé avec nous et multiplié les disputes...' » Le miroir me montre le défi permanent. « Qad jaadal tanaa » — tu as disputé avec nous. L'opposition au message. « Fa'tina bimaa ta'idunaa » — apporte-nous ce dont tu nous menaces. Le défi ironique. Le miroir m'enseigne que l'opposition est prévue dans le chemin de la vérité.`,
  reflection: `La moquerie est l'arme de ceux qui n'ont pas d'arguments.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu yaa Nuuhu qad jaadal tanaa fakasurta jidaalanaa fa'tina bimaa ta'idunaa » — ils dirent : ô Noé, tu as disputé avec nous et multiplié les disputes. Apporte-nous ce dont tu nous menaces." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la moquerie ? Avec patience ou colère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie des hommes ne change rien à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se moque pas — il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui supporte la moquerie pour Allah est proche de Lui." }
  ],
  munajat: `Ya Sabur, donne-moi Ta patience face à la moquerie. Fais que je reste calme comme Noé.`
};

MIROIR["11:33"] = {
  reference: "11:33",
  theme: ["prière", "réponse", "sagesse"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Hakim"],
  mirrorVersion: `« Il dit : 'C'est Allah seul qui vous l'apportera s'Il veut.' » Le miroir me montre la confiance en la réponse divine. « Innamaa ya'tee kumul laah » — c'est Allah seul qui vous l'apportera. La certitude. « In shaaa' » — s'Il veut. L'humilité devant la volonté divine. Le miroir m'enseigne que la réponse est entre les mains d'Allah, pas les nôtres.`,
  reflection: `La réponse d'Allah vient quand Il veut, comme Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala innamaa ya'tee kumul laah bih in shaaa' » — il dit : c'est Allah seul qui vous l'apportera s'Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la réponse d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui attend la réponse d'Allah ne déçoit jamais." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend la réponse de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La réponse d'Allah est toujours parfaite en timing." }
  ],
  munajat: `Ya Mujib, j'attends Ta réponse. Fais qu'elle vienne selon Ta volonté parfaite.`
};

MIROIR["11:34"] = {
  reference: "11:34",
  theme: ["conseil", "égarement", "sincérité"],
  emotion: "Humilité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Mon conseil ne vous profiterait pas, même si je voulais vous conseiller. » Le miroir me montre les limites du conseil. « Lan tanfa'akum nus-hee » — mon conseil ne vous profitera pas. Le conseil sans réception est vain. « In arattu an an-nasaha lakum » — même si je voulais vous conseiller sincèrement. La sincérité ne suffit pas sans l'ouverture du cœur. Le miroir m'enseigne que la guidance est un don, pas un accomplissement.`,
  reflection: `Le meilleur conseil ne profite pas à celui qui ne veut pas entendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laa yanfa'ukum nus-heee in arattu an an-nasaha lakum » — mon conseil ne vous profiterait pas, même si je voulais vous conseiller sincèrement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je ouvert au conseil ? Ou fermé dans mon orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture au conseil est elle-même une guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier reçoit le conseil de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le conseil entend Allah." }
  ],
  munajat: `Ya Hadi, ouvre mon cœur au conseil. Fais que je sois de ceux qui écoutent et profitent.`
};

MIROIR["11:35"] = {
  reference: "11:35",
  theme: ["défense", "innocence", "rétribution"],
  emotion: "Calme, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Ou ils disent : 'Il l'a forgé.' Dis : 'Si je l'ai forgé, que mon crime retombe sur moi.' » Le miroir me montre l'innocence affirmée. « If-taraahu » — il l'a forgé. L'accusation éternelle. « Fa'alayya iqraam » — que mon crime retombe sur moi. L'acceptation de la responsabilité. Le miroir m'enseigne à accepter les conséquences de mes actes réels, pas des accusations fausses.`,
  reflection: `Celui qui est innocent n'a pas peur des accusations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yaquuluunaftarahu qul iniftaraytuhu fa'alayya iqraam » — ou ils disent : il l'a forgé. Dis : si je l'ai forgé, que mon crime retombe sur moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la responsabilité de mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'innocence n'a pas besoin de se défendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers connaît la vérité de chaque action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît la vérité — c'est Lui qui juge." }
  ],
  munajat: `Ya Hakam, Tu connais la vérité sur moi. Fais que je sois innocent devant Toi.`
};

MIROIR["11:36"] = {
  reference: "11:36",
  theme: ["révélation", "limite", "destin"],
  emotion: "Acceptation, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Qadir"],
  mirrorVersion: `« Il ne sera pas cru par personne d'autre que ceux qui ont déjà cru. » Le miroir me montre la limite de la réception. « Lan yu'mina ahadun » — il ne sera pas cru. La fermeture des cœurs. « Illaa man qad aaman » — excepté ceux qui ont déjà cru. Le destin de la foi est scellé. Le miroir m'enseigne que la foi est un don, pas un accomplissement humain.`,
  reflection: `La foi est un don d'Allah. On ne peut pas la forcer dans les cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa uuhila ilaa Nuuhin annahu lan yu'mina min qawmika illaa man qad aaman » — et il fut révélé à Noé que personne de son peuple ne croirait, sauf ceux qui avaient déjà cru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que la foi est un don ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeture des autres m'ouvre à plus de patience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croit naturellement — seul l'être humain peut refuser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que la foi est un don la demande plus humblement." }
  ],
  munajat: `Ya Qadir, la foi est Ton don. Augmente ma foi et donne-la à ceux que Tu veux.`
};

MIROIR["11:37"] = {
  reference: "11:37",
  theme: ["arche", "obéissance", "moquerie"],
  emotion: "Obéissance, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waali", "Al-Hakim"],
  mirrorVersion: `« Construis l'arche sous Nos yeux et selon Notre révélation. » Le miroir me montre l'obéissance concrète. « Wasna'il fulka » — construis l'arche. L'action physique demandée. « Bi a'yunina » — sous Nos yeux. La présence divine. « Wa wahyina » — selon Notre révélation. La guidance spécifique. « Wa laa tuhaatinee » — ne Me parle pas de ceux qui font le mal. Le détachement des opposants. Le miroir m'enseigne à agir malgré l'opposition.`,
  reflection: `L'obéissance à Allah inclut l'action concrète et le détachement des critiques.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wasna'il fulka bi a'yunina wa wahyina wa laa tuhaatinee » — construis l'arche sous Nos yeux et selon Notre révélation, et ne Me parle pas de ceux qui font le mal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah me demande de construire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La construction pour Allah se fait malgré la moquerie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une arche portée par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui construit pour Allah est protégé par Sa présence." }
  ],
  munajat: `Ya Waali, montre-moi ce que je dois construire. Donne-moi la force de le faire malgré les moqueurs.`
};

MIROIR["11:38"] = {
  reference: "11:38",
  theme: ["moquerie", "persévérance", "foi"],
  emotion: "Calme, détermination",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Aziz"],
  mirrorVersion: `« Il construisait l'arche, et chaque fois que des notables de son peuple passaient près de lui, ils se moquaient de lui. » Le miroir me montre la persévérance face à la moquerie. « Yasna'il fulka » — il construisait l'arche. L'action continue. « Kullama marra 'alayhi mala'un » — chaque fois que des notables passaient. L'opposition constante. « Sakhiru minhu » — ils se moquaient de lui. Le mépris. Le miroir m'enseigne que la moquerie n'arrête pas l'œuvre de foi.`,
  reflection: `La moquerie est le bruit de fond de toute œuvre importante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yasna'il fulka wa kullama marra 'alayhi mala'un min qawmihi sakhiru minhu » — il construisait l'arche, et chaque fois que des notables passaient, ils se moquaient de lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand on se moque de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie des hommes est l'encouragement d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se moque pas — il respecte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui construit pour Allah ne sent pas la moquerie." }
  ],
  munajat: `Ya Sabur, donne-moi la patience de Noé. Fais que je continue mon œuvre malgré les moqueurs.`
};

MIROIR["11:39"] = {
  reference: "11:39",
  theme: ["châtiment", "moquerie", "réalité"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Aziz"],
  mirrorVersion: `« Vous verrez qui viendra de Nous un châtiment qui l'humiliera. » Le miroir me montre la réponse divine à la moquerie. « Fawasawfa ta'lamuun » — vous saurez bientôt. La certitude du dévoilement. « Man ya'teehi 'azaabun yukhzeehi » — qui viendra de Nous un châtiment qui l'humiliera. Le retournement. Le miroir m'enseigne que la moquerie a une fin, et que la vérité triomphe.`,
  reflection: `La moquerie d'aujourd'hui sera la honte de demain pour les moqueurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fawasawfa ta'lamuun man ya'teehi 'azaabun yukhzeehi » — vous verrez bientôt qui viendra de Nous un châtiment qui l'humiliera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque ? Ou est-ce que je suis moqué ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie se retourne contre le moqueur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de place pour la moquerie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est moqué pour Allah est honoré par Lui." }
  ],
  munajat: `Ya Rabb, préserve-moi de la moquerie. Fais que je sois du côté de ceux qui sont honorés par Toi.`
};

MIROIR["11:40"] = {
  reference: "11:40",
  theme: ["déluge", "salut", "miracle"],
  emotion: "Stupeur, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Munji", "Al-Qadir"],
  mirrorVersion: `« Jusqu'au moment où Notre ordre vint et que le four bouillonna. » Le miroir me montre le début du déluge. « Hattaaa izaa jaaa'a amrunaa » — jusqu'au moment où Notre ordre vint. L'accomplissement. « Faaraat tannuur » — le four bouillonna. Le signe du début. « Kulla zaujainisnain » — de chaque couple, deux. La préservation. Le miroir m'enseigne que le salut vient au moment précis d'Allah.`,
  reflection: `Le salut vient quand Allah l'ordonne. Le signe peut venir d'où on ne l'attend pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hattaaa izaaa jaaa'a amrunaa wa faaraat tannuur » — jusqu'au moment où Notre ordre vint et que le four bouillonna." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel four bout dans ma vie ? Quel salut approche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déluge est jugement pour les uns, salut pour les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend l'ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est dans l'arche d'Allah ne craint pas le déluge." }
  ],
  munajat: `Ya Munji, fais-moi entrer dans Ton arche. Sauve-moi du déluge de ce monde.`
};

MIROIR["11:41"] = {
  reference: "11:41",
  theme: ["embarquement", "nom d'Allah", "salut"],
  emotion: "Confiance, abandon",
  difficulty: "débutant",
  relatedNames: ["Al-Maji", "Al-Munji"],
  mirrorVersion: `« Embarquez-y ! Au nom d'Allah soit son cours et son mouillage. » Le miroir me montre le voyage de foi. « Irkaboo feeha » — embarquez-y. L'invitation. « Bismil laah majraaha wa mursaaha » — au nom d'Allah soit son cours et son mouillage. La confiance totale. « Inna Rabbiya Gafuurur Raheem » — mon Seigneur est Pardonneur, Miséricordieux. L'espoir. Le miroir m'invite à embarquer dans l'arche de la foi.`,
  reflection: `L'embarquement au nom d'Allah est le voyage le plus sûr.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qaalar kaboo feeha bismil laah majraaha wa mursaaha inna Rabbiya Gafuurur Raheem » — et il dit : embarquez-y ! Au nom d'Allah soit son cours et son mouillage. Mon Seigneur est Pardonneur, Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quelle arche dois-je embarquer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'embarquement avec Allah est le seul voyage sûr." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier voyage au nom d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui embarque avec Allah arrive à bon port." }
  ],
  munajat: `Ya Munji, fais que j'embarque avec Toi. Guide mon cours et mon mouillage au nom d'Allah.`
};

MIROIR["11:42"] = {
  reference: "11:42",
  theme: ["tempête", "protection", "prière"],
  emotion: "Angoisse, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Qadir"],
  mirrorVersion: `« Et elle voguait au milieu des vagues comme des montagnes. » Le miroir me montre la tempête. « Wa hiya tajree bihim » — elle voguait avec eux. Le voyage. « Fee mawjin kal-jibaal » — au milieu des vagues comme des montagnes. Le danger visible. Le miroir me rappelle que la protection d'Allah peut exister au milieu des plus grandes tempêtes.`,
  reflection: `La tempête peut être immense — l'arche d'Allah est plus solide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hiya tajree bihim fee mawjin kal-jibaal » — et elle voguait au milieu des vagues comme des montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles vagues comme des montagnes je traverse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les vagues immenses sont l'occasion de la protection d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier flotte sur les vagues du décret d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est dans l'arche d'Allah ne craint pas les vagues." }
  ],
  munajat: `Ya Hafiz, protège-moi dans ma tempête. Fais que mon arche soit solide.`
};

MIROIR["11:43"] = {
  reference: "11:43",
  theme: ["famille", "égarement", "appel"],
  emotion: "Tristesse, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Waliyy"],
  mirrorVersion: `« Et Noé appela son fils qui se tenait à l'écart. » Le miroir me montre la douleur familiale. « Wa naadaa Nuuhum ibnahu » — Noé appela son fils. L'appel du père. « Wa kaana fee ma'zil » — qui se tenait à l'écart. Le refus. « Kun ma'anaa » — sois avec nous. L'invitation au salut. « Laa takun ma'al kaazireen » — ne sois pas avec les mécréants. Le miroir me montre la douleur de voir les proches refuser le salut.`,
  reflection: `Le salut est individuel. On ne peut pas forcer ceux qu'on aime.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa naadaa Nuuhum ibnahu wa kaana fee ma'zil yaa bunayya irkab ma'anaa » — et Noé appela son fils qui se tenait à l'écart : ô mon fils, embarque avec nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui dans ma famille refuse l'invitation ? Comment je l'appelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel continue même quand le refus est évident." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est appelé vers le salut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'appel sincère n'est jamais perdu, même s'il n'est pas exaucé." }
  ],
  munajat: `Ya Hadi, guide ma famille. Fais qu'ils entendent l'appel et embarquent avec moi.`
};

MIROIR["11:44"] = {
  reference: "11:44",
  theme: ["fin du déluge", "ordre", "repos"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "As-Salam"],
  mirrorVersion: `« Et il fut dit : Ô terre, absorbe ton eau ! Ô ciel, cesse ! » Le miroir me montre la fin de l'épreuve. « Qeelaa yaaa ardu'bliqee maaki » — ô terre, absorbe ton eau. L'ordre à la terre. « Wa yaaa samaaa'u aqli'ee » — ô ciel, cesse. L'ordre au ciel. « Wa qi'al amru » — et l'ordre fut accompli. La fin. « Wa istawat 'alal Juudi » — et elle se posa sur le mont Judi. Le repos. Le miroir m'enseigne que chaque épreuve a une fin décrétée par Allah.`,
  reflection: `Chaque tempête a une fin. Chaque épreuve a son repos.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qeelaa yaaa ardu'bliqee maaki wa yaaa samaaa'u aqli'ee » — et il fut dit : ô terre, absorbe ton eau ! Ô ciel, cesse !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle tempête doit cesser dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fin de la tempête est plus belle que son début." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit instantanément à l'ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend la fin d'Allah n'est jamais déçu." }
  ],
  munajat: `Ya Rabb, fais cesser ma tempête. Donne-moi le repos sur la montagne de Ta paix.`
};

MIROIR["11:45"] = {
  reference: "11:45",
  theme: ["intercession", "famille", "justice"],
  emotion: "Tristesse, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Waliyy"],
  mirrorVersion: `« Et Noé invoqua son Seigneur et dit : 'Seigneur, mon fils est de ma famille.' » Le miroir me montre l'intercession familiale. « Wa naadaa Rabbahu » — Noé invoqua son Seigneur. La prière. « Rabbi innabnee min ahli » — mon fils est de ma famille. L'argument. « Wa inna wa'dakal haqq » — Ta promesse est vraie. La confiance. Le miroir m'enseigne à prier pour les nôtres même quand tout semble perdu.`,
  reflection: `La prière pour les proches est un devoir, même quand l'espoir est mince.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa naadaa Rabbahu Rabbi innabnee min ahli wa inna wa'dakal haqq » — et Noé invoqua son Seigneur : Seigneur, mon fils est de ma famille, et Ta promesse est vraie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui est-ce que je prie avec insistance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah est vraie — mais pas toujours comme on l'imagine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier prie pour le retour à son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière du prophète pour son fils reste exaucée — d'une manière qu'il ne comprenait pas." }
  ],
  munajat: `Ya Rabb, je prie pour les miens. Exauce ma prière selon Ta promesse vraie.`
};

MIROIR["11:46"] = {
  reference: "11:46",
  theme: ["correction", "famille spirituelle", "justice"],
  emotion: "Humilité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Il dit : 'Ô Noé, il n'est pas de ta famille. C'est une conduite blâmable.' » Le miroir me montre la correction divine. « Innahu laysa min ahlik » — il n'est pas de ta famille. La redéfinition de la famille. « Innahu 'amalun ghayru saalih » — c'est une conduite blâmable. La justice. « Falaa tas-alni maa laisa laka bih 'ilm » — ne Me demande pas ce que tu ne connais pas. Le miroir m'enseigne que la famille spirituelle transcende le sang.`,
  reflection: `La vraie famille est celle qui partage la foi, pas seulement le sang.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala yaa Nuuhu innahu laysa min ahlik innahu 'amalun ghayru saalih » — il dit : ô Noé, il n'est pas de ta famille. C'est une conduite blâmable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est vraiment de ma famille ? Le sang ou la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La famille de foi est plus durable que la famille de sang." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une famille unie par l'adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît la vraie famille mieux que nous." }
  ],
  munajat: `Ya Hakim, montre-moi ma vraie famille. Fais que je ne sois pas aveuglé par le sang.`
};

MIROIR["11:47"] = {
  reference: "11:47",
  theme: ["repentir", "humilité", "prière"],
  emotion: "Humilité, retour",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Seigneur, je cherche Ta protection contre le fait de Te demander ce que je ne connais pas. » Le miroir me montre le repentir immédiat. « Rabbi innii a'uzu bika » — Seigneur, je cherche Ta protection. Le refuge. « An as-alaka maa laisa li bih 'ilm » — contre le fait de Te demander ce que je ne connais pas. L'aveu d'ignorance. « Illaa tagfirlii » — à moins que Tu ne me pardonnes. L'espoir. Le miroir m'enseigne le retour immédiat après la correction.`,
  reflection: `Le repentir immédiat est la meilleure réponse à la correction divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala Rabbi innii a'uzu bika an as-alaka maa laisa li bih 'ilm » — il dit : Seigneur, je cherche Ta protection contre le fait de Te demander ce que je ne connais pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la correction d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La correction est un acte d'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier cherche refuge en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le repentir sincère efface la faute instantanément." }
  ],
  munajat: `Ya Tawwab, je me repens. Pardonne-moi mes demandes ignorantes. Accepte mon retour.`
};

MIROIR["11:48"] = {
  reference: "11:48",
  theme: ["salut", "paix", "bénédiction"],
  emotion: "Gratitude, paix",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Barakah"],
  mirrorVersion: `« Il fut dit : Ô Noé, débarque avec Notre salut et Nos bénédictions sur toi. » Le miroir me montre le salut accompli. « U'hbut bis-salaami minal laah » — débarque avec la paix d'Allah. La salutation. « Wa barakaatin 'alaika » — et des bénédictions sur toi. L'abondance. « Wa 'alaa umamin mimman ma'ak » — et sur les communautés avec toi. La descendance. Le miroir m'enseigne que le salut d'Allah inclut la paix et la bénédiction.`,
  reflection: `Le salut d'Allah est complet : paix, bénédiction, descendance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qeelaa yaa Nuuhu'hbut bis-salaami minal laah wa barakaatin 'alaika » — il fut dit : ô Noé, débarque avec Notre salut et Nos bénédictions sur toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel salut m'attend ? Quelles bénédictions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le débarquement après l'épreuve est plus doux que le départ." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend la paix d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La paix d'Allah est le trésor caché du sauvé." }
  ],
  munajat: `Ya Salam, fais que je débarque avec Ta paix. Bénis-moi et ceux qui sont avec moi.`
};

MIROIR["11:49"] = {
  reference: "11:49",
  theme: ["histoire", "révélation", "sagesse"],
  emotion: "Émerveillement, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "An-Nabi"],
  mirrorVersion: `« Ce sont des nouvelles de l'invisible que Nous te révélons. » Le miroir me montre la grâce de la révélation. « Tilka min anbaa'il ghaybi » — ce sont des nouvelles de l'invisible. Le mystère révélé. « Nuuhiihaa ilayka » — que Nous te révélons. Le don. « Maa kunta ta'lamuhaa » — tu ne les connaissais pas. L'ignorance précédente. « Anta wa laa qawmuka » — ni toi ni ton peuple. La nouveauté. Le miroir m'invite à contempler le don de la connaissance divine.`,
  reflection: `La révélation est un don d'Allah — on ne peut pas l'atteindre par soi-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka min anbaa'il ghaybi nuuhiihaa ilayka maa kunta ta'lamuhaa anta wa laa qawmuka » — ce sont des nouvelles de l'invisible que Nous te révélons. Tu ne les connaissais pas, ni toi ni ton peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah m'a révélé que je ne savais pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance précédente rend la révélation plus précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une révélation continue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la révélation est choisi par Allah." }
  ],
  munajat: `Ya Hakim, merci pour Ta révélation. Fais que je la reçoive avec gratitude.`
};

MIROIR["11:50"] = {
  reference: "11:50",
  theme: ["houd", "mission", "unicité"],
  emotion: "Solennité, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Waahid", "An-Nadhir"],
  mirrorVersion: `« Et vers 'Ad, leur frère Hud. Il dit : 'Ô mon peuple, adorez Allah.' » Le miroir me montre la continuité du message. « Wa ilaa 'Aadin akhaahum Hoodaa » — et vers 'Ad, leur frère Hud. L'envoi. « Yaa qawmi'budul laah » — ô mon peuple, adorez Allah. L'unicité. « Maa lakum min ilaahin ghayruhu » — vous n'avez pas d'autre dieu que Lui. Le tawhid. Le miroir m'enseigne que le message est toujours le même : l'adoration d'Allah seul.`,
  reflection: `Tous les prophètes ont le même message fondamental : adorez Allah seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ilaa 'Aadin akhaahum Hoodaa qaala yaa qawmi'budul laah maa lakum min ilaahin ghayruhu » — et vers 'Ad, leur frère Hud. Il dit : ô mon peuple, adorez Allah. Vous n'avez pas d'autre dieu que Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel dieu autre qu'Allah est-ce que j'adore sans le savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unicité libère de toutes les idoles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier adore Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul a tout adoré correctement." }
  ],
  munajat: `Ya Waahid, je T'adore Toi seul. Libère-moi de toutes les idoles cachées.`
};

MIROIR["11:51"] = {
  reference: "11:51",
  theme: ["désintéressement", "récompense", "sincérité"],
  emotion: "Liberté, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaniyy", "Al-Mughni"],
  mirrorVersion: `« Ô mon peuple, je ne vous demande pas de salaire. Ma récompense n'incombe qu'à Celui qui m'a créé. » Le miroir me montre le désintéressement total. « Maa as-alukum 'alayhi ajran » — je ne vous demande pas de salaire. L'indépendance. « In ajriya illaa 'alal lazee fataaranee » — ma récompense n'incombe qu'à Celui qui m'a créé. La source. Le miroir m'interroge : que cherche-je en retour de mon service ?`,
  reflection: `Le vrai serviteur ne cherche rien en retour — sa récompense est en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaa qawmi laa as-alukum 'alayhi ajran in ajriya illaa 'alal lazee fataaranee » — ô mon peuple, je ne vous demande pas de salaire. Ma récompense n'incombe qu'à Celui qui m'a créé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel salaire je cherche pour mon service ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui ne demande rien reçoit tout d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sert son Créateur sans demander de salaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La récompense d'Allah dépasse tout salaire humain." }
  ],
  munajat: `Ya Ghaniyy, enrichis mon cœur du désintéressement. Ma récompense est en Toi seul.`
};

MIROIR["11:52"] = {
  reference: "11:52",
  theme: ["repentir", "pluie", "bénédiction"],
  emotion: "Espérance, appel",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Ô mon peuple, implorez le pardon de votre Seigneur et revenez à Lui. » Le miroir me montre la voie de la bénédiction. « Istaghfiru Rabbakum » — implorez le pardon. L'istighfar. « Tuubuu ilayhi » — revenez à Lui. Le repentir. « Yursilis samaaa'a 'alaikum midraara » — Il enverra sur vous le ciel avec abondance. La pluie. Le miroir m'enseigne que l'istighfar ouvre les portes du ciel.`,
  reflection: `L'istighfar régulier apporte la bénédiction et la provision.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaa qawmistaghfiru Rabbakum thumma tuubuu ilayhi yursilis samaaa'a 'alaikum midraara » — ô mon peuple, implorez le pardon de votre Seigneur et revenez à Lui. Il enverra sur vous le ciel avec abondance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quelle fréquence je fais l'istighfar ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de pardon précède l'abondance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier cherche le pardon de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'istighfar sincère transforme la sécheresse en abondance." }
  ],
  munajat: `Ya Ghafur, je demande Ton pardon. Envoie sur moi Ta bénédiction et Ton abondance.`
};

MIROIR["11:53"] = {
  reference: "11:53",
  theme: ["déni", "moquerie", "orgueil"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Ils dirent : 'Ô Hud, tu n'es pas venu à nous avec une preuve.' » Le miroir me montre le déni obstiné. « Maa ji'tanaa bi-bayyinah » — tu n'es pas venu à nous avec une preuve. Le rejet de l'évidence. « Wa naa nushriku bimaa taqulu » — et nous ne laisserons pas nos divinités. L'attachement aux idoles. « Wa maa nahnu laka bi-mu'mineen » — nous ne croyons pas en toi. Le refus final. Le miroir m'enseigne que le déni peut être aveugle.`,
  reflection: `L'aveuglement volontaire refuse même les preuves évidentes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu yaa Hudu maa ji'tanaa bi-bayyinah wa maa nahnu bitaariki aalihatinaa 'an qawlik » — ils dirent : ô Hud, tu n'es pas venu à nous avec une preuve, et nous ne laisserons pas nos divinités sur ta parole." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle preuve je refuse d'accepter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La preuve est là — mais le cœur peut la refuser." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une preuve continue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah guide celui qui veut être guidé." }
  ],
  munajat: `Ya Hadi, ne permets pas que je sois aveugle aux preuves. Ouvre mes yeux à Ta vérité.`
};

MIROIR["11:54"] = {
  reference: "11:54",
  theme: ["calomnie", "délire", "justice"],
  emotion: "Calme, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Nous ne disons que tes dieux t'ont frappé d'un malheur. » Le miroir me montre la calomnie. « In naqulu illa i'taraatka aalihatunaa bi-suu' » — nous ne disons que tes dieux t'ont frappé. L'accusation délirante. « Qul innee uhhizu 'alal laahi shahaadatan » — dis : je prends Allah comme témoin. Le refuge. « Fatas'alamu mimmaa tushrikuuna » — et vous saurez ce que vous associez. Le verdict. Le miroir m'enseigne à prendre Allah comme témoin face aux accusations.`,
  reflection: `Les accusations des hommes ne pèsent rien face au témoignage d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In naqulu illa i'taraatka aalihatunaa bi-suu' qul innee uhhizu 'alal laahi shahaadatan » — nous ne disons que tes dieux t'ont frappé d'un malheur. Dis : je prends Allah comme témoin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis accusé, qui est mon témoin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoin d'Allah suffit face à tous les accusateurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît la vérité — c'est le seul témoignage qui compte." }
  ],
  munajat: `Ya 'Adl, Tu es mon témoin. Fais que je n'aie pas peur des accusations fausses.`
};

MIROIR["11:55"] = {
  reference: "11:55",
  theme: ["défi", "confiance", "victoire"],
  emotion: "Confiance, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "Al-'Aziz"],
  mirrorVersion: `« Rassemblez donc vos ruses, tous avec vos idoles. » Le miroir me montre le défi confiant. « Fakkiduu kullakum » — rassemblez tous. L'appel à la confrontation. « Thumma laa tuzhiruun » — puis ne tardez pas. L'urgence. « Innee tawakkaltu 'alal laah » — je place ma confiance en Allah. Le tawakkul. Le miroir m'enseigne que la confiance en Allah permet d'affronter tous les complots.`,
  reflection: `Le tawakkul est l'arme contre toutes les ruses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakkiduu kullakum thumma laa tuzhiruun innee tawakkaltu 'alal laah » — rassemblez donc vos ruses, tous avec vos idoles, puis ne tardez pas. J'ai placé ma confiance en Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quel complot ma confiance en Allah me protège-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les rues des hommes sont impuissantes contre le tawakkul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se confie à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah est invincible." }
  ],
  munajat: `Ya Qawiyy, je me confie à Toi. Protège-moi contre toutes les ruses.`
};

MIROIR["11:56"] = {
  reference: "11:56",
  theme: ["confiance", "créateur", "pouvoir"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« J'ai placé ma confiance en Allah, mon Seigneur et votre Seigneur. » Le miroir me montre la confiance totale. « Innee tawakkaltu 'alal laahi Rabbii wa Rabbikum » — j'ai placé ma confiance en Allah, mon Seigneur et votre Seigneur. L'inclusion. « Maa min daabbatin illaa Huwa aakhizum binaasiyatihaa » — nulle bête qu'Il ne tienne par le toupet. La maîtrise totale. Le miroir m'enseigne que la confiance en Allah inclut la conscience de Sa maîtrise absolue.`,
  reflection: `Allah tient toute créature par le toupet — rien n'échappe à Sa maîtrise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innee tawakkaltu 'alal laahi Rabbii wa Rabbikum maa min daabbatin illaa Huwa aakhizum binaasiyatihaa » — j'ai placé ma confiance en Allah, mon Seigneur et votre Seigneur. Nulle bête qu'Il ne tienne par le toupet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que Allah tient tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La maîtrise d'Allah est le fondement de la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est tenu par le toupet par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'Allah tient tout n'a peur de rien." }
  ],
  munajat: `Ya Khaliq, Tu tiens tout. Je me confie à Ta maîtrise absolue.`
};

MIROIR["11:57"] = {
  reference: "11:57",
  theme: ["transmission", "désintéressement", "justice"],
  emotion: "Calme, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Fasl"],
  mirrorVersion: `« Si vous vous détournez, je vous ai transmis ce pour quoi j'ai été envoyé. » Le miroir me montre l'accomplissement du devoir. « Fa-in tawallaw » — si vous vous détournez. Le choix. « Fa-qad ablaghtukum » — j'ai transmis. L'accomplissement. « Maa uhhirtu bih » — ce pour quoi j'ai été envoyé. La mission. « Wa yastakhlifu Rabbii qawman ghayrakum » — mon Seigneur vous remplacera par un autre peuple. Le remplacement. Le miroir m'enseigne que la transmission accomplie suffit.`,
  reflection: `L'accomplissement du devoir suffit, même si le résultat échappe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in tawallaw fa-qad ablaghtukum maa uhhirtu bih » — si vous vous détournez, je vous ai transmis ce pour quoi j'ai été envoyé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai transmis ce que j'ai reçu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transmission accomplie est une victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers transmet la vérité sans s'attacher au résultat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah remplace ceux qui refusent par d'autres qui acceptent." }
  ],
  munajat: `Ya Rabb, aide-moi à transmettre ce que Tu m'as donné. Accepte mon accomplissement même si le résultat T'appartient.`
};

MIROIR["11:58"] = {
  reference: "11:58",
  theme: ["châtiment", "salut", "justice"],
  emotion: "Gratitude, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Al-Qahhar"],
  mirrorVersion: `« Et quand vint Notre ordre, Nous sauvâmes Hud et ceux qui avaient cru avec lui. » Le miroir me montre le salut sélectif. « Lammaa jaaa'a amrunaa » — quand vint Notre ordre. L'accomplissement. « Najjainaa Hoodaa » — Nous sauvâmes Hud. La protection. « Wallazeena aamanuu ma'ahu » — et ceux qui avaient cru avec lui. La compagnie. « Bi-rahmatim minnaa » — par une miséricorde de Nous. La grâce. Le miroir m'enseigne que le salut vient par la foi et la miséricorde.`,
  reflection: `Le salut est pour les croyants — mais c'est la miséricorde qui sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falammaa jaaa'a amrunaa najjainaa Hoodaa wallazeena aamanuu ma'ahu bi-rahmatim minnaa » — et quand vint Notre ordre, Nous sauvâmes Hud et ceux qui avaient cru avec lui, par une miséricorde de Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je de ceux qui seront sauvés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est le bateau, la miséricorde est le vent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sauvé par la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah précède la foi." }
  ],
  munajat: `Ya Munji, sauve-moi par Ta miséricorde. Fais que je sois avec les croyants sauvés.`
};

MIROIR["11:59"] = {
  reference: "11:59",
  theme: ["châtiment", "orgueil", "justice"],
  emotion: "Crainte, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-'Adl"],
  mirrorVersion: `« Et voilà 'Ad qui nièrent les signes de leur Seigneur. » Le miroir me montre la conséquence du déni. « Wa tilka 'Adun » — et voilà 'Ad. Le peuple disparu. « Jahadu bi-aayaati Rabbihim » — nièrent les signes de leur Seigneur. Le rejet. « Wa 'ataw 'an aamirihi » — désobéirent à Son ordre. L'orgueil. « Wat-taba'uu amra kulli jabbaarin 'aniid » — suivirent l'ordre de tout tyran obstiné. L'égarement collectif. Le miroir m'avertit contre le suivi aveugle des tyrans.`,
  reflection: `Le suivi des tyrans mène à la perdition collective.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tilka 'Adun jahadu bi-aayaati Rabbihim wa 'ataw 'an aamirihi » — et voilà 'Ad qui nièrent les signes de leur Seigneur, désobéirent à Ses messagers et suivirent l'ordre de tout tyran obstiné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je suis aveuglément ? Un tyran obstiné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet des signes précède le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de place pour les tyrans éternels." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah anéantit les tyrans et sauve les humbles." }
  ],
  munajat: `Ya Qahhar, préserve-moi du suivi des tyrans. Fais que je suive Tes signes, pas les tyrans.`
};

MIROIR["11:60"] = {
  reference: "11:60",
  theme: ["maudits", "au-delà", "justice"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-La'in", "Al-Akhirah"],
  mirrorVersion: `« Ils furent suivis d'une malédiction dans ce monde et au Jour de la Résurrection. » Le miroir me montre la malédiction éternelle. « Ut-bi'uu fee haazihid dunya la'nah » — ils furent suivis d'une malédiction dans ce monde. Le châtiment immédiat. « Wa Yawmil Qiyaamah » — et au Jour de la Résurrection. L'éternité du châtiment. « Ala inna 'Adan kafaru Rabbahum » — certes, 'Ad a nié son Seigneur. Le crime. « Alaa bu'ldam li-Hood » — que périssent les 'Ad, peuple de Hud. Le verdict. Le miroir m'avertit que la négation a des conséquences éternelles.`,
  reflection: `La négation d'Allah mène à la malédiction dans les deux mondes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ut-bi'uu fee haazihid dunya la'nah wa Yawmil Qiyaamah » — ils furent suivis d'une malédiction dans ce monde et au Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle malédiction je risque par mes choix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La malédiction est le contraire de la bénédiction — chaque choix mène à l'un ou l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de la vérité — nier est impossible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La malédiction est le choix de celui qui refuse la bénédiction." }
  ],
  munajat: `Ya Rabb, préserve-moi de la malédiction. Fais que je sois béni, pas maudit.`
};

MIROIR["11:61"] = {
  reference: "11:61",
  theme: ["salih", "mission", "création"],
  emotion: "Appel, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "An-Nadhir"],
  mirrorVersion: `« Et vers Thamud, leur frère Salih. Il dit : 'Ô mon peuple, adorez Allah.' » Le miroir me montre la continuité du message. « Wa ilaa Samuuda akhaahum Saalihan » — et vers Thamud, leur frère Salih. L'envoi. « Anshaa-akum minal ardi » — Il vous a créés de la terre. L'origine. « Wasta'marakum fiiha » — et vous a fait peupler la terre. La responsabilité. « Fastaghfiruuhu » — demandez-Lui pardon. L'istighfar. « Thuumma tuubuu ilayh » — puis revenez à Lui. Le repentir. Le miroir m'enseigne que notre origine terrestre appelle l'humilité.`,
  reflection: `Nous sommes créés de la terre — l'humilité est notre juste réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ilaa Samuuda akhaahum Saalihan qaala yaa qawmi'budul laah » — et vers Thamud, leur frère Salih. Il dit : ô mon peuple, adorez Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine terrestre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine terrestre élève quand on l'accepte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est notre mère — nous retournons à elle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine connaît sa destination." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de la terre. Aide-moi à vivre avec humilité et repentir.`
};

MIROIR["11:62"] = {
  reference: "11:62",
  theme: ["reconnaissance", "désaveu", "épreuve"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Haqq"],
  mirrorVersion: `« Ils dirent : 'Ô Salih, tu étais auparavant un espoir pour nous.' » Le miroir me montre le revirement. « Kunta feenaa marjuwwan » — tu étais un espoir pour nous. L'estime passée. « A-tanhaanaa an na'buda maa ya'budu aabaaa'unaa » — nous interdis-tu d'adorer ce que nos pères adoraient ? Le traditionalisme. « Innanaa lafee shakkim mir-raabakum mubeen » — nous sommes dans un doute provoquant. Le doute. Le miroir m'enseigne que l'estime passée ne garantit pas l'acceptation présente.`,
  reflection: `Les gens peuvent aimer le messager mais rejeter le message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu yaa Saalihu kunta feenaa marjuwwan qabla hadhaa » — ils dirent : ô Salih, tu étais auparavant un espoir pour nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aime le messager mais refuse le message ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir en l'homme peut devenir obstacle à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de doute sur son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le doute est le luxe de celui qui ne veut pas voir." }
  ],
  munajat: `Ya Haqq, ne permets pas que le doute m'empêche de voir la vérité. Fais que je reconnaisse le message quand il vient.`
};

MIROIR["11:63"] = {
  reference: "11:63",
  theme: ["preuve", "protection", "humilité"],
  emotion: "Confiance, calme",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Waliyy"],
  mirrorVersion: `« Il dit : 'Ô mon peuple, voyez-vous si je me fonde sur une preuve de mon Seigneur.' » Le miroir me montre la réponse mesurée. « Ara'aytum in kuntu 'alaa bayyinatim mir Rabbi » — voyez-vous si j'ai une preuve. L'appel à la raison. « Wa aataani minhu rahmah » — et qu'Il m'a donné une miséricorde. Le don. « Faman yansurunee minal laahi in 'asaytuhu » — qui me protégera contre Allah si je Lui désobéis ? La conscience. « Famaa tazeeduunanii ghayra takhsaar » — vous ne m'augmentez que de la perte. La lucidité. Le miroir m'enseigne la réponse calme et argumentée.`,
  reflection: `L'argument calme est plus fort que l'émotion forte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala yaa qawmi ara'aytum in kuntu 'alaa bayyinatim mir Rabbi wa aataani minhu rahmah » — il dit : ô mon peuple, voyez-vous si je me fonde sur une preuve de mon Seigneur et qu'Il m'a donné une miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réponds à l'opposition ? Avec calme ou colère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience d'être protégé par Allah donne le calme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond calmement à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la preuve n'a pas besoin de crier." }
  ],
  munajat: `Ya Waliyy, donne-moi Ta protection. Fais que je réponde avec calme et preuve.`
};

MIROIR["11:64"] = {
  reference: "11:64",
  theme: ["signe", "chamelle", "épreuve"],
  emotion: "Solennité, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Ayah", "Al-Hafiz"],
  mirrorVersion: `« Voici la chamelle d'Allah, un signe pour vous. » Le miroir me montre le signe concret. « Haazihi naaqatul laah » — voici la chamelle d'Allah. Le signe vivant. « Lakum aayah » — un signe pour vous. La preuve visible. « Fazaruuhaa ta'kul fee ardi laah » — laissez-la manger sur la terre d'Allah. La protection. « Wa laa tamassuuhaa bi-suu'in » — ne la touchez pas avec mal. L'avertissement. « Fa-ya'khuzakum 'azaabun qareeb » — un châtiment proche vous atteindra. La conséquence. Le miroir m'enseigne que les signes d'Allah demandent le respect.`,
  reflection: `Les signes d'Allah sont sacrés — les toucher avec mal apporte le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Haazihi naaqatul laah lakum aayah fazaruuhaa ta'kul fee ardi laah » — voici la chamelle d'Allah, un signe pour vous. Laissez-la manger sur la terre d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel signe d'Allah est-ce que je dois respecter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe qui n'est pas respecté devient jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier respecte les signes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les signes d'Allah est respecté par Lui." }
  ],
  munajat: `Ya Rabb, fais que je respecte Tes signes. Préserve-moi de les toucher avec mal.`
};

MIROIR["11:65"] = {
  reference: "11:65",
  theme: ["transgression", "châtiment", "regret"],
  emotion: "Tristesse, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Mais ils la tuèrent. Il dit : 'Jouissez dans vos maisons pendant trois jours.' » Le miroir me montre la transgression fatale. « Fa'aqaruhaa » — ils la tuèrent. Le crime. « Fata-matta'uu fee daarikum thalaathata ayyaam » — jouissez dans vos maisons pendant trois jours. Le délai. « Dhaaka wa'dun ghayru mukhadhdhab » — c'est une promesse non mensongère. La certitude. Le miroir m'avertit que la transgression des signes d'Allah amène un châtiment certain.`,
  reflection: `La transgression des signes d'Allah a un délai — puis le châtiment vient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'aqaruhaa faqaala tata-matta'uu fee daarikum thalaathata ayyaam » — mais ils la tuèrent. Il dit : jouissez dans vos maisons pendant trois jours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel signe ai-je transgressé ? Quel délai me reste-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde — pas une victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier respecte les limites d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délai de trois jours est le temps du repentir — mais ils ne se repentirent pas." }
  ],
  munajat: `Ya Qahhar, préserve-moi de transgresser Tes signes. Donne-moi le repentir avant le châtiment.`
};

MIROIR["11:66"] = {
  reference: "11:66",
  theme: ["salut", "justice", "miséricorde"],
  emotion: "Gratitude, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Ar-Rahman"],
  mirrorVersion: `« Puis, quand vint Notre ordre, Nous sauvâmes Salih et ceux qui avaient cru avec lui. » Le miroir me montre le salut sélectif. « Falammaa jaaa'a amrunaa » — quand vint Notre ordre. L'accomplissement. « Najjainaa Saalihan » — Nous sauvâmes Salih. La protection. « Wallazeena aamanuu ma'ahu » — et ceux qui avaient cru avec lui. La compagnie des croyants. « Bi-rahmatim minnaa » — par une miséricorde de Nous. La grâce. Le miroir m'enseigne que le salut vient par la foi.`,
  reflection: `Le salut est pour les croyants — la miséricorde d'Allah sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falammaa jaaa'a amrunaa najjainaa Saalihan wallazeena aamanuu ma'ahu bi-rahmatim minnaa » — puis, quand vint Notre ordre, Nous sauvâmes Salih et ceux qui avaient cru avec lui, par une miséricorde de Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le salut ? Suis-je avec les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment des uns est le salut des autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend le salut de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah est le secret du salut." }
  ],
  munajat: `Ya Rahman, sauve-moi par Ta miséricorde. Fais que je sois avec les croyants sauvés.`
};

MIROIR["11:67"] = {
  reference: "11:67",
  theme: ["destruction", "châtiment", "justice"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Mumit"],
  mirrorVersion: `« Le Cri saisit les injustes, et le matin, ils gisaient morts dans leurs maisons. » Le miroir me montre la destruction soudaine. « Akhazathumur-ra'jah » — le Cri les saisit. L'instant. « Fa-asbahuu fee diyaarihim jaathimeen » — le matin, ils gisaient dans leurs maisons. La scène finale. Le miroir m'avertit que le châtiment peut venir soudainement.`,
  reflection: `Le châtiment peut venir en un instant — le repentir doit être immédiat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akhazathumur-ra'jah fa-asbahuu fee diyaarihim jaathimeen » — le Cri saisit les injustes, et le matin, ils gisaient morts dans leurs maisons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt si le Cri vient maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Cri qui tue les injustes épargne les justes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit au Cri d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Cri est le même qui ressuscitera les morts." }
  ],
  munajat: `Ya Qahhar, le Cri m'effraie. Préserve-moi par ma foi. Épargne-moi du châtiment soudain.`
};

MIROIR["11:68"] = {
  reference: "11:68",
  theme: ["disparition", "vide", "leçon"],
  emotion: "Mélancolie, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Baaqi", "Al-Faani"],
  mirrorVersion: `« Comme s'ils n'y avaient jamais vécu. » Le miroir me montre l'effacement total. « Ka-allam yaghnaw feehaa » — comme s'ils n'y avaient jamais vécu. L'oubli complet. « Alaa bu'dal li-Samuuda » — que périssent les Thamud ! Le verdict. « Ka-maa ba'udat 'Aad » — comme 'Ad a péri. La répétition de l'histoire. Le miroir m'enseigne que les civilisations qui nient Allah disparaissent complètement.`,
  reflection: `Les civilisations qui nient Allah sont effacées — comme si elles n'avaient jamais existé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-allam yaghnaw feehaa alaa bu'dal li-Samuuda ka-maa ba'udat 'Aad » — comme s'ils n'y avaient jamais vécu. Que périssent les Thamud ! Comme 'Ad a péri." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui restera de moi ? De mon œuvre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est effacé de la terre reste éternel auprès d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne retient que ce qu'Allah veut retenir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'effacement de la terre peut être l'élévation auprès d'Allah." }
  ],
  munajat: `Ya Baaqi, Tu es l'Éternel. Fais que mon œuvre reste auprès de Toi, pas sur la terre.`
};

MIROIR["11:69"] = {
  reference: "11:69",
  theme: ["ibrahim", "anges", "hospitalité"],
  emotion: "Hospitalité, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Karam", "As-Salam"],
  mirrorVersion: `« Nos envoyés vinrent à Ibrahim avec la bonne nouvelle. » Le miroir me montre l'hospitalité prophétique. « Jaaa'athuu rusulunaa bil-bushraa » — Nos envoyés vinrent avec la bonne nouvelle. La visite. « Qaala salaam » — il dit : paix. L'accueil. « Qaala salaam » — ils dirent : paix. La réciprocité. « Famaa labitha an jaaa'a bi-'ijlin haneedh » — il ne tarda pas à apporter un veau rôti. L'hospitalité. Le miroir m'enseigne l'accueil généreux.`,
  reflection: `L'hospitalité prophétique est immédiate et généreuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad jaaa'at rusulunaa Ibraaheema bil-bushraa qaaluu salaamaa » — Nos envoyés vinrent à Ibrahim avec la bonne nouvelle. Ils dirent : paix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'accueille les visiteurs ? Avec générosité ou réticence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hospitalité est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier accueille les créatures d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'hospitalité à l'étranger peut être l'accueil des anges." }
  ],
  munajat: `Ya Karim, enseigne-moi l'hospitalité. Fais que j'accueille comme Ibrahim.`
};

MIROIR["11:70"] = {
  reference: "11:70",
  theme: ["méfiance", "révélation", "paix"],
  emotion: "Crainte, soulagement",
  difficulty: "intermédiaire",
  relatedNames: ["As-Salam", "Al-Waliyy"],
  mirrorVersion: `« Quand il vit que leurs mains ne l'atteignaient pas, il se méfia d'eux et ressentit de la peur. » Le miroir me montre la méfiance naturelle. « Lam yamidduhaa ilayhi » — leurs mains ne l'atteignaient pas. Le refus de manger. « Nakira hum » — il se méfia. L'inquiétude. « Kheefah » — peur. L'émotion. « Qaalu laa takhaf » — ils dirent : ne crains pas. La rassurance. « Innaa ursilnaa ilaa qawmi Luut » — nous sommes envoyés au peuple de Lot. La mission révélée. Le miroir m'enseigne que la peur précède parfois la révélation.`,
  reflection: `La peur peut être le signe que quelque chose d'important arrive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falammaa ra-aa aydiyahum laa tamidduhaa ilayhi nakira hum wa awjasa minhum kheefah » — quand il vit que leurs mains ne l'atteignaient pas, il se méfia d'eux et ressentit de la peur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle peur me précède ? Quelle révélation m'attend ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur qui mène à la révélation est une peur bénie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier ressent la crainte révérencielle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La rassurance d'Allah suit toujours la peur du croyant." }
  ],
  munajat: `Ya Waliyy, rassure-moi comme Tu as rassuré Ibrahim. Transforme ma peur en révélation.`
};

MIROIR["11:71"] = {
  reference: "11:71",
  theme: ["bonne nouvelle", "sarah", "étonnement"],
  emotion: "Étonnement, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Wahhab"],
  mirrorVersion: `« Sa femme était debout et rit. Nous lui annonçâmes la bonne nouvelle d'Isaac. » Le miroir me montre la bonne nouvelle inattendue. « Imra'atuhu qaaa'imatun fadahikat » — sa femme était debout et rit. La réaction. « Fa-bash-sharnaahaa bi-Is'haaq » — Nous lui annonçâmes Isaac. La promesse. « Wa min waraaa'i Is'haaq Ya'quub » — et après Isaac, Jacob. La descendance. Le miroir m'enseigne que les bonnes nouvelles d'Allah peuvent dépasser l'imagination.`,
  reflection: `Les bonnes nouvelles d'Allah dépassent ce qu'on peut imaginer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa imra'atuhu qaaa'imatun fadahikat fabash-sharnaahaa bi-Is'haaq » — sa femme était debout et rit. Nous lui annonçâmes la bonne nouvelle d'Isaac." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle bonne nouvelle m'attend qui me ferait rire d'étonnement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rire d'étonnement peut être la réaction à la grâce d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend la bonne nouvelle de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La descendance d'Allah est le don le plus précieux." }
  ],
  munajat: `Ya Wahhab, donne-moi Ta bonne nouvelle. Fais que je reçoive avec joie Tes dons inattendus.`
};

MIROIR["11:72"] = {
  reference: "11:72",
  theme: ["étonnement", "âge", "miracle"],
  emotion: "Émerveillement, incrédulité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Khaliq"],
  mirrorVersion: `« Elle dit : 'Malheur à moi ! Enfanterai-je, vieillie que je suis ?' » Le miroir me montre l'étonnement devant le miracle. « Yaa way-lataa » — malheur à moi ! L'exclamation. « a'aldu wa ana 'ajooz » — enfanterai-je, vieillie que je suis ? Le doute raisonnable. « Wa haazaa ba'lee shaykh » — et mon mari est vieux. L'impossibilité humaine. « Inna haaza la-shayjun 'ajiib » — c'est vraiment une chose étonnante. Le miracle reconnu. Le miroir m'enseigne que les miracles d'Allah défient la logique humaine.`,
  reflection: `Les miracles d'Allah défient les limites naturelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalat yaa way-lataa a'aldu wa ana 'ajooz wa haazaa ba'lee shaykh » — elle dit : malheur à moi ! Enfanterai-je, vieillie que je suis, et mon mari est vieux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel miracle je considère impossible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossible pour l'homme est facile pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un miracle continu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le miracle arrive quand la logique humaine est épuisée." }
  ],
  munajat: `Ya Qadir, fais l'impossible pour moi. Je crois en Tes miracles même quand la logique dit non.`
};

MIROIR["11:73"] = {
  reference: "11:73",
  theme: ["rassurance", "miséricorde", "foi"],
  emotion: "Apaisement, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mu'min"],
  mirrorVersion: `« Ils dirent : 'T'étonnes-tu de l'ordre d'Allah ? Que la miséricorde d'Allah et Ses bénédictions soient sur vous.' » Le miroir me montre la rassurance divine. « Ata'jabuuna min amril laah » — t'étonnes-tu de l'ordre d'Allah ? La question. « Rahmatul laahi wa barakaatuhu 'alaikum » — que la miséricorde d'Allah et Ses bénédictions soient sur vous. La bénédiction. « Ahlal bayt » — gens de la maison. L'élection. « Innahu Hameedum Majeed » — Il est Digne de louange, Glorieux. La glorification. Le miroir m'enseigne à ne pas s'étonner de la puissance d'Allah.`,
  reflection: `L'étonnement devant l'ordre d'Allah est une forme d'oubli de Sa puissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu at'jabuuna min amril laahi rahmatul laahi wa barakaatuhu 'alaikum » — ils dirent : t'étonnes-tu de l'ordre d'Allah ? Que la miséricorde d'Allah et Ses bénédictions soient sur vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi m'étonne-je dans l'ordre d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement peut être remplacé par la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne s'étonne pas de l'ordre d'Allah — il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah accompagne toujours Son ordre." }
  ],
  munajat: `Ya Rahman, ne permets pas que je m'étonne de Ton ordre. Augmente ma confiance en Ta puissance.`
};

MIROIR["11:74"] = {
  reference: "11:74",
  theme: ["disparition", "intercession", "compassion"],
  emotion: "Compassion, inquiétude",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Ra'uf", "Al-Waliyy"],
  mirrorVersion: `« Quand la peur eut quitté Ibrahim et que la bonne nouvelle lui fut venue. » Le miroir me montre le passage de la peur à l'action. « Falammaa zahaba 'an Ibraaheemar-ra'u'u » — quand la peur quitta Ibrahim. Le calme. « Jaaa'at-hul bushraa » — la bonne nouvelle lui vint. La joie. « Yujaadilunaa fee qawmi Luut » — il discutait avec Nous au sujet du peuple de Lot. L'intercession. Le miroir m'enseigne que la compassion pour les autres peut suivre la peur pour soi.`,
  reflection: `La compassion pour les pécheurs est un signe de grandeur d'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falammaa zahaba 'an Ibraaheemar-ra'u'u wa jaaa'at-hul bushraa yujaadilunaa fee qawmi Luut » — quand la peur eut quitté Ibrahim et que la bonne nouvelle lui fut venue, il discutait avec Nous au sujet du peuple de Lot." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui est-ce que j'intercède ? De qui ai-je compassion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession pour les autres est un honneur accordé par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier intercède par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui intercède pour les autres est proche d'Allah." }
  ],
  munajat: `Ya Ra'uf, donne-moi la compassion pour les autres. Fais que j'intercède comme Ibrahim.`
};

MIROIR["11:75"] = {
  reference: "11:75",
  theme: ["ibrahim", "caractère", "compassion"],
  emotion: "Admiration, inspiration",
  difficulty: "débutant",
  relatedNames: ["Ar-Ra'uf", "Al-Halim"],
  mirrorVersion: `« Ibrahim était certes longanime, profondément clément et repentant. » Le miroir me montre le caractère prophétique. « Awwaahun » — longanime. La patience. « Haliim » — clément. La douceur. « Muneeb » — repentant. Le retour à Allah. Le miroir m'invite à modeler mon caractère sur celui d'Ibrahim.`,
  reflection: `Le caractère d'Ibrahim combine patience, douceur et repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Ibraaheema la-awwaahun haliim » — Ibrahim était certes longanime, profondément clément et repentant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon caractère ressemble-t-il à celui d'Ibrahim ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douceur n'est pas faiblesse — c'est force maîtrisée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier reflète la patience et la douceur d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le caractère prophétique est le plus grand héritage." }
  ],
  munajat: `Ya Halim, donne-moi le caractère d'Ibrahim. Patience, douceur, repentir — fais que je les possède.`
};

MIROIR["11:76"] = {
  reference: "11:76",
  theme: ["arrêt", "intercession", "destin"],
  emotion: "Acceptation, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadi", "Al-Fasl"],
  mirrorVersion: `« Ô Ibrahim, renonce à cela. L'ordre de ton Seigneur est déjà venu. » Le miroir me montre la limite de l'intercession. « Ya Ibraaheemu a'rid 'an haazaa » — Ibrahim, renonce à cela. L'arrêt. « Qad jaaa'a amru Rabbika » — l'ordre de ton Seigneur est venu. L'irrévocabilité. « Wa innahum aaa'tihim 'azaabum ghayru marduuud » — un châtiment leur viendra, inéluctable. La certitude. Le miroir m'enseigne que l'intercession a des limites fixées par Allah.`,
  reflection: `Quand l'arrêt d'Allah vient, même l'intercession du prophète ne peut le changer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala yaa Ibraaheemu a'rid 'an haazaa qad jaaa'a amru Rabbika » — il dit : ô Ibrahim, renonce à cela. L'ordre de ton Seigneur est déjà venu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel arrêt d'Allah dois-je accepter sans plus discuter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de l'arrêt est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier accepte l'arrêt de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'arrêt d'Allah est toujours juste, même incompréhensible." }
  ],
  munajat: `Ya Qadi, j'accepte Ton arrêt. Fais que je me soumette quand Tu dis : c'est décidé.`
};

MIROIR["11:77"] = {
  reference: "11:77",
  theme: ["lot", "anges", "détresse"],
  emotion: "Angoisse, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Khawf"],
  mirrorVersion: `« Et Nos envoyés vinrent à Lot. Il se sentit gêné pour eux. » Le miroir me montre la détresse prophétique. « Jaaa'athuu rusulunaa Luutan » — Nos envoyés vinrent à Lot. La visite. « See'a bihim » — il se sentit gêné. L'angoisse. « Wa daaqa bihim dhar'an » — son cœur se serra. La détresse. « Wa qaaluu laa takhaf wa laa tahzan » — ils dirent : ne crains pas et ne t'attriste pas. La rassurance. Le miroir m'enseigne que la responsabilité peut créer de l'angoisse.`,
  reflection: `La responsabilité pour les autres peut créer de l'angoisse — Allah rassure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lammaa jaaa'at rusulunaa Luutan see'a bihim wa daaqa bihim dhar'an » — et Nos envoyés vinrent à Lot. Il se sentit gêné pour eux et son cœur se serra." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle responsabilité me serre le cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'angoisse de la responsabilité précède la rassurance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier ressent le poids de la responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La rassurance d'Allah suit toujours l'angoisse du croyant." }
  ],
  munajat: `Ya Waliyy, Tu connais mon angoisse. Rassure-moi comme Tu as rassuré Lot.`
};

MIROIR["11:78"] = {
  reference: "11:78",
  theme: ["lot", "peuple", "proposition"],
  emotion: "Honte, désespoir",
  difficulty: "avancé",
  relatedNames: ["Al-Haqq", "Al-Fahisha"],
  mirrorVersion: `« Son peuple vint à lui, courant vers lui. Déjà ils commettaient les mauvaises actions. » Le miroir me montre la corruption manifeste. « Jaaa'ahu qawmuhu yuhra'uuna ilayhi » — son peuple vint, courant vers lui. L'empressement du mal. « Wa min qablu kaanuu ya'maluunas-sayyi'aat » — déjà ils commettaient les mauvaises actions. L'habitude du péché. « Qaala yaa qawmi haaulaaa'i banaati hunna atharu lakum » — il dit : ô mon peuple, voici mes filles — mariez-vous à elles. La proposition désespérée. Le miroir m'avertit que la corruption peut s'accélérer face au signe.`,
  reflection: `La corruption profondément enracinée ne connaît pas de limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa jaaa'ahu qawmuhu yuhra'uuna ilayhi wa min qablu kaanuu ya'maluunas-sayyi'aat » — son peuple vint à lui, courant. Déjà ils commettaient les mauvaises actions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle corruption m'entoure et m'afflige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proposition du prophète est désespérée — mais l'arrêt d'Allah est déjà là." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de place pour la corruption illimitée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand la corruption est complète, l'arrêt d'Allah vient." }
  ],
  munajat: `Ya Rabb, la corruption m'entoure. Préserve-moi et sauve-moi de ce qui corrompt.`
};

MIROIR["11:79"] = {
  reference: "11:79",
  theme: ["refus", "désir", "aveuglement"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Huda", "Al-Ghayy"],
  mirrorVersion: `« Ils dirent : 'Tu sais que nous n'avons aucun droit sur tes filles.' » Le miroir me montre l'aveuglement total. « Ta'lamu anna laa haqqa lanaa fee banaatik » — tu sais que nous n'avons aucun droit sur tes filles. L'aveu lucide. « Wa innaka la-ta'lamu maa nureed » — tu sais ce que nous voulons. La reconnaissance du désir corrompu. Le miroir m'enseigne que le désir corrompu peut être conscient de sa corruption.`,
  reflection: `Le péché peut être conscient et assumé — c'est le sommet de l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu laqad 'alimta maa lanaa fee banaatika min haqqin wa innaka la-ta'lamu maa nureed » — ils dirent : tu sais que nous n'avons aucun droit sur tes filles, et tu sais ce que nous voulons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel désir corrompu je poursuis consciemment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience du mal peut être le moment du repentir — ou l'approfondissement du péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne poursuit pas de désirs corrompus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît le désir caché — Il peut le guérir ou le punir." }
  ],
  munajat: `Ya Hadi, guéris mes désirs corrompus. Ne permets pas que je les suive consciemment.`
};

MIROIR["11:80"] = {
  reference: "11:80",
  theme: ["impuissance", "appel", "force"],
  emotion: "Détresse, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "Al-Muntaqim"],
  mirrorVersion: `« Il dit : 'Si seulement j'avais contre vous une force !' » Le miroir me montre l'impuissance du prophète. « La-wanna lee bikum quwwatan » — si j'avais contre vous une force. Le vœu. « Awi aawee ilaa ruknin shadeed » — ou un appui solide. Le désir de protection. L'impuissance face au mal organisé. Le miroir m'enseigne que même les prophètes peuvent se sentir impuissants.`,
  reflection: `L'impuissance face au mal peut être le prélude à l'intervention d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala law anna lee bikum quwwatan aw aawee ilaa ruknin shadeed » — il dit : si seulement j'avais contre vous une force ! Ou un appui solide." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quoi je me sens impuissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance humaine est l'occasion de la force divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers trouve sa force en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est le Ruknu ash-shadeed — l'appui solide." }
  ],
  munajat: `Ya Qawiyy, Tu es ma force. Quand je suis impuissant, sois ma force. Sois mon appui solide.`
};

MIROIR["11:81"] = {
  reference: "11:81",
  theme: ["rassurance", "obéissance", "fuite"],
  emotion: "Urgence, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Al-Hadi"],
  mirrorVersion: `« Ils dirent : 'Ô Lot, nous sommes les envoyés de ton Seigneur. Ils ne pourront t'atteindre.' » Le miroir me montre la rassurance immédiate. « Innaa rusulu Rabbika » — nous sommes les envoyés de ton Seigneur. L'identité. « Lan yasiluu ilayk » — ils ne pourront t'atteindre. La protection. « Fa-asri bi-ahlika bi-haa'ilil layl » — pars avec ta famille au cours de la nuit. L'ordre. « Wa laa yalta-fit minkum ahadun » — que personne ne se retourne. L'avertissement. Le miroir m'enseigne que le salut demande l'obéissance immédiate.`,
  reflection: `Le salut demande de partir sans se retourner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu yaa Luutu innaa rusulu Rabbika lan yasiluu ilayk » — ils dirent : ô Lot, nous sommes les envoyés de ton Seigneur. Ils ne pourront t'atteindre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi dois-je partir sans me retourner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le non-retour est la condition du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers avance sans se retourner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le regard en arrière peut transformer le salut en perte." }
  ],
  munajat: `Ya Munji, fais que je parte quand Tu dis pars. Ne permets pas que je me retourne.`
};

MIROIR["11:82"] = {
  reference: "11:82",
  theme: ["châtiment", "destruction", "renversement"],
  emotion: "Stupeur, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Musabbib"],
  mirrorVersion: `« Puis, quand vint Notre ordre, Nous renversâmes la ville de fond en comble. » Le miroir me montre le châtiment total. « Falammaa jaaa'a amrunaa » — quand vint Notre ordre. L'accomplissement. « 'Alya naaha » — Nous la renversâmes. Le bouleversement. « Wa amtarnaa 'alayhaa hijaaratum min sijjeel » — et Nous fîmes pleuvoir sur elle des pierres d'argile. La destruction. Le miroir m'avertit que le châtiment d'Allah peut renverser ce qui semblait stable.`,
  reflection: `Ce qui semble stable peut être renversé par l'ordre d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falammaa jaaa'a amrunaa 'alya naaha wa amtarnaa 'alayhaa hijaaratum min sijjeel » — puis, quand vint Notre ordre, Nous renversâmes la ville et fîmes pleuvoir sur elle des pierres d'argile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui peut être renversé dans ma vie par l'ordre d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le renversement des pervers est la justice d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut être renversé par l'ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah renverse ce qui Lui résiste — et élève ce qui se soumet." }
  ],
  munajat: `Ya Qahhar, Tu renverses ce qui T'oppose. Fais que je me soumette pour ne pas être renversé.`
};

MIROIR["11:83"] = {
  reference: "11:83",
  theme: ["destin", "châtiment", "justice"],
  emotion: "Crainte, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-'Adl"],
  mirrorVersion: `« Marquées auprès de ton Seigneur. Elles ne sont pas loin des injustes. » Le miroir me montre le destin scellé. « Musawwamatum 'inda Rabbika » — marquées auprès de ton Seigneur. Le destin. « Wa maa hiya minal zaalimeena bi-ba'eed » — elles ne sont pas loin des injustes. La proximité du châtiment. Le miroir m'avertit que le châtiment d'Allah peut atteindre n'importe qui, n'importe quand.`,
  reflection: `Le châtiment d'Allah est marqué pour chaque peuple injuste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Musawwamatum 'inda Rabbika wa maa hiya minal zaalimeena bi-ba'eed » — marquées auprès de ton Seigneur. Elles ne sont pas loin des injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je loin du châtiment ou proche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité du châtiment dépend de la proximité de la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est marqué par le décret d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le destin de chaque peuple est marqué — le repentir peut le changer." }
  ],
  munajat: `Ya 'Adl, préserve-moi de l'injustice qui m'approche du châtiment. Fais que je sois juste et sauvé.`
};

MIROIR["11:84"] = {
  reference: "11:84",
  theme: ["shu'ayb", "mission", "justice"],
  emotion: "Appel, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "An-Nadhir"],
  mirrorVersion: `« Et vers Madyan, leur frère Shu'ayb. Il dit : 'Ô mon peuple, adorez Allah.' » Le miroir me montre la continuité du message. « Wa ilaa Madyana akhaahum Shu'aybaa » — et vers Madyan, leur frère Shu'ayb. L'envoi. « Yaa qawmi'budul laah » — ô mon peuple, adorez Allah. Le tawhid. « Wa aatiful kayla waz-zeez » — donnez pleine mesure et poids. La justice commerciale. « Laa tabkhasun-naasa ashyaa'ahum » — ne réduisez pas les gens dans leurs droits. L'honnêteté. Le miroir m'enseigne que le message inclut la justice sociale.`,
  reflection: `La foi inclut la justice dans les transactions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ilaa Madyana akhaahum Shu'aybaa qaala yaa qawmi'budul laah wa aatiful kayla waz-zeez » — et vers Madyan, leur frère Shu'ayb. Il dit : ô mon peuple, adorez Allah, donnez pleine mesure et poids." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis juste dans mes transactions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice dans les transactions contredit l'adoration d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est précis dans ses mesures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La justice commerciale est un acte d'adoration." }
  ],
  munajat: `Ya 'Adl, fais que je sois juste dans mes transactions. L'injustice contredit mon adoration de Toi.`
};

MIROIR["11:85"] = {
  reference: "11:85",
  theme: ["justice", "mesure", "avertissement"],
  emotion: "Avertissement, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Mizan", "Al-Khabeer"],
  mirrorVersion: `« Ô mon peuple, donnez pleine mesure et poids avec équité. » Le miroir me montre l'équité exigée. « Awful kayla waz-zeena bil-qist » — donnez pleine mesure et poids avec équité. La balance juste. « Wa laa tabkhasun-naasa ashyaa'ahum » — ne réduisez pas les gens dans leurs droits. Le respect. « Wa laa ta'saw fil-ardi mufsideen » — ne semez pas la corruption sur la terre. La responsabilité. Le miroir m'enseigne que l'équité est un devoir religieux.`,
  reflection: `L'équité dans les affaires est un devoir envers Allah et les gens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaa qawmi awful kayla waz-zeena bil-qist wa laa tabkhasun-naasa ashyaa'ahum » — ô mon peuple, donnez pleine mesure et poids avec équité, ne réduisez pas les gens dans leurs droits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite les gens dans les affaires ? Avec équité ou tromperie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tromperie dans les affaires corrompt la terre entière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en équilibre parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est équitable reflète l'équité d'Allah." }
  ],
  munajat: `Ya Mizan, Tu es l'Équitable. Fais que je sois équitable dans toutes mes affaires.`
};

MIROIR["11:86"] = {
  reference: "11:86",
  theme: ["licite", "bénédiction", "pureté"],
  emotion: "Appel, promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Halal", "Al-Tayyib"],
  mirrorVersion: `« Ce qui reste auprès d'Allah est meilleur pour vous, si vous êtes croyants. » Le miroir me montre la supériorité du licite. « Baaqiyatul laahi khayrul lakum » — ce qui reste auprès d'Allah est meilleur pour vous. La promesse. « In kuntum mu'mineen » — si vous êtes croyants. La condition. « Wa maaa ana 'alaikum bi-hafeedh » — je ne suis pas votre gardien. La responsabilité individuelle. Le miroir m'enseigne que le licite apporte la bénédiction.`,
  reflection: `Le gain illicite est éphémère — le licite reste auprès d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Baaqiyatul laahi khayrul lakum in kuntum mu'mineen » — ce qui reste auprès d'Allah est meilleur pour vous, si vous êtes croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de gain illicite je poursuis au détriment du licite béni ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le licite est moins en quantité mais plus en bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier subsiste par le licite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La bénédiction dans le licite dépasse toute quantité illicite." }
  ],
  munajat: `Ya Rabb, donne-moi du licite béni. Fuis que je ne cherche pas l'illicite éphémère.`
};

MIROIR["11:87"] = {
  reference: "11:87",
  theme: ["religion", "économie", "moquerie"],
  emotion: "Mépris, incompréhension",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Muta'al"],
  mirrorVersion: `« Ils dirent : 'Ô Shu'ayb, est-ce ta prière qui t'ordonne de nous faire abandonner ce que nos pères adoraient ?' » Le miroir me montre le rejet de la guidance. « A-salaatuka ta'muruka an natruka maa ya'budu aabaaa'unaa » — est-ce ta prière qui t'ordonne d'abandonner ce que nos pères adoraient ? La moquerie. « Aw an naf'ala fee amwaalinaa maa nashaaa' » — ou de faire dans nos biens ce que nous voulons ? Le rejet de l'économie juste. Le miroir m'enseigne que le message intégral est souvent rejeté.`,
  reflection: `La prière devrait influencer tous les aspects de la vie, y compris l'économie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu yaa Shu'aybu a-salaatuka ta'muruka an natruka maa ya'budu aabaaa'unaa » — ils dirent : ô Shu'ayb, est-ce ta prière qui t'ordonne de nous faire abandonner ce que nos pères adoraient ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma prière influence mes affaires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière qui n'influence pas les affaires est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier prie par son ordre parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie prière transforme tout — elle ne laisse rien inchangé." }
  ],
  munajat: `Ya Hakim, fais que ma prière transforme ma vie. Ne permets pas que je sépare l'adoration de l'économie.`
};

MIROIR["74:39"] = {
  reference: "74:39",
  theme: ["droite", "compagnons", "paradis"],
  emotion: "Espoir, réconfort",
  difficulty: "débutant",
  relatedNames: ["Al-Yamin", "Al-Jannah"],
  mirrorVersion: `« Sauf les compagnons de la droite. » L'exception est espérance. Le miroir m'enseigne : les compagnons de la droite sont sauvés. Etre parmi eux est le but.`,
  reflection: `Les compagnons de la droite sont sauvés. Etre parmi eux est le but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa as-habu al-yamin » — sauf les compagnons de la droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi les compagnons de la droite ? Mon chemin m'y mène-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droite est la voie du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les compagnons de la droite sont honorés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la droite la trouve." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les compagnons de la droite. Guide-moi vers cette voie.`
};

MIROIR["74:40"] = {
  reference: "74:40",
  theme: ["paradis", "question", "mécréants"],
  emotion: "Soulagement, victoire",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Fauz"],
  mirrorVersion: `« Dans les jardins, ils s'interrogeront. » Les habitants du Paradis questionnent. Le miroir m'invite à anticiper : au Paradis, on questionnera sur le sort des mécréants.`,
  reflection: `Au Paradis, les croyants questionneront sur le sort des mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi jannatin yatasa'aluna » — dans les jardins, ils s'interrogeront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi ceux qui questionnent ? Le Paradis est-il mon but ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question des habitants du Paradis révèle leur sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le lieu de la sécurité éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui anticipe le Paradis le cherche." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les habitants des jardins. Permets-moi de questionner sur le sort des mécréants.`
};

MIROIR["74:41"] = {
  reference: "74:41",
  theme: ["paradis", "question", "coupables"],
  emotion: "Curiosité, contraste",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Mujrimin"],
  mirrorVersion: `« Au sujet des coupables. » Les coupables sont l'objet de la question. Le miroir m'enseigne : le contraste entre le Paradis et l'enfer est frappant. Les coupables servent de rappel.`,
  reflection: `Les coupables servent de rappel pour les habitants du Paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ani al-mujrimina » — au sujet des coupables." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux être parmi ceux qui questionnent ? Ou parmi les questionnés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le questionnement révèle la sécurité de celui qui questionne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le contraste entre Paradis et enfer est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite d'être coupable questionne." }
  ],
  munajat: `Ya Rabb, préserve-moi d'être parmi les coupables. Fais que je sois parmi les questionneurs.`
};

MIROIR["74:42"] = {
  reference: "74:42",
  theme: ["enfer", "question", "entrée"],
  emotion: "Curiosité, horreur",
  difficulty: "débutant",
  relatedNames: ["Al-Saqar", "Al-Dukhul"],
  mirrorVersion: `« Qu'est-ce qui vous a fait entrer dans le Feu ? » La question posée aux habitants de l'enfer. Le miroir m'avertit : cette question sera posée. La réponse est connue d'avance.`,
  reflection: `La question sera posée aux habitants de l'enfer. La réponse est connue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma salakakum fi al-saqar » — qu'est-ce qui vous a fait entrer dans le Feu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle sera ma réponse ? Est-ce que j'éviterai cette question ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question appelle à la prévention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La question est universelle pour les habitants du Feu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prévient la question ne la répond pas." }
  ],
  munajat: `Ya Rabb, aide-moi à éviter cette question. Préserve-moi du Feu.`
};

MIROIR["74:43"] = {
  reference: "74:43",
  theme: ["prière", "négligence", "enfer"],
  emotion: "Regret, amertume",
  difficulty: "débutant",
  relatedNames: ["Al-Salah", "Al-Ghaflah"],
  mirrorVersion: `« Ils diront : Nous n'étions pas de ceux qui priaient. » La première raison : la négligence de la prière. Le miroir m'avertit : la prière est fondamentale. Sa négligence mène au Feu.`,
  reflection: `La prière est fondamentale. Sa négligence mène au Feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu lam naku mina al-musallina » — nous n'étions pas de ceux qui priaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis de ceux qui prient ? La prière est-elle ma priorité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière protège. Sa négligence expose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière est le pilier de la religion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec constance est protégé." }
  ],
  munajat: `Ya Rabb, fais que je sois de ceux qui prient. Ne permets pas que je néglige la prière.`
};

MIROIR["74:44"] = {
  reference: "74:44",
  theme: ["charité", "négligence", "enfer"],
  emotion: "Regret, amertume",
  difficulty: "débutant",
  relatedNames: ["Al-Sadaqah", "Al-Zakah"],
  mirrorVersion: `« Et nous ne nourrissions pas le pauvre. » La deuxième raison : la négligence de la charité. Le miroir m'avertit : nourrir le pauvre est un devoir. Sa négligence mène au Feu.`,
  reflection: `Nourrir le pauvre est un devoir. Sa négligence mène au Feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lam naku nut'imu al-miskina » — et nous ne nourrissions pas le pauvre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nourris le pauvre ? La charité est-elle ma pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La charité purifie. L'avarice souille." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nourrir le pauvre est un devoir universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui nourrit le pauvre est nourri par Allah." }
  ],
  munajat: `Ya Rabb, aide-moi à nourrir le pauvre. Ne permets pas que je sois avare.`
};

MIROIR["74:45"] = {
  reference: "74:45",
  theme: ["discours", "vanité", "enfer"],
  emotion: "Regret, amertume",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kalam", "Al-Batil"],
  mirrorVersion: `« Et nous nous livrions à des discours avec ceux qui se livraient à des discours. » La troisième raison : les conversations vaines. Le miroir m'avertit : le temps passé dans les discours vains est du temps perdu.`,
  reflection: `Les discours vains sont une perte. Le temps est précieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nakhudu maa al-khadhina » — et nous nous livrions à des discours avec ceux qui se livraient à des discours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je passe mon temps ? Les discours vains occupent-ils ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le discours utile élève. Le discours vain abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est précieux. Il ne doit pas être gaspillé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les discours vains préserve son temps." }
  ],
  munajat: `Ya Rabb, aide-moi à éviter les discours vains. Fais que mon temps soit utilisé pour Toi.`
};

MIROIR["74:46"] = {
  reference: "74:46",
  theme: ["jour", "déni", "enfer"],
  emotion: "Regret, amertume",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yawm", "Al-Jazaa"],
  mirrorVersion: `« Et nous traitions de mensonge le Jour de la Rétribution. » La quatrième raison : le déni du Jour. Le miroir m'avertit : nier le Jour du Jugement mène à l'enfer.`,
  reflection: `Nier le Jour du Jugement mène à l'enfer. La foi en ce Jour sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nukadhdhibu bi-al-yawmi al-dini » — et nous traitions de mensonge le Jour de la Rétribution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment au Jour du Jugement ? Ma foi influence-t-elle mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en ce Jour motive la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour du Jugement est une certitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au Jour se prépare." }
  ],
  munajat: `Ya Rabb, je crois au Jour de la Rétribution. Fais que ma foi guide mes actions.`
};

MIROIR["74:47"] = {
  reference: "74:47",
  theme: ["mort", "certitude", "enfer"],
  emotion: "Réalisation, finalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mawt", "Al-Yaqin"],
  mirrorVersion: `« Jusqu'à ce que nous vienne la certitude. » La mort est la certitude. Le miroir m'enseigne : la mort est le moment de la vérité. Après elle, il n'y a plus d'opportunité de repentir.`,
  reflection: `La mort est la certitude. Le repentir doit précéder.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta atana al-yaqina » — jusqu'à ce que nous vienne la certitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour la certitude de la mort ? Le repentir est-il fait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de la mort appelle à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est la certitude universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la certitude est sauvé." }
  ],
  munajat: `Ya Rabb, je me repens avant la certitude. Accepte mon repentir.`
};

MIROIR["74:48"] = {
  reference: "74:48",
  theme: ["intercession", "inutilité", "enfer"],
  emotion: "Désespoir, finalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shafa'ah", "Al-Qadi"],
  mirrorVersion: `« L'intercession des intercesseurs ne leur profitera pas. » L'intercession est inutile pour les mécréants. Le miroir m'avertit : l'intercession a des limites. Elle ne profite pas à ceux qui n'ont pas cru.`,
  reflection: `L'intercession a des limites. Elle ne profite pas aux mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma tanfa'uhum shafa'atu al-shafi'ina » — l'intercession des intercesseurs ne leur profitera pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur l'intercession ? Ou est-ce que je me prépare par la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est la meilleure intercession." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'intercession est un don d'Allah, pas un droit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit n'a pas besoin d'intercession pour le salut." }
  ],
  munajat: `Ya Rabb, je ne compte que sur Toi. Accepte ma foi comme mon intercession.`
};

MIROIR["74:49"] = {
  reference: "74:49",
  theme: ["évitement", "rappel", "questionnement"],
  emotion: "Questionnement, étonnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Tadhkira", "Al-Mu'rid"],
  mirrorVersion: `« Qu'ont-ils à se détourner du rappel ? » La question de l'évitement. Le miroir m'interroge : pourquoi fuir le rappel ? Le rappel est une miséricorde, pas une menace.`,
  reflection: `Le rappel est une miséricorde. Le détourner est un refus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fama lahum 'ani al-tadhkirati mu'ridina » — qu'ont-ils à se détourner du rappel ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me détourne du rappel ? Ou est-ce que je l'accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel est une miséricorde. Le détourner est un refus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rappel est offert à tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille le rappel reçoit la miséricorde." }
  ],
  munajat: `Ya Rabb, j'accueille Ton rappel. Ne permets pas que je me détourne.`
};

MIROIR["74:50"] = {
  reference: "74:50",
  theme: ["ânes", "fuite", "peur"],
  emotion: "Image, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khashyah", "Al-Hamir"],
  mirrorVersion: `« Comme des ânes qui prennent la fuite. » L'image des ânes fuyants. Le miroir m'avertit : fuir le rappel est comme la fuite d'un âne sans raison. La peur irrationnelle mène à la fuite.`,
  reflection: `Fuir le rappel est irrationnel. L'accueillir est rationnel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-annahum humurun mustanfiratun » — comme des ânes qui prennent la fuite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis le rappel ? Ou est-ce que je l'accueille avec raison ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accueil du rappel est la raison. La fuite est l'irrationalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'âne fuit par instinct. L'homme doit réfléchir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réfléchit ne fuit pas." }
  ],
  munajat: `Ya Rabb, fais que je ne fuis pas le rappel. Donne-moi la raison d'accueillir.`
};

MIROIR["74:51"] = {
  reference: "74:51",
  theme: ["lion", "peur", "fuite"],
  emotion: "Image, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Asad", "Al-Khashyah"],
  mirrorVersion: `« Fuyant devant un lion. » L'image du lion qui effraie. Le miroir m'avertit : la peur irrationnelle du rappel est comme la peur d'un lion. Le rappel n'est pas un danger.`,
  reflection: `Le rappel n'est pas un danger. La peur irrationnelle est l'erreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Farratin min qaswarat » — fuyant devant un lion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi ai-je peur ? Le rappel est-il un lion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel est un ami. La peur en fait un ennemi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La peur du rapple est irrationnelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le rappel ne le fuit pas." }
  ],
  munajat: `Ya Rabb, je n'ai pas peur du rappel. Fais que je l'accueille comme un ami.`
};

MIROIR["74:52"] = {
  reference: "74:52",
  theme: ["exigence", "miracle", "demande"],
  emotion: "Obstination, déni",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'jizah", "Al-Talab"],
  mirrorVersion: `« Mais chaque homme d'entre eux veut qu'on lui apporte des feuilles déployées. » L'exigence de miracles. Le miroir m'avertit : exiger des miracles pour croire est une excuse. La foi vient du cœur.`,
  reflection: `Exiger des miracles est une excuse. La foi vient du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal yuridu kullu imri'in minhum an yu'ta suhufan munsurah » — mais chaque homme veut qu'on lui apporte des feuilles déployées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'exige pour croire ? Ma foi est-elle conditionnée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi inconditionnelle est la vraie foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout. Il faut des yeux pour voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sans condition reçoit les signes." }
  ],
  munajat: `Ya Rabb, je crois sans condition. Ne permets pas que j'exige des signes.`
};

MIROIR["74:53"] = {
  reference: "74:53",
  theme: ["au-delà", "croyance", "désespoir"],
  emotion: "Questionnement, étonnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Akhirah", "Al-Yaqin"],
  mirrorVersion: `« Non ! Mais ils ne craignent pas l'au-delà. » L'absence de crainte. Le miroir m'enseigne : la crainte de l'au-delà motive la préparation. Son absence mène à la négligence.`,
  reflection: `La crainte de l'au-delà motive. Son absence mène à la négligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla bal la yakhawna al-akhirah » — non ! Mais ils ne craignent pas l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains l'au-delà ? Cette crainte me motive-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte de l'au-delà pousse à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'au-delà est une certitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'au-delà se prépare." }
  ],
  munajat: `Ya Rabb, fais que je craigne l'au-delà. Cette crainte me pousse vers Toi.`
};

MIROIR["74:54"] = {
  reference: "74:54",
  theme: ["Coran", "rappel", "bonté"],
  emotion: "Gratitude, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Tadhkira"],
  mirrorVersion: `« Non ! C'est un rappel. » Le rappel confirmé. Le miroir m'enseigne : le Coran est un rappel, pas une contrainte. C'est une bonté pour celui qui l'accepte.`,
  reflection: `Le Coran est un rappel. C'est une bonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla innahu tadhkiratun » — non ! C'est un rappel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le rappel ? Le Coran est-il ma boussole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel est une bonté. Le refus est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est un rappel pour tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le rappel reçoit la bonté." }
  ],
  munajat: `Ya Rabb, j'accepte Ton rappel. Fais que le Coran soit ma boussole.`
};

MIROIR["74:55"] = {
  reference: "74:55",
  theme: ["volonté", "rappel", "souvenir"],
  emotion: "Choix, liberté",
  difficulty: "débutant",
  relatedNames: ["Al-Murid", "Al-Tadhkira"],
  mirrorVersion: `« Que celui qui le veut se le rappelle. » Le choix est offert. Le miroir m'invite : le rappel est disponible pour celui qui veut. La volonté est la clé.`,
  reflection: `Le rappel est disponible. La volonté est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faman sha'a dhakarahu » — que celui qui le veut se le rappelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux me rappeler ? Ma volonté est-elle tournée vers le rappel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vouloir ouvre. L'indifférence ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rappel est offert à tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut vraiment se rappelle." }
  ],
  munajat: `Ya Rabb, je veux me rappeler. Fais que ma volonté soit tournée vers Ton rappel.`
};

MIROIR["74:56"] = {
  reference: "74:56",
  theme: ["volonté", "Allah", "guidance"],
  emotion: "Humilité, dépendance",
  difficulty: "débutant",
  relatedNames: ["Al-Murid", "Al-Hadi"],
  mirrorVersion: `« Mais ils ne se le rappelleront que si Allah le veut. » La volonté divine prime. Le miroir m'enseigne : même le rappel dépend d'Allah. Nous demandons Sa volonté pour nous guider.`,
  reflection: `Tout dépend d'Allah. Nous demandons Sa volonté pour nous guider.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yadhdhakkaruna illa ma sha'a Allahu » — mais ils ne se le rappelleront que si Allah le veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la volonté d'Allah pour me guider ? Ma dépendance est-elle totale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté d'Allah est la source de tout bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dépend de la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la volonté d'Allah la reçoit." }
  ],
  munajat: `Ya Rabb, je demande Ta volonté pour me rappeler. Guide-moi par Ta volonté.`
};

MIROIR["36:47"] = {
  reference: "36:47",
  theme: ["charité", "ingratitude", "réponse"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["As-Sadaqah", "Al-Infaq"],
  mirrorVersion: `« Et quand on leur dit : 'Dépensez de ce qu'Allah vous a donné.' » Le miroir me montre l'appel à la charité. « Wa idha qila lahum anfiqu mimma razaqakumu Allahu » — et quand on leur dit : dépensez de ce qu'Allah vous a donné. L'appel. « Qala alladhina kafaru lilladhina amanu anut'imu man law yasha'u Allahu at'amahu » — les mécréants disent : nourririons-nous celui qu'Allah aurait pu nourrir ? La réponse. Le miroir m'avertit : la charité est un test de foi.`,
  reflection: `La charité est un devoir pour le croyant. Le refus est un signe de mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahum anfiqu mimma razaqakumu Allahu qala alladhina kafaru lilladhina amanu anut'imu man law yasha'u Allahu at'amahu » — et quand on leur dit : dépensez de ce qu'Allah vous a donné, les mécréants disent aux croyants : nourririons-nous celui qu'Allah aurait pu nourrir ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne de ce qu'Allah m'a donné ? Ou est-ce que je refuse sous prétexte qu'Allah pourrait nourrir les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La charité est un test, pas une option." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers partage ses ressources par la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne de ce qu'Allah lui a donné passe le test." }
  ],
  munajat: `Ya Razzaq, je donne de ce que Tu m'as donné. Ne permets pas que je refuse la charité. Fais que je sois parmi les généreux.`
};

MIROIR["36:48"] = {
  reference: "36:48",
  theme: ["promesse", "question", "moquerie"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Sa'ah"],
  mirrorVersion: `« Et ils disent : 'À quand cette promesse, si vous êtes véridiques ?' » Le miroir me montre la moquerie des mécréants. « Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — et ils disent : à quand cette promesse, si vous êtes véridiques ? La question moqueuse. Le miroir m'avertit : la moquerie de la promesse divine n'empêche pas sa réalisation.`,
  reflection: `La promesse d'Allah est certaine. La moquerie ne fera que précipiter le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — et ils disent : à quand cette promesse, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la promesse d'Allah ? Ou est-ce que je la remets en question ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en la promesse protège du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend la promesse de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la promesse est prêt quand elle arrive." }
  ],
  munajat: `Ya Rabb, je crois en Ta promesse. Ne permets pas que je la remette en question. Prépare-moi pour sa réalisation.`
};

MIROIR["36:49"] = {
  reference: "36:49",
  theme: ["cri", "imprévu", "dispute"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sayha", "Al-Fuja'ah"],
  mirrorVersion: `« Ils n'attendent qu'un seul Cri qui les saisira en pleine dispute. » Le miroir me montre l'imprévu du châtiment. « Ma yanzuruna illa sayhatan wahidatan ta'khudhuhum wa hum yakhtasimun » — ils n'attendent qu'un seul Cri qui les saisira en pleine dispute. L'imprévu. Le miroir m'avertit : le châtiment vient quand on ne s'y attend pas.`,
  reflection: `Le châtiment vient au moment le plus inattendu. La préparation continue est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma yanzuruna illa sayhatan wahidatan ta'khudhuhum wa hum yakhtasimun » — ils n'attendent qu'un seul Cri qui les saisira en pleine dispute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour le cri imprévu ? Ou est-ce que je suis occupé à des disputes futiles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation continue protège de l'imprévu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est toujours prêt pour le commandement de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est toujours prêt n'est pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, je me prépare pour le cri imprévu. Ne permets pas que je sois pris en pleine dispute. Donne-moi la préparation continue.`
};

MIROIR["36:50"] = {
  reference: "36:50",
  theme: ["testament", "retour", "impossibilité"],
  emotion: "Réalité, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Wasiyyah", "Al-Ahl"],
  mirrorVersion: `« Ils ne pourront ni faire de testament, ni retourner dans leurs familles. » Le miroir me montre l'impossibilité du retour. « Fa la yastati'una tawsiyatan wa la ila ahlihim yarji'un » — ils ne pourront ni faire de testament, ni retourner dans leurs familles. La finalité. Le miroir m'avertit : après le cri, il n'y a plus de retour.`,
  reflection: `Le moment du cri est le moment de la finalité. Plus de testament possible, plus de retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa la yastati'una tawsiyatan wa la ila ahlihim yarji'un » — ils ne pourront ni faire de testament, ni retourner dans leurs familles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais mon testament maintenant ? Ou est-ce que j'attends qu'il soit trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le testament maintenant évite le regret de plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de retour après la fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait son testament maintenant est prêt." }
  ],
  munajat: `Ya Rabb, je fais mon testament maintenant. Ne permets pas que je sois pris sans préparation. Donne-moi le temps de me préparer.`
};

MIROIR["36:51"] = {
  reference: "36:51",
  theme: ["trompette", "résurrection", "sortie"],
  emotion: "Espérance et crainte",
  difficulty: "débutant",
  relatedNames: ["As-Sur", "Al-Ba'th"],
  mirrorVersion: `« On soufflera dans la Trompe, et voilà que des tombes ils se précipiteront vers leur Seigneur. » Le miroir me montre la résurrection. « Wa nufikha fi as-suri fa-idha hum mina al-ajdathi ila rabbihim yansilun » — on soufflera dans la Trompe, et voilà que des tombes ils se précipiteront vers leur Seigneur. La résurrection. Le miroir m'invite à me préparer pour ce jour.`,
  reflection: `La trompette annonce la résurrection. Tous sortiront des tombes vers leur Seigneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nufikha fi as-suri fa-idha hum mina al-ajdathi ila rabbihim yansilun » — on soufflera dans la Trompe, et voilà que des tombes ils se précipiteront vers leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour la résurrection ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour la résurrection commence par la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera ressuscité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour la résurrection se précipite vers son Seigneur avec joie." }
  ],
  munajat: `Ya Rabb, je me prépare pour la trompette de la résurrection. Fais que je me précipite vers Toi avec joie. Ne permets pas que je sois parmi les effrayés.`
};

MIROIR["36:52"] = {
  reference: "36:52",
  theme: ["étonnement", "question", "réponse"],
  emotion: "Confusion, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-Wa'd"],
  mirrorVersion: `« Ils diront : 'Malheur à nous ! Qui nous a ressuscités de notre lieu de repos ?' » Le miroir me montre l'étonnement des mécréants. « Qalu ya waylana man ba'athana min mardqina » — ils diront : malheur à nous ! Qui nous a ressuscités de notre lieu de repos ? La confusion. « Hadha ma wa'ada ar-rahman » — c'est ce qu'avait promis le Miséricordieux. La réalité. Le miroir m'invite à croire en la promesse maintenant.`,
  reflection: `Les mécréants sont étonnés de la résurrection. Les croyants savent que c'est la promesse d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya waylana man ba'athana min mardqina hadha ma wa'ada ar-rahman » — ils diront : malheur à nous ! Qui nous a ressuscités de notre lieu de repos ? C'est ce qu'avait promis le Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la promesse de la résurrection ? Ou est-ce que je serai étonné quand elle arrivera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en la promesse évite l'étonnement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera ressuscité par la promesse du Miséricordieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la promesse n'est pas étonné." }
  ],
  munajat: `Ya Rahman, je crois en Ta promesse de résurrection. Ne permets pas que je sois étonné quand elle arrivera. Donne-moi la foi certaine.`
};

MIROIR["36:53"] = {
  reference: "36:53",
  theme: ["cri", "comparution", "facilité"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sayha", "Al-'Ard"],
  mirrorVersion: `« Ce ne fut qu'un seul Cri, et les voilà tous présentés devant Nous. » Le miroir me montre la facilité du rassemblement. « In kanat illa sayhatan wahidatan fa-idha jami'un ladayna muhdarun » — ce ne fut qu'un seul Cri, et les voilà tous présentés devant Nous. La facilité totale. Le miroir m'invite à me préparer pour la présentation.`,
  reflection: `Un seul cri suffit pour rassembler toute l'humanité devant Allah. La présentation est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In kanat illa sayhatan wahidatan fa-idha jami'un ladayna muhdarun » — ce ne fut qu'un seul Cri, et les voilà tous présentés devant Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour la présentation devant Allah ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour la présentation commence maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera présenté devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour la présentation a une bonne comparution." }
  ],
  munajat: `Ya Rabb, je me prépare pour la présentation devant Toi. Donne-moi une bonne comparution. Ne permets pas que je sois parmi les honteux.`
};

MIROIR["36:54"] = {
  reference: "36:54",
  theme: ["justice", "action", "rétribution"],
  emotion: "Espérance et crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Jaza"],
  mirrorVersion: `« Ce jour-là, aucune âme ne sera lésée en rien. » Le miroir me montre la justice parfaite. « Al-yawma la tuzlamu nafsun shay'an » — ce jour-là, aucune âme ne sera lésée en rien. La justice. « Wa la tujzawna illa ma kuntum ta'malun » — et vous ne serez rétribués que pour ce que vous faisiez. La rétribution exacte. Le miroir m'invite à la confiance dans la justice d'Allah.`,
  reflection: `La justice d'Allah est parfaite. Personne n'est lésé. La rétribution est exacte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-yawma la tuzlamu nafsun shay'an wa la tujzawna illa ma kuntum ta'malun » — ce jour-là, aucune âme ne sera lésée en rien. Et vous ne serez rétribués que pour ce que vous faisiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais le bien en espérant la rétribution ? Ou est-ce que je néglige mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice parfaite invite à l'action parfaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reflète la justice parfaite de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien est rétribué avec justice." }
  ],
  munajat: `Ya Adl, Ta justice est parfaite. Je fais le bien en espérant Ta rétribution. Ne me lèse pas dans Ton jugement.`
};

MIROIR["36:55"] = {
  reference: "36:55",
  theme: ["paradis", "occupation", "félicité"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "As-Sa'ah"],
  mirrorVersion: `« Les gens du Paradis sont aujourd'hui occupés à jouir. » Le miroir me montre la félicité du Paradis. « Inna ashaba al-jannati al-yawma fi shughulin fakiuhun » — les gens du Paradis sont aujourd'hui occupés à jouir. L'occupation bienheureuse. Le miroir m'invite à espérer cette félicité.`,
  reflection: `L'occupation au Paradis est la jouissance. Pas de souci, pas de fatigue, seulement la félicité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ashaba al-jannati al-yawma fi shughulin fakiuhun » — les gens du Paradis sont aujourd'hui occupés à jouir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère l'occupation bienheureuse du Paradis ? Ou est-ce que je suis occupé par les soucis du monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'occupation du Paradis est la récompense de l'occupation par le bien dans le monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination de l'univers croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la félicité du Paradis y travaille ici-bas." }
  ],
  munajat: `Ya Rabb, j'espère l'occupation bienheureuse du Paradis. Fais que je sois parmi les gens du Paradis. Donne-moi la félicité éternelle.`
};

MIROIR["36:56"] = {
  reference: "36:56",
  theme: ["épouses", "ombrage", "paradis"],
  emotion: "Espérance, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Azwaj", "Az-Zill"],
  mirrorVersion: `« Eux et leurs épouses sont sous des ombrages, accoudés sur des lits. » Le miroir me montre la compagnie au Paradis. « Hum wa azwajuhum fi zilalin 'ala al-ara'iki muttaki'un » — eux et leurs épouses sont sous des ombrages, accoudés sur des lits. Le confort. Le miroir m'invite à espérer cette compagnie.`,
  reflection: `Le Paradis offre la compagnie des épouses, l'ombrage et le confort. Tout est parfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hum wa azwajuhum fi zilalin 'ala al-ara'iki muttaki'un » — eux et leurs épouses sont sous des ombrages, accoudés sur des lits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la compagnie au Paradis ? Ou est-ce que je néglige cette espérance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compagnie au Paradis est la récompense de la compagnie dans le bien ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est fait de compagnies parfaites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la compagnie du Paradis y prépare ses compagnies." }
  ],
  munajat: `Ya Rabb, j'espère la compagnie au Paradis. Donne-moi l'ombrage et le confort éternel. Fais que je sois parmi les accoudés.`
};

MIROIR["36:57"] = {
  reference: "36:57",
  theme: ["fruits", "désir", "paradis"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fawakih", "Al-Raghbah"],
  mirrorVersion: `« Ils y ont des fruits et ils ont ce qu'ils réclament. » Le miroir me montre la satisfaction complète. « Lahum fiha fakihatun wa lahum ma yadda'un » — ils y ont des fruits et ils ont ce qu'ils réclament. La satisfaction. Le miroir m'invite à espérer cette satisfaction.`,
  reflection: `Au Paradis, tout désir est satisfait. Les fruits et ce qu'on réclame sont disponibles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum fiha fakihatun wa lahum ma yadda'un » — ils y ont des fruits et ils ont ce qu'ils réclament." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la satisfaction complète du Paradis ? Ou est-ce que je cherche satisfaction ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction du Paradis est la récompense de la patience ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la satisfaction complète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la satisfaction du Paradis y travaille." }
  ],
  munajat: `Ya Rabb, j'espère la satisfaction complète du Paradis. Donne-moi les fruits et ce que je réclame. Fais que je sois satisfait.`
};

MIROIR["36:59"] = {
  reference: "36:59",
  theme: ["séparation", "criminels", "jugement"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mujrimun", "Al-Fasl"],
  mirrorVersion: `« Ô criminels ! Séparez-vous aujourd'hui ! » Le miroir me montre la séparation finale. « Wa tumilu al-yawma ayyuha al-mujrimuna » — ô criminels ! Séparez-vous aujourd'hui ! La séparation. Le miroir m'avertit : la séparation des criminels est une réalité.`,
  reflection: `Le jour du Jugement, les criminels sont séparés. Leur sort est différent des croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tumilu al-yawma ayyuha al-mujrimuna » — ô criminels ! Séparez-vous aujourd'hui !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les criminels ? Ou est-ce que je suis parmi les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La séparation des criminels est le sort de ceux qui ont choisi le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera séparé en deux groupes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'est pas criminel n'est pas séparé." }
  ],
  munajat: `Ya Rabb, je ne veux pas être parmi les criminels. Garde-moi parmi les croyants. Ne permets pas que je sois séparé des bons.`
};

MIROIR["36:61"] = {
  reference: "36:61",
  theme: ["adoration", "chemin", "obligation"],
  emotion: "Dévotion, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-'Ibadah", "As-Sirat"],
  mirrorVersion: `« Et que vous M'adoriez. Tel est le chemin droit. » Le miroir me montre l'essence de la religion. « Wa an ta'buduni hadha siratun mustaqim » — et que vous M'adoriez. Tel est le chemin droit. L'adoration comme chemin. Le miroir m'invite à l'adoration sincère.`,
  reflection: `L'adoration d'Allah est le chemin droit. Tout le reste est égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa an ta'buduni hadha siratun mustaqim » — et que vous M'adoriez. Tel est le chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah sincèrement ? Ou est-ce que je suis sur un autre chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah est le but de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers adore son Créateur par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah sincèrement est sur le chemin droit." }
  ],
  munajat: `Ya Ma'bud, je T'adore Toi seul. C'est le chemin droit. Garde-moi sur ce chemin. Ne permets pas que je dévie.`
};

MIROIR["36:62"] = {
  reference: "36:62",
  theme: ["satan", "égarement", "multitude"],
  emotion: "Mise en garde, vigilance",
  difficulty: "débutant",
  relatedNames: ["Ash-Shaytan", "Ad-Dalal"],
  mirrorVersion: `« Il a certes égaré beaucoup de gens parmi vous. » Le miroir me montre le danger de Satan. « Laqad adalla minkum jibillan kathira » — il a certes égaré beaucoup de gens parmi vous. L'égarement massif. Le miroir m'avertit : Satan est un ennemi puissant.`,
  reflection: `Satan a égaré beaucoup de gens. La vigilance est nécessaire pour ne pas être parmi eux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad adalla minkum jibillan kathira » — il a certes égaré beaucoup de gens parmi vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vigilant contre Satan ? Ou est-ce que je suis parmi les égarés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance contre Satan protège de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas égaré par Satan." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vigilant contre Satan n'est pas égaré." }
  ],
  munajat: `Ya Rabb, je suis vigilant contre Satan. Protège-moi de son égarement. Ne permets pas que je sois parmi la multitude égarée.`
};

MIROIR["36:63"] = {
  reference: "36:63",
  theme: ["enfer", "promesse", "réalité"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Jahannam", "Al-Wa'd"],
  mirrorVersion: `« Voici l'Enfer qu'on vous promettait. » Le miroir me montre la réalité de l'Enfer. « Tihhi jahannamu allati kuntum tu'adun » — voici l'Enfer qu'on vous promettait. La réalité. Le miroir m'avertit : l'Enfer est une réalité.`,
  reflection: `L'Enfer n'est pas une fiction. C'est une réalité promise aux mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tihhi jahannamu allati kuntum tu'adun » — voici l'Enfer qu'on vous promettait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains l'Enfer ? Ou est-ce que je le considère comme une fiction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte de l'Enfer mène à la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est une réalité cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer s'en protège." }
  ],
  munajat: `Ya Rabb, je crains l'Enfer. Protège-moi de cette réalité. Ne permets pas que je l'entre. Garde-moi dans Ta miséricorde.`
};

MIROIR["36:64"] = {
  reference: "36:64",
  theme: ["brûlure", "mécréance", "châtiment"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Harq", "Al-Kufr"],
  mirrorVersion: `« Brûlez-y aujourd'hui pour avoir mécru. » Le miroir me montre la cause du châtiment. « Aslau al-yawma bima kuntum takfurun » — brûlez-y aujourd'hui pour avoir mécru. La cause. Le miroir m'avertit : la mécréance est la cause du châtiment.`,
  reflection: `La mécréance mène au feu. La foi mène au Paradis. Le choix est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aslau al-yawma bima kuntum takfurun » — brûlez-y aujourd'hui pour avoir mécru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mécru ? Ou est-ce que je crois ? Le châtiment est pour les mécréants." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi protège de la brûlure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne brûle pas pour ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit n'est pas brûlé." }
  ],
  munajat: `Ya Rabb, je crois en Toi. Ne permets pas que je sois brûlé pour la mécréance. Garde-moi dans la foi.`
};

MIROIR["36:65"] = {
  reference: "36:65",
  theme: ["parole", "mains", "témoignage"],
  emotion: "Crainte, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nutq", "Ash-Shahadah"],
  mirrorVersion: `« Ce jour-là, Nous scellerons leurs bouches, et leurs mains Nous parleront. » Le miroir me montre le témoignage des membres. « Al-yawma nakhtimu 'ala afwahihim » — ce jour-là, Nous scellerons leurs bouches. Le silence. « Wa tukallimuna aydihim » — et leurs mains parleront. Le témoignage. Le miroir m'avertit : les actions témoignent.`,
  reflection: `Les mains témoignent des actions. Rien ne peut être caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-yawma nakhtimu 'ala afwahihim wa tukallimuna aydihim » — ce jour-là, Nous scellerons leurs bouches, et leurs mains Nous parleront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mes mains diraient de mes actions ? Sont-elles témoins de bien ou de mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les mains qui font le bien témoignent pour leur propriétaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont les mains font le bien a de bons témoins." }
  ],
  munajat: `Ya Rabb, fais que mes mains soient témoins de bien. Ne permets pas qu'elles témoignent contre moi. Donne-moi des actions pures.`
};

MIROIR["36:66"] = {
  reference: "36:66",
  theme: ["vue", "aveuglement", "pouvoir"],
  emotion: "Crainte, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Basar", "Al-A'ma"],
  mirrorVersion: `« Si Nous voulions, Nous leur ôterions la vue. » Le miroir me montre le pouvoir absolu d'Allah. « Wa law nasha'u la-tamasna 'ala a'yunihim » — si Nous voulions, Nous leur ôterions la vue. Le pouvoir. « Fa-stabaqu as-sirata » — et ils se précipiteraient sur le chemin. La conséquence. Le miroir m'invite à la gratitude pour la vue.`,
  reflection: `La vue est un don d'Allah. Il peut la retirer à tout moment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law nasha'u la-tamasna 'ala a'yunihim fa-stabaqu as-sirata » — si Nous voulions, Nous leur ôterions la vue, et ils se précipiteraient sur le chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour ma vue ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vue physique est un don, la vue spirituelle est plus précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers voit par la lumière de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la vue reçoit la vue spirituelle." }
  ],
  munajat: `Ya Rabb, merci pour ma vue. Ne la retire pas. Donne-moi aussi la vue spirituelle. Fais que je voie avec le cœur.`
};

MIROIR["36:67"] = {
  reference: "36:67",
  theme: ["transformation", "immobilité", "pouvoir"],
  emotion: "Crainte, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Masakh", "Al-Qadar"],
  mirrorVersion: `« Si Nous voulions, Nous les transformerions en statues. » Le miroir me montre le pouvoir de transformation. « Wa law nasha'u la-masakhnahum 'ala makanatihim » — si Nous voulions, Nous les transformerions en statues sur place. La transformation. Le miroir m'invite à la reconnaissance du pouvoir d'Allah.`,
  reflection: `Allah peut transformer les gens en statues. Son pouvoir est absolu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law nasha'u la-masakhnahum 'ala makanatihim » — si Nous voulions, Nous les transformerions en statues sur place." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le pouvoir absolu d'Allah ? Ou est-ce que je le limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance du pouvoir d'Allah mène à la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est transformé par la volonté de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le pouvoir d'Allah se soumet avec joie." }
  ],
  munajat: `Ya Qadir, je reconnais Ton pouvoir absolu. Transforme mon cœur vers le bien. Ne permets pas que je sois transformé en punition.`
};

MIROIR["36:68"] = {
  reference: "36:68",
  theme: ["vieillesse", "faiblesse", "retour"],
  emotion: "Réflexion, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Shaykh", "Al-Ajal"],
  mirrorVersion: `« Celui que Nous vieillissons, Nous le ramenons à la faiblesse. » Le miroir me montre le cycle de la vie. « Wa man nu'ammirhu nunakkishu fi al-khalq » — celui que Nous vieillissons, Nous le ramenons à la faiblesse. Le retour à l'enfance. Le miroir m'invite à méditer sur le cycle de la vie.`,
  reflection: `La vieillesse ramène à la faiblesse. C'est un rappel de la dépendance totale envers Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man nu'ammirhu nunakkishu fi al-khalq » — celui que Nous vieillissons, Nous le ramenons à la faiblesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur la vieillesse qui vient ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse de la vieillesse est un rappel de la dépendance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers vieillit et retourne à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la vieillesse se prépare." }
  ],
  munajat: `Ya Rabb, je médite sur la vieillesse qui vient. Prépare-moi pour ce retour à la faiblesse. Garde-moi dépendant de Toi.`
};

MIROIR["36:69"] = {
  reference: "36:69",
  theme: ["poésie", "coran", "sagesse"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shi'r", "Al-Qur'an"],
  mirrorVersion: `« Nous ne lui avons pas enseigné la poésie. » Le miroir me montre la distinction entre poésie et révélation. « Wa ma 'allamnahu ash-shi'ra » — Nous ne lui avons pas enseigné la poésie. La distinction. « Wa ma yanbaghi lahu » — et cela ne lui sied pas. L'incompatibilité. Le miroir m'invite à reconnaître la nature du Coran.`,
  reflection: `Le Coran n'est pas de la poésie. C'est la parole d'Allah, pleine de sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma 'allamnahu ash-shi'ra wa ma yanbaghi lahu » — Nous ne lui avons pas enseigné la poésie, et cela ne lui sied pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le Coran comme parole d'Allah ? Ou est-ce que je le considère comme de la poésie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est au-dessus de la poésie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reconnaît la parole de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Coran comme parole d'Allah est guidé." }
  ],
  munajat: `Ya Rabb, je reconnais le Coran comme Ta parole. Ce n'est pas de la poésie. Guide-moi par Sa sagesse.`
};

MIROIR["36:71"] = {
  reference: "36:71",
  theme: ["bétail", "provision", "domination"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-An'am", "At-Taskhir"],
  mirrorVersion: `« Ne voient-ils pas que parmi ce que Nos mains ont créé, Nous avons créé pour eux des bestiaux ? » Le miroir me montre la provision du bétail. « Awa lam yaraw anna khalaqna lahum mimma 'amilat aydina an'aman » — ne voient-ils pas que parmi ce que Nos mains ont créé, Nous avons créé pour eux des bestiaux ? La provision. Le miroir m'invite à la gratitude pour le bétail.`,
  reflection: `Les bestiaux sont créés pour nous. Ils sont une provision d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa lam yaraw anna khalaqna lahum mimma 'amilat aydina an'aman » — ne voient-ils pas que parmi ce que Nos mains ont créé, Nous avons créé pour eux des bestiaux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les bestiaux ? Ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bestiaux sont une provision qui mérite gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est pourvu de provisions pour l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour les bestiaux reconnaît la provision d'Allah." }
  ],
  munajat: `Ya Razzaq, merci pour les bestiaux que Tu as créés pour nous. Je suis reconnaissant pour cette provision. Continue à pourvoir à mes besoins.`
};

MIROIR["36:72"] = {
  reference: "36:72",
  theme: ["soumission", "monture", "provision"],
  emotion: "Gratitude, utilité",
  difficulty: "débutant",
  relatedNames: ["At-Taskhir", "Al-Rikab"],
  mirrorVersion: `« Et Nous les leur avons soumis : certains leur servent de monture, d'autres de nourriture. » Le miroir me montre la soumission du bétail. « Fa-dhallalnaha lahum fa-minha rakubuhum wa minha ya'kulun » — et Nous les leur avons soumis : certains leur servent de monture, d'autres de nourriture. La double utilité. Le miroir m'invite à la gratitude pour cette soumission.`,
  reflection: `Le bétail est soumis pour la monture et la nourriture. Double provision d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-dhallalnaha lahum fa-minha rakubuhum wa minha ya'kulun » — et Nous les leur avons soumis : certains leur servent de monture, d'autres de nourriture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la monture et la nourriture ? Ou est-ce que je les oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission du bétail est un don qui mérite gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est soumis pour le service de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la soumission reçoit plus." }
  ],
  munajat: `Ya Rabb, merci pour la soumission du bétail. Je suis reconnaissant pour la monture et la nourriture. Continue Tes bienfaits.`
};

MIROIR["36:73"] = {
  reference: "36:73",
  theme: ["bienfait", "boisson", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Ash-Shurb"],
  mirrorVersion: `« Ils en retirent des profits et des boissons. » Le miroir me montre les multiples bienfaits. « Wa lahum fiha manafi'u wa mashariban » — ils en retirent des profits et des boissons. Les multiples bienfaits. Le miroir m'invite à la gratitude pour ces multiples dons.`,
  reflection: `Du bétail viennent les profits et les boissons. Les bienfaits sont multiples.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lahum fiha manafi'u wa mashariban » — ils en retirent des profits et des boissons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les multiples bienfaits ? Ou est-ce que je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque bienfait mérite gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers regorge de bienfaits multiples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour chaque bienfait reçoit plus." }
  ],
  munajat: `Ya Mannan, merci pour les multiples bienfaits. Je suis reconnaissant pour les profits et les boissons. Augmente ma gratitude.`
};

MIROIR["36:74"] = {
  reference: "36:74",
  theme: ["idolâtrie", "secours", "erreur"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Asnam", "An-Nasr"],
  mirrorVersion: `« Ils ont pris des divinités en dehors d'Allah, espérant être secourus. » Le miroir me montre l'espoir déplacé. « Wattakhadhu min duni Allahi alihatan li'llahum yunsarun » — ils ont pris des divinités en dehors d'Allah, espérant être secourus. L'espoir erroné. Le miroir m'avertit : l'espoir de secours doit être en Allah seul.`,
  reflection: `Les idoles ne peuvent secourir. Seul Allah peut aider.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wattakhadhu min duni Allahi alihatan li'llahum yunsarun » — ils ont pris des divinités en dehors d'Allah, espérant être secourus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche le secours ? En Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secours d'Allah est le seul vrai secours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers cherche le secours auprès de son Créateur seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le secours auprès d'Allah est secouru." }
  ],
  munajat: `Ya Nâsir, je cherche le secours auprès de Toi seul. Ne permets pas que je cherche le secours ailleurs. Secours-moi dans toutes mes épreuves.`
};

MIROIR["36:75"] = {
  reference: "36:75",
  theme: ["impuissance", "idolâtrie", "rejet"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ajz", "Al-Kufr"],
  mirrorVersion: `« Ces divinités ne pourront pas les secourir, et elles formeront contre eux une armée. » Le miroir me montre l'impuissance des idoles. « La yastati'unahum nasran » — ces divinités ne pourront pas les secourir. L'impuissance. « Wa hum lahum jundun muhdarun » — et elles formeront contre eux une armée. Le retournement. Le miroir m'avertit : les idoles se retournent contre leurs adorateurs.`,
  reflection: `Les idoles non seulement ne secourent pas, mais se retournent contre leurs adorateurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yastati'unahum nasran wa hum lahum jundun muhdarun » — ces divinités ne pourront pas les secourir, et elles formeront contre eux une armée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore qui ne peut me secourir ? Suis-je en train de former une armée contre moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Seul Allah peut secourir sans se retourner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se retourne pas contre ceux qui adorent leur Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul n'a pas d'ennemi parmi ses adorations." }
  ],
  munajat: `Ya Rabb, je n'adore que Toi. Ne permets pas que mes adorations se retournent contre moi. Protège-moi de l'impuissance des idoles.`
};

MIROIR["36:76"] = {
  reference: "36:76",
  theme: ["parole", "chagrin", "protection"],
  emotion: "Réconfort, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Qawl", "Al-Hazan"],
  mirrorVersion: `« Que leur parole ne t'afflige pas. » Le miroir me montre le réconfort divin. « Fala yahzunka qawluhum » — que leur parole ne t'afflige pas. Le réconfort. « Inna na'lamu ma yusirruna wa ma yu'linun » — Nous savons ce qu'ils cachent et ce qu'ils divulguent. La connaissance. Le miroir m'invite à la confiance en la connaissance d'Allah.`,
  reflection: `Les paroles des mécréants ne doivent pas affliger. Allah connaît tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fala yahzunka qawluhum inna na'lamu ma yusirruna wa ma yu'linun » — que leur parole ne t'afflige pas. Nous savons ce qu'ils cachent et ce qu'ils divulguent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que les paroles des autres m'affligent ? Ou est-ce que je fais confiance à la connaissance d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en la connaissance d'Allah apaise le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas affligé par les paroles des hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la connaissance d'Allah n'est pas affligé." }
  ],
  munajat: `Ya Alim, je fais confiance à Ta connaissance. Ne permets pas que les paroles des autres m'affligent. Apaise mon cœur par Ta connaissance.`
};

MIROIR["36:77"] = {
  reference: "36:77",
  theme: ["création", "ingratitude", "homme"],
  emotion: "Réflexion, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Insan", "Al-Kufr"],
  mirrorVersion: `« L'homme ne voit-il pas que Nous l'avons créé d'une goutte ? » Le miroir me montre l'origine humble. « Awa lam yara al-insanu anna khalaqnahu min nutfatin » — l'homme ne voit-il pas que Nous l'avons créé d'une goutte ? L'origine. « Fa-idha huwa khasimun mubin » — et le voilà un adversaire déclaré ! L'ingratitude. Le miroir m'avertit : l'homme oublie son origine et devient adversaire.`,
  reflection: `L'homme créé d'une goutte devient adversaire déclaré. L'ingratitude est le résultat de l'oubli de l'origine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa lam yara al-insanu anna khalaqnahu min nutfatin fa-idha huwa khasimun mubin » — l'homme ne voit-il pas que Nous l'avons créé d'une goutte ? Et le voilà un adversaire déclaré !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine humble ? Ou est-ce que je deviens adversaire par orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souvenir de l'origine humble empêche l'adversité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne devient pas adversaire de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de son origine reste humble et reconnaissant." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'une goutte. Je me souviens de mon origine humble. Garde-moi reconnaissant et non adversaire.`
};

MIROIR["36:78"] = {
  reference: "36:78",
  theme: ["parabole", "oubli", "création"],
  emotion: "Réflexion, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mathal", "An-Nasyan"],
  mirrorVersion: `« Il Nous cite une parabole, et il oublie sa propre création. » Le miroir me montre l'oubli de l'homme. « Wa daraba lana mathalan wa nasiya khalqahu » — il Nous cite une parabole, et il oublie sa propre création. L'oubli. Le miroir m'avertit : l'oubli de la création mène à l'erreur.`,
  reflection: `L'homme oublie sa propre création et cite des paraboles erronées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa daraba lana mathalan wa nasiya khalqahu » — il Nous cite une parabole, et il oublie sa propre création." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'oublie ma création ? Ou est-ce que je m'en souviens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souvenir de la création empêche l'erreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'oublie pas sa création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de sa création ne cite pas de paraboles erronées." }
  ],
  munajat: `Ya Rabb, je me souviens de ma création. Ne permets pas que je l'oublie. Garde-moi dans le souvenir de mon origine.`
};

MIROIR["36:79"] = {
  reference: "36:79",
  theme: ["résurrection", "ossements", "pouvoir"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-'Izam"],
  mirrorVersion: `« Dis : 'Celui qui les a créés la première fois leur redonnera la vie.' » Le miroir me montre le pouvoir de la résurrection. « Qul yuhyiha alladhi ansha'aha awwala marratin » — dis : Celui qui les a créés la première fois leur redonnera la vie. La création est preuve de résurrection. Le miroir m'invite à la confiance en la résurrection.`,
  reflection: `La première création est preuve de la résurrection. Celui qui a créé peut recréer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul yuhyiha alladhi ansha'aha awwala marratin » — dis : Celui qui les a créés la première fois leur redonnera la vie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la résurrection basée sur la création ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création est la preuve de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera ressuscité par Celui qui l'a créé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la création croit en la résurrection." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé et Tu me ressusciteras. Je crois en Ta puissance de résurrection. Prépare-moi pour ce jour.`
};

MIROIR["36:80"] = {
  reference: "36:80",
  theme: ["feu", "arbre", "pouvoir"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Ash-Shajar"],
  mirrorVersion: `« Celui qui a fait du feu pour vous, de l'arbre vert. » Le miroir me montre la création du feu. « Alladhi ja'ala lakum mina ash-shajari al-akhdari naran » — celui qui a fait du feu pour vous, de l'arbre vert. La création du feu. Le miroir m'invite à la reconnaissance du pouvoir créateur.`,
  reflection: `Le feu vient de l'arbre vert. La création est pleine de merveilles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi ja'ala lakum mina ash-shajari al-akhdari naran » — celui qui a fait du feu pour vous, de l'arbre vert." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les merveilles de la création ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque merveille de la création est un signe du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de merveilles créatives." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les merveilles de la création reconnaît le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu as créé le feu de l'arbre vert. Je reconnais Tes merveilles. Ouvre mes yeux sur les signes de Ta création.`
};

MIROIR["36:81"] = {
  reference: "36:81",
  theme: ["création", "pouvoir", "facilité"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Qadar"],
  mirrorVersion: `« Celui qui a créé les cieux et la terre est capable de créer leur semblable. » Le miroir me montre la facilité de la création. « Awa laysa alladhi khalaqa as-samawati wa al-arda bi-qadirin 'ala an yakhluqa mithlahum » — celui qui a créé les cieux et la terre est capable de créer leur semblable. La facilité. Le miroir m'invite à la confiance en la puissance d'Allah.`,
  reflection: `Celui qui a créé les cieux et la terre peut facilement recréer. Rien n'est difficile pour Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa laysa alladhi khalaqa as-samawati wa al-arda bi-qadirin 'ala an yakhluqa mithlahum » — celui qui a créé les cieux et la terre est capable de créer leur semblable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la puissance d'Allah ? Ou est-ce que je la limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance d'Allah est illimitée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut être recréé par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la puissance d'Allah a une foi complète." }
  ],
  munajat: `Ya Qadir, Tu as créé les cieux et la terre. Je fais confiance à Ta puissance illimitée. Rien n'est difficile pour Toi.`
};

MIROIR["36:83"] = {
  reference: "36:83",
  theme: ["gloire", "main", "retour"],
  emotion: "Glorification, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Majd", "Al-Yad"],
  mirrorVersion: `« Gloire à Celui qui détient toute la royauté ! » Le miroir me montre la glorification finale. « Fa-subhana alladhi bi-yadihi malakutu kulli shay'in » — gloire à Celui qui détient toute la royauté ! La glorification. « Wa ilayhi turja'un » — et vers Lui vous serez ramenés. Le retour. Le miroir m'invite à la glorification et à la préparation pour le retour.`,
  reflection: `La royauté est entre les mains d'Allah. Vers Lui est le retour final.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-subhana alladhi bi-yadihi malakutu kulli shay'in wa ilayhi turja'un » — gloire à Celui qui détient toute la royauté ! Et vers Lui vous serez ramenés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Celui qui détient la royauté ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification d'Allah prépare au retour vers Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers retourne vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah est prêt pour le retour." }
  ],
  munajat: `Ya Malik, gloire à Toi qui détiens toute la royauté ! Je me prépare pour le retour vers Toi. Accueille-moi avec miséricorde.`
};

// ==================== SURAH 75: AL-QIYAMAH - MISSING VERSES ====================

MIROIR["75:2"] = {
  reference: "75:2",
  theme: ["âme", "reproche", "conscience"],
  emotion: "Introspection, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Nafs", "Al-Lawwamah"],
  mirrorVersion: `« Non ! Je jure par l'âme qui se blâme. » Le serment par l'âme qui se blâme. Le miroir m'enseigne : l'âme a une conscience. Elle se blâme quand elle fait le mal. Cette conscience est un guide.`,
  reflection: `L'âme qui se blâme est un guide intérieur. L'écouter est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la uqsimu bi-al-nafsi al-lawwamah » — et je jure par l'âme qui se blâme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute mon âme qui se blâme ? La conscience est-elle mon guide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'âme qui se blâme appelle au repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La conscience est le guide intérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute son âme se repent." }
  ],
  munajat: `Ya Rabb, fais que j'écoute mon âme qui se blâme. Guide-moi vers le repentir.`
};

MIROIR["75:3"] = {
  reference: "75:3",
  theme: ["création", "os", "résurrection"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Ba'th"],
  mirrorVersion: `« L'homme pense-t-il que Nous ne rassemblerons pas ses os ? » Le doute sur la résurrection. Le miroir m'enseigne : Allah qui a créé les os peut les rassembler. La résurrection est certaine.`,
  reflection: `Allah qui a créé peut recréer. La résurrection est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-yahsabu al-insanu allan najma'a izamah » — l'homme pense-t-il que Nous ne rassemblerons pas ses os ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute de la résurrection ? Ma confiance en Allah est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui croit en la création croit en la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création témoigne du pouvoir de recréer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection se prépare." }
  ],
  munajat: `Ya Khaliq, je crois en Ta puissance. La résurrection est certaine. Aide-moi à me préparer.`
};

MIROIR["75:4"] = {
  reference: "75:4",
  theme: ["création", "doigts", "perfection"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Mais Nous sommes capable de remettre en ordre ses doigts. » Le détail de la création. Le miroir m'enseigne : Allah peut recréer les détails les plus fins. Les doigts témoignent de la précision divine.`,
  reflection: `Allah peut recréer les détails les plus fins. Rien n'est impossible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bala qadirina 'ala an nusawwiya bananah » — mais Nous sommes capable de remettre en ordre ses doigts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la précision de la création ? Ma confiance est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détail témoigne de la puissance globale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque détail de la création est parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les détails croit en la puissance." }
  ],
  munajat: `Ya Musawwir, Ta création est parfaite. Je crois en Ta puissance de recréer.`
};

MIROIR["75:5"] = {
  reference: "75:5",
  theme: ["désir", "corruption", "report"],
  emotion: "Avertissement, réalisation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Murid", "Al-Fasad"],
  mirrorVersion: `« Mais l'homme désire continuer à pécher devant lui. » Le désir de continuer. Le miroir m'avertit : l'homme veut continuer dans le péché. Le report du repentir est une erreur.`,
  reflection: `Le désir de continuer dans le péché est une erreur. Le repentir doit être immédiat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal yuridu al-insanu li-yafjura amamah » — mais l'homme désire continuer à pécher devant lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire continuer dans le péché ? Ou est-ce que je me repens maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir immédiat est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps du repentir est maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent maintenant est sauvé." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que je désire continuer dans le péché.`
};

MIROIR["75:6"] = {
  reference: "75:6",
  theme: ["jour", "question", "doute"],
  emotion: "Questionnement, impatience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sa'ah", "Al-Yawm"],
  mirrorVersion: `« Il demande : Quand est le Jour de la Résurrection ? » La question du quand. Le miroir m'enseigne : demander le quand est souvent un doute. L'important est d'être prêt, pas de savoir quand.`,
  reflection: `L'important est d'être prêt, pas de savoir quand.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'aluna ayyana yawmu al-qiyamah » — il demande : quand est le Jour de la Résurrection ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande le quand ? Ou est-ce que je me prépare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation est plus importante que le quand." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour vient certainement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt n'a pas besoin du quand." }
  ],
  munajat: `Ya Rabb, je ne demande pas le quand. Je me prépare. Fais que je sois prêt.`
};

MIROIR["75:7"] = {
  reference: "75:7",
  theme: ["vision", "regard", "jour"],
  emotion: "Tremblement, réalisation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basar", "Al-Sa'ah"],
  mirrorVersion: `« Quand la vision sera éblouissante. » Le regard ébloui. Le miroir m'enseigne : le Jour sera tel que les regards seront éblouis. La réalité dépassera l'imagination.`,
  reflection: `Le Jour sera tel que les regards seront éblouis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza barraqa al-absar » — quand la vision sera éblouissante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'imagine ce Jour ? Ma préparation est-elle à la hauteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éblouissement révèle la grandeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour dépasse toute imagination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare accueille l'éblouissement." }
  ],
  munajat: `Ya Rabb, aide-moi à me préparer pour ce Jour éblouissant.`
};

MIROIR["75:8"] = {
  reference: "75:8",
  theme: ["lune", "éclipse", "jour"],
  emotion: "Tremblement, awe",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qamar", "Al-Sa'ah"],
  mirrorVersion: `« Et que la lune sera éclipsée. » L'éclipse de la lune. Le miroir m'enseigne : même la lune sera affectée. Les repères célestes changeront. Tout sera bouleversé.`,
  reflection: `Même les repères célestes changeront. Tout sera bouleversé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa khusifa al-qamar » — et que la lune sera éclipsée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise le bouleversement cosmique ? Ma préparation est-elle sérieuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bouleversement révèle la puissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux témoigneront de la grandeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le bouleversement se prépare." }
  ],
  munajat: `Ya Rabb, je réalise le bouleversement. Aide-moi à me préparer.`
};

