    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la pureté comme don la reçoit intacte." }
  ],
  munajat: `Ya Mannan, la pureté est un bienfait. Fais que je la reconnaisse. Purifie mon cœur et garde-le pur.`
};

MIROIR["55:76"] = {
  reference: "55:76",
  theme: ["paradis", "repos", "coussins"],
  emotion: "Sérénité, repos",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Ar-Rahim"],
  mirrorVersion: `« Ils seront accoudés sur des coussins verts et de beaux tapis. » Le miroir me montre le repos parfait. « Muttaki'ina 'ala rafrafi khudrin wa 'abqariyyin hasan » — accoudés sur des coussins verts et des tapis magnifiques.`,
  reflection: `Le repos du Paradis est décrit avec des images de confort et de beauté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muttaki'ina 'ala rafrafi khudrin wa 'abqariyyin hasan » — ils seront accoudés sur des coussins verts et de beaux tapis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel repos je désire ? Est-ce que j'imagine le repos du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos du Paradis vient du repos du cœur ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repos parfait n'existe que dans la demeure parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve le repos en Allah reçoit le repos éternel." }
  ],
  munajat: `Ya Salam, Tu offres le repos parfait. Donne-moi de me reposer en Toi. Fais que je trouve le repos éternel.`
};

MIROIR["55:77"] = {
  reference: "55:77",
  theme: ["faveur", "question", "répétition"],
  emotion: "Gratitude, interrogation",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mannan"],
  mirrorVersion: `« Lequel des bienfaits de votre Seigneur nierez-vous ? » La question suit le repos parfait. Le repos éternel est un bienfait.`,
  reflection: `Le repos et le confort sont des bienfaits. La sérénité parfaite est une grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabi-ayyi ala'i rabbikuma tukadhdhiban » — Lequel des bienfaits de votre Seigneur nierez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le repos comme un bienfait d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos reçu vient de la tranquillité offerte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout repos est un don du Pacificateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le repos comme don le reçoit éternellement." }
  ],
  munajat: `Ya Mannan, le repos est un bienfait. Fais que je le reconnaisse. Donne-moi le repos du Paradis.`
};

MIROIR["55:78"] = {
  reference: "55:78",
  theme: ["noms divins", "bénédiction", "majesté"],
  emotion: "Révérence, louange",
  difficulty: "débutant",
  relatedNames: ["Allah", "Ar-Rahman", "Dhul-Jalal wal-Ikram"],
  mirrorVersion: `« Béni soit le Nom de ton Seigneur, plein de Majesté et de Munificence ! » Le miroir s'achève sur la louange. « Tabaraka ismu rabbika dhi al-jalali wa al-ikram » — béni soit le Nom de ton Seigneur, Possesseur de Majesté et de Générosité. La sourate se termine par la glorification.`,
  reflection: `La sourate Ar-Rahman s'achève par la bénédiction du Nom divin. La majesté et la générosité sont les attributs finals.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tabaraka ismu rabbika dhi al-jalali wa al-ikram » — béni soit le Nom de ton Seigneur, plein de Majesté et de Munificence !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je bénis le Nom de mon Seigneur ? Est-ce que je Le glorifie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bénédiction du Nom vient à celui qui Le prononce avec amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création bénit le Nom du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui bénit le Nom est béni par Lui." }
  ],
  munajat: `Ya Dhal-Jalal wal-Ikram, Ton Nom est béni. Glorifié sois-Tu. Fais que je Te bénisse et que je sois béni.`
};

MIROIR["56:2"] = {
  reference: "56:2",
  theme: ["jour dernier", "inévitable", "certitude"],
  emotion: "Révérence, awe",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Qahhar"],
  mirrorVersion: `« Nul ne traitera son avènement de mensonge. » Le miroir me place devant l'inévitable. « La mukadhdhibatun waqa'iha » — nul ne peut nier son arrivée. Ce jour vient, c'est certain. Le miroir m'invite à la préparation.`,
  reflection: `L'Heure est certaine. Nul ne peut la fuir ni la nier. La préparation est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La mukadhdhibatun waqa'iha » — nul ne traitera son avènement de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si ce jour était certain ? Ou est-ce que je vis dans le déni ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude du Jour fait la valeur de chaque jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers tend vers sa fin. Le Jour Final est l'accomplissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec le Jour dans le cœur vit chaque jour pleinement." }
  ],
  munajat: `Ya Haqq, le Jour vient certainement. Prépare mon cœur. Fais que je vive pour ce jour.`
};

MIROIR["56:3"] = {
  reference: "56:3",
  theme: ["jour dernier", "abaissement", "élévation"],
  emotion: "Humilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Khafid", "Ar-Rafi'"],
  mirrorVersion: `« Il abaissera et élèvera. » Le miroir me montre la grande inversion. « Khafidatun rafi'a » — abaissant, élevant. Les positions seront renversées. Les hauts seront bas, les bas seront hauts.`,
  reflection: `Le Jour Final inverse les positions. L'humble sera élevé, l'arrogant sera abaissé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khafidatun rafi'a » — il abaissera et élèvera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je dans une position que je mérite ? Est-ce que je m'abaisse pour être élevé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "S'abaisser maintenant, c'est s'élever alors. S'élever maintenant, c'est s'abaisser alors." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi de l'inversion gouverne le Jour Dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'abaisse sincèrement est déjà élevé aux yeux d'Allah." }
  ],
  munajat: `Ya Khafid, ya Rafi', Tu abaisses et Tu élèves. Aide-moi à m'abaisser maintenant pour être élevé alors. Ne me laisse pas m'élever pour être abaissé.`
};

MIROIR["56:4"] = {
  reference: "56:4",
  theme: ["jour dernier", "terre", "tremblement"],
  emotion: "Awe, tremblement",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Azim"],
  mirrorVersion: `« Quand la terre sera secouée d'une secousse violente. » Le miroir me montre le cosmos ébranlé. « Idha ruljatu al-ardu rajjan » — quand la terre sera violemment secouée. La création tremble devant son Créateur.`,
  reflection: `La terre stable deviendra instable. Les montagnes s'écrouleront. Rien ne restera sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha ruljatu al-ardu rajjan » — quand la terre sera secouée d'une secousse violente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je compte ? Qu'est-ce qui est stable dans ma vie ? Le tremblement révèle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stabilité du monde est illusion. Seul Allah est stable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création tremblera devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur tremble maintenant ne tremblera pas alors." }
  ],
  munajat: `Ya Qahhar, la terre tremblera. Fais que mon cœur tremble devant Toi maintenant. Donne-moi la stabilité en Toi.`
};

MIROIR["56:5"] = {
  reference: "56:5",
  theme: ["jour dernier", "montagnes", "réduction"],
  emotion: "Awe, petitesse",
  difficulty: "débutant",
  relatedNames: ["Al-Mutakabbir", "Al-Jalil"],
  mirrorVersion: `« Et que les montagnes seront réduites en miettes. » Le miroir me montre les montagnes pulvérisées. « Wa busati al-jibalu bassan » — les montagnes deviendront de la poussière éparpillée. La solidité devient fragilité.`,
  reflection: `Les montagnes, symboles de permanence, seront réduites en poussière. Rien n'est permanent sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa busati al-jibalu bassan » — et que les montagnes seront réduites en miettes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme montagne dans ma vie ? Qu'est-ce qui s'effondrera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La montagne qui s'effondre révèle Celui qui ne s'effondre pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont des cailloux devant la puissance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'appuie sur la Montagne véritable ne craint pas les montagnes qui s'effondrent." }
  ],
  munajat: `Ya Jalil, les montagnes s'effondrent devant Toi. Fais que je m'appuie sur Toi seul. Sois ma montagne inébranlable.`
};

MIROIR["56:6"] = {
  reference: "56:6",
  theme: ["jour dernier", "poussière", "dispersion"],
  emotion: "Petitesse, insignifiance",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Malik"],
  mirrorVersion: `« Et qu'elles deviendront poussière éparpillée. » Le miroir me montre la dispersion finale. « Fa-kana haba'an mumbathan » — elles deviendront poussière dispersée. La forme retourne au sans-forme.`,
  reflection: `La matière retourne à la poussière. La forme retourne au néant. Seul reste l'Éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kana haba'an mumbathan » — et qu'elles deviendront poussière éparpillée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui reste de mes efforts ? Qu'est-ce qui ne devient pas poussière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poussière de ce monde devient la fondation de l'autre monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute forme retourne au sans-forme, puis à la Forme nouvelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui devient poussière pour Allah renaît éternel en Lui." }
  ],
  munajat: `Ya Qadir, tout retourne à la poussière. Fais que ce qui reste de moi soit pour Toi. Garde-moi dans l'éternel.`
};

MIROIR["56:7"] = {
  reference: "56:7",
  theme: ["jour dernier", "groupes", "division"],
  emotion: "Interrogation, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Fasiq", "Al-Hakam"],
  mirrorVersion: `« Et vous serez alors trois groupes. » Le miroir me montre la division finale. « Wa kuntum azwajan thalathatan » — vous serez trois catégories. Chacun trouve sa place. Le tri est fait.`,
  reflection: `L'humanité sera divisée en trois groupes le Jour Dernier. Chaque groupe reçoit selon ses œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kuntum azwajan thalathatan » — et vous serez alors trois groupes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quel groupe j'appartiendrai ? Suis-je dans le groupe des rapprochés, des gens de la droite, ou des gens de la gauche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le groupe d'aujourd'hui détermine le groupe de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La division du Jour reflète la division des cœurs ici-bas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit son groupe maintenant le trouve préparé." }
  ],
  munajat: `Ya Hakam, Tu divises selon la justice. Place-moi dans le groupe des rapprochés. Ne me laisse pas parmi les perdants.`
};

MIROIR["56:8"] = {
  reference: "56:8",
  theme: ["jour dernier", "groupe", "droite"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Mu'min"],
  mirrorVersion: `« Les gens de la droite, que sont les gens de la droite ? » Le miroir m'interroge sur le meilleur groupe. « Ashabu al-maymanati ma ashabu al-maymanah » — les gens de la droite, qui sont-ils ? La question est une invitation.`,
  reflection: `Les gens de la droite reçoivent leur livre en main droite. Ils sont sauvés et honorés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ashabu al-maymanati ma ashabu al-maymanah » — les gens de la droite, que sont les gens de la droite ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi eux ? Qu'est-ce que je fais pour l'être ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droite d'aujourd'hui prépare la droite de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La droite est le symbole du succès et de l'honneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre avec la main droite du cœur reçoit le livre à droite." }
  ],
  munajat: `Ya Wali, fais-moi parmi les gens de la droite. Place mon livre dans ma main droite. Donne-moi l'honneur du succès.`
};

MIROIR["56:9"] = {
  reference: "56:9",
  theme: ["jour dernier", "gauche", "malheur"],
  emotion: "Crainte, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Muntaqim"],
  mirrorVersion: `« Et les gens de la gauche, que sont les gens de la gauche ? » Le miroir m'interroge sur le groupe malheureux. « Wa ashabu al-mash'amati ma ashabu al-mash'amah » — les gens de la gauche, qui sont-ils ? La question est un avertissement.`,
  reflection: `Les gens de la gauche reçoivent leur livre en main gauche. Ils sont perdus et humiliés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ashabu al-mash'amati ma ashabu al-mash'amah » — et les gens de la gauche, que sont les gens de la gauche ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui pourrait me placer parmi eux ? Qu'est-ce que je dois éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gauche d'aujourd'hui prépare la gauche de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gauche est le symbole de l'échec et de l'humiliation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la gauche l'évite par la crainte même." }
  ],
  munajat: `Ya Adl, préserve-moi des gens de la gauche. Ne me laisse pas recevoir mon livre à gauche. Protège-moi de l'humiliation.`
};

MIROIR["56:11"] = {
  reference: "56:11",
  theme: ["jour dernier", "rapprochés", "excellence"],
  emotion: "Espoir, aspiration intense",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muqarrabun", "Al-Wali"],
  mirrorVersion: `« Et les premiers, ce sont les premiers. » Le miroir me montre l'élite des élites. « Wa al-sabiquna al-sabiqun » — les premiers, les devanciers. Ils sont la crème de l'humanité. Les plus proches d'Allah.`,
  reflection: `Les premiers sont les plus rapprochés d'Allah. Ils ont devancé les autres dans la foi et les œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-sabiquna al-sabiqun » — et les premiers, ce sont les premiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les premiers ? Qu'est-ce que je peux devancer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le premier ici devient le premier là-bas. Le dernier ici devient le dernier là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans chaque chose, il y a des premiers et des derniers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut être premier doit devancer les autres vers Allah." }
  ],
  munajat: `Ya Rabb, fais-moi parmi les premiers. Donne-moi de devancer vers Toi. Place-moi parmi les rapprochés.`
};

MIROIR["56:12"] = {
  reference: "56:12",
  theme: ["paradis", "jardins", "délices"],
  emotion: "Espoir, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Ar-Rahim"],
  mirrorVersion: `« Ce sont eux qui seront les rapprochés. » Le miroir me montre l'honneur suprême. « Ula'ika al-muqarrabun » — ceux-là sont les rapprochés. La proximité d'Allah est le plus grand honneur.`,
  reflection: `Les rapprochés sont dans les jardins du délice. La proximité divine est leur récompense suprême.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika al-muqarrabun » — ce sont eux qui seront les rapprochés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais pour me rapprocher d'Allah ? La proximité se mérite-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rapprochement d'ici-bas prépare le rapprochement de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création cherche la proximité du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rapproche d'Allah maintenant Le verra alors." }
  ],
  munajat: `Ya Karim, rapproche-moi de Toi. Donne-moi la proximité des rapprochés. Fais que je sois parmi eux.`
};

MIROIR["56:13"] = {
  reference: "56:13",
  theme: ["paradis", "premiers", "communautés"],
  emotion: "Espoir, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Awwal", "Al-Akhir"],
  mirrorVersion: `« Une multitude parmi les premiers. » Le miroir me montre les anciens croyants. « Thullatun mina al-awwalin » — un grand nombre des premiers. Les prophètes, les compagnons, les saints.`,
  reflection: `Les premiers incluent les croyants des communautés passées. Ils ont cru avant nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thullatun mina al-awwalin » — une multitude parmi les premiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je marche sur leurs pas ? Suis-je digne de les rejoindre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les premiers sont premiers parce qu'ils ont cru en premier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne des croyants traverse les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejoint la chaîne des premiers rejoint leur récompense." }
  ],
  munajat: `Ya Awwal, Tu es le Premier. Fais que je suive les premiers. Donne-moi de les rejoindre au Paradis.`
};

MIROIR["56:14"] = {
  reference: "56:14",
  theme: ["paradis", "derniers", "minorité"],
  emotion: "Espoir, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Akhir", "Al-Baqi"],
  mirrorVersion: `« Et un petit nombre parmi les derniers. » Le miroir me montre la rareté des derniers. « Wa qalilun mina al-akhirin » — et peu parmi les derniers. La compétition est intense.`,
  reflection: `Les derniers sont peu nombreux parmi les rapprochés. La course vers l'excellence est difficile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalilun mina al-akhirin » — et un petit nombre parmi les derniers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi ce petit nombre ? Qu'est-ce qui me distingue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rareté augmente la valeur. Être peu, c'est être précieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le peu vaut plus que le beaucoup quand la qualité compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut être parmi les peu doit exceller." }
  ],
  munajat: `Ya Akhir, Tu es le Dernier. Fais que je sois parmi les peu des derniers. Donne-moi d'exceller dans la course.`
};

MIROIR["56:15"] = {
  reference: "56:15",
  theme: ["paradis", "trônes", "ornement"],
  emotion: "Espoir, magnificence",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Majid"],
  mirrorVersion: `« Sur des lits ornés, ils seront accoudés. » Le miroir me montre le repos royal. « 'Ala sururin mawdunatin muttaki'un » — sur des lits ornés, accoudés. Le repos des rapprochés est magnifique.`,
  reflection: `Les lits ornés symbolisent le repos honorable et confortable des rapprochés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala sururin mawdunatin muttaki'un » — sur des lits ornés, ils seront accoudés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel repos je désire ? Est-ce que je travaille pour le repos éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos éternel vient de l'effort ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repos est la récompense du travail." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repose en Allah maintenant se reposera sur ces lits." }
  ],
  munajat: `Ya Karim, Tu offres le repos magnifique. Donne-moi d'y accéder. Fais que je travaille pour ce repos.`
};

MIROIR["56:16"] = {
  reference: "56:16",
  theme: ["paradis", "face à face", "fraternité"],
  emotion: "Espoir, fraternité",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Jami'"],
  mirrorVersion: `« Ils seront accoudés, face à face. » Le miroir me montre la communauté parfaite. « Muttaki'ina 'alayha mutaqabilin » — accoudés dessus, se faisant face. La compagnie est parfaite.`,
  reflection: `Les rapprochés se font face dans une harmonie parfaite. Les relations sont pures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muttaki'ina 'alayha mutaqabilin » — ils seront accoudés, face à face." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui je veux être face à face au Paradis ? Quelles relations je cultive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fraternité d'ici-bas prépare la fraternité de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le lieu de la fraternité parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime pour Allah se retrouve avec ceux qu'il aime." }
  ],
  munajat: `Ya Wadud, Tu réunis les bien-aimés. Donne-moi d'être avec ceux que j'aime en Toi. Fais que nos faces se rencontrent au Paradis.`
};

MIROIR["56:17"] = {
  reference: "56:17",
  theme: ["paradis", "serviteurs", "éternité"],
  emotion: "Émerveillement, service",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Muta'"],
  mirrorVersion: `« Des serviteurs éternels circuleront parmi eux. » Le miroir me montre le service parfait. « Yaduru 'alayhim wildanun mukhalladun » — des serviteurs éternels tourneront autour d'eux. Le service est parfait et perpétuel.`,
  reflection: `Les serviteurs du Paradis sont éternellement jeunes et dévoués. Le service y est un honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaduru 'alayhim wildanun mukhalladun » — des serviteurs éternels circuleront parmi eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sais servir ? Est-ce que je sais accepter le service ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Servir ici-bas, c'est être servi là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le service est la noblesse dans le Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sert Allah maintenant est servi par Ses serviteurs alors." }
  ],
  munajat: `Ya Malik, Tu offres le service parfait. Apprends-moi à servir. Donne-moi d'être servi au Paradis.`
};

MIROIR["56:18"] = {
  reference: "56:18",
  theme: ["paradis", "coupe", "boisson"],
  emotion: "Désir, fraîcheur",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mu'dhib"],
  mirrorVersion: `« Avec des coupes, des aiguières, et des verres remplis de boissons limpides. » Le miroir me montre l'abondance des boissons. « Bi-akwabin wa abariqa wa ka'sin ma'inin » — avec des coupes, des cruches, des verres de boisson claire.`,
  reflection: `Les boissons du Paradis sont pures et rafraîchissantes. L'abondance est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-akwabin wa abariqa wa ka'sin ma'inin » — avec des coupes, des aiguières, et des verres remplis de boissons limpides." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi j'ai soif ? Est-ce que j'ai soif des boissons du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soif d'ici-bas prépare la satiété de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est le symbole de la vie. Au Paradis, elle est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a soif d'Allah désaltère son cœur au Paradis." }
  ],
  munajat: `Ya Razzaq, Tu offres les boissons pures. Donne-moi d'y boire. Étanche ma soif éternelle.`
};

MIROIR["56:19"] = {
  reference: "56:19",
  theme: ["paradis", "ivresse", "pureté"],
  emotion: "Joie, sobriété",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Hadi"],
  mirrorVersion: `« N'y trouvant aucun mal et n'en étant point enivrés. » Le miroir me montre la boisson sans mal. « La yusadda'una 'anha wa la yunzifun » — ils n'en ont pas de mal et ne s'enivrent pas. La boisson du Paradis est pure.`,
  reflection: `Les boissons du Paradis n'ont pas les effets négatives de celles d'ici-bas. Elles sont pures et enivrent de joie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yusadda'una 'anha wa la yunzifun » — n'y trouvant aucun mal et n'en étant point enivrés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'enivre ici-bas ? Est-ce que je recherche l'ivresse spirituelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ivresse d'Allah est la seule ivresse sans mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté du Paradis transforme tout en bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'enivre d'amour divin goûte au Paradis." }
  ],
  munajat: `Ya Hadi, Tu offres l'ivresse pure. Enivre-moi de Ton amour. Donne-moi la joie sans mal.`
};

MIROIR["56:20"] = {
  reference: "56:20",
  theme: ["paradis", "fruits", "choix"],
  emotion: "Désir, abondance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Et des fruits selon leur désir. » Le miroir me montre l'accomplissement des désirs. « Wa fakihatin mimma yashtahun » — et des fruits qu'ils désirent. Chaque désir est satisfait.`,
  reflection: `Les fruits du Paradis répondent à tous les désirs. L'abondance est personnalisée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fakihatin mimma yashtahun » — et des fruits selon leur désir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel fruit je désire ? Est-ce que je désire les fruits du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désir purifié ici-bas prépare le désir satisfait là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le lieu de la satisfaction de tous les désirs purs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire Allah reçoit tous les désirs en plus." }
  ],
  munajat: `Ya Razzaq, Tu exauces les désirs. Donne-moi de désirer ce qui mène au Paradis. Satisfais mes désirs purs.`
};

MIROIR["56:21"] = {
  reference: "56:21",
  theme: ["paradis", "viande", "volaille"],
  emotion: "Appétit, abondance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mughni"],
  mirrorVersion: `« Et de la chair d'oiseaux qu'ils désirent. » Le miroir me montre les mets raffinés. « Wa lahmi tayrin mimma yashtahun » — et de la chair d'oiseaux qu'ils désirent. La nourriture est excellente.`,
  reflection: `Les viandes du Paradis sont les plus raffinées. Chaque mets correspond au désir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lahmi tayrin mimma yashtahun » — et de la chair d'oiseaux qu'ils désirent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je désire manger ? Est-ce que j'ai faim des mets du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faim d'ici-bas prépare la satiété de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le lieu de la nourriture parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a faim d'Allah est nourri de tout bien." }
  ],
  munajat: `Ya Razzaq, Tu offres les mets excellents. Donne-moi d'y goûter. Nourris-moi des délices du Paradis.`
};

MIROIR["56:22"] = {
  reference: "56:22",
  theme: ["paradis", "houris", "beauté"],
  emotion: "Désir, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Jamil"],
  mirrorVersion: `« Et ils auront des houris aux grands yeux. » Le miroir me montre la compagnie parfaite. « Wa hourun 'in » — et des houris aux grands yeux. La beauté du Paradis inclut la compagnie.`,
  reflection: `Les houris du Paradis sont décrites par leur beauté et leurs grands yeux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hourun 'in » — et ils auront des houris aux grands yeux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle compagnie je désire ? Est-ce que je prépare mon cœur pour la pureté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté du cœur ici-bas prépare la pureté de la compagnie là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté parfaite n'existe que dans la pureté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie son cœur reçoit la compagnie pure." }
  ],
  munajat: `Ya Wadud, Tu offres la compagnie parfaite. Purifie mon cœur. Donne-moi d'accéder à la beauté du Paradis.`
};

MIROIR["56:23"] = {
  reference: "56:23",
  theme: ["paradis", "perles", "cachées"],
  emotion: "Émerveillement, préciosité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Comme des perles cachées. » Le miroir me montre la préciosité. « Ka-amthalilu al-lu'lu'i al-maknun » — comme des perles bien conservées. La pureté est précieuse et protégée.`,
  reflection: `Les houris sont comparées à des perles cachées, précieuses et pures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-amthalilu al-lu'lu'i al-maknun » — comme des perles cachées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve ma perle intérieure ? Mon cœur est-il caché et protégé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perle cachée ici devient la perle révélée là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perle est formée dans l'obscurité, révélée dans la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache son bien pour Allah le trouve révélé au Paradis." }
  ],
  munajat: `Ya Khaliq, Tu formes les perles. Préserve mon cœur comme une perle. Donne-moi d'être révélé dans Ta lumière.`
};

MIROIR["56:24"] = {
  reference: "56:24",
  theme: ["récompense", "œuvres", "mérite"],
  emotion: "Motivation, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Hasib"],
  mirrorVersion: `« En récompense de ce qu'ils faisaient. » Le miroir me montre la justice divine. « Jaza'an bima kanu ya'malun » — récompense pour ce qu'ils faisaient. Chaque acte compte.`,
  reflection: `Les délices du Paradis sont la récompense des œuvres accomplies ici-bas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jaza'an bima kanu ya'malun » — en récompense de ce qu'ils faisaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais aujourd'hui ? Quelle récompense je prépare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acte d'ici-bas crée la récompense de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action a une réaction, dans les deux mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit pour Allah reçoit au-delà de son action." }
  ],
  munajat: `Ya Shakur, Tu récompenses les œuvres. Accepte mes actes. Donne-moi la récompense des rapprochés.`
};

MIROIR["56:25"] = {
  reference: "56:25",
  theme: ["paradis", "parole", "paix"],
  emotion: "Sérénité, pureté",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Quddus"],
  mirrorVersion: `« Ils y n'entendent ni paroles frivoles ni paroles blâmables. » Le miroir me montre la pureté de la parole. « La yasma'una fiha laghwan wa la ta'thiman » — ils n'y entendent ni futilité ni péché. La parole est pure.`,
  reflection: `Au Paradis, les paroles sont pures et bénéfiques. Pas de futilité ni de mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yasma'una fiha laghwan wa la ta'thiman » — ils y n'entendent ni paroles frivoles ni paroles blâmables." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'entends aujourd'hui ? Qu'est-ce que je dis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole pure d'ici-bas prépare la parole pure de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole est le reflet du cœur. Au Paradis, les deux sont purs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie sa parole maintenant entend la pureté éternelle." }
  ],
  munajat: `Ya Salam, Tu offres la paix des paroles. Purifie ma langue. Donne-moi d'entendre les paroles du Paradis.`
};

MIROIR["56:26"] = {
  reference: "56:26",
  theme: ["paradis", "salut", "paix"],
  emotion: "Sérénité, bénédiction",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mu'min"],
  mirrorVersion: `« Seulement une parole de salut, de paix. » Le miroir me montre la parole du Paradis. « Illa qilan salaman salaman » — seulement un dire de salut, de paix. La parole est bénédiction.`,
  reflection: `Au Paradis, les paroles sont des bénédictions. "Salam" est la parole dominante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa qilan salaman salaman » — seulement une parole de salut, de paix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis 'salam' ? Est-ce que je répands la paix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix donnée ici devient la paix reçue là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix est l'état naturel du Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est en paix maintenant trouve la paix éternelle." }
  ],
  munajat: `Ya Salam, Tu es la Paix. Donne-moi la paix. Fais que je sois un porte-parole de la paix.`
};

// ============================================
// SURAH 16 (AN-NAHL) - EXPANSION
// ============================================

MIROIR["16:2"] = {
  reference: "16:2",
  theme: ["révélation", "guidance", "anges"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Hadi"],
  mirrorVersion: `« Il fait descendre les anges avec l'Esprit venant de Son ordre sur qui Il veut parmi Ses serviteurs. » Le miroir me montre la grâce de la révélation. Allah choisit qui Il veut pour recevoir Son message. Ce n'est pas un privilège mérité — c'est un don. La révélation descend comme une pluie bienfaisante sur une terre préparée. Le miroir m'interroge : suis-je une terre préparée pour recevoir la guidance ?`,
  reflection: `La révélation est un don divin, pas un droit humain. Les anges portent l'Esprit — la Parole de Dieu — vers les cœurs ouverts.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yunazzilu al-mala'ikata bi al-ruhi min amrihi » — Il fait descendre les anges avec l'Esprit venant de Son ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à recevoir la guidance ? Mon cœur est-il ouvert ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation descend vers celui qui s'élève vers elle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance divine parcourt l'univers, cherchant les cœurs réceptifs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'Esprit de Dieu transforme celui qui le reçoit." }
  ],
  munajat: `Ya Wahhab, fais descendre Ta guidance sur mon cœur. Prépare-moi à recevoir Ton Esprit.`
};

MIROIR["16:4"] = {
  reference: "16:4",
  theme: ["création", "humilité", "origine"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Il a créé l'homme d'une goutte de sperme ; et voilà que celui-ci devient un adversaire déclaré. » Le miroir me montre l'ironie de l'orgueil humain. D'une goutte insignifiante naît un être qui ose défier son Créateur. L'homme oublie son origine modeste et se prend pour un rival d'Allah. Le miroir m'interroge : où est mon orgueil ? Suis-je conscient de ma petitesse ?`,
  reflection: `L'orgueil est l'oubli de son origine. Se souvenir de sa création, c'est retrouver l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa al-insana min nutfatin fa'idha huwa khasimun mubin » — Il a créé l'homme d'une goutte ; et voilà qu'il devient un adversaire déclaré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon origine est modeste. Pourquoi alors l'orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adversaire d'Allah est en réalité son propre ennemi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature vient du néant et y retourne. Seule la conscience de ce cycle apporte la sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine ne s'enorgueillit jamais." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'une goutte. Garde-moi humble. Rappelle-moi mon origine pour que je ne devienne pas Ton adversaire.`
};

MIROIR["16:5"] = {
  reference: "16:5",
  theme: ["création", "bénédictions", "gratitude"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Et les bestiaux, Il les a créés pour vous ; vous en retirez des vêtements et d'autres utilités, et vous en mangez. » Le miroir me montre les bienfaits cachés dans la création. Les animaux ne sont pas là par hasard — ils sont des dons d'Allah. Leur laine nous couvre, leur chair nous nourrit. Chaque créature porte un bienfait. Le miroir m'interroge : est-ce que je reconnais ces dons quotidiens ?`,
  reflection: `La création entière est un don. Reconnaître ces bienfaits est le début de la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-an'ama khalaqaha lakum fiha dif'un wa manafi'u wa minha ta'kulun » — Et les bestiaux, Il les a créés pour vous ; vous en retirez chaleur et bienfaits, et vous en mangez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits de la création est-ce que je prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les animaux nous servent, mais nous devons les traiter avec bonté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a sa place dans l'écosystème divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bienfait non reconnu devient une dette." }
  ],
  munajat: `Ya Razzaq, merci pour les bestiaux qui me nourrissent et me couvrent. Fais que je reconnaisse Tes dons dans chaque repas.`
};

MIROIR["16:6"] = {
  reference: "16:6",
  theme: ["création", "beauté", "paix"],
  emotion: "Paix, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Jamil", "As-Salam"],
  mirrorVersion: `« Et vous tirez de leur beauté, quand vous les faites paître le soir et le matin. » Le miroir me montre la beauté de la création. Les troupeaux au crépuscule et à l'aube — une image de paix. Allah a mis de la beauté dans les temps de transition. Le matin et le soir sont des moments de contemplation. Le miroir m'interroge : est-ce que je m'arrête pour contempler la beauté de la création ?`,
  reflection: `La beauté est disséminée dans la création. Les moments de transition sont des occasions de contemplation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lakum fiha jamalun hina turinuna wa hina tasrahu » — Et vous tirez de leur beauté, quand vous les faites paître le soir et le matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je m'arrête pour contempler la beauté de la création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté que je contemple est le reflet de la Beauté du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube et le crépuscule sont des moments sacrés dans toutes les traditions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la beauté de la création voit la Beauté du Créateur." }
  ],
  munajat: `Ya Jamil, Tu as mis de la beauté dans la création. Ouvre mes yeux pour la voir. Fais que je contemple Tes signes.`
};

MIROIR["16:7"] = {
  reference: "16:7",
  theme: ["création", "voyage", "miséricorde"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mu'in"],
  mirrorVersion: `« Et ils portent vos charges vers un pays que vous n'atteindriez qu'avec beaucoup de peine. » Le miroir me montre la miséricorde dans le transport. Les animaux portent nos charges vers des contrées lointaines. Ce qui serait impossible à pied devient possible grâce à eux. Allah facilite les voyages. Le miroir m'interroge : est-ce que je reconnais les facilités qu'Allah met dans ma vie ?`,
  reflection: `La facilité du voyage est un don. Les moyens de transport sont des miséricordes cachées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tahmilu athqalakum ila baladin lam takunu balighihi illa bi shiqqi al-anfus » — Et ils portent vos charges vers un pays que vous n'atteindriez qu'avec beaucoup de peine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels facilités est-ce que je prends pour acquis dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du voyage cache la peine que Dieu nous épargne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a une fonction dans l'équilibre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance des facilités attire d'autres facilités." }
  ],
  munajat: `Ya Rahman, Tu facilites mes voyages. Merci pour les moyens de transport. Fais que je reconnaisse Tes facilités.`
};

MIROIR["16:8"] = {
  reference: "16:8",
  theme: ["création", "chevaux", "beauté"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Et les chevaux, les mulets et les ânes, pour vous servir de monture et d'apparat. » Le miroir me montre la dualité des bienfaits. Les animaux servent à la fois l'utilité et la beauté. Le cheval est monture et ornement. Allah pourvoit à nos besoins pratiques et esthétiques. Le miroir m'interroge : est-ce que j'apprécie la beauté dans les choses utiles ?`,
  reflection: `Le beau et l'utile ne s'opposent pas. Allah crée des choses à la fois pratiques et belles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-khayla wa al-bighala wa al-hamira li tasku'rakum wa zinata » — Et les chevaux, les mulets et les ânes, pour vous servir de monture et d'apparat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la beauté dans les choses utiles de ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apparat n'est pas vanité quand il est reconnu comme don divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté dans la création a une fonction : rappeler le Beau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la beauté des montures reconnaît la Beauté du Créateur." }
  ],
  munajat: `Ya Musawwir, Tu as créé la beauté dans les choses utiles. Ouvre mes yeux pour la voir et mon cœur pour la reconnaître.`
};

MIROIR["16:9"] = {
  reference: "16:9",
  theme: ["guidance", "droit chemin", "errance"],
  emotion: "Espoir, recherche",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Sirat"],
  mirrorVersion: `« À Allah appartient la direction du chemin droit, mais il en est de tortueux. » Le miroir me montre le choix qui s'offre à moi. Le chemin droit existe — mais les chemins tortueux aussi. Allah indique la voie droite, mais ne force personne à la suivre. Le miroir m'interroge : quel chemin est-ce que je prends ? Est-ce le droit ou le tortueux ?`,
  reflection: `Le chemin droit est indiqué par Allah. Le choisir est un acte de volonté libre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ala Allahi qasd al-sabilu wa minha jai'ir » — À Allah appartient la direction du chemin droit, mais il en est de tortueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon chemin : est-il droit ou tortueux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin tortueux semble court mais mène à l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création suit le chemin droit assigné par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le chemin droit n'est pas le plus facile, mais c'est le seul qui mène au but." }
  ],
  munajat: `Ya Hadi, montre-moi le chemin droit. Donne-moi la force de le suivre malgré les chemins tortueux qui me tentent.`
};

MIROIR["16:10"] = {
  reference: "16:10",
  theme: ["eau", "vie", "bénédictions"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muhyi"],
  mirrorVersion: `« C'est Lui qui, du ciel, a fait descendre l'eau pour vous ; de laquelle vous avez à boire et grâce à laquelle poussent des plantes dont vous nourrissez vos troupeaux. » Le miroir me montre le cycle de l'eau, ce don vital. La pluie descend du ciel, abreuve les humains, fait pousser les plantes, nourrit les animaux. Un seul don, mille bénéfices. Le miroir m'interroge : est-ce que je reconnais la valeur de l'eau que je bois chaque jour ?`,
  reflection: `L'eau est le don vital par excellence. Chaque goutte est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi anzala mina al-sama'i ma'an lakum minhu sharabun wa minhu shajarun fihi tusimun » — C'est Lui qui, du ciel, a fait descendre l'eau pour vous ; de laquelle vous avez à boire et grâce à laquelle poussent des plantes dont vous nourrissez vos troupeaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je bois de l'eau, est-ce que je remercie Celui qui l'a fait descendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau gratuite est la plus précieuse des richesses." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est la source de toute vie dans l'univers connu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour l'eau remercie pour la vie elle-même." }
  ],
  munajat: `Ya Razzaq, merci pour l'eau qui me désaltère. Fais que je ne la prenne jamais pour acquise.`
};

MIROIR["16:11"] = {
  reference: "16:11",
  theme: ["création", "nourriture", "abondance"],
  emotion: "Gratitude, abondance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muqtadir"],
  mirrorVersion: `« Il fait pousser pour vous, avec elle, les cultures, les oliviers, les palmiers, les vignes et toutes sortes de fruits. » Le miroir me montre la diversité des bienfaits. L'eau fait pousser non pas une nourriture, mais une multitude : olives, dattes, raisins, fruits divers. La variété est un don. Le miroir m'interroge : est-ce que je reconnais la diversité des dons d'Allah dans mon assiette ?`,
  reflection: `La diversité des aliments est une miséricorde. Allah aurait pu créer un seul aliment — mais Il a créé l'abondance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yunbitu lakum biha al-zar'a wa al-zaytuna wa al-nakhila wa al-a'naba wa min kulli al-thamarat » — Il fait pousser pour vous, avec elle, les cultures, les oliviers, les palmiers, les vignes et toutes sortes de fruits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour la variété des aliments que je mange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abondance n'est pas un droit — c'est un privilège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque région du monde a ses fruits spécifiques — une géographie de la miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'abondance l'apprécie davantage." }
  ],
  munajat: `Ya Razzaq, merci pour la variété des fruits et des cultures. Fais que je ne les prenne jamais pour acquis.`
};

MIROIR["16:12"] = {
  reference: "16:12",
  theme: ["signes", "soleil", "lune"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Khaliq"],
  mirrorVersion: `« Et Il a soumis à votre service la nuit, le jour, le soleil et la lune. » Le miroir me montre les signes cosmiques. Le soleil et la lune obéissent à Allah et servent l'homme. La nuit et le jour alternent selon un ordre précis. Ces corps célestes sont des serviteurs de Dieu au service de l'humanité. Le miroir m'interroge : est-ce que je contemple ces signes quotidiens ?`,
  reflection: `Les astres sont des serviteurs. Leur régularité est un signe de l'ordre divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sakhkhara lakuma al-layla wa al-nahara wa al-shamsa wa al-qamara » — Et Il a soumis à votre service la nuit, le jour, le soleil et la lune." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple le soleil et la lune comme des signes d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces corps immenses nous servent — et nous, à qui servons-nous ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est soumis à l'ordre divin. Les astres sont les plus visibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les astres contemple la grandeur d'Allah." }
  ],
  munajat: `Ya Khaliq, le soleil et la lune T'obéissent. Fais que je les contemple comme Tes signes et que je T'obéisse comme eux.`
};

MIROIR["16:13"] = {
  reference: "16:13",
  theme: ["signes", "bénédictions", "réflexion"],
  emotion: "Gratitude, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Hakim"],
  mirrorVersion: `« Et ce qu'Il a créé pour vous sur terre a des couleurs variées. » Le miroir me montre la beauté de la diversité. Les couleurs de la terre ne sont pas fonctionnelles uniquement — elles sont esthétiques. Allah aurait pu créer un monde monochrome. Mais Il a choisi la couleur. Le miroir m'interroge : est-ce que je m'arrête pour apprécier les couleurs de la création ?`,
  reflection: `La couleur est un langage divin. Chaque teinte dit quelque chose de la créativité du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma dhara'a lakum fi al-ardi mukhtalifan alwanuhu » — Et ce qu'Il a créé pour vous sur terre a des couleurs variées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'arrête pour apprécier les couleurs de la nature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La couleur n'est pas nécessaire à la vie — elle est un cadeau supplémentaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les couleurs de la terre varient selon les saisons — un spectacle renouvelé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprécie les couleurs apprécie l'art du Créateur." }
  ],
  munajat: `Ya Musawwir, Tu as créé les couleurs pour mon plaisir. Ouvre mes yeux pour les voir et mon cœur pour les apprécier.`
};

MIROIR["16:14"] = {
  reference: "16:14",
  theme: ["mer", "nourriture", "bijoux"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muqtadir"],
  mirrorVersion: `« Et c'est Lui qui a soumis la mer : vous en mangez une chair fraîche, et vous en tirez des ornements que vous portez. » Le miroir me montre les dons de la mer. La mer nourrit (poissons) et pare (perles, coraux). Le même élément fournit sustenance et beauté. Allah multiplie les bienfaits dans une seule création. Le miroir m'interroge : est-ce que je reconnais les dons multiples d'Allah ?`,
  reflection: `La mer est une ressource multiple. Elle nourrit et embellit à la fois.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi sakhkhara al-bahra li ta'kulu minhu lahman tariyyan wa tastakhriju minhu hilayyan talbasunaha » — Et c'est Lui qui a soumis la mer : vous en mangez une chair fraîche, et vous en tirez des ornements que vous portez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les dons multiples d'Allah dans la mer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mer qui nourrit peut aussi détruire — mais Allah l'a soumise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les océans couvrent la majorité de la terre — une immense ressource." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour les dons de la mer remercie pour l'abondance divine." }
  ],
  munajat: `Ya Razzaq, merci pour les dons de la mer — nourriture et beauté. Fais que je les reconnaisse comme venant de Toi.`
};

MIROIR["16:15"] = {
  reference: "16:15",
  theme: ["montagnes", "stabilité", "protection"],
  emotion: "Sécurité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Matin"],
  mirrorVersion: `« Et Il a implanté des montagnes immobiles dans la terre afin qu'elle ne s'ébranle pas avec vous. » Le miroir me montre la stabilité cachée. Les montagnes ne sont pas de simples décorations — elles sont des ancrages. La terre tremblerait sans elles. Allah a prévu la stabilité avant même que nous en ayons conscience. Le miroir m'interroge : est-ce que je reconnais les stabilisateurs dans ma vie ?`,
  reflection: `Les montagnes sont des stabilisateurs. La stabilité de la terre est un don invisible mais essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alqaa fi al-ardi rawasiya an tamida bikum » — Et Il a implanté des montagnes immobiles dans la terre afin qu'elle ne s'ébranle pas avec vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui stabilise ma vie ? Est-ce que je reconnais les montagnes qu'Allah a placées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stabilité que je ressens cache un équilibre fragile maintenu par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont les piliers de la terre — comme la foi est le pilier du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les stabilisateurs les préserve." }
  ],
  munajat: `Ya Matin, Tu as placé les montagnes pour ma stabilité. Place aussi la foi dans mon cœur comme une montagne.`
};

MIROIR["16:16"] = {
  reference: "16:16",
  theme: ["guidance", "étoiles", "direction"],
  emotion: "Confiance, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Et des voies de communication, ainsi que des repères. Et c'est par les étoiles que les gens se dirigent. » Le miroir me montre les guides dans la création. Les routes terrestres et les étoiles célestes — tous deux orientent le voyageur. Allah a placé des guides partout : sur terre et dans le ciel. Le miroir m'interroge : est-ce que je suis les guides qu'Allah a placés sur mon chemin ?`,
  reflection: `La guidance est partout — sur terre et dans le ciel. Il suffit de lever les yeux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa subulan wa 'alamatun wa bi al-najmi muhtadun » — Et des voies de communication, ainsi que des repères. Et c'est par les étoiles que les gens se dirigent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels guides est-ce que je suis ? Les signes d'Allah ou mes propres désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étoiles guident dans la nuit — le Coran guide dans les ténèbres de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Depuis toujours, les voyageurs se sont guidés aux étoiles — une boussole universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les guides divins ne s'égare jamais." }
  ],
  munajat: `Ya Hadi, Tu as placé des étoiles pour guider les voyageurs. Place aussi des signes sur mon chemin pour me guider vers Toi.`
};

MIROIR["16:17"] = {
  reference: "16:17",
  theme: ["comparaison", "créateur", "idoles"],
  emotion: "Lucidité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Celui qui crée est-il comparable à celui qui ne crée rien ? » Le miroir me pose une question rhétorique. La réponse est évidente : non. Comment comparer le Créateur à ce qui ne crée rien ? L'idole ne peut rien — ni créer, ni nuire, ni profiter. Seul Allah crée. Le miroir m'interroge : est-ce que je place ma confiance dans ce qui ne peut rien ou dans le Créateur ?`,
  reflection: `La comparaison est impossible. Le Créateur et la créature sont dans des catégories différentes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afa man yakhluqu ka man la yakhluq » — Celui qui crée est-il comparable à celui qui ne crée rien ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je place ma confiance ? Dans le Créateur ou dans les créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole que j'adore peut-être l'argent, le pouvoir, le statut — tous ne créent rien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création témoigne de la capacité créatrice d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Créateur ne confond pas l'artisan avec l'œuvre." }
  ],
  munajat: `Ya Khaliq, Tu es le seul Créateur. Ne laisse pas mon cœur s'attacher à ce qui ne crée rien. Fais que je place ma confiance en Toi seul.`
};

MIROIR["16:19"] = {
  reference: "16:19",
  theme: ["science divine", "secret", "connaissance"],
  emotion: "Humilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Allah sait ce que vous cachez et ce que vous divulguez. » Le miroir me montre l'omniscience divine. Rien n'échappe à Allah — ni mes pensées secrètes, ni mes actions publiques. Je peux tromper les autres, mais pas Lui. Le miroir m'interroge : est-ce que je vis en sachant qu'Allah me voit ?`,
  reflection: `La connaissance d'Allah englobe tout. Le secret pour les hommes est manifeste pour Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu ya'lamu ma tusirruna wa ma tu'linun » — Allah sait ce que vous cachez et ce que vous divulguez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Est-ce que je peux le cacher à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je cache des hommes est vu par Allah — et c'est Lui qui juge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers n'échappe à la connaissance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre en sachant qu'Allah voit transforme chaque action." }
  ],
  munajat: `Ya 'Alim, Tu connais mes secrets. Aide-moi à vivre en Ta présence, sans rien cacher, comme si chaque instant était sous Ton regard.`
};

MIROIR["16:20"] = {
  reference: "16:20",
  theme: ["idoles", "impuissance", "unicité"],
  emotion: "Lucidité, rejet",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Qahhar"],
  mirrorVersion: `« Ceux qu'ils invoquent en dehors d'Allah ne créent rien, et ils sont eux-mêmes créés. » Le miroir me montre l'absurdité de l'idolâtrie. Les idoles ne créent pas — elles sont créées. Elles sont des objets passifs, sans vie, sans pouvoir. Pourquoi invoquer ce qui ne peut rien ? Le miroir m'interroge : quelles idoles modernes est-ce que j'adore sans le savoir ?`,
  reflection: `L'idole est impuissante. Invoquer ce qui ne peut rien est le comble de l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina yad'una min duni Allahi la yakhluquna shay'an wa hum yukhlaqun » — Ceux qu'ils invoquent en dehors d'Allah ne créent rien, et ils sont eux-mêmes créés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles idoles est-ce que j'adore ? L'argent ? Le statut ? La beauté ? Toutes sont créées, pas créatrices." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole que j'adore aujourd'hui sera brisée demain — seule Allah demeure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose créée périra. Seul le Créateur est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'impuissance des idoles retourne au Tout-Puissant." }
  ],
  munajat: `Ya Wahid, Tu es le seul digne d'adoration. Libère mon cœur des idoles modernes qui le captivent. Ramène-moi à Toi seul.`
};

MIROIR["16:21"] = {
  reference: "16:21",
  theme: ["mort", "idoles", "impuissance"],
  emotion: "Lucidité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Qayyum"],
  mirrorVersion: `« Ce sont des morts, non des vivants. Et ils ne savent pas quand ils seront ressuscités. » Le miroir me montre l'état des idoles. Elles sont mortes, inanimées, inconscientes. Elles ne connaissent même pas leur propre destin. Comment pourraient-elles aider qui que ce soit ? Le miroir m'interroge : est-ce que je cherche de l'aide auprès des morts ou du Vivant ?`,
  reflection: `Les idoles sont mortes. Seul Allah est le Vivant qui ne meurt jamais.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amwatun ghayru ahya'in wa ma yash'uruna ayyana yub'athun » — Ce sont des morts, non des vivants. Et ils ne savent pas quand ils seront ressuscités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Auprès de qui je cherche secours ? Des morts ou du Vivant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles mortes ne peuvent donner la vie — seul le Vivant le peut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie est le don le plus précieux. Chercher les morts est une contradiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache au Vivant trouve la vie éternelle." }
  ],
  munajat: `Ya Hayy, Tu es le Vivant éternel. Ne laisse pas mon cœur s'attacher aux morts. Fais que je cherche la vie auprès de Toi.`
};

MIROIR["16:22"] = {
  reference: "16:22",
  theme: ["unicité", "mécréance", "résurrection"],
  emotion: "Sérieux, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Votre Dieu est un Dieu unique. Ceux qui ne croient pas en l'au-delà ont les cœurs qui nient et s'enflent d'orgueil. » Le miroir me montre le lien entre l'unicité et l'au-delà. Croire en un Dieu unique implique de croire au jugement. Ceux qui nient la résurrection nient aussi l'unicité — leur cœur se ferme et s'enfle. Le miroir m'interroge : mon cœur est-il ouvert à l'unicité et à la résurrection ?`,
  reflection: `L'unicité et la résurrection sont liées. La foi en l'une implique la foi en l'autre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ilahukum ilahun wahidun fa alladhina la yu'minuna bi al-akhirati qulubuhum munkiratun wa hum mustakbirun » — Votre Dieu est un Dieu unique. Ceux qui ne croient pas en l'au-delà ont les cœurs qui nient et s'enflent d'orgueil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en l'unicité d'Allah et en la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil ferme le cœur. L'humilité l'ouvre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame l'unicité du Créateur. Seul l'orgueil humain nie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur ouvert reconnaît l'unicité et accepte la résurrection." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Ouvre mon cœur à Ta unicité et à la certitude de la résurrection. Garde-moi de l'orgueil qui ferme le cœur.`
};

MIROIR["16:23"] = {
  reference: "16:23",
  theme: ["science divine", "orgueil", "désaveu"],
  emotion: "Avertissement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Mutakabbir"],
  mirrorVersion: `« Nul doute qu'Allah sait ce qu'ils cachent et ce qu'ils divulguent. Il n'aime pas les orgueilleux. » Le miroir me montre la conséquence de l'orgueil. Allah connaît tout — mais Il n'aime pas l'orgueil. Le secret n'est pas un refuge contre Sa connaissance. L'orgueil est un voile entre la créature et son Créateur. Le miroir m'interroge : mon orgueil me cache-t-il d'Allah ?`,
  reflection: `Allah connaît tout, mais Son amour n'est pas automatique. L'orgueil Le déplaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La jarama anna Allaha ya'lamu ma yusirruna wa ma yu'linun, innahu la yuhibbu al-mustakbirin » — Nul doute qu'Allah sait ce qu'ils cachent et ce qu'ils divulguent. Il n'aime pas les orgueilleux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon orgueil ? Est-ce que je le cache ou le reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil déplaît à Allah. L'humilité Lui plaît." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se soumet à Allah. Seul l'orgueilleux refuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne l'orgueil retrouve l'amour d'Allah." }
  ],
  munajat: `Ya 'Alim, Tu connais mon orgueil. Aide-moi à le reconnaître et à m'en défaire. Fais que je sois parmi les humbles que Tu aimes.`
};

MIROIR["16:24"] = {
  reference: "16:24",
  theme: ["coran", "rejet", "contestation"],
  emotion: "Tristesse, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Kalam"],
  mirrorVersion: `« Et quand on leur dit : "Qu'a fait descendre votre Seigneur ?" Ils disent : "Des légendes des anciens." » Le miroir me montre le rejet de la révélation. Face à la Parole de Dieu, certains répondent par le mépris. Ils réduisent le Coran à des contes anciens. Ce rejet n'est pas intellectuel — il est spirituel. Le miroir m'interroge : comment est-ce que je reçois la Parole d'Allah ?`,
  reflection: `Le rejet du Coran est un voile sur le cœur. Celui qui entend mais ne comprend pas a l'esprit fermé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahum ma dhara'a rabbukum qalu asatiru al-awwalin » — Et quand on leur dit : 'Qu'a fait descendre votre Seigneur ?' Ils disent : 'Des légendes des anciens.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je reçois le Coran ? Comme Parole de Dieu ou comme légende ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble légende à l'orgueilleux est vérité pour le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Parole de Dieu transcende les époques. Elle est toujours actuelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le Coran avec le cœur ouvert entend la voix de Dieu." }
  ],
  munajat: `Ya Haqq, Ton Coran est vérité. Ouvre mes oreilles pour l'entendre et mon cœur pour le recevoir. Ne laisse pas le mépris voiler ma compréhension.`
};

MIROIR["16:25"] = {
  reference: "16:25",
  theme: ["responsabilité", "égarement", "charge"],
  emotion: "Gravité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Hakam"],
  mirrorVersion: `« Qu'ils portent donc leurs fardeaux complets le Jour de la Résurrection, ainsi qu'une partie des fardeaux de ceux qu'ils égarent sans le savoir. » Le miroir me montre la responsabilité de l'influence. Celui qui égare les autres porte leur fardeau en plus du sien. L'égarement n'est pas sans conséquence — il revient à son auteur. Le miroir m'interroge : est-ce que j'égare les autres par mes paroles ou mes actes ?`,
  reflection: `L'influence a un prix. Égarer les autres ajoute à notre propre fardeau le Jour du Jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yahmilu awzarahum kamilatan yawma al-qiyamati wa min awzari alladhina yudillunahum bighayri 'ilm » — Qu'ils portent donc leurs fardeaux complets le Jour de la Résurrection, ainsi qu'une partie des fardeaux de ceux qu'ils égarent sans le savoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'influence les autres vers le bien ou vers le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Guider vers le bien allège le fardeau. Égarer l'alourdit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a des ondes qui touchent les autres. La responsabilité est collective." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide vers Allah partage les récompenses, pas les fardeaux." }
  ],
  munajat: `Ya Hasib, garde-moi d'égarer qui que ce soit. Fais que mes paroles et mes actes guident vers Toi, pas vers l'égarement.`
};

MIROIR["16:26"] = {
  reference: "16:26",
  theme: ["histoire", "destruction", "ruse"],
  emotion: "Avertissement, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui ont vécu avant eux ont comploté, mais Allah a renversé leurs constructions par leurs fondations. » Le miroir me montre l'histoire comme enseignement. Les anciens ont comploté contre la vérité — et Allah a détruit leurs œuvres. La ruse des hommes ne peut rien contre le décret divin. Le miroir m'interroge : est-ce que je construis sur des fondations solides ou sur le sable ?`,
  reflection: `Les complots des anciens ont échoué. La vérité triomphe toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad makara alladhina min qablihim fa ata Allahu bunyanahum mina al-qawa'idi » — Ceux qui ont vécu avant eux ont comploté, mais Allah a renversé leurs constructions par leurs fondations." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je construis ? Sur quelles fondations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est construit contre Allah sera détruit. Ce qui est construit pour Lui demeure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de civilisations qui ont disparu. Seuls les justes héritent de la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui construit avec Allah construit pour l'éternité." }
  ],
  munajat: `Ya Qahhar, Tu as détruit les complots des anciens. Garde-moi de comploter contre la vérité. Fais que je construise sur Tes fondations.`
};

MIROIR["16:27"] = {
  reference: "16:27",
  theme: ["jour dernier", "honte", "partners"],
  emotion: "Gravité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Puis, le Jour de la Résurrection, Il les couvrira d'ignominie et dira : "Où sont Mes partenaires pour lesquels vous disputiez ?" » Le miroir me montre le Jour dernier. Les partners invoqués seront absents. Ceux qui les adoraient seront couverts de honte. La question divine sera sans réponse. Le miroir m'interroge : qui sont mes partners ? Seront-ils là le Jour du Jugement ?`,
  reflection: `Les partners disparaîtront le Jour dernier. Seul Allah demeure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yawma al-qiyamati yukhzihim wa yaqulu ayna shuraka'i alladhina kuntum tushiqqun » — Puis, le Jour de la Résurrection, Il les couvrira d'ignominie et dira : 'Où sont Mes partenaires pour lesquels vous disputiez ?'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes partners ? Où seront-ils le Jour du Jugement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute d'aujourd'hui deviendra le silence de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui est adoré en dehors d'Allah disparaîtra. Seul Allah est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a pas de partners aujourd'hui n'aura pas de honte demain." }
  ],
  munajat: `Ya Wahid, Tu es le seul digne d'adoration. Ne laisse pas mon cœur s'attacher à des partners qui disparaîtront. Fais que je T'adore seul.`
};

MIROIR["16:28"] = {
  reference: "16:28",
  theme: ["mort", "anges", "injustice"],
  emotion: "Sérieux, avertissement",
  difficulty: "débutant",
  relatedNames: ["Malak al-Mawt", "Al-'Adl"],
  mirrorVersion: `« Ceux dont les anges reprennent l'âme alors qu'ils sont injustes envers eux-mêmes... » Le miroir me montre le moment de la mort. Les anges viennent prendre l'âme de ceux qui se sont fait du tort à eux-mêmes. L'injustice envers soi-même, c'est l'incrédulité et le péché. Le miroir m'interroge : est-ce que je suis injuste envers moi-même ?`,
  reflection: `L'injustice envers soi-même est la plus grave. Se priver de la guidance, c'est se nuire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina tatawaffahumu al-mala'ikatu zalamu anfusahum » — Ceux dont les anges reprennent l'âme alors qu'ils sont injustes envers eux-mêmes..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je injuste envers moi-même ? Est-ce que je me prive de la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plus grande injustice est de se priver de la miséricorde d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort vient pour tous. Seule la préparation diffère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste envers lui-même se prépare pour la mort." }
  ],
  munajat: `Ya 'Adl, garde-moi d'être injuste envers moi-même. Prépare-moi pour le moment où les anges viendront. Fais que mon âme soit en paix.`
};

MIROIR["16:29"] = {
  reference: "16:29",
  theme: ["enfer", "entrée", "séjour"],
  emotion: "Avertissement, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Muntaqim"],
  mirrorVersion: `« Entrez donc par les portes de l'Enfer pour y demeurer éternellement. » Le miroir me montre la destination finale des injustes. Les portes de l'Enfer s'ouvrent pour ceux qui se sont fait du tort. Le séjour est éternel. Le miroir m'interroge : quelle est ma destination ? Vers quelle porte je me dirige ?`,
  reflection: `L'Enfer est une réalité. Les portes s'ouvrent pour ceux qui les choisissent par leurs actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fadkhulu abwaba jahannama khalidina fiha » — Entrez donc par les portes de l'Enfer pour y demeurer éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quelle porte je me dirige ? Celle du Paradis ou de l'Enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les portes de l'Enfer s'ouvrent pour ceux qui les ont choisies." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vie est un chemin vers une destination éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer le fuit vers le Paradis." }
  ],
  munajat: `Ya Rabb, garde-moi des portes de l'Enfer. Guide-moi vers les portes du Paradis. Fais que je ne sois pas parmi ceux qui entrent par les portes du feu.`
};

MIROIR["16:30"] = {
  reference: "16:30",
  theme: ["paradis", "récompense", "question"],
  emotion: "Espoir, récompense",
  difficulty: "débutant",
  relatedNames: ["Al-Janna", "Al-Karim"],
  mirrorVersion: `« Et il sera dit à ceux qui avaient craint Allah : "Qu'a fait descendre votre Seigneur ?" Ils répondront : "Un bien." » Le miroir me montre la réponse des croyants. Quand on leur demande ce qu'Allah a révélé, ils répondent : "Un bien." Cette simplicité révèle la foi. Le Coran est un bien pour ceux qui le reçoivent avec le cœur ouvert. Le miroir m'interroge : comment est-ce que je décris le Coran ?`,
  reflection: `Le Coran est un bien pour ceux qui craignent Allah. Sa réception dépend de l'état du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qila lilladhina ittaqaw ma dhara'a rabbukum qalu khayran » — Et il sera dit à ceux qui avaient craint Allah : 'Qu'a fait descendre votre Seigneur ?' Ils répondront : 'Un bien.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je décris le Coran ? Comme un bien ou comme une contrainte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est bien pour le croyant est légende pour le mécréant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Parole de Dieu est bénédiction pour ceux qui la reçoivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le Coran comme un bien le reçoit comme un trésor." }
  ],
  munajat: `Ya Karim, Ton Coran est un bien. Ouvre mon cœur pour le recevoir comme tel. Fais que je le voie comme la plus grande bénédiction.`
};

// ==================== SURAH 8: AL-ANFAL - COMPLETE COVERAGE ====================

MIROIR["8:7"] = {
  reference: "8:7",
  theme: ["promesse", "victoire", "foi"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'ud", "An-Nasir"],
  mirrorVersion: `« Et quand Allah vous promettait qu'une des deux bandes serait à vous, et que vous auriez aimé vous emparer de celle qui était sans armes. » Le miroir me montre la préférence humaine face à la promesse divine. Les croyants voulaient le butin facile, mais Allah voulait la victoire par la bataille. La promesse d'Allah était vraie, mais le chemin était différent de ce qu'ils espéraient. Le miroir m'interroge : est-ce que j'accepte le chemin d'Allah même quand il diffère de mes désirs ?`,
  reflection: `La promesse d'Allah est toujours accomplie, mais pas toujours comme nous l'imaginons. Sa sagesse dépasse nos préférences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh ya'idukumu Allahu ihda al-ta'ifatayni annaha lakum » — et quand Allah vous promettait qu'une des deux bandes serait à vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que le chemin d'Allah soit différent du mien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire facile n'est pas toujours la meilleure. L'épreuve fortifie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accomplit la promesse divine, mais selon Ses voies, pas nos préférences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le chemin d'Allah reçoit plus que ce qu'il espérait." }
  ],
  munajat: `Ya Wa'ud, Ta promesse est vraie. Aide-moi à accepter Ton chemin même quand il diffère du mien. Fais que je fasse confiance à Ta sagesse.`
};

MIROIR["8:8"] = {
  reference: "8:8",
  theme: ["vérité", "justice", "islam"],
  emotion: "Détermination, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Qahhar"],
  mirrorVersion: `« Afin que la vérité triomphe et que le faux disparaisse, même si cela déplaît aux criminels. » Le miroir me montre l'objectif divin. « Li-yuhqqa al-haqq » — afin que la vérité triomphe. « Wa yabtula al-batil » — et que le faux disparaisse. Le but d'Allah est la vérité, pas notre confort. Les criminels détestent cela. Le miroir m'interroge : suis-je du côté de la vérité ou de mon confort ?`,
  reflection: `La vérité finit par triompher. Le faux finit par disparaître. C'est une promesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yuhqqa al-haqq wa yabtula al-batil » — afin que la vérité triomphe et que le faux disparaisse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défends la vérité même quand c'est difficile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le triomphe de la vérité peut déplaire. Mais elle triomphe quand même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est régi par la vérité. Le mensonge ne peut pas durer éternellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend la vérité participe au dessein divin." }
  ],
  munajat: `Ya Haqq, Tu fais triompher la vérité. Place-moi du côté de la vérité. Ne permets pas que je préfère mon confort à Ta vérité.`
};

MIROIR["8:10"] = {
  reference: "8:10",
  theme: ["secours", "anges", "foi"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Mala'ika"],
  mirrorVersion: `« Et Allah ne fit cela que comme une bonne nouvelle et pour que vos cœurs s'en rassurent. » Le miroir me montre le secours divin. Les anges furent envoyés comme bonne nouvelle, comme réconfort. Le secours d'Allah vient pour rassurer les cœurs. Le miroir m'interroge : est-ce que mon cœur est rassuré par le secours d'Allah ?`,
  reflection: `Le secours divin est une bonne nouvelle. Il rassure les cœurs des croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ja'alahu Allahu illa bushra wa li-tatma'inna qulubukum » — et Allah ne fit cela que comme bonne nouvelle et pour que vos cœurs s'en rassurent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand Allah m'aide, est-ce que mon cœur est rassuré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secours vient d'Allah, pas des anges eux-mêmes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges participent à l'ordre divin. Ils sont les messagers du secours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est rassuré par Allah n'a pas peur." }
  ],
  munajat: `Ya Nasir, Tu envoies le secours. Rassure mon cœur par Ta présence. Ne permets pas que la peur m'envahisse.`
};

MIROIR["8:12"] = {
  reference: "8:12",
  theme: ["bataille", "anges", "fermeté"],
  emotion: "Courage, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "Al-'Aziz"],
  mirrorVersion: `« Quand ton Seigneur inspirait aux anges : Je suis avec vous. Rendez fermes ceux qui croient. » Le miroir me montre l'inspiration divine. Allah inspirait aux anges de rendre fermes les croyants. La fermeté vient d'Allah. Le miroir m'interroge : est-ce que je suis ferme dans ma foi ?`,
  reflection: `La fermeté des croyants vient d'Allah. Lui seul peut affermir les cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh yuhi rabbuka ila al-mala'ikati anni ma'akum fa-thabbitu alladhina amanu » — quand ton Seigneur inspirait aux anges : Je suis avec vous. Rendez fermes ceux qui croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande à Allah de m'affermir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeté n'est pas humaine — elle est divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par la fermeté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est affermi par Allah ne fléchit pas." }
  ],
  munajat: `Ya Qawiyy, affermis mon cœur. Ne permets pas que je fléchisse devant les épreuves. Donne-moi la fermeté de la foi.`
};

MIROIR["8:13"] = {
  reference: "8:13",
  theme: ["châtiment", "opposition", "justice"],
  emotion: "Crainte, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Muntaqim"],
  mirrorVersion: `« C'est que celui qui s'oppose à Allah et à Son messager sera châtié. » Le miroir me montre la conséquence de l'opposition. « Man yuhadid » — celui qui s'oppose. L'opposition à Allah et à Son messager mène au châtiment. Le miroir m'interroge : est-ce que je m'oppose à Allah ?`,
  reflection: `L'opposition à Allah a des conséquences. La justice divine est inévitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-annahu man yuhadid Allaha wa rasulahu » — c'est que celui qui s'oppose à Allah et à Son messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'oppose à Allah par mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'opposition apparente cache souvent la peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah. L'opposition est futile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'oppose à Allah s'oppose à lui-même." }
  ],
  munajat: `Ya Hakam, Tu juges avec justice. Préserve-moi de T'opposer. Guide-moi vers l'obéissance.`
};

MIROIR["8:14"] = {
  reference: "8:14",
  theme: ["châtiment", "enfer", "mécréance"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Qahhar"],
  mirrorVersion: `« Voilà le châtiment de l'Enfer. » Le miroir me montre la réalité du châtiment. « Dhalika 'adhabu al-nar » — voilà le châtiment de l'Enfer. L'Enfer est une réalité. Le miroir m'interroge : est-ce que je crains l'Enfer ?`,
  reflection: `L'Enfer est une réalité. Le châtiment est pour ceux qui s'opposent à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika 'adhabu al-nar » — voilà le châtiment de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains l'Enfer ? Est-ce que je fais tout pour l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'Enfer est le résultat du choix, pas une fatalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer existe dans la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer ici-bas ne le verra pas là-bas." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'Enfer. Donne-moi la crainte qui mène à l'obéissance. Fais que je n'y entre jamais.`
};

MIROIR["8:16"] = {
  reference: "8:16",
  theme: ["fuite", "bataille", "colère"],
  emotion: "Vigilance, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghadab", "Al-'Adl"],
  mirrorVersion: `« Quiconque ce jour-là leur tourne le dos, à moins qu'il ne se retourne pour combattre ou pour rejoindre un groupe, encourt la colère d'Allah. » Le miroir me montre la gravité de la fuite. Tourner le dos à l'ennemi sans raison valable attire la colère d'Allah. Le courage n'est pas une option — c'est une obligation. Le miroir m'interroge : est-ce que je fuis mes responsabilités ?`,
  reflection: `La fuite sans raison valable est blâmable. Le courage est exigé du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yuwallihim yawma'idhin duburahu illa mutaharrifan li-qitalin aw mutahayyizan ila fi'atin » — quiconque ce jour-là leur tourne le dos, à moins qu'il ne se retourne pour combattre ou pour rejoindre un groupe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis mes responsabilités ? Est-ce que je manque de courage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La retraite stratégique n'est pas la fuite lâche." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le courage est universellement honoré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui affronte avec Allah ne perd jamais." }
  ],
  munajat: `Ya Rabb, donne-moi le courage. Ne permets pas que je fuie mes responsabilités. Fais que je fasse face avec confiance en Toi.`
};

MIROIR["8:18"] = {
  reference: "8:18",
  theme: ["victoire", "grâce", "reconnaissance"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Mannan"],
  mirrorVersion: `« Cela est ainsi, et qu'Allah est le dissipateur des ruses des mécréants. » Le miroir me montre la protection divine. « Mubtilu kaydi al-kafirin » — le dissipateur des ruses des mécréants. Allah neutralise les complots. Le miroir m'interroge : est-ce que je fais confiance à la protection d'Allah ?`,
  reflection: `Allah dissipe les ruses des mécréants. Sa protection est suffisante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalikum wa anna Allaha mubtilu kaydi al-kafirin » — cela est ainsi, et qu'Allah est le dissipateur des ruses des mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les complots des autres ? Ou est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ruses des hommes sont impuissantes face à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est protégé par Allah contre les complots." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repose sur Allah n'a peur d'aucun complot." }
  ],
  munajat: `Ya Mubtil, Tu dissipes les ruses. Protège-moi des complots. Fais que je Te fasse confiance entièrement.`
};

MIROIR["8:19"] = {
  reference: "8:19",
  theme: ["jugement", "victoire", "mécréance"],
  emotion: "Lucidité, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Hakam"],
  mirrorVersion: `« Si vous cherchiez un jugement, le jugement est venu. » Le miroir me montre la réponse divine. « In tastaftihu fa-qad ja'akum al-fath » — si vous cherchiez un jugement, le jugement est venu. Les mécréants demandaient une décision, et Allah l'a donnée — contre eux. Le miroir m'interroge : est-ce que je demande vraiment le jugement d'Allah ?`,
  reflection: `Le jugement d'Allah vient quand on le demande. Mais pas toujours comme on l'espère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tastaftihu fa-qad ja'akum al-fath » — si vous cherchiez un jugement, le jugement est venu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande le jugement d'Allah ? Ou est-ce que je crains Sa décision ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement demandé peut être contre nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est soumis au jugement d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le jugement d'Allah en paix." }
  ],
  munajat: `Ya Fattah, Tu juges avec justice. Je me soumets à Ton jugement. Fais que Ta décision soit en ma faveur par Ta miséricorde.`
};

MIROIR["8:20"] = {
  reference: "8:20",
  theme: ["obéissance", "messager", "écoute"],
  emotion: "Soumission, respect",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "As-Sami'"],
  mirrorVersion: `« Ô vous qui croyez ! Obéissez à Allah et à Son messager, et ne vous détournez pas de lui pendant que vous l'entendez. » Le miroir me montre l'obéissance requise. « Ati'u Allaha wa rasulahu » — obéissez à Allah et à Son messager. L'obéissance est la marque de la foi. Le miroir m'interroge : est-ce que j'obéis au messager d'Allah ?`,
  reflection: `L'obéissance au messager est l'obéissance à Allah. Les deux sont liées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu ati'u Allaha wa rasulahu wa la tawallaw 'anhu wa antum tasma'un » — ô vous qui croyez ! Obéissez à Allah et à Son messager, et ne vous détournez pas de lui pendant que vous l'entendez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis au Coran ? Ou est-ce que je me détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance n'est pas contrainte — elle est libération." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur. L'homme a le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit au messager obéit à Allah." }
  ],
  munajat: `Ya Rabb, je veux obéir. Fais que je ne me détourne pas du Coran. Donne-moi l'obéissance sincère.`
};

MIROIR["8:21"] = {
  reference: "8:21",
  theme: ["hypocrisie", "écoute", "obéissance"],
  emotion: "Vigilance, sincérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Basir"],
  mirrorVersion: `« Ne soyez pas comme ceux qui disent : Nous entendons, alors qu'ils n'entendent pas. » Le miroir me montre l'hypocrisie. Dire « j'entends » sans vraiment entendre. Le miroir m'interroge : est-ce que j'entends vraiment le Coran ?`,
  reflection: `L'audition véritable est l'audition qui mène à l'action. Le reste est hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la takunu ka-alladhina qalu sami'na wa hum la yasma'un » — ne soyez pas comme ceux qui disent : Nous entendons, alors qu'ils n'entendent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends le Coran avec mon cœur ? Ou seulement avec mes oreilles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'audition sans obéissance est sourdement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entend et obéit. L'homme prétend entendre et désobéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend vraiment agit." }
  ],
  munajat: `Ya Sami', fais que j'entende vraiment. Ne permets pas que je sois comme ceux qui disent entendre mais n'entendent pas.`
};

MIROIR["8:22"] = {
  reference: "8:22",
  theme: ["pire", "bétail", "raison"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khaliq"],
  mirrorVersion: `« Les pires bêtes auprès d'Allah sont les sourds et muets qui ne raisonnent pas. » Le miroir me montre le classement divin. « Sharra al-dawabb » — les pires bêtes. Ceux qui n'utilisent pas leur raison sont pires que les animaux. Le miroir m'interroge : est-ce que j'utilise ma raison pour comprendre ?`,
  reflection: `La raison est un don d'Allah. Ne pas l'utiliser est ingrat et dangereux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna sharra al-dawabb 'inda Allahi al-summu al-bukmu alladhina la ya'qilun » — les pires bêtes auprès d'Allah sont les sourds et muets qui ne raisonnent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je raisonne ? Est-ce que je réfléchis sur le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'animal ne peut pas raisonner. L'homme peut mais ne veut pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rationnel. L'homme qui ne raisonne pas le rejette." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui raisonne accède à la compréhension divine." }
  ],
  munajat: `Ya Hakim, Tu m'as donné la raison. Fais que je l'utilise pour Te comprendre. Ne permets pas que je sois pire que les animaux.`
};

MIROIR["8:23"] = {
  reference: "8:23",
  theme: ["guidance", "obstacle", "mécréance"],
  emotion: "Compréhension, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mani'"],
  mirrorVersion: `« Si Allah avait reconnu en eux quelque bien, Il leur aurait fait entendre. Et s'Il leur avait fait entendre, ils auraient tourné le dos en s'éloignant. » Le miroir me montre la connaissance divine. « Law 'alima Allahu fihim khayran » — si Allah avait reconnu en eux quelque bien. Allah sait qui peut être guidé. Le miroir m'interroge : y a-t-il du bien en moi pour entendre la guidance ?`,
  reflection: `Allah connaît les cœurs. Il guide ceux qui ont du bien en eux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law 'alima Allahu fihim khayran la-asma'ahum » — si Allah avait reconnu en eux quelque bien, Il leur aurait fait entendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'il y a du bien en moi pour recevoir la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence de guidance peut être un signe de l'état du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est donnée selon la capacité du récepteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a du bien en lui reçoit la guidance." }
  ],
  munajat: `Ya Hadi, Tu connais les cœurs. Fais qu'il y ait du bien en moi. Guide-moi vers Ton chemin.`
};

MIROIR["8:25"] = {
  reference: "8:25",
  theme: ["épreuve", "justice", "société"],
  emotion: "Vigilance, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Khabir"],
  mirrorVersion: `« Et craignez une épreuve qui n'atteindra pas seulement les injustes parmi vous. » Le miroir me montre la responsabilité collective. « Fitnatin » — une épreuve. « La tusibanna alladhina zalamu minkum khassatan » — qui n'atteindra pas seulement les injustes parmi vous. L'épreuve touche tout le monde, pas seulement les coupables. Le miroir m'interroge : est-ce que je corrige le mal autour de moi ?`,
  reflection: `Le mal non corrigé touche toute la société. La responsabilité est collective.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ittaqu fitnatan la tusibanna alladhina zalamu minkum khassatan » — et craignez une épreuve qui n'atteindra pas seulement les injustes parmi vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je corrige le mal autour de moi ? Ou est-ce que je laisse faire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le silence face au mal est complicité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve touche toute la création quand l'équilibre est rompu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui corrige le mal se protège et protège les autres." }
  ],
  munajat: `Ya 'Adl, l'épreuve touche tout le monde. Donne-moi le courage de corriger le mal. Ne permets pas que je sois complice par mon silence.`
};

MIROIR["8:26"] = {
  reference: "8:26",
  theme: ["mémoire", "gratitude", "protection"],
  emotion: "Reconnaissance, humilité",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Mannan"],
  mirrorVersion: `« Et rappelez-vous quand vous étiez peu nombreux et opprimés sur la terre. » Le miroir me montre l'importance de la mémoire. « Wa udhkuru » — et rappelez-vous. Le rappel des bienfaits passés renforce la gratitude. Les musulmans étaient faibles, et Allah les a fortifiés. Le miroir m'interroge : est-ce que je me souviens des bienfaits d'Allah ?`,
  reflection: `La mémoire des bienfaits passés renforce la confiance en Allah pour l'avenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa udhkuru idh kuntum qalilan fa-staktharakum » — et rappelez-vous quand vous étiez peu nombreux et opprimés sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens d'où je viens ? Des bienfaits d'Allah sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli des bienfaits est ingrat. Le rappel est gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est témoin des bienfaits d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient reconnaît la main d'Allah dans sa vie." }
  ],
  munajat: `Ya Mannan, Tu m'as tant donné. Fais que je me souvienne de Tes bienfaits. Ne permets pas que je sois ingrat.`
};

MIROIR["8:27"] = {
  reference: "8:27",
  theme: ["trahison", "confiance", "responsabilité"],
  emotion: "Vigilance, intégrité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amin", "Al-Wakil"],
  mirrorVersion: `« Ô vous qui croyez ! Ne trahissez pas Allah et le messager. » Le miroir me montre la gravité de la trahison. « La takhunu Allaha wa al-rasul » — ne trahissez pas Allah et le messager. La trahison est grave. Elle peut concerner les dépôts, les secrets, les responsabilités. Le miroir m'interroge : est-ce que je suis digne de confiance ?`,
  reflection: `La trahison est un grave péché. Le croyant est digne de confiance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la takhunu Allaha wa al-rasul » — ô vous qui croyez ! Ne trahissez pas Allah et le messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis digne de confiance ? Est-ce que je garde les dépôts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La trahison de la confiance est auto-destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fondé sur la confiance. La trahison le détruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est digne de confiance reflète la fidélité d'Allah." }
  ],
  munajat: `Ya Amin, Tu es le Fidèle. Fais que je sois digne de confiance. Ne permets pas que je trahisse ceux qui me font confiance.`
};

MIROIR["8:28"] = {
  reference: "8:28",
  theme: ["famille", "épreuve", "attachement"],
  emotion: "Lucidité, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Baliyy"],
  mirrorVersion: `« Et sachez que vos biens et vos enfants sont une épreuve. » Le miroir me montre la nature des attachements. « Fitnatan » — une épreuve. Les biens et les enfants sont des épreuves. Ils peuvent éloigner d'Allah ou rapprocher de Lui. Le miroir m'interroge : mes biens et mes enfants me rapprochent-ils d'Allah ou m'en éloignent-ils ?`,
  reflection: `Les biens et les enfants sont des tests. Ils révèlent l'état du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'lamu annama amwalukum wa awladukum fitnatun » — et sachez que vos biens et vos enfants sont une épreuve." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes biens et mes enfants me rapprochent d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve peut être bénédiction si elle est bien gérée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est test pour l'être humain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui gère bien l'épreuve en tire un bien." }
  ],
  munajat: `Ya Hakim, mes biens et mes enfants sont des tests. Fais qu'ils me rapprochent de Toi. Ne permets pas qu'ils m'en éloignent.`
};

MIROIR["8:30"] = {
  reference: "8:30",
  theme: ["complot", "protection", "exil"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Khayr"],
  mirrorVersion: `« Et quand les mécréants complotaient contre toi pour t'emprisonner ou te tuer ou te bannir. » Le miroir me montre les complots contre le Prophète. « Yamkuruna » — ils complotaient. Les ennemis voulaient tuer le Prophète. Mais Allah l'a protégé. Le miroir m'interroge : est-ce que je fais confiance à la protection d'Allah ?`,
  reflection: `Les complots des hommes échouent face à la protection d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh yamkuru bika alladhina kafaru li-yuthbituka aw yaqtuluka aw yukhrijuka » — et quand les mécréants complotaient contre toi pour t'emprisonner ou te tuer ou te bannir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les complots ? Ou est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le complot des hommes devient l'accomplissement du plan divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est sous le contrôle d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est protégé par Allah ne peut être atteint." }
  ],
  munajat: `Ya Hafiz, Tu as protégé Ton Prophète. Protège-moi aussi des complots. Fais que je me confie en Toi.`
};

MIROIR["8:31"] = {
  reference: "8:31",
  theme: ["coran", "mensonge", "orgueil"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khabir"],
  mirrorVersion: `« Et quand Nos versets leur étaient récités, ils disaient : Nous avons entendu. Si nous voulions, nous dirions pareil. » Le miroir me montre l'orgueil des mécréants. « Law nasha'u la-qulna mithla hadha » — si nous voulions, nous dirions pareil. Ils prétendaient pouvoir produire un livre semblable au Coran. Mais ils n'ont jamais pu. Le miroir m'interroge : est-ce que je reconnais le Coran comme parole d'Allah ?`,
  reflection: `Le Coran est inimitable. L'orgueil humain refuse de l'admettre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha tutla 'alayhim ayatuna qalu qad sami'na law nasha'u la-qulna mithla hadha » — et quand Nos versets leur étaient récités, ils disaient : Nous avons entendu. Si nous voulions, nous dirions pareil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la grandeur du Coran ? Ou est-ce que je le minimise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention humaine est vaine face à la parole divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran reste inégalé depuis 1400 ans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Coran y trouve la guidance." }
  ],
  munajat: `Ya Haqq, le Coran est Ta parole. Fais que je le reconnaisse comme tel. Ne permets pas que l'orgueil m'aveugle.`
};

MIROIR["8:32"] = {
  reference: "8:32",
  theme: ["défi", "châtiment", "mécréance"],
  emotion: "Crainte, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Hakam"],
  mirrorVersion: `« Et quand ils dirent : Ô Allah, si c'est la vérité de Ta part, fais pleuvoir du ciel des pierres sur nous. » Le miroir me montre le défi audacieux. « Fa-amtir 'alayna hijaratan » — fais pleuvoir sur nous des pierres. Ils défiaient Allah de les punir. Et Allah les a punis à Badr. Le miroir m'interroge : est-ce que je défie Allah ?`,
  reflection: `Le défi à Allah mène au châtiment. L'audace humaine a des limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qalu Allahumma in kana hadha huwa al-haqqa min 'indika fa-amtir 'alayna hijaratan » — et quand ils dirent : Ô Allah, si c'est la vérité de Ta part, fais pleuvoir du ciel des pierres sur nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défie Allah ? Est-ce que je demande Sa punition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le défi obtient parfois ce qu'il demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire regorge de peuples punis pour leur défi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte Allah est respecté par Lui." }
  ],
  munajat: `Ya Qadir, je ne veux pas Te défier. Je me soumets à Ta volonté. Préserve-moi du châtiment.`
};

MIROIR["8:34"] = {
  reference: "8:34",
  theme: ["mosquée", "interdiction", "châtiment"],
  emotion: "Lucidité, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bayt", "Al-Mani'"],
  mirrorVersion: `« Mais pourquoi Allah ne les châtierait-Il pas alors qu'ils empêchent l'accès à la Mosquée sacrée ? » Le miroir me montre le crime des Quraysh. « Yasudduna 'an al-masjid al-haram » — ils empêchent l'accès à la Mosquée sacrée. Empêcher les croyants d'adorer est un crime grave. Le miroir m'interroge : est-ce que j'empêche les autres d'adorer Allah ?`,
  reflection: `L'interdiction de l'adoration est un grave péché. La Mosquée sacrée est pour tous les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma lahum alla yu'adhdhibahumu Allahu wa hum yasudduna 'an al-masjid al-haram » — mais pourquoi Allah ne les châtierait-Il pas alors qu'ils empêchent l'accès à la Mosquée sacrée ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'empêche les autres d'adorer Allah ? De quelque manière que ce soit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction de l'adoration révèle la haine du vrai." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Mosquée sacrée est le centre spirituel du monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui facilite l'adoration est aimé d'Allah." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'empêche quiconque de T'adorer. Fais que je facilite l'accès à Tes mosquées.`
};

MIROIR["8:35"] = {
  reference: "8:35",
  theme: ["adoration", "sincérité", "mécréance"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'bud", "Al-Basir"],
  mirrorVersion: `« Et leur prière, devant la Maison, n'est que sifflements et battements de mains. » Le miroir me montre la fausse adoration. « Muk'an wa tasdiyatan » — sifflements et battements de mains. Les mécréants faisaient semblant d'adorer, mais c'était du bruit, pas de la prière. Le miroir m'interroge : ma prière est-elle sincère ou est-ce du bruit ?`,
  reflection: `La prière sans sincérité n'est que bruit. Allah regarde le cœur, pas les gestes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana salatuhum 'inda al-bayt illa muk'an wa tasdiyatan » — et leur prière, devant la Maison, n'est que sifflements et battements de mains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma prière est-elle sincère ? Ou est-ce que je fais semblant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bruit de la fausse prière contraste avec le silence du cœur vrai." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration véritable est universelle. La fausse adoration est vide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec le cœur touche Allah." }
  ],
  munajat: `Ya Basir, Tu vois le cœur. Fais que ma prière soit sincère. Ne permets pas que je prie par habitude sans présence.`
};

MIROIR["8:36"] = {
  reference: "8:36",
  theme: ["dépense", "regret", "mécréance"],
  emotion: "Lucidité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaniyy", "Al-Hakim"],
  mirrorVersion: `« Ceux qui ne croient pas dépensent leurs biens pour éloigner du chemin d'Allah. » Le miroir me montre l'investissement des mécréants. « Yunfiquna amwalahum » — ils dépensent leurs biens. Ils dépensent pour combattre l'islam. Mais leur dépense sera source de regret. Le miroir m'interroge : comment est-ce que je dépense mes biens ?`,
  reflection: `Les biens dépensés contre la vérité sont perdus. L'investissement dans le faux mène au regret.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru yunfiquna amwalahum li-yasuddu 'an sabil Allah » — ceux qui ne croient pas dépensent leurs biens pour éloigner du chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je dépense mes biens ? Pour Allah ou contre Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dépense dans le faux devient regret dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'investissement dans le bien est éternel. Celui dans le mal est perdu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépense pour Allah reçoit au-delà de son investissement." }
  ],
  munajat: `Ya Ghaniyy, je veux dépenser pour Toi. Fais que mes dépenses soient dans le chemin du bien. Ne permets pas que je regrette mes dépenses.`
};

MIROIR["8:37"] = {
  reference: "8:37",
  theme: ["séparation", "jugement", "vérité"],
  emotion: "Lucidité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Fasil", "Al-Hakam"],
  mirrorVersion: `« Afin qu'Allah distingue le mauvais du bon. » Le miroir me montre le but des épreuves. « Li-yamiza Allahu al-khabith min al-tayyib » — afin qu'Allah distingue le mauvais du bon. Les épreuves révèlent les vrais croyants. Le miroir m'interroge : suis-je du côté du bon ou du mauvais ?`,
  reflection: `Les épreuves séparent les cœurs. Elles révèlent la vérité de chaque personne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yamiza Allahu al-khabith min al-tayyib » — afin qu'Allah distingue le mauvais du bon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'épreuve révèle qui je suis vraiment. Que révèle-t-elle sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La séparation est douloureuse mais nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers trie le bon grain de l'ivraie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est du côté du bien n'a pas peur de la séparation." }
  ],
  munajat: `Ya Fasil, Tu sépares le bon du mauvais. Place-moi du côté du bon. Fais que l'épreuve révèle ma foi.`
};

MIROIR["8:38"] = {
  reference: "8:38",
  theme: ["pardon", "conversion", "miséricorde"],
  emotion: "Espoir, invitation",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "At-Tawwab"],
  mirrorVersion: `« Dis à ceux qui ne croient pas que s'ils cessent, leur passé leur sera pardonné. » Le miroir me montre l'offre divine. « Fa-in yantahu yughfar lahum ma qad salaf » — s'ils cessent, leur passé leur sera pardonné. La porte du pardon est ouverte. Le miroir m'interroge : est-ce que j'accepte le pardon d'Allah ?`,
  reflection: `Le pardon est offert à ceux qui se repentent. La miséricorde d'Allah est immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul lilladhina kafaru in yantahu yughfar lahum ma qad salaf » — dis à ceux qui ne croient pas que s'ils cessent, leur passé leur sera pardonné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le pardon d'Allah ? Ou est-ce que je persiste dans le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon est offert même pour le passé le plus lourd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le pardon commence une vie nouvelle." }
  ],
  munajat: `Ya Ghafur, Tu offres le pardon. J'accepte Ton offre. Pardonne mon passé et guide mon avenir.`
};

MIROIR["8:40"] = {
  reference: "8:40",
  theme: ["refuge", "protecteur", "alliance"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Mawla", "An-Nasir"],
  mirrorVersion: `« Et s'ils tournent le dos, sachez qu'Allah est votre Maître. Quel excellent Maître et quel excellent Protecteur ! » Le miroir me montre le refuge divin. « Allahu mawlakum » — Allah est votre Maître. « Ni'ma al-mawla wa ni'ma al-nasir » — quel excellent Maître et quel excellent Protecteur ! Quand les hommes nous abandonnent, Allah reste. Le miroir m'interroge : est-ce qu'Allah est mon refuge ?`,
  reflection: `Allah est le meilleur Maître et Protecteur. Son alliance ne faillit jamais.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yatawallaw fa'lamu anna Allaha mawlakum ni'ma al-mawla wa ni'ma al-nasir » — et s'ils tournent le dos, sachez qu'Allah est votre Maître. Quel excellent Maître et quel excellent Protecteur !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand les autres m'abandonnent, est-ce qu'Allah est mon refuge ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon des hommes révèle la fidélité d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Maître de l'univers. Il protège qui Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah comme Maître n'a besoin de personne d'autre." }
  ],
  munajat: `Ya Mawla, Tu es mon Maître. Sois mon refuge quand les autres m'abandonnent. Je me confie entièrement à Toi.`
};

MIROIR["8:41"] = {
  reference: "8:41",
  theme: ["butin", "droit", "distribution"],
  emotion: "Justice, ordre",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qasim", "Al-'Adl"],
  mirrorVersion: `« Et sachez que de tout butin que vous prenez, le cinquième appartient à Allah. » Le miroir me montre la répartition du butin. « Khumusu li-Allahi » — le cinquième appartient à Allah. Le butin n'appartient pas entièrement au vainqueur. Une partie revient à Allah, au Prophète, aux proches, aux orphelins, aux pauvres. Le miroir m'interroge : est-ce que je partage mes gains avec ceux qui en ont besoin ?`,
  reflection: `Le partage du butin établit la justice sociale. Les pauvres ont droit à une part.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'lamu annama ghanimtum min shay'in fa-inna li-Allahi khumusahu » — et sachez que de tout butin que vous prenez, le cinquième appartient à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je partage mes gains avec les pauvres et les orphelins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le partage n'est pas perte — c'est investissement dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'abondance est un test de partage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage reçoit plus qu'il ne donne." }
  ],
  munajat: `Ya Qasim, Tu m'as donné. Aide-moi à partager. Fais que je n'oublie pas les pauvres et les orphelins.`
};

MIROIR["8:42"] = {
  reference: "8:42",
  theme: ["mémoire", "bataille", "victoire"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nasir", "Al-Fattah"],
  mirrorVersion: `« Quand vous étiez sur le versant le plus proche et eux sur le versant le plus éloigné. » Le miroir me rappelle la bataille de Badr. Les positions des armées. Les musulmans étaient peu nombreux, les mécréants nombreux. Mais Allah a donné la victoire. Le miroir m'interroge : est-ce que je me souviens des moments où Allah m'a sauvé ?`,
  reflection: `La victoire de Badr est un miracle. Peu contre beaucoup, avec Allah le petit nombre triomphe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh antum bi-al-'udwati al-dunya wa hum bi-al-'udwati al-quswa » — quand vous étiez sur le versant le plus proche et eux sur le versant le plus éloigné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens des victoires qu'Allah m'a données ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La position géographique n'importe pas — la position spirituelle compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de victoires improbables par la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient des victoires passées a confiance dans l'avenir." }
  ],
  munajat: `Ya Nasir, Tu m'as donné des victoires. Fais que je m'en souvienne. Renforce ma confiance en Toi.`
};

MIROIR["8:43"] = {
  reference: "8:43",
  theme: ["rêve", "réconfort", "victoire"],
  emotion: "Espoir, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'ammil", "As-Sadiq"],
  mirrorVersion: `« Quand Allah te les montrait en songe peu nombreux. » Le miroir me montre le rêve du Prophète. « Yurikahum Allahu fi manamika qalilan » — Allah te les montrait en songe peu nombreux. Le rêve était un réconfort. Les ennemis semblaient peu nombreux. Le miroir m'interroge : est-ce que je fais confiance aux promesses d'Allah ?`,
  reflection: `Le rêve du Prophète était véridique. Allah réconforte Ses serviteurs avant l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh yurikahum Allahu fi manamika qalilan » — quand Allah te les montrait en songe peu nombreux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance aux promesses d'Allah ? Même quand je ne vois pas encore leur accomplissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rêve divin précède la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vision d'Allah est plus vraie que la réalité apparente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec les yeux d'Allah ne doute pas." }
  ],
  munajat: `Ya Mu'ammil, Tu donnes l'espoir. Fais que je voie avec Tes yeux. Renforce ma confiance en Tes promesses.`
};

MIROIR["8:44"] = {
  reference: "8:44",
  theme: ["perception", "victoire", "sagesse"],
  emotion: "Confiance, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khaliq"],
  mirrorVersion: `« Et quand Il vous les montrait, quand vous vous rencontriez, peu nombreux à vos yeux. » Le miroir me montre la perception modifiée. Allah a fait voir les ennemis peu nombreux aux croyants, pour les encourager. Et Il les a fait voir nombreux aux mécréants, pour les effrayer. La perception est entre les mains d'Allah. Le miroir m'interroge : est-ce que je réalise qu'Allah contrôle ce que je vois ?`,
  reflection: `La perception est un don d'Allah. Il montre ce qu'Il veut à qui Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh yurikumuhum idhi talaqtum fi a'yunikum qalilan » — et quand Il vous les montrait, quand vous vous rencontriez, peu nombreux à vos yeux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise qu'Allah contrôle ma perception ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je vois n'est pas toujours la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La réalité est ce qu'Allah veut qu'elle soit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec les yeux d'Allah voit la vérité." }
  ],
  munajat: `Ya Hakim, Tu contrôles ce que je vois. Fais que je voie la vérité. Ne permets pas que je me trompe par mes perceptions.`
};

MIROIR["8:45"] = {
  reference: "8:45",
  theme: ["patience", "prière", "victoire"],
  emotion: "Détermination, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Mu'izz"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous rencontrez une troupe, soyez fermes et invoquez beaucoup Allah. » Le miroir me montre la préparation spirituelle au combat. « Ithbiru wa akthiru al-dhikr » — soyez fermes et invoquez beaucoup. La fermeté et le dhikr sont les armes du croyant. Le miroir m'interroge : est-ce que j'invoque beaucoup Allah dans les moments difficiles ?`,
  reflection: `La fermeté et le dhikr sont les meilleures armes du croyant face à l'adversité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu idha laqitum fi'atan fa-ithbiru wa akthiru al-dhikr » — ô vous qui croyez ! Quand vous rencontrez une troupe, soyez fermes et invoquez beaucoup Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah dans les moments difficiles ? Ou est-ce que je panique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le dhikr calme le cœur et clarifie l'esprit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invocation est l'arme universelle contre la peur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah reçoit Sa présence." }
  ],
  munajat: `Ya Rabb, apprends-moi à invoquer beaucoup. Fais que le dhikr soit mon arme dans les moments difficiles. Donne-moi la fermeté.`
};

MIROIR["8:47"] = {
  reference: "8:47",
  theme: ["orgueil", "ostentation", "mécréance"],
  emotion: "Vigilance, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Basir"],
  mirrorVersion: `« Et ne soyez pas comme ceux qui sortirent de leurs demeures par ostentation. » Le miroir me montre l'orgueil des mécréants. « Bataran wa ri'a' » — par ostentation et par vanité. Ils sortirent pour se montrer, pas pour Allah. Le miroir m'interroge : mes actions sont-elles pour Allah ou pour être vu ?`,
  reflection: `L'ostentation annule la valeur des actions. Allah voit les intentions, pas les apparences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la takunu ka-alladhina kharaju min diyarihim bataran wa ri'a'a al-nas » — et ne soyez pas comme ceux qui sortirent de leurs demeures par ostentation et pour se montrer aux gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pourquoi est-ce que je fais ce que je fais ? Pour Allah ou pour être vu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ostentation cherche l'approbation des hommes, pas celle d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers agit sans ostentation. Il accomplit sa fonction simplement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit pour Allah seul est libre." }
  ],
  munajat: `Ya Basir, Tu vois mes intentions. Purifie-les. Fais que j'agisse pour Toi seul, pas pour être vu.`
};

MIROIR["8:48"] = {
  reference: "8:48",
  theme: ["satan", "illusion", "fuite"],
  emotion: "Lucidité, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khannas", "Al-Hadi"],
  mirrorVersion: `« Et quand Satan leur embellit leurs actions et dit : Nul ne peut vous vaincre aujourd'hui. » Le miroir me montre les promesses de Satan. « Zayyana lahum » — il leur embellit. Satan fait croire que le mal est bon, que la défaite est impossible. Puis il s'enfuit quand le danger arrive. Le miroir m'interroge : est-ce que je suis les illusions de Satan ?`,
  reflection: `Satan promet et ment. Il embellit le mal puis abandonne ses partisans.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh zayyana lahum al-shaytan a'malahum wa qala la ghaliba lakumu al-yawm » — et quand Satan leur embellit leurs actions et dit : Nul ne peut vous vaincre aujourd'hui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis les illusions de Satan ? Ou est-ce que je suis la vérité d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les promesses de Satan sont des mensonges déguisés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'illusion ne dure qu'un temps. La vérité reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les ruses de Satan ne s'y laisse pas prendre." }
  ],
  munajat: `Ya Hadi, préserve-moi des ruses de Satan. Fais que je voie la vérité derrière les illusions. Ne permets pas que je sois dupé.`
};

MIROIR["8:49"] = {
  reference: "8:49",
  theme: ["hypocrisie", "doute", "épreuve"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Fattah"],
  mirrorVersion: `« Quand les hypocrites et ceux qui ont la maladie dans le cœur disaient : Ceux-là, leur religion les égare. » Le miroir me montre le doute des hypocrites. « Fi qulubihim marad » — ceux qui ont la maladie dans le cœur. Les hypocrites doutaient de la victoire des musulmans. Ils pensaient que leur foi les aveuglait. Le miroir m'interroge : est-ce que j'ai la maladie du doute dans mon cœur ?`,
  reflection: `Le doute est une maladie du cœur. Il aveugle sur la réalité de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh yaqulu al-munafiquna wa alladhina fi qulubihim marad » — quand les hypocrites et ceux qui ont la maladie dans le cœur disaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai des doutes sur ma foi ? Sur la victoire d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute peut être guéri par la confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est la santé du cœur. Le doute est la maladie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guérit son doute trouve la paix." }
  ],
  munajat: `Ya Khabir, Tu connais les cœurs. Guéris mon cœur du doute. Fais que ma foi soit pure et solide.`
};

MIROIR["8:50"] = {
  reference: "8:50",
  theme: ["mort", "anges", "mécréance"],
  emotion: "Crainte, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Mawt"],
  mirrorVersion: `« Si tu voyais quand les anges arrachent les âmes des mécréants, les frappant sur les visages et les dos. » Le miroir me montre la mort des mécréants. « Yatabtishuna » — les frappant. Les anges frappent les mécréants au moment de la mort. La mort des mécréants est terrifiante. Le miroir m'interroge : comment sera ma mort ?`,
  reflection: `La mort des mécréants est douloureuse. La mort des croyants est paisible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law tara idh yatawaffa alladhina kafaru al-mala'ikatu yadribuna wujuhahum wa adbarahum » — si tu voyais quand les anges arrachent les âmes des mécréants, les frappant sur les visages et les dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment sera ma mort ? Est-ce que je me prépare pour une mort paisible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort révèle la vérité de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme goûtera à la mort. L'état de la mort dépend de l'état de la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en croyant meurt en paix." }
  ],
  munajat: `Ya Rabb, je veux mourir en paix. Prépare-moi à une bonne mort. Ne permets pas que je meurs comme un mécréant.`
};

MIROIR["8:51"] = {
  reference: "8:51",
  theme: ["conséquence", "responsabilité", "mécréance"],
  emotion: "Lucidité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Cela est pour ce que vos mains ont préparé. » Le miroir me montre la justice divine. « Bima qaddamat aydikum » — pour ce que vos mains ont préparé. Le châtiment n'est pas arbitraire. Il est la conséquence des actes. Le miroir m'interroge : qu'est-ce que mes mains préparent ?`,
  reflection: `Les conséquences suivent les actes. Le châtiment est mérité par les actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bima qaddamat aydikum » — cela est pour ce que vos mains ont préparé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mes mains préparent ? Quelle conséquence m'attend ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les conséquences peuvent être bonnes si les actes sont bons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est juste. Chaque acte a une conséquence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare le bien reçoit le bien." }
  ],
  munajat: `Ya 'Adl, Tu es juste. Fais que mes mains préparent le bien. Donne-moi de bonnes conséquences.`
};

MIROIR["8:52"] = {
  reference: "8:52",
  theme: ["histoire", "peuples", "châtiment"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-'Aziz"],
  mirrorVersion: `« Comme le destin des gens de Pharaon et ceux qui les ont précédés : ils ont nié les signes d'Allah. » Le miroir me montre l'histoire répétitive. « Ka-da'bi ali Fir'awn » — comme le destin des gens de Pharaon. L'histoire se répète. Les peuples qui nient les signes d'Allah sont punis. Le miroir m'interroge : est-ce que je nie les signes d'Allah ?`,
  reflection: `L'histoire est un enseignement. Ce qui est arrivé aux autres peut nous arriver.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-da'bi ali Fir'awn wa alladhina min qablihim kafaru bi-ayati Allah » — comme le destin des gens de Pharaon et ceux qui les ont précédés : ils ont nié les signes d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nie les signes d'Allah ? Ou est-ce que je les accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire n'est pas condamnation — elle est avertissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les peuples disparaissent. Le message reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, fais que j'apprenne de l'histoire. Ne permets pas que je nie Tes signes. Préserve-moi du destin des peuples punis.`
};

MIROIR["8:54"] = {
  reference: "8:54",
  theme: ["ingratitude", "châtiment", "histoire"],
  emotion: "Lucidité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Muntaqim"],
  mirrorVersion: `« Comme le destin des gens de Pharaon et ceux qui les ont précédés : ils traitèrent de mensonges les signes de leur Seigneur. » Le miroir me montre la réponse à la bénédiction. « Kadhdhabu bi-ayati rabbihim » — ils traitèrent de mensonges les signes de leur Seigneur. Malgré les bénédictions, ils nièrent. Le miroir m'interroge : est-ce que je suis reconnaissant pour les bénédictions d'Allah ?`,
  reflection: `L'ingratitude mène à la perte. La reconnaissance mène à l'augmentation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-da'bi ali Fir'awn wa alladhina min qablihim kadhdhabu bi-ayati rabbihim » — comme le destin des gens de Pharaon et ceux qui les ont précédés : ils traitèrent de mensonges les signes de leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les bénédictions d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude perd celui qui la pratique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bénédictions sont des tests de gratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant reçoit plus." }
  ],
  munajat: `Ya Mannan, Tu m'as béni. Fais que je sois reconnaissant. Ne permets pas que l'ingratitude mène à ma perte.`
};

MIROIR["8:55"] = {
  reference: "8:55",
  theme: ["pire", "mécréance", "raison"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Les pires bêtes auprès d'Allah sont ceux qui ont refusé de croire. » Le miroir me montre le classement divin. « Sharra al-dawabb » — les pires bêtes. Les mécréants sont pires que les animaux parce qu'ils ont la raison mais refusent de l'utiliser. Le miroir m'interroge : est-ce que j'utilise ma raison pour croire ?`,
  reflection: `La mécréance est un refus d'utiliser la raison. L'animal n'a pas le choix, l'homme si.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna sharra al-dawabb 'inda Allahi alladhina kafaru » — les pires bêtes auprès d'Allah sont ceux qui ont refusé de croire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise ma raison pour croire ? Ou est-ce que je refuse comme les animaux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La raison sans foi est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croit par sa soumission naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit avec sa raison accède à la compréhension." }
  ],
  munajat: `Ya Hakim, Tu m'as donné la raison. Fais que je l'utilise pour croire. Ne permets pas que je sois pire que les animaux.`
};

MIROIR["8:56"] = {
  reference: "8:56",
  theme: ["traité", "trahison", "mécréance"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amanah", "Al-Wafi"],
  mirrorVersion: `« Ceux avec qui tu as fait un pacte et qui violent leur pacte à chaque fois. » Le miroir me montre la trahison répétée. « Yanthiquna al-'ahd » — ils violent le pacte. « Kulla marra » — à chaque fois. Certains partenaires ne sont pas fiables. Le miroir m'interroge : est-ce que je respecte mes engagements ?`,
  reflection: `Le pacte est sacré. Le violer est une trahison. La fiabilité est une vertu du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina 'ahadta minhum thumma yanquduna 'ahdahum fi kulli marra » — ceux avec qui tu as fait un pacte et qui violent leur pacte à chaque fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte mes engagements ? Ou est-ce que je les viole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La trahison du pacte révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte ses pactes. Les lois naturelles sont constantes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte ses engagements est digne de confiance." }
  ],
  munajat: `Ya Amanah, Tu es le Fidèle. Fais que je sois fidèle à mes engagements. Ne permets pas que je trahisse mes pactes.`
};

MIROIR["8:57"] = {
  reference: "8:57",
  theme: ["dissuasion", "exemple", "justice"],
  emotion: "Fermeté, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muthir"],
  mirrorVersion: `« Donc, si tu les maîtrises à la guerre, disperse ceux qui les suivraient. » Le miroir me montre la dissuasion. « Fa-sharrid bihim man khalfahum » — disperse ceux qui les suivraient. La punition visible dissuade les autres. Le miroir m'interroge : est-ce que je comprends que la justice a un effet dissuasif ?`,
  reflection: `La justice visible dissuade le mal. L'exemple puni prévient d'autres fautes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in asabtum fihim fa-sharrid bihim man khalfahum » — donc, si tu les maîtrises à la guerre, disperse ceux qui les suivraient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que mes actes ont un impact sur les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exemple bon encourage le bien. L'exemple mauvais encourage le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers apprend par l'exemple." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne un bon exemple est récompensé." }
  ],
  munajat: `Ya Rabb, fais que je sois un bon exemple. Ne permets pas que mes actes encouragent le mal. Donne-moi d'être un modèle de bien.`
};

MIROIR["8:58"] = {
  reference: "8:58",
  theme: ["trahison", "confrontation", "justice"],
  emotion: "Vigilance, fermeté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-'Adl"],
  mirrorVersion: `« Si tu crains une trahison de la part d'un peuple, romps avec lui sur un pied d'égalité. » Le miroir me montre la gestion de la trahison. « Fa-innana alayka fa-anbid ilayhim 'ala sawa' » — romps avec lui sur un pied d'égalité. La trahison doit être gérée avec justice et transparence. Le miroir m'interroge : est-ce que je gère les conflits avec justice ?`,
  reflection: `La rupture doit être juste et transparente. La ruse n'est pas permise même face à la trahison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-inna khiftum min qawmin khyanatan fa-innana ilayhim 'ala sawa' » — si tu crains une trahison de la part d'un peuple, romps avec lui sur un pied d'égalité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je gère les conflits avec justice ? Ou est-ce que je ruse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice demande la transparence, même face à la trahison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers opère avec justice et équité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste même face à la trahison est noble." }
  ],
  munajat: `Ya 'Adl, Tu es juste. Fais que je sois juste même quand les autres me trahissent. Ne permets pas que je réponde à la trahison par la trahison.`
};

MIROIR["8:59"] = {
  reference: "8:59",
  theme: ["illusion", "fuite", "mécréance"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Wasi'"],
  mirrorVersion: `« Que ceux qui ne croient pas ne pensent pas qu'ils Nous ont échappé. » Le miroir me montre l'illusion des mécréants. « La yahsabanna alladhina kafaru sabaqu » — qu'ils ne pensent pas qu'ils Nous ont échappé. Personne n'échappe à Allah. Le miroir m'interroge : est-ce que je pense pouvoir échapper à Allah ?`,
  reflection: `Personne n'échappe à Allah. Sa justice rattrape toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yahsabanna alladhina kafaru sabaqu » — que ceux qui ne croient pas ne pensent pas qu'ils Nous ont échappé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense pouvoir échapper à Allah ? Ou est-ce que je sais qu'Il me rattrape ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite d'Allah est impossible. Le retour à Lui est toujours possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas échapper à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte qu'il ne peut pas fuir choisit de revenir." }
  ],
  munajat: `Ya Qahhar, je ne peux pas T'échapper. Je choisis de revenir à Toi. Rattrape-moi avec Ta miséricorde, pas avec Ton châtiment.`
};

MIROIR["8:61"] = {
  reference: "8:61",
  theme: ["paix", "traité", "confiance"],
  emotion: "Espoir, prudence",
  difficulty: "intermédiaire",
  relatedNames: ["As-Salam", "Al-Wakil"],
  mirrorVersion: `« S'ils inclinent à la paix, incline-la aussi et confie-toi à Allah. » Le miroir me montre l'ouverture à la paix. « Fa-in janahu li-al-salmi fa-jnah laha » — s'ils inclinent à la paix, incline-la aussi. La paix est préférable à la guerre. Mais avec confiance en Allah. Le miroir m'interroge : est-ce que je préfère la paix ?`,
  reflection: `La paix est préférable quand elle est sincère. La confiance en Allah reste nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in janahu li-al-salmi fa-jnah laha wa tawakkal 'ala Allah » — s'ils inclinent à la paix, incline-la aussi et confie-toi à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préfère la paix ? Ou est-ce que je nourris les conflits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix demande de la confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tend vers l'équilibre et la paix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait la paix avec confiance en Allah est protégé." }
  ],
  munajat: `Ya Salam, Tu es la Paix. Fais que je préfère la paix. Donne-moi la confiance en Toi pour accepter les offres de paix.`
};

MIROIR["8:62"] = {
  reference: "8:62",
  theme: ["ruse", "protection", "confiance"],
  emotion: "Vigilance, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wakil", "Al-Hafiz"],
  mirrorVersion: `« Et s'ils veulent te tromper, Allah te suffit. » Le miroir me montre la protection divine. « Fa-in yuridu an yakhda'uka fa-inna hasbaka Allah » — s'ils veulent te tromper, Allah te suffit. La ruse des autres est contrée par la protection d'Allah. Le miroir m'interroge : est-ce qu'Allah me suffit ?`,
  reflection: `Allah suffit contre toutes les ruses. Sa protection est complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yuridu an yakhda'uka fa-inna hasbaka Allah » — et s'ils veulent te tromper, Allah te suffit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'Allah me suffit ? Ou est-ce que je crains les ruses des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La ruse des autres ne peut pas atteindre celui qu'Allah protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection d'Allah englobe tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah n'a besoin de personne d'autre." }
  ],
  munajat: `Ya Hasbi, Tu me suffis. Protège-moi des ruses des autres. Fais que je n'aie peur de personne d'autre que Toi.`
};

MIROIR["8:63"] = {
  reference: "8:63",
  theme: ["unité", "fraternité", "amour"],
  emotion: "Gratitude, fraternité",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Jami'"],
  mirrorVersion: `« Et Il a réuni leurs cœurs. Si tu avais dépensé tout ce qui est sur terre, tu n'aurais pas réuni leurs cœurs. » Le miroir me montre l'union des cœurs. « Allafa bayna qulubihim » — Il a réuni leurs cœurs. L'unité est un don d'Allah. L'argent ne peut pas l'acheter. Le miroir m'interroge : est-ce que je valorise l'unité des cœurs ?`,
  reflection: `L'unité des cœurs est un miracle divin. Elle ne s'achète pas, elle se reçoit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa allafa bayna qulubihim law anfaqta ma fi al-ardi jami'an ma allafta bayna qulubihim » — et Il a réuni leurs cœurs. Si tu avais dépensé tout ce qui est sur terre, tu n'aurais pas réuni leurs cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je valorise l'unité des cœurs ? Est-ce que je demande à Allah de réunir les cœurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'union des cœurs est plus précieuse que l'argent du monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité est la loi de l'univers. La division est artificielle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unit les cœurs participe à l'œuvre d'Allah." }
  ],
  munajat: `Ya Jami', Tu réunis les cœurs. Réunit mon cœur avec ceux de mes frères. Fais que je valorise l'unité plus que l'argent.`
};

MIROIR["8:64"] = {
  reference: "8:64",
  theme: ["suffisance", "alliance", "confiance"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Kafi"],
  mirrorVersion: `« Ô Prophète, Allah te suffit, ainsi qu'à ceux des croyants qui te suivent. » Le miroir me montre la suffisance divine. « Hasbuka Allah » — Allah te suffit. « Wa mani ittaba'aka » — ainsi qu'à ceux des croyants qui te suivent. La suffisance d'Allah s'étend aux croyants. Le miroir m'interroge : est-ce qu'Allah me suffit ?`,
  reflection: `Allah suffit à Son Prophète et à ses suivants. Sa suffisance est notre richesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nabiyu hasbuka Allah wa mani ittaba'aka min al-mu'minin » — ô Prophète, Allah te suffit, ainsi qu'à ceux des croyants qui te suivent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'Allah me suffit ? Ou est-ce que je cherche la sécurité ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La suffisance d'Allah est la vraie richesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah suffit à tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui pour qui Allah suffit n'a besoin de rien d'autre." }
  ],
  munajat: `Ya Kafi, Tu suffis. Sois ma suffisance. Fais que je ne cherche pas de sécurité ailleurs qu'en Toi.`
};

MIROIR["8:65"] = {
  reference: "8:65",
  theme: ["force", "victoire", "foi"],
  emotion: "Courage, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "An-Nasir"],
  mirrorVersion: `« Ô Prophète, incite les croyants au combat. S'il y a parmi vous vingt patients, ils vaincront deux cents. » Le miroir me montre la force de la foi. « Ithna 'ashara » — vingt. « Mi'atayn » — deux cents. Un croyant vaut dix mécréants par sa foi. Le miroir m'interroge : est-ce que je réalise la force que me donne ma foi ?`,
  reflection: `La foi donne une force décuplée. Le croyant patient vainc le multiple de ses ennemis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nabiyu harrid al-mu'minina 'ala al-qital in yakun minkum ishruna sabiruna yaghlibu mi'atayn » — ô Prophète, incite les croyants au combat. S'il y a parmi vous vingt patients, ils vaincront deux cents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la force que me donne ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force n'est pas dans le nombre — elle est dans la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire montre que les petits groupes avec foi vainquent les grands groupes sans foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi a la force de dix." }
  ],
  munajat: `Ya Qawiyy, Tu donnes la force. Renforce ma foi. Fais que je réalise que la foi me donne la force de dix.`
};

MIROIR["8:66"] = {
  reference: "8:66",
  theme: ["facilitation", "force", "foi"],
  emotion: "Gratitude, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Musahhil", "Ar-Rahman"],
  mirrorVersion: `« Allah vous a allégé votre tâche, car Il sait qu'il y a de la faiblesse en vous. » Le miroir me montre l'accommodation divine. « Khaffafa Allahu 'ankum » — Allah vous a allégé. « Wa ya'lamu anna fikum da'fan » — car Il sait qu'il y a de la faiblesse en vous. Allah connaît nos limites et allège en conséquence. Le miroir m'interroge : est-ce que je reconnais mes limites ?`,
  reflection: `Allah connaît nos faiblesses et adapte Ses exigences. Sa miséricorde est dans l'allégement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-alana khaffafa Allahu 'ankum wa ya'lamu anna fikum da'fan » — maintenant, Allah vous a allégé votre tâche, car Il sait qu'il y a de la faiblesse en vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mes limites ? Est-ce que j'accepte l'allégement d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la faiblesse ouvre la porte de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait pour les créatures. Les créatures ne sont pas faites pour souffrir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa faiblesse reçoit la force." }
  ],
  munajat: `Ya Musahhil, Tu allèges mes fardeaux. Je reconnais ma faiblesse. Donne-moi la force que je n'ai pas.`
};

MIROIR["8:67"] = {
  reference: "8:67",
  theme: ["prisonniers", "bataille", "jugement"],
  emotion: "Lucidité, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hakim"],
  mirrorVersion: `« Il n'appartient pas à un prophète de faire des prisonniers avant d'avoir combattu sur la terre. » Le miroir me montre la priorité du combat. « An yakuna lahu asra » — de faire des prisonniers. Le butin ne doit pas précéder la victoire. Le combat doit d'abord être mené. Le miroir m'interroge : est-ce que je mets les priorités dans le bon ordre ?`,
  reflection: `Les priorités doivent être respectées. Le butin ne peut pas précéder la victoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana li-nabiyyin an yakuna lahu asra hatta yuthkhina fi al-ard » — il n'appartient pas à un prophète de faire des prisonniers avant d'avoir combattu sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mets les priorités dans le bon ordre ? Ou est-ce que je veux la récompense avant l'effort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense sans effort est souvent une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit un ordre précis. Le désordre mène au chaos." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'ordre obtient le résultat." }
  ],
  munajat: `Ya Hakim, Tu connais l'ordre. Fais que je respecte les priorités. Ne permets pas que je cherche la récompense avant l'effort.`
};

MIROIR["8:68"] = {
  reference: "8:68",
  theme: ["prescription", "châtiment", "miséricorde"],
  emotion: "Gratitude, soulagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghafur", "Al-Ra'uf"],
  mirrorVersion: `« N'était une prescription d'Allah qui vous a précédés, un énorme châtiment vous aurait touché pour ce que vous avez pris. » Le miroir me montre la miséricorde rétroactive. « Lawla kitabun min Allahi sabaqa » — n'était une prescription d'Allah qui vous a précédés. Le pardon a précédé la faute. Le miroir m'interroge : est-ce que je reconnais la miséricorde qui m'a précédé ?`,
  reflection: `La miséricorde d'Allah précède nos fautes. Il a pardonné avant même que nous péchions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawla kitabun min Allahi sabaqa la-massa lakum 'adhabun 'azimun bima akhadhtum » — n'était une prescription d'Allah qui vous a précédés, un énorme châtiment vous aurait touché pour ce que vous avez pris." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que la miséricorde d'Allah m'a précédé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon qui précède la faute est la plus grande miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah a précédé la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la miséricorde précédente vit dans la gratitude." }
  ],
  munajat: `Ya Ghafur, Tu as pardonné avant même que je ne faute. Je suis reconnaissant pour Ta miséricorde qui me précède.`
};

MIROIR["8:69"] = {
  reference: "8:69",
  theme: ["butin", "licite", "gratitude"],
  emotion: "Gratitude, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Halal"],
  mirrorVersion: `« Mangez donc de ce que vous avez acquis de butin licite et bon. » Le miroir me montre la légitimité du butin. « Mimmā ghanimtum halalan tayyiban » — de ce que vous avez acquis de butin licite et bon. Le butin de guerre est licite quand il est pris selon les règles. Le miroir m'interroge : est-ce que je mange de ce qui est licite ?`,
  reflection: `Le licite est bon. Le butin pris selon les règles est bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kulu mimma ghanimtum halalan tayyiban » — mangez donc de ce que vous avez acquis de butin licite et bon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mange de ce qui est licite ? Est-ce que je vérifie la source de mes gains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le licite nourrit le corps et l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fournit le licite en abondance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange du licite est béni." }
  ],
  munajat: `Ya Razzaq, Tu fournis le licite. Fais que je ne mange que du licite. Bénis mes gains légitimes.`
};

MIROIR["8:71"] = {
  reference: "8:71",
  theme: ["trahison", "confiance", "sagesse"],
  emotion: "Prudence, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Mais s'ils veulent te trahir, ils ont déjà trahi Allah auparavant. » Le miroir me montre la cohérence des traîtres. « Fa-qad khanu Allaha min qablu » — ils ont déjà trahi Allah auparavant. Celui qui trahit Allah trahira aussi les hommes. Le miroir m'interroge : est-ce que je suis fidèle à Allah ?`,
  reflection: `La fidélité envers Allah garantit la fidélité envers les hommes. La trahison révèle le caractère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yuridu khiyanataka fa-qad khanu Allaha min qablu » — mais s'ils veulent te trahir, ils ont déjà trahi Allah auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis fidèle à Allah ? Ma fidélité envers les hommes en dépend." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La trahison d'Allah est la racine de toutes les trahisons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fidélité est universellement honorée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est fidèle à Allah est fidèle à tous." }
  ],
  munajat: `Ya Hakim, Tu connais les traîtres. Fais que je sois fidèle à Toi. Ne permets pas que je trahisse ceux qui me font confiance.`
};

MIROIR["8:73"] = {
  reference: "8:73",
  theme: ["alliance", "protection", "sécurité"],
  emotion: "Vigilance, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Hafiz"],
  mirrorVersion: `« Ceux qui ont cru et n'ont pas émigré, vous n'avez pas à les protéger. » Le miroir me montre les limites de l'alliance. « Lasta lahum bi-wali » — vous n'avez pas à les protéger. L'alliance nécessite l'engagement total. La foi sans hijra est incomplète. Le miroir m'interroge : est-ce que mon engagement envers Allah est total ?`,
  reflection: `L'alliance demande l'engagement total. La foi sans engagement est incomplète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu wa lam yuhajiru ma lakum min walayatihim min shay » — ceux qui ont cru et n'ont pas émigré, vous n'avez pas à les protéger." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon engagement envers Allah est total ? Ou est-ce que je garde un pied dedans et un pied dehors ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'engagement partiel est souvent un refus déguisé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'engagement total est la loi de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'engage totalement reçoit la protection totale." }
  ],
  munajat: `Ya Wali, je veux m'engager totalement. Fais que je ne garde pas un pied dedans et un pied dehors. Protège-moi par mon engagement complet.`
};

MIROIR["8:74"] = {
  reference: "8:74",
  theme: ["foi", "hijra", "jihad"],
  emotion: "Détermination, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Muhajir"],
  mirrorVersion: `« Ceux qui ont cru, émigré et lutté dans le chemin d'Allah, ceux-là sont les vrais croyants. » Le miroir me montre les marques du vrai croyant. « Fa-ula'ika hum al-mu'minuna haqqan » — ceux-là sont les vrais croyants. La foi, l'hijra, le jihad — trois marques de la vraie foi. Le miroir m'interroge : est-ce que je suis un vrai croyant ?`,
  reflection: `Le vrai croyant combine foi, engagement et effort. Ces trois éléments sont indissociables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu wa hajaraju wa jahadu fi sabil Allahi ula'ika hum al-mu'minuna haqqan » — ceux qui ont cru, émigré et lutté dans le chemin d'Allah, ceux-là sont les vrais croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un vrai croyant ? Est-ce que je combine foi, engagement et effort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans action est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie foi transforme la personne et son environnement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combine ces trois éléments atteint la réalisation." }
  ],
  munajat: `Ya Rabb, je veux être un vrai croyant. Donne-moi la foi, l'engagement et l'effort. Fais que je sois complet dans ma foi.`
};

MIROIR["8:75"] = {
  reference: "8:75",
  theme: ["héritage", "fraternité", "récompense"],
  emotion: "Espoir, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-'Adl"],
  mirrorVersion: `« Et ceux qui ont cru ensuite, émigré et lutté avec vous, ceux-là sont des vôtres. » Le miroir me montre l'extension de la communauté. « Fa-ula'ika minkum » — ceux-là sont des vôtres. La communauté s'étend aux nouveaux croyants. L'héritage et les liens du sang sont remplacés par les liens de la foi. Le miroir m'interroge : est-ce que je considère les autres croyants comme mes frères ?`,
  reflection: `La fraternité de la foi remplace les liens du sang. La communauté est une famille spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu min ba'du wa hajaraju wa jahadu ma'akum fa-ula'ika minkum » — et ceux qui ont cru ensuite, émigré et lutté avec vous, ceux-là sont des vôtres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère les autres croyants comme mes frères ? Ou est-ce que je les tiens à distance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fraternité de la foi est plus forte que la fraternité du sang." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté des croyants est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui élargit sa fraternité à tous les croyants participe à l'universel." }
  ],
  munajat: `Ya Warith, Tu es l'Héritier. Fais que je considère tous les croyants comme mes frères. Ne permets pas que je les tiens à distance.`
};

MIROIR["16:31"] = {
  reference: "16:31",
  theme: ["paradis", "jardins", "récompense"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Janna", "Al-Wadud"],
  mirrorVersion: `« Les jardins d'Eden où ils entreront, sous lesquels coulent les rivières. » Le miroir me montre la récompense promise. Des jardins éternels, des rivières qui coulent — une image de paix et d'abondance. Cette promesse est pour ceux qui craignent Allah. Le miroir m'interroge : est-ce que j'aspire à ces jardins ?`,
  reflection: `Le Paradis est la récompense de la piété. Les jardins d'Eden attendent ceux qui craignent Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatu 'adnin yadkhulunaha tajri min tahtiha al-anhar » — Les jardins d'Eden où ils entreront, sous lesquels coulent les rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire au Paradis ? Mon cœur le désire-t-il vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les jardins du Paradis sont le reflet des jardins de la foi dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est source de vie sur terre comme au Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui plante la foi ici-bas récolte les jardins éternels." }
  ],
  munajat: `Ya Wadud, Tu as promis les jardins d'Eden. Fais que je T'aie pour les mériter. Ouvre-moi les portes de Ton Paradis.`
};

MIROIR["16:32"] = {
  reference: "16:32",
  theme: ["mort", "anges", "paix"],
  emotion: "Sérénité, espérance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mu'min"],
  mirrorVersion: `« Ceux dont les anges reprennent l'âme alors qu'ils sont bons et purs. » Le miroir me montre la mort des justes. Les anges viennent en paix pour les âmes pures. "Salam" — paix — est leur salut. La mort devient douce pour ceux qui ont vécu dans la pureté. Le miroir m'interroge : comment est-ce que je veux que les anges me trouvent ?`,
  reflection: `La mort des justes est paisible. Les anges saluent les âmes pures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina tatawaffahumu al-mala'ikatu tayyibina » — Ceux dont les anges reprennent l'âme alors qu'ils sont bons et purs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je veux que les anges me trouvent ? Puis ou souillé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté de la mort reflète la pureté de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort vient pour tous. Seule la préparation diffère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en paix meurt en paix." }
  ],
  munajat: `Ya Salam, fais que je sois parmi ceux que les anges trouvent purs. Donne-moi une mort paisible et une entrée sereine dans l'au-delà.`
};

MIROIR["16:33"] = {
  reference: "16:33",
  theme: ["attendre", "jugement", "mort"],
  emotion: "Urgence, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Akhira", "Al-Qari'ah"],
  mirrorVersion: `« Attendent-ils seulement que les anges viennent à eux ou que l'ordre de ton Seigneur vienne ? » Le miroir me montre l'attente dangereuse. Certains attendent la mort ou le Jugement pour croire — mais ce sera trop tard. La foi doit venir avant, pas après. Le miroir m'interroge : est-ce que je remets ma conversion à plus tard ?`,
  reflection: `L'attente est dangereuse. La mort peut venir à tout moment. La foi doit être immédiate.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal yanzuruna illa an ta'tiyahumu al-mala'ikatu aw ya'tiya amru rabbika » — Attendent-ils seulement que les anges viennent à eux ou que l'ordre de ton Seigneur vienne ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remets ma relation avec Allah à plus tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demain n'est pas garanti. Aujourd'hui est le moment de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort frappe sans prévenir. La préparation doit être constante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne diffère pas la foi la trouve vivante." }
  ],
  munajat: `Ya Rabb, ne laisse pas mon cœur différer. Aujourd'hui, je me tourne vers Toi. Fais que je ne remette jamais ma foi à demain.`
};

MIROIR["16:34"] = {
  reference: "16:34",
  theme: ["conséquence", "mal", "regret"],
  emotion: "Gravité, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hasib"],
  mirrorVersion: `« Le mal qu'ils faisaient les atteindra, et ce dont ils se moquaient les cernera. » Le miroir me montre le retour des actions. Le mal commis revient vers son auteur. Les moqueries se retournent contre ceux qui moquent. La justice divine est imparable. Le miroir m'interroge : quel mal est-ce que je fais qui me reviendra ?`,
  reflection: `Les actions reviennent vers leur auteur. Le bien attire le bien, le mal attire le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa asabahum sayyi'atu ma 'amilu wa haqa bihim ma kanu bihi yastahzi'un » — Le mal qu'ils faisaient les atteindra, et ce dont ils se moquaient les cernera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel mal est-ce que je fais qui risque de me revenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie d'aujourd'hui sera le regret de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est miroir des actions. Ce que nous envoyons revient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien le voit revenir multiplié." }
  ],
  munajat: `Ya 'Adl, garde-moi du mal qui me reviendrait. Fais que je sème le bien pour récolter le bien. Protège-moi des moqueries qui se retournent.`
};

MIROIR["16:35"] = {
  reference: "16:35",
  theme: ["polythéisme", "excuse", "obéissance"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Et les associateurs disent : "Si Allah avait voulu, nous n'aurions rien adoré en dehors de Lui." » Le miroir me montre l'excuse du destin. Les associateurs blâment Allah pour leur égarement. "Si Allah l'avait voulu..." — mais Allah a donné le choix. Le miroir m'interroge : est-ce que je blâme le destin pour mes propres choix ?`,
  reflection: `Le destin n'est pas une excuse. Allah a donné le libre arbitre. Nous choisissons et nous sommes responsables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala al-mushrikuna law shaa Allahu ma 'abadna min dunihi shay'an » — Et les associateurs disent : 'Si Allah avait voulu, nous n'aurions rien adoré en dehors de Lui.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je blâme le destin pour mes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse du destin cache le refus de responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le libre arbitre est le plus grand don — et la plus grande responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume ses choix trouve la voie de la correction." }
  ],
  munajat: `Ya Haqq, ne laisse pas mon cœur blâmer le destin. Aide-moi à assumer mes choix et à me corriger. Fais que je prenne la responsabilité de mes actes.`
};

MIROIR["16:37"] = {
  reference: "16:37",
  theme: ["guidance", "zèle", "impuissance"],
  emotion: "Humilité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mu'ti"],
  mirrorVersion: `« Même si tu te dévoues pour leur guidée, Allah ne guide pas ceux qui s'égarent. » Le miroir me montre les limites de l'effort humain. On ne peut pas forcer la guidance. Même le Prophète ne pouvait pas guider ceux qu'Allah avait égarés. La guidance vient d'Allah seul. Le miroir m'interroge : est-ce que j'accepte que la guidance n'est pas entre mes mains ?`,
  reflection: `La guidance est un don divin. On peut montrer le chemin, mais on ne peut pas forcer le voyageur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tahris 'ala hudahum fa inna Allaha la yahdi man yudill » — Même si tu te dévoues pour leur guidée, Allah ne guide pas ceux qui s'égarent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que je ne peux pas sauver tout le monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'échec à guider les autres n'est pas un échec personnel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme suit son propre chemin vers son propre destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide vers Allah sans s'attacher au résultat est libéré." }
  ],
  munajat: `Ya Hadi, Toi seul guides. Aide-moi à montrer le chemin sans m'y attacher. Accepte que je ne peux pas sauver tout le monde.`
};

MIROIR["16:38"] = {
  reference: "16:38",
  theme: ["serment", "résurrection", "certitude"],
  emotion: "Certitude, affirmation",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Haqq"],
  mirrorVersion: `« Et ils ont juré par Allah avec leurs serments les plus solennels : "Allah ne ressuscitera pas celui qui meurt." » Le miroir me montre le déni de la résurrection. Certains jurent que la mort est finale. Mais leur serment ne change pas la vérité. Allah ressuscitera les morts. Le miroir m'interroge : est-ce que je crois vraiment en la résurrection ?`,
  reflection: `La résurrection est une certitude. Les dénis des hommes ne changent pas la vérité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aqsamu bi Allahi jahda aymanihim la yab'athu Allahu man yamut » — Et ils ont juré par Allah avec leurs serments les plus solennels : 'Allah ne ressuscitera pas celui qui meurt'." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment des hommes ne peut annuler la promesse de Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de la nature — mort et renaissance — préfigure la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection vit différemment." }
  ],
  munajat: `Ya Ba'ith, Tu ressusciteras les morts. Fortifie ma foi en la résurrection. Fais que je vive comme quelqu'un qui croit vraiment à la vie après la mort.`
};

MIROIR["16:39"] = {
  reference: "16:39",
  theme: ["résurrection", "certitude", "jugement"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Bayyinah"],
  mirrorVersion: `« Afin qu'Il leur explique ce sur quoi ils divergeaient, et que les mécréants sachent qu'ils étaient menteurs. » Le miroir me montre le but de la résurrection. Ce jour-là, toutes les disputes seront tranchées. Les mensonges seront exposés. La vérité éclatera. Le miroir m'interroge : est-ce que je suis prêt à voir mes mensonges exposés ?`,
  reflection: `Le Jour de la Résurrection est le jour de la vérité. Tout sera révélé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yubayyina lahum alladhi yakhtalifuna fihi wa li ya'lama alladhina kafaru annahum kanu kadhibin » — Afin qu'Il leur explique ce sur quoi ils divergeaient, et que les mécréants sachent qu'ils étaient menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels mensonges est-ce que je cache ? Seront-ils exposés ce Jour-là ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le menteur se ment d'abord à lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par éclater. La résurrection en est l'ultime révélation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la vérité n'a peur de rien." }
  ],
  munajat: `Ya Haqq, Tu révéleras tout. Aide-moi à vivre dans la vérité. Fais que je n'aie rien à cacher le Jour de la Résurrection.`
};

MIROIR["16:40"] = {
  reference: "16:40",
  theme: ["parole", "création", "pouvoir"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Kun", "Al-Qadir"],
  mirrorVersion: `« Quand Nous voulons une chose, Notre seule parole est : "Sois." Et elle est. » Le miroir me montre la puissance de la Parole divine. Allah crée par le simple commandement. Pas d'effort, pas de matière préexistante — juste la parole. "Kun fayakun" — sois, et c'est. Le miroir m'interroge : est-ce que je réalise la puissance d'Allah ?`,
  reflection: `La création par la parole révèle la toute-puissance divine. "Sois" suffit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama quluna li shay'in idha aradnahu an naqula lahu kun fayakun » — Quand Nous voulons une chose, Notre seule parole est : 'Sois.' Et elle est." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que rien n'est difficile pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble impossible à l'homme est 'sois' pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier existe par ce seul mot : 'Sois.'" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend 'kun fayakun' comprend la toute-puissance." }
  ],
  munajat: `Ya Qadir, Ta parole crée. Rien n'est impossible pour Toi. Crée en moi la foi, la certitude, et laguidance par Ta simple parole : "Sois.""`
};

MIROIR["16:41"] = {
  reference: "16:41",
  theme: ["hijra", "récompense", "patience"],
  emotion: "Espoir, courage",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Mawla"],
  mirrorVersion: `« Et ceux qui ont émigré pour Allah après avoir subi des injustices, Nous les installerons en un excellent lieu. » Le miroir me montre la récompense de l'émigration. Quitter sa terre pour Allah mérite une belle récompense. L'hijra n'est pas une perte — c'est un échange divin. Le miroir m'interroge : qu'est-ce que je quitte pour Allah ?`,
  reflection: `L'émigration pour Allah est un sacrifice récompensé. Quiconque quitte quelque chose pour Allah reçoit mieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hajaru fi Allahi min ba'di ma zulimu lanubawwi'annahum fi al-dunya hasanatan » — Et ceux qui ont émigré pour Allah après avoir subi des injustices, Nous les installerons en un excellent lieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je quitte pour Allah ? Quel sacrifice est-ce que je fais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est quitté pour Allah n'est jamais perdu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le voyage physique préfigure le voyage spirituel vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui quitte pour Allah trouve Allah." }
  ],
  munajat: `Ya Wali, donne-moi le courage de quitter ce qui m'éloigne de Toi. Installe-moi dans le meilleur lieu — auprès de Toi.`
};

MIROIR["16:42"] = {
  reference: "16:42",
  theme: ["patience", "confiance", "prière"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Wakil"],
  mirrorVersion: `« Ceux qui endurent avec patience et se fient à leur Seigneur. » Le miroir me montre les deux piliers de la foi face à l'épreuve. La patience (sabr) et la confiance (tawakkul). Ces deux qualités transforment l'épreuve en élévation. Le miroir m'interroge : est-ce que j'endure avec patience et confiance ?`,
  reflection: `La patience et la confiance sont les ailes de la foi. Ensemble, elles font traverser toute tempête.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina sabaru wa 'ala rabbihim yatawakkalun » — Ceux qui endurent avec patience et se fient à leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans l'épreuve, est-ce que je suis patient ? Est-ce que je me fie à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impatience est le signe du manque de confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création patiente. Seul l'homme a le choix de s'impatienter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente et se fie voit l'épreuve se transformer en bénédiction." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience. Ya Wakil, apprends-moi la confiance. Dans l'épreuve, fais que je sois parmi ceux qui endurent et se fient à Toi.`
};

MIROIR["16:43"] = {
  reference: "16:43",
  theme: ["prophètes", "hommes", "question"],
  emotion: "Humilité, recherche",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mursal"],
  mirrorVersion: `« Nous n'avons envoyé avant toi que des hommes que Nous inspirions. Demandez donc aux gens du rappel si vous ne savez pas. » Le miroir me montre l'humanité des prophètes. Ils n'étaient pas des anges, mais des hommes inspirés. La connaissance vient de la révélation, pas de la nature angélique. Le miroir m'interroge : est-ce que je demande à ceux qui savent ?`,
  reflection: `Les prophètes étaient des hommes. La guidance vient de la révélation, pas de la nature.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna min qablika illa rijalan nuhi ilayhim fas'alu ahla al-dhikri in kuntum la ta'lamun » — Nous n'avons envoyé avant toi que des hommes que Nous inspirions. Demandez donc aux gens du rappel si vous ne savez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande à ceux qui savent ? Ou est-ce que je reste dans l'ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'homme qui ignore et ne demande pas reste ignorant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne de la connaissance passe par les prophètes et les savants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande avec humilité reçoit la connaissance." }
  ],
  munajat: `Ya Hadi, Tu as envoyé des hommes comme prophètes. Fais que je demande à ceux qui savent. Ne laisse pas mon orgueil m'empêcher d'apprendre.`
};

MIROIR["16:44"] = {
  reference: "16:44",
  theme: ["prophètes", "livres", "explication"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Bayan", "Al-Kitab"],
  mirrorVersion: `« Avec des preuves claires et des Livres. Et Nous avons fait descendre sur toi le Rappel pour que tu exposes aux gens ce qui leur est descendu. » Le miroir me montre le rôle du Prophète. Recevoir la révélation et l'expliquer. Le Coran n'est pas obscur — il est expliqué par le Prophète. Le miroir m'interroge : est-ce que je me réfère à l'explication prophétique ?`,
  reflection: `Le Coran est révélé avec son explication. Le Prophète est l'interprète vivant de la Parole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi al-bayyinati wa al-zuburi wa anzalna ilayka al-dhikra li tubayyina li al-nasi ma nuzzila ilayhim » — Avec des preuves claires et des Livres. Et Nous avons fait descendre sur toi le Rappel pour que tu exposes aux gens ce qui leur est descendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je comprends le Coran ? Avec l'explication prophétique ou avec mes propres idées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran sans le Prophète est une lettre sans l'auteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation et l'explication sont les deux ailes de la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète suit la guidance complète." }
  ],
  munajat: `Ya Bayan, Tu as révélé le Coran et son explication. Fais que je le lise avec la sunnah du Prophète. Ne laisse pas mes idées personnelles déformer Ton message.`
};

MIROIR["16:45"] = {
  reference: "16:45",
  theme: ["complot", "sécurité", "châtiment"],
  emotion: "Vigilance, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui ont ourdi des complots criminels sont-ils à l'abri qu'Allah les engloutisse en terre ? » Le miroir me montre la fausse sécurité des comploteurs. Ils croient être à l'abri, mais Allah peut les atteindre de n'importe où. Le châtiment peut venir d'en bas ou d'en haut. Le miroir m'interroge : est-ce que je complote contre la vérité ?`,
  reflection: `Nul n'est à l'abri du châtiment d'Allah. La sécurité n'est que pour les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afa'amina alladhina makaru al-sayyi'ati an yakhsifa Allahu bihimu al-arda » — Ceux qui ont ourdi des complots criminels sont-ils à l'abri qu'Allah les engloutisse en terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je complote ? Est-ce que je me sens à l'abri ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sentiment de sécurité cache souvent le danger imminent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre qui nous porte peut nous engloutir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne complote pas n'a peur de rien." }
  ],
  munajat: `Ya Qahhar, garde-moi des complots. Ne laisse pas mon cœur se sentir à l'abri quand je fais le mal. Protège-moi de Ton châtiment.`
};

MIROIR["16:46"] = {
  reference: "16:46",
  theme: ["châtiment", "voyage", "impuissance"],
  emotion: "Vigilance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Muhit", "Al-Qadir"],
  mirrorVersion: `« Ou qu'Il les saisisse au cours de leurs déplacements ? Ils ne pourront pas L'en empêcher. » Le miroir me montre la vulnérabilité du voyageur. En déplacement, on est plus exposé. Nulle part n'est sûr sans la protection d'Allah. Le miroir m'interroge : est-ce que je me sens en sécurité sans penser à Allah ?`,
  reflection: `Le voyageur est vulnérable. Seule la protection divine assure la sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw ya'khudhahum fi taqallubihim fama hum bi mu'jizin » — Ou qu'Il les saisisse au cours de leurs déplacements ? Ils ne pourront pas L'en empêcher." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la protection d'Allah quand je voyage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voyage sans Allah est une exposition au danger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est vaste mais l'homme ne peut y trouver refuge qu'en Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voyage avec Allah voyage en sécurité." }
  ],
  munajat: `Ya Muhit, Tu m'entoures partout. Protège-moi dans mes déplacements. Ne laisse pas mon cœur s'éloigner de Toi en chemin.`
};

MIROIR["16:47"] = {
  reference: "16:47",
  theme: ["châtiment", "peur", "justice"],
  emotion: "Vigilance, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Ra'uf"],
  mirrorVersion: `« Ou qu'Il les saisisse en pleine frayeur ? » Le miroir me montre l'intensité du châtiment. Allah peut atteindre les pécheurs au moment où ils sont le plus terrifiés. La peur elle-même devient instrument de châtiment. Le miroir m'interroge : qu'est-ce qui me terrifie ? Est-ce que je crains Allah ?`,
  reflection: `La peur est un état que Allah peut utiliser. Craindre Allah est la meilleure protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw ya'khudhahum 'ala takhawwufin » — Ou qu'Il les saisisse en pleine frayeur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me terrifie ? Est-ce que je crains Allah plus que les créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur d'Allah protège de toutes les autres peurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La peur est un signal — elle peut conduire vers la sécurité ou la perdition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah ne craint rien d'autre." }
  ],
  munajat: `Ya Ra'uf, fais que je Te craigne plus que tout. Protège-moi de la frayeur qui saisit les pécheurs. Donne-moi la paix de Ta crainte.`
};

MIROIR["16:48"] = {
  reference: "16:48",
  theme: ["création", "soumission", "ombre"],
  emotion: "Contemplation, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musakhkhir"],
  mirrorVersion: `« N'ont-ils pas vu les choses qu'Allah a créées, dont les ombres se prosternent à droite et à gauche ? » Le miroir me montre la prosternation de la création. Les ombres des créatures se déplacent, se prosternant vers la droite et la gauche — une adoration cosmique. Tout dans la création adore Allah, même les ombres. Le miroir m'interroge : est-ce que je me prosterne comme les ombres ?`,
  reflection: `La création entière adore Allah. L'ombre qui bouge est une prosternation continue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa lam yaraw ila ma khalaqa Allahu min shay'in tatafayya'u zilaluhu » — N'ont-ils pas vu les choses qu'Allah a créées, dont les ombres se prosternent à droite et à gauche ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'ombre se prosterne. Et moi, est-ce que je me prosterne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ombre obéit sans questionner. L'homme a le choix — et il refuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ombre suit le soleil. L'âme devrait suivre Allah de la même manière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les ombres voit la prosternation universelle." }
  ],
  munajat: `Ya Khaliq, Tes créatures T'adorent par leurs ombres. Fais que je T'adore avec tout mon être. Ne laisse pas l'ombre m'enseigner l'adoration que je refuse.`
};

MIROIR["16:49"] = {
  reference: "16:49",
  theme: ["adoration", "créatures", "soumission"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'bud", "Al-Khaliq"],
  mirrorVersion: `« Et à Allah se prosternent toutes les créatures des cieux et de la terre, ainsi que les anges, sans orgueil. » Le miroir me montre l'adoration universelle. Tous les êtres des cieux et de la terre se prosternent devant Allah. Les anges aussi, sans orgueil. Seul l'orgueilleux refuse de se prosterner. Le miroir m'interroge : est-ce que je me prosterne sans orgueil ?`,
  reflection: `La prosternation est universelle. L'orgueil est le seul obstacle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li Allahi yasjudu ma fi al-samawati wa ma fi al-ardi min dabbatin wa al-mala'ikatu wa hum la yastakbirun » — Et à Allah se prosternent toutes les créatures des cieux et de la terre, ainsi que les anges, sans orgueil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prosterne ? Mon orgueil m'en empêche-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ange se prosterne. Iblis a refusé par orgueil. Quel est mon choix ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prosternation est le langage universel de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne avec les créatures rejoint l'adoration universelle." }
  ],
  munajat: `Ya Ma'bud, toutes Tes créatures se prosternent. Fais que je me prosterne avec elles. Ne laisse pas l'orgueil m'empêcher de m'unir à l'adoration universelle.`
};

MIROIR["16:50"] = {
  reference: "16:50",
  theme: ["crainte", "anges", "adoration"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Jalil", "Al-Kabir"],
  mirrorVersion: `« Ils craignent leur Seigneur qui est au-dessus d'eux, et ils font ce qu'on leur ordonne. » Le miroir me montre la crainte des anges. Même les anges, créés de lumière, craignent Allah. Leur obéissance n'est pas mécanique — elle est empreinte de révérence. Le miroir m'interroge : est-ce que je crains Allah comme les anges ?`,
  reflection: `La crainte d'Allah n'est pas la peur — c'est la révérence. Les anges obéissent avec crainte et amour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yakhawna rabbahum min fawqihim wa yaf'aluna ma yu'marun » — Ils craignent leur Seigneur qui est au-dessus d'eux, et ils font ce qu'on leur ordonne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah ? Est-ce que j'obéis comme les anges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ange obéit parfaitement. L'homme obéit imparfaitement — quand il obéit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte révérencielle est le fondement de l'adoration dans tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah avec amour obéit parfaitement." }
  ],
  munajat: `Ya Jalil, les anges Te craignent. Fais que je Te craigne avec révérence. Aide-moi à obéir comme ils obéissent — sans hésitation.`
};

MIROIR["16:52"] = {
  reference: "16:52",
  theme: ["unicité", "adoration", "éternité"],
  emotion: "Certitude, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Abadi"],
  mirrorVersion: `« À Lui appartient tout ce qui est dans les cieux et sur la terre. L'adoration est à Lui pour toujours. » Le miroir me montre l'étendue de la souveraineté divine. Tout Lui appartient — cieux et terre. L'adoration Lui est due éternellement. Il n'y a pas de moment sans Allah. Le miroir m'interroge : est-ce que j'adore Allah en tout temps ?`,
  reflection: `L'adoration n'est pas ponctuelle — elle est éternelle. Tout appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu ma fi al-samawati wa al-ardi wa lahu al-dinu wasiban » — À Lui appartient tout ce qui est dans les cieux et sur la terre. L'adoration est à Lui pour toujours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah en tout temps ? Ou seulement dans certains moments ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration éternelle exige un cœur tourné en permanence vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers adore Allah éternellement. L'homme est le seul à interrompre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore continuellement ne sent pas le poids de l'adoration." }
  ],
  munajat: `Ya Wahid, tout T'appartient. Fais que je T'adore sans interruption. Transforme ma vie entière en adoration continue.`
};

MIROIR["16:54"] = {
  reference: "16:54",
  theme: ["détresse", "délivrance", "ingratitude"],
  emotion: "Reconnaissance, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Naji", "Al-Mannan"],
  mirrorVersion: `« Et quand Il vous délivre du mal, un groupe parmi vous associe à son Seigneur. » Le miroir me montre l'ingratitude après la délivrance. Dans la détresse, on invoque Allah seul. Une fois délivré, on oublie et on associe. Ce cycle est tristement humain. Le miroir m'interroge : est-ce que je suis reconnaissant après la délivrance ?`,
  reflection: `La détresse purifie l'adoration. La facilité la corrompt. La gratitude est le lien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma idha kashafa al-durra 'ankum idha fariqun minkum bi rabbihim yushrikun » — Et quand Il vous délivre du mal, un groupe parmi vous associe à son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Après la délivrance, est-ce que je reste attaché à Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude après la grâce est pire que le déni constant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La détresse est l'école de l'adoration. La facilité en est le test." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie après la délivrance prépare la prochaine grâce." }
  ],
  munajat: `Ya Naji, Tu me délivres du mal. Garde mon cœur attaché à Toi seul après la délivrance. Ne laisse pas l'ingratitude me séparer de Toi.`
};

MIROIR["16:55"] = {
  reference: "16:55",
  theme: ["ingratitude", "dons", "méconnaissance"],
  emotion: "Vigilance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Shakur"],
  mirrorVersion: `« Afin qu'ils méconnaissent ce que Nous leur avons donné. » Le miroir me montre le but de l'association. Les associateurs utilisent les dons d'Allah pour Lui désobéir. Ils ignorent que ces dons viennent de Lui. Le miroir m'interroge : est-ce que je reconnais la source de mes bienfaits ?`,
  reflection: `Les dons d'Allah sont des tests. Les utiliser pour Lui désobéir est le comble de l'ingratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yakfuru bima ataynahum » — Afin qu'ils méconnaissent ce que Nous leur avons donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que mes bienfaits viennent d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don qui mène à l'ingratitude devient une malédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout don porte la signature du Donateur. L'ignorer est une perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source des dons les utilise pour le bien." }
  ],
  munajat: `Ya Mannan, tout ce que j'ai vient de Toi. Fais que je ne méconnaisse jamais Tes dons. Aide-moi à les utiliser pour T'obéir.`
};

MIROIR["16:56"] = {
  reference: "16:56",
  theme: ["part", "idoles", "mensonge"],
  emotion: "Indignation, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Et ils assignent une part de ce que Nous leur avons attribué à des idoles qu'ils ne connaissent pas. » Le miroir me montre l'absurdité du partage. On attribue à des idoles une partie des bienfaits d'Allah — des idoles qui n'ont rien donné. Ce partage est un mensonge. Le miroir m'interroge : est-ce que je partage ma gratitude avec de fausses divinités ?`,
  reflection: `La gratitude est indivisible. Remercier autre qu'Allah pour Ses dons est une tromperie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaj'aluna lima la ya'lamuna nasiban mimma razaqnahum » — Et ils assignent une part de ce que Nous leur avons attribué à des idoles qu'ils ne connaissent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que j'attribue mes bienfaits ? À Allah seul ou à d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole ne peut rien donner. Lui attribuer quoi que ce soit est un vol." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le don a une seule source. La reconnaissance devrait avoir un seul destinataire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie Allah seul reçoit davantage." }
  ],
  munajat: `Ya Wahid, Tu es la source de tous mes biens. Ne laisse pas mon cœur attribuer Tes dons à d'autres. Garde ma gratitude pure pour Toi seul.`
};

MIROIR["16:57"] = {
  reference: "16:57",
  theme: ["filles", "attribution", "injustice"],
  emotion: "Indignation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Et ils assignent à Allah des filles — gloire à Lui ! — et pour eux-mêmes ce qu'ils désirent. » Le miroir me montre l'injustice de l'attribution. Les associateurs attribuent des filles à Allah — qu'ils considéraient comme inférieures — et gardent les fils pour eux. Cette attribution révèle leur mépris. Le miroir m'interroge : est-ce que j'attribue à Allah ce que je refuse pour moi-même ?`,
  reflection: `Attribuer à Allah ce qu'on méprise est une insulte. Allah est au-dessus de toutes les attributions humaines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaj'aluna li Allahi al-banati subhanahu wa lahum ma yashtahun » — Et ils assignent à Allah des filles — gloire à Lui ! — et pour eux-mêmes ce qu'ils désirent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah ce que je refuse ? Est-ce que je Le limite à ma compréhension ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attribution injuste révèle l'injustice du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Créateur de toutes choses. Il n'a pas de fils ni de fille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah ne Lui attribue rien d'humain." }
  ],
  munajat: `Ya 'Adl, Tu es au-dessus de toutes les attributions. Purifie ma compréhension de Toi. Ne laisse pas mes idées limitées Te définir.`
};

MIROIR["16:58"] = {
  reference: "16:58",
  theme: ["naissance", "fille", "chagrin"],
  emotion: "Tristesse, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Et quand on annonce à l'un d'eux une fille, son visage s'assombrit et il suffoque. » Le miroir me montre la déception de l'ignorant. La naissance d'une fille est une grâce, mais l'ignorant la voit comme un malheur. Son visage change, il suffoque de chagrin. Le miroir m'interroge : comment est-ce que je réagis aux décrets d'Allah ?`,
  reflection: `La naissance d'une fille est une bénédiction. L'ignorance transforme la grâce en malheur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha bushshira ahaduhum bi al-untha zalla wajhuhu muswaddan wa huwa kazim » — Et quand on annonce à l'un d'eux une fille, son visage s'assombrit et il suffoque." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis aux décrets d'Allah ? Avec acceptation ou rébellion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble malheur peut être la plus grande grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fille est une créature d'Allah comme le garçon. Les deux sont des dons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le décret d'Allah trouve la paix." }
  ],
  munajat: `Ya Khaliq, Tu donnes ce que Tu veux. Aide-moi à accepter Tes dons avec gratitude. Ne laisse pas mon visage s'assombrir devant Ton décret.`
};

MIROIR["16:59"] = {
  reference: "16:59",
  theme: ["honte", "naissance", "acceptation"],
  emotion: "Réflexion, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Il se cache des gens, à cause du malheur qu'on lui a annoncé. » Le miroir me montre la fuite face au décret. L'ignorant se cache par honte d'une fille. Au lieu d'accepter, il fuit. Il cache ce qu'Allah lui a donné. Le miroir m'interroge : est-ce que je cache ce qu'Allah m'a donné ?`,
  reflection: `Le décret divin n'est pas une honte. Se cacher du don d'Allah est une ingratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatawara mina al-qawmi min sui ma bushshira bihi » — Il se cache des gens, à cause du malheur qu'on lui a annoncé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cache ce qu'Allah m'a donné par honte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La honte face au don révèle le manque de confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est un don. Aucun ne devrait être caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte tous les dons d'Allah ne connaît pas la honte." }
  ],
  munajat: `Ya Khaliq, Ton don n'est jamais une honte. Aide-moi à accepter avec gratitude tout ce que Tu me donnes. Ne laisse pas la honte m'éloigner de Ta reconnaissance.`
};

MIROIR["16:60"] = {
  reference: "16:60",
  theme: ["comparaison", "mécréance", "attributs"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-A'la", "Al-Kabir"],
  mirrorVersion: `« À ceux qui ne croient pas en l'au-delà revient la comparaison la plus vile, tandis qu'à Allah revient la comparaison la plus haute. » Le miroir me montre l'asymétrie de la comparaison. Les mécréants attribuent à Allah des caractéristiques viles. Mais Allah est le plus Haut. Toute comparaison humaine est inadéquate. Le miroir m'interroge : est-ce que j'attribue à Allah la grandeur qu'Il mérite ?`,
  reflection: `Allah est incomparable. Toute attribution humaine est limitée par notre compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lilladhina la yu'minuna bi al-akhirati mathalu al-saw' wa li Allahi al-mathalu al-a'la » — À ceux qui ne croient pas en l'au-delà revient la comparaison la plus vile, tandis qu'à Allah revient la comparaison la plus haute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je pense à Allah ? Avec grandeur ou avec petitesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attribution vile reflète le cœur vil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grandeur d'Allah dépasse toute imagination humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Sa grandeur ne Lui attribue que la perfection." }
  ],
  munajat: `Ya A'la, Tu es le Plus Haut. Purifie ma compréhension de Toi. Ne laisse pas mes pensées Te limiter. Élève mon concept de Toi à Ta grandeur réelle.`
};

// ==================== SURAH 9: AT-TAWBAH - COMPLETE COVERAGE ====================

MIROIR["9:2"] = {
  reference: "9:2",
  theme: ["sécurité", "avertissement", "mécréance"],
  emotion: "Mise en garde, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Qahhar"],
  mirrorVersion: `« Parcourez la terre pendant quatre mois, mais sachez que vous ne pourrez échapper à Allah. » Le miroir me montre le délai accordé. « Fa-sihu fi al-ardi arba'ata ashurin » — parcourez la terre pendant quatre mois. Un délai pour se repentir ou partir. Mais l'impossibilité d'échapper à Allah. Le miroir m'interroge : est-ce que je profite des délais d'Allah pour me repentir ?`,
  reflection: `Allah accorde des délais. Mais nul ne peut Lui échapper. Le délai est une miséricorde, pas un oubli.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sihu fi al-ardi arba'ata ashurin wa'lamu annakum ghayru mu'jizi Allah » — parcourez la terre pendant quatre mois, mais sachez que vous ne pourrez échapper à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je profite des délais d'Allah pour me repentir ? Ou est-ce que je crois que j'ai tout le temps ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est miséricorde. La fin du délai est justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas échapper à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise le délai pour revenir à Allah est sauvé." }
  ],
  munajat: `Ya Rabb, Tu donnes des délais. Fais que je les utilise pour me repentir. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["9:4"] = {
  reference: "9:4",
  theme: ["traité", "respect", "exception"],
  emotion: "Justice, fidélité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amanah", "Al-'Adl"],
  mirrorVersion: `« Excepté ceux avec qui vous avez fait un pacte et qui ne vous ont manqué en rien. » Le miroir me montre l'exception honorable. « Illa alladhina 'ahadtum 'inda al-masjidi al-haram » — excepté ceux avec qui vous avez fait un pacte près de la Mosquée sacrée. Ceux qui respectent leurs engagements méritent le respect. Le miroir m'interroge : est-ce que je respecte mes engagements ?`,
  reflection: `Le respect des engagements est sacré. Ceux qui respectent leurs pactes méritent d'être respectés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina 'ahadtum 'inda al-masjidi al-harami » — excepté ceux avec qui vous avez fait un pacte près de la Mosquée sacrée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte mes engagements ? Même quand c'est difficile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect du pacte élève celui qui le pratique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur des engagements constants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte ses engagements reflète la fidélité d'Allah." }
  ],
  munajat: `Ya Amanah, Tu es le Fidèle. Fais que je sois fidèle à mes engagements. Ne permets pas que je manque à ma parole.`
};

MIROIR["9:5"] = {
  reference: "9:5",
  theme: ["combat", "mécréance", "pardon"],
  emotion: "Fermeté, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Ghafur"],
  mirrorVersion: `« Quand les mois sacrés expirent, tuez les idolâtres où que vous les trouviez. » Le miroir me montre le combat légitime. « Fa-qtulu al-mushrikin haythu wajadtumuhum » — tuez les idolâtres où que vous les trouviez. Mais aussi « fa-in tabu » — s'ils se repentent, laissez-les. La repentance ouvre la porte. Le miroir m'interroge : est-ce que je comprends que le combat a des limites et que la repentance est toujours possible ?`,
  reflection: `Le combat n'est pas éternel. La repentance est toujours ouverte. La miséricorde précède le combat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ida insalakha al-ashhuru al-hurumu fa-qtulu al-mushrikin haythu wajadtumuhum » — quand les mois sacrés expirent, tuez les idolâtres où que vous les trouviez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la repentance est toujours possible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La porte de la repentance est ouverte même pour les ennemis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est plus vaste que Son châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent même au dernier moment est accepté." }
  ],
  munajat: `Ya Ghafur, Tu ouvres la porte de la repentance. Fais que je me repente avant qu'il ne soit trop tard. Accepte le repentir de tous.`
};

MIROIR["9:6"] = {
  reference: "9:6",
  theme: ["asile", "coran", "protection"],
  emotion: "Justice, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "An-Nur"],
  mirrorVersion: `« Et si l'un des idolâtres te demande asile, accorde-le-lui afin qu'il entende la parole d'Allah. » Le miroir me montre l'asile spirituel. « Fa-ajirhu hatta yasma'a kalama Allah » — accorde-lui asile afin qu'il entende la parole d'Allah. L'objectif est la propagation du message, pas la destruction. Le miroir m'interroge : est-ce que je facilite l'accès au Coran pour les autres ?`,
  reflection: `L'asile est accordé pour que le message soit entendu. L'objectif est la guidance, pas la vengeance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in ahadun min al-mushrikin istajaraka fa-ajirhu hatta yasma'a kalama Allah » — et si l'un des idolâtres te demande asile, accorde-le-lui afin qu'il entende la parole d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je facilite l'accès au Coran pour les autres ? Ou est-ce que je le garde pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection mène à l'écoute. L'écoute mène à la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message d'Allah est pour tous, pas pour quelques-uns." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui facilite l'accès à la parole d'Allah est béni." }
  ],
  munajat: `Ya Nur, Tu es la Lumière. Fais que je propage Ta parole. Accorde l'asile à ceux qui cherchent la vérité.`
};

MIROIR["9:7"] = {
  reference: "9:7",
  theme: ["traité", "mosquée", "mécréance"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amin", "Al-Masjid"],
  mirrorVersion: `« Comment y aurait-il un pacte avec Allah et Son messager auprès de la Mosquée sacrée ? » Le miroir me montre l'incompatibilité. « Kayfa yakunu li-al-mushrikina 'ahdun » — comment y aurait-il un pacte pour les idolâtres ? L'idolâtrie est incompatible avec l'alliance divine. Le miroir m'interroge : est-ce que je comprends les limites de l'alliance ?`,
  reflection: `L'alliance avec Allah exclut l'idolâtrie. La Mosquée sacrée est pour les croyants purs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa yakunu li-al-mushrikina 'ahdun 'inda Allahi wa 'inda rasulihi » — comment y aurait-il un pacte avec Allah et Son messager ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que l'alliance avec Allah demande la pureté de la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance exclut la compromission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Mosquée sacrée est le symbole de la pureté monothéiste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entre dans l'alliance doit être pur." }
  ],
  munajat: `Ya Rabb, je veux être dans Ton alliance. Purifie ma foi de toute idolâtrie. Fais que je sois digne de la Mosquée sacrée.`
};

MIROIR["9:8"] = {
  reference: "9:8",
  theme: ["trahison", "serment", "mécréance"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Wafi"],
  mirrorVersion: `« Comment donc, quand ils dominent sur vous, ne respectent à votre égard ni lien de parenté ni engagement ? » Le miroir me montre l'opportuniste. « Law yaghlibunakum » — s'ils vous dominaient. La trahison est prête quand l'occasion se présente. Le miroir m'interroge : est-ce que je suis vigilant face aux opportunistes ?`,
  reflection: `Les opportunistes trahissent quand ils peuvent. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa wa in yazharu 'alaykum la yaqum lakum bi-dhāmmatin wa la bi-hillin » — comment donc, quand ils dominent sur vous, ne respectent à votre égard ni lien de parenté ni engagement ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vigilant face aux opportunistes ? Ou est-ce que je fais confiance aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance n'est pas paranoïa — c'est sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire enseigne que les opportunistes trahissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la nature humaine n'est pas surpris." }
  ],
  munajat: `Ya Khabir, Tu connais les cœurs. Donne-moi la vigilance nécessaire. Ne permets pas que je sois trahi par ma confiance aveugle.`
};

MIROIR["9:9"] = {
  reference: "9:9",
  theme: ["coran", "mécréance", "perte"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Haqq"],
  mirrorVersion: `« Ils ont vendu les signes d'Allah à vil prix et ont écarté de Son chemin. » Le miroir me montre le commerce spirituel. « Sharaw bi-ayati Allahi thamanan qalilan » — ils ont vendu les signes d'Allah à vil prix. Le Coran est ignoré pour des gains matériels. Le miroir m'interroge : est-ce que je vends ma foi pour des gains matériels ?`,
  reflection: `Le Coran a plus de valeur que tout gain matériel. Le vendre est une perte immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ishtaraw bi-ayati Allahi thamanan qalilan » — ils ont vendu les signes d'Allah à vil prix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vends ma foi pour des gains matériels ? Quelle valeur je donne au Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gain matériel est temporaire. Le Coran est éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la révélation finale pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la valeur du Coran ne l'échange jamais." }
  ],
  munajat: `Ya Haqq, Ton Coran est inestimable. Fais que je réalise sa valeur. Ne permets pas que je l'échange pour des gains temporaires.`
};

MIROIR["9:10"] = {
  reference: "9:10",
  theme: ["trahison", "serment", "mécréance"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wafi", "Al-Khabir"],
  mirrorVersion: `« Ils ne respectent à l'égard d'un croyant ni lien de parenté ni engagement. » Le miroir me montre l'absence de scrupules. « La yaqumuna li-mu'minin bi-dhāmmatin » — ils ne respectent pas les liens. Le mécréant sans foi n'a pas de limites morales. Le miroir m'interroge : est-ce que je respecte les liens et les engagements ?`,
  reflection: `Le respect des liens est une marque de foi. L'absence de respect révèle l'absence de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yaqumuna li-mu'minin bi-dhāmmatin wa la bi-hillin ula'ika hum al-mu'tadun » — ils ne respectent à l'égard d'un croyant ni lien de parenté ni engagement. Ceux-là sont les transgresseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les liens et les engagements ? Ou est-ce que je les transgresse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transgression des liens est le signe de l'absence de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les liens sont sacrés dans l'univers d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les liens reflète la fidélité d'Allah." }
  ],
  munajat: `Ya Wafi, Tu es le Fidèle. Fais que je respecte tous les liens. Ne permets pas que je sois un transgresseur.`
};

MIROIR["9:11"] = {
  reference: "9:11",
  theme: ["repentir", "prière", "fraternité"],
  emotion: "Espoir, ouverture",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahman"],
  mirrorVersion: `« Mais s'ils se repentent, accomplissent la prière et acquittent l'aumône, alors ce sont vos frères en religion. » Le miroir me montre le chemin de réintégration. « Fa-in tabu » — s'ils se repentent. « Fa-ikhwanukum fi al-din » — alors ce sont vos frères en religion. Le repentir ouvre la porte de la fraternité. Le miroir m'interroge : est-ce que j'accepte les repentis ?`,
  reflection: `Le repentir réintègre dans la communauté. La prière et l'aumône en sont les preuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in tabu wa aqamu al-salata wa atawu al-zakata fa-ikhwanukum fi al-din » — mais s'ils se repentent, accomplissent la prière et acquittent l'aumône, alors ce sont vos frères en religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les repentis ? Ou est-ce que je garde rancune ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rancune ferme la porte que la repentir ouvre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté est ouverte à tous les repentis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les repentis participe à la miséricorde d'Allah." }
  ],
  munajat: `Ya Tawwab, Tu acceptes le repentir. Fais que j'accepte les repentis. Ne permets pas que la rancune ferme mon cœur.`
};

MIROIR["9:12"] = {
  reference: "9:12",
  theme: ["serment", "combat", "mécréance"],
  emotion: "Fermeté, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Haqq"],
  mirrorVersion: `« Et s'ils violent leurs serments après avoir conclu un pacte, et attaquent votre religion, combattez les chefs de la mécréance. » Le miroir me montre la lutte contre les leaders. « Qatilu a'immat al-kufr » — combattez les chefs de la mécréance. Les leaders de la mécréance sont les premiers visés. Le miroir m'interroge : est-ce que je comprends l'importance de combattre les causes, pas seulement les symptômes ?`,
  reflection: `Les chefs de la mécréance sont les causes du mal. Les combattre coupe le mal à sa source.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in nakathu aymanahum min ba'di 'ahdihim wa ta'anu fi dinikum fa-qatilu a'immat al-kufr » — et s'ils violent leurs serments après avoir conclu un pacte, et attaquent votre religion, combattez les chefs de la mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je combats les causes du mal ? Ou est-ce que je me contente de traiter les symptômes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le combat des causes est plus efficace que le combat des effets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur des causes et des effets." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat les causes résout le problème à la racine." }
  ],
  munajat: `Ya Rabb, donne-moi la sagesse de combattre les causes. Ne permets pas que je me perde dans les symptômes. Guide-moi vers les racines du mal.`
};

MIROIR["9:13"] = {
  reference: "9:13",
  theme: ["combat", "justice", "alliance"],
  emotion: "Détermination, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "An-Nasir"],
  mirrorVersion: `« Ne combattrez-vous pas des gens qui ont violé leurs serments ? » Le miroir me montre le devoir de combat. « A-la tuqatiluna qawman nakathu aymanahum » — ne combattrez-vous pas des gens qui ont violé leurs serments ? La violation des serments est un casus belli. Le miroir m'interroge : est-ce que je comprends que la justice demande parfois le combat ?`,
  reflection: `Le combat est parfois nécessaire pour établir la justice. La violation des engagements justifie la guerre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-la tuqatiluna qawman nakathu aymanahum » — ne combattrez-vous pas des gens qui ont violé leurs serments ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la justice demande parfois le combat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix injuste n'est pas la paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers établit la justice par l'équilibre des forces." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat pour la justice participe à l'ordre divin." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Donne-moi la force de combattre pour la justice. Ne permets pas que je fuie mes responsabilités.`
};

MIROIR["9:14"] = {
  reference: "9:14",
  theme: ["victoire", "châtiment", "mécréance"],
  emotion: "Confiance, détermination",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Muntaqim"],
  mirrorVersion: `« Combattez-les, Allah les châtiera par vos mains et les couvrira d'ignominie. » Le miroir me montre la victoire par le combat. « Yu'adhdhibhumu Allahu bi-aydikum » — Allah les châtiera par vos mains. Le croyant est l'instrument du châtiment divin. Le miroir m'interroge : est-ce que je réalise que je peux être l'instrument de la justice d'Allah ?`,
  reflection: `Le croyant peut être l'instrument de la justice divine. Sa main exécute le décret d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qatiluhum yu'adhdhibhumu Allahu bi-aydikum » — combattez-les, Allah les châtiera par vos mains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je peux être l'instrument de la justice d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être l'instrument d'Allah est un honneur et une responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah utilise Ses créatures pour accomplir Ses décrets." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est choisi comme instrument doit être digne." }
  ],
  munajat: `Ya Nasir, Tu donnes la victoire. Si Tu me choisis comme instrument, rends-moi digne. Fais que ma main serve Ta justice.`
};

MIROIR["9:15"] = {
  reference: "9:15",
  theme: ["colère", "guérison", "foi"],
  emotion: "Espérance, soulagement",
  difficulty: "débutant",
  relatedNames: ["Ash-Shafi", "Ar-Rahman"],
  mirrorVersion: `« Et Il guérira les cœurs des croyants. » Le miroir me montre la guérison des cœurs. « Wa yushfi sudura qawmin mu'minin » — et Il guérira les cœurs des croyants. La victoire apaise les cœurs blessés. La justice guérit les traumatismes. Le miroir m'interroge : est-ce que mon cœur a besoin de guérison ?`,
  reflection: `La justice guérit les cœurs. Les traumatismes de l'injustice demandent réparation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yushfi sudura qawmin mu'minin » — et Il guérira les cœurs des croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cœur a besoin de guérison ? Qu'est-ce qui me blesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guérison vient d'Allah, pas du temps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cœurs guérissent par la justice et la miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est guéri peut aimer à nouveau." }
  ],
  munajat: `Ya Shafi, Tu guéris les cœurs. Guéris mon cœur des blessures de l'injustice. Fais que je retrouve la paix.`
};

MIROIR["9:16"] = {
  reference: "9:16",
  theme: ["épreuve", "sincérité", "foi"],
  emotion: "Vigilance, authenticité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mubtali", "Al-Sadiq"],
  mirrorVersion: `« Pensiez-vous que vous seriez laissés sans qu'Allah distingue ceux qui croient ? » Le miroir me montre l'épreuve révélatrice. « Am hasibtum an tutraku » — pensiez-vous que vous seriez laissés ? L'épreuve distingue les vrais croyants des faux. Le miroir m'interroge : est-ce que je suis prêt à être testé ?`,
  reflection: `L'épreuve révèle la vérité de la foi. Le croyant sincère passe le test.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am hasibtum an tutraku wa lamma ya'lami Allahu alladhina jahadu minkum » — pensiez-vous que vous seriez laissés sans qu'Allah distingue ceux qui luttent parmi vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à être testé ? Ma foi est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve n'est pas punition — elle est révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est testé pour sa valeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe le test est reconnu par Allah." }
  ],
  munajat: `Ya Mubtali, Tu testes les cœurs. Prépare-moi pour l'épreuve. Fais que ma foi soit sincère et que je passe le test.`
};

MIROIR["9:17"] = {
  reference: "9:17",
  theme: ["mosquée", "mécréance", "témoin"],
  emotion: "Lucidité, exclusivité",
  difficulty: "débutant",
  relatedNames: ["Al-Masjid", "Ash-Shahid"],
  mirrorVersion: `« Il n'appartient pas aux idolâtres de peupler les mosquées d'Allah. » Le miroir me montre l'exclusivité de la mosquée. « Ma kana li-al-mushrikina an ya'muru masajida Allah » — il n'appartient pas aux idolâtres de peupler les mosquées. La mosquée est pour les croyants. Le miroir m'interroge : est-ce que je fréquente la mosquée comme un croyant ?`,
  reflection: `La mosquée est le lieu de la foi pure. L'idolâtre n'y a pas sa place.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana li-al-mushrikina an ya'muru masajida Allahi shahidina 'ala anfusihim bi-al-kufr » — il n'appartient pas aux idolâtres de peupler les mosquées d'Allah, pendant qu'ils sont témoins contre eux-mêmes de leur mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fréquente la mosquée comme un croyant ? Ou est-ce que je suis hypocrite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mosquée accueille les cœurs purs, pas les visages hypocrites." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mosquée est le centre spirituel de la communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fréquente la mosquée avec sincérité est béni." }
  ],
  munajat: `Ya Rabb, je veux fréquenter Ta mosquée avec sincérité. Purifie mon cœur. Ne permets pas que je sois un hypocrite dans Ta maison.`
};

MIROIR["9:19"] = {
  reference: "9:19",
  theme: ["service", "foi", "comparaison"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadi", "Al-Hakam"],
  mirrorVersion: `« Faites-vous de la charge d'abreuver les pèlerins et de l'entretien de la Mosquée sacrée une oeuvre égale à celle de celui qui croit en Allah ? » Le miroir me montre la hiérarchie des actions. « A-ja'altum siqayata al-hajji wa 'imārata al-masjidi al-harami » — faites-vous du service de la Mosquée une oeuvre égale à celle de la foi ? Le service sans foi est inférieur à la foi. Le miroir m'interroge : est-ce que je comprends la hiérarchie des valeurs ?`,
  reflection: `Le service de la mosquée est noble, mais inférieur à la foi et au combat pour Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-ja'altum siqayata al-hajji wa 'imārata al-masjidi al-harami ka-man amana bi-Allahi » — faites-vous de la charge d'abreuver les pèlerins et de l'entretien de la Mosquée sacrée une oeuvre égale à celle de celui qui croit en Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la hiérarchie des valeurs ? Qu'est-ce qui est le plus important pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le service sans foi est vide. La foi sans service est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est le fondement. Le service est l'expression." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi et sert est le plus complet." }
  ],
  munajat: `Ya Hakam, Tu juges avec sagesse. Donne-moi la foi d'abord, puis le service. Fais que je comprenne la hiérarchie des valeurs.`
};

MIROIR["9:20"] = {
  reference: "9:20",
  theme: ["foi", "hijra", "jihad", "récompense"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'izz", "Al-Wa'ud"],
  mirrorVersion: `« Ceux qui ont cru, émigré et lutté dans le chemin d'Allah, ceux-là ont le plus grand rang. » Le miroir me montre le sommet de la hiérarchie. « Ula'ika a'zamu darajatan » — ceux-là ont le plus grand rang. La foi, l'hijra et le jihad mènent au sommet. Le miroir m'interroge : quel rang je vise ?`,
  reflection: `Le plus grand rang est pour ceux qui combinent foi, engagement et effort. C'est le chemin de l'excellence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika a'zamu darajatan 'inda Allah » — ceux-là ont le plus grand rang auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel rang je vise ? Est-ce que je vise le sommet ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rang élevé demande un engagement total." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'excellence dans la foi mène à l'excellence dans le rang." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vise le sommet l'atteint par la grâce d'Allah." }
  ],
  munajat: `Ya Mu'izz, Tu élèves les rangs. Je vise le plus grand rang. Donne-moi la foi, l'engagement et l'effort nécessaires.`
};

MIROIR["9:21"] = {
  reference: "9:21",
  theme: ["bonne nouvelle", "miséricorde", "paradis"],
  emotion: "Joie, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Ar-Rahman"],
  mirrorVersion: `« Ton Seigneur les annonce par une miséricorde venant de Lui et une satisfaction. » Le miroir me montre la bonne nouvelle divine. « Yubashshiruhum rabbuhum bi-rahmatin minhu » — ton Seigneur les annonce par une miséricorde. La miséricorde et la satisfaction d'Allah sont la meilleure nouvelle. Le miroir m'interroge : est-ce que je me réjouis de cette bonne nouvelle ?`,
  reflection: `La miséricorde et la satisfaction d'Allah sont les meilleures récompenses. Le Paradis en est l'accomplissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yubashshiruhum rabbuhum bi-rahmatin minhu wa ridwanin wa jannatin » — ton Seigneur les annonce par une miséricorde venant de Lui, une satisfaction et des jardins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me réjouis de la bonne nouvelle d'Allah ? Ou est-ce que je suis indifférent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne nouvelle d'Allah est plus précieuse que tout bien matériel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination finale des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la bonne nouvelle y croit et œuvre pour elle." }
  ],
  munajat: `Ya Bashir, Tu annonces la bonne nouvelle. Je me réjouis de Ta miséricorde. Fais que j'entende cette annonce pour moi.`
};

MIROIR["9:22"] = {
  reference: "9:22",
  theme: ["paradis", "éternité", "récompense"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khuld", "Al-Firdaws"],
  mirrorVersion: `« Ils y demeureront éternellement. Certes, auprès d'Allah est une énorme récompense. » Le miroir me montre l'éternité du Paradis. « Khalidina fiha abadan » — ils y demeureront éternellement. Le Paradis n'est pas temporaire — il est éternel. Le miroir m'interroge : est-ce que j'œuvre pour l'éternité ?`,
  reflection: `Le Paradis est éternel. L'effort pour l'atteindre est un investissement pour l'éternité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalidina fiha abadan inna Allaha 'indahu ajrun 'azim » — ils y demeureront éternellement. Certes, auprès d'Allah est une énorme récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour l'éternité ? Ou est-ce que je me concentre sur le temporaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité demande un investissement maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'éternité du Paradis contraste avec la fugacité de ce monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui investit pour l'éternité reçoit la récompense éternelle." }
  ],
  munajat: `Ya Rabb, je veux l'éternité au Paradis. Fais que j'investisse maintenant pour l'éternité. Donne-moi la récompense éternelle.`
};

// ============================================
// SURAH 17 (AL-ISRA) - EXPANSION
// ============================================

MIROIR["17:2"] = {
  reference: "17:2",
  theme: ["moïse", "livre", "guidance"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Hadi"],
  mirrorVersion: `« Nous avons donné le Livre à Moïse et en avons fait une guidance pour les Enfants d'Israël. » Le miroir me montre le don du Livre. La guidance n'est pas nouvelle — elle a toujours été donnée aux prophètes. Moïse a reçu un Livre pour guider son peuple. Le Coran continue cette tradition. Le miroir m'interroge : est-ce que je reconnais le Coran comme la continuation de la guidance ?`,
  reflection: `La guidance a une histoire. Le Coran est le dernier maillon d'une chaîne prophétique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa atayna Musa al-kitaba wa ja'alnahu huda li bani Isra'il » — Nous avons donné le Livre à Moïse et en avons fait une guidance pour les Enfants d'Israël." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que le Coran fait partie d'une longue tradition de guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Livre de Moïse guidait. Le Coran guide encore." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance divine est universelle dans le temps et l'espace." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la chaîne de la guidance s'y attache." }
  ],
  munajat: `Ya Hadi, Tu as envoyé des Livres depuis toujours. Fais que je reconnaisse le Coran comme Ton dernier message. Attache-moi à Ta guidance éternelle.`
};

MIROIR["17:3"] = {
  reference: "17:3",
  theme: ["descendance", "responsabilité", "alliance"],
  emotion: "Responsabilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Wakil"],
  mirrorVersion: `« Ô descendants de ceux que Nous avons portés avec Noé ! Il était vraiment un serviteur reconnaissant. » Le miroir me montre la continuité de la responsabilité. Nous sommes les descendants de ceux qu'Allah a sauvés. Noé était reconnaissant — ses descendants doivent l'être aussi. Le miroir m'interroge : est-ce que je suis reconnaissant comme mon ancêtre ?`,
  reflection: `La reconnaissance n'est pas individuelle — elle peut être familiale, communautaire, générationnelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya dhurriyata man hamalna ma'a Nuhin innahu kana 'abdan shakura » — Ô descendants de ceux que Nous avons portés avec Noé ! Il était vraiment un serviteur reconnaissant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant comme l'était Noé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude du descendant peut annuler la gratitude de l'ancêtre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité est une famille. La reconnaissance doit être transmise." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant hérite de la reconnaissance de ses ancêtres." }
  ],
  munajat: `Ya Wali, Tu as sauvé mes ancêtres. Fais que je sois reconnaissant comme eux. Ne laisse pas l'ingratitude rompre la chaîne de la reconnaissance.`
};

MIROIR["17:4"] = {
  reference: "17:4",
  theme: ["prophtétie", "corruption", "punition"],
  emotion: "Gravité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Hakam"],
  mirrorVersion: `« Et Nous avons décrété dans le Livre, pour les Enfants d'Israël : "Vous commettrez deux fois la corruption sur terre." » Le miroir me montre la préconnaissance divine. Allah savait que les Enfants d'Israël corrompraient deux fois. Le décret était écrit avant même les actions. Le miroir m'interroge : est-ce que je réalise que Allah connaît mes actions avant que je les fasse ?`,
  reflection: `La préconnaissance divine n'annule pas le libre arbitre. Elle montre la maîtrise d'Allah sur le temps.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qadayna ila bani Isra'il fi al-kitabi latufsidunna fi al-ardi marratayn » — Et Nous avons décrété dans le Livre, pour les Enfants d'Israël : 'Vous commettrez deux fois la corruption sur terre'." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que Allah connaît mes actions d'avance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préconnaissance divine n'est pas une excuse pour le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est écrite d'avance. Nous choisissons notre rôle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le décret divin s'y conforme par choix." }
  ],
  munajat: `Ya 'Alim, Tu connais mes actions avant que je les fasse. Aide-moi à choisir le bien. Fais que je ne sois pas parmi les corrupteurs.`
};

MIROIR["17:5"] = {
  reference: "17:5",
  theme: ["punition", "violence", "conséquence"],
  emotion: "Gravité, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Lorsque vint l'accomplissement de la première, Nous avons envoyé contre vous des serviteurs à Nous doués d'une force terrible. » Le miroir me montre la conséquence de la corruption. La première corruption a entraîné une punition terrible. Allah a envoyé des serviteurs violents pour châtier. Le miroir m'interroge : qu'est-ce que ma corruption attirera-t-elle ?`,
  reflection: `La corruption attire le châtiment. La violence est parfois l'instrument de la justice divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa idha jaa wa'du al-ula ba'athna 'alaykum 'ibadan lana uli ba'sin shadid » — Lorsque vint l'accomplissement de la première, Nous avons envoyé contre vous des serviteurs à Nous doués d'une force terrible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma corruption attirera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui détruit peut être envoyé par Allah comme châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de civilisations détruites pour leur corruption." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la corruption évite le châtiment." }
  ],
  munajat: `Ya Jabbar, garde-moi de la corruption. Ne laisse pas Ton châtiment m'atteindre. Protège-moi de moi-même.`
};

MIROIR["17:6"] = {
  reference: "17:6",
  theme: ["restauration", "victoire", "retour"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Fattah"],
  mirrorVersion: `« Puis Nous vous avons donné le retour sur eux, et vous avons aidés par des biens et des enfants. » Le miroir me montre le cycle de la restauration. Après la punition vient la restoration. Allah donne le retour, les biens, les enfants. La miséricorde suit la justice. Le miroir m'interroge : est-ce que je profite de la restoration pour me rapprocher d'Allah ?`,
  reflection: `La restoration suit le repentir. Les biens et les enfants sont des signes de la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma radadna lakumu al-karata 'alayhim wa ammadnakum bi amwalin wa banina » — Puis Nous vous avons donné le retour sur eux, et vous avons aidés par des biens et des enfants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise la restoration pour me rapprocher d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La restoration n'est pas un droit — c'est une miséricorde à préserver." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cycles de chute et de restauration rythment l'histoire humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise la restoration pour le bien obtient la stabilisation." }
  ],
  munajat: `Ya Nasir, Tu me restuaures après les chutes. Fais que je profite de Tes bienfaits pour me rapprocher de Toi. Ne laisse pas l'abondance m'éloigner.`
};

MIROIR["17:7"] = {
  reference: "17:7",
  theme: ["bien", "mal", "promesse"],
  emotion: "Responsabilité, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Wa'id"],
  mirrorVersion: `« Si vous faites le bien, vous le faites pour vous-mêmes ; et si vous faites le mal, c'est contre vous-mêmes. » Le miroir me montre la circularité des actions. Le bien revient à son auteur. Le mal aussi. Personne n'est lésé par le bien d'autrui, personne n'est puni pour le mal d'autrui. Le miroir m'interroge : est-ce que je réalise que mes actions me reviennent ?`,
  reflection: `L'action est un boomerang. Le bien fait du bien à celui qui le fait. Le mal fait du mal à celui qui le fait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In ahsantum ahsantum li anfusikum wa in asa'tum falaha » — Si vous faites le bien, vous le faites pour vous-mêmes ; et si vous faites le mal, c'est contre vous-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que chaque action me revient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se faire du mal à soi-même par le mal est le comble de l'absurdité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi du retour est universelle. Chaque cause a son effet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le retour fait le bien par intérêt éclairé." }
  ],
  munajat: `Ya Rabb, fais que je fasse le bien pour mon propre bien. Garde-moi de me faire du mal par le mal. Ouvre mes yeux à la circularité de mes actions.`
};

MIROIR["17:8"] = {
  reference: "17:8",
  theme: ["punition", "miséricorde", "retour"],
  emotion: "Gravité, espérance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahim", "Al-Muntaqim"],
  mirrorVersion: `« Peut-être votre Seigneur vous fera-t-Il miséricorde. Mais si vous récidivez, Nous récidiverons. » Le miroir me montre la balance entre miséricorde et justice. Le repentir attire la miséricorde. La récidive attire le châtiment renouvelé. La porte est ouverte, mais pas indéfiniment. Le miroir m'interroge : est-ce que je me repens vraiment ou est-ce que je récidive ?`,
  reflection: `La miséricorde est possible mais pas automatique. La récidive annule le repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Asa rabbukum an yarhamakum wa in 'udtum 'udna » — Peut-être votre Seigneur vous fera-t-Il miséricorde. Mais si vous récidivez, Nous récidiverons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens vraiment ? Ou est-ce que je récidive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir sincère attire la miséricorde. Le faux repentir attire le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde précède toujours la justice dans le plan divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement n'a plus peur de la récidive." }
  ],
  munajat: `Ya Rahim, Ta miséricorde m'attend. Fais que je me repens sincèrement. Ne laisse pas la récidive fermer la porte de Ta miséricorde.`
};

MIROIR["17:10"] = {
  reference: "17:10",
  theme: ["au-delà", "châtiment", "avertissement"],
  emotion: "Gravité, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Akhira", "Al-Jahim"],
  mirrorVersion: `« Et qu'à ceux qui ne croient pas en l'au-delà, Nous avons préparé un châtiment douloureux. » Le miroir me montre la conséquence de l'incrédulité. Ne pas croire en l'au-delà n'annule pas son existence. Le châtiment est préparé pour ceux qui nient. Le miroir m'interroge : est-ce que je crois vraiment en l'au-delà ?`,
  reflection: `L'incrédulité n'est pas une protection — c'est une exposition. Le châtiment attend celui qui nie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna alladhina la yu'minuna bi al-akhirati a'tadna lahum 'adhaban ali'm » — Et qu'à ceux qui ne croient pas en l'au-delà, Nous avons préparé un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en l'au-delà ? Ma vie le montre-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas croire n'annule pas la réalité. L'au-delà existe qu'on y croie ou non." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort mène à l'au-delà pour tous. La différence est la préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en l'au-delà vit comme un voyageur qui prépare son arrivée." }
  ],
  munajat: `Ya Akhira, Tu es ma destination. Fortifie ma foi en Toi. Fais que je vive en sachant que Tu m'attends.`
};

MIROIR["17:11"] = {
  reference: "17:11",
  theme: ["précipitation", "invocation", "humanité"],
  emotion: "Humilité, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Mujib"],
  mirrorVersion: `« L'homme est prompt à appeler le mal. » Le miroir me montre l'impatience humaine. L'homme invoque le mal par précipitation, comme il invoquait le bien. Il ne sait pas ce qui est bon pour lui. Le miroir m'interroge : est-ce que j'invoque avec sagesse ou précipitation ?`,
  reflection: `L'impatience dans l'invocation révèle le manque de confiance. Allah sait ce qui est bon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kana al-insanu 'ajulan » — L'homme est prompt à appeler le mal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque avec précipitation ? Est-ce que je demande le mal en croyant demander le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La précipitation dans l'invocation peut inverser le résultat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est le test de la patience. L'impatient échoue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente dans l'invocation reçoit ce qui est vraiment bon." }
  ],
  munajat: `Ya Hakim, Tu sais ce qui est bon pour moi. Fais que j'invoque avec sagesse et patience. Ne laisse pas ma précipitation m'égarer.`
};

MIROIR["17:12"] = {
  reference: "17:12",
  theme: ["nuit", "jour", "signes"],
  emotion: "Contemplation, gratitude",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Khaliq"],
  mirrorVersion: `« Nous avons fait de la nuit et du jour deux signes. » Le miroir me montre les signes quotidiens. La nuit et le jour alternent selon un ordre précis. Cette régularité est un signe d'Allah. Le miroir m'interroge : est-ce que je contemple l'alternance du jour et de la nuit ?`,
  reflection: `Le jour et la nuit sont des signes constants. Leur régularité témoigne de l'ordre divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna al-layla wa al-nahara ayatayn » — Nous avons fait de la nuit et du jour deux signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'alternance du jour et de la nuit comme un signe d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La régularité du jour et de la nuit cache la merveille de leur création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la terre connaît l'alternance. C'est un signe universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple le jour et la nuit contemple la fidélité d'Allah." }
  ],
  munajat: `Ya Nur, le jour et la nuit sont Tes signes. Ouvre mes yeux pour les voir. Fais que chaque lever et coucher de soleil me rappelle Ta fidélité.`
};

MIROIR["17:13"] = {
  reference: "17:13",
  theme: ["destin", "cou", "jugement"],
  emotion: "Responsabilité, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Katib"],
  mirrorVersion: `« À chaque homme Nous avons attaché son destin à son cou. » Le miroir me montre la proximité du destin. Les actions sont attachées au cou de chacun — indissociables. On ne peut pas fuir ce qu'on a fait. Le miroir m'interroge : qu'est-ce qui est attaché à mon cou ?`,
  reflection: `Les actions nous suivent comme une ombre. Elles sont attachées indissociablement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kulla insanin alzamnahu ta'irahu fi 'unuqihi » — À chaque homme Nous avons attaché son destin à son cou." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est attaché à mon cou ? Quelles actions me suivent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est attaché au cou ne peut être détaché que par le pardon divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être porte son destin. Personne ne peut le porter à sa place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien porte un fardeau léger. Celui qui fait le mal porte un fardeau lourd." }
  ],
  munajat: `Ya Hasib, mes actions me suivent. Fais que ce qui est attaché à mon cou soit léger — fait de bienfaits et non de péchés. Pardonne-moi ce qui est lourd.`
};

MIROIR["17:14"] = {
  reference: "17:14",
  theme: ["livre", "compte", "lecture"],
  emotion: "Responsabilité, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Katib"],
  mirrorVersion: `« Lis ton livre. Aujourd'hui, tu suffis pour te demander compte à toi-même. » Le miroir me montre le moment de la lecture. Le Jour du Jugement, chacun lira son propre livre. Il n'y aura pas besoin de juge extérieur — le livre suffit. Le miroir m'interroge : qu'est-ce que mon livre contient ?`,
  reflection: `Le livre est le témoin irréfutable. Chacun est juge de lui-même par son propre livre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iqra' kitabaka kafa bi nafsika al-yawma 'alayka hasiba » — Lis ton livre. Aujourd'hui, tu suffis pour te demander compte à toi-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon livre contient aujourd'hui ? Que dirait-il si je le lisais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le livre ne ment pas. Il enregistre tout avec précision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout acte est enregistré. Le livre est le registre de l'univers pour chaque âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écrit de bonnes actions lit un beau livre." }
  ],
  munajat: `Ya Hasib, mon livre m'attend. Fais que j'y écrive de bonnes actions. Donne-moi un livre dont la lecture me fera plaisir le Jour du Jugement.`
};

MIROIR["17:15"] = {
  reference: "17:15",
  theme: ["guidance", "responsabilité", "messager"],
  emotion: "Justice, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Mursal"],
  mirrorVersion: `« Celui qui est bien guidé l'est pour lui-même ; celui qui s'égare, s'égare à son propre détriment. » Le miroir me montre l'individualité de la guidance. La guidance profite à celui qui la suit. L'égarement nuit à celui qui s'égare. Personne ne porte le fardeau d'autrui. Le miroir m'interroge : suis-je bien guidé ou égaré ?`,
  reflection: `La guidance et l'égarement sont des choix personnels aux conséquences personnelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mani ihtada fa innama yahtadi li nafsihi wa man dalla fa innama yadillu 'alayha » — Celui qui est bien guidé l'est pour lui-même ; celui qui s'égare, s'égare à son propre détriment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je bien guidé ou égaré ? Personne ne peut répondre à ma place." },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Blâmer les autres pour son égarement ne change rien au résultat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme est responsable d'elle-même. C'est une loi universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa responsabilité trouve la voie de la correction." }
  ],
  munajat: `Ya 'Adl, je suis responsable de ma guidance. Fais que je choisisse d'être bien guidé. Ne laisse pas mon égarement nuire qu'à moi-même.`
};

MIROIR["17:16"] = {
  reference: "17:16",
  theme: ["destruction", "prophète", "avertissement"],
  emotion: "Gravité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Nadhir"],
  mirrorVersion: `« Et Nous ne détruisons une cité que lorsqu'elle a des avertisseurs. » Le miroir me montre la justice dans la destruction. Allah ne détruit pas sans avoir envoyé des avertisseurs. Le rejet des avertisseurs entraîne la destruction. Le miroir m'interroge : est-ce que j'écoute les avertisseurs ?`,
  reflection: `La destruction suit le rejet des avertisseurs. Le Prophète est l'avertisseur pour notre époque.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma uhlikna min qaryatin illa wa laha mundhirun » — Et Nous ne détruisons une cité que lorsqu'elle a des avertisseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute les avertisseurs ? Le Prophète m'a averti." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement non écouté devient le verdict de destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de cités détruites après avoir rejeté les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertisseur évite la destruction." }
  ],
  munajat: `Ya Nadhir, Tu as envoyé des avertisseurs. Fais que j'écoute le Prophète. Ne laisse pas mon rejet de l'avertissement m'entraîner vers la destruction.`
};

MIROIR["17:17"] = {
  reference: "17:17",
  theme: ["générations", "destruction", "mémoire"],
  emotion: "Humilité, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Qahhar"],
  mirrorVersion: `« Que de générations Nous avons détruites après Noé ! » Le miroir me montre la répétition de l'histoire. Après Noé, beaucoup de générations ont été détruites. L'histoire se répète pour ceux qui n'apprennent pas. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire est un maître. Ceux qui n'apprennent pas répètent les erreurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kam ahlakna mina al-quruni min ba'di Nuh » — Que de générations Nous avons détruites après Noé !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je la répète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des anciens est un avertissement pour les modernes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ruines témoignent des civilisations disparues." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les générations passées ne les imite pas dans l'erreur." }
  ],
  munajat: `Ya Hakam, l'histoire est Ton enseignement. Fais que j'apprenne des générations passées. Ne laisse pas mon arrogance m'aveugler comme elles.`
};

MIROIR["17:18"] = {
  reference: "17:18",
  theme: ["monde", "précipitation", "éternité"],
  emotion: "Choix, décision",
  difficulty: "débutant",
  relatedNames: ["Al-'Ajil", "Al-Ajalah"],
  mirrorVersion: `« Quiconque désire cette vie immédiate, Nous Nous empressons de lui donner ce que Nous voulons. » Le miroir me montre le choix de ce monde. Désirer ce monde, c'est l'obtenir — mais sans garantie de satisfaction. Allah donne ce qu'Il veut, pas ce que l'homme veut. Le miroir m'interroge : quel monde est-ce que je désire ?`,
  reflection: `Ce monde est obtenu par le désir. Mais ce n'est pas forcément ce qui satisfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kana yuridu al-'ajilata 'ajjalna lahu fiha ma nasha'u » — Quiconque désire cette vie immédiate, Nous Nous empressons de lui donner ce que Nous voulons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel monde est-ce que je désire ? L'immédiat ou l'éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'immédiat satisfait momentanément. L'éternel satisfait pour toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monde passe. L'au-delà reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire l'éternel obtient l'immédiat en bonus." }
  ],
  munajat: `Ya Rabb, ne laisse pas mon cœur désirer l'immédiat au détriment de l'éternel. Fais que je choisisse le monde qui ne passe pas.`
};

MIROIR["17:19"] = {
  reference: "17:19",
  theme: ["au-delà", "effort", "récompense"],
  emotion: "Espoir, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Dar", "Al-Muta"],
  mirrorVersion: `« Et quiconque désire l'au-delà et fait l'effort nécessaire tout en étant croyant... ceux-là verront leurs efforts reconnus. » Le miroir me montre la formule de la réussite éternelle. Désirer l'au-delà + faire l'effort + être croyant = récompense reconnue. Les trois conditions sont nécessaires. Le miroir m'interroge : est-ce que j'ai les trois ?`,
  reflection: `La récompense de l'au-delà exige le désir, l'effort et la foi. Les trois sont nécessaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man arada al-akhirata wa sa'a fiha sa'yaha wa huwa mu'min » — Et quiconque désire l'au-delà et fait l'effort nécessaire tout en étant croyant..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai le désir, l'effort et la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désir sans effort est rêve. L'effort sans foi est vanité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout résultat exige les bonnes causes. L'au-delà aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réunit les trois conditions obtient la récompense promise." }
  ],
  munajat: `Ya Dar, je désire Ton au-delà. Donne-moi la force de l'effort et la certitude de la foi. Reconnais mes efforts et récompense-les.`
};

MIROIR["17:20"] = {
  reference: "17:20",
  theme: ["don", "générosité", "tous"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« À chacun Nous accordons les dons de ton Seigneur. » Le miroir me montre la générosité universelle. Allah donne à tous — croyants et mécréants, bons et mauvais. Ses dons ne sont pas réservés à un groupe. Le miroir m'interroge : est-ce que je reconnais que les dons d'Allah sont universels ?`,
  reflection: `La générosité d'Allah englobe tous les êtres. Les dons sont pour tous, mais la reconnaissance varie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullan numiddu ha'ula'i wa ha'ula'i min 'ata'i rabbika » — À chacun Nous accordons les dons de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que les dons d'Allah sont pour tous ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don universel appelle la reconnaissance universelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil brille pour tous. La pluie tombe pour tous. Les dons d'Allah sont universels." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le don universel participe à la reconnaissance universelle." }
  ],
  munajat: `Ya Razzaq, Tu donnes à tous. Fais que je sois parmi les reconnaissants. Ne laisse pas Ton don m'éloigner de Toi.`
};

MIROIR["17:21"] = {
  reference: "17:21",
  theme: ["différence", "rangs", "au-delà"],
  emotion: "Réflexion, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Fadl", "Al-Mutafaddil"],
  mirrorVersion: `« Regarde comment Nous avons privilégié certains d'entre eux sur d'autres. » Le miroir me montre les différences dans ce monde. Certains sont privilégiés sur d'autres — en biens, en rang, en dons. Mais la vraie différence sera dans l'au-delà. Le miroir m'interroge : est-ce que je cherche le privilège de ce monde ou celui de l'au-delà ?`,
  reflection: `Les différences de ce monde sont temporaires. Celles de l'au-delà sont éternelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Unzur kayfa faddalna ba'dahum 'ala ba'd » — Regarde comment Nous avons privilégié certains d'entre eux sur d'autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel privilège est-ce que je recherche ? Celui de ce monde ou de l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le privilégié de ce monde peut être le déshérité de l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les différences sont dans la création. L'égalité sera dans le jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le privilège éternel obtient le temporaire en bonus." }
  ],
  munajat: `Ya Fadl, Tu privilégies qui Tu veux. Fais que je cherche Ton privilège éternel. Ne laisse pas les différences de ce monde m'égarer.`
};

MIROIR["17:22"] = {
  reference: "17:22",
  theme: ["unicité", "pauvreté", "abandon"],
  emotion: "Vigilance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Wakil"],
  mirrorVersion: `« N'associe pas une autre divinité à Allah, sinon tu resteras blâmé et abandonné. » Le miroir me montre la conséquence de l'association. Associé Allah, c'est s'exposer au blâme et à l'abandon. L'unicité est la protection. Le miroir m'interroge : est-ce que je garde mon cœur pur de toute association ?`,
  reflection: `L'association est le péché impardonnable. L'unicité est la protection éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La taj'al ma'a Allahi ilahan akhar fataq'uda mathmuman makhdhula » — N'associe pas une autre divinité à Allah, sinon tu resteras blâmé et abandonné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'associe quoi que ce soit à Allah dans mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon du associateur est la conséquence de son propre choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est le fondement de la relation avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde l'unicité n'est jamais abandonné." }
  ],
  munajat: `Ya Wahid, Tu es le seul. Garde mon cœur pur de toute association. Ne me laisse jamais blâmé ni abandonné.`
};
// ============================================
// SURAH 4 - AN-NISA (The Women) - COMPLETE COVERAGE
// 176 verses total - Adding all missing entries
// ============================================

MIROIR["4:2"] = {
  reference: "4:2",
  theme: ["justice", "protection", "responsabilité"],
  emotion: "Vigilance protectrice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Ar-Raqib"],
  mirrorVersion: `« Et rendez aux orphelins leurs biens. Ne substituez pas de mauvaises choses aux bonnes. » Le miroir me place devant la responsabilité envers les plus vulnérables. L'orphelin n'a pas de protecteur naturel — Allah le prend sous Sa protection et m'appelle à être Son agent. « Atawdu » — ne substituez pas — le verbe évoque un échange frauduleux. Le miroir me montre que la justice n'est pas seulement de ne pas voler, mais de ne pas profiter de la vulnérabilité d'autrui.`,
  reflection: `La protection des orphelins est un devoir sacré. Allah veille sur ceux qui n'ont personne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa atu al-yatama amwalahum » — et rendez aux orphelins leurs biens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite ceux qui sont sous ma protection ? Avec justice ou avec opportunisme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je fais aux vulnérables, je le fais à moi-même. La société se mesure à sa protection des faibles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature vulnérable est sous la protection divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège l'orphelin est protégé par Allah." }
  ],
  munajat: `Ya Hakam, Tu m'as confié des responsabilités. Fais que je sois juste envers ceux qui sont sous ma protection. Ne me laisse pas profiter de la vulnérabilité d'autrui.`
};

MIROIR["4:3"] = {
  reference: "4:3",
  theme: ["justice", "mariage", "équilibre"],
  emotion: "Responsabilité mesurée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hakim"],
  mirrorVersion: `« Et si vous craignez de ne pas être équitables envers les orphelins, épousez des femmes parmi celles qui vous plaisent — deux, trois ou quatre. Mais si vous craignez de ne pas être justes, alors une seule. » Le miroir me montre un verset souvent mal compris. La polygamie n'est pas une permission sans condition — elle est encadrée par la justice. « In khiftum alla ta'dilu » — si vous craignez de ne pas être justes. La condition est stricte. Le miroir m'invite à l'honnêteté : puis-je vraiment être juste avec plusieurs épouses ? La réponse du cœur est souvent claire.`,
  reflection: `La justice est la condition de toute relation. Sans justice, la multiplicité devient oppression.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in khiftum alla ta'dilu » — mais si vous craignez de ne pas être justes, alors une seule." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je peux être juste dans mes relations ? Le miroir m'invite à l'honnêteté radicale." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La restriction à une seule n'est pas une punition — c'est une protection contre l'injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équilibre est la loi de l'univers. L'excès crée le désordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste avec une seule épouse a accompli la condition divine." }
  ],
  munajat: `Ya Adl, Tu exige la justice dans toutes mes relations. Aide-moi à connaître mes limites et à ne pas m'engager au-delà de ma capacité d'être juste.`
};

MIROIR["4:4"] = {
  reference: "4:4",
  theme: ["dignité", "mariage", "don"],
  emotion: "Générosité respectueuse",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wahhab"],
  mirrorVersion: `« Et donnez aux femmes leurs dots de bonne grâce. » Le miroir me montre la dignité de la femme dans le mariage. « Saduqatihinna » — leurs dots — est un droit, pas un achat. « Nihlatan » — de bon cœur — l'esprit du don compte autant que le don lui-même. Le miroir m'invite à voir le mariage non comme une transaction, mais comme une alliance honorable.`,
  reflection: `La dot n'est pas le prix de la femme — c'est la reconnaissance de sa dignité et de sa sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa atu al-nisa saduqatihinna nihlatan » — et donnez aux femmes leurs dots de bon cœur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je considère le mariage ? Comme une transaction ou comme une alliance sacrée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dot donnée de bon cœur devient bénédiction. Celle donnée à contrecoeur devient fardeau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout don sincère attire la grâce divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La générosité dans le mariage ouvre la porte de la baraka conjugale." }
  ],
  munajat: `Ya Karim, Tu es le plus généreux. Fais que je sois généreux dans mes relations. Bénis les mariages avec la dignité que Tu veux.`
};

MIROIR["4:5"] = {
  reference: "4:5",
  theme: ["responsabilité", "sagesse", "protection"],
  emotion: "Prudence éclairée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Hafiz"],
  mirrorVersion: `« Ne confiez pas aux incapables vos biens qu'Allah a fait subsister pour vous. » Le miroir me montre la gestion responsable. « Sufaha' » — les incapables, les insensés — ne doivent pas gérer ce qui a de la valeur. Le verset parle des biens matériels, mais le principe s'applique à tout : mes responsabilités, ma famille, ma spiritualité. Le miroir m'invite à discerner qui est capable de porter ce que j'ai à confier.`,
  reflection: `La gestion responsable demande discernement. Confier à qui ne peut pas porter, c'est perdre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tu'tu al-sufaha' amwalakum » — ne confiez pas aux incapables vos biens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je confie ce qui compte ? Ai-je discerné la capacité du receveur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas confier n'est pas méfiance — c'est sagesse et protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers confie chaque responsabilité à celui qui peut la porter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La bonne gestion attire la confiance divine." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse de bien gérer ce que Tu m'as confié. Aide-moi à discerner les capacités de chacun.`
};

MIROIR["4:6"] = {
  reference: "4:6",
  theme: ["éducation", "responsabilité", "maturité"],
  emotion: "Patience éducative",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muwaffiq", "Ar-Rashid"],
  mirrorVersion: `« Et éprouvez les orphelins jusqu'à ce qu'ils atteignent l'âge du mariage. Si vous constatez en eux maturité, remettez-leur leurs biens. » Le miroir me montre le processus de maturation. L'orphelin ne reçoit pas son héritage immédiatement — il est testé, formé, observé. « Ibtalu » — éprouvez — indique un processus actif d'éducation. Le miroir m'invite à voir la responsabilité comme un passage progressif, pas un événement unique.`,
  reflection: `La maturité ne s'acquiert pas d'un coup. Elle demande temps, épreuve et observation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ibtalu al-yatama » — et éprouvez les orphelins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'accompagne ceux qui grandissent sous ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve n'est pas méfiance — c'est préparation à l'autonomie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers grandit par étapes. La maturité est un processus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare bien le passage à l'autonomie accomplit un devoir sacré." }
  ],
  munajat: `Ya Muwaffiq, guide-moi dans l'éducation de ceux qui sont sous ma responsabilité. Fais que je les prépare à l'autonomie avec patience et sagesse.`
};

MIROIR["4:7"] = {
  reference: "4:7",
  theme: ["justice", "héritage", "droit"],
  emotion: "Équité mesurée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hakam"],
  mirrorVersion: `« Aux hommes revient une part de ce qu'ont laissé les pères et mères et les proches. Aux femmes revient une part de ce qu'ont laissé les pères et mères et les proches. » Le miroir me montre l'égalité de principe dans l'héritage. « Lil-rijali nasib » — aux hommes une part. « Wa lil-nisa'i nasib » — aux femmes une part. Les deux genres sont mentionnés explicitement. Le miroir me montre un Islam qui reconnaît les droits économiques des femmes dès le 7ème siècle.`,
  reflection: `L'héritage n'est pas un privilège masculin — c'est un droit pour tous. Les proportions varient selon les responsabilités, mais le droit est universel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lil-rijali nasib mimma taraka al-walidan wa al-aqrabun wa lil-nisa'i nasib » — aux hommes et aux femmes une part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je considère les droits économiques des femmes ? Avec justice ou avec préjugés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La différence de parts n'est pas inégalité — elle reflète les responsabilités différentes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice distributive est un principe divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les parts divines reçoit la bénédiction dans ce qu'il garde." }
  ],
  munajat: `Ya Adl, Tu as établi les parts avec sagesse. Fais que je respecte Tes prescriptions sans les déformer par mes préjugés.`
};

MIROIR["4:8"] = {
  reference: "4:8",
  theme: ["générosité", "héritage", "compassion"],
  emotion: "Partage fraternel",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Ar-Rahman"],
  mirrorVersion: `« Et quand sont présents lors du partage les proches parents, les orphelins et les pauvres, donnez-leur quelque chose de l'héritage. » Le miroir me montre que l'héritage n'est pas une affaire purement privée. « Wa ida hadara al-qismata » — quand sont présents au partage — les témoins vulnérables doivent recevoir. Le miroir m'invite à voir mes ressources non comme mon propriété exclusive, mais comme un bien à partager.`,
  reflection: `La présence des vulnérables au partage m'appelle à la générosité spontanée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-arzuquhum minhu » — donnez-leur quelque chose de l'héritage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je reçois, comment je partage avec ceux qui n'ont rien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner aux témoins du partage n'est pas perdre — c'est purifier ce que je garde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout partage attire la grâce sur le reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La générosité lors de l'héritage bénit toute la famille." }
  ],
  munajat: `Ya Karim, quand je reçois, aide-moi à me souvenir de ceux qui n'ont rien. Fais que ma joie ne soit pas complète sans partage.`
};

MIROIR["4:9"] = {
  reference: "4:9",
  theme: ["responsabilité", "empathie", "justice"],
  emotion: "Sollicitude anticipée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Hafiz"],
  mirrorVersion: `« Et que ceux qui laisseraient après eux des descendants faibles craignent pour eux. Qu'ils craignent Allah et parlent de façon juste. » Le miroir me montre l'empathie comme guide de l'action. « Khalafu » — laisser derrière soi — évoque l'orphelin que je pourrais laisser. Comment je traiterais l'orphelin si c'était le mien ? Cette question transforme ma conduite. Le miroir m'invite à agir envers les autres comme je voudrais qu'on agisse envers les miens.`,
  reflection: `L'empathie est le meilleur guide de la justice. Traiter l'autre comme je voudrais être traité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-yakhsha alladhina law taraku khilafan di'afan » — que ceux qui laisseraient des descendants faibles craignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je laissais des enfants vulnérables, comment je voudrais qu'on les traite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ma conduite envers les vulnérables sera la mesure de ce que je reçois." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce que je fais revient à moi — c'est la loi du miroir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège les orphelins protège ses propres descendants." }
  ],
  munajat: `Ya Wali, Tu protèges les orphelins. Fais que je sois Ton instrument de protection. Ne me laisse pas oublier que je pourrais être à leur place.`
};

MIROIR["4:10"] = {
  reference: "4:10",
  theme: ["avertissement", "justice", "protection"],
  emotion: "Mise en garde solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui mangent injustement les biens des orphelins mangent du feu dans leurs ventres. » Le miroir me montre un avertissement sévère. « Yanuluna fi butunihim naran » — ils introduisent du feu dans leurs ventres. L'image est frappante : la richesse mal acquise devient feu intérieur. Le miroir m'invite à la pureté dans mes gains. Rien de ce qui est pris injustement ne peut être béni.`,
  reflection: `L'injustice envers les vulnérables se transforme en poison pour l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yakulu al-nar fi butunihim » — ils mangent du feu dans leurs ventres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il quelque chose dans mes gains qui ne serait pas pur ? Le miroir m'invite à l'examen." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu de l'enfer commence ici-bas pour celui qui pratique l'injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'injustice ne reste jamais sans conséquence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté des gains purifie le cœur." }
  ],
  munajat: `Ya Jabbar, Tu avertis contre l'injustice envers les vulnérables. Purifie mes gains. Ne me laisse pas profiter de ce qui ne m'appartient pas.`
};

MIROIR["4:11"] = {
  reference: "4:11",
  theme: ["héritage", "loi", "justice"],
  emotion: "Soumission à la sagesse",
  difficulty: "avancé",
  relatedNames: ["Al-Hakam", "Al-Hakim"],
  mirrorVersion: `« Allah vous ordonne au sujet de vos enfants : au garçon une part équivalente à celle de deux filles. » Le miroir me place devant une loi souvent mal comprise. La différence de parts n'est pas une préférence masculine — elle reflète les responsabilités économiques différentes. Le garçon doit subvenir aux besoins de la famille ; la fille garde sa part pour elle. Le miroir m'invite à comprendre la sagesse derrière la lettre.`,
  reflection: `Les parts d'héritage reflètent l'équilibre entre droits et responsabilités. La femme reçoit moins mais n'a pas l'obligation de subvenir aux besoins.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusikum Allah fi awladikum lil-dhakari mithlu haz al-onthayayn » — au garçon une part équivalente à celle de deux filles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la sagesse des lois divines ou est-ce que je les juge avec mes critères humains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plus grande part va avec la plus grande responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équilibre entre droits et devoirs est la loi de la justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les lois divines avec confiance reçoit la paix." }
  ],
  munajat: `Ya Hakam, Tu as établi les lois avec sagesse. Fais que je les accepte avec confiance et compréhension.`
};

MIROIR["4:12"] = {
  reference: "4:12",
  theme: ["héritage", "loi", "équité"],
  emotion: "Acceptation confiante",
  difficulty: "avancé",
  relatedNames: ["Al-Adl", "Al-Khabir"],
  mirrorVersion: `« À vous la moitié de ce que laissent vos épouses, si elles n'ont pas d'enfants. Et à elles le quart de ce que vous laissez, si vous n'avez pas d'enfants. » Le miroir me montre la précision de la loi divine. Chaque situation est couverte, chaque droit est défini. La complexité apparente cache une sagesse profonde : protéger chaque membre de la famille. Le miroir m'invite à accepter la loi plutôt qu'à la contester.`,
  reflection: `La loi de l'héritage protège chacun selon sa situation. La précision divine couvre tous les cas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Walakum nisf ma taraka azwajukum » — à vous la moitié de ce que laissent vos épouses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la sagesse divine dans les questions de droit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loi divine n'oublie personne — elle protège chacun." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La précision de la loi reflète la précision de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation de la loi divine apporte la paix du cœur." }
  ],
  munajat: `Ya Alim, Tu connais toutes les situations. Fais que je fasse confiance à Ta sagesse dans les lois que Tu as établies.`
};

MIROIR["4:13"] = {
  reference: "4:13",
  theme: ["obéissance", "récompense", "paradis"],
  emotion: "Espérance motivée",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'ud"],
  mirrorVersion: `« Voilà les limites d'Allah. Et quiconque obéit à Allah et à Son messager, Il le fera entrer dans des Jardins sous lesquels coulent les rivières. » Le miroir me montre la promesse qui suit la loi. « Hudud Allah » — les limites d'Allah — ne sont pas des contraintes arbitraires, mais des frontières protectrices. Celui qui les respecte entre dans la paix. « Jannatin tajri min tahtiha al-anhar » — des jardins sous lesquels coulent les rivières. L'image évoque la fraîcheur, l'abondance, la satisfaction.`,
  reflection: `Les limites divines ne sont pas des prisons — elles sont les murs du jardin qui protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka hudud Allah » — voilà les limites d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis les limites divines ? Comme contraintes ou comme protections ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les limites sont les murs du paradis — elles délimitent l'espace de la grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers a ses limites — elles assurent l'harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites entre dans la paix illimitée." }
  ],
  munajat: `Ya Allah, Tes limites sont une grâce. Aide-moi à les respecter avec amour, pas avec contrainte. Fais que j'entre dans Tes jardins.`
};

MIROIR["4:14"] = {
  reference: "4:14",
  theme: ["désobéissance", "châtiment", "avertissement"],
  emotion: "Crainte salutaire",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Khawf"],
  mirrorVersion: `« Et quiconque désobéit à Allah et à Son messager, et transgresse Ses limites, Il le fera entrer dans le Feu pour y demeurer éternellement. » Le miroir me montre le pendant de la promesse. La transgression des limites a des conséquences. « Yahurru » — transgresser — c'est franchir délibérément. Le miroir m'invite à prendre au sérieux les avertissements divins. La miséricorde est immense, mais elle n'efface pas la responsabilité.`,
  reflection: `L'avertissement n'est pas une menace vide — il est une miséricorde qui prévient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man ya'si Allah wa rasulahu wa yata'adda hududahu » — quiconque désobéit et transgresse Ses limites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux les avertissements divins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde — il me donne la chance de changer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute transgression des lois naturelles a des conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte salutaire préserve de la chute." }
  ],
  munajat: `Ya Jabbar, Tes avertissements sont une miséricorde. Fais que je les prenne au sérieux et que je ne transgresse pas Tes limites.`
};

MIROIR["4:15"] = {
  reference: "4:15",
  theme: ["chasteté", "justice", "témoignage"],
  emotion: "Prudence juridique",
  difficulty: "avancé",
  relatedNames: ["Al-Adl", "Ash-Shahid"],
  mirrorVersion: `« Celles de vos femmes qui commettent une abomination, appelez contre elles quatre témoins parmi vous. » Le miroir me montre la rigueur de la preuve dans les accusations graves. « Arba'at shuhada' » — quatre témoins — la barre est haute. L'accusation d'adultère ne peut pas être légère. Le miroir m'invite à la prudence dans les jugements. Une accusation sans preuve solide est elle-même une faute.`,
  reflection: `L'accusation d'honneur demande des preuves irréfutables. La présomption d'innocence est protégée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-stashidu 'alayhinna arba'atam minkum » — appelez quatre témoins parmi vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je juge les autres ? Avec prudence ou avec légèreté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La difficulté de la preuve protège l'honneur de chacun." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice demande rigueur — l'injustice commence par la légèreté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège l'honneur des autres voit le sien protégé." }
  ],
  munajat: `Ya Adl, Tu exige la preuve pour juger. Fais que je ne juge jamais sans certitude. Protège mon honneur comme je protège celui des autres.`
};

MIROIR["4:16"] = {
  reference: "4:16",
  theme: ["repentir", "correction", "miséricorde"],
  emotion: "Espérance correctrice",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Et les deux d'entre vous qui l'ont commise, châtiez-les. S'ils se repentent et se corrigent, laissez-les. » Le miroir me montre la correction suivie du pardon. « Fa-in taba wa aslaha » — s'ils se repentent et se corrigent — le repentir n'est pas seulement des mots, mais un changement réel. Le miroir m'invite à voir la correction comme un chemin vers la restauration, pas comme une punition finale.`,
  reflection: `La correction vise la restauration, pas la destruction. Le repentir sincère ouvre la porte du pardon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in taba wa aslaha fa-a'ridu 'anhuma » — s'ils se repentent et se corrigent, laissez-les." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je corrige ceux qui faillent ? Avec espoir de restauration ou avec condamnation définitive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La correction sans espoir de pardon est cruauté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers peut être restauré avec les bonnes conditions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la correction et se repent retrouve sa place." }
  ],
  munajat: `Ya Tawwab, Tu accueilles le repentir. Fais que je corrige avec sagesse et que j'accepte la correction quand je faillis.`
};

MIROIR["4:17"] = {
  reference: "4:17",
  theme: ["repentir", "sincérité", "temps"],
  emotion: "Urgence spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawwab", "Al-Ghaffar"],
  mirrorVersion: `« Allah accueille le repentir de ceux qui font le mal par ignorance puis se repentent aussitôt. » Le miroir me montre le repentir authentique. « Min qarib » — bientôt, aussitôt — le délai compte. Le repentir différé devient douteux. Le miroir m'invite à la rapidité dans le retour vers Allah. Pourquoi attendre ? Chaque jour de retard est un jour de distance.`,
  reflection: `Le vrai repentir est immédiat. Reporter le retour est un signe de non-sincérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatubuna min qarib » — ils se repentent bientôt." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je réalise ma faute, combien de temps j'attends avant de me repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai du repentir est souvent le signe de l'attachement au péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps de la grâce est maintenant — demain n'est pas garanti." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent vite montre la sincérité de son cœur." }
  ],
  munajat: `Ya Tawwab, Tu accueilles le repentir sincère. Fais que je ne tarde pas à revenir vers Toi. Ne me laisse pas m'enfoncer dans le péché par le délai.`
};

MIROIR["4:18"] = {
  reference: "4:18",
  theme: ["repentir", "hypocrisie", "mort"],
  emotion: "Lucidité spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Khaliq"],
  mirrorVersion: `« Mais il n'y a pas de repentir pour ceux qui font le mal jusqu'à ce que la mort se présente à l'un d'eux. » Le miroir me montre le repentir de la dernière heure. Tarder jusqu'à l'article de la mort n'est pas un vrai repentir — c'est un regret paniqué. Le miroir m'invite à ne pas jouer avec le temps. La mort vient sans prévenir. Le repentir sincère ne peut pas être différé.`,
  reflection: `Le repentir de la dernière heure n'est pas accepté — pas par cruauté, mais parce qu'il n'est pas sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta yahuda ahadahumu al-mawt » — jusqu'à ce que la mort se présente à l'un d'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je repousse le repentir à plus tard ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir différé n'est souvent qu'une excuse pour continuer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort ne prévient pas — le moment du retour est maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent maintenant n'a pas à craindre la mort soudaine." }
  ],
  munajat: `Ya Allah, ne me laisse pas attendre la dernière heure. Fais que je me repente maintenant, sincèrement, sans délai.`
};

MIROIR["4:19"] = {
  reference: "4:19",
  theme: ["femme", "respect", "mariage"],
  emotion: "Protection bienveillante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Wadud"],
  mirrorVersion: `« Ô vous qui avez cru ! Il ne vous est pas permis d'hériter des femmes contre leur gré. » Le miroir me montre la protection de la femme dans le mariage. « Jabran » — contre leur gré — la femme n'est pas un objet qu'on hérite, qu'on impose. Son consentement compte. Le miroir m'invite à respecter la volonté de la femme dans toutes les questions qui la concernent.`,
  reflection: `La femme n'est pas une propriété qu'on hérite. Elle est une partenaire avec des droits et une volonté propre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yahillu lakum an tarithu al-nisa' karhan » — il ne vous est pas permis d'hériter des femmes contre leur gré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite les femmes dans ma vie ? Avec respect ou comme des objets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect de la femme est le respect de la création divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La femme est le miroir de l'homme — la respecter, c'est se respecter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la femme reçoit la bénédiction dans sa propre vie." }
  ],
  munajat: `Ya Wadud, Tu as créé la femme avec dignité. Fais que je la traite avec le respect qui Lui est dû. Ne me laisse pas la considérer comme un objet.`
};

MIROIR["4:20"] = {
  reference: "4:20",
  theme: ["mariage", "justice", "divorce"],
  emotion: "Responsabilité conjugale",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hakim"],
  mirrorVersion: `« Si vous voulez remplacer une épouse par une autre, et que vous avez donné à l'une un qintar, ne reprenez rien. » Le miroir me montre la protection du don conjugal. « Qintaran » — une grande somme — même un don considérable ne peut être repris. Le miroir m'invite à voir le mariage non comme une transaction réversible, mais comme un engagement où chaque don est définitif.`,
  reflection: `Ce qui est donné dans le mariage est donné définitivement. Reprendre ce qu'on a donné est une bassesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la ta'khudhu minhuma shay'an » — ne reprenez rien d'elle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je considère les dons que j'ai faits ? Comme définitifs ou récupérables ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Reprendre un don donné est détruire l'honneur du donateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le don parfait ne se reprend pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sans reprendre reçoit la générosité divine." }
  ],
  munajat: `Ya Karim, Tu donnes sans reprendre. Fais que je sois généreux comme Toi. Ne me laisse pas reprendre ce que j'ai donné.`
};

MIROIR["4:21"] = {
  reference: "4:21",
  theme: ["mariage", "intimité", "dignité"],
  emotion: "Respect sacré",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sattar", "Al-Hafiz"],
  mirrorVersion: `« Comment pourriez-vous le reprendre, alors que vous êtes allés l'un vers l'autre et qu'elles ont obtenu de vous un engagement solennel ? » Le miroir me montre l'intimité comme un lien sacré. « Afanah » — vous êtes allés l'un vers l'autre — l'intimité crée un lien indéfectible. « Mithaqan ghalizan » — un engagement solennel — le mariage n'est pas une relation légère. Le miroir m'invite à respecter la profondeur du lien conjugal.`,
  reflection: `L'intimité conjugale crée un lien sacré. Le mariage n'est pas une relation ordinaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akhadhna minkum mithaqan ghalizan » — et elles ont obtenu de vous un engagement solennel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je considère le mariage ? Comme un engagement léger ou comme un pacte sacré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La profondeur de l'engagement demande la profondeur du respect." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mariage est le fondement de la famille et de la société." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le pacte conjugal reçoit la bénédiction dans son foyer." }
  ],
  munajat: `Ya Sattar, Tu couvres les intimités. Fais que je respecte le lien sacré du mariage. Ne me laisse pas le prendre à la légère.`
};

MIROIR["4:22"] = {
  reference: "4:22",
  theme: ["mariage", "tabou", "pureté"],
  emotion: "Respect des limites",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haram", "Al-Taharah"],
  mirrorVersion: `« N'épousez pas les femmes que vos pères ont épousées, excepté le passé. » Le miroir me montre les limites de l'alliance. « Ma nakaha aba'ukum » — ce que vos pères ont épousé — certaines femmes sont interdites par le lien de parenté. Le miroir m'invite à respecter les structures familiales. Les limites ne sont pas arbitraires — elles protègent l'harmonie familiale.`,
  reflection: `Les interdits du mariage protègent la structure familiale. Respecter les limites, c'est respecter l'ordre divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tankihu ma nakaha aba'ukum » — n'épousez pas les femmes que vos pères ont épousées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les limites divines dans les relations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les interdits protègent ce qui doit être protégé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre de la création demande le respect des limites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites familiales reçoit la bénédiction dans sa famille." }
  ],
  munajat: `Ya Tahir, Tu as établi les limites de la pureté. Fais que je les respecte. Protège ma famille de la confusion.`
};

MIROIR["4:23"] = {
  reference: "4:23",
  theme: ["mariage", "interdits", "parenté"],
  emotion: "Respect de l'ordre",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-Haram"],
  mirrorVersion: `« Vous sont interdites vos mères, vos filles, vos sœurs, vos tantes, les filles de vos frères et sœurs... » Le miroir me montre l'étendue des interdits du mariage. La liste est précise et complète. Ces interdits ne sont pas arbitraires — ils protègent la structure familiale et évitent la confusion des liens. Le miroir m'invite à comprendre que les limites sont des protections.`,
  reflection: `Les interdits du mariage définissent les frontières de la famille. Ils protègent l'harmonie et évitent la confusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hurrimat 'alaykum ummahatukum wa banatukum wa akhawatukum » — vous sont interdites vos mères, vos filles, vos sœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je comprends les interdits divins ? Comme restrictions ou comme protections ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdit protège ce qui est le plus précieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute structure a besoin de frontières pour exister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les frontières de la famille construit sur une base solide." }
  ],
  munajat: `Ya Hakim, Tu as défini les limites de la famille. Fais que je les respecte. Protège ma famille de la confusion des liens.`
};

MIROIR["4:24"] = {
  reference: "4:24",
  theme: ["mariage", "permission", "dignité"],
  emotion: "Ouverture encadrée",
  difficulty: "avancé",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Et les femmes mariées, sauf celles que vous possédez. » Le miroir me montre une permission dans un contexte historique précis. Ce verset a été révélé dans un contexte de guerre et de captivité. Le miroir m'invite à comprendre le texte dans son contexte, pas à le lire littéralement hors du temps. La dignité de la femme reste la valeur fondamentale.`,
  reflection: `Les versets doivent être compris dans leur contexte historique. Les principes éternels sont la justice et la dignité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-muhshanatu mina al-nisa' illa ma malakat aymanukum » — et les femmes mariées, sauf celles que vous possédez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je lis les versets historiques ? Avec compréhension du contexte ou avec lecture littérale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dignité humaine est le principe qui guide l'interprétation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation s'adresse à des contextes précis — les principes sont éternels." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sagesse de l'interprétation demande connaissance et nuance." }
  ],
  munajat: `Ya Hakim, Tu as révélé le Coran dans des contextes précis. Fais que je le lise avec sagesse et compréhension. Guide mon interprétation.`
};

MIROIR["4:25"] = {
  reference: "4:25",
  theme: ["mariage", "justice", "chasteté"],
  emotion: "Protection de la dignité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Muhaymin"],
  mirrorVersion: `« Et quiconque parmi vous n'a pas les moyens d'épouser des femmes libres croyantes, qu'il épouse des femmes croyantes parmi celles que vous possédez. » Le miroir me montre l'option pour ceux qui n'ont pas les moyens. Le mariage avec les captives est présenté comme une alternative au célibat forcé, avec des conditions strictes de justice. Le miroir m'invite à voir la révélation comme un chemin progressif vers plus de justice.`,
  reflection: `La révélation guide progressivement vers plus de justice. Les options sont encadrées par des conditions strictes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man ma minkum wusa'an an yankiha al-muhsanati » — quiconque parmi vous n'a pas les moyens d'épouser des femmes libres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je comprends la progression de la révélation vers plus de justice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission encadrée n'est pas une approbation — c'est une concession avec conditions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin de la justice est progressif — chaque étape compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la progression divine suit le chemin de la sagesse." }
  ],
  munajat: `Ya Muhaymin, Tu guides vers la justice. Fais que je comprenne Tes versets dans leur contexte et leur progression.`
};

MIROIR["4:26"] = {
  reference: "4:26",
  theme: ["guidance", "sagesse", "connaissance"],
  emotion: "Confiance dans le Guide",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Alim"],
  mirrorVersion: `« Allah veut vous éclairer et vous guider sur les chemins de ceux qui vous ont précédés. » Le miroir me montre l'intention divine derrière les lois. « Yuridu Allah » — Allah veut — c'est Sa volonté bienveillante. Les lois ne sont pas des contraintes arbitraires — elles sont des guides sur le chemin tracé par ceux qui ont réussi avant nous. Le miroir m'invite à faire confiance à la guidance divine.`,
  reflection: `Les lois divines sont des guides, pas des fardeaux. Elles suivent le chemin de ceux qui ont réussi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuridu Allah li-yubayyina lakum » — Allah veut vous éclairer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je reçois les lois divines ? Comme guides ou comme contraintes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contrainte apparente est en réalité une libération." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin de la réussite est déjà tracé par ceux qui nous ont précédés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le chemin divin marche dans les pas des victorieux." }
  ],
  munajat: `Ya Hadi, Tu veux m'éclairer. Fais que je fasse confiance à Ta guidance. Ne me laisse pas errer hors du chemin tracé.`
};

MIROIR["4:27"] = {
  reference: "4:27",
  theme: ["désir", "guidance", "combat"],
  emotion: "Vigilance spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rashid", "An-Nur"],
  mirrorVersion: `« Mais Allah veut vous purifier, tandis que ceux qui suivent leurs passions voudraient vous voir dévier grandement. » Le miroir me montre le contraste entre la volonté divine et les passions. « Shuhhat anfusikum » — les passions de vos âmes — l'ennemi intérieur. Le miroir m'invite à reconnaître que le combat spirituel se joue entre ce qu'Allah veut pour moi et ce que mes passions veulent.`,
  reflection: `Le combat spirituel est entre la volonté divine et les passions intérieures. Choisir Allah, c'est refuser les passions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allah yuridu an yatubba 'alaykum » — mais Allah veut vous purifier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mes passions veulent pour moi ? Qu'est-ce qu'Allah veut ? Lequel je choisis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les passions promettent le plaisir mais mènent à la perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est traversée par l'instinct et le choix spirituel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise ses passions maîtrise son destin." }
  ],
  munajat: `Ya Rashid, Tu veux me purifier. Aide-moi à lutter contre mes passions. Ne me laisse pas suivre les chemins de la déviation.`
};

MIROIR["4:28"] = {
  reference: "4:28",
  theme: ["faiblesse", "miséricorde", "soulagement"],
  emotion: "Réconfort divin",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Rauf"],
  mirrorVersion: `« Allah veut alléger vos charges, car l'homme a été créé faible. » Le miroir me montre la reconnaissance divine de ma faiblesse. « Du'ifan » — faible — ce n'est pas un reproche, c'est un constat bienveillant. Allah connaît ma nature et Il ne me demande pas au-delà de mes forces. Le miroir m'invite à accepter ma faiblesse et à recevoir Sa miséricorde.`,
  reflection: `La reconnaissance de la faiblesse humaine conduit à la miséricorde divine. Allah ne demande pas l'impossible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa khuliqa al-insanu da'ifan » — et l'homme a été créé faible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma faiblesse ou est-ce que je la nie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ma faiblesse n'est pas une honte — c'est l'espace où la grâce opère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est faible devant son Créateur — c'est la condition de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa faiblesse reçoit la force divine." }
  ],
  munajat: `Ya Rahman, Tu connais ma faiblesse. Ne me demande pas au-delà de mes forces. Donne-moi Ta miséricorde pour compenser ce qui me manque.`
};

MIROIR["4:29"] = {
  reference: "4:29",
  theme: ["justice", "commerce", "consentement"],
  emotion: "Équité économique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Haqq"],
  mirrorVersion: `« Ô vous qui avez cru ! Que les uns ne mangent pas les biens des autres injustement. Mais qu'il y ait du commerce entre vous, par consentement mutuel. » Le miroir me montre les règles de l'échange économique. « Bi al-batil » — injustement — le gain sans droit est interdit. « Tijarah » — commerce — l'échange libre est permis. Le miroir m'invite à la pureté dans mes transactions. Chaque dirham gagné injustement est un fardeau.`,
  reflection: `Le gain injuste pollue l'âme. Le commerce équitable, avec consentement, est béni.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ta'kulwa amwalakum baynakum bi al-batil » — ne mangez pas les biens des uns et des autres injustement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gagne mon argent ? Avec justice ou avec injustice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gain injuste se transforme en perte spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'économie juste reflète l'ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté des gains purifie la vie entière." }
  ],
  munajat: `Ya Haqq, Tu aimes la justice. Purifie mes revenus. Ne me laisse pas gagner ce qui n'est pas juste.`
};

MIROIR["4:30"] = {
  reference: "4:30",
  theme: ["avertissement", "injustice", "châtiment"],
  emotion: "Crainte salutaire",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Khawf"],
  mirrorVersion: `« Quiconque fait cela par agression et injustice, Nous le brûlerons dans un Feu. » Le miroir me montre l'avertissement contre l'injustice économique. « Yadha'u » — Nous le brûlerons — l'image est forte. L'injustice envers les autres, même matérielle, a des conséquences spirituelles. Le miroir m'invite à prendre au sérieux mes transactions quotidiennes.`,
  reflection: `L'injustice économique n'est pas un petit péché — elle mène au feu. La justice dans les affaires est une obligation spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man fa'ala dhalika 'udwanan wa zulman fa-sawfa nuslihi naran » — Nous le brûlerons dans un Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux mes transactions ? Chaque dirham compte." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu de l'enfer commence ici-bas pour celui qui pratique l'injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'injustice ne reste jamais sans conséquence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La justice dans les affaires est un acte d'adoration." }
  ],
  munajat: `Ya Jabbar, Tu avertis contre l'injustice. Fais que je sois juste dans toutes mes transactions. Ne me laisse pas être de ceux qui brûlent.`
};

MIROIR["4:31"] = {
  reference: "4:31",
  theme: ["éviter", "péchés", "purification"],
  emotion: "Espérance purifiée",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "At-Tahur"],
  mirrorVersion: `« Si vous évitez les grands péchés qui vous sont interdits, Nous effacerons vos méfaits et Nous vous ferons entrer par une porte noble. » Le miroir me montre la promesse de la purification. « Tujtanibuna » — si vous évitez — le chemin est clair. Les grands péchés sont à éviter, et le reste sera pardonné. « Madkhalan kariman » — une entrée noble — la récompense est certaine. Le miroir m'invite à me concentrer sur l'essentiel.`,
  reflection: `Éviter les grands péchés suffit pour obtenir le pardon des petits. Le chemin de la purification est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tujtanibu kaba'ira ma tunhawna 'anhu nukaffir 'ankum sayyi'atikum » — Nous effacerons vos méfaits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont les grands péchés que je dois éviter ? Les connais-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement des grands péchés ouvre la porte du pardon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La purification n'est pas compliquée — elle demande la volonté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les grands péchés reçoit la purification complète." }
  ],
  munajat: `Ya Ghaffur, Tu promets le pardon si j'évite les grands péchés. Fais que je les connaisse et que je les évite. Purifie-moi et fais-moi entrer par la porte noble.`
};

MIROIR["4:32"] = {
  reference: "4:32",
  theme: ["envie", "don", "distribution"],
  emotion: "Acceptation gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Qasim"],
  mirrorVersion: `« Ne convoitez pas ce qu'Allah a accordé à certains d'entre vous plus qu'à d'autres. » Le miroir me montre le poison de l'envie. « Tatamanna » — ne convoitez pas — l'envie ne change rien à ma situation, elle ne fait que m'empoisonner. « Fadala » — ce qu'Allah a accordé — la distribution est divine. Le miroir m'invite à accepter ma part et à me réjouir de celle des autres.`,
  reflection: `L'envie est le refus d'accepter la distribution divine. Accepter ma part, c'est accepter la sagesse d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tatamannaw ma faddala Allah bihi ba'dakum 'ala ba'd » — ne convoitez pas ce qu'Allah a accordé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'envie chez les autres ? Pourquoi je n'accepte pas ma part ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'envie ne change rien à ma situation — elle ne fait que me nuire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature reçoit sa part — l'envie est refus de l'ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa part avec gratitude reçoit plus que ce qu'il convoitait." }
  ],
  munajat: `Ya Wahhab, Tu distribues avec sagesse. Fais que j'accepte ma part avec gratitude. Ne me laisse pas être dévoré par l'envie.`
};

MIROIR["4:33"] = {
  reference: "4:33",
  theme: ["héritage", "distribution", "parenté"],
  emotion: "Ordre accepté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Warith", "Al-Hakam"],
  mirrorVersion: `« À tout héritier Nous avons assigné des héritiers pour ce qu'ont laissé les parents et les proches. » Le miroir me montre l'organisation de la succession. « Mawali » — héritiers — chaque bien a son destinataire. L'ordre est établi par Allah. Le miroir m'invite à respecter la distribution divine, pas à la contester ou à la manipuler.`,
  reflection: `L'héritage est régi par des règles divines précises. Respecter l'ordre établi, c'est respecter la sagesse d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa likullin ja'alna mawali mimma taraka al-walidan wa al-aqrabun » — à tout héritier Nous avons assigné des héritiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je respecte les règles de l'héritage ? Avec soumission ou avec contestation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distribution divine est parfaite — la mienne est imparfaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose retourne à son destinataire légitime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la distribution divine reçoit la bénédiction dans ce qu'il garde." }
  ],
  munajat: `Ya Warith, Tu es l'Héritier de tout. Fais que je respecte Tes règles de distribution. Ne me laisse pas manipuler l'héritage à mon profit.`
};

MIROIR["4:34"] = {
  reference: "4:34",
  theme: ["mariage", "responsabilité", "conflit"],
  emotion: "Ordre interrogé",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-Adl"],
  mirrorVersion: `« Les hommes ont autorité sur les femmes, en raison des faveurs qu'Allah leur a accordées. » Le miroir me place devant un verset souvent mal compris. « Qawwamun » — responsables, protecteurs — l'autorité est liée à la responsabilité, pas à la supériorité. Le verset continue avec des limites strictes. Le miroir m'invite à comprendre le texte dans son ensemble, pas à isoler un passage pour justifier l'injustice.`,
  reflection: `L'autorité dans le mariage vient de la responsabilité, pas de la supériorité. Les limites sont strictes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-rijalu qawwamuna 'ala al-nisa' » — les hommes sont responsables des femmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je comprends ce verset ? Avec justice ou avec préjugés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité n'est pas la domination — elle est le service." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque rôle dans la création a sa responsabilité propre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la responsabilité comme service accomplit la volonté divine." }
  ],
  munajat: `Ya Hakim, Tu as établi des rôles dans le mariage. Fais que je les accomplisse avec justice. Ne me laisse pas transformer la responsabilité en domination.`
};

MIROIR["4:35"] = {
  reference: "4:35",
  theme: ["médiation", "conflit", "paix"],
  emotion: "Résolution pacifique",
  difficulty: "intermédiaire",
  relatedNames: ["As-Salam", "Al-Jami'"],
  mirrorVersion: `« Si vous craignez une rupture entre les deux, envoyez un arbitre de sa famille et un arbitre de la sienne. » Le miroir me montre la médiation comme solution aux conflits conjugaux. « Hakaman » — arbitre — la médiation est préférable à la rupture. Le miroir m'invite à chercher la réconciliation avant la séparation. Le mariage mérite qu'on se batte pour lui.`,
  reflection: `La médiation est la voie de la sagesse face aux conflits. Chercher la réconciliation avant la rupture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ib'athu hakaman min ahlihi wa hakaman min ahliha » — envoyez un arbitre de sa famille et un arbitre de la sienne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis en conflit, est-ce que je cherche la médiation ou la rupture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rupture précipitée détruit ce que la médiation pourrait sauver." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix vaut mieux que la guerre — dans le mariage comme ailleurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la réconciliation reçoit la bénédiction de la paix." }
  ],
  munajat: `Ya Salam, Tu es la Paix. Fais que je cherche la réconciliation dans les conflits. Ne me laisse pas précipiter la rupture.`
};

// ============================================
// SURAH 4 - AN-NISA - Verses 37-100
// ============================================

MIROIR["4:37"] = {
  reference: "4:37",
  theme: ["avarice", "hypocrisie", "guidance"],
  emotion: "Mise en garde spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Karim", "Al-Hadi"],
  mirrorVersion: `« Ceux qui sont avares et ordonnent aux hommes l'avarice, et dissimulent ce qu'Allah leur a donné de Sa grâce. » Le miroir me montre l'avarice comme maladie spirituelle. « Yabkhaluna » — ils sont avares — non seulement ils ne donnent pas, mais ils conseillent aux autres de ne pas donner. « Yukhfuna » — ils dissimulent — ils cachent leurs richesses. Le miroir m'invite à la générosité et à la transparence.`,
  reflection: `L'avarice est une maladie qui se propage. Le généreux devient un modèle de générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yabkhaluna wa ya'muruna al-nasa bi al-bukhl » — ceux qui sont avares et ordonnent aux hommes l'avarice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis généreux ou avare ? Mon exemple influence-t-il les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avarice ferme le cœur — la générosité l'ouvre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière donne sans compter — le soleil, la pluie, la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sans compter reçoit sans mesure." }
  ],
  munajat: `Ya Karim, Tu es le Généreux. Fais que je sois généreux comme Toi. Ne me laisse pas être de ceux qui thésaurisent et conseillent l'avarice.`
};

MIROIR["4:38"] = {
  reference: "4:38",
  theme: ["hypocrisie", "charité", "sincérité"],
  emotion: "Authenticité exigée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Khaliq"],
  mirrorVersion: `« Et ceux qui dépensent leurs biens pour être vus des gens, et ne croient en Allah ni au Jour dernier. » Le miroir me montre l'hypocrisie dans la charité. « Ri'a' » — ostentation — donner pour être vu annule l'acte. Le miroir m'invite à examiner mes intentions dans chaque acte de générosité.`,
  reflection: `La charité ostentatoire n'est pas de la charité — c'est du théâtre. La sincérité transforme le don en adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina yunfiquna amwalahum ri'a' al-nas » — ceux qui dépensent leurs biens pour être vus des gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pourquoi je donne ? Pour Allah ou pour être vu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don sincère est adoré par Allah — le don ostentatoire est rejeté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah voit l'intention, pas seulement l'acte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sincèrement reçoit la récompense divine." }
  ],
  munajat: `Ya Basir, Tu vois mes intentions. Purifie-les. Fais que je donne pour Toi seul, pas pour être vu.`
};

MIROIR["4:39"] = {
  reference: "4:39",
  theme: ["foi", "charité", "récompense"],
  emotion: "Rappel bienveillant",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Shakur"],
  mirrorVersion: `« Qu'auraient-ils à perdre s'ils croyaient en Allah et au Jour dernier, et dépensaient de ce qu'Allah leur a donné ? » Le miroir me montre le calcul simple. La foi et la charité ne coûtent rien et rapportent tout. « Ma kana » — qu'auraient-ils — la question est rhétorique. Il n'y a aucune perte. Le miroir m'invite à la logique spirituelle : croire et donner, c'est gagner.`,
  reflection: `La foi et la charité sont un investissement sans risque. Tout ce qu'on donne revient multiplié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana Allah li-yudi'ahum » — Allah ne gaspille pas leur récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de croire et de donner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte est dans le refus de croire et de donner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'investissement spirituel est le seul sans risque." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et donne reçoit au-delà de son espérance." }
  ],
  munajat: `Ya Ghani, Tu es le Riche. Fais que je comprenne que donner n'appauvrit pas. Apprends-moi la logique spirituelle.`
};

MIROIR["4:40"] = {
  reference: "4:40",
  theme: ["justice", "balance", "miséricorde"],
  emotion: "Confiance absolue",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Wadud"],
  mirrorVersion: `« Certes, Allah ne lèse personne, pas même d'un atome. » Le miroir me montre la justice parfaite d'Allah. « Mithqala dharrah » — le poids d'un atome — rien n'est trop petit pour la justice divine. Le miroir m'invite à faire confiance à Allah dans tous mes comptes. Rien n'est oublié, rien n'est exagéré.`,
  reflection: `La justice d'Allah est absolue, même pour les plus petites choses. Rien n'est perdu, rien n'est oublié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama Allah la yazlimu nasaban mithqala dharrah » — Allah ne lèse personne, pas même d'un atome." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la justice d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice divine compense toutes les injustices humaines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque atome est compté dans la balance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la justice divine est en paix." }
  ],
  munajat: `Ya Adl, Tu es parfaitement juste. Fais que je fasse confiance à Ta justice. Ne me laisse pas douter de Tes comptes.`
};

MIROIR["4:41"] = {
  reference: "4:41",
  theme: ["témoignage", "responsabilité", "jour dernier"],
  emotion: "Responsabilité anticipée",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-Hisab"],
  mirrorVersion: `« Comment sera-ce quand Nous ferons venir de chaque communauté un témoin, et que Nous te ferons venir comme témoin contre ceux-ci ? » Le miroir me place devant le témoignage du Jour dernier. « Shahidan » — témoin — le Prophète sera témoin contre sa communauté. Le miroir m'invite à vivre en sachant que chaque acte sera témoigné.`,
  reflection: `Le témoignage du Jour dernier nous rappelle que rien n'est caché. Vivre en sachant qu'on sera témoigné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kayfa idha ji'na min kulli ummatin bi-shahid » — comment sera-ce quand Nous ferons venir de chaque communauté un témoin ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon témoignage dirait de moi si c'était aujourd'hui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage n'est pas pour juger — il est pour rappeler." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création témoigne — les anges, les prophètes, les actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme témoigné n'a rien à cacher." }
  ],
  munajat: `Ya Shahid, Tu es le Témoin de tout. Fais que je vive en sachant que je suis observé. Ne me laisse pas oublier le témoignage à venir.`
};

MIROIR["4:42"] = {
  reference: "4:42",
  theme: ["refuge", "mécréance", "regret"],
  emotion: "Terreur des perdants",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Qahhar"],
  mirrorVersion: `« Ce jour-là, ceux qui ont mécru et désobéi au messager souhaiteront que la terre soit nivelée sur eux. » Le miroir me montre le regret des perdants. « Yawaddu » — ils souhaiteront — le regret vient trop tard. « Tusawwa » — nivelée — l'anéantissement est préféré au face-à-face avec Allah. Le miroir m'invite à ne pas attendre le regret pour changer.`,
  reflection: `Le regret du Jour dernier est inutile. Le temps de changer est maintenant, pas après.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawaddu alladhina kafaru wa 'asaw al-rasula law tusa bina bihim al-ard » — ils souhaiteront que la terre soit nivelée sur eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends le regret pour changer ? Pourquoi pas maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret tardif est le pire des châtiments." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps de la grâce a une fin — le regret commence après." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui change maintenant évite le regret éternel." }
  ],
  munajat: `Ya Qahhar, Tu es le Contraignant. Fais que je change maintenant, avant qu'il ne soit trop tard. Ne me laisse pas attendre le jour du regret inutile.`
};

MIROIR["4:43"] = {
  reference: "4:43",
  theme: ["prière", "pureté", "ivresse"],
  emotion: "Préparation sacrée",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tahur", "Al-Mu'min"],
  mirrorVersion: `« Ô vous qui avez cru ! N'approchez pas de la prière alors que vous êtes ivres, jusqu'à ce que vous sachiez ce que vous dites. » Le miroir me montre l'état requis pour la prière. « Sukara » — ivres — l'ivresse voile la conscience. « Ta'lamuna ma taqulun » — jusqu'à ce que vous sachiez ce que vous dites — la prière demande présence. Le miroir m'invite à me présenter devant Allah avec un cœur éveillé.`,
  reflection: `La prière demande un cœur présent. L'ivresse — qu'elle soit de vin ou de distractions — voile la conscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La taqrabu al-salata wa antum sukara » — n'approchez pas de la prière alors que vous êtes ivres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me présente à la prière ? Avec présence ou avec distraction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière sans présence est un corps sans âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté extérieure reflète la pureté intérieure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec présence rencontre Allah." }
  ],
  munajat: `Ya Tahur, Tu es le Purificateur. Purifie mon cœur avant la prière. Fais que je me présente devant Toi avec un esprit éveillé.`
};

MIROIR["4:44"] = {
  reference: "4:44",
  theme: ["hypocrisie", "égarement", "mise en garde"],
  emotion: "Avertissement lucide",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« N'as-tu pas vu ceux qui ont reçu une partie du Livre et qui achètent l'égarement ? » Le miroir me montre le danger de la connaissance sans mise en pratique. « Yashtaruna al-dalalata » — ils achètent l'égarement — ils ont la guidance mais la troquent. Le miroir m'invite à ne pas être de ceux qui savent mais ne pratiquent pas.`,
  reflection: `La connaissance sans pratique est un danger. Savoir sans faire est un égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara ila alladhina utu nasiban mina al-kitabi yashtaruna al-dalalata » — ceux qui ont reçu une partie du Livre et achètent l'égarement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pratique ce que je sais ? Ou est-ce que ma connaissance reste théorique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance sans pratique est plus dangereuse que l'ignorance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Cel qui sait mais ne fait pas est responsable de son savoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pratique de ce qu'on sait est la vraie sagesse." }
  ],
  munajat: `Ya Hadi, Tu guides vers la vérité. Fais que je pratique ce que je sais. Ne me laisse pas être de ceux qui achètent l'égarement avec leur connaissance.`
};

MIROIR["4:45"] = {
  reference: "4:45",
  theme: ["protection", "ennemi", "confiance"],
  emotion: "Sécurité divine",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Nasir"],
  mirrorVersion: `« Et Allah connaît mieux vos ennemis. Allah suffit comme Protecteur, et Allah suffit comme Secoureur. » Le miroir me montre la protection divine face aux ennemis. « A'lam bi-a'da'ikum » — Il connaît mieux vos ennemis — certains ennemis sont cachés, Allah les connaît tous. « Kafa bi-Allahi waliyan » — Allah suffit comme Protecteur. Le miroir m'invite à me reposer sur Allah, pas sur mes propres calculs.`,
  reflection: `Allah connaît tous les ennemis — visibles et invisibles. Sa protection suffit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allah a'lam bi-a'da'ikum » — et Allah connaît mieux vos ennemis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repose sur Allah pour ma protection ou sur mes propres stratégies ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ma protection est limitée — la Sienne est absolue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est protégée par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repose sur Allah est invulnérable." }
  ],
  munajat: `Ya Wali, Tu es mon Protecteur. Je me repose sur Toi contre tous les ennemis. Suffis-moi, secours-moi, protège-moi.`
};

// ============================================
// SURAH 4 - AN-NISA - Verses 46-100
// ============================================

MIROIR["4:46"] = {
  reference: "4:46",
  theme: ["falsification", "parole", "mise en garde"],
  emotion: "Avertissement solennel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Kalam"],
  mirrorVersion: `« Parmi ceux qui professent le judaïsme, il en est qui déforment les mots. » Le miroir me montre le danger de falsifier la parole divine. « Yuharrifuna al-kalima » — ils déforment les mots — le sens est altéré pour tromper. Le miroir m'invite à préserver le sens du message, pas à le tordre pour mes intérêts.`,
  reflection: `La falsification de la parole divine est un crime contre la vérité. Préserver le sens, c'est honorer le message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuharrifuna al-kalima 'an mawadi'ihi » — ils déforment les mots de leurs places." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve le sens des textes sacrés ou est-ce que je les interprète à ma convenance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La falsification est une forme de rejet de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole divine est un dépôt — la falsification est une trahison." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la parole préserve sa propre âme." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je préserve Ta parole sans la falsifier. Ne me laisse pas tordre le sens pour mon profit.`
};

MIROIR["4:47"] = {
  reference: "4:47",
  theme: ["foi", "révélation", "avertissement"],
  emotion: "Urgence spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Bashir"],
  mirrorVersion: `« Ô vous à qui on a donné le Livre ! Croyez à ce que Nous avons fait descendre. » Le miroir me montre l'appel à reconnaître la nouvelle révélation. « Musaddiqan » — confirmant — le Coran confirme ce qui est venu avant. Le miroir m'invite à la continuité dans la foi, pas à l'obstination dans le refus.`,
  reflection: `La foi est un chemin de reconnaissance continue. Chaque révélation appelle à être accueillie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aminu bima anzalna musaddiqan lima ma'akum » — croyez à ce que Nous avons fait descendre, confirmant ce qui est avec vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la continuité de la révélation ? Ou est-ce que je refuse par obstination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus de la nouvelle révélation est le rejet de l'ancienne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une — elle se dévoile progressivement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la continuité de la révélation reconnaît l'unité de Dieu." }
  ],
  munajat: `Ya Nur, Tu es la Lumière. Fais que je reconnaisse Ta lumière où qu'elle se trouve. Ne me laisse pas refuser par obstination.`
};

MIROIR["4:48"] = {
  reference: "4:48",
  theme: ["pardon", "polythéisme", "miséricorde"],
  emotion: "Espérance avec limite",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffur", "Al-Wahid"],
  mirrorVersion: `« Certes, Allah ne pardonne pas qu'on Lui donne des associés, mais Il pardonne ce qui est moins grave à qui Il veut. » Le miroir me montre la limite du pardon. « Yushrika bihi » — associer à Allah — le polythéisme est impardonnable s'il meurt dans cet état. Mais tout autre péché peut être pardonné. Le miroir m'invite à préserver l'unicité de ma foi.`,
  reflection: `Le polythéisme est le seul péché impardonnable parce qu'il coupe la relation avec Dieu. Tout autre péché peut être effacé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama Allah la yaghfiru an yushraka bihi » — certes, Allah ne pardonne pas qu'on Lui donne des associés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve l'unicité d'Allah dans mon cœur ? Y a-t-il des idoles cachées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le polythéisme n'est pas seulement des statues — c'est tout ce qui prend la place d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité de la création reflète l'unicité du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son cœur pur d'associations garde la porte du pardon ouverte." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Purifie mon cœur de toute association. Ne me laisse pas donner à un autre ce qui T'appartient.`
};

MIROIR["4:49"] = {
  reference: "4:49",
  theme: ["autojustification", "pureté", "humilité"],
  emotion: "Lucidité spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Tahur", "Al-Basir"],
  mirrorVersion: `« N'as-tu pas vu ceux qui se déclarent purs ? C'est Allah qui déclare pur qui Il veut. » Le miroir me montre l'illusion de l'autojustification. « Yuzakkina anfusahum » — ils se déclarent purs — la pureté n'est pas auto-proclamée. Le miroir m'invite à l'humilité : c'est Allah qui juge de la pureté, pas moi.`,
  reflection: `La pureté n'est pas une auto-évaluation — c'est un don divin. L'humilité est le chemin de la vraie pureté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara ila alladhina yuzakkina anfusahum » — ceux qui se déclarent purs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me considère pur ? Ou est-ce que j'attends le jugement d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'auto-justification est souvent le masque de l'impureté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie pureté est reconnue par Dieu seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie est élevé par Allah." }
  ],
  munajat: `Ya Tahur, Tu es le Purificateur. Purifie-moi selon Ta volonté. Ne me laisse pas m'auto-justifier.`
};

MIROIR["4:50"] = {
  reference: "4:50",
  theme: ["mensonge", "invention", "avertissement"],
  emotion: "Mise en garde sévère",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khaliq"],
  mirrorVersion: `« Regarde comment ils inventent le mensonge contre Allah ! Cela suffit comme péché manifeste. » Le miroir me montre la gravité de l'invention religieuse. « Yaftaruna al-kadhib » — ils inventent le mensonge — attribuer à Allah ce qu'Il n'a pas dit est un crime. Le miroir m'invite à la véracité dans mes paroles sur la religion.`,
  reflection: `Inventer sur Allah est un péché grave. La véracité dans les affaires religieuses est une obligation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anzur kayfa yaftaruna 'ala Allah al-kadhib » — regarde comment ils inventent le mensonge contre Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je parle d'Allah avec véracité ? Ou est-ce que j'invente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sur Allah est pire que le mensonge sur les hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur Dieu est sacrée — l'invention est une profanation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique sur Allah reçoit Sa vérité." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je sois véridique quand je parle de Toi. Ne me laisse pas inventer sur Ton compte.`
};

MIROIR["4:51"] = {
  reference: "4:51",
  theme: ["égarement", "polythéisme", "mise en garde"],
  emotion: "Tristesse spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Wahid"],
  mirrorVersion: `« N'as-tu pas vu ceux qui ont reçu une partie du Livre et qui croient au Jibt et au Taghut ? » Le miroir me montre l'égarement de ceux qui ont la connaissance mais la délaissent. « Jibt wa Taghut » — idoles et fausses divinités — ils retournent à l'idolâtrie malgré le Livre. Le miroir m'invite à ne pas abandonner la guidance reçue.`,
  reflection: `La connaissance ne garantit pas la guidance. Ceux qui ont le Livre peuvent s'égarer s'ils l'abandonnent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yu'minuna bi al-jibt wa al-taghut » — ils croient au Jibt et au Taghut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je garde la guidance que j'ai reçue ? Ou est-ce que je la délaisse pour l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon de la guidance est le premier pas vers l'idolâtrie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière reçue peut être éteinte par le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde la guidance reçue est guidé vers plus." }
  ],
  munajat: `Ya Hadi, Tu m'as donné la guidance. Fais que je la garde. Ne me laisse pas retourner à l'égarement après avoir connu la vérité.`
};

MIROIR["4:52"] = {
  reference: "4:52",
  theme: ["malédiction", "injustice", "avertissement"],
  emotion: "Terreur spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-La'in", "Al-Adl"],
  mirrorVersion: `« Ce sont eux les maudits. Allah les a maudits. » Le miroir me montre la conséquence de l'égarement délibéré. « La'ana hum Allah » — Allah les a maudits — la malédiction est l'éloignement de la miséricorde. Le miroir m'invite à prendre au sérieux le danger de l'égarement persistant.`,
  reflection: `La malédiction est l'éloignement de la miséricorde. L'égarement persistant mène à l'éloignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika alladhina la'anahum Allah » — ce sont eux les maudits. Allah les a maudits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux le danger de l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La malédiction n'est pas arbitraire — elle est la conséquence du choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'éloignement de Dieu est le pire châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la proximité d'Allah ne craint pas la malédiction." }
  ],
  munajat: `Ya Rahman, je cherche Ta proximité. Ne me laisse pas m'éloigner de Toi. Préserve-moi de la malédiction de l'égarement.`
};

MIROIR["4:53"] = {
  reference: "4:53",
  theme: ["partage", "pouvoir", "humilité"],
  emotion: "Réalité spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Wahhab"],
  mirrorVersion: `« Possèdent-ils une part de la royauté ? Ils ne donneraient alors aux gens même pas le creux d'un noyau. » Le miroir me montre l'avidité de ceux qui n'ont rien mais veulent tout. « Mitqala nakhl » — le creux d'un noyau — même ce rien, ils ne le donneraient pas. Le miroir m'invite à la générosité, même quand je n'ai que peu.`,
  reflection: `L'avidité n'est pas liée à la richesse. Les avares donnent peu, même quand ils ont beaucoup.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lahum nasibun mina al-mulk » — possèdent-ils une part de la royauté ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne même quand j'ai peu ? Ou est-ce que je garde tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité n'est pas affaire de quantité mais de cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Celui qui donne peu avec un grand cœur vaut mieux que celui qui donne beaucoup à contre-cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le généreux est riche même avec peu." }
  ],
  munajat: `Ya Wahhab, Tu es le Donateur. Fais que je sois généreux, même avec peu. Ne me laisse pas être avare.`
};

MIROIR["4:54"] = {
  reference: "4:54",
  theme: ["envie", "bénédiction", "acceptation"],
  emotion: "Paix avec la distribution",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Fadl"],
  mirrorVersion: `« Ou sont-ils envieux des gens pour ce qu'Allah leur a donné de Sa grâce ? » Le miroir me montre l'envie comme refus de la distribution divine. « Yahsaduna » — ils sont envieux — l'envie est le poison du cœur. Le miroir m'invite à accepter ce qu'Allah a donné aux autres et à me réjouir de ce qu'Il m'a donné.`,
  reflection: `L'envie est le refus de la sagesse d'Allah. Accepter Sa distribution, c'est être en paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yahsaduna al-nasa 'ala ma atahum Allah min fadlihi » — sont-ils envieux des gens pour ce qu'Allah leur a donné de Sa grâce ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'envie ce que les autres ont ? Ou est-ce que j'accepte ma part ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'envie ne change rien — elle ne fait que m'empoisonner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun reçoit sa part — l'accepter est la sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa part reçoit la paix." }
  ],
  munajat: `Ya Fadl, Tu distribues avec sagesse. Fais que j'accepte ma part. Ne me laisse pas être dévoré par l'envie.`
};

MIROIR["4:55"] = {
  reference: "4:55",
  theme: ["foi", "rejet", "division"],
  emotion: "Tristesse lucide",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Alors certains ont cru en lui, et d'autres ont détourné leur regard. » Le miroir me montre la division face à la vérité. « A'rada 'anhu » — ont détourné leur regard — le rejet est un choix. Le miroir m'invite à choisir la foi plutôt que le détournement.`,
  reflection: `La vérité divise — les uns croient, les autres détournent leur regard. Le choix est individuel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-minhum man amana bihi wa minhum man a'rada 'anhu » — certains ont cru en lui, et d'autres ont détourné leur regard." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon choix face à la vérité ? La foi ou le détournement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement du regard n'efface pas la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste vraie même si tous la refusent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit reçoit la lumière — celui qui détourne reste dans l'obscurité." }
  ],
  munajat: `Ya Hadi, guide mon choix vers la foi. Ne me laisse pas détourner mon regard de la vérité.`
};

MIROIR["4:56"] = {
  reference: "4:56",
  theme: ["châtiment", "mécréance", "avertissement"],
  emotion: "Terreur salutaire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Nar"],
  mirrorVersion: `« Ceux qui ne croient pas en Nos signes, Nous les brûlerons dans le Feu. » Le miroir me montre le châtiment de la mécréance. « Lasahiqun » — Nous les brûlerons — le feu purifie mais le feu de l'enfer punit. Le miroir m'invite à prendre au sérieux l'avertissement.`,
  reflection: `Le châtiment est réel pour ceux qui persistent dans le rejet. L'avertissement est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama alladhina kafaru bi-ayatina sawfa nuslihim naran » — ceux qui ne croient pas en Nos signes, Nous les brûlerons dans le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux les avertissements divins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement n'est pas une menace vide — c'est une opportunité de changer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu purifie ou punit selon le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement n'a pas à le subir." }
  ],
  munajat: `Ya Jabbar, Ton avertissement est une miséricorde. Fais que je l'écoute et que je change. Ne me laisse pas subir ce que Tu m'as averti d'éviter.`
};

MIROIR["4:57"] = {
  reference: "4:57",
  theme: ["récompense", "paradis", "espérance"],
  emotion: "Espérance joyeuse",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'ud"],
  mirrorVersion: `« Et ceux qui croient et accomplissent les bonnes œuvres, Nous les ferons entrer dans des Jardins sous lesquels coulent les rivières. » Le miroir me montre la promesse pour les croyants. « Jannatin tajri min tahtiha al-anhar » — des jardins sous lesquels coulent les rivières. Le miroir m'invite à espérer et à œuvrer pour cette promesse.`,
  reflection: `Le paradis est la promesse pour les croyants qui œuvrent. L'espérance motive l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu wa 'amilu al-salihati » — et ceux qui croient et accomplissent les bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour le paradis ? Ou est-ce que je l'espère sans effort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espérance sans œuvre est une illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense suit l'effort — dans le spirituel comme dans le matériel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le paradis y entre." }
  ],
  munajat: `Ya Jannah, Tu es la demeure de la paix. Fais que j'œuvre pour Toi. Donne-moi d'y entrer par Ta miséricorde.`
};

MIROIR["4:58"] = {
  reference: "4:58",
  theme: ["confiance", "responsabilité", "justice"],
  emotion: "Fidélité requise",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amin", "Al-Hakam"],
  mirrorVersion: `« Allah vous ordonne de rendre les dépôts à leurs ayants droit. » Le miroir me montre la responsabilité des dépôts. « Amanat » — les dépôts — tout ce qui m'est confié doit être rendu. « Ila ahliha » — à leurs ayants droit — avec précision. Le miroir m'invite à la fidélité dans les responsabilités.`,
  reflection: `Chaque confiance est un dépôt à rendre. La fidélité est une obligation spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama Allah ya'murukum an tu'addu al-amanat ila ahliha » — Allah vous ordonne de rendre les dépôts à leurs ayants droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels dépôts m'ont été confiés ? Est-ce que je les rends fidèlement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La trahison d'un dépôt est une trahison de confiance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fondé sur la confiance — chaque créature tient son rôle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le fidèle reçoit plus de dépôts — la confiance attire la confiance." }
  ],
  munajat: `Ya Amin, Tu es le Fidèle. Fais que je sois fidèle dans les dépôts qu'on me confie. Ne me laisse pas trahir les responsabilités.`
};

MIROIR["4:59"] = {
  reference: "4:59",
  theme: ["obéissance", "autorité", "communauté"],
  emotion: "Soumission ordonnée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amir", "Al-Hakim"],
  mirrorVersion: `« Ô vous qui avez cru ! Obéissez à Allah, obéissez au messager et à ceux d'entre vous qui détiennent l'autorité. » Le miroir me montre la hiérarchie de l'obéissance. « Ati'u Allah wa ati'u al-rasula » — obéissez à Allah et au messager — l'obéissance à Allah et Son prophète est première. « Uli al-amr » — ceux qui détiennent l'autorité — l'obéissance aux dirigeants est conditionnée par leur conformité à la loi divine.`,
  reflection: `L'obéissance a une hiérarchie : d'abord Allah, puis Son messager, puis les dirigeants justes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ati'u Allah wa ati'u al-rasula wa uli al-amr minkum » — obéissez à Allah, obéissez au messager et à ceux d'entre vous qui détiennent l'autorité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis l'obéissance ? Avec ordre ou avec confusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance aux dirigeants n'est pas absolue — elle est conditionnée par la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre de la création demande l'obéissance à la hiérarchie établie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit avec discernement est vraiment libre." }
  ],
  munajat: `Ya Amir, Tu es Celui qui ordonne. Fais que j'obéisse avec discernement. Guide-moi dans la hiérarchie de l'obéissance.`
};

MIROIR["4:60"] = {
  reference: "4:60",
  theme: ["hypocrisie", "jugement", "discordance"],
  emotion: "Lucidité sur l'hypocrisie",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Basir"],
  mirrorVersion: `« N'as-tu pas vu ceux qui prétendent croire à ce qu'on a fait descendre et à ce qui a été descendu avant toi ? Ils veulent recourir au Taghut pour le jugement. » Le miroir me montre l'hypocrisie du double langage. « Yuriduna an yatahakamu ila al-taghut » — ils veulent recourir au Taghut pour le jugement — la prétention de foi cache le recours à l'injustice. Le miroir m'invite à la cohérence entre mes paroles et mes actes.`,
  reflection: `L'hypocrisie est la discordance entre la prétention et la réalité. La cohérence est l'intégrité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuriduna an yatahakamu ila al-taghut » — ils veulent recourir au Taghut pour le jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis cohérent entre mes paroles et mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention de foi sans pratique est de l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité demande la cohérence — le mensonge est la discordance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est cohérent est en paix avec lui-même." }
  ],
  munajat: `Ya Hakam, Tu es le Juge. Fais que je sois cohérent dans ma foi. Ne me laisse pas prétendre croire alors que je ne pratique pas.`
};

// ==================== SURAH 4:61-176 (AN-NISA) - COMPLETE ====================

MIROIR["4:61"] = {
  reference: "4:61",
  theme: ["hypocrisie", "jugement", "détournement"],
  emotion: "Lucidité sur l'hypocrisie",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hadi"],
  mirrorVersion: `« Et quand on leur dit : Venez vers ce qu'Allah a révélé et vers le Messager, tu vois les hypocrites s'écarter de toi avec mépris. » Le miroir me montre le détournement hypocrite. « I'rida 'anka » — s'écarter de toi. Quand la vérité est claire, l'hypocrite se détourne. Le miroir m'interroge : comment je réagis face à la vérité ?`,
  reflection: `L'hypocrite se détourne de la vérité. Le croyant y vient avec humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahum ta'alaw ila ma anzala Allahu wa ila al-rasuli ra'ayta al-munafiqina yasudduna 'anka sududan » — et quand on leur dit : Venez vers ce qu'Allah a révélé et vers le Messager, tu vois les hypocrites s'écarter de toi avec mépris." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face à la vérité ? Est-ce que je viens avec humilité ou est-ce que je me détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement révèle l'hypocrisie du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité attire les cœurs sincères et repousse les cœurs malades." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se détourne de la vérité se détourne de son propre bien." }
  ],
  munajat: `Ya Hadi, guide-moi vers la vérité. Ne permets pas que je me détourne quand la vérité m'appelle. Fais que je vienne avec humilité.`
};

MIROIR["4:62"] = {
  reference: "4:62",
  theme: ["hypocrisie", "excuse", "mensonge"],
  emotion: "Lucidité sur les excuses",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Basir"],
  mirrorVersion: `« Comment sera leur situation quand un malheur les atteindra à cause de ce qu'ils ont commis ? Ils viendront alors à toi, jurant par Allah : Nous ne voulions que le bien et la réconciliation. » Le miroir me montre les excuses hypocrites. « Ma aradna illa ihsanan wa tawfiqan » — nous ne voulions que le bien et la réconciliation. L'hypocrite justifie son mal par de bonnes intentions. Le miroir m'interroge : est-ce que je justifie mes erreurs par de fausses intentions ?`,
  reflection: `L'hypocrite justifie son mal par de bonnes intentions. Le croyant reconnaît ses erreurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kayfa idha asabathum musibatun bima qaddamat aydihim thumma ja'uka yahlifuna billahi ma aradna illa ihsanan wa tawfiqan » — comment sera leur situation quand un malheur les atteindra à cause de ce qu'ils ont commis ? Ils viendront alors à toi, jurant par Allah : Nous ne voulions que le bien et la réconciliation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je justifie mes erreurs par de fausses intentions ? Ou est-ce que je les reconnaît humblement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse hypocrite aggrave la faute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les conséquences révèlent les vraies intentions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ses erreurs est pardonné." }
  ],
  munajat: `Ya Khabir, Tu connais mes intentions. Ne permets pas que je justifie mes erreurs par de fausses excuses. Donne-moi la sincérité de reconnaître mes fautes.`
};

MIROIR["4:63"] = {
  reference: "4:63",
  theme: ["hypocrisie", "cœur", "détour"],
  emotion: "Discernement, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Ce sont ceux dont Allah connaît ce qu'il y a dans leurs cœurs. Détourne-toi d'eux, exhorte-les et dis-leur sur eux-mêmes des paroles convaincantes. » Le miroir me montre la connaissance divine des cœurs. « Alladhina yalamu Allahu ma fi qulubihim » — ceux dont Allah connaît ce qu'il y a dans leurs cœurs. Allah connaît l'hypocrisie cachée. Le miroir m'interroge : est-ce que je réalise qu'Allah connaît ce qui est dans mon cœur ?`,
  reflection: `Allah connaît ce qui est dans les cœurs. Rien ne Lui est caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika alladhina yalamu Allahu ma fi qulubihim fa-a'rid 'anhum wa 'izhum wa qul lahum fi anfusihim qawlan balighan » — ce sont ceux dont Allah connaît ce qu'il y a dans leurs cœurs. Détourne-toi d'eux, exhorte-les et dis-leur sur eux-mêmes des paroles convaincantes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise qu'Allah connaît ce qui est dans mon cœur ? Mon cœur est-il sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance divine pénètre tous les secrets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur est le sanctuaire de l'intimité avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie son cœur n'a rien à cacher." }
  ],
  munajat: `Ya 'Alim, Tu connais ce qui est dans mon cœur. Purifie-le de toute hypocrisie. Fais que je n'aie rien à cacher devant Toi.`
};

MIROIR["4:64"] = {
  reference: "4:64",
  theme: ["prophète", "obéissance", "pardon"],
  emotion: "Espoir, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« Nous n'avons envoyé de Messager que pour être obéi par la permission d'Allah. » Le miroir me montre le but de l'envoi. « Li-yuta'a » — pour être obéi. Le Messager est envoyé pour être obéi, pas seulement pour informer. Le miroir m'interroge : est-ce que j'obéis au Prophète ou est-ce que je l'écoute seulement ?`,
  reflection: `Le Messager est envoyé pour être obéi. L'obéissance est la réponse à la mission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna min rasulin illa li-yuta'a bi-idhni Allah » — nous n'avons envoyé de Messager que pour être obéi par la permission d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis au Prophète ? Ou est-ce que je l'écoute seulement sans agir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance au Prophète est l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Messager est le modèle de l'obéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit au Prophète trouve le pardon." }
  ],
  munajat: `Ya Ghaffur, je veux obéir à Ton Prophète. Ne permets pas que je l'écoute sans agir. Donne-moi la force de l'obéissance.`
};

MIROIR["4:65"] = {
  reference: "4:65",
  theme: ["foi", "jugement", "soumission"],
  emotion: "Soumission totale",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Malik"],
  mirrorVersion: `« Non ! Par ton Seigneur ! Ils ne seront pas croyants tant qu'ils ne t'auront pas pris pour juge de leurs disputes. » Le miroir me montre la condition de la foi. « La yu'minun » — ils ne seront pas croyants. La foi exige la soumission au jugement du Prophète. Le miroir m'interroge : est-ce que je me soumets au jugement d'Allah et de Son Prophète ?`,
  reflection: `La foi exige la soumission totale au jugement divin. La résistance au jugement est un signe de foi incomplète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la wa rabbika la yu'minun hatta yuhakkimuka fi ma shar'a baynahum » — non ! Par ton Seigneur ! Ils ne seront pas croyants tant qu'ils ne t'auront pas pris pour juge de leurs disputes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumets au jugement d'Allah et de Son Prophète ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission au jugement est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah est la vérité absolue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet au jugement trouve la paix." }
  ],
  munajat: `Ya Hakam, je me soumets à Ton jugement. Ne permets pas que je résiste. Fais que je trouve la paix dans la soumission.`
};

MIROIR["4:66"] = {
  reference: "4:66",
  theme: ["obéissance", "vie", "paradis"],
  emotion: "Espoir, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hayy", "Al-Baqi"],
  mirrorVersion: `« Si Nous leur avions prescrit : Tuez-vous vous-mêmes ou sortez de vos demeures, ils ne l'auraient pas fait. » Le miroir me montre la limite de l'obéissance humaine. « Ma fa'aluhu illa qalilun minhum » — ils ne l'auraient pas fait, excepté un petit nombre. L'obéissance totale est rare. Le miroir m'interroge : jusqu'où va mon obéissance ?`,
  reflection: `L'obéissance totale est rare. La plupart obéissent partiellement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law anna katabna 'alayhim an iqtulu anfusakum aw akhruju min diyarikum ma fa'aluhu illa qalilun minhum » — si Nous leur avions prescrit : Tuez-vous vous-mêmes ou sortez de vos demeures, ils ne l'auraient pas fait, excepté un petit nombre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Jusqu'où va mon obéissance ? Est-ce que j'obéis à tout ou seulement à ce qui m'arrange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance totale mène à la vie éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sacrifice de soi est le sommet de l'obéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit totalement est parmi les élus." }
  ],
  munajat: `Ya Hayy, je veux obéir totalement. Ne permets pas que mon obéissance soit partielle. Donne-moi la force du sacrifice.`
};

MIROIR["4:67"] = {
  reference: "4:67",
  theme: ["récompense", "guidance", "chemin"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Ar-Rashid"],
  mirrorVersion: `« Et s'ils avaient fait ce qu'on leur recommande, cela aurait été mieux pour eux et plus à même de les raffermir. » Le miroir me montre le bien de l'obéissance. « Wa la-ashadda ta'thira » — et plus à même de les raffermir. L'obéissance renforce le cœur. Le miroir m'interroge : est-ce que je réalise que l'obéissance me renforce ?`,
  reflection: `L'obéissance renforce le cœur et rapproche d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha la-ataynahum min ladunna ajran aziman » — et Nous leur aurions donné une récompense immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que l'obéissance me renforce ? Ou est-ce que je la vois comme un fardeau ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance est une force, pas un fardeau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense suit l'obéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit reçoit au-delà de ses attentes." }
  ],
  munajat: `Ya Hadi, je veux obéir pour me renforcer. Ne permets pas que je voie l'obéissance comme un fardeau. Donne-moi la récompense immense.`
};

MIROIR["4:68"] = {
  reference: "4:68",
  theme: ["guidance", "chemin", "droiture"],
  emotion: "Espoir, direction",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Sirat"],
  mirrorVersion: `« Et Nous les aurions guidés vers un chemin droit. » Le miroir me montre la promesse de guidance. « Wa la-hadaynahum siratan mustaqiman » — et Nous les aurions guidés vers un chemin droit. L'obéissance ouvre la voie de la guidance. Le miroir m'interroge : est-ce que je cherche la guidance par l'obéissance ?`,
  reflection: `La guidance suit l'obéissance. Le chemin droit est ouvert à ceux qui obéissent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-hadaynahum siratan mustaqiman » — et Nous les aurions guidés vers un chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la guidance par l'obéissance ? Ou est-ce que j'attends la guidance sans obéir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est la récompense de l'obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin droit mène à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit est guidé sur le chemin." }
  ],
  munajat: `Ya Hadi, guide-moi sur le chemin droit. Ne permets pas que je m'égare. Ouvre-moi la voie par mon obéissance.`
};

MIROIR["4:69"] = {
  reference: "4:69",
  theme: ["compagnie", "prophètes", "élus"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Siddiq"],
  mirrorVersion: `« Quiconque obéit à Allah et au Messager, ceux-là seront avec ceux qu'Allah a comblés de Ses bienfaits : les prophètes, les véridiques, les martyrs et les vertueux. » Le miroir me montre la compagnie des élus. « Ma'a alladhina an'ama Allahu 'alayhim » — avec ceux qu'Allah a comblés de Ses bienfaits. L'obéissance mène à la meilleure compagnie. Le miroir m'interroge : quelle compagnie je cherche ?`,
  reflection: `L'obéissance mène à la compagnie des prophètes, des véridiques, des martyrs et des vertueux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yuti'i Allaha wa al-rasula fa-ula'ika ma'a alladhina an'ama Allahu 'alayhim min al-nabiyyina wa al-siddiqina wa al-shuhada'i wa al-salihina » — quiconque obéit à Allah et au Messager, ceux-là seront avec ceux qu'Allah a comblés de Ses bienfaits : les prophètes, les véridiques, les martyrs et les vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle compagnie je cherche ? Est-ce que j'aspire à la compagnie des élus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compagnie des élus est la récompense de l'obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "On sera avec ceux qu'on aime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit sera élevé au rang des élus." }
  ],
  munajat: `Ya Wali, je veux être avec les élus. Ne permets pas que je sois séparé d'eux. Fais que j'obéisse pour être avec les prophètes, les véridiques, les martyrs et les vertueux.`
};

MIROIR["4:70"] = {
  reference: "4:70",
  theme: ["grâce", "compagnie", "don"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Fadl", "Al-Karim"],
  mirrorVersion: `« Voilà la grâce d'Allah ! Allah suffit comme Connaisseur. » Le miroir me montre la grâce divine. « Dhalika al-fadlu min Allah » — voilà la grâce d'Allah. La compagnie des élus est une grâce, pas un mérite. Le miroir m'interroge : est-ce que je reconnais que c'est une grâce ?`,
  reflection: `La compagnie des élus est une grâce divine. On ne peut pas la mériter par ses œuvres seules.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika al-fadlu min Allahi wa kafa billahi 'aliman » — voilà la grâce d'Allah ! Allah suffit comme Connaisseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que la compagnie des élus est une grâce ? Ou est-ce que je pense la mériter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce précède le mérite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout bien est une grâce d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce la reçoit en abondance." }
  ],
  munajat: `Ya Fadl, je reconnais que c'est Ta grâce. Ne permets pas que je pense la mériter. Donne-moi la compagnie des élus par Ta grâce.`
};

MIROIR["4:71"] = {
  reference: "4:71",
  theme: ["précaution", "danger", "ennemi"],
  emotion: "Vigilance, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wakil"],
  mirrorVersion: `« Ô vous qui croyez ! Prenez vos précautions. » Le miroir me montre la nécessité de la prudence. « Khudhu hizrakum » — prenez vos précautions. La foi n'exclut pas la prudence. Le miroir m'interroge : est-ce que je suis prudent ou imprudent ?`,
  reflection: `La foi n'exclut pas la prudence. Le croyant est vigilant face au danger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu khudhu hizrakum » — ô vous qui croyez ! Prenez vos précautions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prudent ou imprudent ? Comment je me prépare face au danger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prudence est la sagesse du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le danger existe et demande préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prudent est protégé." }
  ],
  munajat: `Ya Hafiz, enseigne-moi la prudence. Ne permets pas que je sois imprudent. Protège-moi par ma préparation.`
};

MIROIR["4:72"] = {
  reference: "4:72",
  theme: ["hypocrisie", "désertion", "épreuve"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Fattah"],
  mirrorVersion: `« Il en est parmi vous qui traîne. » Le miroir me montre le traîneur. « Minhum la-yubattikhan » — parmi vous qui traîne. Certains retardent leur engagement pour voir l'issue. Le miroir m'interroge : est-ce que je traîne ou est-ce que je m'engage ?`,
  reflection: `Le traîneur attend l'issue pour décider. Le croyant s'engage sans attendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna minkum la-man la-yubattikhan » — il en est parmi vous qui traîne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traîne ou est-ce que je m'engage ? Mon engagement est-il conditionnel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le traînage révèle l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'engagement sincère ne connaît pas de délai." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traîne perd l'opportunité." }
  ],
  munajat: `Ya Khabir, je ne veux pas traîner. Ne permets pas que mon engagement soit conditionnel. Donne-moi la force de m'engager totalement.`
};

MIROIR["4:73"] = {
  reference: "4:73",
  theme: ["hypocrisie", "victoire", "regret"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Nasr"],
  mirrorVersion: `« Si une grâce d'Allah vous atteint, il dit comme s'il n'y avait aucune familiarité entre vous : Ah ! Si j'avais été avec eux, j'aurais obtenu un succès énorme. » Le miroir me montre le regret de l'hypocrite. « Ya laytani kuntu ma'ahum » — ah ! Si j'avais été avec eux. L'hypocrite regrette de ne pas avoir participé quand il voit le succès. Le miroir m'interroge : est-ce que je regrette mes absences d'engagement ?`,
  reflection: `L'hypocrite regrette son absence quand il voit le succès. Le croyant s'engage avant le succès.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yusbikum fadlun min Allahi yaqul ka-an lam takun baynakum wa baynahu mawaddatun ya laytani kuntu ma'ahum fa-afuza fawzan 'aziman » — si une grâce d'Allah vous atteint, il dit comme s'il n'y avait aucune familiarité entre vous : Ah ! Si j'avais été avec eux, j'aurais obtenu un succès énorme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je regrette mes absences d'engagement ? Ou est-ce que je m'engage avant le succès ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le succès suit l'engagement, pas l'inverse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'opportunité perdue ne revient pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'engage avant le succès obtient la part complète." }
  ],
  munajat: `Ya Fattah, je veux m'engager avant le succès. Ne permets pas que je regrette mon absence. Donne-moi la part du succès par mon engagement.`
};

MIROIR["4:74"] = {
  reference: "4:74",
  theme: ["combat", "vie", "paradis"],
  emotion: "Courage, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Hayy"],
  mirrorVersion: `« Qu'ils combattent donc dans le sentier d'Allah, ceux qui troquent la vie présente contre la vie future. » Le miroir me montre l'échange de vies. « Yashri al-hayata al-dunya bi-al-akhirah » — troquent la vie présente contre la vie future. Le combat est l'échange de la vie présente contre la vie future. Le miroir m'interroge : est-ce que je suis prêt à troquer ma vie présente contre la vie future ?`,
  reflection: `Le combat dans le sentier d'Allah est l'échange de la vie présente contre la vie future.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-l-yuqatil fi sabili Allahi alladhina yashruna al-hayata al-dunya bi-al-akhirah » — qu'ils combattent donc dans le sentier d'Allah, ceux qui troquent la vie présente contre la vie future." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à troquer ma vie présente contre la vie future ? Quelle valeur je donne à la vie future ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie présente est éphémère, la vie future est éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le combat est l'investissement pour l'éternité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui troque sa vie présente obtient la vie future." }
  ],
  munajat: `Ya Hayy, je veux troquer ma vie présente contre la vie future. Ne permets pas que je m'attache à l'éphémère. Donne-moi le courage du combat.`
};

MIROIR["4:75"] = {
  reference: "4:75",
  theme: ["combat", "faibles", "oppression"],
  emotion: "Compassion, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Muntaqim"],
  mirrorVersion: `« Et qu'avez-vous à ne pas combattre dans le sentier d'Allah et pour la cause des faibles : des hommes, des femmes et des enfants ? » Le miroir me montre la cause des faibles. « Fi sabili Allahi wa al-mustad'afina » — dans le sentier d'Allah et pour les faibles. Le combat est aussi pour protéger les opprimés. Le miroir m'interroge : est-ce que je me soucie des faibles ?`,
  reflection: `Le combat dans le sentier d'Allah inclut la protection des faibles et des opprimés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma lakum la tuqatiluna fi sabili Allahi wa al-mustad'afina min al-rijali wa al-nisa'i wa al-wildani » — et qu'avez-vous à ne pas combattre dans le sentier d'Allah et pour la cause des faibles : des hommes, des femmes et des enfants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soucie des faibles ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force est un devoir pour protéger les faibles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'oppression des faibles appelle la justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège les faibles est protégé par Allah." }
  ],
  munajat: `Ya Nasir, je veux protéger les faibles. Ne permets pas que je les ignore. Donne-moi la force de combattre l'oppression.`
};

MIROIR["4:76"] = {
  reference: "4:76",
  theme: ["combat", "alliés", "satan"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Shaytan"],
  mirrorVersion: `« Les croyants combattent dans le sentier d'Allah, et ceux qui mécroient combattent dans le sentier des idoles. » Le miroir me montre le contraste des combats. « Fi sabili Allah » — dans le sentier d'Allah. « Fi sabili al-taghut » — dans le sentier des idoles. Chacun combat pour son allié. Le miroir m'interroge : pour qui je combats ?`,
  reflection: `Chacun combat pour son allié. Le croyant combat pour Allah, le mécréant pour les idoles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina amanu yuqatiluna fi sabili Allahi wa alladhina kafaru yuqatiluna fi sabili al-taghut » — les croyants combattent dans le sentier d'Allah, et ceux qui mécroient combattent dans le sentier des idoles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui je combats ? Pour Allah ou pour les idoles de ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le combat révèle l'alliance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a que deux camps : Allah et les idoles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat pour Allah a la victoire promise." }
  ],
  munajat: `Ya Wali, je combats pour Toi. Ne permets pas que je combatte pour les idoles. Donne-moi la clarté de l'alliance.`
};

MIROIR["4:77"] = {
  reference: "4:77",
  theme: ["combat", "patience", "épreuve"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabr", "Al-Qadar"],
  mirrorVersion: `« N'as-tu pas vu ceux à qui il fut dit : Retenez vos mains, accomplissez la prière et acquittez la zakat ? Puis quand le combat leur fut prescrit, voilà qu'une partie d'entre eux se mirent à craindre les gens comme on craint Allah, ou d'une crainte plus forte encore. » Le miroir me montre la contradiction humaine. « Khawfan » — crainte. La crainte des hommes remplace la crainte d'Allah. Le miroir m'interroge : qui je crains le plus ?`,
  reflection: `La crainte des hommes révèle la faiblesse de la foi. Le croyant craint Allah plus que les hommes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-lam tara ila alladhina qila lahum kuffu aydiyakum wa aqimu al-salata wa atu al-zakata falamma kutiba 'alayhim al-qitalu idha fariqun minhum yakhshawna al-nasa ka-khashyati Allahi aw ashadda khashyatan » — n'as-tu pas vu ceux à qui il fut dit : Retenez vos mains, accomplissez la prière et acquittez la zakat ? Puis quand le combat leur fut prescrit, voilà qu'une partie d'entre eux se mirent à craindre les gens comme on craint Allah, ou d'une crainte plus forte encore." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je crains le plus ? Allah ou les hommes ? Ma crainte révèle ma foi." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte des hommes est un signe de foi faible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie crainte est celle d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah n'a peur de personne." }
  ],
  munajat: `Ya Rabb, je veux Te craindre plus que les hommes. Ne permets pas que la crainte des hommes domine. Donne-moi la force de la vraie crainte.`
};

MIROIR["4:78"] = {
  reference: "4:78",
  theme: ["destin", "mort", "fuite"],
  emotion: "Résignation, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muhaymin"],
  mirrorVersion: `« Où que vous soyez, la mort vous atteindra, fussiez-vous dans des tours imprenables. » Le miroir me montre l'inévitable. « Ayna ma takunu yudrikkumu al-mawt » — où que vous soyez, la mort vous atteindra. Nul n'échappe à la mort. Le miroir m'interroge : est-ce que je vis en sachant que la mort m'atteindra ?`,
  reflection: `La mort est inévitable. Nul ne peut y échapper, peu importe sa position.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayna ma takunu yudrikkumu al-mawt wa law kuntum fi burujin mushayyadah » — où que vous soyez, la mort vous atteindra, fussiez-vous dans des tours imprenables." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que la mort m'atteindra ? Ou est-ce que je fuis cette réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite de la mort est vaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est la loi universelle de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mort vit pleinement." }
  ],
  munajat: `Ya Qadir, j'accepte que la mort m'atteindra. Ne permets pas que je fuis cette réalité. Donne-moi de vivre avec la conscience de la mort.`
};

MIROIR["4:79"] = {
  reference: "4:79",
  theme: ["bien", "mal", "destin"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-'Adl"],
  mirrorVersion: `« Le bien qui t'atteint vient d'Allah, et le mal qui t'atteint vient de toi-même. » Le miroir me montre l'origine du bien et du mal. « Ma asabaka min hasanatin fa-min Allah » — le bien qui t'atteint vient d'Allah. « Wa ma asabaka min sayyi'atin fa-min nafsika » — et le mal qui t'atteint vient de toi-même. Le bien est grâce, le mal est conséquence. Le miroir m'interroge : est-ce que je reconnais l'origine du bien et du mal ?`,
  reflection: `Le bien vient d'Allah comme grâce. Le mal vient de nous-mêmes comme conséquence de nos actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma asabaka min hasanatin fa-min Allahi wa ma asabaka min sayyi'atin fa-min nafsika » — le bien qui t'atteint vient d'Allah, et le mal qui t'atteint vient de toi-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que le bien vient d'Allah et le mal de moi-même ? Ou est-ce que j'accuse Allah pour mes maux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance du bien augmente le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien est la règle, le mal est l'exception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attribue le bien à Allah voit le bien se multiplier." }
  ],
  munajat: `Ya Karim, je reconnais que le bien vient de Toi. Ne permets pas que j'accuse les autres pour mes maux. Donne-moi la gratitude pour le bien et la responsabilité pour le mal.`
};

MIROIR["4:80"] = {
  reference: "4:80",
  theme: ["obéissance", "prophète", "amour"],
  emotion: "Amour, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Habib", "Al-Rasul"],
  mirrorVersion: `« Quiconque obéit au Messager obéit certainement à Allah. » Le miroir me montre l'unité de l'obéissance. « Man yuti'i al-rasula fa-qad ata'a Allah » — quiconque obéit au Messager obéit à Allah. L'obéissance au Prophète est l'obéissance à Allah. Le miroir m'interroge : est-ce que j'aime le Prophète par mon obéissance ?`,
  reflection: `L'obéissance au Prophète est l'obéissance à Allah. Aimer le Prophète, c'est l'obéir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yuti'i al-rasula fa-qad ata'a Allah » — quiconque obéit au Messager obéit certainement à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aime le Prophète par mon obéissance ? Ou est-ce que je l'aime en paroles seulement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance au Prophète est l'amour sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Prophète est le chemin vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit au Prophète sera avec lui au Paradis." }
  ],
  munajat: `Ya Rabb, je veux obéir à Ton Prophète par amour. Ne permets pas que mon amour soit en paroles seulement. Fais que l'obéissance soit ma preuve d'amour.`
};

MIROIR["4:81"] = {
  reference: "4:81",
  theme: ["hypocrisie", "complot", "science"],
  emotion: "Lucidité, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Sami'"],
  mirrorVersion: `« Ils disent : Soumission. Mais quand ils sortent de chez toi, un groupe médite la nuit sur tout autre chose que ce qu'ils ont dit. » Le miroir me montre le double langage. « Yubayyituna » — méditent la nuit. L'hypocrite dit une chose et complote autrement. Le miroir m'interroge : est-ce que mes paroles correspondent à mes pensées ?`,
  reflection: `L'hypocrite dit une chose et en complote une autre. Le croyant est cohérent entre ses paroles et ses pensées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaquluna ta'atun fa-idha barazu min 'indika bayyata ta'ifatun minhum ghayra alladhi taqul » — ils disent : Soumission. Mais quand ils sortent de chez toi, un groupe médite la nuit sur tout autre chose que ce qu'ils ont dit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes paroles correspondent à mes pensées ? Ou est-ce que je dis une chose et en pense une autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La cohérence est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît les secrets des cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est cohérent n'a rien à cacher." }
  ],
  munajat: `Ya 'Alim, Tu connais mes pensées. Ne permets pas que je sois double. Fais que mes paroles et mes pensées soient une.`
};

MIROIR["4:82"] = {
  reference: "4:82",
  theme: ["coran", "réflexion", "cohérence"],
  emotion: "Émerveillement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Haqq"],
  mirrorVersion: `« Ne méditent-ils pas sur le Coran ? S'il provenait d'un autre qu'Allah, ils y trouveraient maintes contradictions. » Le miroir me montre la cohérence du Coran. « La-wajadu fihi ikhtilafan kathiran » — ils y trouveraient maintes contradictions. La cohérence du Coran prouve son origine divine. Le miroir m'interroge : est-ce que je médite sur le Coran ?`,
  reflection: `La cohérence parfaite du Coran est la preuve de son origine divine. Sa méditation révèle sa profondeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-la yatadabbaruna al-qur'ana fa-law kana min 'indi ghayri Allahi la-wajadu fihi ikhtilafan kathiran » — ne méditent-ils pas sur le Coran ? S'il provenait d'un autre qu'Allah, ils y trouveraient maintes contradictions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur le Coran ? Ou est-ce que je le lis superficiellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation révèle les trésors du Coran." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est cohérent sur tous les plans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite trouve la guidance dans le Coran." }
  ],
  munajat: `Ya Haqq, je veux méditer sur Ton Coran. Ne permets pas que je le lise superficiellement. Donne-moi les trésors de la méditation.`
};

MIROIR["4:83"] = {
  reference: "4:83",
  theme: ["rumeur", "discernement", "responsabilité"],
  emotion: "Prudence, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Quand leur parvient une nouvelle rassurante ou alarmante, ils la diffusent. » Le miroir me montre la diffusion des nouvelles. « Yathi'una biha » — ils la diffusent. La diffusion sans vérification est un danger. Le miroir m'interroge : est-ce que je vérifie avant de diffuser ?`,
  reflection: `La diffusion des nouvelles sans vérification est dangereuse. Le croyant vérifie avant de transmettre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ja'ahum amrun min al-amni aw al-khawfi adha'u bihi » — quand leur parvient une nouvelle rassurante ou alarmante, ils la diffusent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vérifie avant de diffuser ? Ou est-ce que je transmets sans discernement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérification est la responsabilité du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La rumeur est un fléau qui détruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vérifie protège la communauté." }
  ],
  munajat: `Ya Hakim, enseigne-moi la prudence dans la diffusion. Ne permets pas que je transmette sans vérifier. Donne-moi le discernement.`
};

MIROIR["4:84"] = {
  reference: "4:84",
  theme: ["combat", "encouragement", "force"],
  emotion: "Courage, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Qawiyy", "Al-'Aziz"],
  mirrorVersion: `« Combats donc dans le sentier d'Allah, tu n'es responsable que de toi-même. » Le miroir me montre la responsabilité individuelle. « Innama anta 'an nafsika » — tu n'es responsable que de toi-même. Le combat commence par soi. Le miroir m'interroge : est-ce que je me bats d'abord contre mes propres démons ?`,
  reflection: `Le combat dans le sentier d'Allah commence par le combat contre soi-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-qatil fi sabili Allahi la tukallafu illa nafsaka » — combats donc dans le sentier d'Allah, tu n'es responsable que de toi-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me bats d'abord contre mes propres démons ? Ou est-ce que je combats les autres avant moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le combat contre soi est le plus grand combat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La victoire sur soi précède la victoire sur les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se vainc soi-même est le plus fort." }
  ],
  munajat: `Ya Qawiyy, donne-moi la force de me battre contre moi-même. Ne permets pas que je combattre les autres avant moi. Donne-moi la victoire sur mon âme.`
};

MIROIR["4:85"] = {
  reference: "4:85",
  theme: ["intercession", "récompense", "responsabilité"],
  emotion: "Responsabilité, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shafi'", "Al-Wasilah"],
  mirrorVersion: `« Quiconque intercède pour une bonne cause en aura une part. » Le miroir me montre la part de l'intercession. « Falahu nasibun minha » — en aura une part. L'intercession pour le bien apporte une part de récompense. Le miroir m'interroge : est-ce que j'intercède pour le bien ?`,
  reflection: `L'intercession pour le bien apporte une part de récompense. L'intercession pour le mal apporte une part de charge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yashfa' shafa'atan hasanatan yakun lahu nasibun minha » — quiconque intercède pour une bonne cause en aura une part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'intercède pour le bien ? Ou est-ce que je m'abstiens d'intercéder ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession pour le bien est un acte de bienfaisance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'intercession connecte les créatures entre elles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui intercède pour le bien reçoit au-delà de sa part." }
  ],
  munajat: `Ya Shafi', je veux intercéder pour le bien. Ne permets pas que je m'abstienne. Donne-moi la part de l'intercession bienveillante.`
};

MIROIR["4:86"] = {
  reference: "4:86",
  theme: ["salutation", "réponse", "politesse"],
  emotion: "Gentillesse, respect",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Latif"],
  mirrorVersion: `« Si on vous salue, saluez d'une façon meilleure ou rendez le même salut. » Le miroir me montre la réponse au salut. « Fa-raddu bi-ahsana minha » — saluez d'une façon meilleure. Le salut mérite une meilleure réponse. Le miroir m'interroge : comment je réponds aux salutations ?`,
  reflection: `Le salut mérite une réponse meilleure ou égale. La politesse est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ida huyyitum bi-tahiyyatin fa-hayyu bi-ahsana minha aw radduha » — si on vous salue, saluez d'une façon meilleure ou rendez le même salut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réponds aux salutations ? Est-ce que je réponds mieux ou égal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réponse au salut est un droit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le salut est la paix entre les créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui salue mieux reçoit la paix d'Allah." }
  ],
  munajat: `Ya Salam, enseigne-moi la politesse du salut. Ne permets pas que je néglige la réponse. Donne-moi de saluer mieux que je ne suis salué.`
};

MIROIR["4:87"] = {
  reference: "4:87",
  theme: ["allah", "unicité", "résurrection"],
  emotion: "Certitude, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ba'th"],
  mirrorVersion: `« Allah ! Nulle divinité à part Lui. Il vous rassemblera certainement au Jour de la Résurrection. » Le miroir me montre l'unicité et le rassemblement. « La rayba fihi » — pas de doute. L'unicité et la résurrection sont certaines. Le miroir m'interroge : est-ce que je vis avec la certitude de la résurrection ?`,
  reflection: `L'unicité d'Allah et la résurrection sont certaines. La foi en ces vérités transforme la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu la ilaha illa huwa la-yajma'annakum ila yawmi al-qiyamati la rayba fihi » — Allah ! Nulle divinité à part Lui. Il vous rassemblera certainement au Jour de la Résurrection, pas de doute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la certitude de la résurrection ? Ou est-ce que j'ai des doutes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de la résurrection transforme la vie présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rassemblement est la promesse d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit certainement à la résurrection se prépare." }
  ],
  munajat: `Ya Wahid, je crois en Ton unicité et en la résurrection. Ne permets pas que j'aie des doutes. Donne-moi la certitude qui transforme.`
};

MIROIR["4:88"] = {
  reference: "4:88",
  theme: ["hypocrisie", "division", "confusion"],
  emotion: "Clarté, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Furqan"],
  mirrorVersion: `« Qu'avez-vous à vous diviser en deux groupes au sujet des hypocrites ? » Le miroir me montre la confusion face aux hypocrites. « Fi al-munafiqin » — au sujet des hypocrites. La division sur les hypocrites vient de la confusion. Le miroir m'interroge : est-ce que je suis clair sur les hypocrites ?`,
  reflection: `La clarté sur les hypocrites évite la division. Le discernement est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma lakum fi al-munafiqina fi'atayni » — qu'avez-vous à vous diviser en deux groupes au sujet des hypocrites ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis clair sur les hypocrites ? Ou est-ce que je suis confus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté sur l'hypocrisie vient d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'hypocrisie est un danger pour la communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui discerne l'hypocrisie est protégé." }
  ],
  munajat: `Ya Hadi, donne-moi la clarté sur l'hypocrisie. Ne permets pas que je sois confus. Éclaire mon discernement.`
};

MIROIR["4:89"] = {
  reference: "4:89",
  theme: ["hypocrisie", "mécréance", "avertissement"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Basir"],
  mirrorVersion: `« Ils aimeraient que vous mécroyiez comme ils ont mécru, pour que vous soyez tous égaux. » Le miroir me montre le désir des hypocrites. « Takuwna sawa'an » — pour que vous soyez tous égaux. L'hypocrite veut entraîner les autres dans sa mécréance. Le miroir m'interroge : est-ce que je me laisse influencer par les hypocrites ?`,
  reflection: `L'hypocrite veut entraîner les autres dans sa mécréance. Le croyant reste ferme dans sa foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waddu law takfuruna kama kafaru fa-takunu sawa'an » — ils aimeraient que vous mécroyiez comme ils ont mécru, pour que vous soyez tous égaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse influencer par les hypocrites ? Ou est-ce que je reste ferme dans ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeté dans la foi est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'influence des hypocrites est un test." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste ferme passe le test." }
  ],
  munajat: `Ya Basir, je veux rester ferme dans ma foi. Ne permets pas que les hypocrites m'influencent. Donne-moi la fermeté de la foi.`
};

MIROIR["4:90"] = {
  reference: "4:90",
  theme: ["exception", "neutre", 'refuge'],
  emotion: "Nuance, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Excepté ceux qui se réfugient auprès d'un peuple entre lequel et vous il y a une alliance. » Le miroir me montre l'exception. « Illa alladhina wasalu » — excepté ceux qui se réfugient. L'exception existe pour ceux qui cherchent la paix. Le miroir m'interroge : est-ce que je reconnais les exceptions ?`,
  reflection: `L'exception existe pour ceux qui cherchent la paix. La justice demande de reconnaître les nuances.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina yasaluna ila qawmin baynakum wa baynahum mithaqun » — excepté ceux qui se réfugient auprès d'un peuple entre lequel et vous il y a une alliance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les exceptions ? Ou est-ce que je généralise sans nuance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuance est la justice de la loi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix est recherchée même avec les opposants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les exceptions est juste." }
  ],
  munajat: `Ya 'Adl, enseigne-moi la nuance et la justice. Ne permets pas que je généralise sans exception. Donne-moi la sagesse des exceptions.`
};

MIROIR["4:91"] = {
  reference: "4:91",
  theme: ["danger", "neutralité", "vigilance"],
  emotion: "Prudence, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Wakil"],
  mirrorVersion: `« Vous en trouverez d'autres qui désirent être en sécurité avec vous et avec leur peuple. » Le miroir me montre la double appartenance. « Yuridu an ya'manakum » — désirent être en sécurité avec vous. Certains veulent la sécurité des deux côtés. Le miroir m'interroge : est-ce que je suis vigilant face aux doubles appartenances ?`,
  reflection: `La double appartenance est un danger. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa-tajiduna akharina yuriduna an ya'manakum wa ya'mana qawmahum » — vous en trouverez d'autres qui désirent être en sécurité avec vous et avec leur peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vigilant face aux doubles appartenances ? Ou est-ce que je fais confiance aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La double appartenance révèle l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'appartenance unique est la sincérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vigilant n'est pas trompé." }
  ],
  munajat: `Ya Hafiz, enseigne-moi la vigilance. Ne permets pas que je sois trompé par les doubles appartenances. Donne-moi le discernement.`
};

MIROIR["4:92"] = {
  reference: "4:92",
  theme: ["erreur", "meurtre", "réparation"],
  emotion: "Responsabilité, regret",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffur", "Al-Tawwab"],
  mirrorVersion: `« Il n'appartient pas à un croyant de tuer un croyant, si ce n'est par erreur. » Le miroir me montre la gravité du meurtre. « Illa khata'an » — si ce n'est par erreur. Le meurtre d'un croyant est grave, même par erreur. Le miroir m'interroge : est-ce que je réalise la gravité de la vie d'un croyant ?`,
  reflection: `La vie d'un croyant est sacrée. Le meurtre, même par erreur, demande réparation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana li-mu'minin an yaqtula mu'minan illa khata'an » — il n'appartient pas à un croyant de tuer un croyant, si ce n'est par erreur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la gravité de la vie d'un croyant ? Ou est-ce que je sous-estime sa valeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie du croyant est sacrée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'erreur demande réparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répare son erreur obtient le pardon." }
  ],
  munajat: `Ya Ghaffur, je réalise la gravité de la vie du croyant. Ne permets pas que je la sous-estime. Donne-moi la réparation des erreurs.`
};

MIROIR["4:93"] = {
  reference: "4:93",
  theme: ["meurtre", "châtiment", "éternité"],
  emotion: "Terreur, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahannam", "Al-Ghadab"],
  mirrorVersion: `« Quiconque tue intentionnellement un croyant, sa rétribution sera l'Enfer, pour y demeurer éternellement. » Le miroir me montre le châtiment du meurtre intentionnel. « Khalidan fiha » — pour y demeurer éternellement. Le meurtre intentionnel d'un croyant mène à l'Enfer éternel. Le miroir m'interroge : est-ce que je réalise la gravité du meurtre intentionnel ?`,
  reflection: `Le meurtre intentionnel d'un croyant est un des plus grands péchés. Son châtiment est l'Enfer éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yaqtula mu'minan muta'ammidan fa-jaza'uhu jahannamu khalidan fiha » — quiconque tue intentionnellement un croyant, sa rétribution sera l'Enfer, pour y demeurer éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la gravité du meurtre intentionnel ? La vie du croyant est-elle sacrée pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le meurtre intentionnel détruit le meurtrier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie du croyant est la vie de la communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la vie du croyant préserve sa propre vie." }
  ],
  munajat: `Ya Rabb, préserve-moi du meurtre intentionnel. Ne permets pas que je détruis la vie d'un croyant. Donne-moi le respect de la vie sacrée.`
};

MIROIR["4:94"] = {
  reference: "4:94",
  theme: ["discernement", "vérification", "accusation"],
  emotion: "Prudence, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Hakam"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous vous lancez dans le sentier d'Allah, soyez discernants. » Le miroir me montre le devoir de discernement. « Fa-tabayyanu » — soyez discernants. L'action dans le sentier d'Allah demande discernement. Le miroir m'interroge : est-ce que je suis discernant dans mes actions ?`,
  reflection: `L'action dans le sentier d'Allah demande discernement. L'accusation sans preuve est un péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu idha darabtum fi sabili Allahi fa-tabayyanu » — ô vous qui croyez ! Quand vous vous lancez dans le sentier d'Allah, soyez discernants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis discernant dans mes actions ? Ou est-ce que j'agis sans vérification ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le discernement est la protection de l'innocent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérification précède l'accusation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui discerne évite l'injustice." }
  ],
  munajat: `Ya Basir, enseigne-moi le discernement. Ne permets pas que j'accuse sans preuve. Donne-moi la prudence de la vérification.`
};

MIROIR["4:95"] = {
  reference: "4:95",
  theme: ["combattants", "stationnaires", "degrés"],
  emotion: "Motivation, excellence",
  difficulty: "débutant",
  relatedNames: ["Al-Mujahid", "Al-Fadl"],
  mirrorVersion: `« Ne sont pas égaux ceux des croyants qui restent chez eux, exceptés les handicapés, et ceux qui luttent corps et biens dans le sentier d'Allah. » Le miroir me montre l'inégalité des rangs. « La yastawuna » — ne sont pas égaux. Les combattants ont un rang supérieur. Le miroir m'interroge : quel rang je choisis ?`,
  reflection: `Les combattants dans le sentier d'Allah ont un rang supérieur. L'effort apporte l'excellence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yastawina al-qa'iduna min al-mu'minina ghayru uli al-darari wa al-mujahiduna fi sabili Allahi bi-amwalihim wa anfusihim » — ne sont pas égaux ceux des croyants qui restent chez eux, exceptés les handicapés, et ceux qui luttent corps et biens dans le sentier d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel rang je choisis ? Est-ce que je reste chez moi ou est-ce que je lutte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort est la voie de l'excellence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les degrés au Paradis correspondent aux efforts ici-bas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lutte pour Allah reçoit la plus haute récompense." }
  ],
  munajat: `Ya Mujahid, je veux lutter pour Toi. Ne permets pas que je reste passif. Donne-moi le rang des combattants.`
};

MIROIR["4:96"] = {
  reference: "4:96",
  theme: ["degrés", "pardon", "miséricorde"],
  emotion: "Espoir, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Allah a promis aux combattants des degrés, un pardon et une miséricorde. » Le miroir me montre la promesse aux combattants. « Darajatin wa maghfiratan wa rahmah » — des degrés, un pardon et une miséricorde. La récompense du combat est triple. Le miroir m'interroge : est-ce que j'aspire à cette triple récompense ?`,
  reflection: `La récompense du combat est triple : des degrés élevés, le pardon et la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khaddala Allahu al-mujahidina bi-amwalihim wa anfusihim 'ala al-qa'idina darajatan wa maghfiratan wa rahmah » — Allah a promis aux combattants des degrés, un pardon et une miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à cette triple récompense ? Ou est-ce que je néglige l'opportunité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense suit l'effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les degrés sont proportionnels aux efforts." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat pour Allah reçoit au-delà de ses attentes." }
  ],
  munajat: `Ya Ghafur, j'aspire aux degrés, au pardon et à la miséricorde. Ne permets pas que je néglige l'opportunité. Donne-moi la récompense des combattants.`
};

MIROIR["4:97"] = {
  reference: "4:97",
  theme: ["migration", "terre", "question"],
  emotion: "Responsabilité, réveil",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhajir", "Al-Wasi'"],
  mirrorVersion: `« Ceux qui ont fait du tort à eux-mêmes, les anges interrogent : Dans quel état étiez-vous ? Ils répondent : Nous étions faibles sur terre. » Le miroir me montre la question des anges. « Fi ma kuntum » — dans quel état étiez-vous ? La faiblesse n'est pas une excuse pour ne pas migrer. Le miroir m'interroge : suis-je dans une terre où je peux pratiquer ma foi ?`,
  reflection: `La faiblesse n'est pas une excuse pour rester dans une terre où la foi est opprimée. La migration est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina tawaffahumu al-mala'ikatu zalimi anfusihim qalu fi ma kuntum qalu kunna mustad'afina fi al-ard » — ceux qui ont fait du tort à eux-mêmes, les anges interrogent : Dans quel état étiez-vous ? Ils répondent : Nous étions faibles sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je dans une terre où je peux pratiquer ma foi ? Ou est-ce que je reste par faiblesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La migration est la voie de la liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre d'Allah est vaste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui migre pour Allah trouve la liberté." }
  ],
  munajat: `Ya Wasi', la terre est vaste. Ne permets pas que je reste par faiblesse. Donne-moi la force de migrer si nécessaire.`
};

MIROIR["4:98"] = {
  reference: "4:98",
  theme: ["exception", "faibles", "incapacité"],
  emotion: "Compassion, nuance",
  difficulty: "débutant",
  relatedNames: ["Al-Ra'uf", "Al-Tawwab"],
  mirrorVersion: `« Excepté les faibles parmi les hommes, les femmes et les enfants, incapables de trouver une issue. » Le miroir me montre l'exception pour les faibles. « Illa al-mustad'afina » — excepté les faibles. L'incapacité est une excuse valide. Le miroir m'interroge : suis-je vraiment incapable ou suis-je réticent ?`,
  reflection: `L'incapacité est une excuse valide pour ne pas migrer. Mais la réticence n'est pas une excuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa al-mustad'afina min al-rijali wa al-nisa'i wa al-wildani la yastati'una hilatan wa la yahtaduna sabilan » — excepté les faibles parmi les hommes, les femmes et les enfants, incapables de trouver une issue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je vraiment incapable ou suis-je réticent ? Quelle est ma vraie raison de rester ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incapacité excuse, la réticence condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah reconnaît les incapacités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincèrement incapable est pardonné." }
  ],
  munajat: `Ya Ra'uf, Tu connais ma capacité. Ne permets pas que je cache ma réticence derrière une fausse incapacité. Donne-moi la sincérité de l'évaluation.`
};

MIROIR["4:99"] = {
  reference: "4:99",
  theme: ["espoir", "pardon", "chemin"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Samir"],
  mirrorVersion: `« Ceux-là, Allah pourrait leur pardonner. Allah est Pardonneur et Absoluteur. » Le miroir me montre l'espoir pour les incapables. « Asa Allahu an ya'fuwa 'anhum » — Allah pourrait leur pardonner. L'espoir du pardon est ouvert. Le miroir m'interroge : est-ce que j'ai de l'espoir en la miséricorde d'Allah ?`,
  reflection: `L'espoir du pardon est ouvert pour ceux qui sont sincèrement incapables. La miséricorde d'Allah est vaste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ula'ika asa Allahu an ya'fuwa 'anhum wa kana Allahu 'afuwwan ghafuran » — ceux-là, Allah pourrait leur pardonner. Allah est Pardonneur et Absoluteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai de l'espoir en la miséricorde d'Allah ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir est la lumière du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère obtient au-delà de son espoir." }
  ],
  munajat: `Ya Ghafur, j'ai espoir en Ton pardon. Ne permets pas que je désespère. Donne-moi la confiance en Ta miséricorde.`
};

MIROIR["4:100"] = {
  reference: "4:100",
  theme: ["migration", "récompense", "terre"],
  emotion: "Espoir, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Wasi'", "Al-Karim"],
  mirrorVersion: `« Et quiconque émigre dans le sentier d'Allah trouvera sur terre de nombreux refuges et de l'abondance. » Le miroir me montre la promesse de la migration. « Mugharaqan kathiran » — de l'abondance. La migration dans le sentier d'Allah apporte l'abondance. Le miroir m'interroge : est-ce que je fais confiance à la promesse d'Allah ?`,
  reflection: `La migration dans le sentier d'Allah apporte l'abondance et la sécurité. La promesse d'Allah est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yuhajir fi sabili Allahi yajid fi al-ardi muraghaman kathiran wa sa'ah » — et quiconque émigre dans le sentier d'Allah trouvera sur terre de nombreux refuges et de l'abondance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la promesse d'Allah ? Ou est-ce que je crains la perte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte apparente est le gain réel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre d'Allah nourrit ceux qui migrent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui migre pour Allah reçoit l'abondance." }
  ],
  munajat: `Ya Wasi', je fais confiance à Ta promesse. Ne permets pas que je craigne la perte. Donne-moi l'abondance de la migration.`
};

MIROIR["4:101"] = {
  reference: "4:101",
  theme: ["prière", "raccourcissement", "voyage"],
  emotion: "Soulagement, facilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khafid", "Al-Rafi'"],
  mirrorVersion: `« Et quand vous parcourez la terre, il n'y a pas de péché pour vous de raccourcir la prière. » Le miroir me montre la facilité du voyage. « Fa-laysa 'alaykum junahun » — il n'y a pas de péché pour vous. La facilité est accordée au voyageur. Le miroir m'interroge : est-ce que j'accepte les facilités d'Allah ?`,
  reflection: `La facilité est accordée au voyageur. La religion d'Allah est facile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha darabtum fi al-ardi fa-laysa 'alaykum junahun an taqsuru min al-salat » — et quand vous parcourez la terre, il n'y a pas de péché pour vous de raccourcir la prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les facilités d'Allah ? Ou est-ce que je m'impose des difficultés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion d'Allah est facilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la facilité reconnaît la miséricorde." }
  ],
  munajat: `Ya Khafid, j'accepte Ta facilité. Ne permets pas que je m'impose des difficultés. Donne-moi la reconnaissance de la miséricorde.`
};

MIROIR["4:102"] = {
  reference: "4:102",
  theme: ["prière", "danger", "organisation"],
  emotion: "Discipline, vigilance",
  difficulty: "avancé",
  relatedNames: ["Al-Hafiz", "Al-Qadir"],
  mirrorVersion: `« Et quand tu te trouves parmi eux et que tu diriges pour eux la prière, qu'un groupe se tienne debout avec toi. » Le miroir me montre la prière dans le danger. « Fa-li-taqum ma'aka ta'ifatun » — qu'un groupe se tienne debout avec toi. La prière persiste même dans le danger. Le miroir m'interroge : est-ce que je maintiens la prière dans toutes les circonstances ?`,
  reflection: `La prière persiste même dans le danger. L'organisation permet la prière dans toutes les circonstances.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha kunta fihim fa-aqamta lahum al-salata fa-li-taqum ma'aka ta'ifatun minhum » — et quand tu te trouves parmi eux et que tu diriges pour eux la prière, qu'un groupe se tienne debout avec toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je maintiens la prière dans toutes les circonstances ? Ou est-ce que je l'abandonne dans le danger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière dans le danger est la plus méritoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière est le pilier de la religion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie dans le danger est protégé." }
  ],
  munajat: `Ya Hafiz, je veux prier dans toutes les circonstances. Ne permets pas que j'abandonne la prière. Donne-moi la force de prier même dans le danger.`
};

MIROIR["4:103"] = {
  reference: "4:103",
  theme: ["prière", "régularité", "rappel"],
  emotion: "Discipline, présence",
  difficulty: "débutant",
  relatedNames: ["Al-Dhikr", "Al-Salat"],
  mirrorVersion: `« Accomplissez la prière au déclin du soleil jusqu'à l'obscurité de la nuit, et la récitation de l'aube. » Le miroir me montre les temps de prière. « Fa-aqimu al-salat » — accomplissez la prière. La prière a des temps définis. Le miroir m'interroge : est-ce que je respecte les temps de prière ?`,
  reflection: `La prière a des temps définis. Le respect des temps est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aqimu al-salata li-duluki al-shamsi ila ghasaqi al-layli wa qur'ana al-fajr » — accomplissez la prière au déclin du soleil jusqu'à l'obscurité de la nuit, et la récitation de l'aube." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les temps de prière ? Ou est-ce que je retarde sans raison ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des temps est la discipline du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les temps de prière rythment la journée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les temps trouve la barakah." }
  ],
  munajat: `Ya Dhikr, je veux respecter les temps de prière. Ne permets pas que je retarde sans raison. Donne-moi la discipline des temps.`
};

MIROIR["4:104"] = {
  reference: "4:104",
  theme: ["persévérance", "endurance", "espoir"],
  emotion: "Détermination, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Sabr", "Al-Matin"],
  mirrorVersion: `« Ne faiblissez pas dans la poursuite du combat. » Le miroir me montre la persévérance. « La ta'falu » — ne faiblissez pas. La persévérance dans le combat est nécessaire. Le miroir m'interroge : est-ce que je persévère ou est-ce que je faiblis ?`,
  reflection: `La persévérance dans le combat est nécessaire. La faiblesse mène à la défaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la ta'falu fi ibtigha'i al-qawm » — ne faiblissez pas dans la poursuite du combat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persévère ou est-ce que je faiblis ? Quelle est ma détermination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La persévérance est la voie de la victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fin du combat appartient aux persévérants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui persévère obtient la victoire." }
  ],
  munajat: `Ya Sabr, donne-moi la persévérance. Ne permets pas que je faiblis. Donne-moi la détermination jusqu'à la victoire.`
};

MIROIR["4:105"] = {
  reference: "4:105",
  theme: ["jugement", "justice", "révélation"],
  emotion: "Responsabilité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Haqq"],
  mirrorVersion: `« Nous avons fait descendre vers toi le Livre avec la vérité, pour que tu juges entre les gens selon ce qu'Allah t'a enseigné. » Le miroir me montre la fonction de la révélation. « Li-tahkuma bayna al-nasi » — pour que tu juges entre les gens. La révélation est le critère du jugement. Le miroir m'interroge : est-ce que je juge selon la révélation ?`,
  reflection: `La révélation est le critère du jugement. Le jugement selon la vérité est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna anzalna ilayka al-kitaba bi-al-haqqi li-tahkuma bayna al-nasi bima araka Allah » — nous avons fait descendre vers toi le Livre avec la vérité, pour que tu juges entre les gens selon ce qu'Allah t'a enseigné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge selon la révélation ? Ou est-ce que je juge selon mes préférences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement selon la vérité est la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est le fondement du jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui juge selon la vérité est juste." }
  ],
  munajat: `Ya Hakam, je veux juger selon Ta révélation. Ne permets pas que je juge selon mes préférences. Donne-moi la justice de la vérité.`
};

MIROIR["4:106"] = {
  reference: "4:106",
  theme: ["pardon", "repentir", "prière"],
  emotion: "Humilité, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "At-Tawwab"],
  mirrorVersion: `« Implore le pardon d'Allah, car Allah est Pardonneur et Miséricordieux. » Le miroir me montre le pardon constant. « Istaghfir Allah » — implore le pardon d'Allah. Le pardon est un état constant. Le miroir m'interroge : est-ce que j'implore le pardon constamment ?`,
  reflection: `Le pardon est un état constant. Le croyant implore le pardon en permanence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa istaghfir Allaha inna Allaha kana ghafuran rahiman » — implore le pardon d'Allah, car Allah est Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'implore le pardon constamment ? Ou est-ce que je le fais rarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon constant purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est toujours disponible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui implore le pardon constamment est purifié." }
  ],
  munajat: `Ya Ghaffur, j'implore Ton pardon constamment. Ne permets pas que je le néglige. Purifie mon cœur par le pardon continu.`
};

MIROIR["4:107"] = {
  reference: "4:107",
  theme: ["défense", "trahison", "péché"],
  emotion: "Lucidité, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-'Adl"],
  mirrorVersion: `« Ne défends pas ceux qui se trahissent eux-mêmes. » Le miroir me montre l'interdiction de défendre les traîtres. « La tujadil 'an alladhina yakhtanuna anfusahum » — ne défends pas ceux qui se trahissent eux-mêmes. La défense des traîtres est interdite. Le miroir m'interroge : est-ce que je défends ceux qui trahissent ?`,
  reflection: `La défense des traîtres est interdite. La loyauté à la vérité prime sur la loyauté aux personnes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tujadil 'an alladhina yakhtanuna anfusahum » — ne défends pas ceux qui se trahissent eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défends ceux qui trahissent ? Ou est-ce que je défends la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défense des traîtres est une trahison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loyauté à la vérité est suprême." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend la vérité est honoré." }
  ],
  munajat: `Ya Khabir, je veux défendre la vérité. Ne permets pas que je défende les traîtres. Donne-moi la loyauté à la vérité.`
};

MIROIR["4:108"] = {
  reference: "4:108",
  theme: ["secret", "science", "dévoilement"],
  emotion: "Lucidité, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Batin"],
  mirrorVersion: `« Ils se cachent des hommes, mais ils ne se cachent pas d'Allah. » Le miroir me montre la futilité du secret. « La yastakhfuna min Allah » — ils ne se cachent pas d'Allah. Le secret devant les hommes ne cache rien à Allah. Le miroir m'interroge : est-ce que je cache mes péchés des hommes tout en les commettant devant Allah ?`,
  reflection: `Le secret devant les hommes ne cache rien à Allah. La conscience de Sa présence est la meilleure protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yah tarauna min al-nasi wa la yastakhfuna min Allah » — ils se cachent des hommes, mais ils ne se cachent pas d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cache mes péchés des hommes tout en les commettant devant Allah ? Ma conscience est-elle éveillée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience d'Allah est le rempart." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah voit tout, même le secret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec Allah ne cache rien." }
  ],
  munajat: `Ya Khabir, Tu vois tout de moi. Ne permets pas que je cache aux hommes ce que Tu vois. Donne-moi la conscience de Ta présence.`
};

MIROIR["4:109"] = {
  reference: "4:109",
  theme: ["défense", "jugement", "réalité"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Haqq"],
  mirrorVersion: `« Vous les avez défendus dans la vie présente. Mais qui les défendra contre Allah le Jour de la Résurrection ? » Le miroir me montre l'absurdité de la défense. « Man yujadiluhum » — qui les défendra ? La défense dans ce monde ne sert à rien contre Allah. Le miroir m'interroge : est-ce que je défends les coupables ?`,
  reflection: `La défense des coupables dans ce monde ne sert à rien contre le jugement d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha'ula'i jadaltum 'anhum fi al-hayati al-dunya fa-man yujadilu Allaha 'anhum yawma al-qiyamah » — vous les avez défendus dans la vie présente. Mais qui les défendra contre Allah le Jour de la Résurrection ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défends les coupables ? Ou est-ce que je les laisse face à leur responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défense des coupables est un crime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah est inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse les coupables face à leur responsabilité est juste." }
  ],
  munajat: `Ya Hakam, je ne veux pas défendre les coupables. Ne permets pas que je m'interpose entre eux et leur responsabilité. Donne-moi la justice.`
};

MIROIR["4:110"] = {
  reference: "4:110",
  theme: ["péché", "injustice", "pardon"],
  emotion: "Espoir, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« Quiconque fait le mal ou se fait injustice à lui-même, puis implore le pardon d'Allah, trouvera Allah Pardonneur et Miséricordieux. » Le miroir me montre la porte du pardon. « Yajid Allaha ghafuran rahiman » — trouvera Allah Pardonneur et Miséricordieux. La porte du pardon est toujours ouverte. Le miroir m'interroge : est-ce que j'implore le pardon après chaque faute ?`,
  reflection: `La porte du pardon est toujours ouverte. Le repentir sincère efface les péchés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man ya'mal su'an aw yazlim nafsahu thumma yastaghfir Allaha yajid Allaha ghafuran rahiman » — quiconque fait le mal ou se fait injustice à lui-même, puis implore le pardon d'Allah, trouvera Allah Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'implore le pardon après chaque faute ? Ou est-ce que je me décourage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir sincère efface les péchés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est plus vaste que les péchés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement est comme celui qui n'a pas péché." }
  ],
  munajat: `Ya Ghaffur, j'implore Ton pardon après chaque faute. Ne permets pas que je me décourage. Donne-moi le repentir sincère.`
};

MIROIR["4:111"] = {
  reference: "4:111",
  theme: ["péché", "responsabilité", "individualité"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakim"],
  mirrorVersion: `« Quiconque acquiert un péché, ne l'acquiert que contre lui-même. » Le miroir me montre la responsabilité individuelle. « Fa-innama yaksibuha 'ala nafsih » — ne l'acquiert que contre lui-même. Le péché ne nuit qu'à celui qui le commet. Le miroir m'interroge : est-ce que je réalise que mes péchés ne nuisent qu'à moi ?`,
  reflection: `Le péché ne nuit qu'à celui qui le commet. La responsabilité est individuelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yaksib ithman fa-innama yaksibuha 'ala nafsih » — quiconque acquiert un péché, ne l'acquiert que contre lui-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que mes péchés ne nuisent qu'à moi ? Ou est-ce que je pense nuire aux autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le péché est un poison pour l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La responsabilité est le fondement de la justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend cela évite le péché." }
  ],
  munajat: `Ya 'Adl, je réalise que mes péchés ne nuisent qu'à moi. Ne permets pas que je me trompe sur la responsabilité. Donne-moi la clarté.`
};

MIROIR["4:112"] = {
  reference: "4:112",
  theme: ["calomnie", "injustice", "mensonge"],
  emotion: "Mise en garde, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Burhan"],
  mirrorVersion: `« Quiconque acquiert une faute ou un péché puis en accuse un innocent, se charge d'un mensonge et d'un péché évident. » Le miroir me montre la gravité de la calomnie. « Fa-qad ihtamala buhtanan wa ithman mubinan » — se charge d'un mensonge et d'un péché évident. La calomnie double la faute. Le miroir m'interroge : est-ce que je calomnie pour cacher mes fautes ?`,
  reflection: `La calomnie double la faute. Accuser un innocent est un grave péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yaksib khati'atan aw ithman thumma yarmi bihi barian fa-qad ihtamala buhtanan wa ithman mubinan » — quiconque acquiert une faute ou un péché puis en accuse un innocent, se charge d'un mensonge et d'un péché évident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je calomnie pour cacher mes fautes ? Ou est-ce que j'assume ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La calomnie aggrave la faute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'innocent mérite protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité est purifié." }
  ],
  munajat: `Ya Haqq, je ne veux pas calomnier. Ne permets pas que j'accuse un innocent. Donne-moi la force d'assumer ma responsabilité.`
};

MIROIR["4:113"] = {
  reference: "4:113",
  theme: ["grâce", "prophète", "protection"],
  emotion: "Gratitude, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fadl", "Al-Huda"],
  mirrorVersion: `« Sans la grâce d'Allah et Sa miséricorde, un groupe parmi eux t'aurait égaré. » Le miroir me montre la protection divine. « Lawla fadlu Allahi 'alayka » — sans la grâce d'Allah sur toi. La protection contre l'égarement est une grâce. Le miroir m'interroge : est-ce que je reconnais que ma guidance est une grâce ?`,
  reflection: `La protection contre l'égarement est une grâce. La guidance n'est pas un droit, c'est un don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lawla fadlu Allahi 'alayka wa rahmatuhu la-hammat ta'ifatun minhum an yudilluka » — sans la grâce d'Allah et Sa miséricorde, un groupe parmi eux t'aurait égaré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que ma guidance est une grâce ? Ou est-ce que je la considère comme un droit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est un don précieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'égarement guette tout le monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce la garde." }
  ],
  munajat: `Ya Fadl, je reconnais que ma guidance est Ta grâce. Ne permets pas que je l'égare. Protège-moi de l'égarement.`
};

MIROIR["4:114"] = {
  reference: "4:114",
  theme: ["secret", "bien", "mal"],
  emotion: "Discernement, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Hakim"],
  mirrorVersion: `« Il n'y a pas de bien dans la plupart de leurs secrets, sauf celui qui ordonne une charité, une bonne action ou une réconciliation. » Le miroir me montre le critère du secret. « Illa man amara bi-sadaqatin aw ma'rufin aw islahin » — sauf celui qui ordonne une charité, une bonne action ou une réconciliation. Le secret utile est celui du bien. Le miroir m'interroge : quel secret je garde ?`,
  reflection: `Le secret utile est celui qui mène au bien : charité, bonne action ou réconciliation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La khayra fi kathirin min najwahum illa man amara bi-sadaqatin aw ma'rufin aw islahin bayna al-nas » — il n'y a pas de bien dans la plupart de leurs secrets, sauf celui qui ordonne une charité, une bonne action ou une réconciliation entre les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel secret je garde ? Est-ce un secret de bien ou un secret de mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret du bien est béni." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le secret révèle l'intention." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde les secrets du bien est honoré." }
  ],
  munajat: `Ya Khabir, je veux garder les secrets du bien. Ne permets pas que je cache le mal. Donne-moi les secrets de la charité, de la bonne action et de la réconciliation.`
};

MIROIR["4:115"] = {
  reference: "4:115",
  theme: ["division", "prophète", "égarement"],
  emotion: "Mise en garde, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sirat", "Al-Hadi"],
  mirrorVersion: `« Quiconque fait scission du Messager après que la guidance lui est apparue, et suit un autre chemin que celui des croyants, Nous le laisserons sur ce chemin. » Le miroir me montre le danger de la division. « Nuwallih » — nous le laisserons. La division du Messager mène à l'abandon. Le miroir m'interroge : est-ce que je suis le chemin du Messager ou un autre chemin ?`,
  reflection: `La division du Messager mène à l'égarement. Le chemin des croyants est le chemin du Messager.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yushaqiqi al-rasula min ba'di ma tabayyana lahu al-huda wa yattabi' ghayra sabili al-mu'minina nuwallih ma tawalla » — quiconque fait scission du Messager après que la guidance lui est apparue, et suit un autre chemin que celui des croyants, nous le laisserons sur ce chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le chemin du Messager ou un autre chemin ? Mon chemin est-il celui des croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division est l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité est la force du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Messager est sur le chemin droit." }
  ],
  munajat: `Ya Hadi, je veux suivre le chemin du Messager. Ne permets pas que je fasse scission. Donne-moi l'unité avec les croyants.`
};

MIROIR["4:116"] = {
  reference: "4:116",
  theme: ["pardon", "association", "limite"],
  emotion: "Clarté, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Wahid"],
  mirrorVersion: `« Allah ne pardonne pas qu'on Lui associe, mais Il pardonne ce qui est moins grave à qui Il veut. » Le miroir me montre la limite du pardon. « La yaghfiru an yushraka bih » — Il ne pardonne pas qu'on Lui associe. L'association est impardonnable. Le miroir m'interroge : est-ce que je préserve mon cœur de l'association ?`,
  reflection: `L'association est le seul péché impardonnable. Tout autre péché peut être pardonné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha la yaghfiru an yushraka bih wa yaghfiru ma duna dhalika li-man yasha' » — Allah ne pardonne pas qu'on Lui associe, mais Il pardonne ce qui est moins grave à qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve mon cœur de l'association ? Mon unicité est-elle pure ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'association est le danger suprême." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est le fondement de la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve son cœur de l'association est sauvé." }
  ],
  munajat: `Ya Wahid, je préserve mon cœur de l'association. Ne permets pas que je Lui associe quoi que ce soit. Donne-moi l'unicité pure.`
};

MIROIR["4:117"] = {
  reference: "4:117",
  theme: ["idolâtrie", "déviation", "invocation"],
  emotion: "Mise en garde, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Haqq"],
  mirrorVersion: `« Ils n'invoquent en dehors de Lui que des idoles. » Le miroir me montre la futilité de l'idolâtrie. « Illa inathan » — que des idoles. L'invocation des idoles est vaine. Le miroir m'interroge : est-ce que j'invoque autre qu'Allah ?`,
  reflection: `L'invocation des idoles est vaine. Seul Allah répond à l'invocation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yad'una min dunihi illa inathan » — ils n'invoquent en dehors de Lui que des idoles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque autre qu'Allah ? Mon invocation est-elle pure ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation des idoles est l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah mérite l'invocation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul est exaucé." }
  ],
  munajat: `Ya Wahid, j'invoque Toi seul. Ne permets pas que j'invoque autre que Toi. Exauce mon invocation pure.`
};

MIROIR["4:118"] = {
  reference: "4:118",
  theme: ["satan", "malédiction", "égarement"],
  emotion: "Mise en garde, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Shaytan"],
  mirrorVersion: `« Allah l'a maudit, et il a dit : Je prendrai une part déterminée de Tes serviteurs. » Le miroir me montre le plan de Satan. « La-attakhidhan min 'ibadika nasiban » — je prendrai une part de Tes serviteurs. Satan veut nous égarer. Le miroir m'interroge : est-ce que je me laisse égarer par Satan ?`,
  reflection: `Satan est maudit et veut égarer une part des serviteurs d'Allah. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La'anahu Allahu wa qala la-attakhidhan min 'ibadika nasiban » — Allah l'a maudit, et il a dit : Je prendrai une part déterminée de Tes serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse égarer par Satan ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résistance à Satan est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Satan est l'ennemi déclaré de l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui résiste à Satan est protégé par Allah." }
  ],
  munajat: `Ya Hadi, protège-moi de Satan. Ne permets pas que je sois de sa part. Donne-moi la résistance contre l'ennemi.`
};

MIROIR["4:119"] = {
  reference: "4:119",
  theme: ["satan", "innovation", "égarement"],
  emotion: "Vigilance, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fitrah", "Al-Shaytan"],
  mirrorVersion: `« J'ordonnerai l'innovation à la création d'Allah. » Le miroir me montre la tactique de Satan. « La-amurannahum fa-layubayyinun » — j'ordonnerai l'innovation. Satan dénature la création d'Allah. Le miroir m'interroge : est-ce que je préserve la création d'Allah ?`,
  reflection: `Satan veut dénature la création d'Allah. La préservation de la fitrah est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-amurannahum fa-layubayyinunna khalqa Allah » — j'ordonnerai l'innovation à la création d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la création d'Allah ? Ou est-ce que je la dénature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préservation de la fitrah est la droiture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création d'Allah est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la fitrah est droit." }
  ],
  munajat: `Ya Fitrah, préserve ma création originelle. Ne permets pas que Satan la dénature. Donne-moi la droiture de la fitrah.`
};

MIROIR["4:120"] = {
  reference: "4:120",
  theme: ["satan", "promesse", "illusion"],
  emotion: "Lucidité, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Shaytan"],
  mirrorVersion: `« Il leur fait des promesses et leur donne de faux espoirs. » Le miroir me montre les mensonges de Satan. « Wa yu'miduhum » — et leur donne de faux espoirs. Les promesses de Satan sont illusoires. Le miroir m'interroge : est-ce que je crois aux promesses de ce monde ?`,
  reflection: `Les promesses de Satan sont illusoires. La seule vraie promesse est celle d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'iduhum wa yu'miduhum » — il leur fait des promesses et leur donne de faux espoirs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux promesses de ce monde ? Ou est-ce que je crois aux promesses d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les promesses d'Allah sont véridiques." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'illusion est le piège de ce monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux promesses d'Allah n'est pas trompé." }
  ],
  munajat: `Ya Wakil, je crois à Tes promesses. Ne permets pas que je sois trompé par les illusions. Donne-moi la certitude de Tes promesses.`
};

MIROIR["4:121"] = {
  reference: "4:121",
  theme: ["satan", "destination", "enfer"],
  emotion: "Mise en garde, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Jahannam", "Al-Adhab"],
  mirrorVersion: `« Ceux-là ont l'Enfer pour refuge. » Le miroir me montre la destination des suivants de Satan. « Ula'ika mawlahum jahannam » — ceux-là ont l'Enfer pour refuge. Suivre Satan mène à l'Enfer. Le miroir m'interroge : est-ce que je réalise la destination ?`,
  reflection: `Suivre Satan mène à l'Enfer. La destination est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika mawlahum jahannam » — ceux-là ont l'Enfer pour refuge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la destination de suivre Satan ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destination révèle le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est la conséquence de suivre Satan." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse Satan a le Paradis pour refuge." }
  ],
  munajat: `Ya Rabb, je refuse de suivre Satan. Ne permets pas que j'aille vers l'Enfer. Donne-moi le Paradis pour refuge.`
};

MIROIR["4:122"] = {
  reference: "4:122",
  theme: ["foi", "promesse", "paradis"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Sidq"],
  mirrorVersion: `« Quant à ceux qui croient et font de bonnes œuvres, Nous les ferons entrer aux Jardins sous lesquels coulent les rivières. » Le miroir me montre la promesse d'Allah. « Mudkhalin » — Nous les ferons entrer. La foi et les bonnes œuvres mènent au Paradis. Le miroir m'interroge : est-ce que j'œuvre pour cette promesse ?`,
  reflection: `La foi et les bonnes œuvres mènent au Paradis. La promesse d'Allah est véridique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu wa 'amilu al-salihati sanudkhiluhum jannatin tajri min tahtiha al-anhar » — quant à ceux qui croient et font de bonnes œuvres, Nous les ferons entrer aux Jardins sous lesquels coulent les rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour cette promesse ? Ma foi et mes œuvres sont-elles sincères ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah est certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et œuvre bien obtient le Paradis." }
  ],
  munajat: `Ya Jannah, je veux entrer dans Tes Jardins. Ne permets pas que je sois privé de Ta promesse. Donne-moi la foi et les œuvres sincères.`
};

MIROIR["4:123"] = {
  reference: "4:123",
  theme: ["désir", "réalité", "justice"],
  emotion: "Clarté, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Haqq"],
  mirrorVersion: `« Ce n'est ni vos désirs ni les désirs des Gens du Livre. Quiconque fait le mal en sera rétribué. » Le miroir me montre la justice absolue. « La bi-ahwa'ikum » — ce n'est pas vos désirs. Les désirs ne changent pas la réalité. Le miroir m'interroge : est-ce que je vis selon mes désirs ou selon la réalité ?`,
  reflection: `Les désirs ne changent pas la réalité. La justice d'Allah est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laysa bi-ahwa'ikum wa la ahwa'i ahli al-kitabi man ya'mal su'an yujza bih » — ce n'est ni vos désirs ni les désirs des Gens du Livre. Quiconque fait le mal en sera rétribué." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis selon mes désirs ou selon la réalité ? Mes désirs influencent-ils ma compréhension ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice d'Allah ne connaît pas de favoritisme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice est la loi universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la justice est en paix." }
  ],
  munajat: `Ya 'Adl, j'accepte Ta justice absolue. Ne permets pas que mes désirs m'aveuglent. Donne-moi la clarté de la réalité.`
};

MIROIR["4:124"] = {
  reference: "4:124",
  theme: ["œuvre", "récompense", "égalité"],
  emotion: "Espoir, justice",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Mizan"],
  mirrorVersion: `« Quiconque fait une bonne œuvre, homme ou femme, en étant croyant, entrera au Paradis. » Le miroir me montre l'égalité de la récompense. « Dhalika » — cela. La récompense est pour tous sans distinction. Le miroir m'interroge : est-ce que j'œuvre sans attendre de privilèges ?`,
  reflection: `La récompense est pour tous sans distinction de genre. La justice d'Allah est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man ya'mal min al-salihati min dhakarin aw untha wa huwa mu'min fa-ula'ika yadkhuluna al-jannata » — quiconque fait une bonne œuvre, homme ou femme, en étant croyant, entrera au Paradis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre sans attendre de privilèges ? Ma motivation est-elle pure ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égalité devant Allah est la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les œuvres sont mesurées par l'intention." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre sincèrement obtient la récompense." }
  ],
  munajat: `Ya 'Adl, j'œuvre sincèrement sans attendre de privilèges. Ne permets pas que ma motivation soit impure. Donne-moi la récompense égale.`
};

MIROIR["4:125"] = {
  reference: "4:125",
  theme: ["religion", "soumission", "hanif"],
  emotion: "Clarté, direction",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Islam"],
  mirrorVersion: `« Qui est meilleur en religion que celui qui soumet son être à Allah en étant bienfaisant ? » Le miroir me montre l'excellence religieuse. « Ahsana » — bienfaisant. La soumission et la bienfaisance sont l'excellence. Le miroir m'interroge : est-ce que je soumets mon être à Allah ?`,
  reflection: `La soumission à Allah avec bienfaisance est l'excellence religieuse. C'est la religion d'Ibrahim.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man ahsanu dînan mimman aslama wajhahu lillahi wa huwa muhsinun wa ittaba'a millata Ibrahim hanifa » — qui est meilleur en religion que celui qui soumet son être à Allah en étant bienfaisant et suit la religion d'Ibrahim le Hanif ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je soumets mon être à Allah ? Ma religion est-elle celle d'Ibrahim ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission totale est l'excellence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion d'Ibrahim est la religion de tous les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Ibrahim suit le chemin droit." }
  ],
  munajat: `Ya Hanif, je soumets mon être à Toi. Ne permets pas que je dévie de la religion d'Ibrahim. Donne-moi l'excellence de la soumission.`
};

MIROIR["4:126"] = {
  reference: "4:126",
  theme: ["tout", "science", "puissance"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kull", "Al-Muhit"],
  mirrorVersion: `« À Allah appartient tout ce qui est dans les cieux et sur la terre. Et Allah enveloppe tout. » Le miroir me montre la totalité divine. « Wa kana Allahu bi-kulli shay'in muhita » — Allah enveloppe tout. Rien n'échappe à Allah. Le miroir m'interroge : est-ce que je réalise que tout appartient à Allah ?`,
  reflection: `Tout appartient à Allah. Sa connaissance et Sa puissance enveloppent tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lillahi ma fi al-samawati wa ma fi al-ard wa kana Allahu bi-kulli shay'in muhita » — à Allah appartient tout ce qui est dans les cieux et sur la terre. Et Allah enveloppe tout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que tout appartient à Allah ? Mon regard embrasse-t-il cette totalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appartenance à Allah est la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est entre les mains d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise cette totalité s'abandonne." }
  ],
  munajat: `Ya Muhit, je réalise que tout T'appartient. Ne permets pas que je sois aveuglé par l'apparence. Donne-moi la vision de la totalité.`
};

MIROIR["4:127"] = {
  reference: "4:127",
  theme: ["femmes", "justice", "orphelines"],
  emotion: "Justice, compassion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Ra'uf"],
  mirrorVersion: `« Ils te demandent une fatwa au sujet des femmes. Dis : Allah vous donne une fatwa à leur sujet. » Le miroir me montre la justice envers les femmes. « Yuftikum » — Allah vous donne une fatwa. Les droits des femmes sont sacrés. Le miroir m'interroge : est-ce que je respecte les droits des femmes ?`,
  reflection: `Les droits des femmes sont sacrés. La justice envers elles est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yastaftunaka fi al-nisa'i qul Allahu yuftikum fihinna » — ils te demandent une fatwa au sujet des femmes. Dis : Allah vous donne une fatwa à leur sujet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les droits des femmes ? Ou est-ce que je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice envers les femmes est la justice d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les femmes sont les égales des hommes en droits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les femmes respecte la création d'Allah." }
  ],
  munajat: `Ya 'Adl, je respecte les droits des femmes. Ne permets pas que je les néglige. Donne-moi la justice envers elles.`
};

MIROIR["4:128"] = {
  reference: "4:128",
  theme: ["mariage", "réconciliation", "compromis"],
  emotion: "Sagesse, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muslih", "Al-Hakim"],
  mirrorVersion: `« Si une femme craint de son mari un abandon ou un éloignement, nul reproche à eux de se réconcilier. » Le miroir me montre le compromis marital. « Sulh » — réconciliation. La réconciliation est meilleure que la séparation. Le miroir m'interroge : est-ce que je cherche la réconciliation ?`,
  reflection: `La réconciliation est meilleure que la séparation. Le compromis honnête est permis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in imra'atun khafat min ba'liha nushuzan aw i'radan fa-la junaha 'alayhima an yusliha baynahuma sulhan » — si une femme craint de son mari un abandon ou un éloignement, nul reproche à eux de se réconcilier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la réconciliation ? Ou est-ce que je préfère la séparation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réconciliation est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le compromis honnête sauve les foyers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réconcilie est sage." }
  ],
  munajat: `Ya Muslih, je cherche la réconciliation. Ne permets pas que je préfère la séparation. Donne-moi la sagesse du compromis.`
};

MIROIR["4:129"] = {
  reference: "4:129",
  theme: ["polygamie", "équité", "impossibilité"],
  emotion: "Réalisme, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Haqq"],
  mirrorVersion: `« Vous ne pourrez jamais être équitables entre vos femmes, même si vous y tenez. » Le miroir me montre l'impossibilité de l'équité parfaite. « Lan tastati'u » — vous ne pourrez jamais. L'équité parfaite est impossible. Le miroir m'interroge : est-ce que je suis réaliste sur mes capacités ?`,
  reflection: `L'équité parfaite entre les épouses est impossible. La reconnaissance de cette limite est une sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lan tastati'u an ta'dilu bayna al-nisa'i wa law harastum » — vous ne pourrez jamais être équitables entre vos femmes, même si vous y tenez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis réaliste sur mes capacités ? Ou est-ce que je m'illusionne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des limites est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équité parfaite appartient à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ses limites ne s'engage pas légèrement." }
  ],
  munajat: `Ya 'Adl, je reconnais mes limites. Ne permets pas que je m'illusionne sur mes capacités. Donne-moi le réalisme de la justice.`
};

MIROIR["4:130"] = {
  reference: "4:130",
  theme: ["séparation", "suffisance", "richesse"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Wasi'"],
  mirrorVersion: `« S'ils se séparent, Allah rendra chacun d'eux autonome par Sa grâce. » Le miroir me montre la suffisance divine. « Yughni Allahu kulla min fadlih » — Allah rendra chacun autonome. La séparation n'est pas la fin. Le miroir m'interroge : est-ce que je fais confiance à la suffisance d'Allah ?`,
  reflection: `La séparation n'est pas la fin. Allah suffit à chacun par Sa grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yatafarraqa yughni Allahu kullan min sa'atihi » — s'ils se séparent, Allah rendra chacun d'eux autonome par Sa grâce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la suffisance d'Allah ? Ou est-ce que je crains la perte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La suffisance d'Allah est la vraie richesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah suffit à chacun selon Ses besoins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sépare pour Allah trouve Sa suffisance." }
  ],
  munajat: `Ya Ghani, je fais confiance à Ta suffisance. Ne permets pas que je crains la perte. Donne-moi l'autonomie par Ta grâce.`
};

MIROIR["4:131"] = {
  reference: "4:131",
  theme: ["tout", "richesse", "piété"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Malik"],
  mirrorVersion: `« À Allah appartient tout ce qui est dans les cieux et sur la terre. » Le miroir me montre la totalité de la possession divine. « Wa lillahi ma fi al-samawati » — à Allah appartient tout. Nous ne possédons rien en réalité. Le miroir m'interroge : est-ce que je réalise que je ne possède rien ?`,
  reflection: `Nous ne possédons rien en réalité. Tout appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lillahi ma fi al-samawati wa ma fi al-ard » — à Allah appartient tout ce qui est dans les cieux et sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je ne possède rien ? Ou est-ce que je m'attache à mes biens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La non-possession est la liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est prêté par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise qu'il ne possède rien est libre." }
  ],
  munajat: `Ya Malik, je réalise que tout T'appartient. Ne permets pas que je m'attache à mes biens. Donne-moi la liberté du détachement.`
};

MIROIR["4:132"] = {
  reference: "4:132",
  theme: ["protection", "allié", "soutien"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Hafiz"],
  mirrorVersion: `« Et Allah suffit comme Protecteur et comme Soutien. » Le miroir me montre la suffisance de la protection divine. « Kafa billahi waliyan » — Allah suffit comme Protecteur. Nul protecteur n'est nécessaire en dehors d'Allah. Le miroir m'interroge : est-ce qu'Allah me suffit comme protecteur ?`,
  reflection: `Allah suffit comme Protecteur et Soutien. Nul protecteur n'est nécessaire en dehors de Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kafa billahi waliyan wa kafa billahi nasira » — et Allah suffit comme Protecteur et comme Soutien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'Allah me suffit comme protecteur ? Ou est-ce que je cherche d'autres protecteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est la seule protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah protège tout dans l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se protège par Allah est vraiment protégé." }
  ],
  munajat: `Ya Wali, Tu me suffis comme Protecteur. Ne permets pas que je cherche d'autres protecteurs. Donne-moi la sécurité de Ta protection.`
};

MIROIR["4:133"] = {
  reference: "4:133",
  theme: ["remplacement", "puissance", "création"],
  emotion: "Humilité, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Khaliq"],
  mirrorVersion: `« S'Il veut, Il vous fait disparaître et vous remplace par d'autres. » Le miroir me montre la fragilité de notre existence. « Yastabdil » — Il remplace. Notre existence n'est pas nécessaire. Le miroir m'interroge : est-ce que je réalise que je peux être remplacé ?`,
  reflection: `Notre existence n'est pas nécessaire. Allah peut nous remplacer par d'autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yasha' yudhhibkum ayyuha al-nasu wa ya'ti bi-akharina » — s'Il veut, Il vous fait disparaître et vous remplace par d'autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je peux être remplacé ? Ou est-ce que je crois indispensable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'indispensable n'existe pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création continue est le pouvoir d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise sa fragilité s'humilie." }
  ],
  munajat: `Ya Qadir, je réalise que je peux être remplacé. Ne permets pas que je croie indispensable. Donne-moi l'humilité de la fragilité.`
};

MIROIR["4:134"] = {
  reference: "4:134",
  theme: ["récompense", "vie", "ici-bas"],
  emotion: "Choix, orientation",
  difficulty: "débutant",
  relatedNames: ["Al-Ajir", "Al-Akhirah"],
  mirrorVersion: `« Quiconque désire la récompense de ce monde, la récompense d'Allah est meilleure. » Le miroir me montre le choix de la récompense. « Ajr al-akhira » — la récompense de l'au-delà. La récompense d'Allah est supérieure. Le miroir m'interroge : quelle récompense je désire ?`,
  reflection: `La récompense d'Allah est supérieure à celle de ce monde. Le choix révèle l'orientation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kana yurid thawaba al-dunya fa-'inda Allahi thawabu al-dunya wa al-akhirah » — quiconque désire la récompense de ce monde, la récompense d'Allah est meilleure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle récompense je désire ? Celle de ce monde ou celle d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense d'Allah est éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense de ce monde est éphémère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire la récompense d'Allah obtient les deux." }
  ],
  munajat: `Ya Ajir, je désire Ta récompense. Ne permets pas que je sois ébloui par ce monde. Donne-moi la récompense éternelle.`
};

MIROIR["4:135"] = {
  reference: "4:135",
  theme: ["justice", "témoignage", "vérité"],
  emotion: "Intégrité, courage",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shahid", "Al-Haqq"],
  mirrorVersion: `« Ô vous qui croyez ! Soyez fermes en la justice, témoins pour Allah. » Le miroir me montre le devoir de témoignage. « Shuhada'a lillah » — témoins pour Allah. Le témoignage de vérité est un devoir. Le miroir m'interroge : est-ce que je témoigne pour la vérité ?`,
  reflection: `Le témoignage de vérité est un devoir. La justice prime sur les relations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu kanu qawwamina bi-al-qisti shuhada'a lillah » — ô vous qui croyez ! Soyez fermes en la justice, témoins pour Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je témoigne pour la vérité ? Ou est-ce que je tais la vérité par peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage de vérité est la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité transcende les relations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui témoigne pour la vérité est avec Allah." }
  ],
  munajat: `Ya Shahid, je témoigne pour la vérité. Ne permets pas que je taise la vérité par peur. Donne-moi le courage de la justice.`
};

MIROIR["4:136"] = {
  reference: "4:136",
  theme: ["foi", "révélation", "livres"],
  emotion: "Foi, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Iman"],
  mirrorVersion: `« Ô vous qui croyez ! Croyez en Allah, en Son Messager, au Livre qu'Il a fait descendre et aux Livres qu'Il a fait descendre auparavant. » Le miroir me montre la foi complète. « Aminu » — croyez. La foi est un acte continu. Le miroir m'interroge : est-ce que ma foi est complète ?`,
  reflection: `La foi est un acte continu. Elle englobe Allah, le Messager et tous les Livres révélés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu aminu billahi wa rasulihi wa al-kitabi alladhi nazzala 'ala rasulihi wa al-kutubi allati anzala min qabl » — ô vous qui croyez ! Croyez en Allah, en Son Messager, au Livre qu'Il a fait descendre et aux Livres qu'Il a fait descendre auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est complète ? Ou est-ce que je refuse une partie de la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi complète est la foi sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les Livres viennent d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en tout a la foi complète." }
  ],
  munajat: `Ya Kitab, je crois en Toi, en Ton Messager et en tous Tes Livres. Ne permets pas que ma foi soit incomplète. Donne-moi la foi totale.`
};

MIROIR["4:137"] = {
  reference: "4:137",
  theme: ["foi", "mécréance", "fluctuation"],
  emotion: "Mise en garde, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Dalal"],
  mirrorVersion: `« Ceux qui ont cru, puis mécru, puis cru, puis mécru, puis ont augmenté leur mécréance. » Le miroir me montre l'instabilité spirituelle. « Zaduhum kufran » — ont augmenté leur mécréance. La fluctuation est un danger. Le miroir m'interroge : est-ce que ma foi est stable ?`,
  reflection: `La fluctuation entre foi et mécréance est un danger. La stabilité est la marque de la vraie foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu thumma kafaru thumma amanu thumma kafaru thumma izdadu kufran » — ceux qui ont cru, puis mécru, puis cru, puis mécru, puis ont augmenté leur mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est stable ? Ou est-ce qu'elle fluctue avec les circonstances ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stabilité de la foi est la force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi stable résiste aux épreuves." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont la foi est stable est vraiment croyant." }
  ],
  munajat: `Ya Hadi, stabilise ma foi. Ne permets pas qu'elle fluctue. Donne-moi la constance de la foi.`
};

MIROIR["4:138"] = {
  reference: "4:138",
  theme: ["hypocrisie", "annonce", "châtiment"],
  emotion: "Avertissement, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'id", "Al-Jahannam"],
  mirrorVersion: `« Annonce aux hypocrites qu'ils auront un châtiment douloureux. » Le miroir me montre l'annonce aux hypocrites. « Bashshir » — annonce. L'hypocrisie mène au châtiment. Le miroir m'interroge : est-ce que je m'examine pour l'hypocrisie ?`,
  reflection: `L'hypocrisie mène au châtiment douloureux. L'examen de conscience est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bashshiri al-munafiqina bi-anna lahum 'adhaban aliman » — annonce aux hypocrites qu'ils auront un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'examine pour l'hypocrisie ? Ou est-ce que je m'aveugle sur mon état ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'examen de conscience prévient l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'hypocrisie est le pire état du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'examine se préserve de l'hypocrisie." }
  ],
  munajat: `Ya Wa'id, je m'examine pour l'hypocrisie. Ne permets pas que je m'aveugle sur mon état. Préserve-moi du châtiment des hypocrites.`
};

MIROIR["4:139"] = {
  reference: "4:139",
  theme: ["alliés", "mécréants", "confiance"],
  emotion: "Mise en garde, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Nasr"],
  mirrorVersion: `« Ceux qui prennent les mécréants comme alliés en dehors des croyants. » Le miroir me montre l'erreur de l'alliance. « Awliya'a » — alliés. L'alliance avec les mécréants contre les croyants est interdite. Le miroir m'interroge : qui sont mes vrais alliés ?`,
  reflection: `L'alliance avec les mécréants contre les croyants est interdite. Les croyants sont les vrais alliés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yattakhidhuna al-kuffara awliya'a min duni al-mu'minina » — ceux qui prennent les mécréants comme alliés en dehors des croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes vrais alliés ? Les croyants ou les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance avec les croyants est la force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance révèle l'appartenance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'allie avec les croyants est avec Allah." }
  ],
  munajat: `Ya Wali, je m'allie avec les croyants. Ne permets pas que je cherche d'autres alliés. Donne-moi l'alliance de la foi.`
};

MIROIR["4:140"] = {
  reference: "4:140",
  theme: ["mécréance", "fréquentation", "protection"],
  emotion: "Prudence, dignité",
  difficulty: "débutant",
  relatedNames: ["Al-Hijrah", "Al-'Izzah"],
  mirrorVersion: `« Il vous a déjà révélé que quand vous entendez les versets d'Allah reniés et tournés en dérision, ne vous asseyez pas avec eux. » Le miroir me montre le devoir d'éloignement. « La taq'udu ma'ahum » — ne vous asseyez pas avec eux. La fréquentation des moqueurs est interdite. Le miroir m'interroge : est-ce que je fuis les moqueurs des versets ?`,
  reflection: `La fréquentation des moqueurs des versets d'Allah est interdite. L'éloignement est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad nazzala 'alaykum fi al-kitabi an idha sami'tum ayati Allahi yukfaru biha wa yustahza'u biha fala taq'udu ma'ahum » — il vous a déjà révélé que quand vous entendez les versets d'Allah reniés et tournés en dérision, ne vous asseyez pas avec eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis les moqueurs des versets ? Ou est-ce que je reste avec eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement des moqueurs est la dignité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les versets d'Allah méritent respect." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit les moqueurs préserve sa foi." }
  ],
  munajat: `Ya 'Izzah, je fuis les moqueurs de Tes versets. Ne permets pas que je reste avec eux. Donne-moi la dignité de l'éloignement.`
};

MIROIR["4:141"] = {
  reference: "4:141",
  theme: ["hypocrisie", "attente", "opportunisme"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Nasr"],
  mirrorVersion: `« Ils vous guettent. S'il y a une victoire pour vous de la part d'Allah, ils disent : N'étions-nous pas avec vous ? » Le miroir me montre l'opportunisme des hypocrites. « Yurqubunakum » — ils vous guettent. L'hypocrite attend l'issue pour choisir. Le miroir m'interroge : est-ce que je suis opportuniste ?`,
  reflection: `L'hypocrite attend l'issue pour choisir son camp. L'engagement sincère précède l'issue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yatarabbasuna bikum fa-in kana lakum fathun min Allahi qalu alam nakun ma'akum » — ils vous guettent. S'il y a une victoire pour vous de la part d'Allah, ils disent : N'étions-nous pas avec vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis opportuniste ? Ou est-ce que je m'engage avant l'issue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'engagement sincère précède le résultat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La victoire appartient à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'engage sincèrement obtient la victoire." }
  ],
  munajat: `Ya Khabir, je m'engage sincèrement. Ne permets pas que je sois opportuniste. Donne-moi l'engagement avant l'issue.`
};

MIROIR["4:142"] = {
  reference: "4:142",
  theme: ["hypocrisie", "prière", "ostentation"],
  emotion: "Mise en garde, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khushu'", "Al-Ikhlas"],
  mirrorVersion: `« Les hypocrites cherchent à tromper Allah, mais Allah les trompe. Quand ils se lèvent pour la prière, ils se lèvent avec paresse et par ostentation. » Le miroir me montre l'état de la prière hypocrite. « Yura'una » — par ostentation. La prière sans présence est vaine. Le miroir m'interroge : comment est ma prière ?`,
  reflection: `La prière avec paresse et ostentation est vaine. La présence du cœur est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-munafiqina yukhadi'una Allaha wa huwa khadi'uhum wa idha qamu ila al-salati qamu kusalan yura'una al-nasa » — les hypocrites cherchent à tromper Allah, mais Allah les trompe. Quand ils se lèvent pour la prière, ils se lèvent avec paresse et par ostentation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est ma prière ? Avec présence ou avec paresse ? Pour Allah ou pour les hommes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière sincère est le pilier de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière est le lien direct avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec présence est exaucé." }
  ],
  munajat: `Ya Khushu', je veux prier avec présence. Ne permets pas que je prie par paresse ou ostentation. Donne-moi la sincérité de la prière.`
};

MIROIR["4:143"] = {
  reference: "4:143",
  theme: ["hypocrisie", "hésitation", "indécision"],
  emotion: "Mise en garde, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Huda", "Al-Dalal"],
  mirrorVersion: `« Indécis, ils ne sont ni avec vous ni avec eux. » Le miroir me montre l'indécision hypocrite. « Muthabthabina » — indécis. L'hypocrite n'appartient à aucun camp. Le miroir m'interroge : où suis-je vraiment ?`,
  reflection: `L'hypocrite n'appartient à aucun camp. L'appartenance claire est la marque de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muthabthabina bayna dhalika la ila ha'ula'i wa la ila ha'ula'i » — indécis, ils ne sont ni avec vous ni avec eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je vraiment ? Avec les croyants ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appartenance claire est la force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a que deux camps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appartient clairement est avec Allah." }
  ],
  munajat: `Ya Huda, je veux appartenir clairement aux croyants. Ne permets pas que je sois indécis. Donne-moi la clarté de l'appartenance.`
};

MIROIR["4:144"] = {
