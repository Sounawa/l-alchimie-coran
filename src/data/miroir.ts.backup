    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les portes du Paradis s'ouvrent à celui qui frappe avec sincérité." }
  ],
  munajat: `Ya Rabb, les portes du Paradis sont ouvertes. Fais que je sois de ceux qui y entrent. Prépare mon chemin vers les jardins.`
};

MIROIR["38:51"] = {
