  theme: ["chameaux", "vaches", "interdits"],
  emotion: "Questionnement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ibil", "Al-Baqar"],
  mirrorVersion: `« Et des chameaux, deux ; et des vaches, deux. » Le miroir continue : « Wa mina al-ibili ithnayni wa mina al-baqari ithnayni » — et des chameaux, deux ; et des vaches, deux. L'énumération précise montre l'attention divine. Le miroir m'enseigne : chaque détail compte pour Allah.`,
  reflection: `Chaque détail compte pour Allah. Rien n'est oublié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-ibili ithnayni wa mina al-baqari ithnayni » — et des chameaux, deux ; et des vaches, deux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels détails de ma vie sont importants pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La précision divine inclut ma vie aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est comptée et nommée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attention aux détails mène à la gratitude." }
  ],
  munajat: `Ya Rabb, Tu comptes chaque détail. Fais que je sois attentif à ma vie. Ne permets pas la négligence.`
};

MIROIR["6:145"] = {
  reference: "6:145",
  theme: ["nourriture", "interdits", "pureté"],
  emotion: "Clarté, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Dis : Je ne trouve rien d'interdit dans ce qui m'a été révélé. » Le miroir clarifie : « Qul la ajidu fi ma uhiya ilayya muharraman » — dis : Je ne trouve rien d'interdit dans ce qui m'a été révélé. Les interdits sont limités et clairs. Le miroir m'enseigne : la religion n'est pas difficulté.`,
  reflection: `Les interdits sont limités. La religion est facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul la ajidu fi ma uhiya ilayya muharraman » — dis : Je ne trouve rien d'interdit dans ce qui m'a été révélé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ajoute des interdits à la religion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La limitation des interdits montre la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le halal est vaste, le haram est limité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La facilité de la religion est un cadeau." }
  ],
  munajat: `Ya Rabb, merci pour la facilité de la religion. Fais que je n'ajoute pas de difficultés. Ne permets pas l'excès.`
};

MIROIR["6:146"] = {
  reference: "6:146",
  theme: ["juifs", "interdits", "châtiment"],
  emotion: "Leçon, histoire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yahud", "Al-Hurum"],
  mirrorVersion: `« Et aux Juifs, Nous avons interdit toutes les bêtes à ongles. » Le miroir raconte : « Wa 'ala alladhina hadu harramna kulla dhi zufur » — et aux Juifs, Nous avons interdit toutes les bêtes à ongles. L'histoire enseigne par l'exemple. Le miroir m'enseigne : les lois peuvent varier selon les communautés.`,
  reflection: `Les lois peuvent varier. L'obéissance reste constante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ala alladhina hadu harramna kulla dhi zufur » — et aux Juifs, Nous avons interdit toutes les bêtes à ongles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que cette différence de lois m'enseigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La variation des lois montre l'adaptation divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu ce qu'elle pouvait porter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance à sa propre loi est ce qui compte." }
  ],
  munajat: `Ya Rabb, merci pour ma loi. Fais que je l'observe avec joie. Ne permets pas que je la rejette.`
};

MIROIR["6:147"] = {
  reference: "6:147",
  theme: ["mensonge", "désobéissance", "châtiment"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kadhib", "Al-'Adhab"],
  mirrorVersion: `« S'ils te traitent de menteur, dis : Votre Seigneur est d'une miséricorde immense. » Le miroir enseigne : « Fa-in kadhdhabuka fa-qul rabbukum dhu rahmatin wasi'ah » — s'ils te traitent de menteur, dis : Votre Seigneur est d'une miséricorde immense. Le rejet n'annule pas la miséricorde. Le miroir m'enseigne : la miséricorde précède le châtiment.`,
  reflection: `La miséricorde précède le châtiment. Le temps est donné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in kadhdhabuka fa-qul rabbukum dhu rahmatin wasi'ah » — s'ils te traitent de menteur, dis : Votre Seigneur est d'une miséricorde immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis au rejet ? Est-ce que j'annonce la miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'annonce de la miséricorde est un dernier appel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde est plus vaste que tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rappelle la miséricorde espère le retour." }
  ],
  munajat: `Ya Rabb, Ta miséricorde est immense. Fais que je l'annonce au monde. Ne permets pas que je désespère personne.`
};

MIROIR["6:148"] = {
  reference: "6:148",
  theme: ["destin", "excuse", "responsabilité"],
  emotion: "Responsabilité, vérité",
  difficulty: "avancé",
  relatedNames: ["Al-Qadar", "Al-Irada"],
  mirrorVersion: `« Ceux qui associent diront : Si Allah avait voulu, nous n'aurions pas associé. » Le miroir réfute : « Sa yaqulu alladhina ashraku law sha'a Allahu ma ashrakna » — ceux qui associent diront : Si Allah avait voulu, nous n'aurions pas associé. L'excuse du destin ne justifie pas le péché. Le miroir m'enseigne : le choix est réel.`,
  reflection: `Le choix est réel. Le destin n'est pas une excuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa yaqulu alladhina ashraku law sha'a Allahu ma ashrakna » — ceux qui associent diront : Si Allah avait voulu, nous n'aurions pas associé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise le destin comme excuse pour mes péchés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité personnelle reste entière malgré le destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le choix et le destin coexistent sans contradiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation de la responsabilité est le premier pas du repentir." }
  ],
  munajat: `Ya Rabb, je prends la responsabilité de mes actes. Ne permets pas que j'utilise le destin comme excuse. Pardonne-moi.`
};

MIROIR["6:149"] = {
