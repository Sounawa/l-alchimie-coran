  theme: ["richesse", "provision", "distribution"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Ghani"],
  mirrorVersion: `« Et que c'est Lui qui a enrichi et qui a fait avoir. » Le miroir me montre la distribution divine. « Wa annahu huwa aghna wa aqna » — et que c'est Lui qui a enrichi et fait avoir. La richesse vient d'Allah. Le miroir m'invite à la gratitude.`,
  reflection: `La richesse et la pauvreté sont des états divins. Celui qui donne peut reprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu huwa aghna wa aqna » — et que c'est Lui qui a enrichi et fait avoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois ma richesse ou ma pauvreté ? Est-ce que je reconnais la source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie richesse est celle du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision est distribuée selon la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la richesse la garde." }
  ],
  munajat: `Ya Razzaq, Tu enrichis qui Tu veux. Fais que je sois reconnaissant pour ce que j'ai. Ne permets pas que je sois ingrat ou envieux.`
};

MIROIR["53:49"] = {
  reference: "53:49",
  theme: ["étoile", "création", "seigneur"],
  emotion: "Émerveillement, révérence",
  difficulty: "débutant",
  relatedNames: ["Ash-Shi'ra", "Al-Khaliq"],
  mirrorVersion: `« Et que c'est Lui le Seigneur de Sirius. » Le miroir me montre la grandeur cosmique. « Wa annahu huwa rabbu al-shi'ra » — et que c'est Lui le Seigneur de Sirius. L'étoile la plus brillante a un Seigneur. Le miroir m'invite à contempler la grandeur du Créateur.`,
  reflection: `Sirius, l'étoile la plus brillante, est sous le contrôle d'Allah. Les étoiles ne sont pas divines mais créées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu huwa rabbu al-shi'ra » — et que c'est Lui le Seigneur de Sirius." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je contemple les étoiles, est-ce que je vois le Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étoiles ne sont pas à adorer mais à contempler comme signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes de la grandeur du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les étoiles contemple la main qui les guide." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur de Sirius et de toutes les étoiles. Fais que je contemple Ta grandeur dans l'univers. Ne permets pas que j'adore la création au lieu du Créateur.`
};

MIROIR["53:50"] = {
  reference: "53:50",
  theme: ["destruction", "'Ad", "peuple"],
  emotion: "Mise en garde, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Et que c'est Lui qui a fait périr les 'Ad anciens. » Le miroir me montre le châtiment historique. « Wa annahu ahlaka 'adan al-ula » — et que c'est Lui qui a fait périr les 'Ad anciens. Les peuples destructeurs sont détruits. Le miroir m'invite à tirer les leçons de l'histoire.`,
  reflection: `Les 'Ad étaient un peuple puissant mais arrogant. Allah les a détruits. L'histoire est une leçon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu ahlaka 'adan al-ula » — et que c'est Lui qui a fait périr les 'Ad anciens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends de l'histoire des peuples détruits ? Suis-je en sécurité dans mon arrogance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des peuples est un avertissement pour les vivants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de civilisations qui ont disparu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire les leçons de l'histoire évite de les répéter." }
  ],
  munajat: `Ya Qahhar, Tu as détruit les 'Ad. Fais que je tire les leçons de l'histoire. Ne permets pas que je sois arrogant comme eux.`
};

MIROIR["53:51"] = {
  reference: "53:51",
  theme: ["destruction", "Thamud", "peuple"],
  emotion: "Mise en garde, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Hakam"],
  mirrorVersion: `« Et les Thamud, Il n'a laissé personne. » Le miroir continue le récit des destructions. « Wa thamuda fa-ma abqa » — et les Thamud, Il n'a laissé personne. La destruction est totale pour les obstinés. Le miroir m'invite à la vigilance.`,
  reflection: `Les Thamud ont été entièrement détruits. Nul n'a échappé. La justice divine est complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa thamuda fa-ma abqa » — et les Thamud, Il n'a laissé personne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si la destruction vient, où je me réfugie ? Ai-je des garanties ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction totale est le sort de ceux qui refusent totalement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les civilisations disparaissent quand elles oublient leur Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie en Allah échappe à la destruction." }
  ],
  munajat: `Ya Hakam, Tu as détruit les Thamud. Donne-moi la sagesse de tirer les leçons. Ne permets pas que je sois parmi les obstinés.`
};

MIROIR["53:52"] = {
  reference: "53:52",
  theme: ["déluge", "Nuh", "peuple"],
  emotion: "Gratitude, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Nuh", "Al-Munji"],
  mirrorVersion: `« Et le peuple de Nuh auparavant. Ils étaient plus injustes et plus rebelles. » Le miroir continue avec le déluge. « Wa qawma Nuhin min qabl innahum kanu hum adhlama wa atgha » — et le peuple de Nuh auparavant. Ils étaient les pires. Le miroir m'invite à la vigilance contre l'injustice.`,
  reflection: `Le peuple de Nuh était le plus injuste. Le déluge a été leur châtiment. L'injustice attire la destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qawma Nuhin min qabl innahum kanu hum adhlama wa atgha » — et le peuple de Nuh auparavant. Ils étaient plus injustes et plus rebelles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon injustice est-elle comparable ? Suis-je rebelle comme eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pire peuple a reçu le pire châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau peut être vie ou mort selon le comportement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'injustice évite le sort des injustes." }
  ],
  munajat: `Ya Munji, Tu as sauvé Nuh et détruit son peuple. Sauve-moi de l'injustice. Ne permets pas que je sois parmi les rebelles.`
};

MIROIR["53:53"] = {
  reference: "53:53",
  theme: ["destruction", "retournement", "villes"],
  emotion: "Mise en garde, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muqlib", "Al-Qahhar"],
  mirrorVersion: `« Et la ville renversée, Il l'a renversée. » Le miroir me montre le retournement. « Wa al-mu'tafikata akhsaha » — et la ville renversée, Il l'a renversée. Sodome et Gomorrhe ont été retournées. Le miroir m'invite à la vigilance contre la débauche.`,
  reflection: `Les villes de Loth ont été physiquement retournées. La débauche attire la destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-mu'tafikata akhsaha » — et la ville renversée, Il l'a renversée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui pourrait renverser ma vie ? Quels péchés attirent la destruction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retournement physique reflète le retournement moral." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les villes détruites sont des signes pour ceux qui passent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la débauche évite le retournement." }
  ],
  munajat: `Ya Muqlib, Tu as renversé les villes débauchées. Préserve-moi de la débauche. Ne permets pas que ma vie soit renversée par le péché.`
};

MIROIR["53:54"] = {
  reference: "53:54",
  theme: ["destruction", "couverture", "voile"],
  emotion: "Mise en garde, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sattar", "Al-Mughith"],
  mirrorVersion: `« Alors le châtiment les a couverts. » Le miroir montre la couverture du châtiment. « Fa ghashiyaha ma ghashiya » — alors le châtiment les a couverts. La destruction est complète. Le miroir m'invite à la vigilance.`,
  reflection: `Le châtiment a couvert les villes de tous les côtés. Nulle échappatoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ghashiyaha ma ghashiya » — alors le châtiment les a couverts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si le châtiment me couvrait, où irais-je ? Ai-je un refuge ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La couverture du châtiment est totale pour ceux qui refusent totalement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment divin enveloppe complètement les pécheurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge en Allah n'est pas couvert par le châtiment." }
  ],
  munajat: `Ya Sattar, Tu couvres les péchés de ceux qui se repentent. Couvre-moi de Ta miséricorde. Ne permets pas que je sois couvert par le châtiment.`
};

MIROIR["53:55"] = {
  reference: "53:55",
  theme: ["faveur", "question", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Karim"],
  mirrorVersion: `« De quelle faveur de ton Seigneur doutes-tu ? » Le miroir m'interroge sur mes doutes. « Fabi-ayyi ala'i rabbika tatamara » — de quelle faveur de ton Seigneur doutes-tu ? Les faveurs sont innombrables. Le miroir m'invite à la gratitude.`,
  reflection: `Les faveurs d'Allah sont évidentes. Douter de Son bienfait est une ingratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabi-ayyi ala'i rabbika tatamara » — de quelle faveur de ton Seigneur doutes-tu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles faveurs je prends pour acquises ? Qu'est-ce que je ne remarque même plus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute sur les faveurs vient de l'aveuglement, pas de l'absence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque souffle est une faveur. Chaque battement de cœur est un don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte les faveurs ne peut pas douter." }
  ],
  munajat: `Ya Mannan, Tes faveurs sont innombrables. Ouvre mes yeux aux bénédictions. Ne permets pas que je doute de Ton bienfait.`
};

MIROIR["53:56"] = {
  reference: "53:56",
  theme: ["avertissement", "prophète", "sérieux"],
  emotion: "Sérieux, attention",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Bashir"],
  mirrorVersion: `« C'est un avertisseur parmi les avertisseurs. » Le miroir me montre la fonction du Prophète. « Hadha nadhirun mina al-nudhuri » — c'est un avertisseur parmi les avertisseurs. Le Prophète est un avertisseur. Le miroir m'invite à écouter l'avertissement.`,
  reflection: `Le Prophète est un avertisseur. Son message est sérieux. L'écouter est vital.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadha nadhirun mina al-nudhuri » — c'est un avertisseur parmi les avertisseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute l'avertissement ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde pour celui qui écoute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement précède le châtiment. L'ignorer est périlleux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement évite le danger." }
  ],
  munajat: `Ya Nadhir, Tu avertis par Tes prophètes. Fais que j'écoute l'avertissement. Ne permets pas que je l'ignore.`
};

MIROIR["53:57"] = {
  reference: "53:57",
  theme: ["inévitable", "proximité", "jour"],
  emotion: "Urgence, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Azifah", "Al-Qari'ah"],
  mirrorVersion: `« L'inévitable approche. » Le miroir me montre la proximité du Jour. « Azifati al-azifah » — l'inévitable approche. Le Jour du Jugement est proche. Le miroir m'invite à la préparation urgente.`,
  reflection: `Le Jour du Jugement approche. Chaque instant nous en rapproche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Azifati al-azifah » — l'inévitable approche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de la proximité du Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité du Jour doit accélérer la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps s'écoule vers ce Jour inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la proximité du Jour est toujours prêt." }
  ],
  munajat: `Ya Rabb, le Jour approche. Prépare-moi pour ce moment. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["53:58"] = {
  reference: "53:58",
  theme: ["uniquement", "Allah", "révélation"],
  emotion: "Sérieux, concentration",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Il n'y a pas d'autre divinité qu'Allah pour le dévoiler. » Le miroir montre l'exclusivité divine. « Ghayri Allahi min kashifatin » — il n'y a pas d'autre divinité qu'Allah pour le dévoiler. Le Jour du Jugement est exclusivement divin. Le miroir m'invite à faire confiance à Allah seul.`,
  reflection: `Le Jour du Jugement est sous le contrôle exclusif d'Allah. Nul ne peut L'aider ou L'empêcher.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ghayri Allahi min kashifatin » — il n'y a pas d'autre divinité qu'Allah pour le dévoiler." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je fais confiance pour le Jour du Jugement ? À Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité divine au Jour signifie l'exclusivité de la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour du Jugement est le moment de la manifestation de l'Unicité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah seul est protégé ce Jour-là." }
  ],
  munajat: `Ya Ahad, Tu es seul au Jour du Jugement. Fais que je Te fasse confiance exclusivement. Ne permets pas que je cherche d'autres protecteurs.`
};

MIROIR["53:59"] = {
  reference: "53:59",
  theme: ["étonnement", "message", "question"],
  emotion: "Sérieux, interrogation",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Bayyinah"],
  mirrorVersion: `« Êtes-vous étonnés de ce discours ? » Le miroir m'interroge sur ma réaction. « Afamin hadha al-hadithi ta'jabun » — êtes-vous étonnés de ce discours ? L'étonnement face au Coran est révélateur. Le miroir m'invite à examiner ma réaction à la révélation.`,
  reflection: `L'étonnement face au Coran peut être signe d'incrédulité ou d'émerveillement. Lequel est le mien ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afamin hadha al-hadithi ta'jabun » — êtes-vous étonnés de ce discours ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma réaction au Coran ? Étonnement d'incrédulité ou d'émerveillement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est étonnant pour ceux qui ne connaissent pas la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est toujours étonnante pour l'ignorant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le Coran n'est plus étonné mais émerveillé." }
  ],
  munajat: `Ya Rabb, le Coran est Ton discours. Fais que je sois émerveillé, pas incrédule. Ouvre-moi à sa compréhension.`
};

MIROIR["53:60"] = {
  reference: "53:60",
  theme: ["rire", "larmes", "sérieux"],
  emotion: "Sérieux, rectification",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Basir"],
  mirrorVersion: `« Et vous en riez et n'en pleurez pas ? » Le miroir me montre la mauvaise réaction. « Wa tadkuna wa la tabkuna » — et vous en riez et n'en pleurez pas ? Le rire face au sérieux est inapproprié. Le miroir m'invite à la réaction juste.`,
  reflection: `Rire face au Coran au lieu de pleurer montre l'insouciance. La réaction appropriée est la crainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tadkuna wa la tabkuna » — et vous en riez et n'en pleurez pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux avertissements du Coran ? Par le rire ou les larmes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les larmes de crainte lavent les péchés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sérieux de la vie appelle des larmes, pas des rires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pleure maintenant de crainte rira plus tard de joie." }
  ],
  munajat: `Ya Rabb, fais que je pleure de crainte devant Tes avertissements. Ne permets pas que je rie de l'insouciance.`
};

MIROIR["53:61"] = {
  reference: "53:61",
  theme: ["distraction", "insouciance", "sérieux"],
  emotion: "Réveil, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Munadi", "Al-Hadi"],
  mirrorVersion: `« Et vous êtes distraits ! » Le miroir me montre l'état de distraction. « Wa antum samidun » — et vous êtes distraits ! La distraction est l'état des insouciants. Le miroir m'invite à me réveiller.`,
  reflection: `La distraction empend la prise au sérieux de la vie et de la mort. Se réveiller est urgent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa antum samidun » — et vous êtes distraits !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je distrait de l'essentiel ? Qu'est-ce qui me distrait de la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distraction est le sommeil de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est sérieux. Seul l'homme peut être distrait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réveille de la distraction voit la vérité." }
  ],
  munajat: `Ya Munadi, appelle-moi à me réveiller. Ne permets pas que je reste distrait. Réveille mon cœur à la vérité.`
};

MIROIR["53:62"] = {
  reference: "53:62",
  theme: ["prosternation", "adoration", "soumission"],
  emotion: "Soumission, adoration",
  difficulty: "débutant",
  relatedNames: ["As-Sajjad", "Al-Kabir"],
  mirrorVersion: `« Prosternez-vous devant Allah et adorez-Le ! » Le miroir m'invite à l'action. « Fa usjudu lillahi wa u'bud » — prosternez-vous devant Allah et adorez-Le ! La prosternation est la réponse. Le miroir m'invite à me prosterner maintenant.`,
  reflection: `La réponse au Coran est la prosternation et l'adoration. L'action suit la compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa usjudu lillahi wa u'bud » — prosternez-vous devant Allah et adorez-Le !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prosterne devant Allah ? Est-ce que je L'adore vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation est l'attitude juste face à la grandeur divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers se prosterne devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne maintenant sera élevé plus tard." }
  ],
  munajat: `Ya Kabir, Tu es le Grand. Je me prosterne devant Toi. Fais que mon adoration soit sincère et constante.`
};

// === SURAH 54 - AL-QAMAR (The Moon) - 55 verses ===
// Existing: 54:1, 54:17, 54:49
// Adding: 54:2-16, 54:18-48, 54:50-55

MIROIR["54:2"] = {
  reference: "54:2",
  theme: ["miracle", "incrédulité", "excuse"],
  emotion: "Tristesse, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'jiz", "Al-Hadi"],
  mirrorVersion: `« S'ils voient un signe, ils se détournent et disent : C'est une magie continue ! » Le miroir me montre l'incrédulité obstinée. « Wa in yaraw ayatan yu'ridu wa yaqulu sihrun mustamirr » — s'ils voient un signe, ils se détournent et disent : C'est une magie continue ! Le miracle est rejeté. Le miroir m'invite à examiner ma propre réception des signes.`,
  reflection: `Même les miracles ne convainquent pas celui qui ne veut pas croire. Le cœur fermé reste fermé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yaraw ayatan yu'ridu wa yaqulu sihrun mustamirr » — s'ils voient un signe, ils se détournent et disent : C'est une magie continue !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes je rejette ? Quelles évidences j'explique par des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveuglement est un choix, pas une fatalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes pour ceux qui veulent voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut voir verra. Celui qui ne veut pas reste aveugle." }
  ],
  munajat: `Ya Mu'jiz, Tu montres des signes. Ouvre mes yeux pour les voir. Ne permets pas que je me détourne ou que j'invente des excuses.`
};

MIROIR["54:3"] = {
  reference: "54:3",
  theme: ["mensonge", "désir", "suivi"],
  emotion: "Mise en garde, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Ils ont crié au mensonge et ont suivi leurs propres désirs. » Le miroir me montre le lien entre le mensonge et le désir. « Wa kadhdhabu wa ittaba'u ahwa'ahum » — ils ont crié au mensonge et ont suivi leurs propres désirs. Le désir mène au rejet de la vérité. Le miroir m'invite à examiner mes motivations.`,
  reflection: `Suivre ses désirs aveuglément mène au rejet de la vérité. Le désir non maîtrisé est un guide trompeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhdhabu wa ittaba'u ahwa'ahum » — ils ont crié au mensonge et ont suivi leurs propres désirs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel rôle mes désirs jouent-ils dans mes croyances ? Est-ce que je rejette ce qui contredit mes envies ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La maîtrise du désir ouvre les yeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le désir est un serviteur, pas un maître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise ses désirs voit la vérité." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je ne suive pas mes désirs au détriment de la vérité. Maîtrise mes passions par Ta lumière.`
};

MIROIR["54:4"] = {
  reference: "54:4",
  theme: ["histoire", "leçon", "avertissement"],
  emotion: "Sérieux, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Et pourtant, il leur est parvenu une histoire propre à les contenir. » Le miroir me montre la valeur de l'histoire. « Wa qad ja'ahum mina al-anba'i ma fihi muztadjar » — et pourtant, il leur est parvenu une histoire propre à les contenir. L'histoire est une leçon. Le miroir m'invite à apprendre du passé.`,
  reflection: `Les histoires des peuples passés sont des leçons pour les vivants. L'histoire est un enseignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad ja'ahum mina al-anba'i ma fihi muztadjar » — et pourtant, il leur est parvenu une histoire propre à les contenir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends de l'histoire ? Est-ce que je tire les leçons du passé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un miroir pour le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les civilisations passées sont des signes sur la route." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît l'histoire ne la répète pas." }
  ],
  munajat: `Ya Hakim, Tu nous donnes l'histoire comme leçon. Fais que j'en tire les enseignements. Ne permets pas que j'ignore le passé.`
};

MIROIR["54:5"] = {
  reference: "54:5",
  theme: ["sagesse", "avertissement", "rejet"],
  emotion: "Tristesse, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "An-Nadhir"],
  mirrorVersion: `« Une sagesse parfaite. Mais les avertissements ne servent à rien. » Le miroir me montre le rejet de la sagesse. « Hikmatun balighatun fa ma tughni al-nudhur » — une sagesse parfaite. Mais les avertissements ne servent à rien. La sagesse est rejetée par les cœurs fermés. Le miroir m'invite à accueillir la sagesse.`,
  reflection: `Même une sagesse parfaite ne pénètre pas un cœur fermé. L'avertissement est inutile pour qui refuse d'entendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hikmatun balighatun fa ma tughni al-nudhur » — une sagesse parfaite. Mais les avertissements ne servent à rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accueille la sagesse ? Ou est-ce que je suis sourd aux avertissements ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture du cœur transforme l'avertissement en guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sagesse est offerte à tous, mais peu la reçoivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille la sagesse reçoit la lumière." }
  ],
  munajat: `Ya Hakim, Ta sagesse est parfaite. Ouvre mon cœur pour l'accueillir. Ne permets pas que je sois sourd aux avertissements.`
};

MIROIR["54:6"] = {
  reference: "54:6",
  theme: ["jour", "appel", "honte"],
  emotion: "Crainte, honte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Da'i", "Al-Munadi"],
  mirrorVersion: `« Détourne-toi d'eux. Le jour où l'appelateur les appellera vers une chose terrible. » Le miroir me montre le Jour de l'Appel. « Tawalla 'anhum yawma yad'u al-da'i ila shay'in nukur » — détourne-toi d'eux. Le jour où l'appelateur les appellera vers une chose terrible. L'Appel du Jour est terrifiant. Le miroir m'invite à me préparer.`,
  reflection: `L'appel du Jour du Jugement sera terrible pour les négateurs. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tawalla 'anhum yawma yad'u al-da'i ila shay'in nukur » — détourne-toi d'eux. Le jour où l'appelateur les appellera vers une chose terrible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me prépare pour cet appel ? Suis-je prêt à répondre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel terrible pour les uns est l'accueil pour les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'appel viendra pour tous. La réponse différencie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare maintenant n'a pas peur de l'appel." }
  ],
  munajat: `Ya Da'i, Tu appelleras au Jour du Jugement. Prépare-moi pour cet appel. Ne permets pas que je sois parmi ceux qui le craignent.`
};

MIROIR["54:7"] = {
  reference: "54:7",
  theme: ["résurrection", "sortie", "humiliation"],
  emotion: "Humiliation, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ba'ith", "Al-Khafid"],
  mirrorVersion: `« Ils sortiront des tombes, les yeux baissés, comme des sauterelles dispersées. » Le miroir me montre la sortie des tombes. « Khush'an absaruhum yahrujuna mina al-ajdathi ka-annahum jaradun muntashir » — ils sortiront des tombes, les yeux baissés, comme des sauterelles. La résurrection est humiliante pour les pécheurs. Le miroir m'invite à la préparation.`,
  reflection: `La résurrection sera humiliante pour ceux qui ont vécu dans l'insouciance. Les yeux baissés de honte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khush'an absaruhum yahrujuna mina al-ajdathi ka-annahum jaradun muntashir » — ils sortiront des tombes, les yeux baissés, comme des sauterelles dispersées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je sortirai de ma tombe ? Les yeux levés ou baissés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation de la résurrection vient de l'orgueil de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous sortiront des tombes. L'état diffère selon la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit humblement se lève dignement." }
  ],
  munajat: `Ya Ba'ith, Tu me ressusciteras. Fais que je me lève avec dignité. Ne permets pas que je sois parmi les humiliés.`
};

MIROIR["54:8"] = {
  reference: "54:8",
  theme: ["hâte", "jour", "appel"],
  emotion: "Urgence, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jami'", "Al-Da'i"],
  mirrorVersion: `« Courant, le cou tendu, vers l'appelateur. » Le miroir me montre la hâte vers le jugement. « Muhdina ila al-da'i » — courant, le cou tendu, vers l'appelateur. La hâte est forcée par l'appel. Le miroir m'invite à me préparer.`,
  reflection: `La hâte vers l'appel montre l'urgence et l'inévitable. Nulle fuite possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muhdina ila al-da'i » — courant, le cou tendu, vers l'appelateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quoi je cours ? Suis-je prêt pour l'appel final ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La hâte forcée révèle l'inévitable du jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour vient, nul ne peut le retarder." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas peur de la hâte." }
  ],
  munajat: `Ya Jami', Tu rassembleras tous. Fais que je sois prêt pour le rassemblement. Ne permets pas que je sois parmi les effrayés.`
};

MIROIR["54:9"] = {
  reference: "54:9",
  theme: ["Nuh", "négation", "moquerie"],
  emotion: "Tristesse, leçon",
  difficulty: "débutant",
  relatedNames: ["Nuh", "Al-Sabur"],
  mirrorVersion: `« Avant eux, le peuple de Nuh avait crié au mensonge. » Le miroir me montre l'exemple de Nuh. « Kadhdhabat qablahum qawmu Nuhin » — avant eux, le peuple de Nuh avait crié au mensonge. La négation est ancienne. Le miroir m'invite à ne pas suivre leur exemple.`,
  reflection: `Le peuple de Nuh a nié le prophète. Leur négation a mené à leur destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat qablahum qawmu Nuhin » — avant eux, le peuple de Nuh avait crié au mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nie comme le peuple de Nuh ? Ou est-ce que je crois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation des prophètes est le chemin de la perdition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des peuples est un cycle de prophètes et de négations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux prophètes suit le chemin du salut." }
  ],
  munajat: `Ya Rabb, le peuple de Nuh a nié. Fais que je croie. Ne permets pas que je sois parmi les négateurs.`
};

MIROIR["54:10"] = {
  reference: "54:10",
  theme: ["invocation", "détresse", "réponse"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Fattah"],
  mirrorVersion: `« Il invoqua donc son Seigneur : Je suis vaincu, secours-moi ! » Le miroir me montre l'invocation de Nuh. « Fa da'a rabbahu anni maghlubun fa intasir » — il invoqua son Seigneur : Je suis vaincu, secours-moi ! L'invocation dans la détresse est exaucée. Le miroir m'invite à invoquer.`,
  reflection: `Nuh a invoqué Allah dans sa détresse. La réponse divine est venue. L'invocation est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa da'a rabbahu anni maghlubun fa intasir » — il invoqua son Seigneur : Je suis vaincu, secours-moi !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans ma détresse, est-ce que j'invoque Allah ? Est-ce que je Lui demande secours ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la défaite est le début de la victoire divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature dans la détresse invoque son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque dans la détresse reçoit le secours." }
  ],
  munajat: `Ya Mujib, Tu réponds à l'invocation. Quand je suis vaincu, viens à mon secours. Ne m'abandonne pas dans la détresse.`
};

MIROIR["54:11"] = {
  reference: "54:11",
  theme: ["réponse", "portes", "ciel"],
  emotion: "Gratitude, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Mughith"],
  mirrorVersion: `« Nous ouvrîmes alors les portes du ciel. » Le miroir me montre la réponse divine. « Fa fatahna abwaba al-sama'i » — Nous ouvrîmes alors les portes du ciel. La réponse divine ouvre les portes. Le miroir m'invite à attendre l'ouverture.`,
  reflection: `Quand Allah répond, Il ouvre les portes. L'ouverture suit l'invocation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa fatahna abwaba al-sama'i » — Nous ouvrîmes alors les portes du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles portes je veux voir ouvertes ? Est-ce que j'invoque pour l'ouverture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture du ciel vient de l'ouverture du cœur dans l'invocation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les portes du ciel s'ouvrent pour les invocations sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque sincèrement voit les portes s'ouvrir." }
  ],
  munajat: `Ya Fattah, Tu ouvres les portes. Ouvre-moi les portes de Ta miséricorde. Ne permets pas qu'elles restent fermées.`
};

MIROIR["54:12"] = {
  reference: "54:12",
  theme: ["eau", "déluge", "source"],
  emotion: "Émerveillement, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhit", "Al-Qadir"],
  mirrorVersion: `« D'une eau jaillissante. » Le miroir me montre la source du déluge. « Bi-ma'in munhamir » — d'une eau jaillissante. L'eau qui sauve peut aussi détruire. Le miroir m'invite à respecter la puissance divine.`,
  reflection: `L'eau est source de vie mais aussi de destruction selon le contexte. La maîtrise divine est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-ma'in munhamir » — d'une eau jaillissante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois les éléments de la création ? Avec respect ou exploitation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le même élément peut sauver ou détruire selon la volonté divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est la source de la vie et peut être l'instrument du châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la création respecte le Créateur." }
  ],
  munajat: `Ya Muhit, l'eau obéit à Ton commandement. Fais que je respecte Ta création. Utilise l'eau pour ma purification, pas pour ma destruction.`
};

MIROIR["54:13"] = {
  reference: "54:13",
  theme: ["arche", "salut", "protection"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Munji"],
  mirrorVersion: `« Et Nous le portâmes sur un vaisseau fait de planches et de clous. » Le miroir me montre le moyen du salut. « Wa hamalnahu 'ala dhati alwahin wa dusur » — et Nous le portâmes sur un vaisseau fait de planches et de clous. L'arche était simple mais efficace. Le miroir m'invite à faire confiance aux moyens divins.`,
  reflection: `L'arche de Nuh était simple mais elle a sauvé. Les moyens divins peuvent être simples.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hamalnahu 'ala dhati alwahin wa dusur » — et Nous le portâmes sur un vaisseau fait de planches et de clous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels moyens simples Allah utilise-t-Il pour me sauver ? Est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La simplicité du moyen révèle la grandeur du Sauveur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les moyens de salut sont souvent plus simples que prévu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance aux moyens divins est sauvé." }
  ],
  munajat: `Ya Munji, Tu sauves par Tes moyens. Fais que je reconnaisse Ton salut. Ne permets pas que je cherche des moyens compliqués quand Tu offres le simple.`
};

MIROIR["54:14"] = {
  reference: "54:14",
  theme: ["surveillance", "protection", "gratitude"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Raqib", "Al-Hafiz"],
  mirrorVersion: `« Voguant sous Nos yeux, en récompense pour celui qu'on avait renié. » Le miroir me montre la surveillance divine. « Tajri bi-a'yunina jaza'an liman kana kufira » — voguant sous Nos yeux, en récompense. Allah surveille et protège. Le miroir m'invite à la confiance en Sa surveillance.`,
  reflection: `L'arche voguait sous les yeux d'Allah. La surveillance divine est une protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tajri bi-a'yunina jaza'an liman kana kufira » — voguant sous Nos yeux, en récompense pour celui qu'on avait renié." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis sous le regard d'Allah ? Est-ce que Sa surveillance me rassure ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La surveillance divine est protection pour le croyant, témoignage contre le mécréant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'échappe au regard divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit sous le regard d'Allah vit en sécurité." }
  ],
  munajat: `Ya Raqib, Tu me surveilles. Fais que Ta surveillance soit ma protection. Ne permets pas que j'oublie Ton regard.`
};

MIROIR["54:15"] = {
  reference: "54:15",
  theme: ["signe", "leçon", "mémoire"],
  emotion: "Réflexion, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhakkir", "Al-Hakim"],
  mirrorVersion: `« Et Nous en avons fait un signe. Y a-t-il quelqu'un pour se rappeler ? » Le miroir m'invite au rappel. « Wa laqad taraknaha ayatan fa-hal min muddakir » — et Nous en avons fait un signe. Y a-t-il quelqu'un pour se rappeler ? Le signe est là, le rappel est possible. Le miroir m'invite à me rappeler.`,
  reflection: `L'arche de Nuh est devenue un signe. Les signes sont là pour ceux qui se rappellent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad taraknaha ayatan fa-hal min muddakir » — et Nous en avons fait un signe. Y a-t-il quelqu'un pour se rappeler ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes j'ignore ? Qu'est-ce que je dois me rappeler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe est inutile sans le rappel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes qui attendent le rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle voit les signes partout." }
  ],
  munajat: `Ya Mudhakkir, Tu laisses des signes. Fais que je me rappelle. Ne permets pas que j'ignore les signes de Ta puissance.`
};

MIROIR["54:16"] = {
  reference: "54:16",
  theme: ["châtiment", "leçon", "question"],
  emotion: "Sérieux, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-Hakam"],
  mirrorVersion: `« Et quel fut Mon châtiment ! Et quel avertissement ! » Le miroir m'interroge sur la sévérité. « Fa kayfa kana 'adhabi wa nudhur » — et quel fut Mon châtiment ! Et quel avertissement ! L'intensité du châtiment et de l'avertissement. Le miroir m'invite à la crainte respectueuse.`,
  reflection: `Le châtiment divin est sévère. L'avertissement est clair. La question est : ai-je compris ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa kayfa kana 'adhabi wa nudhur » — et quel fut Mon châtiment ! Et quel avertissement !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la sévérité du châtiment ? Est-ce que je prends l'avertissement au sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sévérité du châtiment est proportionnelle à la clarté de l'avertissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite en récompense comme en châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'avertissement évite le châtiment." }
  ],
  munajat: `Ya Hakam, Ton châtiment est sévère et Ton avertissement est clair. Fais que je prenne l'avertissement au sérieux. Ne permets pas que j'expérimente le châtiment.`
};

MIROIR["54:18"] = {
  reference: "54:18",
  theme: ["'Ad", "négation", "destruction"],
  emotion: "Sérieux, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Mubin"],
  mirrorVersion: `« Les 'Ad ont crié au mensonge. » Le miroir continue avec les 'Ad. « Kadhdhabat 'Adun » — les 'Ad ont crié au mensonge. Un autre peuple, une même négation. Le miroir m'invite à ne pas suivre leur exemple.`,
  reflection: `Les 'Ad étaient un peuple puissant mais ils ont nié. Leur puissance ne les a pas sauvés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat 'adun » — les 'Ad ont crié au mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je nie malgré les signes ? Ma puissance m'aveugle-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans foi mène à la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les civilisations puissantes ont disparu quand elles ont nié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ses limites reconnaît le Créateur." }
  ],
  munajat: `Ya Qahhar, les 'Ad ont nié et ont été détruits. Fais que je croie. Ne permets pas que ma puissance m'aveugle.`
};

MIROIR["54:19"] = {
  reference: "54:19",
  theme: ["vent", "destruction", "jours"],
  emotion: "Crainte, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Musaytir", "Al-Qadir"],
  mirrorVersion: `« Nous lâchâmes sur eux un vent mugissant en un jour de grand malheur. » Le miroir me montre l'instrument de la destruction. « Inna arsalna 'alayhim rihan sarsaran fi yawmi nahsin mustamir » — Nous lâchâmes sur eux un vent mugissant. Le vent obéit à Allah. Le miroir m'invite à la crainte respectueuse.`,
  reflection: `Le vent, instrument de vie, devient instrument de mort par le commandement divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna arsalna 'alayhim rihan sarsaran fi yawmi nahsin mustamir » — Nous lâchâmes sur eux un vent mugissant en un jour de grand malheur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois les éléments naturels ? Comme des forces autonomes ou soumises à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vent qui détruit les mécréants peut bénir les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les éléments sont des serviteurs d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les éléments respecte leur Maître." }
  ],
  munajat: `Ya Musaytir, les éléments T'obéissent. Fais que je Te respecte comme les éléments Te respectent. Ne permets pas que je sois détruit par ce qui T'obéit.`
};

MIROIR["54:20"] = {
  reference: "54:20",
  theme: ["vent", "arrachement", "force"],
  emotion: "Crainte, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "Al-Jabbar"],
  mirrorVersion: `« Arrachant les gens comme des souches de palmiers déracinées. » Le miroir me montre la puissance du vent. « Tanzi'u al-nasa ka-annahum a'jamun min nakhlin mu'taqal » — arrachant les gens comme des souches de palmiers. La force divine est irrésistible. Le miroir m'invite à l'humilité.`,
  reflection: `La force du vent divin arrache les hommes comme des plantes. Rien ne résiste à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzi'u al-nasa ka-annahum a'jamun min nakhlin mu'taqal » — arrachant les gens comme des souches de palmiers déracinées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui peut m'arracher de ma sécurité ? Ma confiance est-elle en Allah ou en mes racines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'arrachement des mécréants révèle la fragilité de leurs racines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les racines les plus profondes ne résistent pas au commandement divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'enracine en Allah ne peut être arraché." }
  ],
  munajat: `Ya Qawiyy, Ta force est irrésistible. Enracine-moi en Toi. Ne permets pas que je sois arraché par le vent du châtiment.`
};

MIROIR["54:21"] = {
  reference: "54:21",
  theme: ["châtiment", "avertissement", "leçon"],
  emotion: "Sérieux, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "An-Nadhir"],
  mirrorVersion: `« Et quel fut Mon châtiment ! Et quel avertissement ! » Le miroir répète la question. « Fa kayfa kana 'adhabi wa nudhur » — et quel fut Mon châtiment ! La répétition souligne l'importance. Le miroir m'invite à réfléchir profondément.`,
  reflection: `La répétition de la question demande une réponse sincère. Ai-je compris ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa kayfa kana 'adhabi wa nudhur » — et quel fut Mon châtiment ! Et quel avertissement !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La question se répète. Ai-je répondu ? Ai-je vraiment compris ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition est une insistance pour ceux qui n'écoutent pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les leçons de l'histoire se répètent pour ceux qui ne les apprennent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à la question ne la verra plus se répéter." }
  ],
  munajat: `Ya Rabb, Tu insistes avec la question. Fais que je comprenne. Ne permets pas que l'insistance soit pour moi un signe de mon endurcissement.`
};

MIROIR["54:22"] = {
  reference: "54:22",
  theme: ["coran", "facilité", "mémorisation"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Muyassir", "Al-Hadi"],
  mirrorVersion: `« En vérité, Nous avons rendu le Coran facile pour le rappel. » Le miroir me montre la facilité du Coran. « Wa laqad yassarna al-qur'ana lil-dhikr » — en vérité, Nous avons rendu le Coran facile pour le rappel. Le Coran est accessible. Le miroir m'invite à profiter de cette facilité.`,
  reflection: `Le Coran a été rendu facile pour le rappel. L'accessibilité est un don divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad yassarna al-qur'ana lil-dhikr » — en vérité, Nous avons rendu le Coran facile pour le rappel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je profite de la facilité du Coran ? Est-ce que je le mémorise et le rappelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du Coran est pour ceux qui veulent se rappeler." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le livre le plus mémorisé au monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui profite de la facilité reçoit le don." }
  ],
  munajat: `Ya Muyassir, Tu as facilité le Coran. Fais que j'en profite pour le mémoriser et le rappeler. Ne permets pas que je néglige ce don.`
};

MIROIR["54:23"] = {
  reference: "54:23",
  theme: ["Thamud", "négation", "avertissement"],
  emotion: "Sérieux, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Mubin", "An-Nadhir"],
  mirrorVersion: `« Les Thamud ont crié au mensonge aux avertissements. » Le miroir continue avec les Thamud. « Kadhdhabat thamudu bil-nudhur » — les Thamud ont crié au mensonge aux avertissements. Un autre peuple, une même négation. Le miroir m'invite à ne pas suivre leur exemple.`,
  reflection: `Les Thamud ont nié les avertissements. Leur négation a mené à leur destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat thamudu bil-nudhur » — les Thamud ont crié au mensonge aux avertissements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux avertissements ? Est-ce que je les nie comme les Thamud ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation des avertissements est le prélude à la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les avertissements précèdent toujours le châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute les avertissements les évite." }
  ],
  munajat: `Ya Nadhir, Tu avertis avant le châtiment. Fais que j'écoute les avertissements. Ne permets pas que je les nie comme les Thamud.`
};

MIROIR["54:24"] = {
  reference: "54:24",
  theme: ["orgueil", "prophète", "suivi"],
  emotion: "Humilité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Allons-nous suivre un seul d'entre nous ? » Le miroir me montre l'orgueil du refus. « A-nattabi'u bashiran minna » — allons-nous suivre un seul d'entre nous ? L'orgueil empêche le suivi du prophète. Le miroir m'invite à l'humilité.`,
  reflection: `L'orgueil de suivre quelqu'un de parmi eux les a aveuglés. L'humilité ouvre à la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-nattabi'u bashiran minna » — allons-nous suivre un seul d'entre nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je refuse de suivre par orgueil ? Le prophète ou le sage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil du refus devient l'humiliation du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne dépend pas du statut de celui qui la porte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit par humilité est guidé." }
  ],
  munajat: `Ya Hadi, la guidance peut venir par n'importe qui. Fais que je sois humble pour la recevoir. Ne permets pas que l'orgueil m'empêche de suivre.`
};

MIROIR["54:25"] = {
  reference: "54:25",
  theme: ["envie", "élection", "reconnaissance"],
  emotion: "Humilité, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Musta'an", "Al-Wali"],
  mirrorVersion: `« Le message lui a-t-il été donné à l'exclusion de nous ? » Le miroir me montre l'envie. « Ulqiya al-dhikru 'alayhi min baynina » — le message lui a-t-il été donné à l'exclusion de nous ? L'envie du choix divin. Le miroir m'invite à accepter le choix d'Allah.`,
  reflection: `L'envie du message donné à un autre est un rejet de la sagesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ulqiya al-dhikru 'alayhi min baynina » — le message lui a-t-il été donné à l'exclusion de nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'envie ce qu'Allah a donné à d'autres ? Est-ce que j'accepte Sa distribution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'envie du don d'autrui est le rejet du don pour soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah distribue Ses dons selon Sa sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le choix divin reçoit ce qui lui est destiné." }
  ],
  munajat: `Ya Wali, Tu distribues comme Tu veux. Fais que j'accepte Ta distribution. Ne permets pas que l'envie m'aveugle.`
};

MIROIR["54:26"] = {
  reference: "54:26",
  theme: ["vérité", "demain", "découverte"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« Demain ils sauront qui est le menteur, l'arrogant. » Le miroir me montre la vérité différée. « Ghadan ya'lamuna man al-kadhdhabu al-asir » — demain ils sauront qui est le menteur. La vérité sera révélée. Le miroir m'invite à la patience.`,
  reflection: `La vérité sera révélée demain. Les menteurs seront exposés. La patience est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ghadan ya'lamuna man al-kadhdhabu al-asir » — demain ils sauront qui est le menteur, l'arrogant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je patient pour la vérité ? Est-ce que je laisse le temps révéler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps est allié de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours avec le temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est patient avec la vérité la voit triompher." }
  ],
  munajat: `Ya Haqq, la vérité sera révélée. Fais que je sois patient. Ne permets pas que je sois parmi les menteurs exposés.`
};

MIROIR["54:27"] = {
  reference: "54:27",
  theme: ["épreuve", "chamelle", "signe"],
  emotion: "Test, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mubtil", "Al-Fattah"],
  mirrorVersion: `« Nous enverrons la chamelle comme épreuve. » Le miroir me montre l'épreuve divine. « Inna mursilu al-naqati fitnatan » — Nous enverrons la chamelle comme épreuve. L'épreuve vient sous des formes inattendues. Le miroir m'invite à la vigilance dans les épreuves.`,
  reflection: `La chamelle de Salih était une épreuve. Les épreuves divines sont des tests de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna mursilu al-naqati fitnatan » — Nous enverrons la chamelle comme épreuve." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles épreuves dans ma vie sont des tests divins ? Comment j'y réagis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est une opportunité de prouver sa foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque épreuve est une chance de croissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe l'épreuve reçoit la récompense." }
  ],
  munajat: `Ya Mubtil, Tu éprouves qui Tu veux. Fais que je passe les épreuves avec foi. Ne permets pas que j'échoue dans le test.`
};

MIROIR["54:28"] = {
  reference: "54:28",
  theme: ["partage", "eau", "justice"],
  emotion: "Justice, discipline",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Qasim"],
  mirrorVersion: `« Informe-les que l'eau sera partagée entre eux. » Le miroir me montre le partage juste. « Wa nabbi'hum anna al-ma'a qismatun baynahum » — informe-les que l'eau sera partagée. La justice divine organise le partage. Le miroir m'invite à respecter les parts.`,
  reflection: `Le partage de l'eau était un test de justice. Chacun avait son tour. L'injustice attire le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nabbi'hum anna al-ma'a qismatun baynahum » — informe-les que l'eau sera partagée entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les parts des autres ? Suis-je juste dans le partage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice dans le partage est une injustice envers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice dans le partage maintient l'harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le partage respecte le Partageur." }
  ],
  munajat: `Ya 'Adl, Tu partages avec justice. Fais que je respecte les parts. Ne permets pas que je sois injuste dans le partage.`
};

MIROIR["54:29"] = {
  reference: "54:29",
  theme: ["complot", "compagnon", "crime"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Ash-Shahid"],
  mirrorVersion: `« Ils appelèrent leur compagnon qui se chargea de tuer. » Le miroir me montre le complot criminel. « Fa nadaw sahibahum fa tatara'a » — ils appelèrent leur compagnon qui se chargea de tuer. Le complot mène au crime. Le miroir m'invite à me méfier des complots.`,
  reflection: `Le complot pour tuer la chamelle était prémédité. Le crime collectif a des conséquences collectives.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa nadaw sahibahum fa tatara'a » — ils appelèrent leur compagnon qui se chargea de tuer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe à des complots ? Est-ce que je suis le compagnon du mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le compagnon du mal devient le maudit du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal collectif appelle le châtiment collectif." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse le complot refuse le châtiment." }
  ],
  munajat: `Ya Khabir, Tu connais les complots. Préserve-moi d'y participer. Ne permets pas que je sois le compagnon du mal.`
};

MIROIR["54:30"] = {
  reference: "54:30",
  theme: ["châtiment", "sévérité", "réflexion"],
  emotion: "Crainte, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Shadid", "Al-Muntaqim"],
  mirrorVersion: `« Et quel fut Mon châtiment ! Et quel avertissement ! » Le miroir répète la question. « Fa kayfa kana 'adhabi wa nudhur » — et quel fut Mon châtiment ! La répétition persiste. Le miroir m'invite à une réflexion profonde.`,
  reflection: `La question se répète pour chaque peuple. Ai-je compris ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa kayfa kana 'adhabi wa nudhur » — et quel fut Mon châtiment ! Et quel avertissement !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La question revient pour chaque peuple. Quelle est ma réponse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition signifie l'importance de la compréhension." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des peuples est une répétition de leçons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend une fois n'a pas besoin de répétition." }
  ],
  munajat: `Ya Shadid, Ton châtiment est sévère. Fais que je comprenne la leçon. Ne permets pas que l'insistance signifie mon endurcissement.`
};

MIROIR["54:31"] = {
  reference: "54:31",
  theme: ["cri", "destruction", "totalité"],
  emotion: "Crainte, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Mumit"],
  mirrorVersion: `« Nous lançâmes sur eux un seul cri et ils furent comme les branchages d'un enclos. » Le miroir me montre la destruction instantanée. « Inna arsalna 'alayhim sayhatan wahidatan fa kanu kahashimi al-muhtazir » — Nous lançâmes sur eux un seul cri. La destruction est instantanée et totale. Le miroir m'invite à la crainte.`,
  reflection: `Un seul cri suffit pour détruire un peuple entier. La puissance divine est instantanée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna arsalna 'alayhim sayhatan wahidatan fa kanu kahashimi al-muhtazir » — Nous lançâmes sur eux un seul cri et ils furent comme les branchages d'un enclos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Un cri peut me détruire. Suis-je prêt à affronter ce moment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité de la destruction montre la fragilité de l'existence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit instantanément au commandement divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit à Allah ne craint pas le cri." }
  ],
  munajat: `Ya Qahhar, un cri suffit pour détruire. Fais que je T'obéisse pour ne pas craindre. Ne permets pas que je sois parmi les détruits par un cri.`
};

MIROIR["54:32"] = {
  reference: "54:32",
  theme: ["coran", "facilité", "mémorisation"],
  emotion: "Gratitude, facilité",
  difficulty: "débutant",
  relatedNames: ["Al-Muyassir", "Al-Hadi"],
  mirrorVersion: `« En vérité, Nous avons rendu le Coran facile pour le rappel. » Le miroir répète la facilité. « Wa laqad yassarna al-qur'ana lil-dhikr » — en vérité, Nous avons rendu le Coran facile. La répétition souligne le don. Le miroir m'invite à profiter de cette facilité.`,
  reflection: `Le Coran est facile à mémoriser et à rappeler. La facilité est un don pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad yassarna al-qur'ana lil-dhikr » — en vérité, Nous avons rendu le Coran facile pour le rappel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je profite de cette facilité ? Combien ai-je mémorisé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du Coran est une invitation, pas une obligation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Des millions ont mémorisé le Coran grâce à sa facilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mémorise le Coran porte la parole divine." }
  ],
  munajat: `Ya Muyassir, Tu as facilité le Coran. Fais que je le mémorise. Ne permets pas que je néglige ce don immense.`
};

MIROIR["54:33"] = {
  reference: "54:33",
  theme: ["Lot", "négation", "peuple"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Lut", "An-Nadhir"],
  mirrorVersion: `« Le peuple de Lot a crié au mensonge aux avertissements. » Le miroir continue avec le peuple de Lot. « Kadhdhaba qawmu Lutun bil-nudhur » — le peuple de Lot a crié au mensonge. Un autre peuple, une même négation. Le miroir m'invite à ne pas suivre leur exemple.`,
  reflection: `Le peuple de Lot a nié les avertissements. Leur turpitude a mené à leur destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhaba qawmu Lutun bil-nudhur » — le peuple de Lot a crié au mensonge aux avertissements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels avertissements je nie ? Quelles turpitudes je tolère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation des avertissements précède la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de Lot est un avertissement pour tous les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute les avertissements les évite." }
  ],
  munajat: `Ya Nadhir, le peuple de Lot a nié. Fais que j'écoute les avertissements. Ne permets pas que je tolère la turpitude.`
};

MIROIR["54:34"] = {
  reference: "54:34",
  theme: ["pierres", "destruction", "pluie"],
  emotion: "Crainte, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Qahhar"],
  mirrorVersion: `« Nous lâchâmes sur eux une pluie de pierres. » Le miroir me montre la pluie destructrice. « Inna arsalna 'alayhim hasiban » — Nous lâchâmes sur eux une pluie de pierres. La pluie devient châtiment. Le miroir m'invite à la crainte respectueuse.`,
  reflection: `La pluie de pierres a détruit les villes de Lot. Les éléments obéissent à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna arsalna 'alayhim hasiban » — Nous lâchâmes sur eux une pluie de pierres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois les éléments ? Comme chance ou comme instruments divins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La même pluie qui bénit peut maudire selon le contexte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les éléments sont au service du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte Allah respecte Ses instruments." }
  ],
  munajat: `Ya Mumit, Tu détruis par Tes instruments. Préserve-moi de la destruction. Fais que les éléments soient pour moi bénédiction, pas malédiction.`
};

MIROIR["54:35"] = {
  reference: "54:35",
  theme: ["grâce", "récompense", "reconnaissance"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Ash-Shakur"],
  mirrorVersion: `« Une grâce de Notre part. » Le miroir me montre la grâce divine. « Min mat'arin min 'indina » — une grâce de Notre part. Le salut est une grâce. Le miroir m'invite à la reconnaissance.`,
  reflection: `Le salut de Lot et de sa famille était une grâce divine. La reconnaissance est due.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min mat'arin min 'indina » — une grâce de Notre part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles grâces j'ai reçues ? Est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce non reconnue peut être retirée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque salut est une grâce divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce la conserve." }
  ],
  munajat: `Ya Mannan, Tes grâces sont innombrables. Fais que je les reconnaisse. Ne permets pas que l'ingratitude me prive de Tes faveurs.`
};

MIROIR["54:36"] = {
  reference: "54:36",
  theme: ["avertissement", "dispute", "rejet"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nadhir", "Al-Hakim"],
  mirrorVersion: `« Il les avait pourtant avertis de Notre violence. Mais ils disputèrent les avertissements. » Le miroir me montre le rejet par la dispute. « Wa laqad andharahum batshatana fa tamarau bil-nudhur » — il les avait avertis, mais ils disputèrent. La dispute des avertissements mène à la destruction. Le miroir m'invite à ne pas disputer.`,
  reflection: `Disputer les avertissements au lieu de les accepter est un signe d'endurcissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad andharahum batshatana fa tamarau bil-nudhur » — il les avait avertis de Notre violence, mais ils disputèrent les avertissements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je disputer les avertissements ? Ou est-ce que je les accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute de l'avertissement est une dispute contre soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est une miséricorde pour celui qui l'accepte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'avertissement sans disputer est sauvé." }
  ],
  munajat: `Ya Nadhir, Tu avertis par miséricorde. Fais que j'accepte les avertissements sans disputer. Ne permets pas que je sois parmi les disputeurs.`
};

MIROIR["54:37"] = {
  reference: "54:37",
  theme: ["hôte", "protection", "aveuglement"],
  emotion: "Protection, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Ils voulurent séduire ses hôtes. Nous les aveuglâmes. » Le miroir me montre la protection divine des hôtes. « Wa inna lahu ila buyutihim musawwilun » — ils voulurent séduire ses hôtes. Nous les aveuglâmes. La protection des anges était assurée. Le miroir m'invite à faire confiance à la protection divine.`,
  reflection: `Les hôtes de Lot étaient des anges. Allah les a protégés en aveuglant les agresseurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna lahu ila buyutihim musawwilun » — ils voulurent séduire ses hôtes. Nous les aveuglâmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis attaqué, est-ce que je fais confiance à la protection divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveuglement des agresseurs est la protection des innocents." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah protège Ses serviteurs de manière invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la protection divine est protégé." }
  ],
  munajat: `Ya Hafiz, Tu protèges Tes serviteurs. Protège-moi de mes ennemis. Aveugle ceux qui veulent me nuire.`
};

MIROIR["54:38"] = {
  reference: "54:38",
  theme: ["matin", "châtiment", "imprévu"],
  emotion: "Crainte, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basit", "Al-Muntaqim"],
  mirrorVersion: `« Et le matin, un châtiment continu les atteignit. » Le miroir me montre le timing du châtiment. « Wa sabahan musbihi sayhatun » — et le matin, un châtiment les atteignit. Le châtiment vient à l'improviste. Le miroir m'invite à la vigilance.`,
  reflection: `Le châtiment est venu le matin, quand personne ne s'y attendait. L'imprévu est terrifiant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sabahan musbihi sayhatun » — et le matin, un châtiment continu les atteignit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le châtiment peut venir à tout moment. Suis-je prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le matin est un temps de bénédiction qui peut devenir temps de châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps appartient à Allah. Il en dispose comme Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt à tout moment ne craint pas l'imprévu." }
  ],
  munajat: `Ya Basit, le châtiment vient quand on ne s'y attend pas. Fais que je sois toujours prêt. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["54:39"] = {
  reference: "54:39",
  theme: ["châtiment", "sévérité", "réflexion"],
  emotion: "Crainte, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Shadid", "Al-Hakam"],
  mirrorVersion: `« Goûtez donc Mon châtiment et Mes avertissements ! » Le miroir me montre l'invitation à goûter. « Fa dhuqu 'adhabi wa nudhuri » — goûtez donc Mon châtiment ! L'invitation ironique à l'expérience. Le miroir m'invite à éviter ce goût.`,
  reflection: `Goûter le châtiment est la conséquence d'avoir ignoré les avertissements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa dhuqu 'adhabi wa nudhuri » — goûtez donc Mon châtiment et Mes avertissements !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel goût je veux expérimenter ? Celui de la miséricorde ou du châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le goût du châtiment est amer pour l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a son goût, maintenant ou plus tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte la miséricorde maintenant évite le châtiment plus tard." }
  ],
  munajat: `Ya Shadid, Ton châtiment a un goût amer. Fais que je goûte Ta miséricorde. Ne permets pas que je goûte Ton châtiment.`
};

MIROIR["54:40"] = {
  reference: "54:40",
  theme: ["coran", "facilité", "question"],
  emotion: "Invitation, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Muyassir", "Al-Hadi"],
  mirrorVersion: `« En vérité, Nous avons rendu le Coran facile pour le rappel. Y a-t-il quelqu'un pour se rappeler ? » Le miroir termine la série par une question. « Wa laqad yassarna al-qur'ana lil-dhikr fa-hal min muddakir » — Nous avons rendu le Coran facile. Y a-t-il quelqu'un pour se rappeler ? La question est ouverte. Le miroir m'invite à répondre.`,
  reflection: `La facilité du Coran est offerte. La question est : qui en profitera ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad yassarna al-qur'ana lil-dhikr fa-hal min muddakir » — Nous avons rendu le Coran facile pour le rappel. Y a-t-il quelqu'un pour se rappeler ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La question m'est posée. Est-ce que je suis parmi ceux qui se rappellent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité est don, le rappel est choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran attend ceux qui veulent se rappeler." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'invitation reçoit le don." }
  ],
  munajat: `Ya Muyassir, Tu invites au rappel. Je veux être parmi ceux qui se rappellent. Fais que je réponde à Ton invitation.`
};

MIROIR["54:41"] = {
  reference: "54:41",
  theme: ["Pharaon", "avertissement", "négation"],
  emotion: "Sérieux, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Mubin", "An-Nadhir"],
  mirrorVersion: `« Et les avertissements vinrent certes au peuple de Pharaon. » Le miroir continue avec Pharaon. « Wa laqad ja'a ala fir'awna al-nudhur » — et les avertissements vinrent au peuple de Pharaon. L'histoire continue. Le miroir m'invite à tirer les leçons.`,
  reflection: `Pharaon a reçu les avertissements mais les a niés. Son orgueil a mené à sa destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ja'a ala fir'awna al-nudhur » — et les avertissements vinrent certes au peuple de Pharaon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels avertissements je reçois ? Comment j'y réagis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement vient à tous, la réponse différencie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de Pharaon est un avertissement pour tous les tyrans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement échappe au sort de Pharaon." }
  ],
  munajat: `Ya Nadhir, Tu avertis tous les peuples. Fais que j'écoute les avertissements. Ne permets pas que je suive l'exemple de Pharaon.`
};

MIROIR["54:42"] = {
  reference: "54:42",
  theme: ["signes", "négation", "saisie"],
  emotion: "Crainte, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Matin"],
  mirrorVersion: `« Ils crièrent au mensonge à tous Nos signes. Nous les saisîmes donc. » Le miroir me montre la saisie divine. « Kadhdhabu bi-ayatina kulliha fa-akhadhnahum akhdha 'azizin muqtadir » — ils nièrent tous Nos signes. Nous les saisîmes. La saisie est totale. Le miroir m'invite à la crainte respectueuse.`,
  reflection: `La négation de tous les signes mène à la saisie totale. Le châtiment couvre tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabu bi-ayatina kulliha fa-akhadhnahum akhdha 'azizin muqtadir » — ils nièrent tous Nos signes. Nous les saisîmes donc." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de signes je nie ? La saisie peut-elle m'atteindre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation totale attire la saisie totale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La saisie divine est inévitable pour les négateurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux signes évite la saisie." }
  ],
  munajat: `Ya Qahhar, Tu saisis les négateurs. Fais que je croie aux signes. Ne permets pas que je sois saisi par Ton châtiment.`
};

MIROIR["54:43"] = {
  reference: "54:43",
  theme: ["question", "comparaison", "désaveu"],
  emotion: "Interrogation, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hakim"],
  mirrorVersion: `« Vos mécréants sont-ils meilleurs que ceux-là ? » Le miroir m'interroge sur ma position. « A-kuffarukum khayrun min ulai'ikum » — vos mécréants sont-ils meilleurs que ceux-là ? La comparaison est défavorable. Le miroir m'invite à l'humilité.`,
  reflection: `Les mécréants de La Mecque n'étaient pas meilleurs que les peuples détruits. Leur sort pouvait être le même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-kuffarukum khayrun min ulai'ikum » — vos mécréants sont-ils meilleurs que ceux-là ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me crois à l'abri ? Ai-je des garanties que les autres n'avaient pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La comparaison défavorable doit mener à la vigilance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Personne n'est à l'abri du châtiment divin sans la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se compare humblement se protège." }
  ],
  munajat: `Ya Haqq, je ne suis pas meilleur que ceux qui ont été détruits. Protège-moi par la foi. Ne permets pas que l'orgueil m'aveugle.`
};

MIROIR["54:44"] = {
  reference: "54:44",
  theme: ["orgueil", "désaveu", "groupe"],
  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Ghalib"],
  mirrorVersion: `« Ou bien disent-ils : Nous formons un groupe victorieux ? » Le miroir me montre la confiance illusoire. « Am yaquluna nahnu jami'un ghalibun » — ou bien disent-ils : Nous formons un groupe victorieux ? La force du nombre est illusoire. Le miroir m'invite à ne pas compter sur le groupe.`,
  reflection: `La confiance dans le groupe victorieux est illusoire. Allah est le seul Vainqueur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yaquluna nahnu jami'un ghalibun » — ou bien disent-ils : Nous formons un groupe victorieux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi je mets ma confiance ? Le groupe ? La force ? Ou Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire vient d'Allah, pas du nombre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plus grands groupes ont été défaits par la puissance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah est toujours victorieux." }
  ],
  munajat: `Ya Ghalib, Tu es le Vainqueur. Fais que je compte sur Toi seul. Ne permets pas que je me fie au nombre ou à la force.`
};

MIROIR["54:45"] = {
  reference: "54:45",
  theme: ["défaite", "fuite", "promesse"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Haqq"],
  mirrorVersion: `« Le groupe sera mis en déroute et ils tourneront le dos. » Le miroir me montre la promesse de victoire. « Sayuhzamu al-jam'u wa yuwalluna al-dubur » — le groupe sera mis en déroute. La victoire des croyants est promise. Le miroir m'invite à la confiance.`,
  reflection: `La défaite des mécréants est promise. La victoire des croyants viendra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sayuhzamu al-jam'u wa yuwalluna al-dubur » — le groupe sera mis en déroute et ils tourneront le dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois à la promesse divine ? Attends-je la victoire avec patience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défaite apparente précède la victoire réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours, même si elle tarde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la promesse la voit s'accomplir." }
  ],
  munajat: `Ya Nasir, Tu promets la victoire. Fais que j'y croie. Donne-moi la patience d'attendre Ton secours.`
};

MIROIR["54:46"] = {
  reference: "54:46",
  theme: ["jour", "heure", "difficulté"],
  emotion: "Sérieux, préparation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sa'ah", "Al-Qari'ah"],
  mirrorVersion: `« Mais l'Heure est leur rendez-vous, et l'Heure sera plus terrible et plus amère. » Le miroir me montre le rendez-vous final. « Bal al-sa'atu maw'iduhum wa al-sa'atu adha wa amarr » — mais l'Heure est leur rendez-vous. L'Heure sera terrible. Le miroir m'invite à la préparation.`,
  reflection: `Le rendez-vous avec l'Heure est certain. La difficulté sera extrême pour les négateurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal al-sa'atu maw'iduhum wa al-sa'atu adha wa amarr » — mais l'Heure est leur rendez-vous, et l'Heure sera plus terrible et plus amère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon rendez-vous avec l'Heure ? Suis-je prêt pour ce moment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La difficulté de l'Heure est proportionnelle à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure vient pour tous. L'état à l'arrivée dépend de la préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour l'Heure la trouve facile." }
  ],
  munajat: `Ya Sa'ah, l'Heure vient. Prépare-moi pour ce rendez-vous. Ne permets pas que je la trouve terrible et amère.`
};

MIROIR["54:47"] = {
  reference: "54:47",
  theme: ["criminels", "égarement", "folie"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Dall", "Al-Mudill"],
  mirrorVersion: `« Les criminels sont dans l'égarement et la folie. » Le miroir me montre l'état des criminels. « Inna al-mujrimina fi dalalin wa su'ur » — les criminels sont dans l'égarement et la folie. Le crime mène à la confusion. Le miroir m'invite à éviter le crime.`,
  reflection: `Le crime n'est pas seulement un acte — c'est un état mental d'égarement et de folie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-mujrimina fi dalalin wa su'ur » — les criminels sont dans l'égarement et la folie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je dans l'égarement ? Quels crimes je commets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le crime physique vient du crime spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le crime perturbe l'ordre de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite le crime garde la clarté d'esprit." }
  ],
  munajat: `Ya Mudill, préserve-moi de l'égarement. Fais que je ne sois pas parmi les criminels. Donne-moi la clarté d'esprit.`
};

MIROIR["54:48"] = {
  reference: "54:48",
  theme: ["visage", "enfer", "traînement"],
  emotion: "Crainte, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Khafid"],
  mirrorVersion: `« Le jour où ils seront traînés sur leurs visages dans le Feu. » Le miroir me montre l'humiliation finale. « Yawma yuhabbuna fi al-nari 'ala wujuhihim » — le jour où ils seront traînés sur leurs visages. L'humiliation est totale. Le miroir m'invite à la crainte.`,
  reflection: `Être traîné sur le visage dans le Feu est l'humiliation ultime. La dignité est perdue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yuhabbuna fi al-nari 'ala wujuhihim » — le jour où ils seront traînés sur leurs visages dans le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je veux être traité le Jour du Jugement ? Avec dignité ou humiliation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation dans l'au-delà vient de l'orgueil ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le visage qui s'est levé par orgueil sera traîné par humilité forcée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie maintenant sera élevé plus tard." }
  ],
  munajat: `Ya Khafid, Tu abaisses les orgueilleux. Fais que je m'humilie devant Toi maintenant. Ne permets pas que je sois humilié de force plus tard.`
};

MIROIR["54:50"] = {
  reference: "54:50",
  theme: ["commandement", "instantanéité", "puissance"],
  emotion: "Crainte, soumission",
  difficulty: "avancé",
  relatedNames: ["Al-Amr", "Al-Qadir"],
  mirrorVersion: `« Et Notre commandement est unique comme un clin d'œil. » Le miroir me montre l'instantanéité du commandement. « Wa ma amruna illa wahidatun ka-lamhin bi-al-basar » — Notre commandement est unique comme un clin d'œil. La puissance divine est instantanée. Le miroir m'invite à la reconnaissance de cette puissance.`,
  reflection: `Le commandement d'Allah est instantané. Un clin d'œil suffit pour changer tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma amruna illa wahidatun ka-lamhin bi-al-basar » — Notre commandement est unique comme un clin d'œil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la puissance instantanée d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'instantanéité du commandement montre la puissance absolue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit instantanément au commandement divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit instantanément à Allah Lui ressemble." }
  ],
  munajat: `Ya Amr, Ton commandement est instantané. Fais que je T'obéisse avec la même rapidité. Ne permets pas que je tarde à obéir.`
};

MIROIR["54:51"] = {
  reference: "54:51",
  theme: ["destruction", "exemplarité", "leçon"],
  emotion: "Sérieux, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Mubli", "Al-Hakim"],
  mirrorVersion: `« Et Nous avons certes détruit vos semblables. » Le miroir me montre la similitude du châtiment. « Wa laqad ahlakna ashy'a'akum » — et Nous avons détruit vos semblables. L'histoire se répète. Le miroir m'invite à tirer les leçons.`,
  reflection: `Ceux qui ont été détruits étaient semblables. La similitude invite à la vigilance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ahlakna ashy'a'akum » — et Nous avons certes détruit vos semblables." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "En quoi je suis semblable à ceux qui ont été détruits ? Qu'est-ce que je dois changer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La similitude est une opportunité d'apprentissage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire se répète pour ceux qui n'apprennent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire les leçons des semblables ne les rejoint pas." }
  ],
  munajat: `Ya Mubli, Tu as détruit les semblables. Fais que j'apprenne d'eux. Ne permets pas que je les rejoigne dans la destruction.`
};

MIROIR["54:52"] = {
  reference: "54:52",
  theme: ["livre", "enregistrement", "compte"],
  emotion: "Responsabilité, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Hasib"],
  mirrorVersion: `« Et toute chose qu'ils ont faite est dans les registres. » Le miroir me montre l'enregistrement. « Wa kullu shay'in fa'aluhu fi al-zubur » — et toute chose est dans les registres. Rien n'est oublié. Le miroir m'invite à la conscience de l'enregistrement.`,
  reflection: `Chaque action est enregistrée. Les registres contiennent tout. Le compte sera précis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kullu shay'in fa'aluhu fi al-zubur » — et toute chose qu'ils ont faite est dans les registres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est enregistré sur moi ? Suis-je conscient de l'enregistrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enregistrement continu invite à la vigilance continue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers enregistre tout. Rien n'est perdu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec conscience de l'enregistrement vit bien." }
  ],
  munajat: `Ya Hasib, Tu enregistres tout. Fais que je vive avec conscience de l'enregistrement. Ne permets pas que j'oublie que tout est noté.`
};

MIROIR["54:53"] = {
  reference: "54:53",
  theme: ["petit", "grand", "enregistrement"],
  emotion: "Responsabilité, précision",
  difficulty: "débutant",
  relatedNames: ["Al-Muhsi", "Al-Khabir"],
  mirrorVersion: `« Et toute chose petite ou grande est inscrite. » Le miroir me montre la précision de l'enregistrement. « Wa kullu saghirin wa kabirin mustatar » — toute chose petite ou grande est inscrite. Rien n'échappe. Le miroir m'invite à la précision dans mes actions.`,
  reflection: `Petit ou grand, tout est inscrit. La précision divine est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kullu saghirin wa kabirin mustatar » — et toute chose petite ou grande est inscrite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les petites choses sont-elles importantes pour moi ? Le sont-elles pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La petite chose peut être grande dans le registre divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est précis dans chaque détail." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soigne les petites choses soigne le tout." }
  ],
  munajat: `Ya Muhsi, Tu enregistres petit et grand. Fais que je soigne les détails. Ne permets pas que je néglige le petit pensant qu'il ne compte pas.`
};

MIROIR["54:54"] = {
  reference: "54:54",
  theme: ["piété", "paradis", "rivers"],
  emotion: "Espoir, réconfort",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Jannah"],
  mirrorVersion: `« Les pieux seront parmi des jardins et des rivières. » Le miroir me montre la récompense. « Inna al-muttaqina fi jannatin wa nahar » — les pieux seront dans des jardins et des rivières. La récompense est belle. Le miroir m'invite à la piété.`,
  reflection: `La piété mène aux jardins et aux rivières. La récompense est proportionnée à l'effort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-muttaqina fi jannatin wa nahar » — les pieux seront parmi des jardins et des rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les pieux ? Quel effort je fais pour la piété ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété maintenant mène aux jardins plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jardins et rivières du Paradis dépassent l'imagination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux goûte au Paradis dès ce monde." }
  ],
  munajat: `Ya Rahman, Tu récompenses les pieux. Fais que je sois parmi eux. Donne-moi les jardins et les rivières du Paradis.`
};

MIROIR["54:55"] = {
  reference: "54:55",
  theme: ["paradis", "vérité", "puissance"],
  emotion: "Espoir, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Malik"],
  mirrorVersion: `« En une assemblée de vérité, auprès d'un Souverain Puissant. » Le miroir termine par la compagnie paradisiaque. « Fi maq'adi sidqin 'inda malikin muqtadir » — en une assemblée de vérité, auprès d'un Souverain Puissant. La compagnie est véridique, le Roi est puissant. Le miroir m'invite à aspirer à cette compagnie.`,
  reflection: `L'assemblée du Paradis est véridique. Le Roi est Allah, le Puissant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi maq'adi sidqin 'inda malikin muqtadir » — en une assemblée de vérité, auprès d'un Souverain Puissant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle compagnie je veux pour l'éternité ? La véridique ou la mensongère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compagnie véridique commence par la vérité ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Roi puissant est le Seigneur de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la compagnie véridique la trouve auprès du Roi." }
  ],
  munajat: `Ya Malik, Tu es le Roi Puissant. Fais que je sois dans l'assemblée véridique. Accorde-moi Ta compagnie éternelle.`
};

// === SURAH 55 - AR-RAHMAN (The Most Merciful) - 78 verses ===
// Existing: 55:1, 55:13, 55:26, 55:60, 55:78
// Adding: 55:2-12, 55:14-25, 55:27-59, 55:61-77

MIROIR["55:2"] = {
  reference: "55:2",
  theme: ["coran", "enseignement", "miséricorde"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mu'allim"],
  mirrorVersion: `« Il a enseigné le Coran. » Le miroir me montre le don de l'enseignement. « 'Allama al-qur'an » — Il a enseigné le Coran. Le Coran est un enseignement divin. Le miroir m'invite à recevoir cet enseignement avec gratitude.`,
  reflection: `Le Coran est un enseignement d'Allah. L'apprendre, c'est recevoir un don divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Allama al-qur'an » — Il a enseigné le Coran." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends le Coran ? Est-ce que je le reçois comme enseignement divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enseignement du Coran transforme l'élève." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est l'enseignement le plus parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit l'enseignement reçoit le Maître." }
  ],
  munajat: `Ya Mu'allim, Tu enseignes le Coran. Fais que je reçoive Ton enseignement. Ouvre mon cœur à la compréhension.`
};

MIROIR["55:3"] = {
  reference: "55:3",
  theme: ["création", "homme", "expression"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mutakallim"],
  mirrorVersion: `« Il a créé l'homme. » Le miroir me montre ma création. « Khalaqa al-insan » — Il a créé l'homme. Je suis une création divine. Le miroir m'invite à reconnaître mon Créateur.`,
  reflection: `L'homme est une création divine. Se connaître comme créé change tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa al-insan » — Il a créé l'homme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me connais comme créé ? Est-ce que je reconnais mon Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la création est la base de la relation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est la créature la plus noble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se connaît comme créé connaît le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé. Fais que je Te reconnaisse comme mon Créateur. Aide-moi à vivre comme Ta création.`
};

MIROIR["55:4"] = {
  reference: "55:4",
  theme: ["expression", "langage", "don"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Mutakallim", "Al-Mu'allim"],
  mirrorVersion: `« Il lui a appris à s'exprimer clairement. » Le miroir me montre le don du langage. « 'Allamahu al-bayan » — Il lui a appris à s'exprimer. La parole est un don divin. Le miroir m'invite à utiliser ce don avec sagesse.`,
  reflection: `Le langage est un don divin unique à l'homme. L'utiliser pour le bien est une reconnaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Allamahu al-bayan » — Il lui a appris à s'exprimer clairement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise le don de la parole ? Pour le bien ou le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole peut élever ou détruire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le langage distingue l'homme de toutes les créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise bien la parole approche la perfection." }
  ],
  munajat: `Ya Mutakallim, Tu m'as donné la parole. Fais que je l'utilise pour le bien. Ne permets pas que ma parole soit un mal.`
};

MIROIR["55:5"] = {
  reference: "55:5",
  theme: ["soleil", "lune", "ordre"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mudabbir", "Al-Khaliq"],
  mirrorVersion: `« Le soleil et la lune suivent un calcul précis. » Le miroir me montre l'ordre cosmique. « Al-shamsu wa al-qamaru bi-husban » — le soleil et la lune suivent un calcul. L'univers est ordonné. Le miroir m'invite à respecter l'ordre divin.`,
  reflection: `Le soleil et la lune obéissent parfaitement à l'ordre divin. L'homme devrait en faire autant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-shamsu wa al-qamaru bi-husban » — le soleil et la lune suivent un calcul précis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis l'ordre divin comme le soleil et la lune le suivent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre cosmique est un modèle pour l'ordre humain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier suit l'ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit l'ordre divin participe à l'harmonie universelle." }
  ],
  munajat: `Ya Mudabbir, Tu ordonnes l'univers. Fais que je suive Ton ordre. Ne permets pas que je désobéisse là où tout obéit.`
};

MIROIR["55:6"] = {
  reference: "55:6",
  theme: ["étoiles", "prosternation", "adoration"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Musabbih", "Al-Khaliq"],
  mirrorVersion: `« Et les étoiles et les arbres se prosternent. » Le miroir me montre l'adoration cosmique. « Wa al-najmu wa al-shajaru yasjudan » — les étoiles et les arbres se prosternent. Tout adore Allah. Le miroir m'invite à me joindre à l'adoration universelle.`,
  reflection: `Les étoiles et les arbres adorent Allah par leur existence. L'homme doit adorer consciemment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-najmu wa al-shajaru yasjudan » — et les étoiles et les arbres se prosternent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prosterne avec la création ? Ou est-ce que je reste debout dans l'orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation de la création invite à la prosternation humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne avec la création rejoint l'adoration universelle." }
  ],
  munajat: `Ya Musabbih, toute la création Te glorifie. Fais que je me joigne à l'adoration. Ne permets pas que je reste à l'écart de la prosternation.`
};

MIROIR["55:7"] = {
  reference: "55:7",
  theme: ["ciel", "élévation", "équilibre"],
  emotion: "Émerveillement, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Rafi'", "Al-Musi'u"],
  mirrorVersion: `« Et le ciel, Il l'a élevé. » Le miroir me montre l'élévation divine. « Wa al-sama'a rafa'aha » — et le ciel, Il l'a élevé. L'élévation est divine. Le miroir m'invite à contempler la grandeur.`,
  reflection: `Le ciel élevé est un signe de la grandeur d'Allah. L'élévation est Sa marque.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-sama'a rafa'aha » — et le ciel, Il l'a élevé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je lève les yeux vers le ciel, est-ce que je pense à l'Élévateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation du ciel est un appel à l'élévation de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel élevé contient des milliards de galaxies." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'élévation s'élève." }
  ],
  munajat: `Ya Rafi', Tu as élevé le ciel. Élève mon âme vers Toi. Ne permets pas que je reste bas alors que le ciel est élevé.`
};

MIROIR["55:8"] = {
  reference: "55:8",
  theme: ["balance", "justice", "équilibre"],
  emotion: "Révérence, respect",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Mizan"],
  mirrorVersion: `« Et Il a établi la balance. » Le miroir me montre la balance divine. « Wa wada'a al-mizan » — et Il a établi la balance. La justice est divine. Le miroir m'invite à respecter la balance.`,
  reflection: `La balance représente la justice et l'équilibre. Tout dans l'univers est mesuré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wada'a al-mizan » — et Il a établi la balance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la balance dans mes affaires ? Suis-je juste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La balance divine est le modèle pour la balance humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par l'équilibre parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la balance respecte le Juste." }
  ],
  munajat: `Ya 'Adl, Tu as établi la balance. Fais que je sois juste. Ne permets pas que je fausse la balance.`
};

MIROIR["55:9"] = {
  reference: "55:9",
  theme: ["justice", "équité", "transgression"],
  emotion: "Sérieux, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Qasit"],
  mirrorVersion: `« Afin que vous ne transgressiez pas dans la pesée. » Le miroir me montre le but de la balance. « Alla tathghaw fi al-mizan » — afin que vous ne transgressiez pas. La transgression dans la pesée est grave. Le miroir m'invite à l'équité.`,
  reflection: `Transgresser dans la pesée est une forme de tricherie. L'équité est exigée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alla tathghaw fi al-mizan » — afin que vous ne transgressiez pas dans la pesée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans mes transactions, est-ce que je suis équitable ? Est-ce que je triche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équité dans la pesée est un reflet de l'équité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne avec une équité parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pèse avec équité sera pesé avec équité." }
  ],
  munajat: `Ya Hakam, Tu exiges l'équité. Fais que je sois équitable dans toutes mes pesées. Ne permets pas que je triche.`
};

MIROIR["55:10"] = {
  reference: "55:10",
  theme: ["terre", "créatures", "provision"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Ar-Razzaq"],
  mirrorVersion: `« Et la terre, Il l'a disposée pour les créatures. » Le miroir me montre la terre comme provision. « Wa al-arda wada'aha lil-anam » — et la terre, Il l'a disposée pour les créatures. La terre est un don. Le miroir m'invite à la reconnaissance.`,
  reflection: `La terre a été créée pour les créatures. C'est un don à respecter et à préserver.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-arda wada'aha lil-anam » — et la terre, Il l'a disposée pour les créatures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite la terre ? Avec respect ou exploitation abusive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre est un don pour toutes les créatures, pas seulement les humains." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre abrite des millions d'espèces." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la terre respecte le Donateur." }
  ],
  munajat: `Ya Razzaq, Tu as disposé la terre pour les créatures. Fais que je la respecte. Ne permets pas que je l'exploite injustement.`
};

MIROIR["55:11"] = {
  reference: "55:11",
  theme: ["fruits", "provision", "bénédiction"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Il y a des fruits et des palmiers aux cachettes couvertes. » Le miroir me montre les fruits. « Fiha fakihatun wa nakhulun dhata akmun » — il y a des fruits et des palmiers. La provision est variée. Le miroir m'invite à la gratitude.`,
  reflection: `Les fruits sont un signe de la provision divine. Chaque fruit est un miracle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fiha fakihatun wa nakhulun dhata akmun » — il y a des fruits et des palmiers aux cachettes couvertes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je mange un fruit, est-ce que je remercie le Pourvoyeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque fruit est une lettre d'amour du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit des milliers de variétés de fruits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour le fruit remercie le Pourvoyeur." }
  ],
  munajat: `Ya Razzaq, Tu donnes les fruits. Fais que je Te remercie pour chaque bouchée. Ne permets pas que je mange sans gratitude.`
};

MIROIR["55:12"] = {
  reference: "55:12",
  theme: ["grains", "plantes", "provision"],
