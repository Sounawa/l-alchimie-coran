  emotion: "Sagesse, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ibad", "Ar-Rahman"],
  mirrorVersion: `« Les serviteurs du Tout-Miséricordieux sont ceux qui marchent humblement sur terre. » Le miroir me montre les qualités des serviteurs. « Wa 'ibadu al-rahmani alladhina yamshuna 'ala al-ardi hawn » — les serviteurs du Tout-Miséricordieux marchent humblement. L'humilité est leur marque. Le miroir m'interroge : est-ce que je marche humblement ?`,
  reflection: `L'humilité est la marque des serviteurs. La cultiver est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ibadu al-rahmani alladhina yamshuna 'ala al-ardi hawn » — les serviteurs du Tout-Miséricordieux sont ceux qui marchent humblement sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je marche humblement ? Ou est-ce que je marche avec orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans la marche reflète l'humilité du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les vrais serviteurs sont humbles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble appartient au Tout-Miséricordieux." }
  ],
  munajat: `Ya Rahman, je veux marcher humblement. Ne permets pas l'orgueil. Fais que je sois de Tes vrais serviteurs.`
};

MIROIR["25:70"] = {
  reference: "25:70",
  theme: ["repentir", "pardon", "transformation"],
  emotion: "Espérance, miséricorde",
  difficulty: "débutant",
  relatedNames: ["At-Tawbah", "Al-Ghafur"],
  mirrorVersion: `« Sauf celui qui se repent, croit et accomplit une bonne œuvre. » Le miroir me montre la voie du pardon. « Ila man taba wa amana wa 'amila 'amalan salihan » — sauf celui qui se repent, croit et accomplit une bonne œuvre. Le repentir efface les péchés. Le miroir m'interroge : est-ce que je me repends sincèrement ?`,
  reflection: `Le repentir efface les péchés. Se repentir sincèrement est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila man taba wa amana wa 'amila 'amalan salihan fa-ula'ika yubaddilu Allahu sayyi'atihim hasanat » — sauf celui qui se repent, croit et accomplit une bonne œuvre. Ceux-là, Allah transforme leurs mauvaises actions en bonnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repends sincèrement ? Ou est-ce que je persiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir sincère transforme le mal en bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est plus grande que les péchés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement est comme sans péché." }
  ],
  munajat: `Ya Ghafur, je me repends sincèrement. Ne permets pas que je persiste. Transforme mes mauvaises actions en bonnes par mon repentir.`
};

// ============ SURAH 26 (ASH-SHU'ARA) - Missing Entries ============

MIROIR["26:88"] = {
  reference: "26:88",
  theme: ["jugement", "richesse", "enfants"],
  emotion: "Réalité, détachement",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-Mal"],
  mirrorVersion: `« Le jour où ni les biens ni les enfants ne seront d'aucune utilité. » Le miroir me montre l'inutilité des biens au jugement. « Yawma la yanfa'u malun wa la bun » — le jour où ni les biens ni les enfants ne seront d'aucune utilité. Seule la foi compte. Le miroir m'interroge : est-ce que je compte sur les biens ou sur la foi ?`,
  reflection: `Seule la foi compte au jugement. Compter sur la foi est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma la yanfa'u malun wa la bununa illa man ata Allaha bi-qalbin salim » — le jour où ni les biens ni les enfants ne seront d'aucune utilité, sauf celui qui vient à Allah avec un cœur sain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur les biens ou sur la foi ? Sur quoi j'investis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur sain est le seul capital au jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens et les enfants sont des épreuves." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vient avec un cœur sain est sauvé." }
  ],
  munajat: `Ya Rabb, je viens à Toi avec un cœur sain. Ne permets pas que je compte sur les biens. Donne-moi le cœur pur qui compte seul.`
};

MIROIR["26:227"] = {
  reference: "26:227",
  theme: ["poètes", "foi", "œuvres"],
  emotion: "Clarté, distinction",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shu'ara", "Al-Iman"],
  mirrorVersion: `« Sauf ceux qui croient, accomplissent les bonnes œuvres et invoquent souvent Allah. » Le miroir me montre l'exception parmi les poètes. « Illa alladhina amanu wa 'amilu al-salihati » — sauf ceux qui croient et accomplissent les bonnes œuvres. La foi distingue. Le miroir m'interroge : est-ce que ma parole est accompagnée de foi ?`,
  reflection: `La foi distingue la bonne parole. Parler avec foi est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina amanu wa 'amilu al-salihati wa dhakaru Allaha kathiran » — sauf ceux qui croient, accomplissent les bonnes œuvres et invoquent souvent Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma parole est accompagnée de foi ? Ou est-ce qu'elle est vide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole avec foi transforme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole des croyants est bénie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle avec foi touche les cœurs." }
  ],
  munajat: `Ya Rabb, ma parole est accompagnée de foi. Ne permets pas qu'elle soit vide. Donne-moi de parler avec foi et sincérité.`
};

