    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé en couples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la dualité trouve l'harmonie." }
  ],
  munajat: `Ya Rabb, merci pour la création en couples. Donne-moi l'harmonie dans la dualité.`
};

