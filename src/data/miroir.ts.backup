  theme: ["Noé", "invocation", "réponse"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Nuh", "Al-Du'a", "Al-Mujib"],
  mirrorVersion: `« Et Noé, quand il Nous invoqua auparavant. » Le miroir me montre l'invocation de Noé. « Wa Nuhan idh nada min qablu » — et Noé, quand il Nous invoqua auparavant. « Fa-stajabna lahu » — Nous lui répondîmes. L'invocation est exaucée. Le miroir m'interroge : est-ce que j'invoque Allah avec espoir ?`,
  reflection: `Noé a invoqué et Allah a répondu. L'invocation sincère est toujours exaucée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Nuhan idh nada min qablu fa-stajabna lahu » — et Noé, quand il Nous invoqua auparavant. Nous lui répondîmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah avec espoir ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation sincère est toujours exaucée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah répond à l'appel de ceux qui L'invoquent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque avec espoir reçoit la réponse." }
  ],
  munajat: `Ya Mujib, j'invoque avec espoir. Ne permets pas le désespoir. Réponds à mon invocation comme Tu as répondu à Noé.`
};

MIROIR["21:77"] = {
