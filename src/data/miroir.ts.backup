  mirrorVersion: `« Nous avons honoré les fils d'Adam. » Le miroir me montre la dignité accordée à l'homme. « Wa laqad karramna bani adama » — Nous avons honoré les fils d'Adam. L'honneur divin est sur l'humanité. Le miroir m'interroge : est-ce que j'honore cette dignité ?`,
  reflection: `L'honneur divin est sur l'humanité. Honorer cette dignité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad karramna bani adama » — Nous avons honoré les fils d'Adam." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'honore cette dignité ? Ou est-ce que je la souille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur de la dignité se manifeste par la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est la créature la plus honorée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore sa dignité l'élève encore plus." }
  ],
  munajat: `Ya Rabb, j'honore la dignité que Tu m'as accordée. Ne permets pas que je la souille. Élève-moi par l'honneur de ma dignité.`
};

MIROIR["17:110"] = {
  reference: "17:110",
  theme: ["noms", "invocation", "modération"],
  emotion: "Révérence, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Asma'", "Ad-Du'a"],
  mirrorVersion: `« Invoquez Allah ou invoquez le Tout-Miséricordieux. Quoi que vous invoquiez, à Lui appartiennent les plus beaux noms. » Le miroir me montre la beauté des noms d'Allah. « Qul id'u Allaha aw id'u al-rahmana » — invoquez Allah ou invoquez le Tout-Miséricordieux. Ses noms sont tous beaux. Le miroir m'interroge : est-ce que j'invoque par Ses beaux noms ?`,
  reflection: `Ses noms sont tous beaux. Les connaître et les invoquer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul id'u Allaha aw id'u al-rahmana ayyama tad'u falahu al-asma'u al-husna » — invoquez Allah ou invoquez le Tout-Miséricordieux. Quoi que vous invoquiez, à Lui appartiennent les plus beaux noms." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque par Ses beaux noms ? Ou est-ce que j'oublie Ses noms ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation par Ses noms ouvre les portes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les noms d'Allah sont les clés de l'invocation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Ses noms les invoque avec amour." }
  ],
  munajat: `Ya Rabb, je veux invoquer par Tes beaux noms. Ne permets pas que je les oublie. Enseigne-moi Tes noms pour que je T'invoque correctement.`
};

// ============ SURAH 18 (AL-KAHF) - Missing Entries ============

MIROIR["18:24"] = {
  reference: "18:24",
  theme: ["souvenir", "volonté", "mention"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikr", "Insha' Allah"],
  mirrorVersion: `« Sans ajouter : "Si Allah le veut". » Le miroir me montre l'importance de la mention d'Allah. « Ila an yasha'a Allah » — sans ajouter : Si Allah le veut. La mention de Sa volonté est essentielle. Le miroir m'interroge : est-ce que je mentionne toujours Sa volonté ?`,
  reflection: `La mention de Sa volonté est essentielle. Ne jamais oublier "Insha' Allah".`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila an yasha'a Allah » — sans ajouter : Si Allah le veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mentionne toujours Sa volonté ? Ou est-ce que j'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mention de Sa volonté est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien ne se réalise sans Sa volonté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mentionne Sa volonté reconnaît Sa souveraineté." }
  ],
  munajat: `Ya Rabb, je mentionne toujours Ta volonté. Ne permets pas que je l'oublie. Fais que chaque projet soit accompagné de "Insha' Allah".`
};

MIROIR["18:39"] = {
  reference: "18:39",
  theme: ["bienfait", "reconnaissance", "parole"],
  emotion: "Gratitude, sagesse",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Al-Mashi'ah"],
  mirrorVersion: `« Pourquoi, en entrant dans ton jardin, n'as-tu pas dit : "Ce qu'Allah veut, il arrive" ? » Le miroir me montre la bonne parole à prononcer. « Lawla idha dakhalta jannataka qulta ma sha'a Allahu » — pourquoi n'as-tu pas dit : Ce qu'Allah veut, il arrive. La bonne parole préserve les bienfaits. Le miroir m'interroge : est-ce que je prononce la bonne parole ?`,
  reflection: `La bonne parole préserve les bienfaits. La prononcer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawla idha dakhalta jannataka qulta ma sha'a Allahu la quwwata illa bi-Allah » — pourquoi n'as-tu pas dit : Ce qu'Allah veut, il arrive, il n'y a de force que par Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prononce la bonne parole ? Ou est-ce que je reste silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne parole protège les bienfaits." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole reconnaissante attire la bénédiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prononce la bonne parole préserve ses bienfaits." }
  ],
  munajat: `Ya Rabb, je prononce la bonne parole. Ne permets pas le silence ingrat. Préserve mes bienfaits par ma reconnaissance.`
};

MIROIR["18:45"] = {
  reference: "18:45",
  theme: ["vie", "parabole", "éphémère"],
  emotion: "Réalité, détachement",
  difficulty: "débutant",
  relatedNames: ["Al-Hayah", "Al-Mathal"],
  mirrorVersion: `« Propose-leur l'exemple de la vie de ce monde : elle est comme une eau que Nous faisons descendre du ciel. » Le miroir me montre l'éphémère de cette vie. « Wa idrib lahum mathala al-hayati al-dunya » — propose-leur l'exemple de la vie de ce monde. La vie est comme l'eau qui s'évapore. Le miroir m'interroge : est-ce que je réalise l'éphémère de cette vie ?`,
  reflection: `La vie est comme l'eau qui s'évapore. Réaliser son éphémérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idrib lahum mathala al-hayati al-dunya ka-ma'in anzalnahu mina al-sama'i » — propose-leur l'exemple de la vie de ce monde : elle est comme une eau que Nous faisons descendre du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise l'éphémère de cette vie ? Ou est-ce que je m'y attache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détachement de cette vie ouvre à l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Cette vie est un passage, l'au-delà est la destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise l'éphémère se prépare pour l'éternel." }
  ],
  munajat: `Ya Rabb, je réalise l'éphémère de cette vie. Ne permets pas que je m'y attache. Prépare-moi pour l'éternité.`
};

MIROIR["18:65"] = {
  reference: "18:65",
  theme: ["science", "serviteur", "bénédiction"],
  emotion: "Sagesse, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khidr", "Al-Ilm"],
  mirrorVersion: `« Ils trouvèrent un de Nos serviteurs à qui Nous avions donné une miséricorde de Notre part et enseigné une science émanant de Nous. » Le miroir me montre le serviteur béni. « Wajada 'abdan min 'ibadina ataynahu rahmatan min 'indina » — ils trouvèrent un de Nos serviteurs à qui Nous avions donné une miséricorde. La science est un don. Le miroir m'interroge : est-ce que je cherche la science qui vient d'Allah ?`,
  reflection: `La science est un don d'Allah. La chercher est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wajada 'abdan min 'ibadina ataynahu rahmatan min 'indina wa 'allamnahu mil ladunna 'ilma » — ils trouvèrent un de Nos serviteurs à qui Nous avions donné une miséricorde de Notre part et enseigné une science émanant de Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la science qui vient d'Allah ? Ou est-ce que je cherche autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La science divine est la plus précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah donne Sa science à qui Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la science d'Allah la reçoit." }
  ],
  munajat: `Ya Rabb, je cherche Ta science. Ne permets pas que je cherche ailleurs. Donne-moi la science qui vient de Toi.`
};

MIROIR["18:110"] = {
  reference: "18:110",
  theme: ["messager", "adoration", "récompense"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Ibadah"],
  mirrorVersion: `« Dis : Je suis un homme comme vous, à qui il a été révélé que votre Dieu est un Dieu unique. » Le miroir me montre la mission du Prophète. « Qul innama ana basharun mithlukum yuha ilayya » — dis : Je suis un homme comme vous, à qui il a été révélé. Le Prophète est un homme qui a reçu la révélation. Le miroir m'interroge : est-ce que je suis la révélation qu'il a reçue ?`,
  reflection: `Le Prophète est un homme qui a reçu la révélation. Suivre cette révélation est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama ana basharun mithlukum yuha ilayya annama ilahukum ilahun wahid » — dis : Je suis un homme comme vous, à qui il a été révélé que votre Dieu est un Dieu unique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la révélation qu'il a reçue ? Ou est-ce que je m'en détourne ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le suivi de la révélation est le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le guide pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la révélation atteint le but." }
  ],
  munajat: `Ya Rabb, je suis la révélation que Tu as envoyée. Ne permets pas que je m'en détourne. Guide-moi par Ta révélation.`
};

MIROIR["40:34"] = {
  reference: "40:34",
  theme: ["youssef", "messagers", "égarement"],
  emotion: "Méditation, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Bayan"],
  mirrorVersion: `« Joseph vous avait apporté les preuves évidentes avant, et vous avez persisté dans le doute. » Le miroir me montre l'exemple de Joseph. « Wa laqad ja'akum Yusufu min qablu bi-al-bayyinati » — Joseph vous avait apporté les preuves évidentes avant. L'histoire de Joseph est un exemple. Le miroir m'interroge : est-ce que je persiste dans le doute ?`,
  reflection: `Joseph avait apporté les preuves mais les gens ont persisté dans le doute. Après sa mort, ils ont cru en lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ja'akum Yusufu min qablu bi-al-bayyinati fa-ma ziltum fi shakkin mimma ja'akum bihi » — Joseph vous avait apporté les preuves évidentes avant, et vous avez persisté dans le doute à propos de ce qu'il vous avait apporté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persiste dans le doute ? Ou est-ce que j'accepte les preuves ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des preuves est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Jusqu'à sa mort, vous n'avez pas cru." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les preuves n'est pas dans le doute." }
  ],
  munajat: `Ya Huda, j'accepte les preuves. Ne permets pas que je persiste dans le doute. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["40:35"] = {
  reference: "40:35",
  theme: ["argumentation", "orgueil", "égarement"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Ceux qui discutent les signes d'Allah sans autorité venue à eux, cela est grandement exécrable auprès d'Allah et auprès des croyants. » Le miroir me montre l'exécration de l'argumentation sans preuve. « Alladhina yujadiluna fi ayati Allahi bi-ghayri sultanin atahum » — ceux qui discutent les signes d'Allah sans autorité. L'argumentation sans preuve est exécrée. Le miroir m'interroge : est-ce que j'argumente sans preuve ?`,
  reflection: `L'argumentation sans autorité est exécrable. Allah scelle les cœurs des orgueilleux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yujadiluna fi ayati Allahi bi-ghayri sultanin atahum kabura maqtan 'inda Allahi wa 'inda alladhina amanu » — ceux qui discutent les signes d'Allah sans autorité venue à eux, cela est grandement exécrable auprès d'Allah et auprès des croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'argumente sans preuve ? Ou est-ce que j'accepte avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité face aux signes est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ainsi Allah scelle le cœur de tout orgueilleux tyrannique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble face aux signes a le cœur ouvert." }
  ],
  munajat: `Ya Haqq, j'accepte Tes signes avec humilité. Ne permets pas que mon cœur soit scellé. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["40:36"] = {
  reference: "40:36",
  theme: ["pharaon", "arrogance", "construction"],
  emotion: "Orgueil, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Kibr", "Al-Bab"],
  mirrorVersion: `« Et Pharaon dit : Ô Haman, construis-moi une tour : peut-être atteindrai-je les voies. » Le miroir me montre l'arrogance de Pharaon. « Wa qala fir'awnu ya hamanu ibni li sarhan » — et Pharaon dit : Ô Haman, construis-moi une tour. L'arrogance cherche à atteindre le ciel. Le miroir m'interroge : est-ce que je suis arrogant ?`,
  reflection: `Pharaon voulait atteindre les voies des cieux pour voir le dieu de Moïse. Son orgueil l'a perdu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala fir'awnu ya hamanu ibni li sarhan la'alli ablughu al-asbab asbaba al-samawati » — et Pharaon dit : Ô Haman, construis-moi une tour : peut-être atteindrai-je les voies, les voies des cieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis arrogant ? Ou est-ce que je suis humble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité est la voie du succès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arrogance de Pharaon l'a conduit à sa perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble trouve le chemin d'Allah." }
  ],
  munajat: `Ya Rabb, je suis humble. Ne permets pas que je sois arrogant. Donne-moi la voie du succès par l'humilité.`
};

MIROIR["40:37"] = {
  reference: "40:37",
  theme: ["pharaon", "mousa", "orgueil"],
  emotion: "Mise en garde, dramatique",
  difficulty: "débutant",
  relatedNames: ["Al-Sama'", "Al-Ilah"],
  mirrorVersion: `« Les voies des cieux, et que je jette un regard sur le dieu de Moïse. Je pense qu'il est menteur. » Le miroir me montre le déni de Pharaon. « Fa-attali'a ila ilahi Musa wa inni la-azunnuhu kadhiban » — que je jette un regard sur le dieu de Moïse. Je pense qu'il est menteur. Le déni est complet. Le miroir m'interroge : est-ce que je traite les véridiques de menteurs ?`,
  reflection: `Pharaon voulait voir le dieu de Moïse mais il pensait que Moïse était menteur. Son œuvre est embellie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-attali'a ila ilahi Musa wa inni la-azunnuhu kadhiban wa kazalika zuyyina li-fir'awna su'u 'amalihi » — et que je jette un regard sur le dieu de Moïse. Je pense qu'il est menteur. Ainsi a été embellie à Pharaon la méchanceté de son action." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite les véridiques de menteurs ? Ou est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des véridiques est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il a été détourné du droit chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les véridiques est guidé." }
  ],
  munajat: `Ya Rabb, je reconnais les véridiques. Ne permets pas que je les traite de menteurs. Donne-moi la foi qui reconnaît la vérité.`
};

MIROIR["40:38"] = {
  reference: "40:38",
  theme: ["croyant", "conseil", "sagesse"],
  emotion: "Inspiration, dévouement",
  difficulty: "débutant",
  relatedNames: ["Al-Nasihah", "Al-Hikmah"],
  mirrorVersion: `« Et celui qui croyait dit : Ô mon peuple, suivez-moi, je vous guiderai sur le chemin de la droiture. » Le miroir me montre le dévouement du croyant. « Wa qala alladhi amana ya qawmi ittabi'uni ahdikum sabila al-rashad » — et celui qui croyait dit : Ô mon peuple, suivez-moi, je vous guiderai sur le chemin de la droiture. Le dévouement est admirable. Le miroir m'interroge : est-ce que je guide vers le chemin de la droiture ?`,
  reflection: `Le croyant voulait guider son peuple vers le chemin de la droiture. Son conseil était sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala alladhi amana ya qawmi ittabi'uni ahdikum sabila al-rashad » — et celui qui croyait dit : Ô mon peuple, suivez-moi, je vous guiderai sur le chemin de la droiture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je guide vers le chemin de la droiture ? Ou est-ce que je garde la guidance pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le partage de la guidance est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ô mon peuple ! Cette vie d'ici-bas n'est que jouissance temporaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide les autres est récompensé." }
  ],
  munajat: `Ya Rashid, guide-moi pour que je guide les autres. Ne permets pas que je garde la guidance pour moi. Donne-moi de partager le chemin de la droiture.`
};

MIROIR["40:39"] = {
  reference: "40:39",
  theme: ["vie", "jouissance", "éternité"],
  emotion: "Sagesse, détachement",
  difficulty: "débutant",
  relatedNames: ["Al-Dunya", "Al-Akhirah"],
  mirrorVersion: `« Ô mon peuple ! Cette vie d'ici-bas n'est que jouissance temporaire, alors que l'au-delà est la demeure de la stabilité. » Le miroir me montre la différence entre les deux vies. « Ya qawmi innama hadhihi al-hayatu al-dunya mata'un wa inna al-akhirata hiya daru al-qarar » — ô mon peuple ! Cette vie d'ici-bas n'est que jouissance temporaire, alors que l'au-delà est la demeure de la stabilité. La différence est claire. Le miroir m'interroge : sur quelle vie je me concentre ?`,
  reflection: `Cette vie est une jouissance temporaire. L'au-delà est la demeure de la stabilité. La concentration sur l'au-delà est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya qawmi innama hadhihi al-hayatu al-dunya mata'un wa inna al-akhirata hiya daru al-qarar » — ô mon peuple ! Cette vie d'ici-bas n'est que jouissance temporaire, alors que l'au-delà est la demeure de la stabilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quelle vie je me concentre ? La temporaire ou l'éternelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La concentration sur l'au-delà est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Quiconque fait une mauvaise action ne sera rétribué que de son semblable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se concentre sur l'au-delà trouve la stabilité." }
  ],
  munajat: `Ya Rabb, je me concentre sur l'au-delà. Ne permets pas que je sois distrait par cette vie. Donne-moi la sagesse du détachement.`
};

MIROIR["40:40"] = {
  reference: "40:40",
  theme: ["rétribution", "équité", "paradis"],
  emotion: "Justice, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Jazaa"],
  mirrorVersion: `« Quiconque fait une mauvaise action ne sera rétribué que de son semblable. Et quiconque fait une bonne action, homme ou femme, en étant croyant... ceux-là entreront au paradis. » Le miroir me montre l'équité de la rétribution. « Man 'amila sayyi'atan fa-la yujza illa mithlaha » — quiconque fait une mauvaise action ne sera rétribué que de son semblable. L'équité est parfaite. Le miroir m'interroge : quelle est ma rétribution ?`,
  reflection: `La mauvaise action est rétribuée par son semblable. La bonne action, par le paradis. L'équité est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man 'amila sayyi'atan fa-la yujza illa mithlaha wa man 'amila salihan min dhakarin aw untha wa huwa mu'minin fa-ula'ika yadkhuluna al-jannata yurzaquna fiha bighayri hisab » — quiconque fait une mauvaise action ne sera rétribué que de son semblable. Et quiconque fait une bonne action, homme ou femme, en étant croyant... ceux-là entreront au paradis et y seront pourvus sans compte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma rétribution ? Serai-je parmi les gens du paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne action avec foi mène au paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision au paradis est sans compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien avec foi entre au paradis." }
  ],
  munajat: `Ya Rabb, je veux entrer au paradis. Ne permets pas que je sois rétribué pour le mal. Donne-moi la bonne action avec foi.`
};

MIROIR["40:41"] = {
  reference: "40:41",
  theme: ["appel", "chemin", "contradiction"],
  emotion: "Méditation, perplexité",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Dalal"],
  mirrorVersion: `« Ô mon peuple ! Qu'ai-je à vous appeler au salut alors que vous m'appelez au feu ? » Le miroir me montre la contradiction des voies. « Ya qawmi ma li ad'ukum ila al-najati wa tad'ununi ila al-nar » — ô mon peuple ! Qu'ai-je à vous appeler au salut alors que vous m'appelez au feu ? La contradiction est flagrante. Le miroir m'interroge : quelle voix j'écoute ?`,
  reflection: `Le croyant appelait au salut mais son peuple l'appelait au feu. Les voies sont contradictoires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya qawmi ma li ad'ukum ila al-najati wa tad'ununi ila al-nar tad'ununi li-akfura bi-Allahi » — ô mon peuple ! Qu'ai-je à vous appeler au salut alors que vous m'appelez au feu ? Vous m'appelez à mécroire en Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle voix j'écoute ? Celle du salut ou celle du feu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'écoute de la voix du salut est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Et à Lui associer ce dont je n'ai pas de science." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute la voix du salut est sauvé." }
  ],
  munajat: `Ya Najat, j'écoute Ta voix. Ne permets pas que j'écoute la voix du feu. Donne-moi d'être parmi les sauvés.`
};

MIROIR["40:42"] = {
  reference: "40:42",
  theme: ["association", "ignorance", "appel"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ilm"],
  mirrorVersion: `« Vous m'appelez à mécroire en Allah et à Lui associer ce dont je n'ai pas de science, alors que je vous appelle vers le Puissant, le Grand Pardonneur. » Le miroir me montre la différence des appels. « Tad'ununi li-akfura bi-Allahi wa ushrika bihi ma laysa li bihi 'ilmun » — vous m'appelez à mécroire en Allah et à Lui associer ce dont je n'ai pas de science. L'appel des mécréants est basé sur l'ignorance. Le miroir m'interroge : sur quoi est basé mon appel ?`,
  reflection: `L'appel des mécréants est basé sur l'ignorance. L'appel du croyant est vers le Puissant, le Grand Pardonneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tad'ununi li-akfura bi-Allahi wa ushrika bihi ma laysa li bihi 'ilmun wa ana ad'ukum ila al-azizi al-ghaffar » — vous m'appelez à mécroire en Allah et à Lui associer ce dont je n'ai pas de science, alors que je vous appelle vers le Puissant, le Grand Pardonneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi est basé mon appel ? La vérité ou l'ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel vers Allah est le bon appel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a de doute que les égarés sont dans l'erreur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle vers Allah est guidé." }
  ],
  munajat: `Ya Ghaffar, j'appelle vers Toi. Ne permets pas que j'appelle vers l'ignorance. Donne-moi de connaître la vérité.`
};

MIROIR["40:43"] = {
  reference: "40:43",
  theme: ["invocation", "réponse", "égarement"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Dalal"],
  mirrorVersion: `« Nul doute que ce que vous m'appelez vers lui n'a pas de réponse en ce monde ni dans l'au-delà. » Le miroir me montre la futilité de l'invocation des idoles. « La jarama annama tad'ununi ilayhi laysa lahu da'watun fi al-dunya wa la fi al-akhirati » — nul doute que ce que vous m'appelez vers lui n'a pas de réponse. Les idoles sont muettes. Le miroir m'interroge : qui peut répondre à mon invocation ?`,
  reflection: `Les idoles ne répondent ni dans ce monde ni dans l'au-delà. Seul Allah répond.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La jarama annama tad'ununi ilayhi laysa lahu da'watun fi al-dunya wa la fi al-akhirati wa anna raddana ila Allahi wa anna al-musrifina hum ashabu al-nar » — nul doute que ce que vous m'appelez vers lui n'a pas de réponse en ce monde ni dans l'au-delà. Notre retour est vers Allah, et les outranciers sont les gens du feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui peut répondre à mon invocation ? Les idoles ou Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation d'Allah seule a une réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les outranciers sont les gens du feu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul reçoit une réponse." }
  ],
  munajat: `Ya Mujib, j'invoque Toi seul. Ne permets pas que j'invoque les idoles muettes. Donne-moi une réponse de Toi.`
};

MIROIR["40:44"] = {
  reference: "40:44",
  theme: ["remise", "jugement", "patience"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Hakam"],
  mirrorVersion: `« Et je vous remets à Allah. Car Allah voit bien Ses serviteurs. » Le miroir me montre la remise totale à Allah. « Fa-ufawwidu amri ila Allahi inna Allaha basirun bi-al-'ibad » — et je vous remets à Allah. Car Allah voit bien Ses serviteurs. La remise est totale. Le miroir m'interroge : est-ce que je remets mes affaires à Allah ?`,
  reflection: `Le croyant remettait son peuple à Allah. Allah voit bien Ses serviteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ufawwidu amri ila Allahi inna Allaha basirun bi-al-'ibad » — et je vous remets à Allah. Car Allah voit bien Ses serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remets mes affaires à Allah ? Ou est-ce que je garde le fardeau ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La remise à Allah est la paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah le protégea des maux qu'ils tramaient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remet ses affaires à Allah est protégé." }
  ],
  munajat: `Ya Wakil, je remets mes affaires à Toi. Ne permets pas que je garde le fardeau. Donne-moi la paix de la remise totale.`
};

MIROIR["40:45"] = {
  reference: "40:45",
  theme: ["protection", "complot", "méricorde"],
  emotion: "Gratitude, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Kayd"],
  mirrorVersion: `« Allah le protégea des maux qu'ils tramaient, et le châtiment de l'enfer enveloppa les gens de Pharaon. » Le miroir me montre la protection divine. « Fa-waqahu Allahu sayyi'ati ma makaru » — Allah le protégea des maux qu'ils tramaient. La protection est réelle. Le miroir m'interroge : est-ce que je demande la protection d'Allah ?`,
  reflection: `Allah a protégé le croyant des complots de Pharaon. Le châtiment a enveloppé les injustes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-waqahu Allahu sayyi'ati ma makaru wa haqa bi ali fir'awna su'u al-adab » — Allah le protégea des maux qu'ils tramaient, et le châtiment de l'enfer enveloppa les gens de Pharaon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la protection d'Allah ? Ou est-ce que je me protège moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est la vraie protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment de l'enfer est le pire châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la protection d'Allah est protégé." }
  ],
  munajat: `Ya Hafiz, protège-moi des complots. Ne permets pas que je sois enveloppé par le châtiment. Donne-moi Ta protection divine.`
};

MIROIR["40:46"] = {
  reference: "40:46",
  theme: ["enfer", "présentation", "horreur"],
  emotion: "Effroi, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Mawt"],
  mirrorVersion: `« Le feu, auquel ils sont exposés matin et soir. Et le jour où l'Heure arrivera... » Le miroir me montre l'exposition à l'enfer. « Al-naru yu'raduna 'alayha ghuduwwan wa 'ashiyyan » — le feu, auquel ils sont exposés matin et soir. L'exposition est constante. Le miroir m'interroge : est-ce que je crains cette exposition ?`,
  reflection: `Les gens de Pharaon sont exposés au feu matin et soir. Le Jour de l'Heure, ils seront jetés dans le pire châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-naru yu'raduna 'alayha ghuduwwan wa 'ashiyyan wa yawma taqumu al-sa'atu adkhilu ala fir'awna ashadda al-adab » — le feu, auquel ils sont exposés matin et soir. Et le jour où l'Heure arrivera : Faites entrer les gens de Pharaon dans le pire châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains cette exposition ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte de l'enfer mène à la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pire châtiment est pour les injustes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'enfer l'évite." }
  ],
  munajat: `Ya Rabb, je crains l'enfer. Ne permets pas que j'y sois exposé. Donne-moi la crainte qui mène au salut.`
};

MIROIR["40:47"] = {
  reference: "40:47",
  theme: ["enfer", "dispute", "responsabilité"],
  emotion: "Dramatique, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Hujjah"],
  mirrorVersion: `« Et quand ils se disputeront dans le feu, les faibles diront à ceux qui s'enorgueillissaient : Nous vous avons suivis. » Le miroir me montre la dispute en enfer. « Wa idha tahaajau fi al-nari fa-qala al-du'afa'u lilladhina istakbaru » — et quand ils se disputeront dans le feu, les faibles diront à ceux qui s'enorgueillissaient. La dispute est inévitable. Le miroir m'interroge : qui je suivrai ?`,
  reflection: `Les faibles diront aux orgueilleux : Nous vous avons suivis. Pouvez-vous nous alléger une partie du feu ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha tahaajau fi al-nari fa-qala al-du'afa'u lilladhina istakbaru inna kunna lakum taba'an fa-hal antum mughnuna 'anna nasiban mina al-nar » — et quand ils se disputeront dans le feu, les faibles diront à ceux qui s'enorgueillissaient : Nous vous avons suivis. Pouvez-vous nous alléger une partie du feu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je suivrai ? Les orgueilleux ou les véridiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le suivi des véridiques mène au paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les orgueilleux diront : Nous y sommes tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les véridiques n'est pas dans la dispute." }
  ],
  munajat: `Ya Rabb, je veux suivre les véridiques. Ne permets pas que je suive les orgueilleux. Donne-moi la guidance vers le bon chemin.`
};

MIROIR["40:48"] = {
  reference: "40:48",
  theme: ["enfer", "arrogance", "désespoir"],
  emotion: "Désespoir, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Kibr"],
  mirrorVersion: `« Ceux qui s'enorgueillissaient diront : Nous y sommes tous. Allah a déjà jugé entre les serviteurs. » Le miroir me montre la réponse des orgueilleux. « Qala alladhina istakbaru inna kullun fiha » — ceux qui s'enorgueillissaient diront : Nous y sommes tous. Le désespoir est total. Le miroir m'interroge : est-ce que je veux être parmi eux ?`,
  reflection: `Les orgueilleux diront : Nous sommes tous en enfer. Allah a déjà jugé entre les serviteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala alladhina istakbaru inna kullun fiha inna Allaha qad hakama bayna al-'ibad » — ceux qui s'enorgueillissaient diront : Nous y sommes tous. Allah a déjà jugé entre les serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux être parmi eux ? Ou est-ce que je veux être sauvé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet de l'orgueil mène au salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah est sans appel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejette l'orgueil n'est pas parmi les orgueilleux." }
  ],
  munajat: `Ya Rabb, je veux être sauvé. Ne permets pas que je sois parmi les orgueilleux. Donne-moi l'humilité qui mène au salut.`
};

MIROIR["40:49"] = {
  reference: "40:49",
  theme: ["enfer", "supplication", "désespoir"],
  emotion: "Désespoir, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Du'a"],
  mirrorVersion: `« Et ceux qui sont dans le feu diront aux gardiens de l'enfer : Priez votre Seigneur de nous alléger un jour du châtiment. » Le miroir me montre la supplication des damnés. « Wa qala alladhina fi al-nari li-khazanati jahannama ud'u rabbakum » — et ceux qui sont dans le feu diront aux gardiens de l'enfer : Priez votre Seigneur. La supplication est désespérée. Le miroir m'interroge : est-ce que je prie maintenant ou attendrai-je d'être en enfer ?`,
  reflection: `Les damnés demandent un allégement d'un jour du châtiment. Mais les gardiens diront : Vos messagers ne vous ont-ils pas apporté les preuves ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala alladhina fi al-nari li-khazanati jahannama ud'u rabbakum yukhaffifa 'anna yawman mina al-adab » — et ceux qui sont dans le feu diront aux gardiens de l'enfer : Priez votre Seigneur de nous alléger un jour du châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie maintenant ? Ou attendrai-je d'être en enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière maintenant est plus efficace que la supplication en enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les messagers ont apporté les preuves." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie maintenant n'a pas besoin de supplier en enfer." }
  ],
  munajat: `Ya Rabb, je prie maintenant. Ne permets pas que je sois parmi les suppliciants de l'enfer. Donne-moi la prière qui prévient le châtiment.`
};

MIROIR["40:50"] = {
  reference: "40:50",
  theme: ["enfer", "messagers", "négation"],
  emotion: "Réalité, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Bayan"],
  mirrorVersion: `« Ils diront : Vos messagers ne vous ont-ils pas apporté les preuves évidentes ? Ils diront : Si. » Le miroir me montre l'aveu des damnés. « Qalu awa lam ta'tikum rusulukum bi-al-bayyinati qalu bala » — ils diront : Vos messagers ne vous ont-ils pas apporté les preuves ? Ils diront : Si. L'aveu vient trop tard. Le miroir m'interroge : est-ce que j'accepte les preuves maintenant ?`,
  reflection: `Les damnés avouent que les messagers ont apporté les preuves. Mais ils ont traité les messagers de menteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu awa lam ta'tikum rusulukum bi-al-bayyinati qalu bala qalu fa'du wama yuhada'u lilkafirin » — ils diront : Vos messagers ne vous ont-ils pas apporté les preuves évidentes ? Ils diront : Si. Ils diront : Invoquez ! Mais l'invocation des mécréants est vaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les preuves maintenant ? Ou attendrai-je d'être en enfer pour l'avouer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des preuves maintenant évite le regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invocation des mécréants est vaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les preuves maintenant n'a pas de regret." }
  ],
  munajat: `Ya Rabb, j'accepte les preuves maintenant. Ne permets pas que je sois parmi ceux qui avouent trop tard. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["40:51"] = {
  reference: "40:51",
  theme: ["victoire", "messagers", "foi"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Nasr", "Al-Haqq"],
  mirrorVersion: `« Nous secourrons certes Nos messagers et ceux qui croient, dans la vie présente. » Le miroir me montre la promesse de victoire. « Inna la-nansuru rusulana wa alladhina amanu fi al-hayati al-dunya » — Nous secourrons certes Nos messagers et ceux qui croient. Le secours est certain. Le miroir m'interroge : est-ce que j'ai confiance en cette promesse ?`,
  reflection: `Allah secourt Ses messagers et les croyants dans la vie présente et au Jour où les témoins se lèveront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna la-nansuru rusulana wa alladhina amanu fi al-hayati al-dunya wa yawma yaqumu al-ashhadun » — Nous secourrons certes Nos messagers et ceux qui croient, dans la vie présente et au Jour où les témoins se lèveront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai confiance en cette promesse ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en la promesse est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour des témoins est certain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la promesse reçoit le secours." }
  ],
  munajat: `Ya Nasir, j'ai confiance en Ta promesse. Ne permets pas que je doute. Donne-moi le secours dans la vie présente et au Jour du Jugement.`
};

MIROIR["40:52"] = {
  reference: "40:52",
  theme: ["excuses", "injustice", "jugement"],
  emotion: "Réalité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hujjah", "Al-Adl"],
  mirrorVersion: `« Le jour où les excuses des injustes ne leur seront d'aucune utilité. » Le miroir me montre l'inutilité des excuses. « Yawma la yanfa'u al-zalimina ma'dhiratuhum » — le jour où les excuses des injustes ne leur seront d'aucune utilité. Les excuses sont vaines. Le miroir m'interroge : est-ce que je prépare autre chose que des excuses ?`,
  reflection: `Les excuses des injustes ne serviront à rien ce Jour-là. Il y aura la malédiction et la mauvaise demeure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma la yanfa'u al-zalimina ma'dhiratuhum wa lahum al-la'natu wa lahum su'u al-dar » — le jour où les excuses des injustes ne leur seront d'aucune utilité. Il y aura la malédiction pour eux et la mauvaise demeure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare autre chose que des excuses ? Des bonnes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bonnes actions maintenant valent mieux que les excuses après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La malédiction et la mauvaise demeure attendent les injustes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare les bonnes actions n'a pas besoin d'excuses." }
  ],
  munajat: `Ya Adl, je prépare les bonnes actions. Ne permets pas que je sois parmi les injustes. Donne-moi d'éviter la malédiction et la mauvaise demeure.`
};

MIROIR["40:54"] = {
  reference: "40:54",
  theme: ["guidance", "rappel", "sagesse"],
  emotion: "Gratitude, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Dhikra"],
  mirrorVersion: `« Comme guidance et rappel pour les doués d'intelligence. » Le miroir me montre le but de la révélation. « Hudan wa dhikra li-uli al-albab » — comme guidance et rappel pour les doués d'intelligence. La révélation est pour les intelligents. Le miroir m'interroge : suis-je parmi les doués d'intelligence ?`,
  reflection: `La révélation est une guidance et un rappel pour ceux qui ont de l'intelligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hudan wa dhikra li-uli al-albab » — comme guidance et rappel pour les doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les doués d'intelligence ? Ou est-ce que je néglige la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intelligence est de suivre la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est un don pour les intelligents." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance est intelligent." }
  ],
  munajat: `Ya Hadi, je suis Ta guidance. Ne permets pas que je sois négligent. Donne-moi l'intelligence qui suit la guidance.`
};

MIROIR["40:55"] = {
  reference: "40:55",
  theme: ["patience", "prière", "promesse"],
  emotion: "Confiance, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Sabr", "Al-Salah"],
  mirrorVersion: `« Patiente donc, car la promesse d'Allah est vérité. Implore le pardon pour ton péché et célèbre les louanges de ton Seigneur. » Le miroir me montre les trois devoirs du croyant. « Fa-isbir inna wa'da Allahi haqqun wa istaghfir dhanbaka wa sabbih bi-hamdi rabbika » — patiente donc, car la promesse d'Allah est vérité. Implore le pardon et célèbre les louanges. Les trois devoirs sont clairs. Le miroir m'interroge : est-ce que j'accomplis ces trois devoirs ?`,
  reflection: `Le croyant doit patienter, implorer le pardon et célébrer les louanges d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-isbir inna wa'da Allahi haqqun wa istaghfir dhanbaka wa sabbih bi-hamdi rabbika bi-al-'ashiyyi wa al-ibkar » — patiente donc, car la promesse d'Allah est vérité. Implore le pardon pour ton péché et célèbre les louanges de ton Seigneur, soir et matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accomplis ces trois devoirs ? La patience, le pardon, la louange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les trois devoirs sont le chemin de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accomplit les trois devoirs est sur la voie droite." }
  ],
  munajat: `Ya Rabb, j'accomplis les trois devoirs. Ne permets pas que je les néglige. Donne-moi la patience, le pardon et la louange.`
};

MIROIR["40:56"] = {
  reference: "40:56",
  theme: ["argumentation", "orgueil", "égarement"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kibr", "Al-Huda"],
  mirrorVersion: `« Ceux qui discutent les signes d'Allah sans autorité venue à eux, il n'y a dans leurs poitrines que de l'orgueil. » Le miroir me montre la source de l'argumentation. « Alladhina yujadiluna fi ayati Allahi bi-ghayri sultanin atahum in fi sudurihim illa kibrun » — ceux qui discutent les signes d'Allah, il n'y a dans leurs poitrines que de l'orgueil. L'orgueil est la source. Le miroir m'interroge : qu'y a-t-il dans ma poitrine ?`,
  reflection: `L'argumentation sans preuve vient de l'orgueil. Ils n'atteindront pas leur but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yujadiluna fi ayati Allahi bi-ghayri sultanin atahum in fi sudurihim illa kibrun ma hum bi-balighihi fasta'id bi-Allahi innahu huwa al-sami'u al-basir » — ceux qui discutent les signes d'Allah sans autorité venue à eux, il n'y a dans leurs poitrines que de l'orgueil qu'ils n'atteindront pas. Cherche refuge auprès d'Allah, car c'est Lui l'Audient, le Clairvoyant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'y a-t-il dans ma poitrine ? De l'orgueil ou de l'humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans le cœur est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ils n'atteindront pas leur but." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a de l'humilité dans le cœur est protégé." }
  ],
  munajat: `Ya Sami', Ya Basir, je cherche refuge auprès de Toi contre l'orgueil. Ne permets pas que mon cœur soit rempli d'orgueil. Donne-moi l'humilité qui mène à Toi.`
};

MIROIR["40:57"] = {
  reference: "40:57",
  theme: ["création", "résurrection", "comparaison"],
  emotion: "Émerveillement, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Ba'ath"],
  mirrorVersion: `« La création des cieux et de la terre est plus grande que la création des hommes. » Le miroir me montre la grandeur de la création. « La-khalqu al-samawati wa al-ardi akbaru min khalqi al-nas » — la création des cieux et de la terre est plus grande que la création des hommes. La comparaison est claire. Le miroir m'interroge : est-ce que je médite sur la grandeur de la création ?`,
  reflection: `La création des cieux et de la terre est plus grande que la création des hommes. Mais la plupart des hommes ne savent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-khalqu al-samawati wa al-ardi akbaru min khalqi al-nas wa lakinnna akthara al-nasi la ya'lamun » — la création des cieux et de la terre est plus grande que la création des hommes. Mais la plupart des hommes ne savent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur la grandeur de la création ? Ou est-ce que je passe sans voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation sur la création mène à la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La plupart des hommes ne savent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la création connaît le Créateur." }
  ],
  munajat: `Ya Khaliq, je médite sur Ta création. Ne permets pas que je sois parmi ceux qui ne savent pas. Donne-moi la méditation qui mène à Toi.`
};

MIROIR["40:58"] = {
  reference: "40:58",
  theme: ["comparaison", "vie", "mort"],
  emotion: "Méditation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Mayyit"],
  mirrorVersion: `« L'aveugle et le voyant ne sont pas égaux, ni les croyants qui font le bien et les mauvais. » Le miroir me montre les inégalités fondamentales. « Wa ma yastawi al-a'ma wa al-basir wa alladhina amanu wa 'amilu al-salihati wa la al-musihu » — l'aveugle et le voyant ne sont pas égaux. Les croyants et les mauvais non plus. L'inégalité est fondamentale. Le miroir m'interroge : à quel groupe j'appartiens ?`,
  reflection: `L'aveugle et le voyant ne sont pas égaux. Les croyants et les mauvais non plus. Peu d'hommes se rappellent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yastawi al-a'ma wa al-basir wa alladhina amanu wa 'amilu al-salihati wa la al-musihu qalilan ma tatadhakkarun » — l'aveugle et le voyant ne sont pas égaux, ni les croyants qui font le bien et les mauvais. Peu d'entre vous se rappellent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quel groupe j'appartiens ? Aux croyants ou aux mauvais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix du groupe est crucial." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Peu d'hommes se rappellent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le bon groupe se rappelle." }
  ],
  munajat: `Ya Rabb, je choisis le groupe des croyants. Ne permets pas que je sois parmi les mauvais. Donne-moi de me rappeler.`
};

MIROIR["40:59"] = {
  reference: "40:59",
  theme: ["heure", "certitude", "doute"],
  emotion: "Certitude, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Sa'ah", "Al-Yaqin"],
  mirrorVersion: `« L'Heure approche, il n'y a pas de doute à son sujet. » Le miroir me montre la certitude de l'Heure. « Inna al-sa'ata atiyatun la rayba fiha » — l'Heure approche, il n'y a pas de doute à son sujet. La certitude est totale. Le miroir m'interroge : est-ce que j'ai la certitude de l'Heure ?`,
  reflection: `L'Heure approche sans doute. Mais la plupart des hommes ne croient pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-sa'ata atiyatun la rayba fiha wa lakinnna akthara al-nasi la yu'minun » — l'Heure approche, il n'y a pas de doute à son sujet. Mais la plupart des hommes ne croient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai la certitude de l'Heure ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de l'Heure mène à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La plupart des hommes ne croient pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en l'Heure se prépare." }
  ],
  munajat: `Ya Rabb, j'ai la certitude de l'Heure. Ne permets pas que je sois parmi ceux qui ne croient pas. Donne-moi la préparation pour l'Heure.`
};

MIROIR["40:60"] = {
  reference: "40:60",
  theme: ["invocation", "réponse", "orgueil"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Da'wah"],
  mirrorVersion: `« Et votre Seigneur dit : Invoquez-Moi, Je vous répondrai. Ceux qui s'enorgueillissent de Mon adoration entreront bientôt dans l'enfer, humiliés. » Le miroir me montre l'invitation à l'invocation. « Wa qala rabbukumu ud'uni astajib lakum » — et votre Seigneur dit : Invoquez-Moi, Je vous répondrai. L'invitation est claire. Le miroir m'interroge : est-ce que j'invoque Allah ?`,
  reflection: `Allah invite à l'invoquer et promet la réponse. Mais les orgueilleux qui refusent Son adoration entreront en enfer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala rabbukumu ud'uni astajib lakum inna alladhina yastakbiruna 'an 'ibadati sayadkhuluna jahannama dakhirin » — et votre Seigneur dit : Invoquez-Moi, Je vous répondrai. Ceux qui s'enorgueillissent de Mon adoration entreront bientôt dans l'enfer, humiliés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah ? Ou est-ce que je m'enorgueillis de Son adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation avec humilité est la clé de la réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les orgueilleux seront humiliés en enfer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque avec humilité reçoit la réponse." }
  ],
  munajat: `Ya Mujib, j'invoque avec humilité. Ne permets pas que je m'enorgueillis. Donne-moi la réponse à mon invocation.`
};

MIROIR["40:61"] = {
  reference: "40:61",
  theme: ["nuit", "jour", "bénédictions"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Nahar"],
  mirrorVersion: `« Allah est Celui qui a fait pour vous la nuit pour que vous y reposiez, et le jour pour que vous y voyiez. » Le miroir me montre les bénédictions du temps. « Allahu alladhi ja'ala lakumu al-layla li-taskunu fihi wa al-nahara mubsiran » — Allah est Celui qui a fait pour vous la nuit pour que vous y reposiez, et le jour pour que vous y voyiez. Les bénédictions sont évidentes. Le miroir m'interroge : est-ce que je suis reconnaissant pour ces bénédictions ?`,
  reflection: `La nuit pour le repos et le jour pour la vision sont des bénédictions d'Allah. Mais la plupart des hommes ne sont pas reconnaissants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi ja'ala lakumu al-layla li-taskunu fihi wa al-nahara mubsiran inna Allaha la-dhu fadlin 'ala al-nas wa lakinnna akthara al-nasi la yashkurun » — Allah est Celui qui a fait pour vous la nuit pour que vous y reposiez, et le jour pour que vous y voyiez. Allah est Plein de grâce pour les hommes, mais la plupart des hommes ne sont pas reconnaissants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour ces bénédictions ? Ou est-ce que je les oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance pour les bénédictions est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La plupart des hommes ne sont pas reconnaissants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant reconnaît les bénédictions." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour la nuit et le jour. Ne permets pas que je sois parmi les ingrats. Donne-moi la reconnaissance constante.`
};

MIROIR["40:62"] = {
  reference: "40:62",
  theme: ["créateur", "divinités", "unicité"],
  emotion: "Certitude, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« C'est Lui Allah, votre Seigneur, Créateur de toute chose. Il n'y a de divinité que Lui. » Le miroir me montre l'unicité du Créateur. « Dhalikumu Allahu rabbukum khaliqu kulli shay'in la ilaha illa huwa » — c'est Lui Allah, votre Seigneur, Créateur de toute chose. Il n'y a de divinité que Lui. L'unicité est totale. Le miroir m'interroge : est-ce que je reconnais cette unicité ?`,
  reflection: `Allah est le Créateur de toute chose. Il n'y a de divinité que Lui. Comment pouvez-vous vous détourner ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalikumu Allahu rabbukum khaliqu kulli shay'in la ilaha illa huwa fa-anna tu'fakun » — c'est Lui Allah, votre Seigneur, Créateur de toute chose. Il n'y a de divinité que Lui. Comment vous détournez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais cette unicité ? Ou est-ce que je me détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'unicité est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Comment pouvez-vous vous détourner ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'unicité ne se détourne pas." }
  ],
  munajat: `Ya Wahid, je reconnais Ton unicité. Ne permets pas que je me détourne. Donne-moi la foi en l'unicité parfaite.`
};

MIROIR["40:63"] = {
  reference: "40:63",
  theme: ["détournement", "signes", "mésiance"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Kufr"],
  mirrorVersion: `« Ainsi se détournent ceux qui renient les signes d'Allah. » Le miroir me montre le détournement des négateurs. « Kadhalika yu'tafu alladhina kanu bi-ayati Allahi yajhadun » — ainsi se détournent ceux qui renient les signes d'Allah. Le détournement est leur caractéristique. Le miroir m'interroge : est-ce que je renie les signes d'Allah ?`,
  reflection: `Ceux qui renient les signes d'Allah se détournent. Le détournement est la marque de la mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika yu'tafu alladhina kanu bi-ayati Allahi yajhadun » — ainsi se détournent ceux qui renient les signes d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je renie les signes d'Allah ? Ou est-ce que je les accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des signes est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le détournement est la marque de la mécréance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes ne se détourne pas." }
  ],
  munajat: `Ya Rabb, j'accepte Tes signes. Ne permets pas que je me détourne. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["40:64"] = {
  reference: "40:64",
  theme: ["création", "terre", "formes"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Allah est Celui qui a fait pour vous la terre comme lieu de séjour et le ciel comme toit. » Le miroir me montre la providence dans la création. « Allahu alladhi ja'ala lakumu al-arda qararan wa al-sama'a bina'an » — Allah est Celui qui a fait pour vous la terre comme lieu de séjour et le ciel comme toit. La providence est visible. Le miroir m'interroge : est-ce que je vois cette providence ?`,
  reflection: `Allah a fait la terre comme lieu de séjour et le ciel comme toit. Il vous a donné votre forme et a embelli vos formes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi ja'ala lakumu al-arda qararan wa al-sama'a bina'an wa sawwarakum fa-ahsana suwarakum wa razaqakum mina al-tayyibat » — Allah est Celui qui a fait pour vous la terre comme lieu de séjour et le ciel comme toit. Il vous a donné votre forme et a embelli vos formes. Il vous a pourvus de bonnes choses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois cette providence ? Ou est-ce que je suis aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vue de la providence est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "C'est Lui Allah, votre Seigneur. Béni soit Allah, Seigneur des mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la providence voit Allah partout." }
  ],
  munajat: `Ya Musawwir, je vois Ta providence dans la création. Ne permets pas que je sois aveugle. Donne-moi la vue qui reconnaît Tes bénédictions.`
};

MIROIR["40:65"] = {
  reference: "40:65",
  theme: ["vie", "adoration", "unicité"],
  emotion: "Révérence, adoration",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Qayyum"],
  mirrorVersion: `« C'est Lui le Vivant. Il n'y a de divinité que Lui. Invoquez-Le en Lui vouant un culte exclusif. » Le miroir me montre l'essence divine. « Huwa al-hayyu la ilaha illa huwa fa'duhu mukhlisina lahu al-din » — c'est Lui le Vivant. Il n'y a de divinité que Lui. Invoquez-Le en Lui vouant un culte exclusif. L'essence est le Vivant. Le miroir m'interroge : est-ce que j'invoque le Vivant exclusivement ?`,
  reflection: `Allah est le Vivant. Il n'y a de divinité que Lui. Louange à Allah, Seigneur des mondes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa al-hayyu la ilaha illa huwa fa'duhu mukhlisina lahu al-din al-hamdu lillahi rabbi al-alamin » — c'est Lui le Vivant. Il n'y a de divinité que Lui. Invoquez-Le en Lui vouant un culte exclusif. Louange à Allah, Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque le Vivant exclusivement ? Ou est-ce que j'invoque d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation exclusive du Vivant est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Louange à Allah, Seigneur des mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque le Vivant exclusivement trouve la vie." }
  ],
  munajat: `Ya Hayy, je T'invoque exclusivement. Ne permets pas que j'invoque d'autres. Donne-moi la vie éternelle par Ton invocation.`
};

MIROIR["40:66"] = {
  reference: "40:66",
  theme: ["interdiction", "adoration", "révélation"],
  emotion: "Soumission, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Ibadah"],
  mirrorVersion: `« Dis : Il m'a été interdit d'adorer ceux que vous invoquez en dehors d'Allah, puisque les preuves évidentes me sont venues de mon Seigneur. » Le miroir me montre l'interdiction de l'association. « Qul inni nuhitu an a'buda alladhina tad'una min duni Allahi » — dis : Il m'a été interdit d'adorer ceux que vous invoquez en dehors d'Allah. L'interdiction est claire. Le miroir m'interroge : est-ce que j'évite l'association ?`,
  reflection: `Le Prophète a été interdit d'adorer les idoles. Il a été ordonné de se soumettre au Seigneur des mondes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inni nuhitu an a'buda alladhina tad'una min duni Allahi lamma ja'aniyya al-bayyinatu min rabbi wa umirtu an uslima li-rabbi al-alamin » — dis : Il m'a été interdit d'adorer ceux que vous invoquez en dehors d'Allah, puisque les preuves évidentes me sont venues de mon Seigneur. Et il m'a été ordonné de me soumettre au Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite l'association ? Ou est-ce que j'adore d'autres qu'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement de l'association est la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La soumission au Seigneur des mondes est l'islam." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'association est soumis." }
  ],
  munajat: `Ya Rabb al-alamin, je me soumis à Toi. Ne permets pas que j'adore d'autres. Donne-moi la soumission totale à Ton commandement.`
};

MIROIR["40:67"] = {
  reference: "40:67",
  theme: ["création", "phases", "méricorde"],
  emotion: "Méditation, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« C'est Lui qui vous a créés de poussière, puis d'une goutte de sperme, puis d'un caillot de sang. » Le miroir me montre les phases de la création. « Huwa alladhi khalaqakum min turabin thumma min nutfatin » — c'est Lui qui vous a créés de poussière, puis d'une goutte de sperme. Les phases sont merveilleuses. Le miroir m'interroge : est-ce que je médite sur les phases de ma création ?`,
  reflection: `La création passe par plusieurs phases : poussière, sperme, caillot, puis Il vous fait sortir enfant, puis pour atteindre votre maturité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi khalaqakum min turabin thumma min nutfatin thumma min 'alaqatin thumma yukhrijukum tiflan » — c'est Lui qui vous a créés de poussière, puis d'une goutte de sperme, puis d'un caillot de sang. Puis Il vous fait sortir enfant, puis pour atteindre votre maturité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les phases de ma création ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation sur la création mène à la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Puis pour que vous deveniez vieux. Et il en est qui meurent avant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les phases de la création reconnaît le Créateur." }
  ],
  munajat: `Ya Khaliq, je médite sur les phases de ma création. Ne permets pas que je l'oublie. Donne-moi la reconnaissance pour Ta création merveilleuse.`
};

MIROIR["40:68"] = {
  reference: "40:68",
  theme: ["vie", "mort", "décret"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« C'est Lui qui donne la vie et qui donne la mort. Et quand Il décide une chose, Il dit seulement : Sois ! et elle est. » Le miroir me montre le pouvoir du décret. « Huwa alladhi yuhyi wa yumitu fa-idha qada amran fa-innama yaqulu lahu kun fa-yakun » — c'est Lui qui donne la vie et qui donne la mort. Quand Il décide une chose, Il dit : Sois ! et elle est. Le pouvoir est absolu. Le miroir m'interroge : est-ce que je me soumets au décret d'Allah ?`,
  reflection: `Allah donne la vie et la mort. Son décret est immédiat : Sois ! et c'est.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi yuhyi wa yumitu fa-idha qada amran fa-innama yaqulu lahu kun fa-yakun » — c'est Lui qui donne la vie et qui donne la mort. Et quand Il décide une chose, Il dit seulement : Sois ! et elle est." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumets au décret d'Allah ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission au décret est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret d'Allah est immédiat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet au décret est en paix." }
  ],
  munajat: `Ya Muhyi, Ya Mumit, je me soumets à Ton décret. Ne permets pas que je résiste. Donne-moi la soumission totale à Ta volonté.`
};

