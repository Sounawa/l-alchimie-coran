MIROIR["19:12"] = {
  reference: "19:12",
  theme: ["yahya", "livre", "force"],
  emotion: "Sagesse, détermination",
  difficulty: "débutant",
  relatedNames: ["Yahya", "Al-Kitab"],
  mirrorVersion: `« O Yahya, tiens fermement au Livre ! » Le miroir me montre l'instruction à Yahya. « Ya yahya khudhi al-kitaba bi-quwwatin » — O Yahya, tiens fermement au Livre. La fermeté dans le Livre est essentielle. Le miroir m'interroge : est-ce que je tiens fermement au Livre d'Allah ?`,
  reflection: `La fermeté dans le Livre est essentielle. Y tenir fermement est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya yahya khudhi al-kitaba bi-quwwatin » — O Yahya, tiens fermement au Livre !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens fermement au Livre d'Allah ? Ou est-ce que je le lâche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeté dans le Livre est la force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Livre est l'ancre du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient au Livre tient à la vérité." }
  ],
  munajat: `Ya Rabb, je tiens fermement à Ton Livre. Ne permets pas que je le lâche. Donne-moi la force de la fermeté.`
};

MIROIR["19:41"] = {
  reference: "19:41",
  theme: ["ibrahim", "père", "monothéisme"],
  emotion: "Sagesse, compassion",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Azar"],
  mirrorVersion: `« Mentionne dans le Livre Abraham. C'était un véridique et un prophète. » Le miroir me montre le modèle d'Abraham. « Wa dhkur fi al-kitabi ibrahima innahu kana siddiqan nabiyyan » — mentionne Abraham. C'était un véridique et un prophète. La véracité est la base. Le miroir m'interroge : est-ce que je suis sur le chemin de la véracité ?`,
  reflection: `La véracité est la base. Être véridique est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur fi al-kitabi ibrahima innahu kana siddiqan nabiyyan » — mentionne dans le Livre Abraham. C'était un véridique et un prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sur le chemin de la véracité ? Ou est-ce que je compromise la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La véracité mène à la prophétie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Abraham est le père des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique suit les pas d'Abraham." }
  ],
  munajat: `Ya Rabb, je veux être véridique comme Abraham. Ne permets pas que je compromise la vérité. Donne-moi la véracité totale.`
};

MIROIR["19:96"] = {
  reference: "19:96",
  theme: ["amour", "foi", "œuvres"],
  emotion: "Espérance, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Mahabbah", "Al-Iman"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, le Tout-Miséricordieux leur accordera Son amour. » Le miroir me montre la promesse de l'amour divin. « Inna alladhina amanu wa 'amilu al-salihati » — ceux qui croient et font de bonnes œuvres. La foi et les œuvres attirent l'amour d'Allah. Le miroir m'interroge : est-ce que j'œuvre pour attirer Son amour ?`,
  reflection: `La foi et les œuvres attirent l'amour d'Allah. Œuvrer pour Son amour est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa 'amilu al-salihati sayaj'aluu lahumu al-rahmanu wudda » — ceux qui croient et font de bonnes œuvres, le Tout-Miséricordieux leur accordera Son amour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour attirer Son amour ? Ou est-ce que je néglige les œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour d'Allah est le plus grand trésor." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour d'Allah rend aimé sur terre et au ciel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obtient Son amour obtient tout." }
  ],
  munajat: `Ya Rabb, je veux Ton amour. Ne permets pas que je le néglige. Donne-moi d'œuvrer pour attirer Ton amour.`
};

// ============ SURAH 20 (TA-HA) - Missing Entries ============

MIROIR["20:5"] = {
  reference: "20:5",
  theme: ["trône", "élévation", "souveraineté"],
  emotion: "Révérence, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Arsh", "Al-Istiwa'"],
  mirrorVersion: `« Le Tout-Miséricordieux S'est établi sur le Trône. » Le miroir me montre la majesté divine. « Ar-rahmanu 'ala al-arshi stawa » — le Tout-Miséricordieux S'est établi sur le Trône. La souveraineté absolue. Le miroir m'interroge : est-ce que je contemple Sa majesté ?`,
  reflection: `La souveraineté absolue d'Allah. Contempler Sa majesté est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ar-rahmanu 'ala al-arshi stawa » — le Tout-Miséricordieux S'est établi sur le Trône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple Sa majesté ? Ou est-ce que je L'imagine petit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contemplation de Sa majesté élève le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Trône est la plus grande des créations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple Sa majesté s'humilie devant Lui." }
  ],
  munajat: `Ya Rahman, je contemple Ta majesté. Ne permets pas que je T'imagine petit. Élève mon cœur par la contemplation de Ta grandeur.`
};

MIROIR["20:14"] = {
  reference: "20:14",
  theme: ["moïse", "adoration", "souvenir"],
  emotion: "Révérence, amour",
  difficulty: "débutant",
  relatedNames: ["Musa", "Al-Ibadah"],
  mirrorVersion: `« Moi, Je suis Allah. Nulle divinité que Moi. Adore-Moi et accomplis la prière pour Mon souvenir. » Le miroir me montre l'essence de l'adoration. « Inna ani ana Allahu la ilaha illa ana fa'budni » — Moi, Je suis Allah. Nulle divinité que Moi. Adore-Moi. L'adoration est le but. Le miroir m'interroge : est-ce que je L'adore vraiment ?`,
  reflection: `L'adoration est le but de la création. L'accomplir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ani ana Allahu la ilaha illa ana fa'budni wa aqimi al-salata li-dhikri » — Moi, Je suis Allah. Nulle divinité que Moi. Adore-Moi et accomplis la prière pour Mon souvenir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je L'adore vraiment ? Ou est-ce que j'adore autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration exclusive est la liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'existence adore Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah trouve sa raison d'être." }
  ],
  munajat: `Ya Allah, je T'adore. Ne permets pas que j'adore autre chose. Fais que mon adoration soit exclusive et sincère.`
};

MIROIR["20:114"] = {
  reference: "20:114",
  theme: ["jugement", "vérité", "supériorité"],
  emotion: "Certitude, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-A'la"],
  mirrorVersion: `« Exalté soit Allah, le Vrai Souverain ! Ne te hâte pas de réciter le Coran avant que sa révélation ne soit complète. » Le miroir me montre la patience dans la révélation. « Ta'ala Allahu al-maliku al-haqq » — exalté soit Allah, le Vrai Souverain. La vérité appartient à Allah. Le miroir m'interroge : est-ce que j'accepte la vérité d'Allah ?`,
  reflection: `La vérité appartient à Allah. L'accepter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta'ala Allahu al-maliku al-haqq » — exalté soit Allah, le Vrai Souverain !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la vérité d'Allah ? Ou est-ce que je veux ma propre vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de Sa vérité est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Vrai Souverain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte Sa vérité trouve la vraie vie." }
  ],
  munajat: `Ya Haqq, j'accepte Ta vérité. Ne permets pas que je veuille ma propre vérité. Donne-moi la soumission à Ta vérité.`
};

