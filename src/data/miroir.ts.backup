MIROIR["77:12"] = {
  reference: "77:12",
  theme: ["jour", "question", "délai"],
  emotion: "Attente, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yawm", "Al-Ajal"],
  mirrorVersion: `« À quel jour cela a-t-il été différé ? » La question du délai. Le miroir m'enseigne : le Jour a été différé. Mais le délai n'est pas l'oubli.`,
  reflection: `Le Jour a été différé. Mais le délai n'est pas l'oubli.`,
  tajalli: [
