    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'implore Allah ? Est-ce que je joins ma voix à l'invocation universelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation n'est pas besoin mais relation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en état d'invocation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui implore rejoint le chœur des créatures." }
  ],
  munajat: `Ya Mujib, toutes les créatures T'implorent. Fais que je m'unisse à leur invocation. Réponds à ma demande comme Tu réponds à toutes.`
};

