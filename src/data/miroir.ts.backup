    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi stabilise comme les montagnes stabilisent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont les piquets de la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une foi stable est stable comme les montagnes." }
  ],
  munajat: `Ya Rabb, donne-moi une foi stable. Stabilise ma vie comme les montagnes stabilisent la terre.`
};

