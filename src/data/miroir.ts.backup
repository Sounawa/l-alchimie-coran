    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la sécurité du paradis l'obtient." }
  ],
  munajat: `Ya Rabb, je cherche la sécurité de Ton paradis. Ne permets pas que je me contente de l'insécurité de ce monde. Donne-moi la paix éternelle.`
};

MIROIR["15:47"] = {
  reference: "15:47",
  theme: ["cœurs", "purification", "fraternité"],
