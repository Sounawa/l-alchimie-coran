    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la lumière du soleil reconnaît la lumière divine." }
  ],
  munajat: `Ya Rabb, merci pour la lampe brûlante. Illumine ma vie avec Ta lumière divine.`
};

