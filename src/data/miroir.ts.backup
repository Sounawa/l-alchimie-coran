    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon visage sera-t-il resplendissant ? La beauté intérieure est-elle présente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté intérieure crée la beauté extérieure." },
