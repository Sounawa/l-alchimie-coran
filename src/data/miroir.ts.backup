  relatedNames: ["Al-Sama", "Al-Furuj"],
  mirrorVersion: `« Et que le ciel sera fendu. » La fente du ciel. Le miroir m'enseigne : le ciel lui-même sera fendu. La création céleste sera transformée.`,
  reflection: `Le ciel lui-même sera fendu. La création céleste sera transformée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-sama'u furijat » — et que le ciel sera fendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur la fente du ciel ? La transformation est-elle dans ma conscience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fente révèle l'ouverture vers l'invisible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel témoignera de la grandeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la fente se prépare." }
  ],
  munajat: `Ya Rabb, le ciel sera fendu. Prépare-moi pour l'ouverture.`
};

MIROIR["77:10"] = {
