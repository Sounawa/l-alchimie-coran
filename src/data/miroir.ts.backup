    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie d'ici devient le regret de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection inclut tous les humains, anciens et modernes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la promesse la voit s'accomplir." }
  ],
  munajat: `Ya Ba'ith, Tu ressuscites tous. Donne-moi la certitude de la résurrection. Ne me laisse pas douter de Ta puissance.`
};

MIROIR["56:49"] = {
  reference: "56:49",
  theme: ["résurrection", "tous", "universalité"],
  emotion: "Certitude, awe",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Ba'ith"],
  mirrorVersion: `« Dis : Oui, les premiers et les derniers. » Le miroir me montre la certitude. « Qul inna al-awwalina wa al-akhirin » — dis : les premiers et les derniers. Tous seront ressuscités.`,
  reflection: `La résurrection est pour tous. Les premiers comme les derniers seront rassemblés.`,
  tajalli: [
