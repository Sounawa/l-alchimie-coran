MIROIR["78:25"] = {
  reference: "78:25",
  theme: ["eau", "pus", "châtiment"],
  emotion: "Horreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hamim", "Al-Ghassaq"],
  mirrorVersion: `« Sauf une eau bouillante et du pus. » Le miroir me montre la boisson terrifiante. « Illa hamiman wa ghassaqan » — sauf une eau bouillante et du pus. L'horreur. Le miroir m'avertit : la boisson en Enfer est terrifiante.`,
  reflection: `L'eau bouillante et le pus. La boisson est horrible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa hamiman wa ghassaqan » — sauf une eau bouillante et du pus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La boisson est horrible. Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite l'horrible boisson." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La boisson en Enfer est une réalité terrible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi évite l'horreur." }
  ],
  munajat: `Ya Rabb, je veux éviter l'horreur. Donne-moi la foi qui sauve. Ne permets pas que je boive l'eau bouillante.`
};

MIROIR["78:26"] = {
  reference: "78:26",
  theme: ["récompense", "équivalent", "justice"],
  emotion: "Réalité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Muwafiq"],
  mirrorVersion: `« Une récompense appropriée. » Le miroir me montre la justice divine. « Jaza'an wifaqan » — une récompense appropriée. La justice. Le miroir m'enseigne : le châtiment correspond aux actes.`,
  reflection: `La récompense correspond aux actes. La justice est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jaza'an wifaqan » — une récompense appropriée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle récompense mérité-je ? Est-elle appropriée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bonnes actions méritent de bonnes récompenses." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien reçoit une récompense appropriée." }
  ],
  munajat: `Ya Rabb, je veux une bonne récompense. Aide-moi à faire le bien pour recevoir le bien.`
};

MIROIR["78:27"] = {
  reference: "78:27",
  theme: ["comptabilité", "espoir", "négation"],
  emotion: "Réalité, surprise",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Ar-Raja'"],
  mirrorVersion: `« Ils ne s'attendaient pas à des comptes. » Le miroir me montre la surprise des négateurs. « Innahum kanu la yarjuna hisaban » — ils ne s'attendaient pas à des comptes. La surprise. Le miroir m'avertit : les négateurs seront surpris.`,
  reflection: `Les négateurs ne s'attendaient pas aux comptes. La surprise sera totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahum kanu la yarjuna hisaban » — ils ne s'attendaient pas à des comptes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'attends aux comptes ? Ou est-ce que je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attente des comptes mène à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les comptes sont une réalité universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attend aux comptes se prépare." }
  ],
  munajat: `Ya Rabb, je m'attends aux comptes. Prépare-moi pour le jour des comptes. Ne permets pas que je sois surpris.`
};

MIROIR["78:28"] = {
  reference: "78:28",
  theme: ["mensonge", "versets", "négation"],
  emotion: "Réalité, conséquence",
  difficulty: "débutant",
  relatedNames: ["At-Takdhib", "Al-Ayat"],
  mirrorVersion: `« Et traitaient de mensonges Nos versets. » Le miroir me montre la cause du châtiment. « Wa kadhdhabu bi-ayatina kiddaban » — et traitaient de mensonges Nos versets. La cause. Le miroir m'avertit : nier les versets mène au châtiment.`,
  reflection: `Nier les versets est la cause du châtiment. La foi aux versets sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhdhabu bi-ayatina kiddaban » — et traitaient de mensonges Nos versets." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux versets ? Ou est-ce que je les traite de mensonges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi aux versets sauve du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les versets sont la vérité universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux versets est sauvé." }
  ],
  munajat: `Ya Rabb, je crois à Tes versets. Ne permets pas que je les traite de mensonges. Sauve-moi par ma foi.`
};

MIROIR["78:29"] = {
  reference: "78:29",
  theme: ["inscription", "comptabilité", "connaissance"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Ilm"],
  mirrorVersion: `« Mais Nous avons tout consigné dans un livre. » Le miroir me montre l'enregistrement complet. « Wa kulla shay'in ahsaynahu kitaban » — mais Nous avons tout consigné dans un livre. L'enregistrement. Le miroir m'enseigne : tout est enregistré.`,
  reflection: `Tout est consigné dans un livre. Rien n'est oublié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kulla shay'in ahsaynahu kitaban » — mais Nous avons tout consigné dans un livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Tout est enregistré. Qu'est-ce que mon livre contient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bonnes actions remplissent le livre de bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enregistrement est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien a un livre rempli de bien." }
  ],
  munajat: `Ya Rabb, fais que mon livre soit rempli de bien. Enregistre mes bonnes actions. Pardonne mes mauvaises actions.`
};

MIROIR["78:30"] = {
