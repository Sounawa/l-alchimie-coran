    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le rappel le met en pratique." }
  ],
  munajat: `Ya Rabb, envoie Ton rappel par Tes anges. Fais que je le reçoive.`
};

MIROIR["77:6"] = {
