  theme: ["détournement", "temps", "patience"],
  emotion: "Patience, distance",
  difficulty: "débutant",
  relatedNames: ["At-Tawalli", "Al-Heen"],
  mirrorVersion: `« Détourne-toi d'eux pour un temps. » Le miroir me montre la stratégie répétée. « Wa tawalla 'anhum hattaaneen » — détourne-toi d'eux pour un temps. La répétition. Le détournement est à nouveau ordonné. Le miroir m'enseigne : la patience est un cycle.`,
  reflection: `La patience est un cycle dans la vie spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tawalla 'anhum hattaaneen » — détourne-toi d'eux pour un temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de fois dois-je patienter avant de voir la délivrance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement n'est pas l'abandon — c'est la patience stratégique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend le moment parfait pour chaque événement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît le temps parfait pour chaque intervention." }
  ],
  munajat: `Ya Rabb, apprends-moi à patienter pour un temps. Je Te fais confiance pour le moment de la délivrance.`
};

