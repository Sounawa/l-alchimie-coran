  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Qadir"],
  mirrorVersion: `« Puis Nous aurions coupé son aorte. » Le miroir me montre la conséquence ultime. « Thumma la-qatayna minhu al-watin » — puis Nous aurions coupé son aorte. La mort serait le résultat. Le miroir m'interroge : est-ce que je comprends que la vie et la mort sont entre les mains d'Allah ?`,
  reflection: `L'aorte est l'artère vitale. La couper signifie la mort immédiate.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma la-qatayna minhu al-watin » — puis Nous aurions coupé son aorte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la vie et la mort sont entre les mains d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection du Prophète prouve sa véracité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie et la mort sont contrôlées par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le contrôle d'Allah sur la vie Le craint." }
  ],
  munajat: `Ya Mumit, la vie et la mort sont entre Tes mains. Je crois en la véracité du Prophète. Protège-moi comme Tu l'as protégé.`
};

MIROIR["69:47"] = {
  reference: "69:47",
  theme: ["protection", "personne", "impuissance"],
  emotion: "Certitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-'Azim"],
  mirrorVersion: `« Et nul parmi vous n'aurait pu Nous empêcher. » Le miroir me montre l'impuissance humaine. « Wa ma minhum min ahadin 'alayna jabirin » — nul n'aurait pu Nous empêcher. Personne ne peut arrêter Allah. Le miroir m'interroge : est-ce que je réalise mon impuissance ?`,
  reflection: `Personne ne peut empêcher Allah d'accomplir Sa volonté. L'homme est impuissant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma minhum min ahadin 'alayna jabirin » — et nul parmi vous n'aurait pu Nous empêcher." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise mon impuissance ? Puis-je empêcher Allah d'accomplir Sa volonté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance humaine révèle la puissance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est impuissante devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son impuissance se soumet." }
  ],
  munajat: `Ya 'Azim, je suis impuissant devant Toi. Je me soumets à Ta volonté. Ne permets pas que je sois arrogant.`
};

MIROIR["69:48"] = {
  reference: "69:48",
  theme: ["rappel", "pieux", "coran"],
  emotion: "Espoir, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muttaqin"],
  mirrorVersion: `« C'est un rappel pour les pieux. » Le miroir me montre le but du Coran. « Wa innahu la-tadhkiratun lil-muttaqin » — c'est un rappel pour les pieux. Le Coran est pour ceux qui craignent Allah. Le miroir m'interroge : est-ce que je suis des pieux ?`,
  reflection: `Le Coran est un rappel pour les pieux. La piété ouvre le cœur au message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innahu la-tadhkiratun lil-muttaqin » — c'est un rappel pour les pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis des pieux ? Le Coran me parle-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété ouvre le cœur au rappel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le rappel pour toute l'humanité pieuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux reçoit le rappel." }
  ],
  munajat: `Ya Hadi, je veux être des pieux. Fais que le Coran soit mon rappel. Ouvre mon cœur au message.`
};

MIROIR["69:49"] = {
  reference: "69:49",
  theme: ["savoir", "mécréants", "certitude"],
  emotion: "Certitude, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Haqq"],
  mirrorVersion: `« Et Nous savons qu'il y a parmi vous des négateurs. » Le miroir me montre la connaissance divine. « Wa inna la-na'lamu anna minkum mukadhdhibin » — Nous savons qu'il y a parmi vous des négateurs. Allah connaît les cœurs. Le miroir m'interroge : suis-je parmi les négateurs ou les croyants ?`,
  reflection: `Allah connaît les négateurs parmi nous. Rien n'est caché à Sa connaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna la-na'lamu anna minkum mukadhdhibin » — et Nous savons qu'il y a parmi vous des négateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les négateurs ou les croyants ? Allah connaît mon cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance divine pénètre les secrets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît chaque cœur dans l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son propre cœur se connaît." }
  ],
  munajat: `Ya 'Alim, Tu connais mon cœur. Fais que je sois parmi les croyants. Ne permets pas que je sois parmi les négateurs.`
};

MIROIR["69:50"] = {
  reference: "69:50",
  theme: ["regret", "mécréants", "réalité"],
  emotion: "Tristesse, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hasir"],
  mirrorVersion: `« Et c'est un regret pour les mécréants. » Le miroir me montre le résultat pour les négateurs. « Wa innahu la-hasratun 'ala al-kafirin » — c'est un regret pour les mécréants. Le regret est éternel. Le miroir m'interroge : est-ce que je veux éviter ce regret ?`,
  reflection: `Le regret des mécréants est éternel. Le Coran est devenu leur accusation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innahu la-hasratun 'ala al-kafirin » — et c'est un regret pour les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux éviter ce regret ? Le Coran sera-t-il mon accusation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret suit la négation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est soit guidance soit accusation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Coran évite le regret." }
  ],
  munajat: `Ya Haqq, je ne veux pas le regret éternel. Fais que je suive le Coran. Ne permets pas qu'il soit mon accusation.`
};

MIROIR["69:51"] = {
