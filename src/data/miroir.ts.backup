  theme: ["enfer", "ingratitude", "châtiment"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Ghafur"],
  mirrorVersion: `« Nous avons préparé pour les ingrats des chaînes et des carcans et un feu brûlant. » Le châtiment des ingrats. Le miroir m'avertit : l'ingratitude a des conséquences. Les chaînes et le feu attendent.`,
  reflection: `L'ingratitude a des conséquences. Les chaînes et le feu attendent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna a'tadna lil-kafirina salasila wa aghlalan wa sa'ira » — Nous avons préparé pour les ingrats des chaînes, des carcans et un feu brûlant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant ? Ou est-ce que je risque les chaînes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance libère. L'ingratitude enchaîne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les conséquences suivent les choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant évite les chaînes." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant. Préserve-moi des chaînes et du feu.`
};

MIROIR["76:5"] = {
