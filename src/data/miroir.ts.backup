  theme: ["repos", "invocation", "abondance"],
  emotion: "Paix, gratitude",
  difficulty: "débutant",
  relatedNames: ["As-Sakinah", "Al-Mutakaa"],
  mirrorVersion: `« Accoudés, ils y invoqueront fruits et boissons en abondance. » Le miroir me montre le repos paradisiaque. Accoudés, sans effort — les fruits viennent à eux. Le miroir m'invite à imaginer ce repos.`,
  reflection: `Le repos du Paradis : sans effort, les bienfaits viennent. La gratitude remplit le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mutakia fiha yad'u fiha bi-fakihatihin kathiratin wa sharab » — accoudés, ils y invoqueront fruits et boissons en abondance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel repos cherche mon âme ? L'effort d'ici-bas prépare le repos de là-bas." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos vient après l'effort — le Paradis vient après l'épreuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repos universel attend chaque créature fidèle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai repos est dans la proximité d'Allah." }
  ],
  munajat: `Ya Rabb, je cherche le repos auprès de Toi. Prépare-moi une place où je serai accoudé, comblé de Tes bienfaits.`
};

MIROIR["38:52"] = {
