    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour ce rendez-vous ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rendez-vous est fixé. La préparation est urgente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose a son temps. Le rassemblement a le sien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le rendez-vous s'y prépare." }
  ],
  munajat: `Ya Mi'd, le rendez-vous est fixé. Prépare-moi pour ce jour. Ne me laisse pas être pris au dépourvu.`
};

MIROIR["56:51"] = {
  reference: "56:51",
  theme: ["jour dernier", "égarement", "vérité"],
  emotion: "Avertissement, solennité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Qahhar"],
  mirrorVersion: `« Puis, ô vous les égarés qui traitez de mensonge ! » Le miroir me montre l'adresse directe. « Thumma inna kum ayyuha al-dallun al-mukadhdhibun » — puis, ô vous les égarés qui traitez de mensonge ! L'appel est personnel.`,
  reflection: `Allah s'adresse directement aux égarés qui niaient la vérité. L'avertissement est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma inna kum ayyuha al-dallun al-mukadhdhibun » — puis, ô vous les égarés qui traitez de mensonge !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les égarés ? Ou parmi les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement d'ici mène à l'égarement de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. L'égarement est multiple." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son égarement y échappe." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Garde-moi sur le droit chemin. Ne me laisse pas être parmi les égarés qui nient.`
};

MIROIR["56:52"] = {
  reference: "56:52",
  theme: ["enfer", "nourriture", "punition"],
  emotion: "Crainte, horreur",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Shadid"],
  mirrorVersion: `« Vous mangerez de l'arbre de Zaqqûm. » Le miroir me montre la nourriture de l'enfer. « La-akiluna min shajarin min zaqqum » — vous mangerez certainement de l'arbre de Zaqqûm.`,
