    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que ce monde est peu se prépare pour l'éternité." }
  ],
  munajat: `Ya Rabb, ce monde est peu. Prépare-moi pour l'éternité. Ne permets pas que je m'attache au peu.`
};

