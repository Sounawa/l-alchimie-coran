    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Allah pour la préservation ? Ma foi est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité divine assure la perfection." },
