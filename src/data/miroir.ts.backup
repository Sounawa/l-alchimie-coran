    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse rappeler ? Ou est-ce que j'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel universel attend une réponse universelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est destinataire du rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui accepte le rappel se souvient d'Allah." }
  ],
  munajat: `Ya Rabb, Ton rappel est pour moi. Je l'accepte. Ne permets pas que je l'oublie. Fais que je me souvienne.`
};

MIROIR["38:88"] = {
  reference: "38:88",
  theme: ["connaissance", "temps", "réalisation"],
  emotion: "Attente, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Ajal"],
  mirrorVersion: `« Et vous saurez bientôt de quoi il est question. » Le miroir promet : « Wa la-ta'lamunna naba'ahu ba'da hin » — et vous saurez bientôt de quoi il est question. La vérité sera révélée. Le miroir m'invite à la patience et à la préparation.`,
  reflection: `La vérité sera révélée. Suis-je prêt à la connaître ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-ta'lamunna naba'ahu ba'da hin » — et vous saurez bientôt de quoi il est question." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vais savoir bientôt ? Suis-je prêt pour la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance viendra — la préparation est la clé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sera révélée à tous, tôt ou tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son cœur pour la vérité la recevra avec joie." }
  ],
  munajat: `Ya Rabb, la vérité viendra. Prépare mon cœur pour la recevoir. Ne permets pas que je sois surpris par ce que je vais savoir.`
};

// ==================== SURAH 7: AL-A'RAF - VERSETS 36-42 ====================

MIROIR["7:36"] = {
  reference: "7:36",
  theme: ["foi", "désobéissance", "enfer"],
  emotion: "Avertissement, conséquence",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Nar"],
  mirrorVersion: `« Ceux qui traitent Nos signes de mensonges et s'enorgueillissent, ceux-là sont les compagnons du Feu. » Le miroir avertit : « Wa alladhina kadhdhabu bi-ayatina wa-stakbaru 'anha ula'ika ashabu al-nar » — ceux qui traitent Nos signes de mensonges et s'enorgueillissent, ceux-là sont les compagnons du Feu. Le rejet et l'orgueil mènent à l'enfer. Le miroir m'enseigne : le destin dépend de l'attitude envers les signes.`,
  reflection: `Le destin dépend de l'attitude envers les signes. Comment je traite les signes d'Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kadhdhabu bi-ayatina wa-stakbaru 'anha ula'ika ashabu al-nar » — ceux qui traitent Nos signes de mensonges et s'enorgueillissent, ceux-là sont les compagnons du Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite les signes d'Allah ? Avec foi ou avec rejet ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil devant les signes mène au feu — l'humilité mène au paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont partout — le rejet est un choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation humble des signes est la clé du salut." }
  ],
  munajat: `Ya Rabb, je ne veux pas être parmi ceux qui rejettent Tes signes. Fais que je les accepte avec humilité. Préserve-moi du Feu.`
};

MIROIR["7:37"] = {
  reference: "7:37",
  theme: ["injustice", "création", "châtiment"],
  emotion: "Condamnation, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Zulm", "Al-Khalq"],
  mirrorVersion: `« Qui est plus injuste que celui qui invente un mensonge contre Allah ? » Le miroir questionne : « Fa-man azlamu mimmani iftara 'ala-Allahi kadhiban » — qui est plus injuste que celui qui invente un mensonge contre Allah ? L'invention contre Allah est le comble de l'injustice. Le miroir m'enseigne : le mensonge sur Allah est grave.`,
  reflection: `Le mensonge sur Allah est grave. Est-ce que j'invente sur Lui ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man azlamu mimmani iftara 'ala-Allahi kadhiban » — qui est plus injuste que celui qui invente un mensonge contre Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invente sur Allah ? Est-ce que j'attribue à Allah ce qu'Il n'a pas dit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invention sur Allah montre le manque de crainte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mensonge sur Allah est le pire des mensonges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La véracité sur Allah est le fondement de la foi." }
  ],
  munajat: `Ya Rabb, préserve-moi d'inventer sur Toi. Fais que je sois véridique sur Ton compte. Ne permets pas que je sois parmi les menteurs.`
};

MIROIR["7:38"] = {
  reference: "7:38",
  theme: ["enfer", "communautés", "regret"],
  emotion: "Constat, regret",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahannam", "Al-Umam"],
  mirrorVersion: `« Chaque fois qu'une communauté entrera, elle maudira celle qui l'aura précédée. » Le miroir décrit : « Kullama dakhalat ummatun la'anat ukhtaha » — chaque fois qu'une communauté entrera, elle maudira celle qui l'aura précédée. Le regret et la haine en enfer. Le miroir m'enseigne : l'enfer est rempli de regrets.`,
  reflection: `L'enfer est rempli de regrets. Comment éviter ce destin ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullama dakhalat ummatun la'anat ukhtaha » — chaque fois qu'une communauté entrera, elle maudira celle qui l'aura précédée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel sera mon sort ? Serai-je parmi ceux qui maudissent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La malédiction en enfer est la conséquence de la désobéissance sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les communautés passées sont des exemples — leur sort est notre avertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le regret en enfer est inutile — le repentir sur terre est efficace." }
  ],
  munajat: `Ya Rabb, je ne veux pas être parmi les habitants de l'enfer. Accepte mon repentir maintenant. Ne permets pas que je sois parmi les perdants.`
};

MIROIR["7:39"] = {
  reference: "7:39",
  theme: ["jugement", "double", "châtiment"],
  emotion: "Justice, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hukm", "Al-'Adhab"],
  mirrorVersion: `« La première communauté dira à la dernière : Vous n'avez sur nous aucun avantage. » Le miroir juge : « Fa-ula'ika qalat li-ukhrahum fa-ma kana lakum min fadlin 'alayna » — la première communauté dira à la dernière : vous n'avez sur nous aucun avantage. En enfer, personne n'a d'avantage. Le miroir m'enseigne : l'avantage est pour les croyants.`,
  reflection: `L'avantage est pour les croyants. Quel est mon avantage ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ula'ika qalat li-ukhrahum fa-ma kana lakum min fadlin 'alayna » — la première communauté dira à la dernière : vous n'avez sur nous aucun avantage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel avantage ai-je ? Est-ce que j'ai l'avantage de la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avantage perdu est le résultat du mauvais choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "En enfer, tous sont égaux dans la perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'avantage de la foi sur terre devient l'avantage au paradis." }
  ],
  munajat: `Ya Rabb, donne-moi l'avantage de la foi. Fais que je sois parmi les gagnants. Ne permets pas que je perde cet avantage.`
};

MIROIR["7:40"] = {
  reference: "7:40",
  theme: ["portes", "ciel", "orgueil"],
  emotion: "Avertissement, impossibilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Abwab", "Al-Sama'"],
  mirrorVersion: `« Les portes du ciel ne seront pas ouvertes à ceux qui traitent Nos signes de mensonges. » Le miroir ferme : « Innama tuftahu abwabu al-sama'i li-alladhina kadhdhabu bi-ayatina » — les portes du ciel ne seront pas ouvertes à ceux qui traitent Nos signes de mensonges. La fermeture est définitive pour les orgueilleux. Le miroir m'enseigne : l'orgueil ferme les portes.`,
  reflection: `L'orgueil ferme les portes. Quelles portes ai-je fermées ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama tuftahu abwabu al-sama'i li-alladhina kadhdhabu bi-ayatina » — les portes du ciel ne seront pas ouvertes à ceux qui traitent Nos signes de mensonges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles portes ai-je fermées par mon orgueil ? Comment les ouvrir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeture des portes du ciel est la conséquence du rejet sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les portes du ciel sont ouvertes pour les humbles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité ouvre les portes que l'orgueil ferme." }
  ],
  munajat: `Ya Rabb, ouvre-moi les portes du ciel. Fais que je sois humble. Ne permets pas que l'orgueil ferme les portes devant moi.`
};

MIROIR["7:41"] = {
  reference: "7:41",
  theme: ["enfer", "lit", "couverture"],
  emotion: "Constat, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahannam", "Al-Firash"],
  mirrorVersion: `« L'Enfer sera leur lit, et au-dessus d'eux, des couvertures de feu. » Le miroir décrit : « Lahum min al-jahannami mihadun wa min fawqihim ghashaw » — l'Enfer sera leur lit, et au-dessus d'eux, des couvertures de feu. Le châtiment enveloppe de tous les côtés. Le miroir m'enseigne : l'enfer est total.`,
  reflection: `L'enfer est total. Comment éviter cette enveloppe de feu ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum min al-jahannami mihadun wa min fawqihim ghashaw » — l'Enfer sera leur lit, et au-dessus d'eux, des couvertures de feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment serait mon lit si j'étais en enfer ? Comment éviter ce destin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le lit de feu est le résultat du rejet du paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu enveloppe les mécréants de tous les côtés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi sur terre protège du feu de l'enfer." }
  ],
  munajat: `Ya Rabb, préserve-moi du lit de feu. Fais que mon lit soit au paradis. Ne permets pas que je sois enveloppé de feu.`
};

MIROIR["7:42"] = {
  reference: "7:42",
  theme: ["charge", "capacité", "justice"],
  emotion: "Justice, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Wus'", "Al-'Adl"],
  mirrorVersion: `« Nous n'imposons à aucune âme une charge supérieure à sa capacité. » Le miroir rassure : « La nukallifu Allahu nafsan illa wus'aha » — nous n'imposons à aucune âme une charge supérieure à sa capacité. La charge est proportionnée. Le miroir m'enseigne : Allah est juste dans Ses exigences.`,
  reflection: `La charge est proportionnée. Suis-je conscient que je peux porter ce qui m'est imposé ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La nukallifu Allahu nafsan illa wus'aha » — nous n'imposons à aucune âme une charge supérieure à sa capacité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle charge m'est imposée ? Suis-je conscient que je peux la porter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La charge proportionnée montre la miséricorde d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme a sa capacité — Allah connaît chaque capacité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance en la justice d'Allah soulage le fardeau." }
  ],
  munajat: `Ya Rabb, Tu ne m'imposes pas plus que je ne peux porter. Donne-moi la force de porter ma charge. Aide-moi à remplir mes obligations.`
};

MIROIR["16:61"] = {
  reference: "16:61",
  theme: ["justice", "châtiment", "miséricorde"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Ar-Rahman"],
  mirrorVersion: `« Si Allah saisissait les hommes pour leur injustice, Il ne laisserait sur terre aucun être vivant. » Le miroir me montre la miséricorde d'Allah qui retient Son châtiment malgré l'injustice des hommes. « Law yu'akhidhu Allahu al-nasa bi-zulmihim » — si Allah saisissait les hommes pour leur injustice. L'injustice est répandue, mais Allah patiente. Le miroir m'interroge : est-ce que j'apprécie cette patience divine ?`,
  reflection: `La miséricorde d'Allah retient le châtiment. L'injustice existe, mais Dieu patiente pour donner le temps du repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law yu'akhidhu Allahu al-nasa bi-zulmihim ma taraka 'alayha min dabbatin » — si Allah saisissait les hommes pour leur injustice, Il ne laisserait sur terre aucun être vivant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprécie la patience d'Allah envers mes propres injustices ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience divine est une opportunité de repentir, pas un laissez-passer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création bénéficie de la miséricorde divine qui retient le châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la patience d'Allah se repents rapidement." }
  ],
  munajat: `Ya Rahman, Tu patientes malgré mes injustices. Merci pour Ton temps de repentir. Fais que je me repents avant que le délai ne finisse.`
};

MIROIR["16:62"] = {
  reference: "16:62",
  theme: ["attribution", "mensonge", "préférence"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kadhdhab", "Al-Fadl"],
  mirrorVersion: `« Ils attribuent à Allah ce qu'ils détestent pour eux-mêmes. » Le miroir me montre l'hypocrisie des associateurs. « Yaj'aluna li-Allahi ma yakrahan » — ils attribuent à Allah ce qu'ils détestent. Ils Lui donnent les filles alors qu'ils préfèrent les fils pour eux-mêmes. Le miroir m'interroge : est-ce que j'attribue à Allah ce que je refuse pour moi ?`,
  reflection: `L'attribution mensongère révèle l'hypocrisie. Ce qu'on refuse pour soi ne doit pas être attribué à Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaj'aluna li-Allahi ma yakrahana wa yatasifu alsinatuhumu al-kadhiba » — ils attribuent à Allah ce qu'ils détestent pour eux-mêmes, et leurs langues profèrent le mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah ce que je refuse pour moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qu'on aime pour soi doit être attribué à Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dieu mérite le meilleur, pas ce qu'on refuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attribution sincère reflète la vraie connaissance de Dieu." }
  ],
  munajat: `Ya Rabb, je T'attribue le meilleur. Ne permets pas que je T'attribue ce que je refuse pour moi. Purifie mon attribution.`
};

MIROIR["16:63"] = {
  reference: "16:63",
  theme: ["satan", "ennemi", "ornement"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shaytan", "Al-'Adww"],
  mirrorVersion: `« Par Allah ! Nous avons envoyé des messagers à des nations avant toi, mais Satan a embelli leurs actions. » Le miroir me montre la stratégie de Satan. « Zayyana lahum al-shaytan » — Satan a embelli leurs actions. Le mal paraît beau quand Satan l'orne. Le miroir m'interroge : est-ce que je vois la beauté de mes actions ou leur réalité ?`,
  reflection: `Satan embellit le mal. La beauté apparente n'est pas toujours la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tallaqi-Allahu qad arsalna ila umamin min qablika fa-zayyana lahum al-shaytan a'malahum » — par Allah, Nous avons envoyé des messagers à des nations avant toi, mais Satan a embelli leurs actions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la beauté de mes actions ou leur réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réalité des actions n'est pas leur apparence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Satan est l'ennemi déclaré de l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit au-delà de l'ornement voit la vérité." }
  ],
  munajat: `Ya Rabb, protège-moi de l'ornement de Satan. Fais que je voie la réalité de mes actions, pas leur beauté apparente.`
};

MIROIR["16:64"] = {
  reference: "16:64",
  theme: ["coran", "guidance", "dispute"],
  emotion: "Gratitude, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Huda"],
  mirrorVersion: `« Nous n'avons fait descendre le Livre sur toi que pour leur expliquer ce sur quoi ils disputent. » Le miroir me montre le but du Coran. « Li-tubayyina lahum alladhi ikhtalafu » — pour leur expliquer ce sur quoi ils disputent. Le Coran tranche les différends. Le miroir m'interroge : est-ce que je cherche la clarification dans le Coran ?`,
  reflection: `Le Coran tranche les différends. Il est la référence pour clarifier les disputes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma anzalna 'alayka al-kitaba illa li-tubayyina lahum alladhi ikhtalafu » — Nous n'avons fait descendre le Livre sur toi que pour leur expliquer ce sur quoi ils disputent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la clarification dans le Coran pour mes différends ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est la référence, pas les opinions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance divine tranche toutes les disputes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfère au Coran trouve la clarté." }
  ],
  munajat: `Ya Rabb, le Coran tranche mes différends. Fais que je m'y réfère toujours. Donne-moi la clarté par Ton Livre.`
};

MIROIR["16:65"] = {
  reference: "16:65",
  theme: ["pluie", "vie", "résurrection"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Munazzil"],
  mirrorVersion: `« Allah a fait descendre une eau du ciel par laquelle Il fait revivre la terre après sa mort. » Le miroir me montre la résurrection dans la nature. « Fa-ahya biha al-arda ba'da mawtiha » — par laquelle Il fait revivre la terre après sa mort. La pluie est un signe de résurrection. Le miroir m'interroge : est-ce que je vois la résurrection dans la nature ?`,
  reflection: `La pluie fait revivre la terre morte. C'est un signe de la résurrection future.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allaha anzala min al-sama'i ma'an fa-ahya biha al-arda ba'da mawtiha » — Allah a fait descendre une eau du ciel par laquelle Il fait revivre la terre après sa mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la résurrection dans la nature ? La pluie est un signe." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort de la terre précède sa vie — comme la mort précède la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de la nature témoigne de la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la résurrection dans la nature croit en la résurrection future." }
  ],
  munajat: `Ya Muhyi, Tu fais revivre la terre morte. Fais revivre mon cœur mort. Donne-moi la vie par Ta pluie spirituelle.`
};

MIROIR["16:66"] = {
  reference: "16:66",
  theme: ["bétail", "lait", "signe"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Ar-Rizq"],
  mirrorVersion: `« Il y a certes un enseignement pour vous dans les bestiaux : Nous vous abreuvons de ce qui est dans leurs ventres. » Le miroir me montre le signe dans les animaux. « La'ibran lakum fi al-an'am » — un enseignement pour vous dans les bestiaux. Le lait pur vient entre les excréments et le sang. Le miroir m'interroge : est-ce que je vois les signes dans la création ?`,
  reflection: `Le lait pur vient d'entre les excréments et le sang. C'est un signe de la puissance créatrice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna lakum fi al-an'ami la'ibran nusqikum mimma fi butunihi » — il y a certes un enseignement pour vous dans les bestiaux : Nous vous abreuvons de ce qui est dans leurs ventres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les signes dans la création ? Le lait est un miracle quotidien." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté sort de l'impureté par la volonté divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature porte un signe du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le signe dans le lait voit le signe partout." }
  ],
  munajat: `Ya Khaliq, Tu fais sortir le pur de l'impur. Purifie mon cœur. Donne-moi de voir Tes signes dans toute la création.`
};

MIROIR["16:67"] = {
  reference: "16:67",
  theme: ["fruits", "boisson", "signe"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mun'im"],
  mirrorVersion: `« Des fruits des palmeraies et des vignes, vous retirez une boisson enivrante et un bienfait. » Le miroir me montre le bienfait dans les fruits. « Tattakhidhuna minhu sakiran wa rizqan hasana » — vous retirez une boisson enivrante et un bienfait. Le même fruit donne l'ivresse et le bienfait. Le miroir m'interroge : est-ce que je choisis le bienfait ?`,
  reflection: `Les fruits donnent le bienfait et l'ivresse. Le choix appartient à l'homme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min thamari al-nakhili wa al-a'nabi tattakhidhuna minhu sakiran wa rizqan hasana » — des fruits des palmeraies et des vignes, vous retirez une boisson enivrante et un bienfait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis le bienfait ou l'ivresse ? Le choix est dans mes mains." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le même fruit peut bénir ou maudire selon l'usage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dieu donne le bienfait, l'homme décide de l'usage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bienfait choisi est une reconnaissance du Donateur." }
  ],
  munajat: `Ya Razzaq, Tu donnes le bienfait. Fais que je choisisse le bien et non l'ivresse. Guide mon usage de Tes dons.`
};

MIROIR["16:68-69"] = {
  reference: "16:68-69",
  theme: ["abeille", "miel", "guérison"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ash-Shifa", "Al-Muhaymin"],
  mirrorVersion: `« Ton Seigneur révéla aux abeilles : "Prenez des demeures dans les montagnes, les arbres et les treillages." » Le miroir me montre l'inspiration divine aux abeilles. « Awha rabbuka ila al-nahl » — ton Seigneur révéla aux abeilles. L'abeille suit l'inspiration divine. Le miel qu'elle produit est guérison. Le miroir m'interroge : est-ce que je reconnais la guérison dans le miel ?`,
  reflection: `L'abeille suit l'inspiration divine. Le miel est guérison pour les hommes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awha rabbuka ila al-nahl ani ittakhidhi min al-jibali buyutan » — ton Seigneur révéla aux abeilles : prends des demeures dans les montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la guérison dans ce que Dieu a créé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guérison vient de la créature la plus petite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature porte une sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guérison est cachée dans ce qui semble insignifiant." }
  ],
  munajat: `Ya Shafi, Tu as mis la guérison dans le miel. Guéris mon cœur et mon corps. Fais que je voie Ta sagesse dans toute créature.`
};

MIROIR["16:70"] = {
  reference: "16:70",
  theme: ["création", "vieillesse", "science"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-'Alim"],
  mirrorVersion: `« Allah vous a créés, puis Il vous fait mourir. Et il en est parmi vous qui sont ramenés à l'âge le plus vil. » Le miroir me montre le cycle de la vie. « Yuraddu ila ardhali al-'umur » — ramenés à l'âge le plus vil. La vieillesse inverse la force. Le miroir m'interroge : est-ce que je prépare ma vieillesse et ma mort ?`,
  reflection: `La vieillesse ramène à la faiblesse. La vie est un cycle qui se termine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu khalaqakum thumma yatawaffakum wa minkum man yuraddu ila ardhali al-'umur » — Allah vous a créés, puis Il vous fait mourir. Et il en est parmi vous qui sont ramenés à l'âge le plus vil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare ma vieillesse et ma mort ? Ou est-ce que j'ignore le cycle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse de la vieillesse est un rappel de la dépendance à Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de la vie est universel — nul n'y échappe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa fin vit bien son présent." }
  ],
  munajat: `Ya Khaliq, Tu crées et Tu fais mourir. Prépare-moi pour le cycle de la vie. Fais que je ne sois pas surpris par la vieillesse.`
};

MIROIR["16:71"] = {
  reference: "16:71",
  theme: ["préférence", "don", "ingratitude"],
  emotion: "Reconnaissance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Fadl", "Ar-Razzaq"],
  mirrorVersion: `« Allah a donné la préférence à certains d'entre vous sur d'autres dans la subsistance. » Le miroir me montre l'inégalité des dons. « Faddala Allahu ba'dakum 'ala ba'd fi al-rizq » — Allah a donné la préférence à certains sur d'autres dans la subsistance. Les dons sont inégaux par sagesse divine. Le miroir m'interroge : est-ce que j'accepte ma part ?`,
  reflection: `Les dons sont inégaux par sagesse divine. Accepter sa part est la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu faddala ba'dakum 'ala ba'd fi al-rizq » — Allah a donné la préférence à certains d'entre vous sur d'autres dans la subsistance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma part ? Ou est-ce que je jalouse les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de sa part est la paix du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La distribution des dons suit la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa part trouve le contentement." }
  ],
  munajat: `Ya Razzaq, Tu distribues selon Ta sagesse. Fais que j'accepte ma part avec gratitude. Ne permets pas la jalousie dans mon cœur.`
};

MIROIR["16:72"] = {
  reference: "16:72",
  theme: ["famille", "bienfait", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Ar-Razzaq"],
  mirrorVersion: `« Allah a fait de vous-mêmes des épouses, et de vos épouses, Il vous a donné des enfants et des petits-enfants. » Le miroir me montre les bienfaits familiaux. « Ja'ala lakum min anfusikum azwajan » — Il a fait de vous-mêmes des épouses. La famille est un don d'Allah. Le miroir m'interroge : est-ce que je remercie pour ma famille ?`,
  reflection: `La famille est un don d'Allah. La gratitude est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu ja'ala lakum min anfusikum azwajan wa ja'ala lakum min azwajikum banina wa hafadatan » — Allah a fait de vous-mêmes des épouses, et de vos épouses, Il vous a donné des enfants et des petits-enfants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ma famille ? Ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La famille est un test et un bienfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La famille est le fondement de la société." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour la famille bénit la famille." }
  ],
  munajat: `Ya Wahhab, merci pour ma famille. Bénis mes épouses, mes enfants et mes petits-enfants. Fais que je les apprécie.`
};

MIROIR["16:73"] = {
  reference: "16:73",
  theme: ["idoles", "impouvoir", "adoration"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Qadir"],
  mirrorVersion: `« Ils adorent en dehors d'Allah, ce qui ne peut leur procurer aucune subsistance des cieux et de la terre. » Le miroir me montre l'absurdité de l'idolâtrie. « La yamlikuna lahum rizqan » — ils ne possèdent aucune subsistance. Les idoles sont impuissantes. Le miroir m'interroge : est-ce que j'adore ce qui ne peut rien pour moi ?`,
  reflection: `Les idoles sont impuissantes. L'adoration doit être dirigée vers le Seul Puissant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ya'buduna min duni Allahi ma la yamliku lahum rizqan min al-samawati wa al-ardi shay'an » — ils adorent en dehors d'Allah, ce qui ne peut leur procurer aucune subsistance des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore en dehors d'Allah ? Est-ce que cela peut m'aider ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance des idoles révèle la puissance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah mérite l'adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adonne l'impuissant perd son adoration." }
  ],
  munajat: `Ya Wahid, Tu es le Seul qui mérite l'adoration. Ne permets pas que j'adore ce qui ne peut rien pour moi. Dirige mon adoration vers Toi seul.`
};

MIROIR["16:74"] = {
  reference: "16:74",
  theme: ["comparaison", "limitation", "unicité"],
  emotion: "Révérence, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ahad", "Al-Mathal"],
  mirrorVersion: `« N'attribuez pas des semblables à Allah, car Allah sait et vous ne savez pas. » Le miroir me montre l'erreur de la comparaison. « Fa-la tadribu li-Allahi al-amthal » — n'attribuez pas des semblables à Allah. Allah est incomparable. Le miroir m'interroge : est-ce que je compare Allah à quoi que ce soit ?`,
  reflection: `Allah est incomparable. Toute comparaison est une limitation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la tadribu li-Allahi al-amthal inna Allaha ya'lamu wa antum la ta'lamun » — n'attribuez pas des semblables à Allah, car Allah sait et vous ne savez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compare Allah à quoi que ce soit ? Ou est-ce que je L'accepte comme Incomparable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incomparabilité d'Allah est Sa transcendance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est semblable à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'incomparabilité adore avec vérité." }
  ],
  munajat: `Ya Ahad, Tu es incomparable. Ne permets pas que je Te compare à quoi que ce soit. Fais que je T'adore dans Ton unicité.`
};

MIROIR["16:75"] = {
  reference: "16:75",
  theme: ["esclave", "libre", "comparaison"],
  emotion: "Réflexion, choix",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hurr", "Al-'Abd"],
  mirrorVersion: `« Allah propose une parabole : un esclave appartenant à autrui, qui ne peut rien, et un homme libre que Nous avons pourvu d'une belle subsistance. » Le miroir me montre la différence entre l'esclave et le libre. « 'Abd mamlik » — un esclave appartenant à autrui. L'esclave ne peut rien par lui-même. Le miroir m'interroge : est-ce que je suis libre ou esclave de mes passions ?`,
  reflection: `La vraie liberté est la liberté de l'âme. L'esclave des passions ne peut rien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Daraba Allahu mathalan 'abdan mamlikan la yaqdiru 'ala shay'in wa man razaqnahu minna rizqan hasana » — Allah propose une parabole : un esclave appartenant à autrui, qui ne peut rien, et un homme libre que Nous avons pourvu d'une belle subsistance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je libre ou esclave de mes passions ? Qu'est-ce qui me domine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté de l'âme est la vraie liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'esclavage des passions est le pire esclavage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est libre de ses passions est vraiment libre." }
  ],
  munajat: `Ya Rabb, je veux être libre, pas esclave de mes passions. Libère mon âme. Donne-moi la liberté de Te servir.`
};

MIROIR["16:76"] = {
  reference: "16:76",
  theme: ["ignorant", "guide", "comparaison"],
  emotion: "Réflexion, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Jahil"],
  mirrorVersion: `« Allah propose une autre parabole : deux hommes, l'un d'eux est ignorant et ne peut rien faire. » Le miroir me montre la différence entre l'ignorant et le guide. « A-khuhuma abkam » — l'un d'eux est muet (ignorant). L'ignorant ne peut guider personne. Le miroir m'interroge : est-ce que je suis sur la voie de la guidance ou de l'ignorance ?`,
  reflection: `L'ignorant ne peut guider. Le guide a la connaissance et la direction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa daraba Allahu mathalan rajulayni ahuhuma abkam la yaqdiru 'ala shay'in » — Allah propose une autre parabole : deux hommes, l'un d'eux est ignorant et ne peut rien faire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sur la voie de la guidance ou de l'ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance demande la connaissance et la capacité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le guide est lumière, l'ignorant est ténèbres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le guide arrive à destination." }
  ],
  munajat: `Ya Hadi, guide-moi vers la connaissance. Ne permets pas que je reste dans l'ignorance. Donne-moi la capacité de guider les autres.`
};

MIROIR["16:77"] = {
  reference: "16:77",
  theme: ["cieux", "terre", "secret"],
  emotion: "Révérence, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghayb", "Al-Shahadah"],
  mirrorVersion: `« À Allah appartient le mystère des cieux et de la terre. » Le miroir me montre la connaissance absolue d'Allah. « Lillahi ghaybu al-samawati wa al-ard » — à Allah appartient le mystère des cieux et de la terre. L'homme ne connaît que ce qui lui est révélé. Le miroir m'interroge : est-ce que j'accepte ma limitation de connaissance ?`,
  reflection: `Allah connaît tout. L'homme ne connaît que ce qui lui est donné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lillahi ghaybu al-samawati wa al-ard wa ma amru al-sa'ati illa ka-lamhi al-basar » — à Allah appartient le mystère des cieux et de la terre. L'avènement de l'Heure est comme un clin d'œil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma limitation de connaissance ? Ou est-ce que je prétends savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de l'inconnu est une forme de connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mystère divin dépasse l'entendement humain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère trouve la paix." }
  ],
  munajat: `Ya 'Alim al-Ghayb, Tu connais tout. J'accepte ma limitation. Fais que je ne prétende pas savoir ce que je ne sais pas.`
};

MIROIR["16:78"] = {
  reference: "16:78",
  theme: ["naissance", "sens", "don"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Walid", "As-Sami'"],
  mirrorVersion: `« Allah vous a fait sortir des ventres de vos mères, sans que vous ne sachiez rien. » Le miroir me montre le commencement de la vie. « Kharajakum min butuni ummahatikum » — Il vous a fait sortir des ventres de vos mères. Nous sommes nés sans savoir, et Allah nous a donné les sens. Le miroir m'interroge : est-ce que je remercie pour les sens qu'Allah m'a donnés ?`,
  reflection: `Nous naissons sans savoir. Allah nous donne les sens pour apprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu akhrajakum min butuni ummahatikum la ta'lamuna shay'an wa ja'ala lakum al-sam'a wa al-absar wa al-af'ida » — Allah vous a fait sortir des ventres de vos mères, sans que vous ne sachiez rien. Et Il vous a donné l'ouïe, la vue et les cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour mes sens ? Ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les sens sont des dons pour connaître Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sens sont les portes de la connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise ses sens pour Dieu les utilise bien." }
  ],
  munajat: `Ya Rabb, merci pour l'ouïe, la vue et le cœur. Fais que je les utilise pour Te connaître. Ne permets pas que je les utilise pour le mal.`
};

MIROIR["16:79"] = {
  reference: "16:79",
  theme: ["oiseaux", "vol", "signe"],
  emotion: "Émerveillement, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musakhkhir"],
  mirrorVersion: `« Ne voient-ils pas les oiseaux assujettis dans l'atmosphère du ciel ? » Le miroir me montre le signe dans les oiseaux. « Alam yaraw ila al-tayri musakhkharatin » — ne voient-ils pas les oiseaux assujettis. Les oiseaux volent par la volonté d'Allah. Le miroir m'interroge : est-ce que je vois le signe dans le vol des oiseaux ?`,
  reflection: `Les oiseaux volent par la volonté d'Allah. Leur vol est un signe de Sa puissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam yaraw ila al-tayri musakhkharatin fi jawwi al-sama'i yumsikuhunna inna fi dhalika la-ayatin li-qawmin yu'minun » — ne voient-ils pas les oiseaux assujettis dans l'atmosphère du ciel ? Allah les retient. Il y a là des signes pour ceux qui croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le signe dans le vol des oiseaux ? Ou est-ce que je passe sans méditer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vol des oiseaux est maintenu par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est maintenue par la volonté divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le signe dans le vol voit le signe partout." }
  ],
  munajat: `Ya Musakhkhir, Tu maintiens les oiseaux en vol. Maintiens-moi dans Ta guidance. Fais que je voie Tes signes dans toute créature.`
};

MIROIR["16:80"] = {
  reference: "16:80",
  theme: ["maison", "bétail", "repos"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Musakhkhir", "Ar-Raziq"],
  mirrorVersion: `« Allah a fait de vos maisons un lieu de repos. » Le miroir me montre le don de la maison. « Ja'ala lakum min buyutikum sakanan » — Il a fait de vos maisons un lieu de repos. La maison est un abri et un repos. Le miroir m'interroge : est-ce que je remercie pour ma maison ?`,
  reflection: `La maison est un don d'Allah. Elle est un abri et un repos.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu ja'ala lakum min buyutikum sakanan wa ja'ala lakum min juludi al-an'ami buyutan » — Allah a fait de vos maisons un lieu de repos. Et de vos maisons, Il a fait des abris." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ma maison ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La maison est un test et un bienfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repos dans la maison est un don divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour sa maison trouve la paix chez lui." }
  ],
  munajat: `Ya Rabb, merci pour ma maison. Fais qu'elle soit un lieu de paix et de repos. Bénis mon foyer.`
};

MIROIR["16:81"] = {
  reference: "16:81",
  theme: ["ombre", "vêtement", "protection"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghata", "Al-Muwajjih"],
  mirrorVersion: `« Et Allah a fait de l'ombre un abri pour vous. » Le miroir me montre les dons de l'ombre et du vêtement. « Ja'ala lakum zillan » — Il a fait de l'ombre un abri. L'ombre protège du soleil. Le miroir m'interroge : est-ce que je remercie pour l'ombre et les vêtements ?`,
  reflection: `L'ombre et les vêtements sont des protections divines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu ja'ala lakum min khalaqihi zillan wa ja'ala lakum min al-jibali aknana » — et Allah a fait de l'ombre un abri pour vous. Et des montagnes, Il a fait des abris." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour l'ombre et les vêtements ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection est un don à reconnaître." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière est au service de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les protections divines est protégé." }
  ],
  munajat: `Ya Rabb, merci pour l'ombre et les vêtements. Protège-moi de tout mal. Fais que je voie Tes protections partout.`
};

MIROIR["16:82"] = {
  reference: "16:82",
  theme: ["message", "obéissance", "détournement"],
  emotion: "Sérénité, détermination",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "At-Tabligh"],
  mirrorVersion: `« S'ils se détournent, il ne t'incombe que la communication claire. » Le miroir me montre la limite de la responsabilité du messager. « Fa-in tawallaw fa-innama 'alayka al-balaghu al-mubin » — s'ils se détournent, il ne t'incombe que la communication claire. Le messager n'est responsable que de transmettre. Le miroir m'interroge : est-ce que je fais ma part et je laisse le reste à Allah ?`,
  reflection: `La responsabilité est de transmettre. Le résultat appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in tawallaw fa-innama 'alayka al-balaghu al-mubin » — s'ils se détournent, il ne t'incombe que la communication claire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais ma part et je laisse le résultat à Allah ? Ou est-ce que je veux contrôler le résultat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement des autres n'est pas l'échec du messager." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La responsabilité est proportionnelle à la capacité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait sa part trouve la paix." }
  ],
  munajat: `Ya Rabb, fais que je fasse ma part. Donne-moi la sérénité de laisser le résultat à Toi. Ne permets pas que je sois responsable du détournement des autres.`
};

MIROIR["16:83"] = {
  reference: "16:83",
  theme: ["bienfait", "négation", "ingratitude"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Al-Kufr"],
  mirrorVersion: `« Ils reconnaissent le bienfait d'Allah, puis ils le nient. » Le miroir me montre l'ingratitude des mécréants. « Ya'rifuna ni'mata Allahi thumma yunkirunaha » — ils reconnaissent le bienfait d'Allah, puis ils le nient. La connaissance du bienfait sans gratitude est négation. Le miroir m'interroge : est-ce que je nie les bienfaits que je connais ?`,
  reflection: `La connaissance du bienfait sans gratitude est négation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'rifuna ni'mata Allahi thumma yunkirunaha wa aktharuhumu al-kafirun » — ils reconnaissent le bienfait d'Allah, puis ils le nient, et la plupart d'entre eux sont ingrats." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nie les bienfaits que je connais ? Ou est-ce que je les reconnais avec gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude transforme la connaissance en reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bienfait non reconnu est bienfait perdu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le bienfait le garde." }
  ],
  munajat: `Ya Rabb, je reconnais Tes bienfaits. Fais que je ne les nie pas. Donne-moi la gratitude qui préserve les bienfaits.`
};

MIROIR["16:84"] = {
  reference: "16:84",
  theme: ["témoins", "jour", "jugement"],
  emotion: "Responsabilité, conscience",
  difficulty: "débutant",
  relatedNames: ["Ash-Shuhada", "Al-Qiyamah"],
  mirrorVersion: `« Le jour où Nous ferons venir de chaque communauté un témoin. » Le miroir me montre le témoignage du Jour. « Yawma nab'athu min kulli ummatin shahidan » — le jour où Nous ferons venir de chaque communauté un témoin. Les témoins témoigneront sur leurs communautés. Le miroir m'interroge : est-ce que je serai un bon témoin ?`,
  reflection: `Les témoins du Jour témoigneront sur leurs communautés. Chacun sera responsable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma nab'athu min kulli ummatin shahidan » — le jour où Nous ferons venir de chaque communauté un témoin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai un bon témoin ? Quel sera mon témoignage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage du Jour révèle la réalité de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté aura son témoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le témoin fidèle est honoré par Allah." }
  ],
  munajat: `Ya Rabb, prépare-moi pour le témoignage du Jour. Fais que je sois un témoin fidèle. Ne permets pas que je sois parmi les témoins défavorables.`
};

MIROIR["16:85"] = {
  reference: "16:85",
  theme: ["injustice", "réduction", "châtiment"],
  emotion: "Réalité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hisab"],
  mirrorVersion: `« Quand les injustes verront le châtiment, il ne leur sera pas allégé. » Le miroir me montre la sévérité du châtiment. « La yukhaffafu 'anhum » — il ne leur sera pas allégé. Le châtiment des injustes est sans réduction. Le miroir m'interroge : est-ce que je crains le châtiment des injustes ?`,
  reflection: `Le châtiment des injustes est sans réduction. La justice divine est stricte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'a alladhina zalamu al-'adhaba fa-la yukhaffafu 'anhum » — quand les injustes verront le châtiment, il ne leur sera pas allégé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment des injustes ? Ou est-ce que je me sens à l'abri ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sévérité du châtiment appelle à l'évitement de l'injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite et sans compromis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'injustice évite le châtiment." }
  ],
  munajat: `Ya 'Adl, Ta justice est stricte. Préserve-moi de l'injustice. Ne permets pas que je sois parmi les injustes qui subissent le châtiment sans réduction.`
};

MIROIR["16:86"] = {
  reference: "16:86",
  theme: ["associés", "désaveu", "châtiment"],
  emotion: "Réalité, regret",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shuraka", "Al-Bara'ah"],
  mirrorVersion: `« Quand les associateurs verront leurs associés, ils diront : "Notre Seigneur, voilà nos associés que nous invoquions en dehors de Toi." » Le miroir me montre le désaveu des associés. « Ha'ula'i shuraka'una » — voilà nos associés. Les associés désavoueront leurs adorateurs. Le miroir m'interroge : est-ce que j'invoque autre qu'Allah ?`,
  reflection: `Les associés désavoueront leurs adorateurs. L'invocation en dehors d'Allah est vaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'a alladhina ashraku shuraka'ahum qalu rabbana ha'ula'i shuraka'una alladhina kunna nad'u min dunika » — quand les associateurs verront leurs associés, ils diront : Notre Seigneur, voilà nos associés que nous invoquions en dehors de Toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque autre qu'Allah ? Que feront mes associés le Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'associé ne peut pas sauver son adorateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah peut sauver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a pas d'associé n'a pas de désaveu à craindre." }
  ],
  munajat: `Ya Wahid, je n'invoque que Toi. Préserve-moi de l'association. Ne permets pas que j'invoque autre que Toi.`
};

MIROIR["16:87"] = {
  reference: "16:87",
  theme: ["soumission", "châtiment", "désaveu"],
  emotion: "Réalité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Khasyah"],
  mirrorVersion: `« Ils offriront ce jour-là la soumission à Allah. » Le miroir me montre la soumission forcée du Jour. « Ablaghaw lil-lahi al-yawma al-islam » — ils offriront ce jour-là la soumission à Allah. La soumission est inévitable, mais tardive. Le miroir m'interroge : est-ce que je me soumette maintenant ou j'attends le Jour ?`,
  reflection: `La soumission est inévitable. Mieux vaut se soumettre maintenant que le Jour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alqaw ila Allahi yawma'idhin al-salamah » — ils offriront ce jour-là la soumission à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumette maintenant ou j'attends le Jour ? La soumission tardive ne sauve pas." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission anticipée est bénéfique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous se soumettent à Allah tôt ou tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet maintenant est sauvé." }
  ],
  munajat: `Ya Rabb, je me soumette à Toi maintenant. Ne permets pas que j'attende le Jour pour me soumettre. Accepte ma soumission anticipée.`
};

MIROIR["16:88"] = {
  reference: "16:88",
  theme: ["obstacle", "châtiment", "augmentation"],
  emotion: "Mise en garde, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sadd", "Al-Mazid"],
  mirrorVersion: `« Ceux qui ne croient et obstruent le chemin d'Allah, Nous leur ajouterons châtiment sur châtiment. » Le miroir me montre l'aggravation du châtiment. « Naziduhum 'adhaban » — Nous leur ajouterons châtiment. L'obstruction du chemin d'Allah aggrave le châtiment. Le miroir m'interroge : est-ce que j'obstrue le chemin d'Allah ?`,
  reflection: `L'obstruction du chemin d'Allah aggrave le châtiment. Faciliter le chemin est un bienfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina kafaru wa saddu 'an sabili Allahi zidnahum 'adhaban fawqa al-'adhabi » — ceux qui ne croient et obstruent le chemin d'Allah, Nous leur ajouterons châtiment sur châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obstrue le chemin d'Allah ? Ou est-ce que je le facilite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilitation du chemin d'Allah est un bienfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah est pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui facilite le chemin est facilité." }
  ],
  munajat: `Ya Rabb, je veux faciliter Ton chemin. Ne permets pas que je sois un obstacle. Donne-moi de faciliter la guidance des autres.`
};

MIROIR["16:89"] = {
  reference: "16:89",
  theme: ["témoin", "communauté", "prophète"],
  emotion: "Responsabilité, honorabilité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Ummah"],
  mirrorVersion: `« Le jour où Nous ferons venir contre chaque communauté un témoin d'entre eux-mêmes, et Nous te ferons venir comme témoin contre ceux-ci. » Le miroir me montre le témoignage du Prophète. « Ji'nna bika shahidan 'ala ha'ula'i » — Nous te ferons venir comme témoin contre ceux-ci. Le Prophète témoignera sur sa communauté. Le miroir m'interroge : est-ce que je serai fier de mon témoignage ?`,
  reflection: `Le Prophète témoignera sur sa communauté. Chacun doit préparer son témoignage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma nab'athu fi kulli ummatin shahidan 'alayhim min anfusihim wa ji'nna bika shahidan 'ala ha'ula'i » — le jour où Nous ferons venir contre chaque communauté un témoin d'entre eux-mêmes, et Nous te ferons venir comme témoin contre ceux-ci." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai fier de mon témoignage ? Ou aurai-je honte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage du Prophète est un honneur pour sa communauté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque prophète témoigne sur sa communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète est honoré par son témoignage." }
  ],
  munajat: `Ya Rabb, fais que je sois fier du témoignage du Prophète sur moi. Ne permets pas que j'aie honte. Donne-moi de suivre son exemple.`
};

// ==================== SURAH 39: AZ-ZUMAR - MISSING VERSES ====================

MIROIR["39:8"] = {
  reference: "39:8",
  theme: ["détresse", "gratitude", "oublieux"],
  emotion: "Réflexion, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Munji", "Al-Mughni"],
  mirrorVersion: `« Quand un mal touche l'homme, il invoque son Seigneur en se tournant vers Lui. Puis quand Allah lui accorde un bienfait, il oublie. » Le miroir me montre l'inconstance humaine. Dans la détresse, on invoque — dans l'aisance, on oublie. Le miroir m'interroge : suis-je comme cela ?`,
  reflection: `Dans la détresse, j'invoque. Dans l'aisance, j'oublie. Comment être constant ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha massa al-insana durrun da'a rabbahu muniban ilayhi thumma idha khawwalahu ni'matan minhu nasiya alladhi kana yad'u ilayhi » — quand un mal touche l'homme, il invoque son Seigneur en se tournant vers Lui. Puis quand Allah lui accorde un bienfait, il oublie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis constant dans mon invocation ? Ou est-ce que j'oublie dans l'aisance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude dans l'aisance est plus précieuse que l'invocation dans la détresse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La constance est la marque des véridiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient dans l'aisance est préservé dans la détresse." }
  ],
  munajat: `Ya Rabb, fais que je sois constant dans mon souvenir de Toi. Ne permets pas que j'oublie dans l'aisance. Donne-moi la gratitude en tout temps.`
};

MIROIR["39:11"] = {
  reference: "39:11",
  theme: ["adoration", "sincérité", "exclusivité"],
  emotion: "Engagement, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-'Ibadah", "Al-Ikhlas"],
  mirrorVersion: `« Dis : Il m'a été ordonné d'adorer Allah en Lui vouant un culte exclusif. » Le miroir clarifie la mission. L'adoration exclusive — pour Allah seul. Le miroir m'invite à vérifier mon adoration.`,
  reflection: `Mon adoration est-elle exclusive pour Allah ? Y a-t-il des partenaires dans mon culte ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inni umirtu an a'buda-Allaha mukhlisan lahu ad-din » — dis : il m'a été ordonné d'adorer Allah en Lui vouant un culte exclusif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah exclusivement ? Ou est-ce que j'ai d'autres divinités ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité de l'adoration est le fondement du tawhid." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création adore Allah exclusivement — l'homme a le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration exclusive purifie le cœur de toute idolâtrie." }
  ],
  munajat: `Ya Rabb, je T'adore exclusivement. Purifie mon adoration de tout associé. Fais que mon culte soit pour Toi seul.`
};

MIROIR["39:12"] = {
  reference: "39:12",
  theme: ["soumission", "musulman", "ordre"],
  emotion: "Soumission, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Muslim"],
  mirrorVersion: `« Et il m'a été ordonné d'être le premier des musulmans. » Le miroir montre l'exemplarité. Le Prophète est le premier à se soumettre — il montre le chemin. Le miroir m'invite à suivre son exemple.`,
  reflection: `Suis-je parmi les premiers à me soumettre ? Ou est-ce que je tarde ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa umirtu li-akuna awwala al-muslimin » — et il m'a été ordonné d'être le premier des musulmans." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumets rapidement ? Ou est-ce que je tarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être parmi les premiers est un honneur — tarder est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les premiers à se soumettre sont les plus honorés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La soumission rapide est la marque de l'amour." }
  ],
  munajat: `Ya Rabb, je veux être parmi les premiers à me soumettre. Ne permets pas que je tarde. Donne-moi la promptitude dans la soumission.`
};

MIROIR["39:13"] = {
