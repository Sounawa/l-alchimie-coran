    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Créateur se reconnaît comme créature." }
  ],
  munajat: `Ya Khaliq, Tu es le Créateur unique. Fais que je me reconnaisse comme créature. Donne-moi l'humilité de la reconnaissance.`
};

MIROIR["56:60"] = {
