MIROIR["16:53"] = {
  reference: "16:53",
  theme: ["bienfaits", "reconnaissance", "oubli"],
  emotion: "Gratitude, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Al-Jahd"],
  mirrorVersion: `« Tout bienfait que vous avez provient d'Allah. » Le miroir me montre l'origine de tous les bienfaits. « Wa ma bikum min ni'matin fa-mina Allahi » — tout bienfait que vous avez provient d'Allah. Reconnaître l'origine est essentiel. Le miroir m'interroge : est-ce que je reconnais que tout vient de Lui ?`,
  reflection: `Tout bienfait vient d'Allah. Le reconnaître est le premier devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma bikum min ni'matin fa-mina Allahi » — tout bienfait que vous avez provient d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que tout vient de Lui ? Ou est-ce que je l'attribue à d'autres causes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'origine purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose bonne vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'origine reçoit plus de bienfaits." }
  ],
  munajat: `Ya Rabb, je reconnais que tout bienfait vient de Toi. Ne permets pas que je l'oublie. Garde-moi dans la gratitude constante.`
};

MIROIR["16:55"] = {
  reference: "16:55",
  theme: ["ingratitude", "détournement", "bienfaits"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kufr", "An-Ni'mah"],
  mirrorVersion: `« Afin qu'ils renient ce que Nous leur avons donné. » Le miroir me montre l'ingratitude des hommes. « Li-yakfura bi-ma ataynahum » — afin qu'ils renient ce que Nous leur avons donné. L'ingratitude suit l'oubli. Le miroir m'interroge : est-ce que je renie les bienfaits par mon comportement ?`,
  reflection: `L'ingratitude suit l'oubli. Ne pas renier les bienfaits est essentiel.`,
  tajalli: [
