    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai cette certitude ? Crois-je vraiment au Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude est le fondement de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la vérité dans un monde d'illusions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la certitude est inébranlable." }
  ],
  munajat: `Ya Haqq, le Coran est la vérité certaine. Donne-moi cette certitude. Ne permets pas que je doute.`
};

MIROIR["69:52"] = {
  reference: "69:52",
  theme: ["gloire", "nom", "adoration"],
  emotion: "Révérence, louange",
  difficulty: "débutant",
  relatedNames: ["Al-'Azim", "Al-Kabir"],
  mirrorVersion: `« Glorifie donc le nom de ton Seigneur, le Très Grand. » Le miroir conclut par la glorification. « Fa-sabbih bi-ismi rabbika al-'azim » — glorifie le nom de ton Seigneur, le Très Grand. La réponse à tout est la glorification. Le miroir m'interroge : est-ce que je glorifie le nom d'Allah ?`,
  reflection: `La glorification du nom d'Allah est la réponse finale. Tout mène à la louange.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sabbih bi-ismi rabbika al-'azim » — glorifie donc le nom de ton Seigneur, le Très Grand." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie le nom d'Allah ? Ma vie est-elle une louange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification élève au-dessus des soucis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers glorifie le Très Grand." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah Le rencontre." }
  ],
  munajat: `Ya 'Azim, Tu es le Très Grand. Je glorifie Ton nom. Fais que toute ma vie soit une louange.`
};

// ==================== SURAH 70: AL-MA'ARIJ - COMPLETION (70:5-70:44) ====================

MIROIR["70:5"] = {
  reference: "70:5",
  theme: ["patience", "endurance", "beauté"],
  emotion: "Calme, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Sabur", "Al-Jamil"],
  mirrorVersion: `« Endure donc avec une belle patience. » Le miroir m'appelle à la patience. « Fa-isbir sabran jamilan » — endure avec une belle patience. La patience doit être belle, pas forcée. Le miroir m'interroge : est-ce que ma patience est belle ?`,
  reflection: `La belle patience est celle qui accepte sans plainte. Elle transforme l'épreuve en grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-isbir sabran jamilan » — endure donc avec une belle patience." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma patience est belle ? Ou est-ce que je me plains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La belle patience transforme l'épreuve en grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La patience est une vertu universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure avec beauté reçoit la beauté." }
  ],
  munajat: `Ya Sabur, donne-moi la belle patience. Fais que j'accepte sans me plaindre. Transforme mes épreuves en grâce.`
};

MIROIR["70:6"] = {
  reference: "70:6",
  theme: ["impatience", "châtiment", "vision"],
  emotion: "Avertissement, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Basir"],
  mirrorVersion: `« Ils le voient loin, alors que Nous le voyons proche. » Le miroir me montre la différence de vision. « Yarawnahu ba'idan wa narahu qariban » — ils le voient loin, Nous le voyons proche. Le châtiment est plus proche qu'ils ne pensent. Le miroir m'interroge : est-ce que je vois le châtiment proche ou loin ?`,
  reflection: `Le châtiment peut être plus proche qu'on ne le pense. La vision humaine est limitée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yarawnahu ba'idan wa narahu qariban » — ils le voient loin, alors que Nous le voyons proche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le châtiment proche ou loin ? Ma vision est-elle juste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vision divine est la réalité. La vision humaine est illusoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est relatif. Allah voit tout proche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit comme Allah voit est sage." }
  ],
  munajat: `Ya Basir, Tu vois le châtiment proche. Fais que je le voie aussi. Ne permets pas que je sois trompé par l'éloignement apparent.`
};

MIROIR["70:7"] = {
  reference: "70:7",
  theme: ["proximité", "vision", "réalité"],
  emotion: "Urgence, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qarib", "Al-'Alim"],
  mirrorVersion: `« Nous le voyons proche. » Le miroir me montre la réalité divine. « Wa narahu qariban » — Nous le voyons proche. Pour Allah, tout est proche. Le miroir m'interroge : est-ce que je vis comme si le jugement était proche ?`,
  reflection: `Pour Allah, le Jour du jugement est proche. Notre perception du temps est limitée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa narahu qariban » — Nous le voyons proche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si le jugement était proche ? Ou comme s'il était loin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité du jugement appelle à la préparation immédiate." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est créé. Allah est au-dessus du temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme si c'était proche est préparé." }
  ],
  munajat: `Ya Qarib, le jugement est proche. Fais que je vive en conséquence. Ne permets pas que je repousse ma préparation.`
};

MIROIR["70:8"] = {
  reference: "70:8",
  theme: ["ciel", "métal", "fusion"],
  emotion: "Awe, terreur",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Jabbar"],
  mirrorVersion: `« Le jour où le ciel sera comme de la boue fondue. » Le miroir me montre la transformation cosmique. « Yawma takunu al-sama'u ka-l-muhl » — le jour où le ciel sera comme de la boue fondue. Le ciel se transformera. Le miroir m'interroge : suis-je prêt pour cette transformation ?`,
  reflection: `Le ciel lui-même se transformera. Rien ne reste comme avant au Jour du jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma takunu al-sama'u ka-l-muhl » — le jour où le ciel sera comme de la boue fondue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour cette transformation ? Ma vie sera-t-elle transformée aussi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transformation du ciel annonce la transformation de tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera transformé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se transforme avant le Jour n'a pas peur." }
  ],
  munajat: `Ya Qadir, le ciel sera transformé. Transforme-moi avant ce Jour. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["70:9"] = {
  reference: "70:9",
  theme: ["montagnes", "laine", "cardée"],
  emotion: "Awe, transformation",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Musawwir"],
  mirrorVersion: `« Et les montagnes comme de la laine cardée. » Le miroir me montre l'évanouissement du solide. « Wa takunu al-jibalu ka-l-'ihn » — et les montagnes comme de la laine cardée. Le plus solide devient mou. Le miroir m'interroge : sur quoi je compte de solide ?`,
  reflection: `Les montagnes, si solides, deviendront comme de la laine. Rien n'est solide sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa takunu al-jibalu ka-l-'ihn » — et les montagnes comme de la laine cardée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je compte de solide ? Les montagnes elles-mêmes s'effondreront." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évanouissement du solide révèle l'éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui est solide ici-bas sera évanoui là-bas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur l'éternel n'a pas peur." }
  ],
  munajat: `Ya Musawwir, les montagnes s'effondreront. Fais que je compte sur Toi, l'Éternel. Ne permets pas que je m'appuie sur ce qui s'effondrera.`
};

MIROIR["70:10"] = {
  reference: "70:10",
  theme: ["amis", "question", "solitude"],
  emotion: "Solennité, interrogation",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Haqq"],
  mirrorVersion: `« Et nul ami intime ne posera de question à son ami. » Le miroir me montre la rupture des liens. « Wa la yas'al hamimun hamiman » — nul ami intime ne posera de question à son ami. Chacun sera préoccupé par son propre sort. Le miroir m'interroge : qui me sauvera ce Jour-là ?`,
  reflection: `Les liens d'amitié seront rompus ce Jour-là. Chacun sera seul avec son sort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yas'al hamimun hamiman » — et nul ami intime ne posera de question à son ami." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui me sauvera ce Jour-là ? Mes amis pourront-ils m'aider ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La solitude du Jugement révèle qui est le vrai ami." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme sera seule devant son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah pour ami n'est jamais seul." }
  ],
  munajat: `Ya Wali, sois mon ami ce Jour-là. Fais que je ne compte pas sur les amis humains. Donne-moi Ton amitié éternelle.`
};

MIROIR["70:11"] = {
  reference: "70:11",
  theme: ["exposition", "châtiment", "regret"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mubin", "Al-Jabbar"],
  mirrorVersion: `« On les exposera les uns aux autres. Le pécheur voudrait se racheter du châtiment. » Le miroir me montre l'exposition et le désespoir. « Yubassarunahum yaw'iddu al-mujrimu law ya'tadibu 'an 'adabi yawma'idhin » — ils seront exposés, le pécheur voudra se racheter. Le regret sera trop tard. Le miroir m'interroge : vais-je attendre le regret ou me préparer maintenant ?`,
  reflection: `Le pécheur voudra se racheter au Jour du jugement, mais ce sera trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yubassarunahum yaw'iddu al-mujrimu law ya'tadibu 'an 'adabi yawma'idhin » — on les exposera les uns aux autres. Le pécheur voudrait se racheter du châtiment de ce jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vais-je attendre le regret ou me préparer maintenant ? Sera-t-il trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret tardif ne sauve pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'opportunité de se racheter est maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare maintenant n'a pas de regret." }
  ],
  munajat: `Ya Rabb, je me prépare maintenant. Ne permets pas que j'attende le Jour du regret. Donne-moi la préparation qui sauve.`
};

MIROIR["70:12"] = {
  reference: "70:12",
  theme: ["famille", "rançon", "sacrifice"],
  emotion: "Désespoir, sacrifice",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Par ses enfants, sa compagne, son frère. » Le miroir me montre ce qu'on donnerait en rançon. « Bi-banihi wa sahibatihi wa akhihi » — par ses enfants, sa compagne, son frère. Les liens les plus chers seraient donnés. Le miroir m'interroge : qu'est-ce que je donnerais pour me sauver ?`,
  reflection: `Les liens les plus chers seraient sacrifiés pour se sauver du châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-banihi wa sahibatihi wa akhihi » — par ses enfants, sa compagne, son frère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je donnerais pour me sauver ? Les liens chers suffiront-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rançon humaine ne sauve pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seule la foi sauve, pas les liens humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi n'a pas besoin de rançon." }
  ],
  munajat: `Ya Rabb, je n'ai pas de rançon à donner. Seule ma foi compte. Sauve-moi par ma foi, pas par mes liens.`
};

MIROIR["70:13"] = {
  reference: "70:13",
  theme: ["parenté", "abri", "sécurité"],
  emotion: "Désespoir, recherche",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-Hafiz"],
  mirrorVersion: `« Et de sa parenté qui lui donne asile. » Le miroir me montre la recherche de protection. « Wa fasilatihi allati tu'wihi » — et de sa parenté qui lui donne asile. Même la protection de la parenté ne suffit pas. Le miroir m'interroge : où trouverai-je asile ce Jour-là ?`,
  reflection: `Même la parenté protectrice ne peut pas sauver du châtiment d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fasilatihi allati tu'wihi » — et de sa parenté qui lui donne asile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où trouverai-je asile ce Jour-là ? Qui peut me protéger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'asile humain ne protège pas du châtiment divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah peut protéger ce Jour-là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah pour asile est protégé." }
  ],
  munajat: `Ya Muhaymin, sois mon asile. Fais que je me réfugie en Toi. Ne permets pas que je cherche un asile humain.`
};

MIROIR["70:14"] = {
  reference: "70:14",
  theme: ["humanité", "rançon", "désespoir"],
  emotion: "Désespoir, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Haqq"],
  mirrorVersion: `« Et de tous ceux qui sont sur terre, pour le sauver. » Le miroir me montre l'offre totale. « Wa man fi al-ardi jami'an thumma yunjiyah » — et de tous ceux qui sont sur terre, pour le sauver. Tout serait donné pour se sauver. Le miroir m'interroge : est-ce que je réalise que rien ne sauve sauf Allah ?`,
  reflection: `Toute la terre ne suffirait pas comme rançon. Seul Allah sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man fi al-ardi jami'an thumma yunjiyah » — et de tous ceux qui sont sur terre, pour le sauver." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que rien ne sauve sauf Allah ? Qu'est-ce que je pourrais donner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rançon terrestre ne sauve pas du châtiment divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seule la miséricorde d'Allah sauve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend cela se soumet." }
  ],
  munajat: `Ya Ghani, rien ne sauve sauf Toi. Je me soums à Ta miséricorde. Ne permets pas que je cherche le salut ailleurs.`
};

MIROIR["70:15"] = {
  reference: "70:15",
  theme: ["feu", "réalité", "impossibilité"],
  emotion: "Terreur, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Haqq"],
  mirrorVersion: `« Non ! C'est une flamme arrachant le crâne. » Le miroir me montre la réalité du châtiment. « Kalla innaha lazah » — Non ! C'est une flamme. La réalité est terrifiante. Le miroir m'interroge : est-ce que je réalise la réalité du châtiment ?`,
  reflection: `La flamme de l'enfer est une réalité. Nul ne peut y échapper sans la miséricorde d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla innaha lazah » — Non ! C'est une flamme arrachant le crâne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la réalité du châtiment ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réalité du châtiment appelle à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfer est une réalité cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la réalité se prépare." }
  ],
  munajat: `Ya Rabb, l'enfer est une réalité. Préserve-moi de la flamme. Fais que je me prépare pour l'éviter.`
};

MIROIR["70:16"] = {
  reference: "70:16",
  theme: ["arrachement", "crâne", "châtiment"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Arrachant le crâne. » Le miroir me montre l'intensité du châtiment. « Nazzá'atan li-l-shawa » — arrachant le crâne. Le châtiment atteint le corps dans son essence. Le miroir m'interroge : puis-je supporter un tel châtiment ?`,
  reflection: `Le châtiment de l'enfer atteint le corps dans sa structure même. La peau sera brûlée et renouvelée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nazzá'atan li-l-shawa » — arrachant le crâne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Puis-je supporter un tel châtiment ? Mon corps résistera-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intensité du châtiment révèle la gravité de la désobéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu de l'enfer dépasse tout feu terrestre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment l'évite." }
  ],
  munajat: `Ya Jabbar, je ne peux pas supporter ce châtiment. Préserve-moi de l'enfer. Fais que je craigne assez pour l'éviter.`
};

MIROIR["70:17"] = {
  reference: "70:17",
  theme: ["appel", "rebelle", "détourne"],
  emotion: "Terreur, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Da'i", "Al-Haqq"],
  mirrorVersion: `« Elle appelle celui qui a tourné le dos et s'est détourné. » Le miroir me montre l'appel de l'enfer. « Tad'u man ad-dalla wa tawalla » — elle appelle celui qui s'est détourné. L'enfer appelle les rebelles. Le miroir m'interroge : est-ce que je me suis détourné ?`,
  reflection: `L'enfer appelle ceux qui se sont détournés d'Allah. Le retour est possible maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tad'u man ad-dalla wa tawalla » — elle appelle celui qui a tourné le dos et s'est détourné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me suis détourné ? L'enfer m'appellera-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour maintenant évite l'appel de l'enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfer est préparé pour ceux qui se détournent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient n'est pas appelé par l'enfer." }
  ],
  munajat: `Ya Rabb, je ne veux pas être appelé par l'enfer. Fais que je me tourne vers Toi. Ne permets pas que je me détourne.`
};

MIROIR["70:18"] = {
  reference: "70:18",
  theme: ["accumulation", "richesse", "avarice"],
  emotion: "Avertissement, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Khaliq"],
  mirrorVersion: `« Qui a amassé et thésaurisé. » Le miroir me montre l'avarice. « Jama'a fa-aw'a » — qui a amassé et thésaurisé. L'accumulation sans partage est condamnée. Le miroir m'interroge : est-ce que j'accumule sans partager ?`,
  reflection: `L'accumulation sans partage est un signe d'avarice. La richesse est un test.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jama'a fa-aw'a » — qui a amassé et thésaurisé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accumule sans partager ? Suis-je avare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le partage est la réponse à l'accumulation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse est un dépôt, pas une propriété." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage ne thésaurise pas." }
  ],
  munajat: `Ya Ghani, ne permets pas que je sois avare. Fais que je partage. Donne-moi la générosité qui sauve de l'avarice.`
};

MIROIR["70:19"] = {
  reference: "70:19",
  theme: ["nature", "homme", "impatience"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-'Alim"],
  mirrorVersion: `« Certes, l'homme a été créé impatient. » Le miroir me montre la nature humaine. « Inna al-insana khuliqa halu'an » — l'homme a été créé impatient. L'impatience est naturelle. Le miroir m'interroge : est-ce que je transcende ma nature ?`,
  reflection: `L'impatience est dans la nature humaine. La transcender est un acte spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-insana khuliqa halu'an » — certes, l'homme a été créé impatient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transcende ma nature ? Ou est-ce que je suis mon impatience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience transcende la nature impatiente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est une création avec des défis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui transcende sa nature s'élève." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé avec des défis. Aide-moi à transcender mon impatience. Donne-moi la patience qui dépasse la nature.`
};

MIROIR["70:20"] = {
  reference: "70:20",
  theme: ["malheur", "impatience", "nature"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Sabur"],
  mirrorVersion: `« Quand le malheur le touche, il est impatient. » Le miroir me montre la réaction au malheur. « Iza massahu al-sharru jazu'an » — quand le malheur le touche, il est impatient. La réaction naturelle est l'impatience. Le miroir m'interroge : comment je réagis au malheur ?`,
  reflection: `La réaction naturelle au malheur est l'impatience. La foi change cette réaction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza massahu al-sharru jazu'an » — quand le malheur le touche, il est impatient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis au malheur ? Avec impatience ou avec patience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience dans le malheur est un signe de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le malheur touche tout le monde. La réaction différencie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente dans le malheur est élevé." }
  ],
  munajat: `Ya Sabur, le malheur me touche. Fais que je patiente. Ne permets pas que je sois impatient dans l'épreuve.`
};

MIROIR["70:21"] = {
  reference: "70:21",
  theme: ["bonheur", "générosité", "nature"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mannan"],
  mirrorVersion: `« Et quand le bonheur le touche, il est généreux. » Le miroir me montre la réaction au bonheur. « Wa idha massahu al-khayru mani'an » — quand le bonheur le touche, il est généreux. La réaction au bonheur est la retenue. Le miroir m'interroge : comment je réagis au bonheur ?`,
  reflection: `La réaction au bonheur peut être la retenue ou le partage. La foi change cette réaction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha massahu al-khayru mani'an » — et quand le bonheur le touche, il est généreux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis au bonheur ? Avec retenue ou avec partage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité dans le bonheur est un signe de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bonheur touche tout le monde. La réaction différencie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage dans le bonheur est béni." }
  ],
  munajat: `Ya Karim, le bonheur me touche. Fais que je sois généreux. Ne permets pas que je sois retenu dans l'abondance.`
};

MIROIR["70:22"] = {
  reference: "70:22",
  theme: ["prière", "exception", "constance"],
  emotion: "Espoir, distinction",
  difficulty: "débutant",
  relatedNames: ["Al-Musallin", "Al-Hafiz"],
  mirrorVersion: `« Sauf ceux qui accomplissent la prière. » Le miroir me montre l'exception. « Illa al-musallin » — sauf ceux qui accomplissent la prière. La prière distingue. Le miroir m'interroge : suis-je de ceux qui prient ?`,
  reflection: `Ceux qui prient sont l'exception. La prière constante transforme la nature.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa al-musallin » — sauf ceux qui accomplissent la prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je de ceux qui prient ? La prière me distingue-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière est le chemin de la distinction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière élève au-dessus de la nature commune." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie constamment transcende sa nature." }
  ],
  munajat: `Ya Rabb, je veux être de ceux qui prient. Fais que ma prière soit constante. Donne-moi la distinction par la prière.`
};

MIROIR["70:23"] = {
  reference: "70:23",
  theme: ["constance", "prière", "dévotion"],
  emotion: "Ferveur, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Da'im", "Al-Hafiz"],
  mirrorVersion: `« Qui sont constants dans leur prière. » Le miroir me montre la constance. « Alladhina hum 'ala salatihim da'imun » — qui sont constants dans leur prière. La constance est la clé. Le miroir m'interroge : est-ce que je suis constant dans ma prière ?`,
  reflection: `La constance dans la prière est le signe de la vraie dévotion. La régularité transforme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina hum 'ala salatihim da'imun » — qui sont constants dans leur prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis constant dans ma prière ? Ou est-ce que je l'abandonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance est le secret de la transformation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La régularité est une loi de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est constant reçoit la constance divine." }
  ],
  munajat: `Ya Da'im, je veux être constant dans ma prière. Fais que je ne l'abandonne jamais. Donne-moi la régularité qui transforme.`
};

MIROIR["70:24"] = {
  reference: "70:24",
  theme: ["droit", "pauvre", "partage"],
  emotion: "Générosité, justice",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-'Adl"],
  mirrorVersion: `« Et dans leurs biens, il y a un droit pour le mendiant et le privé. » Le miroir me montre le droit des pauvres. « Wa alladhina fi amwalihim haqqun ma'lum » — dans leurs biens, un droit connu. Le partage est un devoir. Le miroir m'interroge : est-ce que je respecte ce droit ?`,
  reflection: `Les pauvres ont un droit sur nos biens. Ce n'est pas une faveur, c'est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina fi amwalihim haqqun ma'lum » — et dans leurs biens, il y a un droit connu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte ce droit ? Mon partage est-il un devoir ou une faveur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le droit des pauvres précède le droit de soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse est un dépôt avec des droits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le droit des pauvres est béni." }
  ],
  munajat: `Ya 'Adl, je respecte le droit des pauvres. Fais que mon partage soit un devoir. Ne permets pas que je considère mes biens comme miens.`
};

MIROIR["70:25"] = {
  reference: "70:25",
  theme: ["demandeur", "privé", "générosité"],
  emotion: "Générosité, compassion",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Pour le demandeur et le privé. » Le miroir me montre les bénéficiaires. « Li-l-sa'ili wa al-mahrum » — pour le demandeur et le privé. Tous les pauvres sont concernés. Le miroir m'interroge : est-ce que je donne à tous les pauvres ?`,
  reflection: `Le demandeur et le privé ont des droits. L'un demande, l'autre se tait. Les deux méritent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-l-sa'ili wa al-mahrum » — pour le demandeur et le privé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne à tous les pauvres ? Au demandeur et au silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le silencieux a autant de droits que le demandeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pauvreté a de nombreuses formes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne à tous les pauvres est complet." }
  ],
  munajat: `Ya Mannan, je donne au demandeur et au privé. Fais que je voie tous les pauvres. Ne permets pas que j'oublie les silencieux.`
};

// ==================== SURAH 33: AL-AHZAB (73 verses) - COMPLETE COVERAGE ====================

MIROIR["33:11"] = {
  reference: "33:11",
  theme: ["épreuve", "foi", "hypocrisie"],
  emotion: "Introspection, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bala'", "Al-Haqq"],
  mirrorVersion: `« C'est là que les croyants furent mis à l'épreuve et secoués d'une forte secousse. » Le miroir me montre que l'épreuve révèle ce qui est caché. « Zulzilu » — secoués. Comme un arbre qu'on secoue pour en faire tomber les fruits morts. L'épreuve ne crée pas l'hypocrisie — elle la révèle. Le miroir m'interroge : si j'étais secoué, que révélerais-je ?`,
  reflection: `L'épreuve est un révélateur. Elle ne change pas ce qui est — elle montre ce qui est vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huna lya b luma al-mu'minuna wa zulzilu zaljalan shadida » — c'est là que les croyants furent mis à l'épreuve et secoués d'une forte secousse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si j'étais secoué aujourd'hui, que révélerais-je ? Une foi solide ou une foi de façade ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La secousse qui effraie est aussi celle qui purifie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en constant mouvement. La stabilité apparente cache des forces sismiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est secoué et qui reste debout a prouvé sa foi." }
  ],
  munajat: `Ya Rabb, secoue-moi si nécessaire pour révéler ma vérité. Mais fortifie-moi avant l'épreuve. Ne permets pas que je sois de ceux qui s'effondrent.`
};

MIROIR["33:12"] = {
  reference: "33:12",
  theme: ["hypocrisie", "promesse", "exposition"],
  emotion: "Lucidité, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khafi", "Al-Batin"],
  mirrorVersion: `« Et quand les hypocrites et ceux qui ont la maladie dans le cœur disaient : 'Allah et Son messager ne nous ont promis qu'une illusion.' » Le miroir me montre le langage intérieur de l'hypocrisie. « Ma wa'adana Allah » — Allah ne nous a promis. L'hypocrite projette son doute sur la promesse divine. Le miroir m'interroge : quelles promesses d'Allah trouvent-elles du doute en moi ?`,
  reflection: `Le doute sur les promesses divines est le symptôme d'une maladie du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma wa'adana Allahu wa rasuluhu illa ghurura » — Allah et Son messager ne nous ont promis qu'une illusion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je doute des promesses d'Allah, de quoi s'agit-il vraiment ? D'une question intellectuelle ou d'une maladie du cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah est vérité — c'est le cœur malade qui la transforme en illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de la fidélité divine aux promesses. Les saisons reviennent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est sain voit les promesses d'Allah s'accomplir partout." }
  ],
  munajat: `Ya Haqq, purifie mon cœur de toute maladie. Fais que je voie Tes promesses comme des certitudes. Ne permets pas que le doute transforme Ta vérité en illusion.`
};

MIROIR["33:13"] = {
  reference: "33:13",
  theme: ["hypocrisie", "excuse", "épreuve"],
  emotion: "Vigilance, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khafi"],
  mirrorVersion: `« Et quand un groupe d'entre eux dit : 'Ô gens de Yathrib, vous ne pouvez rester, retournez !' » Le miroir me montre la tentation de la fuite. « La muqama lakum » — vous ne pouvez rester. L'hypocrite cherche des excuses pour partir. Sous couvert de bonne intention — protéger les familles — il abandonne la communauté. Le miroir m'interroge : quelles excuses je trouve pour éviter mes obligations ?`,
  reflection: `Les excuses habillent souvent la lâcheté en prudence. L'épreuve révèle qui fuit vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ahla Yathriba la muqama lakum fa-irji'u » — ô gens de Yathrib, vous ne pouvez rester, retournez !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je cherche des excuses pour éviter mes obligations, que dissimule vraiment ma fuite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui reste quand les autres fuient découvre des trésors cachés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne fuit pas ses obligations. L'arbre reste enraciné même dans la tempête." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Rester quand la fuite est tentante est un acte de foi qui transforme." }
  ],
  munajat: `Ya Rabb, quand je suis tenté de fuir, donne-moi le courage de rester. Ne permets pas que mes excuses cachent ma lâcheté. Fortifie mon cœur dans l'épreuve.`
};

MIROIR["33:14"] = {
  reference: "33:14",
  theme: ["hypocrisie", "tentation", "loyauté"],
  emotion: "Vérité, examen de conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Basir"],
  mirrorVersion: `« Et si on avait pénétré par ses côtés et qu'on les avait ensuite sollicités de renier leur foi, ils l'auraient fait sans hésiter. » Le miroir me montre la fragilité des engagements non enracinés. « La falatnaw » — ils l'auraient fait sans hésiter. L'hypocrisie n'a pas besoin de beaucoup pour basculer. Une simple sollicitation suffit. Le miroir m'interroge : quel prix pour ma foi ?`,
  reflection: `La foi véritable a un prix — mais l'hypocrisie n'a pas de prix. Elle se vend au premier enchérisseur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law dukhilat 'alayhim min actariba thumma su'ilu al-fitnata la-atawha » — et si on avait pénétré par ses côtés et qu'on les avait ensuite sollicités de renier leur foi, ils l'auraient fait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel prix pour ma foi ? Quel niveau de pression suffirait à me faire renier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi qui résiste à la tentation est la seule foi réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'or pur résiste au feu. La foi pure résiste à l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la fragilité de sa foi peut la fortifier avant l'épreuve." }
  ],
  munajat: `Ya Rabb, ma foi est fragile. Fortifie-la avant l'épreuve. Ne permets pas que je sois de ceux qui vendent leur foi au premier acheteur.`
};

MIROIR["33:15"] = {
  reference: "33:15",
  theme: ["promesse", "engagement", "responsabilité"],
  emotion: "Responsabilité, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wakil", "Al-Shahid"],
  mirrorVersion: `« Ils avaient pourtant promis à Allah auparavant qu'ils ne tourneraient pas le dos. » Le miroir me montre le poids des promesses. « Wa laqan 'ahada Allah » — ils avaient promis à Allah. La promesse à Allah n'est pas une parole légère. Elle engage l'être entier. Le miroir m'interroge : quelles promesses ai-je faites à Allah ?`,
  reflection: `La promesse à Allah engage toute l'existence. La rompre n'est pas un détail.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad kanu 'ahadu Allahi min qablu la yuwalluna al-adbar » — ils avaient pourtant promis à Allah auparavant qu'ils ne tourneraient pas le dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je promis à Allah ? Est-ce que je tiens mes promesses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tourner le dos à l'engagement, c'est tourner le dos à soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tient ses promesses. Les lois naturelles ne se dérobent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient ses promesses à Allah découvre qu'Allah tient Ses promesses à lui." }
  ],
  munajat: `Ya Rabb, j'ai fait des promesses envers Toi. Aide-moi à les tenir. Ne permets pas que je sois de ceux qui oublient leurs engagements.`
};

MIROIR["33:16"] = {
  reference: "33:16",
  theme: ["fuite", "destin", "acceptation"],
  emotion: "Résignation active, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadar", "Al-Muhaymin"],
  mirrorVersion: `« Dis : 'La fuite ne vous servira à rien, car si vous fuyez la mort ou le meurtre, vous ne jouirez alors que peu de temps.' » Le miroir me montre l'illusion de la fuite. « Lan yanfa'akum al-firar » — la fuite ne vous servira à rien. On ne peut pas fuir son destin. Le miroir m'interroge : de quoi est-ce que je fuis ?`,
  reflection: `La fuite ne repousse pas le destin — elle le rencontre ailleurs, sous une autre forme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul lan yanfa'akum al-firaru in fartum mina al-mawti awa al-qatli » — dis : la fuite ne vous servira à rien, car si vous fuyez la mort ou le meurtre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi est-ce que je fuis ? Est-ce que je réalise que la fuite ne résout rien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Fuir ce qui doit venir, c'est courir vers une autre forme du même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le destin est inévitable. Chaque route mène à lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte son destin le rencontre avec dignité." }
  ],
  munajat: `Ya Qadir, je ne peux fuir Ton destin. Aide-moi à l'accepter avec dignité. Ne permets pas que je vive dans la fuite illusoire.`
};

MIROIR["33:17"] = {
  reference: "33:17",
  theme: ["protection", "destin", "alliés"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Mawla"],
  mirrorVersion: `« Dis : 'Qui peut vous protéger d'Allah s'Il veut vous faire du mal ou veut vous faire miséricorde ?' » Le miroir me montre l'illusion des protecteurs humains. « Man yamna'ukum » — qui peut vous protéger ? Personne ne peut s'interposer entre Allah et Sa créature. Le miroir m'interroge : en qui est-ce que je place ma confiance ?`,
  reflection: `Il n'y a de protection que celle d'Allah. Tous les autres protecteurs sont illusoires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yamna'ukum mina Allahi in arada bikum su'an aw arada bikum rahmatan » — qui peut vous protéger d'Allah s'Il veut vous faire du mal ou veut vous faire miséricorde ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "En qui est-ce que je place ma confiance ? Est-ce que je réalise que seul Allah protège vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chercher la protection ailleurs qu'en Allah, c'est s'exposer au danger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier dépend d'Allah pour sa protection. Aucune créature n'est son propre gardien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise qu'Allah est son seul protecteur n'a plus peur de rien." }
  ],
  munajat: `Ya Wali, Tu es mon seul protecteur. Fais que je place toute ma confiance en Toi. Ne permets pas que je cherche des protecteurs illusoires.`
};

MIROIR["33:18"] = {
  reference: "33:18",
  theme: ["hypocrisie", "direction", "sincérité"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Khafi"],
  mirrorVersion: `« Allah connaît ceux d'entre vous qui sont des empêcheurs et ceux qui disent à leurs frères : 'Venez vers nous.' » Le miroir me montre les saboteurs discrets. « Al-mu'awwiqina » — les empêcheurs. Ceux qui freinent les autres tout en prétendant les aider. Le miroir m'interroge : est-ce que j'encourage ou est-ce que je freine ?`,
  reflection: `Certains freinent les autres tout en prétendant être des conseillers. L'action révèle l'intention.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad ya'lamu Allahu al-mu'awwiqina minkum wa al-qailina li-ikhwanihim » — Allah connaît ceux d'entre vous qui sont des empêcheurs et ceux qui disent à leurs frères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un empêcheur ou un encourageur ? Mes paroles poussent-elles vers le bien ou freinent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui freine les autres freine aussi sa propre progression." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers avance par cooperation. Les freineurs s'excluent du mouvement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît les intentions cachées derrière les conseils." }
  ],
  munajat: `Ya 'Alim, Tu connais mes intentions. Fais que je sois un encourageur, pas un freineur. Ne permets pas que mes conseils cachent de la jalousie ou de la peur.`
};

MIROIR["33:19"] = {
  reference: "33:19",
  theme: ["hypocrisie", "avarice", "égoïsme"],
  emotion: "Discernement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Al-Karim"],
  mirrorVersion: `« Avares envers vous. Quand la peur survient, tu les vois te regarder avec les yeux de celui qui s'évanouit. » Le miroir me montre l'hypocrisie en action. « Ashihhatun 'alaykum » — avares envers vous. L'hypocrite ne donne pas, même quand il le devrait. « Ghashiyan 'alayhi » — comme celui qui s'évanouit. La peur révèle sa vraie nature. Le miroir m'interroge : que révèle ma peur ?`,
  reflection: `La peur révèle ce qui est caché. L'avare montre son avarice dans la difficulté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ashihhatun 'alaykum fa-idha jaa al-khawf ra-aytahum yanzuruna ilayka » — avares envers vous. Quand la peur survient, tu les vois te regarder." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que révèle ma peur ? Suis-je généreux ou avare dans la difficulté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité dans la peur est le signe d'une foi authentique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne même dans la difficulté. Le soleil brille même quand l'orage menace." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne dans la difficulté reçoit dans l'abondance." }
  ],
  munajat: `Ya Karim, sois généreux même dans la peur. Ne permets pas que mon avarice se révèle dans la difficulté. Fais que je donne comme Tu donnes.`
};

MIROIR["33:20"] = {
  reference: "33:20",
  theme: ["hypocrisie", "attente", "opportunisme"],
  emotion: "Lucidité, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Ils pensent que les coalisés ne sont pas partis. Et si les coalisés venaient, ils aimeraient être au désert parmi les Bédouins pour demander des nouvelles. » Le miroir me montre l'opportunisme de l'hypocrite. « Law annahum fi al-badiyah » — s'ils étaient au désert. L'hypocrite veut être ailleurs — n'importe où sauf là où il doit être. Le miroir m'interroge : où veux-je être au lieu d'être ici ?`,
  reflection: `L'hypocrite veut toujours être ailleurs. Le croyant est là où Allah le veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahsabuna al-ahzaba lam yadhhabu » — ils pensent que les coalisés ne sont pas partis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où veux-je être au lieu d'être ici ? Est-ce que j'accepte ma place ou est-ce que je fuis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être là où Allah nous veut est le meilleur endroit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est à sa place. L'homme seul cherche à être ailleurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa place trouve la paix. Celui qui veut être ailleurs perd tout." }
  ],
  munajat: `Ya Rabb, accepte ma place ici et maintenant. Ne permets pas que je cherche à être ailleurs. Fais que je sois présent là où Tu me veux.`
};

MIROIR["33:23"] = {
  reference: "33:23",
  theme: ["engagement", "sacrifice", "foi"],
  emotion: "Admiration, inspiration",
  difficulty: "intermédiaire",
  relatedNames: ["As-Siddiq", "Ash-Shahid"],
  mirrorVersion: `« Parmi les croyants, il y a des hommes qui ont été sincères dans leur engagement envers Allah. » Le miroir me montre la beauté de l'engagement total. « Sadaquu 'ahdahum » — ils ont été sincères dans leur engagement. La sincérité n'est pas une parole — c'est une vie. Certains ont tenu leur promesse par le martyre, d'autres attendent leur tour. Le miroir m'interroge : mon engagement est-il sincère ?`,
  reflection: `L'engagement sincère se voit dans les actes, pas dans les paroles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mina al-mu'minina rijalun sadaquu 'ahdahum ma'Allah » — parmi les croyants, il y a des hommes qui ont été sincères dans leur engagement envers Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon engagement est-il sincère ? Ma vie témoigne-t-elle de ma promesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité n'est pas un sentiment — c'est une fidélité jusqu'au bout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fidèle à son engagement. Les lois naturelles ne se dérobent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère dans son engagement découvre qu'Allah est sincère dans le Sien." }
  ],
  munajat: `Ya Rabb, je veux être sincère dans mon engagement. Fais que ma vie témoigne de ma promesse. Ne permets pas que mes paroles soient plus grandes que mes actes.`
};

MIROIR["33:24"] = {
  reference: "33:24",
  theme: ["véracité", "rétribution", "hypocrisie"],
  emotion: "Espoir, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hakim"],
  mirrorVersion: `« Afin qu'Allah récompense les véridiques pour leur vérité et châtie les hypocrites s'Il veut. » Le miroir me montre la rétribution selon la nature. « Li-yajziya Allah » — afin qu'Allah récompense. La rétribution n'est pas arbitraire — elle correspond à ce qui a été semé. Le miroir m'interroge : que sème-je ?`,
  reflection: `La rétribution correspond à la semence. Vérité pour vérité, hypocrisie pour hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yajziya Allahu al-sadiqina bi-sidqihim » — afin qu'Allah récompense les véridiques pour leur vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que sème-je ? De la vérité ou de l'hypocrisie ? Ma rétribution dépend de ma semence." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rétribution n'est pas punition — c'est récolte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rétribue chaque action. Chaque cause a son effet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la loi de la rétribution ne s'étonne de rien." }
  ],
  munajat: `Ya Rabb, je veux semer la vérité. Récompense-moi selon ma sincérité. Ne permets pas que je récolte ce que je n'ai pas semé.`
};

MIROIR["33:25"] = {
  reference: "33:25",
  theme: ["victoire", "alliés", "repli"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["An-Nasr", "Al-Aziz"],
  mirrorVersion: `« Allah a repoussé les mécréants avec leur rage, sans qu'ils n'aient obtenu aucun bien. » Le miroir me montre la victoire sans combat. « Radda Allah » — Allah a repoussé. La victoire vient d'Allah, pas des armées. « Bighayzin » — avec leur rage. La rage des ennemis se retourne contre eux. Le miroir m'invite à la gratitude.`,
  reflection: `La victoire vient d'Allah. La rage des ennemis est leur propre piège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa radda Allahu alladhina kafaru bighayzihim » — Allah a repoussé les mécréants avec leur rage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment Allah m'a-t-Il protégé de mes ennemis ? Est-ce que je Lui suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rage des ennemis est leur propre défaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers équilibre les forces. L'agression se retourne contre l'agresseur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise que la victoire vient d'Allah n'a pas peur des ennemis." }
  ],
  munajat: `Ya Nasir, Tu m'as protégé de mes ennemis. Je suis reconnaissant. Fais que je me souvienne de Tes victoires. Ne permets pas que l'ingratitude s'installe.`
};

MIROIR["33:26"] = {
  reference: "33:26",
  theme: ["alliés", "soumission", "rétribution"],
  emotion: "Révérence, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Qahhar"],
  mirrorVersion: `« Il fit descendre de leurs forteresses ceux des gens du Livre qui les avaient soutenus et Il jeta l'effroi dans leurs cœurs. » Le miroir me montre la chute des alliés traîtres. « Anzal » — Il fit descendre. Les forteresses ne protègent pas ceux qu'Allah veut atteindre. « Al-ru'b » — l'effroi. La peur entre là où la protection humaine échoue. Le miroir m'avertit : aucune forteresse ne protège de la volonté d'Allah.`,
  reflection: `Les forteresses humaines sont vulnérables. Seule la protection d'Allah est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anzala alladhina zaharuhum min ahli al-kitabi min sayasanihim » — Il fit descendre de leurs forteresses ceux des gens du Livre qui les avaient soutenus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quelles forteresses humaines je compte ? Sont-elles fiables face à la volonté d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plus haute forteresse tombe devant la plus humble foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les murailles les plus solides s'effondrent quand leur heure vient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a d'autre forteresse qu'Allah est le mieux protégé." }
  ],
  munajat: `Ya Jabbar, Tu es ma seule forteresse. Ne permets pas que je compte sur les murailles humaines. Fais que je cherche refuge en Toi seul.`
};

MIROIR["33:27"] = {
  reference: "33:27",
  theme: ["héritage", "victoire", "bénédiction"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Mannan"],
  mirrorVersion: `« Et Il vous a fait hériter de leurs terres, de leurs demeures, de leurs biens et d'une terre que vous n'aviez pas foulée. » Le miroir me montre l'héritage inattendu. « Awrathakum » — Il vous a fait hériter. L'héritage vient d'Allah, pas de nos mérites. « Ardan lam tata'uha » — une terre que vous n'aviez pas foulée. Allah donne au-delà de ce qu'on peut imaginer. Le miroir m'invite à la reconnaissance.`,
  reflection: `L'héritage divin dépasse toujours les attentes. Ce qu'on n'a pas demandé nous est donné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awrathakum ardahum wa diyahum wa amwalahum » — Et Il vous a fait hériter de leurs terres, de leurs demeures, de leurs biens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah m'a donné sans que je l'aie demandé ? Est-ce que je Lui suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage n'est pas un droit — c'est un don qui demande reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre elle-même est un héritage. Nous ne l'avons pas créée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'héritage reçoit plus d'héritage." }
  ],
  munajat: `Ya Warith, Tu m'as fait hériter de biens non demandés. Je suis reconnaissant. Fais que je gère cet héritage selon Ta volonté. Ne permets pas que l'ingratitude s'installe.`
};

MIROIR["33:28"] = {
  reference: "33:28",
  theme: ["choix", "détachement", "sacrifice"],
  emotion: "Introspection, décision",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hadi"],
  mirrorVersion: `« Ô Prophète ! Dis à tes épouses : 'Si c'est la vie présente que vous désirez et sa parure, alors venez ! Je vous donnerai quelque jouissance et je vous libérerai de belle façon.' » Le miroir me montre le choix offert. « In kuntunna turidna al-hayata al-dunya » — si c'est la vie présente que vous désirez. Le choix est clair : le monde ou Allah. Le miroir m'interroge : que désiré-je vraiment ?`,
  reflection: `Le choix entre le monde et Allah est posé à chaque moment. La réponse se voit dans les actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nabi qul li-azwajika in kuntunna turidna al-hayata al-dunya wa zinataha » — ô Prophète ! Dis à tes épouses : si c'est la vie présente que vous désirez et sa parure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si on me proposait ce choix, que répondrais-je ? Ma vie montre-t-elle ma réponse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Choisir Allah, c'est choisir le tout. Choisir le monde, c'est choisir le rien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers offre le choix à chaque instant : se tourner vers l'éternel ou vers le temporel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit Allah découvre que le monde vient en plus." }
  ],
  munajat: `Ya Rabb, je choisis Toi. Mais mon cœur est partagé. Purifie mon désir. Fais que je choisisse Toi vraiment, pas seulement en paroles.`
};

MIROIR["33:29"] = {
  reference: "33:29",
  theme: ["choix", "engagement", "récompense"],
  emotion: "Engagement, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Jannah"],
  mirrorVersion: `« Mais si c'est Allah que vous désirez et Son messager et la demeure dernière, Allah a préparé pour les bienfaisantes d'entre vous une immense récompense. » Le miroir me montre la beauté du bon choix. « In kuntunna turidna Allaha wa rasulahu » — si c'est Allah que vous désirez. Le désir d'Allah transforme tout. « Ajran 'azima » — une immense récompense. La récompense dépasse l'imagination. Le miroir m'interroge : quel est mon vrai désir ?`,
  reflection: `Désirer Allah est le début de tout. La récompense suit automatiquement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kuntunna turidna Allaha wa rasulahu wa al-dara al-akhirata » — mais si c'est Allah que vous désirez et Son messager et la demeure dernière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon vrai désir ? Mon cœur penche-t-il vers Allah ou vers le monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Désirer Allah n'est pas une perte — c'est un gain infini." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers désire son Créateur par son existence même. L'homme seul peut choisir de désirer autre chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire Allah vraiment découvre que tout autre désir s'aligne." }
  ],
  munajat: `Ya Rabb, je désire Toi. Mais mon cœur est faible. Fortifie mon désir. Fais que je désire Toi plus que tout le reste.`
};

MIROIR["33:30"] = {
  reference: "33:30",
  theme: ["responsabilité", "moralité", "exemplarité"],
  emotion: "Vigilance, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakim"],
  mirrorVersion: `« Ô femmes du Prophète ! Celle d'entre vous qui commet une turpitude, le châtiment lui sera doublé. » Le miroir me montre la responsabilité de l'exemplarité. « Ya nisa al-nabi » — ô femmes du Prophète. La proximité du Prophète augmente la responsabilité. « Yuda'aff laha al-'adhab » — le châtiment sera doublé. Plus la position est haute, plus la chute est grave. Le miroir m'interroge : qu'est-ce que ma position demande de moi ?`,
  reflection: `La responsabilité augmente avec la proximité du bien. Être proche du Prophète demande plus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya nisa al-nabi man ya'ti minkunna bi-fahishatin mubayyinatin yuda'aff laha al-'adhab » — ô femmes du Prophète ! Celle d'entre vous qui commet une turpitude, le châtiment lui sera doublé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma position — familiale, sociale, spirituelle — demande de moi ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La haute position n'est pas un privilège — c'est une responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sommets sont plus exposés. La haute montagne reçoit plus de vent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la responsabilité de sa position est élevé encore plus." }
  ],
  munajat: `Ya 'Adl, Tu m'as donné une position. Aide-moi à en assumer la responsabilité. Ne permets pas que je l'oublie ou que je l'abuse.`
};

MIROIR["33:31"] = {
  reference: "33:31",
  theme: ["récompense", "obéissance", "exemplarité"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Jannah"],
  mirrorVersion: `« Et celle d'entre vous qui se soumet à Allah et à Son messager et fait le bien, Nous lui donnerons sa récompense deux fois. » Le miroir me montre la générosité divine. « Tu'azzafa » — Nous lui donnerons le double. La récompense suit la responsabilité. Plus on est responsable, plus on est récompensé — si on répond à la responsabilité. Le miroir m'invite à l'obéissance.`,
  reflection: `La responsabilité a deux faces : le châtiment si on faillit, la récompense si on réussit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yaqnut minkunna lillahi wa rasulihi wa ta'mal salihan nu'tiha ajraha marratayn » — et celle d'entre vous qui se soumet à Allah et à Son messager et fait le bien, Nous lui donnerons sa récompense deux fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réponds à ma responsabilité par l'obéissance ? Ma récompense dépend de ma réponse." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance n'est pas une contrainte — c'est l'accès à la récompense doublée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur. L'homme seul peut choisir la désobéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit avec joie reçoit plus que celui qui obéit avec contrainte." }
  ],
  munajat: `Ya Karim, je veux obéir avec joie. Donne-moi la récompense doublée. Ne permets pas que je voie l'obéissance comme une contrainte.`
};

MIROIR["33:32"] = {
  reference: "33:32",
  theme: ["modestie", "tentation", "protection"],
  emotion: "Vigilance, pudeur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Hakim"],
  mirrorVersion: `« Ô femmes du Prophète ! Vous n'êtes pas comme les autres femmes. Si vous êtes pieuses, ne vous laissez pas attendrir dans votre discours. » Le miroir me montre la vigilance nécessaire. « Lastunna ka-ahadin mina al-nisa » — vous n'êtes pas comme les autres femmes. La différence demande de la vigilance. « La tukhda'na bi-al-qawl » — ne vous laissez pas attendrir dans votre discours. Les mots peuvent être des portes. Le miroir m'interroge : mes paroles sont-elles gardées ?`,
  reflection: `La différence demande de la vigilance. Les paroles peuvent ouvrir des portes dangereuses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya nisa al-nabi lastunna ka-ahadin mina al-nisa ini ittaqaytunna » — ô femmes du Prophète ! Vous n'êtes pas comme les autres femmes. Si vous êtes pieuses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes paroles sont-elles gardées ? Ouvrent-elles des portes ou les ferment-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La modestie dans la parole protège le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature modère ses expressions. L'homme seul peut parler sans mesure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde sa langue garde son cœur." }
  ],
  munajat: `Ya Hafiz, garde ma langue. Fais que mes paroles soient mesurées. Ne permets pas que mes mots ouvrent des portes dangereuses.`
};

MIROIR["33:33"] = {
  reference: "33:33",
  theme: ["purification", "foyer", "obéissance"],
  emotion: "Purification, consécration",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tahir", "Al-Quddus"],
  mirrorVersion: `« Et restez dans vos maisons, ne vous exhibez pas comme on s'exhibait au temps de l'ignorance. » Le miroir me montre la protection du foyer. « Wa qarna fi buyutikunna » — restez dans vos maisons. Le foyer est un refuge, pas une prison. « La tabarrajna » — ne vous exhibez pas. L'exhibitionnisme spirituel est dangereux. Le miroir m'interroge : où est mon refuge ?`,
  reflection: `Le foyer protège de l'exhibitionnisme spirituel. Rester chez soi, c'est se protéger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qarna fi buyutikunna wa la tabarrajna tabarraja al-jahiliyyati al-ula » — et restez dans vos maisons, ne vous exhibez pas comme on s'exhibait au temps de l'ignorance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon refuge spirituel ? Est-ce que je m'exhibe ou est-ce que je me protège ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le foyer n'est pas une prison — c'est un sanctuaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature respecte ses limites. Chaque créature a son territoire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte son foyer respecte son âme." }
  ],
  munajat: `Ya Tahir, purifie mon foyer. Fais que c'en soit un sanctuaire. Ne permets pas que je m'exhibe spirituellement.`
};

MIROIR["33:34"] = {
  reference: "33:34",
  theme: ["rappel", "récitation", "sagesse"],
  emotion: "Apprentissage, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Et gardez en mémoire ce qui est récité dans vos maisons des versets d'Allah et de la sagesse. » Le miroir me montre le devoir de présence au Coran. « Wa dhkurna ma yutla » — et gardez en mémoire ce qui est récité. Le Coran n'est pas lu pour être oublié — il est lu pour être intégré. « Al-hikmah » — la sagesse. La sagesse accompagne la révélation. Le miroir m'interroge : que fais-je de ce que j'entends du Coran ?`,
  reflection: `Le Coran doit être gardé, pas simplement lu. L'intégration suit la récitation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkurna ma yutla fi buyutikunna min ayati Allahi wa al-hikmah » — et gardez en mémoire ce qui est récité dans vos maisons des versets d'Allah et de la sagesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que fais-je de ce que j'entends du Coran ? Est-ce que je l'intègre ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran oublié est un Coran perdu. Le Coran intégré est un Coran vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers intègre les informations qu'il reçoit. Les lois naturelles ne s'oublient pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui intègre le Coran devient lui-même une récitation vivante." }
  ],
  munajat: `Ya Rabb, fais que j'intègre Ton Coran. Ne permets pas que je l'oublie après l'avoir lu. Fais de moi un Coran vivant.`
};

MIROIR["33:36"] = {
  reference: "33:36",
  theme: ["soumission", "obéissance", "choix"],
  emotion: "Soumission, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hakim"],
  mirrorVersion: `« Il n'appartient pas à un croyant ou à une croyante, une fois qu'Allah et Son messager ont décidé d'une affaire, d'avoir encore le choix. » Le miroir me montre la soumission totale. « Ma kana li-mu'minin » — il n'appartient pas à un croyant. Le croyant est défini par sa soumission. « Khayaratan min amrihim » — le choix dans leur affaire. Le choix disparaît après la décision divine. Le miroir m'interroge : comment réagis-je aux décisions d'Allah ?`,
  reflection: `Le croyant n'a pas de choix après la décision d'Allah. La soumission est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana li-mu'minin wa la mu'minatin idha qada Allahu wa rasuluhu amran an yakuna lahumu al-khiyarat » — il n'appartient pas à un croyant ou à une croyante, une fois qu'Allah et Son messager ont décidé d'une affaire, d'avoir encore le choix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je aux décisions d'Allah ? Est-ce que je me soumets ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission n'est pas une perte — c'est un gain de guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers se soumet aux lois divines sans question. L'homme seul peut résister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet totalement découvre la liberté véritable." }
  ],
  munajat: `Ya Hakam, je me soumets à Tes décisions. Ne permets pas que je résiste. Fais que je trouve la liberté dans la soumission.`
};

MIROIR["33:37"] = {
  reference: "33:37",
  theme: ["mariage", "adoption", "lois"],
  emotion: "Révérence, confiance",
  difficulty: "avancé",
  relatedNames: ["Al-Shari'", "Al-Hakim"],
  mirrorVersion: `« Quand tu disais à celui qu'Allah avait comblé de bienfaits et que tu as comblé : 'Garde ton épouse et crains Allah.' » Le miroir me montre les lois sociales d'Allah. Ce verset traite du mariage avec la femme d'un fils adoptif — une pratique abolie par l'Islam. Le Prophète lui-même devait appliquer cette loi pour montrer l'exemple. Le miroir m'enseigne que les lois d'Allah s'appliquent à tous, même aux meilleurs.`,
  reflection: `Les lois d'Allah s'appliquent à tous. Le Prophète lui-même montre l'exemple.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh taqulu lilladhi an'ama Allahu 'alayhi wa an'amta 'alayhi » — quand tu disais à celui qu'Allah avait comblé de bienfaits et que tu as comblé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les lois d'Allah même quand elles me semblent difficiles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loi d'Allah est une miséricorde, même quand elle semble dure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois de l'univers sont impersonnelles et parfaites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la loi découvre sa sagesse cachée." }
  ],
  munajat: `Ya Rabb, j'accepte Tes lois. Fais que je les comprenne. Ne permets pas que je résiste à Ta sagesse.`
};

MIROIR["33:38"] = {
  reference: "33:38",
  theme: ["exemple", "facilité", "lois"],
  emotion: "Confiance, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sunan", "Al-Hakim"],
  mirrorVersion: `« Nulle faute sur le Prophète concernant ce qu'Allah lui a imposé. Telle est la sunna d'Allah pour ceux qui ont vécu auparavant. » Le miroir me montre que le Prophète n'est pas coupable d'appliquer les lois d'Allah. « Ma kana 'ala al-nabi » — nulle faute sur le Prophète. L'obéissance à Allah n'est jamais une faute. « Sunnata Allah » — la sunna d'Allah. Les lois sont constantes. Le miroir m'enseigne que l'obéissance est toujours juste.`,
  reflection: `L'obéissance à Allah n'est jamais une faute. Les lois d'Allah sont constantes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana 'ala al-nabi min harajin fima farada Allahu lahu » — nulle faute sur le Prophète concernant ce qu'Allah lui a imposé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens coupable d'obéir à Allah ? Non. L'obéissance est toujours juste." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La culpabilité vient de la désobéissance, jamais de l'obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit sans culpabilité. Pourquoi l'homme se sentirait-il coupable d'obéir ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit sans hésitation découvre la paix." }
  ],
  munajat: `Ya Rabb, j'obéis sans culpabilité. Fais que je sois clair sur mes devoirs. Ne permets pas que le doute m'envahisse.`
};

MIROIR["33:39"] = {
  reference: "33:39",
  theme: ["prophètes", "transmission", "crainte"],
  emotion: "Révérence, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Rusul", "Al-Khawf"],
  mirrorVersion: `« Ceux qui transmettent les messages d'Allah et Le craignent et ne craignent personne en dehors d'Allah. » Le miroir me montre la mission prophétique. « Yuballighuna » — ils transmettent. La transmission est le devoir. « Yakhawnahu » — ils Le craignent. La crainte d'Allah est la seule crainte. Le miroir m'interroge : qui est-ce que je crains ?`,
  reflection: `La seule crainte légitime est la crainte d'Allah. Les autres craintes sont des entraves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yuballighuna risalati Allahi wa yakhawnahu » — ceux qui transmettent les messages d'Allah et Le craignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je crains ? Allah ou les créatures ? Ma crainte révèle mon maître." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui craint Allah ne craint rien d'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne craint que son Créateur. Pourquoi l'homme craindrait-il autre chose ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte d'Allah libère de toutes les autres craintes." }
  ],
  munajat: `Ya Rabb, je veux Te craindre, Toi seul. Libère-moi de la peur des créatures. Fais que seule Ta crainte guide mes pas.`
};

MIROIR["33:40"] = {
  reference: "33:40",
  theme: ["prophète", "finalité", "mission"],
  emotion: "Révérence, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khatam", "Al-Mursal"],
  mirrorVersion: `« Muhammad n'est le père d'aucun de vos hommes, mais le messager d'Allah et le sceau des prophètes. » Le miroir me montre la finalité de la prophétie. « Khatama al-nabiyyin » — le sceau des prophètes. Muhammad est le dernier. Pas de prophète après lui. « Ma kana aban » — il n'est le père. Sa paternité spirituelle transcende la paternité biologique. Le miroir m'invite à reconnaître la finalité de la révélation.`,
  reflection: `Le Prophète est le dernier maillon de la chaîne prophétique. Sa mission est universelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana Muhammadan aban li-ahadin min rijalikum wa lakin rasula Allahi wa khatama al-nabiyyin » — Muhammad n'est le père d'aucun de vos hommes, mais le messager d'Allah et le sceau des prophètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la finalité de la prophétie ? Est-ce que je comprends ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le dernier prophète signifie que la guidance est complète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne de la prophétie est complète. Le message est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le sceau reconnaît la complétude du message." }
  ],
  munajat: `Ya Rabb, je reconnais Muhammad comme Ton dernier prophète. Fais que je respecte sa position. Ne permets pas que je l'oublie.`
};

MIROIR["33:43"] = {
  reference: "33:43",
  theme: ["bénédiction", "anges", "miséricorde"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mala'ika"],
  mirrorVersion: `« C'est Lui qui vous bénit, ainsi que Ses anges, pour vous faire sortir des ténèbres vers la lumière. » Le miroir me montre la bénédiction divine. « Yusalli 'alaykum » — Il vous bénit. Allah Lui-même bénit les croyants. « Wa mala'ikatuhu » — et Ses anges. Les anges participent à cette bénédiction. « Li-yukhrijakum » — pour vous faire sortir. Le but est la sortie des ténèbres. Le miroir m'invite à la gratitude.`,
  reflection: `Allah et Ses anges bénissent les croyants. Cette bénédiction vise à nous sortir des ténèbres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi yusalli 'alaykum wa mala'ikatuhu li-yukhrijakum mina al-zulumati ila al-nur » — c'est Lui qui vous bénit, ainsi que Ses anges, pour vous faire sortir des ténèbres vers la lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient de cette bénédiction ? Est-ce que je remercie Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bénédiction d'Allah est le plus grand honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est béni par son Créateur. Les croyants reçoivent une bénédiction spéciale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la bénédiction découvre qu'il est déjà dans la lumière." }
  ],
  munajat: `Ya Rahman, Tu me bénis. Je suis reconnaissant. Fais que je sois digne de cette bénédiction. Ne permets pas que je l'oublie.`
};

MIROIR["33:44"] = {
  reference: "33:44",
  theme: ["accueil", "paradis", "salutation"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Jannah"],
  mirrorVersion: `« Leur salutation le jour où ils Le rencontreront sera : 'Paix !' » Le miroir me montre l'accueil du Jour dernier. « Tahiyyatuhum » — leur salutation. Le jour de la rencontre avec Allah sera un jour de paix pour les croyants. « Salam » — paix. La paix éternelle commence par cette salutation. Le miroir m'invite à espérer cette rencontre.`,
  reflection: `La rencontre avec Allah sera un jour de paix pour les croyants. La salutation est « Salam ».`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tahiyyatuhum yawma yalqawnahu salam » — leur salutation le jour où ils Le rencontreront sera : 'Paix !'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère cette rencontre ? Ou est-ce que je la crains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Pour les croyants, la rencontre avec Allah est une joie, pas une peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix est l'état naturel de l'univers avec son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la paix ici-bas rencontrera Allah dans la paix." }
  ],
  munajat: `Ya Salam, j'espère Te rencontrer dans la paix. Prépare-moi à cette rencontre. Ne permets pas que je Te craigne comme les mécréants.`
};

MIROIR["33:46"] = {
  reference: "33:46",
  theme: ["prophète", "invitation", "lumière"],
  emotion: "Gratitude, ouverture",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Da'i"],
  mirrorVersion: `« Comme un inviteur vers Allah avec Sa permission et comme une lampe éclairante. » Le miroir me montre la fonction du Prophète. « Da'iyan ila Allah » — invitant vers Allah. Le Prophète est un guide, pas un but. « Sirajan munira » — une lampe éclairante. Il éclaire le chemin. Le miroir m'invite à suivre la lumière.`,
  reflection: `Le Prophète invite vers Allah. Il est une lampe qui éclaire, pas une idole à adorer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Da'iyan ila Allahi bi-idhnihi wa sirajan munira » — comme un inviteur vers Allah avec Sa permission et comme une lampe éclairante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la lumière du Prophète ? Est-ce que je suis son invitation vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète n'est pas le but — il est le chemin vers le But." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière du soleil éclaire mais n'est pas le but du voyage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète découvre Allah." }
  ],
  munajat: `Ya Rabb, je suis Ton Prophète. Fais que je le suive vers Toi. Ne permets pas que je m'arrête à lui comme but.`
};

MIROIR["33:47"] = {
  reference: "33:47",
  theme: ["bonne nouvelle", "foi", "promesse"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Wa'ud"],
  mirrorVersion: `« Et annonce aux croyants qu'ils ont auprès d'Allah une grande faveur. » Le miroir me montre la promesse d'Allah. « Bashshir » — annonce. La bonne nouvelle est un devoir. « Fadlan mina Allah » — une faveur d'Allah. La faveur dépasse le mérite. Le miroir m'invite à l'espérance.`,
  reflection: `Les croyants ont une grande faveur auprès d'Allah. Cette faveur est une bonne nouvelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa bashshir al-mu'minina bi-anna lahum mina Allahi fadlan kabira » — et annonce aux croyants qu'ils ont auprès d'Allah une grande faveur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère cette faveur ? Est-ce que j'ai confiance en la promesse d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faveur d'Allah dépasse ce que nous méritons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit des faveurs sans nombre. Les croyants reçoivent une faveur spéciale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la faveur la reçoit." }
  ],
  munajat: `Ya Mannan, j'espère Ta faveur. Donne-moi la bonne nouvelle. Ne permets pas que je désespère de Ta générosité.`
};

MIROIR["33:48"] = {
  reference: "33:48",
  theme: ["patience", "opposition", "confiance"],
  emotion: "Persévérance, calme",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Wakil"],
  mirrorVersion: `« Et n'obéis pas aux mécréants et aux hypocrites, et délaisse leur nuisance et place ta confiance en Allah. » Le miroir me montre la position face à l'opposition. « La tuti'i » — n'obéis pas. L'obéissance aux mécréants et hypocrites est interdite. « Wa dawwara 'anhum » — délaisse leur nuisance. Ignorer plutôt qu'engager. « Wa tawakkal 'ala Allah » — place ta confiance en Allah. La confiance remplace la lutte. Le miroir m'enseigne la bonne stratégie.`,
  reflection: `Face à l'opposition, la confiance en Allah est meilleure que l'engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tuti'i al-kafirina wa al-munafiqina wa da' adahum » — et n'obéis pas aux mécréants et aux hypocrites, et délaisse leur nuisance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère l'opposition ? Est-ce que j'engage ou est-ce que je délaisse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Délaisser la nuisance est plus fort que l'affronter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ignore les perturbations mineures et continue son cours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah n'a pas besoin d'affronter." }
  ],
  munajat: `Ya Wakil, je me confie à Toi. Délaisse ma nuisance. Ne permets pas que je m'engage là où Tu veux que je délaisse.`
};

MIROIR["33:49"] = {
  reference: "33:49",
  theme: ["mariage", "divorce", "idda"],
  emotion: "Justice, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakim"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous épousez des croyantes et que vous les répudiez avant de les avoir touchées, vous ne leur devez pas de délai. » Le miroir me montre les lois du mariage. « Nikahtum » — quand vous épousez. Le mariage a des règles. « Lam tamassuhunna » — avant de les avoir touchées. La consommation change les règles. « La 'idda lahum » — pas de délai pour elles. Le miroir m'enseigne la précision des lois.`,
  reflection: `Les lois du mariage sont précises. La consommation change les obligations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu idha nakahtumu al-mu'minati thumma tallaqtumuhunna min qabli an tamassuhunna » — ô vous qui croyez ! Quand vous épousez des croyantes et que vous les répudiez avant de les avoir touchées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les lois d'Allah concernant le mariage ? Est-ce que je les respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les lois d'Allah protègent les droits de tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois de la nature sont précises. Pourquoi les lois humaines seraient-elles floues ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les lois d'Allah trouve la justice." }
  ],
  munajat: `Ya 'Adl, j'apprends Tes lois. Fais que je les respecte. Ne permets pas que je les ignore ou les transgresse.`
};

MIROIR["33:50"] = {
  reference: "33:50",
  theme: ["mariage", "prophète", "permissions"],
  emotion: "Compréhension, acceptation",
  difficulty: "avancé",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Ô Prophète ! Nous t'avons rendues licites tes épouses. » Le miroir me montre les permissions spéciales du Prophète. « Ahlalna laka » — Nous t'avons rendues licites. Les permissions du Prophète sont spécifiques à sa mission. Ce verset détaille les catégories de femmes permises au Prophète. Le miroir m'enseigne que les lois peuvent avoir des exceptions pour les prophètes.`,
  reflection: `Les permissions du Prophète sont spécifiques à sa mission. Pas d'imitation aveugle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nabi inna ahlalna laka azwajaka » — ô Prophète ! Nous t'avons rendues licites tes épouses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que les permissions du Prophète sont spécifiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les permissions spéciales n'enlèvent rien aux lois générales." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois universelles peuvent avoir des exceptions spécifiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les exceptions comprend les lois." }
  ],
  munajat: `Ya Rabb, je comprends Tes lois. Fais que je les respecte. Ne permets pas que je transgresse sous prétexte d'exception.`
};

MIROIR["33:51"] = {
  reference: "33:51",
  theme: ["justice", "préférence", "coeur"],
  emotion: "Honnêteté, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Muqallib"],
  mirrorVersion: `« Tu fais attendre qui tu veux et tu héberges chez toi qui tu veux. » Le miroir me montre la gestion des relations. « Turji man tasha'u » — tu fais attendre qui tu veux. Le Prophète a la permission de gérer son temps. « Wa tu'wi man tasha'u » — tu héberges qui tu veux. La gestion du foyer lui appartient. Le miroir m'enseigne que le cœur ne peut être forcé.`,
  reflection: `La justice dans les relations ne signifie pas l'égalité parfaite. Le cœur ne peut être forcé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Turji man tasha'u minhunna wa tu'wi man tasha'u » — tu fais attendre qui tu veux et tu héberges chez toi qui tu veux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère mes relations ? Est-ce que j'essaie de forcer mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur est libre. La justice ne peut forcer l'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers gère ses relations naturellement, sans forcer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la liberté du cœur trouve la paix." }
  ],
  munajat: `Ya Muqallib, Tu connais mon cœur. Accepte sa liberté. Ne permets pas que je force ce qui doit être naturel.`
};

MIROIR["33:52"] = {
  reference: "33:52",
  theme: ["limites", "mariage", "prophète"],
  emotion: "Acceptation, soumission",
  difficulty: "avancé",
  relatedNames: ["Al-Hadd", "Al-Hakim"],
  mirrorVersion: `« Il ne t'est plus permis de changer d'épouses ni de prendre d'autres femmes. » Le miroir me montre les limites fixées. « La yahillu laka » — il ne t'est plus permis. Les permissions ont des limites. Même le Prophète a des interdits. Le miroir m'enseigne que les permissions ne sont pas infinies.`,
  reflection: `Les permissions ont des limites. Même le Prophète a des interdits. La loi s'applique à tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yahillu laka al-nisa'u min ba'du » — il ne t'est plus permis de changer d'épouses ni de prendre d'autres femmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les limites d'Allah ? Ou est-ce que je veux toujours plus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les limites sont des protections, pas des prisons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne dans des limites précises. Sans limites, le chaos." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les limites découvre la liberté." }
  ],
  munajat: `Ya Rabb, j'accepte Tes limites. Protège-moi de l'avidité. Fais que je trouve la liberté dans Tes limites.`
};

MIROIR["33:53"] = {
  reference: "33:53",
  theme: ["étiquette", "respect", "modestie"],
  emotion: "Respect, pudeur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adab", "Al-Haya"],
  mirrorVersion: `« Ô vous qui croyez ! N'entrez pas dans les maisons du Prophète sans permission. » Le miroir me montre l'étiquette envers le Prophète. « La tadkhulu » — n'entrez pas. Le respect demande des limites. « Bayuta al-nabi » — les maisons du Prophète. Ses maisons méritent le respect. Le miroir m'enseigne le respect des espaces privés.`,
  reflection: `Le respect demande des limites. Les espaces privés doivent être respectés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la tadkhulu bayuta al-nabi » — ô vous qui croyez ! N'entrez pas dans les maisons du Prophète sans permission." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les espaces privés des autres ? Est-ce que je demande la permission ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect commence par les limites." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte les territoires. Chaque créature a son espace." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites est respecté." }
  ],
  munajat: `Ya Rabb, apprends-moi le respect. Fais que je demande la permission. Ne permets pas que j'envahisse les espaces des autres.`
};

MIROIR["33:54"] = {
  reference: "33:54",
  theme: ["omniscience", "discrétion", "conscience"],
  emotion: "Vigilance, crainte révérencielle",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Si vous montrez quelque chose ou si vous la cachez, Allah connaît tout. » Le miroir me montre l'omniscience divine. « In tubdu » — si vous montrez. « Aw tukhfuh » — ou si vous cachez. Le caché et le visible sont pareils pour Allah. « Kana Allahu bi-kulli shay'in 'alima » — Allah connaît tout. Le miroir m'invite à la conscience permanente.`,
  reflection: `Rien n'est caché à Allah. Le caché et le visible sont pareils pour Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tubdu shay'an aw tukhfuh fa-inna Allaha kana bi-kulli shay'in 'alima » — si vous montrez quelque chose ou si vous la cachez, Allah connaît tout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Est-ce que je réalise qu'Allah le sait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le caché pour les hommes est visible pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est transparent devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme si Allah voyait tout n'a rien à cacher." }
  ],
  munajat: `Ya 'Alim, Tu connais tout de moi. Fais que je vive en Ta présence. Ne permets pas que je cache ce qui devrait être visible.`
};

MIROIR["33:55"] = {
  reference: "33:55",
  theme: ["mahram", "pudeur", "exceptions"],
  emotion: "Compréhension, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Nul grief sur elles concernant leurs pères, leurs fils, leurs frères... » Le miroir me montre les exceptions aux règles de pudeur. « La junaha 'alayhinna » — nul grief sur elles. Certaines relations sont naturellement exemptes des restrictions. « Aba'uhinna » — leurs pères. Les mahram sont listés. Le miroir m'enseigne que les règles ont des exceptions logiques.`,
  reflection: `Les règles de pudeur ont des exceptions naturelles. Les mahram sont des relations sûres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La junaha 'alayhinna fi aba'ihinna wa abna'ihinna wa ikhwanihinna » — nul grief sur elles concernant leurs pères, leurs fils, leurs frères..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les exceptions aux règles ? Est-ce que je les respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les exceptions confirment les règles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois naturelles ont des exceptions qui confirment leur logique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les exceptions comprend les lois." }
  ],
  munajat: `Ya Rabb, je comprends Tes exceptions. Fais que je les respecte. Ne permets pas que je les abuse.`
};

MIROIR["33:57"] = {
  reference: "33:57",
  theme: ["respect", "prophète", "conséquence"],
  emotion: "Vigilance, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'azzim", "Al-Muhaymin"],
  mirrorVersion: `« Ceux qui offensent Allah et Son messager, Allah les maudit dans ce monde et dans l'au-delà. » Le miroir me montre la gravité de l'offense. « Yu'dhuna Allaha » — ceux qui offensent Allah. L'offense à Allah et Son messager est grave. « La'annahu Allah » — Allah les maudit. La malédiction est la conséquence. Le miroir m'avertit : respect absolu.`,
  reflection: `L'offense à Allah et Son messager est grave. La malédiction est la conséquence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina yu'dhuna Allaha wa rasulahu la'anahumu Allahu » — ceux qui offensent Allah et Son messager, Allah les maudit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je parle d'Allah et de Son messager ? Est-ce que je les respecte absolument ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect d'Allah et Son messager est la base de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte son Créateur par son existence même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte Allah et Son messager respecte sa propre foi." }
  ],
  munajat: `Ya Rabb, je respecte Toi et Ton messager. Ne permets pas que je T'offense. Garde ma langue et mon cœur dans le respect.`
};

MIROIR["33:58"] = {
  reference: "33:58",
  theme: ["calomnie", "innocence", "injustice"],
  emotion: "Justice, protection",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hafiz"],
  mirrorVersion: `« Ceux qui offensent les croyants et les croyantes sans raison, ils se chargent d'une calomnie et d'un péché évident. » Le miroir me montre l'injustice envers les innocents. « Yu'dhuna al-mu'minina » — ceux qui offensent les croyants. L'offense aux innocents est grave. « Buhtanan » — calomnie. Accuser sans preuve est un péché. Le miroir m'avertit : justice absolue.`,
  reflection: `Offenser les innocents est une calomnie. La calomnie est un péché évident.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina yu'dhuna al-mu'minina wa al-mu'minati bighayri maktasibu » — ceux qui offensent les croyants et les croyantes sans raison." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accuse sans preuve ? Est-ce que je blesse les innocents ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La calomnie blesse l'innocent et le calomniateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne calomnie pas. Chaque élément joue son rôle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège l'innocent protège sa propre innocence." }
  ],
  munajat: `Ya 'Adl, je ne calomnie pas. Protège-moi de l'injustice. Ne permets pas que j'accuse sans preuve.`
};

MIROIR["33:59"] = {
  reference: "33:59",
  theme: ["voile", "protection", "identité"],
  emotion: "Pudeur, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Hijab", "Al-Hafiz"],
  mirrorVersion: `« Ô Prophète ! Dis à tes épouses, à tes filles et aux femmes des croyants de ramener sur elles leurs voiles. » Le miroir me montre le voile comme protection. « Yudnina 'alayhinna min jalabibihinna » — de ramener sur elles leurs voiles. Le voile protège. « Adna an yu'rafna » — pour être reconnues. La reconnaissance précède le respect. Le miroir m'enseigne que le voile est une protection.`,
  reflection: `Le voile protège et identifie. La reconnaissance précède le respect.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yudnina 'alayhinna min jalabibihinna » — de ramener sur elles leurs voiles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je comprends le voile ? Est-ce que je le vois comme une protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile n'est pas une prison — c'est une protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature voile ce qui doit être protégé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la protection du voile le respecte." }
  ],
  munajat: `Ya Hafiz, Tu veux me protéger. J'accepte Ton voile. Ne permets pas que je le voie comme une contrainte.`
};

MIROIR["33:60"] = {
  reference: "33:60",
  theme: ["hypocrisie", "menace", "exclusion"],
  emotion: "Sérieux, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muntazir"],
  mirrorVersion: `« Si les hypocrites et ceux qui ont la maladie dans le cœur ne cessent pas, Nous te ferons sûrement autorité sur eux. » Le miroir me montre la menace aux hypocrites. « Lam yantahi » — s'ils ne cessent pas. Le pardon a des limites. « La-nusayyiranannaka 'alayhim » — Nous te ferons sûrement autorité sur eux. L'autorité vient d'Allah. Le miroir m'avertit : l'hypocrisie a une limite.`,
  reflection: `L'hypocrisie a une limite. Le pardon n'est pas infini pour les persistants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-in lam yantahi al-munafiquna wa alladhina fi qulubihim marad » — si les hypocrites et ceux qui ont la maladie dans le cœur ne cessent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persiste dans mes fautes ? Est-ce que je prends les avertissements au sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La persistance dans le mal attire l'autorité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne tolère pas le dysfonctionnement persistant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'arrête avant la limite trouve encore miséricorde." }
  ],
  munajat: `Ya Rabb, je ne veux pas persister dans le mal. Arrête-moi avant la limite. Ne permets pas que l'hypocrisie s'installe en moi.`
};

MIROIR["33:61"] = {
  reference: "33:61",
  theme: ["malédiction", "exclusion", "conséquence"],
  emotion: "Gravité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-La'nah", "Al-Muhaymin"],
  mirrorVersion: `« Maudits, ils seront où qu'ils se trouvent, pris et massacrés impitoyablement. » Le miroir me montre la conséquence finale. « Mal'inin » — maudits. La malédiction suit la persistance. « Haythu thuqifu » — où qu'ils se trouvent. Nulle part n'est sûr. « Quttilu taqtilan » — massacrés impitoyablement. La fin est terrible. Le miroir m'avertit : ne pas persister.`,
  reflection: `La persistance dans le mal mène à la malédiction. Nulle part n'est sûr pour les maudits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mal'inin ayna thuqifu ukhidhu wa quttilu taqtilan » — maudits, ils seront où qu'ils se trouvent, pris et massacrés impitoyablement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la gravité de la persistance ? Est-ce que je m'arrête à temps ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'arrêt avant la limite peut sauver." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers élimine ce qui persiste dans le dysfonctionnement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la conséquence s'arrête avant." }
  ],
  munajat: `Ya Rabb, je ne veux pas être maudit. Arrête-moi avant la limite. Ne permets pas que je persiste jusqu'à la fin terrible.`
};

MIROIR["33:62"] = {
  reference: "33:62",
  theme: ["sunna", "constance", "précédents"],
  emotion: "Acceptation, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Sunan", "Al-Hakim"],
  mirrorVersion: `« Telle est la sunna d'Allah pour ceux qui ont vécu auparavant. » Le miroir me montre la constance des lois. « Sunnata Allah » — la sunna d'Allah. Les lois sont constantes. « Fi alladhina khalaw » — pour ceux qui ont vécu auparavant. L'histoire répète les leçons. Le miroir m'enseigne que les lois d'Allah ne changent pas.`,
  reflection: `Les lois d'Allah sont constantes. L'histoire répète les leçons pour ceux qui écoutent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sunnata Allahi fi alladhina khalaw min qabl » — telle est la sunna d'Allah pour ceux qui ont vécu auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un maître qui ne se répète pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit des lois constantes. L'histoire est leur témoignage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les lois ne s'étonne pas des conséquences." }
  ],
  munajat: `Ya Rabb, j'apprends de Ton histoire. Ne permets pas que je répète les erreurs. Fais que je comprenne Tes lois constantes.`
};

MIROIR["33:63"] = {
  reference: "33:63",
  theme: ["heure", "ignorance", "question"],
  emotion: "Humilité, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Sa'ah", "Al-Ghayb"],
  mirrorVersion: `« Les gens t'interrogent sur l'Heure. Dis : 'Sa connaissance est auprès d'Allah.' » Le miroir me montre l'ignorance humaine. « Yas'aluka al-nasu » — les gens t'interrogent. La curiosité sur la fin. « Innama 'ilmuha 'inda Allah » — sa connaissance est auprès d'Allah. L'Heure appartient à Allah seul. Le miroir m'enseigne l'humilité face à l'inconnu.`,
  reflection: `L'Heure appartient à Allah seul. L'homme ne peut pas connaître ce qui lui est caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'aluka al-nasu 'ani al-sa'ati qul innama 'ilmuha 'inda Allah » — les gens t'interrogent sur l'Heure. Dis : sa connaissance est auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cherche à connaître ? Est-ce que j'accepte les limites de ma connaissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de l'Heure est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a son heure mais ne la connaît pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'ignorance de l'Heure prépare chaque jour comme le dernier." }
  ],
  munajat: `Ya 'Alim, j'accepte mon ignorance. Fais que je prépare chaque jour comme le dernier. Ne permets pas que je cherche ce qui m'est caché.`
};

MIROIR["33:64"] = {
  reference: "33:64",
  theme: ["mécréance", "géhenne", "préparation"],
  emotion: "Gravité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahannam", "Al-Mu'id"],
  mirrorVersion: `« Allah a maudit les mécréants et leur a préparé une fournaise. » Le miroir me montre la conséquence de la mécréance. « La'anahumu Allah » — Allah les a maudits. La malédiction suit la mécréance. « A'adda lahum » — leur a préparé. La préparation est faite. « Sa'iran » — une fournaise. Le feu attend. Le miroir m'avertit : la mécréance a une conséquence.`,
  reflection: `La mécréance mène à la malédiction et au feu. La préparation est déjà faite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha la'ana al-kafirina wa a'adda lahum sa'iran » — Allah a maudit les mécréants et leur a préparé une fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la conséquence de la mécréance ? Est-ce que j'évite ce chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est le chemin inverse de la malédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu existe dans l'univers comme avertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la conséquence choisit la foi." }
  ],
  munajat: `Ya Rabb, je choisis la foi. Épargne-moi la malédiction. Ne permets pas que je prenne le chemin du feu.`
};

MIROIR["33:65"] = {
  reference: "33:65",
  theme: ["géhenne", "éternité", "désespoir"],
  emotion: "Gravité, peur salutaire",
  difficulty: "débutant",
  relatedNames: ["Al-Abad", "Al-Muntazir"],
  mirrorVersion: `« Pour y demeurer éternellement, sans trouver ni protecteur ni secoureur. » Le miroir me montre l'éternité du châtiment. « Khalidina fiha » — pour y demeurer éternellement. L'éternité est terrifiante. « La yajiduna » — sans trouver. Il n'y a pas d'aide au-delà. Le miroir m'avertit : la conséquence est finale.`,
  reflection: `L'éternité dans le feu est sans espoir d'aide. La conséquence est finale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalidina fiha abadan la yajiduna waliyan wa la nasira » — pour y demeurer éternellement, sans trouver ni protecteur ni secoureur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise l'éternité ? Est-ce que je prépare mon aujourd'hui pour mon éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité dans le bien est le contraire de l'éternité dans le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'éternité existe — le choix est son contenu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'éternité dans le mal la cherche dans le bien." }
  ],
  munajat: `Ya Rabb, je ne veux pas l'éternité dans le mal. Donne-moi l'éternité dans le bien. Ne permets pas que je me perde pour toujours.`
};

MIROIR["33:66"] = {
  reference: "33:66",
  theme: ["regret", "obéissance", "remord"],
  emotion: "Regret, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Hadith", "Al-Muta'allim"],
  mirrorVersion: `« Le jour où leurs visages seront renversés dans le feu, ils diront : 'Si seulement nous avions obéi à Allah et au messager !' » Le miroir me montre le regret final. « Tuqallabu wujuhuhum » — leurs visages seront renversés. L'humiliation totale. « Law atana Allah » — si seulement nous avions obéi. Le regret vient trop tard. Le miroir m'avertit : obéir maintenant.`,
  reflection: `Le regret vient trop tard. L'obéissance maintenant évite le regret après.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tuqallabu wujuhuhum fi al-nari yaquluna law atana Allah » — le jour où leurs visages seront renversés dans le feu, ils diront : si seulement nous avions obéi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis maintenant ? Ou est-ce que je prépare mon regret futur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance aujourd'hui évite le regret demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit maintenant et n'a pas de regret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit maintenant n'aura pas de regret après." }
  ],
  munajat: `Ya Rabb, j'obéis maintenant. Évite-moi le regret. Ne permets pas que je dise « si seulement » dans le feu.`
};

MIROIR["33:67"] = {
  reference: "33:67",
  theme: ["suivi", "responsabilité", "excuse"],
  emotion: "Responsabilité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hisab", "Al-Mas'ul"],
  mirrorVersion: `« Ils diront : 'Seigneur, nous avons obéi à nos chefs et à nos grands, et ils nous ont égarés du chemin.' » Le miroir me montre l'excuse du suivi aveugle. « Ata'na sadatana » — nous avons obéi à nos chefs. Le suivi aveugle ne justifie pas. « Fa-adalluna al-sabil » — ils nous ont égarés. La faute est partagée. Le miroir m'avertit : ne pas suivre aveuglément.`,
  reflection: `Le suivi aveugle ne justifie pas. Chacun est responsable de son choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya rabbana ata'na sadatana wa kubarana fa-adalluna al-sabil » — Seigneur, nous avons obéi à nos chefs et à nos grands, et ils nous ont égarés du chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que j'obéis aveuglément ? Est-ce que je vérifie mon chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance à Allah précède l'obéissance aux créatures." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur, pas aux créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vérifie son chemin ne s'égare pas." }
  ],
  munajat: `Ya Rabb, je vérifie mon chemin. Ne permets pas que je suive aveuglément. Fais que mon obéissance à Toi précède tout.`
};

MIROIR["33:68"] = {
  reference: "33:68",
  theme: ["malédiction", "châtiment", "imprécation"],
  emotion: "Gravité, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-La'nah", "Al-'Adl"],
  mirrorVersion: `« Seigneur, donne-leur un double châtiment et maudis-les d'une grande malédiction. » Le miroir me montre l'imprécation finale. « Di'fan mina al-'adhab » — un double châtiment. Pour l'égarement et l'égarement des autres. « Wa il'anhum la'nan kabiran » — maudis-les d'une grande malédiction. La malédiction est grande comme l'égarement. Le miroir m'avertit : égarer les autres double le châtiment.`,
  reflection: `Égarer les autres double le châtiment. La responsabilité est partagée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana atihim di'fan mina al-'adhab wa il'anhum la'nan kabiran » — Seigneur, donne-leur un double châtiment et maudis-les d'une grande malédiction." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'égare les autres ? Est-ce que je réalise la responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Guider les autres efface les fautes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers guide naturellement. L'homme seul peut égarer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide les autres se guide lui-même." }
  ],
  munajat: `Ya Rabb, je ne veux pas égarer. Fais que je guide. Ne permets pas que je porte la responsabilité de l'égarement des autres.`
};

MIROIR["33:69"] = {
  reference: "33:69",
  theme: ["respect", "prophète", "modestie"],
  emotion: "Respect, pudeur",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'azzim", "Al-Haya"],
  mirrorVersion: `« Ô vous qui croyez ! Ne soyez pas comme ceux qui ont offensé Moïse. » Le miroir me montre le respect dû aux prophètes. « La takunu » — ne soyez pas. L'avertissement est clair. « Alladhina adaw Musa » — ceux qui ont offensé Moïse. L'offense aux prophètes est grave. « Fa-barra'ahu Allah » — Allah l'a innocenté. La protection d'Allah est certaine. Le miroir m'enseigne le respect.`,
  reflection: `L'offense aux prophètes est grave. Allah protège Ses messagers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la takunu ka-alladhina adaw Musa » — ô vous qui croyez ! Ne soyez pas comme ceux qui ont offensé Moïse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je parle des prophètes ? Est-ce que je les respecte absolument ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des prophètes est le respect d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte les messagers de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les prophètes respecte le message." }
  ],
  munajat: `Ya Rabb, je respecte Tes prophètes. Ne permets pas que je les offense. Fais que je les honore comme Tu les honores.`
};

MIROIR["33:71"] = {
  reference: "33:71",
  theme: ["réforme", "guidance", "pardon"],
  emotion: "Espérance, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Ghaffar"],
  mirrorVersion: `« Il vous réforme vos œuvres et vous pardonne vos péchés. » Le miroir me montre la réforme divine. « Yuslih lakum a'malakum » — Il vous réforme vos œuvres. La réforme vient d'Allah. « Wa yaghfir lakum dhunubakum » — et vous pardonne vos péchés. Le pardon accompagne la réforme. Le miroir m'invite à l'obéissance pour la réforme.`,
  reflection: `La réforme et le pardon viennent d'Allah. L'obéissance ouvre la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuslih lakum a'malakum wa yaghfir lakum dhunubakum » — Il vous réforme vos œuvres et vous pardonne vos péchés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la réforme d'Allah ? Est-ce que j'ouvre la porte par l'obéissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réforme d'Allah précède mon effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en constante réforme par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la réforme d'Allah découvre la perfection." }
  ],
  munajat: `Ya Muslih, réforme mes œuvres. Pardonne mes péchés. Ne permets pas que je résiste à Ta réforme.`
};

MIROIR["33:72"] = {
  reference: "33:72",
  theme: ["amanah", "responsabilité", "confiance"],
  emotion: "Responsabilité, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amanah", "Al-Mas'ul"],
  mirrorVersion: `« Nous avons proposé l'amanah aux cieux, à la terre et aux montagnes. Ils ont refusé de la porter et en ont eu peur. » Le miroir me montre la responsabilité refusée par la création. « Al-amanah » — la confiance, la responsabilité. Les cieux et la terre ont refusé. « Fa-abayna » — ils ont refusé. La sagesse de refuser. « Wa ashfaqna minha » — et en ont eu peur. La peur salutaire. « Wa hamalaha al-insan » — et l'homme l'a portée. L'homme a accepté la responsabilité. Le miroir m'interroge : suis-je à la hauteur ?`,
  reflection: `L'homme a accepté une responsabilité que la création a refusée. Suis-je à la hauteur ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna 'aradna al-amanata 'ala al-samawati wa al-ardi wa al-jibali » — Nous avons proposé l'amanah aux cieux, à la terre et aux montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je à la hauteur de cette responsabilité ? Est-ce que je la prends au sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité refusée par la création est portée par l'homme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers refuse ce qu'il ne peut pas porter. L'homme seul accepte au-delà de ses capacités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte la responsabilité avec sérieux découvre sa noblesse." }
  ],
  munajat: `Ya Rabb, j'ai accepté la responsabilité. Aide-moi à la porter. Ne permets pas que je la trahis.`
};

MIROIR["33:73"] = {
  reference: "33:73",
  theme: ["conséquence", "discernement", "châtiment"],
  emotion: "Gravité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Adl"],
  mirrorVersion: `« Afin qu'Allah châtie les hommes et femmes hypocrites, les hommes et femmes associateurs. » Le miroir me montre la conséquence finale. « Li-yu'adhdhiba Allahu » — afin qu'Allah châtie. Le châtiment a un but. « Al-munafiqina wa al-munafiqat » — les hommes et femmes hypocrites. L'hypocrisie est châtiée. « Al-mushrikina wa al-mushrikat » — les hommes et femmes associateurs. L'association est châtiée. Le miroir m'avertit : le discernement final arrive.`,
  reflection: `Le châtiment final distingue les hypocrites et associateurs. Le discernement vient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yu'adhdhiba Allahu al-munafiqina wa al-munafiqat wa al-mushrikina wa al-mushrikat » — afin qu'Allah châtie les hommes et femmes hypocrites, les hommes et femmes associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je hypocrite ? Suis-je associateur ? Le miroir sonde mon cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité et le tawhid évitent le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas l'hypocrisie. L'homme seul peut être double." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se connaît évite la chute." }
  ],
  munajat: `Ya Rabb, purifie-moi de l'hypocrisie et de l'association. Je veux être sincère et pur. Ne permets pas que je sois du nombre des châtiés.`
};

MIROIR["70:26"] = {
  reference: "70:26",
  theme: ["jugement", "foi", "certitude"],
  emotion: "Espoir, conviction",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Dayyan"],
  mirrorVersion: `« Et qui croient fermement au Jour du Jugement. » Le miroir me montre la foi au jugement. « Wa alladhina yusaddiquna bi-l-yawmi al-akhiri » — et qui croient fermement au Jour du Jugement. La certitude du jugement guide l'action. Le miroir m'interroge : est-ce que je crois vraiment au Jour du Jugement ?`,
  reflection: `La foi au Jour du Jugement est le moteur de la responsabilité. Chaque acte sera pesé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina yusaddiquna bi-l-yawmi al-akhiri » — et qui croient fermement au Jour du Jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment au Jour du Jugement ? Ma vie le reflète-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude du jugement précède la certitude de soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout acte a une conséquence. Le jugement est la loi cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au jugement vit comme s'il le voyait." }
  ],
  munajat: `Ya Dayyan, je crois au Jour du Jugement. Fais que cette certitude guide mes actions. Ne permets pas que je l'oublie.`
};

MIROIR["70:27"] = {
  reference: "70:27",
  theme: ["crainte", "châtiment", "vigilance"],
  emotion: "Humilité, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-Khafi", "Al-Muntaqim"],
  mirrorVersion: `« Et qui craignent le châtiment de leur Seigneur. » Le miroir me montre la crainte salutaire. « Wa alladhina hum min 'adhabi rabbihim mushfiqun » — et qui craignent le châtiment de leur Seigneur. La crainte préserve de l'erreur. Le miroir m'interroge : est-ce que je crains le châtiment d'Allah ?`,
  reflection: `La crainte du châtiment est une protection. Elle garde du péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum min 'adhabi rabbihim mushfiqun » — et qui craignent le châtiment de leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment d'Allah ? Ma crainte me préserve-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah précède la crainte des créatures." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte est un instinct de survie spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah n'a peur de rien d'autre." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Fais que cette crainte me préserve. Ne permets pas que je sois audacieux dans le péché.`
};

MIROIR["70:28"] = {
  reference: "70:28",
  theme: ["châtiment", "certitude", "personne"],
  emotion: "Vigilance, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Car vraiment, nul n'est à l'abri du châtiment de son Seigneur. » Le miroir me montre l'universalité du risque. « Inna 'adhaba rabbihim ghayru ma'munin » — car vraiment, le châtiment de leur Seigneur n'est pas à considérer avec insouciance. Personne n'est à l'abri. Le miroir m'interroge : est-ce que je me considère à l'abri ?`,
  reflection: `Nul n'est à l'abri du châtiment. La vigilance est de mise pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna 'adhaba rabbihim ghayru ma'munin » — car vraiment, nul n'est à l'abri du châtiment de son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me considère à l'abri ? Ou est-ce que je reste vigilant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance constante est la seule sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sécurité absolue n'existe que par la miséricorde divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait vulnérable se protège." }
  ],
  munajat: `Ya Rabb, je ne suis pas à l'abri. Fais que je reste vigilant. Ne permets pas que je sois insouciant.`
};

MIROIR["70:29"] = {
  reference: "70:29",
  theme: ["chasteté", "pudeur", "protection"],
  emotion: "Pureté, maîtrise",
  difficulty: "débutant",
  relatedNames: ["Al-Quddus", "Al-Hafiz"],
  mirrorVersion: `« Et qui préservent leur chasteté. » Le miroir me montre la protection de soi. « Wa alladhina hum li-furujihim hafizun » — et qui préservent leur chasteté. La maîtrise des désirs est essentielle. Le miroir m'interroge : est-ce que je préserve ma chasteté ?`,
  reflection: `La chasteté est une protection pour l'âme. Elle préserve la dignité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum li-furujihim hafizun » — et qui préservent leur chasteté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve ma chasteté ? Ma maîtrise est-elle ferme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La maîtrise du désir précède la liberté spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chasteté est une loi de l'équilibre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise son désir maîtrise sa vie." }
  ],
  munajat: `Ya Quddus, je préserve ma chasteté. Fais que je maîtrise mes désirs. Ne permets pas que je sois esclave de mes passions.`
};

MIROIR["70:30"] = {
  reference: "70:30",
  theme: ["épouses", "exception", "légalité"],
  emotion: "Pureté, légalité",
  difficulty: "débutant",
  relatedNames: ["Al-Halim", "Al-Hakim"],
  mirrorVersion: `« Sauf avec leurs épouses ou les esclaves qu'ils possèdent. » Le miroir me montre l'exception légale. « Illa 'ala azwajihim aw ma malakat aymanuhum » — sauf avec leurs épouses ou les esclaves qu'ils possèdent. Allah a prévu des voies licites. Le miroir m'interroge : est-ce que je respecte les limites ?`,
  reflection: `Allah a prévu des voies licites pour les désirs. Les respecter est la voie de la pureté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa 'ala azwajihim aw ma malakat aymanuhum » — sauf avec leurs épouses ou les esclaves qu'ils possèdent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les limites ? Mes relations sont-elles licites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le licite préserve de l'illicite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les limites d'Allah sont des protections." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites trouve la satisfaction." }
  ],
  munajat: `Ya Hakim, je respecte les limites. Fais que je reste dans le licite. Ne permets pas que je transgresse.`
};

MIROIR["70:31"] = {
  reference: "70:31",
  theme: ["limites", "transgression", "blâme"],
  emotion: "Vigilance, respect",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakim"],
  mirrorVersion: `« Ceux qui cherchent au-delà sont des transgresseurs. » Le miroir me montre la conséquence. « Fa-mani ibtagha wara'a dhalika fa-ula'ika hum al-'adun » — ceux qui cherchent au-delà sont des transgresseurs. Dépasser les limites est un péché. Le miroir m'interroge : est-ce que je dépasse les limites ?`,
  reflection: `Dépasser les limites d'Allah est une transgression. Le respect est la voie de la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-mani ibtagha wara'a dhalika fa-ula'ika hum al-'adun » — ceux qui cherchent au-delà sont des transgresseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépasse les limites ? Suis-je un transgresseur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des limites est la noblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose a des limites. Les dépasser crée le désordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites est honoré." }
  ],
  munajat: `Ya 'Adl, je ne veux pas être un transgresseur. Fais que je respecte les limites. Ne permets pas que je dépasse ce que Tu as permis.`
};

MIROIR["70:32"] = {
  reference: "70:32",
  theme: ["dépôt", "confiance", "loyauté"],
  emotion: "Intégrité, fidélité",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Hafiz"],
  mirrorVersion: `« Et qui gardent les dépôts confiés et respectent leurs engagements. » Le miroir me montre la loyauté. « Wa alladhina hum li-amanatihim wa 'ahdihim ra'un » — et qui gardent les dépôts et respectent les engagements. La confiance est sacrée. Le miroir m'interroge : est-ce que je respecte les dépôts ?`,
  reflection: `Le dépôt est une confiance. Le respecter est un devoir sacré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum li-amanatihim wa 'ahdihim ra'un » — et qui gardent les dépôts confiés et respectent leurs engagements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les dépôts ? Ma parole est-elle fiable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loyauté est le fondement de la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La confiance est le lien des sociétés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est digne de confiance reçoit la confiance divine." }
  ],
  munajat: `Ya Amin, je respecte les dépôts. Fais que je sois digne de confiance. Ne permets pas que je trahisse les engagements.`
};

MIROIR["70:33"] = {
  reference: "70:33",
  theme: ["témoignage", "vérité", "justice"],
  emotion: "Intégrité, vérité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Haqq"],
  mirrorVersion: `« Et qui se tiennent à leur témoignage. » Le miroir me montre la fidélité au témoignage. « Wa alladhina hum bi-shahadatihim qa'imun » — et qui se tiennent à leur témoignage. La vérité est un devoir. Le miroir m'interroge : est-ce que je tiens mon témoignage ?`,
  reflection: `Le témoignage doit être vrai et constant. Le changer est une trahison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum bi-shahadatihim qa'imun » — et qui se tiennent à leur témoignage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens mon témoignage ? Ma parole est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance dans la vérité est la force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une et immuable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité est libre." }
  ],
  munajat: `Ya Shahid, je tiens mon témoignage. Fais que je dise la vérité. Ne permets pas que je mente ou cache.`
};

MIROIR["70:34"] = {
  reference: "70:34",
  theme: ["prière", "garde", "réussite"],
  emotion: "Ferveur, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Musallin", "Al-Hafiz"],
  mirrorVersion: `« Et qui gardent strictement leur prière. » Le miroir me montre la prière gardée. « Wa alladhina hum 'ala salatihim yuhafizun » — et qui gardent strictement leur prière. La prière est le pilier. Le miroir m'interroge : est-ce que je garde ma prière ?`,
  reflection: `Garder la prière signifie la préserver de l'abandon et de la négligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum 'ala salatihim yuhafizun » — et qui gardent strictement leur prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je garde ma prière ? La préserve-je de la négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière gardée garde celui qui la prie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière est le lien constant avec le Divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde sa prière est gardé par elle." }
  ],
  munajat: `Ya Rabb, je garde ma prière. Fais que je la préserve. Ne permets pas que je la néglige.`
};

MIROIR["70:35"] = {
  reference: "70:35",
  theme: ["jardins", "honneur", "récompense"],
  emotion: "Espoir, joie",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Karim"],
  mirrorVersion: `« Ceux-là seront dans des Jardins honorés. » Le miroir me montre la récompense. « Ula'ika fi jannatin mukramun » — ceux-là seront dans des Jardins honorés. L'honneur suit la piété. Le miroir m'interroge : est-ce que je suis de ceux-là ?`,
  reflection: `Les Jardins sont la récompense des pieux. L'honneur y est éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika fi jannatin mukramun » — ceux-là seront dans des Jardins honorés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis de ceux-là ? Ma vie mène-t-elle aux Jardins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur dans les Jardins suit l'humilité sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense correspond à l'effort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est honoré dans les Jardins l'était déjà sur terre par sa piété." }
  ],
  munajat: `Ya Rahman, je veux être dans les Jardins. Fais que je sois de ceux-là. Donne-moi l'honneur éternel.`
};

MIROIR["70:36"] = {
  reference: "70:36",
  theme: ["mécréants", "question", "moquerie"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Qu'ont donc ceux qui ont mécru à courir vers toi, le cou tendu ? » Le miroir me montre l'attitude des mécréants. « Ma li-alladhina kafaru qibalaqa muhti'in » — qu'ont donc ceux qui ont mécru à courir vers toi, le cou tendu ? Ils viennent avec arrogance. Le miroir m'interroge : comment je me comporte avec la vérité ?`,
  reflection: `Les mécréants courent vers le Prophète avec moquerie. L'orgueil les aveugle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma li-alladhina kafaru qibalaqa muhti'in » — qu'ont donc ceux qui ont mécru à courir vers toi, le cou tendu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me comporte avec la vérité ? Avec arrogance ou avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil précède la chute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité attire mais l'orgueil repousse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'approche avec humilité trouve la vérité." }
  ],
  munajat: `Ya Basir, je ne veux pas être arrogant. Fais que je m'approche avec humilité. Ne permets pas que l'orgueil m'aveugle.`
};

MIROIR["70:37"] = {
  reference: "70:37",
  theme: ["groupes", "mécréants", "division"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Jami'"],
  mirrorVersion: `« En groupes, à droite et à gauche. » Le miroir me montre la division. « Atyaran min yaminika wa min shimālika 'idin » — en groupes, à droite et à gauche. Ils viennent de toutes parts. Le miroir m'interroge : est-ce que je suis dans le bon groupe ?`,
  reflection: `Les mécréants viennent en groupes dispersés. L'unité n'est pas dans leur nombre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Atyaran min yaminika wa min shimālika 'idin » — en groupes, à droite et à gauche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis dans le bon groupe ? Ma direction est-elle la bonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le nombre ne fait pas la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité peut être dans un groupe petit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la vérité n'a pas besoin du nombre." }
  ],
  munajat: `Ya Jami', je veux être dans le bon groupe. Fais que je suive la vérité. Ne permets pas que je me perde dans la foule.`
};

MIROIR["70:38"] = {
  reference: "70:38",
  theme: ["paradis", "prétention", "illusion"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Chacun d'eux prétend-il entrer au Paradis des délices ? » Le miroir me montre la prétention. « A-yatma'u kullu imri'in minhum an yudkhala jannata na'im » — chacun d'eux prétend-il entrer au Paradis des délices ? La prétention sans œuvre est une illusion. Le miroir m'interroge : sur quoi je base mon espoir ?`,
  reflection: `Prétendre au Paradis sans œuvres est une illusion. L'espoir doit être fondé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-yatma'u kullu imri'in minhum an yudkhala jannata na'im » — chacun d'eux prétend-il entrer au Paradis des délices ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je base mon espoir du Paradis ? Mes œuvres le méritent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis s'achète par les œuvres, pas par les prétentions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense suit l'effort, pas le souhait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvres pour le Paradis l'atteint." }
  ],
  munajat: `Ya Rabb, je veux le Paradis. Fais que je l'œuvre pour l'atteindre. Ne permets pas que je me contente de prétentions.`
};

MIROIR["70:39"] = {
  reference: "70:39",
  theme: ["création", "origine", "humilité"],
  emotion: "Humilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Nous les avons créés de ce qu'ils savent. » Le miroir me montre l'origine humble. « Khalaqnahum mimma ya'lamun » — Nous les avons créés de ce qu'ils savent. L'origine est humble : une goutte de sperme. Le miroir m'interroge : est-ce que je me souviens de mon origine ?`,
  reflection: `L'origine humbledoit inspirer l'humilité. La grandeur vient d'Allah seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqnahum mimma ya'lamun » — Nous les avons créés de ce qu'ils savent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine ? Mon arrogance est-elle justifiée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité de l'origine doit refléter dans la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature vient d'une origine humble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine reste humble." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'une origine humble. Fais que je reste humble. Ne permets pas que l'orgueil m'élève.`
};

MIROIR["70:40"] = {
  reference: "70:40",
  theme: ["serment", "orient", "occident"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mashriq", "Al-Maghrib"],
  mirrorVersion: `« Non ! Je jure par le Seigneur des Orients et des Occidents. » Le miroir me montre le serment divin. « Fa-la uqsimu bi-rabbi al-mashariqi wa al-magharibi » — Non ! Je jure par le Seigneur des Orients et des Occidents. Allah jure par Sa création. Le miroir m'interroge : est-ce que je reconnais la grandeur d'Allah ?`,
  reflection: `Le serment par les orient et occident montre la maîtrise d'Allah sur tout l'univers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la uqsimu bi-rabbi al-mashariqi wa al-magharibi » — Non ! Je jure par le Seigneur des Orients et des Occidents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la grandeur d'Allah ? Le serment m'impressionne-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur d'Allah englobe tout l'univers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orient et l'occident sont entre les mains d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grandeur se soumet." }
  ],
  munajat: `Ya Rabb al-mashariqi wa al-magharibi, Tu es le Maître de l'univers. Fais que je reconnaisse Ta grandeur. Ne permets pas que je sois aveugle.`
};

MIROIR["70:41"] = {
  reference: "70:41",
  theme: ["substitution", "puissance", "remplacement"],
  emotion: "Humilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Badi'"],
  mirrorVersion: `« Que Nous pouvons les remplacer par d'autres meilleurs qu'eux. » Le miroir me montre la possibilité de remplacement. « Inna qadiruna 'ala an nubaddila khayran minhum » — que Nous pouvons les remplacer par d'autres meilleurs qu'eux. Personne n'est irremplaçable. Le miroir m'interroge : est-ce que je me crois irremplaçable ?`,
  reflection: `Allah peut remplacer quiconque. La substitution est toujours possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna qadiruna 'ala an nubaddila khayran minhum » — que Nous pouvons les remplacer par d'autres meilleurs qu'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me crois irremplaçable ? Ou est-ce que je sais que je peux être remplacé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'irremplaçabilité est une illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création continue sans fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait remplaçable fait de son mieux." }
  ],
  munajat: `Ya Qadir, je sais que je peux être remplacé. Fais que je sois utile. Ne permets pas que je sois parmi les inutiles.`
};

MIROIR["70:42"] = {
  reference: "70:42",
  theme: ["négation", "jeu", "distraction"],
  emotion: "Sérieux, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Matin"],
  mirrorVersion: `« Laisse-les donc se noyer dans leur bavardage et s'amuser. » Le miroir me montre l'attitude face aux distracteurs. « Fa-dharhum yakhudu wa yal'abun » — laisse-les donc se noyer dans leur bavardage et s'amuser. Le Prophète n'a pas à s'occuper d'eux. Le miroir m'interroge : est-ce que je me laisse distraire ?`,
  reflection: `Les mécréants se distraient. Le croyant reste sérieux dans sa mission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-dharhum yakhudu wa yal'abun hatta yulaqu yawmahumu alladhi yu'adun » — laisse-les donc se noyer dans leur bavardage et s'amuser, jusqu'à ce qu'ils rencontrent leur jour qu'on leur promet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse distraire ? Ou est-ce que je reste sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sérieux précède la réussite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La distraction est l'ennemie de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste sérieux atteint le but." }
  ],
  munajat: `Ya Haqq, je ne veux pas me distraire. Fais que je reste sérieux. Ne permets pas que je joue avec ma vie.`
};

MIROIR["70:43"] = {
  reference: "70:43",
  theme: ["sortie", "tombeaux", "résurrection"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Qahir"],
  mirrorVersion: `« Le jour où ils sortiront des tombeaux, comme s'ils couraient vers des idoles. » Le miroir me montre la résurrection. « Yawma yakhrujuna min al-ajdathi sir'an » — le jour où ils sortiront des tombeaux, rapidement. La résurrection est soudaine. Le miroir m'interroge : est-ce que je prépare ce jour ?`,
  reflection: `La sortie des tombeaux est rapide. La résurrection est terrifiante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yakhrujuna min al-ajdathi sir'an ka-annahum ila nusubin yusifun » — le jour où ils sortiront des tombeaux, rapidement, comme s'ils couraient vers des idoles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare ce jour ? Mon tombeau sera-t-il une sortie facile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation de la tombe commence ici." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous sortiront des tombeaux. Nul n'échappe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa tombe sort en paix." }
  ],
  munajat: `Ya Ba'ith, je prépare ma sortie de la tombe. Fais qu'elle soit facile. Ne permets pas que je sois surpris.`
};

MIROIR["70:44"] = {
