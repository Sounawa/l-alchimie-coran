    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à être transparent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transparence est libératrice pour l'innocent." },
