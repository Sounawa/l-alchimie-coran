  emotion: "Responsabilité, liberté",
  difficulty: "débutant",
  relatedNames: ["Al-Murid", "Al-Sabil"],
  mirrorVersion: `« Celui qui veut, qu'il prenne un chemin vers son Seigneur. » Le choix du chemin. Le miroir m'invite : le chemin est ouvert pour celui qui veut. La volonté est la clé.`,
  reflection: `Le chemin est ouvert pour celui qui veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadhihi tadhkiratun faman sha'aittakhadha ila rabbihi sabila » — celui qui veut, qu'il prenne un chemin vers son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux prendre le chemin ? Ma volonté est-elle engagée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté ouvre le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin est ouvert pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut vraiment trouve le chemin." }
  ],
  munajat: `Ya Rabb, je veux prendre le chemin. Ouvre-moi la voie.`
};

MIROIR["76:30"] = {
  reference: "76:30",
  theme: ["volonté", "Allah", "guidance"],
  emotion: "Humilité, dépendance",
  difficulty: "débutant",
  relatedNames: ["Al-Murid", "Al-Hadi"],
  mirrorVersion: `« Mais vous ne pouvez vouloir que si Allah le veut. » La volonté dépend d'Allah. Le miroir m'enseigne : même notre volonté dépend de la volonté d'Allah.`,
  reflection: `Même notre volonté dépend de la volonté d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma tasha'una illa an yasha'a Allahu » — mais vous ne pouvez vouloir que si Allah le veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la volonté d'Allah ? Ma dépendance est-elle totale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dépendance d'Allah assure la bonne volonté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute volonté dépend d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépend d'Allah reçoit Sa volonté." }
  ],
  munajat: `Ya Rabb, je dépends de Ta volonté. Donne-moi la bonne volonté.`
};

MIROIR["76:31"] = {
  reference: "76:31",
  theme: ["miséricorde", "châtiment", "sagesse"],
  emotion: "Espoir, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rahman", "Al-Hakim"],
  mirrorVersion: `« Il fait entrer qui Il veut dans Sa miséricorde, et aux injustes Il a préparé un châtiment douloureux. » La miséricorde et le châtiment. Le miroir m'enseigne : Allah décide qui entre dans Sa miséricorde.`,
  reflection: `Allah décide qui entre dans Sa miséricorde. Les injustes ont un châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yudkhilu man yasha'u fi rahmatihi wa al-zalimina a'adda lahum 'adhaban alima » — Il fait entrer qui Il veut dans Sa miséricorde, et aux injustes Il a préparé un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la miséricorde ? Ou est-ce que je risque le châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice attire la miséricorde. L'injustice attire le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde et le châtiment sont les deux faces." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la miséricorde avec justice la trouve." }
  ],
  munajat: `Ya Rahman, fais-moi entrer dans Ta miséricorde. Préserve-moi du châtiment.`
};
// Surahs 11-15 Remaining Miroir Entries

// === SURAH 11 (HUD) - Remaining verses 89, 91-123 ===

MIROIR["11:89"] = {
  reference: "11:89",
  theme: ["avertissement", "histoire", "leçon"],
  emotion: "Sérieux, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhakkir", "Al-Hakim"],
  mirrorVersion: `« Ô mon peuple, que le différend avec moi ne vous entraîne pas vers ce qui frappa les gens de Noé, de Hud ou de Salih. » Le miroir me montre l'avertissement historique. « Walaa yartaddanna am-rukomu ilaa qawmin min-ka » — que votre sort ne devienne pas comme celui de gens parmi vous. La leçon. « Alaa bu'dal li-Samuuda » — que périssent les Thamud ! Le verdict. Le miroir m'avertit que l'histoire se répète pour ceux qui n'apprennent pas.`,
  reflection: `L'histoire est un maître — ceux qui n'apprennent pas répètent les erreurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaa qawmi laa yadrinnakum shiqaqee an yuseebakum mithlu maa asaabu qawma Nuh » — ô mon peuple, que le différend avec moi ne vous entraîne pas vers ce qui frappa les gens de Noé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle leçon de l'histoire je refuse d'apprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire peut être maître ou bourreau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la mémoire de tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire n'a pas besoin de la répéter." }
  ],
  munajat: `Ya Hakim, fais que j'apprenne de l'histoire. Ne permets pas que je répète les erreurs des anciens.`
};

MIROIR["11:91"] = {
  reference: "11:91",
  theme: ["mépris", "rejet", "orgueil"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Haqq"],
  mirrorVersion: `« Ils dirent : 'Ô Shu'ayb, nous ne comprenons pas grand-chose de ce que tu dis.' » Le miroir me montre le mépris déguisé. « Maa nafqahu katheeram mimmaa taqulu » — nous ne comprenons pas grand-chose de ce que tu dis. Le dénigrement intellectuel. « Wa innnaa lanaraaka feenaa da'ee-faa » — nous te voyons faible parmi nous. Le mépris social. « Wa law-laa rahtuka la-rajamnaak » — sans ta famille, nous te lapiderions. La menace. Le miroir m'enseigne que le message peut être rejeté par mépris et menace.`,
  reflection: `Le mépris et les menaces sont les armes de ceux qui n'ont pas d'arguments.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu yaa Shu'aybu maa nafqahu katheeram mimmaa taqulu wa innnaa lanaraaka feenaa da'ee-faa » — ils dirent : ô Shu'ayb, nous ne comprenons pas grand-chose de ce que tu dis, et nous te voyons faible parmi nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je méprise ceux qui m'apportent la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mépris des hommes n'enlève rien à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne méprise pas — il écoute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est méprisé pour la vérité est honoré par Allah." }
  ],
  munajat: `Ya Rabb, ne permets pas que je sois aveuglé par le mépris. Fais que j'écoute la vérité où qu'elle soit.`
};

MIROIR["11:92"] = {
  reference: "11:92",
  theme: ["famille", "protégé", "honneur"],
  emotion: "Indignation, appel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-'Aziz"],
  mirrorVersion: `« Il dit : 'Ô mon peuple, ma famille vous est-elle plus honorable que Allah ?' » Le miroir me montre la question percutante. « Qaala yaa qawmi arahlee a'azamu 'alaikum minal laah » — ma famille vous est-elle plus honorable qu'Allah ? La hiérarchie inversée. « Wat-takhadhtumuuhu waraaa'akum zih-riyya » — vous L'avez mis derrière vous. Le mépris. « Inna Rabbi bimaa ta'maluuna muheet » — mon Seigneur cerne ce que vous faites. La conscience. Le miroir m'interroge : qui est prioritaire dans mon cœur ?`,
  reflection: `Quand la famille devient plus importante qu'Allah, l'idolâtrie commence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala yaa qawmi arahlee a'azamu 'alaikum minal laah » — il dit : ô mon peuple, ma famille vous est-elle plus honorable qu'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est plus important dans mon cœur : Allah ou ma famille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La famille est don d'Allah — pas concurrent à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier honore son Créateur avant tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore Allah voit sa famille honorée par Lui." }
  ],
  munajat: `Ya Waliyy, fais que Tu sois le plus honoré dans mon cœur. Que ma famille ne Te remplace jamais.`
};

MIROIR["11:93"] = {
  reference: "11:93",
  theme: ["châtiment", "défi", "confiance"],
  emotion: "Confiance, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Ô mon peuple, agissez selon votre manière. J'agirai selon la mienne. » Le miroir me montre la confrontation confiante. « F'amaluu 'alaa makaanatikum » — agissez selon votre manière. Le défi. « Innee 'amilun » — j'agirai. La détermination. « Fata'lamunna » — vous saurez. La certitude. « Man ya'teehi 'azaabuy yukhzeehi » — qui viendra un châtiment qui l'humiliera. Le verdict. Le miroir m'enseigne à agir avec confiance face à l'opposition.`,
  reflection: `L'action confiante est la meilleure réponse à l'opposition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaa qawmi'maluu 'alaa makaanatikum innee 'aamilun » — ô mon peuple, agissez selon votre manière. J'agirai selon la mienne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'agis face à l'opposition ? Avec confiance ou peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'action confiante précède la victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers agit selon l'ordre d'Allah avec confiance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit pour Allah n'a pas peur du résultat." }
  ],
  munajat: `Ya Qadir, donne-moi la confiance d'agir pour Toi. Fais que je n'aie pas peur de l'opposition.`
};

MIROIR["11:94"] = {
  reference: "11:94",
  theme: ["salut", "justice", "séparation"],
  emotion: "Soulagement, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Al-Fasl"],
  mirrorVersion: `« Et quand vint Notre ordre, Nous sauvâmes Shu'ayb et ceux qui avaient cru avec lui. » Le miroir me montre le salut sélectif. « Falammaa jaaa'a amrunaa » — quand vint Notre ordre. L'accomplissement. « Najjainaa Shu'ayban » — Nous sauvâmes Shu'ayb. La protection. « Wallazeena aamanuu ma'ahu bi-rahmatim minnaa » — et ceux qui avaient cru avec lui, par une miséricorde de Nous. La grâce. Le miroir m'enseigne que le salut vient par la foi et la miséricorde.`,
  reflection: `Le salut est pour les croyants — la miséricorde d'Allah sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falammaa jaaa'a amrunaa najjainaa Shu'ayban wallazeena aamanuu ma'ahu bi-rahmatim minnaa » — et quand vint Notre ordre, Nous sauvâmes Shu'ayb et ceux qui avaient cru avec lui, par une miséricorde de Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le salut ? Avec les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le salut des uns est le châtiment des autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend le salut de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah est le secret du salut." }
  ],
  munajat: `Ya Munji, sauve-moi par Ta miséricorde. Fais que je sois avec les croyants sauvés.`
};

MIROIR["11:95"] = {
  reference: "11:95",
  theme: ["destruction", "oubli", "leçon"],
  emotion: "Mélancolie, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Baaqi"],
  mirrorVersion: `« Comme s'ils n'y avaient jamais vécu. » Le miroir me montre l'effacement total. « Ka-allam yaghnaw feeh » — comme s'ils n'y avaient jamais vécu. L'oubli. « Alaa bu'dal li-Madyan » — que périssent Madyan ! Le verdict. « Kamaa ba'udat Samuud » — comme Thamud a péri. La répétition. Le miroir m'enseigne que les peuples qui nient Allah sont effacés.`,
  reflection: `Les peuples qui nient Allah sont effacés — comme s'ils n'avaient jamais existé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-allam yaghnaw feeh alaa bu'dal li-Madyan kamaa ba'udat Samuud » — comme s'ils n'y avaient jamais vécu. Que périssent Madyan ! Comme Thamud a péri." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui restera de mon peuple ? De mon œuvre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effacement de la terre peut être l'élévation auprès d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne retient que ce qu'Allah veut retenir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie vie n'est pas sur la terre — elle est auprès d'Allah." }
  ],
  munajat: `Ya Baaqi, Tu es l'Éternel. Fais que mon œuvre reste auprès de Toi.`
};

MIROIR["11:96"] = {
  reference: "11:96",
  theme: ["moïse", "mission", "signes"],
  emotion: "Solennité, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'jiz", "An-Nadhir"],
  mirrorVersion: `« Et Nous avons envoyé Moïse avec Nos signes et une autorité manifeste. » Le miroir me montre la mission de Moïse. « Wa laqad arsalnaa Muusaa bi-aayaatinaa » — Nous avons envoyé Moïse avec Nos signes. La mission. « Wa sul-taanim mubeen » — et une autorité manifeste. Le pouvoir. Le miroir m'enseigne que la mission prophétique vient avec des signes et une autorité.`,
  reflection: `La mission d'Allah vient avec des preuves et une autorité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad arsalnaa Muusaa bi-aayaatinaa wa sul-taanim mubeen » — et Nous avons envoyé Moïse avec Nos signes et une autorité manifeste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle mission Allah m'a-t-Il confiée ? Avec quels signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'autorité d'Allah est plus forte que toute autorité humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne des signes d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte les signes d'Allah porte Son autorité." }
  ],
  munajat: `Ya Rabb, envoie-moi avec Tes signes. Donne-moi l'autorité de Te représenter.`
};

MIROIR["11:97"] = {
  reference: "11:97",
  theme: ["pharaon", "orgueil", "avertissement"],
  emotion: "Sérieux, appel",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Haqq"],
  mirrorVersion: `« Vers Pharaon et ses notables. Ils suivirent l'ordre de Pharaon. » Le miroir me montre l'opposition tyranique. « Ilaa Fir'awna wa malaa'ihi » — vers Pharaon et ses notables. Le pouvoir. « Fa-ttaba'uu amra Fir'awna » — ils suivirent l'ordre de Pharaon. L'aveuglement. « Wa maa amru Fir'awna bi-rashid » — l'ordre de Pharaon n'était pas raisonnable. La critique. Le miroir m'avertit contre le suivi aveugle des tyrans.`,
  reflection: `Le suivi des tyrans mène à la perdition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ilaa Fir'awna wa malaa'ihi fa-ttaba'uu amra Fir'awna wa maa amru Fir'awna bi-rashid » — vers Pharaon et ses notables. Ils suivirent l'ordre de Pharaon, et l'ordre de Pharaon n'était pas raisonnable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel tyran est-ce que je suis aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tyran le plus puissant est impuissant face à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne suit pas les tyrans — il suit son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les tyrans périt avec eux." }
  ],
  munajat: `Ya Rabb, ne permets pas que je suive les tyrans. Fais que je suive Tes signes.`
};

MIROIR["11:98"] = {
  reference: "11:98",
  theme: ["dirigeant", "responsabilité", "châtiment"],
  emotion: "Crainte, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qiyam", "Al-Mas'ul"],
  mirrorVersion: `« Il précédera son peuple au Jour de la Résurrection et les mènera à l'abreuvoir. » Le miroir me montre la responsabilité du dirigeant. « Yaqdum qawmahu Yawmal Qiyaamah » — il précédera son peuple au Jour de la Résurrection. La direction. « Fa-awradahumul baar » — et les mènera à l'abreuvoir. La destination. « Wa bi'sal wirmul maawrud » — quel détestable abreuvoir ! Le châtiment. Le miroir m'enseigne que les dirigeants entraînent leurs suivants.`,
  reflection: `Les dirigeants entraînent leurs suivants — vers le bien ou le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaqdum qawmahu Yawmal Qiyaamah fa-awradahumul baar wa bi'sal wirmul maawrud » — il précédera son peuple au Jour de la Résurrection et les mènera à l'abreuvoir. Quel détestable abreuvoir !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'entraîne ? Vers quelle destination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le dirigeant qui entraîne vers le mal porte la responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entraîne vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entraîne vers Allah reçoit la récompense des suivants." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'entraîne vers le mal. Fais que j'entraîne vers Toi.`
};

MIROIR["11:99"] = {
  reference: "11:99",
  theme: ["poursuite", "malediction", "au-delà"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-La'in", "Al-Qari'b"],
  mirrorVersion: `« Ils sont poursuivis par une malédiction dans ce monde et au Jour de la Résurrection. » Le miroir me montre la malédiction continue. « Utbi'uu fee haazihil la'nah » — ils sont poursuivis par une malédiction dans ce monde. Le châtiment immédiat. « Wa Yawmal Qiyaamah » — et au Jour de la Résurrection. L'éternité. « Bi'sar rizqal marzuud » — quel détestable don ! Le sort. Le miroir m'avertit que la malédiction peut suivre dans les deux mondes.`,
  reflection: `La malédiction peut poursuivre dans ce monde et l'au-delà.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa utbi'uu fee haazihil la'nah wa Yawmal Qiyaamah bi'sar rizqal marzuud » — ils sont poursuivis par une malédiction dans ce monde et au Jour de la Résurrection. Quel détestable don !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle malédiction me poursuit ? Comment m'en libérer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bénédiction peut remplacer la malédiction par le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est béni par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah peut transformer la malédiction en bénédiction." }
  ],
  munajat: `Ya Rabb, libère-moi de toute malédiction. Bénis-moi dans ce monde et l'au-delà.`
};

MIROIR["11:100"] = {
  reference: "11:100",
  theme: ["histoire", "récit", "sagesse"],
  emotion: "Instruction, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Qassas"],
  mirrorVersion: `« Cela fait partie des récits des cités que Nous te racontons. » Le miroir me montre la sagesse des récits. « Dhaalika min anbaa'il quraa » — cela fait partie des récits des cités. L'histoire. « Naqussuhaa 'alaika » — que Nous te racontons. La révélation. « Minhaa qaaa'imun » — certaines sont debout. Les vestiges. « Wa minhaa hasiid » — et d'autres fauchées. Les ruines. Le miroir m'enseigne que les récits historiques sont une instruction.`,
  reflection: `Les récits des anciens peuples sont une instruction pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhaalika min anbaa'il quraa naqussuhaa 'alaika minhaa qaaa'imun wa minhaa hasiid » — cela fait partie des récits des cités que Nous te racontons. Certaines sont debout et d'autres fauchées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle leçon je tire des récits des anciens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les cités debout deviendront fauchées — seule la vérité reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la mémoire de toutes les cités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les récits d'Allah sont éternels — les cités sont éphémères." }
  ],
  munajat: `Ya Hakim, enseigne-moi par Tes récits. Fais que je tire la leçon des anciens.`
};

MIROIR["11:101"] = {
  reference: "11:101",
  theme: ["injustice", "châtiment", "justice"],
  emotion: "Clarté, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Muntaqim"],
  mirrorVersion: `« Nous ne leur avons pas fait d'injustice. Ils se sont fait du tort à eux-mêmes. » Le miroir me montre la justice absolue. « Maa zalamnaahum » — Nous ne leur avons pas fait d'injustice. La justice divine. « Wa laakin zalamuu anfusahum » — mais ils se sont fait du tort à eux-mêmes. La responsabilité. « Fa-afalat 'anhum aalihatuhum » — leurs divinités les abandonnèrent. L'impuissance des idoles. Le miroir m'enseigne que le châtiment est la conséquence des propres actes.`,
  reflection: `Allah ne fait d'injustice à personne — le mal vient de nous-mêmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa maa zalamnaahum wa laakin zalamuu anfusahum fa-afalat 'anhum aalihatuhum » — Nous ne leur avons pas fait d'injustice. Ils se sont fait du tort à eux-mêmes. Leurs divinités les abandonnèrent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je fais du tort ? À moi-même ou aux autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mal qu'on fait aux autres se retourne contre soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas l'injustice — il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est si juste que le mal ne peut venir que de nous." }
  ],
  munajat: `Ya 'Adl, Tu es juste. Préserve-moi de me faire du tort. Fais que je ne nuise à personne.`
};

MIROIR["11:102"] = {
  reference: "11:102",
  theme: ["châtiment", "saisie", "justice"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Ash-Shadid"],
  mirrorVersion: `« Ainsi est la saisie de ton Seigneur quand Il saisit les cités injustes. » Le miroir me montre la prise divine. « Wa kadhaalika akhzu Rabbika izaaa akhadhal quraa » — ainsi est la saisie de ton Seigneur quand Il saisit les cités. La méthode. « Wa humu zaalimuun » — alors qu'elles sont injustes. Le crime. « Inna akhzahu aliimun shadeed » — Sa saisie est douloureuse, sévère. L'intensité. Le miroir m'avertit que la justice d'Allah est implacable.`,
  reflection: `La saisie d'Allah est douloureuse pour les injustes — implacable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhaalika akhzu Rabbika izaaa akhadhal quraa wa humu zaalimuun inna akhzahu aliimun shadeed » — ainsi est la saisie de ton Seigneur quand Il saisit les cités injustes. Sa saisie est douloureuse, sévère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je injuste ? Quel châtiment m'attend ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice d'Allah est implacable pour les injustes — miséricordieuse pour les justes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier craint la saisie d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte de la saisie d'Allah protège de l'injustice." }
  ],
  munajat: `Ya Qahhar, Ta saisie m'effraie. Préserve-moi de l'injustice. Fais que je ne sois jamais saisi.`
};

MIROIR["11:103"] = {
  reference: "11:103",
  theme: ["leçon", "au-delà", "crainte"],
  emotion: "Sérieux, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Akhirah", "Al-Khawf"],
  mirrorVersion: `« Il y a là un signe pour celui qui craint le châtiment de l'au-delà. » Le miroir me montre le but des récits. « Inna fee dhaalika la-aayatal liman khafaa 'azaabal aakhirah » — il y a là un signe pour celui qui craint le châtiment de l'au-delà. La leçon. « Dhaalika Yawmum majmoo'ul lahunnas » — c'est un jour rassemblé pour les gens. Le Rassemblement. « Dhaalika Yawmum mash-huud » — c'est un jour témoigné. La présence. Le miroir m'enseigne que les récits préparent au Jour Dernier.`,
  reflection: `Les récits des anciens préparent au Jour du Rassemblement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fee dhaalika la-aayatal liman khafaa 'azaabal aakhirah » — il y a là un signe pour celui qui craint le châtiment de l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment de l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment est le début de la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend le Jour du Rassemblement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le Jour Dernier y est préparé." }
  ],
  munajat: `Ya Rabb, fais que je craigne le Jour Dernier. Prépare-moi pour le Rassemblement.`
};

MIROIR["11:104"] = {
  reference: "11:104",
  theme: ["délai", "patience", "justice"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Ajal"],
  mirrorVersion: `« Nous ne le retardons que pour un terme déterminé. » Le miroir me montre le délai divin. « Wa maa nu'akh-khiruhu illaa li-ajalim ma'duud » — Nous ne le retardons que pour un terme déterminé. Le temps. Le terme fixé. La justice différée mais certaine. Le miroir m'enseigne que le délai n'est pas l'oubli.`,
  reflection: `Le délai d'Allah n'est pas l'oubli — le terme est fixé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa maa nu'akh-khiruhu illaa li-ajalim ma'duud » — Nous ne le retardons que pour un terme déterminé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je profite du délai d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde — pas une victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend son terme déterminé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le terme d'Allah est parfait — ni tard ni tôt." }
  ],
  munajat: `Ya Rabb, Ton délai est une miséricorde. Aide-moi à en profiter pour me repentir.`
};

MIROIR["11:105"] = {
  reference: "11:105",
  theme: ["jour", "parole", "permission"],
  emotion: "Solennité, silence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qiyam", "Al-Idhn"],
  mirrorVersion: `« Le jour où il viendra, nulle âme ne parlera sans Sa permission. » Le miroir me montre le Jour silencieux. « Yawma ya'tee laa takallamu nafsun illaa bi-idhnihi » — le jour où il viendra, nulle âme ne parlera sans Sa permission. L'autorité. « Faminhum shaqiyyun wa sa'eed » — parmi eux, il y aura des malheureux et des heureux. La séparation. Le miroir m'enseigne que le Jour Dernier est sous l'autorité absolue d'Allah.`,
  reflection: `Au Jour Dernier, nul ne parle sans la permission d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma ya'tee laa takallamu nafsun illaa bi-idhnihi faminhum shaqiyyun wa sa'eed » — le jour où il viendra, nulle âme ne parlera sans Sa permission. Parmi eux, il y aura des malheureux et des heureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je ne pouvais parler qu'avec la permission d'Allah, que dirais-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission d'Allah déterminera qui peut parler." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend en silence le Jour Dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les heureux parleront — les malheureux seront silencieux." }
  ],
  munajat: `Ya Rabb, accorde-moi la permission de parler au Jour Dernier. Fais que je sois parmi les heureux.`
};

MIROIR["11:106"] = {
  reference: "11:106",
  theme: ["malheur", "enfer", "châtiment"],
  emotion: "Crainte, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Ash-Shadid"],
  mirrorVersion: `« Quant aux malheureux, ils seront dans le Feu. » Le miroir me montre le sort des malheureux. « Fa-ammal-lazeena shaqaw » — quant aux malheureux. La catégorie. « Fa-fan-naari lahum feeha zafeerun wa shaheeq » — ils seront dans le Feu, où ils auront des soupirs et des sanglots. La souffrance. Le miroir m'avertit que le malheur éternel est une réalité.`,
  reflection: `Le malheur éternel dans le Feu est une réalité à éviter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ammal-lazeena shaqaw fa-fan-naari lahum feeha zafeerun wa shaheeq » — quant aux malheureux, ils seront dans le Feu, où ils auront des soupirs et des sanglots." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me préserve du malheur éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur d'un jour peut mener au malheur éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de place pour le malheur éternel — les humains seuls le choisissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le malheur est choisi — le bonheur est offert." }
  ],
  munajat: `Ya Rabb, préserve-moi du malheur éternel. Fais que je sois parmi les heureux, pas les malheureux.`
};

MIROIR["11:107"] = {
  reference: "11:107",
  theme: ["éternité", "enfer", "permanence"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Abad", "Al-Khulud"],
  mirrorVersion: `« Ils y demeureront éternellement, tant que dureront les cieux et la terre. » Le miroir me montre l'éternité du châtiment. « Khaalideena feeha » — ils y demeureront éternellement. La permanence. « Maa damatis samaawaatu wal ardu » — tant que dureront les cieux et la terre. La durée. « Illaa maa shaaa'a Rabbuk » — sauf ce que ton Seigneur veut. L'exception. Le miroir m'avertit que le châtiment peut être éternel.`,
  reflection: `Le châtiment peut être éternel — le repentir doit être maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khaalideena feeha maa damatis samaawaatu wal ardu illaa maa shaaa'a Rabbuk » — ils y demeureront éternellement, tant que dureront les cieux et la terre, sauf ce que ton Seigneur veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle action me préserve de l'éternité dans le Feu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité dans le Feu est l'opposé de l'éternité au Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier durera selon la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La volonté d'Allah détermine tout — même l'éternité." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'éternité dans le Feu. Fais que je mérite l'éternité au Paradis.`
};

MIROIR["11:108"] = {
  reference: "11:108",
  theme: ["bonheur", "paradis", "éternité"],
  emotion: "Espoir, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Firdaws"],
  mirrorVersion: `« Et quant aux heureux, ils seront au Paradis. » Le miroir me montre le sort des heureux. « Wa ammal-lazeena su'iduu » — et quant aux heureux. La catégorie. « Fa-fil jannah » — ils seront au Paradis. La récompense. « Khaalideena feeha » — ils y demeureront éternellement. La permanence. Le miroir m'offre l'espoir du bonheur éternel.`,
  reflection: `Le bonheur éternel au Paradis est la promesse d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ammal-lazeena su'iduu fa-fil jannah khaalideena feeha » — et quant aux heureux, ils seront au Paradis, ils y demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me qualifie pour être parmi les heureux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bonheur éternel est le cadeau d'Allah pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers le Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bonheur commence ici-bas par la foi." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les heureux. Accorde-moi l'éternité au Paradis.`
};

MIROIR["11:109"] = {
  reference: "11:109",
  theme: ["doute", "certitude", "attente"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Muntasir"],
  mirrorVersion: `« Ne sois donc pas en doute sur ce qu'adorent ceux-ci. » Le miroir me montre la certitude face au doute. « Falaa taku fee miryatim mimmaa ya'budu haaa'ulaaa'i » — ne sois donc pas en doute sur ce qu'adorent ceux-ci. La certitude. « Maa ya'buduuna illaa kamaa ya'budu aabaaa'uhum min qabl » — ils n'adorent que comme adoraient leurs pères auparavant. La tradition. « Wa innaa la-muwaffuuhum naseebahum ghayra naqis » — et Nous leur donnerons leur part sans diminution. La justice. Le miroir m'enseigne à ne pas douter du sort des idolâtres.`,
  reflection: `La certitude du sort des idolâtres n'a pas besoin de doute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falaa taku fee miryatim mimmaa ya'budu haaa'ulaaa'i maa ya'buduuna illaa kamaa ya'budu aabaaa'uhum min qabl » — ne sois donc pas en doute sur ce qu'adorent ceux-ci. Ils n'adorent que comme adoraient leurs pères auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je des doutes sur la vérité d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute disparaît avec la certitude d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est certain de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La certitude est le contraire du doute — elle vient d'Allah." }
  ],
  munajat: `Ya Haqq, éloigne de moi le doute. Donne-moi la certitude de Ta vérité.`
};

MIROIR["11:110"] = {
  reference: "11:110",
  theme: ["moïse", "livre", "division"],
  emotion: "Tristesse, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kitab", "Al-Furqan"],
  mirrorVersion: `« Nous avons donné le Livre à Moïse, mais il y eut divergence à son sujet. » Le miroir me montre la division post-révélation. « Wa laqaa ataynaa Musal Kitaba » — Nous avons donné le Livre à Moïse. Le don. « Fakh-tulifa feeh » — mais il y eut divergence à son sujet. La division. « Wa law-laa kalimatun sabaqat mir Rabbika » — sans une parole préalable de ton Seigneur. Le décret. « La-qudiya baynahum » — cela aurait été tranché entre eux. La justice différée. Le miroir m'enseigne que la division suit la révélation.`,
  reflection: `La division sur le Livre n'empêche pas la vérité du Livre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqaa ataynaa Musal Kitaba fakh-tulifa feeh » — Nous avons donné le Livre à Moïse, mais il y eut divergence à son sujet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite les divergences sur le Livre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division humaine n'altère pas l'unité du Livre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est unifié par le Livre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La divergence est le test — l'unité est la récompense." }
  ],
  munajat: `Ya Rabb, unifie mon cœur sur Ton Livre. Ne permets pas que la division m'atteigne.`
};

MIROIR["11:111"] = {
  reference: "11:111",
  theme: ["action", "rétribution", "justice"],
  emotion: "Responsabilité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Haqq"],
  mirrorVersion: `« Ton Seigneur paiera à chacun ses œuvres. » Le miroir me montre la rétribution certaine. « Wa inna kullal lammayuwaffiyannahum a'maalahum » — ton Seigneur paiera à chacun ses œuvres. La certitude. Chaque action sera rétribuée. Le miroir m'enseigne que rien n'est perdu.`,
  reflection: `Chaque action sera rétribuée — rien n'est perdu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna kullal lammayuwaffiyannahum a'maalahum » — ton Seigneur paiera à chacun ses œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle sera ma rétribution ? Quelle est ma balance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne action a sa récompense — la mauvaise aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier enregistre chaque action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah n'oublie rien — chaque atome de bien sera récompensé." }
  ],
  munajat: `Ya Rabb, paie-moi selon mes œuvres. Augmente mes bonnes actions et efface mes mauvaises.`
};

MIROIR["11:112"] = {
  reference: "11:112",
  theme: ["droiture", "constance", "ordre"],
  emotion: "Détermination, appel",
  difficulty: "débutant",
  relatedNames: ["As-Sirat", "Al-Mustaqim"],
  mirrorVersion: `« Reste sur le droit chemin comme il t'est ordonné. » Le miroir me montre l'ordre de constance. « Fastaqim kamaa umirta » — reste sur le droit chemin comme il t'est ordonné. L'ordre. « Wa man-taaba ma'aka » — et que reviennent avec toi. La compagnie. « Wa laa tatghaw » — ne transgressez pas. L'avertissement. « Innahu bimaa ta'maluuna baseer » — Il voit ce que vous faites. La conscience. Le miroir m'enseigne la droiture constante.`,
  reflection: `La droiture est un ordre — la transgression est un danger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fastaqim kamaa umirta wa man-taaba ma'aka wa laa tatghaw » — reste sur le droit chemin comme il t'est ordonné, toi et ceux qui reviennent avec toi. Ne transgressez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je sur le droit chemin ? Ou est-ce que je transgresse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droiture est l'ordre — la transgression est le danger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sur le droit chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La droiture est le chemin le plus court vers Allah." }
  ],
  munajat: `Ya Rabb, fais que je reste sur le droit chemin. Ne permets pas que je transgresse.`
};

MIROIR["11:113"] = {
  reference: "11:113",
  theme: ["injustice", "compromission", "châtiment"],
  emotion: "Avertissement, prudence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "An-Nar"],
  mirrorVersion: `« Ne vous penchez pas vers les injustes, sinon le Feu vous saisirait. » Le miroir me montre le danger de la compromission. « Wa laa tarkanuu ilal-lazeena zalamuu » — ne vous penchez pas vers les injustes. L'avertissement. « Fatamassakumun-naar » — sinon le Feu vous saisirait. La conséquence. « Wa maa lakum min duunil-laahi min awliyaa'i » — vous n'avez pas d'alliés en dehors d'Allah. L'avertissement. « Thumma laa tunsaruun » — puis vous ne serez pas secourus. L'impuissance. Le miroir m'avertit contre la compromission avec l'injustice.`,
  reflection: `La compromission avec l'injustice mène au Feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laa tarkanuu ilal-lazeena zalamuu fatamassakumun-naar wa maa lakum min duunil-laahi min awliyaa'i thumma laa tunsaruun » — ne vous penchez pas vers les injustes, sinon le Feu vous saisirait. Vous n'avez pas d'alliés en dehors d'Allah, puis vous ne serez pas secourus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quels injustes je me penche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement des injustes protège du Feu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se compromet pas avec l'injustice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compromission est un détour vers le Feu." }
  ],
  munajat: `Ya 'Adl, préserve-moi de la compromission. Ne permets pas que je me penche vers les injustes.`
};

MIROIR["11:114"] = {
  reference: "11:114",
  theme: ["prière", "constance", "pardon"],
  emotion: "Dévotion, espoir",
  difficulty: "débutant",
  relatedNames: ["As-Salah", "Al-Ghafur"],
  mirrorVersion: `« Accomplis la prière aux deux extrémités du jour et à certaines heures de la nuit. » Le miroir me montre la constance de la prière. « Wa aqimis-salata tarafayin-nahaari » — accomplis la prière aux deux extrémités du jour. La régularité. « Wa zulafam minal layl » — et à certaines heures de la nuit. La nuit. « Innal hasanaati yuz-hibnas-sayyi'aat » — les bonnes actions effacent les mauvaises. L'espoir. « Dhaalika zikraa liz-zaakireen » — c'est un rappel pour ceux qui se rappellent. La mémoire. Le miroir m'enseigne que la prière régulière purifie.`,
  reflection: `La prière régulière efface les péchés — la constance purifie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aqimis-salata tarafayin-nahaari wa zulafam minal layl innal hasanaati yuz-hibnas-sayyi'aat » — accomplis la prière aux deux extrémités du jour et à certaines heures de la nuit. Les bonnes actions effacent les mauvaises." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma prière est régulière ? Efface-t-elle mes péchés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière régulière est la lessive de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier prie par son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière constante maintient le cœur pur." }
  ],
  munajat: `Ya Rabb, fais que je prie régulièrement. Efface mes mauvaises actions par mes bonnes actions.`
};

MIROIR["11:115"] = {
  reference: "11:115",
  theme: ["patience", "persévérance", "victoire"],
  emotion: "Détermination, espoir",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Fattah"],
  mirrorVersion: `« Et endure avec patience, car Allah ne laisse pas perdre la récompense des bienfaiteurs. » Le miroir me montre la promesse de la patience. « Wasbir » — et endure. L'ordre. « Fa-innal laaha laa yudee'u ajral muhsineen » — car Allah ne laisse pas perdre la récompense des bienfaiteurs. La promesse. Le miroir m'enseigne que la patience sera récompensée.`,
  reflection: `La patience sera récompensée — Allah ne perd rien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wasbir fa-innal laaha laa yudee'u ajral muhsineen » — et endure avec patience, car Allah ne laisse pas perdre la récompense des bienfaiteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est ma patience ? Suis-je bienfaiteur ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "L'impatience perd la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier endure avec patience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La patience est la clé du trésor caché." }
  ],
  munajat: `Ya Sabur, donne-moi la patience. Ne permets pas que je perde la récompense des bienfaiteurs.`
};

MIROIR["11:116"] = {
  reference: "11:116",
  theme: ["sagesse", "interdiction", "minorité"],
  emotion: "Responsabilité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "An-Nahy"],
  mirrorVersion: `« Si seulement il y avait, parmi les générations passées, des gens de bon sens pour interdire la corruption sur la terre ! » Le miroir me montre le manque de sauveurs. « Falaw-laa kaana min quruunim min qablikum uluu baqiy-yatin » — si seulement il y avait parmi les générations passées des gens de bon sens. L'espoir. « Yan-hawna 'anil fasaadi fil ardi » — pour interdire la corruption sur la terre. La mission. « Illaa qaleelam mimman anjaynaa minhum » — excepté un petit nombre de ceux que Nous avons sauvés. La minorité. Le miroir m'enseigne que les sauveurs sont rares.`,
  reflection: `Les sauveurs sont rares — être parmi eux est un honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falaw-laa kaana min quruunim min qablikum uluu baqiy-yatin yan-hawna 'anil fasaadi fil ardi illaa qaleelam mimman anjaynaa minhum » — si seulement il y avait parmi les générations passées des gens de bon sens pour interdire la corruption sur la terre ! Excepté un petit nombre de ceux que Nous avons sauvés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'interdis la corruption ? Suis-je sauveur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La minorité des sauveurs est l'élite d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier interdit la corruption par son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah sauve les sauveurs — Il les protège." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les sauveurs. Donne-moi le courage d'interdire la corruption.`
};

MIROIR["11:117"] = {
  reference: "11:117",
  theme: ["justice", "destruction", "raison"],
  emotion: "Clarté, justice",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hukm"],
  mirrorVersion: `« Ton Seigneur ne détruit pas injustement les cités dont les habitants sont bienfaiteurs. » Le miroir me montre la justice de la destruction. « Wa maa kaana Rabbuka li-yuhlikal quraa biz-zulmin » — ton Seigneur ne détruit pas injustement les cités. La justice. « Wa ahluhaa muslihuun » — dont les habitants sont bienfaiteurs. La condition. Le miroir m'enseigne que la destruction vient quand la corruption est totale.`,
  reflection: `La destruction ne vient pas aux cités bienfaisantes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa maa kaana Rabbuka li-yuhlikal quraa biz-zulmin wa ahluhaa muslihuun » — ton Seigneur ne détruit pas injustement les cités dont les habitants sont bienfaiteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma cité est-elle bienfaisante ou corrompue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bienfaisance protège de la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est bienfaisant par son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La bienfaisance d'un seul peut sauver une cité." }
  ],
  munajat: `Ya 'Adl, fais que ma cité soit bienfaisante. Préserve-nous de la destruction.`
};

MIROIR["11:118"] = {
  reference: "11:118",
  theme: ["unité", "volonté", "diversité"],
  emotion: "Acceptation, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waahid", "Al-Murid"],
  mirrorVersion: `« Si ton Seigneur avait voulu, Il aurait fait des hommes une seule communauté. » Le miroir me montre la diversité voulue. « Wa law shaaa'a Rabbuka la-ja'alan-naasa ummataw waahidah » — si ton Seigneur avait voulu, Il aurait fait des hommes une seule communauté. La possibilité. « Wa laa ya zaaluuna mukhtalifeen » — mais ils ne cessent d'être en désaccord. La réalité. Le miroir m'enseigne que la diversité fait partie du plan divin.`,
  reflection: `La diversité et le désaccord font partie du plan divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law shaaa'a Rabbuka la-ja'alan-naasa ummataw waahidah wa laa ya zaaluuna mukhtalifeen » — si ton Seigneur avait voulu, Il aurait fait des hommes une seule communauté. Mais ils ne cessent d'être en désaccord." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère le désaccord avec les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité est possible — mais la diversité est voulue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est divers mais uni dans son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie unité est dans la diversité qui reconnaît Allah." }
  ],
  munajat: `Ya Waahid, Tu es l'Unique. Unifie mon cœur dans la diversité. Fais que je gère le désaccord avec sagesse.`
};

MIROIR["11:119"] = {
  reference: "11:119",
  theme: ["miséricorde", "guidance", "élection"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Hadi"],
  mirrorVersion: `« Excepté ceux à qui ton Seigneur a fait miséricorde. » Le miroir me montre l'exception miséricordieuse. « Illaa man rahima Rabbuka » — excepté ceux à qui ton Seigneur a fait miséricorde. L'élection. « Wa lizaalika khalaqahum » — et c'est pour cela qu'Il les a créés. Le but. « Wa tammat kalimatu Rabbika » — et la parole de ton Seigneur s'est accomplie. L'accomplissement. « La-amla'anna jahannama minal jinnati wan-naasi ajma'een » — Je remplirai certainement l'Enfer de djinns et d'hommes tous ensemble. Le verdict. Le miroir m'enseigne que la miséricorde est la voie du salut.`,
  reflection: `La miséricorde d'Allah est la seule voie de salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illaa man rahima Rabbuka wa lizaalika khalaqahum » — excepté ceux à qui ton Seigneur a fait miséricorde. Et c'est pour cela qu'Il les a créés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je de ceux qui reçoivent la miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde d'Allah sauve de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est créé pour la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La demande de miséricorde est exaucée." }
  ],
  munajat: `Ya Rahman, fais-moi miséricorde. Crée-moi pour Ta miséricorde, pas pour l'Enfer.`
};

MIROIR["11:120"] = {
  reference: "11:120",
  theme: ["récit", "prophètes", "réconfort"],
  emotion: "Réconfort, instruction",
  difficulty: "débutant",
  relatedNames: ["Al-Qassas", "An-Nabi"],
  mirrorVersion: `« Et tout ce que Nous te racontons des récits des messagers est pour fortifier ton cœur. » Le miroir me montre le but des récits. « Wa kullan naqussu 'alaika min anbaa'ir rusuli » — tout ce que Nous te racontons des récits des messagers. L'instruction. « Ma nusabbitu bihee fu'aadak » — est pour fortifier ton cœur. Le but. « Wa jaaa-aka haqqal haqq » — et la vérité t'est venue. La certitude. « Wa maw'izatul lil-mu'mineen » — et un exhortation pour les croyants. La guidance. Le miroir m'enseigne que les récits prophétiques fortifient.`,
  reflection: `Les récits des prophètes fortifient le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kullan naqussu 'alaika min anbaa'ir rusuli ma nusabbitu bihee fu'aadak » — et tout ce que Nous te racontons des récits des messagers est pour fortifier ton cœur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment les récits prophétiques fortifient-ils mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur sans récits prophétiques est faible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se fortifie par les récits d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fortification du cœur vient de la compagnie des prophètes." }
  ],
  munajat: `Ya Rabb, fortifie mon cœur par Tes récits. Fais que je m'instruise des prophètes.`
};

MIROIR["11:121"] = {
  reference: "11:121",
  theme: ["action", "résultat", "justice"],
  emotion: "Responsabilité, attente",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Haqq"],
  mirrorVersion: `« Dis à ceux qui ne croient pas : 'Agissez selon votre manière. Nous agissons aussi.' » Le miroir me montre la confrontation des actions. « Qul lillazeena laa yu'minuun i'maluu 'alaa makaanatikum » — dis à ceux qui ne croient pas : agissez selon votre manière. Le défi. « Inna 'aamilun » — nous agissons aussi. La réponse. Le miroir m'enseigne que les actions seront comparées.`,
  reflection: `Les actions seront comparées — les résultats révéleront la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul lillazeena laa yu'minuun i'maluu 'alaa makaanatikum inna 'aamilun » — dis à ceux qui ne croient pas : agissez selon votre manière. Nous agissons aussi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma manière d'agir ? Est-elle conforme à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'action pour Allah surpassera toute autre action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier agit selon l'ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les actions visibles cachent les intentions invisibles." }
  ],
  munajat: `Ya Rabb, fais que j'agisse selon Ta manière. Ne permets pas que mes actions soient vaines.`
};

MIROIR["11:122"] = {
  reference: "11:122",
  theme: ["attente", "résultat", "vérité"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Haqq"],
  mirrorVersion: `« Et attendez. Nous attendons aussi. » Le miroir me montre l'attente comparative. « Wantaqiruu » — et attendez. L'invitation. « Inna muntaziroon » — nous attendons aussi. La réponse. Le miroir m'enseigne que le temps révélera la vérité.`,
  reflection: `Le temps révélera la vérité — l'attente est l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wantaqiruu inna muntaziroon » — et attendez. Nous attendons aussi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends ? Quelle sera la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attente des croyants est différente de l'attente des mécréants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend le verdict d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attente d'Allah est plus courte que l'éternité." }
  ],
  munajat: `Ya Rabb, je T'attends. Fais que mon attente soit couronnée de succès.`
};

MIROIR["11:123"] = {
  reference: "11:123",
  theme: ["inconnu", "science", "confiance"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghayb", "Al-'Alim"],
  mirrorVersion: `« À Allah appartient l'inconnu des cieux et de la terre. » Le miroir me montre la science divine. « Lillaahi ghaybus samaawaati wal ardi » — à Allah appartient l'inconnu des cieux et de la terre. La science. « Wa ilayhi yurja'uul amru kulluh » — et vers Lui retourne toute chose. Le retour. « Fastakhillu bissalaati wattaqiinee » — adore-Le et place ta confiance en Lui. L'ordre. « Wa maa Rabbuka bighaafilin 'ammaa ta'maluun » — ton Seigneur n'est pas ignorant de ce que vous faites. La conscience. Le miroir m'enseigne que la confiance en Allah remplace l'anxiété de l'inconnu.`,
  reflection: `La confiance en Allah remplace l'anxiété de l'inconnu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillaahi ghaybus samaawaati wal ardi wa ilayhi yurja'uul amru kulluh fastakhillu bissalaati wattaqiinee » — à Allah appartient l'inconnu des cieux et de la terre, et vers Lui retourne toute chose. Adore-Le et place ta confiance en Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère l'inconnu ? Avec anxiété ou confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inconnu pour moi est connu d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier vit dans la confiance en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance en Allah est la paix dans l'inconnu." }
  ],
  munajat: `Ya 'Alim, Tu connais l'inconnu. Je me confie à Toi. Adore-Toi et place ma confiance en Toi.`
};

// === SURAH 12 (YUSUF) - Missing entries ===

MIROIR["12:2"] = {
  reference: "12:2",
  theme: ["coran", "arabe", "compréhension"],
  emotion: "Gratitude, compréhension",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Lisan"],
  mirrorVersion: `« Nous l'avons fait descendre, un Coran en langue arabe, afin que vous compreniez. » Le miroir me montre le don de la langue. « Innaa anzalnaahu Quraanan 'arabiyyal la'allakum ta'qiluun » — Nous l'avons fait descendre, un Coran en langue arabe, afin que vous compreniez. La clarté. Le miroir m'enseigne que la langue du Coran est choisie pour la compréhension.`,
  reflection: `La langue du Coran est choisie pour notre compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaa anzalnaahu Quraanan 'arabiyyal la'allakum ta'qiluun » — Nous l'avons fait descendre, un Coran en langue arabe, afin que vous compreniez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compréhension du Coran ouvre la compréhension de tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier comprend l'ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La langue est le pont entre le cœur et la vérité." }
  ],
  munajat: `Ya Rabb, fais que je comprenne Ton Coran. Ouvre mon cœur à Sa compréhension.`
};

MIROIR["12:3"] = {
  reference: "12:3",
  theme: ["récit", "révélation", "meilleur"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Ahsan", "Al-Qassas"],
  mirrorVersion: `« Nous te racontons le meilleur récit par cette révélation. » Le miroir me montre la qualité du récit. « Nahnu naqussu 'alaika ahsanal qasas » — Nous te racontons le meilleur récit. La qualité. « Bimaaa awhaynaa ilayka haazal Quraan » — par cette révélation du Coran. Le moyen. « Wa in kunta min qablihii laminal ghaafileen » — alors qu'avant cela, tu étais parmi les insouciants. Le changement. Le miroir m'enseigne que le Coran transforme l'insouciance en conscience.`,
  reflection: `Le Coran transforme l'insouciance en conscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nahnu naqussu 'alaika ahsanal qasas bimaaa awhaynaa ilayka haazal Quraan » — Nous te racontons le meilleur récit par cette révélation du Coran." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le Coran m'a-t-il sorti de l'insouciance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'insouciance avant le Coran devient conscience après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est conscient par l'ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le meilleur récit transforme l'auditeur." }
  ],
  munajat: `Ya Rabb, le Coran m'a sorti de l'insouciance. Fais que je sois conscient par lui.`
};

MIROIR["12:5"] = {
  reference: "12:5",
  theme: ["jalousie", "protection", "conseil"],
  emotion: "Amour protecteur, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Hafiz"],
  mirrorVersion: `« Il dit : 'Ô mon fils, ne raconte pas ton rêve à tes frères.' » Le miroir me montre la sagesse protectrice. « Yaa bunayya laa taqsus ru'yaa 'alaa ikhwatika » — ô mon fils, ne raconte pas ton rêve à tes frères. La protection. « Fa-yakeedu laka kaydaa » — ils te tendraient un piège. Le danger. « Innash-shaytaana lil-insaani 'aduwwum mubeen » — le diable est pour l'homme un ennemi manifeste. L'avertissement. Le miroir m'enseigne la prudence dans le partage des bénédictions.`,
  reflection: `La prudence dans le partage des bénédictions protège de la jalousie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala yaa bunayya laa taqsus ru'yaa 'alaa ikhwatika fa-yakeedu laka kaydaa » — il dit : ô mon fils, ne raconte pas ton rêve à tes frères, ils te tendraient un piège." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles bénédictions dois-je protéger de la jalousie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret protège — la révélation expose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers protège ses secrets par son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection du père reflète la protection d'Allah." }
  ],
  munajat: `Ya Hafiz, protège mes bénédictions. Enseigne-moi la prudence dans le partage.`
};

MIROIR["12:6"] = {
  reference: "12:6",
  theme: ["élection", "interprétation", "promesse"],
  emotion: "Espoir, promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Mustafa", "Al-Mu'allim"],
  mirrorVersion: `« Ainsi ton Seigneur t'élira et t'enseignera l'interprétation des rêves. » Le miroir me montre la promesse d'élection. « Wa kadhaalika yajtabeeka Rabbuka wa yu'allimuka min ta'weelil ahaadees » — ainsi ton Seigneur t'élira et t'enseignera l'interprétation. L'élection. « Wa yutimmu ni'matahu 'alaika » — et Il accomplira Sa grâce sur toi. La bénédiction. « Wa 'alaa aali Ya'qoob » — et sur la famille de Jacob. L'extension. « Kamaa atammahaa 'alaa abawayka min qablu » — comme Il l'a accomplie sur tes ancêtres auparavant. La continuité. Le miroir m'enseigne que l'élection divine a une histoire.`,
  reflection: `L'élection divine suit une lignée de grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhaalika yajtabeeka Rabbuka wa yu'allimuka min ta'weelil ahaadees wa yutimmu ni'matahu 'alaika » — ainsi ton Seigneur t'élira et t'enseignera l'interprétation des rêves, et Il accomplira Sa grâce sur toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle élection Allah a-t-Il pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élection d'Allah inclut l'enseignement et la grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est élu par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'élection divine transcende les générations." }
  ],
  munajat: `Ya Rabb, élis-moi. Enseigne-moi. Accomplis Ta grâce sur moi comme sur les élus d'avant.`
};

MIROIR["12:7"] = {
  reference: "12:7",
  theme: ["signes", "questionneurs", "histoire"],
  emotion: "Instruction, promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ayah", "Al-Bayan"],
  mirrorVersion: `« Il y a certes dans leur histoire des signes pour les questionneurs. » Le miroir me montre le but de l'histoire. « Laqad kaana fee qasasihim 'ibratul lil-ulil albaab » — il y a certes dans leur histoire des signes. L'instruction. « Li-ulil albaab » — pour les gens doués d'intelligence. La condition. Le miroir m'enseigne que l'histoire instruit les intelligents.`,
  reflection: `L'histoire instruit ceux qui ont l'intelligence de voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad kaana fee qasasihim 'ibratul lil-ulil albaab » — il y a certes dans leur histoire des signes pour les gens doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je l'intelligence de voir les signes dans l'histoire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire sans intelligence est une histoire perdue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une histoire de signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les signes dans l'histoire attendent les intelligents." }
  ],
  munajat: `Ya Rabb, donne-moi l'intelligence de voir les signes. Fais que je sois parmi les gens doués d'intelligence.`
};

MIROIR["12:8"] = {
  reference: "12:8",
  theme: ["jalousie", "préférence", "frères"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Hasad", "Al-Ikhwan"],
  mirrorVersion: `« Ils dirent : 'Joseph et son frère sont plus aimés de notre père que nous.' » Le miroir me montre la jalousie destructrice. « Qaalu la-yuusufu wa akhuuhu ahabbu ilaa abeenaa minnaa » — Joseph et son frère sont plus aimés de notre père que nous. La jalousie. « Wa nahnu 'usbah » — alors que nous sommes un groupe fort. L'orgueil. « Inna abaanaa lafee dalaalim mubeen » — notre père est dans un égarement manifeste. L'accusation. Le miroir m'avertit contre la jalousie des favorisés.`,
  reflection: `La jalousie des favorisés mène à l'accusation des justes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaalu la-yuusufu wa akhuuhu ahabbu ilaa abeenaa minnaa wa nahnu 'usbah » — ils dirent : Joseph et son frère sont plus aimés de notre père que nous, alors que nous sommes un groupe fort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je jaloux de ceux qui sont favorisés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jalousie mène à l'accusation injuste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas jaloux — il accepte l'ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La jalousie est le premier pas vers le crime." }
  ],
  munajat: `Ya Rabb, préserve-moi de la jalousie. Fais que je me réjouisse du bien des autres.`
};

MIROIR["12:9"] = {
  reference: "12:9",
  theme: ["complot", "meurtre", "jalousie"],
  emotion: "Horreur, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qatl", "Al-Ghayrah"],
  mirrorVersion: `« Tuez Joseph ou éloignez-le. » Le miroir me montre le complot extrême. « Aqtulu Yuusufa awi trafoo ardah » — tuez Joseph ou éloignez-le. Le complot. « Yakhla lakum wajhu abeekum » — le visage de votre père se tournera vers vous. L'objectif. « Wa takuunuu mim ba'dihii qawman saaliheen » — et après cela, vous serez des gens vertueux. La justification. Le miroir m'avertit que la jalousie peut mener au complot.`,
  reflection: `La jalousie peut mener au complot le plus extrême.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aqtulu Yuusufa awi trafoo ardah yakhla lakum wajhu abeekum wa takuunuu mim ba'dihii qawman saaliheen » — tuez Joseph ou éloignez-le. Le visage de votre père se tournera vers vous, et après cela, vous serez des gens vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quel extrême ma jalousie peut-elle me mener ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le crime justifié reste un crime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rejette tout complot." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le complot des jaloux se retourne contre eux." }
  ],
  munajat: `Ya Rabb, préserve-moi du complot. Ne permets pas que ma jalousie me pousse au crime.`
};

MIROIR["12:10"] = {
  reference: "12:10",
  theme: ["modération", "puits", "conseil"],
  emotion: "Modération, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Wasat", "Al-Bi'r"],
  mirrorVersion: `« Un parmi eux dit : 'Ne tuez pas Joseph, jetez-le dans un puits.' » Le miroir me montre la modération dans le mal. « Qaala qaaa'ilum minhum laa taqtulu Yuusuf » — un parmi eux dit : ne tuez pas Joseph. La modération. « Wa alqoohu fee ghayaabatil jub » — jetez-le dans un puits. L'alternative. « Yalqatahu ba'dus-sayyaarah » — des voyageurs le ramasseront. L'espoir. « In kuntum faa'ileen » — si vous êtes décidés. La condition. Le miroir m'enseigne que même le mal peut avoir des degrés.`,
  reflection: `Même le mal a des degrés — la modération en atténue l'horreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaala qaaa'ilum minhum laa taqtulu Yuusuf wa alqoohu fee ghayaabatil jub yalqatahu ba'dus-sayyaarah » — un parmi eux dit : ne tuez pas Joseph, jetez-le dans un puits. Des voyageurs le ramasseront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans le mal, suis-je modéré ou extrême ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La modération dans le mal n'est pas le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rejette tout mal — modéré ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La modération peut sauver — mais le bien est meilleur." }
  ],
  munajat: `Ya Rabb, préserve-moi du mal. Mais si je suis tenté, fais que je sois modéré plutôt qu'extrême.`
};

MIROIR["37:25"] = {
  reference: "37:25",
  theme: ["secours", "absence", "réalité"],
  emotion: "Désespoir, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nasr", "Al-Ghayabah"],
  mirrorVersion: `« Qu'avez-vous à ne pas vous secourir mutuellement ? » Le miroir me montre l'impuissance mutuelle. « Ma lakum la tanasaran » — qu'avez-vous à ne pas vous secourir mutuellement ? La question rhétorique. Le miroir m'avertit : au jour du Jugement, personne ne peut aider personne.`,
  reflection: `Au jour du Jugement, le secours mutuel est impossible. Chacun est seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lakum la tanasaran » — qu'avez-vous à ne pas vous secourir mutuellement ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur qui je compte pour le secours au jour du Jugement ? Sur Allah seul." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Seul le secours d'Allah compte au jour du Jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers compte sur le secours de son Créateur seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur le secours d'Allah n'est pas déçu." }
  ],
  munajat: `Ya Nâsir, je compte sur Ton secours seul. Ne permets pas que je cherche le secours ailleurs. Secours-moi au jour du Jugement.`
};

MIROIR["37:26"] = {
  reference: "37:26",
  theme: ["soumission", "jugement", "réalité"],
  emotion: "Soumission, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Qiyamah"],
  mirrorVersion: `« Mais ce jour-là, ils seront tous soumis. » Le miroir me montre la soumission finale. « Bal huma al-yawma mustaslamun » — mais ce jour-là, ils seront tous soumis. La soumission universelle. Le miroir m'invite à me soumettre maintenant.`,
  reflection: `Tous seront soumis au jour du Jugement. La soumission volontaire maintenant est meilleure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal huma al-yawma mustaslamun » — mais ce jour-là, ils seront tous soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumis maintenant volontairement ? Ou est-ce que j'attends la soumission forcée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission volontaire maintenant vaut mieux que la soumission forcée plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est soumis à son Créateur par nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet volontairement maintenant est honoré." }
  ],
  munajat: `Ya Rabb, je me soumets à Toi maintenant volontairement. Ne permets pas que j'attende la soumission forcée. Accepte ma soumission.`
};

MIROIR["37:27"] = {
  reference: "37:27",
  theme: ["question", "faute", "reproche"],
  emotion: "Regret, reproche",
  difficulty: "débutant",
  relatedNames: ["At-Talab, At-Tawajjuh"],
  mirrorVersion: `« Ils se tourneront les uns vers les autres, s'interrogeant mutuellement. » Le miroir me montre les reproches mutuels. « Wa yaqbilu ba'duhum 'ala ba'din yatasa'alun » — ils se tourneront les uns vers les autres, s'interrogeant mutuellement. Les questions. Le miroir m'avertit : les alliances terrestres se transforment en reproches.`,
  reflection: `Les anciens alliés deviennent des accusateurs. Personne ne peut se cacher derrière les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaqbilu ba'duhum 'ala ba'din yatasa'alun » — ils se tourneront les uns vers les autres, s'interrogeant mutuellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui me reprochera quoi au jour du Jugement ? Suis-je prêt à répondre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les reproches ne servent à rien si on n'a pas la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se reproche rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi n'a pas de reproches à craindre." }
  ],
  munajat: `Ya Rabb, je ne veux pas de reproches au jour du Jugement. Donne-moi la foi qui protège. Ne permets pas que je sois parmi les accusés.`
};

MIROIR["37:28"] = {
  reference: "37:28",
  theme: ["responsabilité", "charge", "reproche"],
  emotion: "Désespoir, reproche",
  difficulty: "débutant",
  relatedNames: ["Al-Wizr", "At-Tabarra"],
  mirrorVersion: `« Ils diront : 'C'est vous qui nous veniez de la droite.' » Le miroir me montre l'accusation. « Qalu innakum ta'tunana 'ani al-yamin » — c'est vous qui nous veniez de la droite. L'accusation. Le miroir m'avertit : les meneurs seront accusés par les suivants.`,
  reflection: `Les meneurs dans l'égarement seront accusés par ceux qu'ils ont égarés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu innakum ta'tunana 'ani al-yamin » — c'est vous qui nous veniez de la droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai égaré quelqu'un ? Ou est-ce que je suis sur le chemin droit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin droit ne mène personne à l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'égare personne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide vers le bien n'est pas accusé." }
  ],
  munajat: `Ya Rabb, je ne veux pas être accusé d'avoir égaré. Garde-moi sur le chemin droit. Ne permets pas que j'égare qui que ce soit.`
};

MIROIR["37:29"] = {
  reference: "37:29",
  theme: ["réponse", "foi", "liberté"],
  emotion: "Défense, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Ikhtiyar"],
  mirrorVersion: `« Ils répondront : 'Vous n'étiez pas croyants.' » Le miroir me montre la défense des meneurs. « Qalu ma kuntum mu'minin » — vous n'étiez pas croyants. La défense. Le miroir m'enseigne : la foi est un choix personnel.`,
  reflection: `Personne ne peut forcer la foi. Chacun est responsable de sa propre croyance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ma kuntum mu'minin » — vous n'étiez pas croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vraiment croyant ? Ou est-ce que je suivais sans foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi personnelle est la seule qui compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croit par sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une foi personnelle n'a pas d'excuse à donner." }
  ],
  munajat: `Ya Rabb, j'ai une foi personnelle en Toi. Ne permets pas que je sois parmi ceux qui suivent sans foi. Donne-moi une foi authentique.`
};

MIROIR["37:30"] = {
  reference: "37:30",
  theme: ["pouvoir", "contrainte", "non-responsabilité"],
  emotion: "Défense, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sultan", "Al-Jabr"],
  mirrorVersion: `« Nous n'avions aucun pouvoir sur vous. » Le miroir me montre la non-responsabilité des meneurs. « Wa ma kana lana 'alaykum min sultan » — nous n'avions aucun pouvoir sur vous. La défense. Le miroir m'enseigne : le pouvoir de la foi appartient à chacun.`,
  reflection: `Les meneurs n'avaient pas le pouvoir de forcer. La décision était personnelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana lana 'alaykum min sultan » — nous n'avions aucun pouvoir sur vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse influencer par les autres ? Ou est-ce que je prends mes propres décisions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La décision personnelle est la seule qui compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers décide par sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui décide par lui-même est responsable de sa décision." }
  ],
  munajat: `Ya Rabb, je prends mes propres décisions. Ne permets pas que je sois influencé par les autres. Donne-moi la force de décider par moi-même.`
};

MIROIR["37:31"] = {
  reference: "37:31",
  theme: ["parole", "jugement", "criminels"],
  emotion: "Réalité, désespoir",
  difficulty: "débutant",
  relatedNames: ["Al-Qawl", "Al-Mujrimun"],
  mirrorVersion: `« La parole de notre Seigneur s'est réalisée contre nous. » Le miroir me montre la réalisation de la menace. « Fa-haqqa qawlu rabbina 'alayna » — la parole de notre Seigneur s'est réalisée contre nous. La réalisation. « Inna la-dha'iqun » — nous allons goûter. La conséquence. Le miroir m'avertit : la menace d'Allah est certaine.`,
  reflection: `La parole d'Allah se réalise. La menace contre les criminels est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-haqqa qawlu rabbina 'alayna inna la-dha'iqun » — la parole de notre Seigneur s'est réalisée contre nous. Nous allons goûter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la réalisation de la parole d'Allah contre moi ? Ou est-ce que je la néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réalisation de la promesse d'Allah est aussi certaine que la menace." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah se réalise sur l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la menace se protège par la foi." }
  ],
  munajat: `Ya Rabb, je crains la réalisation de Ta parole contre moi. Protège-moi par la foi. Ne permets pas que je goûte au châtiment.`
};

MIROIR["37:32"] = {
  reference: "37:32",
  theme: ["égarement", "influence", "responsabilité"],
  emotion: "Regret, reproche",
  difficulty: "débutant",
  relatedNames: ["Ad-Dalal", "At-Tabi'ah"],
  mirrorVersion: `« Nous vous avons égarés. » Le miroir me montre l'aveu des meneurs. « Fa-aghwaynakum » — nous vous avons égarés. L'aveu. « Inna kunna dhillin » — nous étions égarés. La confession. Le miroir m'avertit : ceux qui égarent sont eux-mêmes égarés.`,
  reflection: `Les meneurs avouent avoir égaré. Mais ils étaient eux-mêmes égarés. L'égarement attire l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aghwaynakum inna kunna dhillin » — nous vous avons égarés. Nous étions égarés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'égare les autres ? Ou est-ce que je suis moi-même égaré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui est guidé ne peut égarer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'égare personne car il est guidé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est guidé guide vers le bien." }
  ],
  munajat: `Ya Hadi, guide-moi. Ne permets pas que j'égare qui que ce soit. Donne-moi la guidance qui guide les autres.`
};

MIROIR["37:33"] = {
  reference: "37:33",
  theme: ["châtiment", "partage", "associés"],
  emotion: "Réalité, désespoir",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Ash-Shuraka"],
  mirrorVersion: `« Ce jour-là, ils seront tous associés dans le châtiment. » Le miroir me montre le sort commun. « Fa-innahum yawma'idhin fi al-'adhabi mushtarikun » — ce jour-là, ils seront tous associés dans le châtiment. Le sort commun. Le miroir m'avertit : les alliances dans l'égarement mènent au châtiment partagé.`,
  reflection: `Les associés dans l'égarement sont associés dans le châtiment. Personne n'est épargné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innahum yawma'idhin fi al-'adhabi mushtarikun » — ce jour-là, ils seront tous associés dans le châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui je suis associé ? Dans le bien ou dans le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les associés dans le bien sont associés dans la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est associé dans l'adoration de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'associe aux bons est associé dans le bien." }
  ],
  munajat: `Ya Rabb, je veux être associé aux bons, pas aux mauvais. Donne-moi de bonnes fréquentations. Ne permets pas que je sois associé dans le châtiment.`
};

MIROIR["37:34"] = {
  reference: "37:34",
  theme: ["coutume", "pécheurs", "châtiment"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["As-Sunnah", "Al-Mujrimun"],
  mirrorVersion: `« C'est ainsi que Nous agissons avec les criminels. » Le miroir me montre la règle divine. « Inna kadhalika naf'alu bi-al-mujrimin » — c'est ainsi que Nous agissons avec les criminels. La règle. Le miroir m'avertit : la sunna d'Allah est constante.`,
  reflection: `La sunna d'Allah envers les criminels ne change pas. Le châtiment est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kadhalika naf'alu bi-al-mujrimin » — c'est ainsi que Nous agissons avec les criminels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un criminel ? Ou est-ce que je suis parmi les justes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sunna d'Allah envers les justes est aussi constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la sunna de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'est pas criminel n'est pas concerné par cette sunna." }
  ],
  munajat: `Ya Rabb, je ne veux pas être concerné par Ta sunna envers les criminels. Donne-moi la justice. Garde-moi parmi les justes.`
};

MIROIR["37:35"] = {
  reference: "37:35",
  theme: ["unicité", "refus", "orgueil"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["At-Tawhid", "Al-Istikbar"],
  mirrorVersion: `« Quand on leur disait : 'Il n'y a de divinité qu'Allah', ils s'enorgueillissaient. » Le miroir me montre le refus de l'unicité. « Innahum kanu idha qila lahum la ilaha illa Allahi yastakbirun » — quand on leur disait : il n'y a de divinité qu'Allah, ils s'enorgueillissaient. Le refus. Le miroir m'avertit : l'orgueil empêche l'acceptation de la vérité.`,
  reflection: `L'unicité d'Allah est rejetée par orgueil. La vérité est refusée par les orgueilleux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahum kanu idha qila lahum la ilaha illa Allahi yastakbirun » — quand on leur disait : il n'y a de divinité qu'Allah, ils s'enorgueillissaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'unicité d'Allah avec humilité ? Ou est-ce que je m'enorgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité permet d'accepter la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte l'unicité de son Créateur avec soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'unicité avec humilité est guidé." }
  ],
  munajat: `Ya Wahid, j'accepte Ton unicité avec humilité. Ne permets pas que l'orgueil m'empêche de voir la vérité. Donne-moi l'humilité de la foi.`
};

MIROIR["37:36"] = {
  reference: "37:36",
  theme: ["poète", "possession", "accusation"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Ash-Sha'ir", "Al-Jinn"],
  mirrorVersion: `« Ils disaient : 'Allons-nous abandonner nos divinités pour un poète possédé ?' » Le miroir me montre l'accusation contre le Prophète. « Wa yaquluna a-inna latarikuna alihatina li-sha'irin majnun » — allons-nous abandonner nos divinités pour un poète possédé ? L'accusation. Le miroir m'enseigne : l'accusation des mécréants ne change pas la vérité.`,
  reflection: `Le Prophète est accusé d'être un poète possédé. Mais il est le Messager d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna a-inna latarikuna alihatina li-sha'irin majnun » — allons-nous abandonner nos divinités pour un poète possédé ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au Prophète ? Ou est-ce que je le considère comme les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète est le Messager d'Allah, pas un poète possédé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reconnaît le Messager d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au Prophète voit la vérité de son message." }
  ],
  munajat: `Ya Rabb, je crois en Ton Prophète. Il n'est pas un poète possédé. Il est Ton Messager. Donne-moi la foi en lui.`
};

MIROIR["37:37"] = {
  reference: "37:37",
  theme: ["vérité", "messager", "guide"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mursalin"],
  mirrorVersion: `« Il est venu avec la vérité et il a confirmé les messagers. » Le miroir me montre la véracité du Prophète. « Bal ja'a bi-al-haqqi wa saddaqa al-mursalina » — il est venu avec la vérité et il a confirmé les messagers. La vérité. Le miroir m'invite à croire en la véracité du Prophète.`,
  reflection: `Le Prophète a apporté la vérité et confirmé les messagers précédents.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal ja'a bi-al-haqqi wa saddaqa al-mursalina » — il est venu avec la vérité et il a confirmé les messagers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité du Prophète ? Ou est-ce que je la nie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité du Prophète est confirmée par tous les messagers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la vérité du Prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la vérité du Prophète a la foi complète." }
  ],
  munajat: `Ya Rabb, je reconnais la vérité de Ton Prophète. Il a confirmé les messagers. Donne-moi la foi en lui et en tous les messagers.`
};

MIROIR["37:38"] = {
  reference: "37:38",
  theme: ["châtiment", "mérite", "rétribution"],
  emotion: "Réalité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza", "Al-Kasb"],
  mirrorVersion: `« Vous allez certainement goûter au châtiment douloureux. » Le miroir me montre la certitude du châtiment. « Innakum la-dha'iqu al-'adhabi al-alim » — vous allez certainement goûter au châtiment douloureux. La certitude. Le miroir m'avertit : le châtiment est certain pour les mécréants.`,
  reflection: `Le châtiment douloureux est certain. La foi est la seule protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innakum la-dha'iqu al-'adhabi al-alim » — vous allez certainement goûter au châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vais goûter à ce châtiment ? Ou est-ce que je suis protégé par la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi protège du châtiment douloureux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne goûte pas au châtiment par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi ne goûte pas au châtiment." }
  ],
  munajat: `Ya Rabb, je ne veux pas goûter au châtiment douloureux. Protège-moi par la foi. Donne-moi la protection de la croyance.`
};

MIROIR["37:39"] = {
  reference: "37:39",
  theme: ["rétribution", "action", "justice"],
  emotion: "Justice, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza", "Al-'Amal"],
  mirrorVersion: `« Et vous ne serez rétribués que pour ce que vous faisiez. » Le miroir me montre la justice exacte. « Wa ma tujzawna illa ma kuntum ta'malun » — et vous ne serez rétribués que pour ce que vous faisiez. La justice. Le miroir m'invite à la responsabilité de mes actions.`,
  reflection: `La rétribution est exacte. Chacun reçoit selon ses actions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma tujzawna illa ma kuntum ta'malun » — et vous ne serez rétribués que pour ce que vous faisiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais ? Quel sera ma rétribution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bonnes actions mènent à la bonne rétribution." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit selon son obéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien reçoit le bien." }
  ],
  munajat: `Ya Rabb, je veux faire le bien. Donne-moi de bonnes actions pour une bonne rétribution. Ne permets pas que mes actions me condamnent.`
};

