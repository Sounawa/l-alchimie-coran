  difficulty: "débutant",
  relatedNames: ["Ath-Thikra", "Al-Ajal"],
  mirrorVersion: `« Et perpétuâmes leur souvenir parmi les générations suivantes. » Le miroir me montre l'héritage éternel. « Wa taraknaa 'alayhimaa fee al-aakhireen » — et perpétuâmes leur souvenir parmi les générations suivantes. La mémoire. Moïse et Aaron sont honorés à travers les siècles. Le miroir m'enseigne : les serviteurs d'Allah ne sont jamais oubliés.`,
  reflection: `Les serviteurs fidèles d'Allah ne sont jamais oubliés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa taraknaa 'alayhimaa fee al-aakhireen » — et perpétuâmes leur souvenir parmi les générations suivantes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel souvenir laisserai-je aux générations futures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mémoire éternelle vient de l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la mémoire de tous les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le souvenir d'Allah est plus précieux que toute renommée." }
  ],
  munajat: `Ya Rabb, perpétue mon souvenir en bien. Que les générations futures se souviennent de Ta grâce.`
};

