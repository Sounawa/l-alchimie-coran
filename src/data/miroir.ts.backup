    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accomplit ses vœux est élevé." }
  ],
  munajat: `Ya Rabb, j'accomplis mes vœux. La crainte de Ton Jour me pousse.`
};

MIROIR["76:8"] = {
