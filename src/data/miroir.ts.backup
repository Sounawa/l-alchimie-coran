    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah guérit toute maladie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend la guérison avec patience est guéri." }
  ],
  munajat: `Ya Shafi, je T'attends avec patience. Ne permets pas le désespoir. Guéris-moi et délivre-moi de mon mal.`
};

