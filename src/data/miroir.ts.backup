MIROIR["36:34"] = {
  reference: "36:34",
  theme: ["fruits", "jardins", "provision"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Fawakih"],
  mirrorVersion: `« Et Nous y avons fait pousser des jardins de palmiers et de vignes. » Le miroir me montre la provision divine. « Wa ja'alna fiha jannatin min nakhilin wa a'nab » — et Nous y avons fait pousser des jardins de palmiers et de vignes. La provision. Le miroir m'invite à la gratitude pour la provision.`,
  reflection: `Les jardins et les fruits sont des provisions d'Allah. La gratitude est la réponse appropriée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna fiha jannatin min nakhilin wa a'nab » — et Nous y avons fait pousser des jardins de palmiers et de vignes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la provision d'Allah ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision est un don qui mérite gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est pourvu par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la provision reçoit plus." }
  ],
  munajat: `Ya Razzaq, merci pour Ta provision. Je suis reconnaissant pour les jardins et les fruits. Augmente ma gratitude.`
};

MIROIR["36:35"] = {
  reference: "36:35",
  theme: ["manger", "provision", "gratitude"],
  emotion: "Gratitude, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'kil", "Ash-Shukr"],
  mirrorVersion: `« Qu'ils mangent de ses fruits ! » Le miroir me montre l'invitation à jouir. « Li-ya'kulu min thamarihi » — qu'ils mangent de ses fruits ! L'invitation. « Wa ma 'amilat-hu aydihim » — et ce que leurs mains n'ont pas fait. La grâce. Le miroir m'invite à la gratitude pour ce que nous n'avons pas créé.`,
  reflection: `Les fruits sont un don d'Allah. Nous mangeons ce que nous n'avons pas créé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-ya'kulu min thamarihi wa ma 'amilat-hu aydihim » — qu'ils mangent de ses fruits et ce que leurs mains n'ont pas fait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que ce que je mange vient d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision non méritée appelle à la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers jouit de ce qu'il n'a pas créé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour ce qu'il n'a pas créé est vraiment reconnaissant." }
  ],
  munajat: `Ya Razzaq, je mange de Tes fruits que je n'ai pas créés. Merci pour cette grâce. Donne-moi un cœur reconnaissant.`
};

MIROIR["36:37"] = {
  reference: "36:37",
  theme: ["nuit", "jour", "signe"],
  emotion: "Méditation, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "An-Nahar"],
  mirrorVersion: `« Un signe pour eux est la nuit. » Le miroir me montre le signe de la nuit. « Wa ayatun lahumu al-layl » — un signe pour eux est la nuit. Le signe visible. « Naslikhu minhu an-nahar » — Nous en dépouillons le jour. La transition. Le miroir m'invite à méditer sur l'alternance.`,
  reflection: `La transition du jour à la nuit est un signe de la puissance d'Allah sur le temps.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ayatun lahumu al-layl naslikhu minhu an-nahar » — un signe pour eux est la nuit. Nous en dépouillons le jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur le signe de la nuit ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit qui suit le jour est un rappel de la fin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers alterne entre lumière et obscurité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la nuit comprend les cycles de la vie." }
  ],
  munajat: `Ya Rabb, la nuit est Ton signe. Fais que je médite sur l'alternance. Donne-moi la sagesse des cycles.`
};

MIROIR["36:38"] = {
  reference: "36:38",
  theme: ["soleil", "course", "terme"],
  emotion: "Méditation, soumission",
  difficulty: "débutant",
  relatedNames: ["Ash-Shams", "Al-Mustaqarr"],
  mirrorVersion: `« Et le soleil court vers un lieu de repos. » Le miroir me montre la course du soleil. « Wa ash-shamsu tajri li-mustaqarrin laha » — et le soleil court vers un lieu de repos. La course déterminée. Le miroir m'invite à méditer sur l'ordre cosmique.`,
  reflection: `Le soleil suit sa course déterminée. Tout dans l'univers obéit à un ordre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ash-shamsu tajri li-mustaqarrin laha » — et le soleil court vers un lieu de repos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis ma course déterminée ? Ou est-ce que je dévie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le soleil obéit, l'homme a le choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit sa course déterminée par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit sa course déterminée comme le soleil est en harmonie avec l'univers." }
  ],
  munajat: `Ya Rabb, le soleil suit sa course. Aide-moi à suivre la mienne. Donne-moi la soumission aux ordres cosmiques.`
};

MIROIR["36:39"] = {
  reference: "36:39",
  theme: ["lune", "phases", "ordre"],
  emotion: "Méditation, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Qamar", "Al-Manazil"],
  mirrorVersion: `« Et la lune, Nous lui avons déterminé des phases. » Le miroir me montre l'ordre de la lune. « Wa al-qamara qaddarnahu manazila » — et la lune, Nous lui avons déterminé des phases. L'ordre précis. Le miroir m'invite à méditer sur les phases de la vie.`,
  reflection: `La lune passe par des phases. La vie aussi. Chaque phase a sa beauté et son but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-qamara qaddarnahu manazila » — et la lune, Nous lui avons déterminé des phases." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les phases de ma vie ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque phase a sa place dans le cycle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par phases ordonnées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les phases de la vie vit en harmonie." }
  ],
  munajat: `Ya Rabb, j'accepte les phases de ma vie comme la lune accepte les siennes. Donne-moi la patience dans chaque phase.`
};

MIROIR["36:40"] = {
  reference: "36:40",
  theme: ["soleil", "lune", "harmonie"],
  emotion: "Méditation, ordre",
  difficulty: "débutant",
  relatedNames: ["Ash-Shams", "Al-Qamar"],
  mirrorVersion: `« Le soleil ne peut rattraper la lune, ni la nuit devancer le jour. » Le miroir me montre l'harmonie cosmique. « La ash-shamsu yanbaghi laha an tundrika al-qamar » — le soleil ne peut rattraper la lune. L'harmonie. « Wa la al-laylu sabiqu an-nahar » — ni la nuit devancer le jour. L'ordre. Le miroir m'invite à respecter l'ordre établi.`,
  reflection: `L'harmonie cosmique est parfaite. Chaque élément reste à sa place.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ash-shamsu yanbaghi laha an tundrika al-qamar wa la al-laylu sabiqu an-nahar » — le soleil ne peut rattraper la lune, ni la nuit devancer le jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte l'ordre établi ? Ou est-ce que je cherche à le perturber ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'harmonie vient du respect de l'ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par l'harmonie de ses éléments." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'ordre divin vit en harmonie." }
  ],
  munajat: `Ya Rabb, je respecte Ton ordre cosmique. Aide-moi à vivre en harmonie avec Ta création. Ne permets pas que je perturbe l'ordre établi.`
};

MIROIR["36:41"] = {
  reference: "36:41",
  theme: ["descendance", "arche", "protection"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nasl", "Al-Fulk"],
  mirrorVersion: `« Un signe pour eux : Nous avons porté leur descendance dans l'arche chargée. » Le miroir me montre la protection divine. « Wa ayatun lahum anna hamalna dhurriyyatahum fi al-fulki al-mashhun » — un signe pour eux : Nous avons porté leur descendance dans l'arche chargée. La protection de Noé. Le miroir m'invite à reconnaître la protection divine.`,
  reflection: `L'arche de Noé est un signe de la protection d'Allah pour les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ayatun lahum anna hamalna dhurriyyatahum fi al-fulki al-mashhun » — un signe pour eux : Nous avons porté leur descendance dans l'arche chargée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la protection d'Allah dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est pour ceux qui croient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est protégé par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la protection d'Allah se sent en sécurité." }
  ],
  munajat: `Ya Rabb, Tu as protégé la descendance dans l'arche. Protège-moi et ma descendance. Donne-moi la confiance en Ta protection.`
};

MIROIR["36:42"] = {
  reference: "36:42",
  theme: ["embarcation", "transport", "provision"],
  emotion: "Gratitude, utilité",
  difficulty: "débutant",
  relatedNames: ["Al-Markab", "Ar-Rizq"],
  mirrorVersion: `« Et Nous avons créé pour eux des embarcations similaires sur lesquelles ils montent. » Le miroir me montre la provision continue. « Wa khalaqna lahum min mithlihi ma yarkabun » — et Nous avons créé pour eux des embarcations similaires sur lesquelles ils montent. La provision moderne. Le miroir m'invite à la gratitude pour les moyens de transport.`,
  reflection: `Les embarcations modernes sont aussi des provisions d'Allah. La gratitude s'étend à tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa khalaqna lahum min mithlihi ma yarkabun » — et Nous avons créé pour eux des embarcations similaires sur lesquelles ils montent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les moyens de transport ? Ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque moyen de transport est un don d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est pourvu de moyens de transport." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour les moyens de transport reconnaît la provision continue." }
  ],
  munajat: `Ya Razzaq, merci pour les embarcations et les transports. Je suis reconnaissant pour chaque moyen que Tu m'as donné. Continue Ta provision.`
};

MIROIR["36:43"] = {
  reference: "36:43",
  theme: ["noyade", "secours", "impuissance"],
  emotion: "Crainte, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Gharq", "Al-Najat"],
  mirrorVersion: `« Si Nous voulions, Nous les noyerions. » Le miroir me montre la possibilité du châtiment. « Wa nasha'u nughriqhum » — si Nous voulions, Nous les noyerions. La possibilité. « Fala sarikha lahum » — et ils n'auraient personne pour les secourir. L'impuissance. Le miroir m'avertit : le secours ne vient que d'Allah.`,
  reflection: `Le châtiment est possible à tout moment. Le secours ne vient que d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nasha'u nughriqhum fala sarikha lahum » — si Nous voulions, Nous les noyerions. Et ils n'auraient personne pour les secourir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur le secours d'Allah ? Ou est-ce que je cherche le secours ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secours d'Allah est le seul vrai secours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers dépend du secours de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur le secours d'Allah est protégé." }
  ],
  munajat: `Ya Rabb, je compte sur Ton secours. Ne permets pas que je sois noyé sans secours. Donne-moi la confiance en Toi seul.`
};

MIROIR["36:44"] = {
  reference: "36:44",
  theme: ["miséricorde", "jouissance", "temporaire"],
  emotion: "Gratitude, vigilance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahma", "Al-Mata"],
  mirrorVersion: `« Sauf par une miséricorde de Notre part, et pour une jouissance temporaire. » Le miroir me montre la nature de la vie. « Illa rahmatan minna wa mata'an ila hin » — sauf par une miséricorde de Notre part, et pour une jouissance temporaire. La vie est miséricorde et temporaire. Le miroir m'invite à la gratitude pour le temporaire.`,
  reflection: `La vie est une miséricorde temporaire. La gratitude et la préparation pour l'éternel sont nécessaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa rahmatan minna wa mata'an ila hin » — sauf par une miséricorde de Notre part, et pour une jouissance temporaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience que la vie est temporaire ? Ou est-ce que je m'y attache comme si elle était éternelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temporaire prépare à l'éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une jouissance temporaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le temporaire se prépare pour l'éternel." }
  ],
  munajat: `Ya Rahman, merci pour la miséricorde temporaire de la vie. Aide-moi à me préparer pour l'éternel. Ne permets pas que je m'attache au temporaire.`
};

MIROIR["36:45"] = {
  reference: "36:45",
  theme: ["avertissement", "distraction", "insouciance"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Ghaflah"],
  mirrorVersion: `« Et quand on leur dit : 'Craignez ce qui est devant vous et ce qui est derrière vous.' » Le miroir me montre l'avertissement complet. « Wa idha qila lahumu ittaqu ma bayna aydikum wa ma khalfakum » — et quand on leur dit : craignez ce qui est devant vous et ce qui est derrière vous. L'avertissement total. Le miroir m'invite à la crainte complète.`,
  reflection: `L'avertissement inclut le passé et le futur. La crainte doit être totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahumu ittaqu ma bayna aydikum wa ma khalfakum » — et quand on leur dit : craignez ce qui est devant vous et ce qui est derrière vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce qui est devant et derrière moi ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte complète protège de tout danger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers craint son Créateur dans toutes les directions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint totalement est totalement protégé." }
  ],
  munajat: `Ya Rabb, je crains ce qui est devant et derrière moi. Protège-moi de tous les côtés. Ne permets pas que l'insouciance m'atteigne.`
};

MIROIR["36:46"] = {
  reference: "36:46",
  theme: ["signe", "distraction", "rejet"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ayah", "Al-Tawalla"],
  mirrorVersion: `« Il ne leur vient aucun signe des signes de leur Seigneur sans qu'ils ne s'en détournent. » Le miroir me montre le rejet constant. « Wa ma ta'tihim min ayatin min ayati rabbihim illa kanu 'anha mu'ridin » — il ne leur vient aucun signe sans qu'ils ne s'en détournent. Le rejet systématique. Le miroir m'avertit : le rejet des signes est une maladie du cœur.`,
  reflection: `Les signes d'Allah sont partout. Les rejeter est un aveuglement volontaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ta'tihim min ayatin min ayati rabbihim illa kanu 'anha mu'ridin » — il ne leur vient aucun signe des signes de leur Seigneur sans qu'ils ne s'en détournent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me détourne des signes d'Allah ? Ou est-ce que je les accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accueil des signes ouvre le cœur à la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accueille les signes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille les signes reçoit la guidance." }
  ],
  munajat: `Ya Rabb, j'accueille Tes signes. Ne permets pas que je m'en détourne. Ouvre mon cœur à la guidance par les signes.`
};

// ==================== SURAH 74: AL-MUDDATHTHIR - MISSING VERSES ====================

MIROIR["74:2"] = {
  reference: "74:2",
  theme: ["mission", "avertissement", "prophète"],
  emotion: "Responsabilité, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Nadhir", "Al-Mursal"],
  mirrorVersion: `« Lève-toi et avertis. » L'ordre est direct et pressant. Le miroir m'invite à me lever pour la mission. L'avertissement est un acte d'amour — on avertit ceux qu'on ne veut pas voir perdre.`,
  reflection: `L'avertissement est un acte de miséricorde. Se lever pour la mission est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qum fa-andhir » — lève-toi et avertis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me lève pour la vérité ? Est-ce que j'avertis avec amour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement sauve. Le silence condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création avertit par ses signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avertit par amour participe à la miséricorde." }
  ],
  munajat: `Ya Rabb, aide-moi à me lever pour la vérité. Fais que j'avertisse avec Ton amour.`
};

MIROIR["74:3"] = {
  reference: "74:3",
  theme: ["purification", "Seigneur", "adoration"],
  emotion: "Révérence, consécration",
  difficulty: "débutant",
  relatedNames: ["Al-Quddus", "Al-Rabb"],
  mirrorVersion: `« Et ton Seigneur, glorifie-Le. » La glorification du Seigneur. Le miroir m'invite à élever le nom d'Allah. La mission commence par la glorification de Celui qui envoie.`,
  reflection: `La mission commence par la glorification du Seigneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rabbaka fakabbir » — et ton Seigneur, glorifie-Le." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie mon Seigneur ? Mon cœur est-il dans la louange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification élève l'être. L'oubli l'abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier glorifie son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie vraiment reçoit la grandeur." }
  ],
  munajat: `Ya Rabb, je Te glorifie. Élève-moi par Ta glorification.`
};

MIROIR["74:4"] = {
  reference: "74:4",
  theme: ["purification", "vêtements", "spiritualité"],
  emotion: "Pureté, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Tahir", "Al-Mutahhir"],
  mirrorVersion: `« Et tes vêtements, purifie-les. » La purification des vêtements. Le miroir m'enseigne : l'extérieur reflète l'intérieur. Les vêtements purs symbolisent le cœur pur. La préparation spirituelle passe par la purification matérielle.`,
  reflection: `La purification extérieure reflète la purification intérieure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa thiyabaka fatahhir » — et tes vêtements, purifie-les." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je purifie mon extérieur et mon intérieur ? La pureté est-elle ma préparation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté extérieure aide à la pureté intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création aime la pureté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se purifie reçoit la lumière." }
  ],
  munajat: `Ya Tahir, purifie mes vêtements et mon cœur. Fais que la pureté soit ma préparation.`
};

MIROIR["74:5"] = {
  reference: "74:5",
  theme: ["détachement", "impureté", "spiritualité"],
  emotion: "Libération, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Mutahhir", "Al-Quddus"],
  mirrorVersion: `« Et l'impureté, éloigne-t'en. » Le rejet de l'impureté. Le miroir m'invite au détachement de ce qui souille. L'impureté n'est pas seulement matérielle — elle est aussi spirituelle.`,
  reflection: `L'éloignement de l'impureté est une libération.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-rujza fahjur » — et l'impureté, éloigne-t'en." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui souille ma vie ? Est-ce que je m'en éloigne vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement de l'impureté rapproche de la pureté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création rejette naturellement ce qui la souille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejette l'impureté trouve la pureté." }
  ],
  munajat: `Ya Mutahhir, aide-moi à rejeter l'impureté. Rapproche-moi de la pureté.`
};

MIROIR["74:6"] = {
  reference: "74:6",
  theme: ["générosité", "attente", "désintéressement"],
  emotion: "Liberté, désintéressement",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mannan"],
  mirrorVersion: `« Et ne fais pas de faveur en recherchant un retour plus important. » Le don désintéressé. Le miroir m'enseigne : la vraie générosité n'attend rien en retour. Le don avec attente n'est pas un don — c'est un échange.`,
  reflection: `Le don désintéressé est le vrai don. L'attente corrompt la générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tamnun tastakthir » — ne fais pas de faveur en recherchant un retour plus important." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je donne ? Est-ce que j'attends quelque chose en retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don pur attire la bénédiction divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création donne sans attendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sans attente reçoit d'Allah." }
  ],
  munajat: `Ya Karim, apprends-moi à donner sans attente. Fais que ma générosité soit pure.`
};

MIROIR["74:7"] = {
  reference: "74:7",
  theme: ["patience", "endurance", "attente"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Sabur", "Al-Wa'id"],
  mirrorVersion: `« Et pour ton Seigneur, sois patient. » La patience pour Allah. Le miroir m'enseigne : la patience n'est pas passive — elle est active, orientée vers le Seigneur. Tout ce qui arrive est dans Sa main.`,
  reflection: `La patience pour le Seigneur est une adoration. Elle transforme l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-rabbika fasbir » — et pour ton Seigneur, sois patient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis patient pour Allah ? Mon endurance est-elle orientée vers Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience pour Allah élève. L'impatience abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création patiente naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente pour Allah reçoit Sa compagnie." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience pour Toi. Transforme mon épreuve en élévation.`
};

MIROIR["74:8"] = {
  reference: "74:8",
  theme: ["cor", "jour", "avertissement"],
  emotion: "Tremblement, urgence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nafir", "Al-Sa'ah"],
  mirrorVersion: `« Puis quand le cor sera soufflé. » Le son de la fin. Le miroir me projette vers ce moment ultime. Le cor sonne, tout s'arrête. Être prêt signifie vivre chaque jour comme le dernier.`,
  reflection: `Le cor sonnera. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha nufikha fi al-sur » — puis quand le cor sera soufflé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour le cor ? Mon cœur est-il préparé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le cor commence maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend le son final." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque jour comme le dernier est prêt." }
  ],
  munajat: `Ya Rabb, aide-moi à être prêt pour le cor. Fais que je vive chaque jour pour Toi.`
};

MIROIR["74:9"] = {
  reference: "74:9",
  theme: ["jour", "difficile", "mécréants"],
  emotion: "Gravité, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qari'ah", "Al-Sa'ah"],
  mirrorVersion: `« Ce jour-là sera un jour difficile. » La difficulté du Jour. Le miroir m'avertit : ce Jour n'est pas facile. Les mécréants souffriront particulièrement. La préparation est la seule protection.`,
  reflection: `Le Jour sera difficile pour les non-préparés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fadhalika yawma'idhin yawmun 'asir » — ce jour-là sera un jour difficile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la difficulté de ce Jour ? Ma préparation est-elle sérieuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation allège la difficulté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour sera difficile pour les cieux et la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare trouve la facilité dans la difficulté." }
  ],
  munajat: `Ya Rabb, aide-moi à me préparer pour ce Jour difficile. Fais que je sois parmi les préparés.`
};

MIROIR["74:10"] = {
  reference: "74:10",
  theme: ["jour", "mécréants", "facilité"],
  emotion: "Contraste, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sahlah", "Al-Sa'ah"],
  mirrorVersion: `« Pour les mécréants, non facile. » Le contraste est frappant. Le miroir m'enseigne : le même Jour sera facile pour les croyants et difficile pour les mécréants. La foi fait la différence.`,
  reflection: `La foi transforme la difficulté en facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala al-kafirina ghayru yasir » — pour les mécréants, non facile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est vraie ? Le Jour sera-t-il facile pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est la clé de la facilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi aligne avec le flow divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment trouve la facilité." }
  ],
  munajat: `Ya Rabb, renforce ma foi. Fais que le Jour soit facile pour moi.`
};

MIROIR["74:11"] = {
  reference: "74:11",
  theme: ["création", "rétribution", "solo"],
  emotion: "Confrontation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hasib"],
  mirrorVersion: `« Laisse-Moi avec celui que J'ai créé seul. » La confrontation directe. Le miroir m'avertit : chaque créature sera seule face à son Créateur. Les liens terrestres se rompront, le compte sera individuel.`,
  reflection: `Le compte est individuel. La confrontation est inévitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dharni man khalaqtu wahida » — laisse-Moi avec celui que J'ai créé seul." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour la confrontation ? Mon compte est-il prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confrontation est une miséricorde pour le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature rencontrera son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour la rencontre la accueille avec joie." }
  ],
  munajat: `Ya Rabb, prépare-moi pour la confrontation. Fais que je Te rencontre avec confiance.`
};

MIROIR["74:12"] = {
  reference: "74:12",
  theme: ["richesse", "bénédictions", "ingratitude"],
  emotion: "Rappel, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Mannan"],
  mirrorVersion: `« Et à qui J'ai donné de vastes richesses. » Le rappel des bénédictions. Le miroir m'interroge : que fais-je des richesses qu'Allah m'a données ? La reconnaissance est due.`,
  reflection: `Les richesses sont un don. La reconnaissance est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'altu lahu malan mamduda » — et à qui J'ai donné de vastes richesses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que fais-je de mes richesses ? Suis-je reconnaissant ou ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance multiplie. L'ingratitude annihile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce que nous avons vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le don reçoit plus." }
  ],
  munajat: `Ya Mannan, merci pour Tes richesses. Aide-moi à les utiliser pour Toi.`
};

MIROIR["74:13"] = {
  reference: "74:13",
  theme: ["enfants", "bénédictions", "responsabilité"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Razzaq"],
  mirrorVersion: `« Et des enfants présents. » Les enfants sont une bénédiction. Le miroir m'enseigne : les enfants sont un don d'Allah. Ils sont aussi une responsabilité. La gratitude et l'éducation sont dues.`,
  reflection: `Les enfants sont un don. La gratitude et l'éducation sont des devoirs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa banina shuhuda » — et des enfants présents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour mes enfants ? Est-ce que je les élève pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les enfants sont un test et une bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La progéniture est un don divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui élève ses enfants pour Allah reçoit sa récompense." }
  ],
  munajat: `Ya Wahhab, merci pour mes enfants. Aide-moi à les élever pour Toi.`
};

MIROIR["74:14"] = {
  reference: "74:14",
  theme: ["facilité", "bénédictions", "ingratitude"],
  emotion: "Rappel, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Muyassir", "Al-Mannan"],
  mirrorVersion: `« Et J'ai facilité pour lui toutes choses. » La facilité accordée. Le miroir m'interroge : est-ce que je reconnais la facilité dans ma vie ? L'ingratitude transforme la facilité en difficulté.`,
  reflection: `La facilité est un don. La reconnaissance la préserve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa makkaktu lahu tamshila » — et J'ai facilité pour lui toutes choses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la facilité dans ma vie ? Suis-je reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance facilite. L'ingratitude complique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La facilité dans la vie est un signe de miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la facilité reçoit plus de facilité." }
  ],
  munajat: `Ya Muyassir, merci pour la facilité. Aide-moi à être reconnaissant.`
};

MIROIR["74:15"] = {
  reference: "74:15",
  theme: ["ingratitude", "désir", "avarice"],
  emotion: "Avertissement, constatation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shakur", "Al-Ghani"],
  mirrorVersion: `« Et il désire que Je lui donne encore plus. » L'ingratitude combinée à l'avarice. Le miroir m'avertit : recevoir sans reconnaître mène à exiger plus. L'insatisfaction est le fruit de l'ingratitude.`,
  reflection: `L'ingratitude mène à l'insatisfaction. La reconnaissance mène à la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yatlu 'ani azida » — puis il désire que Je lui donne encore plus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis satisfait ? Ou est-ce que je demande toujours plus sans reconnaître ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction vient de la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est satisfaite de sa part." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant trouve la satisfaction." }
  ],
  munajat: `Ya Shakur, apprends-moi la reconnaissance. Fais que je sois satisfait de ce que Tu donnes.`
};

MIROIR["74:16"] = {
  reference: "74:16",
  theme: ["ingratitude", "déni", "châtiment"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jazaa", "Al-Hasib"],
  mirrorVersion: `« Non ! Il est obstiné dans Nos signes. » L'obstination dans le déni. Le miroir m'avertit : l'ingratitude ouvre la porte au déni. Les signes sont rejetés par celui qui n'est pas reconnaissant.`,
  reflection: `L'ingratitude mène au déni. La reconnaissance ouvre les yeux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla innahu kana li-ayatina 'aniya » — non ! Il est obstiné contre Nos signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis obstiné contre les signes ? Ou est-ce que je les reconnais avec gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance ouvre les yeux. Le déni les ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont partout pour ceux qui voient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes reçoit la guidance." }
  ],
  munajat: `Ya Rabb, ouvre mes yeux aux signes. Fais que je sois reconnaissant et non obstiné.`
};

MIROIR["74:17"] = {
  reference: "74:17",
  theme: ["châtiment", "difficulté", "montée"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shadid", "Al-Muntaqim"],
  mirrorVersion: `« Je vais le contraindre à une montée difficile. » Le châtiment de l'ingratitude. Le miroir m'avertit : l'ingratitude mène à la difficulté. La montée difficile est le chemin de celui qui a refusé la facilité.`,
  reflection: `L'ingratitude mène à la difficulté. La reconnaissance mène à la facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa-asru'u ila sa'ud » — Je vais le contraindre à une montée difficile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis la facilité de la reconnaissance ? Ou la difficulté de l'ingratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance est la montée facile. L'ingratitude est la montée difficile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La difficulté suit le refus de la facilité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît monte facilement." }
  ],
  munajat: `Ya Rabb, je choisis la reconnaissance. Fais que ma montée soit facile.`
};

MIROIR["74:18"] = {
  reference: "74:18",
  theme: ["réflexion", "décision", "calcul"],
  emotion: "Introspection, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hasib", "Al-Alim"],
  mirrorVersion: `« Il a réfléchi et décidé. » L'homme réfléchit et décide. Le miroir m'interroge : à quoi je réfléchis ? Quelle décision je prends ? La réflexion mène à la décision, la décision mène au destin.`,
  reflection: `La réflexion mène à la décision. La décision détermine le destin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu fakkara wa qaddara » — il a réfléchi et décidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je réfléchis ? Quelle décision je prends pour mon destin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réflexion sur Allah mène à la bonne décision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute décision a des conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réfléchit bien décide bien." }
  ],
  munajat: `Ya Rabb, aide-moi à réfléchir sur Toi. Fais que ma décision soit bonne.`
};

MIROIR["74:19"] = {
  reference: "74:19",
  theme: ["mort", "décision", "destin"],
  emotion: "Gravité, finalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Qadir"],
  mirrorVersion: `« Qu'il périsse ! Comme il a décidé. » La conséquence de la mauvaise décision. Le miroir m'avertit : la mauvaise décision mène à la perte. La réflexion et la décision doivent être alignées avec la vérité.`,
  reflection: `La mauvaise décision mène à la perte. La bonne décision mène au salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qutila kayfa qaddara » — qu'il périsse ! Comme il a décidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma décision est bonne ? Ou est-ce que je risque la perte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne décision sauve. La mauvaise condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La décision a des conséquences éternelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui décide bien se sauve." }
  ],
  munajat: `Ya Rabb, préserve-moi de la mauvaise décision. Guide-moi vers la bonne voie.`
};

MIROIR["74:20"] = {
  reference: "74:20",
  theme: ["mort", "décision", "répétition"],
  emotion: "Gravité, insistance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Hakam"],
  mirrorVersion: `« Qu'il périsse ! Comme il a décidé. » La répétition souligne la gravité. Le miroir insiste : la mauvaise décision est mortelle. La répétition divine appelle à la prise de conscience.`,
  reflection: `La répétition souligne la gravité. La prise de conscience est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma qutila kayfa qaddara » — puis qu'il périsse ! Comme il a décidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends l'avertissement répété ? Ma décision est-elle bonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition est une miséricorde pour éveiller." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gravité mérite la répétition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend la répétition se réveille." }
  ],
  munajat: `Ya Rabb, j'entends l'avertissement. Réveille-moi avant qu'il ne soit trop tard.`
};

MIROIR["74:21"] = {
  reference: "74:21",
  theme: ["réflexion", "vision", "compréhension"],
  emotion: "Introspection, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Alim"],
  mirrorVersion: `« Puis il a regardé. » Le regard suit la décision. Le miroir m'interroge : que regarde-je ? Le regard révèle l'orientation. Regarder vers Allah ou regarder ailleurs.`,
  reflection: `Le regard révèle l'orientation. Regarder vers Allah est la bonne direction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nazara » — puis il a regardé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon regard ? Vers Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regard vers Allah éclaire. Le regard ailleurs obscurcit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La direction du regard détermine la direction du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regarde vers Allah Le trouve." }
  ],
  munajat: `Ya Basir, tourne mon regard vers Toi. Fais que je Te voie partout.`
};

MIROIR["74:22"] = {
  reference: "74:22",
  theme: ["expression", "mépris", "orgueil"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mutakabbir", "Al-Rafi'"],
  mirrorVersion: `« Puis il a froncé les sourcils et s'est renfrogné. » L'expression du mépris. Le miroir m'avertit : le front froncé est le signe du rejet. L'orgueil se manifeste dans l'expression.`,
  reflection: `Le front froncé révèle le rejet. L'ouverture révèle l'acceptation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma abasa wa basara » — puis il a froncé les sourcils et s'est renfrogné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon expression face à la vérité ? Ouverte ou renfrognée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture du visage reflète l'ouverture du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'expression révèle l'état intérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a le cœur ouvert a le visage ouvert." }
  ],
  munajat: `Ya Rabb, ouvre mon visage et mon cœur. Fais que j'accepte la vérité avec sérénité.`
};

MIROIR["74:23"] = {
  reference: "74:23",
  theme: ["orgueil", "rejet", "tourner le dos"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Puis il a tourné le dos et s'est enflé d'orgueil. » Le rejet total. Le miroir m'avertit : tourner le dos et s'enfler d'orgueil est le comble du rejet. L'orgueil est l'opposé de la soumission.`,
  reflection: `L'orgueil est le rejet de la soumission. L'humilité est l'acceptation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma tawalla wastakbara » — puis il a tourné le dos et s'est enflé d'orgueil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tourne le dos à la vérité ? Mon orgueil me ferme-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité ouvre. L'orgueil ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil est la maladie des mécréants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie devant Allah est élevé." }
  ],
  munajat: `Ya Rabb, guéris-moi de l'orgueil. Fais que je m'humilie devant Toi.`
};

MIROIR["74:24"] = {
  reference: "74:24",
  theme: ["Coran", "mensonge", "rejet"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Sidq"],
  mirrorVersion: `« Et il a dit : Ce n'est que magie apprise ! » Le rejet du Coran comme magie. Le miroir m'avertit : rejeter la vérité en l'appelant mensonge est le comble de l'égarement.`,
  reflection: `Rejeter la vérité est le comble de l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala in hada illa sihrun yu'thar » — et il a dit : ce n'est que magie apprise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la vérité ? Ou est-ce que je la rejette avec des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accepter la vérité sauve. La rejeter perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste la vérité même si on la rejette." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité reçoit la lumière." }
  ],
  munajat: `Ya Haqq, j'accepte Ta vérité. Ne permets pas que je la rejette.`
};

MIROIR["74:25"] = {
  reference: "74:25",
  theme: ["Coran", "mensonge", "humain"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahy", "Al-Haqq"],
  mirrorVersion: `« Ce n'est que parole d'un humain ! » Le rejet du Coran comme parole humaine. Le miroir m'avertit : nier l'origine divine du Coran est un rejet majeur. La parole d'Allah est évidente pour les cœurs purs.`,
  reflection: `Le Coran est la parole d'Allah. Le nier est un rejet majeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In hada illa qawlu al-bashar » — ce n'est que parole d'un humain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que le Coran est la parole d'Allah ? Ma foi est-elle ferme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en la parole d'Allah sauve. Le rejet perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le miracle éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la parole d'Allah reçoit la guidance." }
  ],
  munajat: `Ya Rabb, je crois en Ton Coran. Renforce ma foi en Ta parole.`
};

MIROIR["74:26"] = {
  reference: "74:26",
  theme: ["enfer", "châtiment", "brûlure"],
  emotion: "Avertissement, horreur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Saqar", "Al-Jahim"],
  mirrorVersion: `« Je vais le brûler dans le Feu. » La menace directe. Le miroir m'avertit : le châtiment du Feu est réel. La parole d'Allah est sérieuse. La préparation est urgente.`,
  reflection: `Le Feu est réel. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa-aslihi saqar » — Je vais le brûler dans le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le Feu ? Ma préparation est-elle sérieuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du Feu pousse à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Feu attend les négateurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le Feu s'en protège." }
  ],
  munajat: `Ya Rabb, préserve-moi du Feu. Aide-moi à me préparer sérieusement.`
};

MIROIR["74:27"] = {
  reference: "74:27",
  theme: ["enfer", "question", "réalité"],
  emotion: "Questionnement, horreur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Saqar", "Al-Jahim"],
  mirrorVersion: `« Et qu'est-ce qui te fera savoir ce qu'est le Feu ? » La question souligne l'horreur. Le miroir m'invite à réaliser : le Feu est au-delà de notre imagination. Les mots ne suffisent pas.`,
  reflection: `Le Feu est au-delà de l'imagination. La réalisation pousse à la préparation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma al-saqar » — et qu'est-ce qui te fera savoir ce qu'est le Feu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise l'horreur du Feu ? Mon imagination est-elle éveillée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question éveille l'imagination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Feu est une création terrifiante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise l'horreur s'en protège." }
  ],
  munajat: `Ya Rabb, fais que je réalise l'horreur du Feu. Aide-moi à m'en protéger.`
};

MIROIR["74:28"] = {
  reference: "74:28",
  theme: ["enfer", "destruction", "permanence"],
  emotion: "Horreur, éternité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Saqar", "Al-Baqi"],
  mirrorVersion: `« Il ne laisse rien et n'épargne rien. » Le Feu détruit tout. Le miroir m'enseigne : le Feu ne fait pas de quartier. Il consume tout, il épargne rien.`,
  reflection: `Le Feu ne fait pas de quartier. La protection est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tubqi wa la tadar » — il ne laisse rien et n'épargne rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la totalité de la destruction du Feu ? La protection est-elle ma priorité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection du Feu est la priorité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Feu est la création de destruction totale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se protège du Feu échappe à sa destruction." }
  ],
  munajat: `Ya Rabb, protège-moi du Feu. Ne permets pas que je sois consumé.`
};

MIROIR["74:29"] = {
  reference: "74:29",
  theme: ["enfer", "brûlure", "visible"],
  emotion: "Horreur, visibilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Saqar", "Al-Muhit"],
  mirrorVersion: `« Brûlant la peau et la rendant visible. » Le Feu brûle jusqu'à l'os. Le miroir m'enseigne : le châtiment est visible, la souffrance est totale. La peau qui brûle révèle l'intérieur.`,
  reflection: `Le châtiment est total et visible. La protection est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawwahatun lil-bashar » — brûlant la peau et la rendant visible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la totalité de la brûlure ? La protection est-elle ma priorité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La brûlure visible rappelle la souffrance totale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Feu est créé pour brûler totalement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la brûlure s'en protège." }
  ],
  munajat: `Ya Rabb, protège-moi de la brûlure du Feu. Préserve ma peau et mon âme.`
};

MIROIR["74:30"] = {
  reference: "74:30",
  theme: ["enfer", "nombre", "anges"],
  emotion: "Horreur, précision",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Saqar", "Al-Mala'ika"],
  mirrorVersion: `« Sur lui, dix-neuf. » Le nombre précis des gardiens. Le miroir m'enseigne : l'enfer a une structure précise. Les anges gardiens sont au nombre de dix-neuf. La précision divine est totale.`,
  reflection: `L'enfer a une structure précise. La précision divine est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alayha tis'ata 'ashar » — sur lui, dix-neuf." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la précision de l'enfer ? La structure divine est-elle évidente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La précision révèle l'ordre divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans la création a un ordre précis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'ordre craint le désordre." }
  ],
  munajat: `Ya Rabb, je reconnais Ta précision. Aide-moi à respecter Ton ordre.`
};

MIROIR["74:31"] = {
  reference: "74:31",
  theme: ["enfer", "anges", "épreuve"],
  emotion: "Avertissement, mise en garde",
  difficulty: "avancé",
  relatedNames: ["Al-Mala'ika", "Al-Mubtala"],
  mirrorVersion: `« Nous n'avons assigné comme gardiens du Feu que des anges, et Nous n'en avons fixé le nombre que pour éprouver les mécréants. » Le nombre est une épreuve. Le miroir m'enseigne : même les détails du châtiment sont une épreuve pour la foi.`,
  reflection: `Les détails de l'enfer sont une épreuve. La foi est testée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma ja'alna ash-haba al-nari illa al-mala'ikata wa ma ja'alna 'iddatahum illa fitnatan lilladhina kafaru » — Nous n'avons assigné comme gardiens du Feu que des anges, et Nous n'en avons fixé le nombre que pour éprouver les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi résiste aux épreuves ? Les détails sont-ils une pierre d'achoppement ou une confirmation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve élève les croyants et abaisse les mécréants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est épreuve pour la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe l'épreuve reçoit la certitude." }
  ],
  munajat: `Ya Rabb, aide-moi à passer les épreuves. Renforce ma foi dans les détails.`
};

MIROIR["74:32"] = {
  reference: "74:32",
  theme: ["lune", "serment", "création"],
  emotion: "Sérénité, majesté",
  difficulty: "débutant",
  relatedNames: ["Al-Qamar", "Al-Khaliq"],
  mirrorVersion: `« Non, par la lune ! » Le serment par la lune. Le miroir m'enseigne : la création témoigne. La lune, symbole de beauté et de cycles, est appelée à témoin.`,
  reflection: `La création témoigne de son Créateur. La lune est un témoin majestueux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla wa al-qamar » — non, par la lune !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la lune comme témoin du Créateur ? La création me parle-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création témoigne. L'homme doit écouter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lune est un signe parmi les signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute la création entend le Créateur." }
  ],
  munajat: `Ya Khaliq, la lune témoigne de Toi. Ouvre mes yeux aux signes.`
};

MIROIR["74:33"] = {
  reference: "74:33",
  theme: ["nuit", "serment", "création"],
  emotion: "Paix, majesté",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Khaliq"],
  mirrorVersion: `« Et par la nuit quand elle se retire. » Le serment par la nuit. Le miroir m'enseigne : la nuit qui se retire est un signe. L'alternance du jour et de la nuit témoigne de la création.`,
  reflection: `L'alternance jour/nuit témoigne de la création divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-layli idh adbar » — et par la nuit quand elle se retire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur l'alternance jour/nuit ? La création me parle-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit qui se retire annonce le jour qui vient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle jour/nuit est un signe divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les cycles trouve la sagesse." }
  ],
  munajat: `Ya Khaliq, la nuit témoigne de Toi. Fais que je médite sur Tes signes.`
};

MIROIR["74:34"] = {
  reference: "74:34",
  theme: ["aube", "serment", "création"],
  emotion: "Espoir, majesté",
  difficulty: "débutant",
  relatedNames: ["Al-Subh", "Al-Khaliq"],
  mirrorVersion: `« Et par l'aube quand elle se lève. » Le serment par l'aube. Le miroir m'enseigne : l'aube qui se lève est un signe. La lumière qui chasse les ténèbres témoigne de la miséricorde.`,
  reflection: `L'aube qui se lève témoigne de la miséricorde divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-subhi idha asfar » — et par l'aube quand elle se lève." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur l'aube ? La lumière qui chasse les ténèbres me parle-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aube annonce la lumière après les ténèbres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube est un signe de miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend l'aube trouve la lumière." }
  ],
  munajat: `Ya Khaliq, l'aube témoigne de Toi. Fais que Ta lumière chasse mes ténèbres.`
};

MIROIR["74:35"] = {
  reference: "74:35",
  theme: ["enfer", "grandeur", "avertissement"],
  emotion: "Gravité, majesté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Saqar", "Al-Kabir"],
  mirrorVersion: `« C'est l'un des plus grands signes. » L'enfer est un grand signe. Le miroir m'enseigne : l'enfer n'est pas petit. Il est parmi les plus grandes créations d'Allah. Sa grandeur appelle à la crainte.`,
  reflection: `L'enfer est un grand signe. La crainte est appropriée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaha ihda al-kuba » — c'est l'un des plus grands signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur de l'enfer ? La crainte est-elle présente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur de l'enfer appelle à la grandeur de la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les grands signes d'Allah méritent la méditation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la grandeur se prépare grandement." }
  ],
  munajat: `Ya Rabb, je reconnais la grandeur de Tes signes. Aide-moi à me préparer sérieusement.`
};

MIROIR["74:36"] = {
  reference: "74:36",
  theme: ["avertissement", "humanité", "miséricorde"],
  emotion: "Urgence, sollicitude",
  difficulty: "débutant",
  relatedNames: ["Al-Nadhir", "Al-Rahman"],
  mirrorVersion: `« Un avertissement pour les humains. » L'avertissement est universel. Le miroir m'enseigne : personne n'est exclu. L'avertissement est une miséricorde pour tous.`,
  reflection: `L'avertissement est universel. C'est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nadhiran lil-bashar » — un avertissement pour les humains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends l'avertissement ? Est-ce que je le transmets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde pour celui qui l'écoute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est pour tous les humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement se sauve." }
  ],
  munajat: `Ya Rabb, j'entends l'avertissement. Fais que je le transmette à mon tour.`
};

MIROIR["74:37"] = {
  reference: "74:37",
  theme: ["choix", "avancement", "recul"],
  emotion: "Urgence, décision",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabiq", "Al-Mu'akhkhir"],
  mirrorVersion: `« Pour celui d'entre vous qui veut avancer ou reculer. » Le choix est offert. Le miroir m'invite à décider : avancer vers Allah ou reculer. Le mouvement est individuel.`,
  reflection: `Le choix est individuel. Avancer ou reculer, c'est mon choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Liman sha'a minkum an yataqaddama aw yata'akhara » — pour celui d'entre vous qui veut avancer ou reculer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'avance ou est-ce que je recule ? Mon mouvement est-il vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avancement est la voie. Le recul est la perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mouvement vers Allah est le mouvement naturel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avance vraiment trouve la proximité." }
  ],
  munajat: `Ya Rabb, je veux avancer vers Toi. Ne permets pas que je recule.`
};
