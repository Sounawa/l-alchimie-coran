    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la domination d'Allah est humble." }
  ],
  munajat: `Ya Malik, la domination des cieux et de la terre T'appartient. Je la reconnais. Donne-moi l'humilité de la reconnaissance.`
};

MIROIR["38:11"] = {
