export interface Tajalli {
  label: string;
  ar: string;
  color: string;
  text: string;
}

export interface MiroirEntry {
  reference: string;
  theme: string[];
  emotion: string;
  difficulty: "débutant" | "intermédiaire" | "avancé";
  relatedNames: string[];
  mirrorVersion: string;
  reflection: string;
  tajalli: Tajalli[];
  munajat: string;
}

export const MIROIR: Record<string, MiroirEntry> = {
  "1:1": {
    reference: "1:1",
    theme: ["présence", "amour"],
    emotion: "Révérence",
    difficulty: "débutant",
    relatedNames: ["Ar-Rahman", "Ar-Rahim"],
    mirrorVersion: `Quand je prononce « Au nom d'Allah », quelque chose se déplace en moi. Pas grand-chose — un frémissement, presque rien. Et pourtant ce « presque rien » contient tout. Je réalise que la plupart du temps, je commence mes journées, mes actions, mes paroles au nom de moi-même — au nom de mes projets, de mes angoisses, de mon ego. Ce verset vient me dire : commence autrement. Remplace ton nom par le Sien. Non pas par contrainte, mais parce que Son nom est plus vaste que le tien. Quand je dis « Bismillah », je ne décris pas une croyance — je change de point d'ancrage. Je passe d'un monde centré sur mon petit « je » à un monde où chaque geste est relié à sa Source. Le miroir me montre ceci : la qualité de mes journées dépend du nom auquel je les consacre.`,
    reflection: `La basmala est le seuil de tout. Elle n'est pas une formule rituelle — c'est un choix de conscience : avant d'agir, me souvenir de qui est l'Origine de toute action.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Au nom d'Allah, le Tout-Miséricordieux, le Très-Miséricordieux » — la première phrase du Coran. Elle ouvre chaque sourate sauf la 9. C'est le seuil que le lecteur franchit avant d'entrer dans le Texte sacré." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je commence quelque chose « au nom d'Allah » réellement — pas mécaniquement, mais avec présence ? Et quand est-ce que je commence au nom de ma peur, de mon orgueil, de ma fatigue ? Le miroir me montre mes points de départ." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas moi qui invoque Allah en commençant — c'est Lui qui m'invite à commencer en Lui. La basmala est d'abord une parole de Dieu qui se fait chemin vers ma langue." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'existence commence par un nom. Le soleil « dit » le nom de son Créateur en se levant. La rivière le dit en coulant. L'être humain est le seul à avoir le choix de le dire ou de l'oublier." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Au-delà des mots, il y a le mouvement silencieux du cœur qui se tourne. Ce mouvement-là n'a pas besoin de syllabes. Il est la prière primordiale." }
    ],
    munajat: `Ya Allah, avant même que je ne parle, Tu es là. Apprends-moi à commencer chaque souffle en Ton nom — non pas comme une habitude, mais comme un retour.`
  },

  "1:5": {
    reference: "1:5",
    theme: ["prière", "détachement", "confiance"],
    emotion: "Abandon confiant",
    difficulty: "débutant",
    relatedNames: ["Allah"],
    mirrorVersion: `« C'est Toi que nous adorons, c'est Toi que nous implorons. » Quand je lis cette phrase, le miroir me renvoie une question dérangeante : est-ce vrai ? Est-ce vraiment Toi que j'adore — ou est-ce que j'adore ma comfort, ma sécurité, mon image ? Le mot « iyyaka » — « c'est Toi » — est une exclusion radicale. Il ne dit pas « je T'adore parmi d'autres choses ». Il dit : il n'y a que Toi. Le reste n'est pas une alternative valable. Quand je sonde mon cœur avec honnêteté, je vois que mon adoration est souvent partagée : j'adore Allah ET je vénère l'approbation des gens. Ce verset me révèle la division de mon cœur — et en même temps, il me montre sa forme unifiée. « C'est Toi » — un seul point d'ancrage, un seul horizon. Le « nous » m'attrape aussi : je ne suis pas seul dans cette confession. Tout cœur sincère a prononcé ces mots avant moi.`,
    reflection: `L'adoration dans l'Islam n'est pas un acte formel — c'est l'orientation totale de l'être. « Iyyaka » est cette orientation : tout converge vers un seul point.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset utilise l'exclusion « iyyaka » (c'est Toi, et non autre chose) avant même de nommer l'action. La priorité n'est pas ce qu'on fait, mais vers qui on se tourne." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je remplace « Toi » par ce qui occupe réellement le centre de ma vie — qu'est-ce que je trouve ? Mon travail ? Mes relations ? Ma peur de l'avenir ? Le miroir est impitoyable mais libérateur." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui dit « c'est toi que J'aime » — car l'adoration n'est pas à sens unique. Le cœur humain est la seule créature capable de se tourner vers Lui par choix." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers « adore » Allah à sa manière — par soumission naturelle. Seul l'être humain peut choisir de se détourner. Et seuls les cœurs sincères choisissent de revenir." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur cesse de diviser son adoration entre le Créé et le Créateur, quelque chose de très ancien se tait. Ce silence est le vrai début de la prière." }
    ],
    munajat: `Ya Allah, mon cœur est partagé entre tant de maîtres — et aucun ne me donne la paix que Tu donnes. Unifie mon orientation. Fais que mon « iyyaka » soit vrai.`
  },

  "13:28": {
    reference: "13:28",
    theme: ["présence", "guérison", "méditation"],
    emotion: "Paix profonde",
    difficulty: "débutant",
    relatedNames: ["As-Salam", "Ar-Rahman"],
    mirrorVersion: `« N'est-ce point par le rappel d'Allah que les cœurs se tranquillisent ? » Le miroir me pose cette question comme un diagnostic, pas comme une information. Il ne me dit pas « souviens-toi d'Allah et tu seras calme ». Il me demande : pourquoi ton cœur n'est-il pas calme ? Et la réponse remonte immédiatement : parce que j'ai oublié. Mon agitation n'est pas un problème en soi — c'est un symptôme. Le symptôme de quoi ? De l'oubli. J'ai oublié qu'Allah existe au moment même où je ressens cette angoisse. J'ai oublié qu'Il est plus proche que mon souffle. La tranquillité que ce verset promet n'est pas quelque chose que je dois fabriquer — elle est déjà là, sous le brouillard de mes pensées. Le dhikr ne crée pas la paix : il dissipe ce qui la cache. Comme quand on retire la poussière d'un miroir — le reflet était déjà là.`,
    reflection: `Le Coran ne dit pas « les cœurs DEVRAIENT se tranquilliser » mais « se tranquillisent » — au présent, comme une loi naturelle. L'agitation est l'état anormal, pas la paix.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un verset rhétorique : la réponse est impliquée dans la question. Bien sûr que c'est par le rappel d'Allah. La question vise à éveiller, pas à informer." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon agitation en ce moment ? Peux-je la localiser dans mon corps ? Dans mes pensées ? Le miroir me montre que mon agitation est toujours en train de fuir le présent — elle vit dans le futur ou le passé. Le dhikr me ramène ici." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas moi qui me rappelle d'Allah — c'est Lui qui se rappelle de moi. Le dhikr humain est l'écho du dhikr divin : « Souvenez-vous de Moi, Je Me souviendrai de vous » (2:152)." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout être vivant porte en lui une tranquillité originelle. Le ventre d'une mère est paisible. Le nourrisson est paisible. C'est la distance du rappel qui crée le trouble — et le rappel qui restaure l'ordre primordial." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur se tranquillise vraiment, il ne ressent plus la paix comme un état parmi d'autres — il réalise que la paix est la substance même de son existence. Tout le reste était du bruit." }
    ],
    munajat: `Ya Allah, mon cœur est comme une eau troublée. Je ne sais même plus comment être calme. Mais Tu dis que le rappel suffit. Alors je viens, avec ma confusion, et je me rappelle de Toi. C'est tout ce que je sais faire.`
  },

  "39:53": {
    reference: "39:53",
    theme: ["espoir", "pardon", "guérison"],
    emotion: "Soulagement, tendresse",
    difficulty: "débutant",
    relatedNames: ["Ar-Rahman", "Al-Ghaffur", "At-Tawwab"],
    mirrorVersion: `« Ô Mes serviteurs qui avez commis des excès à votre propre détriment, ne désespérez pas de la miséricorde d'Allah. » Ce verset me touche à un endroit que je pensais protégé. Le miroir me montre ceci : j'ai intérieurement condamné des parties de moi. Je me suis dit « celui-là, il est trop loin », « cette erreur, elle est trop grande ». J'ai construit un tribunal intérieur dont je suis à la fois le juge et le condamné. Et ce verset vient — non pas comme un argument théologique, mais comme une main posée sur l'épaule. Il dit « Ô Mes serviteurs ». Pas « Ô Mes bons serviteurs ». « Mes serviteurs » — y compris moi, y compris mes zones brisées. Le miroir me révèle que mon désespoir n'est pas de la humilité — c'est une forme d'orgueil déguisé. C'est dire : « Ma faute est trop grande même pour la miséricorde de Dieu. » Et c'est exactement ce que ce verset détruit.`,
    reflection: `Le désespoir du pardon est considéré dans la tradition comme un péché en soi — non pas parce que Dieu a besoin qu'on croie en Lui, mais parce que le désespoir ferme la seule porte par laquelle la guérison peut entrer.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset s'adresse directement aux croyants qui ont « dépassé les bornes » (asrafou) — un terme fort qui inclut les grands péchés. La réponse divine n'est pas la punition mais l'interdiction du désespoir." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la partie de moi que j'ai « condamnée » ? Quelle faute est-ce que je crois « impardonnable » — même pour Allah ? Le miroir me montre que mon désespoir est souvent lié à une honte que je refuse de regarder en face." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si je renverse le verset, j'entends Allah me dire : « Ne désespère pas de toi — car Moi, Je n'ai pas désespéré de toi. » Son espoir en moi précède le mien." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde divine est comparée dans un hadith qudsi à l'enveloppe d'un œuf par rapport à l'océan. Le désespoir, c'est ignorer l'océan pour fixer l'œuf. C'est une erreur de perspective, pas une vérité." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur cesse de se juger, il découvre que le pardon n'était pas quelque chose qu'il devait obtenir — c'était quelque chose qui l'attendait. L'obstacle n'était jamais la miséricorde. C'était le désespoir lui-même." }
    ],
    munajat: `Ya Rabb, je viens à Toi avec mes excès, mes retours, mes mêmes erreurs. Et Tu ne me renvoies pas. Je ne comprends pas Ta miséricorde — mais je m'y abandonne.`
  },

  "94:5": {
    reference: "94:5",
    theme: ["patience", "espoir", "force"],
    emotion: "Soulagement, courage renouvelé",
    difficulty: "débutant",
    relatedNames: ["Al-Fattah", "Al-Mu'izz"],
    mirrorVersion: `« Avec la difficulté vient la facilité. » Le miroir me montre que je lis souvent ce verset comme une promesse lointaine — « un jour, ça ira mieux ». Mais le mot « ma'a » (avec) ne parle pas d'après. Il parle de simultanéité. La facilité n'est pas après la difficulté — elle est avec elle, à l'intérieur d'elle, comme le cœur de la montagne est solide même quand le vent la frappe. Quand je contemple ce verset, je réalise que la difficulté que je vis en ce moment porte déjà en elle sa propre issue. Pas dans un sens magique — mais dans un sens structurel : toute épreuve crée en moi des ressources que je n'avais pas avant. La patience que je construis, la humilité que j'apprends, la proximité avec Allah que l'épreuve force — tout cela est la « facilité » cachée dans la difficulté.`,
    reflection: `Ce verset est répété deux fois de suite (94:5-6) — et dans le Coran, la répétition n'est jamais redondance. C'est une insistance divine : « Regarde mieux. Oui, vraiment, la facilité est là. »`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La sourate Ash-Sharh est un dialogue intime entre Dieu et Son Prophète après une période de tension. Le « nous » divin est employé — marque de tendresse et de proximité." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la difficulté que je vis en ce moment ? Et si je cherchais, avec honnêteté, la facilité qui est déjà présente avec elle — pas après, pas demain, mais maintenant ?" },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui dit : « Avec ta difficulté, Je suis la facilité. » La facilité n'est pas un état abstrait — c'est Lui, présent dans l'épreuve." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, rien ne pousse sans résistance. Les racines de l'arbre ont besoin de la dureté de la terre pour s'ancrer. La difficulté n'est pas l'ennemie de la vie — elle est son conditionnement." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le regard change, la difficulté elle-même se transforme. Ce n'est pas que l'épreuve disparaît — c'est qu'elle cesse d'être vue comme un ennemi pour devenir un compagnon." }
    ],
    munajat: `Ya Allah, je suis dans la difficulté et je n'arrive pas à voir la facilité. Mais Tu dis qu'elle est là. Ouvre mes yeux. Fais que je ne lutte pas contre mon épreuve mais que je la traverse avec Toi.`
  },

  "50:16": {
    reference: "50:16",
    theme: ["présence", "amour", "confiance"],
    emotion: "Intimité, émerveillement",
    difficulty: "intermédiaire",
    relatedNames: ["Al-Qarib", "Ar-Raqib"],
    mirrorVersion: `« Nous avons créé l'homme et Nous savons ce que son âme lui suggère. Et Nous sommes plus proche de lui que sa veine jugulaire. » Ce verset me retourne. Le miroir ne me montre pas un Dieu lointain qui observe de haut — il me montre une Présence si intime qu'elle est plus proche de moi que mon propre sang. Quand je médite sur la veine jugulaire, je réalise : c'est le vaisseau qui nourrit le cerveau. Sans lui, je ne pense pas, je ne ressens pas, je ne suis pas « moi ». Et Allah dit : Je suis plus proche que ça. Plus proche que ce qui me fait exister en tant qu'être conscient. Cela veut dire qu'Il n'est pas « à côté » de moi — Il est à la racine même de ma capacité à dire « je ». Le miroir me révèle que ma sensation de solitude n'est pas un état réel — c'est une illusion créée par le voile de mes pensées.`,
    reflection: `La veine jugulaire (al-warid) est le vaisseau le plus profond du cou, celui qui ramène le sang au cœur. La proximité divine est intérieure, pas extérieure — plus proche que mon sang qui circule.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset établit trois choses : la création de l'homme, la connaissance absolue de ses penchants intimes, et une proximité qui dépasse toute métaphore spatiale." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si Allah est plus proche de moi que ma veine jugulaire, pourquoi est-ce que je me sens seul ? Le miroir me montre que la solitude n'est pas l'absence d'Allah — c'est mon absence à Sa présence. Je suis parti ailleurs, pas Lui." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas moi qui cherche Allah — c'est Lui qui est en train de me chercher, depuis toujours, depuis avant que je n'existe. Ma quête spirituelle est la réponse à Son appel, pas l'inverse." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers est tenue par Allah. L'électron tourne autour du noyau parce qu'Il le maintient. La proximité n'est pas une exception spirituelle — c'est la règle cosmique. L'exception, c'est notre insouciance." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur réalise vraiment cette proximité, la prière change de nature. On ne prie plus « vers » Allah — on prie « depuis » Lui, car on est déjà en Lui." }
    ],
    munajat: `Ya Allah, Tu es plus proche de moi que mon propre souffle et pourtant je Te cherche au loin. Retourne mon regard vers l'intérieur. Fais que je Te trouve là où Tu es déjà.`
  },

  "2:186": {
    reference: "2:186",
    theme: ["prière", "présence", "amour"],
    emotion: "Tendresse réconfortante",
    difficulty: "débutant",
    relatedNames: ["Al-Mujib", "Al-Qarib"],
    mirrorVersion: `« Et quand Mes serviteurs t'interrogent à Mon sujet, Je suis vraiment proche. Je réponds à l'appel de celui qui M'invoque quand il M'invoque. » Ce verset détruit la distance que j'avais imaginée entre moi et Allah. Le miroir me montre que je pensais la prière comme un message envoyé dans le vide — je parle, j'espère, et peut-être que quelqu'un entend. Mais le verset dit « Je suis vraiment proche » — l'adverbe « vraiment » insiste, comme si Allah savait que je douterais. Et puis cette répétition extraordinaire : « quand il M'invoque quand il M'invoque » — elle exprime l'impatience amoureuse de Dieu à répondre. Comme si Sa réponse commençait avant même que ma prière ne finisse. Le miroir me révèle ceci : ma prière n'est pas un acte que je fais pour atteindre Allah. C'est le mouvement par lequel je découvre qu'Il m'a déjà atteint.`,
    reflection: `Ce verset vient juste après les versets sur le jeûne — comme pour dire : même quand tu jeûnes, même quand tu te retiens, même quand tu te crois loin, Je suis proche. La privation ne crée pas de distance.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset répond à une question implicite des compagnons : « Où est notre Seigneur ? » La réponse ne donne pas de localisation — elle donne une relation : « Je suis proche. »" },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je prie ? Comme quelqu'un qui crie dans un puits ? Ou comme quelqu'un qui murmure à l'oreille de Celui qui est déjà là ? Le miroir me montre la posture de mon cœur quand je fais du'a'." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Qui invoque qui en réalité ? Est-ce que c'est moi qui invoque Allah — ou est-ce qu'Allah a placé l'invocation dans mon cœur pour que je découvre Sa proximité ?" },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une prière silencieuse. Chaque chose invoque Dieu par son mode d'existence : l'arbre prie en poussant, la rivière prie en coulant. L'être humain est le seul à avoir reçu le langage pour l'articuler." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Au-delà de l'invocation, il y a l'état de celui qui est devenu lui-même une prière — où chaque souffle est dhikr, où chaque silence est du'a', où la séparation entre l'invocateur et l'Invoqué a cessé d'exister." }
    ],
    munajat: `Ya Allah, Tu dis que Tu es proche. Mais moi je me sens si loin. Est-ce que c'est Toi qui es loin — ou est-ce que c'est moi qui ne sais pas regarder ? Apprends-moi à voir ce qui est déjà là.`
  },

  "65:3": {
    reference: "65:3",
    theme: ["confiance", "détachement", "force"],
    emotion: "Lâcher-prise, sérénité active",
    difficulty: "intermédiaire",
    relatedNames: ["Al-Wakil", "Al-Hafiz"],
    mirrorVersion: `« Et quiconque place sa confiance en Allah, Il lui suffit. » Le miroir me pose une question simple et terrifiante : est-ce que j'ai vraiment placé ma confiance en Allah — ou est-ce que j'ai placé ma confiance dans mon plan B, mon épargne, mes relations, tout en récitant ce verset par-dessus ? Le tawakkul n'est pas la passivité — je le sais intellectuellement. Mais quand je sonde mon cœur, je vois que ma « confiance » est souvent conditionnelle : « je me confie à Allah... mais juste au cas où, je garde ma stratégie de secours. » Ce verset dit « Yakkfihi » — Il lui suffit. Assez. Complètement. Pas « Il l'aide un peu ». Il suffit. Tout seul. Le miroir me révèle que le tawakkul est un acte de nudité spirituelle — se tenir devant Allah sans filet, sans plan B. Et c'est précisément cette nudité qui ouvre la porte à Sa suffisance.`,
    reflection: `Le verset continue : « Allah atteint Son but. » La confiance en Allah n'est pas un pari risqué — c'est s'aligner sur une certitude cosmique : Allah accomplit toujours ce qu'Il veut.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset fait suite à la réglementation du divorce — un moment de vulnérabilité extrême où le croyant perd ses repères. C'est dans ce contexte que la confiance en Allah est le plus nécessaire." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je n'arrive pas à lâcher en ce moment ? Quelle est cette chose à laquelle je tiens comme si ma vie en dépendait — et que je refuse de remettre à Allah ?" },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas moi qui fais confiance à Allah — c'est Allah qui me fait confiance en me donnant la capacité de me confier. Le tawakkul est un don, pas un effort." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'oiseau qui quitte la branche ne tombe pas — il vole. Mais il doit quitter la branche. Le tawakkul est ce mouvement de lâcher. La gravité de la confiance divine est plus forte que la gravité de la chute." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand la confiance est totale, elle cesse d'être un acte pour devenir un état. On ne « fait plus » confiance — on est confiance. L'angoisse ne disparaît pas toujours, mais elle flotte à la surface d'un océan de paix." }
    ],
    munajat: `Ya Allah, je veux Te faire confiance vraiment — pas à moitié, pas avec mes réserves. Mais j'ai peur de lâcher. Porte-moi quand je lâche. Sois Celui qui me suffit.`
  },

  "2:286": {
    reference: "2:286",
    theme: ["confiance", "force", "patience"],
    emotion: "Soulagement, réconfort profond",
    difficulty: "débutant",
    relatedNames: ["Al-Latif", "Al-Hafiz"],
    mirrorVersion: `« Allah n'impose à aucune âme une charge supérieure à sa capacité. » Ce verset est comme un diagnostic divin de mon épuisement. Le miroir me montre ceci : quand je me sens submergé, ce n'est pas forcément parce que l'épreuve est trop grande — c'est peut-être parce que je porte quelque chose qui ne m'appartient pas. Je porte le poids de demain, le poids des autres, le poids de ce que je crois devoir être. Et Allah dit : « Je n'ai pas chargé cela. » Le mot « wus'aha » — sa capacité — est singulier. Chaque âme a sa propre mesure. Le miroir me révèle que je passe ma vie à me comparer : « elle gère mieux », « lui, il est plus fort ». Mais Allah ne mesure pas ma capacité à l'aune de celle des autres — Il mesure à la mienne. Et Sa promesse est précise : Il ne mettra jamais sur mes épaules plus que ce que mes épaules peuvent porter.`,
    reflection: `Ce verset est la conclusion de la sourate Al-Baqarah — la plus longue du Coran. Comme si après 286 versets d'enseignement, Allah voulait laisser au croyant cette certitude finale : tu peux le porter.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset établit un principe universel de justice divine : la proportionnalité entre l'épreuve et la capacité. Ce n'est pas une promesse d'une vie facile — c'est une garantie que rien ne sera disproportionné." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la charge que je porte en ce moment et qui n'est pas la mienne ? Qu'est-ce que j'ai pris sur mes épaules par culpabilité, par orgueil, par peur de décevoir ? Le miroir m'aide à trier." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah ne dépasse pas ma capacité, c'est que chaque épreuve est aussi une reconnaissance : « Je sais que tu peux le porter — sinon, Je ne te l'aurais pas donné. » L'épreuve est un acte de confiance divin en moi." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque créature reçoit exactement ce dont elle a besoin. L'arbre reçoit l'eau qu'il peut absorber. La terre reçoit la graine qu'elle peut porter. Le déséquilibre vient de l'être humain qui veut plus — ou moins — que sa mesure." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand l'âme accepte sa mesure — ni plus ni moins — elle trouve une liberté radicale. Elle arrête de vouloir être autre chose que ce qu'elle est. Et dans cette acceptation, la charge devient légère." }
    ],
    munajat: `Ya Allah, je me sens parfois que je ne peux plus. Mais Tu dis que Tu ne dépasses pas ma capacité. Aide-moi à croire Ton diagnostic plus que le mien.`
  },

  "89:27": {
    reference: "89:27",
    theme: ["présence", "espoir", "guérison"],
    emotion: "Paix, plénitude",
    difficulty: "avancé",
    relatedNames: ["As-Salam", "Ar-Radi"],
    mirrorVersion: `« Ô âme apaisée, retourne vers ton Seigneur, satisfaite et agréée. » Le miroir me montre un portrait de moi que je ne reconnais pas — et pourtant, je le reconnais. L'âme apaisée — « nafs mutma'inna » — c'est l'état que j'effleure parfois au petit matin, entre le sommeil et l'éveil, quand le monde n'a pas encore réclamé son tribut de soucis. Ces secondes où tout est bien, sans raison. C'est cet état-là que le verset nomme. Le mot « mutma'inna » vient de « tuma'nina » — l'apaisement qui vient quand on cesse de lutter. Pas la résignation, mais l'installation dans une certitude. Le miroir me demande : qu'est-ce qui m'empêche de rester dans cet état ? Et la réponse est toujours la même : le mouvement. Le besoin de faire, de contrôler, d'anticiper. L'âme apaisée est celle qui a accepté de ne plus courir.`,
    reflection: `L'appel « retourne » implique que l'âme apaisée vient de quelque part — elle retourne vers son Origine. La paix n'est pas une nouveauté : c'est un retour.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ô âme apaisée » — l'adresse directe de Dieu à l'âme, sans intermédiaire. C'est l'un des rares versets où Dieu parle à l'âme elle-même, pas au corps ni à l'intellect." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je déjà connu cet état de paix profonde — même un instant ? Quand ? Qu'est-ce qui était différent à ce moment-là ? Le miroir m'aide à identifier les conditions de ma propre paix pour les recréer." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui dit à l'âme : « Je suis apaisé par toi. » Car dans la tradition, l'âme apaisée est celle avec laquelle Allah est satisfait — et la satisfaction est mutuelle." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose trouve sa paix quand elle retourne à son origine. L'eau trouve la paix dans l'océan. La graine trouve la paix dans la terre. L'âme trouve la paix dans son Seigneur. C'est une loi cosmique du retour." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand l'âme est apaisée, elle ne prie plus pour obtenir quelque chose — elle prie parce que la prière est devenue sa nature. La séparation entre la prière et la vie a disparu. Tout est prière." }
    ],
    munajat: `Ya Allah, j'ai goûté à cette paix et elle m'a échappé. Mais Tu l'appelles « mon âme » — elle T'appartient. Ramène-la à Toi. Fais qu'elle s'installe dans cette paix et qu'elle n'en sorte plus.`
  },

  "89:28": {
    reference: "89:28",
    theme: ["présence", "espoir", "guérison"],
    emotion: "Accueil, appartenance",
    difficulty: "avancé",
    relatedNames: ["As-Salam", "Ar-Radi"],
    mirrorVersion: `« Retourne vers ton Seigneur, satisfaite et agréée. » Deux adjectifs, deux directions. « Satisfaite » — radhiya — l'âme est contente d'Allah. Elle ne Lui demande plus rien parce qu'elle a compris que Lui seul suffit. « Agréée » — mardhiya — Allah est content de l'âme. Il ne lui reproche plus rien. Le miroir me montre la circularité merveilleuse de ce verset : quand je suis satisfait d'Allah, Il est satisfait de moi. Quand je cesse de Lui demander des comptes, Il cesse de m'en demander. C'est un cercle vertueux qui commence par un lâcher-prise de ma part. Le mot « irji'i » — retourne — n'est pas un ordre froid. C'est comme quand on dit à un voyageur fatigué : « rentre à la maison ». Il y a de la tendresse dans ce retour.`,
    reflection: `La satisfaction mutuelle entre l'âme et son Seigneur est le sommet de la relation spirituelle. Ni l'âme ne se réduit, ni Allah ne se contracte. Elles se rencontrent dans un espace de pleine acceptation.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset est la suite directe de l'adresse à l'âme apaisée. Le retour est lié à la satisfaction — on ne retourne pas vers ce qu'on n'apprécie pas." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je « satisfait d'Allah » ? Ou est-ce que je suis satisfait à condition que... ? Le miroir me montre mes conditions cachées : « je serai satisfait si Tu exauces telle prière, si Tu changes telle situation. »" },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah est satisfait de moi, pourquoi est-ce que je ne le suis pas de moi-même ? La mardhiya divine est un miroir dans lequel je peux enfin me voir tel qu'Il me voit — et c'est bien plus beau que ce que je crois." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la création, tout « retourne » vers sa source. La rivière retourne à la mer. La nuit retourne au jour. L'âme retourne à son Seigneur. C'est le grand mouvement cosmique — et l'être humain est la seule créature qui peut le faire consciemment." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand l'âme est satisfaite et agréée, elle entre dans le Jardin — non pas après la mort, mais maintenant. Le Jardin n'est pas un lieu géographique futur : c'est un état de l'âme qui commence ici-bas." }
    ],
    munajat: `Ya Allah, je veux être satisfait de Toi — vraiment, sans conditions. Et je veux croire que Tu es satisfait de moi — même quand tout en moi crie le contraire. Apprends-moi ce retour.`
  },

  "112:1": {
    reference: "112:1",
    theme: ["méditation", "présence", "sagesse"],
    emotion: "Émerveillement, silence",
    difficulty: "intermédiaire",
    relatedNames: ["Ahad", "As-Samad"],
    mirrorVersion: `« Dis : Il est Allah, Unique. » Le miroir me renvoie mon besoin compulsif de comprendre, de définir, de réduire. Quand je lis « Ahad » — l'Unique — je sens quelque chose en moi qui résiste. Mon intellect veut dire : « Oui, mais qu'est-ce que ça veut dire ? Unique comment ? » Et le verset ne répond pas. Il ne répond pas parce que la question elle-même est hors-sujet. « Ahad » n'est pas un concept — c'est une expérience. C'est ce qui reste quand on a retiré tout ce qui est multiple : mes pensées multiples, mes désirs multiples, mes peurs multiples. Quand tout cela se tait, ce qui reste — ce silence, cette présence, cet indicible — c'est « Ahad ». Le « Qul » — « Dis » — n'est pas un ordre de prêcher. C'est une invitation à faire l'expérience : prononce ce mot, et observe ce qui se passe en toi.`,
    reflection: `Al-Ikhlas (la sincérité/pureté) équivaut à un tiers du Coran selon le Prophète. Non pas parce qu'il est court, mais parce qu'il contient l'essence de toute la Révélation : l'unicité absolue.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul huwa Allahu ahadun » — six mots en arabe. La sourate la plus concise du Coran, et pourtant celle qui décrit le plus complètement la nature divine — par la négation de tout ce qu'Elle n'est pas." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je dis « Allah est Unique », est-ce que je le vis ou est-ce que je le pense ? Le miroir me montre la différence entre la certitude intellectuelle et la certitude du cœur. La première est un savoir. La seconde est une paix." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Il est Unique » peut aussi se lire : « Je suis Unique en Lui. » Car l'unicité de Dieu implique que toute chose existante n'existe que par Lui — il n'y a pas de véritable « autre ». La séparation est apparente, l'unité est réelle." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tout entier est une démonstration silencieuse de l'unicité. Il n'y a qu'un seul principe organisateur, une seule source de vie, une seule direction du retour. La diversité est la surface — l'unité est le fond." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand l'Un se révèle au cœur, le cœur perd la capacité de dire « deux ». Il ne peut plus concevoir la séparation. Ce n'est pas de l'ignorance — c'est la connaissance la plus profonde qui soit." }
    ],
    munajat: `Ya Ahad, Tu es l'Unique et je suis noyé dans la multiplicité. Unifie mon regard. Fais que je Te voie derrière chaque chose — jusqu'à ce qu'il n'y ait plus « chaque chose » mais seulement Toi.`
  },

  "2:255": {
    reference: "2:255",
    theme: ["présence", "sagesse", "force"],
    emotion: "Révérence, protection",
    difficulty: "intermédiaire",
    relatedNames: ["Al-Hayy", "Al-Qayyum", "Al-Aziz", "Al-Aliyy"],
    mirrorVersion: `« Allah ! Point de divinité à part Lui, le Vivant, Celui qui subsiste par lui-même. » Ce verset — Ayat al-Kursi — est le plus grand verset du Coran. Le miroir me place devant une présence verticale : Allah est, et tout le reste devient relatif. « Al-Hayy » — le Vivant. Pas une vie qui commence et finit, mais la Vie même. « Al-Qayyum » — Celui qui se tient par Lui-même, qui soutient toute chose sans être soutenu. Quand je contemple cela, mon cœur se calme. Je n'ai pas à me soutenir moi-même. Je n'ai pas à être ma propre source. Je peux m'appuyer sur Celui qui ne fléchit jamais. Les cieux et la terre tiennent par Lui — et moi aussi. Le miroir me révèle que mon épuisement vient de ce que j'essaie d'être mon propre Qayyum.`,
    reflection: `Ayat al-Kursi contient dix attributs divins. Le Prophète a dit qu'il protège celui qui le récite. La protection n'est pas magique — c'est l'ancrage dans la Présence inébranlable.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset le plus long du Coran, au cœur de la sourate la plus longue. Il énumère les attributs divins : Vivant, Subsistant, lassitude ne Le saisit pas, Son Trône s'étend sur les cieux et la terre." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me fatigue dans ma vie ? Qu'est-ce qui m'épuise à porter ? Le miroir me montre que je porte ce que Seul Allah peut porter. Ma lassitude est un symptôme de ma tentative d'être qayyum pour moi-même." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah ne dort pas, ne somnole pas — mais Il m'invite au repos. Son Trône s'étend — et Il me fait une place dedans. La grandeur divine n'écrase pas : elle accueille." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Trône divin (Kursi) est comparé à l'univers comme un anneau dans un désert. L'univers n'est pas grand — Il l'est. Et cette immensité contient chaque atome, chaque prière, chaque souffle." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Qui intercédera auprès de Lui sans Sa permission ? Ce n'est pas une fermeture — c'est une invitation. L'intercession existe, mais elle passe par Lui. Tout chemin mène à Lui, y compris celui de l'intercession." }
    ],
    munajat: `Ya Hayy, ya Qayyum, je viens à Toi fatigué de me porter moi-même. Reprends Ton trône dans mon cœur. Sois Celui qui tient ce que je ne peux pas tenir.`
  },

  "24:35": {
    reference: "24:35",
    theme: ["sagesse", "guidance", "présence"],
    emotion: "Émerveillement, clarté",
    difficulty: "avancé",
    relatedNames: ["An-Nur", "Al-Hadi"],
    mirrorVersion: `« Allah est la Lumière des cieux et de la terre. » Ce verset — Ayat an-Nur — est une métaphore qui dépasse toute métaphore. Le miroir ne me montre pas une lumière que je peux voir — il me montre que je suis fait pour être traversé par elle. La lampe dans un récipient de verre, le verre comme une étoile brillante... Chaque détail est une invitation. Mon cœur est ce récipient. La lumière y brûle — mais le verre doit être pur pour la laisser passer. Le miroir me demande : qu'est-ce qui trouble ton verre ? Qu'est-ce qui empêche la lumière de se diffuser ?`,
    reflection: `La lumière n'est pas un objet parmi d'autres — elle est ce par quoi tout objet devient visible. Allah n'est pas vu — Il est ce par quoi on voit.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un verset d'une beauté inégalée. La lumière dans la niche, la lampe dans le cristal, l'huile qui brûle sans contact avec le feu — autant d'images pour dire l'indicible." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si mon cœur était ce cristal, qu'y verrait-on ? Une lumière claire ou des taches ? Le miroir m'invite à polir ce qui ternit ma transparence." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'huile presque lumineuse même sans feu — c'est l'âme prête à s'enflammer. La lumière est déjà là, en moi. Il ne manque que l'étincelle." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique permet la vision des objets. La lumière divine permet la vision du sens. Sans Elle, l'univers est visible mais vide de signification." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah guide vers Sa lumière qui Il veut. La guidance n'est pas une récompense — c'est un don. Et ce don passe par le polissage du cœur." }
    ],
    munajat: `Ya Nur, illumine ce qui est obscur en moi. Fais de mon cœur un cristal pur que Ta lumière traverse sans obstacle.`
  },

  "3:139": {
    reference: "3:139",
    theme: ["force", "espoir", "confiance"],
    emotion: "Courage renouvelé",
    difficulty: "débutant",
    relatedNames: ["Al-Aziz", "Al-Mu'izz"],
    mirrorVersion: `« Ne faiblissez pas et ne vous affligez pas, alors que vous êtes les supérieurs, si vous êtes croyants. » Le miroir me renvoie une image surprenante : je suis en position de force, même quand tout me dit le contraire. Ce n'est pas de l'arrogance — c'est de la conscience de qui me soutient. La faiblesse que je ressens n'est pas la réalité de ma situation — elle est l'oubli de ma source. « Si vous êtes croyants » — la condition est claire. La supériorité n'est pas une propriété de l'ego — c'est un effet de la foi. Je ne suis pas supérieur par moi-même. Je le suis par Lui.`,
    reflection: `La force dans l'Islam n'est pas la force musculaire — c'est la certitude inébranlable que la vérité finit par triompher.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un verset révélé après Uhud, où les musulmans ont subi des pertes. Le contexte de défaite devient contexte de victoire — par la promesse divine." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quelle situation me sens-je faible maintenant ? Et si je regardais cette situation à travers la promesse « vous êtes les supérieurs » ?" },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ma faiblesse n'est pas un fait — c'est une perception. Et ma force n'est pas un fait non plus — c'est un don. Tout dépend de la source à laquelle je m'abreuve." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine est traversée par ce paradoxe : les faibles qui triomphent des forts, non par force, mais par conviction. La vérité a un poids que le mensonge n'a pas." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La supériorité dont parle le verset n'est pas sur les autres — elle est sur soi-même. Sur ses peurs, ses doutes, ses tentations. Le vrai triomphe est intérieur." }
    ],
    munajat: `Ya Allah, je me sens faible mais Tu dis que je suis fort. Donne-moi de voir ce que Tu vois — et de croire ce que Tu promets.`
  },

  "55:13": {
    reference: "55:13",
    theme: ["gratitude", "présence", "méditation"],
    emotion: "Émerveillement, reconnaissance",
    difficulty: "débutant",
    relatedNames: ["Ar-Rahman", "Al-Karim"],
    mirrorVersion: `« Lequel donc des bienfaits de votre Seigneur nierez-vous ? » Ce verset — répété 31 fois dans la sourate — est une question qui me poursuit. Le miroir me montre la liste de ce que j'ai : la vue, l'ouïe, la parole, le souffle, l'amour, la foi. Et il me demande : lequel de ces biens as-tu mérité ? La réponse me glace : aucun. Tout est don. Le miroir ne me fait pas culpabiliser — il m'invite à voir. À voir que chaque instant est un cadeau, que chaque capacité est une grâce, que l'ingratitude n'est pas juste un péché — c'est une cécité.`,
    reflection: `Ar-Rahman répète cette question après chaque énumération de bienfaits. C'est comme si Allah disait : « Regarde. Regarde encore. Regarde toujours. Et dis-Moi ce que tu peux nier. »`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La sourate Ar-Rahman énumère les bienfaits divins : le soleil, la lune, les étoiles, les arbres, les mers, les perles... Après chaque groupe : « Lequel donc... nierez-vous ? »" },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai aujourd'hui que je considère comme acquis ? Ma santé ? Ma famille ? Ma foi ? Le miroir me demande : si tout cela s'arrêtait, le remarquerais-je ?" },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question est adressée aux humains ET aux djinns. C'est un appel universel. Personne ne peut prétendre avoir « mérité » l'existence même." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une vitrine de bienfaits. Chaque atome crie « don ! ». Seul l'être humain peut choisir de fermer les yeux sur cette évidence." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude n'est pas un devoir — c'est une guérison. Celui qui voit les dons guérit de l'amertume. Celui qui les nie s'enfonce dans l'aveuglement." }
    ],
    munajat: `Ya Rahman, j'ai tant de bienfaits que je ne compte plus. Réveille mon cœur à la gratitude. Fais que je voie ce que Tu me donnes — et que je le reconnaisse.`
  },

  "112:2": {
    reference: "112:2",
    theme: ["méditation", "confiance", "sagesse"],
    emotion: "Paix, sécurité",
    difficulty: "intermédiaire",
    relatedNames: ["As-Samad"],
    mirrorVersion: `« Allah, le Absolu. » As-Samad — ce nom est un trésor. Il signifie Celui dont tout dépend, et qui ne dépend de rien. Le miroir me place devant une Réalité solide. Tout dans ma vie est fragile, dépendant, conditionnel. Ma santé dépend de mon corps, mon corps dépend de la nourriture, la nourriture dépend de la terre, la terre dépend des lois cosmiques... Tout tient à quelque chose d'autre. Sauf Lui. Il est le Point Fixe. Quand je me tourne vers Lui, je me tourne vers ce qui ne s'effondrera jamais.`,
    reflection: `As-Samad est Celui qu'on invoque dans le besoin. Mais Il est aussi Celui qui n'a besoin de rien. Cette asymétrie est au cœur de la relation créateur-créature.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le mot « Samad » n'a pas d'équivalent parfait en français. Il contient : l'indépendance absolue, la solidité, la référence ultime, Celui qui satisfait tous les besoins." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi est-ce que je me « fixe » dans ma vie ? Sur quoi m'appuie ma sécurité ? Le miroir me montre que tout point d'appui humain est fragile. Seul As-Samad ne faillit pas." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je Le sollicite pour mes besoins — mais Lui, Il n'a besoin de rien de moi. Cette asymétrie devrait m'humilier. Au lieu de cela, elle me rassure : Sa disponibilité n'est jamais épuisée." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création « samada » vers Allah — se tourne vers Lui pour ses besoins. L'univers entier est en état de besoin constant. Seul Allah est Samad." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur réalise As-Samad, il cesse de courir après les créatures pour ses besoins. Il va directement à la Source. C'est une économie spirituelle radicale." }
    ],
    munajat: `Ya Samad, je viens à Toi avec mes besoins infinis. Toi qui n'as besoin de rien, comble ce qui manque en moi. Sois mon Point Fixe dans un monde qui bouge.`
  },

  "2:152": {
    reference: "2:152",
    theme: ["gratitude", "présence", "prière"],
    emotion: "Reconnaissance, intimité",
    difficulty: "débutant",
    relatedNames: ["Adh-Dhakir", "Al-Mujib"],
    mirrorVersion: `« Souvenez-vous de Moi, Je me souviendrai de vous. » Ce verset est une promesse extraordinaire. Le miroir me montre un échange inégal : je me souviens de Lui un instant, Il se souvient de moi toujours. Mon dhikr est intermittent, distrait, imparfait. Son souvenir de moi est constant, attentif, parfait. Et pourtant, Il lie Son souvenir au mien. Ce n'est pas une condition — c'est une invitation. « Souvenez-vous » n'est pas un ordre strict — c'est une ouverture. Comme si Allah disait : « Tu as accès à Ma présence. Une présence que J'ai déjà. Il suffit que tu t'en souviennes. »`,
    reflection: `Le Prophète a rapporté qu'Allah dit : « Je suis comme Mon serviteur M'imagine. » Notre souvenir de Lui détermine Sa relation avec nous. La première step est la nôtre.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une symétrie apparente : « Souvenez-vous » ↔ « Je Me souviendrai ». Mais le contenu est asymétrique : un dhikr limité contre une miséricorde illimitée." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je Me souviens d'Allah ? Aux moments faciles ou difficiles ? Le miroir me montre la qualité de mon dhikr — et me promet une réponse qui dépasse ce que je donne." },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi : « J'ai commencé par Me souvenir de vous, alors souvenez-vous de Moi. » Mon dhikr est une réponse à Son dhikr éternel. Il m'a précédé." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers « se souvient » d'Allah par son existence même. L'arbre se souvient en poussant, l'étoile en brillant. L'humain se souvient consciemment." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le dhikr n'est pas une technique — c'est une relation. Et dans toute relation, l'initiative de l'autre précède la mienne. Je réponds à un appel qui m'a précédé." }
    ],
    munajat: `Ya Allah, Tu T'es souvenu de moi avant que je n'existe. Aide-moi à me souvenir de Toi maintenant que j'existe. Fais que mon dhikr soit une réponse à Ton amour.`
  },

  "67:3": {
    reference: "67:3",
    theme: ["méditation", "sagesse", "présence"],
    emotion: "Émerveillement, silence",
    difficulty: "intermédiaire",
    relatedNames: ["Al-Khaliq", "Al-Bari"],
    mirrorVersion: `« Celui qui a créé sept cieux superposés. Tu ne vois aucune disproportion dans la création du Tout-Miséricordieux. Regarde encore une fois : y vois-tu une faille ? » Ce verset m'invite à regarder le monde différemment. Le miroir ne me montre pas seulement la création — il me montre mon regard sur elle. « Regarde encore une fois » — l'invitation est claire : le problème n'est pas dans ce que je vois, mais dans comment je vois. Si je vois des failles, c'est que mon regard est imparfait. La création est parfaite — ma perception ne l'est pas.`,
    reflection: `L'invitation à « regarder encore » suggère que la première vue ne suffit pas. Il faut regarder plusieurs fois, avec plusieurs angles, pour voir la perfection qui était toujours là.`,
    tajalli: [
      { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un verset d'une précision scientifique étonnante. Les sept cieux, l'absence de disproportion, l'invitation à réexaminer — tout converge vers une contemplation cosmique." },
      { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois comme « faille » dans ma vie ? Dans le monde ? Le miroir me demande : et si la faille était dans ton regard, pas dans l'objet ?" },
      { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Regarde encore » — et si je regardais mes propres « failles » de la même manière ? Peut-être que ce que je juge imparfait a une perfection que je ne vois pas encore." },
      { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sciences modernes confirment l'ajustement fin de l'univers. Chaque constante physique est calibrée avec une précision extrême. La création n'a pas de faille." },
      { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le regard se purifie, tout devient signe. Chaque imperfection apparente révèle une sagesse cachée. La faille n'est jamais dans la création — elle est dans l'observateur." }
    ],
    munajat: `Ya Khaliq, mon regard est limité et je vois des failles partout. Purifie ma vision. Fais que je voie Ta perfection dans tout ce que Tu as créé — y compris en moi.`
  }
};

// Helper function to get miroir count
export function getMiroirCount(): number {
  return Object.keys(MIROIR).length;
}

// Helper function to get random miroir reference
export function getRandomMiroir(): string | null {
  const keys = Object.keys(MIROIR);
  if (keys.length === 0) return null;
  return keys[Math.floor(Math.random() * keys.length)];
}

// Get all miroir references
export function getAllMiroirReferences(): string[] {
  return Object.keys(MIROIR);
}

// ============================================
// NEW MIROIR ENTRIES - Expanding Coverage
// ============================================

// Surah 4 - An-Nisa
MIROIR["4:36"] = {
  reference: "4:36",
  theme: ["présence", "amour", "méditation"],
  emotion: "Responsabilité, connexion",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wadud"],
  mirrorVersion: `« Adorez Allah et ne Lui donnez aucun associé. Agissez avec bonté envers vos père et mère, les proches, les orphelins, les pauvres, le proche voisin, le voisin lointain, le collègue et le voyageur. » Ce verset me place devant une verticalité et une horizontalité. Verticalité : « Adorez Allah » — l'orientation vers le Haut. Horizontalité : « agissez avec bonté » — le déploiement vers les autres. Le miroir me montre que ces deux dimensions ne sont pas séparées. Mon adoration n'est pas complète si elle ne devient pas bonté envers ceux qui m'entourent. Et ma bonté n'est pas durable si elle n'est pas nourrie par l'adoration.`,
  reflection: `L'islam unit le droit de Dieu et le droit des humains. Les deux sont inséparables. Celui qui prit mais maltraite les gens, son prit est incomplet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une énumération complète : parents, proches, orphelins, pauvres, voisins proches et lointains, collègues, voyageurs. Huit catégories de devoirs sociaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Parmi ces huit catégories, laquelle est-ce que je néglige ? Le miroir m'aide à identifier mes zones d'aveuglement dans mes relations humaines." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Ne Lui donnez aucun associé » — et si mon égoïsme était une forme d'association ? Quand je place mes intérêts au-dessus de ceux des autres, je m'associe à Allah dans mon cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité forme une seule famille. Le verset trace un cercle concentrique qui part du plus proche (les parents) vers le plus lointain (le voyageur de passage)." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La bonté envers les autres est un miroir de la bonté d'Allah envers moi. Je ne peux pas recevoir Sa miséricorde et refuser d'en être le canal." }
  ],
  munajat: `Ya Allah, Tu me demandes d'être bon envers ceux qui m'entourent. Mais parfois je suis égoïste, indifférent. Ouvre mon cœur à la générosité que Tu veux faire passer à travers moi.`
};

// ==================== SURAH 5: AL-MA'IDAH (The Table) - 120 verses - COMPREHENSIVE COVERAGE ====================

MIROIR["5:1"] = {
  reference: "5:1",
  theme: ["alliance", "engagement", "sacré"],
  emotion: "Sérieux, consécration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wakil", "Al-Hafiz"],
  mirrorVersion: `« Ô les croyants ! Remplissez vos engagements. » Le miroir m'ouvre la sourate Al-Ma'idah par un appel solennel. « Ayyuha alladhina amanu awfu bil-'uqud » — ô croyants, remplissez vos engagements. Le mot « 'uqud » désigne les nœuds — les liens sacrés. Le miroir me montre que ma vie spirituelle est faite d'engagements : envers Allah, envers les autres, envers moi-même. Chaque promesse est un nœud que je noue. Le miroir m'invite à l'honnêteté : quels engagements ai-je pris ? Les ai-je honorés ?`,
  reflection: `La vie spirituelle commence par la fidélité à ses engagements. Un engagement non tenu est une brèche dans l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayyuha alladhina amanu awfu bil-'uqud » — ô croyants, remplissez vos engagements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels engagements ai-je pris envers Allah ? Envers les autres ? Les ai-je honorés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'engagement envers Allah est aussi Son engagement envers moi. Je ne suis pas seul dans l'alliance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par des « engagements » — les lois naturelles. Chaque créature tient sa promesse d'exister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore ses engagements reçoit la fidélité d'Allah en retour." }
  ],
  munajat: `Ya Allah, j'ai pris des engagements envers Toi. Aide-moi à les honorer. Ne permets pas que je sois de ceux qui promettent et ne tiennent pas.`
};

MIROIR["5:3"] = {
  reference: "5:3",
  theme: ["confiance", "guidance", "force"],
  emotion: "Accomplissement, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kamil", "An-Ni'mah"],
  mirrorVersion: `« Aujourd'hui, J'ai parachevé pour vous votre religion, et accompli sur vous Mon bienfait. Et J'agrée l'Islam comme religion pour vous. » Ce verset a été révélé lors du Pèlerinage d'Adieu, dans les derniers jours du Prophète. Le miroir me montre un moment d'accomplissement — comme quand une œuvre est terminée, complète. « J'ai parachevé » — le verbe implique que rien ne manque. La religion n'a pas besoin d'ajouts, de corrections. Elle est complète. Ma quête spirituelle n'est pas de compléter ce qui manque — mais de découvrir ce qui est déjà là.`,
  reflection: `La perfection de la religion signifie que tout ce dont l'âme a besoin pour son voyage vers Dieu est présent. Le chemin est tracé — il reste à le parcourir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Révélé à 'Arafat, lors du dernier pèlerinage du Prophète. C'est l'un des derniers versets révélés — un testament spirituel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis ma foi comme une quête de perfection personnelle, ou comme la découverte d'un chemin déjà parfait ? Le miroir m'invite à la confiance plutôt qu'à l'anxiété." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« J'agrée l'Islam » — c'est Allah qui choisit, pas moi. Ma conversion spirituelle n'est pas mon exploit — c'est Son cadeau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'achèvement de la religion marque la fin de la révélation et le début de l'humanité responsable. Le message est complet — maintenant, à nous de le vivre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand la religion est complète, le cœur n'a plus besoin de chercher ailleurs. Tout ce qu'il cherche est déjà dans ce qu'il a reçu." }
  ],
  munajat: `Ya Allah, Tu as parfait ma religion. Aide-moi à ne pas chercher ce que Tu as déjà donné, à ne pas douter de ce que Tu as accompli. Fais-moi vivre dans la plénitude de Ton bienfait.`
};

MIROIR["5:4"] = {
  reference: "5:4",
  theme: ["pureté", "permission", "sagesse"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["At-Tayyib", "Al-Hakim"],
  mirrorVersion: `« Ils t'interrogent sur ce qui leur est permis. Dis : 'Vous sont permises les bonnes choses.' » Le miroir me montre un Dieu qui ne restreint pas par caprice. « Uhilla lakum at-tayyibat » — les bonnes choses vous sont permises. La permission est la règle, l'interdiction est l'exception. Le miroir m'invite à ne pas voir l'Islam comme une liste de non, mais comme un chemin de oui — oui à ce qui purifie, qui nourrit, qui élève.`,
  reflection: `La permission divine précède l'interdiction. Allah veut la facilité pour Ses serviteurs, pas la difficulté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uhilla lakum at-tayyibat » — les bonnes choses vous sont permises." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois ma religion comme restriction ou comme permission ? Le miroir m'invite à la gratitude." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission n'est pas permissivité — elle est confiance. Allah me fait confiance pour choisir le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit abondamment. La permission est inscrite dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la permission avec gratitude reçoit aussi la baraka." }
  ],
  munajat: `Ya Tayyib, Tu m'as permis les bonnes choses. Fais que je les reçoive avec gratitude et que je ne recherche pas ce qui est impur.`
};

MIROIR["5:5"] = {
  reference: "5:5",
  theme: ["alliance", "mariage", "respect"],
  emotion: "Ouverture, dignité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wadud", "Al-Jami'"],
  mirrorVersion: `« La nourriture de ceux qui ont reçu le Livre vous est permise, et votre nourriture leur est permise. » Le miroir me montre un Islam d'ouverture, pas de fermeture. « Wa ta'amu alladhina utu al-kitaba hillun lakum » — la nourriture des gens du Livre vous est permise. Cette permission crée un pont, pas une barrière. Le miroir m'invite à voir l'autre non comme impur, mais comme partenaire dans la dignité humaine.`,
  reflection: `L'Islam reconnaît la dignité des autres traditions. Le respect mutuel est la base de la coexistence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ta'amu alladhina utu al-kitaba hillun lakum » — la nourriture des gens du Livre vous est permise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois ceux qui ont une autre foi ? Avec mépris ou avec respect ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission de partager la nourriture est aussi une invitation à partager l'humanité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La table commune est un symbole universel de fraternité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage sa table partage son cœur." }
  ],
  munajat: `Ya Wadud, Tu as permis le partage avec les gens du Livre. Aide-moi à construire des ponts, pas des murs. Fais que je voie l'autre avec Tes yeux.`
};

MIROIR["5:6"] = {
  reference: "5:6",
  theme: ["purification", "prière", "miséricorde"],
  emotion: "Pureté, préparation",
  difficulty: "débutant",
  relatedNames: ["At-Tahur", "Al-Ghaffur"],
  mirrorVersion: `« Ô les croyants ! Quand vous vous levez pour la prière, lavez vos visages et vos mains jusqu'aux coudes, passez les mains mouillées sur vos têtes et lavez vos pieds jusqu'aux chevilles. » Le miroir me montre la wudu' — l'ablution — comme une préparation sacrée. « Ya ayyuha alladhina amanu idha qumtum ila as-salati faghsilu wujuhakum » — ô croyants, quand vous vous levez pour la prière, lavez vos visages. Le corps se lave, le cœur se prépare. Le miroir m'invite à voir la wudu' non comme une corvée, mais comme une transition entre le profane et le sacré.`,
  reflection: `La purification extérieure prépare la purification intérieure. Le corps est le temple de l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faghsilu wujuhakum wa aydiyakum ila al-marafiq » — lavez vos visages et vos mains jusqu'aux coudes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je fais ma wudu' ? Mécaniquement ou avec conscience ? Le miroir m'invite à la présence." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau purifie le corps, mais c'est Allah qui purifie le cœur. La wudu' est Son invitation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est le symbole universel de purification. Chaque tradition connaît son pouvoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait wudu' avec présence entre dans la prière déjà connecté." }
  ],
  munajat: `Ya Tahur, purifie mon corps et mon cœur. Fais que chaque goutte d'eau soit une demande de pardon. Prépare-moi à me tenir devant Toi.`
};

MIROIR["5:7"] = {
  reference: "5:7",
  theme: ["gratitude", "alliance", "mémoire"],
  emotion: "Reconnaissance, conscience",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "An-Ni'mah"],
  mirrorVersion: `« Et rappelez-vous le bienfait d'Allah sur vous, ainsi que Son alliance par laquelle Il vous a liés. » Le miroir m'invite à la mémoire. « Wadhkuru ni'mata Allahi 'alaykum » — rappelez-vous le bienfait d'Allah sur vous. L'oubli est la maladie spirituelle. Je vis dans le bienfait et je l'oublie. Le miroir me demande : quels bienfaits ai-je reçus aujourd'hui ? Hier ? Cette semaine ? La gratitude commence par la mémoire.`,
  reflection: `La mémoire du bienfait est la base de la gratitude. Oublier, c'est devenir ingrat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wadhkuru ni'mata Allahi 'alaykum wa mithaqahu » — rappelez-vous le bienfait d'Allah et Son alliance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits ai-je reçus ? Les ai-je reconnus ? Le miroir m'invite à la reconnaissance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bienfait n'est pas mérité — il est donné. La gratitude n'est pas un devoir — elle est une réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque souffle est un bienfait. Chaque battement de cœur est un don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient du bienfait reçoit plus de bienfaits." }
  ],
  munajat: `Ya Shakur, j'oublie si souvent Tes bienfaits. Réveille ma mémoire. Fais que chaque instant soit une reconnaissance de ce que Tu m'as donné.`
};

MIROIR["5:8"] = {
  reference: "5:8",
  theme: ["justice", "intégrité", "vérité"],
  emotion: "Fermeté, droiture",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Haqq"],
  mirrorVersion: `« Ô les croyants ! Soyez stricts dans la justice, témoins pour Allah, même contre vous-mêmes, contre vos parents ou vos proches. » Le miroir me place devant une exigence radicale. « Ya ayyuha alladhina amanu kunu qawwamina lillahi shuhada'a bil-qist » — ô croyants, soyez fermes pour Allah, témoins de la justice. La justice n'est pas relative à mes intérêts. Elle est absolue. Le miroir m'invite à l'honnêteté même quand elle me coûte.`,
  reflection: `La vraie justice ne tient pas compte des liens du sang ou de l'intérêt personnel. Elle est témoin pour la vérité seule.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kunu qawwamina lillahi shuhada'a bil-qist » — soyez fermes pour Allah, témoins de la justice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je juste quand ça me coûte ? Ou ma justice s'adapte à mes intérêts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être témoin pour Allah, c'est être témoin de Sa vérité, pas de mes préférences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice est le fondement de l'ordre cosmique. Sans elle, tout s'effondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste contre lui-même est proche d'Allah." }
  ],
  munajat: `Ya 'Adl, ma justice est souvent biaisée par mes intérêts. Aide-moi à être témoin de Ta vérité, même quand elle me déplaît.`
};

MIROIR["5:13"] = {
  reference: "5:13",
  theme: ["pardon", "gentillesse", "élévation"],
  emotion: "Clémence, douceur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Afuww", "Ar-Rauf"],
  mirrorVersion: `« Mais tu pardonneras et tu passeras l'éponge, car Allah aime les bienfaisants. » Le miroir me montre le chemin de l'élévation. « Fa'fu wasfah » — pardonne et passe l'éponge. Le pardon n'est pas une faiblesse — c'est une force. « Inna Allaha yuhibbu al-muhsinin » — Allah aime les bienfaisants. Le miroir m'invite à pardonner comme Allah me pardonne.`,
  reflection: `Le pardon libère le pardonneur autant que le pardonné. La rancune est une prison dont le pardon est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'fu wasfah inna Allaha yuhibbu al-muhsinin » — pardonne et passe l'éponge, car Allah aime les bienfaisants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui dois-je pardonner ? Qu'est-ce qui me retient de pardonner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas oublier — c'est libérer. C'est refuser de laisser le passé contrôler le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature pardonne chaque jour. Le soleil se lève sur les justes et les injustes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne reçoit le pardon d'Allah." }
  ],
  munajat: `Ya 'Afuww, Tu me pardonnes sans cesse. Aide-moi à pardonner aux autres. Libère-moi de la rancune et donne-moi la douceur du cœur.`
};

MIROIR["5:15"] = {
  reference: "5:15",
  theme: ["lumière", "guidance", "révélation"],
  emotion: "Illumination, espérance",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« ô gens du Livre ! Notre Messager est venu à vous pour vous exposer une grande partie du Livre que vous cachiez, et pour passer sur beaucoup. Une lumière et un Livre explicite vous sont venus d'Allah. » Le miroir m'ouvre à la lumière. « Qad ja'akum mina Allahi nurun wa kitabun mubin » — une lumière et un Livre explicite vous sont venus d'Allah. La lumière éclaire, le Livre guide. Le miroir m'invite à recevoir cette lumière et à marcher dans cette guidance.`,
  reflection: `La lumière de la révélation dissipe les ténèbres de l'ignorance et de l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad ja'akum mina Allahi nurun wa kitabun mubin » — une lumière et un Livre explicite vous sont venus d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je marche dans cette lumière ? Ou est-ce que je préfère les ténèbres de mes habitudes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière ne force personne. Elle éclaire. À chacun de choisir de voir ou de fermer les yeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique permet la vie. La lumière spirituelle permet le sens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la lumière devient lui-même lumière pour les autres." }
  ],
  munajat: `Ya Nur, Tu m'as envoyé Ta lumière. Ne permets pas que je la cache ou que je m'en détourne. Illumine mon chemin et guide mes pas.`
};

MIROIR["5:16"] = {
  reference: "5:16",
  theme: ["guidance", "paix", "chemin"],
  emotion: "Sérénité, direction",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Hadi"],
  mirrorVersion: `« Par lequel Allah guide quiconque cherche Son agrément dans les chemins de la paix. Et Il les fait sortir des ténèbres vers la lumière par Sa permission, et les guide vers un chemin droit. » Le miroir me montre le chemin. « Yahdi bihi Allahi man ittaba'a ridwanahu subula as-salam » — Allah guide par lui quiconque cherche Son agrément dans les chemins de la paix. La guidance est liée à l'intention. Chercher l'agrément d'Allah, c'est déjà être guidé. Le miroir m'invite à purifier mon intention.`,
  reflection: `La paix (salam) est le chemin et la destination. Les chemins de paix mènent à la Paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahdi bihi Allahi man ittaba'a ridwanahu subula as-salam » — Allah guide vers les chemins de la paix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cherche ? L'agrément d'Allah ou l'agrément des gens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les chemins de paix ne sont pas toujours faciles, mais ils mènent toujours à la lumière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier cherche l'équilibre, la paix. C'est la direction naturelle de toute création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'agrément d'Allah trouve la paix même dans la tempête." }
  ],
  munajat: `Ya Salam, je cherche Ton agrément. Guide-moi vers les chemins de la paix. Fais-moi sortir des ténèbres vers Ta lumière.`
};

MIROIR["5:23"] = {
  reference: "5:23",
  theme: ["courage", "confiance", "obéissance"],
  emotion: "Determination, foi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Nasir"],
  mirrorVersion: `« Deux hommes parmi ceux qui craignaient Allah et qui étaient comblés de bienfaits par Lui dirent : 'Entrez chez eux par la porte ; une fois entrés, vous serez victorieux.' » Le miroir me montre deux hommes courageux parmi un peuple peureux. « Qala rajulani mina alladhina yakhawna anfusahum » — deux hommes parmi ceux qui craignaient Allah dirent. La minorité courageuse peut changer le cours de l'histoire. Le miroir m'invite à avoir le courage de ma foi, même si je suis seul.`,
  reflection: `Le courage n'est pas l'absence de peur, mais la foi en Allah qui dépasse la peur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rajulani mina alladhina yakhawna anfusahum » — deux hommes parmi ceux qui craignaient Allah dirent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à parler quand les autres se taisent ? À agir quand les autres reculent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur d'Allah libère de la peur des autres. Qui craint Allah ne craint personne d'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'histoire, les changements viennent souvent d'une minorité courageuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah avec lui n'a pas besoin de majorité." }
  ],
  munajat: `Ya Waliyy, donne-moi le courage de ma foi. Quand les autres ont peur, aide-moi à faire confiance. Quand les autres se taisent, aide-moi à parler.`
};

MIROIR["5:27"] = {
  reference: "5:27",
  theme: ["sacrifice", "acceptation", "intention"],
  emotion: "Sérieux, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qabil", "At-Tawwab"],
  mirrorVersion: `« Et raconte-leur en toute vérité l'histoire des deux fils d'Adam : ils offrirent un sacrifice chacun, et celui de l'un fut accepté, et celui de l'autre ne fut pas accepté. » Le miroir m'ouvre l'histoire de Qabil et Habil. « Innama yataqabbalu Allahu mina al-muttaqin » — Allah n'accepte que de ceux qui Le craignent. Le sacrifice extérieur ne suffit pas. L'intention compte plus que l'offrande. Le miroir m'invite à examiner mes actes : sont-ils faits avec sincérité ?`,
  reflection: `L'acceptation divine dépend de l'état du cœur, pas de la grandeur de l'acte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yataqabbalu Allahu mina al-muttaqin » — Allah n'accepte que de ceux qui Le craignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes actes sont-ils acceptés ? Quelle est mon intention profonde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet de l'offrande n'est pas le rejet de la personne. C'est une invitation à changer le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière offre à Allah. Seule l'humanité peut offrir avec ou sans sincérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah regarde le cœur, pas la main qui donne." }
  ],
  munajat: `Ya Allah, j'offre mes actes, mais Tu regardes mon cœur. Purifie mon intention. Fais que chaque offrande vienne d'un cœur sincère.`
};

MIROIR["5:32"] = {
  reference: "5:32",
  theme: ["vie", "justice", "responsabilité"],
  emotion: "Gravité, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Qayyum"],
  mirrorVersion: `« C'est pourquoi Nous avons décrété pour les Enfants d'Israël que quiconque tuerait une personne non coupable d'un meurtre ou de corruption sur la terre, c'est comme s'il avait tué l'humanité entière. » Le miroir me place devant la sacralité de la vie. « Man qatala nafsan bighayri nafsin aw fasadin fi al-ardi faka'annama qatala an-nasa ajma'in » — quiconque tue une personne innocente, c'est comme s'il avait tué l'humanité entière. Une vie vaut l'humanité. Le miroir m'invite à respecter chaque vie comme sacrée.`,
  reflection: `La vie humaine est sacrée. La détruire, c'est détruire un monde entier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man qatala nafsan bighayri nafsin aw fasadin fi al-ardi faka'annama qatala an-nasa ajma'in » — quiconque tue une personne innocente, c'est comme tuer l'humanité entière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite la vie ? La mienne ? Celle des autres ? Chaque vie est un univers." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sauver une vie, c'est sauver l'humanité. Chaque acte de compassion a une portée infinie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité est une. Chaque vie en est une cellule. Tuer une cellule, c'est blesser le corps entier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la vie respecte le Créateur de la vie." }
  ],
  munajat: `Ya Hayy, chaque vie est sacrée. Aide-moi à respecter la vie en moi et autour de moi. Ne permets pas que je sois cause de destruction.`
};

MIROIR["5:35"] = {
  reference: "5:35",
  theme: ["rapprochement", "effort", "espoir"],
  emotion: "Aspiration, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Qarib", "Al-Wasilah"],
  mirrorVersion: `« Ô les croyants ! Craignez Allah et cherchez le moyen de vous rapprocher de Lui. » Le miroir m'invite au rapprochement. « Wabtaghu ilayhi al-wasilah » — cherchez le moyen de vous rapprocher de Lui. Le rapprochement n'est pas automatique. Il demande un effort. « Al-wasilah » est le moyen, le chemin, l'approche. Le miroir me montre que la distance entre moi et Allah n'est pas spatiale — elle est spirituelle. Et je peux la réduire.`,
  reflection: `Se rapprocher d'Allah demande un effort conscient. Chaque acte d'obéissance est un pas vers Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wabtaghu ilayhi al-wasilah » — cherchez le moyen de vous rapprocher de Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels moyens je prends pour me rapprocher d'Allah ? La prière ? Le dhikr ? La charité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'est pas loin. C'est moi qui m'éloigne. Chercher le rapprochement, c'est revenir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création cherche son Créateur. L'être humain peut le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait un pas vers Allah voit Allah faire dix pas vers lui." }
  ],
  munajat: `Ya Qarib, je veux me rapprocher de Toi. Montre-moi les moyens. Aide-moi à faire l'effort. Rapproche-moi de Toi.`
};

MIROIR["5:44"] = {
  reference: "5:44",
  theme: ["jugement", "livre", "responsabilité"],
  emotion: "Sérieux, accountability",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Nous avons fait descendre la Thora dans laquelle il y a guide et lumière. C'est avec elle que les prophètes soumis à Allah jugent les juifs. » Le miroir me montre la responsabilité de juger selon la révélation. « Inna anzalna at-tawrata fiha hudan wa nur » — Nous avons fait descendre la Thora dans laquelle il y a guide et lumière. Le jugement doit être selon le Livre, pas selon les caprices. Le miroir m'invite à juger avec justice, selon les critères divins.`,
  reflection: `Le jugement selon le Livre est un acte sacré. Juger selon ses désirs est un égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna anzalna at-tawrata fiha hudan wa nur » — Nous avons fait descendre la Thora dans laquelle il y a guide et lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je juge ? Selon le Livre ou selon mes préférences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Livre juge en premier celui qui le juge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice universelle suit des critères, pas des humeurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui juge selon le Livre devient lui-même une lumière." }
  ],
  munajat: `Ya Hakam, Tu as envoyé des Livres pour nous guider. Aide-moi à juger avec justice, selon Tes critères et non les miens.`
};

MIROIR["5:54"] = {
  reference: "5:54",
  theme: ["amour", "force", "humilité"],
  emotion: "Passion, puissance douce",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wadud", "Al-'Aziz"],
  mirrorVersion: `« Allah va faire venir un peuple qu'Il aimera et qui L'aimeront, modestes envers les croyants, fiers et puissants envers les mécréants. » Le miroir me montre le portrait du croyant idéal. « Sawaghfiruna 'ala al-mu'minina a'izzatun 'ala al-kafirin » — modestes envers les croyants, fiers envers les mécréants. La force n'exclut pas la douceur. La modestie n'exclut pas la dignité. Le miroir m'invite à cultiver ces deux qualités apparemment opposées.`,
  reflection: `Le croyant est un paradoxe vivant : doux avec les siens, ferme avec l'injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'izzatun 'ala al-kafirin » — fiers et puissants envers les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je doux avec les croyants ? Suis-je ferme avec l'injustice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie force est douce. La vraie douceur est forte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est douce mais elle peut éroder la pierre. Le soleil est doux mais il peut brûler." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qu'Allah aime a les qualités d'Allah : doux et puissant." }
  ],
  munajat: `Ya Wadud, Tu aimes ceux qui T'aiment. Fais que je sois parmi eux. Donne-moi la douceur avec les croyants et la force contre l'injustice.`
};

MIROIR["5:57"] = {
  reference: "5:57",
  theme: ["compagnie", "influence", "discernement"],
  emotion: "Prudence, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Basir"],
  mirrorVersion: `« ô les croyants ! Ne prenez pas pour alliés ceux qui prennent votre religion en raillerie et en jeu. » Le miroir m'avertit sur le choix des compagnies. « La tattakhidhu awliya'a min alladhina utu al-kitaba min qablikum » — ne prenez pas pour alliés ceux de vos prédécesseurs qui prennent votre religion en raillerie. La compagnie influence le cœur. Le miroir m'invite à choisir mes amis avec discernement.`,
  reflection: `On devient comme ceux qu'on fréquente. Le choix des amis est un choix spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tattakhidhu awliya'a min alladhina utu al-kitaba » — ne prenez pas pour alliés ceux qui se moquent de votre religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes amis proches ? M'aident-ils dans ma foi ou m'en détournent-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Éviter les mauvaises compagnies n'est pas de l'exclusion — c'est de la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'association est une loi de la nature. Chaque être est influencé par son environnement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège son cœur des mauvaises influences protège sa foi." }
  ],
  munajat: `Ya Hakim, guide-moi dans le choix de mes compagnies. Éloigne-moi de ceux qui m'éloignent de Toi. Rapproche-moi de ceux qui me rapprochent de Toi.`
};

MIROIR["5:64"] = {
  reference: "5:64",
  theme: ["générosité", "justice", "réalité"],
  emotion: "Espoir, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Karim", "Al-Wasi'"],
  mirrorVersion: `« Les Juifs disent : 'La main d'Allah est fermée.' Que leurs mains soient fermées et qu'ils soient maudits pour ce qu'ils ont dit ! Au contraire, Ses mains sont ouvertes, et Il dépense comme Il veut. » Le miroir me montre une polémique sur la générosité divine. « Bal yadahu mabsutatani yunfiqu kayfa yasha' » — au contraire, Ses deux mains sont ouvertes, et Il dépense comme Il veut. Allah n'est pas avare. Sa générosité est infinie. Le miroir m'invite à faire confiance à cette générosité.`,
  reflection: `La main d'Allah est toujours ouverte. La rareté est une illusion humaine, pas une réalité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal yadahu mabsutatani yunfiqu kayfa yasha' » — Ses deux mains sont ouvertes, et Il dépense comme Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois Allah comme généreux ou comme avare ? Ma vision de Lui affecte ma relation avec Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité d'Allah n'est pas une promesse de tout recevoir — c'est une promesse de recevoir ce qui est bon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers déborde de générosité. Chaque grain contient une plante entière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la générosité d'Allah ne craint jamais le manque." }
  ],
  munajat: `Ya Karim, Tes mains sont ouvertes. Je crains le manque, mais Tu es généreux. Ouvre mes yeux à Ta générosité infinie.`
};

MIROIR["5:83"] = {
  reference: "5:83",
  theme: ["reconnaissance", "vérité", "émotion"],
  emotion: "Tendresse, émotion profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Et quand ils entendent ce qui a été révélé au Messager, tu vois leurs yeux déborder de larmes, parce qu'ils reconnaissent la vérité. » Le miroir me montre la réaction des chrétiens sincères qui entendent le Coran. « Tara a'yunahum tafidu mina ad-dam'i » — tu vois leurs yeux déborder de larmes. La vérité touche le cœur avant l'intellect. Les larmes sont la reconnaissance de l'âme. Le miroir m'invite à laisser la vérité me toucher profondément.`,
  reflection: `La vérité reconnue touche le cœur. Les larmes sont le langage de l'âme qui reconnaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tara a'yunahum tafidu mina ad-dam'i » — tu vois leurs yeux déborder de larmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que la vérité du Coran m'a fait pleurer ? Ou suis-je devenu insensible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les larmes ne sont pas une faiblesse — elles sont une ouverture du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité touche universellement. Les larmes sont le même langage dans toutes les cultures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pleure devant la vérité reçoit la lumière de la vérité." }
  ],
  munajat: `Ya Haqq, Ta vérité touche les cœurs. Fais que je ne sois pas insensible. Ouvre mon cœur à l'émotion de la vérité.`
};

MIROIR["5:90"] = {
  reference: "5:90",
  theme: ["pureté", "abstinence", "clarté"],
  emotion: "Détermination, libération",
  difficulty: "débutant",
  relatedNames: ["At-Tayyib", "Al-Quddus"],
  mirrorVersion: `« Ô les croyants ! Le vin, le jeu de hasard, les pierres dressées et les flèches de divination ne sont qu'une abomination, œuvre du diable. Éloignez-vous-en pour que vous réussissiez. » Le miroir me montre les interdits clairement. « Innama al-khamru wa al-maysir wa al-anhabu wa al-azlam rijsun min 'amali ash-shaytan » — le vin, le jeu, les idoles sont une abomination, œuvre du diable. L'interdiction est pour mon bien. Le miroir m'invite à choisir la clarté sur la confusion.`,
  reflection: `Les interdits protègent. Le vin trouble l'esprit, le jeu trouble le cœur, les idoles trouble la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fajtanibuhu la'allakum tuflihun » — éloignez-vous-en pour que vous réussissiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui trouble ma clarté ? Qu'est-ce qui m'éloigne de la réussite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction n'est pas une privation — c'est une libération de ce qui asservit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté est la norme de l'univers. La souillure est une déviation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'éloigne de l'abomination s'approche de la réussite." }
  ],
  munajat: `Ya Tayyib, Tu m'interdis ce qui me nuit. Donne-moi la force de m'éloigner de l'abomination. Purifie mon cœur et mon corps.`
};

MIROIR["5:100"] = {
  reference: "5:100",
  theme: ["discernement", "valeur", "réalité"],
  emotion: "Clarté, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Dis : 'Le mauvais et le bon ne sont pas pareils, même si l'abondance du mal te plaît.' » Le miroir me donne un critère de discernement. « La yastawi al-khabithu wa at-tayyib » — le mauvais et le bon ne sont pas pareils. La quantité ne change pas la qualité. L'abondance du mal ne le rend pas bon. Le miroir m'invite à juger par la qualité, pas par la quantité.`,
  reflection: `La qualité prime sur la quantité. Un peu de bien vaut mieux que beaucoup de mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yastawi al-khabithu wa at-tayyib » — le mauvais et le bon ne sont pas pareils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse séduire par l'abondance ? Ou je discerne la qualité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui plaît n'est pas forcément bon. Ce qui est abondant n'est pas forcément valable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Une goutte d'eau pure vaut mieux qu'un océan pollué." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui discerne la qualité des choses discerne aussi la qualité des âmes." }
  ],
  munajat: `Ya Hakim, donne-moi le discernement. Aide-moi à voir la qualité au-delà de la quantité. Fais que je choisisse le bien, même s'il est peu.`
};

MIROIR["5:105"] = {
  reference: "5:105",
  theme: ["responsabilité", "individualité", "guidance"],
  emotion: "Sérieux, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Hasib"],
  mirrorVersion: `« ô les croyants ! Vous êtes responsables de vous-mêmes. Celui qui s'égare ne vous nuira point si vous êtes bien guidés. » Le miroir me montre ma responsabilité ultime. « 'Alaykum anfusakum » — vous êtes responsables de vous-mêmes. Je ne peux pas sauver les autres. Je ne peux pas être sauvé par les autres. Chacun porte son destin. Le miroir m'invite à me concentrer sur ma propre guidance.`,
  reflection: `La guidance personnelle est la priorité. On ne peut guider les autres si on est soi-même égaré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alaykum anfusakum la yadurrukum man dalla idha ihtadaytum » — vous êtes responsables de vous-mêmes. Celui qui s'égare ne vous nuira point si vous êtes bien guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je concentré sur ma guidance ou sur celle des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être responsable de soi n'est pas de l'égoïsme — c'est de la lucidité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est responsable de son propre destin dans l'ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se guide soi-même peut ensuite guider les autres." }
  ],
  munajat: `Ya Hadi, je suis responsable de moi-même. Aide-moi à me concentrer sur ma guidance. Ne permets pas que je sois distrait par l'égarement des autres.`
};

MIROIR["5:114"] = {
  reference: "5:114",
  theme: ["prière", "miracle", "communauté"],
  emotion: "Espoir, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujib", "Al-Karim"],
  mirrorVersion: `« 'Îsa, fils de Marie, dit : 'Ô Allah, notre Seigneur ! Fais descendre sur nous une table du ciel, pour que ce soit une fête pour nous, pour le premier et le dernier d'entre nous, et un signe de Ta part.' » Le miroir me montre la prière de Jésus pour sa communauté. « Allahumma rabbana anzil 'alayna ma'idatan mina as-sama' » — Ô Allah, fais descendre sur nous une table du ciel. Jésus prie pour son peuple, pas pour lui seul. Le miroir m'invite à prier pour la communauté, pas seulement pour moi-même.`,
  reflection: `La prière communautaire a une puissance particulière. Prier pour les autres, c'est étendre le cercle de la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahumma rabbana anzil 'alayna ma'idatan mina as-sama' » — Ô Allah, fais descendre sur nous une table du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui je prie ? Pour moi seul ou pour ma communauté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La table descendue du ciel nourrit le corps et l'âme. La prière est la nourriture spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nourriture est un don d'Allah. La demander ensemble renforce la communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour les autres reçoit plus que celui qui prie pour lui seul." }
  ],
  munajat: `Ya Mujib, exauce ma prière pour ma communauté. Fais descendre Ta bénédiction sur nous. Nourris nos corps et nos âmes.`
};

MIROIR["5:118"] = {
  reference: "5:118",
  theme: ["intercession", "responsabilité", "sagesse"],
  emotion: "Humilité, acceptation",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-'Adl"],
  mirrorVersion: `« Si Tu les châties, ce sont Tes serviteurs. Et si Tu leur pardonnes, c'est Toi le Puissant, le Sage. » Le miroir me montre la soumission de Jésus à la volonté divine. « In tu'adhdhibhum fa'innahum 'ibaduk » — si Tu les châties, ce sont Tes serviteurs. « Wa in taghfir lahum fa'innaka anta al-'azizu al-hakim » — et si Tu leur pardonnes, c'est Toi le Puissant, le Sage. Jésus accepte la décision d'Allah, quelle qu'elle soit. Le miroir m'invite à cette soumission radicale.`,
  reflection: `L'intercession a ses limites. La décision finale appartient à Allah. L'acceptation est le sommet de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tu'adhdhibhum fa'innahum 'ibaduk wa in taghfir lahum fa'innaka anta al-'azizu al-hakim » — si Tu les châties, ce sont Tes serviteurs. Et si Tu leur pardonnes, c'est Toi le Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la décision d'Allah, même quand je ne la comprends pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation n'est pas de la passivité — c'est la reconnaissance de la sagesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création accepte la volonté du Créateur. L'être humain peut l'accepter avec amour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la volonté d'Allah reçoit la paix d'Allah." }
  ],
  munajat: `Ya Hakim, Ta décision est toujours sage. Aide-moi à l'accepter, même quand je ne la comprends pas. Donne-moi la soumission de Jésus.`
};

MIROIR["5:120"] = {
  reference: "5:120",
  theme: ["souveraineté", "puissance", "louange"],
  emotion: "Révérence, adoration",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Qadir"],
  mirrorVersion: `« À Allah appartient la royauté des cieux et de la terre et de ce qui s'y trouve. Et Il est Omnipotent. » Le miroir conclut la sourate par la souveraineté absolue. « Lillahi mulku as-samawati wa al-ardi wa ma fihinna » — à Allah appartient la royauté des cieux et de la terre. Tout Lui appartient. Je ne possède rien. Le miroir m'invite à vivre dans cette conscience de propriété divine.`,
  reflection: `Tout appartient à Allah. Je suis un gérant, pas un propriétaire. Cette conscience libère de l'attachement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillahi mulku as-samawati wa al-ardi wa ma fihinna wa huwa 'ala kulli shay'in qadir » — à Allah appartient la royauté des cieux et de la terre et de ce qui s'y trouve. Et Il est Omnipotent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je pense posséder ? Mon corps ? Mes biens ? Mon temps ? Tout est à Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne rien posséder, c'est tout recevoir. La non-possession est la porte de l'abondance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient à son Créateur. Aucune créature n'est propriétaire, toutes sont gérantes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît qu'il ne possède rien reçoit tout." }
  ],
  munajat: `Ya Malik, tout T'appartient. Je ne suis qu'un gérant. Aide-moi à bien gérer ce que Tu m'as confié. Ne permets pas que je m'approprie ce qui est à Toi.`
};

// ==================== SURAH 5: MISSING VERSES (2, 9-12, 14, 17-22, 24-26, etc.) ====================

MIROIR["5:2"] = {
  reference: "5:2",
  theme: ["sacré", "respect", "interdiction"],
  emotion: "Révérence, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haram", "Al-Muhaymin"],
  mirrorVersion: `« Ô les croyants ! Ne profanez pas les rites d'Allah, ni le mois sacré, ni les animaux offerts. » Le miroir me montre le respect du sacré. « La tuhillu sha'a'ira Allah » — ne profanez pas les rites d'Allah. Le sacré mérite respect. Le miroir m'interroge : comment je traite ce qui est sacré ?`,
  reflection: `Le sacré est ce qui est mis à part pour Allah. Le profaner, c'est manquer de respect à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tuhillu sha'a'ira Allahi wa la al-shahra al-haram » — ne profanez pas les rites d'Allah ni le mois sacré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est sacré dans ma vie ? Comment je le traite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Respecter le sacré, c'est honorer Celui qui l'a sanctifié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque tradition a son sacré. Le respect transcende les frontières." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le sacré reçoit la bénédiction du sacré." }
  ],
  munajat: `Ya Muhaymin, enseigne-moi le respect du sacré. Ne permets pas que je profane ce qui T'appartient. Donne-moi la conscience du saint.`
};

MIROIR["5:9"] = {
  reference: "5:9",
  theme: ["promesse", "foi", "paradis"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wadi", "Al-Fardous"],
  mirrorVersion: `« Allah a promis à ceux qui croient et font de bonnes œuvres qu'ils auront un pardon et une énorme récompense. » Le miroir me montre la promesse divine. « Wa'ada Allahu alladhina amanu wa 'amilu as-salihati » — Allah a promis à ceux qui croient et font de bonnes œuvres. La promesse est certaine.`,
  reflection: `La promesse d'Allah est vérité. La foi et les œuvres ouvrent les portes du paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'ada Allahu alladhina amanu wa 'amilu as-salihati lahum maghfiratun wa ajrun 'azim » — Allah a promis à ceux qui croient et font de bonnes œuvres un pardon et une énorme récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis selon cette promesse ? Ma foi et mes œuvres y conduisent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse est pour les croyants et les bienfaiteurs. Les deux sont nécessaires." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis est la destination de toute âme pure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la promesse travaille pour l'accomplir." }
  ],
  munajat: `Ya Wadi, Ta promesse est vérité. Fais que je sois parmi ceux qui croient et font le bien. Accorde-moi le pardon et le paradis.`
};

MIROIR["5:10"] = {
  reference: "5:10",
  theme: ["mécréance", "punition", "enfer"],
  emotion: "Avertissement, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Muntaqim"],
  mirrorVersion: `« Mais ceux qui ne croient pas et traitent de mensonges Nos signes, ceux-là sont les gens de la Fournaise. » Le miroir me montre l'alternative. « Wa alladhina kafaru wa kadhdhabu bi-ayatina » — ceux qui ne croient pas et traitent de mensonges Nos signes. Le rejet a des conséquences.`,
  reflection: `La mécréance et le rejet des signes mènent à l'enfer. Le choix est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika as-habu al-jahim » — ceux-là sont les gens de la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux signes d'Allah ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mécréance est un choix. L'enfer en est la conséquence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont partout. Les nier est un aveuglement volontaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes échappe à la Fournaise." }
  ],
  munajat: `Ya Rabb, préserve-moi de la mécréance. Ouvre mes yeux à Tes signes. Ne permets pas que je sois parmi les gens de la Fournaise.`
};

MIROIR["5:11"] = {
  reference: "5:11",
  theme: ["gratitude", "protection", "rappel"],
  emotion: "Reconnaissance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "An-Nasir"],
  mirrorVersion: `« Et rappelez-vous le bienfait d'Allah sur vous, quand un peuple projetait de porter sa main sur vous. » Le miroir me rappelle les protections passées. « Wadhkuru ni'mata Allahi 'alaykum » — rappelez-vous le bienfait d'Allah sur vous. La mémoire des délivrances nourrit la confiance.`,
  reflection: `Allah nous a protégés maintes fois. Se souvenir de Ses interventions passées fortifie la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wadhkuru ni'mata Allahi 'alaykum idh hamma qawmun an yabsutu ilaykum aydiyahum » — rappelez-vous le bienfait d'Allah sur vous, quand un peuple projetait de porter sa main sur vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles protections Allah m'a-t-Il accordées ? M'en souviens-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection passée garantit la protection future." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque jour apporte sa protection. Chaque nuit sa délivrance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient des protections passées les attire pour l'avenir." }
  ],
  munajat: `Ya Hafiz, Tu m'as protégé tant de fois. Réveille ma mémoire. Fais que je me souvienne et que je Te fasse confiance.`
};

MIROIR["5:12"] = {
  reference: "5:12",
  theme: ["alliance", "Israël", "messagers"],
  emotion: "Solennité, histoire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mithaq", "Al-Rasul"],
  mirrorVersion: `« Allah a pris l'engagement des Enfants d'Israël. Nous avons suscité parmi eux douze chefs. » Le miroir me montre l'histoire de l'alliance. « Wa akhadha Allahu mithaqa bani Isra'il » — Allah a pris l'engagement des Enfants d'Israël. L'alliance a des termes.`,
  reflection: `Allah a fait alliance avec les Enfants d'Israël. Ils avaient des responsabilités et des promesses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akhadha Allahu mithaqa bani Isra'il wa ba'athna minhumu ithnay 'ashara naqiban » — Allah a pris l'engagement des Enfants d'Israël et Nous avons suscité parmi eux douze chefs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon alliance avec Allah ? Quels sont mes termes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance d'Allah est toujours suivie de responsabilités." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté reçoit son alliance et ses guides." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte son alliance reçoit les promesses." }
  ],
  munajat: `Ya Mithaq, Tu fais des alliances avec Tes serviteurs. Aide-moi à respecter la mienne. Donne-moi des guides fidèles.`
};

MIROIR["5:14"] = {
  reference: "5:14",
  theme: ["alliance", "chrétiens", "oubli"],
  emotion: "Tristesse, rappel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Munadi"],
  mirrorVersion: `« Et Nous avons pris l'engagement de ceux qui disent : 'Nous sommes chrétiens.' Mais ils ont oublié une partie de ce qu'on leur a rappelé. » Le miroir me montre l'oubli des alliances. « Fansau hazran mimma dhukkiru bihi » — ils ont oublié une partie de ce qu'on leur a rappelé. L'oubli corrompt l'alliance.`,
  reflection: `Les chrétiens aussi avaient une alliance. L'oubli partiel a conduit à la division.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina alladhina qalu inna nasara akhadhna mithaqahum fansau hazran mimma dhukkiru bihi » — et Nous avons pris l'engagement de ceux qui disent : 'Nous sommes chrétiens.' Mais ils ont oublié une partie de ce qu'on leur a rappelé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai oublié de mon alliance avec Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli partiel mène à l'égarement total." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mémoire est la gardienne de l'alliance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de toute l'allagne est complet." }
  ],
  munajat: `Ya Rabb, l'oubli me guette. Préserve-moi de l'amnésie spirituelle. Rappelle-moi sans cesse Ton alliance.`
};

MIROIR["5:17"] = {
  reference: "5:17",
  theme: ["divinité", "Jésus", "création"],
  emotion: "Correction, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« Certes, sont mécréants ceux qui disent : 'Allah, c'est le Messie, fils de Marie.' » Le miroir corrige une erreur grave. « Laqad kafara alladhina qalu inna Allaha huwa al-masihu ibnu Maryam » — certes, sont mécréants ceux qui disent : 'Allah, c'est le Messie, fils de Marie.' La divinité de Jésus est une erreur.`,
  reflection: `Jésus est messager, pas Dieu. Attribuer la divinité à un créé est une mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad kafara alladhina qalu inna Allaha huwa al-masihu ibnu Maryam » — certes, sont mécréants ceux qui disent : 'Allah, c'est le Messie, fils de Marie.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends qui est Jésus ? Et qui est Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le créé ne peut être le Créateur. Le messager n'est pas l'Envoyeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière témoigne de l'unicité du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la différence entre le créé et le Créateur connaît la vérité." }
  ],
  munajat: `Ya Khaliq, Tu es le Créateur, Jésus est Ton messager. Préserve-moi de confondre le créé et le Créateur. Donne-moi la vérité sur Ton unicité.`
};

MIROIR["5:18"] = {
  reference: "5:18",
  theme: ["filiation", "prétention", "égalité"],
  emotion: "Correction, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rabb", "Al-Khaliq"],
  mirrorVersion: `« Les Juifs et les chrétiens disent : 'Nous sommes les fils d'Allah et Ses préférés.' » Le miroir corrige une autre prétention. « Nahnu abna'u Allahi wa ahibba'uh » — nous sommes les fils d'Allah et Ses bien-aimés. La prétention de filiation spéciale est rejetée.`,
  reflection: `Nul n'est fils d'Allah. Tous sont Ses serviteurs. Les uns obéissent, les autres désobéissent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul falima yu'adhdhibukum bi-dhunubikum » — dis : Pourquoi alors vous châtie-t-Il pour vos péchés ?" },
    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Est-ce que je me crois spécial auprès d'Allah ? Ou est-ce que je me sais serviteur parmi d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention d'être préféré ne rend pas préféré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains sont créés égaux. La distinction est dans la piété." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait serviteur devient véritablement proche." }
  ],
  munajat: `Ya Rabb, je suis Ton serviteur, pas Ton fils. Préserve-moi de la prétention. Donne-moi l'humilité de ma position.`
};

MIROIR["5:19"] = {
  reference: "5:19",
  theme: ["messager", "intervalle", "avertissement"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Bashir"],
  mirrorVersion: `« Ô gens du Livre ! Notre Messager est venu à vous, pour vous exposer clairement, après une interruption de messagers. » Le miroir me montre la continuité rétablie. « Qad ja'akum rasuluna yubayyinu lakum 'ala fatrati mina ar-rusul » — Notre Messager est venu vous exposer clairement après une interruption de messagers. La révélation a repris.`,
  reflection: `Muhammad est venu après une longue pause de la prophétie. Sa venue est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad ja'akum rasuluna yubayyinu lakum 'ala fatrati mina ar-rusul » — Notre Messager est venu à vous pour vous exposer clairement après une interruption de messagers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la venue du Messager comme une miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interruption de la prophétie était une épreuve. Sa reprise est un don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance divine ne cesse jamais vraiment. Elle se transforme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Messager reconnaît la miséricorde d'Allah." }
  ],
  munajat: `Ya Rabb, Tu as envoyé Ton Messager après une interruption. Je reconnais sa venue comme miséricorde. Guide-moi par lui.`
};

MIROIR["5:20"] = {
  reference: "5:20",
  theme: ["Moïse", "mémoire", "faveur"],
  emotion: "Rappel, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mun'im", "Al-Musa"],
  mirrorVersion: `« Et quand Moïse dit à son peuple : 'Ô mon peuple ! Rappelez-vous le bienfait d'Allah sur vous.' » Le miroir me montre la gratitude demandée. « Udhkuru ni'mata Allahi 'alaykum » — rappelez-vous le bienfait d'Allah sur vous. Moïse appelait son peuple à la mémoire.`,
  reflection: `Moïse rappelait sans cesse les bienfaits d'Allah à son peuple. La mémoire nourrit la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qala Musa li-qawmihi ya qawmi udhkuru ni'mata Allahi 'alaykum » — et quand Moïse dit à son peuple : 'Ô mon peuple ! Rappelez-vous le bienfait d'Allah sur vous.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits ai-je reçus ? M'en souviens-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli du bienfait mène à l'ingratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple a reçu ses bienfaits. Chaque génération ses dons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient des bienfaits en reçoit davantage." }
  ],
  munajat: `Ya Mun'im, Tu m'as tant donné. Aide-moi à me souvenir. Ne permets pas que l'oubli me rende ingrat.`
};

MIROIR["5:21"] = {
  reference: "5:21",
  theme: ["terre", "promesse", "entrée"],
  emotion: "Espoir, courage",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wadi", "Al-Ard"],
  mirrorVersion: `« Ô mon peuple ! Entrez dans la terre sainte qu'Allah vous a prescrite. » Le miroir me montre la promesse d'une terre. « Udkhulu al-arda al-muqaddasata allati kataba Allahu lakum » — entrez dans la terre sainte qu'Allah vous a prescrite. La terre promise attend l'entrée.`,
  reflection: `Allah a promis une terre à Son peuple. Mais l'entrée demande le courage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya qawmi udkhulu al-arda al-muqaddasata allati kataba Allahu lakum » — ô mon peuple ! Entrez dans la terre sainte qu'Allah vous a prescrite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle terre Allah m'a-t-Il promise ? Ai-je le courage d'y entrer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse demande l'action. La terre n'est pas prise sans entrée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme a sa terre promise. L'atteindre demande le voyage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entre dans sa terre promise accomplit sa destinée." }
  ],
  munajat: `Ya Wadi, Tu m'as promis une terre. Donne-moi le courage d'y entrer. Ne permets pas que la peur me retienne.`
};

MIROIR["5:22"] = {
  reference: "5:22",
  theme: ["peur", "obstacle", "réponse"],
  emotion: "Découragement, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "An-Nasir"],
  mirrorVersion: `« Ils dirent : 'Ô Moïse ! Il y a un peuple de géants sur cette terre. Nous n'y entrerons pas qu'ils n'en soient sortis.' » Le miroir me montre la peur comme obstacle. « Fiha qawmun jabbarun » — il y a un peuple de géants. La peur paralyse l'entrée.`,
  reflection: `Les géants existent. Mais la peur ne doit pas empêcher l'entrée dans la promesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya Musa inna fiha qawman jabbarin wa inna lan nadkhulaha hatta yakhruju minha » — ils dirent : Ô Moïse ! Il y a un peuple de géants sur cette terre. Nous n'y entrerons pas qu'ils n'en soient sortis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels géants me font peur ? Quels obstacles m'empêchent d'entrer dans ma promesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les géants sont réels, mais la promesse est plus grande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque terre promise a ses géants. Chaque victoire son obstacle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui affronte les géants avec Allah les vainc." }
  ],
  munajat: `Ya Qadir, les géants me font peur. Mais Ta promesse est plus grande. Donne-moi le courage de ne pas reculer.`
};

MIROIR["5:24"] = {
  reference: "5:24",
  theme: ["refus", "peur", "paralysie"],
  emotion: "Tristesse, impuissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "An-Nasir"],
  mirrorVersion: `« Ils dirent : 'Ô Moïse ! Nous n'y entrerons jamais, tant qu'ils y seront.' » Le miroir me montre le refus par peur. « Lan nadkhulaha abadan ma damu fiha » — nous n'y entrerons jamais tant qu'ils y seront. La peur paralyse l'action.`,
  reflection: `Le refus par peur ferme la porte de la promesse. Les géants ne partiront pas tant qu'on n'entre pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya Musa inna lan nadkhulaha abadan ma damu fiha » — ils dirent : Ô Moïse ! Nous n'y entrerons jamais, tant qu'ils y seront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse d'affronter ? Quelle peur me paralyse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Attendre que les géants partent, c'est ne jamais entrer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les obstacles ne disparaissent pas par l'attente. Ils cèdent par l'action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend les circonstances parfaites n'agit jamais." }
  ],
  munajat: `Ya Rabb, la peur me paralyse. Mais Tu es plus grand que les géants. Donne-moi la force d'entrer dans Ta promesse.`
};

MIROIR["5:25"] = {
  reference: "5:25",
  theme: ["Moïse", "désespoir", "séparation"],
  emotion: "Tristesse, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Hadi"],
  mirrorVersion: `« Seigneur, dit Moïse, je n'ai de pouvoir que sur moi-même et mon frère. » Le miroir me montre le renoncement du guide. « Inni la amliku illa nafsi wa akhi » — je n'ai de pouvoir que sur moi-même et mon frère. Le guide ne peut forcer les cœurs.`,
  reflection: `Moïse réalise qu'il ne peut guider que ceux qui veulent être guidés. Le leadership a ses limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbi inni la amliku illa nafsi wa akhi » — il dit : Seigneur, je n'ai de pouvoir que sur moi-même et mon frère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je peux contrôler ? Qu'est-ce qui m'échappe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai pouvoir est sur soi-même, pas sur les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun est responsable de son propre cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se maîtrise maîtrise ce qu'il peut maîtriser." }
  ],
  munajat: `Ya Rabb, je ne peux que moi-même. Aide-moi à me concentrer sur ce que je peux changer. Ne permets pas que je sois accablé par ce qui m'échappe.`
};

MIROIR["5:26"] = {
  reference: "5:26",
  theme: ["punition", "errance", "patience"],
  emotion: "Sérieux, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Muhit"],
  mirrorVersion: `« Allah dit : 'Cette terre leur sera interdite pendant quarante ans ; ils erreront sur la terre.' » Le miroir me montre la conséquence du refus. « Fa-innah muharramatun 'alayhim arba'ina sanah » — cette terre leur sera interdite quarante ans. Le refus a un prix.`,
  reflection: `La punition de l'errance suit le refus d'entrer. Quarante ans d'errance pour un moment de peur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala fa-innah muharramatun 'alayhim arba'ina sanah yatihuna fi al-ard » — Allah dit : Cette terre leur sera interdite pendant quarante ans ; ils erreront sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle errance ai-je causée par mes refus ? Quelles opportunités ai-je manquées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'errance est sometimes nécessaire pour apprendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps perdu se paie en temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'errance peut y trouver des leçons." }
  ],
  munajat: `Ya Hakam, Tes jugements sont justes. Si j'ai erré, aide-moi à apprendre. Ne permets pas que je répète les erreurs du passé.`
};

MIROIR["5:28"] = {
  reference: "5:28",
  theme: ["meurtre", "innocence", "réponse"],
  emotion: "Paix, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muta'ali", "Al-Hakam"],
  mirrorVersion: `« Si tu étends ta main pour me tuer, moi, je n'étendrai pas ma main pour te tuer. » Le miroir me montre la réponse de Habil à Qabil. « In basatta ilayka yadaka li-taqtulanima ma ana bi-basiti yadiya ilayka li-aqtulak » — si tu étends ta main pour me tuer, je n'étendrai pas ma main pour te tuer. La non-violence comme réponse.`,
  reflection: `Habil refuse de répondre à la violence par la violence. Il préfère être victime que meurtrier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In basatta ilayka yadaka li-taqtulanima ma ana bi-basiti yadiya ilayka li-aqtulak » — si tu étends ta main pour me tuer, moi, je n'étendrai pas ma main pour te tuer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réponds à l'agression ? Par la violence ou par la paix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Refuser de tuer, c'est parfois accepter de mourir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La non-violence est une force supérieure à la violence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse de tuer garde son âme pure." }
  ],
  munajat: `Ya Mut'ali, donne-moi la force de ne pas répondre à la violence par la violence. Préserve mon cœur pur même face à l'agression.`
};

MIROIR["5:29"] = {
  reference: "5:29",
  theme: ["innocence", "responsabilité", "témoignage"],
  emotion: "Paix, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-Haqq"],
  mirrorVersion: `« Je crains Allah, le Seigneur de l'univers. Je veux que tu portes ton péché et une partie du péché de celui que tu as tué. » Le miroir me montre la conscience d'Habil. « Inni akhafu Allaha rabba al-'alamin » — je crains Allah, le Seigneur de l'univers. La crainte d'Allah protège du mal.`,
  reflection: `Habil préfère mourir innocent que vivre coupable. Sa crainte d'Allah est plus forte que sa peur de la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inni akhafu Allaha rabba al-'alamin » — je crains Allah, le Seigneur de l'univers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de faire le mal ? La peur des hommes ou la crainte d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah libère de la peur des hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La conscience est le témoin intérieur de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah ne craint personne d'autre." }
  ],
  munajat: `Ya Shahid, Tu es témoin de mon cœur. Donne-moi Ta crainte qui protège du mal. Préserve-moi innocent même dans l'épreuve.`
};

MIROIR["5:30"] = {
  reference: "5:30",
  theme: ["meurtre", "jalousie", "perte"],
  emotion: "Tragédie, perte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Mumit"],
  mirrorVersion: `« Son âme l'incita à tuer son frère. Il le tua donc et devint ainsi du nombre des perdants. » Le miroir me montre le premier meurtre. « Fataw'at lahu nafsuhu qatla akhihi fa-qatalahu » — son âme l'incita à tuer son frère, et il le tua. La jalousie mène au crime.`,
  reflection: `Qabil tua son frère par jalousie. Le premier meurtre de l'humanité fut fratricide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fataw'at lahu nafsuhu qatla akhihi fa-qatalahu fa-asbaha mina al-khasirina » — son âme l'incita à tuer son frère. Il le tua donc et devint ainsi du nombre des perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma jalousie pourrait me faire faire ? Comment je la maîtrise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tuer son frère, c'est se tuer soi-même spirituellement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La jalousie détruit plus celui qui la porte que sa cible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise sa jalousie maîtrise un démon." }
  ],
  munajat: `Ya Rabb, la jalousie est destructrice. Préserve-moi de ce poison. Donne-moi un cœur satisfait de ce que Tu m'as donné.`
};

MIROIR["5:31"] = {
  reference: "5:31",
  theme: ["remords", "enseignement", "corbeau"],
  emotion: "Regret, enseignement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-'Alim"],
  mirrorVersion: `« Allah envoya un corbeau qui gratta la terre pour lui montrer comment enterrer le corps de son frère. » Le miroir me montre l'enseignement divin même dans le châtiment. « Ba'atha Allahu ghuraban yabhathu fi al-ard » — Allah envoya un corbeau qui grattait la terre. Même le meurtrier reçoit un enseignement.`,
  reflection: `Allah enseigne à Qabil comment enterrer son frère. Même dans la punition, il y a guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ba'atha Allahu ghuraban yabhathu fi al-ardi li-yuriyahu kayfa yuwari saw'ata akhih » — Allah envoya un corbeau qui grattait la terre pour lui montrer comment cacher la nudité de son frère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah m'enseigne même dans mes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Même le meurtrier reçoit une leçon. La miséricorde d'Allah atteint tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature est parfois notre maître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend même de ses erreurs grandit." }
  ],
  munajat: `Ya Hadi, Tu enseignes même dans l'erreur. Aide-moi à apprendre de mes fautes. Ne permets pas que je reste dans l'ignorance.`
};

MIROIR["5:33"] = {
  reference: "5:33",
  theme: ["punition", "guerre", "justice"],
  emotion: "Sérieux, réalité",
  difficulty: "avancé",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« La récompense de ceux qui font la guerre à Allah et à Son messager et s'efforcent de semer la corruption sur la terre, c'est qu'ils soient tués, ou crucifiés. » Le miroir me montre la sévérité de la justice. « Innama jazau alladhina yuharibuna Allaha wa rasulahu » — la récompense de ceux qui font la guerre à Allah et à Son messager. La trahison a un prix.`,
  reflection: `La guerre contre Allah et Son messager est le crime suprême. La punition est proportionnée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama jazau alladhina yuharibuna Allaha wa rasulahu wa yasauna fi al-ardi fasadan » — la récompense de ceux qui font la guerre à Allah et à Son messager et s'efforcent de semer la corruption sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite la parole d'Allah ? En ami ou en ennemi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Faire la guerre à Allah, c'est se faire la guerre à soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine protège l'ordre cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la guerre contre Allah évite la punition." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Préserve-moi de m'opposer à Toi. Donne-moi d'être parmi Tes alliés, pas Tes ennemis.`
};

MIROIR["5:34"] = {
  reference: "5:34",
  theme: ["repentir", "miséricorde", "exception"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Excepté ceux qui se repentent avant de tomber en votre pouvoir. » Le miroir me montre la porte ouverte. « Illa alladhina tabu min qabli an taqdiru 'alayhim » — excepté ceux qui se repentent avant que vous les capturiez. Le repentir efface le crime.`,
  reflection: `Le repentir avant la capture est accepté. La miséricorde précède la justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina tabu min qabli an taqdiru 'alayhim » — excepté ceux qui se repentent avant de tomber en votre pouvoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens avant d'être pris ? Ou est-ce que j'attends la punition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir tardif vaut mieux que pas de repentir. Mais le repentir précoce est meilleur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah précède Sa justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent vraiment est pardonné vraiment." }
  ],
  munajat: `Ya Tawwab, Tu acceptes le repentir. Aide-moi à me repentir avant qu'il soit trop tard. Ne permets pas que j'attende la punition pour revenir.`
};

MIROIR["5:36"] = {
  reference: "5:36",
  theme: ["rançon", "valeur", "réalité"],
  emotion: "Sérieux, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Al-Haqq"],
  mirrorVersion: `« Certes, ceux qui ne croient pas, s'ils avaient tout ce qui est sur la terre pour se racheter, cela ne serait pas accepté. » Le miroir me montre l'impossibilité de la rançon. « Law lahum ma fi al-ardi jami'an wa mithlahu ma'ahu » — s'ils avaient tout ce qui est sur la terre et autant encore. La richesse ne rachète pas l'âme.`,
  reflection: `Au jour du jugement, la richesse ne sert à rien. Seule la foi compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru law anna lahum ma fi al-ardi jami'an wa mithlahu ma'ahu li-yaftadu bihi » — certes, ceux qui ne croient pas, s'ils avaient tout ce qui est sur la terre et autant encore pour se racheter..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je pense pouvoir échanger ? Quel est le vrai trésor ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui a de la valeur ici n'en a pas là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie monnaie du jugement est la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui investit dans la foi investit dans l'éternel." }
  ],
  munajat: `Ya Ghani, Tu n'as pas besoin de ma richesse. Ce que Tu veux, c'est mon cœur. Aide-moi à investir dans ce qui compte vraiment.`
};

MIROIR["5:37"] = {
  reference: "5:37",
  theme: ["enfer", "éternité", "impossibilité"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Khulud"],
  mirrorVersion: `« Ils voudraient sortir du Feu, mais ils n'en sortiront point. » Le miroir me montre la finalité du choix. « Yuriduna an yakhruju mina an-nari wa ma hum bi-kharijina minha » — ils voudraient sortir du Feu, mais ils n'en sortiront point. Le choix d'ici a des conséquences là-bas.`,
  reflection: `L'enfer n'a pas de sortie. Le regret ne change pas le passé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuriduna an yakhruju mina an-nari wa ma hum bi-kharijina minha wa lahum 'adhabun muqim » — ils voudraient sortir du Feu, mais ils n'en sortiront point. Et ils auront un châtiment permanent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel choix je fais maintenant ? Quel sera son résultat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sortie de l'enfer était ici-bas, par la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque choix a une conséquence éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sort de l'égarement ici évite l'enfer là-bas." }
  ],
  munajat: `Ya Rabb, préserve-moi du Feu éternel. Fais que je choisisse la sortie maintenant. Ne permets pas que je sois parmi ceux qui regretteront trop tard.`
};

MIROIR["5:38"] = {
  reference: "5:38",
  theme: ["vol", "punition", "dissuasion"],
  emotion: "Sérieux, justice",
  difficulty: "avancé",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Le voleur et la voleuse, coupez-leur la main en punition de ce qu'ils ont acquis. » Le miroir me montre la punition du vol. « As-sariqu wa as-sariqatu iqta'u aydiyahuma » — le voleur et la voleuse, coupez-leur la main. La punition est sévère mais dissuasive.`,
  reflection: `La punition du vol est sévère pour protéger la société. La justice protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa as-sariqu wa as-sariqatu iqta'u aydiyahuma jaza'an bima kasaba » — le voleur et la voleuse, coupez-leur la main en punition de ce qu'ils ont acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je respecte les biens d'autrui ? Est-ce que je prends ce qui ne m'appartient pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La main qui vole perd son droit d'exercer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection des biens est un droit humain fondamental." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les biens d'autrui protège sa propre main." }
  ],
  munajat: `Ya Hakam, Tu es le Juste. Préserve-moi de prendre ce qui ne m'appartient pas. Donne-moi le respect des droits d'autrui.`
};

MIROIR["5:39"] = {
  reference: "5:39",
  theme: ["repentir", "réforme", "miséricorde"],
  emotion: "Espoir, transformation",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Mais quiconque se repent après son tort et se réforme, Allah accepte son repentir. » Le miroir me montre la miséricorde après la punition. « Man taba min ba'di zulumihi wa aslaha » — quiconque se repent après son tort et se réforme. Le repentir sincère est accepté.`,
  reflection: `Même après le crime, le repentir sincère est accepté. La porte n'est jamais fermée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man taba min ba'di zulumihi wa aslaha fa-inna Allaha yatubu 'alayh » — mais quiconque se repent après son tort et se réforme, Allah accepte son repentir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens et me réforme ? Ou est-ce que je me repens sans changer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir sans réforme n'est pas complet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transformation est la preuve du vrai repentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent et se réforme est comme celui qui n'a pas péché." }
  ],
  munajat: `Ya Tawwab, Tu acceptes le repentir. Aide-moi à me repentir vraiment et à me réformer. Ne permets pas que mon repentir soit superficiel.`
};

MIROIR["5:40"] = {
  reference: "5:40",
  theme: ["royaume", "justice", "soumission"],
  emotion: "Révérence, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Hakam"],
  mirrorVersion: `« Ne sais-tu pas qu'à Allah appartient la royauté des cieux et de la terre ? Il châtie qui Il veut et pardonne à qui Il veut. » Le miroir me montre la souveraineté absolue. « Alam ta'lam anna Allaha lahu mulku as-samawati wa al-ard » — ne sais-tu pas qu'à Allah appartient la royauté des cieux et de la terre ?`,
  reflection: `Allah fait ce qu'Il veut. Sa décision est juste, même si je ne la comprends pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam ta'lam anna Allaha lahu mulku as-samawati wa al-ardi yu'adhdhibu man yasha'u wa yaghfiru liman yasha' » — ne sais-tu pas qu'à Allah appartient la royauté des cieux et de la terre ? Il châtie qui Il veut et pardonne à qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la souveraineté d'Allah ? Ou est-ce que je La conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Contester la décision d'Allah, c'est oublier Sa souveraineté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sous la souveraineté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la souveraineté d'Allah est en paix." }
  ],
  munajat: `Ya Malik, Tout T'appartient. J'accepte Ta décision. Donne-moi la soumission à Ta souveraineté.`
};

MIROIR["5:41"] = {
  reference: "5:41",
  theme: ["hypocrisie", "écoute", "épreuve"],
  emotion: "Mise en garde, discernement",
  difficulty: "avancé",
  relatedNames: ["Al-Khabir", "Al-Basir"],
  mirrorVersion: `« Ô Messager ! Que ne t'affligent point ceux qui concourent en mécréance. » Le miroir me montre l'épreuve des hypocrites. « La yahzunka alladhina yusari'una fi al-kufr » — que ne t'affligent point ceux qui concourent en mécréance. L'hypocrisie existe, mais ne doit pas affliger.`,
  reflection: `Les hypocrites existent dans chaque communauté. Leur présence est une épreuve, pas un obstacle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yahzunka alladhina yusari'una fi al-kufr » — ô Messager ! Que ne t'affligent point ceux qui concourent en mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face à l'hypocrisie ? Avec tristesse ou avec discernement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hypocrisie des autres ne doit pas affecter ma sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mélange du vrai et du faux existe dans chaque communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste sincère malgré l'hypocrisie autour préserve son âme." }
  ],
  munajat: `Ya Khabir, Tu connais les cœurs. Préserve-moi de l'hypocrisie et de la tristesse face à celle des autres. Donne-moi le discernement et la constance.`
};

MIROIR["5:42"] = {
  reference: "5:42",
  theme: ["mensonge", "écoute", "jugement"],
  emotion: "Discernement, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Haqq"],
  mirrorVersion: `« Écouteurs de mensonge, dévoreurs d'illicite. » Le miroir me montre les caractéristiques des corrompus. « Samma'una li al-kadhibi akkaluna li as-suht » — écouteurs de mensonge, dévoreurs d'illicite. Le mensonge et le gain illicite vont ensemble.`,
  reflection: `Ceux qui écoutent le mensonge et mangent l'illicite sont corrompus. Le Prophète doit les juger avec justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Samma'una li al-kadhibi akkaluna li as-suht » — écouteurs de mensonge, dévoreurs d'illicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'écoute ? Qu'est-ce que je mange ? Suis-je parmi les corrompus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Éviter le mensonge et l'illicite, c'est préserver son intégrité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La corruption commence par l'oreille et la bouche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son oreille et sa bouche pures garde son cœur pur." }
  ],
  munajat: `Ya Hakam, Tu es le Juge. Préserve-moi du mensonge et de l'illicite. Donne-moi l'intégrité de l'oreille et de la bouche.`
};

MIROIR["5:43"] = {
  reference: "5:43",
  theme: ["jugement", "Livre", "hypocrisie"],
  emotion: "Ironie, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Tawrah"],
  mirrorVersion: `« Mais comment te demanderaient-ils d'être leur juge alors qu'ils ont la Thora où est le jugement d'Allah ? » Le miroir me montre l'hypocrisie du choix. « Kayfa yuhakkimunaka » — comment te demanderaient-ils d'être juge ? Ils ont leur propre Livre mais le rejettent.`,
  reflection: `Les Juifs avaient la Thora mais préféraient demander au Prophète de juger, espérant un jugement favorable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa yuhakkimunaka wa 'indahumu at-tawratu fiha hukmu Allah » — mais comment te demanderaient-ils d'être leur juge alors qu'ils ont la Thora où est le jugement d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis mes juges selon ce qui m'arrange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chercher un juge qui nous convient, c'est fuir la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice est une, même si on la cherche ailleurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte n'importe quel juge juste accepte la justice." }
  ],
  munajat: `Ya Hakam, Tu es le Juste. Fais que j'accepte Ton jugement où qu'il vienne. Ne permets pas que je cherche ce qui m'arrange.`
};

MIROIR["5:45"] = {
  reference: "5:45",
  theme: ["justice", "loi", "rétribution"],
  emotion: "Sérieux, équité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Et Nous leur avons prescrit : vie pour vie, œil pour œil, nez pour nez, oreille pour oreille, dent pour dent. » Le miroir me montre la loi du talion dans la Thora. « Wa katabna 'alayhim fiha anna an-nafsa bi-n-nafs » — vie pour vie. La justice est proportionnelle. Le miroir m'enseigne que la loi divine établit l'équilibre. Mais ensuite vient le pardon : « Celui qui y renonce par charité, cela lui servira d'expiation. » La justice n'interdit pas la miséricorde.`,
  reflection: `La loi du talion établit la justice stricte. Le pardon l'élève à la miséricorde. Les deux sont divins.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa katabna 'alayhim fiha anna an-nafsa bi-n-nafs wa al-'ayna bi-l-'ayn wa al-anfa bi-l-anf » — et Nous leur avons prescrit : vie pour vie, œil pour œil, nez pour nez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand on me fait du tort, est-ce que je cherche la justice ou le pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice est un droit, le pardon est un élévation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur l'équilibre. Chaque action a une réaction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne reçoit plus que ce qu'il a donné." }
  ],
  munajat: `Ya 'Adl, Tu es Juste. Donne-moi la justice quand j'en ai besoin et la capacité de pardonner quand je peux.`
};

MIROIR["5:46"] = {
  reference: "5:46",
  theme: ["Jésus", "Évangile", "guidance"],
  emotion: "Révérence, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Al-Hadi"],
  mirrorVersion: `« Et Nous avons fait suivre leurs traces de Jésus, fils de Marie, confirmant ce qu'il y avait avant lui de la Thora. Et Nous lui avons donné l'Évangile. » Le miroir me montre la continuité de la révélation. « Wa qaffayna 'ala atharihim bi 'Isa ibni Maryama » — et Nous avons fait suivre leurs traces de Jésus. Jésus confirme la Thora. L'Évangile vient après. Le miroir m'enseigne que la révélation est une chaîne continue, pas des livres isolés.`,
  reflection: `Jésus confirme Moïse. L'Évangile confirme la Thora. La révélation est une, les messagers sont nombreux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qaffayna 'ala atharihim bi 'Isa ibni Maryama musaddiqan lima bayna yadayhi mina at-tawrati » — et Nous avons fait suivre leurs traces de Jésus, fils de Marie, confirmant ce qu'il y avait avant lui de la Thora." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la continuité de la révélation ? Ou est-ce que je vois des religions séparées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confirmation est le signe de l'unité de la source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est une, les lampes sont multiples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'unité de la révélation voit l'unité du Révélateur." }
  ],
  munajat: `Ya Hadi, Tu as envoyé Jésus avec l'Évangile. Fais que je voie la continuité de Ta révélation. Unifie ma compréhension de Tes messagers.`
};

MIROIR["5:47"] = {
  reference: "5:47",
  theme: ["jugement", "responsabilité", "Livre"],
  emotion: "Sérieux, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Ash-Shahid"],
  mirrorVersion: `« Que les gens de l'Évangile jugent selon ce qu'Allah y a fait descendre. » Le miroir me montre la responsabilité de chaque communauté envers son Livre. « Wal-yahkum ahlu al-injili bima anzala Allahu fihi » — que les gens de l'Évangile jugent selon ce qu'Allah y a fait descendre. Le Livre n'est pas un ornement — il est une loi. Le miroir m'interroge : est-ce que je juge ma vie selon ce qu'Allah a fait descendre ?`,
  reflection: `Chaque communauté a son Livre. Chaque Livre est une loi. Juger selon le Livre est la responsabilité du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wal-yahkum ahlu al-injili bima anzala Allahu fihi » — que les gens de l'Évangile jugent selon ce qu'Allah y a fait descendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge ma vie selon le Coran ? Ou est-ce que je juge selon mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Juger selon le Livre, c'est se soumettre à la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier suit la loi de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui juge selon le Livre est jugé avec miséricorde." }
  ],
  munajat: `Ya Hakam, Tu as donné le Livre pour guider. Fais que je juge ma vie selon ce que Tu as révélé. Ne permets pas que je suive mes désirs.`
};

MIROIR["5:48"] = {
  reference: "5:48",
  theme: ["Coran", "critère", "diversité"],
  emotion: "Gratitude, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Furqan", "Al-Hakam"],
  mirrorVersion: `« Et Nous t'avons fait descendre le Livre avec la vérité, confirmant les Livres qui l'ont précédé et prédominant sur eux. Juge donc entre eux selon ce qu'Allah a fait descendre. » Le miroir me montre la place unique du Coran. « Wa anzalna ilayka al-kitaba bi-l-haqqi musaddiqan lima bayna yadayhi mina al-kitabi wa muhayminan 'alayh » — confirmant et prédominant. Le Coran est la confirmation et le critère final. Le miroir m'invite à juger par le Coran.`,
  reflection: `Le Coran confirme les Livres précédents et les domine. Il est le critère final pour tous les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anzalna ilayka al-kitaba bi-l-haqqi musaddiqan lima bayna yadayhi mina al-kitabi wa muhayminan 'alayh » — et Nous t'avons fait descendre le Livre avec la vérité, confirmant les Livres qui l'ont précédé et prédominant sur eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère le Coran comme le critère final ? Ou est-ce que je cherche ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran prédomine, mais il ne nie pas — il confirme et complète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation finale est la lumière qui rassemble toutes les lumières." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui juge par le Coran juge par la vérité." }
  ],
  munajat: `Ya Furqan, Tu as fait descendre le Coran comme critère. Fais que je juge par lui. Donne-moi la compréhension de Ta révélation finale.`
};

MIROIR["5:49"] = {
  reference: "5:49",
  theme: ["jugement", "désirs", "égarement"],
  emotion: "Avertissement, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hadi"],
  mirrorVersion: `« Juge donc entre eux selon ce qu'Allah a fait descendre. Ne suis pas leurs désirs. Et prends garde qu'ils ne te tentent en t'écartant de ce qu'Allah t'a fait descendre. » Le miroir me met en garde contre la tentation des désirs. « Wa ihdharhum an yaftinuka » — prends garde qu'ils ne te tentent. Les désirs des autres peuvent nous détourner. Le miroir m'avertit : la pression sociale peut nous éloigner de la vérité.`,
  reflection: `Suivre les désirs des autres est aussi dangereux que suivre ses propres désirs. La vérité n'est pas négociable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-hkum baynahum bima anzala Allahu wa la tattabi' ahwa'ahum wa ihdharhum an yaftinuka » — juge donc entre eux selon ce qu'Allah a fait descendre. Ne suis pas leurs désirs. Et prends garde qu'ils ne te tentent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels désirs des autres m'influencent ? Est-ce que je compromets la vérité pour plaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tentation des autres est un test de notre attachement à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a ses désirs. La vérité est au-dessus des désirs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui résiste aux désirs des autres renforce sa propre vérité." }
  ],
  munajat: `Ya Hadi, les désirs des autres me tentent. Fortifie mon cœur dans la vérité. Ne permets pas que je sois détourné de ce que Tu as révélé.`
};

MIROIR["5:50"] = {
  reference: "5:50",
  theme: ["loi", "ignorance", "guidance"],
  emotion: "Interrogation, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Hikmah"],
  mirrorVersion: `« Est-ce donc le jugement de l'Ignorance qu'ils recherchent ? Qui est meilleur qu'Allah en jugement pour un peuple qui croit ? » Le miroir me pose une question tranchante. « Afahukma al-jahiliyyati yabghun » — est-ce le jugement de l'Ignorance qu'ils recherchent ? La jahiliyya est l'opposé de la guidance. Le miroir m'interroge : quel jugement est-ce que je recherche ?`,
  reflection: `La jahiliyya n'est pas seulement l'époque préislamique — c'est tout jugement qui n'est pas d'Allah. Chercher ailleurs que Lui est ignorance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afahukma al-jahiliyyati yabghun wa man ahsanu mina Allahu hukman li-qawmin yuqinun » — est-ce donc le jugement de l'Ignorance qu'ils recherchent ? Qui est meilleur qu'Allah en jugement pour un peuple qui croit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je prends des décisions, à quelle source je me réfère ? À Allah ou à l'ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement d'Allah est la lumière, tout autre jugement est ténèbres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier obéit aux lois divines. Seul l'homme prétend les ignorer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le jugement d'Allah trouve la lumière." }
  ],
  munajat: `Ya Hakam, Ton jugement est le meilleur. Ne permets pas que je cherche le jugement de l'ignorance. Guide-moi par Ta sagesse.`
};

MIROIR["5:51"] = {
  reference: "5:51",
  theme: ["alliance", "confiance", "loyauté"],
  emotion: "Avertissement, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "An-Nasir"],
  mirrorVersion: `« Ô vous qui croyez ! Ne prenez pas pour alliés les Juifs et les Chrétiens ; ils sont alliés les uns des autres. Et celui d'entre vous qui les prend pour alliés est des leurs. » Le miroir me montre la question de l'alliance. « La tattakhidhu al-yahuda wa an-nasara awliya' » — ne prenez pas pour alliés. L'alliance n'est pas seulement amitié — c'est confiance. Le miroir m'invite à discernement dans mes alliances.`,
  reflection: `L'alliance religieuse est une question de loyauté. Être allié de ceux qui rejettent la foi peut compromettre sa propre foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la tattakhidhu al-yahuda wa an-nasara awliya' ba'duhum awliya' ba'd » — ô vous qui croyez ! Ne prenez pas pour alliés les Juifs et les Chrétiens ; ils sont alliés les uns des autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je donne ma confiance ? Mes alliances renforcent-elles ma foi ou la compromettent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance avec les croyants renforce la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont alliés des croyants. Les croyants sont alliés les uns des autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'allie avec Allah est protégé." }
  ],
  munajat: `Ya Waliyy, Tu es mon Allié. Fais que mes alliances soient avec Toi et avec ceux qui T'aiment. Ne permets pas que je trahisse ma foi par de mauvaises alliances.`
};

MIROIR["5:52"] = {
  reference: "5:52",
  theme: ["hypocrisie", "épreuve", "regret"],
  emotion: "Avertissement, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khallaq", "Al-'Alim"],
  mirrorVersion: `« Ceux donc dont le cœur est malade se précipitent vers eux en disant : 'Nous craignons qu'un revers ne nous atteigne.' » Le miroir me montre les maladies du cœur. « Fa-tara alladhina fi qulubihim marad » — ceux dont le cœur est malade. La maladie du cœur est la faiblesse de la foi. Ils cherchent des alliés par peur, pas par conviction. Le miroir m'avertit : la peur peut faire oublier la foi.`,
  reflection: `La maladie du cœur n'est pas la maladie physique — c'est la faiblesse de la foi. Les malades de cœur cherchent des alliances de peur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tara alladhina fi qulubihim maradun yusari'una fihim yaquluna nahsha an tuzira dairah » — ceux donc dont le cœur est malade se précipitent vers eux en disant : nous craignons qu'un revers ne nous atteigne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cœur est malade ? Est-ce que je prends des décisions par peur ou par foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi guérit le cœur, la peur l'empoisonne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur sain est stable, le cœur malade oscille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guérit son cœur par la foi n'a plus peur." }
  ],
  munajat: `Ya Rabb, mon cœur est malade de peur. Guéris-le par la foi. Ne permets pas que je cherche des alliances par crainte des hommes.`
};

MIROIR["5:53"] = {
  reference: "5:53",
  theme: ["foi", "hypocrisie", "vrai"],
  emotion: "Réalisation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Ash-Shahid"],
  mirrorVersion: `« Et ceux qui croient diront : 'Est-ce là ceux qui juraient par Allah de leur plus ferme serment qu'ils étaient avec vous ?' » Le miroir me montre le contraste entre les paroles et la réalité. « A-ha'ula'i alladhina aqsamu bi-Allahi jurusahum » — est-ce là ceux qui juraient par Allah ? Les serments ne suffisent pas. La réalité révèle la vérité. Le miroir m'invite à vérifier mes serments par mes actes.`,
  reflection: `Les serments peuvent mentir, les actes ne mentent pas. La foi se voit dans la réalité, pas dans les paroles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaqulu alladhina amanu a-ha'ula'i alladhina aqsamu bi-Allahi jurusahum innahum ma'akum » — et ceux qui croient diront : est-ce là ceux qui juraient par Allah de leur plus ferme serment qu'ils étaient avec vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes serments correspondent-ils à mes actes ? Ou est-ce que je jure sans tenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment sincère se voit dans la constance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tient ses serments par sa constance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient ses serments est digne de confiance." }
  ],
  munajat: `Ya Haqq, Tu connais la vérité de mes serments. Fais que mes paroles soient vraies et mes actes conformes à mes serments. Ne permets pas que je sois hypocrite.`
};

MIROIR["5:55"] = {
  reference: "5:55",
  theme: ["alliance", "croyants", "obéissance"],
  emotion: "Appartenance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Mu'min"],
  mirrorVersion: `« Vos alliés ne sont qu'Allah, Son Messager et les croyants qui accomplissent la prière, s'acquittent de l'aumône et s'inclinent. » Le miroir me montre les vrais alliés. « Innama waliyyukumu Allahu wa rasuluhu wa alladhina amanu » — vos alliés ne sont qu'Allah, Son Messager et les croyants. L'alliance avec Allah inclut l'alliance avec Son Messager et les croyants. Le miroir m'invite à choisir mes alliés.`,
  reflection: `Les vrais alliés sont ceux qui craignent Allah. L'alliance est une question de foi et de pratique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama waliyyukumu Allahu wa rasuluhu wa alladhina amanu alladhina yuqimuna as-salata wa yu'tuna az-zakata wa hum raki'un » — vos alliés ne sont qu'Allah, Son Messager et les croyants qui accomplissent la prière, s'acquittent de l'aumône et s'inclinent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes vrais alliés ? Sont-ils ceux qui craignent Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance avec Allah inclut l'alliance avec les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont alliés des croyants dans les cieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'allie avec Allah n'a besoin d'autre allié." }
  ],
  munajat: `Ya Waliyy, Tu es mon Allié. Fais que mes alliés soient ceux qui T'aiment. Unis-moi aux croyants sincères.`
};

MIROIR["5:56"] = {
  reference: "5:56",
  theme: ["alliance", "victoire", "confiance"],
  emotion: "Confiance, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Waliyy"],
  mirrorVersion: `« Quiconque prend pour alliés Allah, Son Messager et les croyants, le parti d'Allah sera victorieux. » Le miroir me montre la promesse de victoire. « Fa-inna hizba Allahi humu al-ghalibun » — le parti d'Allah sera victorieux. L'alliance avec Allah n'est pas seulement spirituelle — elle est aussi un engagement qui mène à la victoire. Le miroir m'invite à rejoindre le parti d'Allah.`,
  reflection: `Le parti d'Allah n'est pas un parti politique — c'est l'ensemble de ceux qui s'allient avec Lui. La victoire est promise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yatawalla Allaha wa rasulahu wa alladhina amanu fa-inna hizba Allahi humu al-ghalibun » — quiconque prend pour alliés Allah, Son Messager et les croyants, le parti d'Allah sera victorieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie du parti d'Allah ? Mon alliance est-elle claire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire n'est pas dans les nombres — elle est dans l'alliance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient au parti d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appartient au parti d'Allah ne perd jamais." }
  ],
  munajat: `Ya 'Aziz, Ton parti est victorieux. Fais que je sois de Ton parti. Donne-moi la victoire par mon alliance avec Toi.`
};

MIROIR["5:58"] = {
  reference: "5:58",
  theme: ["prière", "moquerie", "respect"],
  emotion: "Indignation, sérieux",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Karim"],
  mirrorVersion: `« Et quand vous faites l'appel à la prière, ils le prennent en raillerie et en jeu. » Le miroir me montre le mépris des hypocrites. « Wa idha nadaytumu ila as-salati ittakhadhuha huzuan wa la'iban » — ils prennent l'appel en raillerie. L'adhan est sacré. Le rire face au sacré révèle le vide du cœur. Le miroir m'invite à honorer l'appel à la prière.`,
  reflection: `L'appel à la prière est l'invitation d'Allah. Le mépriser, c'est mépriser l'Inviteur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha nadaytumu ila as-salati ittakhadhuha huzuan wa la'iban » — et quand vous faites l'appel à la prière, ils le prennent en raillerie et en jeu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à l'adhan ? Avec empressement ou avec indifférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La raillerie de l'adhan révèle la mort du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier répond à l'appel d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore l'adhan honore l'Inviteur." }
  ],
  munajat: `Ya Sami', j'entends Ton appel. Fais que je l'honore. Ne permets pas que je sois parmi ceux qui se moquent du sacré.`
};

MIROIR["5:59"] = {
  reference: "5:59",
  theme: ["rejet", "partialité", "persécution"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Dis : 'Ô gens du Livre ! Nous reprochez-vous autre chose que de croire en Allah et à ce qu'on a fait descendre sur nous et à ce qu'on a fait descendre auparavant ?' » Le miroir me montre le vrai motif du rejet. « Tahsununa 'alayna illa an amanna » — nous reprochez-vous autre chose que de croire ? La foi est le seul « crime ». Le miroir m'enseigne que le rejet de la vérité n'a pas toujours de raison logique.`,
  reflection: `La foi est parfois perçue comme une offense. Croire en Allah dérange ceux qui ne croient pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ahla al-kitabi hal tanqimuna minna illa an amanna bi-Allahi wa ma unzila ilayna » — dis : ô gens du Livre ! Nous reprochez-vous autre chose que de croire en Allah et à ce qu'on a fait descendre sur nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand on me rejette, est-ce pour ma foi ou pour autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet de la foi révèle la haine de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière dérange les ténèbres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est rejeté pour sa foi est honoré par Allah." }
  ],
  munajat: `Ya Haqq, on me rejette pour ma foi. Fortifie-moi dans la vérité. Ne permets pas que le rejet des hommes m'éloigne de Toi.`
};

MIROIR["5:60"] = {
  reference: "5:60",
  theme: ["transformation", "châtiment", "mécréance"],
  emotion: "Effroi, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Mutakabbir"],
  mirrorVersion: `« Dis : 'Puis-je vous apprendre quelque chose de pire que cela, comme rétribution auprès d'Allah ? Ceux qu'Allah a maudits, contre qui Il S'est courroucé et dont Il a fait des singes, des porcs et des adorateurs du Taghut.' » Le miroir me montre la transformation des mécréants. « Ja'ala minhum al-qiradata wa al-khanazira » — Il a fait d'eux des singes et des porcs. La transformation physique est le signe de la transformation spirituelle. Le miroir m'avertit : le cœur peut se transformer en bête.`,
  reflection: `La transformation en animaux est une métaphore de la dégradation morale. L'homme qui oublie Allah devient moins qu'animal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ja'ala minhum al-qiradata wa al-khanazira wa 'abada at-taghut » — Il a fait d'eux des singes, des porcs et des adorateurs du Taghut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cœur se transforme ? Suis-je en train de devenir ce que j'adore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah élève, l'adoration du Taghut dégrade." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'animal suit sa nature, l'homme peut choisir de s'élever ou de se dégrader." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adorce Allah devient plus qu'humain." }
  ],
  munajat: `Ya Qahhar, Tu transformes ceux qui Te rejettent. Préserve-moi de la dégradation. Fais que je m'élève par l'adoration.`
};

MIROIR["5:61"] = {
  reference: "5:61",
  theme: ["hypocrisie", "mensonge", "exposition"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Quand ils viennent vous voir, ils disent : 'Nous croyons.' Alors qu'ils entrent avec la mécréance et qu'ils en sortent. » Le miroir me montre l'hypocrisie des faux croyants. « Yaquluna amanna wa qad dakhalu bi-l-kufri wa hum qad kharaju bihi » — ils disent nous croyons alors qu'ils entrent avec la mécréance. Les mots mentent, le cœur reste caché. Mais Allah connaît le cœur. Le miroir m'invite à la sincérité.`,
  reflection: `L'hypocrisie est un double jeu. On dit une chose, on en pense une autre. Mais Allah voit tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ja'ukum qalu amanna wa qad dakhalu bi-l-kufri wa hum qad kharaju bihi » — quand ils viennent vous voir, ils disent : nous croyons. Alors qu'ils entrent avec la mécréance et qu'ils en sortent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis hypocrite ? Est-ce que mes paroles correspondent à mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité aligne les mots et le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas — il est ce qu'il est." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère n'a rien à cacher." }
  ],
  munajat: `Ya 'Alim, Tu connais mon cœur. Fais que je sois sincère. Ne permets pas que je sois hypocrite. Alignes mes paroles avec mon cœur.`
};

MIROIR["5:62"] = {
  reference: "5:62",
  theme: ["corruption", "péché", "transgression"],
  emotion: "Indignation, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Qahhar"],
  mirrorVersion: `« Et tu en vois beaucoup d'entre eux se précipiter vers le péché, l'inimité et la consommation du mal illicite. » Le miroir me montre la précipitation vers le mal. « Tara kathiran minhum yusari'una fi al-ithmi wa al-'udwani » — tu en vois beaucoup se précipiter vers le péché et l'inimité. La précipitation vers le mal est un signe de maladie du cœur. Le miroir m'avertit : où je me précipite ?`,
  reflection: `On se précipite vers ce qu'on aime. Se précipiter vers le mal révèle l'amour du mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tara kathiran minhum yusari'una fi al-ithmi wa al-'udwani wa aklihimu as-suht » — et tu en vois beaucoup d'entre eux se précipiter vers le péché, l'inimité et la consommation du mal illicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quoi je me précipite ? Vers le bien ou vers le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se précipiter vers le bien guérit le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers se précipite vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se précipite vers le bien reçoit la bénédiction." }
  ],
  munajat: `Ya Rabb, vers quoi je me précipite ? Change ma direction. Fais que je me précipite vers le bien, pas vers le mal.`
};

MIROIR["5:63"] = {
  reference: "5:63",
  theme: ["responsabilité", "savants", "silence"],
  emotion: "Interrogation, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakam"],
  mirrorVersion: `« Pourquoi les rabbins et les savants ne les empêchent-ils pas de tenir des propos pécheresses et de consommer l'illicite ? » Le miroir me pose une question sur la responsabilité des savants. « Lawla yanhahu al-ahbaru wa al-rabbaniyyun » — pourquoi les rabbins et les savants ne les empêchent-ils pas ? Le silence face au mal est une complicité. Le miroir m'interroge : qu'est-ce que je fais face au mal ?`,
  reflection: `Les savants ont la responsabilité de parler. Leur silence face au mal est une trahison de leur mission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawla yanhahu al-ahbaru wa al-rabbaniyyun 'an qawlihim al-ithma wa aklihimu as-suht » — pourquoi les rabbins et les savants ne les empêchent-ils pas de tenir des propos pécheresses et de consommer l'illicite ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois le mal, est-ce que je parle ? Ou est-ce que je me tais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Parler contre le mal est un devoir pour celui qui sait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se tait pas sur la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle contre le mal préserve sa communauté." }
  ],
  munajat: `Ya 'Alim, Tu m'as donné le savoir. Fais que je parle contre le mal. Ne permets pas que mon silence soit complice.`
};

MIROIR["5:65"] = {
  reference: "5:65",
  theme: ["mécréance", "miséricorde", "châtiment"],
  emotion: "Espoir, avertissement",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Ghaffur"],
  mirrorVersion: `« Si les gens du Livre avaient cru et craint, Nous aurions effacé leurs méfaits et les aurions fait entrer dans les jardins du délice. » Le miroir me montre la miséricorde conditionnelle. « Law anna ahla al-kitabi amanu wa ittaqaw » — s'ils avaient cru et craint. La foi et la crainte ouvrent la porte du pardon. « Lakaffarna 'anhum sayyi'atihim » — Nous aurions effacé leurs méfaits. Le miroir m'enseigne que la miséricorde est disponible pour ceux qui croient et craignent.`,
  reflection: `La miséricorde d'Allah est immense, mais elle demande la foi et la crainte. Ces deux conditions ouvrent toutes les portes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law anna ahla al-kitabi amanu wa ittaqaw lakaffarna 'anhum sayyi'atihim wa la-adkhalthum jannati an-na'im » — si les gens du Livre avaient cru et craint, Nous aurions effacé leurs méfaits et les aurions fait entrer dans les jardins du délice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois et crains ? Ces conditions sont-elles remplies dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde attend la foi et la crainte pour se déployer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est dans un état de soumission et de crainte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et craint reçoit l'effacement des méfaits." }
  ],
  munajat: `Ya Rahman, Ta miséricorde est immense. Donne-moi la foi et la crainte. Efface mes méfaits et fais-moi entrer dans Tes jardins.`
};

MIROIR["5:66"] = {
  reference: "5:66",
  theme: ["Livre", "pratique", "bénédiction"],
  emotion: "Espoir, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mubin"],
  mirrorVersion: `« S'ils avaient observé la Thora, l'Évangile et ce qui leur a été révélé de leur Seigneur, ils auraient joui des nourritures au-dessus d'eux et sous leurs pieds. » Le miroir me montre la bénédiction de la pratique. « Wa law annahum aqamu at-tawrata wa al-injila » — s'ils avaient observé la Thora et l'Évangile. La bénédiction suit la pratique. Le miroir m'enseigne que le Livre n'est pas seulement pour la lecture — il est pour la pratique.`,
  reflection: `La bénédiction n'est pas automatique — elle suit la pratique du Livre. Lire sans pratiquer ne suffit pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law annahum aqamu at-tawrata wa al-injila wa ma unzila ilayhim min rabbihim la-akalu min fawqihim wa min tahti arjulihim » — s'ils avaient observé la Thora, l'Évangile et ce qui leur a été révélé de leur Seigneur, ils auraient joui des nourritures au-dessus d'eux et sous leurs pieds." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pratique ce que je lis ? Ou est-ce que je lis sans pratiquer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bénédiction est le fruit de la pratique, pas de la simple lecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers pratique les lois divines naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique le Livre reçoit la bénédiction visible et invisible." }
  ],
  munajat: `Ya Hadi, Tu as révélé le Livre pour la pratique. Fais que je pratique ce que je lis. Donne-moi la bénédiction de l'observance.`
};

MIROIR["5:67"] = {
  reference: "5:67",
  theme: ["messager", "transmission", "protection"],
  emotion: "Confiance, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Rasul", "Al-Hafiz"],
  mirrorVersion: `« Ô Messager ! Transmets ce qui t'a été révélé de ton Seigneur. Si tu ne le fais pas, tu n'as pas transmis Son message. » Le miroir me montre la responsabilité du Messager. « Balligh ma unzila ilayka min rabbika » — transmets ce qui t'a été révélé. La transmission est obligatoire. « Wa in lam taf'al » — si tu ne le fais pas. L'échec de la transmission est l'échec de la mission. Mais ensuite vient la promesse : « Allah te protègera des gens. » La protection suit l'obéissance.`,
  reflection: `Le Messager a la responsabilité de transmettre. La protection d'Allah est promise à celui qui obéit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha ar-rasulu balligh ma unzila ilayka min rabbika wa in lam taf'al fama ballaghta risalatah » — ô Messager ! Transmets ce qui t'a été révélé de ton Seigneur. Si tu ne le fais pas, tu n'as pas transmis Son message." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois transmettre ? Est-ce que je transmets la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est avec celui qui transmet Sa parole." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier transmet la parole d'Allah par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui transmet la vérité est protégé par la Vérité." }
  ],
  munajat: `Ya Rabb, Tu as confié la transmission à Ton Messager. Fais que je sois parmi ceux qui transmettent la vérité. Protège-moi comme Tu l'as protégé.`
};

MIROIR["5:68"] = {
  reference: "5:68",
  theme: ["Livre", "obligation", "foi"],
  emotion: "Responsabilité, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hadi"],
  mirrorVersion: `« Dis : 'Ô gens du Livre, vous ne vous fondez sur rien tant que vous n'observez pas la Thora, l'Évangile et ce qui vous a été révélé de votre Seigneur.' » Le miroir me montre l'obligation du Livre. « Lastum 'ala shay'in » — vous ne vous fondez sur rien. Sans le Livre, il n'y a pas de fondation. Le Livre est le socle. Le miroir m'interroge : sur quoi je me fonde ?`,
  reflection: `Sans le Livre, la vie est sans fondation. Le Livre donne le sens, la direction, la loi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ahla al-kitabi lastum 'ala shay'in hatta tuqimu at-tawrata wa al-injila wa ma unzila ilaykum min rabbikum » — dis : ô gens du Livre, vous ne vous fondez sur rien tant que vous n'observez pas la Thora, l'Évangile et ce qui vous a été révélé de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je me fonde ? Sur le Livre ou sur autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Livre est la fondation, tout le reste est superficiel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fondé sur les lois divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se fonde sur le Livre est inébranlable." }
  ],
  munajat: `Ya Hadi, je veux me fonder sur Ton Livre. Ne permets pas que je cherche une autre fondation. Donne-moi la stabilité de Ta parole.`
};

MIROIR["5:69"] = {
  reference: "5:69",
  theme: ["foi", "salvation", "communauté"],
  emotion: "Espoir, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Waliyy"],
  mirrorVersion: `« Ceux qui croient, ceux qui pratiquent le judaïsme, les Sabéens et les Chrétiens, quiconque croit en Allah et au Jour dernier et fait le bien, nulle crainte sur eux et ils ne seront point affligés. » Le miroir me montre l'universalité de la salvation. « Man amana bi-Allahi wa al-yawmi al-akhiri wa 'amila salihan » — quiconque croit en Allah et au Jour dernier et fait le bien. La foi et les œuvres sont les critères, pas l'appartenance nominale. Le miroir m'enseigne que la salvation est ouverte à tous.`,
  reflection: `La salvation n'est pas réservée à une communauté nominale. Elle est pour quiconque croit et fait le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa alladhina hadu wa as-sabi'una wa an-nasara man amana bi-Allahi wa al-yawmi al-akhiri wa 'amila salihan fala khawfun 'alayhim wa la hum yahzanun » — ceux qui croient, ceux qui pratiquent le judaïsme, les Sabéens et les Chrétiens, quiconque croit en Allah et au Jour dernier et fait le bien, nulle crainte sur eux et ils ne seront point affligés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment ? Est-ce que je fais le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appartenance nominale ne suffit pas — la foi et les œuvres comptent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier croit en son Créateur et fait le bien naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et fait le bien n'a ni crainte ni tristesse." }
  ],
  munajat: `Ya Mu'min, je crois en Toi et au Jour dernier. Fais que je fasse le bien. Donne-moi la sécurité et la paix promises.`
};

MIROIR["5:70"] = {
  reference: "5:70",
  theme: ["prophètes", "rejet", "conséquence"],
  emotion: "Tristesse, leçon",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Haqq"],
  mirrorVersion: `« Nous avions conclu une alliance avec les Enfants d'Israël et Nous avons envoyé des prophètes. Mais chaque fois qu'un prophète leur venait avec ce qui ne leur plaisait pas, ils traitaient certains de menteurs et en tuaient d'autres. » Le miroir me montre le rejet obstiné. « Kullama ja'ahum rasulun bima la tahwa anfusuhum » — chaque fois qu'un prophète leur venait avec ce qui ne leur plaisait pas. Le prophète qui dérange est rejeté. Le miroir m'avertit : la vérité qui dérange est souvent rejetée.`,
  reflection: `Le prophète qui dérange est rejeté. La vérité qui ne plaît pas est tuée. L'histoire se répète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad akhadhna mithaqa bani Isra'ila wa arsalna ilayhim rusulan kullama ja'ahum rasulun bima la tahwa anfusuhum kadhdhabu bi-fariqin wa qatalu fariqan » — Nous avions conclu une alliance avec les Enfants d'Israël et Nous avons envoyé des prophètes. Mais chaque fois qu'un prophète leur venait avec ce qui ne leur plaisait pas, ils traitaient certains de menteurs et en tuaient d'autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la vérité qui me dérange ? Est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité qui dérange est souvent la plus nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte toutes les vérités naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité qui dérange grandit." }
  ],
  munajat: `Ya Haqq, la vérité me dérange parfois. Fais que je l'accepte. Ne permets pas que je sois parmi ceux qui rejettent Tes prophètes.`
};

MIROIR["5:71"] = {
  reference: "5:71",
  theme: ["illusion", "épreuve", "égarement"],
  emotion: "Avertissement, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Ils ont cru qu'il n'y aurait pas d'épreuve, ils sont devenus aveugles et sourds. Puis Allah accueillit leur repentir. Puis beaucoup d'entre eux redevenaient aveugles et sourds. » Le miroir me montre l'illusion de sécurité. « Wa hasibu an takuna fitnah » — ils ont cru qu'il n'y aurait pas d'épreuve. L'illusion de sécurité mène à l'aveuglement. Le repentir est accepté, mais la récidive est possible. Le miroir m'avertit : l'aveuglement peut revenir.`,
  reflection: `Croire qu'il n'y a pas d'épreuve est une illusion. L'épreuve vient toujours. Le repentir est possible, mais la vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hasibu an takuna fitnatun fa'mu wa samumu thumma taba Allahu 'alayhim thumma 'ammu wa samu kathirun minhum » — ils ont cru qu'il n'y aurait pas d'épreuve, ils sont devenus aveugles et sourds. Puis Allah accueillit leur repentir. Puis beaucoup d'entre eux redevenaient aveugles et sourds." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense qu'il n'y a pas d'épreuve ? Suis-je en train de devenir aveugle et sourd ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est certaine, la préparation est nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en état d'épreuve constante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attend à l'épreuve n'est pas surpris." }
  ],
  munajat: `Ya Hadi, je m'attends à l'épreuve. Ne permets pas que je devienne aveugle et sourd. Donne-moi la vigilance constante.`
};

MIROIR["5:72"] = {
  reference: "5:72",
  theme: ["Jésus", "divinité", "mécréance"],
  emotion: "Avertissement, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Al-Wahid"],
  mirrorVersion: `« Ce sont mécréants ceux qui disent : 'Allah est le Messie, fils de Marie.' Le Messie a dit : 'Ô Enfants d'Israël, adorez Allah, mon Seigneur et votre Seigneur.' » Le miroir me montre la divinité de Jésus réfutée. « Laqad kafara alladhina qalu inna Allaha huwa al-masihu ibnu Maryam » — ce sont mécréants ceux qui disent qu'Allah est le Messie. Jésus lui-même nie cette divinité. Il est serviteur, pas Seigneur. Le miroir m'enseigne l'unicité pure.`,
  reflection: `Jésus est serviteur d'Allah, pas Allah lui-même. L'association est la plus grande mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad kafara alladhina qalu inna Allaha huwa al-masihu ibnu Maryam » — ce sont mécréants ceux qui disent : Allah est le Messie, fils de Marie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends l'unicité d'Allah ? Jésus est serviteur, pas divin." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serviteur qui se dit divin devient mécréant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reconnaît un seul Dieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'unicité comprend tout." }
  ],
  munajat: `Ya Wahid, Tu es Un. Jésus est Ton serviteur. Fais que je comprenne l'unicité pure. Ne permets pas que je m'égare dans l'association.`
};

MIROIR["5:73"] = {
  reference: "5:73",
  theme: ["trinité", "unicité", "mécréance"],
  emotion: "Avertissement, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Ce sont mécréants ceux qui disent : 'Allah est le troisième de trois.' Il n'y a de divinité qu'un seul Dieu. » Le miroir me montre la trinité réfutée. « Inna Allaha thalithu thalathah » — Allah est le troisième de trois. Cette affirmation est de la mécréance. « Ma min ilahin illa ilahun wahid » — il n'y a de divinité qu'un seul Dieu. L'unicité est absolue. Le miroir m'enseigne la pureté du tawhid.`,
  reflection: `La trinité est une invention humaine. L'unicité est la vérité éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad kafara alladhina qalu inna Allaha thalithu thalathah wa ma min ilahin illa ilahun wahid » — ce sont mécréants ceux qui disent : Allah est le troisième de trois. Il n'y a de divinité qu'un seul Dieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends l'unicité absolue ? Mon cœur est-il pur de toute association ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unicité est simple, la complexité est humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de l'unicité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise l'unicité réalise tout." }
  ],
  munajat: `Ya Ahad, Tu es Un. Fais que je réalise l'unicité absolue. Purifie mon cœur de toute association.`
};

MIROIR["5:74"] = {
  reference: "5:74",
  theme: ["repentir", "miséricorde", "pardon"],
  emotion: "Espoir, invitation",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Ne se repentiront-ils pas à Allah et ne Lui demanderont-ils pas pardon ? Allah est Pardonneur et Miséricordieux. » Le miroir me montre la porte ouverte du repentir. « A-fa-la yatubuna ila Allah » — ne se repentiront-ils pas à Allah ? Le repentir est toujours possible. « Allahu ghafurun rahim » — Allah est Pardonneur et Miséricordieux. Le miroir m'invite au repentir constant.`,
  reflection: `Le repentir est toujours possible. La miséricorde est toujours disponible. Il suffit de revenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-la yatubuna ila Allah wa yastaghfirunah wa Allahu ghafurun rahim » — ne se repentiront-ils pas à Allah et ne Lui demanderont-ils pas pardon ? Allah est Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens ? Est-ce que je demande pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir est la clé qui ouvre toutes les portes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier retourne à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent constamment est constamment purifié." }
  ],
  munajat: `Ya Tawwab, je me repens à Toi. Pardonne-moi. Ta miséricorde est immense. Ne permets pas que je désespère.`
};

MIROIR["5:75"] = {
  reference: "5:75",
  theme: ["Jésus", "humanité", "prophète"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Ar-Rasul"],
  mirrorVersion: `« Le Messie, fils de Marie, n'est qu'un messager. Des messagers sont passés avant lui. Et sa mère était une véridique. Tous deux mangeaient de la nourriture. » Le miroir me montre l'humanité de Jésus et Marie. « Ma al-masihu ibnu Maryama illa rasul » — le Messie n'est qu'un messager. Il n'est pas divin. « Kana ya'kulani at-ta'am » — tous deux mangeaient. Manger est le signe de la créature. Le miroir m'enseigne que Jésus est humain, prophète, pas Dieu.`,
  reflection: `Manger est le signe de la créature. Jésus mangeait. Il n'est donc pas le Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma al-masihu ibnu Maryama illa rasulun qad khalat min qablihi ar-rusulu wa ummuhu siddiqah kana ya'kulani at-ta'am » — le Messie, fils de Marie, n'est qu'un messager. Des messagers sont passés avant lui. Et sa mère était une véridique. Tous deux mangeaient de la nourriture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends l'humanité des prophètes ? Ils sont des créatures, pas le Créateur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La créature qui mange ne peut être le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a besoin de nourriture. Le Créateur n'en a pas besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la différence entre Créateur et créature comprend tout." }
  ],
  munajat: `Ya Rabb, Tu es le Créateur. Jésus est une créature. Fais que je comprenne la différence. Ne permets pas que je confonde créature et Créateur.`
};

MIROIR["5:76"] = {
  reference: "5:76",
  theme: ["divinité", "impuissance", "guidance"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Dis : 'Adorerez-vous, au lieu d'Allah, ce qui ne peut ni vous nuire ni vous profiter ?' » Le miroir me montre l'impuissance des fausses divinités. « Ata'buduna min duni Allahi ma la yamlikukum darran wa la naf'an » — adorerez-vous au lieu d'Allah ce qui ne peut ni vous nuire ni vous profiter ? Les fausses divinités sont impuissantes. Le miroir m'invite à adorer le seul qui peut.`,
  reflection: `Pourquoi adorer ce qui ne peut rien ? La vraie adoration est pour Celui qui peut tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ata'buduna min duni Allahi ma la yamlikukum darran wa la naf'an » — dis : adorerez-vous, au lieu d'Allah, ce qui ne peut ni vous nuire ni vous profiter ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore ? Est-ce que cela peut me profiter ou me nuire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration de l'impuissant est un gaspillage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier adore Celui qui peut tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore le Tout-Puissant reçoit tout." }
  ],
  munajat: `Ya Qadir, Tu peux tout. Fais que je T'adore seul. Ne permets pas que j'adore ce qui ne peut rien.`
};

MIROIR["5:77"] = {
  reference: "5:77",
  theme: ["excès", "religion", "égarement"],
  emotion: "Avertissement, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mustaqim"],
  mirrorVersion: `« Dis : 'Ô gens du Livre ! N'exagérez pas dans votre religion, en dehors de la vérité.' » Le miroir me montre le danger de l'exagération. « La taghlu fi dinikum ghayra al-haqq » — n'exagérez pas dans votre religion en dehors de la vérité. L'exagération même religieuse est un égarement. Le miroir m'avertit : la religion doit rester dans la vérité, pas l'excès.`,
  reflection: `L'exagération religieuse est un égarement. La religion est vérité, pas excès.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ahla al-kitabi la taghlu fi dinikum ghayra al-haqq » — dis : ô gens du Livre ! N'exagérez pas dans votre religion, en dehors de la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'exagère dans ma religion ? Ou est-ce que je reste dans la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est équilibrée, l'excès est déséquilibré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est dans l'équilibre, pas dans l'excès." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste dans la vérité reste dans le droit chemin." }
  ],
  munajat: `Ya Haqq, la vérité est Ton chemin. Fais que je reste dans la vérité. Ne permets pas que j'exagère et m'égare.`
};

MIROIR["5:78"] = {
  reference: "5:78",
  theme: ["malédiction", "désobéissance", "conséquence"],
  emotion: "Avertissement, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-La'in", "Al-'Adl"],
  mirrorVersion: `« Ont été maudits les mécréants parmi les Enfants d'Israël par la bouche de David et de Jésus, fils de Marie. » Le miroir me montre la malédiction des désobéissants. « Lu'ina alladhina kafaru min bani Isra'ila » — ont été maudits les mécréants parmi les Enfants d'Israël. La désobéissance prolongée attire la malédiction. Le miroir m'avertit : la désobéissance a des conséquences.`,
  reflection: `La malédiction est la conséquence de la désobéissance obstinée. Les prophètes ont maudit les désobéissants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lu'ina alladhina kafaru min bani Isra'ila 'ala lisani Dawuda wa 'Isa ibni Maryam » — ont été maudits les mécréants parmi les Enfants d'Israël par la bouche de David et de Jésus, fils de Marie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la malédiction ? Est-ce que j'évite la désobéissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance attire la bénédiction, la désobéissance attire la malédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit naturellement, pas de malédiction sur lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit est béni, celui qui désobéit est maudit." }
  ],
  munajat: `Ya Rabb, je crains la malédiction. Fais que j'obéisse. Ne permets pas que je sois parmi les maudits.`
};

MIROIR["5:79"] = {
  reference: "5:79",
  theme: ["interdiction", "mal", "responsabilité"],
  emotion: "Responsabilité, sérieux",
  difficulty: "débutant",
  relatedNames: ["An-Nahy", "Al-Ma'ruf"],
  mirrorVersion: `« Ils ne se recommandaient pas mutuellement de s'abstenir du mal qu'ils faisaient. » Le miroir me montre la responsabilité collective. « Kanu la yatanahawna 'an munkarin fa'aluh » — ils ne se recommandaient pas mutuellement de s'abstenir du mal. Le silence face au mal est une complicité. Le miroir m'invite à recommander le bien et interdire le mal.`,
  reflection: `Ne pas recommander le bien est un mal. Le silence complice est condamnable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kanu la yatanahawna 'an munkarin fa'aluh » — ils ne se recommandaient pas mutuellement de s'abstenir du mal qu'ils faisaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recommande le bien ? Est-ce que j'interdis le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Recommander le bien est un devoir collectif." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers naturellement recommande le bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui recommande le bien préserve la communauté." }
  ],
  munajat: `Ya Rabb, je veux recommander le bien et interdire le mal. Donne-moi le courage de parler. Ne permets pas que mon silence soit complice.`
};

MIROIR["5:80"] = {
  reference: "5:80",
  theme: ["alliance", "désobéissance", "conséquence"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Bara'ah"],
  mirrorVersion: `« Tu en vois beaucoup qui prennent pour alliés les mécréants. Comme est mauvais ce qu'ils ont fait pour eux-mêmes ! » Le miroir me montre l'alliance injuste. « Tara kathiran minhum yatawallawna alladhina kafaru » — tu en vois beaucoup qui prennent pour alliés les mécréants. L'alliance avec les ennemis d'Allah est une trahison. Le miroir m'avertit : choisir ses alliés est un acte sérieux.`,
  reflection: `L'alliance avec les mécréants est mauvaise pour soi-même. On devient ce qu'on fréquente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tara kathiran minhum yatawallawna alladhina kafaru la-bi'sa ma qaddamat lahum anfusuhum » — tu en vois beaucoup qui prennent pour alliés les mécréants. Comme est mauvais ce qu'ils ont fait pour eux-mêmes !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes alliés ? Sont-ils des croyants ou des mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance juste est avec les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'allie avec son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'allie avec Allah ne perd jamais." }
  ],
  munajat: `Ya Waliyy, Tu es mon Allié. Fais que mes alliés soient ceux qui T'aiment. Ne permets pas que je m'allie avec Tes ennemis.`
};

MIROIR["5:81"] = {
  reference: "5:81",
  theme: ["foi", "alliance", "hypocrisie"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "An-Nur"],
  mirrorVersion: `« S'ils croyaient en Allah, au Prophète et à ce qui lui a été révélé, ils ne les prendraient pas pour alliés. » Le miroir me montre le lien entre foi et alliance. « Law kanu yu'minuna bi-Allahi wa an-nabiyyi wa ma unzila ilayhi » — s'ils croyaient en Allah, au Prophète et à ce qui lui a été révélé. La foi implique la bonne alliance. L'hypocrisie se voit dans les alliances. Le miroir m'interroge : mes alliances révèlent-elles ma foi ?`,
  reflection: `La foi change les alliances. On ne fréquente pas les ennemis de ce qu'on aime.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kanu yu'minuna bi-Allahi wa an-nabiyyi wa ma unzila ilayhi ma ittakhaduhum awliya' » — s'ils croyaient en Allah, au Prophète et à ce qui lui a été révélé, ils ne les prendraient pas pour alliés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes alliances révèlent-elles ma foi ? Ou révèlent-elles mon hypocrisie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie foi se voit dans les choix d'alliance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'allie naturellement avec son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont la foi est sincère a des alliances sincères." }
  ],
  munajat: `Ya Mu'min, je crois en Toi. Fais que mes alliances soient conformes à ma foi. Ne permets pas que je sois hypocrite.`
};

MIROIR["5:82"] = {
  reference: "5:82",
  theme: ["amitié", "chrétiens", "croyants"],
  emotion: "Espoir, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Mu'min"],
  mirrorVersion: `« Tu trouveras que les plus proches en affection des croyants sont ceux qui disent : 'Nous sommes chrétiens.' C'est qu'il y a parmi eux des prêtres et des moines, et qu'ils ne s'enorgueillissent pas. » Le miroir me montre une exception positive. « Latajiddanna aqrabahum mawaddatan lilladhina amanu alladhina qalu inna nasara » — tu trouveras que les plus proches en affection sont ceux qui disent nous sommes chrétiens. Certains chrétiens sont plus ouverts à la vérité. Le miroir m'enseigne que l'humilité ouvre le cœur.`,
  reflection: `L'humilité des prêtres et des moines les rapproche de la vérité. L'orgueil éloigne, l'humilité rapproche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Latajiddanna aqrabahum mawaddatan lilladhina amanu alladhina qalu inna nasara dhalika bi-anna minhum qissisina wa ruhbanan wa annahum la yastakbirun » — tu trouveras que les plus proches en affection des croyants sont ceux qui disent : nous sommes chrétiens. C'est qu'il y a parmi eux des prêtres et des moines, et qu'ils ne s'enorgueillissent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis humble ? L'humilité ouvre-t-elle mon cœur à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil ferme le cœur, l'humilité l'ouvre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est humble devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble reconnaît la vérité." }
  ],
  munajat: `Ya Wadud, l'humilité rapproche de la vérité. Fais que je sois humble. Ouvre mon cœur à ceux qui cherchent la vérité.`
};

MIROIR["5:84"] = {
  reference: "5:84",
  theme: ["foi", "soumission", "espérance"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Waliyy"],
  mirrorVersion: `« Et quand ils entendent ce qui a été révélé au Messager, tu vois leurs yeux déborder de larmes. » Le miroir me montre la réaction des croyants sincères. « Tara a'yunahum tafidu mina ad-dam'i » — tu vois leurs yeux déborder de larmes. Les larmes sont le signe de la reconnaissance. La vérité touche le cœur. Le miroir m'invite à laisser la vérité me toucher.`,
  reflection: `Les larmes devant la vérité sont le signe d'un cœur vivant. Un cœur qui ne pleure pas est peut-être mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha sami'u ma unzila ila ar-rasuli tara a'yunahum tafidu mina ad-dam'i » — et quand ils entendent ce qui a été révélé au Messager, tu vois leurs yeux déborder de larmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que la vérité me fait pleurer ? Mon cœur est-il assez ouvert pour réagir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les larmes de reconnaissance lavent le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier réagit à la présence divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pleure devant la vérité est purifié." }
  ],
  munajat: `Ya Mu'min, fais que la vérité me touche. Ouvre mon cœur aux larmes de reconnaissance. Ne permets pas que je reste insensible.`
};

MIROIR["5:85"] = {
  reference: "5:85",
  theme: ["récompense", "foi", "paradis"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wadud"],
  mirrorVersion: `« Allah les a récompensés pour ce qu'ils ont dit par des jardins sous lesquels coulent les rivières. » Le miroir me montre la récompense de la foi sincère. « Fa-ajazahumu Allahu bima qalu jannatin tajri min tahtiha al-anhar » — Allah les a récompensés par des jardins sous lesquels coulent les rivières. La parole sincère attire la récompense. Le miroir m'invite à parler avec sincérité.`,
  reflection: `La parole sincère est récompensée. Ce qu'on dit avec le cœur compte auprès d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ajazahumu Allahu bima qalu jannatin tajri min tahtiha al-anhar khalidina fiha » — Allah les a récompensés pour ce qu'ils ont dit par des jardins sous lesquels coulent les rivières, où ils demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dis avec sincérité ? Ma parole mérite-t-elle une récompense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole du cœur rejoint le Cœur divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers parle le langage de la sincérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle avec sincérité reçoit plus que ce qu'il dit." }
  ],
  munajat: `Ya Rabb, récompense ma sincérité. Fais que mes paroles soient vraies. Donne-moi les jardins promis aux croyants sincères.`
};

MIROIR["5:86"] = {
  reference: "5:86",
  theme: ["mécréance", "châtiment", "conséquence"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Jahim"],
  mirrorVersion: `« Mais ceux qui ont mécru et traité de mensonges Nos signes, ceux-là sont les gens de la Fournaise. » Le miroir me montre le destin des mécréants. « Wa alladhina kafaru wa kadhdhabu bi-ayatina ula'ika ashabu al-jahim » — ceux qui ont mécru et traité de mensonges Nos signes sont les gens de la Fournaise. Le rejet a des conséquences. Le miroir m'avertit : le rejet de la vérité n'est pas sans prix.`,
  reflection: `Le rejet de la vérité mène au châtiment. La mécréance n'est pas un choix innocent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kafaru wa kadhdhabu bi-ayatina ula'ika ashabu al-jahim » — mais ceux qui ont mécru et traité de mensonges Nos signes, ceux-là sont les gens de la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette des signes ? Suis-je en danger de mécréance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la vérité mène au Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte tous les signes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes échappe à la Fournaise." }
  ],
  munajat: `Ya 'Adl, Tu es Juste. Préserve-moi de la mécréance. Fais que j'accepte Tes signes. Ne permets pas que je sois parmi les gens de la Fournaise.`
};

MIROIR["5:87"] = {
  reference: "5:87",
  theme: ["interdits", "excès", "légalité"],
  emotion: "Modération, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Ô vous qui croyez ! Ne déclarez pas illicites les bonnes choses qu'Allah vous a rendues licites. » Le miroir me montre le danger de l'excès d'abstinence. « La tuharrimu tayyibati ma ahala Allahu lakum » — ne déclarez pas illicites les bonnes choses qu'Allah a rendues licites. L'interdit auto-imposé est une innovation. Le miroir m'enseigne l'équilibre entre permission et interdiction.`,
  reflection: `Rendre illicite ce qu'Allah a rendu licite est une innovation. La modération est le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la tuharrimu tayyibati ma ahala Allahu lakum » — ô vous qui croyez ! Ne déclarez pas illicites les bonnes choses qu'Allah vous a rendues licites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'interdis ce qu'Allah m'a permis ? Est-ce que je fais preuve d'excès ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excès d'abstinence peut être aussi nuisible que l'excès de jouissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est dans l'équilibre entre permission et interdiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites d'Allah trouve l'équilibre." }
  ],
  munajat: `Ya Halal, Tu as permis le bon. Fais que je respecte Tes limites sans excès. Donne-moi la modération dans tout.`
};

MIROIR["5:88"] = {
  reference: "5:88",
  theme: ["nourriture", "licite", "croyance"],
  emotion: "Gratitude, conscience",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "At-Tayyib"],
  mirrorVersion: `« Mangez de ce qu'Allah vous a attribué de licite et de bon. Et craignez Allah en qui vous croyez. » Le miroir me montre le lien entre nourriture et foi. « Kulu min ma razaqakumu Allahu halalan tayyiban » — mangez de ce qu'Allah vous a attribué de licite et de bon. La nourriture licite nourrit le corps et l'âme. La crainte d'Allah accompagne la consommation. Le miroir m'invite à la conscience dans ce que je mange.`,
  reflection: `La nourriture licite et bonne est une bénédiction. La manger avec conscience est un acte d'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu min ma razaqakumu Allahu halalan tayyiban wa ittaqu Allaha alladhi antum bihi mu'minun » — mangez de ce qu'Allah vous a attribué de licite et de bon. Et craignez Allah en qui vous croyez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je mange ? Est-ce licite et bon ? Est-ce que je mange avec conscience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture illicite nourrit le corps mais empoisonne l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature mange ce que son Créateur lui a attribué." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange licite avec gratitude reçoit la bénédiction." }
  ],
  munajat: `Ya Razzaq, Tu m'as donné le licite et le bon. Fais que je mange avec conscience et gratitude. Ne permets pas que je consume l'illicite.`
};

MIROIR["5:89"] = {
  reference: "5:89",
  theme: ["serment", "expiation", "responsabilité"],
  emotion: "Sérieux, réparation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amanah", "Al-Ghaffur"],
  mirrorVersion: `« Allah ne vous tient pas rigueur de l'imprudence dans vos serments, mais Il vous tient rigueur des serments que vous avez scellés. » Le miroir me montre la gravité des serments. « La yu'akhidhukumu Allahu bi-l-laghwi fi aymanikum » — Allah ne vous tient pas rigueur de l'imprudence. « Wa lakin yu'akhidhukum bima 'aqqadtumu al-ayman » — mais Il vous tient rigueur des serments scellés. Le serment est une promesse. Le miroir m'enseigne la responsabilité de la parole donnée.`,
  reflection: `Le serment n'est pas une parole légère. L'imprudence est pardonnée, mais le serment intentionnel engage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yu'akhidhukumu Allahu bi-l-laghwi fi aymanikum wa lakin yu'akhidhukum bima 'aqqadtumu al-ayman » — Allah ne vous tient pas rigueur de l'imprudence dans vos serments, mais Il vous tient rigueur des serments que vous avez scellés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels serments ai-je faits ? Est-ce que je les respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment intentionnel engage et nécessite réparation s'il est rompu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tient ses promesses par sa constance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte ses serments est digne de confiance." }
  ],
  munajat: `Ya Amanah, mes serments T'engagent. Fais que je respecte mes promesses. Pardonne mon imprudence et aide-moi à réparer mes ruptures.`
};

MIROIR["5:91"] = {
  reference: "5:91",
  theme: ["alcool", "jeu", "Satan"],
  emotion: "Avertissement, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Najiy", "Al-Hadi"],
  mirrorVersion: `« Le Satan ne veut que jeter parmi vous l'inimité et la haine par l'alcool et le jeu de hasard. » Le miroir me montre les conséquences cachées des interdits. « Innama yuridu ash-shaytanu an yuqi'a baynakumu al-'adawata wa al-baghda'a » — le Satan ne veut que jeter parmi vous l'inimité et la haine. L'alcool et le jeu ne sont pas des divertissements innocents — ils sont des pièges. Le miroir m'avertit : derrière le plaisir apparent se cache la discorde.`,
  reflection: `L'alcool et le jeu créent l'inimité et la haine. Le plaisir apparent cache la destruction réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yuridu ash-shaytanu an yuqi'a baynakumu al-'adawata wa al-baghda'a fi al-khamri wa al-maysiri » — le Satan ne veut que jeter parmi vous l'inimité et la haine par l'alcool et le jeu de hasard." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui crée l'inimité et la haine dans ma vie ? Suis-je victime des pièges de Satan ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement de l'alcool et du jeu préserve la fraternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas l'ivresse ni le jeu de hasard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les pièges de Satan préserve sa communauté." }
  ],
  munajat: `Ya Najiy, protège-moi des pièges de Satan. Fuis l'alcool et le jeu qui mènent à la discorde. Préserve la fraternité entre les croyants.`
};

MIROIR["5:92"] = {
  reference: "5:92",
  theme: ["obéissance", "messager", "responsabilité"],
  emotion: "Sérieux, engagement",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rasul"],
  mirrorVersion: `« Obéissez à Allah, obéissez au Messager et prenez garde ! » Le miroir me montre le chemin clair. « Wa ati'u Allaha wa ati'u ar-rasula wa ihdharu » — obéissez à Allah, obéissez au Messager et prenez garde. L'obéissance est double : à Allah et à Son Messager. La vigilance est constante. Le miroir m'invite à l'obéissance totale.`,
  reflection: `L'obéissance à Allah passe par l'obéissance au Messager. Les deux sont liées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ati'u Allaha wa ati'u ar-rasula wa ihdharu » — obéissez à Allah, obéissez au Messager et prenez garde !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis à Allah ? Est-ce que j'obéis au Messager ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance au Messager est l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit naturellement à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit totalement est totalement guidé." }
  ],
  munajat: `Ya Allah, je T'obéis. Ya Rasul, je T'obéis. Fais que mon obéissance soit totale. Ne permets pas que je désobéisse.`
};

MIROIR["5:93"] = {
  reference: "5:93",
  theme: ["foi", "œuvres", "innocence"],
  emotion: "Paix, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Barr", "At-Tayyib"],
  mirrorVersion: `« Il n'y a pas de péché sur ceux qui croient et font de bonnes œuvres pour ce qu'ils ont mangé, s'ils craignent et croient et font de bonnes œuvres. » Le miroir me montre l'innocence du croyant. « Laysa 'ala alladhina amanu wa 'amilu as-salihati junahun » — il n'y a pas de péché sur ceux qui croient et font de bonnes œuvres. La foi, la crainte et les bonnes œuvres purifient. Le miroir m'enseigne que la voie du croyant est pure.`,
  reflection: `La foi, la crainte et les bonnes œuvres lavent les péchés mineurs. Le croyant sincère est innocent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laysa 'ala alladhina amanu wa 'amilu as-salihati junahun fi ma ta'imu idha ma ittaqaw wa amanu wa 'amilu as-salihat » — il n'y a pas de péché sur ceux qui croient et font de bonnes œuvres pour ce qu'ils ont mangé, s'ils craignent et croient et font de bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois, crains et fais le bien ? Ces trois purifient ma vie." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans les œuvres est incomplète, les œuvres sans la foi sont vides." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croit, craint et fait le bien naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a les trois n'a pas de péché sur lui." }
  ],
  munajat: `Ya Barr, purifie ma vie par la foi, la crainte et les bonnes œuvres. Ne permets pas que le péché m'atteigne.`
};

MIROIR["5:94"] = {
  reference: "5:94",
  theme: ["test", "chasse", "pièges"],
  emotion: "Vigilance, prudence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhit", "Al-Khabir"],
  mirrorVersion: `« Ô vous qui croyez ! Allah vous éprouvera par une chasse que vos mains et vos lances atteindront. » Le miroir me montre que la vie est un test constant. « La-yablawannakumu Allahu bi-shay'in mina as-saydi » — Allah vous éprouvera par une chasse. Les tests sont variés. Les mains et les lances représentent les moyens faciles et difficiles. Le miroir m'avertit : la facilité n'est pas toujours une bénédiction.`,
  reflection: `Les tests viennent sous de nombreuses formes. La facilité peut être un piège, la difficulté peut être une élévation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la-yablawannakumu Allahu bi-shay'in mina as-saydi tanaluhu aydikum wa rimahukum » — ô vous qui croyez ! Allah vous éprouvera par une chasse que vos mains et vos lances atteindront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels tests traverse-je ? Suis-je vigilant face aux pièges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le test révèle la vraie nature du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en état de test permanent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe le test reçoit l'élévation." }
  ],
  munajat: `Ya Muhit, Tu m'éprouves. Donne-moi la vigilance face aux tests. Ne permets pas que je tombe dans les pièges.`
};

MIROIR["5:95"] = {
  reference: "5:95",
  theme: ["chasse", "interdiction", "expiation"],
  emotion: "Responsabilité, réparation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haram", "Al-Kaffarah"],
  mirrorVersion: `« Ô vous qui croyez ! Ne tuez pas le gibier pendant que vous êtes en état d'ihram. » Le miroir me montre les limites sacrées. « La taqtulu as-sayda wa antum hurum » — ne tuez pas le gibier pendant que vous êtes en état d'ihram. L'état sacré impose des limites. Leur violation nécessite une expiation. Le miroir m'enseigne que les limites sacrées ne sont pas à prendre à la légère.`,
  reflection: `L'ihram est un état sacré. Les interdits pendant l'ihram sont stricts. La violation engage la responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la taqtulu as-sayda wa antum hurum » — ô vous qui croyez ! Ne tuez pas le gibier pendant que vous êtes en état d'ihram." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles limites sacrées dois-je respecter ? Suis-je conscient de mes obligations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les limites sacrées protègent le sacré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte toutes les limites divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites sacrées est sanctifié." }
  ],
  munajat: `Ya Haram, les limites sacrées sont Tes limites. Fais que je les respecte. Pardonne-moi si je les viole par inadvertance.`
};

MIROIR["5:96"] = {
  reference: "5:96",
  theme: ["mer", "nourriture", "permission"],
  emotion: "Gratitude, facilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Halal"],
  mirrorVersion: `« La chasse en mer vous est permise, ainsi que ce qu'elle vous fournit comme nourriture. » Le miroir me montre la permission généreuse d'Allah. « Uhilla lakum saydu al-bahri wa ta'amuhu » — la chasse en mer vous est permise, ainsi que sa nourriture. La mer est source de provision. Le miroir m'invite à la gratitude pour cette permission.`,
  reflection: `La mer est une source de nourriture permise. La générosité d'Allah est visible dans Ses permissions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uhilla lakum saydu al-bahri wa ta'amuhu mata'an lakum » — la chasse en mer vous est permise, ainsi que ce qu'elle vous fournit comme nourriture, pour votre jouissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les permissions d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission est une miséricorde, l'interdiction est une protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mer est une création d'Allah au service de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour les permissions reçoit plus." }
  ],
  munajat: `Ya Razzaq, Tu as permis les nourritures de la mer. Je suis reconnaissant. Bénis ma provision et fais que je Te remercie.`
};

MIROIR["5:97"] = {
  reference: "5:97",
  theme: ["Ka'aba", "sacré", "protection"],
  emotion: "Révérence, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Bayt", "Al-Haram"],
  mirrorVersion: `« Allah a institué la Ka'aba, la Maison sacrée, comme un lieu de culte pour les gens. » Le miroir me montre le centre sacré. « Ja'ala Allahu al-ka'bata al-bayta al-harama qiyaman li-nnas » — Allah a institué la Ka'aba, la Maison sacrée, comme un lieu de culte pour les gens. La Ka'aba est le point d'ancrage. Le miroir m'invite à honorer ce lieu sacré.`,
  reflection: `La Ka'aba est le centre spirituel de l'humanité. L'honorer, c'est honorer Celui qui l'a instituée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ja'ala Allahu al-ka'bata al-bayta al-harama qiyaman li-nnas » — Allah a institué la Ka'aba, la Maison sacrée, comme un lieu de culte pour les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon rapport avec la Ka'aba ? Est-ce que je l'honore comme je dois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Ka'aba est le centre, le cœur du croyant est le miroir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier gravite autour de ce centre spirituel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore la Ka'aba honore son Seigneur." }
  ],
  munajat: `Ya Bayt, Tu es la Maison d'Allah. Fais que je T'honore. Bénis mon pèlerinage et accepte mon adoration.`
};

MIROIR["5:98"] = {
  reference: "5:98",
  theme: ["punition", "miséricorde", "équilibre"],
  emotion: "Crainte, espoir",
  difficulty: "débutant",
  relatedNames: ["Ash-Shadid", "Ar-Rahim"],
  mirrorVersion: `« Sachez qu'Allah est dur en punition et qu'Allah est Pardonneur et Miséricordieux. » Le miroir me montre les deux faces d'Allah. « Inna Allaha shadidu al-'iqab » — Allah est dur en punition. « Wa anna Allaha ghafurun rahim » — Allah est Pardonneur et Miséricordieux. La punition existe, mais le pardon aussi. Le miroir m'invite à la crainte et à l'espoir.`,
  reflection: `Allah est sévère et miséricordieux. La crainte et l'espoir doivent coexister dans le cœur du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« I'lamu anna Allaha shadidu al-'iqab wa anna Allaha ghafurun rahim » — sachez qu'Allah est dur en punition et qu'Allah est Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Sa punition ? Est-ce que j'espère Sa miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La punition pour les mécréants, la miséricorde pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers connaît la justice et la miséricorde divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui balance entre crainte et espoir est guidé." }
  ],
  munajat: `Ya Shadid, Ta punition est redoutable. Ya Rahim, Ta miséricorde est immense. Donne-moi la crainte qui protège et l'espoir qui rassure.`
};

MIROIR["5:99"] = {
  reference: "5:99",
  theme: ["messager", "responsabilité", "guidance"],
  emotion: "Clarté, soulagement",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Hadi"],
  mirrorVersion: `« Il n'incombe au Messager que de transmettre le message. » Le miroir me montre la limite de la responsabilité du Messager. « Ma 'ala ar-rasuli illa al-balagh » — il n'incombe au Messager que de transmettre. La guidance n'est pas forcée. Le Messager transmet, Allah guide. Le miroir m'enseigne que la responsabilité humaine est de transmettre, pas de convertir.`,
  reflection: `Le Messager transmet, Allah guide. La conversion n'est pas entre les mains du messager.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma 'ala ar-rasuli illa al-balagh » — il n'incombe au Messager que de transmettre le message." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma responsabilité ? Transmettre, pas forcer." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transmission est mon devoir, la guidance est l'œuvre d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers transmet les signes, Allah guide les cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui transmet fidèlement a fait son devoir." }
  ],
  munajat: `Ya Rasul, tu as transmis le message. Ya Hadi, Tu guides les cœurs. Fais que je transmette fidèlement et que Tu guides ceux que j'aime.`
};

MIROIR["5:101"] = {
  reference: "5:101",
  theme: ["questions", "révélation", "sagesse"],
  emotion: "Prudence, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Ô vous qui croyez ! Ne posez pas de questions sur des choses qui, si elles vous étaient révélées, vous causeraient du tort. » Le miroir me montre la sagesse de l'ignorance. « La tas'aluu 'an ashyaa' in tubda lakum tasu'kum » — ne posez pas de questions sur des choses qui, si elles vous étaient révélées, vous causeraient du tort. Toute vérité n'est pas bonne à savoir. Le miroir m'enseigne la confiance dans la révélation progressive.`,
  reflection: `Certaines questions sont mieux sans réponse. La révélation d'Allah est progressive et sage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la tas'aluu 'an ashyaa' in tubda lakum tasu'kum » — ô vous qui croyez ! Ne posez pas de questions sur des choses qui, si elles vous étaient révélées, vous causeraient du tort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles questions inutiles je pose ? Suis-je prêt à accepter ce que je ne sais pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance peut être une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne questionne pas — il accepte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'ignorance sur ce qu'il ne doit pas savoir est protégé." }
  ],
  munajat: `Ya 'Alim, Tu sais tout. Moi je ne sais pas tout. Fais que j'accepte mon ignorance. Ne permets pas que je pose des questions nuisibles.`
};

MIROIR["5:102"] = {
  reference: "5:102",
  theme: ["questions", "peuple", "regret"],
  emotion: "Avertissement, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Un peuple avant vous a posé ces questions, puis ils sont devenus mécréants. » Le miroir me montre le danger des questions obstinées. « Qad sa'alaha qawmun min qablikum thumma asbahu biha kafirin » — un peuple avant vous a posé ces questions, puis ils sont devenus mécréants. La curiosité excessive peut mener à l'égarement. Le miroir m'avertit : la question n'est pas toujours innocente.`,
  reflection: `Les questions obstinées peuvent mener à la mécréance. La foi demande de l'acceptation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad sa'alaha qawmun min qablikum thumma asbahu biha kafirin » — un peuple avant vous a posé ces questions, puis ils sont devenus mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes questions renforcent-elles ma foi ou l'ébranlent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question sincère élève, la question obstinée égare." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne pose pas de questions — il accepte et obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sans questionner obstinément préserve sa foi." }
  ],
  munajat: `Ya Hadi, garde-moi des questions qui égarent. Fais que ma foi soit basée sur l'acceptation, pas sur le doute. Ne permets pas que je devienne mécréant par curiosité excessive.`
};

MIROIR["5:103"] = {
  reference: "5:103",
  theme: ["innovations", "idolâtrie", "ignorance"],
  emotion: "Clarté, rejet",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Ash-Shar'"],
  mirrorVersion: `« Allah n'a pas institué de bahira, ni de sa'iba, ni de wasila, ni de hami. » Le miroir me montre les innovations de l'ignorance. « Ma ja'ala Allahu min bahiratin wa la sa'ibatin » — Allah n'a pas institué de bahira ou de sa'iba. Ces pratiques étaient des innovations païennes. Le miroir m'enseigne à distinguer la religion d'Allah des innovations humaines.`,
  reflection: `Les innovations religieuses ne viennent pas d'Allah. Seule Sa loi est sacrée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma ja'ala Allahu min bahiratin wa la sa'ibatin wa la wasilatin wa la hamin » — Allah n'a pas institué de bahira, ni de sa'iba, ni de wasila, ni de hami." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles innovations religieuses je pratique ? Sont-elles d'Allah ou des hommes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion d'Allah est pure, les innovations sont souillures." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit les lois d'Allah, pas les inventions humaines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la loi d'Allah évite les innovations." }
  ],
  munajat: `Ya Haqq, Ta loi est pure. Fais que je la suive seule. Ne permets pas que je suive les innovations des hommes.`
};

MIROIR["5:104"] = {
  reference: "5:104",
  theme: ["tradition", "révélation", "aveuglement"],
  emotion: "Interrogation, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Et quand on leur dit : 'Venez vers ce qu'Allah a révélé et vers le Messager', ils disent : 'Il nous suffit de ce sur quoi nous avons trouvé nos pères.' » Le miroir me montre l'aveuglement de la tradition. « Hasbuna ma wajadna 'alayhi aba'ana » — il nous suffit de ce sur quoi nous avons trouvé nos pères. La tradition n'est pas un argument. Le miroir m'interroge : est-ce que je suis la vérité ou la tradition ?`,
  reflection: `La tradition n'est pas la vérité. Suivre les ancêtres aveuglément est de l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahum ta'alaw ila ma anzala Allahu wa ila ar-rasuli qalu hasbuna ma wajadna 'alayhi aba'ana » — et quand on leur dit : venez vers ce qu'Allah a révélé et vers le Messager, ils disent : il nous suffit de ce sur quoi nous avons trouvé nos pères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je guidé par la vérité ou par la tradition de mes ancêtres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité peut contredire la tradition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la vérité, pas la tradition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la vérité même contre la tradition est guidé." }
  ],
  munajat: `Ya Hadi, la vérité m'importe plus que la tradition. Fais que je suive Ta révélation. Ne permets pas que je m'aveugle dans la tradition.`
};

MIROIR["5:106"] = {
  reference: "5:106",
  theme: ["testament", "témoins", "mort"],
  emotion: "Sérieux, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wasiyya", "Ash-Shahid"],
  mirrorVersion: `« Ô vous qui croyez ! Le témoignage, au moment de faire un testament, sera fait par deux hommes justes parmi vous. » Le miroir me montre la responsabilité du témoignage. « Shahadatu baynini idha hadara ahadakumu al-mawt » — le témoignage au moment de la mort. La mort est sérieuse, le témoignage aussi. Le miroir m'invite à la justice dans mes affaires dernières.`,
  reflection: `Le testament est un acte sérieux. Les témoins doivent être justes. La mort réclame la justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu shahadatu baynini idha hadara ahadakumu al-mawt » — ô vous qui croyez ! Le témoignage, au moment de faire un testament, sera fait par deux hommes justes parmi vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour mon testament ? Mes témoins sont-ils justes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice même dans la mort est un devoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers laisse son témoignage à chaque instant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son testament avec justice meurt en paix." }
  ],
  munajat: `Ya Wasiyya, le testament est un devoir. Fais que je le prépare avec justice. Donne-moi des témoins justes et une mort paisible.`
};

MIROIR["5:107"] = {
  reference: "5:107",
  theme: ["témoins", "fraude", "justice"],
  emotion: "Justice, réparation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Haqq"],
  mirrorVersion: `« Si l'on découvre que les deux témoins ont mérité un péché, deux autres plus proches prendront leur place. » Le miroir me montre la réparation de l'injustice. « Fa-in yuhkama alladhani istahaqqa ithman » — si l'on découvre que les deux témoins ont mérité un péché. La fraude est découverte, la justice rétablie. Le miroir m'enseigne que la vérité finit par triompher.`,
  reflection: `La fraude sera découverte. La justice sera rétablie. Les témoins frauduleux seront remplacés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in yuhkama alladhani istahaqqa ithman fanakalani aqrabuna min alladhina istahaqqa 'alayhimu al-haqqa » — si l'on découvre que les deux témoins ont mérité un péché, deux autres plus proches prendront leur place." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis témoin avec justice ? Ou est-ce que je fraude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fraude sera découverte, la vérité triomphera." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne fraude pas — il témoigne de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui témoigne avec justice n'a pas peur de la découverte." }
  ],
  munajat: `Ya 'Adl, Tu découvres la fraude. Fais que je sois un témoin juste. Ne permets pas que je triche et sois exposé.`
};

MIROIR["5:108"] = {
  reference: "5:108",
  theme: ["témoignage", "sincérité", "crainte"],
  emotion: "Sérieux, vigilance",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Khabir"],
  mirrorVersion: `« C'est plus proche de la justice, et plus à même de les amener à témoigner sincèrement. » Le miroir me montre les conditions du témoignage sincère. « Aqrabu an ya'tu bi-shahadati 'ala wajhiha » — plus à même de les amener à témoigner sincèrement. La sincérité du témoignage dépend de la crainte d'Allah. Le miroir m'invite à la sincérité dans mes paroles.`,
  reflection: `Le témoignage sincère vient de la crainte d'Allah. La sincérité est proche de la justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika adraku an ya'tu bi-shahadati 'ala wajhiha aw yakhafu an tu'radda aymanun ba'da aymanihi » — c'est plus proche de la justice, et plus à même de les amener à témoigner sincèrement ou à craindre que leurs serments ne soient rejetés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon témoignage est-il sincère ? Est-ce que je crains qu'il soit rejeté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité vient de la crainte d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne sincèrement par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui témoigne sincèrement n'a pas peur du rejet." }
  ],
  munajat: `Ya Shahid, fais que mon témoignage soit sincère. Ne permets pas que je mente par peur des hommes. Donne-moi la crainte de Toi qui rend sincère.`
};

MIROIR["5:109"] = {
  reference: "5:109",
  theme: ["Jour du Jugement", "messagers", "réponse"],
  emotion: "Crainte, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yawm", "Al-Jami'"],
  mirrorVersion: `« Le jour où Allah réunira les messagers et demandera : 'Quelle réponse avez-vous reçue ?' » Le miroir me montre la question du Jour du Jugement. « Yawma yajma'u Allahu ar-rusula » — le jour où Allah réunira les messagers. Les messagers sont questionnés sur la réponse de leurs peuples. Le miroir m'interroge : quelle réponse je donnerai ?`,
  reflection: `Les messagers seront questionnés sur la réponse reçue. Nous aussi nous serons questionnés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yajma'u Allahu ar-rusula fa-yaqulu madha ujibtum » — le jour où Allah réunira les messagers et demandera : quelle réponse avez-vous reçue ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle réponse je donnerai au Jour du Jugement ? Ai-je répondu à l'appel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question du Jour demande une réponse de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera réuni pour répondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa réponse maintenant sera prêt ce jour-là." }
  ],
  munajat: `Ya Jami', Tu rassembleras tout. Fais que ma réponse soit bonne. Ne permets pas que je sois parmi ceux qui n'ont pas de réponse.`
};

MIROIR["5:110"] = {
  reference: "5:110",
  theme: ["Jésus", "miracles", "Esprit"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Masih", "Ruh al-Qudus"],
  mirrorVersion: `« Quand Allah dira : 'Ô Jésus, fils de Marie, rappelle-toi Mon bienfait sur toi et sur ta mère quand Je te soutenais par l'Esprit saint.' » Le miroir me montre les miracles de Jésus. « Wa idh qala Allahu ya 'Isa ibna Maryama dhkur ni'mati 'alayka wa 'ala walidatik » — rappelle-toi Mon bienfait sur toi et sur ta mère. Jésus a été soutenu par l'Esprit saint. Le miroir m'invite à me rappeler les bienfaits d'Allah.`,
  reflection: `Les miracles de Jésus viennent d'Allah. L'Esprit saint est un soutien divin. Le bienfait doit être reconnu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qala Allahu ya 'Isa ibna Maryama dhkur ni'mati 'alayka wa 'ala walidatik id ayyadttuka bi-ruhi al-qudus » — quand Allah dira : ô Jésus, fils de Marie, rappelle-toi Mon bienfait sur toi et sur ta mère quand Je te soutenais par l'Esprit saint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits dois-je me rappeler ? Suis-je reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bienfait non reconnu est un péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier reconnaît les bienfaits de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle les bienfaits en reçoit plus." }
  ],
  munajat: `Ya Rahman, je me rappelle Tes bienfaits. Merci pour le soutien que Tu m'as donné. Fais que je sois reconnaissant chaque jour.`
};

MIROIR["5:111"] = {
  reference: "5:111",
  theme: ["disciples", "foi", "secours"],
  emotion: "Confiance, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Hawariyyun", "An-Nasir"],
  mirrorVersion: `« Et quand J'ai révélé aux disciples : 'Croyez en Moi et en Mon Messager', ils dirent : 'Nous croyons, et sois témoin que nous sommes soumis.' » Le miroir me montre la foi des disciples. « Wa idh awhaytu ila al-hawariyyina an aminu bi wa bi-rasuli » — J'ai révélé aux disciples : croyez en Moi et en Mon Messager. La réponse fut immédiate : « Nous croyons. » Le miroir m'invite à cette réponse immédiate.`,
  reflection: `Les disciples ont cru immédiatement. La foi sans délai est la meilleure foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh awhaytu ila al-hawariyyina an aminu bi wa bi-rasuli qalu amanna wa ish-had bi-anna muslimun » — et quand J'ai révélé aux disciples : croyez en Moi et en Mon Messager, ils dirent : nous croyons, et sois témoin que nous sommes soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma réponse à l'appel d'Allah est-elle immédiate ? Ou est-ce que je tarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi immédiate est la plus pure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond immédiatement à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond immédiatement est immédiatement exaucé." }
  ],
  munajat: `Ya Rabb, je crois en Toi et en Ton Messager. Sois témoin que je suis soumis. Fais que ma réponse soit immédiate et sincère.`
};

MIROIR["5:112"] = {
  reference: "5:112",
  theme: ["table", "miracle", "demande"],
  emotion: "Espoir, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'idah", "Ar-Razzaq"],
  mirrorVersion: `« Et quand les disciples dirent : 'Ô Jésus, fils de Marie, ton Seigneur peut-Il faire descendre sur nous une table du ciel ?' » Le miroir me montre la demande des disciples. « Hal yastati'u rabbuka an yunnazzila 'alayna ma'idatan mina as-sama'i » — ton Seigneur peut-Il faire descendre sur nous une table du ciel ? La demande d'un miracle est aussi un test. Le miroir m'interroge : qu'est-ce que je demande à Allah ?`,
  reflection: `La demande d'un miracle peut être un test. Ce qu'on demande révèle l'état du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qala al-hawariyyuna ya 'Isa ibna Maryama hal yastati'u rabbuka an yunnazzila 'alayna ma'idatan mina as-sama'i » — et quand les disciples dirent : ô Jésus, fils de Marie, ton Seigneur peut-Il faire descendre sur nous une table du ciel ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande à Allah ? Mon cœur est-il dans la bonne intention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande d'un miracle peut être un test de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne demande pas — il reçoit ce qu'on lui donne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande avec la bonne intention reçoit." }
  ],
  munajat: `Ya Razzaq, Tu peux tout. Fais descendre Tes bénédictions sur moi. Mais ne permets pas que je demande avec mauvaise intention.`
};

MIROIR["5:113"] = {
  reference: "5:113",
  theme: ["table", "cœur", "satisfaction"],
  emotion: "Espoir, apaisement",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'idah", "As-Sakinah"],
  mirrorVersion: `« Nous voulons manger, que nos cœurs soient rassurés, et savoir que tu nous as dit la vérité. » Le miroir me montre l'intention derrière la demande. « Natma'inna qulubuna » — que nos cœurs soient rassurés. La nourriture n'est pas le but — la certitude du cœur l'est. Le miroir m'enseigne que les demandes matérielles peuvent viser des buts spirituels.`,
  reflection: `Manger n'est pas le but — la certitude du cœur l'est. Les demandes matérielles peuvent servir des buts spirituels.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu nuridu an na'kula minha wa tatma'inna qulubuna wa na'lama an qad sadaqtana » — ils dirent : nous voulons manger, que nos cœurs soient rassurés, et savoir que tu nous as dit la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je veux vraiment ? La satisfaction matérielle ou la certitude du cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude du cœur vaut plus que la nourriture du corps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers cherche la certitude dans l'ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est certain n'a plus besoin de preuves." }
  ],
  munajat: `Ya Sakinah, apaise mon cœur. Fais que je trouve la certitude en Toi. Donne-moi ce dont j'ai besoin pour que mon cœur soit rassuré.`
};

MIROIR["5:115"] = {
  reference: "5:115",
  theme: ["table", "châtiment", "mise en garde"],
  emotion: "Crainte, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ma'idah", "Ash-Shadid"],
  mirrorVersion: `« Allah dit : 'Je la ferai descendre sur vous. Mais quiconque d'entre vous mécroira après cela, Je le châtierai d'un châtiment dont Je n'ai châtié personne dans l'univers.' » Le miroir me montre la gravité du miracle suivi de mécréance. « Man yakfur ba'du dhalika minhum fa-inni u'adhdhibuhu 'adhaban » — quiconque mécroira après cela, Je le châtierai. Le miracle n'est pas un cadeau innocent — c'est un test. Le miroir m'avertit : les bienfaits viennent avec des responsabilités.`,
  reflection: `Le miracle n'est pas gratuit. La mécréance après le miracle est le pire péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Allahu inni munazziluha 'alaykum fa-man yakfur ba'du minhum fa-inni u'adhdhibuhu 'adhaban la u'adhdhibuhu ahadan mina al-'alamin » — Allah dit : Je la ferai descendre sur vous. Mais quiconque d'entre vous mécroira après cela, Je le châtierai d'un châtiment dont Je n'ai châtié personne dans l'univers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux bienfaits d'Allah ? Est-ce que je mécrois après avoir reçu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bienfait vient avec la responsabilité de la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit et remercie naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie après le bienfait en reçoit plus." }
  ],
  munajat: `Ya Shadid, Ton châtiment est terrible. Préserve-moi de la mécréance après les bienfaits. Fais que je sois reconnaissant toujours.`
};

MIROIR["5:116"] = {
  reference: "5:116",
  theme: ["Jésus", "divinité", "question"],
  emotion: "Sérieux, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Al-Wahid"],
  mirrorVersion: `« Et quand Allah dira : 'Ô Jésus, fils de Marie, est-ce toi qui as dit aux gens : Prenez-moi et ma mère pour divinités en dehors d'Allah ?' » Le miroir me montre la question finale. « A-anta qulta li-nnasi attakhidhuni wa ummiya ilahayni min duni Allah » — est-ce toi qui as dit aux gens de te prendre toi et ta mère pour divinités ? La réponse de Jésus sera claire : non. Le miroir m'enseigne que Jésus n'a jamais prétendu être divin.`,
  reflection: `Jésus n'a jamais prétendu être Dieu. La question du Jour du Jugement établira la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qala Allahu ya 'Isa ibna Maryama a-anta qulta li-nnasi attakhidhuni wa ummiya ilahayni min duni Allah » — et quand Allah dira : ô Jésus, fils de Marie, est-ce toi qui as dit aux gens : prenez-moi et ma mère pour divinités en dehors d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah ce qu'Il n'a pas dit ? Est-ce que je suis la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité sera établie au Jour du Jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de l'unicité d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la vérité maintenant n'aura pas peur des questions." }
  ],
  munajat: `Ya Wahid, Tu es le Seul Dieu. Jésus est Ton serviteur. Fais que je connaisse la vérité et que je la suive. Ne permets pas que je sois parmi ceux qui attribuent des mensonges.`
};

MIROIR["5:117"] = {
  reference: "5:117",
  theme: ["Jésus", "témoignage", "serviteur"],
  emotion: "Vérité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Al-'Abd"],
  mirrorVersion: `« Jésus répondra : 'Gloire à Toi ! Il ne m'appartenait pas de dire ce à quoi je n'ai pas droit.' » Le miroir me montre la réponse humble de Jésus. « Subhanaka ma yakunu li an aqula ma laysa li bi-haqqin » — gloire à Toi ! Il ne m'appartenait pas de dire ce à quoi je n'ai pas droit. Jésus nie la divinité. Il est serviteur, pas Dieu. Le miroir m'enseigne l'humilité devant Allah.`,
  reflection: `Jésus, le grand prophète, nie la divinité. Son humilité est un exemple pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala subhanaka ma yakunu li an aqula ma laysa li bi-haqqin » — Jésus répondra : gloire à Toi ! Il ne m'appartenait pas de dire ce à quoi je n'ai pas droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je humble devant Allah ? Est-ce que je m'attribue ce qui ne m'appartient pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité est de reconnaître sa place de serviteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est humble devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble sera élevé par Allah." }
  ],
  munajat: `Ya Rabb, gloire à Toi. Je suis Ton serviteur. Fais que je ne m'attribue rien qui ne m'appartient pas. Donne-moi l'humilité de Jésus.`
};

MIROIR["5:119"] = {
  reference: "5:119",
  theme: ["Jésus", "témoignage", "Jour du Jugement"],
  emotion: "Vérité, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-Haqq"],
  mirrorVersion: `« Allah dit : 'Ceci est le jour où leur véracité profitera aux véridiques.' » Le miroir me montre la récompense de la véracité. « Hadha yawmu yanfa'u as-sadiqina sidquhum » — ceci est le jour où leur véracité profitera aux véridiques. La véracité a une récompense finale. Le miroir m'invite à la véracité maintenant pour qu'elle profite alors.`,
  reflection: `La véracité sera utile au Jour du Jugement. Les véridiques seront récompensés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Allahu hadha yawmu yanfa'u as-sadiqina sidquhum » — Allah dit : ceci est le jour où leur véracité profitera aux véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je véridique ? Ma véracité profitera-t-elle au Jour du Jugement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sera exposé, la vérité sera récompensée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est véridique par nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique maintenant sera récompensé alors." }
  ],
  munajat: `Ya Haqq, je veux être véridique. Fais que ma véracité profite au Jour du Jugement. Ne permets pas que je sois parmi les menteurs.`
};

// ==================== SURAH 6: AL-AN'AM (The Cattle) - 165 verses - COMPREHENSIVE COVERAGE ====================

MIROIR["6:1"] = {
  reference: "6:1",
  theme: ["louange", "création", "opposition"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "An-Nur"],
  mirrorVersion: `« Louange à Allah qui a créé les cieux et la terre et fait les ténèbres et la lumière. Pourtant, ceux qui mécroient donnent des égaux à leur Seigneur. » Le miroir m'ouvre la sourate Al-An'am par la louange. « Al-hamdu lillahi alladhi khalaqa as-samawati wa al-arda » — louange à Allah qui a créé les cieux et la terre. La création est le premier don. Les ténèbres et la lumière sont les deux faces de l'existence. Le miroir m'invite à louer Celui qui a tout créé.`,
  reflection: `La louange est la réponse naturelle à la reconnaissance de la création. Tout ce qui existe est un signe du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hamdu lillahi alladhi khalaqa as-samawati wa al-arda wa ja'ala az-zulumati wa an-nur » — louange à Allah qui a créé les cieux et la terre et fait les ténèbres et la lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends le temps de louer Allah pour la création ? Ou est-ce que je considère tout comme acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ténèbres et la lumière sont toutes deux créées par Allah. L'une n'est pas le mal absolu, l'autre n'est pas le bien absolu. Les deux servent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier loue Allah par son existence. Chaque atome dit « SubhanAllah »." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue Allah pour la création reçoit la lumière de la reconnaissance." }
  ],
  munajat: `Ya Khaliq, Tu as tout créé. Louange à Toi pour les cieux, la terre, les ténèbres et la lumière. Fais que je sois de ceux qui Te louent.`
};

MIROIR["6:14"] = {
  reference: "6:14",
  theme: ["créateur", "sustentation", "confiance"],
  emotion: "Humilité, dépendance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Khaliq"],
  mirrorVersion: `« Dis : 'Prendrai-je un protecteur autre qu'Allah, le Créateur des cieux et de la terre, qui nourrit et n'est point nourri ?' » Le miroir me place devant l'indépendance absolue d'Allah. « Khalaqa as-samawati wa al-arda wa yut'imu wa la yut'am » — le Créateur des cieux et de la terre, qui nourrit et n'est point nourri. Allah donne tout et ne reçoit rien. Je suis dépendant, Il est indépendant. Le miroir m'invite à reconnaître ma dépendance radicale.`,
  reflection: `Allah se suffit à Lui-même. Tout le reste a besoin de Lui. Cette reconnaissance libère de l'orgueil et de l'anxiété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa as-samawati wa al-arda wa yut'imu wa la yut'am » — le Créateur des cieux et de la terre, qui nourrit et n'est point nourri." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi ai-je besoin aujourd'hui ? Qui me nourrit ? Tout vient de Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas être nourri, c'est être autonome. Allah est le seul autonome. Tout le reste est nourri par Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature reçoit sa nourriture du Créateur. Le soleil, la pluie, la terre — tout est Sa provision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa dépendance absolue reçoit l'indépendance relative." }
  ],
  munajat: `Ya Razzaq, Tu nourris tout et nul ne Te nourrit. Je suis dépendant de Toi. Pourvois à mes besoins et donne-moi la confiance en Ta provision.`
};

MIROIR["6:17"] = {
  reference: "6:17",
  theme: ["épreuve", "détresse", "délivrance"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Fattah"],
  mirrorVersion: `« Et si Allah te touche par un malheur, nul ne peut l'écarter que Lui. Et s'Il te touche par un bonheur, Il est Omnipotent. » Le miroir me montre la dualité de la vie. « Wa in yamsaska Allahu bi durrin fa la kashifa lahu illa huwa » — si Allah te touche par un malheur, nul ne peut l'écarter que Lui. Le mal et le bien viennent de Lui, et la délivrance aussi. Le miroir m'invite à me tourner vers Lui dans les deux cas.`,
  reflection: `Allah est la source de tout, et la solution de tout. Dans le malheur, je me tourne vers Lui. Dans le bonheur, je Le remercie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yamsaska Allahu bi durrin fa la kashifa lahu illa huwa » — si Allah te touche par un malheur, nul ne peut l'écarter que Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans le malheur, à qui je me tourne ? Vers les gens ou vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur est aussi une porte vers Allah. La détresse force l'invocation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature en détresse se tourne vers son Créateur. C'est un réflexe universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se tourne vers Allah dans le malheur voit le malheur devenir une bénédiction." }
  ],
  munajat: `Ya Nasir, Tu es le seul qui peut écarter le malheur. Dans ma détresse, je me tourne vers Toi. Délivre-moi et donne-moi la patience.`
};

MIROIR["6:32"] = {
  reference: "6:32",
  theme: ["vie", "jeu", "au-delà"],
  emotion: "Sérieux, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Akhirah"],
  mirrorVersion: `« La vie présente n'est que jeu et divertissement. La Demeure de l'au-delà est meilleure pour ceux qui craignent Allah. » Le miroir me montre la relativité de cette vie. « Ma al-hayatu ad-dunya illa la'ibun wa lahw » — la vie présente n'est que jeu et divertissement. Ce n'est pas qu'elle est sans importance, mais elle est relative. L'au-delà est absolu. Le miroir m'invite à investir dans l'éternel plutôt que le temporel.`,
  reflection: `La vie est un passage, pas une destination. Jouer sérieusement, c'est vivre pour l'éternité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma al-hayatu ad-dunya illa la'ibun wa lahw » — la vie présente n'est que jeu et divertissement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis cette vie ? Comme un jeu ou comme une préparation pour l'éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie n'est pas un jeu si on y voit l'éternité. Elle devient sérieuse quand on la vit pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est sérieux. Les galaxies ne jouent pas. L'être humain peut choisir son attitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit cette vie pour l'au-delà gagne les deux." }
  ],
  munajat: `Ya Haqq, cette vie passe vite. Aide-moi à ne pas me perdre dans le jeu. Fais que je vive pour l'éternité.`
};

MIROIR["6:44"] = {
  reference: "6:44",
  theme: ["épreuve", "ingratitude", "châtiment"],
  emotion: "Avertissement, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qabid", "Ash-Shadid"],
  mirrorVersion: `« Puis, quand ils eurent oublié ce qu'on leur avait rappelé, Nous leur ouvrîmes les portes de toute chose, jusqu'à ce que, joyeux de ce qui leur avait été donné, Nous les saisîmes soudain, et les voilà désespérés. » Le miroir me montre le piège de l'abondance. « Falamma nasu ma dhukkiru bihi fatahna 'alayhim abwaba kulli shay' » — quand ils eurent oublié, Nous leur ouvrîmes les portes de toute chose. L'abondance sans gratitude mène à la destruction. Le miroir m'avertit : la facilité n'est pas toujours une bénédiction.`,
  reflection: `L'abondance peut être un piège. La facilité sans reconnaissance mène à l'oubli, et l'oubli mène à la perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fatahna 'alayhim abwaba kulli shay' » — Nous leur ouvrîmes les portes de toute chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'abondance que je reçois est-elle une bénédiction ou un test ? Suis-je reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité peut être plus dangereuse que la difficulté. La difficulté réveille, la facilité endort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine de peuples qui ont péri dans l'abondance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant dans l'abondance est protégé du piège de l'abondance." }
  ],
  munajat: `Ya Allah, l'abondance peut être un piège. Si Tu me donnes la facilité, donne-moi aussi la reconnaissance. Ne permets pas que je m'oublie dans Tes dons.`
};

MIROIR["6:59"] = {
  reference: "6:59",
  theme: ["sagesse", "présence", "confiance"],
  emotion: "Révérence, sécurité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Auprès de Lui se trouvent les clés de l'Inconnaissable. Nul autre que Lui ne les connaît. Et Il connaît ce qui est dans la terre ferme et dans la mer. Pas une feuille ne tombe sans qu'Il ne le sache. » Le miroir me place devant une Connaissance absolue. Chaque feuille qui tombe, chaque grain de sable, chaque pensée qui traverse mon esprit — tout est connu. Cette omniscience n'est pas une surveillance oppressive — c'est une présence rassurante. Rien de ma vie n'est perdu, oublié, insignifiant. Tout est enregistré, conservé, valorisé.`,
  reflection: `Les « clés de l'Inconnaissable » (mafâtih al-ghayb) signifient que seul Allah connaît l'avenir, le destin, les secrets des cœurs. Cette ignorance est une protection, pas une punition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'expression « mafâtih al-ghayb » est unique. Les clés ouvrent ce qui est fermé — ici, ce qui est caché à la connaissance humaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cherche à savoir que je ne peux pas savoir ? L'avenir ? Le destin de mes proches ? Le miroir m'invite à laisser ces questions à Celui qui les connaît." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah sait tout, alors mon ignorance n'est pas un échec — c'est ma place d'humain. Je suis fait pour ne pas tout savoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque feuille qui tombe est comptée. L'univers entier est un registre vivant, chaque événement y est inscrit. Rien n'est perdu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance divine n'est pas une menace — c'est une promesse. Ce que je vis n'est pas oublié. Tout a un sens, même si je ne le vois pas." }
  ],
  munajat: `Ya 'Alim, Tu sais tout de moi — même ce que j'ignore de moi-même. Remets-moi là où mon ignorance me pèse. Fais que je vive dans la confiance de Celui qui sait.`
};

MIROIR["6:70"] = {
  reference: "6:70",
  theme: ["rappel", "responsabilité", "âme"],
  emotion: "Sérieux, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Wakil"],
  mirrorVersion: `« Laisse ceux qui prennent leur religion pour jeu et divertissement, et que la vie présente a trompés. Rappelle par le Coran, de peur qu'une âme ne soit livrée à sa perte pour ce qu'elle a acquis. » Le miroir m'avertit sur la responsabilité de l'âme. « Wa tadarra kulla nafsin » — de peur qu'une âme ne soit livrée à sa perte. Chaque âme est responsable. Le rappel est le remède. Le miroir m'invite à prendre ma vie spirituelle au sérieux.`,
  reflection: `L'âme peut se perdre. Le rappel la sauve. Prendre sa religion au sérieux, c'est se prendre au sérieux en tant qu'être éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tadarra kulla nafsin ma kasabat » — de peur qu'une âme ne soit livrée à sa perte pour ce qu'elle a acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends ma religion au sérieux ? Ou est-ce que c'est un jeu pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel n'est pas une contrainte — c'est une protection contre la perte de soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers suit sa nature. L'âme humaine a le choix de suivre ou de dévier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle Allah se protège de la perte de son âme." }
  ],
  munajat: `Ya Hasib, mon âme est en danger sans le rappel. Fais que je prenne ma religion au sérieux. Rappelle-moi par Ton Livre.`
};

MIROIR["6:79"] = {
  reference: "6:79",
  theme: ["unicité", "orientation", "soumission"],
  emotion: "Détermination, consécration",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Hanif"],
  mirrorVersion: `« Je tourne mon visage vers Celui qui a créé les cieux et la terre, en pur monothéiste, et je ne suis point des associateurs. » Le miroir me montre la déclaration d'Ibrahim. « Inni wajjahtu wajhiya lilladhi fataru as-samawati wa al-arda hanifan » — je tourne mon visage vers Celui qui a créé les cieux et la terre. Le monothéisme est une orientation, pas seulement une croyance. Tourner son visage, c'est tout orienter. Le miroir m'invite à cette orientation totale.`,
  reflection: `L'unicité n'est pas théorique — elle est pratique. Tourner son visage vers Allah, c'est orienter toute sa vie vers Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inni wajjahtu wajhiya lilladhi fataru as-samawati wa al-arda hanifan wa ma ana mina al-mushrikin » — je tourne mon visage vers Celui qui a créé les cieux et la terre, en pur monothéiste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quoi je tourne mon visage ? Vers Allah ou vers les créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tourner son visage vers Allah, c'est Lui donner toute la face, pas seulement une partie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature s'oriente vers son Créateur naturellement. L'être humain peut choisir de le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tourne son visage vers Allah voit Allah tourner Sa face vers lui." }
  ],
  munajat: `Ya Wahid, je tourne mon visage vers Toi. Sois mon orientation unique. Ne permets pas que je me tourne vers autre que Toi.`
};

MIROIR["6:95"] = {
  reference: "6:95",
  theme: ["vie", "mort", "résurrection"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« C'est Allah qui fend le grain et le noyau. Du mort, Il fait sortir le vivant, et du vivant, Il fait sortir le mort. » Le miroir me montre le miracle quotidien. « Inna Allaha faliquu al-habbi wa an-nawa » — c'est Allah qui fend le grain et le noyau. La vie sort de la mort. Le grain meurt pour donner la plante. La mort n'est pas une fin, mais une transition. Le miroir m'invite à voir la résurrection dans chaque graine qui germe.`,
  reflection: `La vie et la mort sont entre les mains d'Allah. Du mort Il fait le vivant — c'est le miracle de chaque printemps, de chaque naissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yukhriju al-hayya mina al-mayyiti wa mukhriju al-mayyiti mina al-hayy » — du mort, Il fait sortir le vivant, et du vivant, Il fait sortir le mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les miracles quotidiens ? Le grain qui germe, la vie qui jaillit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas une fin — c'est une porte vers une autre vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un cycle de vie et de mort. Chaque mort prépare une vie nouvelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la mort comprend la vie." }
  ],
  munajat: `Ya Muhyi, Tu fais sortir le vivant du mort. Donne-moi la vie dans mon cœur mort. Fais germer les graines de foi en moi.`
};

MIROIR["6:101"] = {
  reference: "6:101",
  theme: ["création", "transcendance", "miracle"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari'"],
  mirrorVersion: `« Créateur des cieux et de la terre ! Comment aurait-Il un enfant alors qu'Il n'a pas de compagne ? Il a tout créé et Il sait tout. » Le miroir me montre la transcendance d'Allah. « Badi'u as-samawati wa al-ard » — Créateur originel des cieux et de la terre. « Anna yakunu lahu waladun wa lam takun lahu sahibah » — comment aurait-Il un enfant sans compagne ? Allah transcende les catégories humaines. Le miroir m'invite à accepter ce qui dépasse mon entendement.`,
  reflection: `Allah n'a pas de pareil, pas de compagne, pas d'enfant. Sa création vient de rien, pas d'une procréation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Badi'u as-samawati wa al-ard anna yakunu lahu waladun wa lam takun lahu sahibah » — Créateur des cieux et de la terre, comment aurait-Il un enfant sans compagne ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la transcendance d'Allah ? Ou est-ce que je Le réduis à mes catégories ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de compagne pour créer. Sa création est pure parole : « Sois » et cela est." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé de rien par la parole d'Allah. Pas de précédent, pas de modèle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la transcendance d'Allah reçoit Sa proximité." }
  ],
  munajat: `Ya Khaliq, Tu es transcendant. Je ne peux pas Te comprendre, mais je peux T'adorer. Accepte mon amour pour Toi.`
};

MIROIR["6:115"] = {
  reference: "6:115",
  theme: ["parole", "perfection", "véracité"],
  emotion: "Confiance, assurance",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Haqq"],
  mirrorVersion: `« La parole de ton Seigneur s'est accomplie en vérité et en justice. Nul ne peut changer Ses paroles. » Le miroir me montre la finalité de la parole divine. « Wa tammat kalimatu rabbika sidqan wa 'adlan » — la parole de ton Seigneur s'est accomplie en vérité et en justice. La parole d'Allah est vraie et juste. Nul ne peut la changer. Le miroir m'invite à faire confiance à cette parole inaltérable.`,
  reflection: `La parole d'Allah est accomplie. Vérité et justice sont ses caractéristiques. Elle ne change pas, elle ne faillit pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tammat kalimatu rabbika sidqan wa 'adlan la mubaddila li kalimatihi » — la parole de ton Seigneur s'est accomplie en vérité et en justice. Nul ne peut changer Ses paroles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la parole d'Allah ? Ou est-ce que je la remets en question ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole qui ne change pas est un ancre dans un monde qui change." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par la parole d'Allah. Sa constance assure la constance des lois naturelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'appuie sur la parole d'Allah ne sera jamais ébranlé." }
  ],
  munajat: `Ya Sadiq, Ta parole est vérité et justice. Je m'y appuie. Ne permets pas que je doute de ce que Tu as dit.`
};

MIROIR["6:122"] = {
  reference: "6:122",
  theme: ["lumière", "vie", "guidance"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Muhyi"],
  mirrorVersion: `« Est-ce que celui qui était mort et que Nous avons fait revivre, et à qui Nous avons donné une lumière par laquelle il marche parmi les gens, est comparable à celui qui est dans les ténèbres ? » Le miroir me montre le contraste entre la guidance et l'égarement. « Awa man kana mayyitan fa ahyaynahu » — celui qui était mort et que Nous avons fait revivre. La foi est une résurrection. La lumière est un don. Le miroir m'invite à marcher dans cette lumière.`,
  reflection: `La vraie vie est la vie avec Allah. La vraie lumière est la lumière de la foi. Marcher parmi les gens avec cette lumière est un privilège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa man kana mayyitan fa ahyaynahu wa ja'alna lahu nuran yamshi bihi fi an-nas » — celui qui était mort et que Nous avons fait revivre, et à qui Nous avons donné une lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je vivant par la foi ? Ou mort par l'égarement ? Est-ce que je marche dans la lumière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort spirituelle précède la vie spirituelle. La résurrection vient de la rencontre avec Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique permet la vision. La lumière spirituelle permet la vision du sens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a reçu la lumière doit la partager, pas la garder." }
  ],
  munajat: `Ya Nur, Tu m'as fait revivre de la mort de l'égarement. Donne-moi Ta lumière. Fais que je marche avec elle parmi les gens.`
};

MIROIR["6:141"] = {
  reference: "6:141",
  theme: ["création", "générosité", "gratitude"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Ar-Razzaq"],
  mirrorVersion: `« C'est Lui qui a créé les jardins, avec ou sans treillis, ainsi que les palmiers, les récoltes aux produits variés, l'olive et la grenade, semblables ou dissemblables. » Le miroir me montre la diversité de la création. « Wa huwa alladhi ansha'a al-jannat » — c'est Lui qui a créé les jardins. La diversité est un don. Les fruits variés sont des signes. Le miroir m'invite à la gratitude pour cette abondance.`,
  reflection: `La création est diverse et généreuse. Chaque fruit, chaque plante est un signe de la générosité du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi ansha'a al-jannat mu'rafatan wa ghayra mu'rafatin wa an-nakhla wa al-zar'a » — c'est Lui qui a créé les jardins, avec ou sans treillis, les palmiers et les récoltes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie Allah pour la diversité de Sa création ? Ou est-ce que je la considère comme acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité n'est pas un hasard — c'est une intention divine de nous donner plus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers déborde de diversité. Chaque espèce, chaque fruit est unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la diversité reçoit plus de diversité." }
  ],
  munajat: `Ya Karim, Tu as créé tant de fruits, tant de jardins. Merci pour Ta générosité. Fais que je sois reconnaissant pour chaque bouchée.`
};

MIROIR["6:162"] = {
  reference: "6:162",
  theme: ["adoration", "consécration", "totalité"],
  emotion: "Engagement, dévouement",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Ma'bud"],
  mirrorVersion: `« Dis : 'Ma prière, mes actes de dévotion, ma vie et ma mort appartiennent à Allah, Seigneur de l'univers.' » Le miroir me montre la consécration totale. « Inna salati wa nusuki wa mahyaya wa mamati lillahi rabbi al-'alamin » — ma prière, mes actes de dévotion, ma vie et ma mort appartiennent à Allah. Tout est à Lui. La vie et la mort sont offertes. Le miroir m'invite à cette consécration complète.`,
  reflection: `Tout appartient à Allah. Offrir sa vie et sa mort, c'est reconnaître cette vérité et la vivre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna salati wa nusuki wa mahyaya wa mamati lillahi rabbi al-'alamin » — ma prière, mes actes de dévotion, ma vie et ma mort appartiennent à Allah, Seigneur de l'univers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie est consacrée à Allah ? Ou est-ce que je garde des parties pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Offrir sa vie, ce n'est pas la perdre — c'est la trouver en Celui qui la donne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie appartient à son Créateur. L'être humain peut choisir de l'offrir consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui offre sa vie à Allah reçoit Sa vie en retour." }
  ],
  munajat: `Ya Rabb, ma vie et ma mort T'appartiennent. Je T'offre tout. Prends ce que je suis et fais-en ce que Tu veux.`
};

MIROIR["6:165"] = {
  reference: "6:165",
  theme: ["succession", "responsabilité", "test"],
  emotion: "Conscience, accountability",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Hasib"],
  mirrorVersion: `« C'est Lui qui a fait de vous les successeurs sur terre et vous a élevés, en rangs, les uns au-dessus des autres, afin de vous éprouver par ce qu'Il vous a donné. » Le miroir me montre ma place sur terre. « Wa huwa alladhi ja'alakum khala'ifa al-ard » — c'est Lui qui a fait de vous les successeurs sur terre. Je suis un gérant, pas un propriétaire. L'élévation est un test. Le miroir m'invite à la responsabilité de cette gérance.`,
  reflection: `Être successeur sur terre est une responsabilité. Les rangs sont des tests. La position n'est pas un privilège — c'est une épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi ja'alakum khala'ifa al-ardi wa rafa'a ba'dakum fawqa ba'din darajat » — c'est Lui qui a fait de vous les successeurs sur terre et vous a élevés en rangs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère ce que j'ai reçu ? Est-ce que je suis un bon gérant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation n'est pas un accomplissement — c'est un test. La chute vient après l'élévation sans gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité est le gérant de la terre. Chaque génération transmet à la suivante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui gère bien ce qu'il a reçu reçoit plus." }
  ],
  munajat: `Ya Warith, je suis Ton gérant sur terre. Aide-moi à bien gérer ce que Tu m'as confié. Ne permets pas que j'oublie ma responsabilité.`
};

MIROIR["6:2"] = {
  reference: "6:2",
  theme: ["création", "argile", "décret"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« C'est Lui qui vous a créés d'argile, puis a décrété un terme. » Le miroir me ramène à mon origine. « Khalaqakum min tin » — Il vous a créés d'argile. L'argile est humble, terrestre, banale. Je viens de la terre. « Thumma qada ajalan » — puis a décrété un terme. Mon existence a une limite. Le miroir m'invite à l'humilité de l'origine et à la conscience de la fin.`,
  reflection: `Je viens de l'argile. Je retournerai à la terre. Mon existence est limitée par un décret divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi khalaqakum min tinin thumma qada ajalan » — c'est Lui qui vous a créés d'argile, puis a décrété un terme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais de mon origine d'argile ? Est-ce que j'en suis conscient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argile est humble, mais elle peut devenir ce qu'Allah veut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature vient de la terre et y retourne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine connaît sa valeur." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'argile. Fais que je me souvienne de mon humble origine. Donne-moi la conscience de mon terme.`
};

MIROIR["6:3"] = {
  reference: "6:3",
  theme: ["connaissance", "caché", "manifeste"],
  emotion: "Révérence, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Et Allah est Allah dans les cieux et sur la terre. Il sait ce que vous cachez et ce que vous divulguez. » Le miroir me place devant une Connaissance totale. « Wa Allahu fi as-samawati wa fi al-ard » — Allah est Dieu dans les cieux et sur la terre. Sa divinité est universelle. « Ya'lamu ma tusirruna wa ma tu'linun » — Il sait ce que vous cachez et ce que vous divulguez. Rien n'échappe à Sa connaissance. Le miroir m'invite à la transparence.`,
  reflection: `Allah connaît tout — le caché et le manifeste. La sincérité est la meilleure politique devant Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu fi as-samawati wa fi al-ardi ya'lamu ma tusirruna wa ma tu'linun » — et Allah est Allah dans les cieux et sur la terre. Il sait ce que vous cachez et ce que vous divulguez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Suis-je prêt à le voir exposé devant Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le caché sera manifeste au Jour du Jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est manifeste devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en transparence n'a rien à cacher." }
  ],
  munajat: `Ya 'Alim, Tu connais mon caché et mon manifeste. Purifie ce que je cache. Fais que je vive dans la transparence.`
};

MIROIR["6:4"] = {
  reference: "6:4",
  theme: ["signes", "rejet", "aveuglement"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "Al-Huda"],
  mirrorVersion: `« Et aucun signe ne leur vient des signes de leur Seigneur sans qu'ils ne s'en détournent. » Le miroir me montre l'aveuglement obstiné. « Wa ma ta'tihim min ayatin min ayati rabbihim illa can 'anha mu'ridin » — aucun signe ne leur vient sans qu'ils ne s'en détournent. Le signe est présent, mais le regard est absent. Le miroir m'avertit : combien de signes ai-je ignorés ?`,
  reflection: `Les signes sont partout. L'aveuglement n'est pas l'absence de signes, c'est le refus de les voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ta'tihim min ayatin min ayati rabbihim illa can 'anha mu'ridin » — et aucun signe ne leur vient des signes de leur Seigneur sans qu'ils ne s'en détournent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes ai-je ignorés ? Combien de fois me suis-je détourné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe ignoré devient un témoignage contre celui qui l'ignore." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe continu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche les signes les trouve partout." }
  ],
  munajat: `Ya Hadi, les signes sont partout. Ouvre mes yeux. Ne permets pas que je me détourne de Tes signes.`
};

MIROIR["6:5"] = {
  reference: "6:5",
  theme: ["vérité", "rejet", "réalisation"],
  emotion: "Réalisation, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batin"],
  mirrorVersion: `« Ils ont traité de mensonge la vérité quand elle leur est venue. Mais ils sauront bientôt ce dont ils se moquaient. » Le miroir me montre la conséquence du rejet. « Kadhdhabu bi-l-haqqi lamma ja'ahum » — ils ont traité de mensonge la vérité. Le rejet de la vérité est un choix. « Fasaufa ya'lamun » — mais ils sauront bientôt. La réalisation viendra, peut-être trop tard. Le miroir m'avertit : ne pas attendre la réalisation tardive.`,
  reflection: `La vérité rejetée reste vérité. La réalisation tardive ne sert à rien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabu bi-l-haqqi lamma ja'ahum fasaufa ya'lamun » — ils ont traité de mensonge la vérité quand elle leur est venue. Mais ils sauront bientôt ce dont ils se moquaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la vérité ? Est-ce que je me moque de ce qui est sacré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité que je rejette maintenant, je la regretterai plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas — il est vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité maintenant n'aura pas de regret." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je L'accepte maintenant. Ne permets pas que je sois parmi ceux qui réalisent trop tard.`
};

MIROIR["6:6"] = {
  reference: "6:6",
  theme: ["histoire", "destruction", "succession"],
  emotion: "Leçon, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Qahhar"],
  mirrorVersion: `« N'ont-ils pas vu combien de générations Nous avons fait périr avant eux ? Nous les avons installés sur terre mieux que vous. » Le miroir me montre les leçons de l'histoire. « Alam yaraw kam ahlakna qablahum min al-quruni » — n'ont-ils pas vu combien de générations Nous avons fait périr ? L'histoire est pleine de leçons. « Wa makkanahum fi al-ard » — Nous les avons installés sur terre. La puissance n'est pas permanente. Le miroir m'avertit : les nations passent, seules les œuvres restent.`,
  reflection: `Les civilisations passent. La puissance est temporaire. Seule la relation avec Allah compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam yaraw kam ahlakna qablahum min al-quruni wa makkanahum fi al-ard » — n'ont-ils pas vu combien de générations Nous avons fait périr avant eux ? Nous les avons installés sur terre mieux que vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends de l'histoire ? Suis-je conscient de la fragilité de la puissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans gratitude mène à la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a vu passer des milliards d'années et des milliards de formes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Qahhar, les civilisations passent. Fais que j'apprenne de l'histoire. Ne permets pas que je sois parmi les arrogants qui oublient.`
};

MIROIR["6:7"] = {
  reference: "6:7",
  theme: ["miracle", "demande", "endurcissement"],
  emotion: "Interrogation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'jizah", "Al-Bayyinah"],
  mirrorVersion: `« Si Nous avions fait descendre sur toi un écrit sur un support matériel, et qu'ils l'avaient touché de leurs mains, ceux qui mécroient auraient dit : 'Ce n'est que de la magie évidente.' » Le miroir me montre l'endurcissement du cœur. « Law anzalna 'alayka kitaban fi qirtasin » — si Nous avions fait descendre un écrit sur support matériel. « Famasahu bi-aydihim » — et qu'ils l'avaient touché de leurs mains. Le tangible ne suffit pas au cœur endurci. Le miroir m'enseigne que le problème n'est pas le signe — c'est le cœur.`,
  reflection: `Le miracle tangible ne convainc pas le cœur fermé. La foi est une question de cœur, pas de preuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law anzalna 'alayka kitaban fi qirtasin famasahu bi-aydihim laqala alladhina kafaru in hadha illa sihrun mubin » — si Nous avions fait descendre sur toi un écrit sur un support matériel, et qu'ils l'avaient touché de leurs mains, ceux qui mécroient auraient dit : ce n'est que de la magie évidente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demanderais comme preuve ? Mon cœur est-il ouvert à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur ouvert n'a pas besoin de miracles tangibles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un miracle tangible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est ouvert voit les signes partout." }
  ],
  munajat: `Ya Rabb, ne me demande pas de miracles tangibles. Ouvre mon cœur à Tes signes. Ne permets pas que je sois parmi les endurcis.`
};

MIROIR["6:8"] = {
  reference: "6:8",
  theme: ["ange", "demande", "décret"],
  emotion: "Clarté, décision",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ika", "Al-Haqq"],
  mirrorVersion: `« Et ils disent : 'Pourquoi n'a-t-on pas fait descendre sur lui un ange ?' » Le miroir me montre les exigences des mécréants. « Lawla unzila 'alayhi malak » — pourquoi n'a-t-on pas fait descendre sur lui un ange ? La demande d'un ange est une demande de preuve ultime. Mais la réponse est claire : « Si Nous avions fait descendre un ange, l'affaire aurait été réglée. » L'ange viendra quand il n'y aura plus de temps pour la foi.`,
  reflection: `L'ange viendra quand il sera trop tard. Le temps de la foi est maintenant, pas après l'évidence ultime.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu lawla unzila 'alayhi malakun wa law anzalna malakan la-qudiya al-amru » — et ils disent : pourquoi n'a-t-on pas fait descendre sur lui un ange ? Si Nous avions fait descendre un ange, l'affaire aurait été réglée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends comme preuve ? Est-ce que je comprends que l'évidence ultime peut être trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi anticipée vaut plus que l'évidence subie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont présents mais invisibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sans voir est béni." }
  ],
  munajat: `Ya Rabb, je crois sans voir d'ange. Ma foi est assez. Ne permets pas que je sois parmi ceux qui attendent trop tard.`
};

MIROIR["6:9"] = {
  reference: "6:9",
  theme: ["ange", "forme", "confusion"],
  emotion: "Sagesse, compréhension",
  difficulty: "débutant",
  relatedNames: ["Al-Hikmah", "Al-Mala'ika"],
  mirrorVersion: `« Si Nous avions fait d'un ange un messager, Nous aurions fait d'un homme un ange. » Le miroir me montre la sagesse du choix prophétique. « Walaw ja'alnahu malakan la-ja'alnahu rajulan » — si Nous en avions fait un ange, Nous l'aurions fait homme. L'ange doit ressembler à ceux à qui il est envoyé. Le messager humain est la forme la plus appropriée pour l'humanité. Le miroir m'enseigne la sagesse d'Allah dans le choix de Ses messagers.`,
  reflection: `Le messager est homme parce que l'humanité a besoin d'un modèle humain. La forme suit la fonction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Walaw ja'alnahu malakan la-ja'alnahu rajulan » — si Nous en avions fait un ange, Nous l'aurions fait homme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la forme que la guidance prend ? Ou est-ce que je veux une autre forme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La forme n'est pas importante — le message l'est." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a la forme appropriée à sa fonction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la forme accepte le message." }
  ],
  munajat: `Ya Hakim, Ta sagesse est parfaite. J'accepte Ton messager sous la forme que Tu as choisie. Ne permets pas que je rejette la forme pour manquer le message.`
};

MIROIR["6:10"] = {
  reference: "6:10",
  theme: ["moquerie", "prophètes", "conséquence"],
  emotion: "Avertissement, leçon",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Haqq"],
  mirrorVersion: `« On s'est moqué de messagers venus avant toi ; et ceux qui se moquaient d'eux ont été atteints par ce dont ils se moquaient. » Le miroir me montre la conséquence de la moquerie. « Wa laqadi astuhzi'a bi-rusulin min qablika » — on s'est moqué de messagers avant toi. La moquerie des prophètes est une constante. « Fa-haqa alladhina sakiru minhum » — ceux qui se moquaient ont été atteints. La moquerie devient réalité. Le miroir m'avertit : ne pas se moquer de ce qui est sacré.`,
  reflection: `La moquerie du sacré retourne contre le moqueur. Ce dont on se moque devient réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqadi istuhzi'a bi-rusulin min qablika fa-haqa alladhina sakiru minhum ma kanu bihi yastahzi'un » — on s'est moqué de messagers venus avant toi ; et ceux qui se moquaient d'eux ont été atteints par ce dont ils se moquaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque de ce qui est sacré ? Qu'est-ce que je risque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie n'annule pas la vérité — elle expose le moqueur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se moque pas — il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le sacré est respecté." }
  ],
  munajat: `Ya Rabb, je respecte Tes messagers. Ne permets pas que je me moque de ce qui est sacré. Préserve-moi de la moquerie destructrice.`
};

MIROIR["6:11"] = {
  reference: "6:11",
  theme: ["voyage", "réflexion", "histoire"],
  emotion: "Invitation, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mubin"],
  mirrorVersion: `« Dis : 'Parcourez la terre, puis regardez quelle fut la fin de ceux qui criaient au mensonge.' » Le miroir m'invite au voyage et à la réflexion. « Siru fi al-ard » — parcourez la terre. Le voyage est une école. « Thumma anzhuru » — puis regardez. L'observation est la méthode. « Kayfa kana 'aqibatu al-mukadhdhibin » — quelle fut la fin de ceux qui criaient au mensonge. L'histoire est pleine de leçons. Le miroir m'invite à apprendre des ruines.`,
  reflection: `Les ruines des civilisations passées sont des leçons visibles. Parcourir la terre, c'est apprendre de l'histoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul siru fi al-ard thumma anzhuru kayfa kana 'aqibatu al-mukadhdhibin » — dis : parcourez la terre, puis regardez quelle fut la fin de ceux qui criaient au mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je appris de mes voyages ? Qu'ai-je vu des ruines de l'histoire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ruines parlent à ceux qui écoutent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un livre ouvert d'histoires et de leçons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voyage avec un cœur ouvert revient transformé." }
  ],
  munajat: `Ya Hadi, fais que je parcours la terre avec sagesse. Ouvre mes yeux aux leçons de l'histoire. Ne permets pas que je passe sans voir.`
};

MIROIR["6:12"] = {
  reference: "6:12",
  theme: ["miséricorde", "réunion", "vérité"],
  emotion: "Espoir, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Jami'"],
  mirrorVersion: `« Dis : 'À qui appartient ce qui est dans les cieux et sur la terre ?' Dis : 'À Allah.' » Le miroir me montre la propriété universelle. « Li-mani ma fi as-samawati wa al-ard » — à qui appartient ce qui est dans les cieux et sur la terre ? La réponse est évidente : « Lillah » — à Allah. Tout Lui appartient. « Kataba 'ala nafsihi ar-rahmah » — Il a prescrit à Lui-même la miséricorde. La miséricorde est Sa nature. Le miroir m'invite à la confiance en Sa miséricorde.`,
  reflection: `Tout appartient à Allah. Il a prescrit la miséricorde pour Lui-même. La confiance en Sa miséricorde est fondée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul li-mani ma fi as-samawati wa al-ard qul lillah kataba 'ala nafsihi ar-rahmah » — dis : à qui appartient ce qui est dans les cieux et sur la terre ? Dis : à Allah. Il a prescrit à Lui-même la miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis dans la conscience que tout Lui appartient ? Est-ce que je fais confiance à Sa miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde d'Allah précède ma demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est maintained par la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la miséricorde d'Allah ne désespère jamais." }
  ],
  munajat: `Ya Rahman, tout T'appartient. Tu as prescrit la miséricorde pour Toi-même. Je fais confiance à Ta miséricorde. Ne permets pas que je désespère.`
};

MIROIR["6:13"] = {
  reference: "6:13",
  theme: ["repos", "nuit", "propriété"],
  emotion: "Paix, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Muhit"],
  mirrorVersion: `« À Lui tout ce qui repose la nuit et le jour. » Le miroir me montre la propriété continue. « Lahu ma sakana fi al-layli wa an-nahar » — à Lui tout ce qui repose la nuit et le jour. Le repos et l'activité, la nuit et le jour — tout Lui appartient. Je ne possède rien, même pas mon repos. Le miroir m'invite à la conscience de ma dépendance totale.`,
  reflection: `Mon repos appartient à Allah. Mon activité Lui appartient aussi. Je ne possède rien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu ma sakana fi al-layli wa an-nahar wa huwa as-sami'u al-'alim » — à Lui tout ce qui repose la nuit et le jour. Et c'est Lui l'Audient, l'Omniscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je dors, est-ce que je sais que mon sommeil Lui appartient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos n'est pas une possession — c'est un don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier repose et veille sous la garde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que son repos appartient à Allah dort en paix." }
  ],
  munajat: `Ya Muhit, mon repos T'appartient. Fais que je me souvienne de Toi dans mon sommeil. Donne-moi la paix de la dépendance totale.`
};

// ==================== SURAH 7: AL-A'RAF (The Heights) - 206 verses - COMPREHENSIVE COVERAGE ====================

MIROIR["7:1"] = {
  reference: "7:1",
  theme: ["révélation", "mystère", "attention"],
  emotion: "Révérence, concentration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mubin"],
  mirrorVersion: `« Alif, Lam, Mim, Sad. » Le miroir m'ouvre la sourate Al-A'raf par des lettres mystérieuses. « Alif Lam Mim Sad » — quatre lettres dont le sens exact nous échappe. Le mystère précède la révélation. Je ne comprends pas tout, et c'est normal. Le miroir m'invite à l'humilité devant ce que je ne peux pas saisir.`,
  reflection: `Les lettres mystérieuses rappellent que la connaissance divine dépasse l'entendement humain. L'humilité est la porte d'entrée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alif Lam Mim Sad » — lettres mystérieuses au début de la sourate." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'aborde ce que je ne comprends pas ? Avec frustration ou avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mystère n'est pas un obstacle — c'est une invitation à aller plus loin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères. Chaque découverte en révèle d'autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère reçoit la lumière de la compréhension." }
  ],
  munajat: `Ya Hakim, il y a des mystères que je ne peux pas comprendre. Donne-moi l'humilité de les accepter et la patience de chercher.`
};

MIROIR["7:11"] = {
  reference: "7:11",
  theme: ["création", "dignité", "commandement"],
  emotion: "Émerveillement, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Nous vous avons créés, puis Nous vous avons donné une forme. Puis Nous avons dit aux anges : 'Prosternez-vous devant Adam.' » Le miroir me montre la dignité de l'homme. « Wa laqad khalaqnakum thumma sawwarnakum » — Nous vous avons créés, puis Nous vous avons donné une forme. La création, puis la formation. Et enfin l'honneur : les anges se prosternent. Le miroir m'invite à reconnaître ma dignité tout en restant humble.`,
  reflection: `L'homme est honoré par Allah. Cette dignité n'est pas un accomplissement — c'est un don qui demande de la reconnaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad khalaqnakum thumma sawwarnakum thumma qulna li al-mala'ikati usjudu li-adam » — Nous vous avons créés, puis Nous vous avons donné une forme. Puis Nous avons dit aux anges : 'Prosternez-vous devant Adam.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ma dignité ? Ou est-ce que je me sous-estime ? Ou est-ce que je m'enorgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation des anges n'est pas une adoration d'Adam — c'est une reconnaissance de ce qu'il représente : le lieutenant de Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme occupe une place unique dans la création. Ni ange ni bête, il est entre les deux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît sa dignité vit à la hauteur de cette dignité." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé et honoré. Aide-moi à vivre dignement. Ne permets pas que je sois ingrat ou orgueilleux.`
};

MIROIR["7:12"] = {
  reference: "7:12",
  theme: ["orgueil", "désobéissance", "jalousie"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Mutakabbir", "Al-Khabir"],
  mirrorVersion: `« Qu'est-ce qui t'a empêché de te prosterner quand Je te l'ai ordonné ? Il répondit : 'Je suis meilleur que lui. Tu m'as créé de feu, et Tu l'as créé d'argile.' » Le miroir me montre le premier péché : l'orgueil. « Ma mana'aka alla tasjuda idh amartuk » — qu'est-ce qui t'a empêché de te prosterner ? Iblis compare : le feu est supérieur à l'argile. La comparaison mène au refus. Le miroir m'avertit : l'orgueil comparatif ferme la porte de l'obéissance.`,
  reflection: `L'orgueil commence par la comparaison. « Je suis meilleur que lui » — cette pensée a perdu Iblis. Comparer, c'est s'éloigner de l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ma mana'aka alla tasjuda idh amartuka qala ana khayrun minhu khalaqtani min nar » — qu'est-ce qui t'a empêché de te prosterner ? Il dit : je suis meilleur que lui, Tu m'as créé de feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me compare aux autres ? Est-ce que je me crois supérieur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La supériorité apparente (feu vs argile) n'est pas une vraie supériorité. L'argile reçoit l'honneur, le feu le refuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création n'est pas une hiérarchie de valeur basée sur la matière. La valeur vient de la décision divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse de se prosterner refuse sa propre élévation." }
  ],
  munajat: `Ya Allah, l'orgueil me guette. Protège-moi de la comparaison et de la supériorité. Donne-moi l'humilité de me prosterner.`
};

MIROIR["7:23"] = {
  reference: "7:23",
  theme: ["repentir", "humilité", "pardon"],
  emotion: "Regret, espoir",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Ils dirent : 'Notre Seigneur, nous avons fait du tort à nous-mêmes. Si Tu ne nous pardonnes pas et ne nous fais pas miséricorde, nous serons certes parmi les perdants.' » Le miroir me montre la première prière de repentir. « Rabbana zalamna anfusana » — notre Seigneur, nous avons fait du tort à nous-mêmes. Adam et Ève ne blame pas l'autre, pas le serpent. Ils assument leur erreur. Le miroir m'invite à ce repentir sincère.`,
  reflection: `Le vrai repentir ne blame pas les circonstances ni les autres. Il reconnaît sa propre responsabilité et demande pardon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbana zalamna anfusana wa in lam taghfir lana wa tarhamna lanakunanna mina al-khasirin » — notre Seigneur, nous avons fait du tort à nous-mêmes. Si Tu ne nous pardonnes pas, nous serons perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je pèche, est-ce que je blame les autres ? Ou est-ce que j'assume ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Faire du tort à soi-même, c'est reconnaître que le péché nous blesse en premier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque erreur a une conséquence. Le repentir est le chemin du retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avoue sa faute reçoit le pardon." }
  ],
  munajat: `Ya Tawwab, j'ai fait du tort à moi-même. Pardonne-moi. Sans Ton pardon, je suis perdant. Accorde-moi Ta miséricorde.`
};

MIROIR["7:35"] = {
  reference: "7:35",
  theme: ["envoyé", "obéissance", "piété"],
  emotion: "Attention, réponse",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Hadi"],
  mirrorVersion: `« Ô enfants d'Adam ! Si des messagers choisis parmi vous viennent à vous pour vous raconter Mes signes, quiconque pratique la piété et se réforme n'aura aucune crainte et ne sera point affligé. » Le miroir me montre la promesse divine. « Fa man ittaqa wa aslaha » — quiconque pratique la piété et se réforme. La piété protège, la réforme transforme. Le résultat : ni crainte ni affliction. Le miroir m'invite à cette double attitude.`,
  reflection: `La piété (taqwa) et la réforme (islah) sont les deux faces de la réponse au message divin. Ensemble, elles apportent la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa man ittaqa wa aslaha fala khawfun 'alayhim wa la hum yahzanun » — quiconque pratique la piété et se réforme n'aura aucune crainte et ne sera point affligé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pratique la piété ? Est-ce que je me réforme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété sans réforme est incomplète. La réforme sans piété est impossible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers suit son ordre. L'être humain peut choisir l'ordre ou le désordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui allie piété et réforme reçoit la paix dans les deux mondes." }
  ],
  munajat: `Ya Hadi, Tu as envoyé des messagers. Aide-moi à pratiquer la piété et à me réformer. Donne-moi la paix sans crainte ni affliction.`
};

MIROIR["7:43"] = {
  reference: "7:43",
  theme: ["gratitude", "espoir", "guérison"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shakur", "Al-Wadud"],
  mirrorVersion: `« Et ils diront : 'Louange à Allah qui nous a guidés vers ceci. Nous n'aurions pas été guidés si Allah ne nous avait pas guidés.' » Ce verset décrit les habitants du Paradis. Le miroir me place au cœur de leur reconnaissance. Ils ne disent pas « nous avons mérité ». Ils disent « nous n'aurions pas été guidés si... ». La gratitude n'est pas pour l'accomplissement personnel — elle est pour le Don reçu. Le Paradis n'est pas une récompense pour mes efforts — c'est le résultat de Sa guidance.`,
  reflection: `Au Paradis, la première parole est « al-hamdu lillah » — la louange. Pas l'orgueil, pas la comparaison, mais la reconnaissance pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une scène du Paradis : les élus reconnaissent que leur présence là n'est pas leur mérite, mais le fruit de la guidance divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans mes réussites, combien de fois dis-je « c'est grâce à Allah » ? Et combien de fois dis-je « c'est grâce à moi » ? Le miroir mesure mon gratitude." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance précède le guidé. Allah a guidé avant même que je ne demande à l'être. Sa miséricorde court après moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute guidance est un don. L'étoile qui guide le navigateur, l'instinct qui guide l'oiseau migrateur — tout vient de Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie gratitude n'est pas dans les mots — elle est dans la conscience que tout est don. Même la capacité de dire « merci » est un don." }
  ],
  munajat: `Ya Allah, tout ce que j'ai vient de Toi. Même ma capacité à Te remercier. Fais que ma gratitude soit sincère — pas une formule, mais une conscience constante.`
};

MIROIR["7:54"] = {
  reference: "7:54",
  theme: ["création", "souveraineté", "adoration"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Khaliq"],
  mirrorVersion: `« Votre Seigneur est Allah qui a créé les cieux et la terre en six jours, puis S'est établi sur le Trône. Il couvre le jour de la nuit qui le poursuit. » Le miroir me montre la souveraineté d'Allah. « Inna rabbakumu Allahu alladhi khalaqa as-samawati wa al-arda fi sittati ayyam » — votre Seigneur est Allah qui a créé les cieux et la terre en six jours. La création est ordonnée. Le Trône est la souveraineté. Le miroir m'invite à adorer le Souverain de l'univers.`,
  reflection: `Allah est le Créateur et le Souverain. L'ordre de la création reflète Sa sagesse. Le Trône symbolise Son autorité sur tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbakumu Allahu alladhi khalaqa as-samawati wa al-arda fi sittati ayyam thumma astawa 'ala al-'arsh » — votre Seigneur est Allah qui a créé les cieux et la terre en six jours, puis S'est établi sur le Trône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la souveraineté d'Allah sur ma vie ? Ou est-ce que je veux être mon propre souverain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Trône n'est pas un lieu physique — c'est l'expression de l'autorité absolue d'Allah sur toute chose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur. Les cieux et la terre sont Ses sujets." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet au Souverain reçoit Sa protection." }
  ],
  munajat: `Ya Malik, Tu es le Souverain de l'univers. Je me soumets à Ton autorité. Règne sur mon cœur et ordonne ma vie.`
};

MIROIR["7:55"] = {
  reference: "7:55",
  theme: ["invocation", "humilité", "discrétion"],
  emotion: "Tendresse, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Khafi"],
  mirrorVersion: `« Invoquez votre Seigneur avec humilité et discrétion. Il n'aime pas les transgresseurs. » Le miroir me montre la posture de l'invocation. « Ud'u rabbakum tadarru'an wa khufyah » — invoquez votre Seigneur avec humilité et discrétion. L'invocation n'est pas une performance publique. C'est un cœur qui se tourne en secret. Le miroir m'invite à l'intimité avec Allah.`,
  reflection: `La meilleure invocation est celle du cœur sincère, pas celle de la voix forte. L'intimité avec Allah se construit dans le secret.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ud'u rabbakum tadarru'an wa khufyah » — invoquez votre Seigneur avec humilité et discrétion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'invoque Allah ? Avec ostentation ou dans le secret du cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret entre Allah et Son serviteur est le plus précieux. Personne d'autre n'y a accès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers prie en silence. Les étoiles, les arbres, les rivières — tout adore en secret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie dans le secret reçoit dans le secret." }
  ],
  munajat: `Ya Mujib, j'invoque Ton nom en secret. Entends ma prière silencieuse. Donne-moi l'intimité avec Toi.`
};

MIROIR["7:89"] = {
  reference: "7:89",
  theme: ["témoin", "mensonge", "jugement"],
  emotion: "Sérieux, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-Haqq"],
  mirrorVersion: `« Nous aurions forgé un mensonge contre Allah si nous revenions à votre religion après qu'Allah nous en ait sauvés. Il ne convient pas que nous y retournions, sauf si Allah notre Seigneur le veut. » Le miroir me montre la fermeté de la foi. « Qad iftarayna 'ala Allahi kadhiban » — nous aurions forgé un mensonge contre Allah. Revenir en arrière après la guidance serait un mensonge. Le miroir m'invite à la constance dans la vérité.`,
  reflection: `La guidance reçue est un trésor. L'abandonner serait un mensonge contre Allah qui nous a guidés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad iftarayna 'ala Allahi kadhiban in 'udna fi millatikum » — nous aurions forgé un mensonge contre Allah si nous revenions à votre religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis constant dans ma foi ? Ou est-ce que je reviens en arrière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Revenir en arrière après la guidance est pire que ne jamais avoir été guidé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne change pas. Celui qui l'a trouvée ne doit pas la quitter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste ferme dans la vérité reçoit la fermeté d'Allah." }
  ],
  munajat: `Ya Shahid, Tu es témoin de ma foi. Garde-moi ferme dans la vérité. Ne permets pas que je retourne à l'égarement.`
};

MIROIR["7:128"] = {
  reference: "7:128",
  theme: ["patience", "victoire", "piété"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "An-Nasir"],
  mirrorVersion: `« Moïse dit à son peuple : 'Demandez l'aide d'Allah et faites preuve de patience. La terre appartient à Allah, et Il la donne en héritage à qui Il veut parmi Ses serviteurs.' » Le miroir me montre la réponse à l'oppression. « Fasta'inu bi Allahi wasbiru » — demandez l'aide d'Allah et faites preuve de patience. La patience active, pas passive. L'aide d'Allah vient. La terre Lui appartient. Le miroir m'invite à la patience confiante.`,
  reflection: `La patience avec Allah n'est pas de la passivité. C'est l'attente active de Sa justice et de Sa victoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fasta'inu bi Allahi wasbiru inna al-arda lillahi yurithuha man yasha'u min 'ibadih » — demandez l'aide d'Allah et faites preuve de patience. La terre appartient à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans l'oppression, est-ce que je demande l'aide d'Allah ? Est-ce que je suis patient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre n'appartient à personne définitivement. Elle passe de main en main selon la volonté d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine de renversements. Les opprimés deviennent héritiers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente avec Allah reçoit Son héritage." }
  ],
  munajat: `Ya Nasir, dans mon oppression, je demande Ton aide. Donne-moi la patience. Fais-moi hériter de la terre avec les pieux.`
};

MIROIR["7:143"] = {
  reference: "7:143",
  theme: ["révélation", "montagne", "incapacité"],
  emotion: "Émerveillement, humilité",
  difficulty: "avancé",
  relatedNames: ["Al-Zahir", "Al-Batin"],
  mirrorVersion: `« Et quand Moïse vint à Notre rendez-vous et que son Seigneur lui eut parlé, il dit : 'Seigneur, montre-Toi à moi que je Te voie !' Il dit : 'Tu ne Me verras pas, mais regarde la montagne. Si elle reste en place, tu Me verras.' Quand son Seigneur Se manifesta à la montagne, Il la réduisit en poussière, et Moïse s'effondra foudroyé. » Le miroir me montre la grandeur de la manifestation divine. « Lamma tajalla rabbuhu li al-jabali ja'alahu dakkan » — quand son Seigneur Se manifesta à la montagne, Il la réduisit en poussière. La montagne ne peut pas supporter la manifestation. Moi non plus. Le miroir m'invite à l'humilité radicale.`,
  reflection: `La vision d'Allah dans ce monde dépasse notre capacité. Même la montagne s'effondre. Notre adoration est celle de la foi, pas de la vision.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lamma tajalla rabbuhu li al-jabali ja'alahu dakkan wa kharra musa sa'iqan » — quand son Seigneur Se manifesta à la montagne, Il la réduisit en poussière, et Moïse s'effondra foudroyé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si la montagne ne peut pas supporter la manifestation d'Allah, comment pourrais-je ? Mon adoration doit passer par l'humilité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incapacité de voir Allah est une protection. Nous ne pourrions pas survivre à Sa pleine manifestation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière tremble devant son Créateur. L'être humain peut choisir de se prosterner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'effondre devant la grandeur d'Allah sera relevé par Sa miséricorde." }
  ],
  munajat: `Ya Zahir, Ta grandeur dépasse tout. Je ne peux pas Te voir, mais je peux T'adorer. Donne-moi l'humilité de me prosterner devant Toi.`
};

MIROIR["7:144"] = {
  reference: "7:144",
  theme: ["élection", "gratitude", "responsabilité"],
  emotion: "Reconnaissance, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mustaf", "Al-Mujib"],
  mirrorVersion: `« Il dit : 'Ô Moïse, Je t'ai préféré à tous les hommes par Mes messages et Ma parole. Prends donc ce que Je t'ai donné et sois du nombre des reconnaissants.' » Le miroir me montre la grâce divine. « Inni istafaytuka 'ala an-nas » — Je t'ai préféré à tous les hommes. L'élection n'est pas un privilège à revendiquer mais un don à accueillir avec gratitude. Le miroir m'invite à la reconnaissance pour tout ce qu'Allah m'a donné.`,
  reflection: `La préférence divine est une responsabilité. Chaque bénédiction est aussi un engagement à la gratitude et au service.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innî istafaytuka 'ala an-nas bi-risalati wa bi-kalami » — Je t'ai préféré à tous les hommes par Mes messages et Ma parole." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je reçu d'Allah ? Est-ce que je suis reconnaissant pour ces dons ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élection n'élève pas l'homme au-dessus des autres — elle l'engage envers Allah et les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être humain a des dons uniques. La reconnaissance les transforme en offrande." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude est la clé qui ouvre la porte des bénédictions continues." }
  ],
  munajat: `Ya Allah, Tu m'as donné tant de choses que je ne mérite pas. Apprends-moi la gratitude. Fais que je sois du nombre des reconnaissants.`
};

MIROIR["7:145"] = {
  reference: "7:145",
  theme: ["tablettes", "guidance", "rappel"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Hakim"],
  mirrorVersion: `« Et Nous écrivîmes pour lui sur les tablettes une exhortation concernant toute chose et un exposé détaillé de toute chose. » Le miroir me montre la guidance complète. « Wa katabna lahu fi al-alwah » — Nous écrivîmes pour lui sur les tablettes. La révélation est écrite, précise, complète. Elle couvre toute chose. Le miroir m'invite à prendre la guidance divine avec sérieux et attention.`,
  reflection: `La guidance d'Allah est complète et détaillée. Elle n'oublie rien de ce dont nous avons besoin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa katabna lahu fi al-alwah min kulli shay'in maw'izatan » — Nous écrivîmes pour lui sur les tablettes une exhortation concernant toute chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends la guidance d'Allah au sérieux ? Est-ce que je la lis avec attention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance n'est pas une contrainte — elle est un guide vers le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création suit les lois divines. L'être humain reçoit une guidance explicite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les tablettes de la guidance sont gravées dans le cœur de celui qui les médite." }
  ],
  munajat: `Ya Hadi, Ta guidance est complète. Aide-moi à la lire, la comprendre et la mettre en pratique avec sérieux.`
};

MIROIR["7:146"] = {
  reference: "7:146",
  theme: ["orgueil", "guidance", "humilité"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mutakabbir", "Al-Hadi"],
  mirrorVersion: `« Je détournerai de Mes signes ceux qui s'enorgueillissent sans raison sur terre. » Le miroir me montre le danger de l'orgueil. « Sa-asrifu 'an ayatiya alladhina yatakabbaruna » — Je détournerai de Mes signes ceux qui s'enorgueillissent. L'orgueil ferme les portes de la guidance. Celui qui se croit supérieur ne peut pas recevoir la vérité. Le miroir m'invite à l'humilité radicale.`,
  reflection: `L'orgueil est le plus grand obstacle à la guidance. Il rend aveugle aux signes d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa-asrifu 'an ayatiya alladhina yatakabbaruna fi al-ardi bighayri al-haqq » — Je détournerai de Mes signes ceux qui s'enorgueillissent sur terre sans raison." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'orgueil m'empêche de voir les signes d'Allah ? De reconnaître mes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité ouvre les portes que l'orgueil ferme. Se savoir petit devant Allah, c'est devenir grand à Ses yeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueilleux refuse de voir sa place dans la création. L'humble accepte sa petitesse et trouve sa grandeur en Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clé de la guidance est l'humilité. Sans elle, même les signes les plus clairs restent invisibles." }
  ],
  munajat: `Ya Allah, protège-moi de l'orgueil. Je ne suis rien sans Toi. Ouvre mes yeux à Tes signes par l'humilité.`
};

MIROIR["7:147"] = {
  reference: "7:147",
  theme: ["négation", "au-delà", "perdition"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hasib"],
  mirrorVersion: `« Ceux qui traitent de mensonges Nos signes ainsi que la rencontre de l'au-delà, leurs œuvres sont vaines. » Le miroir me montre la conséquence du déni. « Wa alladhina kadhdhabu bi-ayatina » — ceux qui traitent de mensonges Nos signes. Le déni annule le sens de l'action. Sans la foi en l'au-delà, les œuvres perdent leur valeur éternelle. Le miroir m'invite à la sincérité dans la foi.`,
  reflection: `La foi en l'au-delà donne sens à nos actions. Sans elle, tout s'effondre dans la vanité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kadhdhabu bi-ayatina wa liqa'i al-akhirati habitat a'maluhum » — ceux qui traitent de mensonges Nos signes ainsi que la rencontre de l'au-delà, leurs œuvres sont vaines." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en l'au-delà ? Est-ce que cette foi transforme mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les œuvres sans foi sont comme un corps sans âme — elles peuvent paraître belles mais sont vides." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action laisse une trace. La foi lui donne une dimension éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'intention sincere transforme l'acte le plus simple en offrande éternelle." }
  ],
  munajat: `Ya Haqq, je crois en Toi et en l'au-delà. Fais que ma foi transforme mes actions en œuvres durables.`
};

MIROIR["7:148"] = {
  reference: "7:148",
  theme: ["veau", "idolâtrie", "égarement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Et le peuple de Moïse adopta pour idole un veau fait de leurs ornements, un corps qui mugissait. » Le miroir me montre la faiblesse humaine face aux idoles. « Wa attakhadha qawmu musa min huliyyihim 'ijlan jasadun lahu khuwara » — le peuple de Moïse adopta un veau fait de leurs ornements. L'or qu'ils portaient est devenu leur idole. Le miroir m'invite à examiner ce que je fais de mes biens et de mon temps.`,
  reflection: `L'idolâtrie n'est pas seulement le culte des statues. C'est tout ce qui prend la place d'Allah dans le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa attakhadha qawmu musa min huliyyihim 'ijlan jasadun lahu khuwara » — le peuple de Moïse adopta un veau fait de leurs ornements, un corps qui mugissait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui a pris la place d'Allah dans mon cœur ? L'argent ? Le statut ? Les plaisirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ornements que nous portons peuvent devenir nos idoles si nous ne faisons pas attention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'être humain est créateur d'idoles. Il a besoin de revenir sans cesse au Créateur unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'idole la plus dangereuse est celle qui se cache dans le cœur sans qu'on la nomme." }
  ],
  munajat: `Ya Wahid, Tu es le seul digne d'adoration. Délivre mon cœur de toutes les idoles. Fais que rien ne Te remplace.`
};

MIROIR["7:149"] = {
  reference: "7:149",
  theme: ["repentir", "erreur", "miséricorde"],
  emotion: "Regret, espoir",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Et quand ils éprouvèrent du regret et qu'ils virent qu'ils étaient égarés, ils dirent : 'Si notre Seigneur ne nous fait pas miséricorde, nous serons certainement parmi les perdants.' » Le miroir me montre le chemin du retour. « Wa lamma suqita fi aydihim » — quand ils éprouvèrent du regret. Le regret sincère est le début du retour. Ils reconnaissent leur égarement et demandent la miséricorde. Le miroir m'invite à ce retour constant vers Allah.`,
  reflection: `Le regret sincère efface les erreurs. La porte de la miséricorde est toujours ouverte pour celui qui revient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lamma suqita fi aydihim wa ra'aw annahum qad dalqu qalu ila lam yarhamna rabbuna » — quand ils éprouvèrent du regret et qu'ils virent qu'ils étaient égarés, ils dirent : 'Si notre Seigneur ne nous fait pas miséricorde...'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je me trompe, est-ce que je ressens du regret ? Est-ce que je demande la miséricorde d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'erreur n'est pas irréparable. Le regret sincère ouvre la porte de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout être humain se trompe. La différence est dans le retour vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le regret qui mène à la supplication est lui-même une grâce d'Allah." }
  ],
  munajat: `Ya Tawwab, j'ai fait des erreurs. Je regrette et je reviens vers Toi. Accorde-moi Ta miséricorde avant qu'il ne soit trop tard.`
};

MIROIR["7:150"] = {
  reference: "7:150",
  theme: ["colère", "tablettes", "pardon"],
  emotion: "Trouble, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halim", "Al-Ghafur"],
  mirrorVersion: `« Et quand Moïse retourna vers son peuple, furieux et attristé, il dit : 'Quelle mauvaise succession vous avez faite après moi !' » Le miroir me montre la réaction du prophète. « Wa lamma raja'a musa ila qawmihi ghadbana asifa » — quand Moïse retourna vers son peuple, furieux et attristé. La colère de Moïse était pour Allah, pas pour lui-même. Il a jeté les tablettes, puis les a reprises. Le miroir m'invite à gérer ma colère avec sagesse.`,
  reflection: `La colère pour la vérité peut être légitime, mais elle doit être canalisée. Moïse a su pardonner après la colère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lamma raja'a musa ila qawmihi ghadbana asifa » — quand Moïse retourna vers son peuple, furieux et attristé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand je vois le mal ? Avec colère ? Avec sagesse ? Avec pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La colère du prophète était pour Allah, pas pour son ego. C'est ce qui lui a permis de pardonner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La trahison fait partie de l'expérience humaine. La réponse juste est le retour à la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La colère gérée avec sagesse devient une force de transformation." }
  ],
  munajat: `Ya Halim, apprends-moi à gérer ma colère. Fais qu'elle soit toujours pour Toi et jamais pour mon ego. Donne-moi la sagesse de pardonner.`
};

MIROIR["7:151"] = {
  reference: "7:151",
  theme: ["intercession", "pardon", "fraternité"],
  emotion: "Supplication, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffar", "Ar-Ra'uf"],
  mirrorVersion: `« Il dit : 'Seigneur, pardonne à moi et à mon frère et fais-nous entrer dans Ta miséricorde, car Tu es le plus Miséricordieux des miséricordieux.' » Le miroir me montre l'intercession de Moïse. « Rabbi ghfir li wa li-akhi » — Seigneur, pardonne à moi et à mon frère. Moïse demande le pardon pour lui-même ET pour son frère qui l'a trahi. Le miroir m'invite à la miséricorde envers ceux qui m'ont fait du tort.`,
  reflection: `Le vrai pardon inclut ceux qui nous ont blessés. La prière pour les autres est un signe de grandeur d'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi ghfir li wa li-akhi wa adkhilna fi rahmatika wa anta arhamu ar-rahimin » — Seigneur, pardonne à moi et à mon frère et fais-nous entrer dans Ta miséricorde, car Tu es le plus Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour ceux qui m'ont fait du tort ? Ou est-ce que je garde rancune ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Prier pour celui qui m'a blessé, c'est me libérer de la prison du ressentiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse tous ceux qui reviennent vers Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière sincère pour les autres purifie le cœur de toute rancune." }
  ],
  munajat: `Ya Ghaffar, pardonne-moi et pardonne à ceux qui m'ont fait du tort. Fais entrer tous dans Ta miséricorde. Libère mon cœur de toute rancune.`
};

MIROIR["7:152"] = {
  reference: "7:152",
  theme: ["châtiment", "idolâtrie", "justice"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui ont adoré le veau encourent la colère de leur Seigneur et l'humiliation dans la vie présente. » Le miroir me montre les conséquences de l'idolâtrie. « Inna alladhina attakhadhu al-'ijl » — ceux qui ont adoré le veau. La conséquence est double : colère divine et humiliation dans cette vie. L'idole qu'on adore finit par nous humilier. Le miroir m'invite à éviter toute forme d'idolâtrie.`,
  reflection: `L'idole qu'on adore devient notre maître et nous humilie. Seul Allah élève ceux qui L'adorent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina attakhadhu al-'ijl sayanahum ghadabun min rabbihim wa dhillatun fi al-hayati ad-dunya » — ceux qui ont adoré le veau encourent la colère de leur Seigneur et l'humiliation dans la vie présente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'humilie ? Ce à quoi je m'attache plus qu'à Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah élève. L'adoration de toute autre chose abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine atteint chaque idolâtre, tôt ou tard, dans cette vie ou dans l'autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humiliation est le signe que l'âme adore autre qu'Allah." }
  ],
  munajat: `Ya Allah, protège-moi de toute idolâtrie. Fais que Tu sois le seul Maître de mon cœur. Élève-moi par Ton adoration.`
};

MIROIR["7:153"] = {
  reference: "7:153",
  theme: ["repentir", "miséricorde", "pardon"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Quant à ceux qui ont fait de mauvaises actions et qui ensuite se sont repentis et ont cru, ton Seigneur est après cela Pardonneur et Miséricordieux. » Le miroir me montre l'espoir après le péché. « Wa alladhina 'amilu as-sayyi'at » — ceux qui ont fait de mauvaises actions. Même après le péché, le repentir sincère ouvre la porte du pardon. Le miroir m'invite à ne jamais désespérer de la miséricorde d'Allah.`,
  reflection: `Le péché n'est pas irréparable. Le repentir sincère efface tout. La miséricorde d'Allah est plus grande que tous les péchés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina 'amilu as-sayyi'at thumma tabu min ba'diha wa amanu innaka rabbuka min ba'diha ghafurun rahim » — ceux qui ont fait de mauvaises actions et qui ensuite se sont repentis et ont cru, ton Seigneur est après cela Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désespère après mes péchés ? Ou est-ce que je me repens sincèrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désespoir est plus grave que le péché. Il ferme la porte que le repentir peut ouvrir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La porte du repentir est ouverte tant que l'âme est dans ce monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le repentir sincère transforme le péché en béneviction par la grâce d'Allah." }
  ],
  munajat: `Ya Tawwab, j'ai fait des erreurs. Je me repens sincèrement. Accorde-moi Ton pardon et Ta miséricorde. Ne me laisse jamais désespérer de Toi.`
};

MIROIR["7:154"] = {
  reference: "7:154",
  theme: ["calme", "tablettes", "guidance"],
  emotion: "Apaisement, réception",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Hadi"],
  mirrorVersion: `« Et quand la colère de Moïse se fut calmée, il prit les tablettes. » Le miroir me montre l'importance du calme. « Wa lamma sakata 'an musa al-ghadab » — quand la colère de Moïse se fut calmée. La colère passée, Moïse peut reprendre les tablettes. La guidance se reçoit dans le calme, pas dans l'agitation. Le miroir m'invite à cultiver la sérénité pour recevoir la guidance.`,
  reflection: `La colère trouble la réception de la guidance. Le calme permet de retrouver la clarté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lamma sakata 'an musa al-ghadab akhadha al-alwah » — quand la colère de Moïse se fut calmée, il prit les tablettes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends des décisions dans la colère ? Ou est-ce que j'attends le calme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La colère nous fait jeter la guidance. Le calme nous permet de la récupérer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau agitée ne peut refléter le ciel. Le cœur agité ne peut refléter la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sérénité est la condition de la réception divine." }
  ],
  munajat: `Ya Sabur, apprends-moi le calme. Quand la colère m'envahit, fais que je patiente jusqu'à ce qu'elle passe. Alors je pourrai recevoir Ta guidance.`
};

MIROIR["7:155"] = {
  reference: "7:155",
  theme: ["élection", "tremblement", "supplication"],
  emotion: "Humilité, supplication",
  difficulty: "avancé",
  relatedNames: ["Al-Qahhar", "Al-Jalil"],
  mirrorVersion: `« Et Moïse choisit parmi son peuple soixante-dix hommes pour Notre rendez-vous. Puis le tremblement de terre les saisit. » Le miroir me montre la grandeur de la rencontre divine. « Wa akhadhatkumu ar-rajfah » — le tremblement vous a saisis. Même les élus ne peuvent pas supporter la grandeur divine. Moïse supplie : « Tu es notre Bienfaiteur, pardonne-nous. » Le miroir m'invite à l'humilité radicale devant la grandeur d'Allah.`,
  reflection: `La grandeur divine dépasse toute capacité humaine. Même les plus proches tremblent devant Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akhadhatkumu ar-rajfah » — le tremblement vous a saisis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je ressens la grandeur d'Allah ? Ou est-ce que je La prends à la légère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Plus on est proche d'Allah, plus on est conscient de Sa grandeur et de notre petitesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière tremble devant son Créateur. L'être humain oublie souvent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le tremblement sacré est le signe de la présence divine." }
  ],
  munajat: `Ya Jalil, Ta grandeur me dépasse. Fais que je ne T'oublie jamais. Donne-moi la conscience de Ta majesté et la supplication sincère.`
};

MIROIR["7:156"] = {
  reference: "7:156",
  theme: ["miséricorde", "science", "générosité"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wasi'"],
  mirrorVersion: `« Et écris pour nous une bonne chose dans ce monde et dans l'au-delà. Nous nous sommes guidés vers Toi. » Le miroir me montre la prière de Moïse. « Uktub lana fi hadhihi ad-dunya hasanatan wa fi al-akhirah » — écris pour nous une bonne chose dans ce monde et dans l'au-delà. Les deux mondes ensemble. La bonne chose dans chacun. Le miroir m'invite à demander pour les deux mondes.`,
  reflection: `La prière complète demande le bien dans ce monde et dans l'au-delà. Les deux ne sont pas opposés — ils sont complémentaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uktub lana fi hadhihi ad-dunya hasanatan wa fi al-akhirah » — écris pour nous une bonne chose dans ce monde et dans l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi je prie ? Pour ce monde seul ? Pour l'au-delà seul ? Ou pour les deux ensemble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne chose dans ce monde prépare la bonne chose dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce monde est le champ de l'au-delà. Ce qu'on y sème, on le récoltera là-bas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande pour les deux mondes reçoit dans les deux." }
  ],
  munajat: `Ya Rahman, écris pour moi une bonne chose dans ce monde et dans l'au-delà. Je me suis tourné vers Toi. Accorde-moi Ta miséricorde.`
};

MIROIR["7:157"] = {
  reference: "7:157",
  theme: ["prophète", "révélation", "guidance"],
  emotion: "Espoir, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Ceux qui suivent le Messager, le Prophète illettré qu'ils trouvent mentionné chez eux dans la Thora et l'Évangile. » Le miroir me montre la continuité de la guidance. « Alladhina yattabi'una ar-rasula an-nabiyya al-ummiyya » — ceux qui suivent le Messager, le Prophète illettré. La prophétie est une chaîne continue. Le Prophète Muhammad est annoncé dans les livres précédents. Le miroir m'invite à reconnaître l'unité du message divin.`,
  reflection: `La prophétie est une lumière continue à travers l'histoire. Reconnaître le Prophète, c'est reconnaître la vérité de tous les prophètes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yattabi'una ar-rasula an-nabiyya al-ummiyya alladhi yajidunahu maktuban 'indahum fi at-tawrati wa al-injil » — ceux qui suivent le Messager, le Prophète illettré qu'ils trouvent mentionné chez eux dans la Thora et l'Évangile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le Prophète ? Est-ce que je le suis vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète illetté est le plus savant — sa science vient d'Allah, pas des hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes sont des frères, des lumières de la même source." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît un prophète reconnaît tous les prophètes." }
  ],
  munajat: `Ya Allah, fais que je suive Ton Prophète avec sincérité. Fais que je le reconnaisse dans tous les signes que Tu as envoyés.`
};

MIROIR["7:158"] = {
  reference: "7:158",
  theme: ["unification", "prophète", "foi"],
  emotion: "Engagement, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Ar-Rasul"],
  mirrorVersion: `« Dis : 'Ô vous les hommes, je suis le Messager d'Allah à vous tous, de Celui à Qui appartient la royauté des cieux et de la terre.' » Le miroir me montre l'universalité du message. « Qul ya ayyuha an-nasu inni rasulu Allahi ilaykum jami'an » — je suis le Messager d'Allah à vous tous. Le message n'est pas pour un peuple, mais pour l'humanité entière. Le miroir m'invite à embrasser cette universalité.`,
  reflection: `Le message du Prophète est universel. Il s'adresse à chaque être humain sans exception.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ayyuha an-nasu inni rasulu Allahi ilaykum jami'an » — dis : je suis le Messager d'Allah à vous tous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère le message comme universel ? Ou est-ce que je le limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le message universel demande une réponse universelle — la foi de chaque cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité entière est destinataire du même message. La diversité n'empêche pas l'unité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'appel universel entre dans la communauté universelle." }
  ],
  munajat: `Ya Wahid, Ton message est pour tous. Fais que je l'entende et que j'y réponde avec tout mon cœur.`
};

MIROIR["7:159"] = {
  reference: "7:159",
  theme: ["communauté", "guidance", "justice"],
  emotion: "Espoir, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muqtadir"],
  mirrorVersion: `« Parmi le peuple de Moïse, il est une communauté qui guide par la vérité et qui par elle exerce la justice. » Le miroir me montre la possibilité de la justice. « Min qawmi musa ummatun ya'duna bi al-haqq » — une communauté qui guide par la vérité. Même dans les temps difficiles, il y a toujours des justes. Le miroir m'invite à faire partie de cette communauté qui guide et qui est juste.`,
  reflection: `La justice est possible. Il y a toujours des justes qui guident par la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min qawmi musa ummatun ya'duna bi al-haqq wa bihi ya'dilun » — parmi le peuple de Moïse, une communauté qui guide par la vérité et qui par elle exerce la justice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de cette communauté ? Est-ce que je guide par la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance par la vérité demande d'être soi-même guidé par elle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans chaque communauté, il y a des justes. Ils sont le sel de la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide par la vérité est guidé par elle." }
  ],
  munajat: `Ya Hadi, fais que je sois parmi ceux qui guident par la vérité. Donne-moi la justice dans mes paroles et mes actes.`
};

MIROIR["7:160"] = {
  reference: "7:160",
  theme: ["division", "bénédiction", "épreuve"],
  emotion: "Gratitude, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Ar-Razzaq"],
  mirrorVersion: `« Et Nous les répartîmes en douze tribus, en communautés. » Le miroir me montre l'organisation divine. « Wa qatta'nahum ithnay 'ashrata asbatan » — Nous les répartîmes en douze tribus. La division peut être une bénédiction quand elle vient d'Allah. Le peuple devient une communauté organisée. Le miroir m'invite à voir la sagesse dans l'organisation.`,
  reflection: `L'organisation et la division peuvent être des bénédictions quand elles viennent d'Allah. Elles permettent la gestion et la responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qatta'nahum ithnay 'ashrata asbatan umaman » — Nous les répartîmes en douze tribus, en communautés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois la division dans ma communauté ? Comme une malédiction ou comme une possibilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division voulue par Allah est organisation. La division voulue par l'ego est fragmentation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La diversité dans l'unité est la signature de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'unité dans la diversité est le secret de la communauté harmonieuse." }
  ],
  munajat: `Ya Fattah, organise ma vie selon Ta sagesse. Fais que je voie la bénédiction dans la diversité et l'organisation.`
};

MIROIR["7:161"] = {
  reference: "7:161",
  theme: ["entrée", "humilité", "pardon"],
  emotion: "Espoir, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Et quand il leur fut dit : 'Habitez cette cité et mangez de ses produits où vous voulez, et dites : rémission, et entrez par la porte en vous prosternant.' » Le miroir me montre la condition de l'entrée. « Udkhulu al-baba sujjadan » — entrez par la porte en vous prosternant. L'entrée dans la bénédiction demande l'humilité. La prosternation est la posture de l'entrée. Le miroir m'invite à l'humilité pour recevoir les bénédictions.`,
  reflection: `L'humilité est la condition de l'entrée dans la bénédiction. Se prosterner, c'est reconnaître notre dépendance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udkhulu al-baba sujjadan wa qulu hittatun » — entrez par la porte en vous prosternant et dites : rémission." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'entre dans les bénédictions ? Avec orgueil ou avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation est la posture la plus haute — elle élève l'humain au plus près d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création se soumet à son Créateur. L'humain choisit sa posture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne pour entrer, entrera debout dans la lumière." }
  ],
  munajat: `Ya Ghafur, je me prosterne devant Toi. Je demande Ta rémission. Fais-moi entrer dans Tes bénédictions avec humilité.`
};

MIROIR["7:162"] = {
  reference: "7:162",
  theme: ["désobéissance", "substitution", "châtiment"],
  emotion: "Mise en garde, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Muntaqim"],
  mirrorVersion: `« Mais ceux d'entre eux qui étaient injustes substituèrent une autre parole à celle qui leur avait été dite. » Le miroir me montre la substitution du mal. « Fa baddala alladhina zalamu minhum qawlan ghayra alladhi qila lahum » — les injustes substituèrent une autre parole. Au lieu de dire « hittatun » (rémission), ils ont dit autre chose. La désobéissance commence par la substitution des paroles. Le miroir m'invite à la fidélité à la parole divine.`,
  reflection: `La désobéissance commence par de petits changements. Une parole ici, un acte là. La fidélité demande la précision.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa baddala alladhina zalamu minhum qawlan ghayra alladhi qila lahum » — les injustes substituèrent une autre parole à celle qui leur avait été dite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je change les paroles d'Allah ? Est-ce que j'adapte Sa guidance à mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Substituer la parole divine, c'est s'éloigner de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah est parfaite. La changer, c'est l'imperfection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fidélité à la parole est la fidélité au Guide." }
  ],
  munajat: `Ya Allah, garde-moi fidèle à Ta parole. Ne me laisse pas substituer mes désirs à Ta guidance. Fais que je dise ce que Tu veux que je dise.`
};

MIROIR["7:163"] = {
  reference: "7:163",
  theme: ["sabbat", "épreuve", "désobéissance"],
  emotion: "Mise en garde, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hasib"],
  mirrorVersion: `« Et interroge-les au sujet de la cité qui donnait sur la mer, quand on y transgressait le sabbat. » Le miroir me montre l'épreuve du sabbat. « Wa sa'alhum 'ani al-qaryati allati kanat hadirata al-bahr » — interroge-les au sujet de la cité qui donnait sur la mer. Le sabbat était un jour sacré, mais ils l'ont transgressé. L'épreuve était claire, la désobéissance était délibérée. Le miroir m'invite à respecter les limites sacrées.`,
  reflection: `Les limites sacrées sont des protections. Les transgresser, c'est s'exposer aux conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sa'alhum 'ani al-qaryati allati kanat hadirata al-bahr idh yasduna fi as-sabt » — interroge-les au sujet de la cité qui donnait sur la mer, quand on y transgressait le sabbat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles limites sacrées je transgresse ? Quels commandements je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les limites d'Allah sont des protections, pas des restrictions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création respecte les limites. L'être humain peut choisir de les transgresser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La transgression des limites sacrées appelle la conséquence sacrée." }
  ],
  munajat: `Ya Hakam, aide-moi à respecter Tes limites. Elles sont pour mon bien, pas ma restriction. Protège-moi de la transgression délibérée.`
};

MIROIR["7:164"] = {
  reference: "7:164",
  theme: ["avertissement", "communauté", "responsabilité"],
  emotion: "Responsabilité, engagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Maw'iz", "Al-Hakim"],
  mirrorVersion: `« Et quand une communauté dit : 'Pourquoi exhortez-vous un peuple qu'Allah va anéantir ou châtier sévèrement ?' » Le miroir me montre le débat sur l'avertissement. Certains disaient : pourquoi avertir ceux qui vont périr ? Mais d'autres continuaient à avertir. Le devoir d'avertir n'est pas conditionné par le résultat. Le miroir m'invite à la responsabilité sans calcul.`,
  reflection: `Le devoir de dire la vérité n'est pas conditionné par le résultat. Dire le bien reste un devoir même si les autres n'écoutent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qalat ummatun minhum lima ta'izuna qawman Allahu muhlikuhum aw mu'adhdhibuhum » — quand une communauté dit : pourquoi exhortez-vous un peuple qu'Allah va anéantir ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je renonce à dire le bien parce que les autres n'écoutent pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement peut toucher ceux qui le prononcent autant que ceux qui l'entendent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien reste le bien, indépendamment de la réponse des autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Dire la vérité est un acte d'obéissance, pas une stratégie de résultat." }
  ],
  munajat: `Ya Hakim, aide-moi à dire le bien même quand les autres n'écoutent pas. Mon devoir est de dire, pas de réussir.`
};

MIROIR["7:165"] = {
  reference: "7:165",
  theme: ["oubli", "rappel", "sauvetage"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhakir", "Al-Munji"],
  mirrorVersion: `« Puis quand ils oublièrent ce qu'on leur avait rappelé, Nous sauvâmes ceux qui interdisaient le mal. » Le miroir me montre le salut des justes. « Fa lamma nasu ma dhukkiru bihi anjayna alladhina yan-hawna 'ani as-su' » — Nous sauvâmes ceux qui interdisaient le mal. L'oubli du rappel mène à la perte, mais ceux qui rappellent sont sauvés. Le miroir m'invite à être parmi ceux qui rappellent le bien.`,
  reflection: `Le salut est pour ceux qui se souviennent et qui rappellent. L'oubli est le chemin de la perdition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa lamma nasu ma dhukkiru bihi anjayna alladhina yan-hawna 'ani as-su' » — quand ils oublièrent ce qu'on leur avait rappelé, Nous sauvâmes ceux qui interdisaient le mal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'oublie le rappel ? Ou est-ce que je suis parmi ceux qui rappellent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le salut n'est pas collectif — il est individuel pour ceux qui choisissent le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La distinction entre les justes et les injustes se fait par la réponse au rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Rappeler le bien aux autres, c'est d'abord se le rappeler à soi-même." }
  ],
  munajat: `Ya Munji, sauve-moi avec ceux qui rappellent le bien. Ne me laisse pas oublier Ton rappel. Fais que je sois parmi les sauvés.`
};

MIROIR["7:166"] = {
  reference: "7:166",
  theme: ["transgression", "châtiment", "transformation"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Mutakabbir"],
  mirrorVersion: `« Puis quand ils transgressèrent les interdits, Nous leur dîmes : 'Soyez des singes méprisés.' » Le miroir me montre la transformation des transgresseurs. « Fa lamma 'taw 'an ma nuhu 'anhu qulna lahum kunu qiradatan khasi'in » — soyez des singes méprisés. La transgression prolongée transforme l'être. On devient ce qu'on choisit d'être. Le miroir m'invite à choisir ce que je veux devenir.`,
  reflection: `La transgression prolongée transforme l'être humain en quelque chose de moins qu'humain. Nos choix nous façonnent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa lamma 'taw 'an ma nuhu 'anhu qulna lahum kunu qiradatan khasi'in » — quand ils transgressèrent les interdits, Nous leur dîmes : soyez des singes méprisés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mes choix font de moi ? Est-ce que je deviens plus humain ou moins humain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transformation est réelle — nos choix façonnent notre être." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque choix laisse une trace dans l'âme. Les choix répétés deviennent une nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La forme extérieure reflète l'état intérieur." }
  ],
  munajat: `Ya Allah, protège-moi de la transformation par le mal. Fais que mes choix me rendent plus humain, plus proche de Toi.`
};

MIROIR["7:167"] = {
  reference: "7:167",
  theme: ["châtiment", "histoire", "mise en garde"],
  emotion: "Crainte, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muhaymin"],
  mirrorVersion: `« Et quand ton Seigneur annonça qu'Il enverrait certes contre eux, jusqu'au Jour de la Résurrection, quelqu'un qui leur infligerait le pire châtiment. » Le miroir me montre la continuité du châtiment. « Idh atawwa'a rabbuka » — quand ton Seigneur annonça. L'annonce est pour l'histoire, le châtiment est continu. Les transgresseurs ne connaîtront pas la paix. Le miroir m'invite à éviter ce chemin.`,
  reflection: `La transgression a des conséquences qui traversent l'histoire. Le châtiment peut être différé mais il est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh atawwa'a rabbuka layab'athanna 'alayhim ila yawmi al-qiyamah man yasumuhum su'a al-'adhab » — ton Seigneur annonça qu'Il enverrait contre eux quelqu'un qui leur infligerait le pire châtiment jusqu'au Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux les conséquences de mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment différé n'est pas le châtiment évité. La justice arrive toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine de civilisations qui ont transgressé et qui ont péri." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du châtiment est une protection contre la transgression." }
  ],
  munajat: `Ya Qahhar, je crains Ton châtiment. Protège-moi de la transgression. Fais que je sois parmi ceux que Tu protèges.`
};

MIROIR["7:168"] = {
  reference: "7:168",
  theme: ["dispersion", "épreuve", "retour"],
  emotion: "Réflexion, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Mudabbir", "At-Tawwab"],
  mirrorVersion: `« Et Nous les avons dispersés sur terre en communautés. Il y a parmi eux des gens de bien, et il y en a d'autres qui ne le sont pas. » Le miroir me montre la dispersion comme épreuve. « Wa qatta'nahum fi al-ardi umaman » — Nous les avons dispersés sur terre en communautés. La dispersion n'est pas la fin — elle est une épreuve. Parmi les dispersés, il y a des justes et des injustes. Le miroir m'invite à choisir mon camp.`,
  reflection: `La dispersion et l'épreuve révèlent les natures. Chacun montre qui il est vraiment dans les circonstances difficiles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qatta'nahum fi al-ardi umaman minhum as-salihuna wa minhum duna dhalik » — Nous les avons dispersés sur terre en communautés. Il y a parmi eux des gens de bien, et il y en a d'autres qui ne le sont pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans les épreuves de la vie, que révèle ma conduite ? Suis-je parmi les justes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispersion peut être une opportunité — chaque lieu devient un lieu de témoignage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les croyants sont partout. La vérité traverse les frontières." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le juste reste juste partout. L'injuste ne peut pas se cacher." }
  ],
  munajat: `Ya Mudabbir, dans ma dispersion, garde-moi juste. Fais que je sois parmi les gens de bien où que je sois.`
};

MIROIR["7:169"] = {
  reference: "7:169",
  theme: ["héritage", "responsabilité", "choix"],
  emotion: "Responsabilité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Warith", "Al-Hakam"],
  mirrorVersion: `« Puis leurs successeurs leur succédèrent, héritant du Livre. Ils prennent les biens de ce bas monde en disant : 'On nous pardonnera.' » Le miroir me montre le danger de l'héritage spirituel sans engagement. « Fa khalafa min ba'dihim khalaf » — leurs successeurs leur succédèrent. L'héritage du Livre ne suffit pas. Ceux qui prennent les biens de ce monde en espérant le pardon se trompent. Le miroir m'invite à un engagement réel, pas seulement formel.`,
  reflection: `L'héritage spirituel sans engagement personnel est vide. On n'hérite pas le paradis, on le conquiert par la foi et les œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa khalafa min ba'dihim khalaf warithu al-kitaba ya'khudhuna 'arada hadha al-adna » — leurs successeurs héritèrent du Livre, prenant les biens de ce bas monde et disant : on nous pardonnera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur l'héritage spirituel ? Ou est-ce que je m'engage personnellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage du Livre est une responsabilité, pas un privilège automatique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération doit faire ses propres choix. L'héritage n'oblige personne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'engagement personnel est le seul chemin vers le pardon." }
  ],
  munajat: `Ya Warith, je ne veux pas hériter sans m'engager. Donne-moi la foi et les œuvres qui mènent à Toi. Ne me laisse pas compter sur un héritage vide.`
};

MIROIR["7:170"] = {
  reference: "7:170",
  theme: ["attachement", "prière", "espérance"],
  emotion: "Espoir, engagement",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Wadud"],
  mirrorVersion: `« Et ceux qui s'attachent au Livre et accomplissent la prière, Nous ne laisserons pas perdre la récompense de ceux qui s'amendent. » Le miroir me montre la promesse divine. « Wa alladhina yumassikuna bi al-kitab » — ceux qui s'attachent au Livre. L'attachement au Livre plus la prière. Ces deux ensemble mènent à la récompense. Le miroir m'invite à cet attachement et à cette pratique.`,
  reflection: `L'attachement au Livre et la prière sont les deux piliers de la vie spirituelle. Ensemble, ils mènent à la récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina yumassikuna bi al-kitab wa aqamu as-salata inna la nudi'u ajra al-muslimina » — ceux qui s'attachent au Livre et accomplissent la prière, Nous ne laisserons pas perdre leur récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'attache au Livre ? Est-ce que j'accomplis la prière ? Les deux ensemble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Livre guide, la prière connecte. L'un sans l'autre est incomplet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est certaine. La récompense n'est jamais perdue pour les justes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attachement au Livre transformé en prière devient vie." }
  ],
  munajat: `Ya Wadud, je m'attache à Ton Livre. J'accomplis ma prière. Ne laisse pas perdre ma récompense. Accepte mon amendement.`
};

MIROIR["7:171"] = {
  reference: "7:171",
  theme: ["montagne", "alliance", "sérieux"],
  emotion: "Révérence, engagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jalil", "Al-Maw'ud"],
  mirrorVersion: `« Et quand Nous avons brandi la montagne au-dessus d'eux comme si c'était une ombrelle. Ils pensaient qu'elle allait tomber sur eux. » Le miroir me montre le sérieux de l'alliance. « Wa idh nataqna al-jabala fawqahum » — quand Nous avons brandi la montagne au-dessus d'eux. L'alliance a été prise avec sérieux, sous la montagne suspendue. Le miroir m'invite à prendre l'engagement avec le même sérieux.`,
  reflection: `L'alliance avec Allah est un engagement grave. La montagne suspendue montre le sérieux de la promesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh nataqna al-jabala fawqahum ka'annahu zullahum » — quand Nous avons brandi la montagne au-dessus d'eux comme si c'était une ombrelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends mon engagement avec Allah aussi au sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La montagne suspendue était une leçon — l'alliance est lourde de sens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes visibles renforcent les engagements invisibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sérieux de l'alliance se mesure à la gravité de l'engagement." }
  ],
  munajat: `Ya Jalil, prends mon engagement au sérieux comme Tu as pris l'alliance des Enfants d'Israël. Fais que je sois fidèle à ma promesse.`
};

MIROIR["7:172"] = {
  reference: "7:172",
  theme: ["alliance", "fitra", "tawhid"],
  emotion: "Révérence, reconnaissance",
  difficulty: "avancé",
  relatedNames: ["Al-Fitrah", "Ar-Rabb"],
  mirrorVersion: `« Et quand ton Seigneur tira une descendance des reins des fils d'Adam et les fit témoigner contre eux-mêmes : 'Ne suis-Je pas votre Seigneur ?' Ils répondirent : 'Si, nous en témoignons.' » Le miroir me montre l'alliance primordiale. « Alastu bi-rabbikum » — ne suis-Je pas votre Seigneur ? Cette question résonne dans chaque âme. Nous avons tous répondu « oui » avant même de naître. Le miroir m'invite à me souvenir de cette alliance éternelle.`,
  reflection: `La fitra est cette alliance primordiale. Chaque être humain porte en lui le témoignage du Seigneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh akhadha rabbuka min bani adama min zuhurihim dhuriyyatahum wa ash-hadahum 'ala anfusihim alastu bi-rabbikum qalu bala » — ne suis-Je pas votre Seigneur ? Ils répondirent : si, nous en témoignons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de cette alliance ? Est-ce que mon cœur reconnaît son Seigneur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli de l'alliance est la source de l'égarement. Le souvenir est la source de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'humanité porte ce témoignage. C'est le dénominateur commun de l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le « bala » (oui) résonne encore dans les profondeurs de chaque âme." }
  ],
  munajat: `Ya Rabb, Tu es mon Seigneur. Je me souviens de l'alliance. Fais que ce souvenir guide toute ma vie. Ne me laisse pas l'oublier.`
};

MIROIR["7:173"] = {
  reference: "7:173",
  theme: ["excuse", "responsabilité", "témoignage"],
  emotion: "Lucidité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hasib"],
  mirrorVersion: `« Ou que vous ne disiez : 'Ce sont nos ancêtres qui ont associé auparavant et nous étions leurs descendants après eux.' » Le miroir me montre l'excuse rejetée. « An taqalu inna ash-raka abauna min qablu » — ou que vous ne disiez : ce sont nos ancêtres qui ont associé. L'excuse de l'héritage ne sera pas acceptée. Chacun est responsable de ses choix. Le miroir m'invite à la responsabilité individuelle.`,
  reflection: `L'excuse de l'héritage ne sera pas acceptée. Chacun est responsable de sa foi et de ses actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An taqulu inna ash-raka abauna min qablu wa kunna dhurriyyatan min ba'dihim » — ou que vous ne disiez : ce sont nos ancêtres qui ont associé et nous étions leurs descendants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles excuses je donne pour mes erreurs ? Est-ce que j'assume ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage n'est pas une excuse. Chacun peut choisir de suivre ou de se détourner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La responsabilité individuelle est le fondement de la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'excuse est le refuge de ceux qui refusent de changer." }
  ],
  munajat: `Ya Haqq, je n'ai pas d'excuse. Je suis responsable de mes choix. Aide-moi à assumer cette responsabilité et à choisir le bien.`
};

MIROIR["7:174"] = {
  reference: "7:174",
  theme: ["explication", "signes", "retour"],
  emotion: "Attention, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "Al-Hadi"],
  mirrorVersion: `« Ainsi expliquons-Nous les signes. Peut-être reviendront-ils. » Le miroir me montre le but des signes. « Wa kadhalika nufassilu al-ayat » — ainsi expliquons-Nous les signes. Les signes sont expliqués pour que nous revinions. Le but n'est pas la condamnation mais le retour. Le miroir m'invite à lire les signes et à revenir vers Allah.`,
  reflection: `Les signes sont expliqués pour notre retour. Allah veut que nous revenions, pas que nous périssions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika nufassilu al-ayat wa la'allahum yarji'un » — ainsi expliquons-Nous les signes. Peut-être reviendront-ils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis les signes ? Est-ce que je reviens vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes ne sont pas des obstacles mais des guides vers le retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est un signe qui pointe vers le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit les signes entend l'appel au retour." }
  ],
  munajat: `Ya Hadi, explique-moi Tes signes. Fais que je les lise et que je revienne vers Toi. Je veux revenir.`
};

MIROIR["7:175"] = {
  reference: "7:175",
  theme: ["histoire", "signes", "détournement"],
  emotion: "Mise en garde, tristesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Maw'iz"],
  mirrorVersion: `« Et raconte-leur l'histoire de celui à qui Nous avons donné Nos signes et qui s'en est détourné. » Le miroir me montre le danger du détournement. « Wa tlu 'alayhim naba'a alladhi ataynahu ayatina » — raconte-leur l'histoire de celui à qui Nous avons donné Nos signes. Avoir les signes ne suffit pas. Il faut les suivre. Le détournement mène à la perte. Le miroir m'invite à ne pas détourner les signes reçus.`,
  reflection: `Recevoir les signes n'est pas suffisant. Les suivre est essentiel. Le détournement est le chemin de la perdition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tlu 'alayhim naba'a alladhi ataynahu ayatina fansalakha minha » — raconte-leur l'histoire de celui à qui Nous avons donné Nos signes et qui s'en est détourné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes ai-je reçus ? Est-ce que je les suis ou est-ce que je m'en détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe reçu et rejeté devient un témoin contre nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont offerts à tous. Seuls quelques-uns les suivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le détournement des signes est le début de la fin spirituelle." }
  ],
  munajat: `Ya Hakim, je ne veux pas me détourner de Tes signes. Aide-moi à les suivre avec sincérité. Ne me laisse pas devenir comme celui qui s'est détourné.`
};

MIROIR["7:176"] = {
  reference: "7:176",
  theme: ["chien", "exemple", "bas instincts"],
  emotion: "Mise en garde, aversion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muthil", "Al-Basir"],
  mirrorVersion: `« Et si Nous avions voulu, Nous l'aurions élevé par ces signes. Mais il s'inclina vers la terre et suivit sa passion. Son exemple est celui du chien. » Le miroir me montre le choix du bas. « Fa lamma atahu al-'ilmu insalakha minha » — quand la science lui vint, il s'en détacha. L'exemple du chien : si on l'attaque, il halète ; si on le laisse, il halète. Il ne change pas. Le miroir m'invite à ne pas suivre les passions.`,
  reflection: `Suivre les passions rabaisse l'être humain. L'élévation par les signes est un choix que nous devons faire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa masaluhu kal-kalb in tahmil 'alayhi yalhas aw tatrukahu yalhas » — son exemple est celui du chien : si on l'attaque, il halète ; si on le laisse, il halète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis mes passions ? Ou est-ce que je m'élève par les signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'être humain peut s'élever ou s'abaisser. Le choix est entre ses mains." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les passions sont un animal en nous. Soit nous le maîtrisons, soit il nous maîtrise." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le chien ne change pas parce que son maître est le bas instinct, pas Allah." }
  ],
  munajat: `Ya Muthil, je ne veux pas être comme le chien. Aide-moi à maîtriser mes passions et à m'élever par Tes signes. Change mon cœur.`
};

MIROIR["7:177"] = {
  reference: "7:177",
  theme: ["mauvais exemple", "signes", "perte"],
  emotion: "Mise en garde, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Khusran", "Al-Hasir"],
  mirrorVersion: `« Quel mauvais exemple que celui du peuple qui traite de mensonges Nos signes. » Le miroir me montre le mauvais exemple. « Sa'a mathalan al-qawmu alladhina kadhdhabu bi-ayatina » — quel mauvais exemple que celui du peuple qui traite de mensonges Nos signes. Le négateur des signes devient un mauvais exemple. Il ne perd pas que lui-même — il perd aussi ceux qui le suivent. Le miroir m'invite à être un bon exemple.`,
  reflection: `Nos vies sont des exemples, bons ou mauvais. Choisir de nier les signes fait de nous un mauvais exemple.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa'a mathalan al-qawmu alladhina kadhdhabu bi-ayatina » — quel mauvais exemple que celui du peuple qui traite de mensonges Nos signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel exemple ma vie donne-t-elle ? Bon ou mauvais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mauvais exemple entraîne les autres vers la perte avec lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vie est un livre que les autres lisent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bon exemple est une aumône continue." }
  ],
  munajat: `Ya Allah, fais de ma vie un bon exemple. Ne me laisse pas être parmi ceux qui égarent les autres. Fais que je guide par mon exemple.`
};

MIROIR["7:178"] = {
  reference: "7:178",
  theme: ["guidance", "égarement", "science"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Celui qu'Allah guide est le bien guidé, et ceux qu'Il égare sont les perdants. » Le miroir me montre la source de la guidance. « Man yahdi Allahu fa huwa al-muhtadi » — celui qu'Allah guide est le bien guidé. La guidance vient d'Allah. L'égarement aussi. Nous demandons la guidance car nous ne pouvons pas nous guider nous-mêmes. Le miroir m'invite à demander la guidance avec humilité.`,
  reflection: `La guidance est un don d'Allah. Nous ne pouvons pas l'obtenir par nos propres efforts seuls. Il faut la demander.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yahdi Allahu fa huwa al-muhtadi wa man yudlil fa ula'ika humu al-khasirun » — celui qu'Allah guide est le bien guidé, et ceux qu'Il égare sont les perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la guidance ? Est-ce que je reconnais que je ne peux pas me guider moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil empêche de demander la guidance. L'humilité l'attire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature dépend de son Créateur pour sa direction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La demande sincère de guidance est elle-même une guidance." }
  ],
  munajat: `Ya Hadi, guide-moi. Je ne peux pas me guider moi-même. Donne-moi Ta guidance et ne me laisse pas m'égarer.`
};

MIROIR["7:179"] = {
  reference: "7:179",
  theme: ["bétail", "cœurs", "inattention"],
  emotion: "Mise en garde, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Ghafur"],
  mirrorVersion: `« Nous avons destiné à l'Enfer beaucoup de djinns et d'hommes. Ils ont des cœurs avec lesquels ils ne comprennent pas, des yeux avec lesquels ils ne voient pas. » Le miroir me montre la condition des insouciants. « Lahum qulubun la yafqahuna biha » — ils ont des cœurs avec lesquels ils ne comprennent pas. Les organes sont là mais ils ne fonctionnent pas spirituellement. Ils sont pire que le bétail qui au moins suit son instinct. Le miroir m'invite à utiliser mes facultés spirituelles.`,
  reflection: `Avoir un cœur, des yeux, des oreilles ne suffit pas. Il faut les utiliser pour comprendre, voir et entendre la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum qulubun la yafqahuna biha wa lahum a'yunun la yubsiruna biha » — ils ont des cœurs avec lesquels ils ne comprennent pas, des yeux avec lesquels ils ne voient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends avec mon cœur ? Est-ce que je vois avec mes yeux spirituels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les organes spirituels qui ne fonctionnent pas sont pire que de ne pas les avoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bétail suit son instinct. L'être humain qui ignore la vérité est pire que le bétail." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'inattention est une mort spirituelle avant la mort physique." }
  ],
  munajat: `Ya Alim, fais que mon cœur comprenne, que mes yeux voient, que mes oreilles entendent. Ne me laisse pas être parmi ceux qui sont pire que le bétail.`
};

MIROIR["7:180"] = {
  reference: "7:180",
  theme: ["noms", "invocation", "beauté"],
  emotion: "Révérence, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Asma' al-Husna", "Al-Jamil"],
  mirrorVersion: `« À Allah appartiennent les plus beaux noms. Invoquez-Le par ces noms et éloignez-vous de ceux qui profanent Ses noms. » Le miroir me montre les noms divins. « Wa lillahi al-asma'u al-husna » — à Allah appartiennent les plus beaux noms. Chaque nom est une porte vers Lui. L'invocation par les noms rapproche. Le miroir m'invite à connaître et invoquer les beaux noms d'Allah.`,
  reflection: `Les noms d'Allah sont des trésors. Chacun révèle un aspect de Sa perfection. Les invoquer, c'est se connecter à cette perfection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lillahi al-asma'u al-husna fa ud'uhu biha » — à Allah appartiennent les plus beaux noms. Invoquez-Le par ces noms." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de noms d'Allah je connais ? Combien je les invoque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les noms ne délimitent pas Allah — ils nous rapprochent de Lui à notre mesure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque nom divin se reflète dans la création. Ar-Rahman dans la miséricorde universelle, Al-Khaliq dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les noms d'Allah et les invoque reçoit Sa proximité." }
  ],
  munajat: `Ya Dhu al-asma' al-husna, Tes noms sont beaux. Apprends-moi à les connaître et à T'invoquer par eux. Rapproche-moi de Toi par Tes beaux noms.`
};

MIROIR["7:181"] = {
  reference: "7:181",
  theme: ["création", "justice", "équilibre"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Adl"],
  mirrorVersion: `« Parmi ceux que Nous avons créés, il est une communauté qui guide par la vérité et par elle exerce la justice. » Le miroir me montre l'existence des justes. « Wa mimman khalaqna ummatun ya'duna bi al-haqq » — parmi ceux que Nous avons créés, une communauté qui guide par la vérité. Les justes existent dans chaque communauté. Ils sont le signe de la miséricorde divine. Le miroir m'invite à faire partie de cette communauté.`,
  reflection: `La communauté des justes traverse l'histoire. Elle est le témoin de la vérité et de la justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mimman khalaqna ummatun ya'duna bi al-haqq wa bihi ya'dilun » — parmi ceux que Nous avons créés, une communauté qui guide par la vérité et par elle exerce la justice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi cette communauté ? Est-ce que je guide par la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance par la vérité est un don, mais aussi une responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les justes sont les gardiens de l'équilibre du monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être parmi les justes est un choix que nous devons faire chaque jour." }
  ],
  munajat: `Ya Khaliq, fais que je sois parmi ceux qui guident par la vérité. Donne-moi la justice dans mes décisions. Inscris-moi dans la communauté des justes.`
};

MIROIR["7:182"] = {
  reference: "7:182",
  theme: ["délai", "stratégie", "mise en garde"],
  emotion: "Crainte, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mudabbir", "Al-Hakim"],
  mirrorVersion: `« Et ceux qui traitent de mensonges Nos signes, Nous les conduirons par des degrés d'où ils ne savent pas. » Le miroir me montre la stratégie divine. « Wa alladhina kadhdhabu bi-ayatina sanastadrijuhum min haythu la ya'lamun » — Nous les conduirons par des degrés d'où ils ne savent pas. Le châtiment n'est pas toujours immédiat. Il vient par étapes, imperceptiblement. Le miroir m'invite à la vigilance constante.`,
  reflection: `Le délai n'est pas l'oubli. La stratégie divine amène le châtiment graduellement, sans que le transgresseur s'en aperçoive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kadhdhabu bi-ayatina sanastadrijuhum min haythu la ya'lamun » — ceux qui traitent de mensonges Nos signes, Nous les conduirons par des degrés d'où ils ne savent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens en sécurité parce que le châtiment ne vient pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est plus dangereux que le châtiment immédiat — il endort la vigilance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les dégrés de la perdition sont invisibles jusqu'à ce qu'il soit trop tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vigilance constante est la protection contre la chute graduelle." }
  ],
  munajat: `Ya Mudabbir, ne me laisse pas m'endormir dans le délai. Donne-moi la vigilance de revenir vers Toi avant qu'il soit trop tard.`
};

MIROIR["7:183"] = {
  reference: "7:183",
  theme: ["délai", "patience", "piège"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Hakim"],
  mirrorVersion: `« Et Je leur accorde un délai. Mon stratagème est solide. » Le miroir me montre le piège du délai. « Wa umli lahum » — Je leur accorde un délai. Le délai peut être une miséricorde pour se repentir, mais pour celui qui persiste, c'est un piège. Le miroir m'invite à ne pas confondre le délai avec l'impunité.`,
  reflection: `Le délai divin est une opportunité de repentir, pas une permission de continuer dans le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa umli lahum inna kaydi matîn » — Je leur accorde un délai. Mon stratagème est solide." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise le délai qu'Allah me donne ? Pour me repentir ou pour persister ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai utilisé pour se repentir devient une bénédiction. Utilisé pour persister, il devient un piège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est une ressource limitée. Chaque instant passé dans le mal est une perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand piège est de croire qu'on a tout le temps." }
  ],
  munajat: `Ya Sabur, je ne veux pas abuser de Ton délai. Aide-moi à me repentir maintenant, pas plus tard. Ne me laisse pas tomber dans le piège de la procrastination.`
};

MIROIR["7:184"] = {
  reference: "7:184",
  theme: ["rappel", "prophète", "folie"],
  emotion: "Réflexion, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Hakim"],
  mirrorVersion: `« Ne réfléchissent-ils pas ? Il n'y a pas de folie en leur compagnon. Il n'est qu'un avertisseur explicite. » Le miroir me montre le statut du Prophète. « Awa lam yatafakkaru » — ne réfléchissent-ils pas ? La réflexion mène à reconnaître la vérité du Prophète. Il n'est pas fou — il est un avertisseur. Le miroir m'invite à réfléchir sur le message du Prophète.`,
  reflection: `La réflexion sur le Prophète révèle sa vérité. Il n'était ni fou ni poète — il était le Messager d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa lam yatafakkaru ma bi-sahibihim min jinnah » — ne réfléchissent-ils pas ? Il n'y a pas de folie en leur compagnon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réfléchis sur le Prophète ? Est-ce que je reconnais sa vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de folie était le refuge de ceux qui refusaient d'écouter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité dérange ceux qui vivent dans le mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La réflexion sincère mène toujours à la reconnaissance de la vérité." }
  ],
  munajat: `Ya Allah, fais que je réfléchisse sur Ton Prophète. Aide-moi à reconnaître sa vérité et à le suivre. Ne me laisse pas rejeter Ton message.`
};

MIROIR["7:185"] = {
  reference: "7:185",
  theme: ["création", "signes", "fin"],
  emotion: "Émerveillement, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Akhir"],
  mirrorVersion: `« N'ont-ils pas médité sur la royauté des cieux et de la terre, et sur toute chose qu'Allah a créée ? » Le miroir me montre les signes dans la création. « Awa lam yanzuru fi malakuti as-samawati wa al-ard » — n'ont-ils pas regardé la royauté des cieux et de la terre ? La création entière est un signe. La fin approche. Le miroir m'invite à méditer sur les signes avant qu'il ne soit trop tard.`,
  reflection: `La création est un livre ouvert. Chaque phénomène est un signe. La fin de ce monde approche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa lam yanzuru fi malakuti as-samawati wa al-ard wa kulli shay'in khalaqahu » — n'ont-ils pas médité sur la royauté des cieux et de la terre, et sur toute chose qu'Allah a créée ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur la création ? Est-ce que je vois les signes d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont partout pour celui qui regarde. L'aveugle ne voit que l'aveuglement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame la gloire du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La méditation sur la création est une prière silencieuse." }
  ],
  munajat: `Ya Khaliq, ouvre mes yeux aux signes de Ta création. Fais que je médite sur les cieux et la terre. Rappelle-moi que la fin approche.`
};

MIROIR["7:186"] = {
  reference: "7:186",
  theme: ["égarement", "guide", "amis"],
  emotion: "Humilité, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Quiconque Allah égare, il n'a point de guide. Et Il les laisse dans leur transgression, tâtonnant aveuglément. » Le miroir me montre les conséquences de l'égarement. « Man yudlili Allahu fa la hadiya lahu » — quiconque Allah égare, il n'a point de guide. L'égarement est la perte de tout repère. Le transgresseur tâtonne comme un aveugle. Le miroir m'invite à chercher la guidance avant de l'avoir perdue.`,
  reflection: `L'égarement est l'état le plus terrible. Perdre la guidance, c'est perdre tout. Il faut la chercher tant qu'elle est disponible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yudlili Allahu fa la hadiya lahu wa yadharuhum fi tughyanihim ya'mahun » — quiconque Allah égare, il n'a point de guide. Et Il les laisse dans leur transgression, tâtonnant aveuglément." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la guidance ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance perdue est difficile à retrouver. Il faut la garder jalousement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'égarement est une prison dont on ne sort pas sans l'aide d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus grande perte est de perdre la guidance alors qu'on avait les signes." }
  ],
  munajat: `Ya Hadi, ne me laisse pas m'égarer. Je cherche Ta guidance. Garde-moi sur le droit chemin. Ne me laisse pas tâtonner dans les ténèbres.`
};

MIROIR["7:187"] = {
  reference: "7:187",
  theme: ["heure", "inconnu", "préparation"],
  emotion: "Humilité, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "As-Sa'ah"],
  mirrorVersion: `« Ils t'interrogent sur l'Heure : 'Quand arrivera-t-elle ?' Dis : 'Seul mon Seigneur la connaît.' » Le miroir me montre le mystère de l'Heure. « Yas'alunaka 'ani as-sa'ati ayyana mursaha » — ils t'interrogent sur l'Heure. L'Heure est connue d'Allah seul. Ni le Prophète ni les anges ne la connaissent. Le miroir m'invite à me préparer plutôt qu'à spéculer.`,
  reflection: `L'Heure est inconnue. Au lieu de spéculer sur sa date, nous devrions nous préparer comme si elle était imminente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'alunaka 'ani as-sa'ati ayyana mursaha fiha qul innama 'ilmuha 'inda rabbi » — ils t'interrogent sur l'Heure : quand arrivera-t-elle ? Dis : seul mon Seigneur la connaît." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour l'Heure ? Ou est-ce que je repousse la préparation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inconnu de l'Heure doit nous pousser à la préparation constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute âme goûtera la mort. L'Heure pour chacun est sa propre mort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre chaque jour comme le dernier, c'est la meilleure préparation." }
  ],
  munajat: `Ya Alim, je ne connais pas l'Heure. Aide-moi à me préparer comme si elle était aujourd'hui. Ne me laisse pas vivre dans l'illusion du temps illimité.`
};

MIROIR["7:188"] = {
  reference: "7:188",
  theme: ["impuissance", "prophète", "bénéfice"],
  emotion: "Humilité, réalisme",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "An-Nafi'"],
  mirrorVersion: `« Dis : 'Je ne possède pour moi-même ni bénéfice ni nuisance, sauf ce qu'Allah veut.' » Le miroir me montre l'impuissance du Prophète. « La amliku li-nafsi naf'an wa la darran » — je ne possède pour moi-même ni bénéfice ni nuisance. Même le Prophète ne peut se bénéficier ou se nuire sans la permission d'Allah. Le miroir m'invite à la même humilité.`,
  reflection: `Nous ne contrôlons pas notre destin. Le bien et le mal nous viennent d'Allah selon Sa sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La amliku li-nafsi naf'an wa la darran illa ma sha'a Allah » — je ne possède pour moi-même ni bénéfice ni nuisance, sauf ce qu'Allah veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mon impuissance ? Ou est-ce que je pense pouvoir tout contrôler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance reconnue devient une force — celle de la confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature dépend de son Créateur pour chaque instant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de son impuissance est le début de la vraie force." }
  ],
  munajat: `Ya Allah, je suis impuissant sans Toi. Je ne peux ni me bénéficier ni me nuire. Fais que chaque instant soit selon Ta volonté.`
};

MIROIR["7:189"] = {
  reference: "7:189",
  theme: ["création", "couple", "invocation"],
  emotion: "Gratitude, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahhab"],
  mirrorVersion: `« C'est Lui qui vous a créés d'un seul être, et qui a tiré de lui son épouse. » Le miroir me montre l'origine commune. « Huwa alladhi khalaqakum min nafsin wahidah » — c'est Lui qui vous a créés d'un seul être. L'humanité vient d'un seul couple. L'unité d'origine appelle l'unité de destin. Le miroir m'invite à reconnaître notre fraternité fondamentale.`,
  reflection: `Nous sommes tous enfants d'Adam et Ève. Notre origine commune doit nous unir, pas nous diviser.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi khalaqakum min nafsin wahidah wa khalaqa minha zawjaha » — c'est Lui qui vous a créés d'un seul être, et qui a tiré de lui son épouse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ma fraternité avec tous les humains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité d'origine doit mener à l'unité de cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'humanité est une seule famille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de l'origine commune est le fondement de la paix." }
  ],
  munajat: `Ya Khaliq, Tu nous as créés d'un seul être. Fais que je reconnaisse tous les humains comme mes frères et sœurs. Unis nos cœurs dans la fraternité.`
};

MIROIR["7:190"] = {
  reference: "7:190",
  theme: ["enfant", "invocation", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Ar-Razzaq"],
  mirrorVersion: `« Puis, quand Il leur a donné un enfant sain, ils ont associé à ce qu'Il leur a donné. » Le miroir me montre l'ingratitude humaine. « Fa lamma atahuma salihan ja'ala lahu shuraka' » — quand Il leur a donné un enfant sain, ils ont associé. L'enfant est un don d'Allah, mais l'être humain oublie et associe d'autres à Allah. Le miroir m'invite à la gratitude pure.`,
  reflection: `Les enfants sont des dons d'Allah. Les associer à d'autres qu'Allah est une ingratitude qui nie la source du don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa lamma atahuma salihan ja'ala lahu shuraka' » — quand Il leur a donné un enfant sain, ils ont associé à ce qu'Il leur a donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je remercie pour les dons reçus ? Est-ce que j'associe d'autres à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don d'Allah mérite la reconnaissance exclusive à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque enfant est un signe de la puissance créatrice d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pure est celle qui n'associe rien à Allah." }
  ],
  munajat: `Ya Wahhab, merci pour les dons que Tu m'as accordés. Je ne veux rien T'associer. Fais que ma reconnaissance soit pure et sincère.`
};

MIROIR["7:191"] = {
  reference: "7:191",
  theme: ["idoles", "création", "impotence"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Associent-ils ce qui ne peut rien créer et qui est lui-même créé ? » Le miroir me montre la fausseté des idoles. « Ayushrikuna ma la yakhluqu shay'an » — associent-ils ce qui ne peut rien créer ? L'idole ne peut pas créer, elle est créée. Elle ne peut pas nuire ni bénéficier. Le miroir m'invite à la clarté sur ce que j'adore.`,
  reflection: `L'idole est impuissante. Créée, elle ne peut pas créer. Pourquoi l'adorer ? Seul le Créateur mérite l'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayushrikuna ma la yakhluqu shay'an wa hum yukhlaqun » — associent-ils ce qui ne peut rien créer et qui est lui-même créé ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore ? Est-ce que c'est le Créateur ou des créatures impuissantes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Adorer ce qui est créé au lieu du Créateur est le sommet de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est impuissante devant le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration du Créateur est la seule adoration logique." }
  ],
  munajat: `Ya Khaliq, Tu es le seul Créateur. Je ne veux rien T'associer. Fais que mon adoration soit pour Toi seul, pas pour les créatures impuissantes.`
};

MIROIR["7:192"] = {
  reference: "7:192",
  theme: ["secours", "idoles", "impuissance"],
  emotion: "Lucidité, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Qawiyy"],
  mirrorVersion: `« Ils ne peuvent ni les secourir, ni se secourir eux-mêmes. » Le miroir me montre l'impuissance totale des idoles. « La yastati'unahum nasran » — ils ne peuvent pas les secourir. Les idoles et leurs adorateurs sont tous impuissants. Ni aide pour les autres, ni aide pour eux-mêmes. Le miroir m'invite à chercher le seul vrai Secoureur.`,
  reflection: `Les idoles ne peuvent aider personne. Même leurs adorateurs sont impuissants. Seul Allah peut secourir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yastati'unahum nasran wa la anfusahum yansurun » — ils ne peuvent ni les secourir, ni se secourir eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je demande de l'aide ? À des impuissants ou à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chercher l'aide auprès des impuissants est lui-même une impuissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est dépendante. Seul le Créateur est indépendant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est le seul Secoureur véritable." }
  ],
  munajat: `Ya Nasir, Tu es mon seul Secoureur. Je ne cherche pas d'aide ailleurs. Viens à mon secours dans tous mes besoins.`
};

MIROIR["7:193"] = {
  reference: "7:193",
  theme: ["guidance", "idoles", "indifférence"],
  emotion: "Lucidité, ironie",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Sami'"],
  mirrorVersion: `« Et si vous les appelez vers la guidance, ils ne vous suivront pas. Le résultat pour vous est le même. » Le miroir me montre l'indifférence des idoles. « Wa in tad'uhum ila al-huda la yattabi'ukum » — si vous les appelez vers la guidance, ils ne vous suivront pas. Les idoles sont indifférentes. Que vous les appeliez ou non, elles ne répondent pas. Le miroir m'invite à chercher Celui qui répond.`,
  reflection: `Les idoles sont sourdes à nos appels. Elles ne guident ni ne répondent. Pourquoi les appeler ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in tad'uhum ila al-huda la yattabi'ukum sawa'un 'alaykum ada'wtumuhum am antum samitun » — si vous les appelez vers la guidance, ils ne vous suivront pas. Le résultat pour vous est le même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'appelle ce qui ne peut pas répondre ? Ou est-ce que j'appelle Allah qui entend tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel à l'idole est un appel dans le vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah entend et répond à l'appel de Ses serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'appel sincère à Allah est toujours entendu." }
  ],
  munajat: `Ya Sami', Tu entends mon appel. Je ne crie pas dans le vide. Réponds à ma prière et guide-moi vers Toi.`
};

MIROIR["7:194"] = {
  reference: "7:194",
  theme: ["serviteurs", "égalité", "invocation"],
  emotion: "Égalité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'bud", "Al-Haqq"],
  mirrorVersion: `« Ceux que vous invoquez en dehors d'Allah sont des serviteurs comme vous. » Le miroir me montre l'égalité des serviteurs. « Inna alladhina tad'una min duni Allahi 'ibadun amthalukum » — ceux que vous invoquez en dehors d'Allah sont des serviteurs comme vous. Les idoles, les saints, les prophètes — tous sont des serviteurs. Seul Allah est le Maître. Le miroir m'invite à adorer le Maître, pas les serviteurs.`,
  reflection: `Tous ceux qu'on invoque en dehors d'Allah sont Ses serviteurs. Pourquoi adorer les serviteurs quand on peut adorer le Maître ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina tad'una min duni Allahi 'ibadun amthalukum » — ceux que vous invoquez en dehors d'Allah sont des serviteurs comme vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui j'adore ? Le Maître ou les serviteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Adorer le serviteur au lieu du Maître est un contresens spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est serviteur. Seul Allah est le Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus grande dignité est d'être le serviteur du Maître." }
  ],
  munajat: `Ya Allah, Tu es le Maître. Je suis Ton serviteur. Je n'adore que Toi. Fais que mon adoration soit exclusive à Toi.`
};

MIROIR["7:195"] = {
  reference: "7:195",
  theme: ["création", "marche", "impuissance"],
  emotion: "Ironie, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Ont-ils des pieds pour marcher ? Ont-ils des mains pour frapper ? Ont-ils des yeux pour voir ? » Le miroir me montre l'absurdité des idoles. « A-lahum arjulun yamshuna biha » — ont-ils des pieds pour marcher ? Les idoles n'ont pas les organes qu'Allah a donnés aux humains. Elles sont moins que les humains qu'elles sont censées aider. Le miroir m'invite à la clarté sur ce qui mérite l'adoration.`,
  reflection: `Les idoles n'ont ni pieds, ni mains, ni yeux. Elles sont inertes. Comment pourraient-elles aider ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-lahum arjulun yamshuna biha am lahum aydin yabtishuna biha » — ont-ils des pieds pour marcher ? Ont-ils des mains pour frapper ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment peux-je adorer ce qui est moins que moi ? Ce qui ne peut ni marcher ni voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole est l'opposé du Dieu vivant et capable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah a créé les organes. L'idole n'a rien créé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clarté sur l'idole libère de son emprise." }
  ],
  munajat: `Ya Khaliq, Tu as créé mes pieds, mes mains, mes yeux. Je n'adore pas ce qui ne peut rien. J'adore Toi, le Créateur de tout.`
};

MIROIR["7:196"] = {
  reference: "7:196",
  theme: ["protecteur", "victoire", "révélation"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Nasir"],
  mirrorVersion: `« Certes, mon Maître est Allah qui a fait descendre le Livre de vérité. C'est Lui qui protège les vertueux. » Le miroir me montre le protecteur ultime. « Inna waliyyiya Allahu alladhi nazzala al-kitab » — certes, mon Maître est Allah qui a fait descendre le Livre. Le Livre guide, Allah protège. Les vertueux sont sous Sa garde. Le miroir m'invite à faire d'Allah mon protecteur.`,
  reflection: `Allah est le Protecteur de ceux qui Le suivent. Le Livre est le chemin, la protection est le don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna waliyyiya Allahu alladhi nazzala al-kitab wa huwa yatawalla as-salihin » — certes, mon Maître est Allah qui a fait descendre le Livre. C'est Lui qui protège les vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon protecteur ? Les hommes ou Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est la seule vraie protection. Tout autre protecteur est limité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par la protection d'Allah. Sans Lui, tout s'effondrerait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se place sous la protection d'Allah ne craint rien." }
  ],
  munajat: `Ya Waliyy, Tu es mon Protecteur. Protège-moi contre tout mal. Sois mon allié dans cette vie et dans l'au-delà.`
};

MIROIR["7:197"] = {
  reference: "7:197",
  theme: ["protecteurs", "impuissance", "confiance"],
  emotion: "Lucidité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Qawiyy"],
  mirrorVersion: `« Ceux que vous invoquez en dehors de Lui ne peuvent ni vous secourir, ni se secourir eux-mêmes. » Le miroir me montre l'impuissance des faux protecteurs. « Wa alladhina tad'una min dunihi la yastati'una nasrakum » — ceux que vous invoquez en dehors de Lui ne peuvent vous secourir. Les faux protecteurs sont impuissants. Seul Allah est le vrai Protecteur. Le miroir m'invite à mettre ma confiance en Allah seul.`,
  reflection: `Les protecteurs humains sont limités. Seul Allah peut vraiment protéger, secourir et sauver.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina tad'una min dunihi la yastati'una nasrakum wa la anfusahum yansurun » — ceux que vous invoquez en dehors de Lui ne peuvent ni vous secourir, ni se secourir eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je fais confiance pour ma protection ? Aux hommes ou à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le protecteur impuissant n'est pas un protecteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute protection en dehors d'Allah est une illusion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie sécurité est dans la confiance en Allah seul." }
  ],
  munajat: `Ya Waliyy, Tu es mon seul Protecteur. Je ne cherche pas d'autre protection. Viens à mon secours dans tous mes besoins.`
};

MIROIR["7:198"] = {
  reference: "7:198",
  theme: ["guidance", "injonction", "indifférence"],
  emotion: "Lucidité, ironie",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Sami'"],
  mirrorVersion: `« Et si vous les appelez vers la guidance, ils n'entendent pas. Et tu les vois qui te regardent, mais ils ne voient pas. » Le miroir me montre la fausse spiritualité. « Wa in tad'uhum ila al-huda la yasma'u » — si vous les appelez vers la guidance, ils n'entendent pas. Les idoles semblent regarder mais ne voient pas. L'apparence de vie sans la réalité. Le miroir m'invite à chercher le Dieu vivant.`,
  reflection: `Les idoles ont l'apparence de voir et d'entendre mais elles sont inertes. Seul Allah voit, entend et répond.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in tad'uhum ila al-huda la yasma'u wa tarahum yanzurunaka wa hum la yubsirun » — si vous les appelez vers la guidance, ils n'entendent pas. Et tu les vois qui te regardent, mais ils ne voient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore une illusion ou le Dieu vivant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apparence sans la réalité est la pire des tromperies." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Vivant qui voit et entend." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Dieu vivant répond à l'appel du vivant." }
  ],
  munajat: `Ya Hayy, Tu es le Vivant. Tu entends et Tu vois. Je ne me tourne pas vers les morts. Je me tourne vers Toi, le Dieu vivant.`
};

MIROIR["7:199"] = {
  reference: "7:199",
  theme: ["pardon", "bien", "ignorants"],
  emotion: "Bienveillance, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Afuww", "Ar-Ra'uf"],
  mirrorVersion: `« Prends ce qui est convenable, ordonne le bien et éloigne-toi des ignorants. » Le miroir me montre la noblesse du caractère. « Khudhi al-'afwa » — prends ce qui est convenable. Le pardon, le bien, l'éloignement des ignorants. Ces trois qualités résument la noblesse du Prophète. Le miroir m'invite à cultiver ces qualités.`,
  reflection: `Le bon caractère combine le pardon, l'encouragement du bien et la sagesse face à l'ignorance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khudhi al-'afwa wa'mur bi al-'urfi wa a'rid 'ani al-jahilin » — prends ce qui est convenable, ordonne le bien et éloigne-toi des ignorants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pardonne ? Est-ce que j'ordonne le bien ? Est-ce que je m'éloigne des ignorants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement des ignorants n'est pas du mépris — c'est de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bon caractère est la meilleure invitation à la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ces trois qualités transforment les relations humaines." }
  ],
  munajat: `Ya Afuww, apprends-moi le pardon, le bien et la sagesse. Donne-moi la noblesse du caractère du Prophète.`
};

MIROIR["7:200"] = {
  reference: "7:200",
  theme: ["Satan", "protection", "réfuge"],
  emotion: "Vigilance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-Hafiz"],
  mirrorVersion: `« Et si une mauvaise suggestion te vient de Satan, cherche refuge auprès d'Allah. » Le miroir me montre le remède contre Satan. « Wa immâ yanzaghannaka mina ash-shaytani nazghun » — si une mauvaise suggestion te vient de Satan. Le remède est clair : cherche refuge auprès d'Allah. Le Prophète lui-même avait besoin de ce refuge. Le miroir m'invite à ce refuge constant.`,
  reflection: `Les suggestions de Satan atteignent tout le monde. Le remède est de chercher refuge auprès d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa immâ yanzaghannaka mina ash-shaytani nazghun fasta'iz bi Allah » — si une mauvaise suggestion te vient de Satan, cherche refuge auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand les mauvaises pensées viennent, que je fais ? Je lutte seul ou je cherche refuge en Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lutte contre Satan seul est une défaite. Avec Allah, c'est la victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Satan est l'ennemi de l'humanité. Allah est le Protecteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le refuge en Allah est un bouclier invincible." }
  ],
  munajat: `Ya Muhaymin, je cherche refuge en Toi contre Satan. Protège-moi de ses suggestions. Sois mon bouclier contre le mal.`
};

MIROIR["7:201"] = {
  reference: "7:201",
  theme: ["taqwa", "vision", "protection"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Hadi"],
  mirrorVersion: `« Ceux qui pratiquent la piété, quand une suggestion de Satan les touche, ils se rappellent et deviennent clairvoyants. » Le miroir me montre la différence des pieux. « Inna alladhina ttaqaw » — ceux qui pratiquent la piété. Les pieux ne sont pas exempts des suggestions de Satan. Mais ils se rappellent Allah et deviennent clairvoyants. Le miroir m'invite à ce rappel qui éclaire.`,
  reflection: `La piété n'empêche pas les suggestions, mais elle permet de les reconnaître et de s'en protéger par le rappel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina ttaqaw idha massahum ta'ifun mina ash-shaytani tadhakkaru fa idha hum mubsirun » — ceux qui pratiquent la piété, quand une suggestion de Satan les touche, ils se rappellent et deviennent clairvoyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand les suggestions viennent, est-ce que je me rappelle Allah ? Est-ce que je deviens clairvoyant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel transforme l'obscurité de la suggestion en clarté de la vision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière du rappel dissipe les ténèbres de l'égarement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clairvoyance est le don accordé à ceux qui se rappellent." }
  ],
  munajat: `Ya Basir, fais que je sois parmi les pieux qui se rappellent. Donne-moi la clairvoyance face aux suggestions. Illumine mon cœur par Ton rappel.`
};

MIROIR["7:202"] = {
  reference: "7:202",
  theme: ["frères", "égarement", "persistence"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Mudill"],
  mirrorVersion: `« Et leurs frères les poussent à l'égarement et ils ne cessent de persévérer. » Le miroir me montre l'entraînement vers le mal. « Wa ikhwanuhum yamuddunahum » — leurs frères les poussent. Les mauvais compagnons poussent à l'égarement. Et ils persistent dans cette poussée. L'environnement compte. Le miroir m'invite à choisir mes compagnons.`,
  reflection: `Les mauvais compagnons sont un danger. Ils ne s'arrêtent pas dans leur égarement et ils entraînent les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ikhwanuhum yamuddunahum fi al-ghayyi thumma la yaqsurun » — leurs frères les poussent à l'égarement et ils ne cessent de persévérer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes frères ? Ceux qui me poussent vers le bien ou vers le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bon compagnon pousse vers le bien. Le mauvais compagnon pousse vers le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est influencé par son entourage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le choix des compagnons est un choix de destin." }
  ],
  munajat: `Ya Allah, protège-moi des mauvais compagnons. Donne-moi des frères qui me poussent vers le bien. Choisis pour moi mon entourage.`
};

MIROIR["7:203"] = {
  reference: "7:203",
  theme: ["signe", "prophète", "guidance"],
  emotion: "Confiance, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Bayyinah"],
  mirrorVersion: `« Et quand tu ne leur apportes pas de signe, ils disent : 'Pourquoi ne l'as-tu pas choisi ?' » Le miroir me montre l'attitude des négateurs. « Wa idh lam ta'tihim bi-ayah » — quand tu ne leur apportes pas de signe. Ils demandent des signes selon leurs critères. Mais le Prophète ne fait que suivre ce qui lui est révélé. Le miroir m'invite à la patience face aux exigences déraisonnables.`,
  reflection: `Les négateurs demandent des signes selon leurs propres critères. Le croyant suit la guidance reçue, pas les demandes arbitraires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh lam ta'tihim bi-ayah qalu lawla ijtabaytaha » — quand tu ne leur apportes pas de signe, ils disent : pourquoi ne l'as-tu pas choisi ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la guidance reçue ? Ou est-ce que je demande des signes selon mes critères ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance vient d'Allah, pas des demandes humaines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes viennent quand Allah le veut, pas quand nous le voulons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La patience face aux exigences est une partie de la foi." }
  ],
  munajat: `Ya Hadi, je suis Ta guidance. Je ne demande pas de signes selon mes critères. Donne-moi la patience de suivre ce que Tu me donnes.`
};

MIROIR["7:204"] = {
  reference: "7:204",
  theme: ["écoute", "révélation", "présence"],
  emotion: "Attention, réception",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Hadi"],
  mirrorVersion: `« Et quand on récite le Coran, écoutez-le attentivement afin d'obtenir miséricorde. » Le miroir me montre la posture devant le Coran. « Wa idha quri'a al-quran fa istami'u lahu wa ansitu » — quand on récite le Coran, écoutez-le attentivement. L'écoute n'est pas passive — elle est une ouverture pour recevoir la miséricorde. Le miroir m'invite à cette écoute attentive.`,
  reflection: `Le Coran est la parole d'Allah. L'écouter, c'est écouter Allah. Le silence et l'attention sont les conditions de la réception.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha quri'a al-quran fa istami'u lahu wa ansitu la'allakum turhamun » — quand on récite le Coran, écoutez-le attentivement afin d'obtenir miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'écoute le Coran ? En faisant autre chose ? Ou avec présence et attention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le silence n'est pas vide — il est espace pour recevoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers écoute son Créateur. La création entière est en état d'écoute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le Coran avec présence reçoit la miséricorde." }
  ],
  munajat: `Ya Sami', j'écoute Ta parole. Ouvre mes oreilles et mon cœur. Donne-moi la miséricorde promise à ceux qui écoutent avec attention.`
};

MIROIR["7:205"] = {
  reference: "7:205",
  theme: ["rappel", "matin", "soir", "humilité"],
  emotion: "Présence, constance",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhakir", "Al-Muhaymin"],
  mirrorVersion: `« Et invoque ton Seigneur en toi-même, en humilité et crainte, à voix basse, le matin et le soir. » Le miroir me montre la constance du rappel. « Wa dhkur rabbaka fi nafsika tadharru'an wa khifatan » — invoque ton Seigneur en toi-même, en humilité et crainte. Le rappel n'est pas seulement dans la mosquée. Il est dans le cœur, en tout temps. Matin et soir. Le miroir m'invite à cette présence continue.`,
  reflection: `Le rappel d'Allah doit imprégner toute la journée. Matin et soir, dans l'humilité et la crainte, le cœur reste connecté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur rabbaka fi nafsika tadharru'an wa khifatan wa duna al-jahr mina al-qawli bi al-ghuduwwi wa al-asal » — invoque ton Seigneur en toi-même, en humilité et crainte, à voix basse, le matin et le soir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me rappelle Allah matin et soir ? Est-ce que mon cœur est dans l'humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel discret est parfois plus puissant que le rappel public." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le matin et le soir sont les moments privilégiés du rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel constant transforme le cœur." }
  ],
  munajat: `Ya Rabb, je me rappelle de Toi matin et soir. Fais que mon cœur soit dans l'humilité et la crainte. Ne me laisse pas oublier Ton rappel.`
};

MIROIR["7:206"] = {
  reference: "7:206",
  theme: ["anges", "adoration", "gloire"],
  emotion: "Révérence, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ika", "Al-Majid"],
  mirrorVersion: `« Ceux qui sont auprès de ton Seigneur ne dédaignent pas de L'adorer. Ils Le glorifient et se prosternent devant Lui. » Le miroir conclut la sourate par l'exemple des anges. « Inna alladhina 'inda rabbika la yastakbiruna 'an 'ibadatihi » — ceux qui sont auprès de ton Seigneur ne dédaignent pas de L'adorer. Les anges adorent sans cesse. Ils sont le modèle de l'adoration continue. Le miroir m'invite à suivre leur exemple.`,
  reflection: `Les anges adorent Allah sans orgueil, sans fatigue, sans interruption. Ils sont les modèles de l'adoration parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina 'inda rabbika la yastakbiruna 'an 'ibadatihi wa yusabbihunahu wa lahu yasjudun » — ceux qui sont auprès de ton Seigneur ne dédaignent pas de L'adorer. Ils Le glorifient et se prosternent devant Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore comme les anges ? Ou est-ce que je dédaigne parfois l'adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration n'est pas une contrainte pour les anges — c'est leur nature et leur joie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les serviteurs parfaits d'Allah. L'être humain peut apprendre d'eux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore comme les anges reçoit leur compagnie." }
  ],
  munajat: `Ya Rabb, les anges T'adorent sans cesse. Fais que je sois comme eux. Donne-moi l'adoration continue et la prosternation sincère.`
};

// Surah 8 - Al-Anfal
MIROIR["8:17"] = {
  reference: "8:17",
  theme: ["confiance", "présence", "force"],
  emotion: "Humilité, émerveillement",
  difficulty: "avancé",
  relatedNames: ["Al-Qawiyy", "Al-Aziz"],
  mirrorVersion: `« Ce n'est pas vous qui les avez tués, mais c'est Allah qui les a tués. Et ce n'est pas toi qui as lancé, quand tu as lancé, mais c'est Allah qui a lancé. » Ce verset déconstruit la notion d'action autonome. Le Prophète a physiquement lancé — mais Allah dit « c'est Moi qui ai lancé ». Le miroir me place devant une vérité bouleversante : mes actions sont réellement miennes, et en même temps, elles sont l'expression de l'action divine. Je ne suis pas un robot — je suis un canal. Tout ce que je fais de bien passe à travers moi, mais vient de Lui.`,
  reflection: `Ce verset révèle le mystère de l'action humaine et de l'action divine. L'homme agit vraiment — mais c'est Allah qui crée l'acte. Les deux vérités coexistent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Révélé après Badr, où les musulmans étaient en minorité. Le succès apparent était le résultat d'une intervention invisible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je réussis quelque chose, à qui attribue-je le mérite ? À mon effort ? À ma chance ? Le miroir m'invite à voir la Main derrière la main." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne suis pas l'auteur de mes succès — je suis leur canal. Et je ne suis pas l'auteur de mes échecs non plus — ils font partie d'un plan que je ne vois pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action dans l'univers est le résultat d'une interaction entre le choix créaturel et la volonté créatrice. L'homme choisit — Allah crée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur comprend cela, l'orgueil devient impossible. Comment être fier de ce qui ne vient pas de moi ? Et le désespoir aussi devient impossible." }
  ],
  munajat: `Ya Allah, tout ce que je fais de bien vient de Toi. Ne me laisse pas m'approprier ce qui T'appartient. Fais que je sois un canal transparent de Ta volonté.`
};

// Surah 9 - At-Tawbah
MIROIR["9:51"] = {
  reference: "9:51",
  theme: ["confiance", "force", "patience"],
  emotion: "Sérénité, résilience",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Wakil"],
  mirrorVersion: `« Dis : 'Rien ne nous atteindra excepté ce qu'Allah a décrété pour nous. Il est notre Maître. Et c'est en Allah que les croyants doivent placer leur confiance.' » Ce verset est un bouclier contre l'anxiété. Le miroir me montre que je passe ma vie à craindre ce qui pourrait arriver — mais rien n'arrive sans Son décret. Ce n'est pas du fatalisme passif — c'est la reconnaissance que je suis entre des Mains bienveillantes. « Rien ne nous atteindra » — le verbe est futur. C'est une promesse pour demain, et après-demain, et toujours.`,
  reflection: `Le décret divin (qadar) n'est pas une prison — c'est une sécurité. Rien ne peut m'atteindre sans Sa permission, et ce qui m'atteint a un sens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une réponse aux hypocrites qui menaçaient les musulmans. Le verset replace la menace dans la perspective du décret divin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains en ce moment ? Perte d'emploi ? Maladie ? Abandon ? Le miroir me demande : est-ce que je crois que c'est déjà écrit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si rien ne m'atteint sans Son décret, alors tout ce qui m'atteint est soit une bénédiction, soit un test, soit une purification — mais jamais une punition arbitraire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque événement dans l'univers suit un ordre. L'étoile ne sort pas de son orbite, la saison ne change pas au hasard. Ma vie aussi a son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance totale libère une énergie considérable. Au lieu de lutter contre ce qui arrive, je peux accueillir ce qui vient et y trouver le sens." }
  ],
  munajat: `Ya Allah, j'ai peur de ce qui pourrait arriver. Mais Tu dis que rien ne m'atteint sans Ton décret. Apprends-moi à faire confiance à Ton écriture, même quand je ne la comprends pas.`
};

// Surah 10 - Yunus
MIROIR["10:62"] = {
  reference: "10:62",
  theme: ["présence", "amour", "confiance"],
  emotion: "Sécurité, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Wadud"],
  mirrorVersion: `« En vérité, les bien-aimés d'Allah n'auront rien à craindre, et ils ne seront pas affligés. » Ce verset contient un mot extraordinaire : « auliya' » — les bien-aimés, les amis, les proches d'Allah. Le miroir me montre que cette proximité n'est pas réservée aux prophètes. Elle est accessible à tout cœur sincère. Et la promesse est double : « rien à craindre » pour le futur, « pas affligés » pour le passé. La proximité divine nettoie les deux directions du temps.`,
  reflection: `La walâya (amitié divine) est le sommet de la vie spirituelle. Elle n'est pas obtenue par des miracles — mais par la sincérité, l'adoration et le détachement du monde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le terme « wali » signifie proche, ami, protecteur. C'est une relation d'intimité et de confiance mutuelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un « wali » d'Allah ? Le miroir me montre les signes : ma crainte diminue-t-elle ? Ma tristesse se transforme-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui est mon Wali — mon Protecteur. La relation est réciproque. Je suis Sien, et Il est mien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est « wali » d'Allah par soumission naturelle. L'être humain peut choisir de devenir « wali » par amour conscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand on est vraiment proche d'Allah, la peur disparaît parce qu'on sait que tout est bien, et la tristesse disparaît parce qu'on sait que tout a un sens." }
  ],
  munajat: `Ya Waliyy, je veux être de Tes bien-aimés. Rapproche-moi de Toi. Fais que ma peur et ma tristesse fondent devant Ta présence.`
};

// Surah 11 - Hud
MIROIR["11:88"] = {
  reference: "11:88",
  theme: ["confiance", "prière", "sagesse"],
  emotion: "Humilité, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hadi"],
  mirrorVersion: `« Et mon succès ne dépend que d'Allah. En Lui je place ma confiance, et vers Lui je me repens. » Ce verset est une formule complète de spiritualité. « Mon succès ne dépend que d'Allah » — la reconnaissance de la source. « En Lui je place ma confiance » — l'attitude face à l'avenir. « Vers Lui je me repens » — le retour constant. Le miroir me montre que ces trois éléments sont liés. Parce que mon succès vient de Lui, je peux me fier à Lui, et quand je dévie, je retourne à Lui.`,
  reflection: `Shu'ayb, ce prophète méconnu, résume en quelques mots toute l'attitude spirituelle : origine, confiance, retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le prophète Shu'ayb s'adresse à son peuple qui le rejette. Son discours est un modèle de dignité et de confiance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui attribue-je mes succès ? À mon travail ? À ma chance ? À mes relations ? Le miroir m'invite à relocaliser la source." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Je me repens » — le retour est constant. On ne se repent pas une fois pour toutes. On se repent chaque jour, chaque instant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute réussite dans l'univers vient de l'alignement avec la volonté divine. La rivière coule parce qu'elle suit la pente que Dieu a créée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ces trois phrases sont une respiration spirituelle : inspir (reconnaissance), pause (confiance), expir (retour). Un cycle constant." }
  ],
  munajat: `Ya Allah, je veux vivre dans cette conscience : Tu es la source de tout bien, je Te fais confiance pour tout, et je retourne à Toi sans cesse. Fais que ces mots deviennent ma respiration.`
};

// Surah 12 - Yusuf
MIROIR["12:53"] = {
  reference: "12:53",
  theme: ["guérison", "confiance", "présence"],
  emotion: "Humilité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffur", "Ar-Ra'uf"],
  mirrorVersion: `« Je ne m'innocente pas. Car l'âme est incitatrice au mal, sauf celle à qui mon Seigneur fait miséricorde. » Ce verset est une déclaration d'humilité radicale. Yusuf, après des années d'épreuves, ne se présente pas comme un saint impeccable. Il dit : je suis capable du pire — si Allah ne me protège pas. Le miroir me montre que ma « bonté » n'est pas une qualité stable que je possède. Elle est un état maintenu par Sa miséricorde. Si Il me lâche, je tombe. Cette conscience est le début de la véritable vigilance.`,
  reflection: `L'âme (nafs) a plusieurs niveaux. Ici, Yusuf parle du « nafs ammara » — l'âme qui commande le mal. Mais il existe aussi le « nafs lawwama » (qui blâme) et le « nafs mutma'inna » (apaisée).`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Yusuf refuse l'auto-justification. Même après avoir résisté à la tentation, il ne s'attribue aucun mérite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je résiste à une tentation, est-ce que je me dis « je suis fort » ? Le miroir me corrige : « tu es protégé »." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde qui protège n'est pas une récompense pour ma bonté — c'est elle qui crée ma bonté. Je suis bon parce qu'Il est bon avec moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa « nafs » — son instinct, ses pulsions. L'animal suit sa nafs naturellement. L'humain peut choisir — avec l'aide d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité n'est pas de se voir mauvais — c'est de se voir dépendant. Je ne suis pas mauvais par nature, mais je ne suis pas bon par moi-même." }
  ],
  munajat: `Ya Allah, je ne veux pas m'innocenter. Je veux Te reconnaître comme la source de tout bien en moi. Protège-moi de moi-même. Maintiens-moi dans Ta miséricorde.`
};

// Surah 14 - Ibrahim
MIROIR["14:34"] = {
  reference: "14:34",
  theme: ["gratitude", "présence", "espoir"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Karim"],
  mirrorVersion: `« Et si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer. » Ce verset me place devant l'impossibilité de la gratitude complète. Je peux essayer de compter — mais je n'y arriverai pas. Chaque souffle est un bienfait. Chaque battement de cœur. Chaque pensée. Chaque capacité. La liste est infinie parce que la source est infinie. Le miroir me montre que la gratitude n'est pas une tâche à accomplir — c'est un état à habiter.`,
  reflection: `L'ingratitude n'est pas le contraire de la gratitude — c'est l'aveuglement. On ne peut pas être ingrat en voyant vraiment les dons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une invitation au dénombrement qui révèle l'impossibilité du dénombrement. C'est le paradoxe de la gratitude infinie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits est-ce que je considère comme « normaux » ? Ma vue ? Mon ouïe ? Ma capacité à aimer ? Le miroir m'invite à voir l'extraordinaire dans l'ordinaire." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si je ne peux pas compter les bienfaits, je peux au moins les reconnaître. La reconnaissance n'a pas besoin de liste complète — elle a besoin d'un cœur ouvert." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un bienfait. Le soleil qui chauffe, la pluie qui nourrit, la terre qui porte — tout est don, rien n'est dû." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur reconnaissant voit des bienfaits partout. Le cœur ingrat ne voit que des manques. Le monde est le même — le regard change tout." }
  ],
  munajat: `Ya Shakur, Tes bienfaits sont innombrables et ma gratitude est limitée. Accepte mon effort de reconnaissance. Ouvre mes yeux à l'océan de dons dans lequel je nage.`
};

// Surah 15 - Al-Hijr
MIROIR["15:99"] = {
  reference: "15:99",
  theme: ["prière", "présence", "espoir"],
  emotion: "Urgence, consécration",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mumin"],
  mirrorVersion: `« Et adore ton Seigneur jusqu'à ce que te vienne la certitude. » La « certitude » (yaqin) dans ce verset signifie la mort — le moment où l'incertitude de la foi devient la certitude de la vision. Le miroir me montre que l'adoration n'est pas un épisode dans ma vie — elle est le fil conducteur qui doit traverser toute ma vie, du début à la fin. Pas de retraite spirituelle, pas de pause, pas de « maintenant je suis bon ». L'adoration jusqu'au dernier souffle.`,
  reflection: `Le yaqin (certitude) est le plus haut degré de connaissance. Il y a la certitude de la science ('ilm al-yaqin), la certitude de la vue ('ayn al-yaqin), et la certitude de la vérité (haqq al-yaqin).`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un commandement simple mais total : adore jusqu'à la fin. Pas de condition, pas d'exception." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon adoration a-t-elle une date de fin ? Ai-je un âge où je me dis « j'ai assez prié » ? Le miroir m'invite à la consécration totale." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin de l'adoration — elle est son accomplissement. L'adoration terrestre prépare l'adoration éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose adore Allah par son existence. L'ange adore par l'obéissance constante. L'humain adore par le choix constant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration continue n'est pas une charge — c'est une respiration. Le cœur qui adore en permanence ne s'épuise pas. Il se nourrit." }
  ],
  munajat: `Ya Allah, fais que mon adoration soit constante, pas intermittente. Fais que je T'adore jusqu'à mon dernier souffle — et que ce souffle soit une prière.`
};

// Surah 16 - An-Nahl
MIROIR["16:97"] = {
  reference: "16:97",
  theme: ["espoir", "force", "confiance"],
  emotion: "Encouragement, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Karim"],
  mirrorVersion: `« Quiconque, homme ou femme, fait une bonne œuvre tout en étant croyant, Nous lui ferons vivre une bonne vie. Et Nous les récompenserons selon les meilleures de leurs actions. » Ce verset contient une promesse extraordinaire pour ici-bas, pas seulement pour l'au-delà. « Une bonne vie » — hayatan tayyiba. Le miroir me montre que la qualité de ma vie spirituelle n'est pas en contradiction avec la qualité de ma vie terrestre. La foi et les bonnes œuvres produisent une vie bonne, maintenant, pas seulement plus tard.`,
  reflection: `La « bonne vie » (hayat tayyiba) est une vie de paix intérieure, de sens, de contentement — même dans les épreuves. C'est la qualité de la présence, pas des circonstances.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une promesse équilibrée entre hommes et femmes, entre cette vie et l'au-delà. La bonne œuvre n'est pas sexuée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vie est-elle « bonne » ? Pas dans les circonstances, mais dans la qualité intérieure ? Le miroir m'aide à distinguer le bonheur de la satisfaction." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne vie n'est pas une récompense extérieure — elle est le fruit naturel de l'alignement intérieur. Quand je suis aligné, je suis bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose qui accomplit sa fonction vit une « bonne vie » à sa manière. L'arbre qui pousse est bien. L'oiseau qui vole est bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La « meilleure récompense » n'est pas forcément la plus visible. Parfois c'est la paix, parfois c'est la clarté, parfois c'est la présence divine elle-même." }
  ],
  munajat: `Ya Allah, promets-moi une bonne vie. Pas une vie facile, mais une vie bonne. Une vie où Tu es présent, où le sens est clair, où la paix intérieure accompagne chaque jour.`
};

// Surah 17 - Al-Isra
MIROIR["17:82"] = {
  reference: "17:82",
  theme: ["guérison", "prière", "espoir"],
  emotion: "Soulagement, confiance",
  difficulty: "débutant",
  relatedNames: ["Ash-Shafi", "Al-Kafi"],
  mirrorVersion: `« Et Nous faisons descendre du Coran ce qui est guérison et miséricorde pour les croyants. » Le Coran n'est pas qu'un livre de lois — c'est un remède. Le miroir me montre que chaque verset peut être une médecine pour un mal spécifique. Mon cœur est anxieux ? Il y a un verset pour cela. Mon âme est triste ? Il y a un verset pour cela. Je me sens seul ? Il y a un verset pour cela. Le Coran est une pharmacie spirituelle — mais je dois savoir quel remède prendre pour quel mal.`,
  reflection: `La guérison par le Coran n'est pas magique — elle passe par la récitation, la contemplation, et l'application. Le remède doit être pris.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ce qui est guérison » — le Coran est décrit comme remède (shifa') pour les cœurs et les corps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me fait souffrir maintenant ? Quel verset pourrait être mon remède ? Le miroir m'invite à chercher dans le Coran la médecine pour mon mal." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guérison est « pour les croyants » — pas parce qu'Allah exclut, mais parce que la guérison nécessite la confiance en Celui qui guérit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute guérison vient d'Allah, qu'elle passe par un médecin, un médicament, ou une prière. Le Coran est une guérison directe de Sa Parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie guérison n'est pas la disparition du mal — c'est la transformation du rapport au mal. Le Coran ne supprime pas toujours l'épreuve, mais il change comment je la vis." }
  ],
  munajat: `Ya Shafi, guéris mon cœur par Ta Parole. Montre-moi quel verset est mon remède aujourd'hui. Fais que le Coran soit pour moi ce qu'il est vraiment : une guérison et une miséricorde.`
};

// Surah 18 - Al-Kahf
MIROIR["18:24"] = {
  reference: "18:24",
  theme: ["confiance", "présence", "humilité"],
  emotion: "Humilité, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-Wakil"],
  mirrorVersion: `« Et ne dis jamais à propos d'une chose : 'Je la ferai demain', sans ajouter : 'Si Allah le veut'. » Ce verset m'invite à reconnaître ma limite. Je ne possède pas demain. Je peux planifier, mais je ne peux pas garantir. « Insha'Allah » n'est pas une formule vide — c'est la reconnaissance que le futur appartient à Allah. Le miroir me montre mon illusion de contrôle. Je dis « je ferai » comme si je possédais le temps. Mais je ne possède même pas ma prochaine respiration.`,
  reflection: `Le « insha'Allah » n'est pas une excuse pour la paresse — c'est la conscience que tout futur dépend de la volonté divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un conseil pratique intégré dans une histoire. Le Prophète a oublié de dire « insha'Allah » et a été rappelé à l'ordre divinement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de fois dis-je « je ferai » sans ajouter « si Allah le veut » ? Le miroson mesure mon illusion de contrôle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Dire « insha'Allah » ne diminue pas ma responsabilité — elle l'encadre. Je planifie et j'agis, tout en sachant que le résultat n'est pas à moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier fonctionne selon la volonté divine. Le soleil se lève parce qu'Il le veut. Les saisons changent parce qu'Il le décide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand « insha'Allah » devient une habitude sincère, l'anxiété diminue. Je fais ce que je peux, et j'accepte ce qui vient." }
  ],
  munajat: `Ya Allah, je veux vivre dans la conscience que demain T'appartient. Fais que « insha'Allah » soit pour moi une reconnaissance sincère, pas une formule mécanique.`
};

// Surah 19 - Maryam
MIROIR["19:96"] = {
  reference: "19:96",
  theme: ["amour", "présence", "espoir"],
  emotion: "Tendresse, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Ar-Rahman"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, le Tout-Miséricordieux leur accordera Son amour. » Ce verset me promet quelque chose d'extraordinaire : l'amour d'Allah. Pas seulement Sa miséricorde, Sa justice, ou Sa clémence — mais Son amour. Et le miroir me montre que cet amour a des conditions simples : croire et faire le bien. Pas être parfait, pas être sans péché — mais croire et essayer. L'amour d'Allah n'est pas réservé à une élite spirituelle. Il est accessible.`,
  reflection: `L'amour divin (hubb) est mentionné à plusieurs reprises dans le Coran. Ici, il est promis à ceux qui croient et agissent bien. L'amour suit l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'expression « Sa part d'amour » (wuddan) suggère une relation personnelle, pas une approbation abstraite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois qu'Allah m'aime ? Ou est-ce que je Le vois comme un juge sévère ? Le miroir m'invite à accueillir Sa tendresse." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah m'aime, pourquoi est-ce que je doute de ma valeur ? Son amour est la mesure ultime de ma dignité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour est la force qui maintient l'univers. Les atomes s'attirent, les planètes gravitent, les cœurs s'aiment — tout est wudd." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur sait qu'il est aimé d'Allah, il n'a plus besoin de chercher l'approbation ailleurs. L'amour divin suffit à guérir toutes les insécurités." }
  ],
  munajat: `Ya Wadud, je veux être de ceux que Tu aimes. Accepte ma foi et mes efforts, si modestes soient-ils. Fais-moi ressentir Ton amour, et fais qu'il me suffise.`
};

// Surah 20 - Ta-Ha
MIROIR["20:14"] = {
  reference: "20:14",
  theme: ["prière", "présence", "méditation"],
  emotion: "Révérence, focus",
  difficulty: "débutant",
  relatedNames: ["Allah", "Al-Haqq"],
  mirrorVersion: `« En vérité, Moi, Je suis Allah. Point de divinité en dehors de Moi. Adore-Moi donc et accomplis la prière pour M'évoquer. » Ce verset est adressé à Moïse, dans la vallée sacrée. Allah Se présente directement : « Je suis Allah ». Pas d'intermédiaire, pas de métaphore. « Point de divinité en dehors de Moi » — le tawhid pur. « Adore-Moi » — la conséquence de la reconnaissance. « Accomplis la prière pour M'évoquer » — la prière n'est pas un rituel vide, mais un rappel conscient.`,
  reflection: `La prière comme dhikr — rappel. Chaque geste de la prière est conçu pour me ramener à la conscience d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une auto-présentation divine. Allah Se nomme, Se définit, et commande. Le fondement de la révélation à Moïse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma prière est-elle un rappel ou une routine ? Est-ce que j'y suis présent avec Allah, ou ailleurs avec mes pensées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui m'évoque dans la prière. La relation n'est pas à sens unique. Je Le nomme, Il me répond." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est en état de prière permanente. L'ange ne cesse d'adorer. L'être humain a reçu des moments dédiés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière pour l'évocation n'est pas une obligation qui pèse — c'est une respiration qui libère. Le cœur étouffe sans elle." }
  ],
  munajat: `Ya Allah, Tu es le Vrai. Fais que ma prière soit un vrai rendez-vous avec Toi, pas une habitude vide. Que chaque prosternation soit un retour à Toi.`
};

// Surah 21 - Al-Anbya
MIROIR["21:35"] = {
  reference: "21:35",
  theme: ["patience", "confiance", "force"],
  emotion: "Acceptation, résilience",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Adl"],
  mirrorVersion: `« Tout âme goûtera la mort. Nous vous éprouvons par le mal et par le bien, à titre de tentation. Et c'est à Nous que vous serez ramenés. » Ce verset me place devant l'inévitable : la mort. Chaque âme la goûtera. Le miroir me montre que cette vérité n'est pas sombre — elle est libératrice. Si je sais que tout finira, je peux arrêter de courir après l'éternel ici-bas. Et l'épreuve par le bien — le succès, la richesse — est aussi un test que l'épreuve par le mal.`,
  reflection: `La mort est l'horizon de toute vie. La conscience de la mort n'est pas morbide — elle est la condition d'une vie lucide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tout âme goûtera » — le verbe suggère une expérience intime, personnelle. La mort n'est pas une abstraction." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'éprouve en ce moment ? Le mal ou le bien ? Le miroir m'aide à voir chaque situation comme un test, pas comme un hasard." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve par le bien peut être plus dangereuse que l'épreuve par le mal. Le succès peut éloigner de Dieu plus sûrement que l'échec." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers passe. Les étoiles meurent, les civilisations s'effondrent. Seul Dieu demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la mort est le secret de la vie. Vivre en sachant qu'on mourra change tout — chaque moment devient précieux." }
  ],
  munajat: `Ya Allah, fais que je vive avec la conscience de la mort sans être obsédé par elle. Aide-moi à voir chaque épreuve comme ce qu'elle est : un test de ma foi.`
};

// Surah 22 - Al-Hajj
MIROIR["22:78"] = {
  reference: "22:78",
  theme: ["force", "confiance", "prière"],
  emotion: "Determination, engagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Mawla"],
  mirrorVersion: `« Et luttez pour Allah avec la lutte qui Lui est due. C'est Lui qui vous a élus; et Il n'a placé aucune gêne dans la religion. » Ce verset m'appelle au jihad — pas le jihad militaire, mais le jihad spirituel : l'effort sur soi-même pour Allah. « La lutte qui Lui est due » — Allah mérite un effort total. Mais aussitôt : « Il n'a placé aucune gêne dans la religion ». Le paradoxe est résolu : l'effort est total, mais il n'est pas pénible quand il est fait avec amour.`,
  reflection: `Le « jihad nafs » — la lutte contre l'ego — est le plus grand combat. Et le « haraj » (gêne) n'existe pas dans une religion faite pour la facilité de l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le jihad authentique est pour Allah, pas pour l'ego, pas pour le pouvoir, pas pour la tribu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi est-ce que je lutte dans ma vie ? Pour ma carrière ? Mon image ? Ou pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Il vous a élus » — je ne me suis pas choisi. Allah m'a choisi avant que je ne Le choisisse. Ma lutte est une réponse à Son élection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers lutte pour sa place. La plante lutte vers la lumière. L'être humain lutte vers Dieu — ou vers autre chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'absence de gêne dans la religion signifie que le chemin vers Dieu est naturel pour l'âme. L'âme est faite pour ce chemin." }
  ],
  munajat: `Ya Allah, je veux lutter pour Toi, pas pour mes désirs. Montre-moi quel combat est le mien. Et fais que ce combat soit une joie, pas un fardeau.`
};

// Surah 25 - Al-Furqan
MIROIR["25:70"] = {
  reference: "25:70",
  theme: ["pardon", "espoir", "guérison"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Sauf celui qui se repent, croit et accomplit de bonnes œuvres. Ceux-là, Allah changera leurs mauvaises actions en bonnes actions. » Ce verset contient une promesse extraordinaire : non seulement les péchés sont pardonnés, mais ils sont transformés. Les mauvaises actions deviennent bonnes. Comment ? Par le repentir sincère. Le miroir me montre que mon passé n'est pas fixé. Ce que j'ai fait de mal peut devenir, par la grâce d'Allah, une source de bien.`,
  reflection: `La transformation des péchés en bonnes actions est le signe ultimate de la miséricorde divine. Le passé ne condamne pas — il peut devenir trésor.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois conditions : repentir (tawba), foi (iman), bonnes œuvres ('amal salih). Les trois ensemble transforment le passé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel passé me pèse ? Qu'est-ce que j'ai fait que je crois impossible à transformer ? Le miroir me dit : même ça peut devenir bien." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le péché qui m'éloignait de Allah peut devenir le chemin qui m'en rapproche. La prise de conscience du péché peut ouvrir une porte que l'innocence n'ouvre pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature transforme le poison en remède, la pourriture en terre fertile. Allah transforme le mal en bien — c'est Sa façon d'être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le péché pardonné devient une bénédiction cachée. Celui qui a péché et s'est repenti connaît une miséricorde que l'innocent ne connaît pas." }
  ],
  munajat: `Ya Tawwab, transforme mes erreurs en trésors. Ne laisse aucun péché sans pardon, aucune faute sans rédemption. Fais de mon passé une source de lumière.`
};

// Surah 29 - Al-'Ankabut
MIROIR["29:69"] = {
  reference: "29:69",
  theme: ["guidance", "force", "confiance"],
  emotion: "Determination, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "As-Sirat"],
  mirrorVersion: `« Et ceux qui luttent pour Nous, Nous les guiderons sur Nos chemins. » Ce verset contient une promesse conditionnelle. Ceux qui luttent — ceux qui font l'effort — reçoivent la guidance. La précèdent pas ; elle répond à l'effort. Le miroir me montre que j'attends souvent la guidance avant de bouger. Mais Allah dit : bouge d'abord, et Je te guiderai. L'effort sur soi-même ouvre les chemins que l'immobilité ne peut pas voir.`,
  reflection: `La guidance (hidaya) n'est pas seulement une connaissance — c'est un chemin qui s'ouvre. Et ce chemin s'ouvre à celui qui marche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nos chemins » au pluriel suggère une multiplicité de voies vers Allah. Pas un seul chemin, mais autant de chemins que de chercheurs sincères." },
    { label: "Le Reflet", ar: "المرصAD", color: "var(--mirror)", text: "Où est-ce que je stagne en attendant la guidance ? Le miroir m'invite à faire le premier pas, même dans le flou." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lutte pour Allah n'est pas une lutte contre le monde — c'est une lutte pour Sa proximité. Et c'est Lui qui ouvre la porte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers cherche son créateur à sa manière. La plante cherche la lumière. L'âme cherche son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les chemins d'Allah sont sans nombre. Chaque âme a son chemin unique. La lutte pour Allah révèle quel est mon chemin personnel." }
  ],
  munajat: `Ya Hadi, je veux lutter pour Toi. Ouvre-moi Tes chemins. Montre-moi la voie qui est faite pour moi — et donne-moi la force de la suivre.`
};

// Surah 30 - Ar-Rum
MIROIR["30:21"] = {
  reference: "30:21",
  theme: ["amour", "paix", "méditation"],
  emotion: "Tendresse, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "As-Salam"],
  mirrorVersion: `« Et parmi Ses signes, Il a créé de vous des épouses pour que vous viviez avec elles en tranquillité, et Il a mis entre vous de l'affection et de la bonté. » Ce verset décrit le mariage comme un signe divin. Le miroir me montre que l'amour humain n'est pas une distraction spirituelle — c'est une fenêtre sur l'amour divin. La « tranquillité » (sakina) recherchée dans le couple est un reflet de la sakina que l'âme cherche en Allah.`,
  reflection: `L'amour entre époux est un « signe » d'Allah — un miroir de Son amour. Celui qui comprend l'amour humain peut comprendre l'amour divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois dons dans le couple : tranquillité (sakina), affection (mawadda), bonté (rahma). La relation conjugale est une école spirituelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je trouve la sakina dans mes relations ? Ou est-ce que je cherche la tranquillité ailleurs que dans les liens authentiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si le mariage est un signe, alors l' célibat aussi peut être un signe. Chaque état de vie révèle quelque chose de Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est tissé de relations. L'atome avec l'atome, la planète avec l'étoile, l'être avec l'être. La relation est la structure de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'amour humain parfait n'existe pas — mais l'amour humain peut être parfait comme chemin vers l'Amour parfait. Chaque relation est une école." }
  ],
  munajat: `Ya Wadud, remercie-Toi pour l'amour que Tu as mis entre les êtres. Fais que mes relations soient des chemins vers Toi, pas des distractions de Toi.`
};

// Surah 31 - Luqman
MIROIR["31:17"] = {
  reference: "31:17",
  theme: ["prière", "force", "confiance"],
  emotion: "Détermination, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Ô mon fils, accomplis la prière, commande le convenable, interdis le blâmable, et endure ce qui t'atteint avec patience. » Les conseils de Luqman à son fils résument la vie spirituelle en quatre piliers : la prière (relation verticale), commander le bien (responsabilité sociale), interdire le mal (engagement moral), la patience (attitude face aux épreuves). Le miroir me montre que ces quatre éléments sont interdépendants. La prière donne la force pour le bien social, et la patience permet de tenir dans les deux.`,
  reflection: `Luqman le sage n'était pas un prophète, mais ses conseils sont dignes de la révélation. La sagesse n'est pas l'apanage des prophètes — elle est accessible à tout cœur sage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Quatre commandements en ordre : prière, bien, vérité, patience. La base est la prière — tout le reste en découle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Lequel de ces quatre piliers est faible en moi ? Ma prière ? Mon engagement social ? Ma patience ? Le miroir identifie la brèche." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience vient à la fin — elle est la conséquence de tout le reste. Celui qui prie, fait le bien et dit la vérité aura besoin de patience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute société qui pratique ces quatre principes prospère. Toute société qui les abandonne décline. C'est une loi universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'équilibre entre ces quatre est le secret. Trop de patience sans action devient passivité. Trop d'action sans prière devient épuisement." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse de Luqman. Fais que je prie, que j'agisse, que je dise la vérité, et que j'endure avec grâce. Enseigne-moi l'équilibre.`
};

// Surah 32 - As-Sajdah
MIROIR["32:17"] = {
  reference: "32:17",
  theme: ["espoir", "amour", "présence"],
  emotion: "Émerveillement, attente",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Karim", "Al-Wadud"],
  mirrorVersion: `« Aucun être humain ne sait ce qui lui est caché comme réjouissance pour récompense de ce qu'il œuvrait. » Ce verset promet des joies cachées que l'esprit humain ne peut même pas imaginer. Le miroir me montre que mon imagination est limitée par mon expérience. Je ne peux pas imaginer une couleur que je n'ai jamais vue. De même, les joies du Paradis dépassent tout ce que j'ai connu. Cette promesse n'est pas une fuite — elle est une perspective qui donne du sens à l'effort présent.`,
  reflection: `Les joies du Paradis ne sont pas des plaisirs connus amplifiés — elles sont d'une nature radicalement nouvelle. « Ce que aucun œil n'a vu, aucune oreille n'a entendu ».`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ce qui est caché » (ma ayyana) suggère une réserve secrète, préparée spécifiquement pour chaque âme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'espère ? Des plaisirs que je connais ? Le miroir m'invite à espérer ce que je ne peux même pas imaginer." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est caché pour les œuvres est aussi caché pour les épreuves. De même que je ne peux pas imaginer les joies, je ne peux pas imaginer les bienfaits cachés dans mes difficultés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers réserve des surprises à chaque niveau. Le microscope révèle un monde invisible. Le Paradis révèlera des joies invisibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'espérance en ce qui est caché transforme le présent. Vivre en sachant qu'un trésor m'attend change comment je traverse chaque jour." }
  ],
  munajat: `Ya Karim, Tu as préparé pour moi ce que je ne peux pas imaginer. Ouvre mon cœur à l'espérance. Fais que je vive dans l'attente joyeuse de Tes surprises.`
};

// Surah 33 - Al-Ahzab
MIROIR["33:56"] = {
  reference: "33:56",
  theme: ["amour", "prière", "présence"],
  emotion: "Revérence, connexion",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Muhammad"],
  mirrorVersion: `« Certes, Allah et Ses anges prient sur le Prophète. Ô vous qui croyez, priez sur lui et saluez-le abondamment. » Ce verset révèle quelque chose d'extraordinaire : Allah Lui-même « prie » sur le Prophète. La prière d'Allah n'est pas comme la nôtre — c'est Sa miséricorde, Son attention, Son honneur qu'Il accorde. Le miroir me montre que prier sur le Prophète n'est pas un rituel vide — c'est entrer dans un courant de grâce qui va d'Allah aux anges aux croyants.`,
  reflection: `La prière sur le Prophète (salawat) est une connexion à la source de la miséricorde. Celui qui prie sur le Prophète reçoit dix prières d'Allah en retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verbe « yusalli » est utilisé pour Allah, les anges et les croyants — un même mot pour des réalités différentes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quelle fréquence prie-je sur le Prophète ? Le miroir me montre que cette pratique simple ouvre une porte immense de bénédictions." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète prie aussi pour ceux qui prient sur lui. La relation est réciproque. Je me connecte à lui, il se connecte à moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Prophète est une miséricorde pour les mondes. Prier sur lui, c'est se connecter à la source de la miséricorde universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La salawat régulière poli le cœur. Chaque salawat est une goutte qui nettoie l'ego et rapproche de la lumière prophétique." }
  ],
  munajat: `Ya Allah, prie sur Muhammad et sur la famille de Muhammad, comme Tu as prié sur Ibrahim et la famille d'Ibrahim. Accorde-lui la bénédiction et la paix.`
};

// Surah 35 - Fatir
MIROIR["35:2"] = {
  reference: "35:2",
  theme: ["confiance", "gratitude", "force"],
  emotion: "Reconnaissance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Mu'ti"],
  mirrorVersion: `« Ce qu'Allah accorde comme miséricorde aux gens, nul ne peut la retenir. Et ce qu'Il retient, nul ne peut le relâcher après Lui. » Ce verset place ma vie entre les mains d'Allah. Ce qu'Il donne, personne ne peut l'enlever. Ce qu'Il retient, personne ne peut le donner. Le miroir me montre que mes efforts pour « sécuriser » ce que j'ai sont vains. Je ne possède rien — je reçois tout. La sécurité ne vient pas de mes stratégies, mais de Sa volonté de donner.`,
  reflection: `La miséricorde d'Allah est inconditionnelle dans sa source, mais conditionnée par Sa sagesse. Il donne quand c'est bon, retient quand c'est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux impossibilités : personne ne peut empêcher ce qu'Il donne, personne ne peut donner ce qu'Il retient. Sa volonté est absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains de perdre ? Et qu'est-ce que je désespère d'obtenir ? Le miroir me dit : ni la peur ni le désespoir n'ont de sens." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qu'Il retient peut être un bien. Ce qu'Il donne peut être une épreuve. Seul Lui connaît la valeur véritable de ce qui arrive." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers reçoit ce qui lui est destiné. La pluie tombe sur qui elle doit tomber. Le soleil éclaire qui il doit éclairer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance totale libère de la lutte. Pourquoi lutter pour ce qui ne peut pas être retenu ? Pourquoi craindre pour ce qui ne peut pas être enlevé ?" }
  ],
  munajat: `Ya Wahhab, Tu donnes et Tu retiens selon Ta sagesse. Fais que je reçoive avec gratitude ce que Tu donnes, et que j'accepte avec confiance ce que Tu retiens.`
};

// Surah 36 - Ya-Sin
MIROIR["36:11"] = {
  reference: "36:11",
  theme: ["guidance", "présence", "méditation"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Wa'iz"],
  mirrorVersion: `« Tu avertis seulement celui qui suit le Rappel et craint le Tout-Miséricordieux en secret. » Ce verset distingue ceux qui peuvent être touchés par le message : ceux qui suivent le Rappel (le Coran) et qui craignent Allah « en secret ». La crainte en secret signifie une conscience de Allah même quand personne ne regarde. Le miroir me montre que ma vie publique peut être impeccable tandis que mon cœur en privé est ailleurs. La vraie piété se mesure dans le secret.`,
  reflection: `La crainte en secret (khawf al-sirr) est le signe d'une conscience vivante. Celui qui ne craint que le regard des hommes n'a pas vraiment compris.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Rappel (dhikr) et la crainte secrète (khawf) sont les deux conditions pour être touché par l'avertissement coranique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui suis-je quand personne ne me voit ? Le miroir du secret révèle ma vraie relation avec Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte en secret n'est pas de la peur — c'est de la conscience. Je ne crains pas Sa punition autant que Sa désapprobation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est dans la crainte respectueuse de son Créateur. L'atome obéit aux lois. L'être humain peut choisir — mais le cœur sage craint." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte en secret purifie l'intention. Quand je fais le bien sans témoin, c'est vraiment pour Allah que je le fais." }
  ],
  munajat: `Ya Rahman, je veux Te craindre même quand personne ne me voit. Purifie mon intention. Fais que chaque acte secret soit un acte pour Toi.`
};

// Surah 40 - Ghafir
MIROIR["40:60"] = {
  reference: "40:60",
  theme: ["prière", "confiance", "espoir"],
  emotion: "Espérance, connexion",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Qarib"],
  mirrorVersion: `« Et votre Seigneur dit : 'Invoquez-Moi, Je vous exaucerai.' » Ce verset est une invitation directe d'Allah. Pas une suggestion — une invitation. Et une promesse : « Je vous exaucerai ». Le miroir me montre que je ne prie pas assez. Je m'inquiète, je planifie, je me plains — mais je n'invoque pas vraiment. Pourtant, la promesse est là : demandez, et vous recevrez. Pas peut-être — vous recevrez.`,
  reflection: `L'invocation (du'a') est l'essence de l'adoration selon le Prophète. C'est le moment où la créature reconnaît sa dépendance et le Créateur Sa générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un impératif divin : « Invoquez-Moi ». Le du'a' n'est pas optionnel — c'est une obligation spirituelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je désire vraiment ? Et ai-je vraiment demandé à Allah ? Le miroir m'invite à verbaliser mes désirs devant Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exaucement n'est pas forcément selon ma demande. Parfois Allah donne mieux, parfois Il retient par sagesse. Mais Il répond toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose invoque Allah par son besoin. La plante invoque la pluie. L'âme invoque son Seigneur. Le besoin est une prière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le du'a' change celui qui prie autant que sa situation. En demandant, je reconnais que je ne suis pas autonome. Et cette reconnaissance est un trésor." }
  ],
  munajat: `Ya Mujib, Tu m'invites à T'invoquer. Me voici. J'apporte mes besoins, mes désirs, mes peurs. Exauce-moi selon Ta sagesse, pas selon mon impatience.`
};

// Surah 41 - Fussilat
MIROIR["41:53"] = {
  reference: "41:53",
  theme: ["guidance", "présence", "méditation"],
  emotion: "Certitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Bayyinah"],
  mirrorVersion: `« Nous leur montrerons Nos signes dans l'univers et en eux-mêmes, jusqu'à ce qu'il leur devienne évident que c'est la vérité. » Ce verset promet que la vérité finira par être évidente. Les signes d'Allah sont partout — dans l'univers (le cosmos) et en nous-mêmes (l'âme). Le miroir me montre que je cherche parfois Allah au loin alors qu'Il est visible dans la création et dans ma propre constitution. Chaque cellule, chaque étoile, chaque souffle est un signe.`,
  reflection: `La vérité (al-haqq) devient évidente non par l'argument mais par l'expérience. Celui qui regarde avec sincérité finit par voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux lieux de signes : l'univers (l'extérieur) et l'âme (l'intérieur). Le macrocosme et le microcosme disent la même vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel signe d'Allah ai-je vu aujourd'hui ? Le soleil ? Mon cœur qui bat ? Une parole qui m'a touché ? Le miroir m'invite à la reconnaissance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si la vérité doit devenir évidente, pourquoi est-elle parfois obscure ? Parce que mon regard est voilé, pas parce que la vérité est cachée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un livre de signes. Chaque page dit « Allah ». L'âme aussi est un livre — chaque expérience dit « Il est là »." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand la vérité devient évidente, la foi cesse d'être un effort pour devenir une évidence. C'est l'état du yaqin — la certitude." }
  ],
  munajat: `Ya Haqq, montre-moi Tes signes. Ouvre mes yeux à l'univers et à mon âme. Fais que la vérité devienne évidente pour mon cœur, pas seulement pour mon intellect.`
};

// ============================================
// EXPANSION PHASE 2 - More Surah Coverage
// ============================================

// Surah 23 - Al-Mu'minun
MIROIR["23:1"] = {
  reference: "23:1",
  theme: ["présence", "prière", "méditation"],
  emotion: "Espoir, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Muflih"],
  mirrorVersion: `« Bienheureux sont les croyants qui sont humbles dans leur prière. » Ce verset ouvre une sourate entière dédiée aux qualités des croyants véritables. Le miroir me place devant une liste de contrôle spirituelle. Suis-je de ceux qui « sont humbles dans leur prière » ? L'humilité dans la prière (khushu') n'est pas une émotion — c'est une présence. C'est quand mon corps et mon cœur sont alignés face à Allah.`,
  reflection: `Les « bienheureux » (aflaha) sont ceux qui réussissent vraiment. Le succès dans l'au-delà commence par la qualité de la prière ici-bas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La sourate énumère les qualités des croyants : khushu' dans la prière, évitement du vain, paiement de la zakat, préservation des parties intimes..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je prie, où est mon cœur ? Est-ce que je suis présent ou distrait ? Le miroir m'invite à évaluer la qualité, pas seulement la quantité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans la prière n'est pas un effort — c'est un don. C'est quand je réalise devant Qui je me tiens que l'humilité devient naturelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création « prie » à sa manière. L'humain seul peut prier avec conscience ou sans. Le khushu' est ce qui distingue la prière vivante de la récitation morte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière avec khushu' est le paradis anticipé. Dans ces moments, le temps s'arrête, et l'âme goûte à ce qui l'attend." }
  ],
  munajat: `Ya Allah, je me tiens devant Toi mais mon cœur s'égare. Apprends-moi le khushu'. Fais que ma prière soit une vraie rencontre, pas une répétition.`
};

// Surah 26 - Ash-Shu'ara
MIROIR["26:88"] = {
  reference: "26:88",
  theme: ["détachement", "confiance", "sagesse"],
  emotion: "Lucidité, priorisation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Hadi"],
  mirrorVersion: `« Le jour où ni les biens ni les enfants ne seront d'aucune utilité, sauf celui qui vient à Allah avec un cœur sain. » Ce verset est un diagnostic radical. Le miroir me demande : sur quoi comptes-tu vraiment ? Tes économies ? Ta famille ? Ta réputation ? Tout cela sera inutile. Seul un « cœur sain » (qalb salim) servira. Un cœur sain, c'est un cœur sans maladie : sans shirk (association), sans hasad (envie), sans kibr (orgueil). Un cœur purifié.`,
  reflection: `Le cœur sain est la seule monnaie valable au Jour du Jugement. Ni l'intelligence, ni la beauté, ni la richesse ne seront acceptées. Seul le cœur compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset vient dans le contexte des épreuves de l'au-delà. Les biens et les enfants, souvent nos plus grandes fiertés, deviennent inutiles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui « sécurise » ma vie aujourd'hui ? Et si j'enlevais cela, que resterait-il ? Le miroir m'aide à identifier mes fausses assurances." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur sain n'est pas un cœur parfait — c'est un cœur qui se tourne sincèrement vers Allah. La santé spirituelle n'est pas l'absence de péché, mais la présence de retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne à son origine. Le cœur retourne à son Créateur. Seul ce qui est compatible avec Lui peut faire ce voyage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur sain est celui qui a fait la paix avec Allah — qui a cessé de Lui faire la guerre par ses résistances, ses doutes, ses rébellions." }
  ],
  munajat: `Ya Allah, purifie mon cœur. Enlève ce qui l'encombre : l'orgueil, l'envie, l'attachement au monde. Donne-moi un qalb salim qui viendra à Toi sans honte.`
};

// Surah 27 - An-Naml
MIROIR["27:62"] = {
  reference: "27:62",
  theme: ["espoir", "confiance", "prière"],
  emotion: "Soulagement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Fattah"],
  mirrorVersion: `« N'est-ce pas Lui qui répond à l'accablé quand il L'invoque, et qui dissipe le mal ? » Ce verset est une des plus belles promesses du Coran. Le miroir me montre un Allah qui répond spécifiquement à « l'accablé » (al-mudtar). Pas au parfait, pas au saint — à celui qui est écrasé par les difficultés. Quand je suis au fond du trou, incapable de bouger, Allah dit : « Invoque-Moi, Je répondrai. »`,
  reflection: `La réponse d'Allah à l'accablé est une promesse inconditionnelle. Celui qui est vraiment dans la difficulté a accès direct à la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset utilise la forme interrogative rhétorique : « N'est-ce pas Lui... ? » La réponse est évidente : oui, c'est Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis accablé, vers qui me tourne-je en premier ? Vers les remèdes humains ou vers l'Invoqué divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est peut-être l'accablement lui-même qui est la porte. Sans lui, je n'invoquerais pas. La difficulté crée l'ouverture vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature en détresse « invoque » à sa manière. Le cri du bébé, le gémissement du malade, le silence du désespéré — tout est entendu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La réponse d'Allah précède parfois l'invocation. Il prépare la délivrance avant même que je ne demande." }
  ],
  munajat: `Ya Mujib, je suis accablé et je viens à Toi. Réponds à mon invocation. Délivre-moi de ce qui m'écrase. Tu es le seul qui peut vraiment soulager.`
};

// Surah 28 - Al-Qasas
MIROIR["28:56"] = {
  reference: "28:56",
  theme: ["guidance", "amour", "sagesse"],
  emotion: "Humilité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Muqtadir"],
  mirrorVersion: `« Tu ne guides pas celui que tu aimes, mais c'est Allah qui guide qui Il veut. » Ce verset a été révélé au sujet d'Abu Talib, l'oncle du Prophète qui l'avait protégé mais n'avait pas embrassé l'Islam. Le miroir me montre les limites de mon influence. J'ai des proches que j'aime et que je voudrais voir guidés. Mais la guidance n'est pas dans mes mains. Mon rôle est d'aimer, de témoigner, de prier — le reste appartient à Allah.`,
  reflection: `La guidance (hidayah) est un don divin, pas un fruit de l'effort humain. Le Prophète lui-même ne pouvait pas guider ceux qu'il aimait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un verset d'humilité pour le Prophète et pour nous. Même le meilleur des humains ne contrôle pas les cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'essaie de « sauver » ? Et comment réagis-je quand mes efforts échouent ? Le miroir m'invite au lâcher-prise." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si je ne peux pas guider, je peux aimer. L'amour authentique est plus puissant que la persuasion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque cœur a son propre chemin vers Allah. Certains prennent des détours que je ne comprends pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie guidance passe par l'acceptation que je ne suis pas le Maître des cœurs. Je suis un messager, pas un contrôleur." }
  ],
  munajat: `Ya Hadi, Toi seul guides les cœurs. J'aime ceux qui m'entourent mais je ne peux pas les sauver. Conduis-les vers Toi, à Ton heure, à Ta manière.`
};

// Surah 34 - Saba
MIROIR["34:3"] = {
  reference: "34:3",
  theme: ["présence", "sagesse", "confiance"],
  emotion: "Révérence, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-'Alim"],
  mirrorVersion: `« Ceux qui ne croient pas disent : 'L'Heure ne nous viendra pas.' Dis : 'Au contraire, par mon Seigneur, elle vous viendra certainement.' » Ce verset traite de la certitude de l'Heure (as-sa'ah). Le miroir me montre que je vis parfois comme si l'Heure n'arriverait jamais. Je remets à demain ce que je devrais faire aujourd'hui. La mort, le jugement, la rencontre avec Allah — tout cela semble si lointain. Et pourtant, c'est une certitude.`,
  reflection: `L'Heure est certaine, mais son moment est inconnu. Cette combinaison crée une tension salutaire : vivre chaque jour comme si c'était le dernier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset répond aux négateurs par une affirmation solennelle : « Par mon Seigneur » (rabbika). Le serment divin confirme la certitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si l'Heure arrivait aujourd'hui, serais-je prêt ? Qu'est-ce que j'aurais regret de ne pas avoir fait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de l'Heure devrait transformer mon présent. Chaque instant devient précieux, chaque acte devient compté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers tend vers une fin. Les étoiles s'éteindront, les montagnes s'effondreront. Seul Allah demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la certitude de l'Heure ne s'attache à rien. Il passe dans ce monde sans s'y installer." }
  ],
  munajat: `Ya Allah, l'Heure viendra certainement. Fais que je ne l'oublie pas. Aide-moi à vivre chaque jour comme si c'était le dernier, dans la préparation et la présence.`
};

// Surah 39 - Az-Zumar (adding another important verse)
MIROIR["39:9"] = {
  reference: "39:9",
  theme: ["méditation", "sagesse", "présence"],
  emotion: "Humilité, aspiration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Dis : 'Sont-ils égaux, ceux qui savent et ceux qui ne savent pas ?' Seuls les doués d'intelligence se rappellent. » Ce verset établit une hiérarchie spirituelle basée sur la connaissance. Le miroir me demande : quelle est ma relation avec le savoir ? Le « savoir » ici n'est pas l'information — c'est la connaissance d'Allah (ma'rifa). Celui qui connaît vraiment Allah ne peut pas vivre comme celui qui ne Le connaît pas.`,
  reflection: `La connaissance d'Allah transforme l'être. Le savant spirituel voit ce que l'ignorant ne voit pas. Sa prière, sa patience, sa confiance sont d'une autre qualité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une question rhétorique : l'égalité entre savants et ignorants est évidemment impossible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « sais » vraiment d'Allah ? Et comment cette connaissance transforme-t-elle ma vie quotidienne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie connaissance n'enflée pas — elle humilie. Plus je connais Allah, plus je me connais comme limité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une manifestation de la connaissance divine. Le connaître, c'est Le connaître à travers Ses signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les « doués d'intelligence » (ulu l-albab) sont ceux dont le cœur a été ouvert. L'intelligence spirituelle n'est pas dans la tête — elle est dans le cœur." }
  ],
  munajat: `Ya 'Alim, apprends-moi ce qui Te concerne. Pas une connaissance qui enflée, mais une connaissance qui rapproche. Fais de moi un de ceux qui se rappellent.`
};

// Surah 42 - Ash-Shura
MIROIR["42:37"] = {
  reference: "42:37",
  theme: ["force", "patience", "confiance"],
  emotion: "Résilience, pardon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Afuww", "Al-Ghaffur"],
  mirrorVersion: `« Ceux qui évitent les péchés graves et les turpitudes, et qui pardonnent quand ils sont en colère. » Ce verset décrit les croyants de haut rang. Le miroir me montre deux axes : l'un vertical (éviter les péchés) et l'un horizontal (pardonner quand on est en colère). Le deuxième est peut-être plus difficile. Être en colère et pardonner — c'est le test ultime de la maîtrise de soi.`,
  reflection: `Le pardon dans la colère est un miracle spirituel. C'est quand l'ego crie « justice ! » que le cœur choisi « miséricorde ».`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset lie le pardon à la colère (ghadab). Pas le pardon facile, mais le pardon dans le moment où l'ego est blessé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis en colère, quelle est ma première réaction ? La riposte ou le pardon ? Le miroir me montre mon niveau spirituel réel." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Pardonner quand on est en colère, c'est se souvenir que j'ai été pardonné par Allah. Je donne ce que j'ai reçu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice humaine demande « œil pour œil ». La justice divine offre le pardon. Le croyant transcende la première pour embrasser la seconde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le pardon dans la colère purifie le cœur de ses chaînes. Celui qui pardonne se libère, même si l'autre ne le mérite pas." }
  ],
  munajat: `Ya 'Afuww, Tu me pardonnes quand je ne le mérite pas. Apprends-moi à faire de même. Quand la colère monte, fais que je choisisse le pardon, pas la riposte.`
};

// Surah 47 - Muhammad
MIROIR["47:7"] = {
  reference: "47:7",
  theme: ["confiance", "force", "guidance"],
  emotion: "Engagement, assurance",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Wali"],
  mirrorVersion: `« Ô vous qui croyez ! Si vous soutenez Allah, Il vous soutiendra et raffermira vos pas. » Ce verset établit un partenariat extraordinaire. Le miroir me montre que « soutenir Allah » signifie soutenir Sa cause, Sa vérité, Sa guidance. Et la promesse est double : soutien divin et raffermissement. Quand je marche dans Sa direction, Il raffermît mes pas.`,
  reflection: `Le soutien d'Allah n'est pas magique — il vient quand je m'engage. Ma step déclenche Sa réponse. L'initiative est la mienne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Soutenir Allah » (tansuruna Allah) signifie aider Sa religion, défendre Ses signes, propager Sa vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je « soutiens » Allah dans ma vie quotidienne ? Par ma parole ? Mes actions ? Ma patience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui me soutient en premier. Mon soutien à Sa cause est une réponse à Son soutien éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute cause juste est « soutenue » par Allah. L'histoire est remplie de vainqueurs apparemment faibles qui ont triomphé par un soutien invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le raffermissement des pas signifie que la route devient plus claire, plus stable. Celui qui soutient Allah n'est jamais vraiment perdu." }
  ],
  munajat: `Ya Nasir, je veux Te soutenir. Mais je suis faible et distrait. Montre-moi comment Te soutenir, et promets-moi Ton aide quand je le ferai.`
};

// Surah 49 - Al-Hujurat
MIROIR["49:13"] = {
  reference: "49:13",
  theme: ["sagesse", "présence", "amour"],
  emotion: "Humilité, fraternité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-'Alim"],
  mirrorVersion: `« Ô humains ! Nous vous avons créés d'un mâle et d'une femelle, et Nous avons fait de vous des nations et des tribus pour que vous vous connaissiez. Le plus noble d'entre vous auprès d'Allah est le plus pieux. » Ce verset est la charte universelle de l'humanité. Le miroir me montre que mes distinctions (nationalité, ethnie, statut) sont des outils de connaissance, pas de supériorité. La seule vraie hiérarchie est la piété (taqwa) — et elle est invisible aux yeux humains.`,
  reflection: `La diversité humaine est voulue par Allah. Les différences ne sont pas des obstacles mais des opportunités de rencontre et de connaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un appel universel : « Ô humains ! » Pas « ô croyants » ou « ô Arabes ». Tous sont concernés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je vois ceux qui sont différents de moi ? Avec curiosité ou jugement ? Le miroir m'invite à la rencontre plutôt qu'à la comparaison." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse aux yeux d'Allah n'est pas visible. Le plus pauvre, le plus simple peut être le plus noble. Le plus puissant peut être le plus vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité forme une seule famille, diverse mais unie dans son origine et sa destination. La taqwa est le lien universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise que la seule noblesse est la taqwa cesse de juger par l'apparence. Il regarde les cœurs, pas les habits." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé parmi des peuples différents. Aide-moi à voir au-delà des différences. Fais que je recherche la taqwa — la seule chose qui compte vraiment auprès de Toi.`
};

// Surah 51 - Adh-Dhariyat
MIROIR["51:56"] = {
  reference: "51:56",
  theme: ["présence", "prière", "méditation"],
  emotion: "Purpose, orientation",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Hamid"],
  mirrorVersion: `« Je n'ai créé les djinns et les hommes que pour qu'ils M'adorent. » Ce verset est le verset de la finalité. Le miroir me place devant la question ultime : pourquoi existé-je ? La réponse est claire : l'adoration. Pas parce qu'Allah a besoin de mon adoration — Il est « Al-Ghani », le Riche — mais parce que l'adoration est le sens de mon existence. C'est ce pour quoi je suis fait.`,
  reflection: `L'adoration ('ibadah) dans l'Islam englobe toute action faite avec intention divine. Travailler, aimer, apprendre — tout peut être adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une déclaration de but : « Je n'ai créé... que pour... » La raison d'être est unique et claire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je poursuis dans ma vie ? Est-ce aligné avec ma raison d'être ? Le miroir m'invite à vérifier ma direction." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de mon adoration — c'est moi qui ai besoin d'adorer. L'adoration me construit, pas Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création « adore » par son existence. L'humain seul peut choisir d'adorer consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand l'adoration devient l'orientation de toute la vie, chaque acte devient prière. La vie entière devient un acte de présence." }
  ],
  munajat: `Ya Allah, Tu m'as créé pour T'adorer. Mais je m'égare dans tant de poursuites. Recentre-moi. Fais que chaque acte soit un acte d'adoration.`
};

// Surah 53 - An-Najm
MIROIR["53:39"] = {
  reference: "53:39",
  theme: ["force", "méditation", "sagesse"],
  emotion: "Responsabilité, authenticité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hasib"],
  mirrorVersion: `« Que l'homme n'obtiendra que ce qu'il aura acquis par son effort. » Ce verset établit le principe de la responsabilité personnelle. Le miroir me montre que je ne peux pas compter sur l'héritage spirituel, la famille pieuse, ou les bonnes actions des autres. Chacun récolte ce qu'il sème. Mon effort (sa'y) détermine mon résultat.`,
  reflection: `L'effort spirituel est individuel. Personne ne peut prier à ma place, ni croire pour moi. Ma relation avec Allah est personnelle et intransférable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le mot « sa'y » signifie effort, course, lutte. C'est l'investissement personnel, pas le statut social." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon effort spirituel réel ? Est-ce que je compte sur les autres ou est-ce que je travaille sur moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort est nécessaire — mais le résultat dépend d'Allah. Je fournis le sa'y, et Lui fournit le résultat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi de cause à effet gouverne le monde. Semer récolter. Effort résultat. C'est une justice cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus bel effort est celui fait pour Allah, sans attacher le cœur au résultat. L'effort purifié de son ego." }
  ],
  munajat: `Ya Allah, fais que je ne compte que sur mon propre effort. Apprends-moi à travailler pour Toi, sans attendre la validation des autres, sans craindre le résultat.`
};

// Surah 54 - Al-Qamar
MIROIR["54:17"] = {
  reference: "54:17",
  theme: ["méditation", "guidance", "présence"],
  emotion: "Accessibilité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Murshid"],
  mirrorVersion: `« En vérité, Nous avons rendu le Coran facile pour la méditation. Y a-t-il quelqu'un pour le méditer ? » Ce verset est répété quatre fois dans cette sourate. Le miroir me montre une offre extraordinaire : le Coran est « facile » (yassarna) — accessible à tous, pas seulement aux savants. La seule condition est la volonté de méditer. « Y a-t-il quelqu'un pour le méditer ? » — c'est une invitation, pas un reproche.`,
  reflection: `La facilité du Coran ne signifie pas la superficialité. C'est une profondeur accessible à tous ceux qui approchent avec sincérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le mot « yassarna » signifie facilité, accessibilité. Le Coran parle à chaque niveau de compréhension." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite le Coran ? Ou est-ce que je le lis mécaniquement ? Le miroir m'invite à ralentir, à réfléchir." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est facile — mais est-ce que je suis disponible ? La facilité du Texte rencontre parfois mon indisponibilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le seul texte qui « parle » à chaque époque, chaque culture, chaque niveau. Il est vivant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Méditer le Coran, c'est le laisser méditer sur moi. C'est un dialogue où le Texte me révèle à moi-même." }
  ],
  munajat: `Ya Allah, le Coran est facile et pourtant je le trouve parfois difficile. Ouvre mon cœur à sa méditation. Fais que je sois de ceux qui répondent à Ton invitation.`
};

// Surah 57 - Al-Hadid (29 verses)
MIROIR["57:1"] = {
  reference: "57:1",
  theme: ["présence", "sagesse", "méditation"],
  emotion: "Révérence, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Aziz", "Al-Hakim"],
  mirrorVersion: `« Tout ce qui est dans les cieux et sur terre glorifie Allah, et Il est le Puissant, le Sage. » Le miroir m'invite à écouter la louange silencieuse de l'univers. Chaque atome, chaque étoile, chaque créature proclame la grandeur d'Allah. Le miroir me demande : ma voix s'unit-elle à ce chœur cosmique ? Ou est-ce que je reste silencieux quand toute la création chante ?`,
  reflection: `La glorification (tasbih) est l'état naturel de toute chose. L'homme seul peut choisir de se taire — ou de se joindre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les cieux et la terre — tout l'univers — glorifie Allah sans exception." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je glorifie Allah ? Est-ce que je me joins à l'univers ou reste-je à l'écart ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange n'est pas pour Allah — Il n'en a pas besoin. Elle est pour nous, pour nous aligner sur notre nature profonde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers vibre de louange. Le silence apparent cache une symphonie continue de glorification." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend la louange de l'univers n'est jamais seul. Il fait partie d'un chœur infini." }
  ],
  munajat: `Ya Allah, fais que ma langue et mon cœur se joignent à la louange de l'univers. Que chaque souffle soit une glorification.`
};

MIROIR["57:2"] = {
  reference: "57:2",
  theme: ["confiance", "sagesse", "force"],
  emotion: "Sérénité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mulk", "Al-Qadir"],
  mirrorVersion: `« À Lui appartient la royauté des cieux et de la terre. Il fait vivre et mourir, et Il est capable de tout. » Le miroir me montre la souveraineté absolue d'Allah. Tout Lui appartient — y compris ma vie, ma mort, mes instants. Le miroir m'invite à relâcher ma prétention de contrôle. Je ne possède rien — je suis géré par le Possédant de tout.`,
  reflection: `La vie et la mort sont entre Ses mains. Cette vérité devrait libérer de la peur et de l'anxiété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La royauté (mulk) est à Allah seul. La vie et la mort sont Ses décrets." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crois « posséder » ? Ma vie ? Mes biens ? Tout est prêté, rien n'est possédé." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "S'Il fait vivre et mourir, alors chaque instant de ma vie est un don qu'Il choisit de prolonger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est Son royaume. Chaque loi physique, chaque cycle cosmique est Son décret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il ne possède rien ne craint rien perdre. Tout est don, tout est grâce." }
  ],
  munajat: `Ya Malik, Tu possèdes tout et je ne possède rien. Libère-moi de l'illusion du contrôle. Fais que je vive en gestionnaire reconnaissant, pas en propriétaire attaché.`
};

MIROIR["57:3"] = {
  reference: "57:3",
  theme: ["présence", "sagesse", "méditation"],
  emotion: "Contemplation, sécurité",
  difficulty: "avancé",
  relatedNames: ["Al-Awwal", "Al-Akhir", "Az-Zahir", "Al-Batin"],
  mirrorVersion: `« Il est le Premier et le Dernier, l'Apparent et le Caché. » Ce verset contient quatre noms divins qui embrassent toute la réalité. Le miroir me place devant une Présence qui est partout — avant le commencement, après la fin, visible dans la création, caché dans les cœurs. Il n'y a pas de lieu où Allah n'est pas. Je ne peux pas Le fuir, je ne peux pas Le perdre — je peux seulement ne pas Le voir.`,
  reflection: `Ces quatre noms forment un cercle parfait de présence divine. Où que je me tourne, je Le trouve — si je regarde avec les bons yeux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Quatre attributs : Premier (Awal), Dernier (Akhir), Apparent (Zahir), Caché (Batin). Deux temporalités, deux spatialités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans ma vie, où est-ce que je vois Allah ? Dans le visible ou dans le caché ? Dans le début ou dans la fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "S'Il est Premier et Dernier, alors je suis entre Ses deux mains. S'Il est Apparent et Caché, alors nul endroit n'est sans Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose manifeste un de ces attributs. Le soleil est apparent, le vent est caché. L'aube est premier, le crépuscule est dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise ces quatre noms ne se sent jamais seul, jamais perdu. Allah l'enveloppe de toutes parts." }
  ],
  munajat: `Ya Awwal, ya Akhir, ya Zahir, ya Batin, Tu es avant tout, après tout, visible en tout, caché en tout. Aide-moi à Te voir partout.`
};

MIROIR["57:4"] = {
  reference: "57:4",
  theme: ["présence", "sagesse", "confiance"],
  emotion: "Intimité, protection",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Alim"],
  mirrorVersion: `« C'est Lui qui a créé les cieux et la terre en six jours, puis S'est établi sur le Trône. Il sait ce qui pénètre en terre et ce qui en sort, ce qui descend du ciel et ce qui y monte. » Le miroir me montre un Dieu qui connaît chaque mouvement de l'univers — le grain qui pousse sous terre, la pluie qui tombe, l'âme qui s'élève. Rien ne Lui échappe. Le miroir me rassure : ma vie n'est pas perdue dans l'anonymat cosmique.`,
  reflection: `La connaissance divine est totale et intime. Chaque détail de l'existence est vu et connu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La création en six jours, l'établissement sur le Trône, la connaissance de tout mouvement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que chaque geste est vu ? Le miroir m'invite à la conscience constante." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas une surveillance intrusive — c'est une attention aimante. Il me connaît parce qu'Il m'aime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sous Son regard. Pas un atome ne bouge sans Sa connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise qu'il est constamment vu vit avec intégrité — même dans le secret." }
  ],
  munajat: `Ya 'Alim, Tu vois tout et Tu connais tout. Rien de ma vie ne T'est caché. Aide-moi à vivre en Ta présence avec sincérité.`
};

MIROIR["57:5"] = {
  reference: "57:5",
  theme: ["confiance", "force", "sagesse"],
  emotion: "Sécurité, abandon",
  difficulty: "débutant",
  relatedNames: ["Al-Mulk", "Al-Hukm"],
  mirrorVersion: `« À Lui appartient la royauté des cieux et de la terre, et vers Allah toute chose retourne. » Le miroir me montre la destination finale : tout retourne à Allah. Cette vérité simplifie ma vie. Si tout retourne à Lui, alors je ne devrais m'attacher qu'à Lui. Tout le reste est passager, provisoire, emprunté.`,
  reflection: `Le retour vers Allah est la trajectoire de toute existence. Anticiper ce retour change mes priorités.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La royauté et le retour — deux vérités qui orientent la vie du croyant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'accumule pour le retour ? Qu'est-ce que je prépare pour cette rencontre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour n'est pas une punition — c'est un accomplissement. C'est la maison après le voyage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en mouvement vers son Seigneur. Chaque chose suit sa trajectoire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui anticipe le retour prépare sa rencontre. Chaque acte devient une brique pour l'au-delà." }
  ],
  munajat: `Ya Allah, tout retourne à Toi. Fais que je prépare ce retour avec soin. Que ma vie soit un voyage vers Toi, pas un éloignement.`
};

MIROIR["57:6"] = {
  reference: "57:6",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Émerveillement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Alim"],
  mirrorVersion: `« Il fait pénétrer la nuit dans le jour et le jour dans la nuit. Et Il connaît le contenu des poitrines. » Le miroir me montre l'alternance jour-nuit comme signe de la puissance divine, et la connaissance des cœurs comme signe de Son intimité. L'univers obéit à Ses cycles, et les cœurs sont ouverts à Sa connaissance.`,
  reflection: `Les cycles cosmiques et les secrets du cœur — rien n'échappe à Allah. Il est le Maître du visible et de l'invisible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'alternance jour-nuit et la connaissance des cœurs — deux domaines, une même maîtrise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon cœur cache ? Qu'est-ce que je ne veux pas montrer ? Allah le sait." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mon cœur est transparent à Allah. Je ne peux me cacher — mais je n'ai pas à me cacher de Celui qui pardonne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour et la nuit alternent selon Son ordre. Mes humeurs alternent aussi — et Il les connaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'Allah connaît son cœur n'a pas besoin de le cacher. Il peut être vrai." }
  ],
  munajat: `Ya 'Alim, Tu connais mon cœur mieux que moi. Aide-moi à Te montrer ce que je cache, à Te confier ce que je porte. Purifie mon intérieur.`
};

MIROIR["57:7"] = {
  reference: "57:7",
  theme: ["confiance", "gratitude", "détachement"],
  emotion: "Reconnaissance, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Ar-Razzaq"],
  mirrorVersion: `« Croyez en Allah et en Son Messager, et dépensez de ce dont Il vous a fait héritiers. » Le miroir me montre un paradoxe : je dépense ce que j'ai reçu. Rien n'est vraiment « à moi » — tout est héritage, don, prêt. Le miroir m'invite à la générosité : je donne ce que j'ai reçu, je partage ce qui m'a été confié.`,
  reflection: `La dépense dans le chemin d'Allah n'est pas une perte — c'est un investissement dans l'éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La foi et la dépense — deux obligations liées. Croire implique donner." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai reçu ? Et qu'est-ce que je donne en retour ? Le miroir vérifie ma générosité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne donne pas de « mon » argent — je redistribue ce qui m'a été confié. Je suis gestionnaire, pas propriétaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier donne sans compter. Le soleil éclaire, la pluie arrose — tout est don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne ce qu'il a reçu participe à l'économie divine. Il devient canal de la générosité." }
  ],
  munajat: `Ya Razzaq, Tu m'as confié des biens. Fais que je les partage avec générosité. Je ne possède rien — je gère pour Toi.`
};

MIROIR["57:8"] = {
  reference: "57:8",
  theme: ["confiance", "prière", "force"],
  emotion: "Urgence, résolution",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wali"],
  mirrorVersion: `« Et qu'avez-vous à ne pas croire en Allah, alors que le Messager vous invite à croire en votre Seigneur ? » Le miroir me place devant une question directe : pourquoi hésiter ? L'invitation est claire, le Messager est venu, la vérité est manifeste. Le miroir m'interroge : qu'est-ce qui me retient ? La peur ? L'orgueil ? Les habitudes ?`,
  reflection: `L'invitation à la foi est ouverte. L'hésitation n'a pas de fondement rationnel — elle est résistance du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une question rhétorique : pourquoi ne pas croire quand l'invitation est si claire ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de croire pleinement ? Quel obstacle intérieur résiste encore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invitation n'est pas une contrainte — c'est une opportunité. Le refus est une perte pour moi, pas pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est la réponse naturelle de la créature au Créateur. L'incrédulité est une distorsion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'invitation découvre qu'elle était un don, pas une demande." }
  ],
  munajat: `Ya Haqq, Tu m'invites à croire et j'hésite. Brise les obstacles en moi. Fais que je réponde à Ton appel sans délai.`
};

MIROIR["57:9"] = {
  reference: "57:9",
  theme: ["guidance", "sagesse", "espoir"],
  emotion: "Gratitude, illumination",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« C'est Lui qui fait descendre sur Son serviteur des versets explicites pour vous faire sortir des ténèbres vers la lumière. » Le miroir me montre le mouvement fondamental : des ténèbres à la lumière. Le Coran est ce véhicule de transformation. Sans lui, je reste dans l'obscurité de l'ignorance, de l'égarement, de moi-même. Avec lui, je marche vers la lumière.`,
  reflection: `La Révélation est une miséricorde — un guide pour sortir de l'égarement vers la clarté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La descente des versets (ayat bayyinat) — signes clairs — pour le voyage des ténèbres à la lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles ténèbres dois-je encore quitter ? Où est-ce que le Coran m'invite à aller ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière n'est pas ajoutée de l'extérieur — elle est révélée à l'intérieur. Le Coran éveille la lumière déjà présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique traverse l'espace. La lumière divine traverse les cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme un guide de ténèbres à lumière est déjà en chemin." }
  ],
  munajat: `Ya Nur, fais descendre Ta lumière dans mon cœur. Sors-moi des ténèbres de l'ego vers la lumière de la guidance.`
};

MIROIR["57:10"] = {
  reference: "57:10",
  theme: ["force", "confiance", "détachement"],
  emotion: "Urgence, générosité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Alim"],
  mirrorVersion: `« Pourquoi ne dépensez-vous pas dans le chemin d'Allah, alors que c'est à Allah qu'appartient l'héritage des cieux et de la terre ? » Le miroir me montre l'absurdité de l'avarice. Tout retournera à Allah de toute façon — pourquoi ne pas donner maintenant et en recevoir la récompense ? Le miroir m'interroge : qu'est-ce que je garde qui ne m'appartiendra pas à la fin ?`,
  reflection: `L'héritage final revient à Allah. Donner maintenant, c'est investir avant que tout ne soit rendu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'héritage (warath) — tout finira par revenir à Allah. La question est : que donne-je avant ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse de donner ? Pourquoi ? Le miroir révèle mes attachements." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne peux pas garder ce qui ne m'appartient pas. Je peux seulement décider quand et comment le donner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier retourne à son Créateur. Je suis de passage — mes biens aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne avant l'héritage final reçoit la récompense. Celui qui garde jusqu'à la fin ne reçoit rien." }
  ],
  munajat: `Ya Warith, tout Te reviendra. Fais que je donne volontiers ce qui T'appartiendra de toute façon. Transforme mon avidité en générosité.`
};

MIROIR["57:11"] = {
  reference: "57:11",
  theme: ["confiance", "espoir", "gratitude"],
  emotion: "Espérance, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wahhab"],
  mirrorVersion: `« Qui est celui qui fait un beau prêt à Allah, pour qu'Il le lui multiplie et lui réserve une récompense généreuse ? » Le miroir me montre la beauté de l'échange divin. Je prête à Allah — et Il multiplie. Comment est-ce possible ? C'est que mon « prêt » est en fait un don qu'Allah me permet de Lui faire, pour qu'Il puisse me récompenser au-delà de toute mesure.`,
  reflection: `Le « prêt » à Allah est une métaphore de la générosité. Ce que je donne dans Son chemin revient multiplié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le « beau prêt » (qard hasan) — une métaphore pour la dépense dans le chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je peux « prêter » à Allah ? Du temps ? De l'argent ? Des efforts ? Le miroir m'invite à l'action." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de mon prêt — c'est moi qui ai besoin de Sa récompense. L'invitation est une faveur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne et reçoit. Le cycle de la générosité reflète la nature divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que le « prêt » est un privilège donne avec joie. Il ne perd rien — il investit." }
  ],
  munajat: `Ya Karim, Tu m'invites à Te « prêter » et Tu promets de multiplier. Prends de moi ce que je peux donner. Multiplie-le pour mon au-delà.`
};

MIROIR["57:12"] = {
  reference: "57:12",
  theme: ["espoir", "lumière", "force"],
  emotion: "Espérance, illumination",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Ghafur"],
  mirrorVersion: `« Le jour où tu verras les croyants et les croyantes, leur lumière courir devant eux et à leur droite... » Le miroir me montre une image de l'au-delà : la lumière des croyants qui les précède. Cette lumière est le fruit de leurs œuvres, de leur foi, de leurs dépenses. Le miroir m'interroge : quelle lumière suis-je en train de construire ?`,
  reflection: `La lumière du Jour dernier se construit aujourd'hui. Chaque bonne œuvre est une flamme ajoutée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La lumière (nur) qui court devant les croyants — une récompense visible, tangible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si mon lumière devait courir devant moi aujourd'hui, quelle serait son intensité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière n'est pas donnée — elle est construite. Chaque acte de foi ajoute une étincelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière dans le monde physique guide les pas. La lumière spirituelle guide l'âme vers le Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accumule de la lumière dans ce monde sera éclairé dans l'autre. L'obscurité est le résultat de l'inaction." }
  ],
  munajat: `Ya Nur, illumine mon chemin aujourd'hui pour que je sois illuminé demain. Fais que chaque acte soit une étincelle pour mon au-delà.`
};

MIROIR["57:13"] = {
  reference: "57:13",
  theme: ["espoir", "méditation", "force"],
  emotion: "Urgence, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Adl"],
  mirrorVersion: `« Le jour où les hypocrites diront aux croyants : Attendez-nous que nous empruntions votre lumière ! » Le miroir me place devant la tragédie des hypocrites : trop tard pour la lumière. Ils ont joué un double jeu, et maintenant ils réalisent leur erreur. Le miroir m'avertit : la sincérité n'est pas négociable. On ne peut pas tricher avec la foi.`,
  reflection: `L'hypocrisie est une illusion qui se dissout le Jour dernier. La lumière ne peut pas être empruntée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les hypocrites demandent de « emprunter » la lumière — mais la lumière ne se prête pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je joue un double jeu ? Où suis-je hypocrite ? Le miroir révèle mes contradictions." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière ne peut pas être transférée. Chacun construit la sienne — ou pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique peut être partagée. La lumière spirituelle est personnelle, intransférable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère maintenant n'aura pas à supplier demain. La sincérité est la meilleure préparation." }
  ],
  munajat: `Ya Fattah, préserve-moi de l'hypocrisie. Fais que ma foi soit pure, sans double jeu. Que je construise ma propre lumière maintenant.`
};

MIROIR["57:14"] = {
  reference: "57:14",
  theme: ["méditation", "force", "sagesse"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Hakim"],
  mirrorVersion: `« Ils vous appelleront : N'étions-nous pas avec vous ? » Le miroir me montre le dialogue des hypocrites avec les croyants. Ils prétendent avoir été « avec eux » — mais leur compagnie était superficielle. Le miroir m'interroge : suis-je vraiment « avec » les croyants ? Ou juste à côté d'eux en apparence ?`,
  reflection: `La compagnie des croyants ne suffit pas — il faut la foi sincère. L'appartenance extérieure sans l'intérieur est vide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les hypocrites revendiquent une appartenance qui ne les a pas sauvés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je revendique sans le vivre ? Mes titres, mes affiliations, mes apparences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Être avec » les croyants ne suffit pas. Il faut être croyant de l'intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connait pas l'hypocrisie. Chaque chose est ce qu'elle est. L'homme seul peut prétendre être ce qu'il n'est pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vrai n'a pas besoin de revendiquer. Sa vérité parle d'elle-même." }
  ],
  munajat: `Ya Khabir, Tu connais mon intérieur. Fais que l'extérieur et l'intérieur soient alignés. Que je sois ce que je prétends être.`
};

MIROIR["57:15"] = {
  reference: "57:15",
  theme: ["méditation", "espoir", "force"],
  emotion: "Gravité, urgence",
  difficulty: "avancé",
  relatedNames: ["Al-Ghafur", "Al-Hakim"],
  mirrorVersion: `« Aujourd'hui, aucune rançon ne sera acceptée de vous ni des mécréants. » Le miroir me place devant la finalité du Jour du Jugement. Il n'y a pas de transaction possible — ni argent, ni intercession, ni négociation. Ce qui a été fait est fait. Le miroir m'avertit : prépare-toi maintenant, quand la transaction est encore possible.`,
  reflection: `Le temps de l'action est maintenant. L'au-delà est le temps des comptes, pas des transactions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La rançon (fidya) — le rachat — n'est plus acceptée. La porte est fermée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je donnerais pour me racheter ? Mais la question est : qu'est-ce que je fais maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeture de la porte n'est pas cruelle — elle est juste. Le temps était donné. L'usage en était mon choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit des lois immuables. La mort aussi. Le Jugement aussi. On ne négocie pas avec l'inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque jour comme s'il était le dernier n'a pas besoin de rançon. Il a déjà réglé ses comptes." }
  ],
  munajat: `Ya Ghafur, je ne veux pas attendre que la porte se ferme. Je me repens maintenant. Accepte mon repentir tant que la transaction est possible.`
};

MIROIR["57:16"] = {
  reference: "57:16",
  theme: ["présence", "guérison", "force"],
  emotion: "Humilité, ouverture",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Wa'iz"],
  mirrorVersion: `« Le moment n'est-il pas venu pour ceux qui croient que leurs cœurs s'humilient à l'évocation d'Allah ? » Le miroir me pose une question intime : mon cœur s'humilie-t-il vraiment à l'évocation d'Allah ? Ou est-il endurci, distrait, occupé par autre chose ? Le verset me dit : le moment est venu. Pas demain — maintenant. Le cœur qui reste dur est un cœur qui s'éloigne.`,
  reflection: `L'humilité du cœur (khushu') est le signe de la foi vivante. Le cœur dur est le symptôme de l'oubli.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La question rhétorique : « Le moment n'est-il pas venu ? » L'urgence de l'humilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'évoque Allah, que se passe-t-il dans mon cœur ? Rien ? Un frémissement ? Une révolution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité n'est pas une posture — c'est un état. Le cœur s'humilie naturellement face à la Grandeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier s'humilie devant Allah. La montagne tremble, le ciel se plie. L'homme seul peut résister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur s'humilie maintenant n'aura pas à s'humilier de force demain. L'humilité volontaire précède l'humiliation imposée." }
  ],
  munajat: `Ya Allah, mon cœur est dur. Brise-le par Ton rappel. Fais que l'évocation de Ton nom suffise à l'humilier. Ramène-moi à la douceur.`
};

MIROIR["57:17"] = {
  reference: "57:17",
  theme: ["espoir", "guérison", "force"],
  emotion: "Espérance, renouveau",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« Sachez qu'Allah fait revivre la terre après sa mort. » Le miroir me montre la résurrection constante de la nature. La terre morte devient verte après la pluie. L'hiver stérile précède le printemps fertile. Cette loi cosmique s'applique aussi aux cœurs : le cœur mort peut revivre. Le miroir m'invite à l'espoir : même si mon cœur est mort, Allah peut le ressusciter.`,
  reflection: `La résurrection de la terre est une promesse pour les cœurs. Rien n'est définitivement mort avec Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La terre morte qui revit — une image de la résurrection, de la miséricorde, de l'espoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle partie de moi est « morte » ? Ma foi ? Mon enthousiasme ? Mon espérance ? Allah peut la ressusciter." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort du cœur n'est pas irréversible — tant que la vie continue. Le repentir est une résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature meurt et renaît sans cesse. L'automne précède l'hiver, qui précède le printemps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la résurrection de la terre croit à celle de son cœur. Chaque repentir est un printemps." }
  ],
  munajat: `Ya Muhyi, fais revivre mon cœur mort. Fais tomber la pluie de Ta miséricorde sur ma terre desséchée. Ramène-moi à la vie spirituelle.`
};

MIROIR["57:18"] = {
  reference: "57:18",
  theme: ["confiance", "espoir", "gratitude"],
  emotion: "Récompense, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Karim"],
  mirrorVersion: `« Ceux qui font des aumônes, hommes et femmes, et ceux qui font un beau prêt à Allah, Il le leur multipliera et ils auront une récompense généreuse. » Le miroir me montre la promesse divine : la multiplication. Ce que je donne n'est pas perdu — il est multiplié. Le compte est déséquilibré en ma faveur. Le miroir m'invite à la générosité : pourquoi craindre de perdre quand Allah promet de multiplier ?`,
  reflection: `L'aumône et le prêt à Allah sont des investissements à rendement garanti — divinement garanti.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La multiplication (yuda'if) — le retour multiple sur l'investissement spirituel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien ai-je « investi » auprès d'Allah ? Mon portefeuille spirituel est-il vide ou plein ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne peux pas perdre en donnant à Allah. Je ne peux que gagner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La semence donne cent grains. Le don à Allah donne des milliers de récompenses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'économie divine donne sans compter — car compter limiterait la récompense." }
  ],
  munajat: `Ya Karim, Tu promets de multiplier. Je Te fais confiance. Accepte mon aumône et mon prêt, et multiplie-les au-delà de ce que je mérite.`
};

MIROIR["57:19"] = {
  reference: "57:19",
  theme: ["confiance", "force", "espoir"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["As-Siddiq", "Ash-Shahid"],
  mirrorVersion: `« Ceux qui croient en Allah et en Ses messagers, ce sont les véridiques, et les martyrs auprès de leur Seigneur. » Le miroir me montre le statut des croyants sincères : véridiques (siddiqin) et témoins (shuhada). Ces titres ne sont pas pour une élite lointaine — ils sont promis à quiconque croit vraiment. Le miroir m'interroge : ma foi est-elle de cette qualité ?`,
  reflection: `La foi sincère élève le croyant au rang des véridiques et des témoins. Le statut découle de la qualité de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux rangs : siddiqin (véridiques) et shuhada (témoins/martyrs). La foi ouvre ces portes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je sur le chemin de la véracité ? Mon témoignage est-il authentique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces titres ne sont pas des récompenses passives — ils sont l'aboutissement d'une vie de vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la vérité divine. Le croyant s'ajoute à ce témoignage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique ici-bas sera compté parmi les véridiques là-bas. La cohérence paie." }
  ],
  munajat: `Ya Shahid, fais de moi un véridique et un témoin. Que ma foi soit authentique, que mon témoignage soit vrai. Place-moi parmi Tes rapprochés.`
};

MIROIR["57:20"] = {
  reference: "57:20",
  theme: ["détachement", "sagesse", "méditation"],
  emotion: "Lucidité, perspective",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khaliq"],
  mirrorVersion: `« Sachez que la vie présente n'est que jeu, divertissement, parade mutuelle, rivalité dans les biens et les enfants. » Le miroir me montre la vie d'ici-bas sans illusion : un jeu, une parade, une compétition. Tout cela est passager, vain. Le miroir m'invite à la sobriété : si la vie n'est que cela, pourquoi y investir tout mon cœur ? Le verset continue : « comme une pluie dont les plantes émerveillent les mécréants, puis elles sèchent. » La beauté passagère ne devrait pas aveugler.`,
  reflection: `La vie présente est séduisante mais illusoire. Sa beauté fane, sa promesse déçoit. L'au-delà seul reste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Cinq descriptions : jeu, divertissement, parade, rivalité en biens, rivalité en enfants. Toutes passagères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'imprègne de la vie d'ici-bas ? Les biens ? Le statut ? Les enfants ? Le miroir vérifie mes attachements." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté de la vie n'est pas fausse — elle est fugace. Profiter sans s'attacher est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lui-même passera. Seul Allah demeure. Pourquoi s'attacher à ce qui s'en va ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vie comme elle est — jeu et parade — ne s'y laisse pas piéger. Il joue le jeu sans être joué." }
  ],
  munajat: `Ya Hakim, la vie m'illusionne. Ouvre mes yeux sur sa réalité : jeu, parade, vanité. Détache mon cœur de ce qui passe pour l'attacher à Ce qui reste.`
};

MIROIR["57:21"] = {
  reference: "57:21",
  theme: ["espoir", "force", "confiance"],
  emotion: "Aspiration, course",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Wasi"],
  mirrorVersion: `« Hâtez-vous vers le pardon de votre Seigneur et vers un Paradis aussi vaste que le ciel et la terre. » Le miroir m'invite à la course — non pas la course aux biens de ce monde, mais la course vers le pardon et le Paradis. Le Paradis est « vaste » (wasi') — immense, illimité. Le miroir me demande : cours-je dans la bonne direction ? Vers les biens qui s'en vont ou vers le Paradis qui reste ?`,
  reflection: `La vie est une course. La question n'est pas de courir, mais vers quoi. Le Paradis est la seule destination digne d'une course.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'impératif « hâtez-vous » (sari'u) — l'urgence de la course vers le pardon et le Paradis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quoi cours-je ? Quel est mon objectif ultime ? Le miroir révèle ma direction." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas une récompense passive — c'est une destination active. On y accède en y courant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en mouvement. Chaque chose se dirige quelque part. Le croyant se dirige vers le Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui court vers le Paradis dans cette vie y entrera en courant dans l'autre. La vitesse d'ici devient la vitesse de là-bas." }
  ],
  munajat: `Ya Fattah, je veux courir vers Ton pardon et Ton Paradis. Dirige mes pas, accélère ma course. Que je T'atteigne avant que la vie ne m'atteigne.`
};

MIROIR["57:22"] = {
  reference: "57:22",
  theme: ["confiance", "patience", "force"],
  emotion: "Acceptation, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Alim"],
  mirrorVersion: `« Nul malheur n'atteint la terre ni vos personnes, qui ne soit inscrit dans un Livre avant que Nous le créions. » Le miroir me montre le décret divin déjà écrit. Rien n'est improvisé, rien n'est accidentel. Chaque épreuve était connue avant ma création. Le miroir m'invite à la confiance : ce qui arrive était prévu. Ma réaction, par contre, est mon choix.`,
  reflection: `Le destin est écrit. L'épreuve n'est pas une surprise pour Allah — elle est un rendez-vous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'inscription dans le Livre (kitab) — le décret divin précède l'existence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand l'épreuve arrive, est-ce que je l'accepte comme décret ou est-ce que je résiste à la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si l'épreuve était connue d'Allah avant ma naissance, elle a un sens. Mon rôle est de le découvrir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit un plan. Les étoiles, les saisons, les événements — tout obéit à un ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que tout est écrit ne panique pas. Il accepte et cherche le sens caché." }
  ],
  munajat: `Ya Qadir, tout est écrit par Toi. Aide-moi à accepter ce qui arrive et à réagir avec foi. Transforme mes épreuves en degrés.`
};

MIROIR["57:23"] = {
  reference: "57:23",
  theme: ["patience", "détachement", "sagesse"],
  emotion: "Équilibre, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "As-Sabur"],
  mirrorVersion: `« Afin que vous ne vous désespériez pas de ce qui vous a échappé ni ne vous réjouissiez de ce qui vous est échu. » Le miroir me montre l'équilibre émotionnel prescrit : ni désespoir du manque, ni exultation du gain. Tout est d'Allah — la perte comme le gain. Le miroir m'invite à l'impartialité : si je reçois avec gratitude et perds avec patience, je suis libre des oscillations de la fortune.`,
  reflection: `L'équilibre face aux aléas de la vie est le signe de la maturité spirituelle. Rien n'est vraiment « à moi » — tout est prêté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux interdits : ne pas désespérer du manque, ne pas exulter du gain. L'équilibre est la voie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je à la perte ? À la gain ? Suis-je stable ou instable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte et le gain sont deux faces de la même pièce — le décret divin. Accepter l'un sans l'autre est incomplet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers alterne jour et nuit, été et hiver. La stabilité n'est pas dans les conditions — elle est dans le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne s'attache ni au gain ni à la perte est libre. Il traverse les saisons sans être affecté." }
  ],
  munajat: `Ya Hakim, enseigne-moi l'équilibre. Que je ne désespère pas de ce qui part ni ne m'enorgueillisse de ce qui vient. Tout est Toi.`
};

MIROIR["57:24"] = {
  reference: "57:24",
  theme: ["détachement", "force", "sagesse"],
  emotion: "Liberté, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Hamid"],
  mirrorVersion: `« Ceux qui sont avares et ordonnent l'avarice aux autres... Allah Se suffit à Lui-même et Il est Digne de louange. » Le miroir me montre le contraste entre l'avare et Allah. L'avare a peur de manquer. Allah Se suffit à Lui-même. L'avare garde parce qu'il croit manquer. Allah donne parce qu'Il n'a pas besoin. Le miroir m'invite à ressembler à Allah, pas à l'avare : donner parce qu'on a reçu, être libre parce qu'Il suffit.`,
  reflection: `L'avarice vient de la peur de manquer. La générosité vient de la confiance en Celui qui suffit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'avare (bakhil) est opposé à Allah qui est Ghani (Riche) et Hamid (Louable)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon avarice ? De quoi ai-je peur de manquer ? Le miroir révèle mes insécurités." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a besoin de rien — donc je peux tout donner. Sa suffisance est ma sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne abondamment. Le soleil ne compte pas ses rayons. La terre ne mesure pas ses fruits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'Allah suffit n'est jamais avare. Il a trouvé la source inépuisable." }
  ],
  munajat: `Ya Ghani, Tu Te suffis et Tu es digne de louange. Délivre-moi de l'avarice. Fais que je donne comme Tu donnes, libre de la peur de manquer.`
};

MIROIR["57:25"] = {
  reference: "57:25",
  theme: ["force", "justice", "sagesse"],
  emotion: "Force, équilibre",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawi", "Al-'Adl"],
  mirrorVersion: `« Nous avons envoyé Nos messagers avec les preuves, et fait descendre avec eux le Livre et la balance, afin que les gens établissent la justice. Et Nous avons fait descendre le fer, dans lequel il y a une force terrible et des avantages pour les gens. » Le miroir me montre deux outils divins : la balance (la justice) et le fer (la force). L'un pour mesurer, l'autre pour protéger. Le croyant a besoin des deux : justice dans ses rapports, force dans sa défense.`,
  reflection: `La justice sans force est impuissante. La force sans justice est tyrannie. Les deux ensemble font la droiture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Livre, la balance, le fer — trois outils divins pour établir la justice et la protéger." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que j'utilise « la balance » dans ma vie ? Et « le fer » ? Justice et force sont-elles équilibrées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le fer n'est pas pour l'agression — il est pour la protection de la justice. La force sert le droit, pas l'inverse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses lois équilibrées. La gravité maintient l'ordre. Les forces nucléaires maintiennent la cohésion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la balance sans le fer est écrasé. Celui qui a le fer sans la balance est tyran. Les deux ensemble font le croyant complet." }
  ],
  munajat: `Ya 'Adl, Ya Qawi, donne-moi la justice de la balance et la force du fer. Que je sois juste et capable de protéger la justice.`
};

MIROIR["57:26"] = {
  reference: "57:26",
  theme: ["guidance", "confiance", "sagesse"],
  emotion: "Reconnaissance, continuité",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Nous avons envoyé Noé et Abraham, et établi la prophétie et la révélation dans leur descendance. » Le miroir me montre la chaîne de la guidance : de Noé à Abraham, puis à leurs descendants. La prophétie n'est pas un événement isolé — c'est un fleuve qui coule à travers l'histoire. Le miroir m'invite à la gratitude : je fais partie d'une chaîne de guidance qui remonte aux premiers prophètes.`,
  reflection: `La guidance est un héritage transmis. Chaque prophète a reçu et transmis. Je suis l'héritier de cette chaîne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La chaîne prophétique : Noé, Abraham, et leurs descendants. La continuité de la guidance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai hérité de cette chaîne ? Est-ce que je transmets à mon tour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne suis pas le début de la chaîne — je suis un maillon. Mon rôle est de recevoir et transmettre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine est tissée de guides envoyés. Chaque peuple a reçu un messager." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait héritier d'une chaîne millénaire ne prend pas sa foi à la légère. Il protège l'héritage." }
  ],
  munajat: `Ya Hadi, Tu as envoyé Tes prophètes et établi la guidance. Fais que je sois un héritier fidèle de cette chaîne. Que je transmette ce que j'ai reçu.`
};

MIROIR["57:27"] = {
  reference: "57:27",
  theme: ["méditation", "détachement", "prière"],
  emotion: "Devotion, modération",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Rahman", "Al-Muqtadir"],
  mirrorVersion: `« Puis Nous avons fait suivre leurs traces de Nos messagers, et Nous avons fait suivre Jésus, fils de Marie, et Nous lui avons donné l'Évangile, et mis dans les cœurs de ceux qui le suivirent douceur et pitié. Et le monachisme qu'ils inventèrent, Nous ne le leur avons pas prescrit. » Le miroir me montre l'équilibre : douceur et pitié sont de la foi, mais le monachisme extrême est une invention humaine. Le miroir m'invite à la modération : la dévotion sans l'excès, le détachement sans la fuite du monde.`,
  reflection: `La foi authentique est douce et compatissante. L'excès de rigueur inventé par les hommes n'est pas de Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La douceur (ra'fa) et la pitié (rahma) sont divines. Le monachisme (rahbaniyya) est une invention." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je doux et compatissant ? Ou rigoureux et dur ? Le miroir vérifie mon cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah prescrit la douceur, pas la rigidité. Le monachisme extrême n'est pas la voie prophétique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature est équilibrée. Ni laxiste ni rigide. La foi aussi devrait l'être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve l'équilibre entre dévotion et vie quotidienne a trouvé la voie médiane." }
  ],
  munajat: `Ya Rahman, enseigne-moi la douceur et la pitié. Préserve-moi de l'excès et de la rigidité. Que ma foi soit équilibrée comme Tu le veux.`
};

MIROIR["57:28"] = {
  reference: "57:28",
  theme: ["confiance", "espoir", "pardon"],
  emotion: "Espérance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Ô vous qui croyez ! Craignez Allah et croyez en Son Messager, Il vous donnera une double part de Sa miséricorde. » Le miroir me montre la promesse d'une « double part » (kiflayn) de miséricorde. La crainte (taqwa) et la foi (iman) ouvrent cette porte. Le miroir m'invite à l'action : craindre et croire — et recevoir doublement. La miséricorde d'Allah n'est pas mesurée — elle est généreuse pour ceux qui s'en approchent.`,
  reflection: `La crainte et la foi ne sont pas opposées — elles sont complémentaires. Ensemble, elles ouvrent les trésors divins.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La double part de miséricorde — une promesse généreuse pour les croyants sincères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah ? Est-ce que je crois vraiment ? Ces deux conditions sont-elles remplies ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La double part n'est pas un bonus — c'est la norme pour ceux qui s'approchent correctement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers regorge de miséricorde. Le croyant y a accès par la taqwa et l'iman." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la double part sur terre en recevra encore plus dans l'au-delà. La miséricorde s'étend." }
  ],
  munajat: `Ya Ghafur, je crains et je crois. Donne-moi ma double part de miséricorde. Éclaire mon chemin et protège ma marche.`
};

MIROIR["57:29"] = {
  reference: "57:29",
  theme: ["sagesse", "confiance", "force"],
  emotion: "Clarté, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fadl", "Al-Hakim"],
  mirrorVersion: `« Afin que les gens du Livre sachent qu'ils ne peuvent rien disposer de la grâce d'Allah, et que la grâce est dans la main d'Allah, Il la donne à qui Il veut. » Le miroir me montre la souveraineté d'Allah sur Sa propre grâce (fadl). Personne ne peut prétendre à un droit sur Allah — ni les gens du Livre, ni personne. La grâce est don, pas dû. Le miroir m'invite à l'humilité : ce que j'ai reçu n'est pas un droit — c'est une faveur.`,
  reflection: `La grâce divine n'est pas monnaie d'échange. Elle est don pur. On ne peut ni la forcer ni l'accaparer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La grâce (fadl) est dans la main d'Allah. Il la donne à qui Il veut — souveraineté absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère ce que j'ai comme un dû ou comme une grâce ? Le miroir vérifie mon attitude." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne peux pas revendiquer la grâce — je peux seulement l'espérer et la recevoir avec gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de grâces non méritées. La vie, la conscience, la beauté — tout est don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que la grâce est un don ne s'enorgueillit pas de l'avoir. Il remercie de l'avoir reçue." }
  ],
  munajat: `Ya Dhu al-fadl, Ta grâce est un don, pas un dû. Je Te remercie pour ce que j'ai reçu. Donne-moi d'être reconnaissant, pas revendicateur.`
};

// Surah 59 - Al-Hashr (24 verses)
MIROIR["59:1"] = {
  reference: "59:1",
  theme: ["force", "méditation", "confiance"],
  emotion: "Révérence, puissance",
  difficulty: "débutant",
  relatedNames: ["Al-Aziz", "Al-Hakim"],
  mirrorVersion: `« Tout ce qui est dans les cieux et sur terre glorifie Allah. C'est Lui le Puissant, le Sage. » Le miroir m'invite à joindre ma voix à la louange universelle. Chaque créature, chaque atome glorifie Allah. Le miroir me demande : ma glorification est-elle consciente ? Est-ce que je joins le chœur cosmique avec intention ?`,
  reflection: `La glorification de l'univers est continue et spontanée. La mienne devrait l'être aussi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les cieux et la terre glorifient — une louange universelle, continue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment glorifié-je Allah ? Avec conscience ? Avec constance ? Le miroir vérifie ma pratique." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange n'est pas pour Allah — Il est au-dessus du besoin. Elle est pour nous, pour nous aligner sur notre nature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers vibre de louange. Le silence apparent cache une symphonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie constamment ne se sent jamais seul. Il fait partie de l'orchestre cosmique." }
  ],
  munajat: `Ya Aziz, Ya Hakim, tout Te glorifie et je veux Te glorifier. Fais que ma louange soit consciente et constante. Unis ma voix au chœur de l'univers.`
};

MIROIR["59:2"] = {
  reference: "59:2",
  theme: ["force", "méditation", "sagesse"],
  emotion: "Gratitude, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahir", "Al-Khaliq"],
  mirrorVersion: `« C'est Lui qui a fait sortir des leurs foyers ceux des gens du Livre qui avaient mécru, lors du premier exil. » Le miroir me montre l'action de Allah dans l'histoire : l'exil des Juifs de Médine pour leur trahison. Cette expulsion n'est pas une punition arbitraire mais une conséquence de leurs actes. Le miroir m'invite à comprendre que les événements historiques ont un sens spirituel.`,
  reflection: `L'histoire est sous le contrôle d'Allah. Les événements ne sont pas aléatoires — ils sont des conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'exil des gens du Livre — un événement historique avec un sens spirituel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que l'histoire m'enseigne ? Les conséquences des actes sont réelles." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les événements défavorables ne sont pas sans raison. Ils ont un sens caché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire suit des lois comme l'univers. Les conséquences sont intégrées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit l'histoire avec les yeux de la foi y voit la main d'Allah." }
  ],
  munajat: `Ya Qahir, Tu es Maître de l'histoire. Aide-moi à comprendre les événements comme Tu les comprends. Fais que je voie Ta main dans tout.`
};

MIROIR["59:3"] = {
  reference: "59:3",
  theme: ["force", "confiance", "sagesse"],
  emotion: "Lucidité, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Latif", "Al-Wali"],
  mirrorVersion: `« Si Allah ne leur avait pas prescrit l'exil, Il les aurait certainement châtiés dans ce monde. » Le miroir me montre la miséricorde dans le châtiment : l'exil est une correction, pas une destruction. Allah aurait pu les anéantir, mais Il a choisi la voie de l'exil. Le miroir m'invite à voir la miséricorde même dans les épreuves.`,
  reflection: `L'exil peut être une miséricorde déguisée. Le châtiment pourrait être pire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'exil au lieu du châtiment — une miséricorde dans la correction." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes épreuves sont-elles des miséricordes déguisées ? Le pire a-t-il été évité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble punition peut être protection. La perspective change tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers corrige sans détruire. La tempête nettoie, elle ne dévaste pas toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la miséricorde dans l'épreuve trouve la paix dans tout." }
  ],
  munajat: `Ya Latif, Ta miséricorde se cache même dans les corrections. Aide-moi à voir le bien dans mes épreuves. Remercie pour ce qui a été évité.`
};

MIROIR["59:4"] = {
  reference: "59:4",
  theme: ["méditation", "force", "confiance"],
  emotion: "Gravité, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hasib", "Al-Dayyan"],
  mirrorVersion: `« Il en est ainsi parce qu'ils se sont opposés à Allah et à Son Messager. » Le miroir me montre le lien entre cause et effet : l'opposition à Allah et Son Messager entraîne des conséquences. Ce n'est pas arbitraire — c'est structurel. Le miroir m'invite à examiner mes oppositions : contre quoi est-ce que je me positionne ?`,
  reflection: `L'opposition à la vérité a des conséquences inévitables. La cause précède l'effet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'opposition (muhadat) comme cause de l'épreuve. Le lien est clair." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quoi m'opposé-je ? Mes difficultés sont-elles liées à mes oppositions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si l'opposition crée des difficultés, l'alignement crée la facilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers réagit à l'opposition. La résistance crée la friction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cesse de s'opposer à la vérité trouve la fluidité." }
  ],
  munajat: `Ya Hasib, enregistre mes actes mais ne me laisse pas m'opposer à Toi. Aide-moi à m'aligner sur Ta vérité. Évite-moi les conséquences de l'opposition.`
};

MIROIR["59:5"] = {
  reference: "59:5",
  theme: ["sagesse", "force", "confiance"],
  emotion: "Soumission, compréhension",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Hakim"],
  mirrorVersion: `« Tout ce que vous avez coupé de palmiers ou laissé debout sur leurs racines, c'est avec la permission d'Allah. » Le miroir me montre que même les actes de guerre sont sous la permission divine. Couper ou laisser — tout est selon le décret d'Allah. Le miroir m'invite à la conscience : mes actes, même anodins, sont sous Son regard.`,
  reflection: `Rien n'arrive sans la permission d'Allah. Même les actions humaines sont encadrées par Sa volonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les palmiers coupés ou laissés — tout avec la permission d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes actes sont-ils faits avec la conscience de Sa permission ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission divine n'excuse pas tout — elle encadre tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers n'arrive sans Sa permission. Tout est décret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit avec la conscience de Sa permission agit avec responsabilité." }
  ],
  munajat: `Ya Qadir, rien n'arrive sans Ta permission. Fais que je sois conscient de Ta présence dans chaque acte. Guide mes gestes.`
};

MIROIR["59:6"] = {
  reference: "59:6",
  theme: ["confiance", "détachement", "gratitude"],
  emotion: "Reconnaissance, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Warith", "Al-Wahhab"],
  mirrorVersion: `« Le butin qu'Allah a accordé à Son Messager, vous n'avez eu à y fournir ni chevaux ni chameaux. » Le miroir me montre le don sans effort : le butin est venu sans combat physique. C'est un don d'Allah, pas une conquête humaine. Le miroir m'invite à reconnaître les dons non mérités dans ma vie.`,
  reflection: `Certains dons viennent sans effort. Ils sont pure grâce, pas récompense du labeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le butin sans combat — un don pur, sans effort humain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai reçu sans l'avoir mérité ? Le miroir révèle les grâces non gagnées." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don sans effort n'est pas une invitation à la paresse — c'est un rappel de la source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne abondamment. Le soleil n'est pas mérité, la pluie n'est pas gagnée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le don sans effort devient humble et reconnaissant." }
  ],
  munajat: `Ya Wahhab, Tu donnes sans que je mérite. Je reconnais Tes grâces non gagnées. Fais que je ne m'enorgueillisse pas de ce que je n'ai pas conquis.`
};

MIROIR["59:7"] = {
  reference: "59:7",
  theme: ["sagesse", "justice", "confiance"],
  emotion: "Ordre, équité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Adl"],
  mirrorVersion: `« Le butin appartient à Allah et à Son Messager, ainsi qu'aux proches, aux orphelins, aux pauvres et au voyageur. » Le miroir me montre la distribution équitable du butin : pas de monopolisation, mais un partage structuré. La richesse ne doit pas circuler seulement entre les riches. Le miroir m'invite à examiner ma propre distribution : à qui vais-je ?`,
  reflection: `La richesse a des droits. Elle ne doit pas être accaparée par quelques-uns.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La distribution du butin : Allah, Messager, proches, orphelins, pauvres, voyageurs. Personne n'est oublié." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma richesse est-elle partagée équitablement ? À qui vais-je ? Qui est oublié ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse n'est pas pour l'enrichissement personnel — elle est pour la circulation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers circule. L'eau, l'air, l'énergie — tout bouge. La stagnation est mortelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage selon le modèle divin participe à l'économie céleste." }
  ],
  munajat: `Ya Hakim, enseigne-moi à partager équitablement. Que ma richesse ne stagne pas mais circule vers ceux qui en ont besoin.`
};

MIROIR["59:8"] = {
  reference: "59:8",
  theme: ["gratitude", "confiance", "méditation"],
  emotion: "Reconnaissance, solidarité",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muhajir"],
  mirrorVersion: `« Aux pauvres parmi les émigrés qui ont été expulsés de leurs foyers et privés de leurs biens. » Le miroir me montre les sacrifices des premiers musulmans : quitter leurs foyers, leurs biens, pour la foi. Cette pauvreté était un choix de dignité. Le miroir m'invite à la reconnaissance : qu'ai-je sacrifié pour ma foi ?`,
  reflection: `Le sacrifice matériel pour la foi est honoré par Allah. Les émigrés ont tout quitté pour tout gagner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les émigrés pauvres — sacrifiés de leurs foyers et biens pour la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai sacrifié pour ma foi ? Rien ? Quelque chose ? Tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice matériel n'est pas une perte — c'est un investissement spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La graine doit être enterrée pour germer. Le sacrifice précède la croissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sacrifie pour Allah reçoit au-delà de ce qu'il a donné." }
  ],
  munajat: `Ya Razzaq, les émigrés ont tout quitté pour Toi. Fais que je sois prêt à sacrifier pour ma foi. Remplace ce que je donne par ce que Tu donnes.`
};

MIROIR["59:9"] = {
  reference: "59:9",
  theme: ["amour", "générosité", "confiance"],
  emotion: "Solidarité, préférence",
  difficulty: "avancé",
  relatedNames: ["Al-Wadud", "Al-Karim"],
  mirrorVersion: `« Et à ceux qui ont adopté le Foyer et la foi avant eux, ils aiment ceux qui ont émigré vers eux et ne ressentent en leurs cœurs aucune envie. » Le miroir me montre le sommet de la générosité : les Ansar aimaient donner aux émigrés, même s'ils en avaient besoin eux-mêmes. Ils « se préféraient » (yuthiruna) aux autres. Le miroir m'interroge : suis-je capable de me préférer les autres à moi-même ?`,
  reflection: `La préférence pour autrui même dans le besoin est le sommet de la générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La préférence (ithar) — donner même quand on a besoin. Le sommet de la générosité." },
    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Quand je donne, est-ce que je me prive ? Ou est-ce que je donne de l'excédent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se priver pour autrui n'est pas une perte — c'est un gain spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne même quand elle semble vide. Le désert fleurit par la grâce." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se préfère les autres reçoit d'Allah plus que ce qu'il a donné." }
  ],
  munajat: `Ya Wadud, enseigne-moi le ithar. Fais que je me préfère les autres à moi-même. Donne-moi un cœur qui donne même quand il manque.`
};

MIROIR["59:10"] = {
  reference: "59:10",
  theme: ["pardon", "confiance", "prière"],
  emotion: "Humilité, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Et ceux qui sont venus après eux disent : Seigneur, pardonne-nous ainsi qu'à nos frères qui nous ont précédés dans la foi. » Le miroir me montre la prière des générations suivantes : demander le pardon pour eux ET pour ceux qui les ont précédés. Cette solidarité dans la prière transcende le temps. Le miroir m'invite à prier pour ceux qui m'ont précédé.`,
  reflection: `La prière pour les autres, y compris les défunts, est une forme de solidarité spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La prière pour soi et pour les prédécesseurs — une solidarité temporelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui est-ce que je prie ? Seulement pour moi ? Ou pour ceux qui m'ont précédé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Prier pour les autres, c'est prier pour soi. Le cercle de la prière s'élargit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est lié dans l'univers. Prier pour les autres, c'est participer à l'unité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour les autres reçoit la réponse pour lui-même." }
  ],
  munajat: `Ya Ghafur, pardonne-moi et pardonne à ceux qui m'ont précédé dans la foi. Unis-nous dans Ton pardon. Fais que je prie pour les autres comme pour moi.`
};

MIROIR["59:11"] = {
  reference: "59:11",
  theme: ["méditation", "force", "sagesse"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Hakim"],
  mirrorVersion: `« N'as-tu pas vu les hypocrites dire à leurs frères mécréants parmi les gens du Livre : Si vous êtes expulsés, nous partirons avec vous ? » Le miroir me montre l'alliance des hypocrites avec les mécréants. Ils promettent ce qu'ils ne tiendront pas. Le miroir m'avertit : mes promesses sont-elles sincères ou sont-elles des mots en l'air ?`,
  reflection: `Les promesses non tenues révèlent l'hypocrisie. La parole engage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La promesse des hypocrites — des mots sans intention de les tenir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je promis que je ne tiendrai pas ? Mes paroles sont-elles alignées sur mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse non tenue est un mensonge déguisé. La parole doit être acte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tient ses promesses. Le soleil se lève, les saisons reviennent. L'homme seul peut mentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient ses promesses, même difficiles, construit une âme solide." }
  ],
  munajat: `Ya Khabir, Tu connais mes promesses. Aide-moi à les tenir. Fais que ma parole soit acte, pas seulement son.`
};

MIROIR["59:12"] = {
  reference: "59:12",
  theme: ["méditation", "force", "sagesse"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Muhit"],
  mirrorVersion: `« S'ils sont expulsés, ils ne partiront pas avec eux. Et s'ils sont attaqués, ils ne les aideront pas. » Le miroir me montre la réalité derrière les promesses : l'aide promise ne viendra pas. Les mots étaient des leurres. Le miroir m'avertit : sur qui puis-je vraiment compter ? Sur les promesses humaines ou sur Allah ?`,
  reflection: `Les promesses humaines peuvent faillir. Seule la promesse d'Allah est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La non-assistance promise — la vérité derrière les belles paroles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui m'a promis et ne m'a pas aidé ? Sur qui puis-je vraiment compter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La déception humaine conduit à la confiance en Allah. L'échec des hommes est la leçon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah ne faillit pas. Tout le reste peut décevoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui place sa confiance en Allah n'est jamais déçu." }
  ],
  munajat: `Ya Muhit, les hommes promettent et faillent. Toi seul Tiens Tes promesses. Je place ma confiance en Toi, pas dans les paroles humaines.`
};

MIROIR["59:13"] = {
  reference: "59:13",
  theme: ["force", "confiance", "méditation"],
  emotion: "Courage, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aziz", "Al-Qawi"],
  mirrorVersion: `« Vous les terrorisez plus qu'Allah. C'est qu'ils sont des gens qui ne comprennent pas. » Le miroir me montre l'inversion des valeurs : les hypocrites craignent les hommes plus qu'Allah. Cette peur est le signe de l'incompréhension. Le miroir m'interroge : qui ou quoi crains-je le plus ?`,
  reflection: `La crainte des créatures plutôt que du Créateur révèle un cœur malade.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La peur des hommes vs la peur d'Allah — l'inversion des valeurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains le plus ? Les hommes ? Les conséquences ? Ou Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si je crains Allah, je ne crains rien d'autre. Sa crainte dissout toutes les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne craint que son Créateur. L'homme seul craint les créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah vraiment est libre de toutes les autres peurs." }
  ],
  munajat: `Ya Qawi, Tu es plus redoutable que tout ce que je crains. Fais que ma crainte soit pour Toi seul. Libère-moi de la peur des hommes.`
};

MIROIR["59:14"] = {
  reference: "59:14",
  theme: ["force", "confiance", "sagesse"],
  emotion: "Lucidité, stratégie",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Nasir"],
  mirrorVersion: `« Ils ne vous combattront que dans des villes fortifiées ou de derrière des murs. » Le miroir me montre la lâcheté des hypocrites : ils n'attaquent que de positions sûres. Le courage leur manque. Le miroir m'avertit : moi aussi, suis-je courageux seulement quand je suis protégé ?`,
  reflection: `Le vrai courage se montre dans la vulnérabilité. La sécurité permet la bravade.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le combat derrière les murs — la bravade des sécurisés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je courageux seulement quand je suis en sécurité ? Ou puis-je l'être dans la vulnérabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai courage n'a pas besoin de murs. Il s'expose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ouvert. Les créatures bravent le danger pour survivre. L'homme seul cache sa peur derrière des murs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ose sans protection发现 qu'il n'en avait pas besoin — Allah suffisait." }
  ],
  munajat: `Ya Nasir, donne-moi le vrai courage. Pas celui des murs, mais celui de l'exposition. Fais que je compte sur Toi, pas sur mes protections.`
};

MIROIR["59:15"] = {
  reference: "59:15",
  theme: ["méditation", "force", "sagesse"],
  emotion: "Avertissement, histoire",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muhit"],
  mirrorVersion: `« Comme ceux qui ont goûté les conséquences de leurs actes peu de temps avant eux. » Le miroir me montre l'histoire comme enseignement : ceux qui ont précédé ont subi les conséquences. Le même sort attend les hypocrites. Le miroir m'invite à apprendre de l'histoire plutôt qu'à la répéter.`,
  reflection: `L'histoire enseigne ceux qui veulent apprendre. Les erreurs passées devraient prévenir les erreurs futures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'exemple des précédents — l'histoire comme enseignement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je appris de l'histoire ? Quelles erreurs évité grâce aux exemples passés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Répéter l'histoire est le signe de l'inintelligence. Apprendre est le signe de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers évolue par cycles. Ce qui a été sera, à moins qu'on ne change." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui étudie les conséquences des autres évite de les subir lui-même." }
  ],
  munajat: `Ya Qadir, l'histoire est mon enseignante. Fais que j'apprenne des autres plutôt que d'apprendre par mes propres erreurs.`
};

MIROIR["59:16"] = {
  reference: "59:16",
  theme: ["méditation", "force", "confiance"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khannas", "Al-Wali"],
  mirrorVersion: `« Comme le diable quand il dit à l'homme : Mécréis ! Puis quand il a mécru, il dit : Je te désavoue. » Le miroir me montre la traîtrise du diable : il pousse au péché puis se retire. Il n'est pas un allié mais un manipulateur. Le miroir m'avertit : qui me pousse au mal ? Et qu'arrivera-t-il après ?`,
  reflection: `Le diable pousse au mal puis abandonne. La séduction précède la trahison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le diable pousse puis se retire — la stratégie de la manipulation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui me pousse au mal ? Qu'est-ce qui me séduit pour m'abandonner ensuite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le diable n'a aucun pouvoir réel — seulement la suggestion. Je peux résister." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal est toujours temporaire. La tromperie s'effondre sur elle-même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la fin de la tentation avant d'y céder ne cède pas." }
  ],
  munajat: `Ya Wali, le diable me tente puis m'abandonne. Protège-moi de ses ruses. Fais que je voie la fin de chaque tentation avant d'y céder.`
};

MIROIR["59:17"] = {
  reference: "59:17",
  theme: ["méditation", "force", "confiance"],
  emotion: "Gravité, conséquence",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Khuld"],
  mirrorVersion: `« La fin de tous deux sera le Feu éternel. Telle est la récompense des injustes. » Le miroir me montre le sort final : le Feu éternel pour le diable et ses suivants. Cette fin est certaine pour ceux qui choisissent l'injustice. Le miroir m'avertit : ma fin dépend de mes choix présents.`,
  reflection: `La destination finale est déterminée par les choix d'ici-bas. L'injustice mène au Feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Feu éternel — la conséquence finale de l'injustice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma destination ? Mon présent détermine mon futur éternel." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Feu n'est pas la volonté d'Allah pour moi — c'est le résultat de mes choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des conséquences intégrées. Le mal consume celui qui le fait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur le Feu comme conséquence évite les actes qui y mènent." }
  ],
  munajat: `Ya Allah, le Feu est la conséquence de l'injustice. Préserve-moi de l'injustice et de sa fin. Guide-moi vers le Paradis.`
};

MIROIR["59:18"] = {
  reference: "59:18",
  theme: ["méditation", "force", "confiance"],
  emotion: "Vigilance, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Dayyan"],
  mirrorVersion: `« Ô vous qui croyez ! Craignez Allah et que chaque âme considère ce qu'elle a préparé pour demain. » Le miroir me donne une méthode : l'audit quotidien. Qu'ai-je préparé pour demain — le Jour Dernier ? Ce questionnement constant est la clé de la préparation. Le miroir m'invite à cet audit maintenant.`,
  reflection: `L'audit quotidien est la pratique du croyant conscient. Chaque jour, vérifier le compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'ordre de la crainte et de l'examen — la pratique du croyant conscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je préparé aujourd'hui pour demain ? Mon compte est-il créditeur ou débiteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demain n'est pas garanti — mais le Jour Dernier l'est. Préparer ce qui est certain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accumule. Chaque action laisse une trace. Rien n'est perdu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait cet audit chaque jour n'a pas peur du grand audit final." }
  ],
  munajat: `Ya Hasib, je fais mon audit aujourd'hui. Qu'ai-je préparé pour demain ? Augmente mon crédit et efface mon débit. Prépare-moi pour le Jour certain.`
};

MIROIR["59:19"] = {
  reference: "59:19",
  theme: ["méditation", "force", "confiance"],
  emotion: "Mise en garde, urgence",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikr", "Al-Ghafur"],
  mirrorVersion: `« Et ne soyez pas comme ceux qui ont oublié Allah, alors Il leur a fait oublier leurs propres âmes. » Le miroir me montre le processus terrible de l'oubli : oublier Allah conduit à s'oublier soi-même. L'âme est perdue quand son Créateur est oublié. Le miroir m'avertit : mon oubli d'Allah est un oubli de moi-même.`,
  reflection: `L'oubli d'Allah est auto-destructeur. Se perdre dans le monde, c'est se perdre tout court.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'oubli d'Allah = l'oubli de soi. Le processus de l'autodestruction." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je m'oublie ? En oubliant Allah ? Le miroir révèle le lien." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se souvenir d'Allah, c'est se souvenir de soi. Le dhikr est la clé de l'identité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers ne s'oublie soi-même. Chaque chose est ce qu'elle est. L'homme seul peut s'oublier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient d'Allah constamment ne perd jamais son âme." }
  ],
  munajat: `Ya Dhikr, je T'oublie et je m'oublie. Ramène-moi à Toi et à moi-même. Par Ton rappel, fais que je me retrouve.`
};

MIROIR["59:20"] = {
  reference: "59:20",
  theme: ["méditation", "espoir", "force"],
  emotion: "Contraste, choix",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "An-Nar"],
  mirrorVersion: `« Ne sont pas égaux les gens du Feu et les gens du Paradis. » Le miroir me place devant l'alternative ultime : Feu ou Paradis. Ces deux destinations ne sont pas comparables. Le choix ici-bas détermine la destination là-bas. Le miroir m'interroge : pour quelle destination travaille-je ?`,
  reflection: `Feu et Paradis ne sont pas équivalents. Le choix n'est pas anodin — il est déterminant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'inégalité fondamentale : gens du Feu vs gens du Paradis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour laquelle de ces deux catégories travaille-je ? Mon orientation détermine ma destination." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix n'est pas fait à la fin — il est fait chaque jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a deux directions : expansion ou contraction. L'âme aussi : Paradis ou Feu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que le choix est maintenant fait le bon choix." }
  ],
  munajat: `Ya Rabb al-Jannah, je choisis le Paradis. Dirige-moi vers lui. Éloigne-moi du Feu. Mon choix est fait — aide-moi à le vivre.`
};

MIROIR["59:21"] = {
  reference: "59:21",
  theme: ["présence", "force", "méditation"],
  emotion: "Révérence, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« Si Nous avions fait descendre ce Coran sur une montagne, tu l'aurais vu s'humilier et se fendre par crainte d'Allah. » Ce verset me montre la puissance du Coran. Une montagne — symbole de solidité et de force — s'humilierait et se fendrait devant ce Livre. Le miroir me demande : et moi ? Comment est-ce que je réagis au Coran ? Suis-je plus dur qu'une montagne ? Ou est-ce que je laisse Ses paroles me transformer ?`,
  reflection: `La montagne est physiquement solide mais spirituellement sensible. L'humain est souvent l'inverse : physiquement fragile mais spirituellement endurci.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une image saisissante : la montagne qui s'humilie et se fend. Le Coran a un poids qui dépasse la matière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entends le Coran, qu'est-ce qui se passe en moi ? Une montagne se fendrait — et moi ? Je continue comme si de rien n'était ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité de la montagne devrait être la mienne. Si la pierre craint Allah, comment puis-je ne pas Le craindre ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création reconnaît la Parole divine. L'homme seul peut l'entendre sans être transformé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Coran est une lumière qui fend les cœurs endurcis. Ceux qui ne sont pas fendus sont plus durs que les montagnes." }
  ],
  munajat: `Ya Allah, ne me laisse pas devenir plus dur que la montagne. Fends mon cœur avec Ton Livre. Fais que Sa parole me transforme vraiment.`
};

MIROIR["59:22"] = {
  reference: "59:22",
  theme: ["présence", "méditation", "sagesse"],
  emotion: "Contemplation, révérence",
  difficulty: "débutant",
  relatedNames: ["Allah", "Ar-Rahman", "Ar-Rahim"],
  mirrorVersion: `« C'est Lui Allah, nulle divinité autre que Lui, le Connaisseur de l'invisible et du visible. » Le miroir me place devant les noms divins fondamentaux : Allah, le Connaisseur. Pas de dieu autre que Lui — l'unicité absolue. Et Il connaît tout : le caché et le manifeste. Le miroir m'invite à vivre dans cette conscience : Allah est Un, et Il sait tout de moi.`,
  reflection: `L'unicité et la connaissance — deux attributs fondamentaux. Un Dieu, une connaissance totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois noms : Allah, 'Alim al-ghayb wa-sh-shahada. L'unicité et l'omniscience." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vis-je en sachant qu'Il connaît mon caché et mon manifeste ? Rien ne Lui est secret." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sa connaissance n'est pas intrusion — c'est intimité. Il me connaît mieux que je me connais." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ouvert à Son regard. Rien n'est caché, tout est connu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit sous le regard de l'Omniscient vit avec intégrité et transparence." }
  ],
  munajat: `Ya Allah, Tu connais mon caché et mon manifeste. Aide-moi à vivre en Ta présence. Rien ne Te cache — alors que je sois transparent devant Toi.`
};

MIROIR["59:23"] = {
  reference: "59:23",
  theme: ["présence", "méditation", "force"],
  emotion: "Adoration, paix",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malik", "Al-Quddus", "As-Salam", "Al-Mu'min", "Al-Muhaymin", "Al-Aziz", "Al-Jabbar", "Al-Mutakabbir"],
  mirrorVersion: `« C'est Lui Allah, le Roi, le Saint, la Paix, le Gardien de la foi, le Dominateur, le Puissant, le Suprême. » Le miroir me place devant huit noms divins qui décrivent Sa souveraineté, Sa sainteté, Sa paix, Sa protection, Sa domination, Sa puissance, Sa grandeur. Chaque nom est une méditation. Le miroir m'invite à Le connaître par Ses noms.`,
  reflection: `Les noms d'Allah sont des portes vers Sa connaissance. Chacun révèle un aspect de Sa majesté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Huit noms : Malik, Quddus, Salam, Mu'min, Muhaymin, Aziz, Jabbar, Mutakabbir. La majesté divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Lequel de ces noms me touche le plus ? Par quel aspect d'Allah suis-je le plus connecté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces noms ne sont pas des titres vides — ils sont des réalités vivantes. Allah EST ces attributs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reflète ces noms : la royauté dans l'ordre, la sainteté dans la pureté, la paix dans l'harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah par Ses noms L'aime selon Sa réalité, pas selon son imagination." }
  ],
  munajat: `Ya Malik, Ya Quddus, Ya Salam, Tu es le Roi, le Saint, la Paix. Fais que je Te connaisse par Tes noms. Enseigne-moi Ta majesté.`
};

MIROIR["59:24"] = {
  reference: "59:24",
  theme: ["présence", "méditation", "gratitude"],
  emotion: "Adoration, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari", "Al-Musawwir", "Al-Asma' al-Husna"],
  mirrorVersion: `« C'est Lui Allah, le Créateur, Celui qui donne l'existence, le Formateur. À Lui les plus beaux noms. » Le miroir me montre les noms de création : Khaliq (Créateur), Bari' (Celui qui fait exister), Musawwir (Formateur). Puis la conclusion : à Lui les plus beaux noms. Tout ce qui est beau dans les noms Lui appartient. Le miroir m'invite à L'adorer avec tous les beaux noms.`,
  reflection: `Allah est Créateur, Inventeur, Formateur. Et tous les beaux noms Lui appartiennent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois noms de création + « les plus beaux noms ». La totalité de la beauté nominale." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que j'adore Allah ? Avec quels noms ? Les plus beaux sont à Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Toute beauté nominale vient de Lui. Les beaux noms humains sont des reflets des Siens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé, formé, inventé. Chaque forme porte la signature du Formateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui L'adore avec les beaux noms entre dans la beauté même." }
  ],
  munajat: `Ya Khaliq, Ya Bari', Ya Musawwir, Tu es le Créateur de toute chose. À Toi les plus beaux noms. Je T'adore avec tous les noms que Tu as révélés. Gloire à Toi.`
};

// Surah 63 - Al-Munafiqun
MIROIR["63:9"] = {
  reference: "63:9",
  theme: ["détachement", "méditation", "confiance"],
  emotion: "Vigilance, priorisation",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Fattah"],
  mirrorVersion: `« Ô vous qui croyez ! Que ni vos biens ni vos enfants ne vous distrait du rappel d'Allah. » Ce verset me met en garde contre la distraction (lahw) la plus courante : les biens et les enfants. Le miroir me montre que ce que je considère comme « bénédiction » peut devenir « obstacle » s'il me détourne d'Allah. Le problème n'est pas la possession — c'est la distraction. Puis-je avoir des biens sans être distrait ?`,
  reflection: `Les biens et les enfants sont des tests, pas des buts. Ils sont des moyens de se rapprocher d'Allah — ou de s'en éloigner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le mot « tulhikum » vient de la racine qui signifie distraire, faire oublier. L'enjeu est l'attention, pas la possession." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me « distrait » d'Allah ? Mon travail ? Mes projets ? Mes relations ? Le miroir m'aide à identifier mes idoles modernes." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les biens et les enfants peuvent aussi me rapprocher d'Allah — si je les vois comme des dons à gérer, pas des maîtres à servir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose est un test dans ce monde. Ce qui est bénédiction pour l'un peut être malédiction pour l'autre, selon l'usage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui possède sans être possédé a trouvé la liberté. Ses biens sont dans ses mains, pas dans son cœur." }
  ],
  munajat: `Ya Allah, j'ai des biens et des responsabilités qui m'occupent. Fais qu'ils ne m'éloignent pas de Toi. Aide-moi à Te rappeler au milieu de mes occupations.`
};

// Surah 73 - Al-Muzzammil
MIROIR["73:8"] = {
  reference: "73:8",
  theme: ["prière", "présence", "méditation"],
  emotion: "Dévotion, focalisation",
  difficulty: "avancé",
  relatedNames: ["Ath-Thikr", "Al-Qarib"],
  mirrorVersion: `« Et rappelle-toi du nom de ton Seigneur et consacre-toi entièrement à Lui. » Ce verset m'invite à une relation exclusive. « Consacre-toi entièrement » (tabattal) signifie couper les liens avec tout sauf Allah. Le miroir me montre que ma spiritualité est souvent partagée : je suis avec Allah ET avec le monde. L'invitation ici est à être entièrement avec Lui, même brièvement.`,
  reflection: `Le tabattul (dévotion exclusive) est l'état du cœur qui ne regarde qu'Allah. C'est un trésor caché accessible à tous, même brièvement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tabattal » vient de « batta » (couper). C'est couper toute attache autre qu'Allah — pendant le dhikr, la prière, la méditation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pendant mes moments de prière, suis-je vraiment « entièrement » à Allah ? Ou une partie de moi est-elle ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas moi qui me consacre à Lui — c'est Lui qui m'attire. La consécration est une réponse à Son appel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne à Allah. Le croyant anticipe ce retour en se consacrant à Lui dès maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur est entièrement tourné vers Allah, même un instant, cet instant a la valeur de l'éternité." }
  ],
  munajat: `Ya Allah, je veux me consacrer entièrement à Toi. Mais mon cœur est partagé. Coupe ce qui m'attache ailleurs. Donne-moi des moments de pureté.`
};

// Surah 87 - Al-A'la
MIROIR["87:14"] = {
  reference: "87:14",
  theme: ["guérison", "présence", "prière"],
  emotion: "Succès, gratitude",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Bienheureux celui qui se purifie, qui prononce le nom de son Seigneur et prie. » Ce verset condense le chemin spirituel en trois étapes : purification (tazkiyah), rappel (dhikr), prière (salah). Le miroir me montre une progression logique : d'abord je me purifie des souillures, puis je me tourne vers Allah par le dhikr, puis je stabilise cette relation par la prière.`,
  reflection: `La purification est la base. Sans elle, le dhikr est superficiel et la prière mécanique. Le cœur propre accueille la présence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois verbes : se purifier, prononcer, prier. Un programme spirituel complet en trois mots." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est l'état de mon cœur maintenant ? Est-il purifié ? Le miroir m'invite à l'examen avant l'action." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification n'est pas un effort — c'est un don qui vient quand je me tourne vers Allah avec sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose cherche la pureté. L'eau se purifie en s'écoulant. L'air se purifie par le vent. L'âme se purifie par le dhikr." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bienheureux (aflaha) est celui qui a réussi le voyage de retour vers la pureté originelle." }
  ],
  munajat: `Ya Tawwab, purifie mon cœur. Fais que je prononce Ton nom avec présence. Et que ma prière soit le couronnement de ma purification.`
};

// Surah 93 - Ad-Duha
MIROIR["93:3"] = {
  reference: "93:3",
  theme: ["espoir", "amour", "confiance"],
  emotion: "Réconfort, assurance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wadud"],
  mirrorVersion: `« Ton Seigneur ne t'a ni abandonné ni détesté. » Ce verset a été révélé quand le Prophète n'avait pas reçu de révélation pendant un temps, et pensait qu'Allah l'avait abandonné. Le miroir me montre mes propres moments d'abandon apparent — quand je prie et que rien ne vient, quand j'attends et que rien ne change. Le verset me dit : « Il ne t'a pas abandonné. » Mon sentiment d'abandon est une illusion.`,
  reflection: `Le silence de Dieu n'est pas Son absence. La pause dans la guidance n'est pas un rejet. Allah aime même dans le silence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux négations : « pas abandonné » et « pas détesté ». Allah rassure doublement Son Prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je me sens « abandonné » par Allah ? Et si ce sentiment était une illusion ? Le miroir m'invite à la confiance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est peut-être dans le silence que l'amour d'Allah est le plus profond. Il me laisse grandir, chercher, désirer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit précède l'aube. Le silence précède la parole. L'absence apparente précède la présence plus forte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il n'est pas abandonné peut traverser n'importe quel silence. La confiance remplace la peur." }
  ],
  munajat: `Ya Wadud, parfois je me sens abandonné. Mais Tu dis que Tu ne m'abandonnes pas. Je choisis de Te croire, même quand je ne ressens rien.`
};

// Surah 103 - Al-'Asr
MIROIR["103:1"] = {
  reference: "103:1",
  theme: ["méditation", "confiance", "force"],
  emotion: "Urgence, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-'Asr", "Al-Haqq"],
  mirrorVersion: `« Par le Temps ! L'humanité est certes en perdition, sauf ceux qui croient, accomplissent les bonnes œuvres, s'enjoignent mutuellement la vérité et s'enjoignent mutuellement la patience. » Cette sourate est la plus courte mais l'une des plus complètes. Le miroir me place devant l'urgence du temps. Je suis en perdition (khusr) — perte — sauf si je fais quatre choses : croire, agir, conseiller la vérité, conseiller la patience.`,
  reflection: `Le temps (asr) est la ressource la plus précieuse et la plus gaspillée. Chaque instant non investi dans le bien est une perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Quatre conditions pour échapper à la perdition : iman (foi), amal salih (bonnes actions), tawasi bil-haqq (conseil mutuel de vérité), tawasi bis-sabr (conseil mutuel de patience)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je dépense mon temps ? Est-ce en perte ou en investissement ? Le miroir m'invite à l'audit temporel." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perdition est l'état par défaut. Le salut exige un effort actif et continu. Personne n'est sauvé automatiquement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est la dimension où se joue le destin. L'éternité se décide dans le temporel. L'infini dans le fini." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ceux qui remplissent ces quatre conditions transforment le temps en éternité. Chaque instant devient éternel par sa qualité." }
  ],
  munajat: `Ya Allah, je suis en perdition sans Toi. Fais que je croie, que j'agisse, que je conseille la vérité et la patience. Sauve-moi de la perte du temps.`
};

// Surah 108 - Al-Kawthar
MIROIR["108:1"] = {
  reference: "108:1",
  theme: ["gratitude", "prière", "espoir"],
  emotion: "Reconnaissance, plénitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Karim"],
  mirrorVersion: `« Nous t'avons certes accordé l'Abondance. » Ce verset promet à Muhammad le Kawthar — l'abondance. Le miroir me montre qu'Allah donne sans compter. Le mot « Kawthar » suggère une rivière au Paradis, mais aussi toute forme de bien abondant. Ce que j'ai reçu — la vie, la foi, la capacité d'aimer — est une forme de Kawthar. Ma reconnaissance devrait être à la mesure de ce don.`,
  reflection: `L'abondance divine n'est pas seulement matérielle. Le plus grand Kawthar est la proximité d'Allah et la capacité de L'invoquer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une courte sourate mais dense. Le Kawthar est un don spécifique au Prophète, mais le principe s'applique à tous les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon « abondance » ? Qu'est-ce que j'ai reçu en quantité généreuse ? Et comment est-ce que je le reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abondance n'est pas une accumulation — c'est une grâce. Je ne l'ai pas méritée, je l'ai reçue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers déborde de générosité divine. Chaque soleil, chaque goutte d'eau, chaque souffle est un cadeau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'abondance reçoit plus. La gratitude est la clé qui ouvre les portes du don." }
  ],
  munajat: `Ya Wahhab, Tu m'as donné l'abondance que je ne mérite pas. Aide-moi à la reconnaître, à l'utiliser pour Toi, et à ne jamais l'oublier.`
};

// Surah 110 - An-Nasr
MIROIR["110:1"] = {
  reference: "110:1",
  theme: ["guidance", "gratitude", "espoir"],
  emotion: "Accomplissement, humilité",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Fattah"],
  mirrorVersion: `« Lorsque vient le secours d'Allah ainsi que la victoire. » Cette sourate annonce la victoire finale de l'Islam. Le miroir me montre que toute victoire vient d'Allah. Quand je réussis, ce n'est pas mon mérite — c'est Son secours (nasr). La bonne réaction à la victoire n'est pas l'orgueil mais la reconnaissance : « tu verras les gens entrer en masse dans la religion d'Allah, alors glorifie par les louanges ton Seigneur et implore Son pardon. »`,
  reflection: `La victoire appelle à l'humilité, pas à l'arrogance. Plus le succès est grand, plus la prosternation devrait être profonde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La dernière sourate révélée chronologiquement. Elle annonce la fin proche du Prophète et l'accomplissement de sa mission." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je réussis, quelle est ma réaction ? Célébration personnelle ou reconnaissance divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire n'est pas la fin — elle est le début de la gratitude et de la préparation au retour vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute victoire dans l'histoire est un don d'Allah. Les empires s'effondrent et les causes justes triomphent par Sa permission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que la victoire vient d'Allah ne s'enorgueillit jamais. Il reste prosterné, même au sommet." }
  ],
  munajat: `Ya Nasir, Tu accordes la victoire à qui Tu veux. Si Tu me donnes le succès, fais que je ne m'enorgueillisse pas. Garde-moi prosterné devant Toi.`
};

// Surah 114 - An-Nas
MIROIR["114:1"] = {
  reference: "114:1",
  theme: ["guérison", "confiance", "présence"],
  emotion: "Protection, refuge",
  difficulty: "débutant",
  relatedNames: ["Rab an-Nas", "Malik an-Nas", "Ilah an-Nas"],
  mirrorVersion: `« Dis : Je cherche refuge auprès du Seigneur des humains, le Souverain des humains, le Dieu des humains. » Ce verset ouvre la dernière sourate du Coran. Le miroir me place devant trois attributs divins liés à l'humanité : Seigneur (Celui qui nourrit), Souverain (Celui qui gouverne), Dieu (Celui qui est adoré). Je cherche refuge en Lui contre le mal qui vient du cœur des autres — l'envie, la jalousie, le mal occulte.`,
  reflection: `La protection divine couvre tout : visible et invisible. Le « refuge » (isti'adha) est une prise de conscience que seule Sa protection est fiable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois fois « an-nas » (les humains). La relation Allah-humanité est au cœur de cette sourate." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quoi ai-je besoin de protection ? Les maladies occultes (hasad, 'ayn, sihr) sont réelles. Le miroir m'invite à me réfugier." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mal vient parfois de ceux qu'on aime. La protection d'Allah est nécessaire même — surtout — de la part des proches." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité a besoin de protection contre elle-même. Les humains peuvent être la plus grande bénédiction ou le plus grand danger." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie vraiment en Allah n'a peur de rien d'autre. Sa protection est un bouclier contre tout mal visible et invisible." }
  ],
  munajat: `Ya Rabb an-nas, ya Malik an-nas, ya Ilah an-nas, je cherche refuge en Toi contre tout mal qui vient des cœurs. Protège-moi, visible et invisible.`
};

// Surah 37 - As-Saffat
MIROIR["37:83"] = {
  reference: "37:83",
  theme: ["confiance", "détachement", "sagesse"],
  emotion: "Émerveillement, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Hadi"],
  mirrorVersion: `« Certes, Abraham était de son rang un guide parfait. » Le miroir me place devant le modèle d'Ibrahim — l'ami d'Allah. Sa soumission n'était pas aveugle mais lucide : il a compris que tout appartient à Allah, même son fils. Le miroir me demande : quelle est la chose que je n'arrive pas à remettre à Allah ? Ibrahim a été testé avec ce qu'il aimait le plus. Et sa réponse a été la confiance totale.`,
  reflection: `La soumission (islam) d'Ibrahim est le modèle de toute foi. Il n'a pas renoncé par désespoir mais par confiance absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ibrahim est appelé « umma » — une nation à lui seul. Son rang est unique parmi les prophètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aime au point de ne pas pouvoir l'abandonner pour Allah ? Le miroir révèle mes attachements." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah ne demande pas l'abandon pour nuire — Il demande l'abandon pour libérer. Ibrahim a retrouvé son fils et gagné l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La soumission à Allah est la liberté suprême. L'oiseau qui se rend au vent vole mieux que celui qui résiste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne tout à Allah reçoit tout d'Allah. La perte apparente est le gain réel." }
  ],
  munajat: `Ya Wali, donne-moi la confiance d'Ibrahim. Aide-moi à Te remettre ce que j'aime, sachant que Tu es le meilleur des gardiens.`
};

// Surah 38 - Sad
MIROIR["38:26"] = {
  reference: "38:26",
  theme: ["sagesse", "guidance", "confiance"],
  emotion: "Responsabilité, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Adl"],
  mirrorVersion: `« Ô David, Nous avons fait de toi un calife sur terre. Juge donc entre les gens avec vérité. » Le miroir me montre que toute position de responsabilité est un dépôt divin. Dawud a reçu la royauté ET la prophétie — deux charges lourdes. Le miroir m'interroge : comment est-ce que je gère les responsabilités qu'Allah m'a confiées ? Avec justice ou avec favoritisme ? Avec vérité ou avec compromis ?`,
  reflection: `Le pouvoir est un test, pas un privilège. Chaque responsabilité sera questionnée le Jour du Jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Dawud reçoit le califat — la succession de la gestion terrestre. Avec elle vient l'ordre de juger avec vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles responsabilités ai-je ? Parent, travailleur, voisin ? Comment est-ce que je les remplis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pouvoir n'est pas un honneur — c'est une charge. Le Prophète a dit qu'on sera questionné sur chaque responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a une responsabilité. L'ange a sa fonction, l'animal son instinct, l'homme son libre arbitre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai califat est celui du cœur — gouverner son ego avec vérité avant de gouverner les autres." }
  ],
  munajat: `Ya Hakam, Tu m'as confié des responsabilités. Aide-moi à les remplir avec justice et vérité. Ne me laisse pas trahir le dépôt.`
};

// Surah 43 - Az-Zukhruf
MIROIR["43:36"] = {
  reference: "43:36",
  theme: ["guidance", "détachement", "présence"],
  emotion: "Vigilance, lucidité",
  difficulty: "avancé",
  relatedNames: ["Al-Hadi", "Al-Mudhill"],
  mirrorVersion: `« Quant à celui qui se détourne du rappel du Tout-Miséricordieux, Nous lui assignons un diable qui devient son compagnon inséparable. » Le miroir me montre le danger du détourment. L'oubli d'Allah n'est pas neutre — il crée un vide que quelque chose d'autre remplit. Si je ne remplit mon cœur de dhikr, les shayatin s'y installent. Le miroir m'interroge : qu'est-ce qui accompagne mes journées ? La présence d'Allah ou les murmures de l'ego ?`,
  reflection: `Le cœur ne reste jamais vide. Soit il est habité par la présence divine, soit par les suggestions obscures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le « détournement » (a'rada) du dhikr a une conséquence : un qarin (compagnon) démoniaque." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui « m'accompagne » ? Quelles pensées reviennent sans cesse ? Sont-elles de lumière ou d'ombre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui se tourne vers Allah reçoit aussi un compagnon — mais un compagnon de lumière, un ange." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est habité. Les espaces ne sont pas vides. Le cœur encore moins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compagnie que je garde détermine qui je deviens. Le dhikr est la meilleure des fréquentations." }
  ],
  munajat: `Ya Hadi, ne me laisse pas me détourner de Ton rappel. Remplace les compagnons d'ombre par Ta lumière présente.`
};

// Surah 44 - Ad-Dukhan
MIROIR["44:38"] = {
  reference: "44:38",
  theme: ["méditation", "sagesse", "présence"],
  emotion: "Émerveillement, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Nous n'avons créé les cieux et la terre et ce qui est entre eux qu'en toute vérité et pour un terme fixé. » Le miroir me place devant la majesté de la création. L'univers n'est pas un jeu — il a un sens (haqq) et une fin (ajal). Le miroir m'invite à contempler : si l'univers entier a été créé avec tant de précision, quelle est ma place dans ce dessein ?`,
  reflection: `La création n'est pas futile. Chaque atome témoigne d'un Créateur intentionnel et d'un but précis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les cieux et la terre créés « bi-l-haqq » — en vérité/justice. Rien n'est superflu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vie aussi a été créée en vérité. Quel est mon « haqq » ? Ma raison d'être ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le terme fixé (ajal) n'est pas une menace — c'est une délimitation. La fin donne sens au trajet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier obéit à des lois précises. L'homme seul peut choisir de s'y soumettre ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que sa vie a un but et une fin vit chaque instant comme précieux." }
  ],
  munajat: `Ya Khaliq, Tu as créé toute chose avec sagesse. Révèle-moi ma place dans Ton dessein. Aide-moi à vivre avec vérité.`
};

// Surah 45 - Al-Jathiya
MIROIR["45:23"] = {
  reference: "45:23",
  theme: ["guidance", "détachement", "sagesse"],
  emotion: "Mise en garde, lucidité",
  difficulty: "avancé",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« Vois-tu celui qui prend sa passion pour divinité ? Allah l'égue sciemment. » Le miroir me montre un danger terrifiant : l'adoration de soi-même. Quand je suis mes désirs aveuglément, je transforme mon ego en dieu. Et Allah « scelle » ce choix — pas par injustice, mais par respect de mon libre arbitre. Le miroir m'interroge : quelles passions dirigent ma vie ?`,
  reflection: `L'idolâtrie moderne n'est pas les statues de pierre — c'est l'adoration du moi, de la passion, du plaisir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Prendre sa passion pour dieu : l'adoration du désir personnel au lieu du Créateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « sers » vraiment ? Mon confort ? Mon image ? Mon plaisir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement d'Allah est une réponse à l'égarement de l'homme. Il ne force personne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature suit sa nature donnée par Allah. L'homme seul peut choisir de suivre sa passion contre sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie liberté n'est pas suivre ses désirs — c'est les maîtriser pour servir le Vrai." }
  ],
  munajat: `Ya Hadi, protège-moi de l'adoration de moi-même. Guide mes passions vers ce qui Te plaît, pas vers ce qui m'égare.`
};

// Surah 46 - Al-Ahqaf
MIROIR["46:13"] = {
  reference: "46:13",
  theme: ["confiance", "force", "espérance"],
  emotion: "Assurance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Muhaymin"],
  mirrorVersion: `« Ceux qui disent : 'Notre Seigneur est Allah' puis se tiennent droit, nullement ils ne subiront de crainte ni ne s'affligeront. » Le miroir me montre la promesse d'Allah : dire « notre Seigneur est Allah » ET s'y tenir. La sincérité suivie de la constance. La récompense ? La disparition de la crainte et de la tristesse — les deux fléaux du cœur.`,
  reflection: `La crainte et la tristesse dominent le cœur humain. La relation avec Allah les dissout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux conditions : la parole sincère (qalu) et la droiture (istaqamu). Deux résultats : pas de crainte, pas de tristesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains ? Qu'est-ce qui m'attriste ? Et si la source était mon éloignement d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix n'est pas l'absence de problèmes — c'est la présence d'Allah dans les problèmes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers est en paix avec son Créateur. Seul l'homme peut s'en séparer et souffrir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La droiture (istiqama) n'est pas la perfection — c'est la direction constante vers Allah malgré les chutes." }
  ],
  munajat: `Ya Wali, je dis que Tu es mon Seigneur. Aide-moi à m'y tenir. Dissous ma crainte et ma tristesse dans Ta présence.`
};

// Surah 48 - Al-Fath
MIROIR["48:4"] = {
  reference: "48:4",
  theme: ["force", "confiance", "paix"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "As-Sakinah"],
  mirrorVersion: `« C'est Lui qui a fait descendre la quiétude dans les cœurs des croyants. » Le miroir me montre la sakinah — cette paix qui descend du ciel vers le cœur. Elle ne se fabrique pas, elle se reçoit. Elle vient quand Allah voit que le cœur est prêt à l'accueillir. Le miroir m'invite à me demander : mon cœur est-il prêt à recevoir cette sérénité ?`,
  reflection: `La sakinah est mentionnée plusieurs fois dans le Coran. Elle accompagne les moments de tension — comme un baume divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La sakinah descend (anzala) — elle vient d'en haut, elle n'est pas humaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand ai-je ressenti cette paix surnaturelle ? Dans quelles circonstances Allah l'a-t-Il envoyée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La quiétude précède la victoire. Les croyants ont reçu la sakinah AVANT la conquête de La Mecque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier vibre de cette sérénité. Les étoiles ne s'affolent pas. La nature ne panique pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sakinah est la présence d'Allah ressentie. Quand elle descend, le cœur sait qu'il est chez lui." }
  ],
  munajat: `Ya Allah, fais descendre Ta sakinah dans mon cœur. Calme les tempêtes intérieures. Donne-moi la paix qui vient de Toi.`
};

// Surah 52 - At-Tur
MIROIR["52:21"] = {
  reference: "52:21",
  theme: ["amour", "espoir", "gratitude"],
  emotion: "Réconfort, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Jami"],
  mirrorVersion: `« Et ceux qui ont cru et que leurs descendants ont suivis dans la foi, Nous ferons rejoindre leurs descendants. » Le miroir me montre la générosité d'Allah envers les familles croyantes. La foi d'un parent peut bénéficier à ses enfants. Allah ne sépare pas les croyants de ceux qu'ils aiment — Il les rassemble. Le miroir m'invite à prier pour ma famille, car ma foi peut les atteindre.`,
  reflection: `La foi est un héritage. Le croyant n'est pas sauvé seul — il peut devenir une source de salut pour les siens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Allah « joindra » les descendants aux parents croyants — une grâce supplémentaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui dans ma famille a besoin de ma foi ? Mes prières peuvent-ils les atteindre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les enfants suivent les parents — mais les parents aussi peuvent suivre la foi de leurs enfants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les liens familiaux sont sacrés. L'au-delà les préserve et les amplifie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Paradis n'est pas solitaire. On y retrouve ceux qu'on aime — et on y aime ceux qu'on n'avait jamais aimés." }
  ],
  munajat: `Ya Wadud, je Te confie ma famille. Fais que ma foi soit une source de bénédiction pour eux. Rassemble-nous dans Ta miséricorde.`
};

// Surah 56 - Al-Waqi'a
MIROIR["56:88"] = {
  reference: "56:88",
  theme: ["espoir", "confiance", "gratitude"],
  emotion: "Espérance, aspiration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qarib", "Ar-Rahim"],
  mirrorVersion: `« S'il est du nombre des rapprochés, alors il aura repos, parfum et Jardin de délices. » Le miroir me montre les trois catégories du Jour dernier : les rapprochés (muqarrabun), les gens de la droite, les gens de la gauche. Mon aspiration devrait être la première catégorie — ceux qui sont si proches d'Allah qu'Il les a rapprochés de Lui. Le miroir m'interroge : ma vie me rapproche-t-Elle d'Allah ou m'en éloigne-t-elle ?`,
  reflection: `Les muqarrabun sont les plus proches d'Allah — les prophètes, les véridiques, les martyrs, les saints.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois catégories, trois destins. Les rapprochés ont la meilleure part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je en ce moment ? Sur quel chemin marche-t-je ? Vers Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rapprochement n'est pas une distance physique — c'est une qualité de cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'existence tend vers Allah. Certains y résistent, d'autres s'y précipitent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est rapproché d'Allah ici-bas l'est dans l'au-delà. La proximité se cultive maintenant." }
  ],
  munajat: `Ya Rabb, fais de moi un des rapprochés. Rapproche-moi de Toi dans cette vie pour que je sois proche de Toi dans l'autre.`
};

// Surah 58 - Al-Mujadila (22 verses)
MIROIR["58:1"] = {
  reference: "58:1",
  theme: ["prière", "confiance", "espoir"],
  emotion: "Espoir, supplication",
  difficulty: "débutant",
  relatedNames: ["As-Sami", "Al-Mujib"],
  mirrorVersion: `« Allah a bien entendu la parole de celle qui discutait avec toi à propos de son époux et se plaignait auprès d'Allah. » Le miroir me montre une femme qui ose porter sa plainte directement à Allah — et Allah entend. Cette femme n'était pas prophète, pas leader, mais une personne ordinaire avec un problème concret. Et Allah a écouté. Le miroir m'invite à porter mes propres plaintes à Allah : Il entend, même les plus humbles.`,
  reflection: `Allah entend la voix de chacun — homme ou femme, puissant ou faible. Sa miséricorde s'étend à toutes les situations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une femme se plaint à Allah, et Allah révèle un verset pour elle. Son cas est pris au sérieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je porte en moi que je n'ai pas encore confié à Allah ? Il entend, même ce que je ne dis pas." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'est pas un juge distant — Il est un Auditeur proche. Ma plainte Lui importe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier prie à sa manière. Chaque créature exprime son besoin. L'homme a le privilège de la parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui confie sa plainte à Allah est déjà soulagé. Le partage avec le Créateur guérit le cœur." }
  ],
  munajat: `Ya Sami', Tu as entendu cette femme et Tu m'entends. J'élève mes plaintes vers Toi. Prends en charge ce qui me pèse.`
};

MIROIR["58:2"] = {
  reference: "58:2",
  theme: ["sagesse", "pardon", "confiance"],
  emotion: "Lucidité, repentir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Ghaffur"],
  mirrorVersion: `« Ceux d'entre vous qui répudient leurs femmes en disant : Tu es pour moi comme le dos de ma mère... » Le miroir me montre une pratique préislamique injuste : l'homme qui compare sa femme au dos de sa mère pour la repousser sans divorce formel. Le Coran condamne cette pratique et établit l'expiation. Le miroir m'invite à examiner mes propres « formules » qui permettent d'éviter mes responsabilités.`,
  reflection: `Les mots ont des conséquences. On ne peut pas prononcer des formules qui libèrent de nos devoirs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le zihar — une pratique préislamique d'oppression. Le Coran la condamne et impose une expiation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels mots est-ce que j'utilise pour éviter mes responsabilités ? Quelles « formules » me dédouanent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole engage. On ne peut pas dire n'importe quoi et espérer ne pas en payer le prix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mots créent des réalités. L'univers a été créé par la Parole divine. Nos mots créent aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pèse ses mots protège son cœur. La parole est un dépôt — il faut la préserver." }
  ],
  munajat: `Ya Hakim, purifie ma parole. Fais que je ne prononce pas de mots qui libèrent de mes devoirs. Enseigne-moi la responsabilité du langage.`
};

MIROIR["58:3"] = {
  reference: "58:3",
  theme: ["pardon", "guérison", "confiance"],
  emotion: "Réparation, expiation",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Ceux qui répudient leurs femmes puis reviennent sur ce qu'ils ont dit devront affranchir un esclave... » Le miroir me montre la structure de l'expiation (kaffara) : libérer un esclave, ou jeûner, ou nourrir les pauvres. Le mal commis exige une réparation. Le miroir m'invite à la réparation active : quand je fais mal, comment est-ce que je répare ?`,
  reflection: `L'expiation n'est pas une punition — c'est une réparation. Le mal commis demande une action positive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois options d'expiation : libérer un esclave, jeûner, nourrir les pauvres. Trois actes de libération et de partage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je fais mal, comment est-ce que je répare ? Est-ce que je m'en tire avec des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'expiation purifie le coupable et aide autrui. Le mal se transforme en bien par la réparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'équilibre. Chaque action a une réaction. La réparation rétablit l'équilibre brisé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répare activement grandit de sa faute. Le repentir n'est pas des mots — c'est une action." }
  ],
  munajat: `Ya Tawwab, quand je fais mal, donne-moi la force de réparer. Transforme mes fautes en occasions de bienfaits.`
};

MIROIR["58:4"] = {
  reference: "58:4",
  theme: ["guérison", "confiance", "pardon"],
  emotion: "Libération, partage",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Ar-Razzaq"],
  mirrorVersion: `« Et celui qui n'en trouve pas les moyens doit jeûner deux mois consécutifs avant tout contact. » Le miroir me montre l'accessibilité de l'expiation : si on ne peut pas affranchir un esclave, on jeûne. Si on ne peut pas jeûner, on nourrit. Allah ne demande pas l'impossible — Il demande ce qui est possible pour chacun. Le miroir m'invite à l'action selon mes moyens : je ne peux pas tout, mais je peux quelque chose.`,
  reflection: `L'expiation est adaptée aux moyens de chacun. Allah ne charge pas une âme au-dessus de ses capacités.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'adaptation de l'expiation aux moyens : esclave, jeûne, ou nourriture. Personne n'est exclu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je peux faire avec mes moyens ? Je ne peux pas tout — mais je peux quelque chose." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'exige pas l'impossible. Il demande l'effort selon la capacité de chacun." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne selon les capacités. Chaque créature reçoit et donne selon sa mesure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait ce qu'il peut avec ce qu'il a satisfait Allah. La perfection n'est pas exigée — l'effort oui." }
  ],
  munajat: `Ya Razzaq, Tu ne demandes que ce que je peux donner. Aide-moi à faire mon possible, même si c'est petit à mes yeux.`
};

MIROIR["58:5"] = {
  reference: "58:5",
  theme: ["force", "méditation", "confiance"],
  emotion: "Mise en garde, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Aziz"],
  mirrorVersion: `« Ceux qui s'opposent à Allah et à Son Messager seront terrassés comme ceux qui les ont précédés. » Le miroir me montre l'histoire comme tribunal : ceux qui ont défié Allah ont été vaincus. Cette vérité n'est pas une menace sadique — c'est une loi cosmique. L'opposition à la vérité ne peut pas triompher éternellement. Le miroir m'avertit : suis-je du côté de la vérité ou dans l'opposition ?`,
  reflection: `L'histoire est remplie de ceux qui ont défié la vérité et ont péri. La victoire finale appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La défaite des opposants — une loi historique. Aucune opposition à Allah ne triomphe durablement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quoi ou qui est-ce que je m'oppose ? Suis-je du bon côté de l'histoire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'opposition à Allah est auto-destructrice. On ne peut pas gagner contre la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à des lois. Qui va contre ces lois échoue. La vérité est une loi cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'aligne sur la vérité avance avec elle. Celui qui s'y oppose est emporté par elle." }
  ],
  munajat: `Ya Qadir, garde-moi du côté de la vérité. Ne me laisse pas m'opposer à Toi ou à Ton Messager. Que je sois vaincu avec Toi, pas contre Toi.`
};

MIROIR["58:6"] = {
  reference: "58:6",
  theme: ["méditation", "force", "confiance"],
  emotion: "Lucidité, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hasib", "Al-Khabir"],
  mirrorVersion: `« Le jour où Allah les ressuscitera tous et les informera de ce qu'ils ont fait. » Le miroir me place devant le Jour de la Résurrection : chaque action sera connue, chaque secret révélé. Pas de cachette, pas d'omission. Le miroir m'invite à la préparation : si tout doit être révélé, que vais-je voir ce jour-là ?`,
  reflection: `Le Jour du Jugement est le grand miroir où tout est révélé. Préparer ce jour, c'est préparer ce qu'on verra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La résurrection de tous, l'information de tout — chaque acte sera exposé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je verrai ce jour-là ? Mon passé me plaît-il ? Le miroir m'invite à l'audit." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tout sera révélé — mais Allah connaît déjà tout. La révélation est pour nous, pas pour Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est perdu dans l'univers. Chaque action laisse une trace qui sera révélée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme si ce Jour était déjà là n'a rien à craindre de sa révélation." }
  ],
  munajat: `Ya Hasib, ce Jour viendra où tout sera exposé. Prépare-moi à cette rencontre. Fais que ce que je verrai me fasse honneur, pas honte.`
};

MIROIR["58:7"] = {
  reference: "58:7",
  theme: ["présence", "confiance", "méditation"],
  emotion: "Lucidité, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sami", "Al-Basir", "Al-Khabir"],
  mirrorVersion: `« Ne sais-tu pas qu'Allah sait ce qui est dans les cieux et sur la terre ? Il n'y a pas de conversation secrète entre trois sans qu'Il ne soit leur quatrième. » Le miroir me place devant la présence omnisciente d'Allah. Où que je sois, avec qui que je sois, Allah est là. Cette conscience devrait transformer mes conversations, mes pensées, mes secrets. Le miroir m'interroge : qu'est-ce que je dis quand je pense qu'Allah n'entend pas ?`,
  reflection: `La présence d'Allah est totale et constante. Rien ne Lui est caché — ni les mots, ni les pensées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Allah connaît toute conversation. Il est le quatrième de trois, le troisième de deux, le deuxième de un." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dis en secret ? Qu'est-ce que je pense que personne n'entend ? Allah entend tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Cette présence n'est pas une surveillance oppressive — c'est une compagnie bienveillante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sous le regard d'Allah. Pas un atome ne bouge sans Sa connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre avec la conscience de Sa présence transforme chaque instant en acte d'adoration." }
  ],
  munajat: `Ya Sami', Ya Basir, Tu es présent dans chaque conversation, dans chaque pensée. Aide-moi à vivre en Ta présence comme si je Te voyais.`
};

MIROIR["58:8"] = {
  reference: "58:8",
  theme: ["sagesse", "confiance", "méditation"],
  emotion: "Intimité, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sami", "Al-Alim"],
  mirrorVersion: `« N'as-tu pas vu ceux à qui les conversations secrètes ont été interdites ? Puis ils y retournent à ce qui leur a été interdit. » Le miroir me montre la récidive : ces gens ont été avertis, mais ils retournent à leurs pratiques condamnables. Le miroir m'interroge : qu'est-ce que je sais être interdit, mais que je continue à faire ? La connaissance sans l'action est une hypocrisie.`,
  reflection: `Connaître l'interdit ne suffit pas — il faut le délaisser. La récidive est le signe d'un cœur malade.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'interdiction puis le retour — le cycle de la récidive. La connaissance ne suffit pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je sais être interdit mais que je continue ? Le miroir révèle mes contradictions." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance de l'interdit est une bénédiction — mais elle devient malédiction si on ne l'applique pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à ses lois. L'homme seul connaît la loi et la transgresse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui délaisse ce qu'il sait être interdit purifie sa connaissance. Le savoir devient sagesse." }
  ],
  munajat: `Ya 'Alim, je connais Tes interdits et je les transgresse. Donne-moi la force de mettre en pratique ce que je sais. Purifie mon cœur de la contradiction.`
};

MIROIR["58:9"] = {
  reference: "58:9",
  theme: ["sagesse", "confiance", "force"],
  emotion: "Clarté, intégrité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous vous entretenez en secret, ne le faites pas pour le péché, l'hostilité et la désobéissance au Messager. » Le miroir me montre les trois usages interdits des conversations secrètes : le péché, l'hostilité, la désobéissance. Les secrets ne sont pas interdits en soi — leur usage malveillant l'est. Le miroir m'invite à examiner mes conversations secrètes : à quoi servent-elles ?`,
  reflection: `Le secret n'est pas le problème — l'intention l'est. Les conversations cachées révèlent le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois interdits : le péché (ithm), l'hostilité (udwan), la désobéissance (ma'siya). L'intention compte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi est-ce que je parle en secret ? Est-ce constructif ou destructif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret peut être vertueux — si l'intention l'est. Ce n'est pas le lieu qui compte, c'est le but." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses mystères, mais ils servent l'ordre, pas le désordre. Les secrets divins sont des bienfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a rien à cacher n'a pas peur des secrets. Son cœur est transparent devant Allah." }
  ],
  munajat: `Ya Hadi, purifie mes conversations secrètes. Fais qu'elles servent le bien, pas le mal. Que mes secrets soient avec Toi, pas contre Toi.`
};

MIROIR["58:10"] = {
  reference: "58:10",
  theme: ["confiance", "force", "espoir"],
  emotion: "Libération, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Wali"],
  mirrorVersion: `« Les conversations secrètes viennent du diable, pour affliger les croyants. » Le miroir me montre l'origine malveillante des complots secrets : le diable veut diviser, affliger, semer le trouble. Le croyant ne doit pas participer à ces complots. Le miroir m'invite à la transparence : ce qui est bon n'a pas besoin d'être caché.`,
  reflection: `Le secret malveillant est l'outil du diable. La transparence est la marque du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le diable est à l'origine des complots secrets. Son but : diviser et affliger." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache par malveillance ? Le miroir révèle mes complots, même intérieurs." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est bon peut être public. Ce qui doit être caché est souvent suspect." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est publique par nature. Les ténèbres se cachent. Le croyant est lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a rien à cacher marche dans la lumière. Il ne craint ni la révélation ni le jugement." }
  ],
  munajat: `Ya Wali, préserve-moi des complots secrets. Fais que je sois transparent, que je marche dans la lumière. Éloigne-moi des ruses du diable.`
};

MIROIR["58:11"] = {
  reference: "58:11",
  theme: ["sagesse", "confiance", "force"],
  emotion: "Respect, ordre",
  difficulty: "débutant",
  relatedNames: ["Al-Wasi", "Al-Alim"],
  mirrorVersion: `« Ô vous qui croyez ! Quand on vous dit : Faites place dans les assemblées, faites place. » Le miroir me montre un enseignement social : l'importance de faire de la place pour les autres. Les assemblées ne sont pas des territoires à conquérir mais des espaces à partager. Le miroir m'invite à l'humilité sociale : est-ce que je fais place aux autres ou est-ce que je m'étends ?`,
  reflection: `Faire place (tawassa') est un acte de générosité sociale. L'espace est un don, pas une conquête.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'ordre de faire place — un enseignement d'humilité sociale et de partage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans mes assemblées, est-ce que je fais place aux autres ? Ou est-ce que je m'approprie l'espace ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Faire place physiquement apprend à faire place dans le cœur. L'espace extérieur reflète l'espace intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est vaste et accueille tout. Le croyant devrait imiter cette vastesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait place aux autres verra Allah lui faire place au Paradis. La générosité spatiale est spirituelle." }
  ],
  munajat: `Ya Wasi, Tu es Vaste et Tu fais place à tous. Fais que je sois vaste comme Toi, que je fasse place aux autres dans mes espaces et mon cœur.`
};

MIROIR["58:12"] = {
  reference: "58:12",
  theme: ["sagesse", "détachement", "prière"],
  emotion: "Discipline, purification",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous voulez vous entretenir en secret avec le Messager, faites précéder cela d'une aumône. » Le miroir me montre une discipline : avant de solliciter le temps du Prophète, donner une aumône. Cette règle purifie l'intention et valorise le temps. Le miroir m'invite à la préparation : avant de demander, qu'est-ce que je donne ?`,
  reflection: `Donner avant de recevoir purifie l'intention. La requête devrait être précédée de la contribution.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'aumône avant l'entretien secret — une discipline de purification et de valorisation du temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je demande quelque chose, qu'est-ce que je donne d'abord ? L'attente sans contribution est-elle juste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Cette règle a été abrogée, mais le principe reste : donner avant de prendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne avant de recevoir. La graine est plantée avant la récolte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne avant de demander purifie sa requête. Il n'est pas en dette, il est en échange." }
  ],
  munajat: `Ya Hakim, enseigne-moi à donner avant de demander. Purifie mes requêtes par la contribution. Que je ne sois pas seulement preneur.`
};

MIROIR["58:13"] = {
  reference: "58:13",
  theme: ["confiance", "espoir", "pardon"],
  emotion: "Soulagement, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Craignez-vous de faire précéder vos entretiens d'aumônes ? Puisque vous ne l'avez pas fait et qu'Allah vous a accueillis en repentir... » Le miroir me montre la miséricorde d'Allah : cette règle a été allégée. Ceux qui ne pouvaient pas donner ont été pardonnés. Le miroir m'invite à la gratitude : même quand je ne peux pas accomplir parfaitement, Allah accepte mon effort.`,
  reflection: `L'allègement des obligations est une miséricorde. Allah n'impose pas ce qui écrase.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'abrogation de la règle — une miséricorde pour ceux qui ne pouvaient pas donner." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je ne peux pas accomplir parfaitement, est-ce que je désespère ? Allah accepte l'effort." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allègement n'est pas une licence pour la négligence — c'est une miséricorde pour la faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses lois, mais aussi ses exceptions. La miséricorde complète la justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'allègement comme miséricorde est reconnaissant, pas négligent." }
  ],
  munajat: `Ya Ghafur, Tu allèges mes obligations quand je ne peux pas les porter. Je Te remercie pour Ta miséricorde. Aide-moi à ne pas abuser de Ton indulgence.`
};

MIROIR["58:14"] = {
  reference: "58:14",
  theme: ["sagesse", "force", "confiance"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Hadi"],
  mirrorVersion: `« N'as-tu pas vu ceux qui prennent pour alliés des gens contre qui Allah est courroucé ? » Le miroir me montre le danger des mauvaises alliances. Prendre pour alliés ceux qu'Allah a maudits, c'est s'aligner contre Lui. Le miroir m'interroge : qui sont mes alliés ? Sont-ils du côté d'Allah ou contre Lui ?`,
  reflection: `Les alliances révèlent les valeurs. Qui je fréquente dit qui je suis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'alliance avec les ennemis d'Allah — un danger spirituel et social." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes alliés intimes ? Sont-ils compatibles avec ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance n'est pas neutre. On devient ce qu'on fréquente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par associations. Les atomes se combinent selon leurs affinités. Les cœurs aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit ses alliés avec sagesse protège son cœur de l'influence néfaste." }
  ],
  munajat: `Ya Wali, Tu es mon Allié. Aide-moi à choisir des alliés qui sont avec Toi. Épargne-moi les amitiés qui m'éloignent de Toi.`
};

MIROIR["58:15"] = {
  reference: "58:15",
  theme: ["force", "méditation", "confiance"],
  emotion: "Mise en garde, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhit", "Al-Hakim"],
  mirrorVersion: `« Allah a préparé pour eux un châtiment sévère. Ce qu'ils font est certes mauvais. » Le miroir me montre la conséquence : un châtiment sévère pour les mauvaises alliances. Le mal n'est pas gratuit — il a un prix. Le miroir m'avertit : chaque action a une conséquence, chaque alliance a un coût.`,
  reflection: `Le châtiment n'est pas arbitraire — il est la conséquence logique des choix faits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le châtiment sévère — la conséquence du mauvais choix d'alliance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle conséquence est-ce que je prépare par mes choix actuels ? Le miroir m'invite à l'anticipation." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment n'est pas désiré par Allah — il est le résultat de nos propres choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des conséquences intégrées. La gravité fait tomber. Les mauvais choix font chuter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui anticipe les conséquences change ses comportements. La peur salutaire précède la sécurité." }
  ],
  munajat: `Ya Muhit, Tu connais les conséquences de mes choix. Aide-moi à anticiper et à choisir le bien. Épargne-moi le châtiment que je prépare par mes erreurs.`
};

MIROIR["58:16"] = {
  reference: "58:16",
  theme: ["sagesse", "méditation", "force"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khabir"],
  mirrorVersion: `« Ils ont pris leurs serments comme bouclier et obstruent le chemin d'Allah. » Le miroir me montre l'instrumentalisation de la religion : ces gens utilisent leurs serments comme protection tout en obstruant le chemin d'Allah. L'hypocrisie religieuse. Le miroir m'interroge : est-ce que j'utilise la religion pour me protéger ou pour obéir ?`,
  reflection: `La religion n'est pas un bouclier pour le mensonge — elle est une voie pour la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le serment comme bouclier (junna) — l'instrumentalisation de la religion pour la protection personnelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise la religion comme protection ou comme guidance ? Le miroir vérifie mes intentions." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion utilisée comme bouclier devient une armure vide. Elle protège de l'extérieur mais pas de l'intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne peut pas être instrumentalisée. Elle est ce qu'elle est, pas ce qu'on veut qu'elle soit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise la religion de manière instrumentale perd son essence. Il garde la coquille mais pas le cœur." }
  ],
  munajat: `Ya Haqq, préserve-moi de l'instrumentalisation de la religion. Fais que je l'utilise pour T'obéir, pas pour me protéger de mes mensonges.`
};

MIROIR["58:17"] = {
  reference: "58:17",
  theme: ["détachement", "force", "sagesse"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Qadir"],
  mirrorVersion: `« Ni leurs biens ni leurs enfants ne leur serviront à rien contre Allah. » Le miroir me montre l'illusion de la protection matérielle. Les biens et les enfants — sources de fierté et de sécurité dans ce monde — ne protégeront pas contre Allah. Le miroir m'invite à reconsidérer mes sécurités : en quoi est-ce que je mets ma confiance ?`,
  reflection: `Les biens et les enfants sont des dons, pas des protections. Seul Allah protège vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les biens et les enfants — deux sources de sécurité illusoires face à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "En quoi est-ce que je mets ma sécurité ? L'argent ? Les relations ? Les enfants ? Le miroir révèle mes fausses protections." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les biens et les enfants sont des dons à gérer, pas des boucliers à accumuler." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers ne peut se interposer entre une créature et son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui place sa sécurité en Allah n'a besoin d'aucune autre protection. Allah suffit." }
  ],
  munajat: `Ya Ghani, mes biens et mes proches ne me protègent pas. Toi seul me protèges. Je remets ma sécurité entre Tes mains.`
};

MIROIR["58:18"] = {
  reference: "58:18",
  theme: ["méditation", "force", "confiance"],
  emotion: "Gravité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Muhit"],
  mirrorVersion: `« Le jour où Allah les ressuscitera tous, ils Lui jureront comme ils vous jurent, pensant que cela leur servira. » Le miroir me montre le mensonge éternel des hypocrites : même devant Allah, ils jureront avoir été sincères. Le mensonge devient leur nature. Le miroir m'avertit : le mensonge répété devient une seconde nature.`,
  reflection: `Le mensonge peut devenir une habitude si profonde qu'elle persiste même devant Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le serment mensonger même devant Allah — le mensonge comme seconde nature." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel mensonge est-ce que je me répète ? Est-il en train de devenir ma nature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité aussi peut devenir une seconde nature. C'est une question de pratique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas. Chaque chose est ce qu'elle est. Le mensonge est une invention humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique la vérité jusqu'à ce qu'elle devienne naturelle ne peut plus mentir." }
  ],
  munajat: `Ya Haqq, préserve-moi du mensonge habituel. Fais que la vérité soit ma nature, pas le mensonge. Purifie ma langue et mon cœur.`
};

MIROIR["58:19"] = {
  reference: "58:19",
  theme: ["force", "confiance", "méditation"],
  emotion: "Mise en garde, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Ash-Shaytan"],
  mirrorVersion: `« Le diable les a dominés et leur a fait oublier le rappel d'Allah. » Le miroir me montre le processus de l'égarement : le diable domine, l'oubli suit. L'oubli du rappel d'Allah est le symptôme d'un cœur dominé. Le miroir m'invite à la vigilance : est-ce que je me laisse dominer par les distractions ?`,
  reflection: `L'oubli d'Allah n'est pas accidentel — il est le résultat d'une domination spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La domination du diable (istahwahum) et l'oubli du rappel (dhikr Allah) — le processus de l'égarement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me fait oublier Allah ? Les distractions ? Les passions ? Le diable a-t-il prise sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si le diable peut dominer, Allah peut protéger. Le rappel est l'antidote." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'oubli est l'opposé de la conscience. L'univers ne peut pas oublier son Créateur. L'homme seul le peut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle d'Allah constamment ne peut être dominé par le diable. Le dhikr est une forteresse." }
  ],
  munajat: `Ya Wali, le diable veut me dominer et me faire oublier. Protège-moi par Ton rappel. Fais que le dhikr soit mon bouclier contre l'oubli.`
};

MIROIR["58:20"] = {
  reference: "58:20",
  theme: ["force", "confiance", "méditation"],
  emotion: "Clarté, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghalib", "Al-Haqq"],
  mirrorVersion: `« Ceux qui s'opposent à Allah et à Son Messager, ceux-là sont parmi les plus humiliés. » Le miroir me montre le résultat de l'opposition : l'humiliation. Non pas une humiliation arbitraire, mais le résultat naturel de l'opposition à la vérité. Le miroir m'invite à choisir mon camp : avec Allah ou contre Lui.`,
  reflection: `L'humiliation dans ce monde et l'autre attend ceux qui s'opposent à la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'opposition à Allah et Son Messager = l'humiliation (adhallin). La conséquence est claire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'oppose à quelque chose de divin ? Mes positions sont-elles alignées sur Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur est avec Allah. L'humiliation est contre Lui. Le choix est simple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah. Ce qui s'y oppose est écarté. La loi est implacable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'aligne sur Allah est honoré, même s'il est faible. Celui qui s'y oppose est humilié, même s'il est puissant." }
  ],
  munajat: `Ya Ghalib, Tu es le Victorieux. Place-moi de Ton côté. Je refuse l'opposition à Toi. Fais que je sois parmi les honorés, pas les humiliés.`
};

MIROIR["58:21"] = {
  reference: "58:21",
  theme: ["confiance", "force", "espoir"],
  emotion: "Certitude, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Ghalib"],
  mirrorVersion: `« Allah a écrit : Moi et Mes messagers triompherons. » Le miroir me montre la promesse divine écrite : la victoire finale. Cette écriture n'est pas un souhait — c'est un décret. Le miroir m'invite à la confiance : si je suis avec Allah et Ses messagers, je suis du côté victorieux.`,
  reflection: `La victoire finale est assurée. Être du bon côté suffit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'écriture divine (kataba) — la victoire est décrétée, pas juste promise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je avec Allah et Ses messagers ? Si oui, je suis du côté vainqueur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire n'est pas à obtenir — elle est déjà décrétée. Je n'ai qu'à m'y associer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire tend vers la victoire de la vérité. C'est une loi cosmique, pas une espérance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que la victoire est assurée ne perd jamais confiance. Il sait que la défaite est temporaire." }
  ],
  munajat: `Ya Ghalib, Tu as écrit la victoire. Fais que je sois de Ton côté. Même si je perds temporairement, je sais que Tu gagnes finalement.`
};

MIROIR["58:22"] = {
  reference: "58:22",
  theme: ["confiance", "force", "amour"],
  emotion: "Appartenance, fidélité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Mu'min"],
  mirrorVersion: `« Tu ne trouveras pas de gens qui croient en Allah et au Jour dernier, aimer ceux qui s'opposent à Allah et à Son Messager. » Le miroir me montre l'impossibilité de l'amour mixte : on ne peut pas aimer Allah et Ses ennemis simultanément. Le cœur est un — il ne peut pas être divisé. Le miroir m'interroge : qui est-ce que j'aime vraiment ?`,
  reflection: `L'amour est exclusif par nature. On ne peut pas aimer la vérité et le mensonge en même temps.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'impossibilité de l'amour double. Le cœur croyant ne peut pas aimer les ennemis d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'aime ? Mes amours sont-ils compatibles avec ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour d'Allah précède tout autre amour. Les autres amours doivent s'y soumettre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est unifié. La division crée le chaos. Le cœur divisé est un cœur chaotique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime purement Allah n'a pas besoin de choisir — son cœur a déjà choisi." }
  ],
  munajat: `Ya Wali, mon cœur doit être un. Aide-moi à aimer ceux que Tu aimes et à ne pas aimer Tes ennemis. Unifie mon amour pour Toi.`
};

// Surah 60 - Al-Mumtahana
MIROIR["60:4"] = {
  reference: "60:4",
  theme: ["détachement", "confiance", "force"],
  emotion: "Détermination, clarté",
  difficulty: "avancé",
  relatedNames: ["Al-Wali", "Al-Barri"],
  mirrorVersion: `« Nous vous désavouons, vous et ce que vous adorez en dehors d'Allah. » Ces mots d'Ibrahim marquent la rupture avec l'idolâtrie. Le miroir me montre que la foi exige parfois des ruptures. Pas la haine des personnes, mais le refus de l'égarement. Le croyant aime pour Allah et se détache pour Allah. Le miroir m'interroge : quels compromis ai-je faits avec le faux au nom de la paix sociale ?`,
  reflection: `Le désaveu (bara'a) n'est pas la haine — c'est la clarté des limites. On peut aimer les gens tout en refusant leurs égarements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ibrahim rompt avec son peuple et ses idoles. Un acte de courage spirituel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois « désavouer » dans ma vie ? Quelles idoles modernes ai-je tolérées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rupture extérieure doit venir d'une rupture intérieure. Désavouer l'idole dans son cœur d'abord." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. Elle ne se divise pas. On ne peut servir deux maîtres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le désaveu du faux est la face sombre de l'amour du Vrai. On ne peut aimer Allah sans rejeter ce qui Lui est opposé." }
  ],
  munajat: `Ya Wali, donne-moi le courage d'Ibrahim. Aide-moi à désavouer le faux sans haïr les hommes. Que mon cœur soit pur pour Toi seul.`
};

// Surah 61 - As-Saff
MIROIR["61:4"] = {
  reference: "61:4",
  theme: ["force", "confiance", "prière"],
  emotion: "Solidarité, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aziz", "Al-Jami"],
  mirrorVersion: `« Allah aime ceux qui combattent dans Son chemin, rangés en rangs serrés comme un édifice scellé. » Le miroir me montre l'image de la communauté croyante : un bâtiment solide, chaque croyant étant une brique qui soutient les autres. La force individuelle devient force collective. Le miroir m'interroge : suis-je une brique solide dans la construction de la ummah, ou une faille qui l'affaiblit ?`,
  reflection: `La communauté n'est pas une addition d'individus — c'est une structure où chaque élément soutient les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le combat (jihad) ordonné, organisé, solidaire. Comme un mur scellé (binyan marsus)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je soutiens les autres croyants ? Suis-je un lien ou une rupture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force collective commence par la force individuelle. Je ne peux soutenir si je m'effondre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est construit sur l'interdépendance. L'atome tient par les forces qui l'unissent aux autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait soutenu peut avancer sans peur. La communauté est une armure spirituelle." }
  ],
  munajat: `Ya Jami', fais de moi une brique solide dans Ta construction. Unis-moi aux croyants dans le combat pour Ta cause.`
};

// Surah 62 - Al-Jumu'a
MIROIR["62:9"] = {
  reference: "62:9",
  theme: ["prière", "présence", "détachement"],
  emotion: "Urgence, priorité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« Ô vous qui croyez ! Quand on appelle à la prière du vendredi, courez vers le rappel d'Allah et délaissez le commerce. » Le miroir me montre la hiérarchie des priorités. Le commerce — source de revenus — est moins important que le rappel d'Allah. Le mot « courez » (sa'u) indique l'urgence. Le miroir m'interroge : qu'est-ce que je délaisse pour la prière ? Et qu'est-ce que je préfère à la prière ?`,
  reflection: `La prière du vendredi est une invitation hebdomadaire à rétablir les priorités. Allah avant tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'appel du vendredi (adhan) interrompt les affaires. Le rappel d'Allah prime sur le profit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « délaisse » pour la prière ? Et qu'est-ce que je refuse de délaisser ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le commerce n'est pas interdit — il est secondaire. Ce qu'on délaisse temporairement pour Allah, Il le rend multiplié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création « prie » à sa manière. L'homme seul a besoin d'être rappelé à l'ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vendredi est le jour du rassemblement. La communauté se reforme, le cœur se reconnecte." }
  ],
  munajat: `Ya Allah, quand Ton appel retentit, aide-moi à tout délaisser pour Te rejoindre. Que ma présence à la prière soit une présence à Toi.`
};

// Surah 64 - At-Taghabun
MIROIR["64:11"] = {
  reference: "64:11",
  theme: ["confiance", "patience", "force"],
  emotion: "Acceptation, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Hakim"],
  mirrorVersion: `« Nul malheur n'atteint l'homme qu'avec la permission d'Allah. Et quiconque croit en Allah, Il guide son cœur. » Le miroir me montre que chaque épreuve passe par la permission divine. Rien ne m'arrive par hasard. Le croyant — celui qui accepte cette vérité — reçoit la guidance du cœur. Son cœur est « guidé » vers la patience, la gratitude, la compréhension. Le miroir m'interroge : comment est-ce que je réagis aux épreuves ?`,
  reflection: `La foi dans le destin n'est pas la passivité — c'est l'acceptation active qui transforme l'épreuve en croissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Chaque « malheur » (musiba) a besoin de la permission d'Allah. Rien n'échappe à Son contrôle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle épreuve m'arrive aujourd'hui ? Est-ce que je l'accepte comme venant d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur guidé voit dans l'épreuve une opportunité, pas un obstacle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers obéit à Allah. L'épreuve aussi. Elle a un but même si je ne le vois pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est guidé ne demande pas « pourquoi » mais « que faire avec ». Il transforme l'épreuve en escalier." }
  ],
  munajat: `Ya Qadir, chaque épreuve vient avec Ta permission. Guide mon cœur dans l'acceptation et la croissance. Transforme mes difficultés en degrés vers Toi.`
};

// Surah 66 - At-Tahrim
MIROIR["66:8"] = {
  reference: "66:8",
  theme: ["pardon", "espoir", "prière"],
  emotion: "Espoir, détermination",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Ô vous qui croyez ! Repentez-vous à Allah d'un repentir sincère. » Le miroir me montre l'urgence du tawba — le retour vers Allah. Pas un retour tiède, mais « sincère » (nasuha) — total, sans réserve. Le miroir m'interroge : qu'est-ce que j'ai laissé en suspens avec Allah ? Quel péché ai-je rationalisé au lieu de m'en repentir ?`,
  reflection: `Le repentir sincère efface les péchés. La porte est toujours ouverte — tant que la vie n'a pas cessé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le tawba nasuh : un repentir qui « conseille » le cœur, qui l'avertit de ne pas retomber." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le péché que je refuse d'abandonner ? Quel retour est-ce que je repousse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah attend le retour. Il aime ceux qui se repentent. La honte ne devrait pas empêcher le retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier retourne à Allah. Le soleil se couche, la saison s'inverse. Le retour est la loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le péché du repenti devient une porte. Celui qui revient à Allah L'aime plus que celui qui n'a jamais péché." }
  ],
  munajat: `Ya Tawwab, je me repens à Toi d'un repentir sincère. Pardonne-moi, efface mes fautes, et prends-moi par la main pour ne pas retomber.`
};

// Surah 68 - Al-Qalam
MIROIR["68:4"] = {
  reference: "68:4",
  theme: ["force", "confiance", "sagesse"],
  emotion: "Révérence, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Khuluq"],
  mirrorVersion: `« Et tu es certes d'un caractère grandiose. » Le miroir me montre le Prophète à travers les yeux d'Allah. Son caractère (khuluq) est « 'azim » — immense, grandiose. C'est le plus beau compliment divin. Le miroir m'interroge : mon caractère ressemble-t-il à celui du Prophète ? Quelles qualités dois-je cultiver pour m'en rapprocher ?`,
  reflection: `Le caractère du Prophète était le Coran incarné. Chaque verset qu'il transmettait, il le vivait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le khuluq 'azim : la grandeur morale. La meilleure des qualités selon Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon caractère ? Quelles qualités me définissent aux yeux des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté du caractère n'est pas innée — elle se cultive par l'imitation du Prophète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reflète la beauté du Créateur. Le croyant reflète la beauté du Prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le caractère est ce qui reste quand tout le reste s'en va. C'est l'essence de la personne." }
  ],
  munajat: `Ya Allah, fais que mon caractère ressemble à celui de Ton Prophète. Cultive en moi la patience, la générosité, la douceur et la vérité.`
};

// Surah 69 - Al-Haqqah
MIROIR["69:32"] = {
  reference: "69:32",
  theme: ["méditation", "détachement", "force"],
  emotion: "Lucidité, gravité",
  difficulty: "avancé",
  relatedNames: ["Al-Hasib", "Al-Dayyan"],
  mirrorVersion: `« Puis, dans une chaîne de soixante-dix coudées, insérez-le. » Le miroir me place devant le châtiment des mécréants. L'image est terrifiante : une chaîne immense, l'enfer. Le miroir ne me fait pas peur pour le plaisir — il m'éveille. Le Jour du Jugement est réel. Le châtiment est réel. Le miroir m'interroge : ma vie est-elle digne de ce rendez-vous ?`,
  reflection: `L'enfer n'est pas une métaphore. Le Coran le décrit en détail pour éveiller les cœurs endormis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La description de l'enfer est brutale. Les chaînes, le feu, la suppression." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais pour éviter ce destin ? Ma foi est-elle réelle ou superficielle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur de l'enfer peut être le début de la foi. Elle n'est pas la fin, mais elle peut être le départ." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers contient des sommets et des abîmes. L'au-delà contient le Paradis et l'Enfer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur l'enfer ne le mérite pas — car la méditation le transforme." }
  ],
  munajat: `Ya Dayyan, préserve-moi du châtiment. Ma foi est faible mais Ta miséricorde est immense. Sauve-moi de moi-même.`
};

// Surah 70 - Al-Ma'arij
MIROIR["70:4"] = {
  reference: "70:4",
  theme: ["méditation", "présence", "espoir"],
  emotion: "Émerveillement, aspiration",
  difficulty: "avancé",
  relatedNames: ["Al-Ali", "Al-Kabir"],
  mirrorVersion: `« Les anges et l'Esprit montent vers Lui en un jour dont la durée est de cinquante mille ans. » Le miroir me place devant la grandeur de l'au-delà. Un jour qui équivaut à cinquante mille ans. L'ascension vers Allah traverse des dimensions que je ne peux pas imaginer. Le miroir m'invite à l'humilité : mon temps, mon échelle, ma compréhension sont limités.`,
  reflection: `Le temps divin n'est pas le temps humain. Un jour auprès d'Allah peut être mille ans ou cinquante mille ans.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'ascension des anges vers Allah. Le voyage cosmique vers la Présence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon temps est limité. Comment est-ce que je l'utilise ? Chaque instant compte dans l'éternité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble long pour l'homme est court pour Allah. Et inversement. La perspective change tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des dimensions que je ne peux pas concevoir. L'au-delà encore plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'ascension vers Allah commence ici-bas. Chaque prière est un degré. Chaque bonne action est un pas." }
  ],
  munajat: `Ya Ali, Tu es au-dessus de tout. Élève mon cœur vers Toi. Fais que mon ascension commence maintenant, dans chaque instant.`
};

// Surah 71 - Nuh
MIROIR["71:10"] = {
  reference: "71:10",
  theme: ["pardon", "prière", "espoir"],
  emotion: "Espoir, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« J'ai dit : implorez le pardon de votre Seigneur, car Il est grand Pardonneur. » Le miroir me montre la prédication de Noé — 950 ans d'appel. Son message central : le pardon d'Allah. Le miroir m'invite à implorer ce pardon. Combien de fois ai-je demandé le pardon aujourd'hui ?`,
  reflection: `Le prophète Noé a prêché pendant des siècles. Son message reste simple : demandez le pardon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Nuh appelle au istighfar — la demande de pardon. La clé de la miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je demande pardon ? Une fois par jour ? Une fois par an ? Le Prophète le faisait 70-100 fois par jour." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon d'Allah précède la demande. Il attend qu'on Lui demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par la miséricorde. Le pardon est l'air que respire l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande pardon constamment voit son cœur s'illuminer. Le istighfar est un polissage quotidien." }
  ],
  munajat: `Ya Ghaffur, je demande Ton pardon pour chaque péché, chaque négligence, chaque moment loin de Toi. Pardonne-moi et rapproche-moi.`
};

// Surah 72 - Al-Jinn
MIROIR["72:16"] = {
  reference: "72:16",
  theme: ["guidance", "prière", "confiance"],
  emotion: "Clarté, résolution",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sirat", "Al-Mustaqim"],
  mirrorVersion: `« S'ils s'étaient maintenus dans la voie droite, Nous leur aurions donné à boire une eau abondante. » Le miroir me montre la promesse liée à la droiture (istiqama). Ceux qui tiennent le chemin droit reçoivent une « eau abondante » — la provision, la guidance, la paix. Le miroir m'interroge : est-ce que je tiens le chemin, ou est-ce que je dérive ?`,
  reflection: `L'eau abondante est une métaphore de la provision divine — spirituelle et matérielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La condition : istaqamu (ils se sont maintenus droits). La récompense : ma' ghadaq (eau abondante)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je perds en dérivant du chemin ? La provision se tarit quand le cœur s'égare." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droiture n'est pas la rigidité — c'est la constance dans la direction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La rivière qui suit son cours atteint l'océan. Celle qui dérive se perd dans les marécages." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'eau abondante n'est pas seulement matérielle — c'est la présence divine qui inonde le cœur droit." }
  ],
  munajat: `Ya Hadi, maintiens-moi sur le chemin droit. Donne-moi de Ton eau abondante — celle qui désaltère pour l'éternité.`
};

// Surah 74 - Al-Muddaththir
MIROIR["74:38"] = {
  reference: "74:38",
  theme: ["force", "confiance", "méditation"],
  emotion: "Responsabilité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hasib", "Al-Dayyan"],
  mirrorVersion: `« Chaque âme est otage de ce qu'elle a acquis. » Le miroir me place devant ma responsabilité totale. Je suis lié (rahina) à mes actes. Personne ne peut porter mes péchés, personne ne peut me créditer de bonnes actions que je n'ai pas faites. Le miroir m'interroge : qu'est-ce que j'acquiers aujourd'hui ? De quoi serai-je otage demain ?`,
  reflection: `La responsabilité individuelle est centrale en Islam. Chacun récolte ce qu'il sème.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'âme est « otage » — garantie, détenue. Ses actes sont sa monnaie d'échange." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « possède » ? Des bonnes actions ou des dettes ? Le bilan de chaque jour." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'otage peut être libéré — par le repentir, la miséricorde, la grâce divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur la causalité. Chaque acte a une conséquence, visible ou invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est otage de ses actes choisit chaque geste avec soin." }
  ],
  munajat: `Ya Hasib, je suis otage de mes actes. Libère-moi par Ton pardon. Aide-moi à n'accumuler que ce qui me rapproche de Toi.`
};

// Surah 75 - Al-Qiyama
MIROIR["75:26"] = {
  reference: "75:26",
  theme: ["méditation", "espoir", "détachement"],
  emotion: "Urgence, sobriété",
  difficulty: "avancé",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Non ! Quand l'âme remonte à la gorge. » Le miroir me place devant l'instant de la mort. Le moment où l'âme, qui était dispersée dans le corps, se rassemble et remonte. Le miroir m'interroge : si c'était maintenant ? Mon cœur est-il prêt ? Ai-je réglé mes comptes ?`,
  reflection: `La mort n'est pas la fin — c'est le passage. Mais ce passage est décisif. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'âme au moment de la mort — l'image est viscérale, physiologique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je regretterai si l'âme remonte maintenant ? Qu'ai-je laissé en suspens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort du croyant n'est pas une punition — c'est un retour. Mais le retour suppose la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier traverse des cycles de fin et de renaissance. L'âme aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Méditer la mort vivifie la vie. Celui qui meurt chaque jour dans le dhikr meurt une seule fois en réalité." }
  ],
  munajat: `Ya Allah, rappelle-moi la mort pour que je vive pleinement. Prépare mon cœur pour ce moment inévitable. Prends mon âme en paix.`
};

// Surah 76 - Al-Insan
MIROIR["76:9"] = {
  reference: "76:9",
  theme: ["amour", "détachement", "gratitude"],
  emotion: "Générosité, désintéressement",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Razzaq", "Al-Wadud"],
  mirrorVersion: `« Nous vous nourrissons pour le seul visage d'Allah. Nous ne voulons de vous ni récompense ni gratitude. » Le miroir me montre le sommet de la générosité : donner sans attendre rien en retour. Les croyants décrits ici nourrissent les pauvres par pure foi. Le miroir m'interroge : quand je donne, qu'est-ce que j'attends ? Une reconnaissance ? Un retour ?`,
  reflection: `La générosité désintéressée est la plus pure. Elle ne cherche que le visage d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Nourrir pour « wajh Allah » — le Visage d'Allah. Sans attente de récompense humaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je donne, qu'est-ce que je veux ? La reconnaissance ? Le statut ? Ou seulement Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui donne sans attente reçoit tout. La récompense d'Allah dépasse toute reconnaissance humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne sans compter. Le soleil éclaire sans demander de merci. L'eau désaltère sans réclamer de prix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le visage d'Allah est la plus belle récompense. Qui Le voit n'a besoin de rien d'autre." }
  ],
  munajat: `Ya Wadud, purifie mon intention. Fais que je donne pour Ton visage seul, sans attente, sans calcul. Que mon don soit pur comme le Tien.`
};

// Surah 77 - Al-Mursalat
MIROIR["77:50"] = {
  reference: "77:50",
  theme: ["guidance", "sagesse", "méditation"],
  emotion: "Interpellation, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Dans quel discours, après cela, croiront-ils ? » Le miroir me place devant une question lancinante. Après le Coran, après les signes, après les prophètes — que reste-t-il pour croire ? Le miroir m'interroge : qu'est-ce que j'attends pour croire ? Quel signe de plus me faut-il ?`,
  reflection: `Le Coran est le signe ultime. Qui n'y croit pas cherche en vain un autre message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La question est rhétorique mais dévastatrice. Après le Coran, quel autre discours ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de croire ? Qu'est-ce que j'attends ? Le miroir révèle mes résistances." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question n'est pas : que faut-il de plus ? Mais : pourquoi est-ce que je refuse ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un message. Le Coran en est la clé. Refuser la clé, c'est refuser la compréhension." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au Coran n'a besoin de rien d'autre. Le Coran suffit à qui lui suffit." }
  ],
  munajat: `Ya Hadi, je crois en Ton message. Mais augmente ma foi. Ouvre mes yeux aux signes que Tu as déjà envoyés.`
};

// Surah 78 - An-Naba'
MIROIR["78:39"] = {
  reference: "78:39",
  theme: ["espoir", "confiance", "force"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wa'id"],
  mirrorVersion: `« C'est le Jour certain. » Le miroir me place devant « le Jour » — al-Qiyama. Ce jour est « haqq » — certain, vrai, inévitable. Le miroir ne me fait pas peur pour le plaisir — il me donne un repère. Tout ce que je fais aujourd'hui aura son sens dans ce Jour-là. Le miroir m'interroge : vis-je comme si ce Jour était certain ?`,
  reflection: `Le Jour dernier est la référence. Tout acte prend sens à la lumière de l'éternité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Jour est « haqq » — vérité, certitude, réalité. Pas une possibilité, une certitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si ce Jour était certain ? Mes priorités le reflètent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce Jour n'est pas une menace — c'est une justice. Les opprimés y trouveront réparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tend vers ce Jour. Chaque seconde qui passe m'en rapproche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en ce Jour chaque jour — par la conscience — ne sera pas surpris quand il viendra." }
  ],
  munajat: `Ya Allah, fais que je vive dans la conscience de ce Jour certain. Que chaque acte soit posé en Sa lumière. Prépare-moi pour cette rencontre.`
};

// Surah 79 - An-Nazi'at
MIROIR["79:40"] = {
  reference: "79:40",
  theme: ["force", "détachement", "sagesse"],
  emotion: "Maîtrise, détermination",
  difficulty: "avancé",
  relatedNames: ["An-Nafs", "Al-Mutma'inna"],
  mirrorVersion: `« Quant à celui qui a craint la station devant son Seigneur et s'est interdit à l'âme ses passions. » Le miroir me montre le chemin de la maîtrise : craindre Allah ET se discipliner. Les deux vont ensemble. La peur seule ne suffit pas — il faut l'action sur soi. Le miroir m'interroge : quelles passions ai-je apprivoisées ? Lesquelles me dominent encore ?`,
  reflection: `La maîtrise de l'âme (nafs) est un combat quotidien. Les passions ne meurent pas — elles se soumettent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Crainte du Seigneur + interdiction à l'âme = la formule de la maîtrise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon âme désire que je dois lui refuser ? Quelles passions me contrôlent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'âme n'est pas l'ennemie — elle est la monture. Celui qui la maîtrise voyage loin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers suit son ordre. L'homme seul peut choisir le désordre — ou l'ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'âme maîtrisée devient alliée. Elle porte le croyant vers Allah au lieu de l'en éloigner." }
  ],
  munajat: `Ya Allah, je crains Ta station. Aide-moi à maîtriser mon âme, à lui interdire ce qui m'éloigne de Toi. Fais de mes passions des alliées.`
};

// ==================== SURAH 79: AN-NAZI'AT - MISSING VERSES 41-46 ====================

MIROIR["79:41"] = {
  reference: "79:41",
  theme: ["paradis", "récompense", "satisfaction"],
  emotion: "Espoir, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Ar-Rida"],
  mirrorVersion: `« Le Paradis sera son refuge. » Le miroir me montre la récompense du pieux. Après la maîtrise, le Paradis. Après l'effort, le repos. Le miroir m'enseigne : la maîtrise de l'âme mène au Paradis.`,
  reflection: `Le Paradis est le refuge de celui qui maîtrise son âme. La récompense suit l'effort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-inna al-jannata hiya al-ma'wa » — le Paradis sera son refuge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon refuge sera-t-il le Paradis ? Ou l'Enfer ? Le choix est maintenant." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refuge du Paradis est la récompense de la maîtrise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est préparé pour ceux qui se préparent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise son âme entre au Paradis en maître." }
  ],
  munajat: `Ya Rabb, je veux le Paradis comme refuge. Aide-moi à maîtriser mon âme. Donne-moi la récompense éternelle.`
};

MIROIR["79:42"] = {
  reference: "79:42",
  theme: ["question", "heure", "curiosité"],
  emotion: "Curiosité, questionnement",
  difficulty: "débutant",
  relatedNames: ["As-Sa'ah", "Al-Qiyamah"],
  mirrorVersion: `« Ils t'interrogent sur l'Heure : quand viendra-t-elle ? » Le miroir me montre la question récurrente. Les gens demandent quand. Allah répond par une question plus profonde. Le miroir m'enseigne : la question du quand cache la question du comment.`,
  reflection: `La question sur l'Heure est secondaire. La vraie question est : suis-je prêt ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'alunaka 'ani al-sa'ah ayyana mursaha » — ils t'interrogent sur l'Heure : quand viendra-t-elle ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande quand ? Ou est-ce que je demande comment me préparer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation est plus importante que la date." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure est connue d'Allah seul. Ma préparation est mon affaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est préparé n'a pas besoin de connaître la date." }
  ],
  munajat: `Ya Rabb, je ne demande pas quand. Je demande comment me préparer. Donne-moi la préparation constante.`
};

MIROIR["79:43"] = {
  reference: "79:43",
  theme: ["science", "rappel", "heure"],
  emotion: "Humilité, ignorance",
  difficulty: "débutant",
  relatedNames: ["Al-Ilm", "Adh-Dhikra"],
  mirrorVersion: `« Mais qu'en sais-tu pour pouvoir le mentionner ? » Le miroir me montre l'ignorance humaine. L'homme demande mais ne sait pas. La question dépasse sa capacité. Le miroir m'enseigne : certaines questions n'ont pas de réponse accessible.`,
  reflection: `L'Heure dépasse la compréhension humaine. L'humilité est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi-ma anta min dhikraha » — mais qu'en sais-tu pour pouvoir le mentionner ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande sans comprendre ? La question révèle mon ignorance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité devant l'inconnu est la vraie sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure appartient à Allah. Le temps appartient à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte son ignorance s'ouvre à la connaissance." }
  ],
  munajat: `Ya Rabb, je ne sais pas. Accepte mon ignorance. Donne-moi l'humilité de ne pas demander ce que je ne peux comprendre.`
};

MIROIR["79:44"] = {
  reference: "79:44",
  theme: ["science", "fin", "Allah"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Ilm", "Allah"],
  mirrorVersion: `« La connaissance ultime en appartient à ton Seigneur. » Le miroir me montre la limite de la connaissance humaine. L'Heure est connue d'Allah seul. La science ultime Lui appartient. Le miroir m'enseigne : accepter les limites de ma connaissance.`,
  reflection: `La science ultime appartient à Allah. Je dois accepter mes limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila rabbika muntahaha » — la connaissance ultime en appartient à ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'accepte de ne pas savoir ? La limite est une protection." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la limite ouvre à la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des limites. Allah n'en a pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les limites d'Allah est libre." }
  ],
  munajat: `Ya Rabb, Ta science est ultime. J'accepte mes limites. Donne-moi la confiance en Toi.`
};

MIROIR["79:45"] = {
  reference: "79:45",
  theme: ["avertissement", "crainte", "annonce"],
  emotion: "Gravité, préparation",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Khashyah"],
  mirrorVersion: `« Tu n'es qu'un avertisseur pour ceux qui la craignent. » Le miroir me montre la fonction du Prophète. Avertir ceux qui craignent. L'avertissement est pour les cœurs éveillés. Le miroir m'enseigne : l'avertissement n'est utile qu'à celui qui craint.`,
  reflection: `L'avertissement est pour ceux qui craignent. La crainte est la clé de l'écoute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anta innama anta nadhirun man yakhshaha » — tu n'es qu'un avertisseur pour ceux qui la craignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de ceux qui craignent ? Ou est-ce que l'avertissement me passe au-dessus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte fait de l'avertissement un guide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est universel. L'écoute est personnelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint entend l'avertissement et se prépare." }
  ],
  munajat: `Ya Rabb, je veux être parmi ceux qui craignent. Fais que j'entende l'avertissement. Prépare-moi par la crainte.`
};

MIROIR["79:46"] = {
  reference: "79:46",
  theme: ["perception", "jour", "réalité"],
  emotion: "Stupeur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-Haqiqah"],
  mirrorVersion: `« Le jour où ils la verront, il leur semblera n'être restés qu'un soir ou un matin. » Le miroir me montre la relativité du temps. Ce monde qui semble long sera perçu comme un instant. L'éternité change la perception. Le miroir m'enseigne : ce monde est court, l'au-delà est long.`,
  reflection: `Ce monde sera perçu comme un instant. La perspective de l'éternité change tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-annahum yawma yarawna lam yalbathu illa 'ashiyyatan aw duhaha » — le jour où ils la verront, il leur semblera n'être restés qu'un soir ou un matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je perçois ce monde ? Long ou court ? L'éternité change ma perspective." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perception du temps dépend de l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est relatif. L'éternité est la référence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la perspective de l'éternité ne s'attache pas au court." }
  ],
  munajat: `Ya Rabb, ce monde est court. Donne-moi la perspective de l'éternité. Ne permets pas que je m'y attache. Fais que je vive pour l'éternel.`
};

// Surah 80 - 'Abasa
MIROIR["80:24"] = {
  reference: "80:24",
  theme: ["gratitude", "méditation", "sagesse"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Khaliq"],
  mirrorVersion: `« Que l'homme considère donc sa nourriture. » Le miroir m'invite à contempler l'humble nourriture. Le grain de blé, la goutte d'eau — tout un processus cosmique se cache derrière. La pluie, la terre, le soleil, la croissance — chaque étape est un miracle. Le miroir m'interroge : est-ce que je vois le miracle dans mon assiette ?`,
  reflection: `La nourriture est un voyage cosmique avant d'arriver à nous. Chaque bouchée est un don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset invite à la contemplation du processus alimentaire. De la pluie à l'assiette." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je mange ? En vitesse ? Sans penser ? Le miroir invite à la conscience." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture n'est pas un dû — c'est un don. Chaque repas est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier collabore pour me nourrir. Le soleil, la pluie, la terre, les mains qui cultivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange en conscience transforme chaque repas en acte d'adoration." }
  ],
  munajat: `Ya Razzaq, Tu me nourris chaque jour. Ouvre mes yeux sur le miracle de ma nourriture. Fais que chaque bouchée soit une gratitude.`
};

// Surah 81 - At-Takwir
MIROIR["81:27"] = {
  reference: "81:27",
  theme: ["guidance", "prière", "espoir"],
  emotion: "Universalité, mission",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "An-Nur"],
  mirrorVersion: `« Il n'est qu'un rappel pour l'univers. » Le miroir me montre la portée du Coran : pas un message pour une tribu ou une époque, mais pour l'univers entier (al-'alamin). Chaque être, chaque lieu, chaque temps peut y trouver sa guidance. Le miroir m'interroge : quelle est ma relation avec ce message universel ?`,
  reflection: `Le Coran n'est pas un livre du passé — il est une lumière pour chaque temps et chaque lieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Coran est « dhikr » — rappel. Pour « al-'alamin » — les mondes, l'univers entier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que le Coran me « rappelle » ? Quel aspect de moi a besoin de ce rappel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne suis pas seul concerné. Le message est pour tous. Comment le transmets-je ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran parle à l'humanité entière. Chaque culture, chaque langue peut s'y reconnaître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme un message personnel reçoit l'univers entier dans son cœur." }
  ],
  munajat: `Ya Rabb, fais que je lise Ton message comme si Il m'était personnellement adressé. Et partage cette lumière avec l'univers entier.`
};

// Surah 82 - Al-Infitar
MIROIR["82:6"] = {
  reference: "82:6",
  theme: ["méditation", "confiance", "gratitude"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Khaliq"],
  mirrorVersion: `« Ô homme ! Qu'est-ce qui t'a trompé au sujet de ton Seigneur généreux ? » Le miroir me place devant une question bouleversante. Qu'est-ce qui m'a trompé ? Qu'est-ce qui m'a fait croire que je pouvais ignorer Allah, que je pouvais vivre sans Lui ? Le « Generous » (Karim) est souligné — Sa générosité même devrait m'éveiller. Le miroir m'interroge : qu'est-ce qui me détourne de Lui ?`,
  reflection: `La tromperie (ghurur) est le voile principal. L'ego, le monde, les passions — tout concourt à nous faire oublier le Généreux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La question est directe : « Qu'est-ce qui t'a trompé ? » Chacun doit y répondre pour soi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'éloigne d'Allah ? La distraction ? L'orgueil ? Le confort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité d'Allah ne devrait pas tromper — elle devrait réveiller. Ses dons sont des signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un don du Généreux. Comment puis-je L'oublier ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à cette question avec honnêteté découvre son plus grand obstacle — et peut le traverser." }
  ],
  munajat: `Ya Karim, Ta générosité m'entoure et je T'oublie. Réveille-moi de ma tromperie. Fais que chaque don me rappelle le Donateur.`
};

// Surah 83 - Al-Mutaffifin
MIROIR["83:1"] = {
  reference: "83:1",
  theme: ["sagesse", "force", "détachement"],
  emotion: "Mise en garde, intégrité",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Adl"],
  mirrorVersion: `« Malheur aux fraudeurs. » Le miroir me place devant une mise en garde sévère. Les mutaffifun — ceux qui trichent dans les mesures, qui donnent moins qu'ils ne doivent. Mais la fraude ne se limite pas au commerce. Le miroir m'interroge : où est-ce que je « diminue » ? Mes prières ? Mes obligations ? Ma parole ?`,
  reflection: `La fraude est une forme de vol. Donner moins que ce qui est dû, prendre plus que ce qui est juste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Wayl — malheur, destruction — aux fraudeurs. Une menace sévère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je « triche » ? Dans mes relations ? Dans mon travail ? Dans ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intégrité n'est pas une option — c'est une obligation. Chaque diminution est comptée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne fraude pas. La nature donne ce qu'elle doit. L'homme seul peut tricher." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est intègre dans les petites choses sera intègre dans les grandes. La fraude commence par les détails." }
  ],
  munajat: `Ya Hasib, préserve-moi de la fraude. Fais que je donne pleinement ce que je dois, que je sois intègre dans chaque mesure.`
};

// Surah 84 - Al-Inshiqaq
MIROIR["84:6"] = {
  reference: "84:6",
  theme: ["force", "patience", "confiance"],
  emotion: "Effort, persévérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mubin", "Al-Wafi"],
  mirrorVersion: `« Ô homme ! Tu fournis un effort laborieux vers ton Seigneur et tu Le rencontreras. » Le miroir me montre la vie comme un effort (kadh) constant. Chaque jour, chaque souffle, je me dirige vers mon Seigneur. La rencontre est certaine. Le miroir m'interroge : quel genre d'effort fournis-je ? Et quelle sera la qualité de ma rencontre ?`,
  reflection: `La vie est un voyage vers Allah. L'effort est inévitable — la question est : quel effort ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'homme « s'épuise » (kaddh) vers son Seigneur. L'effort est inévitable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi m'épuisais-je ? Pour Allah ou pour le monde ? L'effort compte, mais la direction aussi." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort n'est pas vain — il a une destination. La rencontre avec le Seigneur est la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers « voyage ». L'électron vers le noyau, la rivière vers la mer, l'âme vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que chaque effort le rapproche d'Allah transforme la fatigue en offrande." }
  ],
  munajat: `Ya Rabb, je m'épuise vers Toi. Fais que mon effort soit pour Toi, que ma fatigue soit douce, que ma rencontre soit belle.`
};

// Surah 85 - Al-Buruj
MIROIR["85:14"] = {
  reference: "85:14",
  theme: ["amour", "pardon", "espoir"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Al-Wadud"],
  mirrorVersion: `« Et Il est le Pardonneur, le Tout-Aimant. » Le miroir me place devant deux noms divins intimement liés. Al-Ghafur pardonne les fautes. Al-Wadud aime même le pécheur qui revient. Le miroir m'invite à comprendre que le pardon d'Allah n'est pas froid — il est empreint d'amour. Il ne tolère pas seulement — Il aime.`,
  reflection: `L'amour d'Allah n'est pas conditionnel à la perfection. Il aime le repenti, le chercheur, l'effort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux noms ensemble : le Pardonneur et l'Aimant. Le pardon est une forme d'amour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois qu'Allah m'aime ? Ou est-ce que je pense qu'Il me tolère à peine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour d'Allah précède le mien. Il m'aime avant que je ne L'aime. Son pardon attend mon retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par l'amour divin. Chaque chose est aimée de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est aimé pardonne à lui-même et peut avancer. L'amour guérit la honte." }
  ],
  munajat: `Ya Ghafur, Ya Wadud, Tu pardonnes et Tu aimes. Je me repens et je T'aime. Aide-moi à croire en Ton amour même dans mes chutes.`
};

// Surah 86 - At-Tariq
MIROIR["86:4"] = {
  reference: "86:4",
  theme: ["présence", "confiance", "méditation"],
  emotion: "Intimité, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Raqib", "Al-Hafiz"],
  mirrorVersion: `« Sur chaque âme il y a un gardien. » Le miroir me place devant une vérité rassurante : je ne suis jamais seul ni sans protection. Un gardien (hafiz) veille sur chaque âme. Ce gardien peut être un ange ou la protection divine elle-même. Le miroir m'invite à la confiance : je suis veillé, protégé, accompagné.`,
  reflection: `La protection divine est constante. Nous ne voyons pas les gardiens, mais ils sont là.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Chaque âme (nafs) a un hafiz — un gardien, un protecteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens protégé ? Ou est-ce que je vis dans la peur constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gardien protège mais n'empêche pas les épreuves. Il transforme les épreuves en croissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de forces visibles et invisibles. La protection divine est parmi les invisibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est gardé dort en paix. La protection ne s'enlève pas — elle se découvre." }
  ],
  munajat: `Ya Hafiz, Tu as placé un gardien sur mon âme. Merci pour cette protection invisible. Fais-moi la sentir et m'y confier.`
};

// Surah 88 - Al-Ghashiya
MIROIR["88:21"] = {
  reference: "88:21",
  theme: ["guidance", "confiance", "détachement"],
  emotion: "Liberté, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudhill"],
  mirrorVersion: `« Rappelle donc, car tu n'es qu'un rappeleur. Tu n'es pas un dominateur sur eux. » Le miroir me montre la limite du rôle du Prophète — et de tout prédicateur. On rappelle, on ne force pas. La guidance est l'affaire d'Allah. Le miroir m'interroge : est-ce que j'essaie de forcer les autres à croire ? Ou est-ce que je rappelle avec douceur ?`,
  reflection: `Le devoir du croyant est de transmettre, pas de convertir. Les cœurs sont dans les mains d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Prophète est « mudhakkir » — rappeleur. Pas « musaytir » — dominateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que j'appelle les autres à Allah ? Avec force ou avec douceur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douceur est plus efficace que la contrainte. Les cœurs s'ouvrent à la douceur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne force pas. Le soleil éclaire doucement. La pluie tombe avec grâce." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rappelle sans attendre de résultat transmet librement. Le résultat appartient à Allah." }
  ],
  munajat: `Ya Hadi, fais de moi un rappeleur doux. Aide-moi à transmettre Ton message sans forcer, à inviter sans imposer.`
};

// Surah 90 - Al-Balad
MIROIR["90:4"] = {
  reference: "90:4",
  theme: ["force", "patience", "confiance"],
  emotion: "Endurance, résilience",
  difficulty: "débutant",
  relatedNames: ["Al-Mubtala", "As-Sabur"],
  mirrorVersion: `« Nous avons créé l'homme dans la peine. » Le miroir me place devant une vérité fondamentale : la vie est un effort (kabad). Pas comme punition, mais comme structure. L'âme grandit dans l'effort. Le miroir m'interroge : comment est-ce que je vis ma peine ? Comme un fardeau ou comme une opportunité de croissance ?`,
  reflection: `La peine n'est pas un accident — elle est une donnée de la condition humaine. Chaque être humain porte son kabad.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'homme créé dans « kabad » — la peine, l'effort, la difficulté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma « peine » ? Comment est-ce que je la vis ? Avec résistance ou avec acceptation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peine n'est pas un signe d'échec — elle est un signe d'humanité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute croissance exige un effort. Le papillon lutte pour sortir du cocon. Le pousse force la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la peine comme structure de vie la transforme en escalier vers le haut." }
  ],
  munajat: `Ya Rabb, Tu m'as créé dans la peine. Aide-moi à l'accepter, à la traverser, à grandir à travers elle. Fais de mon effort une offrande.`
};

// Surah 91 - Ash-Shams
MIROIR["91:9"] = {
  reference: "91:9",
  theme: ["guérison", "force", "sagesse"],
  emotion: "Responsabilité, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nafs", "Al-Mutma'inna"],
  mirrorVersion: `« A réussi celui qui la purifie, et est perdu celui qui la corrompt. » Le miroir me place devant le destin de l'âme (nafs). Elle peut être purifiée (zakkaha) et réussir, ou corrompue (dassaha) et échouer. Le choix m'appartient. Le miroir m'interroge : que fais-je de mon âme aujourd'hui ? La purifie-je ou l'obscurcis-je ?`,
  reflection: `L'âme n'est pas figée — elle se transforme. Chaque acte la purifie ou la corrompt.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Aflaha (réussi) vs khasiba (perdu). Zakka (purifié) vs dassa (corrompu)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je fait aujourd'hui pour mon âme ? L'ai-je nourrie ou affamée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification n'est pas une performance — c'est une direction. Chaque pas compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil purifie chaque jour. L'eau purifie. Le feu purifie. L'âme se purifie par les actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'âme purifiée brille comme le soleil. Elle reflète la lumière de son Créateur." }
  ],
  munajat: `Ya Allah, purifie mon âme. Ne la laisse pas se corrompre. Aide-moi à choisir chaque jour ce qui l'éclaire.`
};

// Surah 92 - Al-Layl
MIROIR["92:5"] = {
  reference: "92:5",
  theme: ["détachement", "gratitude", "force"],
  emotion: "Générosité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Ghani"],
  mirrorVersion: `« Quant à celui qui donne et craint, et déclare véridique le meilleur. » Le miroir me montre le portrait du croyant heureux : il donne (a'ta), il craint (ittaqa), il croit au meilleur (saddaqa). Trois piliers. Le miroir m'interroge : est-ce que je donne ? Est-ce que je crains ? Est-ce que je crois au meilleur ?`,
  reflection: `La générosité avec crainte et foi est la formule du succès spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Donner + craindre + croire = la voie du succès (yusra)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne de ce que j'ai ? Est-ce que je crains Allah dans mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui donne reçoit. Celui qui craint est protégé. Celui qui croit est guidé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne abondamment. Le soleil ne retient pas sa lumière. L'eau ne compte pas ses gouttes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le « meilleur » (al-husna) est la promesse d'Allah. Y croire, c'est recevoir." }
  ],
  munajat: `Ya Wahhab, fais de moi un donneur. Place Ta crainte dans mon cœur. Et fais que je croie au meilleur que Tu promets.`
};

// Surah 95 - At-Tin
MIROIR["95:6"] = {
  reference: "95:6",
  theme: ["méditation", "espoir", "sagesse"],
  emotion: "Humilité, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Asfal"],
  mirrorVersion: `« Sauf ceux qui croient et accomplissent les bonnes œuvres : ils auront une récompense non interrompue. » Le miroir me montre l'exception à la règle de la « plus basse des basses ». Les croyants qui agissent bien ne descendent pas — ils s'élèvent. Leur récompense est « ghayru mamnun » — sans interruption, sans fin. Le miroir m'interroge : suis-je dans l'exception ou dans la règle ?`,
  reflection: `L'homme a été créé dans la meilleure forme mais peut tomber au plus bas. La foi et les actes préservent l'élévation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'exception : foi + bonnes œuvres = récompense éternelle (ajrun ghayru mamnun)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de l'exception ? Ma foi est-elle suivie d'actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense n'est pas interrompue — elle coule sans fin comme une rivière éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers le bas (entropie). L'âme croyante tend vers le haut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'élévation commence ici-bas. Chaque bonne action est un degré vers le haut." }
  ],
  munajat: `Ya Rabb, préserve-moi de la chute. Fais que ma foi soit suivie d'actes. Élève-moi vers la récompense éternelle.`
};

// Surah 96 - Al-'Alaq
MIROIR["96:1"] = {
  reference: "96:1",
  theme: ["méditation", "gratitude", "sagesse"],
  emotion: "Révérence, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-'Alim"],
  mirrorVersion: `« Lis, au nom de ton Seigneur qui a créé. » Le miroir me place au début de la révélation — les premiers mots reçus par le Prophète. « Iqra » — lis, récite. Au nom du Créateur. Le miroir m'invite à lier toute connaissance à son origine. Je ne lis pas pour moi — je lis pour Lui. Je n'apprends pas pour briller — j'apprends pour Le connaître.`,
  reflection: `La première révélation lie la lecture à la création. Le savoir n'est pas neutre — il est lié au Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les premiers mots : Iqra (lis) + bismi Rabbik (au nom de ton Seigneur)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je lis ? Pourquoi est-ce que j'apprends ? Quel est le lien avec mon Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Lire au nom d'Allah transforme la lecture en adoration. Le savoir devient sacrement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un livre à lire. Chaque créature est un verset. Tout est signe (aya)." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit au nom d'Allah lit partout — dans le Coran, dans la nature, dans les événements." }
  ],
  munajat: `Ya Khaliq, enseigne-moi à lire en Ton nom. Fais que chaque savoir me rapproche de Toi. Transforme ma lecture en adoration.`
};

// Surah 97 - Al-Qadr
MIROIR["97:3"] = {
  reference: "97:3",
  theme: ["prière", "bénédiction", "espoir"],
  emotion: "Espérance, ferveur",
  difficulty: "débutant",
  relatedNames: ["Al-Qadr", "As-Salam"],
  mirrorVersion: `« La Nuit du Destin est meilleure que mille mois. » Le miroir me place devant une nuit unique dans l'année. Une nuit qui vaut plus que 83 ans de vie. Le miroir m'invite à la chercher — dans les dix dernières nuits de Ramadan. Qu'ai-je fait pour cette nuit ? Quelle prière ai-je préparée ?`,
  reflection: `La Nuit du Destin (Laylat al-Qadr) est le moment où les destinées sont fixées. La prière y est multipliée infiniment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une nuit meilleure que mille mois (83+ ans). La multiplication est divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je prépare cette nuit ? Qu'est-ce que je demanderais si je savais que c'est Elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque nuit peut devenir Laylat al-Qadr pour celui qui prie comme si c'était Elle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le destin se décide dans cette nuit. Les anges descendent. La paix inonde l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit cette nuit en veille la porte toute l'année dans son cœur." }
  ],
  munajat: `Ya Rabb, fais que je vive la Nuit du Destin. Accepte ma prière cette nuit-là. Décris pour moi le meilleur destin.`
};

// Surah 98 - Al-Bayyina
MIROIR["98:5"] = {
  reference: "98:5",
  theme: ["guidance", "prière", "détachement"],
  emotion: "Clarté, résolution",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Waqif"],
  mirrorVersion: `« Il ne leur a été ordonné que d'adorer Allah avec dévotion, en honnêtes croyants. » Le miroir me montre l'essence de la religion : adorer Allah avec ikhlas (sincérité) et hanif (inclination pure). Rien d'autre. Pas de complications, pas d'intermédiaires. Juste le cœur tourné vers Allah, sincèrement. Le miroir m'interroge : est-ce que ma religion est aussi simple ? Ou suis-je chargé d'ajouts ?`,
  reflection: `La simplicité de l'islam : un cœur sincère tourné vers Allah. Les complications sont humaines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'ordre : adorer Allah avec mukhlisina (sincérité) + hunafa' (purement tournés)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma pratique est-elle simple et sincère ? Ou chargée de rituels vides et d'attentes humaines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La simplicité n'est pas la facilité. Elle demande la purification constante du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers adore simplement. L'arbre prie sans artifice. L'oiseau chante sans partition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sincérité (ikhlas) est le secret. Avec elle, peu devient beaucoup. Sans elle, beaucoup devient peu." }
  ],
  munajat: `Ya Allah, simplifie ma religion. Fais que je T'adore avec un cœur sincère, sans ajout, sans artifice. Purifie mon intention.`
};

// Surah 99 - Az-Zalzala
MIROIR["99:7"] = {
  reference: "99:7",
  theme: ["force", "méditation", "espoir"],
  emotion: "Espoir, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Mizan", "Al-Hasib"],
  mirrorVersion: `« Quiconque fait un bien, fût-il du poids d'un atome, le verra. » Le miroir me montre la précision du compte divin. Rien n'est perdu — même un atome de bien. Cette vérité devrait m'encourager : chaque petite action compte. Le miroir m'interroge : quels « atomes » de bien est-ce que je néglige ?`,
  reflection: `Le bien le plus petit n'est pas perdu. Allah le compte, le pèse, le récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un atome (dharra) de bien est vu. La justice divine est absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels petits biens puis-je faire ? Un sourire ? Un mot gentil ? Une prière rapide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si le bien est compté, le mal aussi. Les « atomes » de mal sont également vus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait d'atomes. Chaque atome compte dans la physique. Chaque acte compte dans la métaphysique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'atome de bien respecte tout bien. La grandeur se cache dans le petit." }
  ],
  munajat: `Ya Hasib, Tu comptes chaque atome. Aide-moi à ne pas mépriser les petits biens. Fais que chaque geste Te soit offert.`
};

// Surah 100 - Al-'Adiyat
MIROIR["100:6"] = {
  reference: "100:6",
  theme: ["méditation", "gratitude", "force"],
  emotion: "Lucidité, remise en question",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Karim", "Al-Jahud"],
  mirrorVersion: `« L'homme est certes ingrat envers son Seigneur. » Le miroir me place devant une vérité douloureuse : l'homme est « kanud » — ingrat, dénégateur. Combien de bienfaits reçois-je chaque jour sans les reconnaître ? Le miroir m'interroge : quelle est ma gratitude aujourd'hui ?`,
  reflection: `L'ingratitude est l'état par défaut de l'homme. La gratitude est un effort conscient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'homme est « kanud » — celui qui nie les bienfaits, qui ne reconnaît pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de « merci » ai-je dit aujourd'hui ? Combien de bienfaits ai-je reconnus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude n'annule pas l'ingratitude naturelle — elle la combat chaque jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne cesse de donner. L'homme seul peut refuser de reconnaître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat son ingratitude devient reconnaissant. C'est un combat, pas un don." }
  ],
  munajat: `Ya Karim, je suis ingrat par nature. Apprends-moi la gratitude. Ouvre mes yeux sur les bienfaits que je ne vois pas.`
};

// Surah 101 - Al-Qari'a
MIROIR["101:6"] = {
  reference: "101:6",
  theme: ["méditation", "espoir", "force"],
  emotion: "Espérance, résolution",
  difficulty: "débutant",
  relatedNames: ["Al-Mizan", "Al-Waqi"],
  mirrorVersion: `« Celui dont les balances seront lourdes sera dans une vie agréable. » Le miroir me montre le Jour où les balances pèsent les actes. Les lourds (mawazin thaqulat) sont dans une vie agréable (ishat radiya). Le miroir m'interroge : qu'est-ce qui alourdit mes balances aujourd'hui ?`,
  reflection: `Les bonnes actions pèsent. Les mots, les intentions, les gestes — tout a un poids.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les balances (mawazin). Lourdes = vie agréable. Légères = abîme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je mets dans mes balances ? Des bonnes actions ou du vide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le poids n'est pas dans la quantité mais dans la qualité. Une action sincère pèse lourd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses balances. Les étoiles ont leur masse. Les âmes ont leur poids." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remplit ses balances de bonnes actions remplit sa vie de sens avant même l'au-delà." }
  ],
  munajat: `Ya Allah, fais que mes balances soient lourdes. Donne-moi des actions qui pèsent devant Toi. Prépare-moi pour la vie agréable.`
};

// Surah 102 - At-Takathur
MIROIR["102:5"] = {
  reference: "102:5",
  theme: ["détachement", "méditation", "sagesse"],
  emotion: "Lucidité, réveil",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Yaqin"],
  mirrorVersion: `« Non ! Si vous saviez avec la connaissance certaine. » Le miroir me place devant le contraste entre le savoir superficiel et la certitude (yaqin). Les gens se vantent de leurs biens, de leurs enfants — mais « si vous saviez vraiment ». La vraie connaissance change tout. Le miroir m'interroge : quel est mon niveau de certitude ?`,
  reflection: `La connaissance certaine ('ilm al-yaqin) transforme la vision. Celui qui « sait vraiment » ne s'attache pas au futile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le contraste : le takathur (multiplication des biens) vs le yaqin (certitude)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je « sais » vraiment ? Ou est-ce que je ne fais que croire savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude n'est pas intellectuelle — elle est expérientielle. On « voit » ce qu'on sait vraiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers dévoile ses secrets à ceux qui cherchent la certitude, pas la spéculation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui atteint le yaqin n'a plus besoin des compensations du monde." }
  ],
  munajat: `Ya Allah, donne-moi la connaissance certaine. Fais que je voie avec les yeux du cœur, pas seulement avec ceux de l'intellect.`
};

// Surah 104 - Al-Humaza
MIROIR["104:1"] = {
  reference: "104:1",
  theme: ["sagesse", "détachement", "force"],
  emotion: "Mise en garde, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Batin", "Al-Khafi"],
  mirrorVersion: `« Malheur à tout calomniateur diffamateur. » Le miroir me place devant deux vices dangereux : la calomnie (humaza) et la diffamation (lumaza). Ces comportements détruisent les relations, les réputations, les vies. Le miroir m'interroge : est-ce que je critique ? Est-ce que je médis ? Quel est le poids de mes mots sur les autres ?`,
  reflection: `La langue peut tuer sans sang. La calomnie est un crime contre l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Wayl (malheur) au humaza (calomniateur) et lumaza (diffamateur)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je parle des autres ? Qu'est-ce que je dis en leur absence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne parole construit. La mauvaise détruit. Le choix est dans chaque mot." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers parle en harmonie. Les atomes vibrent ensemble. Les mots humains peuvent déchirer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise sa langue maîtrise tout. La parole est le pont ou la faille." }
  ],
  munajat: `Ya Rabb, préserve ma langue. Fais que je ne sois ni calomniateur ni diffamateur. Aide-moi à parler bien ou à me taire.`
};

// Surah 105 - Al-Fil
MIROIR["105:1"] = {
  reference: "105:1",
  theme: ["force", "confiance", "gratitude"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Muntaqim"],
  mirrorVersion: `« N'as-tu pas vu comment ton Seigneur a agi avec les gens de l'Éléphant ? » Le miroir me place devant une intervention divine historique. L'armée d'Abraha venue détruire la Ka'ba a été anéantie par des oiseaux portant des pierres. Allah protège Sa Maison. Le miroir m'invite à la confiance : si Allah a protégé Sa Maison, Il peut protéger ce qui m'est confié.`,
  reflection: `L'histoire de l'Éléphant montre qu'Allah défend ce qui Lui appartient. Pas de force humaine qui peut l'emporter sur Sa volonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'année de l'Éléphant — l'année de naissance du Prophète. Allah défend Sa Maison." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains ? Qu'est-ce qui me semble impossible à défendre ? Allah peut tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les moyens d'Allah sont inattendus. Des oiseaux avec des pierres ! Il n'a pas besoin de nos stratégies." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah. Les oiseaux, les pierres, les vents — tout est à Son service." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se met sous la protection d'Allah est plus fort que toute armée." }
  ],
  munajat: `Ya Qahir, Tu as défendu Ta Maison avec des oiseaux. Défends-moi, protège ce qui m'est cher. Je me remets à Ta puissance.`
};

// Surah 106 - Quraysh
MIROIR["106:3"] = {
  reference: "106:3",
  theme: ["gratitude", "prière", "confiance"],
  emotion: "Reconnaissance, adoration",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Amin"],
  mirrorVersion: `« Qu'ils adorent donc le Seigneur de cette Maison. » Le miroir me montre le lien entre la protection et l'adoration. Les Quraysh ont été protégés, nourris, sécurisés — la réponse ? Adorer le Seigneur de la Ka'ba. Le miroir m'interroge : qu'ai-je reçu ? Et comment est-ce que j'adore en retour ?`,
  reflection: `La sécurité et la nourriture sont des dons d'Allah. La reconnaissance est l'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'adoration est la réponse à la protection et à la provision." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je reçu d'Allah ? La sécurité ? La nourriture ? Comment Lui rends-je grâce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration n'est pas un fardeau — c'est une reconnaissance. On adore ce qu'on reconnaît." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Ka'ba est un point de convergence. Les cœurs y tournent. L'adoration est le mouvement naturel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les dons adore naturellement. L'ingratitude seule empêche l'adoration." }
  ],
  munajat: `Ya Rabb de cette Maison, Tu m'as protégé et nourri. Je T'adore en reconnaissance. Accepte mon adoration comme un merci.`
};

// Surah 107 - Al-Ma'un
MIROIR["107:1"] = {
  reference: "107:1",
  theme: ["sagesse", "amour", "force"],
  emotion: "Interpellation, remise en question",
  difficulty: "débutant",
  relatedNames: ["Al-Kashif", "Al-Batin"],
  mirrorVersion: `« Vois-tu celui qui traite de mensonge la religion ? » Le miroir me place devant ceux qui nient la responsabilité religieuse. Le signe ? Ils négligent l'orphelin, ils n'encouragent pas à nourrir le pauvre. La religion n'est pas dans les discours — elle est dans le soin aux vulnérables. Le miroir m'interroge : comment est-ce que je traite les orphelins ? Les pauvres ?`,
  reflection: `La religion se mesure au traitement des plus faibles. Les rites sans compassion sont vides.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le signe de celui qui nie la religion : négliger l'orphelin, oublier le pauvre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite les vulnérables ? Les orphelins ? Les pauvres ? Les étrangers ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion n'est pas ce qu'on dit — c'est ce qu'on fait pour les plus faibles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers prend soin des plus petits. La nature nourrit même les créatures les plus fragiles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le soin aux pauvres est le signe de la vraie foi. Sans lui, la prière est vide." }
  ],
  munajat: `Ya Rabb, ne me laisse pas traiter de mensonge la religion par mon indifférence. Ouvre mes yeux sur l'orphelin et le pauvre. Fais que mes actes rejoignent mes paroles.`
};

// Surah 109 - Al-Kafirun
MIROIR["109:6"] = {
  reference: "109:6",
  theme: ["détachement", "confiance", "force"],
  emotion: "Clarté, résolution",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wali"],
  mirrorVersion: `« À vous votre religion, et à moi ma religion. » Le miroir me montre la frontière claire entre la foi et l'incroyance. Pas de compromis, pas de syncrétisme. Le croyant affirme sa foi sans haine, mais sans confusion. Le miroir m'interroge : est-ce que ma foi est claire ? Ou est-ce que je la dilue pour plaire ?`,
  reflection: `Le respect des autres n'implique pas la confusion des croyances. On peut être ferme sans être hostile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La séparation claire : « votre religion » vs « ma religion ». Pas de mélange." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compromets ma foi pour être accepté ? Ou est-ce que je la vis clairement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté n'est pas l'hostilité. On peut être ferme et bienveillant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. Elle ne se divise pas. Celui qui la possède ne la partage pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait ce qu'il croit n'a pas besoin de l'imposer. Sa clarté suffit." }
  ],
  munajat: `Ya Allah, donne-moi la clarté dans ma foi. Fais que je la vive sans compromis et sans haine. À Toi ma religion.`
};

// Surah 111 - Al-Masad
MIROIR["111:1"] = {
  reference: "111:1",
  theme: ["force", "confiance", "méditation"],
  emotion: "Gravité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qawi", "Al-Muhit"],
  mirrorVersion: `« Que périssent les deux mains d'Abu Lahab et qu'il périsse lui-même. » Le miroir me place devant le destin de l'ennemi du Prophète. Abu Lahab, l'oncle du Prophète, l'a combattu avec acharnement. Sa richesse ne l'a pas sauvé. Le miroir m'interroge : contre qui ou quoi est-ce que je me bats ? Suis-je du côté de la vérité ou contre elle ?`,
  reflection: `L'opposition à la vérité ne paie pas. Même la richesse et le statut ne protègent pas du châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Abu Lahab (« le Père de la Flamme ») porte un nom prémonitoire. Sa fin est dans son nom." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quoi suis-je ? Contre qui ? Est-ce que je résiste à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse d'Abu Lahab ne l'a pas sauvé. Ce qu'on possède ne protège pas de l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine de ceux qui ont combattu la vérité et ont péri." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le camp de la vérité peut perdre ici-bas mais gagner partout ailleurs." }
  ],
  munajat: `Ya Allah, place-moi du côté de la vérité. Ne me laisse pas m'opposer à Toi ou à Ton Prophète. Sauve-moi de la fin des oppresseurs.`
};

// Surah 113 - Al-Falaq
MIROIR["113:1"] = {
  reference: "113:1",
  theme: ["guérison", "confiance", "prière"],
  emotion: "Protection, refuge",
  difficulty: "débutant",
  relatedNames: ["Al-Falaq", "Al-Hafiz"],
  mirrorVersion: `« Dis : Je cherche refuge auprès du Seigneur de l'aube naissante. » Le miroir me place devant la protection contre les maux invisibles. L'aube (falaq) est le moment où la lumière perce les ténèbres. Je cherche refuge en Celui qui fait naître la lumière. Le miroir m'invite à la confiance : même dans les ténèbres, la lumière viendra.`,
  reflection: `L'aube est la promesse que les ténèbres ne durent pas. Chaque nuit a son matin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Seigneur du falaq — l'aube, le jour qui perce la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles ténèbres me menacent ? L'envie ? Le mal occulte ? Je cherche refuge." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière perce toujours. Les ténèbres ne sont pas éternelles. L'aube est promise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers alterne jour et nuit. La création respire. Chaque nuit attend son aube." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge auprès du Seigneur de l'aube est protégé même dans les nuits les plus sombres." }
  ],
  munajat: `Ya Rabb al-falaq, je cherche refuge en Toi contre tout mal. Fais lever l'aube dans mon cœur. Chasse les ténèbres par Ta lumière.`
};

// ==================== SURAH 85-114 COMPLETE MIROIR ENTRIES ====================
// Generated for Task ID: 2-d - All verses from Surahs 85-114

// ========== SURAH 85 - AL-BURUJ (The Mansions of Stars) ==========
// Missing verses: 1-13, 15-22

MIROIR["85:1"] = {
  reference: "85:1",
  theme: ["méditation", "présence", "sagesse"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Par le ciel aux constellations ! » Le miroir me lève les yeux vers l'immensité. Les constellations (buruj) sont les « tours » ou « châteaux » célestes — des formations majestueuses qui jalonnent la voûte céleste. Quand je contemple les étoiles, je ne vois pas seulement de la lumière lointaine. Je vois la signature d'un Créateur qui a disposé chaque point lumineux avec précision. Le miroir m'interroge : combien de fois lève-je les yeux vers le ciel ? Combien de fois oublie-je cette immensité qui m'entoure et me dépasse ?`,
  reflection: `Le ciel nocturne est un livre ouvert. Chaque constellation est un verset silencieux qui parle du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les buruj — les constellations, les tours célestes, les signes du zodiaque. Des formations fixes dans un univers en mouvement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand ai-je contemplé les étoiles pour la dernière fois ? Le miroir m'invite à lever les yeux." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les constellations nous regardent aussi. Elles sont témoins de nos nuits, de nos prières, de nos oublis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est constellé. Pas un point vide qui ne porte une signature divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les constellations contemple sans le savoir les traces du Trône." }
  ],
  munajat: `Ya Khaliq des cieux, fais que je lève les yeux vers Tes signes. Ne me laisse pas enfermé dans mes petits soucis. Ouvre-moi à l'immensité.`
};

MIROIR["85:2"] = {
  reference: "85:2",
  theme: ["méditation", "confiance", "force"],
  emotion: "Gravité, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'id", "Al-Haqq"],
  mirrorVersion: `« Par le Jour promis ! » Le miroir me place devant la certitude du Jour dernier. Ce jour est « promis » (yawm al-maw'ud) — il vient inéluctablement. Je ne connais pas sa date, mais je sais qu'il arrivera. Le miroir m'interroge : vis-je comme si ce jour n'existait pas ? Ou chaque action est-elle posée en sa présence ?`,
  reflection: `Le Jour promis est la grande perspective de l'humanité. Tout converge vers lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le Jour promis — le Jour du Jugement. Promesse divine, certitude absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si ce jour venait aujourd'hui, serais-je prêt ? Qu'ai-je préparé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce jour qui effraie est aussi celui qui libère. La justice finale répare toutes les injustices." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier attend ce jour. La création tout entière est tendue vers ce rendez-vous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque jour comme le Jour promis n'a rien à craindre du Jour promis." }
  ],
  munajat: `Ya Allah, fais que je vive chaque jour en pensant au Jour promis. Prépare-moi pour ce rendez-vous inéluctable.`
};

MIROIR["85:3"] = {
  reference: "85:3",
  theme: ["méditation", "témoin", "présence"],
  emotion: "Lucidité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Basir"],
  mirrorVersion: `« Par le témoin et le témoigné ! » Le miroir me place dans une position de regard. Il y a celui qui regarde (shahid — le témoin) et celui qui est regardé (mashhud — le témoigné). Suis-je témoin de la vérité ou témoin de mon propre intérêt ? Suis-je témoigné — c'est-à-dire, mes actes sont-ils visibles ? Le miroir me rappelle que rien n'échappe au regard divin.`,
  reflection: `Nous sommes à la fois témoins et témoignés. Nos regards et nos actes sont comptés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le témoin (shahid) et le témoigné (mashhud). Double perspective de la conscience." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je témoigne ? Qu'est-ce que je laisse témoigner de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le Témoin suprême. Nous sommes témoignés par Lui avant même de témoigner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un témoin silencieux. Chaque atome « observe » et « est observé »." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai témoin est celui qui témoigne de la vérité même quand elle le dérange." }
  ],
  munajat: `Ya Shahid, Tu me vois et Tu es témoin de tout. Fais que je sois un témoin véridique, pas un témoin de complaisance.`
};

MIROIR["85:4"] = {
  reference: "85:4",
  theme: ["force", "justice", "méditation"],
  emotion: "Gravité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Muntaqim"],
  mirrorVersion: `« Périssent les gens du fossé ! » Le miroir me place devant une histoire tragique. Les « ashâb al-ukhdud » — les gens du fossé — étaient des oppresseurs qui avaient creusé une tranchée de feu pour y jeter les croyants. Allah les a fait périr. Le miroir m'avertit : l'oppression ne paie pas. Le pouvoir temporel n'est rien face à la justice divine.`,
  reflection: `L'histoire des gens du fossé est un rappel éternel : la vérité peut être persécutée mais jamais détruite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les ashâb al-ukhdud — les gens du fossé, les oppresseurs qui brûlaient les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels fossés ai-je creusés ? Quelles oppressions ai-je commises ou tolérées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu des oppresseurs devient leur propre châtiment. L'instrument de torture se retourne contre son créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de fossés. Chaque époque a ses oppresseurs et ses martyrs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les martyrs du fossé sont vivants auprès de leur Seigneur. Le feu ne consume que les corps." }
  ],
  munajat: `Ya Allah, préserve-moi d'être un oppresseur et donne-moi la force de supporter l'oppression. Ne me laisse pas creuser de fossés.`
};

MIROIR["85:5"] = {
  reference: "85:5",
  theme: ["force", "justice", "méditation"],
  emotion: "Gravité, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Qawi", "Al-Jabbar"],
  mirrorVersion: `« Du feu alimenté en combustible. » Le miroir détaille le châtiment des oppresseurs. Le feu (nar) est « dhâti waqud » — plein de combustible, intensément ardent. L'enfer n'est pas une métaphore floue. Il est une réalité brûlante. Le miroir m'avertit : les conséquences des actes sont concrètes.`,
  reflection: `Le feu de l'enfer n'est pas une invention. Il est la conséquence logique du mal commis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le feu (nar) avec son combustible (waqud). Une image terrifiante de l'enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui « alimente » mes passions destructrices ? Quel combustible attise mes feux intérieurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu qui devait consumer les croyants a consumé les oppresseurs. La justice est un cercle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu existe dans la création. Il purifie ou détruit selon l'usage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'enfer n'est pas la volonté première d'Allah. Il est la conséquence du refus de Sa miséricorde." }
  ],
  munajat: `Ya Allah, épargne-moi le feu. Préserve-moi de l'alimenter par mes mauvaises actions. Refroidis mes passions par Ta miséricorde.`
};

MIROIR["85:6"] = {
  reference: "85:6",
  theme: ["justice", "force", "méditation"],
  emotion: "Effroi, consternation",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Ash-Shahid"],
  mirrorVersion: `« Alors qu'ils étaient assis autour. » Le miroir montre une scène terrifiante : les oppresseurs assis (qu'ud) autour du fossé, spectateurs du massacre. Ils assistent à l'horreur sans rien faire. Pire, ils la provoquent. Le miroir m'interroge : suis-je spectateur d'injustices ? Assis confortablement pendant que d'autres souffrent ?`,
  reflection: `La passivité face à l'injustice est une forme de complicité. Être assis ne dispense pas de responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ils étaient assis (qu'ud) — spectateurs passifs devenant complices actifs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je assis ? De quelle souffrance suis-je le spectateur silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les spectateurs seront jugés avec les acteurs. La passivité ne protège pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité assiste à tant de fossés. La question n'est pas « qui brûle ? » mais « qui regarde ? »" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le spectacle de la souffrance endurcit le cœur. Celui qui regarde sans agir devient pierre." }
  ],
  munajat: `Ya Allah, ne me laisse pas être un spectateur passif. Donne-moi le courage d'agir face à l'injustice. Lève-moi de mon siège.`
};

MIROIR["85:7"] = {
  reference: "85:7",
  theme: ["justice", "force", "méditation"],
  emotion: "Indignation, colère sainte",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Khabir"],
  mirrorVersion: `« Et ils témoignaient de ce qu'ils faisaient aux croyants. » Le miroir ajoute une dimension terrifiante : les oppresseurs n'étaient pas seulement spectateurs — ils témoignaient (shuhud) de leur propre crime. Ils s'en vantaient peut-être. Le miroir m'interroge : de quoi suis-je témoin dans ma vie ? Qu'est-ce que je regarde avec complaisance ?`,
  reflection: `Être témoin de ses propres crimes sans se repentir est le comble de l'aveuglement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ils témoignaient (yashhadun) — regard attentif, complicité active, peut-être même jouissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je regarde avec complaisance ? Quelles actions « témoigné-je » sans les condamner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qu'ils regardaient deviendra leur propre spectacle au Jour du Jugement. Le témoin devient témoigné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'œil humain peut être témoin de grâce ou témoin d'horreur. Le choix du regard définit l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regarde le mal sans le condamner porte le mal en lui." }
  ],
  munajat: `Ya Basir, purifie mon regard. Fais que je ne sois témoin que de la vérité et de la justice. Ne me laisse pas complaire dans le mal.`
};

MIROIR["85:8"] = {
  reference: "85:8",
  theme: ["force", "confiance", "espérance"],
  emotion: "Éclaircissement, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Aziz", "Al-Hamid"],
  mirrorVersion: `« Et ils ne leur reprochaient que d'avoir cru en Allah, le Puissant, le Digne de louanges. » Le miroir révèle le « crime » des croyants : avoir cru. Pas de vol, pas de meurtre, pas de trahison — simplement la foi en Allah Al-Aziz (le Puissant) et Al-Hamid (le Digne de louanges). Le miroir m'interroge : qu'est-ce qu'on me reproche ? Ma foi ? Ou mes fautes ? Si c'est ma foi, je suis en bonne compagnie.`,
  reflection: `La vraie foi dérange. Elle est persécutée précisément parce qu'elle est vraie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Leur seul tort : croire en Allah Al-Aziz (Puissant) et Al-Hamid (Digne de louanges)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'on me reproche ? Ma foi ou mes erreurs ? Si c'est ma foi, je suis béni." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le reproche des oppresseurs est un honneur. Être persécuté pour Allah est la plus grande distinction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous été reprochés pour leur foi. Le chemin de la vérité est semé d'oppositions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est blâmé pour sa foi ne devrait pas se blâmer lui-même. Le blâme des hommes est l'éloge d'Allah." }
  ],
  munajat: `Ya Aziz, ya Hamid, si on me reproche ma foi, fais que je la porte avec fierté. Ne me laisse pas hésiter devant l'opposition.`
};

MIROIR["85:9"] = {
  reference: "85:9",
  theme: ["confiance", "force", "sagesse"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Malik", "Al-Mulk"],
  mirrorVersion: `« Auquel appartient la royauté des cieux et de la terre. » Le miroir élargit la perspective : Allah est le Roi (Malik) des cieux et de la terre. Les oppresseurs avaient un pouvoir temporaire sur un petit territoire. Allah possède tout l'univers. Le miroir me rappelle : les puissances de ce monde sont limitées. La vraie puissance est ailleurs.`,
  reflection: `La royauté d'Allah englobe tout. Les rois de la terre ne possèdent que ce qu'Il leur prête.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Lahu mulku as-samawati wa al-ard — À Lui la royauté des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De qui ai-je peur ? Des rois de la terre ou du Roi des cieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les oppresseurs n'étaient que des locataires temporaires. Allah est le Propriétaire éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque étoile, chaque planète, chaque atome appartient à Allah. Sa royauté est absolue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la royauté d'Allah ne craint plus la prétention des tyrans." }
  ],
  munajat: `Ya Malik al-mulk, Tu possèdes tout. Les puissants de la terre ne sont rien devant Toi. Fais que je Te craigne, Toi le Vrai Roi.`
};

MIROIR["85:10"] = {
  reference: "85:10",
  theme: ["force", "justice", "méditation"],
  emotion: "Gravité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui font subir des épreuves aux croyants et aux croyantes, puis ne se repentent pas, auront le châtiment de l'Enfer. » Le miroir montre que la persécution n'est pas seulement physique — elle est aussi spirituelle. « Fitna » désigne l'épreuve, la tentation, la mise à l'épreuve. Persécuter les croyants est un crime. Mais ne pas se repentir (tawba) est pire. Le miroir m'interroge : ai-je fait du mal à quelqu'un ? Me suis-je repenti ?`,
  reflection: `Le repentir efface même les crimes les plus graves. Son absence les aggrave.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La fitna contre les croyants + absence de repentir = châtiment de l'enfer (jahim)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je fait subir des épreuves à quelqu'un ? Ai-je demandé pardon ? À Allah ? À la personne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir est toujours possible. La porte reste ouverte jusqu'au dernier souffle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfer n'est pas la volonté première d'Allah. C'est la conséquence du refus de revenir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand crime n'est pas l'acte lui-même — c'est l'absence de regret après l'acte." }
  ],
  munajat: `Ya Tawwab, si j'ai fait du mal, donne-moi la force de me repentir. Ne me laisse pas dans l'aveuglement. Accepte mon retour.`
};

MIROIR["85:11"] = {
  reference: "85:11",
  theme: ["espoir", "confiance", "force"],
  emotion: "Réconfort, promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« Mais ceux qui croient et accomplissent de bonnes œuvres auront des Jardins sous lesquels coulent les rivières. » Le miroir contraste le sort des oppresseurs avec celui des croyants. Les Jardins (jannat) avec des rivières (anhar) — une image de fraîcheur et de vie. Cette promesse est pour ceux qui croient (amanu) ET font de bonnes œuvres (amilu as-salihat). Le miroir m'interroge : ma foi se traduit-elle en actes ?`,
  reflection: `La foi sans les œuvres est incomplète. Les jardins sont promis à ceux qui croient ET agissent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Foi + bonnes œuvres = Jardins avec rivières. La formule est claire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi se voit-elle dans mes actes ? Qu'ai-je fait de bon aujourd'hui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu des oppresseurs contraste avec l'eau des Jardins. Chaque choix a sa conséquence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les rivières coulent vers la mer. Les âmes coulent vers leur destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Paradis n'est pas une récompense lointaine — il commence dans le cœur qui croit et agit." }
  ],
  munajat: `Ya Ghafur, ya Rahim, fais que ma foi produise des fruits. Conduis-moi aux Jardins. Donne-moi d'être du nombre de ceux qui croient et agissent.`
};

MIROIR["85:12"] = {
  reference: "85:12",
  theme: ["force", "confiance", "méditation"],
  emotion: "Révérence, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Jabbar"],
  mirrorVersion: `« Le châtiment de ton Seigneur est redoutable. » Le miroir place la grandeur divine en face de moi. « Batsh » désigne la prise, l'emprise, la force contraignante. Le châtiment d'Allah n'est pas une menace vide — il est une réalité redoutable (shadid). Le miroir m'invite à la vigilance : ne pas prendre Sa miséricorde pour acquise.`,
  reflection: `La miséricorde d'Allah est immense, mais Sa justice est implacable. Les deux faces de la réalité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Batsh (l'emprise) de ton Seigneur est shadid (redoutable, intense, violent)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si Allah n'était que miséricordieux ? Où est la crainte de Sa justice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La même main qui châtie les oppresseurs caresse les repentants. La force n'est pas cruelty." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à des lois précises. La désobéissance a des conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la batsh d'Allah ne la subira jamais. La crainte est protection." }
  ],
  munajat: `Ya Rabb, Ta force est redoutable. Fais que je Te craigne suffisamment pour ne jamais Te décevoir. Protège-moi de Ton châtiment.`
};

MIROIR["85:13"] = {
  reference: "85:13",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Révérence, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Badi", "Al-Mu'id"],
  mirrorVersion: `« C'est Lui qui crée et recrée. » Le miroir me place devant le cycle de la création. « Insha' » — créer initialement. « I'ada » — recréer, restaurer, ressusciter. Allah commence et recommence. La mort n'est pas une fin — elle est une transition vers une nouvelle création. Le miroir m'interroge : crois-je en la résurrection ? Vis-je comme si cette vie était la seule ?`,
  reflection: `La création n'est pas un acte unique passé. Elle est un processus continu avec une résurrection finale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Insha' (créer) et i'ada (recréer, ressusciter). Le cycle divin de l'existence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crée dans ma vie ? Qu'est-ce que je recrée ? Quelle résurrection prépare-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin mais le passage vers la recréation. L'horreur du fossé devient la gloire du Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature meurt et renaît chaque saison. L'univers entier témoigne du cycle créer/recréer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la recréation ne craint plus la mort. Elle n'est qu'un nouveau début." }
  ],
  munajat: `Ya Badi', ya Mu'id, Tu crées et recrées. Prépare-moi pour la résurrection. Fais que chaque jour soit une recréation de moi-même.`
};

MIROIR["85:15"] = {
  reference: "85:15",
  theme: ["méditation", "présence", "force"],
  emotion: "Révérence, humilité",
  difficulty: "débutant",
  relatedNames: ["Dhul-Arsh", "Al-Majid"],
  mirrorVersion: `« Le Possesseur du Trône, le Glorieux. » Le miroir élève mon regard vers le Trône divin (arsh). Ce Trône qui s'étend sur les cieux et la terre — symbole de la souveraineté absolue d'Allah. Et Il est Majid — Glorieux, Majestueux, Digne d'éloges. Le miroir m'interroge : comment puis-je me prendre au sérieux face à une telle Majesté ?`,
  reflection: `Le Trône d'Allah est la plus grande création. Le posséder est la plus haute souveraineté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Dhul-arsh al-majid — Possesseur du Trône Glorieux. La souveraineté absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma « gloire » ? À quel trône m'assois-je dans mon imagination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Trône d'Allah englobe tout. Je suis porté par Lui, pas porteur de Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Trône soutient l'univers. L'univers est une manifestation de la gloire divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le Trône ne cherche plus d'autre trône. Sa majesté intérieure suffit." }
  ],
  munajat: `Ya Dhul-arsh, Tu es Glorieux. Fais que je ne cherche pas la gloire ailleurs qu'en Toi. Humilie-moi devant Ta Majesté.`
};

MIROIR["85:16"] = {
  reference: "85:16",
  theme: ["force", "confiance", "méditation"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Fa'al", "Al-Murid"],
  mirrorVersion: `« Il fait ce qu'Il veut. » Le miroir me place devant la souveraineté absolue d'Allah. « Fa'al » — Il agit. « Lima yurid » — ce qu'Il veut. Pas de contrainte, pas d'obstacle, pas de limite. Allah fait exactement ce qu'Il décide. Le miroir m'interroge : comment réagis-je à ce que fait Allah ? Est-ce que j'accepte ou est-ce que je conteste ?`,
  reflection: `La volonté d'Allah est souveraine. L'accepter est le cœur de la soumission (islam).`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Fa'alun lima yurid — Faiseur de ce qu'Il veut. La volonté divine est absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand Allah fait quelque chose qui me déplaît, comment réagis-je ? Acceptation ou rébellion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah fait ce qu'Il veut, pourquoi m'inquiéter ? Sa volonté est le meilleur des plans." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Sa volonté. Seul l'homme peut choisir de s'y opposer — à ses dépens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la volonté d'Allah la précède. Il veut ce qu'Allah veut et devient ainsi libre." }
  ],
  munajat: `Ya Fa'al, fais ce que Tu veux. Je m'y soumets. Donne-moi de vouloir ce que Tu veux. Unifie ma volonté avec la Tienne.`
};

MIROIR["85:17"] = {
  reference: "85:17",
  theme: ["sagesse", "méditation", "force"],
  emotion: "Rappel, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Hakim"],
  mirrorVersion: `« T'est-il parvenu le récit des armées ? » Le miroir m'invite à me souvenir de l'histoire. Les « junud » — les armées, les troupes — désignent les puissances qui se sont opposées aux prophètes. Pharaon, les 'Ad, les Thamud... Toutes ces puissances ont péri. Le miroir m'interroge : connais-je l'histoire ? En tire-je des leçons ?`,
  reflection: `L'histoire est un maître. Ceux qui ne s'en souviennent pas la répètent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les armées (junud) — les puissances qui ont combattu les prophètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon « armée » ? De quel côté suis-je ? Oppresseur ou opprimé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les armées des oppresseurs sont devenues des leçons. Leur force est devenue faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un miroir. Les civilisations passent, la vérité reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les armées d'Allah ne sont pas visibles. Celles qui gagnent vraiment sont les invisibles." }
  ],
  munajat: `Ya Khabir, fais que je retienne les leçons de l'histoire. Ne me laisse pas répéter les erreurs des armées perdues.`
};

MIROIR["85:18"] = {
  reference: "85:18",
  theme: ["méditation", "force", "sagesse"],
  emotion: "Rappel, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Muntaqim"],
  mirrorVersion: `« De Pharaon et des Thamud ? » Le miroir cite deux exemples célèbres d'oppression punie. Pharaon — le tyran qui a dit « Je suis votre seigneur suprême » et qui a été noyé. Les Thamud — le peuple qui a tué la chamelle et a été anéanti. Le miroir m'avertit : ces exemples ne sont pas que des histoires — ils sont des avertissements.`,
  reflection: `Pharaon et les Thamud sont les archétypes de l'oppression. Leur fin est l'avertissement éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Pharaon (Fir'awn) et les Thamud. Deux empires, deux chutes, deux leçons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel Pharaon en moi ? Quelle Thamud dans mon entourage ? Où est l'oppression ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Leur puissance n'a servi à rien. Leur mémoire est devenue un avertissement, pas un exemple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ruines de ces civilisations existent encore. La terre garde la mémoire des châtiments." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Pharaon existe en chaque époque. Les Thamud sont éternels. La question : où suis-je ?" }
  ],
  munajat: `Ya Allah, préserve-moi du pharaonisme. Ne me laisse pas m'enfler d'orgueil. Fais que je sois du côté des opprimés, pas des oppresseurs.`
};

MIROIR["85:19"] = {
  reference: "85:19",
  theme: ["méditation", "sagesse", "force"],
  emotion: "Mise en garde, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Mais ceux qui ont mécru persistent à traiter de mensonge. » Le miroir montre le tragique du déni. Les mécréants (alladhina kafaru) sont dans une « takdhib » — une accusation de mensonge, un rejet de la vérité. Ils persistent (yukadhdhibun) malgré les signes. Le miroir m'interroge : qu'est-ce que je traite de mensonge ? Quelle vérité refuse-je de voir ?`,
  reflection: `Le déni est une prison volontaire. On y reste tant qu'on refuse de voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La takdhib — le fait de traiter de mensonge. Le rejet obstiné de la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse de croire ? Quelle vérité me dérange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Traiter la vérité de mensonge ne change pas la vérité — cela change seulement celui qui le fait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame la vérité. Le nier n'efface rien. Le croyant s'aligne sur le réel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le déni est une protection illusoire. On croit se protéger de la vérité, mais on s'enfonce." }
  ],
  munajat: `Ya Haqq, ne me laisse pas dans le déni. Ouvre mes yeux sur la vérité, même si elle me fait mal. Je préfère la vérité qui blesse au mensonge qui rassure.`
};

MIROIR["85:20"] = {
  reference: "85:20",
  theme: ["force", "confiance", "sagesse"],
  emotion: "Réconfort, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Muhit", "Al-Khabir"],
  mirrorVersion: `« Et Allah les cerne par derrière. » Le miroir me rassure : les mécréants peuvent comploter, ils peuvent persécuter, mais Allah les « cerne » (muhit). Il est derrière eux, autour d'eux, au-dessus d'eux. Pas d'échappatoire. Le miroir me rappelle : les oppresseurs ne sont jamais hors d'atteinte de la justice divine.`,
  reflection: `Allah cerne tout. Nulle fuite possible hors de Sa sphère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Allahu min wara'ihim muhit — Allah les cerne par derrière. Son emprise est totale." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si Allah me cerne, où puis-je aller ? Nulle part. Je suis toujours dans Sa main." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les oppresseurs croient encercler les croyants. En réalité, ils sont eux-mêmes encerclés par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est dans la main d'Allah. Rien n'existe hors de Sa sphère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être cerné par Allah est une prison pour l'oppresseur mais un refuge pour le croyant." }
  ],
  munajat: `Ya Muhit, Tu m'entoures de toutes parts. Je ne peux pas T'échapper — et je ne le veux pas. Sois mon refuge, pas ma prison.`
};

MIROIR["85:21"] = {
  reference: "85:21",
  theme: ["présence", "méditation", "force"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« C'est au contraire un Coran glorieux. » Le miroir recentre tout sur le Coran. Ce Livre que les mécréants traitent de mensonge est en réalité « majid » — glorieux, noble, majestueux. Le miroir m'invite à reconsidérer le Coran : est-ce que je le traite avec la gloire qu'il mérite ?`,
  reflection: `Le Coran n'est pas un livre ordinaire. Sa gloire transcende les dénégations humaines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Qur'anun majid — Un Coran glorieux. Noble, majestueux, digne d'honneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite le Coran ? Avec la gloire qu'il mérite ? Ou avec négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les mécréants le nient, mais sa gloire n'en est pas diminuée. La vérité n'a pas besoin d'être crue pour être vraie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le message final à l'humanité. Sa gloire est pour tous les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la gloire du Coran est lui-même glorifié par son étude." }
  ],
  munajat: `Ya Rabb du Coran glorieux, fais que je Le traite avec l'honneur qu'il mérite. Illumine-moi par sa lecture. Fais que je ne sois pas de ceux qui Le nient.`
};

MIROIR["85:22"] = {
  reference: "85:22",
  theme: ["méditation", "sagesse", "confiance"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Lawh"],
  mirrorVersion: `« Sur une Table gardée. » Le miroir élève mon regard vers la Table préservée (al-lawh al-mahfuz). Le Coran n'est pas une composition humaine — il est gravé sur une Table céleste, gardée, préservée de toute altération. Le miroir m'invite à la confiance : ce que je lis est exactement ce qui a été révélé.`,
  reflection: `Le Coran est préservé éternellement. Aucune altération ne peut l'atteindre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Fi lawhin mahfuz — Sur une Table gardée, préservée, protégée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si le Coran est sur une Table gardée, qu'est-ce que je garde ? Qu'est-ce que je protège ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est gardé par Allah. Nous n'avons pas à le protéger — il nous protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Table préservée contient tout. Le Coran en est une manifestation dans le temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écrit le Coran dans son cœur possède une Table gardée en lui." }
  ],
  munajat: `Ya Hafiz, Tu as gardé le Coran sur la Table préservée. Garde-le aussi dans mon cœur. Préserve-moi de l'égarement.`
};

