    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur cette réunion ? L'ordre sera-t-il transformé en moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réunion révèle la fin des opposés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera transformé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la transformation se transforme." }
  ],
  munajat: `Ya Rabb, médite sur la transformation. Transforme-moi pour ce Jour.`
};

MIROIR["75:10"] = {
  reference: "75:10",
  theme: ["fuite", "question", "désespoir"],
  emotion: "Désespoir, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Firar", "Al-Mahil"],
  mirrorVersion: `« L'homme dira ce jour-là : Où fuir ? » La question de la fuite. Le miroir m'enseigne : ce Jour-là, il n'y a pas de fuite possible. La question révèle le désespoir de ceux qui n'ont pas cru.`,
  reflection: `Ce Jour-là, il n'y a pas de fuite possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaqulu al-insanu yawma-idhin ayna al-mahar » — l'homme dira ce jour-là : où fuir ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour ce Jour ? Ou est-ce que je serai parmi ceux qui demandent où fuir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation évite la question de la fuite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a pas de fuite de la présence d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas besoin de fuir." }
  ],
  munajat: `Ya Rabb, je me prépare. Ne permets pas que je demande où fuir.`
};

MIROIR["75:11"] = {
  reference: "75:11",
  theme: ["refuge", "impossibilité", "jour"],
