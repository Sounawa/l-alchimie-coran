MIROIR["77:25"] = {
  reference: "77:25",
  theme: ["terre", "contenance", "accueil"],
  emotion: "Gratitude, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Jami'"],
  mirrorVersion: `« N'avons-Nous pas fait de la terre un lieu de réunion ? » Le miroir me montre la fonction de la terre. « Alam naj'al al-arda kifatan » — n'avons-Nous pas fait de la terre un lieu de réunion ? L'accueil. Le miroir m'enseigne : la terre rassemble les vivants et les morts.`,
  reflection: `La terre rassemble tout. Elle accueille les vivants et les morts.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam naj'al al-arda kifatan » — n'avons-Nous pas fait de la terre un lieu de réunion ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre m'accueille. Comment l'utilise-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre est un lieu de passage vers l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre rassemble toutes les créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la fonction de la terre se prépare." }
  ],
  munajat: `Ya Rabb, la terre est mon lieu de réunion temporaire. Prépare-moi pour l'éternité.`
};

MIROIR["77:26"] = {
  reference: "77:26",
  theme: ["vivants", "morts", "réunion"],
  emotion: "Méditation, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ahya'", "Al-Amwat"],
  mirrorVersion: `« Pour les vivants et les morts ? » Le miroir me montre le rassemblement universel. « Ahya'an wa amwatan » — pour les vivants et les morts. Le rassemblement. Le miroir m'enseigne : tous se retrouvent sur la terre.`,
  reflection: `Vivants et morts sont rassemblés sur la terre. La transition est constante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ahya'an wa amwatan » — pour les vivants et les morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Je suis parmi les vivants. Comment vis-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie est une préparation pour la mort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers contient la vie et la mort en harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit bien meurt bien." }
  ],
  munajat: `Ya Rabb, je suis vivant. Fais que je vive bien pour mourir bien. Rassemble-moi avec les croyants.`
};

MIROIR["77:27"] = {
  reference: "77:27",
  theme: ["montagnes", "stabilité", "hauteur"],
  emotion: "Méditation, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jibal", "Al-Rawasi"],
  mirrorVersion: `« Et y avons placé des montagnes fermement enracinées. » Le miroir me montre la stabilité. « Wa ja'alna fiha rawasiya shamikhatin » — et y avons placé des montagnes fermement enracinées. La stabilité. Le miroir m'enseigne : les montagnes stabilisent la terre.`,
  reflection: `Les montagnes stabilisent la terre. La stabilité est un don d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna fiha rawasiya shamikhatin » — et y avons placé des montagnes fermement enracinées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je stable comme les montagnes ? Ou chancelant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est la montagne qui stabilise le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont les piliers de la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une foi ferme est stable comme les montagnes." }
  ],
  munajat: `Ya Rabb, donne-moi une foi ferme comme les montagnes. Stabilise mon cœur dans la vérité.`
};

MIROIR["77:28"] = {
  reference: "77:28",
  theme: ["eau", "bénédiction", "vie"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'", "Ar-Rizq"],
  mirrorVersion: `« Et y avons fait jaillir des eaux douces. » Le miroir me montre la provision. « Wa sakkanakum min ma'in furatin » — et y avons fait jaillir des eaux douces. La bénédiction. Le miroir m'enseigne : l'eau douce est un don précieux.`,
  reflection: `L'eau douce est une bénédiction. La gratitude est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sakkanakum min ma'in furatin » — et y avons fait jaillir des eaux douces." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je reconnaissant pour l'eau douce ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude pour l'eau mène à la gratitude pour toutes les bénédictions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau douce est la source de toute vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour l'eau reçoit plus de bénédictions." }
  ],
  munajat: `Ya Rabb, merci pour l'eau douce. Je suis reconnaissant pour cette bénédiction. Multiplie Tes faveurs sur moi.`
};

