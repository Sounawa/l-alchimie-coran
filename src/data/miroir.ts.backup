    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les montagnes stables seront transformées. Qu'en sera-t-il de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Seule la foi reste stable quand tout change." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transformation est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une foi stable reste stable même quand tout change." }
  ],
  munajat: `Ya Rabb, donne-moi une foi stable. Quand tout change, garde-moi stable en Toi.`
};

