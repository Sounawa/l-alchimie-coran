  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Jaza'"],
  mirrorVersion: `« Et Il les récompensera pour leur endurance en leur donnant un jardin et des vêtements de soie. » La récompense de la patience. Le miroir m'enseigne : la patience mène au jardin.`,
  reflection: `La patience mène au jardin et aux vêtements de soie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa jazahum bima sabaru jannatan wa harira » — et Il les récompensera pour leur endurance en leur donnant un jardin et des vêtements de soie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente ? La récompense est-elle mon espérance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience attire la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La patience est la clé du jardin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente reçoit le jardin." }
  ],
  munajat: `Ya Rabb, je patiente. Récompense-moi avec le jardin.`
};

MIROIR["76:13"] = {
