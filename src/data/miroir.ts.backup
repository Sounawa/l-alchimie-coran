  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Qaum"],
  mirrorVersion: `« Quand il dit à son peuple : 'Ne craignez-vous pas ?' » Le miroir me montre l'appel prophétique. « Idh qaala li-qaumihi alaa tattaqoon » — quand il dit à son peuple : ne craignez-vous pas ? L'appel. Élie appelle son peuple à la piété. Le miroir m'enseigne : le prophète commence par l'appel à la piété.`,
  reflection: `Le prophète commence toujours par l'appel à la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh qaala li-qaumihi alaa tattaqoon » — quand il dit à son peuple : ne craignez-vous pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah comme je devrais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel à la piété est le premier message de chaque prophète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier craint Allah par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte d'Allah est le début de la sagesse." }
  ],
  munajat: `Ya Rabb, fais que je Te craigne vraiment. Ouvre mon cœur à Ta piété.`
};

MIROIR["37:125"] = {
  reference: "37:125",
  theme: ["idolâtrie", "tawhid", "créateur"],
  emotion: "Avertissement, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Ar-Rabb"],
  mirrorVersion: `« Invoquez-vous Baal et délaissez-vous le meilleur des créateurs ? » Le miroir me montre le choix spirituel. « Atad'oonu ba'lan wa tazaroonal-khalqal-akbar » — invoquez-vous Baal et délaissez-vous le meilleur des créateurs ? La question. Élie confronte son peuple à leur idolâtrie. Le miroir m'invite à examiner mes propres idoles.`,
  reflection: `Le choix entre les idoles et le Créateur est fondamental.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Atad'oonu ba'lan wa tazaroonal-khalqal-akbar » — invoquez-vous Baal et délaissez-vous le meilleur des créateurs ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles idoles invoqué-je à la place d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole est toujours inférieure au Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas d'autres idoles que son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le meilleur des créateurs est le seul digne d'adoration." }
  ],
  munajat: `Ya Rabb, Tu es le meilleur des créateurs. Je délaisse toutes les idoles pour Toi seul.`
};

MIROIR["37:126"] = {
  reference: "37:126",
  theme: ["seigneur", "unicité", "adoration"],
  emotion: "Reconnaissance, tawhid",
  difficulty: "débutant",
  relatedNames: ["Allah", "Ar-Rabb"],
  mirrorVersion: `« Allah, votre Seigneur et le Seigneur de vos ancêtres les plus anciens. » Le miroir me montre la continuité divine. « Allaha rabbakum wa rabba aaba'ikumul-awwaleen » — Allah, votre Seigneur et le Seigneur de vos ancêtres les plus anciens. L'affirmation. Allah est le Seigneur de tous les temps. Le miroir m'enseigne : le Seigneur d'Allah transcende les générations.`,
  reflection: `Allah est le Seigneur de tous les temps et de toutes les générations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allaha rabbakum wa rabba aaba'ikumul-awwaleen » — Allah, votre Seigneur et le Seigneur de vos ancêtres les plus anciens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Allah comme Seigneur de mes ancêtres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Seigneur des ancêtres est aussi le Seigneur des descendants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reconnaît Allah comme son unique Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La seigneurie d'Allah est éternelle et universelle." }
  ],
  munajat: `Ya Rabb, Tu es mon Seigneur et le Seigneur de mes ancêtres. Je T'adore seul.`
};

MIROIR["37:127"] = {
  reference: "37:127",
  theme: ["rejet", "mécréance", "prophète"],
  emotion: "Tristesse, constatation",
  difficulty: "débutant",
  relatedNames: ["Al-Takdhib", "Al-Kufr"],
  mirrorVersion: `« Mais ils le traitèrent de menteur. » Le miroir me montre le rejet des prophètes. « Fakadhdhboohu » — mais ils le traitèrent de menteur. Le rejet. Le peuple d'Élie refuse son message. « Fa-innahum lamuhaadaroona » — ils seront certainement amenés. La conséquence. Le miroir m'avertit : le rejet de la vérité a des conséquences.`,
  reflection: `Le rejet des prophètes entraîne des conséquences graves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakadhdhboohu fa-innahum lamuhaadaroona » — mais ils le traitèrent de menteur. Ils seront certainement amenés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite la vérité de mensonge ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le menteur est celui qui rejette la vérité, pas le prophète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas — il témoigne de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les conséquences du rejet sont inévitables." }
  ],
  munajat: `Ya Rabb, ne permets pas que je traite Tes prophètes de menteurs. Ouvre mon cœur à la vérité.`
};

MIROIR["37:128"] = {
  reference: "37:128",
  theme: ["exception", "élite", "sincérité"],
  emotion: "Espoir, distinction",
  difficulty: "débutant",
  relatedNames: ["Al-Mukhlas", "Al-Ibad"],
  mirrorVersion: `« Sauf les serviteurs sincères d'Allah. » Le miroir me montre l'exception sauvée. « Illaa 'ibaadal-Allahil-mukhlaseen » — sauf les serviteurs sincères d'Allah. L'exception. Parmi le peuple d'Élie, les sincères seront sauvés. Le miroir m'invite à la sincérité.`,
  reflection: `La sincérité envers Allah sauve du châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illaa 'ibaadal-Allahil-mukhlaseen » — sauf les serviteurs sincères d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les serviteurs sincères d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité est la clé du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sincère envers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les serviteurs sincères sont les bien-aimés d'Allah." }
  ],
  munajat: `Ya Rabb, purifie mon intention. Fais que je sois parmi Tes serviteurs sincères.`
};

MIROIR["37:129"] = {
  reference: "37:129",
  theme: ["mémoire", "héritage", "postérité"],
  emotion: "Honneur, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ath-Thikra", "Al-Ajal"],
  mirrorVersion: `« Et perpétuâmes son souvenir parmi les générations suivantes. » Le miroir me montre l'héritage éternel. « Wa taraknaa 'alayhi fee al-aakhireen » — et perpétuâmes son souvenir parmi les générations suivantes. La mémoire. Élie est honoré à travers les siècles. Le miroir m'enseigne : les prophètes ne sont jamais oubliés.`,
  reflection: `Les prophètes d'Allah ne sont jamais oubliés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa taraknaa 'alayhi fee al-aakhireen » — et perpétuâmes son souvenir parmi les générations suivantes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel souvenir laisserai-je aux générations futures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mémoire éternelle vient de l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la mémoire de tous les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le souvenir d'Allah est plus précieux que toute renommée." }
  ],
  munajat: `Ya Rabb, perpétue mon souvenir en bien. Que les générations futures se souviennent de Ta grâce.`
};

MIROIR["37:130"] = {
  reference: "37:130",
  theme: ["paix", "prophète", "salut"],
  emotion: "Paix, révérence",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Ilyas"],
  mirrorVersion: `« Paix sur Élie ! » Le miroir me montre la salutation divine. « Salaamun 'alaa ilyaaseen » — paix sur Élie ! La bénédiction. Après Ibrahim, Moïse et Aaron, Élie reçoit la paix d'Allah. Le miroir m'enseigne : la paix est la récompense de tous les prophètes.`,
  reflection: `La paix d'Allah est la récompense de tous les prophètes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salaamun 'alaa ilyaaseen » — paix sur Élie !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recherche la paix d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix d'Allah descend sur tous les prophètes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en paix avec ses prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La paix éternelle est le trésor des croyants." }
  ],
  munajat: `Ya Salam, que Ta paix soit sur Élie et sur moi aussi. Accorde-moi Ta paix.`
};

// ==================== SURAH 80: 'ABASA - ADDITIONAL ENTRIES ====================

MIROIR["80:2"] = {
  reference: "80:2",
  theme: ["guidance", "aveugle", "préoccupation"],
  emotion: "Questionnement, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« L'aveugle est venu à toi. » Le miroir me montre une scène précise : un homme aveugle, Abdullah ibn Umm Maktum, vient vers le Prophète cherchant la guidance. Mais le Prophète était occupé avec les notables de Quraysh. Le miroir m'interroge : qui est-ce que j'ignore parce que je suis occupé avec des « plus importants » ? La guidance ne doit pas être réservée aux élites.`,
  reflection: `L'aveugle est venu chercher la lumière. Le voyant l'a ignoré. Qui suis-je en train d'ignorer ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An ja'ahu al-a'ma » — l'aveugle est venu à lui. Un homme aveugle cherche la guidance spirituelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ignore ceux qui viennent à moi parce que je suis préoccupé par les « importants » ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveugle voyait mieux que le voyant — il voyait ce qui comptait vraiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie vue n'est pas dans les yeux mais dans le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vient à Allah avec un cœur sincère est plus important que le riche qui vient par curiosité." }
  ],
  munajat: `Ya Hadi, ne permets pas que j'ignore celui qui vient à Toi. Ouvre mes yeux à tous ceux qui cherchent la guidance.`
};

MIROIR["80:3"] = {
  reference: "80:3",
  theme: ["purification", "rappel", "croissance"],
  emotion: "Espoir, possibilité",
  difficulty: "débutant",
  relatedNames: ["Al-Tahir", "Al-Muzakki"],
  mirrorVersion: `« Qu'en sais-tu ? Peut-être se purifierait-il. » Le miroir me montre la limitation de mon jugement. Je ne connais pas le cœur des autres. Celui que j'ignore peut-être est en train de se purifier. Celui que je méprise peut-être est plus proche d'Allah que moi. Le miroir m'enseigne : ne jugez pas les apparences.`,
  reflection: `Seul Allah connaît le cœur. L'apparence ne révèle pas la purification intérieure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yudrika la'allahu yazakka » — qu'en sais-tu ? Peut-être se purifierait-il." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je juge sans connaître son cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification invisible est plus précieuse que l'apparence visible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La croissance spirituelle est invisible aux yeux mais évidente pour Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ne sous-estime jamais personne — la purification peut être en cours." }
  ],
  munajat: `Ya 'Alim, Tu connais les cœurs. Ne permets pas que je juge par les apparences. Aide-moi à voir la purification en chacun.`
};

MIROIR["80:4"] = {
  reference: "80:4",
  theme: ["rappel", "profit", "guidance"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Dhikra", "Al-Nafi'"],
  mirrorVersion: `« Ou se rappellerait-il et le rappel lui profiterait. » Le miroir me montre le potentiel de transformation. Un simple rappel peut changer une vie. L'aveugle n'avait pas besoin de longs discours — il avait besoin d'être vu, entendu, guidé. Le rappel profitait à son cœur ouvert. Le miroir m'interroge : est-ce que je donne le rappel à ceux qui en ont besoin ?`,
  reflection: `Le rappel transforme le cœur ouvert. Ne refusez le rappel à personne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw yadhakkara fatanfa'ahu al-dhikra » — ou se rappellerait-il et le rappel lui profiterait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que je refuse le rappel ? Et qui m'a donné le rappel quand j'en avais besoin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel donné à bon cœur profite plus que le sermon aux cœurs fermés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole juste au bon moment peut transformer une vie entière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel n'est pas pour l'ego du rappelleur — il est pour le cœur du rappelé." }
  ],
  munajat: `Ya Mudhakkir, fais que je sois un canal de Ton rappel. Donne-moi de voir ceux qui ont besoin d'être rappelés.`
};

MIROIR["80:5"] = {
  reference: "80:5",
  theme: ["richesse", "autosuffisance", "orgueil"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Mustaghni"],
  mirrorVersion: `« Quant à celui qui se montre indifférent. » Le miroir contraste deux attitudes : l'aveugle qui vient chercher et le riche qui se détourne. L'indifférence n'est pas neutre — elle est un choix. Celui qui se croit suffisant n'a pas besoin de guidance. Le miroir m'interroge : suis-je indifférent à la guidance ?`,
  reflection: `L'indifférence à la guidance est un signe d'autosuffisance spirituelle — une illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amma man istaghna » — quant à celui qui se montre indifférent, qui se croit suffisant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis indifférent à la guidance ? Est-ce que je me crois suffisant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'indifférent est en fait le plus besoin — mais il ne le sait pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse matérielle ne suffit jamais — le cœur a besoin de guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai riche est celui qui reconnaît son besoin d'Allah." }
  ],
  munajat: `Ya Ghani, Tu es le seul Riche. Ne permets pas que je me croie suffisant. Toujours j'ai besoin de Ta guidance.`
};

MIROIR["80:6"] = {
  reference: "80:6",
  theme: ["attention", "priorité", "monde"],
  emotion: "Questionnement, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'tani", "Al-A'la"],
  mirrorVersion: `« Tu lui accordes toute ton attention. » Le miroir révèle la tendance humaine : accorder attention aux riches, ignorer les pauvres. Le Prophète lui-même a été corrigé pour ce biais. Le miroir m'interroge : à qui est-ce que j'accorde mon attention ? Pourquoi ?`,
  reflection: `L'attention est une ressource précieuse. À qui l'accordons-nous et pourquoi ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anta lahu tasadda » — tu lui accordes toute ton attention." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que j'accorde mon attention ? Les riches ou les nécessiteux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui reçoit l'attention mondaine n'a pas besoin de plus — mais il la reçoit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monde accorde l'attention à ceux qui en ont le moins besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah regarde le cœur, pas le statut." }
  ],
  munajat: `Ya Rabb, purifie mon attention. Fais que je voie ceux que Tu vois, que j'entende ceux que Tu entends.`
};

MIROIR["80:7"] = {
  reference: "80:7",
  theme: ["responsabilité", "détachement", "liberté"],
  emotion: "Libération, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Bari'"],
  mirrorVersion: `« Qu'il ne se purifie pas, tu n'en es pas responsable. » Le miroir m'enseigne une vérité libératrice : je ne suis pas responsable de la purification des autres. Mon devoir est de transmettre, non de convertir. Le cœur qui refuse la guidance ne m'appartient pas. Le miroir me libère du fardeau des résultats.`,
  reflection: `La responsabilité est dans l'effort, pas dans le résultat. Allah guide qui Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala yal-ka 'alayka haraj » — il n'y a pas de blâme sur toi s'il ne se purifie pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je porte le fardeau des refus des autres ? Le miroir me libère." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus de l'autre n'est pas mon échec — c'est son choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme est responsable d'elle-même. Nous transmettons, Allah décide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La libération des résultats est la véritable liberté spirituelle." }
  ],
  munajat: `Ya Rabb, libère-moi du fardeau des résultats. Je transmets — Tu guides. Je offre — Tu acceptes ou refuses selon Ta sagesse.`
};

MIROIR["80:8"] = {
  reference: "80:8",
  theme: ["crainte", "purification", "sincérité"],
  emotion: "Espoir, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khashi'a", "Al-Tahir"],
  mirrorVersion: `« Quant à celui qui vient à toi avec empressement et crainte. » Le miroir me montre le contraste : l'indifférent qui reçoit l'attention et le craignant qui est ignoré. Pourtant, c'est le craignant qui mérite la priorité. Son cœur est prêt. Sa crainte est la clé. Le miroir m'enseigne : la priorité spirituelle n'est pas le statut social.`,
  reflection: `La crainte d'Allah est le véritable critère. Le cœur qui vient avec crainte est le cœur qui recevra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma man ja'aka yas'a wa huwa yakhsha » — quant à celui qui vient à toi avec empressement et crainte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui vient à moi avec crainte ? Est-ce que je les reconnais et les priorise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le craignant a plus de valeur que l'indifférent, même si le monde l'ignore." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte d'Allah élève le cœur au-dessus de tout statut mondain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah regarde la crainte dans le cœur, pas la position dans la société." }
  ],
  munajat: `Ya Rabb, fais que je reconnaisse ceux qui viennent avec crainte. Ne permets pas que je les ignore pour les indifférents.`
};

MIROIR["80:9"] = {
  reference: "80:9",
  theme: ["préoccupation", "négligence", "question"],
  emotion: "Interpellation, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Shaghil", "Al-Mughni"],
  mirrorVersion: `« Tu te préoccupes de lui ! » Le miroir pose une question brûlante : pourquoi donner de l'attention à celui qui s'en fout et négliger celui qui vient avec crainte ? Cette question traverse les siècles et me touche aujourd'hui. Le miroir m'oblige à examiner mes priorités.`,
  reflection: `Nos priorités révèlent nos valeurs. Qui négligeons-nous pour qui ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anta 'anhu taghni » — tu te préoccupes de lui, tu le négliges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je néglige parce que je suis préoccupé par les « importants » ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui que je néglige peut-être est celui qu'Allah priorise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monde inverse souvent les priorités divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah voit ce que je néglige — et Il m'en demande compte." }
  ],
  munajat: `Ya Rabb, montre-moi qui je néglige. Fais que mes priorités reflètent Tes priorités, pas celles du monde.`
};

MIROIR["80:10"] = {
  reference: "80:10",
  theme: ["négligence", "insulte", "dignité"],
  emotion: "Honte, correction",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mu'izz"],
  mirrorVersion: `« Non ! C'est un rappel. » Le miroir me secoue. La correction divine est claire : ignorer le craignant est une erreur. Ce n'est pas une suggestion — c'est une correction. « Kalla » — non ! Un mot fort qui arrête le comportement. Le miroir m'enseigne : la correction divine est un rappel, pas une condamnation.`,
  reflection: `La correction d'Allah est une miséricorde. Elle nous ramène sur le droit chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla innaha tadhkira » — non ! C'est un rappel. La correction est claire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis à la correction divine ? Est-ce que je l'accepte ou je la refuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La correction est un honneur — Allah nous corrige parce qu'Il nous aime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers répond à la correction du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la correction grandit. Celui qui la refuse stagne." }
  ],
  munajat: `Ya Rabb, j'accepte Ta correction. Ne permets pas que je m'éloigne du rappel. Corrige-moi pour que je grandisse.`
};

MIROIR["80:11"] = {
  reference: "80:11",
  theme: ["Coran", "rappel", "accès"],
  emotion: "Gratitude, accès",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Tadhkira"],
  mirrorVersion: `« Que quiconque le veuille s'en rappelle. » Le miroir m'ouvre une porte magnifique : le Coran est accessible à tous. Pas seulement aux élites, aux savants, aux riches — à « quiconque le veut ». La volonté est la seule clé nécessaire. Le miroir m'interroge : est-ce que je veux vraiment me rappeler ?`,
  reflection: `Le Coran n'est pas réservé à une élite. Il est ouvert à tout cœur qui veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man sha'a dhakarahu » — que quiconque le veuille s'en rappelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux vraiment me rappeler ? Ou est-ce que je suis distrait par le monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté précède la compréhension. Celui qui veut comprend." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rappel divin est disponible pour tous les cœurs ouverts." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clé n'est pas l'intelligence — c'est la volonté." }
  ],
  munajat: `Ya Rabb, je veux me rappeler. Ouvre mon cœur à Ton rappel. Ne permets pas que les distractions m'éloignent.`
};

MIROIR["80:12"] = {
  reference: "80:12",
  theme: ["feuilles", "honorées", "protection"],
  emotion: "Révérence, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Suhuf", "Al-Mukarramun"],
  mirrorVersion: `« Dans des feuilles honorées. » Le miroir me montre le statut du Coran : non pas des paroles ordinaires, mais un texte dans des feuilles honorées, élevées, protégées. Le respect dû au Coran n'est pas excessif — il est approprié à son statut. Le miroir m'interroge : comment est-ce que je traite la Parole d'Allah ?`,
  reflection: `Le Coran est honoré dans les cieux. Comment l'honorons-nous sur terre ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi suhufin mukarramah » — dans des feuilles honorées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite le Coran ? Avec honneur ou négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le texte honoré honore celui qui l'honore." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges entourent les feuillets du Coran de leur respect." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'honneur du Coran se transfère à celui qui le porte dans son cœur." }
  ],
  munajat: `Ya Rabb, honore Ton Livre dans mon cœur. Fais que je le traite avec le respect qu'il mérite.`
};

MIROIR["80:13"] = {
  reference: "80:13",
  theme: ["élevées", "purifiées", "anges"],
  emotion: "Révérence, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Mutahharah", "Al-Mala'ika"],
  mirrorVersion: `« Élevées, purifiées. » Le miroir continue la description : les feuillets sont « marfu'ah » — élevées, et « mutahharah » — purifiées. La pureté n'est pas seulement physique — elle est spirituelle. Rien de bas, de mondain, d'impur ne touche ces feuillets. Le miroir m'invite à élever ma propre relation avec le Texte.`,
  reflection: `Le Coran est pur et élevé. Comment purifier notre relation avec lui ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Marfu'atin mutahharah » — élevées, purifiées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je purifie mon cœur avant de lire le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le texte purifié purifie celui qui le lit avec un cœur pur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté du Coran reflète la pureté de sa Source." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah a purifié le Coran pour qu'il purifie les cœurs." }
  ],
  munajat: `Ya Tahir, purifie mon cœur pour Ton Livre. Élève ma relation avec le Coran au-dessus du mondain.`
};

MIROIR["80:14"] = {
  reference: "80:14",
  theme: ["anges", "scribe", "noblesse"],
  emotion: "Révérence, proximité",
  difficulty: "débutant",
  relatedNames: ["Al-Safarah", "Al-Kiram"],
  mirrorVersion: `« Par les mains d'anges scribes, nobles. » Le miroir me montre les anges : « safarah » — scribes, « kiram » — nobles, « bararah » — vertueux. Ces anges ne sont pas de simples scribes — ils sont nobles, honorés. Leur rôle dans la transmission du Coran est sacré. Le miroir m'enseigne le respect dû à ceux qui portent et transmettent la Parole divine.`,
  reflection: `Les anges nobles transmettent le Coran. Comment honorons-nous cette transmission ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-aydi safarah kiram bararah » — par les mains d'anges scribes, nobles, vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que les anges ont participé à la transmission du Coran que je lis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les nobles anges transmettent aux nobles cœurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges entourent ceux qui récitent le Coran de leur lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La noblesse des anges scribes inspire la noblesse dans le lecteur." }
  ],
  munajat: `Ya Rabb, merci pour Tes anges nobles qui transmettent Ton Livre. Fais que je sois digne de cette transmission.`
};

MIROIR["80:15"] = {
  reference: "80:15",
  theme: ["mort", "choix", "répugnance"],
  emotion: "Réalité, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Mawt", "Al-Khizy"],
  mirrorVersion: `« Périsse l'homme ! Qu'il est ingrat ! » Le miroir me secoue. « Qutila al-insan » — que l'homme périsse ! Une exclamation forte contre l'ingratitude humaine. « Ma akfarahu » — comme il est ingrat ! Le miroir m'oblige à examiner mon ingratitude : combien de bienfaits ai-je reçus et combien ai-je reconnus ?`,
  reflection: `L'ingratitude est la racine de beaucoup de maux. Combien sommes-nous ingrats ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qutila al-insan ma akfarahu » — que l'homme périsse ! Comme il est ingrat !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai reçu sans remercier ? Combien de bienfaits ignore-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude est plus destructrice que la faim." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création rend grâce — seul l'homme oublie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude ouvre les portes du ciel. L'ingratitude les ferme." }
  ],
  munajat: `Ya Shakur, Tu as droit à ma gratitude. Pardonne mon ingratitude. Apprends-moi à remercier pour chaque souffle.`
};

MIROIR["80:16"] = {
  reference: "80:16",
  theme: ["création", "matière", "origine"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Ma'din"],
  mirrorVersion: `« De quoi l'a-t-Il créé ? » Le miroir pose la question fondamentale : quelle est notre origine ? Nous venons de quelque chose d'humble — pas de quelque chose de noble par lui-même. « Min ayyi shay'in khalaqahu » — de quoi l'a-t-Il créé ? La réponse va humble l'orgueil humain.`,
  reflection: `Notre origine est humble. Notre fierté doit être dans le Créateur, pas dans la créature.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min ayyi shay'in khalaqahu » — de quoi l'a-t-Il créé ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'oublie mon origine humble ? D'où est-ce que je pense venir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine humble élève celui qui s'en souvient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création vient de la terre — et y retourne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de l'origine humble est le début de la sagesse." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de rien. Je ne suis que poussière. Fais que je n'oublie jamais mon origine.`
};

MIROIR["80:17"] = {
  reference: "80:17",
  theme: ["goutte", "fluid", "création"],
  emotion: "Humilité, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« D'une goutte de sperme, Il l'a créé. » Le miroir continue : « Min nutfatin khalaqahu » — d'une goutte, Il l'a créé. Pas d'un matériau noble, mais d'une goutte. Cette goutte est devenue un être complexe, pensant, capable de contester son Créateur. Le miroir m'émerveille et m'humilie.`,
  reflection: `La goutte devient l'homme. Le Créateur transforme l'humble en magnifique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min nutfatin khalaqahu » — d'une goutte de sperme, Il l'a créé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Je viens d'une goutte. Mon orgueil vient de quoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La goutte ne vaut rien par elle-même — elle vaut tout par le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie commence dans l'eau, humble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Créateur tire la majesté de l'humilité." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'une goutte. Je ne suis rien par moi-même. Tout ce que je suis vient de Toi.`
};

MIROIR["80:18"] = {
  reference: "80:18",
  theme: ["chemin", "facilitation", "guidance"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muyassir"],
  mirrorVersion: `« Puis Il lui a tracé son chemin. » Le miroir me montre la guidance intégrée : Allah ne crée pas et abandonne — Il trace le chemin. « Qaddara » — Il a déterminé, « fa hada » — puis guidé. La guidance suit la création. Le miroir m'enseigne : je ne suis pas perdu — le chemin est tracé.`,
  reflection: `Le chemin est tracé. Il nous appartient de le suivre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaddara fa hada » — Il a déterminé puis guidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le chemin tracé ou est-ce que je m'égare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin tracé est le chemin de la facilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création suit le chemin tracé par le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guidance est inscrite dans la création elle-même." }
  ],
  munajat: `Ya Hadi, Tu as tracé mon chemin. Fais que je le suive avec confiance. Ne permets pas que je m'égare.`
};

MIROIR["80:19"] = {
  reference: "80:19",
  theme: ["mort", "sépulture", "sortie"],
  emotion: "Réalité, résurrection",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Puis Il l'a fait mourir et mis dans la tombe. » Le miroir me montre le cycle complet : goutte → vie → mort → tombe. « Amatahu » — Il l'a fait mourir. « Wa aqbarahu » — et mis dans la tombe. Le cycle est inévitable. Le miroir m'interroge : est-ce que je vis en sachant que je mourrai ?`,
  reflection: `La mort suit la vie. La tombe attend chacun. Comment vivons-nous en sachant cela ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amatahu wa aqbarahu » — puis Il l'a fait mourir et mis dans la tombe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si j'étais éternel ? La mort est certaine." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin — c'est la transition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose vivante goûte à la mort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de la mort vit pleinement." }
  ],
  munajat: `Ya Rabb, la mort m'attend. Fais que je vive en la sachant. Prépare-moi pour la tombe et au-delà.`
};

MIROIR["80:20"] = {
  reference: "80:20",
  theme: ["résurrection", "sortie", "vie"],
  emotion: "Espoir, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Muhyi"],
  mirrorVersion: `« Puis quand Il voudra, Il le fera ressusciter. » Le miroir complète le cycle : mort → résurrection. « Idha sha'a ansharahu » — quand Il voudra, Il le fera ressusciter. La mort n'est pas définitive. La résurrection est promise. Le miroir m'enseigne : la vie reprend après la mort.`,
  reflection: `La résurrection suit la mort. Le Créateur qui a créé peut recréer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha sha'a ansharahu » — quand Il voudra, Il le fera ressusciter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort est un sommeil — la résurrection est le réveil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le printemps suit l'hiver — la résurrection suit la mort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La résurrection est déjà inscrite dans la création." }
  ],
  munajat: `Ya Ba'ith, Tu me ressusciteras. Fais que je sois prêt. Fais que je vive maintenant en sachant que je reverrai.`
};

// ==================== SURAH 37 (AS-SAFFAT) - REMAINING VERSES 131-182 ====================

MIROIR["37:131"] = {
  reference: "37:131",
  theme: ["récompense", "bienfaisance", "gratitude"],
  emotion: "Espoir, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Ihsan"],
  mirrorVersion: `« Ainsi récompensons-Nous les bienfaisants. » Le miroir me montre le refrain universel. « Kadhaalika najzil muhsineen » — ainsi récompensons-Nous les bienfaisants. Ce refrain revient après chaque prophète. Le miroir m'enseigne : la bienfaisance est toujours récompensée.`,
  reflection: `La bienfaisance est toujours récompensée par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhaalika najzil muhsineen » — ainsi récompensons-Nous les bienfaisants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les bienfaisants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense est proportionnelle à la bienfaisance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers récompense chaque acte de bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La meilleure récompense est la satisfaction d'Allah." }
  ],
  munajat: `Ya Rabb, compte-moi parmi les bienfaisants. Récompense ma bienfaisance par Ta satisfaction.`
};

MIROIR["37:132"] = {
  reference: "37:132",
  theme: ["foi", "sincérité", "serviteur"],
  emotion: "Honneur, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Ikhlas"],
  mirrorVersion: `« Il était de Nos serviteurs croyants. » Le miroir me montre l'appartenance spirituelle. « Innahu min 'ibaadinal-mu'mineen » — il était de Nos serviteurs croyants. L'appartenance. Élie fait partie de l'élite des croyants. Le miroir m'invite à rejoindre cette élite.`,
  reflection: `Faire partie des serviteurs croyants d'Allah est le plus grand honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu min 'ibaadinal-mu'mineen » — il était de Nos serviteurs croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis de Ses serviteurs croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appartenance à Allah précède la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est serviteur d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai croyant est celui qui appartient entièrement à Allah." }
  ],
  munajat: `Ya Rabb, fais que je sois de Tes serviteurs croyants. Je T'appartiens entièrement.`
};

MIROIR["37:133"] = {
  reference: "37:133",
  theme: ["prophète", "envoyé", "véracité"],
  emotion: "Honneur, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "As-Sadiq"],
  mirrorVersion: `« Lot était aussi des envoyés. » Le miroir me montre la continuité prophétique. « Wa inna luutan laminal-mursaleen » — Lot était aussi des envoyés. La mention. Après Élie, Lot (Lut) est mentionné. Le miroir m'enseigne : les prophètes forment une chaîne continue.`,
  reflection: `Les prophètes forment une chaîne continue de guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna luutan laminal-mursaleen » — Lot était aussi des envoyés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais tous les prophètes d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque prophète complète la chaîne de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reconnaît tous les prophètes d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La chaîne prophétique est un fil de lumière à travers l'histoire." }
  ],
  munajat: `Ya Rabb, je crois en tous Tes prophètes. Fais que je sois reconnaissant envers Lot et tous les envoyés.`
};

MIROIR["37:134"] = {
  reference: "37:134",
  theme: ["salut", "famille", "exception"],
  emotion: "Gratitude, miséricorde",
  difficulty: "débutant",
  relatedNames: ["An-Najat", "Al-Ahl"],
  mirrorVersion: `« Quand Nous le sauvâmes, lui et sa famille entière. » Le miroir me montre le sauvetage miséricordieux. « Idh najjaynaahu wa ahlahu ajma'een » — quand Nous le sauvâmes, lui et sa famille entière. Le salut. Lot et sa famille sont épargnés de la destruction. Le miroir m'enseigne : Allah sauve les croyants et leurs familles.`,
  reflection: `Allah sauve les croyants et leurs familles de la destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh najjaynaahu wa ahlahu ajma'een » — quand Nous le sauvâmes, lui et sa famille entière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma famille est sauvée avec moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le salut du croyant peut s'étendre à sa famille." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers protège les familles des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah s'étend à la descendance." }
  ],
  munajat: `Ya Munji, sauve-moi et ma famille. Étends Ta miséricorde à ceux que j'aime.`
};

MIROIR["37:135"] = {
  reference: "37:135",
  theme: ["exception", "punition", "demeure"],
  emotion: "Avertissement, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Al-Ghabir"],
  mirrorVersion: `« Sauf une vieille femme qui resta en arrière. » Le miroir me montre l'exception tragique. « Illaa 'ajuzan fil-ghaabireen » — sauf une vieille femme qui resta en arrière. L'exception. La femme de Lot refusa de partir et fut détruite avec son peuple. Le miroir m'avertit : l'attachement au mal détruit.`,
  reflection: `L'attachement au mal détruit même ceux qui sont proches des prophètes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illaa 'ajuzan fil-ghaabireen » — sauf une vieille femme qui resta en arrière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste attaché à ce qui doit être détruit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité avec le prophète ne suffit pas sans la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de favoris — seul le cœur compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi personnelle est nécessaire, pas seulement l'association." }
  ],
  munajat: `Ya Rabb, ne permets pas que je reste en arrière. Détache-moi de ce qui doit être détruit.`
};

MIROIR["37:136"] = {
  reference: "37:136",
  theme: ["destruction", "punition", "mécréance"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Halak", "Al-'Adhab"],
  mirrorVersion: `« Puis Nous détruisîmes les autres. » Le miroir me montre la destruction totale. « Thumma dammarnal-aakhareen » — puis Nous détruisîmes les autres. La destruction. Les villes de Sodome et Gomorrhe furent anéanties. Le miroir m'avertit : le péché entraîne la destruction.`,
  reflection: `Le péché collectif entraîne la destruction collective.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma dammarnal-aakhareen » — puis Nous détruisîmes les autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels péchés collectifs entraîneraient notre destruction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des méchants est la préservation des justes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne tolère pas le mal indéfiniment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La destruction est une miséricorde pour les générations futures." }
  ],
  munajat: `Ya Rabb, préserve-moi de la destruction. Éloigne-moi des péchés qui anéantissent.`
};

MIROIR["37:137"] = {
  reference: "37:137",
  theme: ["ruines", "signe", "passage"],
  emotion: "Rappel, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Athar", "Al-'Ibrah"],
  mirrorVersion: `« Et vous passez près d'eux le matin. » Le miroir me montre le signe visible. « Wa innakum latamurroona 'alayhim musbiheen » — et vous passez près d'eux le matin. Le passage. Les ruines de Sodome sont un avertissement visible pour les voyageurs. Le miroir m'enseigne : les ruines du passé sont des leçons pour le présent.`,
  reflection: `Les ruines du passé sont des leçons pour le présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innakum latamurroona 'alayhim musbiheen » — et vous passez près d'eux le matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles ruines traversent ma vie sans que je les remarque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le passage près des ruines doit éveiller, pas endormir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde les traces de chaque civilisation détruite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque ruine est un message d'Allah à méditer." }
  ],
  munajat: `Ya Rabb, fais que je voie les signes autour de moi. Que les ruines du passé m'avertissent pour le présent.`
};

MIROIR["37:138"] = {
  reference: "37:138",
  theme: ["nuit", "signe", "méditation"],
  emotion: "Rappel, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Tafakkur"],
  mirrorVersion: `« Et la nuit. Ne comprendrez-vous donc pas ? » Le miroir me montre le temps de méditation. « Wa bil-layl » — et la nuit. Le moment. « Afalaa ta'qiloon » — ne comprendrez-vous donc pas ? La question. Les ruines sont visibles jour et nuit. Le miroir m'invite à la compréhension.`,
  reflection: `La méditation jour et nuit sur les signes d'Allah mène à la compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa bil-layl afalaa ta'qiloon » — et la nuit. Ne comprendrez-vous donc pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les signes autour de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compréhension vient de la méditation, pas de la simple observation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers parle jour et nuit à ceux qui écoutent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compréhension est un don d'Allah à ceux qui cherchent." }
  ],
  munajat: `Ya Rabb, donne-moi la compréhension. Fais que je médite sur Tes signes jour et nuit.`
};

MIROIR["37:139"] = {
  reference: "37:139",
  theme: ["prophète", "envoyé", "véracité"],
  emotion: "Honneur, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Yunus"],
  mirrorVersion: `« Jonas était aussi des envoyés. » Le miroir me montre la continuité prophétique. « Wa inna yoonusa laminal-mursaleen » — Jonas était aussi des envoyés. La mention. Après Lot, Jonas (Yunus) est mentionné. Le miroir m'enseigne : les prophètes forment une chaîne continue.`,
  reflection: `Les prophètes forment une chaîne continue de guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna yoonusa laminal-mursaleen » — Jonas était aussi des envoyés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais tous les prophètes d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque prophète complète la chaîne de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reconnaît tous les prophètes d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La chaîne prophétique est un fil de lumière à travers l'histoire." }
  ],
  munajat: `Ya Rabb, je crois en tous Tes prophètes. Fais que je sois reconnaissant envers Jonas et tous les envoyés.`
};

MIROIR["37:140"] = {
  reference: "37:140",
  theme: ["fuite", "navire", "épreuve"],
  emotion: "Fuite, destin",
  difficulty: "débutant",
  relatedNames: ["Al-Firar", "Al-Fulk"],
  mirrorVersion: `« Quand il s'enfuit vers le navire chargé. » Le miroir me montre la fuite du prophète. « Idh abaqa ilal-fullkil mashhuun » — quand il s'enfuit vers le navire chargé. La fuite. Jonas quitta son peuple sans l'ordre d'Allah. Le miroir m'avertit : la fuite du destin n'est pas la solution.`,
  reflection: `La fuite du destin n'est pas la solution.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh abaqa ilal-fullkil mashhuun » — quand il s'enfuit vers le navire chargé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis mes responsabilités au lieu de les affronter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite du prophète devient une leçon pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne permet pas la fuite du destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah rattrape toujours ceux qui fuient." }
  ],
  munajat: `Ya Rabb, ne permets pas que je fuie mes responsabilités. Aide-moi à affronter mes épreuves avec Toi.`
};

MIROIR["37:141"] = {
  reference: "37:141",
  theme: ["sort", "tirage", "destin"],
  emotion: "Destin, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Qadar", "Al-Sahm"],
  mirrorVersion: `« Il participa au tirage au sort et fut du nombre des perdants. » Le miroir me montre le destin dans le hasard. « Fa-saahama fa-kaana minal-mudh'afeen » — il participa au tirage au sort et fut du nombre des perdants. Le sort. Jonas perdit le tirage et fut jeté à la mer. Le miroir m'enseigne : le hasard n'existe pas pour Allah.`,
  reflection: `Le hasard n'existe pas pour Allah — tout est destin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-saahama fa-kaana minal-mudh'afeen » — il participa au tirage au sort et fut du nombre des perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je perds, est-ce que je vois la main d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte apparente peut être le début du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit au destin divin, pas au hasard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sort d'Allah est toujours juste." }
  ],
  munajat: `Ya Rabb, j'accepte Ton destin. Même quand je perds, je sais que Tu as un plan.`
};

MIROIR["37:142"] = {
  reference: "37:142",
  theme: ["poisson", "avaler", "épreuve"],
  emotion: "Épreuve, ténèbres",
  difficulty: "débutant",
  relatedNames: ["Al-Hut", "Al-Balaa'"],
  mirrorVersion: `« Le poisson l'avala car il était blâmable. » Le miroir me montre l'épreuve dans les entrailles. « Fal-taqamahuul-huutu wa huwa muleem » — le poisson l'avala car il était blâmable. L'épreuve. Jonas est avalé par le poisson pour son erreur. Le miroir m'enseigne : l'erreur du prophète est corrigée par l'épreuve.`,
  reflection: `L'erreur du prophète est corrigée par l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fal-taqamahuul-huutu wa huwa muleem » — le poisson l'avala car il était blâmable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles épreuves me corrigent de mes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve dans le poisson est aussi une protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut créer des épreuves uniques pour chaque prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les ténèbres du poisson préparent la lumière de la délivrance." }
  ],
  munajat: `Ya Rabb, corrige-moi par Tes épreuves. Même dans les ténèbres, je sais que Tu es là.`
};

MIROIR["37:143"] = {
  reference: "37:143",
  theme: ["ténèbres", "invocation", "repentir"],
  emotion: "Espoir, repentir",
  difficulty: "débutant",
  relatedNames: ["Az-Zulumat", "Ad-Du'a'"],
  mirrorVersion: `« S'il n'avait pas été de ceux qui glorifient Allah. » Le miroir me montre le salut par la glorification. « Falaw-laa annahu kaana minal-musabbiheen » — s'il n'avait pas été de ceux qui glorifient Allah. La condition. Jonas fut sauvé parce qu'il invoqua Allah dans les ténèbres. Le miroir m'enseigne : l'invocation sauve des ténèbres.`,
  reflection: `L'invocation sauve des ténèbres les plus profondes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falaw-laa annahu kaana minal-musabbiheen » — s'il n'avait pas été de ceux qui glorifient Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah dans mes ténèbres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ténèbres deviennent lumière par l'invocation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond à l'invocation du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La glorification d'Allah est la clé de la délivrance." }
  ],
  munajat: `Ya Rabb, dans mes ténèbres, je Te glorifie. Sauve-moi comme Tu as sauvé Jonas.`
};

MIROIR["37:144"] = {
  reference: "37:144",
  theme: ["jugement", "tombe", "résurrection"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Qabr", "Al-Ba'th"],
  mirrorVersion: `« Il serait resté dans son ventre jusqu'au jour où l'on sera ressuscité. » Le miroir me montre l'alternative tragique. « Lalabitha fee batnihi ilaa yawmi yub'athoon » — il serait resté dans son ventre jusqu'au jour où l'on sera ressuscité. La conséquence. Sans repentir, Jonas serait resté prisonnier. Le miroir m'avertit : le retard du repentir prolonge l'épreuve.`,
  reflection: `Le retard du repentir prolonge l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lalabitha fee batnihi ilaa yawmi yub'athoon » — il serait resté dans son ventre jusqu'au jour de la résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de temps vais-je rester dans mon épreuve avant de me repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prison de l'épreuve s'ouvre par le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend le repentir du croyant pour le libérer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le repentir immédiat raccourcit l'épreuve." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que mon épreuve se prolonge. Libère-moi par mon repentir.`
};

MIROIR["37:145"] = {
  reference: "37:145",
  theme: ["délivrance", "plage", "rétablissement"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["An-Najat", "Al-'Arah"],
  mirrorVersion: `« Nous le jetâmes sur la terre nue, malade. » Le miroir me montre la délivrance imparfaite. « Fanabadhnaahu bil-'araa'i wa huwa saqeem » — Nous le jetâmes sur la terre nue, malade. La délivrance. Jonas est rejeté sur la plage, faible mais vivant. Le miroir m'enseigne : la délivrance peut venir avec des cicatrices.`,
  reflection: `La délivrance peut venir avec des cicatrices.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fanabadhnaahu bil-'araa'i wa huwa saqeem » — Nous le jetâmes sur la terre nue, malade." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand Allah me délivre, est-ce que j'accepte les cicatrices ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse après l'épreuve est le début du rétablissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers offre la terre ferme après la tempête." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La délivrance est un don, même imparfaite." }
  ],
  munajat: `Ya Rabb, merci pour Ta délivrance. Même si je suis faible, je suis vivant. Rétablis-moi complètement.`
};

MIROIR["37:146"] = {
  reference: "37:146",
  theme: ["provision", "plante", "grâce"],
  emotion: "Gratitude, soin",
  difficulty: "débutant",
  relatedNames: ["Ar-Rizq", "Al-Shajar"],
  mirrorVersion: `« Et fîmes pousser sur lui une plante de courge. » Le miroir me montre la provision divine. « Wa anbatnaa 'alayhi shajaratan min yaqteen » — et fîmes pousser sur lui une plante de courge. La provision. Allah pourvoit à Jonas dans sa faiblesse. Le miroir m'enseigne : Allah pourvoit même dans la plus grande faiblesse.`,
  reflection: `Allah pourvoit même dans la plus grande faiblesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anbatnaa 'alayhi shajaratan min yaqteen » — et fîmes pousser sur lui une plante de courge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle provision inattendue Allah m'a-t-Il donnée dans ma faiblesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plante de courge protège du soleil — la provision protège de l'épreuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers produit ce dont chaque créature a besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La provision d'Allah est adaptée à chaque situation." }
  ],
  munajat: `Ya Razzaq, merci pour Ta provision. Pourvois à mes besoins même dans ma faiblesse.`
};

MIROIR["37:147"] = {
  reference: "37:147",
  theme: ["mission", "peuple", "message"],
  emotion: "Responsabilité, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Risalah", "Al-Qaum"],
  mirrorVersion: `« Et Nous l'envoyâmes à cent mille personnes ou plus. » Le miroir me montre la mission restaurée. « Wa arsalnaahu ilaa mi'ati alfin aw yaazeedoon » — et Nous l'envoyâmes à cent mille personnes ou plus. La mission. Après son épreuve, Jonas retourne à son peuple. Le miroir m'enseigne : l'épreuve prépare pour la mission.`,
  reflection: `L'épreuve prépare pour la mission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa arsalnaahu ilaa mi'ati alfin aw yaazeedoon » — et Nous l'envoyâmes à cent mille personnes ou plus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que je suis envoyé après mon épreuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mission est restaurée après le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a besoin de chaque prophète pour chaque peuple." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La mission d'Allah attend le serviteur restauré." }
  ],
  munajat: `Ya Rabb, restaure ma mission après mon épreuve. Envoie-moi à ceux qui ont besoin de moi.`
};

MIROIR["37:148"] = {
  reference: "37:148",
  theme: ["foi", "repentir", "jouissance"],
  emotion: "Joie, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Mut'a"],
  mirrorVersion: `« Ils crurent, et Nous leur donnâmes jouissance pour un temps. » Le miroir me montre le résultat de la prédication. « Fa-aamanoo fa-matta'naahum ilaa heen » — ils crurent, et Nous leur donnâmes jouissance pour un temps. Le résultat. Le peuple de Jonas crut et fut épargné. Le miroir m'enseigne : la foi sauve du châtiment.`,
  reflection: `La foi sauve du châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aamanoo fa-matta'naahum ilaa heen » — ils crurent, et Nous leur donnâmes jouissance pour un temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi me sauve-t-elle du châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jouissance temporaire suit la foi sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers offre la jouissance à ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La jouissance d'Allah est temporaire dans ce monde, éternelle dans l'autre." }
  ],
  munajat: `Ya Rabb, fais que je croie sincèrement. Donne-moi la jouissance de Ta miséricorde dans ce monde et l'éternité dans l'autre.`
};

MIROIR["37:149"] = {
  reference: "37:149",
  theme: ["question", "fille", "attribution"],
  emotion: "Questionnement, défi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Banat", "Ash-Shirk"],
  mirrorVersion: `« Interroge-les : ton Seigneur a-t-Il des filles et eux des fils ? » Le miroir me montre l'absurdité de l'attribution. « Fastafhimhum alirabbika al-banuatu wa lahumul-banoon » — interroge-les : ton Seigneur a-t-Il des filles et eux des fils ? La question. Les Arabes attribuaient des filles à Allah tout en préférant les fils. Le miroir démasque l'absurdité.`,
  reflection: `L'attribution arbitraire à Allah révèle les préjugés humains.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fastafhimhum alirabbika al-banuatu wa lahumul-banoon » — interroge-les : ton Seigneur a-t-Il des filles et eux des fils ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attribue à Allah qui vient en fait de mes préjugés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je donne à Allah, je le refuse pour moi-même — c'est l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de préférence entre fils et filles — il est neutre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est au-dessus de toute comparaison humaine." }
  ],
  munajat: `Ya Rabb, Tu es au-dessus de toute attribution humaine. Purifie ma conception de Toi.`
};

MIROIR["37:150"] = {
  reference: "37:150",
  theme: ["création", "témoin", "question"],
  emotion: "Défi, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Ash-Shahadah"],
  mirrorVersion: `« Ou bien les avons-Nous créés anges de sexe féminin ? » Le miroir me montre le défi divin. « Am khalaqnal-malaa'ikata inaathan wa hum shaahidoon » — ou bien les avons-Nous créés anges de sexe féminin ? La question. Les Arabes prétendaient que les anges étaient des filles d'Allah. Le miroir demande : étiez-vous témoins ?`,
  reflection: `Les prétentions sans preuve sont des mensonges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am khalaqnal-malaa'ikata inaathan wa hum shaahidoon » — ou bien les avons-Nous créés anges de sexe féminin ? Ils en sont témoins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je prétends sans preuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoin de la création est Allah seul, pas les hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne témoigne que pour la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prétention sans preuve est le propre de l'ignorance." }
  ],
  munajat: `Ya Rabb, ne permets pas que je prétende sans preuve. Tu es le Témoin de toute création.`
};

MIROIR["37:151"] = {
  reference: "37:151",
  theme: ["mensonge", "invention", "langue"],
  emotion: "Accusation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Kadhib", "Al-Iftira'"],
  mirrorVersion: `« C'est de leur propre invention qu'ils disent. » Le miroir me montre l'origine du mensonge. « Alaa innahum min ifkihim la-yaqooloon » — c'est de leur propre invention qu'ils disent. La source. Les affirmations sur Allah viennent de leur imagination, pas de la vérité. Le miroir m'avertit : ne pas inventer sur Allah.`,
  reflection: `Ne pas inventer sur Allah — parler seulement avec science.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alaa innahum min ifkihim la-yaqooloon » — c'est de leur propre invention qu'ils disent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invente sur Allah ou est-ce que je parle avec science ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invention sur Allah est un grave péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas sur son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vérité sur Allah vient d'Allah seul." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'invente sur Toi. Donne-moi la science avant la parole.`
};

MIROIR["37:152"] = {
  reference: "37:152",
  theme: ["fils", "attribution", "mensonge"],
  emotion: "Accusation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Walad", "Al-Kadhib"],
  mirrorVersion: `« Allah a engendré. » Le miroir me montre le mensonge suprême. « Allahu walad » — Allah a engendré. L'affirmation. Le plus grand mensonge contre Allah est de Lui attribuer une progéniture. « Wa innahum la-kaadhiboon » — et ils sont certainement menteurs. Le verdict.`,
  reflection: `Attribuer une progéniture à Allah est le plus grand mensonge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu walad wa innahum la-kaadhiboon » — Allah a engendré. Ils sont certainement menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois des mensonges sur Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'engendre pas et n'est pas engendré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas besoin d'engendrer pour être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est le Premier sans commencement, le Dernier sans fin." }
  ],
  munajat: `Ya Rabb, Tu n'engendres pas et n'es pas engendré. Tu es l'Unique, l'Éternel. Je purifie ma foi de toute attribution fausse.`
};

MIROIR["37:153"] = {
  reference: "37:153",
  theme: ["choix", "préférence", "question"],
  emotion: "Questionnement, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Istifa'", "Al-Banat"],
  mirrorVersion: `« A-t-Il choisi les filles plutôt que les fils ? » Le miroir me montre l'absurdité de la prétention. « As-takhaa al-banaati 'alal-baneen » — a-t-Il choisi les filles plutôt que les fils ? La question. Si les Arabes préféraient les fils, pourquoi attribueraient-ils les filles à Allah ? Le miroir révèle l'absurdité.`,
  reflection: `L'hypocrisie des attributions révèle les préjugés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« As-takhaa al-banaati 'alal-baneen » — a-t-Il choisi les filles plutôt que les fils ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je cohérent dans mes croyances ou hypocrite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah ne choisit pas comme les hommes choisissent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de préférence — il est équilibré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est au-dessus des préférences humaines." }
  ],
  munajat: `Ya Rabb, Tu es au-dessus de tout choix humain. Ta sagesse est parfaite.`
};

MIROIR["37:154"] = {
  reference: "37:154",
  theme: ["question", "jugement", "justice"],
  emotion: "Défi, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Hukm", "Al-'Adl"],
  mirrorVersion: `« Qu'avez-vous à juger ainsi ? » Le miroir me montre la critique du jugement. « Maa lakum kayfa tahkumoon » — qu'avez-vous à juger ainsi ? La question. Votre jugement est absurde. Le miroir m'invite à examiner mes propres jugements.`,
  reflection: `Examiner mes jugements — sont-ils justes ou absurdes ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Maa lakum kayfa tahkumoon » — qu'avez-vous à juger ainsi ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je juge ? Suis-je juste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement humain sans science est erroné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers juge par la vérité, pas par le caprice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Seul Allah juge avec justice parfaite." }
  ],
  munajat: `Ya Hakam, Tu es le Juge parfait. Ne permets pas que je juge sans science. Guide mon jugement.`
};

MIROIR["37:155"] = {
  reference: "37:155",
  theme: ["rappel", "méditation", "science"],
  emotion: "Appel, espoir",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikra", "Al-'Ilm"],
  mirrorVersion: `« Ne vous souvenez-vous donc pas ? » Le miroir me montre l'appel à la conscience. « Afalaa tatakabbaroon » — ne vous souvenez-vous donc pas ? L'appel. Le rappel est une clé pour sortir de l'égarement. Le miroir m'invite à me souvenir d'Allah.`,
  reflection: `Se souvenir d'Allah est la clé de la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afalaa tatakabbaroon » — ne vous souvenez-vous donc pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens d'Allah dans mes jugements ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli mène à l'égarement — le rappel mène à la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se souvient d'Allah par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel d'Allah illumine le cœur." }
  ],
  munajat: `Ya Rabb, fais que je me souvienne de Toi. Illumine mon cœur par Ton rappel.`
};

MIROIR["37:156"] = {
  reference: "37:156",
  theme: ["preuve", "autorité", "science"],
  emotion: "Défi, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Sultan", "Al-Burhan"],
  mirrorVersion: `« Avez-vous une preuve évidente ? » Le miroir me montre le défi de la preuve. « Am lakum sultanun mubeen » — avez-vous une preuve évidente ? La question. Les prétentions sans preuve sont vaines. Le miroir m'invite à chercher les preuves de mes croyances.`,
  reflection: `Les croyances sans preuves sont des illusions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lakum sultanun mubeen » — avez-vous une preuve évidente ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je des preuves pour mes croyances ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La preuve évidente vient d'Allah, pas des hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de preuves évidentes d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus grande preuve est la création elle-même." }
  ],
  munajat: `Ya Rabb, donne-moi des preuves évidentes. Ne permets pas que je croie sans preuve.`
};

MIROIR["37:157"] = {
  reference: "37:157",
  theme: ["livre", "vérité", "défi"],
  emotion: "Défi, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "As-Sidq"],
  mirrorVersion: `« Apportez votre livre, si vous êtes véridiques ! » Le miroir me montre le défi du livre. « Fa'too bi-kitabikum in kuntum saadiqeen » — apportez votre livre, si vous êtes véridiques ! Le défi. Si vous avez un livre d'Allah, montrez-le. Le miroir révèle : il n'y a pas de livre sans révélation.`,
  reflection: `La vérité vient d'Allah, pas de l'imagination humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'too bi-kitabikum in kuntum saadiqeen » — apportez votre livre, si vous êtes véridiques !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quel livre est-ce que je base ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le livre véridique vient d'Allah seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lui-même est un livre à lire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Coran est le livre véridique pour tous les temps." }
  ],
  munajat: `Ya Rabb, Ton livre est la vérité. Guide-moi par Ta révélation.`
};

MIROIR["37:158"] = {
  reference: "37:158",
  theme: ["lien", "invention", "falsification"],
  emotion: "Accusation, vérité",
  difficulty: "débutant",
  relatedNames: ["An-Nasab", "Al-Falsafah"],
  mirrorVersion: `« Ils ont établi un lien de parenté entre Lui et les djinns. » Le miroir me montre l'invention absurde. « Wa ja'aloo baynahu wa baynal-jinnati nasaba » — ils ont établi un lien de parenté entre Lui et les djinns. L'invention. Les Arabes prétendaient qu'Allah avait des liens de parenté avec les djinns. Le miroir révèle l'absurdité.`,
  reflection: `Les inventions sur Allah sont des égarements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'aloo baynahu wa baynal-jinnati nasaba » — ils ont établi un lien de parenté entre Lui et les djinns." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles inventions ai-je sur Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas de parenté — Il est l'Unique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de parenté avec Allah — il est création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est le Créateur, séparé de Sa création." }
  ],
  munajat: `Ya Rabb, Tu es le Créateur sans parenté. Purifie ma conception de Toi.`
};

MIROIR["37:159"] = {
  reference: "37:159",
  theme: ["gloire", "transcendance", "pureté"],
  emotion: "Glorification, révérence",
  difficulty: "débutant",
  relatedNames: ["Subhan", "At-Tanzih"],
  mirrorVersion: `« Gloire à Allah ! Il est au-dessus de ce qu'ils décrivent. » Le miroir me montre la transcendance. « Subhaanallahi 'ammâ yasifoon » — gloire à Allah ! Il est au-dessus de ce qu'ils décrivent. La glorification. Allah est pur de toutes les inventions humaines. Le miroir m'invite à glorifier.`,
  reflection: `Allah est pur de toutes les inventions humaines.`,
  tajalli: [
