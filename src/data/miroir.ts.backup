MIROIR["21:86"] = {
  reference: "21:86",
  theme: ["miséricorde", "vertueux", "prophètes"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "As-Salihun"],
  mirrorVersion: `« Et Nous les fîmes entrer dans Notre miséricorde, car ils étaient du nombre des vertueux. » Le miroir me montre l'entrée dans la miséricorde. « Wa adkhalnahum fi rahmatina » — Nous les fîmes entrer dans Notre miséricorde. « Innahum mina al-salihin » — car ils étaient du nombre des vertueux. La vertu ouvre la porte de la miséricorde. Le miroir m'interroge : est-ce que je suis vertueux ?`,
  reflection: `La vertu ouvre la porte de la miséricorde. Cultiver la vertu est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adkhalnahum fi rahmatina innahum mina al-salihin » — Nous les fîmes entrer dans Notre miséricorde, car ils étaient du nombre des vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vertueux ? Ou est-ce que je m'éloigne de la vertu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu est la clé de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les vertueux entrent dans la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive la vertu entre dans la miséricorde." }
  ],
  munajat: `Ya Rabb, fais que je sois vertueux. Ne permets pas la déviation. Fais-moi entrer dans Ta miséricorde.`
};

MIROIR["21:87"] = {
  reference: "21:87",
  theme: ["Jonas", "colère", "ténèbres"],
  emotion: "Repentir, espérance",
  difficulty: "débutant",
  relatedNames: ["Yunus", "Dhu al-Nun"],
  mirrorVersion: `« Et Dhu al-Nun, quand il partit, irrité. » Le miroir me montre l'histoire de Jonas. « Wa Dha al-Nuni idh dhahaba mughadiban » — et Dhu al-Nun, quand il partit, irrité. « Fa zanna an lan naqdira 'alayhi » — il pensa que Nous ne pourrions pas le contraindre. Jonas a fui et a été éprouvé. Le miroir m'interroge : est-ce que je fuis ou est-ce que j'accepte ?`,
  reflection: `Jonas a fui et a été éprouvé dans les ténèbres. Fuir est vain. Accepter la mission est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Dha al-Nuni idh dhahaba mughadiban fa zanna an lan naqdira 'alayhi » — et Dhu al-Nun, quand il partit, irrité. Il pensa que Nous ne pourrions pas le contraindre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis ? Ou est-ce que j'accepte la mission d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Fuir la mission d'Allah mène aux ténèbres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne peut fuir la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mission d'Allah est guidé." }
  ],
  munajat: `Ya Rabb, j'accepte Ta mission. Ne permets pas la fuite. Fais que j'accomplisse ce que Tu m'as confié.`
};

MIROIR["21:88"] = {
