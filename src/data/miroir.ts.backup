  reference: "23:1",
  theme: ["croyants", "succès", "foi"],
  emotion: "Espérance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'minun", "Al-Falah"],
  mirrorVersion: `« Les croyants ont réussi. » Le miroir me montre la promesse du succès. « Qad aflaha al-mu'minun » — les croyants ont réussi. La foi mène au succès. Le miroir m'interroge : est-ce que je suis de ces croyants qui réussissent ?`,
  reflection: `La foi mène au succès. Être croyant est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad aflaha al-mu'minun » — les croyants ont réussi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis de ces croyants qui réussissent ? Ou est-ce que ma foi est faible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sincère est la garantie du succès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vrai succès est le succès éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi a déjà réussi." }
  ],
  munajat: `Ya Rabb, je veux être de ces croyants qui réussissent. Ne permets pas que ma foi soit faible. Donne-moi le succès par la foi.`
};

MIROIR["23:115"] = {
  reference: "23:115",
  theme: ["création", "jugement", "responsabilité"],
  emotion: "Réalité, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Hisab"],
  mirrorVersion: `« Pensez-vous que Nous vous avons créés sans but et que vous ne seriez pas ramenés vers Nous ? » Le miroir me montre le but de la création. « A-hasibtum annama khalaqnakum 'abathan » — pensez-vous que Nous vous avons créés sans but. La création a un but. Le miroir m'interroge : est-ce que je connais le but de ma création ?`,
  reflection: `La création a un but. Le connaître est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-hasibtum annama khalaqnakum 'abathan wa annakum ilayna la turja'un » — pensez-vous que Nous vous avons créés sans but et que vous ne seriez pas ramenés vers Nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais le but de ma création ? Ou est-ce que je vis sans but ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance du but donne sens à la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création a un but." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son but l'accomplit." }
  ],
  munajat: `Ya Rabb, je connais le but de ma création. Ne permets pas que je vive sans but. Donne-moi d'accomplir ma raison d'être.`
};

