    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crée ? Est-ce que je reconnais que tout vient d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance du Créateur mène à la reconnaissance de la créature." },
