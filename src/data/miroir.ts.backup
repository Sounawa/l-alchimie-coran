    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Allah comme Il le mérite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification d'Allah purifie mon cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier glorifie Allah par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La glorification constante élève l'âme." }
  ],
  munajat: `Ya Subhan, Tu es pur de tout ce qu'ils décrivent. Gloire à Toi ! Purifie mon cœur par Ta glorification.`
};

MIROIR["37:160"] = {
  reference: "37:160",
  theme: ["exception", "sincérité", "serviteur"],
  emotion: "Espoir, distinction",
  difficulty: "débutant",
  relatedNames: ["Al-Mukhlas", "Al-Ibad"],
  mirrorVersion: `« Sauf les serviteurs sincères d'Allah. » Le miroir me montre l'exception sauvée. « Illaa 'ibaadal-Allahil-mukhlaseen » — sauf les serviteurs sincères d'Allah. L'exception. Les sincères sont épargnés des inventions. Le miroir m'invite à la sincérité.`,
  reflection: `La sincérité préserve des inventions sur Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illaa 'ibaadal-Allahil-mukhlaseen » — sauf les serviteurs sincères d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les serviteurs sincères d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité est la protection contre l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est sincère envers son Créateur par nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les serviteurs sincères sont les bien-aimés d'Allah." }
  ],
  munajat: `Ya Rabb, purifie mon intention. Fais que je sois parmi Tes serviteurs sincères.`
};

MIROIR["37:161"] = {
  reference: "37:161",
  theme: ["adoration", "polythéisme", "mensonge"],
  emotion: "Déclaration, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ibadah", "Ash-Shirk"],
  mirrorVersion: `« Vous et ce que vous adorez. » Le miroir me montre l'association dans le mensonge. « Fa-innakum wa maa ta'budoon » — vous et ce que vous adorez. L'adresse. Les idolâtres et leurs idoles sont dans le même égarement. Le miroir sépare le vrai du faux.`,
  reflection: `Les idolâtres et leurs idoles partagent le même sort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innakum wa maa ta'budoon » — vous et ce que vous adorez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore en dehors d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole et l'idolâtre sont dans le même égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a qu'un seul objet d'adoration : Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie adoration est celle d'Allah seul." }
  ],
  munajat: `Ya Rabb, je n'adore que Toi. Sépare-moi de toute idolâtrie.`
};

MIROIR["37:162"] = {
  reference: "37:162",
  theme: ["tentation", "pouvoir", "limitation"],
  emotion: "Réconfort, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Fitnah", "Al-Sultan"],
  mirrorVersion: `« Vous ne pouvez tenter personne contre Lui. » Le miroir me montre l'impuissance des idolâtres. « Maa antum 'alayhi bi-faatineen » — vous ne pouvez tenter personne contre Lui. La limitation. Les idolâtres ne peuvent égarer que ceux qu'Allah permet. Le miroir me rassure : la tentation a des limites.`,
  reflection: `La tentation a des limites fixées par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Maa antum 'alayhi bi-faatineen » — vous ne pouvez tenter personne contre Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la tentation plus que je ne fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tentation ne peut atteindre que ceux qui s'y exposent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers protège les croyants de la tentation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection d'Allah est plus forte que toute tentation." }
  ],
  munajat: `Ya Rabb, protège-moi de la tentation. Ta protection est plus forte que tout.`
};

MIROIR["37:163"] = {
  reference: "37:163",
  theme: ["enfer", "destin", "brûlure"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Haraq"],
  mirrorVersion: `« Sauf celui qui brûlera dans la Fournaise. » Le miroir me montre l'exception tragique. « Illaa man huwa saalil-jaheem » — sauf celui qui brûlera dans la Fournaise. L'exception. Ceux qui se laissent tenter finiront en enfer. Le miroir m'avertit : le destin des égarés est la Fournaise.`,
  reflection: `Le destin des égarés est la Fournaise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illaa man huwa saalil-jaheem » — sauf celui qui brûlera dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je à l'abri de la Fournaise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Fournaise attend ceux qui se laissent tenter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a un lieu pour chaque destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection d'Allah est le seul abri contre la Fournaise." }
  ],
  munajat: `Ya Rabb, protège-moi de la Fournaise. Je me réfugie en Toi contre tout égarement.`
};

MIROIR["37:164"] = {
  reference: "37:164",
  theme: ["anges", "ordre", "adoration"],
  emotion: "Organisation, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "As-Saff"],
  mirrorVersion: `« Il n'y en a pas un parmi nous qui n'ait une place connue. » Le miroir me montre l'ordre céleste. « Wa maa minnaa illaa lahu maqaamun ma'loom » — il n'y en a pas un parmi nous qui n'ait une place connue. L'organisation. Les anges ont chacun une fonction précise. Le miroir m'invite à l'ordre.`,
  reflection: `L'ordre céleste reflète l'ordre divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa maa minnaa illaa lahu maqaamun ma'loom » — il n'y en a pas un parmi nous qui n'ait une place connue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais ma place auprès d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque créature a une place unique auprès d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est parfaitement ordonné par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Connaître sa place est le début de la sagesse." }
  ],
  munajat: `Ya Rabb, montre-moi ma place. Aide-moi à l'accepter et à m'y installer.`
};

MIROIR["37:165"] = {
  reference: "37:165",
  theme: ["rang", "ordre", "soumission"],
  emotion: "Organisation, discipline",
  difficulty: "débutant",
  relatedNames: ["As-Saff", "At-Tartib"],
  mirrorVersion: `« Nous sommes certainement rangés en rangs. » Le miroir me montre la discipline céleste. « Wa innaa lanahmus-saaffoon » — nous sommes certainement rangés en rangs. La discipline. Les anges sont parfaitement organisés. Le miroir m'invite à la discipline spirituelle.`,
  reflection: `La discipline spirituelle reflète l'ordre céleste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innaa lanahmus-saaffoon » — nous sommes certainement rangés en rangs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis discipliné dans ma spiritualité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les rangs des anges sont parfaits — les nôtres doivent le devenir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en rangs parfaits devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La discipline intérieure prépare aux rangs célestes." }
  ],
  munajat: `Ya Rabb, apprends-moi la discipline. Range-moi parmi ceux qui sont en ordre devant Toi.`
};

MIROIR["37:166"] = {
  reference: "37:166",
  theme: ["glorification", "constance", "adoration"],
  emotion: "Adoration, constance",
  difficulty: "débutant",
  relatedNames: ["At-Tasbih", "Ad-Dawam"],
  mirrorVersion: `« Nous sommes certainement ceux qui glorifient. » Le miroir me montre la fonction des anges. « Wa innaa lanahmus-sabbihoon » — nous sommes certainement ceux qui glorifient. La fonction. La glorification constante est le travail des anges. Le miroir m'invite à la glorification continue.`,
  reflection: `La glorification constante est l'occupation des anges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innaa lanahmus-sabbihoon » — nous sommes certainement ceux qui glorifient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Allah constamment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification des anges est continue — la mienne doit le devenir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers glorifie Allah par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La langue du cœur glorifie même quand la bouche se tait." }
  ],
  munajat: `Ya Rabb, fais que je Te glorifie constamment. Unis ma langue à celle des anges.`
};

MIROIR["37:167"] = {
  reference: "37:167",
  theme: ["moquerie", "menace", "prétention"],
  emotion: "Avertissement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Istihza'", "At-Ta'did"],
  mirrorVersion: `« Ils disaient : 'Si nous avions un rappel des anciens.' » Le miroir me montre la fausse prétention. « Wa kaanoo yaqooloona law anna 'indanaa dhikrun minal-awwaleen » — ils disaient : si nous avions un rappel des anciens. La prétention. Les mécréants prétendaient qu'ils auraient cru avec un livre ancien. Le miroir révèle : le problème n'est pas le livre, c'est le cœur.`,
  reflection: `Le problème n'est pas le livre, c'est le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kaanoo yaqooloona law anna 'indanaa dhikrun minal-awwaleen » — ils disaient : si nous avions un rappel des anciens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles excuses est-ce que je donne pour ne pas croire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse cache souvent le refus intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a donné tous les signes — le problème est dans les cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur fermé refuse tout rappel." }
  ],
  munajat: `Ya Rabb, ne permets pas que je cherche des excuses. Ouvre mon cœur à Ton rappel.`
};

MIROIR["37:168"] = {
  reference: "37:168",
  theme: ["rappel", "ancien", "prétention"],
  emotion: "Défi, vérité",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikr", "Al-Awwalun"],
  mirrorVersion: `« Nous aurions été les serviteurs sincères d'Allah. » Le miroir me montre la fausse prétention. « Lakunnaa 'ibaadal-Allahil-mukhlaseen » — nous aurions été les serviteurs sincères d'Allah. La prétention. Ils prétendaient qu'ils auraient été sincères avec un ancien livre. Le miroir révèle : la sincérité se prouve maintenant, pas en théorie.`,
  reflection: `La sincérité se prouve maintenant, pas en théorie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakunnaa 'ibaadal-Allahil-mukhlaseen » — nous aurions été les serviteurs sincères d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sincère maintenant, ou seulement en théorie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité hypothétique n'est pas la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers juge par les actes, pas par les paroles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît le cœur — les prétentions ne Le trompent pas." }
  ],
  munajat: `Ya Rabb, fais que ma sincérité soit réelle, pas théorique. Tu connais mon cœur.`
};

MIROIR["37:169"] = {
  reference: "37:169",
  theme: ["foi", "hypocrisie", "prétention"],
  emotion: "Vérité, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "An-Nifaq"],
  mirrorVersion: `« Ils ont mécru, et ils sauront. » Le miroir me montre la réalité derrière la prétention. « Fakafaroo bihi » — ils ont mécru. La réalité. « Fasaufa ya'lamoon » — ils sauront. La conséquence. Malgré leurs prétentions, ils ont rejeté le Coran. Le miroir m'avertit : les conséquences suivront.`,
  reflection: `Les prétentions ne changent pas la réalité — les conséquences suivront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakafaroo bihi fasaufa ya'lamoon » — ils ont mécru, et ils sauront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis une chose et en fais une autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention cache souvent la mécréance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers révèle la vérité de chaque cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah sait la vérité avant même qu'elle ne soit révélée." }
  ],
  munajat: `Ya Rabb, purifie mes intentions. Ne permets pas que je prétende ce que je ne suis pas.`
};

MIROIR["37:170"] = {
  reference: "37:170",
  theme: ["mécréance", "conséquence", "science"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Kufr", "Al-'Ilm"],
  mirrorVersion: `« Ils ont mécru, et ils sauront. » Le miroir me montre la réalité cachée. « Fakafaroo » — ils ont mécru. Le rejet. « Fasaufa ya'lamoon » — ils sauront. La révélation future. Les mécréants sauront la vérité quand il sera trop tard. Le miroir m'avertit : ne pas attendre pour croire.`,
  reflection: `Ne pas attendre pour croire — la vérité sera révélée mais peut-être trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakafaroo fasaufa ya'lamoon » — ils ont mécru, et ils sauront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je repousse la vérité pour plus tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Savoir trop tard est le pire des savoirs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers révèlera la vérité au Jour Dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Croire maintenant vaut mieux que savoir plus tard." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que je sache trop tard. Guide-moi dès maintenant.`
};

MIROIR["37:171"] = {
  reference: "37:171",
  theme: ["parole", "prophète", "victoire"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Kalam", "Ar-Rusul"],
  mirrorVersion: `« Notre parole a déjà été donnée à Nos serviteurs les envoyés. » Le miroir me montre la promesse d'Allah. « Wa laqad sabaqat kalimatunaa li-'ibaadinal-mursaleen » — notre parole a déjà été donnée à Nos serviteurs les envoyés. La promesse. La victoire des prophètes est garantie. Le miroir me rassure : la vérité triomphe.`,
  reflection: `La victoire des prophètes est garantie par la parole d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad sabaqat kalimatunaa li-'ibaadinal-mursaleen » — notre parole a déjà été donnée à Nos serviteurs les envoyés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la promesse d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah est plus certaine que toute réalité visible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à la parole d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La parole d'Allah est Sa promesse éternelle." }
  ],
  munajat: `Ya Rabb, Ta parole est vérité. Je fais confiance à Ta promesse de victoire pour la vérité.`
};

MIROIR["37:172"] = {
  reference: "37:172",
  theme: ["secours", "victoire", "prophète"],
  emotion: "Confiance, espoir",
  difficulty: "débutant",
  relatedNames: ["An-Nasr", "Al-Ghalib"],
  mirrorVersion: `« Ce sont eux qui seront secourus. » Le miroir me montre la victoire promise. « Innahum lahumul-mansooroon » — ce sont eux qui seront secourus. La victoire. Les prophètes et leurs disciples seront secourus. Le miroir me rassure : le secours d'Allah est certain.`,
  reflection: `Le secours d'Allah pour les croyants est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahum lahumul-mansooroon » — ce sont eux qui seront secourus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Attends-je le secours d'Allah avec confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secours d'Allah vient souvent quand tout semble perdu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers se range du côté des prophètes d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le secours d'Allah est déjà décrété." }
  ],
  munajat: `Ya Nasir, Ton secours est certain. Je l'attends avec confiance.`
};

MIROIR["37:173"] = {
  reference: "37:173",
  theme: ["victoire", "soldat", "force"],
  emotion: "Force, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Jund", "Al-Ghalab"],
  mirrorVersion: `« Et Nos soldats auront le dessus. » Le miroir me montre la supériorité divine. « Wa inna jundanaa lahumul-ghaaliboon » — et Nos soldats auront le dessus. La supériorité. Les soldats d'Allah — anges et croyants — sont victorieux. Le miroir me rassure : le camp d'Allah l'emporte.`,
  reflection: `Le camp d'Allah l'emporte toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna jundanaa lahumul-ghaaliboon » — et Nos soldats auront le dessus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je dans le camp d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire appartient aux soldats d'Allah, pas aux armées du monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est le soldat d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les soldats d'Allah sont invisibles mais invincibles." }
  ],
  munajat: `Ya Rabb, fais-moi Ton soldat. Donne-moi la victoire avec Ton camp.`
};

MIROIR["37:174"] = {
  reference: "37:174",
  theme: ["détournement", "patience", "échéance"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Tawalli", "As-Sabr"],
  mirrorVersion: `« Détourne-toi d'eux pour un temps. » Le miroir me montre la stratégie prophétique. « Fa-tawalla 'anhum hattaaneen » — détourne-toi d'eux pour un temps. La stratégie. Le Prophète doit patienter face au rejet. Le miroir m'enseigne : la patience face au rejet est une stratégie.`,
  reflection: `La patience face au rejet est une stratégie spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tawalla 'anhum hattaaneen » — détourne-toi d'eux pour un temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis rejeté, est-ce que je patiente ou est-ce que je me vexe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement temporaire prépare le retour triomphant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers patiente pour chaque prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La patience d'Allah est plus grande que l'impatience des hommes." }
  ],
  munajat: `Ya Rabb, apprends-moi la patience. Quand je suis rejeté, aide-moi à attendre Ton moment.`
};

MIROIR["37:175"] = {
  reference: "37:175",
  theme: ["vision", "conséquence", "avenir"],
  emotion: "Attention, attente",
  difficulty: "débutant",
  relatedNames: ["An-Nazar", "Al-'Aqibah"],
  mirrorVersion: `« Et observe, ils verront. » Le miroir me montre l'attente de la conséquence. « Wa absirhum fasaufa yubsiroon » — et observe, ils verront. L'attente. Le prophète observe, les mécréants verront les conséquences. Le miroir m'invite à l'observation patiente.`,
  reflection: `L'observation patiente précède la révélation des conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa absirhum fasaufa yubsiroon » — et observe, ils verront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'observe avec patience ou précipitation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Voir les conséquences est pour eux — observer la patience est pour le prophète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers révèle ses conséquences à son rythme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui observe avec patience voit la vérité se dévoiler." }
  ],
  munajat: `Ya Rabb, apprends-moi à observer avec patience. Fais que je voie Ta vérité se dévoiler.`
};

MIROIR["37:176"] = {
  reference: "37:176",
  theme: ["châtiment", "hâte", "question"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Al-'Ajalah"],
  mirrorVersion: `« Cherchent-ils à hâter Notre châtiment ? » Le miroir me montre l'impatience destructrice. « Afabi-'adhaabinaa yasta'jiloon » — cherchent-ils à hâter Notre châtiment ? La question. Les mécréants défient le châtiment. Le miroir m'avertit : ne pas défier le châtiment.`,
  reflection: `Ne pas défier le châtiment d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afabi-'adhaabinaa yasta'jiloon » — cherchent-ils à hâter Notre châtiment ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défie les conséquences de mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Hâter le châtiment est le comble de l'insouciance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne précipite pas le châtiment — il le décrète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le châtiment d'Allah vient au moment parfait." }
  ],
  munajat: `Ya Rabb, je ne défie pas Ton châtiment. Je me repens avant qu'il ne soit trop tard.`
};

MIROIR["37:177"] = {
  reference: "37:177",
  theme: ["désastre", "territoire", "avertissement"],
  emotion: "Avertissement, peur",
  difficulty: "débutant",
  relatedNames: ["As-Sayyi'ah", "Al-Ard"],
  mirrorVersion: `« Quand il fondra sur leur territoire, quel mauvais matin pour ceux qu'on avertit ! » Le miroir me montre l'inévitabilité du châtiment. « Fa-idha waqa'a 'alaa wajhis-saatihi saa'atu subhuhum » — quand il fondra sur leur territoire, quel mauvais matin pour ceux qu'on avertit ! L'avertissement. Le châtiment vient au moment inattendu.`,
  reflection: `Le châtiment vient au moment inattendu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha waqa'a 'alaa wajhis-saatihi saa'atu subhuhum » — quand il fondra sur leur territoire, quel mauvais matin pour ceux qu'on avertit !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le moment inattendu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mauvais matin est la conséquence de l'insouciance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut changer en un instant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le moment du châtiment est connu d'Allah seul." }
  ],
  munajat: `Ya Rabb, prépare-moi pour le moment inattendu. Fais que je sois prêt chaque matin.`
};

MIROIR["37:178"] = {
