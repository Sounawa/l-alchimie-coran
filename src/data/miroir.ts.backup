    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour le Paradis obtient le repos éternel." }
  ],
  munajat: `Ya Rabb, je veux le repos éternel sur les lits du Paradis. Donne-moi l'effort pour y accéder. Accorde-moi la contemplation bienheureuse.`
};

MIROIR["37:45"] = {
