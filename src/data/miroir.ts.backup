// ==================== SURAH 37: AS-SAFFAT - MISSING VERSES ====================

MIROIR["37:2"] = {
  reference: "37:2",
  theme: ["vents", "souffle", "obéissance"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Ar-Riyah", "Al-Gha'idiqat"],
  mirrorVersion: `« Et par celles qui soufflent avec violence. » Le miroir me montre les vents violents. « Wa al-'asifati 'asfan » — et par celles qui soufflent avec violence. Les vents obéissants. Le miroir m'invite à méditer sur les forces naturelles soumises.`,
  reflection: `Les vents violents sont créés et soumis par Allah. Ils obéissent à Son commandement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-'asifati 'asfan » — et par celles qui soufflent avec violence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis soumis comme les vents ? Ou est-ce que je résiste au commandement d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission des vents est un modèle pour l'homme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est soumis par les forces naturelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet comme les vents est en harmonie avec l'univers." }
  ],
  munajat: `Ya Rabb, les vents T'obéissent. Fais que je T'obéisse comme eux. Soumets mon cœur à Ton commandement.`
};

MIROIR["37:3"] = {
  reference: "37:3",
  theme: ["révélation", "livre", "ange"],
  emotion: "Révérence, contemplation",
  difficulty: "débutant",
  relatedNames: ["At-Tanzil", "Al-Mala'ikah"],
  mirrorVersion: `« Et par celles qui distribuent les commandements. » Le miroir me montre les anges distributeurs. « Wa an-nashirati nashran » — et par celles qui distribuent les commandements. Les anges obéissants. Le miroir m'invite à méditer sur le rôle des anges.`,
  reflection: `Les anges distribuent les commandements d'Allah. Ils sont les messagers entre Allah et la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa an-nashirati nashran » — et par celles qui distribuent les commandements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les commandements d'Allah comme les anges les distribuent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des commandements est la voie de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit les commandements d'Allah par les anges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les commandements est en harmonie avec les anges." }
  ],
  munajat: `Ya Rabb, j'accepte Tes commandements. Fais que je sois en harmonie avec Tes anges. Donne-moi la soumission à Tes ordres.`
};

MIROIR["37:4"] = {
  reference: "37:4",
  theme: ["unicité", "divinité", "tawhid"],
  emotion: "Certitude, adoration",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ilah"],
  mirrorVersion: `« Votre Dieu est certes unique. » Le miroir me montre l'unicité absolue. « Inna ilahakum la-wahid » — votre Dieu est certes unique. L'affirmation centrale. Le miroir m'invite à la foi en l'unicité.`,
  reflection: `Allah est unique. Pas de divinité autre que Lui. C'est le fondement de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ilahakum la-wahid » — votre Dieu est certes unique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en l'unicité d'Allah ? Ou est-ce que j'ai des divinités cachées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unicité d'Allah est le fondement de tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de l'unicité de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment en l'unicité a purifié sa foi." }
  ],
  munajat: `Ya Wahid, Tu es mon Dieu unique. Je crois en Ton unicité. Purifie ma foi de toute association.`
};

MIROIR["37:5"] = {
  reference: "37:5",
  theme: ["seigneur", "cieux", "création"],
  emotion: "Adoration, révérence",
  difficulty: "débutant",
  relatedNames: ["Ar-Rabb", "As-Samawat"],
  mirrorVersion: `« Seigneur des cieux et de la terre et de ce qui est entre eux. » Le miroir me montre la seigneurie universelle. « Rabbu as-samawati wa al-ard wa ma baynahuma » — Seigneur des cieux et de la terre et de ce qui est entre eux. La seigneurie totale. Le miroir m'invite à reconnaître la seigneurie d'Allah sur tout.`,
  reflection: `Allah est Seigneur de tout. Les cieux, la terre et tout ce qui est entre eux Lui appartiennent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbu as-samawati wa al-ard wa ma baynahuma » — Seigneur des cieux et de la terre et de ce qui est entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la seigneurie d'Allah sur tout ? Ou est-ce que je la limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la seigneurie universelle mène à la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier reconnaît son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la seigneurie d'Allah sur tout se soumet à Lui en tout." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur des cieux et de la terre. Je reconnais Ta seigneurie sur tout. Soumets-moi à Toi en toutes choses.`
};

MIROIR["37:6"] = {
  reference: "37:6",
  theme: ["étoiles", "ornement", "protection"],
  emotion: "Émerveillement, beauté",
  difficulty: "débutant",
  relatedNames: ["An-Nujum", "Az-Zinah"],
  mirrorVersion: `« Nous avons décoré le ciel le plus proche d'un ornement : les étoiles. » Le miroir me montre la beauté cosmique. « Inna zayyanna as-sama'a ad-dunya bi-zinatin » — Nous avons décoré le ciel le plus proche d'un ornement. La beauté. « Al-kawakib » — les étoiles. L'ornement. Le miroir m'invite à contempler la beauté du ciel.`,
  reflection: `Les étoiles sont l'ornement du ciel. La beauté de la création est un signe du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna zayyanna as-sama'a ad-dunya bi-zinatin al-kawakib » — Nous avons décoré le ciel le plus proche d'un ornement : les étoiles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple la beauté du ciel ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté du ciel est un signe de la beauté du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est orné par la beauté de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la beauté du ciel contemple la beauté du Créateur." }
  ],
  munajat: `Ya Rabb, les étoiles sont la beauté de Ton ciel. Ouvre mes yeux sur cette beauté. Fais que je contemple avec le cœur.`
};

MIROIR["37:7"] = {
  reference: "37:7",
  theme: ["protection", "démons", "barrière"],
  emotion: "Sécurité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hifz", "Ash-Shayatin"],
  mirrorVersion: `« Et protection contre tout démon rebelle. » Le miroir me montre la protection divine. « Wa hifzan min kulli shaytanin marid » — et protection contre tout démon rebelle. La protection. Le miroir m'invite à la gratitude pour cette protection.`,
  reflection: `Le ciel est protégé contre les démons rebelles. La protection d'Allah est sur la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hifzan min kulli shaytanin marid » — et protection contre tout démon rebelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la protection d'Allah ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est un don qui mérite gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est protégé par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la protection est protégé davantage." }
  ],
  munajat: `Ya Hafiz, merci pour Ta protection contre les démons. Protège-moi de tout mal. Garde-moi dans Ta sécurité.`
};

MIROIR["37:8"] = {
  reference: "37:8",
  theme: ["écoute", "interdiction", "châtiment"],
  emotion: "Vigilance, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sam'", "As-Sahim"],
  mirrorVersion: `« Ils ne peuvent écouter les conversations des anges. » Le miroir me montre l'interdiction pour les démons. « La yassamma'una ila al-mala'i al-a'la » — ils ne peuvent écouter les conversations des anges supérieurs. L'interdiction. Le miroir m'invite à méditer sur l'accès interdit.`,
  reflection: `Les démons sont exclus de l'écoute des anges. Leur rébellion a des conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yassamma'una ila al-mala'i al-a'la » — ils ne peuvent écouter les conversations des anges supérieurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai accès à l'écoute divine ? Ou est-ce que je suis exclu par ma rébellion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accès à l'écoute divine est pour les soumis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers écoute son Créateur par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet a accès à l'écoute divine." }
  ],
  munajat: `Ya Rabb, je veux avoir accès à Ton écoute. Ne m'exclus pas par ma rébellion. Donne-moi l'accès par ma soumission.`
};

MIROIR["37:9"] = {
  reference: "37:9",
  theme: ["repoussement", "châtiment", "démons"],
  emotion: "Réalité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Ad-Daf'", "Al-'Adhab"],
  mirrorVersion: `« Ils sont repoussés de tous côtés, et ils auront un châtiment permanent. » Le miroir me montre le sort des démons. « Yuqdhafuna min kulli janibin » — ils sont repoussés de tous côtés. Le rejet. « Wa lahum 'adhabun wasib » — et ils auront un châtiment permanent. La conséquence. Le miroir m'avertit : la rébellion mène au rejet et au châtiment.`,
  reflection: `Les démons rebelles sont repoussés et châtiés. La rébellion n'est pas sans conséquence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuqdhafuna min kulli janibin wa lahum 'adhabun wasib » — ils sont repoussés de tous côtés, et ils auront un châtiment permanent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je risque le rejet par ma rébellion ? Ou est-ce que je me soumis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission évite le rejet et le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas repoussé par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet n'est pas repoussé." }
  ],
  munajat: `Ya Rabb, je me soumets à Toi. Ne me repousse pas. Épargne-moi le châtiment permanent. Garde-moi dans Ta miséricorde.`
};

MIROIR["37:10"] = {
  reference: "37:10",
  theme: ["capture", "flamme", "châtiment"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Shihab", "Al-Sarif"],
  mirrorVersion: `« Sauf celui qui saisit au vol, alors une flamme le poursuit. » Le miroir me montre le sort de celui qui tente de saisir. « Illa man khatafa al-khatfah » — sauf celui qui saisit au vol. La tentative. « Fa-atba'ahu shihabun thaqib » — alors une flamme le poursuit. Le châtiment. Le miroir m'avertit : même la tentative est punie.`,
  reflection: `Ceux qui tentent de saisir l'écoute divine sont poursuivis par des flammes. Rien n'échappe à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa man khatafa al-khatfah fa-atba'ahu shihabun thaqib » — sauf celui qui saisit au vol, alors une flamme le poursuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tente de saisir ce qui ne m'appartient pas ? Ou est-ce que je respecte les limites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des limites protège du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte les limites établies par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites n'est pas poursuivi." }
  ],
  munajat: `Ya Rabb, je respecte Tes limites. Ne permets pas que je saisisse ce qui ne m'appartient pas. Protège-moi de la flamme poursuivante.`
};

MIROIR["37:11"] = {
  reference: "37:11",
  theme: ["création", "comparaison", "question"],
  emotion: "Humilité, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khalq", "As-Suw'al"],
  mirrorVersion: `« Demande-leur s'ils sont plus difficiles à créer que ceux que Nous avons créés. » Le miroir me montre la question rhétorique. « Fa-staftihim a-hum ashaddu khalqan am man khalaqna » — demande-leur s'ils sont plus difficiles à créer que ceux que Nous avons créés. L'interrogation. Le miroir m'invite à méditer sur la facilité de la création pour Allah.`,
  reflection: `L'homme n'est pas plus difficile à créer que le reste de l'univers. La création est facile pour Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-staftihim a-hum ashaddu khalqan am man khalaqna » — demande-leur s'ils sont plus difficiles à créer que ceux que Nous avons créés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me considère comme difficile à créer ? Ou est-ce que je reconnais la facilité de la création pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création est facile pour Allah, quel que soit l'être." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est facile à créer pour son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la facilité de la création pour Allah a une foi complète." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé facilement. Je ne suis pas difficile pour Toi. Reconnaître la facilité de Ta création renforce ma foi.`
};

MIROIR["37:12"] = {
  reference: "37:12",
  theme: ["étonnement", "moquerie", "création"],
  emotion: "Tristesse, patience",
  difficulty: "débutant",
  relatedNames: ["Al-'Ajab", "As-Sukhriyah"],
  mirrorVersion: `« Tu t'étonnes, et ils se moquent. » Le miroir me montre la différence d'attitude. « Bal 'ajibta wa yaskharun » — tu t'étonnes, et ils se moquent. Le contraste. Le miroir m'invite à méditer sur la différence de réaction.`,
  reflection: `Le Prophète s'étonne de la création, les mécréants se moquent. Deux attitudes face à la même réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal 'ajibta wa yaskharun » — tu t'étonnes, et ils se moquent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon attitude face à la création ? L'étonnement ou la moquerie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement est la bonne attitude, la moquerie est l'erreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'étonne de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'étonne de la création est sur le bon chemin." }
  ],
  munajat: `Ya Rabb, je m'étonne de Ta création. Ne permets pas que je me moque. Garde-moi dans l'étonnement bienveillant.`
};

MIROIR["37:13"] = {
  reference: "37:13",
  theme: ["rappel", "indifférence", "insouciance"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikr", "Al-Ghaflah"],
  mirrorVersion: `« Et quand on le leur rappelle, ils ne se rappellent pas. » Le miroir me montre l'indifférence au rappel. « Wa idha dhukiru la yadhkarun » — et quand on le leur rappelle, ils ne se rappellent pas. L'oubli volontaire. Le miroir m'avertit : ignorer le rappel est une maladie du cœur.`,
  reflection: `Le rappel est donné, mais il est ignoré. L'insouciance est un choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha dhukiru la yadhkarun » — et quand on le leur rappelle, ils ne se rappellent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me rappelle quand on me rappelle ? Ou est-ce que j'oublie volontairement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel accepté ouvre le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers se rappelle de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle quand on lui rappelle est guidé." }
  ],
  munajat: `Ya Rabb, je me rappelle quand Tu me rappelles. Ne permets pas que j'oublie volontairement. Ouvre mon cœur au rappel.`
};

MIROIR["37:14"] = {
  reference: "37:14",
  theme: ["signe", "regard", "moquerie"],
  emotion: "Mise en garde, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ayah", "An-Nazar"],
  mirrorVersion: `« Et quand ils voient un signe, ils le tournent en moquerie. » Le miroir me montre le mépris des signes. « Wa idha ra'aw ayatan yastahzi'un » — et quand ils voient un signe, ils le tournent en moquerie. Le rejet. Le miroir m'avertit : mépriser les signes est une grave erreur.`,
  reflection: `Les signes d'Allah sont méprisés par les mécréants. Leur cécité les empêche de voir la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'aw ayatan yastahzi'un » — et quand ils voient un signe, ils le tournent en moquerie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux signes d'Allah ? Avec respect ou moquerie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des signes est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte les signes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les signes reçoit la guidance." }
  ],
  munajat: `Ya Rabb, je respecte Tes signes. Ne permets pas que je les tourne en moquerie. Ouvre mes yeux sur les signes de Ta création.`
};

MIROIR["37:15"] = {
  reference: "37:15",
  theme: ["accusation", "magie", "mensonge"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["As-Sihr", "Al-Kadhib"],
  mirrorVersion: `« Ils disent : 'Ce n'est que magie évidente.' » Le miroir me montre l'accusation mensongère. « Wa qalu in hadha illa sihrun mubin » — ils disent : ce n'est que magie évidente. L'accusation. Le miroir m'enseigne : l'accusation des mécréants ne change pas la vérité.`,
  reflection: `Les mécréants accusent le prophète de magie. La vérité reste la vérité malgré les accusations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu in hadha illa sihrun mubin » — ils disent : ce n'est que magie évidente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accuse la vérité de mensonge ? Ou est-ce que je la reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité reste vraie malgré les accusations." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas sur la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité la trouve." }
  ],
  munajat: `Ya Haqq, je reconnais Ta vérité. Ne permets pas que je l'accuse de mensonge. Donne-moi la clarté de voir la vérité.`
};

MIROIR["37:16"] = {
  reference: "37:16",
  theme: ["mort", "poussière", "résurrection"],
  emotion: "Questionnement, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Mawt", "Al-Ba'th"],
  mirrorVersion: `« Quand nous serons morts et réduits en poussière, serons-nous ressuscités ? » Le miroir me montre le doute des mécréants. « A-idha mitna wa kunna turaban wa 'izaman a-inna la-mab'uthun » — quand nous serons morts et réduits en poussière, serons-nous ressuscités ? Le doute. Le miroir m'invite à méditer sur la certitude de la résurrection.`,
  reflection: `Les mécréants doutent de la résurrection. Mais la résurrection est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-idha mitna wa kunna turaban wa 'izaman a-inna la-mab'uthun » — quand nous serons morts et réduits en poussière, serons-nous ressuscités ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la résurrection ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est certaine pour ceux qui croient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera ressuscité par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection se prépare." }
  ],
  munajat: `Ya Ba'ith, je crois en la résurrection. Ne permets pas que je doute. Prépare-moi pour ce jour certain.`
};

MIROIR["37:17"] = {
  reference: "37:17",
  theme: ["ancêtres", "résurrection", "question"],
  emotion: "Questionnement, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Aba", "Al-Ba'th"],
  mirrorVersion: `« Et nos anciens ancêtres aussi ? » Le miroir me montre l'extension de la question. « Wa aba'una al-awwalun » — et nos anciens ancêtres aussi ? L'extension. Le miroir m'invite à méditer sur la résurrection universelle.`,
  reflection: `La résurrection inclut tous les ancêtres. Personne n'est oublié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aba'una al-awwalun » — et nos anciens ancêtres aussi ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que tous seront ressuscités ? Ou est-ce que je limite la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est pour tous, sans exception." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera ressuscité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection universelle comprend la justice d'Allah." }
  ],
  munajat: `Ya Rabb, je crois que tous seront ressuscités. Ta résurrection est universelle. Prépare tous les miens pour ce jour.`
};

MIROIR["37:18"] = {
  reference: "37:18",
  theme: ["réponse", "humiliation", "vérité"],
  emotion: "Réalité, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Jawab", "Adh-Dhillah"],
  mirrorVersion: `« Dis : 'Oui, et vous serez humiliés.' » Le miroir me montre la réponse divine. « Qul na'am wa antum dakhirun » — dis : oui, et vous serez humiliés. La certitude et la conséquence. Le miroir m'avertit : la résurrection est certaine et les mécréants seront humiliés.`,
  reflection: `La résurrection est certaine. Les mécréants seront humiliés. La vérité est implacable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul na'am wa antum dakhirun » — dis : oui, et vous serez humiliés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai humilié ? Ou est-ce que je serai honoré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation est pour les mécréants, l'honneur pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne sera pas humilié par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sera honoré, pas humilié." }
  ],
  munajat: `Ya Rabb, je veux être honoré, pas humilié. Donne-moi la foi qui mène à l'honneur. Ne permets pas que je sois parmi les humiliés.`
};

MIROIR["37:19"] = {
  reference: "37:19",
  theme: ["cri", "résurrection", "soudaineté"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sayha", "An-Nazar"],
  mirrorVersion: `« Ce ne sera qu'un seul Cri, et les voilà regardant. » Le miroir me montre la soudaineté de la résurrection. « Fa-innama hiya zajratun wahidatun » — ce ne sera qu'un seul Cri. La soudaineté. « Fa-idha hum yanzurun » — et les voilà regardant. La conscience. Le miroir m'avertit : la résurrection est soudaine.`,
  reflection: `Un seul cri suffit pour la résurrection. Tout le monde se met à regarder.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innama hiya zajratun wahidatun fa-idha hum yanzurun » — ce ne sera qu'un seul Cri, et les voilà regardant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour le cri soudain ? Ou est-ce que je serai pris au dépourvu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le cri soudain est nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera réveillé par le cri." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour le cri n'est pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, je me prépare pour le cri soudain. Ne permets pas que je sois pris au dépourvu. Réveille-moi par Ta miséricorde.`
};

MIROIR["37:20"] = {
  reference: "37:20",
  theme: ["jugement", "regret", "réalité"],
  emotion: "Regret, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "An-Nadam"],
  mirrorVersion: `« Ils diront : 'Malheur à nous ! C'est le jour du Jugement.' » Le miroir me montre le regret tardif. « Wa qalu ya waylana hadha yawmu ad-din » — ils diront : malheur à nous ! C'est le jour du Jugement. La réalisation. Le miroir m'avertit : le regret au jour du Jugement est trop tard.`,
  reflection: `Le regret au jour du Jugement est inefficace. La foi doit venir avant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu ya waylana hadha yawmu ad-din » — ils diront : malheur à nous ! C'est le jour du Jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour le jour du Jugement ? Ou est-ce que j'attendrai le regret ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation avant le jour du Jugement évite le regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers se prépare pour le jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare avant le jour du Jugement n'a pas de regret." }
  ],
  munajat: `Ya Rabb, je me prépare pour le jour du Jugement. Ne permets pas que j'aie le regret tardif. Donne-moi la préparation complète.`
};

MIROIR["37:21"] = {
  reference: "37:21",
  theme: ["séparation", "jugement", "accusation"],
  emotion: "Réalité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Fasl", "At-Takdhib"],
  mirrorVersion: `« C'est le jour de la Séparation que vous traitiez de mensonge. » Le miroir me montre la réalité du jour. « Hadha yawmu al-fasli alladhi kuntum bihi tukadhdhibun » — c'est le jour de la Séparation que vous traitiez de mensonge. La réalité de ce qui était nié. Le miroir m'avertit : nier le jour ne l'empêche pas d'arriver.`,
  reflection: `Le jour de la Séparation arrive, qu'on le croie ou non. Le déni ne change rien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadha yawmu al-fasli alladhi kuntum bihi tukadhdhibun » — c'est le jour de la Séparation que vous traitiez de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au jour de la Séparation ? Ou est-ce que je le traite de mensonge ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi au jour de la Séparation prépare à sa venue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend le jour de la Séparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au jour de la Séparation est prêt." }
  ],
  munajat: `Ya Rabb, je crois au jour de la Séparation. Ne permets pas que je le traite de mensonge. Prépare-moi pour ce jour de vérité.`
};

MIROIR["37:22"] = {
  reference: "37:22",
  theme: ["rassemblement", "injustes", "épouses"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hashr", "Az-Zalimun"],
  mirrorVersion: `« Rassemblez les injustes et leurs épouses et ce qu'ils adoraient. » Le miroir me montre le rassemblement complet. « Uhshuru alladhina zalamu wa azwajahum » — rassemblez les injustes et leurs épouses. Le rassemblement. « Wa ma kanu ya'budun » — et ce qu'ils adoraient. Les idoles. Le miroir m'avertit : tous seront rassemblés.`,
  reflection: `Les injustes, leurs épouses et leurs idoles seront rassemblés. Personne n'y échappe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uhshuru alladhina zalamu wa azwajahum wa ma kanu ya'budun » — rassemblez les injustes et leurs épouses et ce qu'ils adoraient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi les rassemblés injustes ? Ou parmi les justes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement des justes est différent de celui des injustes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera rassemblé devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste n'est pas rassemblé parmi les injustes." }
  ],
  munajat: `Ya Rabb, je ne veux pas être rassemblé parmi les injustes. Donne-moi la justice. Garde-moi parmi les justes.`
};

MIROIR["37:23"] = {
  reference: "37:23",
  theme: ["chemin", "enfer", "guide"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sirat", "Jahannam"],
  mirrorVersion: `« Et guidez-les vers le chemin de la Fournaise. » Le miroir me montre la destination finale. « Min duni Allahi fa-hduhum ila tariqi al-jahim » — en dehors d'Allah, guidez-les vers le chemin de la Fournaise. La destination. Le miroir m'avertit : le chemin sans Allah mène à la Fournaise.`,
  reflection: `Ceux qui prennent des chemins en dehors d'Allah sont guidés vers l'Enfer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min duni Allahi fa-hduhum ila tariqi al-jahim » — en dehors d'Allah, guidez-les vers le chemin de la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quel chemin suis-je ? Le chemin d'Allah ou le chemin de la Fournaise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin d'Allah mène au Paradis, pas à la Fournaise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit le chemin de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le chemin d'Allah n'est pas guidé vers la Fournaise." }
  ],
  munajat: `Ya Rabb, je suis Ton chemin. Ne me guide pas vers la Fournaise. Garde-moi sur le chemin du Paradis.`
};

MIROIR["37:24"] = {
  reference: "37:24",
  theme: ["arrêt", "question", "responsabilité"],
  emotion: "Crainte, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Waqf", "As-Su'al"],
  mirrorVersion: `« Et arrêtez-les, ils seront interrogés. » Le miroir me montre l'interrogatoire. « Wa qifuhum innahum mas'ulun » — et arrêtez-les, ils seront interrogés. L'arrêt et la question. Le miroir m'avertit : tous seront interrogés.`,
  reflection: `L'interrogatoire est certain. Personne n'échappe à la question.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qifuhum innahum mas'ulun » — et arrêtez-les, ils seront interrogés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour l'interrogatoire ? Ou est-ce que je serai pris au dépourvu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour l'interrogatoire est nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera interrogé sur son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour l'interrogatoire répond avec assurance." }
  ],
  munajat: `Ya Rabb, je me prépare pour l'interrogatoire. Donne-moi de bonnes réponses. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["75:27"] = {
  reference: "75:27",
  theme: ["agonie", "guérison", "désespoir"],
  emotion: "Détresse, impuissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Shafi"],
  mirrorVersion: `« Et quand on dira : Qui est le guérisseur ? » La question du guérisseur. Le miroir m'enseigne : à l'agonie, on cherche le guérisseur. Mais la mort vient d'Allah.`,
  reflection: `À l'agonie, on cherche le guérisseur. Mais la mort vient d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qila man raq » — et quand on dira : qui est le guérisseur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche le guérisseur en Allah ? Ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le seul vrai guérisseur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guérison vient d'Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le guérisseur en Allah le trouve." }
  ],
  munajat: `Ya Shafi, Tu es mon guérisseur. Je me tourne vers Toi dans l'agonie.`
};

MIROIR["75:28"] = {
  reference: "75:28",
  theme: ["séparation", "réalisation", "agonie"],
  emotion: "Réalisation, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Firaq", "Al-Mawt"],
  mirrorVersion: `« Et il pensera que c'est la séparation. » La réalisation de la séparation. Le miroir m'enseigne : l'agonie révèle la séparation d'avec ce monde. La préparation doit précéder.`,
  reflection: `L'agonie révèle la séparation. La préparation doit précéder.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa zanna annahu al-firaq » — et il pensera que c'est la séparation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour la séparation ? Ma préparation est-elle faite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation rend la séparation acceptable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La séparation est inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare accueille la séparation." }
  ],
  munajat: `Ya Rabb, je me prépare pour la séparation. Accueille-moi quand elle vient.`
};

MIROIR["75:29"] = {
  reference: "75:29",
  theme: ["jambes", "entrelacement", "agonie"],
  emotion: "Détresse, impuissance",
  difficulty: "avancé",
  relatedNames: ["Al-Mawt", "Al-Qadir"],
  mirrorVersion: `« Et les jambes s'entrelaceront. » L'image des jambes entrelacées. Le miroir m'enseigne : l'agonie est un combat. Les jambes entrelacées symbolisent la lutte finale.`,
  reflection: `L'agonie est un combat. La préparation spirituelle aide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-tafati al-saqu bi-al-saq » — et les jambes s'entrelaceront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour le combat final ? Ma préparation est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation spirituelle calme le combat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est le passage universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est préparé passe en paix." }
  ],
  munajat: `Ya Rabb, prépare-moi pour le passage. Fais que je passe en paix.`
};

MIROIR["75:30"] = {
  reference: "75:30",
  theme: ["destination", "Seigneur", "jour"],
  emotion: "Réalisation, destination",
  difficulty: "débutant",
  relatedNames: ["Al-Rabb", "Al-Masir"],
  mirrorVersion: `« Vers ton Seigneur sera la destination. » La répétition de la destination. Le miroir m'enseigne : la destination finale est Allah. Tout converge vers Lui.`,
  reflection: `La destination finale est Allah. Tout converge vers Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila rabbika yawma-idhin al-masq » — vers ton Seigneur sera la destination." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que ma destination est Allah ? Mon voyage est-il orienté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destination est le but. Le voyage doit y tendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout retourne vers le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui oriente son voyage y arrive." }
  ],
  munajat: `Ya Rabb, Tu es ma destination. Oriente mon voyage vers Toi.`
};

MIROIR["75:31"] = {
  reference: "75:31",
  theme: ["confirmation", "prière", "désobéissance"],
  emotion: "Avertissement, jugement",
  difficulty: "débutant",
  relatedNames: ["Al-Salah", "Al-Tasdiq"],
  mirrorVersion: `« Mais il n'a ni confirmé ni prié. » Le refus de la foi. Le miroir m'avertit : celui qui ne confirme pas et ne prie pas est perdu. La confirmation et la prière sont essentielles.`,
  reflection: `La confirmation et la prière sont essentielles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fala saddaqa wa la salla » — mais il n'a ni confirmé ni prié." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je confirme la vérité ? Est-ce que je prie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confirmation et la prière sont les deux piliers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi sans prière est incomplète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui confirme et prie est sauvé." }
  ],
  munajat: `Ya Rabb, je confirme la vérité et je prie. Accepte ma confirmation et ma prière.`
};

MIROIR["75:32"] = {
  reference: "75:32",
  theme: ["démenti", "détournement", "mécréance"],
  emotion: "Avertissement, jugement",
  difficulty: "débutant",
  relatedNames: ["Al-Takdhib", "Al-Tawalla"],
  mirrorVersion: `« Mais il a démenti et tourné le dos. » Le rejet total. Le miroir m'avertit : démentir et tourner le dos est le comble du rejet. La mécréance active mène à la perte.`,
  reflection: `Démentir et tourner le dos est le comble du rejet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lakin kadhdhaba wa tawalla » — mais il a démenti et tourné le dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je démens la vérité ? Ou est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation est la voie. Le rejet est la perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste la vérité même si on la rejette." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité reçoit la lumière." }
  ],
  munajat: `Ya Rabb, j'accepte la vérité. Ne permets pas que je la démente.`
};

MIROIR["75:33"] = {
  reference: "75:33",
  theme: ["orgueil", "famille", "mécréance"],
  emotion: "Avertissement, jugement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Takabbur", "Al-Ahl"],
  mirrorVersion: `« Puis il s'en est allé vers sa famille, marchant avec orgueil. » L'orgueil dans la désobéissance. Le miroir m'avertit : l'orgueil accompagne souvent la mécréance. La famille ne protège pas du jugement.`,
  reflection: `L'orgueil accompagne souvent la mécréance. La famille ne protège pas du jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma dhahaba ila ahli yatamatta » — puis il s'en est allé vers sa famille, marchant avec orgueil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je marche avec orgueil ? Ou est-ce que je marche avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité accompagne la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil est la maladie des mécréants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui marche avec humilité est élevé." }
  ],
  munajat: `Ya Rabb, fais que je marche avec humilité. Ne permets pas l'orgueil dans mon cœur.`
};

MIROIR["75:34"] = {
  reference: "75:34",
  theme: ["malheur", "approche", "avertissement"],
  emotion: "Avertissement, urgence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wayl", "Al-Qarib"],
  mirrorVersion: `« Malheur à toi, malheur ! » Le double malheur. Le miroir m'avertit : le malheur approche. La répétition souligne la gravité.`,
  reflection: `Le malheur approche. La répétition souligne la gravité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waylun laka wayl » — malheur à toi, malheur !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends le malheur qui approche ? Ma préparation est-elle urgente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation évite le malheur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le malheur est la conséquence de la mécréance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare évite le malheur." }
  ],
  munajat: `Ya Rabb, je me prépare. Préserve-moi du malheur.`
};

MIROIR["75:35"] = {
  reference: "75:35",
  theme: ["malheur", "répétition", "avertissement"],
  emotion: "Avertissement, urgence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wayl", "Al-Azab"],
  mirrorVersion: `« Malheur à toi, malheur ! » La répétition du malheur. Le miroir insiste : le malheur est certain pour les mécréants. L'insistance divine appelle à la prise de conscience.`,
  reflection: `L'insistance divine appelle à la prise de conscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waylun laka wayl » — malheur à toi, malheur !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends l'insistance ? Ma conscience est-elle éveillée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'insistance éveille la conscience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La répétition est une miséricorde pour avertir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend l'insistance se réveille." }
  ],
  munajat: `Ya Rabb, j'entends l'insistance. Réveille ma conscience.`
};

MIROIR["75:36"] = {
  reference: "75:36",
  theme: ["liberté", "négligence", "création"],
  emotion: "Questionnement, réalisation",
  difficulty: "débutant",
  relatedNames: ["Al-Hurr", "Al-Mahjur"],
  mirrorVersion: `« L'homme pense-t-il qu'il sera laissé sans but ? » La question du but. Le miroir m'interroge : la vie a-t-elle un but ? L'homme n'est pas créé pour être abandonné.`,
  reflection: `L'homme n'est pas créé pour être abandonné. La vie a un but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-yahsabu al-insanu an yutraka suda » — l'homme pense-t-il qu'il sera laissé sans but ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon but ? Est-ce que je vis avec un but ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le but donne le sens. Le sans-but est la perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création a un but." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son but le poursuit." }
  ],
  munajat: `Ya Rabb, quel est mon but ? Montre-moi le sens de ma vie.`
};

MIROIR["75:37"] = {
  reference: "75:37",
  theme: ["création", "sperme", "origine"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Nutfah"],
  mirrorVersion: `« N'était-il pas une goutte de sperme éjaculée ? » L'origine humble. Le miroir m'enseigne : l'homme vient d'une goutte. L'humilité est de reconnaître son origine.`,
  reflection: `L'homme vient d'une goutte. L'humilité est de reconnaître son origine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam yaku nutfatan min manayyin yumna » — n'était-il pas une goutte de sperme éjaculée ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise mon origine humble ? L'humilité est-elle présente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'origine humble élève." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être humain a une origine humble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son origine est humble." }
  ],
  munajat: `Ya Khaliq, je reconnais mon origine humble. Fais que l'humilité soit ma posture.`
};

MIROIR["75:38"] = {
  reference: "75:38",
  theme: ["création", "adhérence", "développement"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Puis il a été une adhérence, puis Il l'a créée et formée. » Le développement embryonnaire. Le miroir m'enseigne : la création passe par des étapes. Allah forme et perfectionne.`,
  reflection: `La création passe par des étapes. Allah forme et perfectionne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma kana 'alaqatan fakhalaqa fasawwa » — puis il a été une adhérence, puis Il l'a créée et formée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur ma création ? La gratitude est-elle présente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation sur la création mène à la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création embryonnaire est un miracle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur sa création remercie." }
  ],
  munajat: `Ya Khaliq, merci pour ma création. Fais que je médite sur Ton œuvre.`
};

MIROIR["75:39"] = {
