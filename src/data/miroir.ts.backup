    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains d'entrer par l'une de ces portes ? Ou est-ce que je minimise mes péchés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience des portes de l'Enfer motive l'évitement des péchés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque porte correspond à un type de péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les péchés évite les portes de l'Enfer." }
  ],
  munajat: `Ya Rabb, je crains les portes de l'Enfer. Ne permets pas que j'entre par l'une d'elles. Protège-moi de tout péché qui y mène.`
};

