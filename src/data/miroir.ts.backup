MIROIR["77:30"] = {
  reference: "77:30",
  theme: ["ombre", "châtiment", "feu"],
  emotion: "Avertissement, crainte",
  difficulty: "débutant",
  relatedNames: ["Az-Zill", "Al-Jahim"],
  mirrorVersion: `« Allez vers une ombre à trois branches. » Le miroir me montre le châtiment particulier. « Intalu zillan dhi al-thalathi sha'abin » — allez vers une ombre à trois branches. L'image. Le miroir m'avertit : le châtiment a des formes terrifiantes.`,
  reflection: `L'ombre à trois branches est une forme de châtiment. Les images sont terrifiantes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Intalu zillan dhi al-thalathi sha'abin » — allez vers une ombre à trois branches." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis vers cette ombre ? Ou est-ce que je fuis vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi fait fuir vers Allah, pas vers le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ombre est un refuge, mais pas l'ombre du châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge en Allah évite l'ombre du châtiment." }
  ],
  munajat: `Ya Rabb, je cherche refuge en Toi. Ne permets pas que j'aille vers l'ombre du châtiment. Sauve-moi par ma foi.`
};

MIROIR["77:31"] = {
  reference: "77:31",
  theme: ["ombre", "protection", "inutilité"],
  emotion: "Désespoir, avertissement",
  difficulty: "débutant",
  relatedNames: ["Az-Zill", "Al-Himayah"],
  mirrorVersion: `« Qui n'abrite ni ne protège de la flamme. » Le miroir me montre l'inutilité de cette ombre. « La zallilin wa la yughni min al-lahab » — qui n'abrite ni ne protège de la flamme. L'inutilité. Le miroir m'avertit : le faux refuge ne protège pas.`,
  reflection: `L'ombre qui n'abrite ni ne protège. Le faux refuge est inutile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La zallilin wa la yughni min al-lahab » — qui n'abrite ni ne protège de la flamme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon refuge ? Est-ce un vrai refuge ou un faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le seul vrai refuge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers cherche refuge en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend Allah comme refuge est vraiment protégé." }
  ],
  munajat: `Ya Rabb, Tu es mon seul refuge. Protège-moi de la flamme. Ne permets pas que je cherche un faux refuge.`
};

