  theme: ["révélation", "seigneur", "univers"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Rabb", "Al-Wahhab"],
  mirrorVersion: `« C'est une révélation du Seigneur des mondes. » Le miroir me montre l'origine ultime. « Tanzilun min rabbi al-'alamin » — c'est une révélation du Seigneur des mondes. Le Coran vient d'Allah. Le miroir m'interroge : est-ce que je traite le Coran comme venant d'Allah ?`,
  reflection: `Le Coran vient du Seigneur des mondes. Il mérite la plus haute révérence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzilun min rabbi al-'alamin » — c'est une révélation du Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite le Coran comme venant d'Allah ? Ou comme un livre ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine divine élève le Coran au-dessus de tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Seigneur des monds parle à travers le Coran." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'origine est transformé." }
  ],
  munajat: `Ya Rabb al-'alamin, le Coran vient de Toi. Fais que je le traite avec révérence. Donne-moi la conscience de son origine divine.`
};

MIROIR["69:44"] = {
  reference: "69:44",
  theme: ["mensonge", "prophète", "châtiment"],
  emotion: "Certitude, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Qadir"],
  mirrorVersion: `« S'il avait forgé quelques paroles contre Nous. » Le miroir me montre l'hypothèse. « Wa law taqawwala 'alayna ba'da al-aqawil » — s'il avait forgé quelques paroles contre Nous. Le Prophète ne forge rien. Le miroir m'interroge : est-ce que je crois à la sincérité du Prophète ?`,
  reflection: `Le Prophète n'a rien forgé. Il est le messager véridique d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law taqawwala 'alayna ba'da al-aqawil » — s'il avait forgé quelques paroles contre Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois à la sincérité du Prophète ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité du Prophète est garantie par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Prophète est le modèle de la sincérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au Prophète croit au message." }
  ],
  munajat: `Ya Rabb, je crois à la sincérité du Prophète. Ne permets pas que je doute. Donne-moi la certitude de sa véracité.`
};

MIROIR["69:45"] = {
