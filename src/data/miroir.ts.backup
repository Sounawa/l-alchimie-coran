    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah protège Ses messagers véridiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la protection comprend la véracité." }
  ],
  munajat: `Ya Qadir, Tu protèges Tes messagers. Je crois en la véracité du Prophète. Ne permets pas que je doute de lui.`
};

MIROIR["69:46"] = {
