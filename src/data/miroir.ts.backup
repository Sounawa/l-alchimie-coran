    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La répétition dans l'univers est un signe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend après la répétition est doublement averti." }
  ],
  munajat: `Ya Rabb, je comprends après la répétition. Donne-moi la certitude maintenant. Ne permets pas que je sache trop tard.`
};

MIROIR["78:6"] = {
  reference: "78:6",
  theme: ["terre", "lit", "vaste"],
  emotion: "Gratitude, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Mihad"],
  mirrorVersion: `« N'avons-Nous pas fait de la terre un lit ? » Le miroir me montre le confort de la terre. « Alam naj'al al-arda mihadan » — n'avons-Nous pas fait de la terre un lit ? Le confort. Le miroir m'enseigne : la terre est faite pour notre confort.`,
  reflection: `La terre est un lit. Elle est confortable pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam naj'al al-arda mihadan » — n'avons-Nous pas fait de la terre un lit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre est mon lit. Suis-je reconnaissant pour ce confort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude pour le confort mène à plus de confort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est le lit de toute vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour le lit de la terre reçoit plus de confort." }
  ],
  munajat: `Ya Rabb, merci pour le lit de la terre. Je suis reconnaissant pour ce confort. Donne-moi plus de gratitude.`
};

MIROIR["78:7"] = {
