    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le Coran comme une révélation ? Ou comme une prédiction humaine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La divination est mensongère. La révélation est véridique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la vérité dans un monde de mensonges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la révélation est éclairé." }
  ],
  munajat: `Ya 'Alim, le Coran est Ta révélation. Fais que je le reconnaisse comme tel. Donne-moi la clarté de la vérité.`
};

MIROIR["69:43"] = {
