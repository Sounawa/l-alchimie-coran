    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je reconnaissant pour cette protection ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection divine précède ma reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers protège la vie fragile qu'il porte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la protection est protégé davantage." }
  ],
  munajat: `Ya Rabb, merci pour Ta protection. Garde-moi dans Ton lieu de repos solide.`
};

MIROIR["77:22"] = {
  reference: "77:22",
  theme: ["durée", "détermination", "calcul"],
  emotion: "Méditation, ordre",
  difficulty: "débutant",
  relatedNames: ["Al-Qadar", "Al-Ajal"],
  mirrorVersion: `« Pour une durée déterminée. » Le miroir me montre le calcul divin. « Li-qadarin ma'lum » — pour une durée déterminée. Le temps. Le miroir m'enseigne : tout a un temps fixé par Allah.`,
  reflection: `La durée est déterminée. Le temps est calculé par Allah.`,
  tajalli: [
