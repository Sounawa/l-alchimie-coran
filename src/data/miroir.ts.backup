MIROIR["55:39"] = {
  reference: "55:39",
  theme: ["jour", "question", "innocence"],
  emotion: "Espérance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Salam", "Al-Ghani"],
  mirrorVersion: `« Ce jour-là, on n'interrogera ni l'homme ni le djinn sur son péché. » Le miroir me montre le soulagement. « Fa-yawma'idhin la yus'alu 'an dhanbihi insun wa la jann » — ce jour-là, on n'interrogera pas. L'interrogatoire cessera. Le miroir m'invite à me préparer pour l'innocence.`,
  reflection: `Ce jour-là, les criminels seront reconnus sans interrogation. Les innocents seront épargnés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-yawma'idhin la yus'alu 'an dhanbihi insun wa la jann » — ce jour-là, on n'interrogera ni l'homme ni le djinn sur son péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon innocence sera-t-elle visible ? Ou serai-je reconnu coupable sans interrogation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence d'interrogatoire signifie la connaissance parfaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour, tout sera manifeste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est innocent ne craint pas l'absence d'interrogatoire." }
  ],
  munajat: `Ya Salam, le Jour révèlera tout. Fais que je sois innocent. Ne permets pas que je sois reconnu coupable sans même pouvoir me défendre.`
};

MIROIR["55:40"] = {
