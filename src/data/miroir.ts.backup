    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La piété envers le Livre ouvre ses secrets." }
  ],
  munajat: `Ya Rabb, merci pour le Livre béni. Fais que je sois pieux envers lui. Ne permets pas que je le néglige.`
};

MIROIR["6:156"] = {
  reference: "6:156",
  theme: ["excuse", "livre", "communauté"],
