    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare à être parmi les ressuscités ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection universelle appelle la préparation universelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains seront rassemblés devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit pour la résurrection y trouve son accomplissement." }
  ],
  munajat: `Ya Jami', Tu rassembles tous. Prépare-moi pour le rassemblement. Fais que je sois parmi les ressuscités heureux.`
};

MIROIR["56:50"] = {
  reference: "56:50",
  theme: ["résurrection", "assemblée", "temps"],
  emotion: "Certitude, solennité",
  difficulty: "débutant",
  relatedNames: ["Al-Mi'd", "Al-Haqq"],
  mirrorVersion: `« Seront rassemblés au terme d'un délai fixé. » Le miroir me montre le rendez-vous. « La-majmu'un ila miqatin ma'dud » — seront certainement rassemblés pour un rendez-vous déterminé. Le temps est fixé.`,
