    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit sa provision de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère reçoit la provision éternelle." }
  ],
  munajat: `Ya Razzaq, je veux la provision du Paradis. Donne-moi la sincérité pour la recevoir. Ne me prive pas de cette récompense.`
};

