    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Reconnais-je la capacité absolue d'Allah ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la capacité divine renforce la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la capacité de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la capacité divine s'y soumet avec confiance." }
  ],
  munajat: `Ya Qadir, Tu es capable de tout. Je me soumets à Ta capacité. Fais ce que Tu veux de moi.`
};

