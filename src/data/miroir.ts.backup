  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi awzi'ni an ashkura ni'mataka allati an'amta 'alayya » — Seigneur, inspire-moi de rendre grâce pour le bienfait dont Tu m'as comblé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la grâce d'être reconnaissant ? Ou est-ce que je suis ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de gratitude précède la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gratitude est la clé des bienfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la gratitude la reçoit." }
  ],
  munajat: `Ya Rabb, inspire-moi la gratitude. Ne permets pas l'ingratitude. Donne-moi de reconnaître chaque bienfait.`
};

MIROIR["27:62"] = {
  reference: "27:62",
  theme: ["détresse", "réponse", "secours"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mudtar", "Al-Mujib"],
  mirrorVersion: `« Qui répond à l'angoissé quand il L'invoque, et dissipe le mal ? » Le miroir me montre la réponse d'Allah. « Amman yujibu al-mudtarra idha da'ahu » — qui répond à l'angoissé quand il L'invoque. Allah répond toujours. Le miroir m'interroge : est-ce que j'invoque dans l'angoisse ?`,
  reflection: `Allah répond toujours. L'invoquer dans l'angoisse est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amman yujibu al-mudtarra idha da'ahu wa yakshifu al-suu » — qui répond à l'angoissé quand il L'invoque, et dissipe le mal ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque dans l'angoisse ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation dans l'angoisse attire la réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Répondeur par excellence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque dans l'angoisse reçoit la réponse." }
  ],
  munajat: `Ya Mujib, j'invoque dans mon angoisse. Ne permets pas le désespoir. Réponds à mon invocation et dissipe mon mal.`
};

