  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatu 'Adnin mufattahatan lahum al-abwab » — jardins d'Eden aux portes ouvertes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les portes sont-elles ouvertes pour moi ? Qu'ai-je fait pour y entrer ?" },
