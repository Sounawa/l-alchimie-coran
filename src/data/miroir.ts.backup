    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Est-ce que je profite du délai ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde pour se préparer." },
