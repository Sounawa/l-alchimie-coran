    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La voie droite existe et est accessible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la voie droite atteint Allah." }
  ],
  munajat: `Ya Rabb, je veux suivre la voie droite qui mène à Toi. Ne permets pas que je m'en écarte. Guide-moi sur le chemin droit.`
};

MIROIR["15:42"] = {
  reference: "15:42",
  theme: ["autorité", "protection", "croyants"],
