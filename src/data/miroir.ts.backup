MIROIR["55:27"] = {
  reference: "55:27",
  theme: ["éternité", "face", "majesté"],
  emotion: "Révérence, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Baqi", "Al-Wajih"],
  mirrorVersion: `« Et la Face de ton Seigneur, pleine de majesté et de noblesse, subsistera. » Le miroir me montre l'éternité divine. « Wa yabqa wajju rabbika dhu al-jalali wa al-ikram » — et la Face de ton Seigneur subsistera. Tout passe, Allah reste. Le miroir m'invite à m'attacher à l'Éternel.`,
  reflection: `La Face d'Allah est éternelle. Tout le reste est temporaire. S'attacher à l'Éternel est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yabqa wajju rabbika dhu al-jalali wa al-ikram » — et la Face de ton Seigneur, pleine de majesté et de noblesse, subsistera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je m'attache ? À ce qui passe ou à Ce qui reste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité d'Allah invite à investir dans l'éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers passera. Seul le Créateur demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache à l'Éternel participe à l'éternité." }
  ],
  munajat: `Ya Baqi, Ta Face est éternelle. Fais que je m'attache à Toi seul. Ne permets pas que je perde mon temps avec ce qui disparaîtra.`
};

MIROIR["55:28"] = {
