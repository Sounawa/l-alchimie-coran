  emotion: "Avertissement, réalisation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ajilah", "Al-Dunya"],
  mirrorVersion: `« Non ! Mais vous aimez l'immédiat. » L'amour du présent. Le miroir m'avertit : l'amour de l'immédiat aveugle. Le présent est aimé, l'avenir est négligé.`,
  reflection: `L'amour de l'immédiat aveugle. L'avenir doit être considéré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla bal tuhibbuna al-'ajilah » — non ! Mais vous aimez l'immédiat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aime l'immédiat ? Ou est-ce que je considère l'avenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour de l'avenir équilibre l'amour du présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le présent est passager. L'avenir est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui équilibre présent et avenir est sage." }
  ],
  munajat: `Ya Rabb, aide-moi à considérer l'avenir. Ne permets pas que j'aime seulement l'immédiat.`
};

