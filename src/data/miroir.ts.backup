MIROIR["55:24"] = {
  reference: "55:24",
  theme: ["navires", "montagnes", "majesté"],
  emotion: "Émerveillement, puissance",
  difficulty: "débutant",
  relatedNames: ["Al-Jalil", "Al-Muhaymin"],
  mirrorVersion: `« Et à Lui appartiennent les navires qui voguent sur la mer comme des montagnes. » Le miroir me montre la majesté des navires. « Wa lahu al-jawari al-munsha'atu fi al-bahri ka-al-a'lam » — à Lui appartiennent les navires comme des montagnes. La grandeur appartient à Allah. Le miroir m'invite à reconnaître Sa grandeur.`,
  reflection: `Les navires sur la mer sont comme des montagnes flottantes. Tout appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lahu al-jawari al-munsha'atu fi al-bahri ka-al-a'lam » — et à Lui appartiennent les navires qui voguent sur la mer comme des montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ce que je possède m'appartient-il vraiment ? Ou tout appartient-il à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur des créations reflète la grandeur du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mers portent les navires comme la terre porte les montagnes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît que tout appartient à Allah est libre de tout." }
  ],
  munajat: `Ya Jalil, tout T'appartient. Fais que je reconnaisse que rien n'est à moi. Libère-moi de l'attachement à ce qui est à Toi.`
};

