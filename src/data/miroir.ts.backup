  difficulty: "débutant",
  relatedNames: ["Al-Jahannam", "Al-Asfal"],
  mirrorVersion: `« Les hypocrites seront au plus bas degré de l'Enfer. » Le miroir me montre le châtiment des hypocrites. « Fi al-daraki al-asfal » — au plus bas degré. L'hypocrisie a le pire châtiment. Le miroir m'interroge : est-ce que je crains ce degré ?`,
  reflection: `L'hypocrisie a le pire châtiment. Le plus bas degré de l'Enfer est réservé aux hypocrites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-munafiqina fi al-daraki al-asfali min al-nar » — les hypocrites seront au plus bas degré de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce degré ? Ou est-ce que je m'aveugle sur l'hypocrisie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité élève, l'hypocrisie abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les degrés de l'Enfer correspondent aux péchés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se préserve de l'hypocrisie s'élève." }
  ],
  munajat: `Ya Rabb, je crains le plus bas degré. Ne permets pas que je sois hypocrite. Préserve-moi de l'hypocrisie et de son châtiment.`
};

MIROIR["4:146"] = {
