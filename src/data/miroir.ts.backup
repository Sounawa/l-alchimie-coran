    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la pluie reçoit plus de bénédictions." }
  ],
  munajat: `Ya Rabb, merci pour la pluie abondante. Bénis-moi avec Ta provision constante.`
};

