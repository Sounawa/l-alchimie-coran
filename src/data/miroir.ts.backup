  theme: ["âme", "mort", "épreuve"],
  emotion: "Réalité, soumission",
  difficulty: "débutant",
  relatedNames: ["An-Nafs", "Al-Mawt"],
  mirrorVersion: `« Toute âme goûtera la mort. » Le miroir me montre la certitude de la mort. « Kullu nafsin dha'iqatu al-mawt » — toute âme goûtera la mort. La mort est inévitable. Le miroir m'interroge : est-ce que je me prépare pour ce moment ?`,
  reflection: `La mort est inévitable. Se préparer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu nafsin dha'iqatu al-mawt » — toute âme goûtera la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour ce moment ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour la mort vivifie la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est le passage obligé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour la mort vit vraiment." }
  ],
  munajat: `Ya Rabb, je me prépare pour la mort. Ne permets pas que je l'oublie. Donne-moi de vivre chaque jour comme le dernier.`
};

MIROIR["21:107"] = {
  reference: "21:107",
  theme: ["miséricorde", "prophète", "univers"],
  emotion: "Gratitude, amour",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "Al-Ka'inat"],
  mirrorVersion: `« Nous ne t'avons envoyé que comme miséricorde pour les univers. » Le miroir me montre la mission universelle du Prophète. « Wa ma arsalnaka illa rahmatan li-l-'alamin » — Nous ne t'avons envoyé que comme miséricorde pour les univers. Le Prophète est la miséricorde incarnée. Le miroir m'interroge : est-ce que je reçois cette miséricorde ?`,
  reflection: `Le Prophète est la miséricorde incarnée. La recevoir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalnaka illa rahmatan li-l-'alamin » — Nous ne t'avons envoyé que comme miséricorde pour les univers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois cette miséricorde ? Ou est-ce que je m'en détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réception de sa miséricorde transforme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Prophète est une bénédiction pour toute la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit sa miséricorde reçoit tout le bien." }
  ],
  munajat: `Ya Rabb, je reçois la miséricorde de Ton Prophète. Ne permets pas que je m'en détourne. Bénis-moi par son intercession.`
};

