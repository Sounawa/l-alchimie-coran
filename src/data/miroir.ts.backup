    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je sur le chemin droit ? Ou suis-je égaré par les chemins latéraux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La concentration sur le chemin unique protège de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a qu'un seul chemin vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La simplicité du chemin est une miséricorde." }
  ],
  munajat: `Ya Rabb, guide-moi sur Ton chemin droit. Ne permets pas que je suive les chemins de l'égarement. Maintiens-moi sur le droit.`
};

MIROIR["6:154"] = {
