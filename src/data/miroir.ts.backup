MIROIR["21:5"] = {
  reference: "21:5",
  theme: ["révélation", "mécréance", "confusion"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahy"],
  mirrorVersion: `« Ils disent : c'est un mélange de rêves ! Ou bien il l'a inventé ! » Le miroir me montre les réponses des mécréants. « Bal hiwa adghathu ahlamin » — c'est un mélange de rêves. « Bal iftarahu » — ou bien il l'a inventé. Les mécréants trouvent toujours des excuses. Le miroir m'interroge : est-ce que je cherche la vérité ou des excuses ?`,
  reflection: `La vérité dérange ceux qui préfèrent l'erreur. Chercher la vérité demande de l'honnêteté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal hiwa adghathu ahlamin bal iftarahu » — c'est un mélange de rêves ! Ou bien il l'a inventé !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la vérité ? Ou est-ce que je trouve des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les excuses sont plus faciles que la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste la vérité, même si tous la nient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la vérité la trouve." }
  ],
  munajat: `Ya Haqq, guide-moi vers la vérité. Ne permets pas que je trouve des excuses. Ouvre mes yeux à Ta réalité.`
};

MIROIR["21:6"] = {
  reference: "21:6",
  theme: ["nations", "foi", "destruction"],
  emotion: "Humilité, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Khaliq"],
  mirrorVersion: `« Aucune cité que Nous avons faite périr n'a cru avant eux. » Le miroir me montre l'histoire des nations. « Ma amanat qablahum min qaryatin ahlaknaha » — aucune cité que Nous avons faite périr n'a cru avant elles. Les nations précédentes n'ont pas cru. Le miroir m'interroge : est-ce que je croirai avant qu'il ne soit trop tard ?`,
  reflection: `L'histoire est un enseignement. Les nations qui n'ont pas cru ont péri. La foi sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma amanat qablahum min qaryatin ahlaknaha » — aucune cité que Nous avons faite périr n'a cru avant elles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je croirai avant qu'il ne soit trop tard ? Ou est-ce que j'attends le châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi tardive ne compte pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des nations est un cycle de foi et de destruction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à temps échappe au châtiment." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que j'attende. Fais que ma foi soit sincère et rapide.`
};

MIROIR["21:7"] = {
  reference: "21:7",
  theme: ["messagers", "hommes", "révélation"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Mursalun", "Al-Wahy"],
  mirrorVersion: `« Et Nous n'avons envoyé avant toi que des hommes à qui Nous faisions la révélation. » Le miroir me montre la nature des prophètes. « Wa ma arsalna qablaka illa rijalan nuhi ilayhim » — Nous n'avons envoyé avant toi que des hommes à qui Nous faisions la révélation. Les prophètes sont des hommes, pas des anges. Le miroir m'interroge : est-ce que j'accepte la guidance des hommes ?`,
  reflection: `Les prophètes sont des hommes comme nous. Ils reçoivent la révélation et nous guident.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna qablaka illa rijalan nuhi ilayhim » — Nous n'avons envoyé avant toi que des hommes à qui Nous faisions la révélation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la guidance des prophètes ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les hommes peuvent guider les hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne de la prophétie traverse l'histoire humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les prophètes suit la guidance." }
  ],
  munajat: `Ya Rabb, j'accepte la guidance des prophètes. Ne permets pas le rejet. Guide-moi par leur exemple.`
};

MIROIR["21:8"] = {
  reference: "21:8",
  theme: ["création", "corps", "mort"],
  emotion: "Humilité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mumit"],
  mirrorVersion: `« Nous n'en avons pas fait des corps qui ne mangeaient pas de nourriture. » Le miroir me montre la nature humaine des prophètes. « Wa ma ja'alnahum jasadan la ya'kuluna al-ta'am » — Nous n'en avons pas fait des corps qui ne mangeaient pas de nourriture. Les prophètes mangent et sont mortels. Le miroir m'interroge : est-ce que j'accepte leur humanité ?`,
  reflection: `Les prophètes sont humains. Ils mangent, boivent et meurent. Leur miracle est la révélation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ja'alnahum jasadan la ya'kuluna al-ta'am » — Nous n'en avons pas fait des corps qui ne mangeaient pas de nourriture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'humanité des prophètes ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humanité des prophètes est leur force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création a besoin de nourriture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'humanité des prophètes comprend leur mission." }
  ],
  munajat: `Ya Khaliq, j'accepte l'humanité des prophètes. Ne permets pas le doute. Fais que je comprenne leur mission.`
};

MIROIR["21:9"] = {
  reference: "21:9",
  theme: ["promesse", "vérité", "accomplissement"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Sadiq"],
  mirrorVersion: `« Puis Nous avons accompli la promesse envers eux. » Le miroir me montre l'accomplissement divin. « Thumma sadaqnahumu al-wa'da » — puis Nous avons accompli la promesse envers eux. Allah tient toujours Ses promesses. Le miroir m'interroge : est-ce que je fais confiance à Sa promesse ?`,
  reflection: `Allah accomplit toujours Ses promesses. Les prophètes et les croyants sont sauvés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma sadaqnahumu al-wa'da » — puis Nous avons accompli la promesse envers eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la promesse d'Allah ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah est certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de l'accomplissement divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la promesse d'Allah la voit s'accomplir." }
  ],
  munajat: `Ya Sadiq, je fais confiance à Ta promesse. Ne permets pas le doute. Accomplis Ta promesse envers moi.`
};

MIROIR["21:10"] = {
  reference: "21:10",
  theme: ["Coran", "guidance", "rappel"],
  emotion: "Gratitude, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Quran", "Al-Dhikr"],
  mirrorVersion: `« Nous avons fait descendre vers vous un Livre où est votre mention. » Le miroir me montre le but du Coran. « Laqad anzalna ilaykum kitaban fihi dhikrukum » — Nous avons fait descendre vers vous un Livre où est votre mention. Le Coran est notre mention, notre rappel. Le miroir m'interroge : est-ce que je me reconnais dans le Coran ?`,
  reflection: `Le Coran parle de nous. Notre mention y est. Nous devons nous y reconnaître.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad anzalna ilaykum kitaban fihi dhikrukum » — Nous avons fait descendre vers vous un Livre où est votre mention." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me reconnais dans le Coran ? Ou est-ce que je le lis sans réflexion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est un miroir pour l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la mention de toute l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se reconnaît dans le Coran se transforme." }
  ],
  munajat: `Ya Rabb, aide-moi à me reconnaître dans le Coran. Ne permets pas l'inattention. Fais que le Coran soit mon miroir.`
};

MIROIR["21:11"] = {
  reference: "21:11",
  theme: ["nations", "destruction", "remplacement"],
  emotion: "Humilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Badi'"],
  mirrorVersion: `« Et Nous avons détruit des cités injustes et avons créé après elles d'autres cités. » Le miroir me montre le cycle des nations. « Wa kam qasamna min qaryatin zalimat » — combien de cités injustes avons-Nous détruites. « Wa ansha'na ba'daha qawman akharin » — et créé après elles d'autres peuples. Les nations injustes disparaissent. Le miroir m'interroge : ma communauté est-elle juste ?`,
  reflection: `Les nations injustes sont remplacées. La justice est la clé de la survie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kam qasamna min qaryatin zalimat wa ansha'na ba'daha qawman akharin » — combien de cités injustes avons-Nous détruites et créé après elles d'autres peuples." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma communauté est-elle juste ? Ou est-elle sur le chemin de la destruction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice mène à la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des nations est un cycle de justice et de renouvellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique la justice survit." }
  ],
  munajat: `Ya Rabb, fais que ma communauté soit juste. Ne permets pas l'injustice. Remplace nos mauvaises actions par de bonnes.`
};

MIROIR["21:12"] = {
  reference: "21:12",
  theme: ["châtiment", "fuite", "regret"],
  emotion: "Urgence, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Quand ils ont senti Notre rigueur, ils s'en sont soudainement enfuis. » Le miroir me montre la réaction des mécréants. « Falamma ahassu ba'sana idha hum minha yarkudun » — quand ils ont senti Notre rigueur, ils s'en sont soudainement enfuis. La fuite est inutile face au châtiment divin. Le miroir m'interroge : est-ce que je fuis ou est-ce que je me repens ?`,
  reflection: `Fuir le châtiment est impossible. Se repentir avant qu'il n'arrive est la seule voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ahassu ba'sana idha hum minha yarkudun » — quand ils ont senti Notre rigueur, ils s'en sont soudainement enfuis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis ? Ou est-ce que je me repens maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite est inutile. Le repentir est efficace." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne peut fuir la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant le châtiment est épargné." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que j'attende le châtiment. Accepte mon repentir avant qu'il ne soit trop tard.`
};

MIROIR["21:13"] = {
  reference: "21:13",
  theme: ["fuite", "impuissance", "retour"],
  emotion: "Réalité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muta'al"],
  mirrorVersion: `« Ne fuyez pas ! Retournez à ce qui vous a été donné en abondance ! » Le miroir me montre l'appel ironique. « La tarkuduu wa irji'u ila ma utriftum fihi » — ne fuyez pas ! Retournez à ce qui vous a été donné en abondance. Les mécréants fuient mais nulle part n'est sûr. Le miroir m'interroge : où puis-je fuir d'Allah ?`,
  reflection: `Il n'y a nulle part où fuir d'Allah. Le retour à Lui est la seule issue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tarkuduu wa irji'u ila ma utriftum fihi » — ne fuyez pas ! Retournez à ce qui vous a été donné en abondance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où puis-je fuir d'Allah ? Quel luxe m'a fait oublier la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite est impossible. Le retour est nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sous le contrôle d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui retourne à Allah avant le châtiment est sauvé." }
  ],
  munajat: `Ya Rabb, je retourne à Toi. Ne permets pas la fuite. Accepte mon retour sincère.`
};

MIROIR["21:14"] = {
  reference: "21:14",
  theme: ["regret", "malheur", "confession"],
  emotion: "Regret, désespoir",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Haqq"],
  mirrorVersion: `« Ils ont dit : malheur à nous ! Nous étions injustes ! » Le miroir me montre la confession tardive. « Qalu ya waylana inna kunna zalimin » — ils ont dit : malheur à nous ! Nous étions injustes ! La confession vient trop tard. Le miroir m'interroge : est-ce que je me confesse maintenant ou après ?`,
  reflection: `La confession tardive ne sert à rien. Se confesser maintenant est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya waylana inna kunna zalimin » — ils ont dit : malheur à nous ! Nous étions injustes !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me confesse maintenant ? Ou est-ce que j'attends le malheur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confession tardive est inutile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le malheur révèle la vérité cachée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confesse avant le malheur est épargné." }
  ],
  munajat: `Ya Rabb, je me confesse maintenant. Je suis injuste. Ne permets pas que j'attende le malheur. Pardonne-moi maintenant.`
};

MIROIR["21:15"] = {
  reference: "21:15",
  theme: ["lamentation", "destruction", "fin"],
  emotion: "Tristesse, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Qahhar"],
  mirrorVersion: `« Et ils n'ont cessé de crier jusqu'à ce que Nous les ayons rendus comme des moissons fauchées. » Le miroir me montre la fin des injustes. « Fa ma zalat tilka dak'ahum hatta ja'alnahum hawidan » — ils n'ont cessé de crier jusqu'à ce que Nous les ayons rendus comme des moissons fauchées. Les lamentations ne sauvent pas. Le miroir m'interroge : vais-je attendre la fauche ?`,
  reflection: `Les lamentations tardives ne sauvent pas. Agir avant est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ma zalat tilka dak'ahum hatta ja'alnahum hawidan » — ils n'ont cessé de crier jusqu'à ce que Nous les ayons rendus comme des moissons fauchées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vais-je attendre la fauche ? Ou est-ce que je me repens maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les lamentations ne sauvent pas. Le repentir sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui vit sera fauché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la fauche est épargné." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que j'attende la fauche. Épargne-moi par Ton pardon.`
};

MIROIR["21:16"] = {
  reference: "21:16",
  theme: ["création", "ciel", "sérieux"],
  emotion: "Émerveillement, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "As-Samawat"],
  mirrorVersion: `« Et Nous n'avons pas créé le ciel et la terre et ce qui est entre eux par jeu. » Le miroir me montre la gravité de la création. « Wa ma khalaqna al-sama'a wa al-arda wa ma baynahuma la'ibin » — Nous n'avons pas créé le ciel et la terre et ce qui est entre eux par jeu. La création a un but sérieux. Le miroir m'interroge : quel est le but de ma vie ?`,
  reflection: `La création n'est pas un jeu. Chaque être a un but. Le trouver est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma khalaqna al-sama'a wa al-arda wa ma baynahuma la'ibin » — Nous n'avons pas créé le ciel et la terre et ce qui est entre eux par jeu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le but de ma vie ? Est-ce que je le cherche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie n'est pas un jeu. Elle a un but." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier a un but." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve le but de sa vie est comblé." }
  ],
  munajat: `Ya Khaliq, montre-moi le but de ma vie. Ne permets pas le jeu. Guide-moi vers ma destinée.`
};

MIROIR["21:17"] = {
  reference: "21:17",
  theme: ["divertissement", "création", "sérieux"],
  emotion: "Gravité, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Jidd"],
  mirrorVersion: `« Si Nous avions voulu prendre un divertissement, Nous l'aurions pris de Notre présence. » Le miroir me montre l'absurdité du polythéisme. « Law aradna an nattakhidha lahwan la ttakhadhnahu min ladunna » — si Nous avions voulu prendre un divertissement, Nous l'aurions pris de Notre présence. Allah n'a pas besoin de créatures pour se divertir. Le miroir m'interroge : est-ce que je prends ma vie au sérieux ?`,
  reflection: `Allah est au-dessus du divertissement. Notre vie doit être sérieuse et orientée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law aradna an nattakhidha lahwan la ttakhadhnahu min ladunna » — si Nous avions voulu prendre un divertissement, Nous l'aurions pris de Notre présence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends ma vie au sérieux ? Ou est-ce que je la traite comme un divertissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le divertissement n'est pas le but de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est sérieux dans son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend sa vie au sérieux trouve son but." }
  ],
  munajat: `Ya Rabb, aide-moi à prendre ma vie au sérieux. Ne permets pas le divertissement. Guide-moi vers le sérieux.`
};

MIROIR["21:18"] = {
  reference: "21:18",
  theme: ["vérité", "mensonge", "triomphe"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Mais Nous lançons la vérité contre le mensonge, qui l'écrase, et le voilà qui disparaît. » Le miroir me montre le combat de la vérité. « Bal naqdhifu bi-al-haqqi 'ala al-batili fayadmaghuhu » — Nous lançons la vérité contre le mensonge, qui l'écrase. La vérité triomphe toujours. Le miroir m'interroge : suis-je du côté de la vérité ?`,
  reflection: `La vérité triomphe toujours du mensonge. Être du côté de la vérité assure la victoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal naqdhifu bi-al-haqqi 'ala al-batili fayadmaghuhu fa idha huwa zahiqun » — Nous lançons la vérité contre le mensonge, qui l'écrute, et le voilà qui disparaît." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je du côté de la vérité ? Ou est-ce que je soutiens le mensonge ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité triomphe toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soutient la vérité triomphe." }
  ],
  munajat: `Ya Haqq, place-moi du côté de la vérité. Ne permets pas que je soutienne le mensonge. Fais que la vérité triomphe en moi.`
};

MIROIR["21:19"] = {
  reference: "21:19",
  theme: ["anges", "adoration", "soumission"],
  emotion: "Révérence, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "Al-'Abidun"],
  mirrorVersion: `« À Lui appartient quiconque est dans les cieux et la terre. Ceux qui sont auprès de Lui ne s'enorgueillissent pas de L'adorer. » Le miroir me montre l'adoration des anges. « Lahu man fi al-samawati wa al-ard » — à Lui appartient quiconque est dans les cieux et la terre. « Wa man 'indahu la yastakbiruna 'an 'ibadatihi » — ceux qui sont auprès de Lui ne s'enorgueillissent pas de L'adorer. Les anges adorent sans orgueil. Le miroir m'interroge : est-ce que j'adore avec humilité ?`,
  reflection: `Les anges adorent Allah sans orgueil. Nous devons les imiter dans notre adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu man fi al-samawati wa al-ard wa man 'indahu la yastakbiruna 'an 'ibadatihi » — à Lui appartient quiconque est dans les cieux et la terre. Ceux qui sont auprès de Lui ne s'enorgueillissent pas de L'adorer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore avec humilité ? Ou est-ce que je m'enorgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration avec orgueil n'est pas une adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création adore Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore avec humilité est proche d'Allah." }
  ],
  munajat: `Ya Rabb, j'adore avec humilité. Ne permets pas l'orgueil. Fais que mon adoration soit sincère.`
};

MIROIR["21:20"] = {
  reference: "21:20",
  theme: ["anges", "glorification", "perpétuité"],
  emotion: "Émerveillement, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "Al-Tasbih"],
  mirrorVersion: `« Ils Le glorifient nuit et jour et ne se lassent point. » Le miroir me montre la persévérance des anges. « Yusabbihuna al-layla wa al-nahara la yafturun » — ils Le glorifient nuit et jour et ne se lassent point. Les anges adorent sans relâche. Le miroir m'interroge : est-ce que ma glorification est constante ?`,
  reflection: `Les anges glorifient Allah sans cesse. Nous devons aspirer à cette constance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusabbihuna al-layla wa al-nahara la yafturun » — ils Le glorifient nuit et jour et ne se lassent point." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma glorification est constante ? Ou est-ce que je me lasse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lassitude dans la glorification vient du manque d'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier glorifie Allah sans cesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie sans cesse goûte à la présence divine." }
  ],
  munajat: `Ya Rabb, aide-moi à Te glorifier sans cesse. Ne permets pas la lassitude. Fais que ma glorification soit perpétuelle.`
};

// ============================================
// SURAH 19 (MARYAM) - MISSING ENTRIES
// ============================================

MIROIR["19:13"] = {
  reference: "19:13",
  theme: ["sagesse", "compassion", "pureté"],
  emotion: "Tendresse, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Ar-Rauf"],
  mirrorVersion: `« Et Notre tendresse envers lui, et la pureté. » Le miroir me montre les dons divins à Yahya. La tendresse et la pureté sont accordées par Allah. Ces qualités ne s'acquièrent pas — elles se reçoivent. Le miroir m'interroge : qu'est-ce qu'Allah m'a donné ?`,
  reflection: `La tendresse et la pureté sont des dons divins. Elles transforment le caractère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hananan min ladunna wa zakatan » — Et Notre tendresse envers lui, et la pureté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah m'a donné ? Suis-je conscient de Ses dons ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les dons divins ne sont pas mérités — ils sont accordés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être reçoit des dons uniques d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les dons les voit se multiplier." }
  ],
  munajat: `Ya Hannan, Ta tendresse m'atteint. Purifie mon cœur. Fais que je reconnaisse Tes dons et que je les préserve.`
};

MIROIR["19:14"] = {
  reference: "19:14",
  theme: ["piété", "parents", "bonté"],
  emotion: "Amour filial, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Barr", "Ar-Rahim"],
  mirrorVersion: `« Et la bonté envers ses parents. » Le miroir me montre la bonté filiale. Yahya est décrit comme bon envers ses parents. La bonté envers les parents est une qualité prophétique. Le miroir m'interroge : comment suis-je avec mes parents ?`,
  reflection: `La bonté envers les parents est un signe de piété. Elle reflète le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa barran bi walidayhi » — Et la bonté envers ses parents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment suis-je avec mes parents ? Suis-je bon envers eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonté envers les parents reflète la bonté envers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'honneur des parents est universel dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est bon envers ses parents reçoit la bonté d'Allah." }
  ],
  munajat: `Ya Barr, enseigne-moi la bonté envers mes parents. Fais que je les honore comme Tu les honores. Ne laisse pas l'ingratitude s'installer dans mon cœur.`
};

MIROIR["19:15"] = {
  reference: "19:15",
  theme: ["paix", "naissance", "mort"],
  emotion: "Sérénité, espérance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Baqi"],
  mirrorVersion: `« Que la paix soit sur lui le jour où il naquit, le jour où il mourra, et le jour où il sera ressuscité. » Le miroir me montre la paix sur toute une vie. Naissance, mort, résurrection — trois moments clés. La paix d'Allah accompagne le prophète. Le miroir m'interroge : est-ce que je cherche la paix d'Allah à chaque étape ?`,
  reflection: `La paix d'Allah accompagne les prophètes à chaque moment crucial. Elle est disponible pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa salamun 'alayhi yawma wulida wa yawma yamutu wa yawma yub'athu hayya » — Que la paix soit sur lui le jour où il naquit, le jour où il mourra, et le jour où il sera ressuscité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la paix à chaque étape de ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix n'est pas un moment — c'est une présence constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être traverse ces trois moments. La paix d'Allah peut accompagner chacun." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la paix d'Allah la trouve à chaque transition." }
  ],
  munajat: `Ya Salam, que Ta paix m'accompagne à chaque moment. Naissance, mort, résurrection — sois présent. Ne me laisse pas traverser ces moments sans Ta paix.`
};

MIROIR["19:16"] = {
  reference: "19:16",
  theme: ["maryam", "retrait", "prière"],
  emotion: "Contemplation, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Batul", "Al-Quds"],
  mirrorVersion: `« Et rappelle dans le Livre l'histoire de Marie. » Le miroir me montre l'histoire de Marie. Elle se retira du monde pour se consacrer à Allah. Le retrait n'est pas la fuite — c'est la consécration. Le miroir m'interroge : est-ce que je me retire pour Allah ?`,
  reflection: `Le retrait du monde pour Allah est un acte de consécration. Marie en est l'exemple parfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur fi al-kitabi maryam » — Et rappelle dans le Livre l'histoire de Marie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me retire pour Allah ? Mon retrait est-il consécration ou fuite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retrait pour Allah n'est pas une perte — c'est un gain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme a besoin de moments de retrait pour se ressourcer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se retire pour Allah Le trouve dans le retrait." }
  ],
  munajat: `Ya Rabb, enseigne-moi le retrait sacré. Fais que je me retire pour Toi, pas du monde par peur. Dans mon retrait, fais que je Te trouve.`
};

MIROIR["19:17"] = {
  reference: "19:17",
  theme: ["voile", "révélation", "intimité"],
  emotion: "Mystère, présence",
  difficulty: "débutant",
  relatedNames: ["Al-Hijab", "Ar-Ruh"],
  mirrorVersion: `« Elle mit un voile entre elle et sa famille. » Le miroir me montre le voile de l'intimité. Marie se voile pour se consacrer. Le voile n'est pas une barrière — c'est une protection. Le miroir m'interroge : qu'est-ce que je protège dans ma vie spirituelle ?`,
  reflection: `Le voile protège l'intimité avec Allah. Il crée un espace sacré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fattakhadhat min dunihim hijaban » — Elle mit un voile entre elle et sa famille." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je protège dans ma vie spirituelle ? Mon intimité avec Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile qui sépare du monde unit à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque relation sacrée nécessite un voile protecteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voile ce qui doit l'être découvre ce qui est caché." }
  ],
  munajat: `Ya Hijab, protège mon intimité avec Toi. Fais que je sache ce qui doit être voilé et ce qui doit être révélé. Dans le voile, fais que je Te trouve.`
};

MIROIR["19:18"] = {
  reference: "19:18",
  theme: ["protection", "refuge", "pureté"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mawla", "Ar-Rahman"],
  mirrorVersion: `« Je cherche protection contre toi auprès du Tout-Miséricordieux. » Le miroir me montre le refuge en Allah. Marie cherche protection non par peur mais par pureté. Le Tout-Miséricordieux est le refuge ultime. Le miroir m'interroge : où cherche-je refuge ?`,
  reflection: `Le refuge en Allah est la meilleure protection. Il purifie et sécurise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innı a'udhu bir-rahmani minka » — Je cherche protection contre toi auprès du Tout-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où cherche-je refuge ? En Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refuge en Allah n'est pas une fuite — c'est une protection active." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature cherche refuge quelque part. Le croyant cherche en Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge en Allah ne trouve que miséricorde." }
  ],
  munajat: `Ya Rahman, Tu es mon refuge. Contre tout mal, je me tourne vers Toi. Protège-moi par Ta miséricorde. Ne laisse rien m'atteindre sans Ta permission.`
};

MIROIR["19:19"] = {
  reference: "19:19",
  theme: ["ange", "annonce", "pureté"],
  emotion: "Stupéfaction, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Ruh", "Al-Mubashshir"],
  mirrorVersion: `« Je suis seulement un messager de ton Seigneur pour t'annoncer un garçon pur. » Le miroir me montre l'annonce angélique. L'ange vient avec une nouvelle extraordinaire. Un garçon pur — sans père. Le miroir m'interroge : comment réagirais-je à une nouvelle impossible ?`,
  reflection: `L'impossible d'Allah devient possible. L'ange est Son messager.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama ana rasulu rabbiki li ahaba laki ghulaman zakiyya » — Je suis seulement un messager de ton Seigneur pour t'annoncer un garçon pur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagirais-je à l'impossible ? Par foi ou par doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossible annoncé par Allah est déjà réalisé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les messagers de l'impossible divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille l'annonce divine avec foi la voit se réaliser." }
  ],
  munajat: `Ya Mubashshir, envoie-moi Tes bonnes nouvelles. Fais que je les accueille avec foi. Transforme mon impossible en Tes possibles.`
};

MIROIR["19:20"] = {
  reference: "19:20",
  theme: ["étonnement", "impossible", "pureté"],
  emotion: "Stupéfaction, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Batul"],
  mirrorVersion: `« Comment aurais-je un fils alors qu'aucun homme ne m'a touchée ? » Le miroir me montre la question légitime. Marie s'étonne — c'est naturel. L'impossible demande clarification. Le miroir m'interroge : est-ce que je questionne avec foi ou avec doute ?`,
  reflection: `Questionner l'impossible avec foi est différent de douter. Marie questionne, elle ne refuse pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anna yakunu li ghulamun wa lam yamsasni basharun » — Comment aurais-je un fils alors qu'aucun homme ne m'a touchée ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment questionné-je l'impossible ? Avec foi ou avec résistance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question sincère ouvre la voie à la compréhension." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque impossible soulève des questions — les réponses viennent d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne avec foi reçoit des réponses qui transforment." }
  ],
  munajat: `Ya Qadir, quand l'impossible se présente, aide-moi à questionner avec foi. Ne laisse pas le doute m'envahir. Fais que ma question soit une ouverture, pas une fermeture.`
};

MIROIR["19:21"] = {
  reference: "19:21",
  theme: ["décret", "facilité", "signe"],
  emotion: "Acceptation, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Muqtadir", "Al-Ayah"],
  mirrorVersion: `« Ainsi sera-t-il. Ton Seigneur dit : Cela M'est facile. » Le miroir me montre la facilité divine. Ce qui est impossible pour l'homme est facile pour Allah. Le décret est prononcé. Le miroir m'interroge : est-ce que j'accepte le décret d'Allah ?`,
  reflection: `L'impossible humain est le facile divin. Accepter le décret est la voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhaliki qala rabbuki huwa 'alayya hayyinun » — Ainsi sera-t-il. Ton Seigneur dit : Cela M'est facile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ce qu'Allah décrète facile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le 'facile' d'Allah n'a pas besoin de mon consentement — mais je suis invité à l'accepter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est facile pour Allah. La difficulté n'existe que pour nous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le 'facile' d'Allah le trouve léger à porter." }
  ],
  munajat: `Ya Muqtadir, ce qui est facile pour Toi peut me sembler impossible. Aide-moi à accepter Ton décret. Fais que je voie Ta facilité dans ce qui m'écrase.`
};

MIROIR["19:22"] = {
  reference: "19:22",
  theme: ["conception", "épreuve", "retrait"],
  emotion: "Lourdeur, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hamid"],
  mirrorVersion: `« Elle devint enceinte et se retira avec lui dans un lieu écarté. » Le miroir me montre le retrait dans l'épreuve. Marie porte le miracle et s'isole. Le miracle s'accompagne de solitude. Le miroir m'interroge : est-ce que j'accepte la solitude qui accompagne mes bénédictions ?`,
  reflection: `Le miracle peut apporter la solitude. Le retrait permet de le porter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fahamalathu fatahadhaathu bihi makanan qasiyyan » — Elle devint enceinte et se retira avec lui dans un lieu écarté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la solitude qui accompagne mes bénédictions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La solitude avec le miracle vaut mieux que la foule sans lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque grande bénédiction s'accompagne d'un retrait nécessaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte le miracle accepte la solitude qu'il impose." }
  ],
  munajat: `Ya Khaliq, j'accepte la solitude qui vient avec Tes dons. Fais que je ne cherche pas la foule quand Tu m'appelles au retrait. Dans la solitude, fais que je Te trouve.`
};

MIROIR["19:23"] = {
  reference: "19:23",
  theme: ["douleur", "détresse", "regret"],
  emotion: "Souffrance, désespoir momentané",
  difficulty: "débutant",
  relatedNames: ["Al-Mudtar", "As-Sabur"],
  mirrorVersion: `« Les douleurs de l'enfantement l'amenèrent au tronc du palmier. » Le miroir me montre la douleur du miracle. Le miracle a un coût. Marie souffre seule. Le désespoir momentané la touche. Le miroir m'interroge : est-ce que j'accepte la douleur qui accompagne les bénédictions ?`,
  reflection: `La douleur peut accompagner le miracle. Elle n'enlève rien à la bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aja'aha al-makhasu ila jidh'i al-nakhlati » — Les douleurs de l'enfantement l'amenèrent au tronc du palmier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je à la douleur qui accompagne mes bénédictions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douleur du miracle précède la joie de la naissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque naissance s'accompagne de douleur — qu'elle soit physique ou spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traverse la douleur du miracle en ressort transformé." }
  ],
  munajat: `Ya Sabur, la douleur m'atteint même dans Tes bénédictions. Aide-moi à l'accepter. Ne laisse pas le désespoir momentané m'éloigner de Toi.`
};

MIROIR["19:24"] = {
  reference: "19:24",
  theme: ["consolation", "provision", "miracle"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mawla"],
  mirrorVersion: `« Un ruisseau coula beneath elle. » Le miroir me montre la provision dans l'épreuve. Au moment de la douleur, l'eau coule. La provision suit la difficulté. Le miroir m'interroge : est-ce que je cherche la provision d'Allah dans l'épreuve ?`,
  reflection: `La provision d'Allah arrive au moment critique. Elle est souvent proche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-nadaha min tahtiha alla tahzani » — On l'appela de beneath elle : Ne t'attriste pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la provision d'Allah dans l'épreuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve cache souvent la provision — il faut regarder autrement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque désert cache une source pour celui qui cherche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la provision dans l'épreuve la trouve." }
  ],
  munajat: `Ya Razzaq, Tu pourvois même dans l'épreuve. Ouvre mes yeux pour voir la provision cachée. Ne laisse pas ma tristesse m'aveugler à Tes dons.`
};

MIROIR["19:25"] = {
  reference: "19:25",
  theme: ["action", "miracle", "nourriture"],
  emotion: "Espoir, action",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'ti", "Al-Karim"],
  mirrorVersion: `« Secoue vers toi le tronc du palmier. » Le miroir me montre l'action dans le miracle. Marie doit agir — secouer le palmier. Le miracle n'exclut pas l'effort. L'effort humain rencontre la provision divine. Le miroir m'interroge : est-ce que je fais ma part ?`,
  reflection: `Le miracle demande parfois un geste. L'effort humain coopère avec la grâce divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huzzi ilayki bi jidh'i al-nakhlati tusaqit 'alayki rutaban janiyya » — Secoue vers toi le tronc du palmier, il fera tomber sur toi des dattes fraîches." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais ma part dans l'attente du miracle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le palmier ne donne pas sans secousse — la provision demande l'effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature coopère avec l'effort humain pour produire le fruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui secoue reçoit — l'effort est la clé du miracle." }
  ],
  munajat: `Ya Mu'ti, fais que je fasse ma part. Ne laisse pas ma passivité bloquer le miracle. Dans mon effort, fais que je trouve Ta provision.`
};

MIROIR["19:26"] = {
  reference: "19:26",
  theme: ["gratitude", "jeûne", "silence"],
  emotion: "Satisfaction, dévotion",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "As-Samad"],
  mirrorVersion: `« Mange donc, bois et réjouis-toi. » Le miroir me montre la permission de jouir. Allah permet à Marie de jouir de la provision. La gratitude suit le don. Le jeûne de silence complète la bénédiction. Le miroir m'interroge : est-ce que je savoure les dons d'Allah ?`,
  reflection: `La gratitude se vit par la jouissance du don et par le silence qui protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kuli wa ishrabi wa qarri 'aynan » — Mange donc, bois et réjouis-toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je savoure les dons d'Allah ? Ou les prends-je pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jouissance du don est une forme de gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature jouit de sa provision — c'est un droit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui savoure avec reconnaissance reçoit davantage." }
  ],
  munajat: `Ya Shakur, je savoure Ton don avec reconnaissance. Fais que je n'oublie pas de Te remercier. Dans la jouissance, garde mon cœur connecté à Toi.`
};

MIROIR["19:27"] = {
  reference: "19:27",
  theme: ["retour", "accusation", "épreuve"],
  emotion: "Crainte, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mawla", "Al-Hafiz"],
  mirrorVersion: `« Elle vint auprès des siens, portant l'enfant. » Le miroir me montre le retour avec le miracle. Marie revient avec Jésus dans les bras. L'accusation l'attend. Le miracle expose au jugement. Le miroir m'interroge : est-ce que j'accepte d'être jugé pour mes bénédictions ?`,
  reflection: `Le miracle peut attirer les accusations. Il faut du courage pour revenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-atat bihi qawmaha tahmiluhu » — Elle vint auprès des siens, portant l'enfant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai le courage de montrer mes bénédictions malgré les jugements ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation des gens ne change rien au miracle d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque bénédiction visible attire l'attention — positive ou négative." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte le miracle d'Allah n'a pas à craindre les accusations." }
  ],
  munajat: `Ya Mawla, je reviens vers les miens avec Tes dons. Protège-moi des accusations. Fais que je ne cache pas Tes bénédictions par peur des gens.`
};

MIROIR["19:28"] = {
  reference: "19:28",
  theme: ["famille", "accusation", "honneur"],
  emotion: "Honte, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Harun", "Al-Mujib"],
  mirrorVersion: `« Ô sœur de Aaron ! Ton père n'était pas un homme de mal. » Le miroir me montre l'accusation d'inconduite. La famille de Marie l'accuse indirectement. L'honneur familial est invoqué. Le miroir m'interroge : comment supporté-je les accusations injustes ?`,
  reflection: `L'accusation injuste est une épreuve. La confiance en Allah suffit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ukhta haruna ma kana abuki imra'a saw'in » — Ô sœur de Aaron ! Ton père n'était pas un homme de mal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment supporté-je les accusations injustes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation injuste ne peut détruire l'honneur donné par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les justes sont souvent accusés injustement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est accusé injustement reçoit l'honneur d'Allah." }
  ],
  munajat: `Ya Mujib, les accusations m'atteignent. Défends-moi par Ta vérité. Fais que je ne cherche pas à me justifier moi-même — sois mon défenseur.`
};

MIROIR["19:29"] = {
  reference: "19:29",
  theme: ["silence", "réponse", "miracle"],
  emotion: "Confiance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Mutakallim", "Al-Bayyinah"],
  mirrorVersion: `« Elle fit signe vers lui. » Le miroir me montre la réponse par le silence. Marie ne parle pas — elle indique l'enfant. La réponse est dans le miracle lui-même. Le miroir m'interroge : est-ce que je laisse les miracles parler pour moi ?`,
  reflection: `Parfois le silence est la meilleure réponse. Le miracle parle de lui-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-asharat ilayhi » — Elle fit signe vers lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je laisse les miracles d'Allah parler pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe vers le miracle vaut mieux que mille mots." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les œuvres d'Allah parlent d'elles-mêmes — pas besoin de défense." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui indique le miracle le laisse parler." }
  ],
  munajat: `Ya Mutakallim, fais parler Tes miracles dans ma vie. Ne me laisse pas dépendre de mes mots. Que Ton œuvre soit ma défense.`
};

MIROIR["19:30"] = {
  reference: "19:30",
  theme: ["jésus", "serviteur", "révélation"],
  emotion: "Émerveillement, adoration",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Abdullah"],
  mirrorVersion: `« Je suis le serviteur d'Allah. » Le miroir me montre la première parole de Jésus. Il se définit comme serviteur. Le miracle le plus grand est la servitude. Le miroir m'interroge : comment me définis-je ?`,
  reflection: `La première identité du miraculé est la servitude. Je suis serviteur avant tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala inni 'abdullahi » — Il dit : Je suis le serviteur d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment me définis-je ? Ma première identité est-elle serviteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le miracle ne grandit pas — la servitude est le sommet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est serviteur — le reconnaître est le début de la sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait serviteur accède à tout le reste." }
  ],
  munajat: `Ya Rabb, je suis Ton serviteur. Fais que je ne l'oublie jamais. Dans mes miracles et mes épreuves, garde-moi dans la conscience de ma servitude.`
};

MIROIR["19:31"] = {
  reference: "19:31",
  theme: ["prière", "zakat", "bénédiction"],
  emotion: "Dévotion, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Musalli", "Ar-Raziq"],
  mirrorVersion: `« Il m'a donné le Livre et a fait de moi un prophète. » Le miroir me montre les dons de la prophétie. Le Livre, la prophétie, la prière, la zakat — une vie bénie. Le miroir m'interroge : qu'est-ce qu'Allah m'a donné ?`,
  reflection: `Les dons d'Allah sont multiples. La reconnaissance est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alani nabiyyan » — Et Il a fait de moi un prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah m'a donné ? Est-ce que je Le remercie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les dons sont des responsabilités — pas des privilèges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être reçoit des dons uniques d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les dons les voit se multiplier." }
  ],
  munajat: `Ya Raziq, Tu m'as donné tant de dons. Fais que je les reconnaisse et les utilise pour Toi. Ne laisse pas l'ingratitude s'installer.`
};

MIROIR["19:32"] = {
  reference: "19:32",
  theme: ["bonté", "mère", "humilité"],
  emotion: "Amour, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Barr", "Ar-Rauf"],
  mirrorVersion: `« Et Il a fait de moi un être bon envers ma mère. » Le miroir me montre la bonté envers la mère. Jésus est bon envers Marie. La bonté filiale accompagne la prophétie. Le miroir m'interroge : comment suis-je avec ma mère ?`,
  reflection: `La bonté envers la mère est un signe de prophétie et de piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa barran bi walidati » — Et Il a fait de moi un être bon envers ma mère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment suis-je avec ma mère ? Est-ce que je suis bon envers elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonté envers la mère purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La relation à la mère est la première relation humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore sa mère honore la source de sa vie." }
  ],
  munajat: `Ya Barr, enseigne-moi la bonté envers ma mère. Fais que je l'honore comme Tu le veux. Dans ma relation avec elle, fais que je Te plaise.`
};

MIROIR["19:33"] = {
  reference: "19:33",
  theme: ["paix", "vie", "résurrection"],
  emotion: "Sérénité, espérance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Muhyi"],
  mirrorVersion: `« Que la paix soit sur moi le jour de ma naissance, le jour de ma mort, et le jour où je serai ressuscité. » Le miroir me montre la paix sur toute la vie. Jésus invoque la paix comme Yahya. La paix accompagne les prophètes. Le miroir m'interroge : est-ce que je cherche cette paix ?`,
  reflection: `La paix d'Allah couvre la vie entière. Elle est disponible pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-salamu 'alayya yawma wulidtu wa yawma amutu wa yawma ub'athu hayya » — Que la paix soit sur moi le jour de ma naissance, le jour de ma mort, et le jour où je serai ressuscité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la paix d'Allah sur toute ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix n'est pas un moment — c'est une présence constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être traverse ces moments — la paix peut les accompagner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la paix d'Allah la trouve à chaque transition." }
  ],
  munajat: `Ya Salam, que Ta paix soit sur moi à chaque moment de ma vie. Naissance, mort, résurrection — sois avec moi. Ne me laisse jamais sans Ta paix.`
};

MIROIR["19:34"] = {
  reference: "19:34",
  theme: ["jésus", "vérité", "questionnement"],
  emotion: "Certitude, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Masih"],
  mirrorVersion: `« C'est là une vérité sur laquelle ils disputent. » Le miroir me montre la dispute sur la vérité. La vérité de Jésus est contestée. Pourtant, elle reste vérité. Le miroir m'interroge : est-ce que je tiens à la vérité malgré les disputes ?`,
  reflection: `La vérité reste vérité même si on la dispute. Elle ne dépend pas de l'opinion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika 'isa ibnu maryama qawla al-haqqi alladhi fihi tamtarun » — C'est Jésus, fils de Marie, parole de vérité sur laquelle ils disputent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens à la vérité malgré les disputes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute ne change pas la vérité — elle révèle les cœurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une — les opinions sont multiples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la vérité n'a pas besoin de la défendre — elle se défend." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je La connaisse et La tienne. Ne laisse pas les disputes m'éloigner de ce qui est vrai.`
};

MIROIR["19:35"] = {
  reference: "19:35",
  theme: ["création", "fils", "décision"],
  emotion: "Certitude, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« Il ne convient pas à Allah de S'attribuer un fils. » Le miroir me montre la pureté de la nature divine. Allah n'a pas de fils — Sa création est par Sa parole « Sois ». Le miroir m'interroge : est-ce que j'accepte Allah tel qu'Il est ?`,
  reflection: `Allah est au-dessus de la création. Il n'a pas besoin de progéniture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana lillahi an yattakhidha min waladin » — Il ne convient pas à Allah de S'attribuer un fils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte Allah tel qu'Il Se décrit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence de fils pour Allah est une perfection, pas une limitation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah crée par Sa parole — pas par reproduction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah tel qu'Il est Le connaît vraiment." }
  ],
  munajat: `Ya Khaliq, Tu es le Créateur sans égal. J'accepte Ta nature telle que Tu la décris. Ne laisse pas mes conceptions humaines Te limiter.`
};

MIROIR["19:36"] = {
  reference: "19:36",
  theme: ["adoration", "chemin", "obéissance"],
  emotion: "Soumission, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'bud", "Al-Mahdi"],
  mirrorVersion: `« Allah est mon Seigneur et votre Seigneur. Adorez-Le. » Le miroir me montre l'appel universel. Jésus appelle à l'adoration d'Allah. Le chemin droit est l'adoration. Le miroir m'interroge : est-ce que j'adore Allah vraiment ?`,
  reflection: `L'adoration d'Allah est le chemin droit. Tous les prophètes l'ont enseigné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha rabbi wa rabbukum fa'buduhu » — Allah est mon Seigneur et votre Seigneur. Adorez-Le." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah vraiment ? Mon adoration est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration n'est pas un rituel — c'est une orientation du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création adore Allah à sa manière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah Le trouve partout." }
  ],
  munajat: `Ya Ma'bud, Tu es mon Seigneur. Fais que je T'adore en vérité. Ne laisse pas mon adoration être vide de sens. Guide-moi sur le chemin droit.`
};

MIROIR["19:37"] = {
  reference: "19:37",
  theme: ["division", "sectes", "désaccord"],
  emotion: "Tristesse, prière",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Hakam"],
  mirrorVersion: `« Les sectes divergèrent entre elles. » Le miroir me montre la division sur la vérité. La vérité unique produit des divisions. L'unité est rompue par l'ego. Le miroir m'interroge : est-ce que je contribue à l'unité ou à la division ?`,
  reflection: `La vérité devrait unir — mais l'ego divise. La division est un signe d'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakhtalafa al-ahzabu min baynihim » — Les sectes divergèrent entre elles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contribue à l'unité des croyants ou à leur division ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division sur la vérité ne détruit pas la vérité — elle détruit ceux qui se divisent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité est une loi divine — la division est une invention humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'unité dans la vérité la trouve." }
  ],
  munajat: `Ya Jami', Tu rassembles ce qui est divisé. Unifie les cœurs sur la vérité. Ne me laisse pas être source de division. Fais que je sois un facteur d'unité.`
};

MIROIR["19:38"] = {
  reference: "19:38",
  theme: ["jugement", "ouïe", "vue"],
  emotion: "Crainte, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Khabir"],
  mirrorVersion: `« Comme ils entendront et verront le jour où ils viendront à Nous ! » Le miroir me montre le jugement final. Les sens seront parfaits ce jour-là. Ce qui était caché sera vu. Le miroir m'interroge : est-ce que je vis comme si ce jour approche ?`,
  reflection: `Le jour du jugement révélera tout. Les sens seront parfaits pour voir la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kaifa yasma'una wa yubsiruna yawma ya'tunana » — Comme ils entendront et verront le jour où ils viendront à Nous !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en préparant ce jour ? Qu'est-ce qui sera révélé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est caché aujourd'hui sera vu demain — rien ne restera secret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout acte laisse une trace — le jugement la révélera." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en prévoyant ce jour le trouve léger." }
  ],
  munajat: `Ya Hakam, le jour du jugement approche. Fais que je m'y prépare. Ne laisse rien en moi qui doive être caché — purifie-moi avant ce jour.`
};

MIROIR["19:39"] = {
  reference: "19:39",
  theme: ["avertissement", "regret", "négligence"],
  emotion: "Urgence, réveil",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Ghaffar"],
  mirrorVersion: `« Avertis-les du jour du regret. » Le miroir me montre le jour du regret. Ce jour-là, le regret sera amer. Les occasions manquées seront visibles. Le miroir m'interroge : de quoi aurais-je regret aujourd'hui ?`,
  reflection: `Le regret viendra pour ce qui a été négligé. L'avertissement est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa andhirhum yawma al-hasrati » — Avertis-les du jour du regret." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi aurais-je regret aujourd'hui ? Qu'est-ce que je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret futur peut être évité par l'action présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque négligence laisse une dette — le jour du regret la réclame." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit maintenant n'aura pas de regret après." }
  ],
  munajat: `Ya Nadhir, avertis-moi avant le jour du regret. Fais que je voie mes négligences maintenant. Donne-moi le temps de me corriger avant qu'il soit trop tard.`
};

MIROIR["19:40"] = {
  reference: "19:40",
  theme: ["héritage", "retour", "puissance"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Qahir"],
  mirrorVersion: `« C'est Nous qui hériterons de la terre et de ceux qui s'y trouvent. » Le miroir me montre l'héritage final. Tout retourne à Allah. La terre et ses habitants Lui appartiennent. Le miroir m'interroge : est-ce que je vis en sachant que tout retourne à Lui ?`,
  reflection: `Tout appartient à Allah. Nous sommes des locataires temporaires. L'héritage final est Sien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nahnu nurithu al-arda wa man 'alayha » — C'est Nous qui hériterons de la terre et de ceux qui s'y trouvent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que tout retourne à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je possède n'est qu'un prêt — l'héritier final est Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne à son propriétaire véritable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il n'hérite pas détache son cœur." }
  ],
  munajat: `Ya Warith, Tu es l'Héritier de tout. Fais que je vive comme un gérant, pas un propriétaire. Tout ce que j'ai T'appartient — rends-le-moi facile à rendre.`
};

MIROIR["21:21"] = {
  reference: "21:21",
  theme: ["divinités", "création", "impuissance"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Ilah"],
  mirrorVersion: `« Ont-ils pris des divinités qui peuvent créer de la terre ? » Le miroir me montre l'absurdité des idoles. « Am ittakhadhu alihatan mina al-ardi hum yunshirun » — ont-ils pris des divinités qui peuvent créer de la terre ? Les idoles ne créent rien. Le miroir m'interroge : est-ce que j'adore le Créateur ou les créatures ?`,
  reflection: `Les idoles ne créent rien. Seul Allah crée. L'adorer Lui seul est la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am ittakhadhu alihatan mina al-ardi hum yunshirun » — ont-ils pris des divinités qui peuvent créer de la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore le Créateur ? Ou est-ce que j'adore les créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Adorer les créatures est vain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est créé. Seul le Créateur mérite l'adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore le Créateur seul trouve la vérité." }
  ],
  munajat: `Ya Khaliq, je T'adore Toi seul. Ne permets pas l'idolâtrie. Guide-moi vers l'adoration exclusive.`
};

MIROIR["21:22"] = {
  reference: "21:22",
  theme: ["divinités", "ciel", "désordre"],
  emotion: "Certitude, logique",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "As-Samawat"],
  mirrorVersion: `« S'il y avait dans le ciel et la terre des divinités autres qu'Allah, tous deux seraient corrompus. » Le miroir me montre la preuve de l'unicité. « Law kana fihima alihatun illa Allahu lafasadat » — s'il y avait dans le ciel et la terre des divinités autres qu'Allah, tous deux seraient corrompus. L'ordre de l'univers prouve l'unicité. Le miroir m'interroge : est-ce que je contemple cet ordre ?`,
  reflection: `L'ordre parfait de l'univers prouve l'unicité d'Allah. Contempler cet ordre renforce la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kana fihima alihatun illa Allahu lafasadat » — s'il y avait dans le ciel et la terre des divinités autres qu'Allah, tous deux seraient corrompus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'ordre de l'univers ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre de l'univers est la signature de l'Unicité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est parfaitement ordonné par un seul Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'ordre de l'univers découvre l'Un." }
  ],
  munajat: `Ya Wahid, je contemple Ton ordre parfait. Ne permets pas l'aveuglement. Fais que je voie Ta signature dans toute chose.`
};

MIROIR["21:23"] = {
  reference: "21:23",
  theme: ["questionnement", "autorité", "souveraineté"],
  emotion: "Soumission, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Hakam"],
  mirrorVersion: `« Il n'est pas questionné sur ce qu'Il fait, mais eux seront questionnés. » Le miroir me montre la souveraineté absolue d'Allah. « La yus'alu 'amma yaf'al » — Il n'est pas questionné sur ce qu'Il fait. « Wa hum yus'alun » — mais eux seront questionnés. Allah juge, les hommes sont jugés. Le miroir m'interroge : est-ce que j'accepte Sa souveraineté ?`,
  reflection: `Allah n'est pas questionné. Nous le sommes. Accepter Sa souveraineté est la soumission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yus'alu 'amma yaf'al wa hum yus'alun » — Il n'est pas questionné sur ce qu'Il fait, mais eux seront questionnés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte Sa souveraineté ? Ou est-ce que je La questionne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Questionner Allah est l'orgueil. Être questionné est notre réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit sans questionner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la souveraineté d'Allah trouve la paix." }
  ],
  munajat: `Ya Malik, j'accepte Ta souveraineté. Ne permets pas le questionnement. Soumets-moi entièrement à Ta volonté.`
};

MIROIR["21:24"] = {
  reference: "21:24",
  theme: ["divinités", "preuve", "guidance"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Burhan"],
  mirrorVersion: `« Ont-ils pris des divinités en dehors de Lui ? Dis : apportez votre preuve ! » Le miroir me montre le défi divin. « Am ittakhadhu min dunihi alihatan » — ont-ils pris des divinités en dehors de Lui ? « Qul hatu burhanakum » — dis : apportez votre preuve ! Les mécréants n'ont aucune preuve. Le miroir m'interroge : est-ce que j'ai des preuves de ma foi ?`,
  reflection: `Les mécréants n'ont pas de preuves. Les croyants ont le Coran et la création comme preuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am ittakhadhu min dunihi alihatan qul hatu burhanakum » — ont-ils pris des divinités en dehors de Lui ? Dis : apportez votre preuve !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai des preuves de ma foi ? Ou est-ce que je crois aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans preuve est fragile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une preuve d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche les preuves les trouve partout." }
  ],
  munajat: `Ya Rabb, donne-moi des preuves de ma foi. Ne permets pas l'aveuglement. Ouvre mes yeux aux signes partout.`
};

MIROIR["21:25"] = {
  reference: "21:25",
  theme: ["messagers", "unicité", "adoration"],
  emotion: "Unité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-'Ibadah"],
  mirrorVersion: `« Et Nous n'avons envoyé avant toi aucun messager sans lui révéler : nulle divinité en dehors de Moi, adorez-Moi ! » Le miroir me montre le message universel. « Wa ma arsalna min qablika min rasulin illa nuhi ilayhi » — Nous n'avons envoyé avant toi aucun messager sans lui révéler. « Annahu la ilaha illa ana fa'budun » — nulle divinité en dehors de Moi, adorez-Moi ! Le message est toujours le même. Le miroir m'interroge : est-ce que j'adore Allah seul ?`,
  reflection: `Tous les prophètes ont apporté le même message : adorez Allah seul. C'est le message éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna min qablika min rasulin illa nuhi ilayhi annahu la ilaha illa ana fa'budun » — Nous n'avons envoyé avant toi aucun messager sans lui révéler : nulle divinité en dehors de Moi, adorez-Moi !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah seul ? Ou est-ce que j'associe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah seul est le message de tous les prophètes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message de l'unicité traverse toute l'histoire humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul suit tous les prophètes." }
  ],
  munajat: `Ya Wahid, je T'adore Toi seul. Ne permets pas l'association. Fais que mon adoration soit exclusive.`
};

MIROIR["21:26"] = {
  reference: "21:26",
  theme: ["anges", "fils", "créatures"],
  emotion: "Clarté, rectification",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "Al-Khaliq"],
  mirrorVersion: `« Et ils ont dit : le Tout-Miséricordieux a pris un fils ! Pureté à Lui ! Ce sont plutôt des serviteurs honorés. » Le miroir me montre la rectification divine. « Wa qalu ittakhadha al-Rahmanu waladan » — ils ont dit : le Tout-Miséricordieux a pris un fils ! « Subhanahu » — Pureté à Lui ! « Bal 'ibadun mukramun » — ce sont plutôt des serviteurs honorés. Les anges sont des serviteurs, pas des fils. Le miroir m'interroge : est-ce que je comprends la nature des anges ?`,
  reflection: `Les anges sont des serviteurs honorés, pas des fils. Allah est au-dessus de la filiation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu ittakhadha al-Rahmanu waladan subhanahu bal 'ibadun mukramun » — ils ont dit : le Tout-Miséricordieux a pris un fils ! Pureté à Lui ! Ce sont plutôt des serviteurs honorés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la nature des anges ? Ou est-ce que je crois aux mythes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas de fils. Les anges sont Ses serviteurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est serviteur d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la nature des créatures ne les divinise pas." }
  ],
  munajat: `Ya Rahman, je comprends que Tu n'as pas de fils. Ne permets pas les mythes. Fais que je voie les créatures comme elles sont.`
};

MIROIR["21:27"] = {
  reference: "21:27",
  theme: ["anges", "parole", "obéissance"],
  emotion: "Révérence, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "Al-Tawq"],
  mirrorVersion: `« Ils ne parlent qu'après Lui et agissent sur Son ordre. » Le miroir me montre l'obéissance des anges. « La yantasiquna min qawlihi » — ils ne parlent qu'après Lui. « Wa hum bi-amrihi ya'malun » — et agissent sur Son ordre. Les anges attendent l'ordre d'Allah. Le miroir m'interroge : est-ce que j'attends l'ordre d'Allah ?`,
  reflection: `Les anges n'agissent que sur l'ordre d'Allah. Les imiter est une forme d'obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yantasiquna min qawlihi wa hum bi-amrihi ya'malun » — ils ne parlent qu'après Lui et agissent sur Son ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends l'ordre d'Allah ? Ou est-ce que j'agis par moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Agir sans l'ordre d'Allah est l'orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit aux ordres d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend l'ordre d'Allah est guidé." }
  ],
  munajat: `Ya Rabb, j'attends Ton ordre. Ne permets pas l'indépendance. Fais que j'agisse selon Ta volonté.`
};

MIROIR["21:28"] = {
  reference: "21:28",
  theme: ["anges", "intercession", "connaissance"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Ash-Shafa'ah"],
  mirrorVersion: `« Il connaît ce qui est devant eux et ce qui est derrière eux, et ils n'intercèdent qu'en faveur de ceux qu'Il agrée. » Le miroir me montre la connaissance divine et l'intercession. « Ya'lamu ma bayna aydihim wa ma khalfahum » — Il connaît ce qui est devant eux et ce qui est derrière eux. « Wa la yashfa'una illa liman irtada » — ils n'intercèdent qu'en faveur de ceux qu'Il agrée. L'intercession est conditionnée par l'agrément divin. Le miroir m'interroge : est-ce que je suis agréé par Allah ?`,
  reflection: `Allah connaît tout. L'intercession ne fonctionne qu'avec Son agrément. Être agréé est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamu ma bayna aydihim wa ma khalfahum wa la yashfa'una illa liman irtada » — Il connaît ce qui est devant eux et ce qui est derrière eux, et ils n'intercèdent qu'en faveur de ceux qu'Il agrée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis agréé par Allah ? Ou est-ce que je compte sur l'intercession sans mérite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession n'est pas automatique. Elle nécessite l'agrément." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance divine embrasse tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est agréé par Allah reçoit l'intercession." }
  ],
  munajat: `Ya 'Alim, fais que je sois agréé par Toi. Ne permets pas le rejet. Accorde-moi Ton agrément et l'intercession.`
};

MIROIR["21:29"] = {
  reference: "21:29",
  theme: ["divinité", "prétention", "châtiment"],
  emotion: "Vigilance, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Ilah", "Al-Jahannam"],
  mirrorVersion: `« Quiconque parmi eux dirait : je suis une divinité en dehors de Lui, Nous le rétribuerions par l'Enfer. » Le miroir me montre le châtiment de la prétention. « Man yaqul minhum inni ilahun ghayruhu » — quiconque parmi eux dirait : je suis une divinité en dehors de Lui. « Fa dhalika najzihu jahannam » — Nous le rétribuerions par l'Enfer. La prétention à la divinité mène à l'Enfer. Le miroir m'interroge : est-ce que je prétends à quelque chose qui ne m'appartient pas ?`,
  reflection: `Prétendre à la divinité mène à l'Enfer. Rester humble et reconnaître sa place de serviteur est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yaqul minhum inni ilahun ghayruhu fa dhalika najzihu jahannam » — quiconque parmi eux dirait : je suis une divinité en dehors de Lui, Nous le rétribuerions par l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prétends à quelque chose qui ne m'appartient pas ? Ou est-ce que je reste humble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention mène à la perte. L'humilité mène au salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul n'est divin excepté Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste humble à sa place est honoré." }
  ],
  munajat: `Ya Rabb, je reste humble à ma place. Ne permets pas la prétention. Fais que je reconnaisse que je suis Ton serviteur.`
};

MIROIR["21:30"] = {
  reference: "21:30",
  theme: ["création", "ciel", "terre", "vie"],
  emotion: "Émerveillement, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hayy"],
  mirrorVersion: `« Ceux qui ont mécru n'ont-ils pas vu que les cieux et la terre formaient une masse compacte ? » Le miroir me montre l'origine de l'univers. « Awalam yara alladhina kafaru anna al-samawati wa al-arda kanata ratqan » — les mécréants n'ont-ils pas vu que les cieux et la terre formaient une masse compacte ? « Fa fataqnahuma » — puis Nous les avons séparés. « Wa ja'alna mina al-ma'i kulla shay'in hayyin » — et Nous avons fait de l'eau toute chose vivante. Le miroir m'interroge : est-ce que je contemple l'origine de l'univers ?`,
  reflection: `L'univers était une masse compacte. Allah l'a séparé. La vie vient de l'eau. La science confirme le Coran.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awalam yara alladhina kafaru anna al-samawati wa al-arda kanata ratqan fa fataqnahuma wa ja'alna mina al-ma'i kulla shay'in hayyin » — les mécréants n'ont-ils pas vu que les cieux et la terre formaient une masse compacte ? Puis Nous les avons séparés. Et Nous avons fait de l'eau toute chose vivante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'origine de l'univers ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine de l'univers est un signe d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers vient d'une masse compacte séparée par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'origine de l'univers découvre le Créateur." }
  ],
  munajat: `Ya Khaliq, je contemple l'origine de l'univers. Ne permets pas l'aveuglement. Montre-moi Tes signes dans la création.`
};

MIROIR["21:31"] = {
  reference: "21:31",
  theme: ["montagnes", "stabilité", "création"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Jibal", "Al-Rawasi"],
  mirrorVersion: `« Et Nous avons placé des montagnes firmly fixées dans la terre de peur qu'elle ne les ébranle. » Le miroir me montre la sagesse de la création. « Wa ja'alna fi al-ardi rawasiya an tamida bihim » — Nous avons placé des montagnes firmly fixées dans la terre de peur qu'elle ne les ébranle. Les montagnes stabilisent la terre. Le miroir m'interroge : est-ce que je contemple cette sagesse ?`,
  reflection: `Les montagnes stabilisent la terre. Cette stabilité est un don d'Allah pour notre bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna fi al-ardi rawasiya an tamida bihim » — Nous avons placé des montagnes firmly fixées dans la terre de peur qu'elle ne les ébranle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple la sagesse des montagnes ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les montagnes sont des piliers de stabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est stabilisée par les montagnes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les montagnes découvre la sagesse du Créateur." }
  ],
  munajat: `Ya Rabb, je contemple la sagesse des montagnes. Ne permets pas l'aveuglement. Montre-moi Ta sagesse dans toute chose.`
};

MIROIR["21:32"] = {
  reference: "21:32",
  theme: ["ciel", "protection", "création"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["As-Sama'", "Al-Hifz"],
  mirrorVersion: `« Et Nous avons fait du ciel un toit protégé. » Le miroir me montre la protection divine. « Wa ja'alna al-sama'a saqfan mahfuzan » — Nous avons fait du ciel un toit protégé. Le ciel nous protège des rayons nocifs et des météorites. Le miroir m'interroge : est-ce que je suis reconnaissant pour cette protection ?`,
  reflection: `Le ciel est un toit protégé. Cette protection invisible est un don immense d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna al-sama'a saqfan mahfuzan » — Nous avons fait du ciel un toit protégé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour cette protection ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection du ciel est invisible mais réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'atmosphère protège toute vie sur terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la protection divine est protégé." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour la protection du ciel. Ne permets pas l'ingratitude. Protège-moi de tout mal.`
};

MIROIR["21:33"] = {
  reference: "21:33",
  theme: ["soleil", "lune", "nuit", "jour"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Ash-Shams", "Al-Qamar"],
  mirrorVersion: `« Et c'est Lui qui a créé la nuit et le jour, le soleil et la lune, chacun voguant dans une orbite. » Le miroir me montre l'ordre cosmique. « Wa huwa alladhi khalaqa al-layla wa al-nahara wa al-shamsa wa al-qamar » — c'est Lui qui a créé la nuit et le jour, le soleil et la lune. « Kullun fi falakin yasbahun » — chacun voguant dans une orbite. Les astres suivent leur orbite. Le miroir m'interroge : est-ce que je contemple cet ordre ?`,
  reflection: `Le soleil, la lune, la nuit et le jour suivent leur orbite. Cet ordre est un signe d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi khalaqa al-layla wa al-nahara wa al-shamsa wa al-qamar kullun fi falakin yasbahun » — c'est Lui qui a créé la nuit et le jour, le soleil et la lune, chacun voguant dans une orbite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'ordre des astres ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre des astres est un signe de l'ordre divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers suit un ordre parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'ordre des astres découvre l'Ordinateur." }
  ],
  munajat: `Ya Rabb, je contemple l'ordre des astres. Ne permets pas l'aveuglement. Fais que je voie Ton ordre partout.`
};

MIROIR["21:34"] = {
  reference: "21:34",
  theme: ["mort", "prophète", "éternité"],
  emotion: "Acceptation, réalisme",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Baqi"],
  mirrorVersion: `« Et Nous n'avons pas fait de l'homme avant toi un être éternel. » Le miroir me montre la mortalité universelle. « Wa ma ja'alna li-basharin min qablika al-khuld » — Nous n'avons pas fait de l'homme avant toi un être éternel. Personne n'est éternel. Le miroir m'interroge : est-ce que j'accepte ma mortalité ?`,
  reflection: `Nul n'est éternel. Accepter sa mortalité est la sagesse. Préparer sa mort est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ja'alna li-basharin min qablika al-khuld » — Nous n'avons pas fait de l'homme avant toi un être éternel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma mortalité ? Ou est-ce que je fuis cette réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort est certaine. L'éternité appartient à Allah seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est mortel excepté Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa mortalité prépare sa mort." }
  ],
  munajat: `Ya Mumit, j'accepte ma mortalité. Ne permets pas le déni. Prépare-moi à Te rencontrer.`
};

MIROIR["19:42"] = {
  reference: "19:42",
  theme: ["ibrahim", "père", "invitation"],
  emotion: "Tendresse, préoccupation",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Wali"],
  mirrorVersion: `« Ô mon père, pourquoi adores-tu ce qui n'entend ni ne voit ? » Le miroir me montre l'invitation d'Ibrahim à son père. Il invite avec tendresse malgré l'erreur. L'appel est respectueux mais ferme. Le miroir m'interroge : comment j'invite les autres à la vérité ?`,
  reflection: `L'invitation à la vérité peut être ferme et respectueuse. L'amour n'empêche pas la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya abati lima ta'budu ma la yasma'u wa la yubsiru » — Ô mon père, pourquoi adores-tu ce qui n'entend ni ne voit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'invite les autres à la vérité ? Avec respect ou avec mépris ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité dite avec amour est mieux reçue que le mensonge dit avec douceur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme égarée a besoin d'un appel sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle avec sincérité touche les cœurs, même sans résultat visible." }
  ],
  munajat: `Ya Hadi, donne-moi la sagesse d'appeler à la vérité avec amour. Fais que je ne méprise pas ceux qui s'égarent. Comme Ibrahim, fais que je sois un appel sincère.`
};

MIROIR["19:43"] = {
  reference: "19:43",
  theme: ["sagesse", "révélation", "obéissance"],
  emotion: "Humilité, conviction",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Wahy"],
  mirrorVersion: `« La science m'est venue que ne t'est pas venue. » Le miroir me montre la science donnée par Allah. Ibrahim a reçu une science que son père n'a pas. La révélation crée une distance de compréhension. Le miroir m'interroge : est-ce que je suis la science reçue ?`,
  reflection: `La science d'Allah guide. Celui qui la reçoit doit la suivre même si les proches ne la comprennent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad ja'ani mina al-'ilmi ma lam ya'tika » — La science m'est venue que ne t'est pas venue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la science que j'ai reçue ? Ou est-ce que je la cache pour plaire aux autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La science est une responsabilité — pas un privilège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance est un don — elle doit être partagée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit sa science malgré l'opposition est guidé." }
  ],
  munajat: `Ya Hakim, Tu m'as donné de la science. Fais que je la suive avec courage. Ne me laisse pas cacher la vérité pour plaire aux autres.`
};

MIROIR["19:44"] = {
  reference: "19:44",
  theme: ["idolâtrie", "satan", "désobéissance"],
  emotion: "Avertissement, amour",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ash-Shaytan"],
  mirrorVersion: `« Ô mon père, n'adore pas Satan. » Le miroir me montre le lien entre idolâtrie et satan. Adorer les idoles, c'est obéir à Satan. L'adoration détermine le maître. Le miroir m'interroge : qui est mon maître réel ?`,
  reflection: `L'adoration est une obéissance. Ce qu'on adore, on obéit. Satan se cache derrière les fausses adorations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya abati la ta'budu al-shaytana » — Ô mon père, n'adore pas Satan." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon maître réel ? À qui obéis-je en réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration apparente peut cacher une obéissance à Satan." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a que deux chemins — celui d'Allah et celui de Satan." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son maître réel le choisit consciemment." }
  ],
  munajat: `Ya Rahman, je ne veux pas adorer Satan. Fais que mon adoration soit purement pour Toi. Révèle-moi les fausses adorations dans ma vie.`
};

MIROIR["19:45"] = {
  reference: "19:45",
  theme: ["châtiment", "miséricorde", "relation"],
  emotion: "Inquiétude, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Al-Mu'adhib"],
  mirrorVersion: `« Je crains qu'un châtiment te touche de la part du Tout-Miséricordieux. » Le miroir me montre la crainte pour les proches. Ibrahim craint pour son père. La crainte n'est pas de la haine — c'est de l'amour. Le miroir m'interroge : est-ce que je crains pour ceux que j'aime ?`,
  reflection: `La crainte pour le salut des proches est un signe d'amour vrai. Elle prie pour eux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inni akhafu an yamassaka 'adhabun mina al-rahmani » — Je crains qu'un châtiment te touche de la part du Tout-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains pour ceux que j'aime ? Est-ce que je prie pour leur salut ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie crainte pour autrui mène à la prière, pas au rejet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment d'Allah est réel — personne n'en est à l'abri sans miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint pour autrui prie avec sincérité." }
  ],
  munajat: `Ya Ghafur, je crains pour ceux que j'aime. Préserve-les du châtiment. Fais que ma crainte se transforme en prière sincère.`
};

MIROIR["19:46"] = {
  reference: "19:46",
  theme: ["rejet", "menace", "épreuve"],
  emotion: "Tristesse, courage",
  difficulty: "débutant",
  relatedNames: ["Al-Mawla", "As-Sabur"],
  mirrorVersion: `« Désires-tu abandonner mes divinités ? » Le miroir me montre le rejet du message. Le père d'Ibrahim rejette et menace. L'appel à la vérité peut être rejeté. Le miroir m'interroge : comment réagis-je au rejet ?`,
  reflection: `Le rejet fait partie du chemin de la vérité. Il teste la conviction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A radigha 'an alihati ya ibrahim » — Désires-tu abandonner mes divinités, Ô Ibrahim ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je quand mon appel est rejeté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet de l'appel n'invalide pas l'appel — il révèle le cœur de l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes ont été rejetés — c'est la norme, pas l'exception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le rejet avec patience continue d'appeler." }
  ],
  munajat: `Ya Mawla, quand je suis rejeté, sois ma force. Fais que je ne me décourage pas. Continue à m'inspirer pour appeler à la vérité malgré le rejet.`
};

MIROIR["19:47"] = {
  reference: "19:47",
  theme: ["prière", "parents", "désobéissance"],
  emotion: "Douleur, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mustajab", "Ar-Rauf"],
  mirrorVersion: `« Paix sur toi. Je vais prier mon Seigneur de te pardonner. » Le miroir me montre la prière pour ceux qui rejettent. Ibrahim prie pour son père malgré le rejet. La prière persiste. Le miroir m'interroge : est-ce que je prie pour ceux qui me rejettent ?`,
  reflection: `La prière pour les opposants est le signe d'un cœur attaché à Allah. Elle ne dépend pas de la réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salamun 'alayka sa-astaghfiru laka rabbi » — Paix sur toi. Je vais prier mon Seigneur de te pardonner." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour ceux qui me rejettent ? Ou est-ce que je les abandonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour l'opposant purifie le cœur de la rancune." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière sincere atteint son but — même si le résultat n'est pas visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour ses opposants grandit en spiritualité." }
  ],
  munajat: `Ya Mustajab, je prie pour ceux qui me rejettent. Pardonne-leur comme je veux être pardonné. Purifie mon cœur de toute rancune.`
};

MIROIR["19:48"] = {
  reference: "19:48",
  theme: ["séparation", "invocation", "détachement"],
  emotion: "Résolution, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Mujib"],
  mirrorVersion: `« Je me sépare de vous et de ce que vous invoquez. » Le miroir me montre la séparation nécessaire. Ibrahim se sépare de sa famille et de ses idoles. La séparation protège la foi. Le miroir m'interroge : de quoi dois-je me séparer ?`,
  reflection: `La séparation peut être nécessaire pour préserver la foi. Elle n'est pas un abandon — c'est une protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa a'tazilukum wa ma tad'una min duni Allahi wa ad'u rabbi » — Je me sépare de vous et de ce que vous invoquez hormis Allah, et j'invoque mon Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi dois-je me séparer pour protéger ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La séparation du mal est une union avec Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute croissance demande une séparation de l'ancien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sépare pour Allah trouve Sa compagnie." }
  ],
  munajat: `Ya Wali, je me sépare de ce qui m'éloigne de Toi. Donne-moi le courage de couper les liens nocifs. Dans ma séparation, sois mon Compagnon.`
};

MIROIR["19:49"] = {
  reference: "19:49",
  theme: ["bénédiction", "don", "prophètes"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Karim"],
  mirrorVersion: `« Nous lui donnâmes Isaac et Jacob. » Le miroir me montre la récompense de la séparation. Ibrahim quitte sa famille et reçoit une descendance prophétique. Le don suit le sacrifice. Le miroir m'interroge : qu'est-ce que je sacrifie pour Allah ?`,
  reflection: `Le sacrifice pour Allah est toujours récompensé. La récompense peut dépasser le sacrifice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabna lahu ishaqa wa ya'qub » — Nous lui donnâmes Isaac et Jacob." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je sacrifie pour Allah ? Qu'est-ce que je reçois en retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice n'est pas une perte — c'est un échange." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque sacrifice sincère est récompensé par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne pour Allah reçoit davantage qu'il n'a donné." }
  ],
  munajat: `Ya Wahhab, Tu récompenses le sacrifice. Donne-moi le courage de sacrifier pour Toi. Fais que je voie Ta générosité dans mes renoncements.`
};

MIROIR["19:50"] = {
  reference: "19:50",
  theme: ["miséricorde", "prophètes", "générosité"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mannan"],
  mirrorVersion: `« Nous leur accordâmes de Notre miséricorde. » Le miroir me montre la miséricorde sur les prophètes. La miséricorde d'Allah accompagne les sacrifices. Elle est le fil conducteur. Le miroir m'interroge : est-ce que je cherche la miséricorde d'Allah ?`,
  reflection: `La miséricorde d'Allah est la récompense ultime. Elle surpasse tout don matériel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabna lahum min rahmatina » — Nous leur accordâmes de Notre miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la miséricorde d'Allah ? C'est-elle mon but ultime ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde d'Allah vaut plus que tout ce qu'on peut donner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde est l'attribut le plus vaste d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la miséricorde la trouve." }
  ],
  munajat: `Ya Rahman, Ta miséricorde est mon but. Accorde-la-moi. Fais que je ne cherche rien d'autre que Ta miséricorde dans tout ce que je fais.`
};

MIROIR["19:51"] = {
  reference: "19:51",
  theme: ["musa", "élection", "parole"],
  emotion: "Révérence, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Mukhtar", "Al-Mutakallim"],
  mirrorVersion: `« Et mentionne Moïse dans le Livre. Il était sincère. » Le miroir me montre l'élection de Moïse. Il est choisi et sincère. La sincérité attire l'élection. Le miroir m'interroge : suis-je sincère dans ma relation avec Allah ?`,
  reflection: `La sincérité (sidq) est une qualité prophétique. Elle attire la faveur d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur fi al-kitabi musa innahu kana mukhlasan » — Et mentionne Moïse dans le Livre. Il était sincère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je sincère dans ma relation avec Allah ? Mon cœur est-il pur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité purifie tout — même les imperfections." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sincérité est la monnaie du royaume spirituel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère est élu par Allah." }
  ],
  munajat: `Ya Mukhtar, élis-moi par ma sincérité. Purifie mon cœur de tout ce qui n'est pas pour Toi. Fais que je sois parmi les sincères.`
};

MIROIR["19:52"] = {
  reference: "19:52",
  theme: ["appel", "montagne", "révélation"],
  emotion: "Awe, écoute",
  difficulty: "débutant",
  relatedNames: ["An-Nadi", "At-Tur"],
  mirrorVersion: `« Nous l'appelâmes depuis le côté droit du Mont. » Le miroir me montre l'appel divin. Allah appelle Moïse depuis la montagne. L'appel vient du haut — de la proximité. Le miroir m'interroge : est-ce que j'entends l'appel d'Allah ?`,
  reflection: `Allah appelle chaque âme. La question est de savoir si on écoute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nadaynahu min janibi al-turi al-aymani » — Nous l'appelâmes depuis le côté droit du Mont." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends l'appel d'Allah ? Mon cœur est-il ouvert ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel d'Allah vient de la proximité — pas de la distance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque montagne, chaque lieu, peut être un lieu de révélation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'appel est guidé." }
  ],
  munajat: `Ya Nadi, appelle-moi depuis Ta proximité. Ouvre mes oreilles à Ton appel. Fais que je sois parmi ceux qui entendent et répondent.`
};

MIROIR["19:53"] = {
  reference: "19:53",
  theme: ["harun", "frère", "soutien"],
  emotion: "Gratitude, fraternité",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'ayyid", "Al-Akh"],
  mirrorVersion: `« Et Nous lui donnâmes son frère Aaron comme prophète. » Le miroir me montre le don du soutien. Moïse reçoit son frère comme soutien. La mission n'est pas solitaire. Le miroir m'interroge : qui est mon soutien dans la foi ?`,
  reflection: `La mission a besoin de soutien. Allah envoie des compagnons pour les prophètes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabna lahu min rahmatina akhahu haruna nabiyyan » — Et Nous lui donnâmes, de Notre miséricorde, son frère Aaron comme prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon soutien dans la foi ? Suis-je un soutien pour les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don du frère est une miséricorde — pas une nécessité pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fraternité dans la foi est un don d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a un frère dans la foi a un trésor." }
  ],
  munajat: `Ya Mu'ayyid, donne-moi des frères dans la foi. Fais que je sois un soutien pour eux. Dans la fraternité, bénis-nous et guide-nous.`
};

MIROIR["19:54"] = {
  reference: "19:54",
  theme: ["isma'il", "vérité", "promesse"],
  emotion: "Respect, admiration",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Wa'd"],
  mirrorVersion: `« Et mentionne Ismaël dans le Livre. Il était véridique. » Le miroir me montre la véracité d'Ismaël. La véracité est une qualité prophétique. Elle engage le passé et l'avenir. Le miroir m'interroge : suis-je véridique dans mes promesses ?`,
  reflection: `La véracité (sidq) engage la parole et l'acte. Le prophète la personnifie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur fi al-kitabi isma'ila innahu kana sadiqa al-wa'di » — Et mentionne Ismaël dans le Livre. Il était véridique dans sa promesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je véridique dans mes promesses ? Ma parole est-elle fiable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse non tenue est un mensonge envers soi et envers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur la fiabilité de la parole divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient ses promesses ressemble aux prophètes." }
  ],
  munajat: `Ya Sadiq, fais que je sois véridique dans mes promesses. Ma parole doit être sacrée. Ne me laisse pas manquer à mes engagements.`
};

MIROIR["19:55"] = {
  reference: "19:55",
  theme: ["prière", "zakat", "appel"],
  emotion: "Devotion, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Musalli", "Al-Muzakki"],
  mirrorVersion: `« Il ordonnait à sa famille la prière et l'aumône. » Le miroir me montre l'exemple d'Ismaël. Il pratiquait et enseignait. La prière et la zakat sont prioritaires. Le miroir m'interroge : est-ce que j'enseigne ma famille ?`,
  reflection: `La pratique sans enseignement est incomplète. Le croyant doit transmettre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kana ya'muru ahlahu bi al-salati wa al-zakati » — Il ordonnait à sa famille la prière et l'aumône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'enseigne ma famille ? Mon exemple est-il suivi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui n'enseigne pas ce qu'il pratique trahit sa pratique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transmission de la foi est aussi importante que sa pratique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ordonne le bien à sa famille reçoit la bénédiction." }
  ],
  munajat: `Ya Musalli, fais que j'ordonne le bien à ma famille. Ma pratique et mon enseignement doivent être unis. Bénis ma famille dans la prière et la zakat.`
};

MIROIR["19:56"] = {
  reference: "19:56",
  theme: ["idris", "vérité", "élévation"],
  emotion: "Admiration, espérance",
  difficulty: "débutant",
  relatedNames: ["As-Siddiq", "Ar-Rafi'"],
  mirrorVersion: `« Et mentionne Idris dans le Livre. Il était véridique, un prophète. » Le miroir me montre Idris. Véridique et prophète — deux qualités liées. La véracité mène à la prophétie. Le miroir m'interroge : quelle qualité prophétique puis-je développer ?`,
  reflection: `Les prophètes sont des exemples. Chaque qualité prophétique est accessible au croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur fi al-kitabi idrisa innahu kana siddiqa nabiyyan » — Et mentionne Idris dans le Livre. Il était véridique, un prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle qualité prophétique puis-je développer ? La véracité ? La patience ? La confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les qualités prophétiques ne sont pas réservées aux prophètes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque croyant est appelé à ressembler aux prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui développe les qualités prophétiques est élevé." }
  ],
  munajat: `Ya Siddiq, fais que je développe les qualités des prophètes. Véracité, patience, confiance — enseigne-moi. Élève-moi comme Tu as élevé Idris.`
};

MIROIR["19:57"] = {
  reference: "19:57",
  theme: ["élévation", "honneur", "rang"],
  emotion: "Espérance, humilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rafi'", "Al-Karim"],
  mirrorVersion: `« Nous l'élevâmes à un haut rang. » Le miroir me montre l'élévation d'Idris. Allah l'a élevé. L'élévation vient d'Allah, pas de soi. Le miroir m'interroge : où place-je mon espoir d'élévation ?`,
  reflection: `L'élévation véritable vient d'Allah. Elle suit la sincérité et la véracité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rafa'nahu makanan 'aliyyan » — Nous l'élevâmes à un haut rang." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où place-je mon espoir d'élévation ? En moi-même ou en Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation par Allah est permanente — l'auto-élévation est fragile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce qu'Allah élève ne peut être abaissé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'élévation d'Allah la reçoit." }
  ],
  munajat: `Ya Rafi', élève-moi par Ta grâce. Je ne cherche pas l'élévation du monde mais la Tienne. Fais que mon rang soit élevé auprès de Toi.`
};

MIROIR["19:58"] = {
  reference: "19:58",
  theme: ["descendance", "bénédiction", "prophètes"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhurriyah", "Al-Mubarak"],
  mirrorVersion: `« Ceux-là sont ceux qu'Allah a bénis parmi les prophètes. » Le miroir me montre la bénédiction sur les prophètes. Adam et sa descendance, ceux qui sont bénis. La bénédiction d'Allah choisit. Le miroir m'interroge : est-ce que je recherche la bénédiction d'Allah ?`,
  reflection: `La bénédiction d'Allah descend sur ceux qu'Il choisit. La recherche de cette bénédiction est légitime.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika alladhina an'ama Allahu 'alayhim mina al-nabiyyina » — Ceux-là sont ceux qu'Allah a bénis parmi les prophètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recherche la bénédiction d'Allah ? Mon cœur est-il orienté vers Sa faveur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bénédiction d'Allah n'est pas un hasard — elle répond à des qualités." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La bénédiction est le signe de l'élection divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la bénédiction la trouve." }
  ],
  munajat: `Ya Mubarak, bénis-moi comme Tu as béni les prophètes. Je cherche Ta faveur, pas la faveur du monde. Fais que je sois parmi les bénis.`
};

MIROIR["19:59"] = {
  reference: "19:59",
  theme: ["successeurs", "négligence", "prière"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Khalaf", "Ad-Dala"],
  mirrorVersion: `« Puis leur succédèrent des générations qui délaissèrent la prière. » Le miroir me montre le déclin des générations. Après les prophètes, la négligence. La prière est la première abandonnée. Le miroir m'interroge : est-ce que je préserve la prière ?`,
  reflection: `La négligence commence par la prière. La prière est le pilier — si elle tombe, tout tombe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-khalafa min ba'dihim khalfun adau al-salata » — Puis leur succédèrent des générations qui délaissèrent la prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la prière ? Est-elle ma priorité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon de la prière est le début de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération est testée sur la prière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la prière préserve sa foi." }
  ],
  munajat: `Ya Rabb, préserve ma prière. Ne me laisse pas la délaisser. Fais que la prière soit mon pilier, mon refuge, ma force.`
};

MIROIR["19:60"] = {
  reference: "19:60",
  theme: ["repentir", "foi", "réforme"],
  emotion: "Espérance, encouragement",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Mu'min"],
  mirrorVersion: `« Sauf ceux qui se repentent, croient et font le bien. » Le miroir me montre l'exception. Il y a toujours un chemin de retour. Le repentir, la foi, les œuvres — trois étapes. Le miroir m'interroge : ai-je pris ce chemin ?`,
  reflection: `Le repentir est toujours possible. La porte n'est jamais fermée pour celui qui veut revenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa man taba wa amana wa 'amila salihan » — Sauf ceux qui se repentent, croient et font le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je pris le chemin du repentir ? Ma foi est-elle active ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir sans œuvre est incomplet — l'œuvre sans foi est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour à Allah est toujours possible — jusqu'au dernier souffle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement est comme celui qui n'a pas péché." }
  ],
  munajat: `Ya Tawwab, je me repens et je reviens à Toi. Accepte mon repentir, fortifie ma foi, guide mes œuvres. Fais que je sois parmi ceux qui reviennent.`
};

MIROIR["21:36"] = {
  reference: "21:36",
  theme: ["moquerie", "prophète", "persécution"],
  emotion: "Patience, résilience",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Ar-Rasul"],
  mirrorVersion: `« Quand les mécréants te voient, ils ne te prennent qu'en moquerie. » Le miroir me montre l'attitude des mécréants. « Wa idha ra'aka alladhina kafaru in yattakhidhunaka illa huzuan » — quand les mécréants te voient, ils ne te prennent qu'en moquerie. Le prophète est moqué. Le miroir m'interroge : est-ce que je supporte la moquerie pour la vérité ?`,
  reflection: `Les prophètes ont été moqués. La vérité dérange. Être moqué pour la vérité est un honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'aka alladhina kafaru in yattakhidhunaka illa huzuan » — quand les mécréants te voient, ils ne te prennent qu'en moquerie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je supporte la moquerie pour la vérité ? Ou est-ce que je fuis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie des mécréants est un signe de vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous été moqués." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui supporte la moquerie pour la vérité est honoré par Allah." }
  ],
  munajat: `Ya Rabb, aide-moi à supporter la moquerie pour Ta vérité. Ne permets pas la faiblesse. Honore-moi par la patience.`
};

MIROIR["21:37"] = {
  reference: "21:37",
  theme: ["impatience", "châtiment", "création"],
  emotion: "Calme, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-'Azab"],
  mirrorVersion: `« L'homme a été créé impatient. » Le miroir me montre la nature humaine. « Khuliqa al-insanu min 'ajal » — l'homme a été créé impatient. « Sa'urikum ayati fala tasta'jilun » — Je vais vous montrer Mes signes, ne Me pressez pas. L'impatience est naturelle mais doit être maîtrisée. Le miroir m'interroge : est-ce que je maîtrise mon impatience ?`,
  reflection: `L'impatience est naturelle. La maîtriser est une vertu. Attendre les signes d'Allah avec confiance est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khuliqa al-insanu min 'ajal sa'urikum ayati fala tasta'jilun » — l'homme a été créé impatient. Je vais vous montrer Mes signes, ne Me pressez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je maîtrise mon impatience ? Ou est-ce que je presse Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impatience précipite l'erreur. La patience permet la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne avec patience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise son impatience reçoit les signes d'Allah." }
  ],
  munajat: `Ya Rabb, maîtrise mon impatience. Ne permets pas la précipitation. Donne-moi la patience d'attendre Tes signes.`
};

MIROIR["21:38"] = {
  reference: "21:38",
  theme: ["promesse", "châtiment", "défi"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Haqq"],
  mirrorVersion: `« Et ils disent : quand sera cette promesse, si vous êtes véridiques ? » Le miroir me montre le défi des mécréants. « Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — et ils disent : quand sera cette promesse, si vous êtes véridiques ? Les mécréants défient la promesse d'Allah. Le miroir m'interroge : est-ce que je fais confiance à la promesse d'Allah ?`,
  reflection: `Les mécréants défient la promesse d'Allah. Mais Sa promesse est certaine. La confiance est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — et ils disent : quand sera cette promesse, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la promesse d'Allah ? Ou est-ce que je la questionne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Questionner la promesse d'Allah est le signe de la mécréance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah s'accomplit toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la promesse d'Allah la voit s'accomplir." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ta promesse. Ne permets pas le doute. Accomplis Ta promesse quand Tu le veux.`
};

MIROIR["21:39"] = {
  reference: "21:39",
  theme: ["vision", "châtiment", "regret"],
  emotion: "Urgence, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "An-Nar"],
  mirrorVersion: `« Si seulement les mécréants pouvaient voir le moment où ils ne pourront éloigner le feu de leurs visages ! » Le miroir me montre la vision du châtiment. « Law ya'lamu alladhina kafaru heena la yakuffuna 'an wujuhihimu al-nar » — si seulement les mécréants pouvaient savoir quand ils ne pourront éloigner le feu de leurs visages ! Le châtiment est inévitable. Le miroir m'interroge : est-ce que j'évite ce châtiment maintenant ?`,
  reflection: `Le châtiment est inévitable pour les mécréants. L'éviter maintenant par la foi est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law ya'lamu alladhina kafaru heena la yakuffuna 'an wujuhihimu al-nar » — si seulement les mécréants pouvaient savoir quand ils ne pourront éloigner le feu de leurs visages !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite ce châtiment maintenant ? Ou est-ce que j'attends qu'il soit trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment peut être évité par la foi maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu attend ceux qui le méritent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant évite le châtiment éternel." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que j'attende. Épargne-moi le châtiment par ma foi sincère.`
};

MIROIR["21:40"] = {
  reference: "21:40",
  theme: ["châtiment", "soudaineté", "impuissance"],
  emotion: "Vigilance, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "An-Nar"],
  mirrorVersion: `« Au contraire, il leur viendra soudainement et les stupéfiera. » Le miroir me montre la soudaineté du châtiment. « Bal ta'tihim baghtatan fatabhathuhum » — au contraire, il leur viendra soudainement et les stupéfiera. Le châtiment arrive sans avertissement. Le miroir m'interroge : suis-je prêt ?`,
  reflection: `Le châtiment arrive soudainement. Être prêt à tout moment est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal ta'tihim baghtatan fatabhathuhum » — au contraire, il leur viendra soudainement et les stupéfiera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le châtiment soudain ? Ou est-ce que je suis distrait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soudaineté du châtiment est sa force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'imprévu caractérise le châtiment divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt à tout moment n'est pas surpris." }
  ],
  munajat: `Ya Rabb, je suis prêt pour Ta rencontre. Ne permets pas la distraction. Prépare-moi à tout moment.`
};

MIROIR["21:41"] = {
  reference: "21:41",
  theme: ["moquerie", "messagers", "destruction"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rusul", "Al-Mutakabbirun"],
  mirrorVersion: `« Certes, on s'est moqué de messagers avant toi, et ceux qui se sont moqués d'eux furent enveloppés par ce dont ils se moquaient. » Le miroir me montre la conséquence de la moquerie. « Wa laqadi istuhzi'a bi-rusulin min qablika » — on s'est moqué de messagers avant toi. « Fa haqa bi-alladhina sakhiru minhum ma kanu bihi yastahzi'un » — ceux qui se sont moqués furent enveloppés par ce dont ils se moquaient. La moquerie se retourne contre les moqueurs. Le miroir m'interroge : est-ce que je me moque ?`,
  reflection: `Ceux qui se moquent des prophètes sont détruits. La moquerie est dangereuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqadi istuhzi'a bi-rusulin min qablika fa haqa bi-alladhina sakhiru minhum ma kanu bihi yastahzi'un » — on s'est moqué de messagers avant toi, et ceux qui se sont moqués d'eux furent enveloppés par ce dont ils se moquaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque ? Ou est-ce que je respecte les prophètes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie se retourne contre le moqueur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire témoigne de la destruction des moqueurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les prophètes est respecté par Allah." }
  ],
  munajat: `Ya Rabb, je respecte les prophètes. Ne permets pas la moquerie. Honore-moi par le respect de Tes élus.`
};

MIROIR["21:42"] = {
  reference: "21:42",
  theme: ["protection", "nuit", "jour"],
  emotion: "Confiance, refuge",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Ar-Rahman"],
  mirrorVersion: `« Dis : qui vous protégera la nuit et le jour contre le Tout-Miséricordieux ? » Le miroir me montre l'absence de refuge contre Allah. « Qul man yakla'ukum bi-al-layli wa al-nahari mina al-Rahman » — dis : qui vous protégera la nuit et le jour contre le Tout-Miséricordieux ? Nul refuge contre Allah. Le miroir m'interroge : est-ce que je me réfugie en Allah seul ?`,
  reflection: `Nul refuge contre Allah. Se réfugier en Lui seul est la seule protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul man yakla'ukum bi-al-layli wa al-nahari mina al-Rahman » — dis : qui vous protégera la nuit et le jour contre le Tout-Miséricordieux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me réfugie en Allah seul ? Ou est-ce que je cherche d'autres protecteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le seul protecteur contre Lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nulle protection en dehors d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie en Allah est protégé." }
  ],
  munajat: `Ya Rahman, je me réfugie en Toi seul. Ne permets pas que je cherche d'autres protecteurs. Protège-moi de Ton châtiment.`
};

MIROIR["21:43"] = {
  reference: "21:43",
  theme: ["divinités", "protection", "impuissance"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Nasr"],
  mirrorVersion: `« Ont-ils des divinités qui les protègent en dehors de Nous ? » Le miroir me montre l'impuissance des idoles. « Am lahum alihatun tamna'uhum min dunina » — ont-ils des divinités qui les protègent en dehors de Nous ? Les idoles ne protègent personne. Le miroir m'interroge : est-ce que j'ai d'autres protecteurs qu'Allah ?`,
  reflection: `Les idoles ne protègent pas. Seul Allah protège. Mettre sa confiance en Lui seul est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lahum alihatun tamna'uhum min dunina » — ont-ils des divinités qui les protègent en dehors de Nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai d'autres protecteurs qu'Allah ? Ou est-ce que je mets ma confiance en Lui seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles ne protègent personne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute protection vient d'Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui met sa confiance en Allah seul est protégé." }
  ],
  munajat: `Ya Rabb, je mets ma confiance en Toi seul. Ne permets pas l'association. Protège-moi par Ta puissance.`
};

MIROIR["21:44"] = {
  reference: "21:44",
  theme: ["provision", "mécréance", "aveuglement"],
  emotion: "Vigilance, lucidité",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Ghani"],
  mirrorVersion: `« Nous avons donné de jouir à ces gens et à leurs pères, jusqu'à un âge avancé. » Le miroir me montre l'aveuglement par la provision. « Matta'na hawla'i wa aba'ahum hatta tala 'alayhimu al-'umur » — Nous avons donné de jouir à ces gens et à leurs pères, jusqu'à un âge avancé. Les biens aveuglent. Le miroir m'interroge : est-ce que les biens m'aveuglent ?`,
  reflection: `Les biens peuvent aveugler. Rester lucide au milieu de l'abondance est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Matta'na hawla'i wa aba'ahum hatta tala 'alayhimu al-'umur » — Nous avons donné de jouir à ces gens et à leurs pères, jusqu'à un âge avancé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que les biens m'aveuglent ? Ou est-ce que je reste lucide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abondance peut être un test, pas une bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens sont éphémères. La lucidité est durable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste lucide dans l'abondance est vraiment riche." }
  ],
  munajat: `Ya Rabb, garde-moi lucide dans l'abondance. Ne permets pas l'aveuglement. Fais que je Te voie au-delà des biens.`
};

MIROIR["21:45"] = {
  reference: "21:45",
  theme: ["avertissement", "sourds", "révélation"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Qur'an"],
  mirrorVersion: `« Dis : je vous avertis par ce qui m'est révélé. » Le miroir me montre la mission du prophète. « Qul innama andhirukum bi-al-wahy » — dis : je vous avertis par ce qui m'est révélé. « Wa la yasma'u al-summu al-du'a'a » — mais les sourds n'entendent pas l'appel. Les cœurs fermés n'entendent pas. Le miroir m'interroge : mon cœur est-il ouvert ?`,
  reflection: `Les sourds n'entendent pas l'avertissement. Avoir le cœur ouvert est essentiel pour entendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama andhirukum bi-al-wahy wa la yasma'u al-summu al-du'a'a » — dis : je vous avertis par ce qui m'est révélé. Mais les sourds n'entendent pas l'appel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il ouvert ? Ou est-ce que je suis sourd à l'appel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La surdité du cœur est plus grave que la surdité des oreilles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'appel d'Allah résonne partout. Seuls les cœurs ouverts l'entendent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre son cœur entend l'appel d'Allah." }
  ],
  munajat: `Ya Rabb, ouvre mon cœur à Ton appel. Ne permets pas la surdité. Fais que j'entende Ton avertissement.`
};

MIROIR["21:46"] = {
  reference: "21:46",
  theme: ["châtiment", "toucher", "désespoir"],
  emotion: "Effroi, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "An-Nar"],
  mirrorVersion: `« Et si un souffle du châtiment de ton Seigneur les touche, ils diront : malheur à nous ! » Le miroir me montre la fragilité humaine. « Wa la-in massathum nafkhatun min 'adhabi rabbika » — et si un souffle du châtiment de ton Seigneur les touche. « La yaqulun ya waylana inna kunna zalimin » — ils diront : malheur à nous ! Nous étions injustes ! Un souffle suffit pour les faire confesser. Le miroir m'interroge : est-ce que j'attends ce souffle ?`,
  reflection: `Un souffle du châtiment suffit pour faire confesser. Ne pas attendre ce moment est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in massathum nafkhatun min 'adhabi rabbika la yaqulun ya waylana inna kunna zalimin » — et si un souffle du châtiment de ton Seigneur les touche, ils diront : malheur à nous ! Nous étions injustes !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends ce souffle ? Ou est-ce que je me repens maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir avant le châtiment est préférable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La puissance d'Allah est immense. Un souffle suffit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant le souffle est épargné." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que j'attende le souffle. Pardonne-moi avant que le châtiment ne touche.`
};

MIROIR["21:47"] = {
  reference: "21:47",
  theme: ["balance", "justice", "jugement"],
  emotion: "Responsabilité, équité",
  difficulty: "débutant",
  relatedNames: ["Al-Mizan", "Al-'Adl"],
  mirrorVersion: `« Nous placerons les balances exactes pour le Jour de la Résurrection. » Le miroir me montre la précision du jugement. « Wa nad'u al-mawazin al-qishta li-yawmi al-qiyamah » — Nous placerons les balances exactes pour le Jour de la Résurrection. « Fala tuzlamu nafsun shay'an » — nulle âme ne sera lésée en rien. La justice est parfaite. Le miroir m'interroge : suis-je prêt pour cette balance ?`,
  reflection: `La balance du Jour du Jugement est exacte. Personne n'est lésé. Préparer son compte est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nad'u al-mawazin al-qishta li-yawmi al-qiyamah fala tuzlamu nafsun shay'an » — Nous placerons les balances exactes pour le Jour de la Résurrection. Nulle âme ne sera lésée en rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour cette balance ? Ou est-ce que je néglige mon compte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La balance est exacte. Il n'y a pas de tricherie possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite et universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son compte maintenant le trouve léger." }
  ],
  munajat: `Ya 'Adl, prépare mon compte pour Ta balance. Ne permets pas la lourdeur. Allège mon compte par Tes bonnes actions.`
};

MIROIR["21:48"] = {
  reference: "21:48",
  theme: ["Moïse", "Aaron", "guidance"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Musa", "Harun", "Al-Furqan"],
  mirrorVersion: `« Et Nous avons donné à Moïse et à Aaron le Critère. » Le miroir me montre la guidance des prophètes. « Wa laqad atayna Musa wa Haruna al-furqan » — Nous avons donné à Moïse et à Aaron le Critère. « Wa diya'an wa dhikran lil-muttaqin » — et une lumière et un rappel pour les pieux. Le Critère distingue le vrai du faux. Le miroir m'interroge : est-ce que j'ai ce critère ?`,
  reflection: `Moïse et Aaron ont reçu le Critère. Les pieux en bénéficient. Chercher ce critère est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad atayna Musa wa Haruna al-furqan wa diya'an wa dhikran lil-muttaqin » — Nous avons donné à Moïse et à Aaron le Critère, et une lumière et un rappel pour les pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai ce critère ? Ou est-ce que je confonds le vrai et le faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Critère est la lumière qui distingue le vrai du faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance des prophètes illumine les pieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui possède le Critère ne s'égare pas." }
  ],
  munajat: `Ya Rabb, donne-moi le Critère. Ne permets pas la confusion. Illumine mon chemin par Ta guidance.`
};

MIROIR["19:61"] = {
  reference: "19:61",
  theme: ["jardin", "éternité", "promesse"],
  emotion: "Espérance, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Janna", "Al-Wa'd"],
  mirrorVersion: `« Ils entreront dans les Jardins d'Éden. » Le miroir me montre la promesse du Paradis. Les Jardins d'Éden attendent. La promesse est sûre. Le miroir m'interroge : est-ce que je désire le Paradis ?`,
  reflection: `Le Paradis est la promesse d'Allah. Le désirer est une forme de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika yadkhuluna al-jannati » — Ils entreront dans les Jardins d'Éden." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le Paradis ? Est-il mon but ultime ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas une récompense — c'est une destination préparée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis existe — il attend ceux qui y aspirent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire le Paradis sincèrement y est appelé." }
  ],
  munajat: `Ya Janna, Tu es ma destination. Fais que je Te désire plus que tout. Prépare-moi pour les Jardins d'Éden.`
};

MIROIR["19:62"] = {
  reference: "19:62",
  theme: ["paix", "salutation", "paradis"],
  emotion: "Sérénité, anticipation",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Karim"],
  mirrorVersion: `« Ils n'y entendront aucune parole futile, mais seulement 'Paix'. » Le miroir me montre la paix du Paradis. Pas de paroles futiles — seulement la paix. La paix est le langage du Paradis. Le miroir m'interroge : quelles paroles entrent dans mon cœur ?`,
  reflection: `La paix est l'ambiance du Paradis. Les paroles futiles en sont exclues.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yasma'una fiha laghwan illa salaman » — Ils n'y entendront aucune parole futile, mais seulement 'Paix'." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles paroles entrent dans mon cœur ? Sont-elles futiles ou porteuses de paix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix sur terre prépare la paix du Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est un lieu de paix — la terre peut en être une anticipation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive la paix sur terre la trouve au Paradis." }
  ],
  munajat: `Ya Salam, fais que mes paroles soient paix. Prépare mon cœur pour la paix du Paradis. Éloigne de moi les paroles futiles.`
};

MIROIR["19:63"] = {
  reference: "19:63",
  theme: ["héritage", "serviteurs", "piété"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Muttaqin"],
  mirrorVersion: `« C'est le Paradis que Nous ferons hériter à Nos serviteurs pieux. » Le miroir me montre l'héritage du Paradis. Les pieux en sont les héritiers. La piété est la clé de l'héritage. Le miroir m'interroge : suis-je parmi les pieux ?`,
  reflection: `Le Paradis est un héritage. La piété est la condition pour l'obtenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka al-jannatu allati nurithu min 'ibadi al-muttaqin » — C'est le Paradis que Nous ferons hériter à Nos serviteurs pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les pieux ? Qu'est-ce que la piété dans ma vie ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La piété n'est pas une performance — c'est une orientation du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis n'est pas acheté — il est hérité par la piété." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la piété hérite du Paradis." }
  ],
  munajat: `Ya Warith, je veux être parmi Tes serviteurs pieux. Enseigne-moi la piété. Fais que j'hérite du Paradis par ma crainte de Toi.`
};

MIROIR["19:64"] = {
  reference: "19:64",
  theme: ["ange", "descente", "volonté"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Ar-Ruh", "Al-Amr"],
  mirrorVersion: `« Nous ne descendons que sur ordre de ton Seigneur. » Le miroir me montre l'obéissance des anges. Ils descendent sur ordre divin. La volonté d'Allah gouverne tout. Le miroir m'interroge : est-ce que j'obéis à l'ordre d'Allah ?`,
  reflection: `Les anges obéissent parfaitement. Le croyant est appelé à la même obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma natanazzalu illa bi amri rabbika » — Nous ne descendons que sur ordre de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis à l'ordre d'Allah ? Mon obéissance est-elle totale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance des anges est instinctive — la nôtre doit être choisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers obéit à Allah — seul l'homme peut désobéir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit totalement ressemble aux anges." }
  ],
  munajat: `Ya Amr, fais que j'obéisse à Ton ordre. Ma volonté doit s'aligner sur la Tienne. Fais que je sois comme les anges dans mon obéissance.`
};

MIROIR["19:65"] = {
  reference: "19:65",
  theme: ["seigneur", "création", "adoration"],
  emotion: "Awe, soumission",
  difficulty: "débutant",
  relatedNames: ["Ar-Rabb", "Al-Khaliq"],
  mirrorVersion: `« Lui le Seigneur des cieux et de la terre et de ce qui est entre eux. » Le miroir me montre la seigneurie d'Allah. Tout Lui appartient. Les cieux, la terre, l'entre-deux — Sa création. Le miroir m'interroge : est-ce que je reconnais Sa seigneurie sur tout ?`,
  reflection: `La seigneurie d'Allah englobe tout. Rien n'échappe à Sa souveraineté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbu al-samawati wa al-ardi wa ma baynahuma » — Lui le Seigneur des cieux et de la terre et de ce qui est entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Sa seigneurie sur tout ? Y compris sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Reconnaître Sa seigneurie, c'est accepter ma servitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame Sa seigneurie — silencieusement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît Sa seigneurie trouve sa place dans l'univers." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur de tout. Je reconnais Ta seigneurie sur moi. Fais que je vive en serviteur reconnaissant.`
};

MIROIR["19:66"] = {
  reference: "19:66",
  theme: ["mort", "résurrection", "incrédulité"],
  emotion: "Questionnement, éveil",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ath", "Al-Mawt"],
  mirrorVersion: `« L'homme dit : Quand je serai mort, serai-je ressuscité ? » Le miroir me montre le doute sur la résurrection. L'homme doute du retour à la vie. La résurrection semble impossible à l'esprit limité. Le miroir m'interroge : est-ce que je crois en la résurrection ?`,
  reflection: `La résurrection est un article de foi. Le doute vient de la limitation de l'esprit humain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaqulu al-insanu a-idha ma mittu la-awhudana hayyan » — L'homme dit : Quand je serai mort, serai-je ressuscité ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en la résurrection ? Mon cœur en est-il convaincu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est impossible pour l'homme — pas pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est une loi de l'univers — le printemps après l'hiver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection prépare sa rencontre avec Allah." }
  ],
  munajat: `Ya Ba'ath, je crois en la résurrection. Fortifie ma foi en ce jour. Fais que je vive en sachant que je serai ressuscité devant Toi.`
};

MIROIR["19:67"] = {
  reference: "19:67",
  theme: ["création", "mémoire", "première fois"],
  emotion: "Rappel, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Badi'"],
  mirrorVersion: `« L'homme ne voit-il pas que Nous l'avons créé d'une goutte ? » Le miroir me montre l'origine de l'homme. Une goutte de sperme — voilà l'origine. La création première prouve la résurrection. Le miroir m'interroge : est-ce que je me souviens de mon origine ?`,
  reflection: `La première création est un miracle. Ce qui a été créé une fois peut l'être à nouveau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yara al-insanu anna khalaqnahu min nutfatin » — L'homme ne voit-il pas que Nous l'avons créé d'une goutte ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine ? De ma petitesse première ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si J'ai été créé de rien, je peux être recréé après la mort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est continue — chaque instant est un acte créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine connaît sa destination." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de rien. Fais que je me souvienne de mon origine. Cette mémoire doit m'humilier et me fortifier dans la foi en la résurrection.`
};

MIROIR["19:68"] = {
  reference: "19:68",
  theme: ["rassemblement", "jugement", "responsabilité"],
  emotion: "Sérieux, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Hashr", "Al-Hisab"],
  mirrorVersion: `« Par ton Seigneur, Nous les rassemblerons avec les démons. » Le miroir me montre le rassemblement universel. Tous seront rassemblés — même les démons. Le jour du jugement est certain. Le miroir m'interroge : suis-je prêt pour ce rassemblement ?`,
  reflection: `Le rassemblement est inévitable. Personne n'y échappe. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-warabbiki la-nahshurannahum wa al-shayatina » — Par ton Seigneur, Nous les rassemblerons avec les démons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le rassemblement ? Qu'est-ce qui sera révélé ce jour-là ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement n'est pas une menace — c'est une réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne à son origine — le rassemblement est le retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le rassemblement le traverse en sécurité." }
  ],
  munajat: `Ya Hashr, le rassemblement approche. Prépare-moi pour ce jour. Fais que je sois du bon côté, avec les bons compagnons.`
};

MIROIR["19:69"] = {
  reference: "19:69",
  theme: ["extraction", "groupes", "jugement"],
  emotion: "Sérieux, examen",
  difficulty: "débutant",
  relatedNames: ["An-Natiq", "Al-Fasiq"],
  mirrorVersion: `« Puis Nous ferons sortir de chaque groupe ceux qui étaient les plus rebelles. » Le miroir me montre le tri final. Chaque groupe sera examiné. Les rebelles seront séparés. Le miroir m'interroge : dans quel groupe serai-je ?`,
  reflection: `Le jugement sépare les groupes. Les rebelles sont identifiés et sortis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma la-nanzi'anna min kulli shi'atin » — Puis Nous ferons sortir de chaque groupe ceux qui étaient les plus rebelles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quel groupe serai-je ? Suis-je parmi les rebelles ou les soumis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rébellion contre Allah mène à l'extraction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté sera jugée selon ses actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet à Allah n'a pas à craindre l'extraction." }
  ],
  munajat: `Ya Rabb, ne me laisse pas être parmi les rebelles. Fais que je sois parmi les soumis. Épargne-moi l'extraction des orgueilleux.`
};

MIROIR["19:70"] = {
  reference: "19:70",
  theme: ["connaissance", "méritants", "brûlement"],
  emotion: "Certitude, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Muqtadir"],
  mirrorVersion: `« Puis Nous savons le mieux qui mérite le plus d'y être brûlé. » Le miroir me montre la connaissance parfaite d'Allah. Il sait qui mérite le Feu. Rien n'échappe à Sa connaissance. Le miroir m'interroge : est-ce que je crains d'être parmi ceux qui méritent le Feu ?`,
  reflection: `La connaissance d'Allah est parfaite. Le mérite du châtiment est connu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nahnu a'lamu bi alladhina hum awla biha saliyyan » — Puis Nous savons le mieux qui mérite le plus d'y être brûlé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains d'être parmi ceux qui méritent le Feu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance d'Allah est justice — pas arbitraire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Feu existe pour ceux qui le méritent — le Paradis pour les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le Feu le fuit — celui qui l'oublie s'en approche." }
  ],
  munajat: `Ya 'Alim, Tu sais qui mérite le Feu. Préserve-moi de le mériter. Fuis tout ce qui m'en rapproche. Guide-moi vers le Paradis.`
};

MIROIR["19:71"] = {
  reference: "19:71",
  theme: ["passage", "enfer", "certitude"],
  emotion: "Sérieux, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wajib", "An-Nar"],
  mirrorVersion: `« Il n'y a personne parmi vous qui ne passera pas par l'Enfer. » Le miroir me montre le passage obligé. Tout le monde passera par l'Enfer — mais pas tous y resteront. Le passage est certitude. Le miroir m'interroge : suis-je prêt pour ce passage ?`,
  reflection: `Le passage par l'Enfer est inévitable. La différence est dans le temps passé et la sortie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in minkum illa wariduha » — Il n'y a personne parmi vous qui ne passera pas par l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ce passage ? Mon œuvre permettra-t-elle de passer rapidement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le passage n'est pas la condamnation — c'est l'épreuve obligatoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est une réalité — le passage est un passage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe rapidement n'est pas touché par le feu." }
  ],
  munajat: `Ya Rabb, je passerai par l'Enfer. Fais que ce passage soit rapide. Protège-moi du feu. Fais que je sois parmi ceux qui sortent rapidement.`
};

MIROIR["19:72"] = {
  reference: "19:72",
  theme: ["salut", "damnation", "différence"],
  emotion: "Espérance, crainte",
  difficulty: "débutant",
  relatedNames: ["An-Naji", "Al-Halid"],
  mirrorVersion: `« Puis Nous sauverons ceux qui ont craint. » Le miroir me montre le salut après le passage. Les pieux seront sauvés. Les injustes y resteront. Le miroir m'interroge : serai-je parmi les sauvés ?`,
  reflection: `Le salut suit la piété. La crainte d'Allah est la clé de la sortie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nunajji alladhina ittaqaw » — Puis Nous sauverons ceux qui ont craint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Serai-je parmi les sauvés ? Ma crainte d'Allah est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah sauve — l'insouciance condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le salut est un don — la damnation est un choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant sera sauvé alors." }
  ],
  munajat: `Ya Naji, sauve-moi du Feu. Ma crainte de Toi doit être sincère. Fais que je sois parmi ceux qui sortent et entrent au Paradis.`
};

MIROIR["19:73"] = {
  reference: "19:73",
  theme: ["moquerie", "foi", "réalité"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mustahzi'un", "Al-Mu'minun"],
  mirrorVersion: `« Quand Nos signes sont récités, les mécréants disent aux croyants : Lequel des deux groupes a une meilleure situation ? » Le miroir me montre la moquerie des mécréants. Ils se croient supérieurs. La réalité est inverse. Le miroir m'interroge : comment réagis-je à la moquerie ?`,
  reflection: `La supériorité apparente ne signifie rien. La vraie situation est connue d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha tutla 'alayhim ayatuna bayyinatin qala alladhina kafaru lilladhina amanu ayyu al-fariqayni khayrun maqaman » — Quand Nos signes sont récités, les mécréants disent aux croyants : Lequel des deux groupes a une meilleure situation ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je à la moquerie ? Est-ce que je me laisse déstabiliser ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie d'aujourd'hui deviendra le regret de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les apparences trompent — la vérité est connue d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est moqué pour sa foi est honoré par Allah." }
  ],
  munajat: `Ya Rabb, quand je suis moqué, fortifie-moi. Fais que je ne cherche pas l'approbation des hommes. Ma situation réelle est connue de Toi.`
};

MIROIR["19:74"] = {
  reference: "19:74",
  theme: ["destruction", "générations", "supériorité"],
  emotion: "Rappel, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Muhlik", "Al-Qasim"],
  mirrorVersion: `« Combien de générations avons-Nous détruites avant eux ! » Le miroir me montre l'histoire des destructions. Les générations passées étaient plus puissantes. La destruction les a atteintes. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire est un maître. Les générations passées étaient plus fortes — et pourtant détruites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kam ahlakna qablahum min qarnin » — Combien de générations avons-Nous détruites avant eux !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Les leçons du passé m'atteignent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance n'est pas une protection — la foi l'est." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un cycle — les puissants tombent, les humbles restent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Muhlik, les générations passées ont péri. Enseigne-moi par leur histoire. Ne me laisse pas m'enorgueillir de ma situation. La sécurité est en Toi seul.`
};

MIROIR["19:75"] = {
  reference: "19:75",
  theme: ["égarement", "délai", "destination"],
  emotion: "Sérieux, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Mudill", "Al-Mahdi"],
  mirrorVersion: `« Quiconque est dans l'égarement, que le Tout-Miséricordieux prolonge son délai. » Le miroir me montre le délai accordé aux égarés. La prolongation n'est pas une bénédiction — c'est une épreuve. Le miroir m'interroge : comment utilises-je le temps qui m'est donné ?`,
  reflection: `Le délai peut être une ruse. La longueur de vie n'est pas signe de faveur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul man kana fi al-dalalati fa-l-yamdud lahu al-rahmanu maddan » — Dis : Quiconque est dans l'égarement, que le Tout-Miséricordieux prolonge son délai." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment utilises-je le temps qui m'est donné ? Est-ce pour me rapprocher ou m'éloigner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prolongation de la vie de l'égaré est une augmentation de son châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est une épreuve — pour le croyant et l'égaré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise son temps pour le bien est béni dans son temps." }
  ],
  munajat: `Ya Rahman, ne me laisse pas m'égarer. Si je suis dans l'égarement, guide-moi rapidement. Fais que mon temps soit utilisé pour me rapprocher de Toi.`
};

MIROIR["19:76"] = {
  reference: "19:76",
  theme: ["guidance", "augmentation", "bien"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Ziyadah", "Al-Huda"],
  mirrorVersion: `« Allah ajoute la guidance à ceux qui sont guidés. » Le miroir me montre l'augmentation de la guidance. La guidance attire plus de guidance. Le bien attire le bien. Le miroir m'interroge : est-ce que je cherche l'augmentation de la guidance ?`,
  reflection: `La guidance n'est pas statique — elle croît avec la pratique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaziduu Allahu alladhina ihtadaw hudan » — Allah ajoute la guidance à ceux qui sont guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche l'augmentation de la guidance ? Mon cœur est-il ouvert à plus de lumière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance utilise ce qu'elle a pour en recevoir plus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière attire la lumière — les ténèbres attirent les ténèbres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la guidance la reçoit en abondance." }
  ],
  munajat: `Ya Hadi, ajoute à ma guidance. Je cherche plus de lumière. Fais que chaque pas vers Toi m'en rapproche davantage.`
};

MIROIR["19:77"] = {
  reference: "19:77",
  theme: ["mécréance", "promesse", "désaveu"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kafir", "Al-Wa'id"],
  mirrorVersion: `« As-tu vu celui qui ne croit pas en Nos signes ? » Le miroir me montre le mécréant qui nie les promesses. Il dit : On me donnera richesse et enfants. La présomption l'aveugle. Le miroir m'interroge : est-ce que je crois aux promesses d'Allah ?`,
  reflection: `La mécréance en les signes d'Allah mène à la présomption. Croire aux promesses est la base.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A ra'ayta alladhi kafara bi-ayatina » — As-tu vu celui qui ne croit pas en Nos signes ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux promesses d'Allah ? Mon cœur est-il certain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mécréance en les promesses est une mécréance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les promesses d'Allah sont certaines — nier est une erreur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux promesses d'Allah les voit se réaliser." }
  ],
  munajat: `Ya Rabb, je crois en Tes signes et Tes promesses. Fortifie ma foi. Ne me laisse pas douter de Ta parole.`
};

MIROIR["19:78"] = {
  reference: "19:78",
  theme: ["connaissance", "invisible", "présomption"],
  emotion: "Humilité, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Ghayb", "Al-'Alim"],
  mirrorVersion: `« A-t-il connaissance de l'invisible ? » Le miroir me montre la limite de la connaissance humaine. L'invisible appartient à Allah. Personne ne connaît l'avenir. Le miroir m'interroge : est-ce que je prétends connaître ce que je ne connais pas ?`,
  reflection: `L'invisible est le domaine d'Allah. La présomption de le connaître est une erreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-t-il connaissance de l'invisible ? Ou a-t-il pris un engagement auprès du Tout-Miséricordieux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prétends connaître ce que je ne connais pas ? Mon humilité est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention de connaître l'invisible est une usurpation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invisible est le secret d'Allah — Il le révèle à qui Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa limite connaît sa place." }
  ],
  munajat: `Ya 'Alim, Tu connais l'invisible. Moi, je ne connais que ce que Tu m'as appris. Fais que je reste humble dans ma connaissance limitée.`
};

MIROIR["19:79"] = {
  reference: "19:79",
  theme: ["écriture", "châtiment", "prolongation"],
  emotion: "Sérieux, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Katib", "Al-Mu'adhib"],
  mirrorVersion: `« Nous écrirons ce qu'il dit et prolongerons son châtiment. » Le miroir me montre l'écriture des paroles. Tout est enregistré. La prolongation du châtiment suit la parole arrogante. Le miroir m'interroge : que dis-je qui sera écrit ?`,
  reflection: `Les paroles sont enregistrées. L'arrogance dans la parole prolonge le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla sanaktubu ma yaqulu wa namuddu lahu mina al-'adhabi maddan » — Non ! Nous écrirons ce qu'il dit et prolongerons son châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que dis-je qui sera écrit ? Mes paroles sont-elles justes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne parole est écrite comme bonne action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est enregistré — parole, acte, intention." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui surveille ses paroles protège son châtiment." }
  ],
  munajat: `Ya Katib, écris mes bonnes paroles. Efface mes mauvaises paroles. Fais que ce qui est écrit de moi soit une source de récompense, pas de châtiment.`
};

MIROIR["19:80"] = {
  reference: "19:80",
  theme: ["héritage", "solitude", "retour"],
  emotion: "Réalité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Fard"],
  mirrorVersion: `« C'est Nous qui hériterons de ce dont il parle. » Le miroir me montre l'héritage final. Tout ce qu'il possède lui échappera. Allah hérite de tout. Le miroir m'interroge : à quoi suis-je attaché qui ne m'appartient pas ?`,
  reflection: `L'héritage d'Allah est absolu. Rien ne nous appartient vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nahnu narithuhu wa yaqulu » — C'est Nous qui hériterons de ce dont il parle, et il viendra à Nous seul." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi suis-je attaché qui ne m'appartient pas ? Mon détachement est-il réel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attachement à ce qui sera hérité est un attachement à l'emprunté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout retourne à Allah — nous sommes des locataires temporaires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il n'hérite pas détache son cœur." }
  ],
  munajat: `Ya Warith, Tu hérites de tout. Détache mon cœur de ce qui ne m'appartient pas. Fais que je vienne à Toi seul, sans rien d'autre que mes œuvres.`
};

MIROIR["21:49"] = {
  reference: "21:49",
  theme: ["crainte", "Jour", "secret"],
  emotion: "Révérence, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Khashyah", "Al-Ghayb"],
  mirrorVersion: `« Ceux qui craignent leur Seigneur en secret et qui redoutent l'Heure. » Le miroir me montre la crainte intérieure. « Alladhina yakhawna rabbahum bi-al-ghaybi » — ceux qui craignent leur Seigneur en secret. « Wa hum min al-sa'ati mushfiqun » — et qui redoutent l'Heure. La crainte secrète est sincère. Le miroir m'interroge : est-ce que je crains Allah en secret ?`,
  reflection: `La crainte en secret est la vraie crainte. Redouter l'Heure est le signe de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yakhawna rabbahum bi-al-ghaybi wa hum min al-sa'ati mushfiqun » — ceux qui craignent leur Seigneur en secret et qui redoutent l'Heure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah en secret ? Ou est-ce que je ne Le crains que publiquement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte secrète est la plus sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure approche pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah en secret est sécurisé par Lui." }
  ],
  munajat: `Ya Rabb, je Te crains en secret. Ne permets pas l'hypocrisie. Fais que ma crainte soit sincère et constante.`
};

MIROIR["21:50"] = {
  reference: "21:50",
  theme: ["Coran", "bénédiction", "mécréance"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Barakah"],
  mirrorVersion: `« Et ceci est un Livre béni que Nous avons fait descendre. » Le miroir me montre la bénédiction du Coran. « Wa hadha dhikrun mubarakun anzalnahu » — ceci est un rappel béni que Nous avons fait descendre. « Afa'antum lahu munkirun » — le niez-vous donc ? Le Coran est une bénédiction. Le miroir m'interroge : est-ce que je reconnais cette bénédiction ?`,
  reflection: `Le Coran est un Livre béni. Le reconnaître et l'honorer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hadha dhikrun mubarakun anzalnahu afa'antum lahu munkirun » — ceci est un rappel béni que Nous avons fait descendre. Le niez-vous donc ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la bénédiction du Coran ? Ou est-ce que je le nie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Nier le Coran est nier une immense bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est une bénédiction pour l'humanité entière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la bénédiction du Coran en bénéficie." }
  ],
  munajat: `Ya Rabb, je reconnais la bénédiction du Coran. Ne permets pas le déni. Bénis-moi par Ta Parole.`
};

MIROIR["21:51"] = {
  reference: "21:51",
  theme: ["Abraham", "guidance", "sagesse"],
  emotion: "Révérence, admiration",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Huda"],
  mirrorVersion: `« Et Nous avons donné auparavant à Abraham sa droiture. » Le miroir me montre la guidance d'Abraham. « Wa laqad atayna Ibrahimah rushdahu » — Nous avons donné auparavant à Abraham sa droiture. « Wa kunna bihi 'alimin » — et Nous le connaissions bien. Abraham a été guidé. Le miroir m'interroge : est-ce que je suis la guidance d'Abraham ?`,
  reflection: `Abraham a reçu la droiture. Le suivre dans son unicité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad atayna Ibrahimah rushdahu wa kunna bihi 'alimin » — Nous avons donné auparavant à Abraham sa droiture. Et Nous le connaissions bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la guidance d'Abraham ? Ou est-ce que je m'égare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droiture d'Abraham est un modèle pour tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Abraham est le père des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la droiture d'Abraham est guidé." }
  ],
  munajat: `Ya Rabb, guide-moi vers la droiture d'Abraham. Ne permets pas l'égarement. Fais que je suis son chemin.`
};

MIROIR["21:52"] = {
  reference: "21:52",
  theme: ["Abraham", "idoles", "questionnement"],
  emotion: "Discernement, courage",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Asnam"],
  mirrorVersion: `« Quand il dit à son père et à son peuple : que sont ces statues auxquelles vous vous attachez ? » Le miroir me montre le questionnement d'Abraham. « Idh qala li-abihi wa qawmihi ma hadhihi al-tamathilu allati antum laha 'akifun » — quand il dit à son père et à son peuple : que sont ces statues auxquelles vous vous attachez ? Abraham questionne l'idolâtrie. Le miroir m'interroge : est-ce que je questionne mes idoles ?`,
  reflection: `Abraham a questionné les idoles. Questionner nos propres idoles est essentiel pour la purification.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh qala li-abihi wa qawhihi ma hadhihi al-tamathilu allati antum laha 'akifun » — quand il dit à son père et à son peuple : que sont ces statues auxquelles vous vous attachez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je questionne mes idoles ? Ou est-ce que je les adore aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles ne sont que des statues sans pouvoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'idolâtrie a existé à toutes les époques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne ses idoles les détruit." }
  ],
  munajat: `Ya Rabb, aide-moi à questionner mes idoles. Ne permets pas l'aveuglement. Détruis mes fausses divinités.`
};

MIROIR["21:53"] = {
  reference: "21:53",
  theme: ["tradition", "idoles", "aveuglement"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Aba'", "Al-Asnam"],
  mirrorVersion: `« Ils dirent : nous avons trouvé nos ancêtres les adorant. » Le miroir me montre l'excuse de la tradition. « Qalu wajadna aba'ana laha 'abidin » — nous avons trouvé nos ancêtres les adorant. La tradition n'est pas une excuse. Le miroir m'interroge : est-ce que je suis aveuglément la tradition ?`,
  reflection: `Suivre la tradition aveuglément n'est pas une excuse. Questionner la tradition est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu wajadna aba'ana laha 'abidin » — nous avons trouvé nos ancêtres les adorant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis aveuglément la tradition ? Ou est-ce que je la questionne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tradition peut être fausse. La vérité est plus importante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute tradition doit être examinée à la lumière de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne la tradition trouve la vérité." }
  ],
  munajat: `Ya Rabb, aide-moi à questionner la tradition. Ne permets pas l'aveuglement. Guide-moi vers la vérité, même si elle contredit la tradition.`
};

MIROIR["21:54"] = {
  reference: "21:54",
  theme: ["épreuve", "clarté", "égarement"],
  emotion: "Lucidité, compassion",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Dalalah"],
  mirrorVersion: `« Il dit : vous et vos ancêtres êtes dans un égarement évident. » Le miroir me montre la vérité dure d'Abraham. « Qala laqad kuntum antum wa aba'ukum fi dalalin mubin » — vous et vos ancêtres êtes dans un égarement évident. La vérité peut blesser. Le miroir m'interroge : est-ce que j'accepte la vérité même quand elle blesse ?`,
  reflection: `La vérité peut blesser. L'accepter quand elle contredit nos croyances est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala laqad kuntum antum wa aba'ukum fi dalalin mubin » — vous et vos ancêtres êtes dans un égarement évident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la vérité même quand elle blesse ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité qui blesse est plus précieuse que le mensonge qui flatte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'égarement peut être évident pour l'observateur lucide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité qui blesse est vraiment libre." }
  ],
  munajat: `Ya Rabb, j'accepte la vérité même quand elle blesse. Ne permets pas le déni. Ouvre mes yeux à la vérité.`
};

MIROIR["21:55"] = {
  reference: "21:55",
  theme: ["sérieux", "moquerie", "jeu"],
  emotion: "Gravité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Jidd", "Al-Hazl"],
  mirrorVersion: `« Ils dirent : es-tu venu à nous en sérieux ou es-tu de ceux qui jouent ? » Le miroir me montre le doute des mécréants. « Qalu aji'tana bi-al-haqqi am anta mina al-la'ibin » — es-tu venu à nous en sérieux ou es-tu de ceux qui jouent ? Les mécréants doutent du sérieux du prophète. Le miroir m'interroge : est-ce que je prends la révélation au sérieux ?`,
  reflection: `La révélation est sérieuse. La traiter avec sérieux est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu aji'tana bi-al-haqqi am anta mina al-la'ibin » — es-tu venu à nous en sérieux ou es-tu de ceux qui jouent ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends la révélation au sérieux ? Ou est-ce que je la traite comme un jeu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation n'est pas un jeu. Elle est la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le sérieux d'Allah pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend la révélation au sérieux est guidé." }
  ],
  munajat: `Ya Rabb, je prends Ta révélation au sérieux. Ne permets pas le jeu. Fais que ma vie soit consacrée à Ta vérité.`
};

MIROIR["21:56"] = {
  reference: "21:56",
  theme: ["créateur", "unicité", "chemin"],
  emotion: "Certitude, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« Il dit : plutôt, votre Seigneur est le Seigneur des cieux et de la terre qui les a créés. » Le miroir me montre la proclamation d'Abraham. « Qala bal rabbukum rabbu al-samawati wa al-ardi alladhi fatarahun » — votre Seigneur est le Seigneur des cieux et de la terre qui les a créés. « Wa ana 'ala dhalikum mina al-shahidin » — et je suis de ceux qui témoignent. Abraham proclame la vérité. Le miroir m'interroge : est-ce que je témoigne de cette vérité ?`,
  reflection: `Allah est le Créateur des cieux et de la terre. Témoigner de cette vérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala bal rabbukum rabbu al-samawati wa al-ardi alladhi fatarahun wa ana 'ala dhalikum mina al-shahidin » — plutôt, votre Seigneur est le Seigneur des cieux et de la terre qui les a créés. Et je suis de ceux qui témoignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je témoigne de cette vérité ? Ou est-ce que je la cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage de la vérité est le devoir du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui témoigne de la vérité est honoré par Allah." }
  ],
  munajat: `Ya Rabb, je témoigne de Ta vérité. Ne permets pas le silence. Fais que je sois parmi les témoins.`
};

MIROIR["21:57"] = {
  reference: "21:57",
  theme: ["plan", "idoles", "destruction"],
  emotion: "Détermination, courage",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Asnam"],
  mirrorVersion: `« Et par Allah, je ruserai contre vos idoles après votre départ. » Le miroir me montre la détermination d'Abraham. « Wa t'allahi la akidanna asnamakum ba'da an tuwallu mudbirin » — par Allah, je ruserai contre vos idoles après votre départ. Abraham a un plan contre les idoles. Le miroir m'interroge : est-ce que j'ai un plan contre mes idoles ?`,
  reflection: `Abraham avait un plan contre les idoles. Avoir un plan contre nos idoles personnelles est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa t'allahi la akidanna asnamakum ba'da an tuwallu mudbirin » — par Allah, je ruserai contre vos idoles après votre départ." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai un plan contre mes idoles ? Ou est-ce que je les laisse tranquilles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles doivent être détruites, pas ignorées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La destruction des idoles libère le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui détruit ses idoles trouve la liberté." }
  ],
  munajat: `Ya Rabb, aide-moi à détruire mes idoles. Ne permets pas qu'elles restent. Libère mon cœur par leur destruction.`
};

MIROIR["21:58"] = {
  reference: "21:58",
  theme: ["destruction", "idoles", "exception"],
  emotion: "Détermination, sagesse",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Asnam"],
  mirrorVersion: `« Il les mit en pièces, excepté une grande idole parmi elles. » Le miroir me montre l'action d'Abraham. « Fa ja'alahum juthathan illa kabiran lahum la'allahum ilayhi yarji'un » — il les mit en pièces, excepté une grande idole parmi elles, peut-être qu'ils y retourneraient. Abraham laisse une idole pour la leçon. Le miroir m'interroge : est-ce que je détruis mes idoles ?`,
  reflection: `Abraham a détruit les idoles. Détruire nos idoles personnelles est une action nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ja'alahum juthathan illa kabiran lahum la'allahum ilayhi yarji'un » — il les mit en pièces, excepté une grande idole parmi elles, peut-être qu'ils y retourneraient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je détruis mes idoles ? Ou est-ce que je les épargne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des idoles révèle leur impuissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les idoles brisées ne peuvent pas se défendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui détruit ses idoles découvre leur nullité." }
  ],
  munajat: `Ya Rabb, aide-moi à détruire mes idoles. Ne permets pas qu'elles restent entières. Montre-moi leur nullité.`
};

MIROIR["21:59"] = {
  reference: "21:59",
  theme: ["questionnement", "coupable", "recherche"],
  emotion: "Confusion, recherche",
  difficulty: "débutant",
  relatedNames: ["Al-Zalimun", "Al-Bahth"],
  mirrorVersion: `« Ils dirent : qui a fait cela à nos divinités ? Il est certes parmi les injustes. » Le miroir me montre la réaction des idolâtres. « Qalu man fa'ala hadha bi-alihatina innahu mina al-zalimin » — qui a fait cela à nos divinités ? Il est certes parmi les injustes. Les idolâtres cherchent le coupable. Le miroir m'interroge : est-ce que je cherche la vérité ou le coupable ?`,
  reflection: `Les idolâtres cherchent le coupable, pas la vérité. Chercher la vérité est plus important.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu man fa'ala hadha bi-alihatina innahu mina al-zalimin » — qui a fait cela à nos divinités ? Il est certes parmi les injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la vérité ? Ou est-ce que je cherche le coupable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chercher le coupable évite de questionner les idoles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité dérange ceux qui protègent leurs idoles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la vérité trouve la liberté." }
  ],
  munajat: `Ya Rabb, aide-moi à chercher la vérité. Ne permets pas la recherche du coupable. Ouvre mes yeux à Ta réalité.`
};

MIROIR["19:81"] = {
  reference: "19:81",
  theme: ["divinités", "rapprochement", "illusion"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Haqq"],
  mirrorVersion: `« Ils ont pris des divinités en dehors d'Allah pour se rapprocher. » Le miroir me montre l'illusion du rapprochement. On prend des intermédiaires pour se rapprocher d'Allah. Mais ces intermédiaires sont inutiles. Le miroir m'interroge : quels intermédiaires ai-je pris ?`,
  reflection: `Le rapprochement d'Allah est direct. Les intermédiaires sont des illusions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ittakhadhu min duni Allahi alihatan li-yakunu lahum 'izzan » — Ils ont pris des divinités en dehors d'Allah pour se rapprocher." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels intermédiaires ai-je pris ? Sont-ils des voies ou des obstacles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rapprochement par autre qu'Allah est un éloignement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est proche — pas besoin d'intermédiaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le rapprochement directement Le trouve." }
  ],
  munajat: `Ya Wali, je me rapproche de Toi directement. Pas d'intermédiaire entre Toi et moi. Fais que je T'atteigne sans détour.`
};

MIROIR["19:82"] = {
  reference: "19:82",
  theme: ["désaveu", "opposition", "jugement"],
  emotion: "Réalité, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Kafir", "Al-Hasim"],
  mirrorVersion: `« Ils renieront leur adoration et seront contre eux des adversaires. » Le miroir me montre le désaveu final. Les divinités renieront leurs adorateurs. L'opposition sera mutuelle. Le miroir m'interroge : qui ou quoi vais-je adorer sincèrement ?`,
  reflection: `Les fausses divinités renient leurs adorateurs. Seul Allah reste fidèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla sayakfuruna bi-'ibadatihim wa yakununa 'alayhim diddan » — Non ! Ils renieront leur adoration et seront contre eux des adversaires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui ou quoi vais-je adorer sincèrement ? Mon adoration sera-t-elle reniée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah n'est jamais reniée — Lui reste fidèle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui est adoré en dehors d'Allah renie son adorateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul n'a rien à craindre du reniement." }
  ],
  munajat: `Ya Haqq, je T'adore Toi seul. Tu ne me renieras pas. Fais que mon adoration soit pure et que Tu l'acceptes.`
};

MIROIR["19:83"] = {
  reference: "19:83",
  theme: ["démons", "tentation", "adversaires"],
  emotion: "Vigilance, prière",
  difficulty: "débutant",
  relatedNames: ["Ash-Shayatin", "Al-Hafiz"],
  mirrorVersion: `« N'as-tu pas vu que Nous avons envoyé les démons contre les mécréants ? » Le miroir me montre l'action des démons. Ils sont envoyés contre les mécréants. La tentation est organisée. Le miroir m'interroge : comment me protège-je des démons ?`,
  reflection: `Les démons sont actifs. La protection est dans la foi et le dhikr.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A lam tara anna arsalna al-shayatina 'ala al-kafirina » — N'as-tu pas vu que Nous avons envoyé les démons contre les mécréants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment me protège-je des démons ? Ma foi est-elle une protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les démons n'ont de pouvoir que sur ceux qui s'éloignent d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tentation est universelle — la protection est dans le rapprochement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rapproche d'Allah est protégé des démons." }
  ],
  munajat: `Ya Hafiz, protège-moi des démons. Ma foi est ma forteresse. Fais que je me rapproche de Toi pour être à l'abri.`
};

MIROIR["19:84"] = {
  reference: "19:84",
  theme: ["patience", "compte", "journaux"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Hasib"],
  mirrorVersion: `« Ne te hâte pas contre eux. Nous tenons un compte précis. » Le miroir me montre la patience face aux mécréants. Pas de hâte — tout est compté. La justice viendra en son temps. Le miroir m'interroge : est-ce que je me hâte dans le jugement ?`,
  reflection: `La précision d'Allah dans le compte garantit la justice. La hâte humaine est inutile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fala ta'jal 'alayhim innama na'uddu lahum 'addan » — Ne te hâte pas contre eux. Nous tenons un compte précis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me hâte dans le jugement ? Ma patience est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La hâte humaine ne précipite pas la justice divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est compté — rien n'échappe au compte d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente voit la justice se réaliser." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience. Je ne me hâte pas. Ton compte est précis et Ta justice est certaine. Fais que je te fasse confiance dans le timing.`
};

MIROIR["19:85"] = {
  reference: "19:85",
  theme: ["rassemblement", "piété", "jour"],
  emotion: "Anticipation, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Muttaqin"],
  mirrorVersion: `« Le jour où Nous rassemblerons les pieux. » Le miroir me montre le rassemblement des pieux. Un jour spécial pour un groupe spécial. Les pieux sont distingués. Le miroir m'interroge : serai-je parmi les pieux rassemblés ?`,
  reflection: `Le rassemblement des pieux est un honneur. La piété est la condition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma nahshuru al-muttaqina » — Le jour où Nous rassemblerons les pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Serai-je parmi les pieux rassemblés ? Ma piété est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement des pieux est un honneur — le rassemblement des autres est un effroi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La piété distingue dans ce monde et dans l'autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la piété est rassemblé avec les pieux." }
  ],
  munajat: `Ya Jami', rassemble-moi avec les pieux. Ma piété doit être réelle. Fais que je sois de ceux qui sont honorés par le rassemblement.`
};

MIROIR["19:86"] = {
  reference: "19:86",
  theme: ["poussée", "coupables", "enfer"],
  emotion: "Effroi, motivation",
  difficulty: "débutant",
  relatedNames: ["An-Natiq", "Al-Mujrimun"],
  mirrorVersion: `« Et conduirons les coupables à l'Enfer en troupeaux. » Le miroir me montre le sort des coupables. Ils seront poussés comme des troupeaux. L'humiliation précède le châtiment. Le miroir m'interroge : comment éviter ce sort ?`,
  reflection: `Le sort des coupables est l'humiliation puis le châtiment. La piété évite les deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nasqu al-mujrimina ila jahannama wirdan » — Et conduirons les coupables à l'Enfer en troupeaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment éviter ce sort ? Mon cœur est-il innocent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation dans ce monde peut éviter l'humiliation dans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin des coupables mène à l'Enfer — le chemin des pieux au Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la culpabilité évite le sort des coupables." }
  ],
  munajat: `Ya Rabb, préserve-moi du sort des coupables. Je ne veux pas être poussé comme un troupeau. Purifie mon cœur de toute culpabilité.`
};

MIROIR["19:87"] = {
  reference: "19:87",
  theme: ["intercession", "alliance", "permission"],
  emotion: "Espérance, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shafi'", "Al-Ahd"],
  mirrorVersion: `« Ils ne posséderont pas le pouvoir d'intercession, sauf ceux qui ont pris une alliance avec le Tout-Miséricordieux. » Le miroir me montre la condition de l'intercession. L'intercession n'est pas automatique. Elle nécessite une alliance avec Allah. Le miroir m'interroge : ai-je pris cette alliance ?`,
  reflection: `L'intercession est un privilège. L'alliance avec Allah est la condition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yamlikuna al-shafa'ata illa man ittakhadha 'inda al-rahmani 'ahdan » — Ils ne posséderont pas le pouvoir d'intercession, sauf ceux qui ont pris une alliance avec le Tout-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je pris cette alliance ? Mon engagement envers Allah est-il réel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession n'est pas un droit — c'est un privilège conditionnel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance avec Allah ouvre des portes fermées aux autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une alliance avec Allah reçoit Ses faveurs." }
  ],
  munajat: `Ya Rahman, je prends une alliance avec Toi. Mon engagement est sincère. Accorde-moi le privilège de l'intercession par Ta grâce.`
};

MIROIR["19:88"] = {
  reference: "19:88",
  theme: ["fils", "allégation", "mécréance"],
  emotion: "Réprobation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Walad", "Al-Haqq"],
  mirrorVersion: `« Ils ont dit : Le Tout-Miséricordieux S'est attribué un fils. » Le miroir me montre l'allégation grave. Attribuer un fils à Allah est une mécréance majeure. Cette parole est une invention. Le miroir m'interroge : est-ce que je préserve la pureté de ma croyance en Allah ?`,
  reflection: `La croyance pure en Allah exclut tout associé, tout fils, toute ressemblance avec la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu ittakhadha al-rahmanu waladan » — Ils ont dit : Le Tout-Miséricordieux S'est attribué un fils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la pureté de ma croyance ? Allah est-Il unique dans mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allégation d'un fils pour Allah est une offense à Sa grandeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est au-dessus de la création — aucune comparaison n'est valide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah refuse toute allégation fausse." }
  ],
  munajat: `Ya Rahman, Tu n'as pas de fils. Je préserve la pureté de ma croyance en Toi. Tu es Unique, sans égal, sans associé.`
};

MIROIR["19:89"] = {
  reference: "19:89",
  theme: ["invention", "grave", "mensonge"],
  emotion: "Gravité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Iftira'", "As-Sidq"],
  mirrorVersion: `« Vous avancez une chose gravissime ! » Le miroir me montre la gravité de l'allégation. Ce n'est pas une petite erreur — c'est une chose gravissime. Les mots ont du poids. Le miroir m'interroge : quels mots graves prononcé-je ?`,
  reflection: `Les paroles ont des conséquences. L'erreur sur Allah est la plus grave.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad ji'tum shay'an iddan » — Vous avancez une chose gravissime !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels mots graves prononcé-je ? Mes paroles sur Allah sont-elles justes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gravité de la parole sur Allah demande une prudence extrême." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole sur Allah engage l'éternité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pèse ses paroles sur Allah évite l'erreur grave." }
  ],
  munajat: `Ya Rabb, fais que mes paroles sur Toi soient justes. Je ne veux pas avancer de chose gravissime. Guide ma langue dans la vérité.`
};

MIROIR["19:90"] = {
  reference: "19:90",
  theme: ["rupture", "ciel", "terre"],
  emotion: "Awe, tremblement",
  difficulty: "débutant",
  relatedNames: ["Al-Fatih", "Al-Munfatiq"],
  mirrorVersion: `« Peu s'en faut que les cieux ne se fendent. » Le miroir me montre l'impact cosmique de l'allégation. Les cieux sont prêts à se fendre. La terre à se rompre. Les montagnes à s'écrouler. Le miroir m'interroge : est-ce que je réalise la gravité de l'offense à Allah ?`,
  reflection: `L'univers entier réagit à l'offense envers Allah. La création tremble.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Takadu al-samawatu yatafattarna minhu » — Peu s'en faut que les cieux ne se fendent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la gravité de l'offense à Allah ? Mon cœur tremble-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création entière est sensible à l'honneur du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux, la terre, les montagnes — tous réagissent à l'offense." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte Allah respecte Sa création." }
  ],
  munajat: `Ya Rabb, je respecte Ton honneur. Fais que mes paroles et mes actes ne L'offensent jamais. La création tremble — fais que mon cœur tremble aussi de respect.`
};

MIROIR["19:91"] = {
  reference: "19:91",
  theme: ["fils", "attribution", "création"],
  emotion: "Réprobation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Mansub", "Al-Khalq"],
  mirrorVersion: `« Parce qu'ils ont attribué un fils au Tout-Miséricordieux. » Le miroir me montre la cause de la rupture cosmique. L'attribution d'un fils est la cause. Une offense qui ébranle l'univers. Le miroir m'interroge : quelles attributions fausses fais-je ?`,
  reflection: `L'attribution fausse à Allah est la plus grande erreur. Elle ébranle tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An dahu al-rahmanu waladan » — Parce qu'ils ont attribué un fils au Tout-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles attributions fausses fais-je ? Mon concept d'Allah est-il pur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attribution correcte à Allah est la base de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers réagit à la vérité et au mensonge sur Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attribue correctement à Allah Le connaît." }
  ],
  munajat: `Ya Rahman, je T'attribue ce qui T'appartient. Tu n'as pas de fils, pas d'associé. Fais que mon concept de Toi soit pur et véridique.`
};

MIROIR["19:92"] = {
  reference: "19:92",
  theme: ["fils", "convenance", "indignité"],
  emotion: "Vérité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Walad", "Al-Ma'rifah"],
  mirrorVersion: `« Il ne convient pas au Tout-Miséricordieux de Se donner un fils. » Le miroir me montre l'inconvenance du fils pour Allah. Allah n'a pas besoin de progéniture. La divinité transcende la filiation. Le miroir m'interroge : est-ce que je conçois Allah comme transcendant ?`,
  reflection: `Allah est au-dessus des besoins humains. La filiation est une nécessité créée, pas divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yanbaghi lil-rahmani an yattakhidha waladan » — Il ne convient pas au Tout-Miséricordieux de Se donner un fils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je conçois Allah comme transcendant ? Mon concept est-il pur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transcendance d'Allah exclut tout besoin de fils." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah crée par Sa volonté — pas par besoin de progéniture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la transcendance d'Allah refuse la notion de fils." }
  ],
  munajat: `Ya Rahman, Tu es transcendant. Je Te conçois comme Tu es. Pas de fils, pas de besoin — seulement la grandeur absolue.`
};

MIROIR["19:93"] = {
  reference: "19:93",
  theme: ["serviteur", "création", "relation"],
  emotion: "Humilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Abd", "Al-Khalq"],
  mirrorVersion: `« Il n'y a personne dans les cieux et sur terre qui ne vienne au Tout-Miséricordieux comme serviteur. » Le miroir me montre la relation universelle. Tous sont serviteurs. Les cieux, la terre, tous viennent comme serviteurs. Le miroir m'interroge : est-ce que j'accepte ma servitude ?`,
  reflection: `La servitude est la relation universelle. Refuser la servitude, c'est refuser la réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In kullu man fi al-samawati wa al-ardi illa ati al-rahmani 'abdan » — Il n'y a personne dans les cieux et sur terre qui ne vienne au Tout-Miséricordieux comme serviteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma servitude ? Ou est-ce que je prétends à autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La servitude est l'honneur — pas l'humiliation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est serviteur — le refus est une exception humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa servitude trouve sa vraie grandeur." }
  ],
  munajat: `Ya Rahman, je viens à Toi comme serviteur. J'accepte ma relation avec Toi. Fais que ma servitude soit volontaire et joyeuse.`
};

MIROIR["19:94"] = {
  reference: "19:94",
  theme: ["comptage", "connaissance", "nombre"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Adad", "Al-'Alim"],
  mirrorVersion: `« Il les a comptés et bien dénombrés. » Le miroir me montre la connaissance précise d'Allah. Chaque être est compté. Le nombre est exact. Rien n'échappe à Sa connaissance. Le miroir m'interroge : est-ce que je réalise que je suis compté ?`,
  reflection: `La connaissance d'Allah est précise et complète. Chacun est unique et compté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad ahsahum wa 'addahum 'addan » — Il les a comptés et bien dénombrés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je suis compté ? Ma place est-elle connue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être compté par Allah signifie être connu personnellement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être a un numéro dans le registre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est compté se sent important." }
  ],
  munajat: `Ya 'Adad, Tu m'as compté. Je suis connu de Toi. Fais que je vive en sachant que ma place est établie dans Ton registre.`
};

MIROIR["19:95"] = {
  reference: "19:95",
  theme: ["comparution", "solitude", "jugement"],
  emotion: "Sérieux, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Warid", "Al-Fard"],
  mirrorVersion: `« Et chacun viendra à Lui seul, le jour de la Résurrection. » Le miroir me montre la comparution solitaire. Chacun vient seul. Pas de groupe, pas de protecteur — seul. Le miroir m'interroge : suis-je prêt pour cette rencontre solo ?`,
  reflection: `La comparution est individuelle. Les liens de ce monde se brisent à ce moment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kulluhum atihi yawma al-qiyamati fardan » — Et chacun viendra à Lui seul, le jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour cette rencontre solo ? Qu'aurai-je à présenter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La solitude du jugement est une vérité à méditer maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme vient seule — les relations du monde ne comptent plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa rencontre solo la traverse en sécurité." }
  ],
  munajat: `Ya Rabb, je viendrai à Toi seul. Prépare-moi pour cette rencontre. Fais que je sois prêt, avec mes œuvres, à Te rencontrer en solo.`
};

MIROIR["19:97"] = {
  reference: "19:97",
  theme: ["facilitation", "annonce", "pierre"],
  emotion: "Espérance, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Muyassir", "Al-Bashir"],
  mirrorVersion: `« Nous avons facilité ce Coran pour le rappel. » Le miroir me montre la facilitation du Coran. Allah l'a facilité pour le rappel. Pas pour la difficulté — pour la facilité. Le miroir m'interroge : est-ce que je trouve le Coran facile ou difficile ?`,
  reflection: `Le Coran est facilité par Allah. La difficulté vient de nous, pas du Texte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innama yassarnahu bi-lisanika » — Nous l'avons facilité avec ta langue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je trouve le Coran facile ou difficile ? Mon approche est-elle correcte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du Coran est un don — la difficulté est une résistance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est accessible à tous — le rappel est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui approche le Coran avec foi le trouve facile." }
  ],
  munajat: `Ya Muyassir, Tu as facilité le Coran. Fais que je l'approche avec la bonne intention. Ouvre-moi ses sens et rends-le facile pour moi.`
};

MIROIR["19:98"] = {
  reference: "19:98",
  theme: ["destruction", "générations", "succession"],
  emotion: "Rappel, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Muhlik", "Al-Khalaf"],
  mirrorVersion: `« Combien de générations avons-Nous fait périr avant eux ! » Le miroir me montre la succession des destructions. Les générations passées ont péri. Nous sommes les successeurs temporaires. Le miroir m'interroge : qu'est-ce qui me distingue des générations passées ?`,
  reflection: `L'histoire est un cycle de générations. Nous ne sommes pas différents de ceux qui ont péri.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kam ahlakna qablahum min qarnin » — Combien de générations avons-Nous fait périr avant eux !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me distingue des générations passées ? Ma foi ? Ma pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des passés est un avertissement pour les présents." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un maître — les leçons sont là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Muhlik, les générations ont péri. Enseigne-moi par leur histoire. Ne me laisse pas m'installer dans l'insouciance. Fais que je sois parmi ceux qui se souviennent.`
};

MIROIR["21:60"] = {
  reference: "21:60",
  theme: ["témoin", "accusation", "Abraham"],
  emotion: "Injustice, patience",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Ash-Shahid"],
  mirrorVersion: `« Ils dirent : nous avons entendu un jeune homme les médire, appelé Abraham. » Le miroir me montre l'accusation contre Abraham. « Qalu sami'na fatan yadhkuruhum yuqalu lahu Ibrahim » — nous avons entendu un jeune homme les médire, appelé Abraham. Abraham est identifié. Le miroir m'interroge : est-ce que je suis prêt à être identifié pour la vérité ?`,
  reflection: `Abraham a été identifié comme celui qui dérange. Être identifié pour la vérité est un honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu sami'na fatan yadhkuruhum yuqalu lahu Ibrahim » — nous avons entendu un jeune homme les médire, appelé Abraham." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à être identifié pour la vérité ? Ou est-ce que je me cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être identifié pour la vérité est un honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous été identifiés et persécutés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est identifié pour la vérité est protégé par Allah." }
  ],
  munajat: `Ya Rabb, je suis prêt à être identifié pour Ta vérité. Ne permets pas la lâcheté. Honore-moi par le témoignage.`
};

MIROIR["21:61"] = {
  reference: "21:61",
  theme: ["assemblée", "témoignage", "jugement"],
  emotion: "Injustice, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Majlis", "Al-Qada'"],
  mirrorVersion: `« Ils dirent : amenez-le devant les yeux des gens, afin qu'ils témoignent. » Le miroir me montre l'assemblée publique. « Qalu fa'tu bihi 'ala a'iyuni al-nasi la'allahum yashhadun » — amenez-le devant les yeux des gens, afin qu'ils témoignent. Le public est convoqué. Le miroir m'interroge : est-ce que je tiens bon devant le public ?`,
  reflection: `Le public est convoqué pour juger. Tenir bon devant l'opinion publique est essentiel pour la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu fa'tu bihi 'ala a'iyuni al-nasi la'allahum yashhadun » — amenez-le devant les yeux des gens, afin qu'ils témoignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens bon devant le public ? Ou est-ce que je plie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'opinion publique peut être injuste. La vérité reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les assemblées publiques ont souvent condamné les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient bon devant le public est justifié par Allah." }
  ],
  munajat: `Ya Rabb, aide-moi à tenir bon devant le public. Ne permets pas la faiblesse. Justifie-moi par Ta vérité.`
};

MIROIR["21:62"] = {
  reference: "21:62",
  theme: ["question", "responsabilité", "Abraham"],
  emotion: "Courage, calme",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Mas'uliyyah"],
  mirrorVersion: `« Ils dirent : est-ce toi qui as fait cela à nos divinités, Abraham ? » Le miroir me montre la question directe. « Qalu a-anta fa'alta hadha bi-alihatina ya Ibrahim » — est-ce toi qui as fait cela à nos divinités, Abraham ? La question est directe. Le miroir m'interroge : est-ce que j'assume mes actes pour la vérité ?`,
  reflection: `La question directe demande une réponse directe. Assumer ses actes pour la vérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu a-anta fa'alta hadha bi-alihatina ya Ibrahim » — est-ce toi qui as fait cela à nos divinités, Abraham ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'assume mes actes pour la vérité ? Ou est-ce que je les nie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Assumer ses actes est la force du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous assumé leurs actes devant les tyrans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume ses actes pour la vérité est victorieux." }
  ],
  munajat: `Ya Rabb, j'assume mes actes pour Ta vérité. Ne permets pas le déni. Fais que je sois courageux dans mon témoignage.`
};

MIROIR["21:63"] = {
  reference: "21:63",
  theme: ["ironie", "idoles", "pouvoir"],
  emotion: "Sagesse, ironie",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Asnam"],
  mirrorVersion: `« Il dit : c'est la grande idole qui a fait cela. Interrogez-les donc, si elles peuvent parler. » Le miroir me montre la réponse ironique d'Abraham. « Qala bal fa'alahu kabiruhum hadha fas'aluhum in kanu yantiqun » — c'est la grande idole qui a fait cela. Interrogez-les donc, si elles peuvent parler. L'ironie révèle l'absurdité. Le miroir m'interroge : est-ce que je comprends l'absurdité de l'idolâtrie ?`,
  reflection: `L'ironie d'Abraham révèle l'absurdité. Les idoles ne peuvent pas parler ni agir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala bal fa'alahu kabiruhum hadha fas'aluhum in kanu yantiqun » — c'est la grande idole qui a fait cela. Interrogez-les donc, si elles peuvent parler." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends l'absurdité de l'idolâtrie ? Ou est-ce que je reste aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles ne peuvent ni parler ni agir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ironie est une arme contre la stupidité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'absurdité des idoles les abandonne." }
  ],
  munajat: `Ya Rabb, aide-moi à comprendre l'absurdité des idoles. Ne permets pas l'aveuglement. Ouvre mes yeux à leur nullité.`
};

MIROIR["21:64"] = {
  reference: "21:64",
  theme: ["réflexion", "retour", "vérité"],
  emotion: "Réalisation, honte",
  difficulty: "débutant",
  relatedNames: ["Al-Fikr", "Al-Haqq"],
  mirrorVersion: `« Ils retournèrent à eux-mêmes et dirent : c'est vous qui êtes les injustes. » Le miroir me montre le retour à la conscience. « Faraja'u ila anfusihim fa qalu innakum antumu al-zalimun » — ils retournèrent à eux-mêmes et dirent : c'est vous qui êtes les injustes. La vérité frappe. Le miroir m'interroge : est-ce que je reviens à moi-même ?`,
  reflection: `Revenir à soi-même est essentiel pour reconnaître son injustice. La conscience peut se réveiller.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faraja'u ila anfusihim fa qalu innakum antumu al-zalimun » — ils retournèrent à eux-mêmes et dirent : c'est vous qui êtes les injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reviens à moi-même ? Ou est-ce que je fuis la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité oblige à revenir à soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La conscience peut se réveiller face à l'évidence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient à lui-même reconnaît son injustice." }
  ],
  munajat: `Ya Rabb, aide-moi à revenir à moi-même. Ne permets pas la fuite. Fais que je reconnaisse mon injustice.`
};

MIROIR["21:65"] = {
  reference: "21:65",
  theme: ["retour", "orgueil", "aveuglement"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Inkir", "Al-Kibr"],
  mirrorVersion: `« Puis ils revinrent à leur erreur et dirent : tu sais bien que celles-ci ne parlent pas. » Le miroir me montre le retour à l'aveuglement. « Thumma nukisu 'ala ru'usihim » — puis ils revinrent à leur erreur. « Laqad ta'lamu ma hawla'i yantiqun » — tu sais bien que celles-ci ne parlent pas. L'aveuglement reprend le dessus. Le miroir m'interroge : est-ce que je retourne à mon erreur ?`,
  reflection: `La conscience peut se réveiller puis s'endormir. Rester éveillé est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nukisu 'ala ru'usihim laqad ta'lamu ma hawla'i yantiqun » — puis ils revinrent à leur erreur et dirent : tu sais bien que celles-ci ne parlent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je retourne à mon erreur ? Ou est-ce que je reste éveillé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour à l'erreur est la défaite de la conscience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aveuglement peut reprendre le dessus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste éveillé ne retourne pas à son erreur." }
  ],
  munajat: `Ya Rabb, garde-moi éveillé. Ne permets pas le retour à l'erreur. Maintiens ma conscience alerte.`
};

MIROIR["21:66"] = {
  reference: "21:66",
  theme: ["question", "raison", "divinité"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-'Aql", "Al-Ilah"],
  mirrorVersion: `« Il dit : adorez-vous donc en dehors d'Allah ce qui ne vous profite ni ne vous nuit ? » Le miroir me montre la question logique. « Qala a-ta'buduna min duni Allahi ma la yanfa'ukum shay'an wa la yadurrukum » — adorez-vous donc en dehors d'Allah ce qui ne vous profite ni ne vous nuit ? La logique est imparable. Le miroir m'interroge : est-ce que j'adore ce qui ne peut ni m'aider ni me nuire ?`,
  reflection: `Adorer ce qui ne peut ni aider ni nuire est absurde. La logique mène à Allah seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala a-ta'buduna min duni Allahi ma la yanfa'ukum shay'an wa la yadurrukum » — adorez-vous donc en dehors d'Allah ce qui ne vous profite ni ne vous nuit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore ce qui ne peut m'aider ? Ou est-ce que j'adore Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Adorer l'inutile est l'absurdité de l'idolâtrie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah peut aider et nuire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la logique adore Allah seul." }
  ],
  munajat: `Ya Rabb, je T'adore Toi seul. Ne permets pas l'absurdité. Guide-moi vers l'adoration exclusive.`
};

MIROIR["21:67"] = {
  reference: "21:67",
  theme: ["honte", "indignation", "Abraham"],
  emotion: "Indignation, honte",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Fahisha"],
  mirrorVersion: `« Fi ! Fi de vous et de ce que vous adorez en dehors d'Allah ! » Le miroir me montre l'indignation d'Abraham. « Uffin lakum wa lima ta'buduna min duni Allahi » — fi ! Fi de vous et de ce que vous adorez en dehors d'Allah ! L'indignation est forte. Le miroir m'interroge : est-ce que je suis indigné par l'idolâtrie ?`,
  reflection: `L'indignation d'Abraham montre son rejet total de l'idolâtrie. Être indigné par le faux est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uffin lakum wa lima ta'buduna min duni Allahi » — fi ! Fi de vous et de ce que vous adorez en dehors d'Allah !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis indigné par l'idolâtrie ? Ou est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'indignation contre le faux est la marque du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vrai croyant rejette le faux avec force." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est indigné par le faux est proche de la vérité." }
  ],
  munajat: `Ya Rabb, fais que je sois indigné par le faux. Ne permets pas l'acceptation. Purifie mon cœur du compromis.`
};

MIROIR["21:68"] = {
  reference: "21:68",
  theme: ["feu", "menace", "Abraham"],
  emotion: "Injustice, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Ibrahim"],
  mirrorVersion: `« Ils dirent : brûlez-le et aidez vos divinités, si vous voulez faire quelque chose. » Le miroir me montre la menace extrême. « Qalu harruhu wa ansuru alihatakum in kuntum fa'ilin » — brûlez-le et aidez vos divinités, si vous voulez faire quelque chose. Le feu est la menace. Le miroir m'interroge : est-ce que je crains le feu des hommes ?`,
  reflection: `Le feu des hommes ne peut rien contre la foi. Allah protège ceux qui défendent Sa vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu harruhu wa ansuru alihatakum in kuntum fa'ilin » — brûlez-le et aidez vos divinités, si vous voulez faire quelque chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le feu des hommes ? Ou est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu des hommes ne peut brûler que le corps. La foi est inattaquable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu est devenu frais pour Abraham." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah est protégé du feu." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ta protection. Ne permets pas la peur du feu. Protège-moi comme Tu as protégé Abraham.`
};

MIROIR["21:69"] = {
  reference: "21:69",
  theme: ["feu", "fraîcheur", "miracle"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Barakah"],
  mirrorVersion: `« Nous dîmes : ô feu, sois fraîcheur et sécurité sur Abraham ! » Le miroir me montre le miracle. « Qulna ya naru kuni bardan wa salaman 'ala Ibrahim » — ô feu, sois fraîcheur et sécurité sur Abraham ! Le feu obéit à Allah. Le miroir m'interroge : est-ce que je crois au miracle ?`,
  reflection: `Le feu est devenu frais pour Abraham. Les miracles d'Allah sont possibles pour ceux qui croient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulna ya naru kuni bardan wa salaman 'ala Ibrahim » — ô feu, sois fraîcheur et sécurité sur Abraham !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au miracle ? Ou est-ce que je le doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu qui devient frais est le miracle d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création obéit au commandement d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au miracle le vit." }
  ],
  munajat: `Ya Rabb, je crois à Ton miracle. Ne permets pas le doute. Transforme mes épreuves en fraîcheur par Ta puissance.`
};

MIROIR["21:70"] = {
  reference: "21:70",
  theme: ["complot", "échec", "Abraham"],
  emotion: "Confiance, victoire",
  difficulty: "débutant",
  relatedNames: ["Al-Kayd", "Al-Nusrat"],
  mirrorVersion: `« Ils voulurent ruser contre lui, mais ce sont eux que Nous rendîmes les plus grands perdants. » Le miroir me montre l'échec du complot. « Wa aradu bihi kaydan fa ja'alnahumu al-akhsarina » — ils voulurent ruser contre lui, mais ce sont eux que Nous rendîmes les plus grands perdants. Le complot échoue. Le miroir m'interroge : est-ce que je crains les complots ?`,
  reflection: `Les complots des mécréants échouent contre ceux qu'Allah protège. Faire confiance à Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aradu bihi kaydan fa ja'alnahumu al-akhsarina » — ils voulurent ruser contre lui, mais ce sont eux que Nous rendîmes les plus grands perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les complots ? Ou est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les complots contre les croyants se retournent contre leurs auteurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le meilleur des stratèges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah est protégé des complots." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ta protection. Ne permets pas la peur des complots. Protège-moi de tout mal.`
};

MIROIR["21:71"] = {
  reference: "21:71",
  theme: ["sauvetage", "bénédiction", "terre"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Ard"],
  mirrorVersion: `« Et Nous le sauvâmes ainsi que Lot vers une terre que Nous avons bénie pour les mondes. » Le miroir me montre le sauvetage. « Wa najjaynahu wa Lutan ila al-ardi allati barakna fiha lil-'alamin » — Nous le sauvâmes ainsi que Lot vers une terre que Nous avons bénie pour les mondes. Le sauvetage vient avec la bénédiction. Le miroir m'interroge : est-ce que j'accepte le sauvetage d'Allah ?`,
  reflection: `Allah sauve et bénit. Accepter Son sauvetage et Sa bénédiction est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa najjaynahu wa Lutan ila al-ardi allati barakna fiha lil-'alamin » — Nous le sauvâmes ainsi que Lot vers une terre que Nous avons bénie pour les mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le sauvetage d'Allah ? Ou est-ce que je refuse Sa guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sauvetage d'Allah vient avec la bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre bénie accueille les sauvés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le sauvetage d'Allah est béni." }
  ],
  munajat: `Ya Rabb, j'accepte Ton sauvetage. Ne permets pas le refus. Sauve-moi et bénis ma vie.`
};

MIROIR["21:72"] = {
  reference: "21:72",
  theme: ["postérité", "Isaac", "Jacob"],
  emotion: "Gratitude, bénédiction",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Ishaq", "Ya'qub"],
  mirrorVersion: `« Et Nous lui donnâmes Isaac et Jacob comme cadeau supplémentaire. » Le miroir me montre la bénédiction de la descendance. « Wa wahabna lahu Ishaqa wa Ya'quba nafilatan » — Nous lui donnâmes Isaac et Jacob comme cadeau supplémentaire. La descendance est une bénédiction. Le miroir m'interroge : est-ce que je suis reconnaissant pour mes bénédictions ?`,
  reflection: `La descendance est un cadeau d'Allah. Être reconnaissant pour les bénédictions est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabna lahu Ishaqa wa Ya'quba nafilatan » — Nous lui donnâmes Isaac et Jacob comme cadeau supplémentaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour mes bénédictions ? Ou est-ce que je les prends pour acquises ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bénédictions sont des cadeaux, pas des droits." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La descendance des prophètes est bénie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour les bénédictions en reçoit plus." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour Tes bénédictions. Ne permets pas l'ingratitude. Multiplie Tes faveurs sur moi.`
};

MIROIR["21:73"] = {
  reference: "21:73",
  theme: ["guidance", "prophètes", "prière"],
  emotion: "Révérence, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-A'imah", "As-Salah"],
  mirrorVersion: `« Et Nous en fîmes des dirigeants qui guident par Notre ordre. » Le miroir me montre la mission des prophètes. « Wa ja'alnahum a'immatan yahduna bi-amrina » — Nous en fîmes des dirigeants qui guident par Notre ordre. « Wa awhayna ilayhim fi'l al-khayrati » — et Nous leur révélâmes de faire le bien. Les prophètes guident et prient. Le miroir m'interroge : est-ce que je suis leur guidance ?`,
  reflection: `Les prophètes sont des guides et des modèles. Les suivre dans la prière et les bonnes actions est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alnahum a'immatan yahduna bi-amrina wa awhayna ilayhim fi'l al-khayrati » — Nous en fîmes des dirigeants qui guident par Notre ordre. Et Nous leur révélâmes de faire le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis leur guidance ? Ou est-ce que je m'égare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre les prophètes dans la prière est la voie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont les modèles pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance des prophètes est guidé." }
  ],
  munajat: `Ya Rabb, je suis la guidance des prophètes. Ne permets pas l'égarement. Guide-moi par leur exemple.`
};

MIROIR["21:74"] = {
  reference: "21:74",
  theme: ["Lot", "savoir", "jugement"],
  emotion: "Sagesse, discernement",
  difficulty: "débutant",
  relatedNames: ["Lut", "Al-'Ilm", "Al-Hukm"],
  mirrorVersion: `« Et à Lot, Nous donnâmes le jugement et le savoir. » Le miroir me montre la sagesse de Lot. « Wa Lutan ataynahu hukman wa 'ilman » — et à Lot, Nous donnâmes le jugement et le savoir. La sagesse accompagne la prophétie. Le miroir m'interroge : est-ce que je cherche la sagesse et le savoir ?`,
  reflection: `La sagesse et le savoir sont des dons d'Allah. Les rechercher est essentiel pour le croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Lutan ataynahu hukman wa 'ilman » — et à Lot, Nous donnâmes le jugement et le savoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la sagesse et le savoir ? Ou est-ce que je reste ignorant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse et le savoir sont essentiels pour le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes reçoivent la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la sagesse la reçoit." }
  ],
  munajat: `Ya Rabb, donne-moi la sagesse et le savoir. Ne permets pas l'ignorance. Illumine mon esprit par Ta lumière.`
};

MIROIR["21:75"] = {
  reference: "21:75",
  theme: ["miséricorde", "Lot", "droiture"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Lut", "Ar-Rahmah"],
  mirrorVersion: `« Et Nous le fîmes entrer dans Notre miséricorde, car il était du nombre des vertueux. » Le miroir me montre l'entrée dans la miséricorde. « Wa adkhalnahu fi rahmatina innahu mina al-salihin » — Nous le fîmes entrer dans Notre miséricorde, car il était du nombre des vertueux. La vertu mène à la miséricorde. Le miroir m'interroge : est-ce que je suis du nombre des vertueux ?`,
  reflection: `La vertu mène à la miséricorde. Être du nombre des vertueux est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adkhalnahu fi rahmatina innahu mina al-salihin » — Nous le fîmes entrer dans Notre miséricorde, car il était du nombre des vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis du nombre des vertueux ? Ou est-ce que je m'éloigne de la vertu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu est la clé de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les vertueux entrent dans la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique la vertu entre dans la miséricorde." }
  ],
  munajat: `Ya Rabb, fais que je sois du nombre des vertueux. Ne permets pas la déviation. Fais-moi entrer dans Ta miséricorde.`
};

MIROIR["21:76"] = {
