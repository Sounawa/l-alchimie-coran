};

MIROIR["17:23"] = {
  reference: "17:23",
  theme: ["parents", "bienfaisance", "obéissance"],
  emotion: "Respect, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Walidayn", "Al-Ihsan"],
  mirrorVersion: `« Ton Seigneur a décrété que vous n'adorerez que Lui, et que vous traiterez avec bonté vos parents. » Le miroir me montre le devoir envers les parents. « Wa qada rabbuka alla ta'budu illa iyyahu wa bi-al-walidayni ihsana » — ton Seigneur a décrété que vous n'adorerez que Lui, et que vous traiterez avec bonté vos parents. Le devoir envers les parents suit l'adoration. Le miroir m'interroge : est-ce que je traite mes parents avec bonté ?`,
  reflection: `Le devoir envers les parents suit l'adoration. Les traiter avec bonté est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qada rabbuka alla ta'budu illa iyyahu wa bi-al-walidayni ihsana » — ton Seigneur a décrété que vous n'adorerez que Lui, et que vous traiterez avec bonté vos parents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite mes parents avec bonté ? Ou est-ce que je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonté envers les parents est un acte d'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les parents sont la porte du paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est bon avec ses parents ouvre les portes du bien." }
  ],
  munajat: `Ya Rabb, je veux traiter mes parents avec bonté. Ne permets pas que je les néglige. Donne-moi l'amour et le respect pour eux.`
};

MIROIR["17:32"] = {
