    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité est une sagesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La dualité est présente dans toute la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la sagesse de la diversité apprécie." }
  ],
  munajat: `Ya Khaliq, je reconnais Ta sagesse dans la diversité. Merci pour Ta création.`
};

MIROIR["75:40"] = {
  reference: "75:40",
  theme: ["résurrection", "puissance", "question"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-Qadir"],
  mirrorVersion: `« Celui-là n'est-Il pas capable de faire revivre les morts ? » La question rhétorique. Le miroir m'enseigne : celui qui crée peut ressusciter. La résurrection est certaine.`,
  reflection: `Celui qui crée peut ressusciter. La résurrection est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-laysa dhalika bi-qadirin 'ala an yuhyiya al-mawta » — celui-là n'est-Il pas capable de faire revivre les morts ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la résurrection ? Ma confiance en Allah est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création prouve la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est la suite logique de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection se prépare." }
  ],
  munajat: `Ya Qadir, je crois en la résurrection. Prépare-moi pour ce Jour.`
};

// ==================== SURAH 76: AL-INSAN - MISSING VERSES ====================

MIROIR["76:2"] = {
  reference: "76:2",
  theme: ["création", "épreuve", "sperme"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mubtala"],
  mirrorVersion: `« Nous avons créé l'homme d'une goutte mélangée pour l'éprouver. » L'épreuve est le but. Le miroir m'enseigne : la création n'est pas un jeu. L'homme est créé pour être testé.`,
  reflection: `L'homme est créé pour être testé. L'épreuve est le but de la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna khalaqna al-insana min nutfatin amshajin nabtalih » — Nous avons créé l'homme d'une goutte mélangée pour l'éprouver." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que ma vie est une épreuve ? Mon attitude est-elle conforme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve élève celui qui la passe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la vie est une épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'épreuve la passe bien." }
  ],
  munajat: `Ya Rabb, je comprends que je suis éprouvé. Aide-moi à passer l'épreuve.`
};

MIROIR["76:3"] = {
  reference: "76:3",
  theme: ["guidance", "choix", "chemin"],
  emotion: "Responsabilité, liberté",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Shakir"],
  mirrorVersion: `« Nous l'avons guidé sur le chemin, qu'il soit reconnaissant ou ingrat. » Le choix est offert. Le miroir m'enseigne : la guidance est donnée, le choix appartient à l'homme.`,
  reflection: `La guidance est donnée. Le choix appartient à l'homme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadaynahu al-sabila imma shakiran wa imma kafura » — Nous l'avons guidé sur le chemin, qu'il soit reconnaissant ou ingrat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant ? Mon choix est-il le bon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance est le bon choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le choix est la caractéristique de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la reconnaissance gagne." }
  ],
  munajat: `Ya Rabb, je choisis la reconnaissance. Guide-moi sur le chemin.`
};

MIROIR["76:4"] = {
