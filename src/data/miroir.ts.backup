    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare de bonnes œuvres accueille l'annonce." }
  ],
  munajat: `Ya Rabb, aide-moi à préparer de bonnes œuvres. Fais que l'annonce soit une bonne nouvelle.`
};

MIROIR["75:14"] = {
