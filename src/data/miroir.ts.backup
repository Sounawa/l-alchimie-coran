  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yufuna bi-al-nadri wa yakhawna yawman kana sharruhu mustatira » — ils accomplissent leurs vœux et craignent un jour dont le mal s'étendra partout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accomplis mes vœux ? La crainte du Jour est-elle présente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accomplissement des vœux élève." },
