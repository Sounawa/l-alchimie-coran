    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange avec gratitude ici mange les délices là-bas." }
  ],
  munajat: `Ya Razzaq, Tu es le Pourvoyeur. Donne-moi la nourriture licite et bénie. Préserve-moi du Zaqqûm de l'enfer.`
};

MIROIR["56:53"] = {
