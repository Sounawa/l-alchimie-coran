  difficulty: "débutant",
  relatedNames: ["Al-Jalil", "Al-Muta'ali"],
  mirrorVersion: `« Les regards baissés, l'avilissement les couvrant. » Le miroir me montre l'état de ce jour. « Khashi'atan absaruhum tarhaquhum dhillatun » — les regards baissés, l'avilissement les couvrant. L'humiliation est totale. Le miroir m'interroge : est-ce que je veux éviter cette humiliation ?`,
  reflection: `L'humiliation de ce jour attend les mécréants. Les regards ne peuvent pas se lever.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khashi'atan absaruhum tarhaquhum dhillatun dhalika al-yawmu alladhi kanu yu'adun » — les regards baissés, l'avilissement les couvrant. C'est le jour qu'on leur promettait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux éviter cette humiliation ? Mon regard sera-t-il baissé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation suit l'orgueil d'ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce jour est la réalité de toutes les promesses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble ici-bas sera élevé ce jour." }
  ],
  munajat: `Ya Jalil, je ne veux pas être humilié ce jour. Fais que je sois humble ici-bas. Ne permets pas que l'orgueil me perde.`
};

MIROIR["71:3"] = {
  reference: "71:3",
  theme: ["adoration", "piété", "obéissance"],
  emotion: "Appel, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Rabb", "Al-Wadud"],
  mirrorVersion: `« Que vous adoriez Allah, que vous Le craigniez et que vous m'obéissiez. » Le miroir me montre le message de Noé. « An ta'budu Allaha wa tattaquhu wa tuti'uni » — adorez Allah, craignez-Le et obéissez-moi. Le message est simple. Le miroir m'interroge : est-ce que j'adore, crains et obéis ?`,
  reflection: `Le message des prophètes est constant : adoration, crainte, obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An ta'budu Allaha wa tattaquhu wa tuti'uni » — que vous adoriez Allah, que vous Le craigniez et que vous m'obéissiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore, crains et obéis ? Mon adoration est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance au prophète est l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message prophétique est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore vraiment est sauvé." }
  ],
  munajat: `Ya Rabb, j'adore, je crains et j'obéis. Fais que mon adoration soit complète. Ne permets pas que je refuse Ton message.`
};

MIROIR["71:4"] = {
  reference: "71:4",
  theme: ["pardon", "délai", "miséricorde"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Rahim"],
  mirrorVersion: `« Il vous pardonnera vos péchés et vous accordera un délai. » Le miroir me montre la promesse divine. « Yaghfir lakum min dhunubikum wa yu'akhkhirakum » — Il pardonnera vos péchés et vous accordera un délai. Le pardon est offert. Le miroir m'interroge : est-ce que je saisis cette offre ?`,
  reflection: `Le pardon d'Allah est immense. Le délai est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaghfir lakum min dhunubikum wa yu'akhkhirakum ila ajalin musamman » — Il vous pardonnera vos péchés et vous accordera un délai jusqu'à un terme fixé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je saisis cette offre ? Qu'est-ce qui m'empêche de me repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une chance, pas une permission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde divine précède le châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui saisit l'offre est pardonné." }
  ],
  munajat: `Ya Ghaffur, Ton pardon est offert. Je saisis cette offre. Ne permets pas que je repousse Ta miséricorde.`
};

MIROIR["71:5"] = {
  reference: "71:5",
  theme: ["appel", "persévérance", "rejet"],
  emotion: "Tristesse, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Sabur", "Al-Hadi"],
  mirrorVersion: `« Seigneur, dit-il, j'ai appelé mon peuple nuit et jour. » Le miroir me montre la persévérance de Noé. « Qala rabbi inni da'awtu qawmi laylan wa naharan » — j'ai appelé mon peuple nuit et jour. L'appel constant malgré le rejet. Le miroir m'interroge : est-ce que je persévère dans l'appel ?`,
  reflection: `La persévérance de Noé est un modèle. 950 ans d'appel sans découragement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbi inni da'awtu qawmi laylan wa naharan » — Seigneur, j'ai appelé mon peuple nuit et jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persévère dans l'appel ? Ou est-ce que je me décourage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La persévérance dans le rejet est la vraie foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'appel à Allah est une mission continue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui persévère sans se lasser réussit." }
  ],
  munajat: `Ya Sabur, donne-moi la persévérance de Noé. Ne permets pas que je me décourage. Fais que j'appelle sans cesse.`
};

MIROIR["71:6"] = {
  reference: "71:6",
  theme: ["fuite", "rejet", "entêtement"],
  emotion: "Tristesse, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mu'id"],
  mirrorVersion: `« Mais mon appel n'a fait qu'accroître leur fuite. » Le miroir me montre le résultat paradoxal. « Fa-mazadahum du'a'i illa firaran » — mon appel n'a fait qu'accroître leur fuite. L'appel peut repousser. Le miroir m'interroge : est-ce que je fuis l'appel à Allah ?`,
  reflection: `L'appel à la vérité peut repousser ceux qui préfèrent l'erreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-mazadahum du'a'i illa firaran » — mais mon appel n'a fait qu'accroître leur fuite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis l'appel à Allah ? Qu'est-ce qui me fait fuir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite de la vérité est la course vers l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité attire les cœurs purs, repousse les cœurs malades." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne fuit pas trouve la vérité." }
  ],
  munajat: `Ya Hadi, je ne veux pas fuir Ton appel. Fais que je me rapproche. Ne permets pas que je m'éloigne de la vérité.`
};

MIROIR["71:7"] = {
  reference: "71:7",
  theme: ["orgueil", "fermeture", "oreilles"],
  emotion: "Tristesse, impuissance",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Sami'"],
  mirrorVersion: `« Chaque fois que je les appelais pour que Tu leur pardonnes, ils se bouchaient les oreilles. » Le miroir me montre la fermeture volontaire. « Kullama da'awtuhum lita'ghfira lahum ja'alu asabi'ahum fi adhanihim » — ils se bouchaient les oreilles. La fermeture est un choix. Le miroir m'interroge : est-ce que je me bouche les oreilles ?`,
  reflection: `L'orgueil empêche d'entendre. La fermeture est un choix conscient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullama da'awtuhum lita'ghfira lahum ja'alu asabi'ahum fi adhanihim » — chaque fois que je les appelais, ils se bouchaient les oreilles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me bouche les oreilles ? Qu'est-ce que je refuse d'entendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oreille ouverte est la porte du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'audition est un don divin qui demande une réponse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre ses oreilles ouvre son cœur." }
  ],
  munajat: `Ya Sami', je ne veux pas fermer mes oreilles. Ouvre mon ouïe à Ta vérité. Ne permets pas que l'orgueil me rende sourd.`
};

MIROIR["71:8"] = {
  reference: "71:8",
  theme: ["appel", "public", "constance"],
  emotion: "Détermination, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Da'i", "Al-Haqq"],
  mirrorVersion: `« Puis je les ai appelés ouvertement. » Le miroir me montre l'appel public. « Thumma inni a'lantu lahum » — puis je les ai appelés ouvertement. L'appel public complète l'appel privé. Le miroir m'interroge : est-ce que j'appelle ouvertement ?`,
  reflection: `L'appel à Allah doit être à la fois privé et public. La constance dans les deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma inni a'lantu lahum » — puis je les ai appelés ouvertement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'appelle ouvertement ? Ou est-ce que je cache ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel public montre la sincérité de l'appel privé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité n'a pas besoin d'être cachée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle ouvertement est sincère." }
  ],
  munajat: `Ya Haqq, fais que j'appelle ouvertement. Ne permets pas que je cache ma foi. Donne-moi le courage de la proclamation.`
};

MIROIR["71:9"] = {
  reference: "71:9",
  theme: ["proclamation", "secret", "complétude"],
  emotion: "Engagement, totalité",
  difficulty: "débutant",
  relatedNames: ["Al-Zahir", "Al-Batin"],
  mirrorVersion: `« Puis je leur ai fait des déclarations publiques et des conversations secrètes. » Le miroir me montre la complétude de l'appel. « Fa-asrartu lahum wa a'lantu » — en secret et en public. Les deux formes sont nécessaires. Le miroir m'interroge : est-ce que je complète mon appel ?`,
  reflection: `L'appel complet touche les cœurs dans toutes les situations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-asrartu lahum wa a'lantu » — puis je leur ai fait des déclarations publiques et des conversations secrètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je complète mon appel ? Est-ce que je touche tous les aspects ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret et le public se complètent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est complète dans toutes ses formes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle dans tous les états est complet." }
  ],
  munajat: `Ya Zahir, ya Batin, complète mon appel. Fais que je touche en secret et en public. Ne permets pas que je sois incomplet.`
};

MIROIR["71:10"] = {
  reference: "71:10",
  theme: ["repentir", "pardon", "réponse"],
  emotion: "Espoir, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "At-Tawwab"],
  mirrorVersion: `« J'ai dit : Implorez le pardon de votre Seigneur, car Il est grand Pardonneur. » Le miroir me montre la clé du pardon. « Fa-qultu istaghfiru rabbakum innahu kana ghaffaran » — implorez le pardon, Il est grand Pardonneur. L'istighfar est la clé. Le miroir m'interroge : est-ce que j'implore le pardon ?`,
  reflection: `L'istighfar quotidien ouvre les portes du ciel et de la terre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-qultu istaghfiru rabbakum innahu kana ghaffaran » — implorez le pardon de votre Seigneur, car Il est grand Pardonneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'implore le pardon ? Combien de fois par jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon d'Allah attend l'istighfar." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'istighfar est la clé de toutes les ouvertures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui implore beaucoup est beaucoup pardonné." }
  ],
  munajat: `Ya Ghaffur, j'implore Ton pardon. Ouvre-moi Tes portes. Ne permets pas que je néglige l'istighfar.`
};

MIROIR["71:11"] = {
  reference: "71:11",
  theme: ["pluie", "provision", "abondance"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mun'im"],
  mirrorVersion: `« Pour qu'Il envoie sur vous, du ciel, une pluie abondante. » Le miroir me montre la réponse à l'istighfar. « Yursili al-sama'a 'alaykum midraran » — Il envoie du ciel une pluie abondante. La provision suit le pardon. Le miroir m'interroge : est-ce que je vois le lien entre pardon et provision ?`,
  reflection: `La pluie est une métaphore de toutes les provisions divines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yursili al-sama'a 'alaykum midraran » — pour qu'Il envoie sur vous, du ciel, une pluie abondante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le lien entre pardon et provision ? Mon istighfar est-il constant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision matérielle suit la purification spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pluie est une miséricorde visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui implore reçoit abondamment." }
  ],
  munajat: `Ya Razzaq, envoie Ta provision. Je T'implore et j'espère. Ne permets pas que ma provision soit coupée par mes péchés.`
};

MIROIR["71:12"] = {
  reference: "71:12",
  theme: ["richesse", "enfants", "jardins"],
  emotion: "Gratitude, abondance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Ghani"],
  mirrorVersion: `« Et qu'Il vous accorde des biens et des enfants, et des jardins et des rivières. » Le miroir me montre les bénédictions complètes. « Wa yumdidkum bi-amwalin wa banina » — Il vous accorde des biens et des enfants. Les bénédictions suivent le pardon. Le miroir m'interroge : est-ce que je remercie pour ces bénédictions ?`,
  reflection: `Les biens, les enfants, les jardins sont des signes de la faveur divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yumdidkum bi-amwalin wa banina wa yaj'al lakum jannatin wa yaj'al lakum anharan » — et qu'Il vous accorde des biens et des enfants, et des jardins et des rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ces bénédictions ? Suis-je conscient de leur source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bénédictions matérielles sont des signes spirituels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision divine prend de nombreuses formes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les bénédictions les préserve." }
  ],
  munajat: `Ya Wahhab, je remercie pour les biens, les enfants, les jardins. Fais que je sois reconnaissant. Ne permets pas que je sois ingrat.`
};

MIROIR["71:13"] = {
  reference: "71:13",
  theme: ["question", "réflexion", "éveil"],
  emotion: "Interpellation, éveil",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Qu'avez-vous à ne pas espérer la grandeur d'Allah ? » Le miroir me montre la question cruciale. « Ma lakum la tarjuna lillahi waqaran » — qu'avez-vous à ne pas espérer la grandeur d'Allah ? L'espoir en Allah est essentiel. Le miroir m'interroge : est-ce que j'espère en la grandeur d'Allah ?`,
  reflection: `L'espoir en Allah motive la foi. Le désespoir est une maladie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lakum la tarjuna lillahi waqaran » — qu'avez-vous à ne pas espérer la grandeur d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère en la grandeur d'Allah ? Mon espoir est-il vivant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir en Allah est la vie du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grandeur d'Allah mérite l'espoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère vraiment reçoit." }
  ],
  munajat: `Ya Hakim, j'espère en Ta grandeur. Réveille mon espoir. Ne permets pas que je désespère.`
};

MIROIR["71:14"] = {
  reference: "71:14",
  theme: ["création", "étapes", "perfection"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Alors qu'Il vous a créés par étapes successives. » Le miroir me montre la création progressive. « Wa qad khalaqakum atwaran » — Il vous a créés par étapes. La création est un processus. Le miroir m'interroge : est-ce que je contemple ma création ?`,
  reflection: `La création par étapes montre la sagesse divine. Chaque étape a son sens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad khalaqakum atwaran » — alors qu'Il vous a créés par étapes successives." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple ma création ? Mon développement est-il dans ma conscience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étapes de la création reflètent les étapes spirituelles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création progressive est une loi universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les étapes comprend le processus." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé par étapes. Fais que je contemple. Ne permets pas que j'oublie le processus de ma création.`
};

MIROIR["71:15"] = {
  reference: "71:15",
  theme: ["cieux", "création", "contemplation"],
  emotion: "Émerveillement, humble",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« N'avez-vous pas vu comment Allah a créé sept cieux superposés ? » Le miroir me montre l'invitation à contempler. « Alam taraw kayfa khalaqa Allahu sab'a samawatin tibaqan » — n'avez-vous pas vu comment Allah a créé sept cieux ? La contemplation du ciel. Le miroir m'interroge : est-ce que je contemple les cieux ?`,
  reflection: `Les sept cieux sont un signe de la grandeur créatrice. La contemplation élève.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam taraw kayfa khalaqa Allahu sab'a samawatin tibaqan » — n'avez-vous pas vu comment Allah a créé sept cieux superposés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les cieux ? Quand ai-je regardé le ciel la dernière fois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contemplation des cieux élève vers le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux sont le signe le plus visible de la grandeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les cieux connaît le Créateur." }
  ],
  munajat: `Ya Khaliq al-samawat, je contemple Tes cieux. Élève-moi vers Toi. Ne permets pas que je sois aveugle aux signes.`
};

MIROIR["71:16"] = {
  reference: "71:16",
  theme: ["lune", "soleil", "lumière"],
  emotion: "Émerveillement, guidée",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Siraj"],
  mirrorVersion: `« Et y a placé la lune comme lumière et le soleil comme lampe ? » Le miroir me montre les luminaires. « Wa ja'ala al-qamara fihinna nuran wa ja'ala al-shamsa sirajan » — la lune comme lumière, le soleil comme lampe. Chaque astre a sa fonction. Le miroir m'interroge : est-ce que je vois la sagesse dans la création ?`,
  reflection: `La lumeur éclaire la nuit, le soleil éclaire le jour. La complémentarité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'ala al-qamara fihinna nuran wa ja'ala al-shamsa sirajan » — et y a placé la lune comme lumière et le soleil comme lampe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la sagesse dans la création ? Les astres m'enseignent-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière et la lampe reflètent la guidée divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les luminaires sont des guides dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les luminaires trouve la lumière." }
  ],
  munajat: `Ya Nur, Tu as créé la lune et le soleil. Illumine mon chemin. Ne permets pas que je reste dans les ténèbres.`
};

MIROIR["71:17"] = {
  reference: "71:17",
  theme: ["croissance", "terre", "végétation"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mubdi"],
  mirrorVersion: `« Et Allah vous a fait croître de la terre comme des plantes. » Le miroir me montre l'origine terrestre. « Wa Allahu anbatakum min al-ardi nabatan » — Allah vous a fait croître de la terre comme des plantes. Notre origine est humble. Le miroir m'interroge : est-ce que je me souviens de mon origine ?`,
  reflection: `La croissance végétale est un modèle pour notre développement spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu anbatakum min al-ardi nabatan » — et Allah vous a fait croître de la terre comme des plantes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine ? Ma croissance est-elle saine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La croissance humble mène à l'élévation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est la mère de notre croissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croît bien porte du fruit." }
  ],
  munajat: `Ya Khaliq, Tu m'as fait croître de la terre. Fais que je croisse bien. Ne permets pas que je sois une plante stérile.`
};

MIROIR["71:18"] = {
  reference: "71:18",
  theme: ["retour", "résurrection", "cycle"],
  emotion: "Espoir, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Ma'ad"],
  mirrorVersion: `« Puis Il vous y fera retourner et Il vous en fera sortir. » Le miroir me montre le cycle complet. « Thumma yu'idukum fiha wa yukhrijukum ikhrajan » — puis Il vous y fera retourner et vous en fera sortir. La terre est le début et le retour. Le miroir m'interroge : est-ce que j'accepte ce cycle ?`,
  reflection: `De la terre nous venons, à la terre nous retournons, de la terre nous sortons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yu'idukum fiha wa yukhrijukum ikhrajan » — puis Il vous y fera retourner et Il vous en fera sortir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ce cycle ? La mort et la résurrection font-elles partie de ma conscience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour à la terre prépare la sortie glorieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle création-retour-résurrection est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le cycle est prêt pour la sortie." }
  ],
  munajat: `Ya Ba'ith, j'accepte le cycle. Prépare-moi pour le retour et la sortie. Ne permets pas que je nie la résurrection.`
};

MIROIR["71:19"] = {
  reference: "71:19",
  theme: ["terre", "tapis", "facilité"],
  emotion: "Gratitude, confort",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mudabbir"],
  mirrorVersion: `« Et Allah a fait de la terre un tapis pour vous. » Le miroir me montre la facilité accordée. « Wa Allahu ja'ala lakumu al-arda bisatan » — Allah a fait de la terre un tapis pour vous. La terre est facilitée. Le miroir m'interroge : est-ce que je remercie pour cette facilité ?`,
  reflection: `Le tapis est une métaphore de l'aisance. La terre est faite pour notre confort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu ja'ala lakumu al-arda bisatan » — et Allah a fait de la terre un tapis pour vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour cette facilité ? Ou est-ce que je me plains ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La facilité de la terre invite à l'adoration facile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un don adapté à l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la facilité adore avec gratitude." }
  ],
  munajat: `Ya Khaliq, Tu as fait de la terre un tapis. Je remercie pour cette facilité. Ne permets pas que je sois ingrat.`
};

MIROIR["71:20"] = {
  reference: "71:20",
  theme: ["passage", "chemins", "mouvement"],
  emotion: "Gratitude, liberté",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Musahhil"],
  mirrorVersion: `« Pour que vous puissiez emprunter ses larges chemins. » Le miroir me montre la liberté de mouvement. « Li-tasluku minha subulana fujajan » — pour que vous puissiez emprunter ses chemins. Les chemins sont ouverts. Le miroir m'interroge : quel chemin j'emprunte ?`,
  reflection: `Les chemins de la terre sont nombreux. Le choix du chemin est crucial.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-tasluku minha subulana fujajan » — pour que vous puissiez emprunter ses larges chemins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel chemin j'emprunte ? Est-ce le bon chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les chemins matériels reflètent les chemins spirituels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les chemins sont ouverts à tous les choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le bon chemin arrive à bon port." }
  ],
  munajat: `Ya Fattah, ouvre-moi les bons chemins. Guide mes pas. Ne permets pas que j'emprunte les mauvais chemins.`
};

MIROIR["71:21"] = {
  reference: "71:21",
  theme: ["désobéissance", "orgueil", "richesse"],
  emotion: "Tristesse, constat",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Noé dit : Seigneur, ils m'ont désobéi et ont suivi celui dont les biens et les enfants n'ont fait qu'accroître la perte. » Le miroir me montre l'égarement par les biens. « Qala Nuhun rabbi innahum 'asawnî » — ils m'ont désobéi. La désobéissance suit l'orgueil. Le miroir m'interroge : est-ce que les biens m'égarent ?`,
  reflection: `Les biens et les enfants peuvent être des épreuves. L'attachement excessif égare.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Nuhun rabbi innahum 'asawnî wa ittaba'u man lam yazidhu maluhu wa waladuhu illa khasaran » — Seigneur, ils m'ont désobéi et ont suivi celui dont les biens et les enfants n'ont fait qu'accroître la perte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que les biens m'égarent ? Mon attachement est-il excessif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les biens bien utilisés augmentent, mal utilisés diminuent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse est un test, pas un signe de favoritisme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise ses biens n'est pas maîtrisé par eux." }
  ],
  munajat: `Ya Hakam, les biens m'entourent. Fais que je ne sois pas égaré. Ne permets pas que l'attachement me perde.`
};

MIROIR["71:22"] = {
  reference: "71:22",
  theme: ["ruse", "complot", "égarement"],
  emotion: "Vigilance, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Khali'ah", "Al-Mudabbir"],
  mirrorVersion: `« Ils ont ourdi un immense complot. » Le miroir me montre la ruse des mécréants. « Wa makaru makran kubbaran » — ils ont ourdi un immense complot. Le complot contre la vérité. Le miroir m'interroge : est-ce que je suis victime ou auteur de complots ?`,
  reflection: `Le complot contre la vérité est voué à l'échec. La ruse se retourne contre son auteur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa makaru makran kubbaran » — ils ont ourdi un immense complot." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis victime ou auteur de complots ? Quelle est ma ruse cachée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La ruse contre la vérité se retourne contre son auteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours de la ruse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui complote contre la vérité se détruit." }
  ],
  munajat: `Ya Rabb, préserve-moi des complots. Fais que je ne sois pas un comploteur. Protège-moi de la ruse.`
};

MIROIR["71:23"] = {
  reference: "71:23",
  theme: ["idoles", "égarement", "tradition"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hadi"],
  mirrorVersion: `« Et ils ont dit : N'abandonnez jamais vos divinités. » Le miroir me montre l'attachement aux idoles. « Wa qalu la tazarunna alihatakum » — n'abandonnez jamais vos divinités. L'idolâtrie est un attachement aveugle. Le miroir m'interroge : quelles sont mes idoles cachées ?`,
  reflection: `Les idoles ne sont pas seulement des statues. Tout ce qui remplace Allah est une idole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu la tazarunna alihatakum » — et ils ont dit : N'abandonnez jamais vos divinités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes idoles cachées ? Qu'est-ce que je refuse d'abandonner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon des idoles est la libération." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'idolâtrie prend mille formes dans chaque époque." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne ses idoles trouve Allah." }
  ],
  munajat: `Ya Haqq, révèle-moi mes idoles. Aide-moi à les abandonner. Ne permets pas que je sois attaché à autre que Toi.`
};

MIROIR["71:24"] = {
  reference: "71:24",
  theme: ["égarement", "multiplication", "prière"],
  emotion: "Supplication, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Mudill", "Al-Hadi"],
  mirrorVersion: `« Ils en ont égaré beaucoup. Seigneur, n'ajoute aux injustes que l'égarement. » Le miroir me montre la conséquence du rejet. « Wa qad adallu kathiran » — ils en ont égaré beaucoup. L'égarement se multiplie. Le miroir m'interroge : est-ce que j'égare ou je guide ?`,
  reflection: `L'égarement collectif est une responsabilité. Le juste prie contre l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad adallu kathiran wa la yazidu al-zalimina illa dalalan » — ils en ont égaré beaucoup. Seigneur, n'ajoute aux injustes que l'égarement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'égare ou je guide ? Mon influence est-elle positive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidée des uns contraste avec l'égarement des autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'influence est une responsabilité collective." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide est béni, celui qui égare est maudit." }
  ],
  munajat: `Ya Hadi, fais que je guide et n'égare pas. Utilise-moi pour la guidée. Ne permets pas que je sois une cause d'égarement.`
};

MIROIR["71:25"] = {
  reference: "71:25",
  theme: ["noyade", "châtiment", "conséquence"],
  emotion: "Terreur, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Qawi"],
  mirrorVersion: `« A cause de leurs fautes, ils ont été noyés et introduits dans le Feu. » Le miroir me montre la conséquence finale. « Mimma khati'ihimughriqu fa-udkhilu naran » — à cause de leurs fautes, noyés et au Feu. Le châtiment suit les fautes. Le miroir m'interroge : quelles sont mes fautes ?`,
  reflection: `Le déluge de Noé est une leçon éternelle. Le châtiment a des causes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mimma khati'ihimughriqu fa-udkhilu naran » — à cause de leurs fautes, ils ont été noyés et introduits dans le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes fautes ? Quelles conséquences m'attendent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les fautes ont des conséquences dans les deux mondes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment suit la persistance dans le mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les fautes évite les conséquences." }
  ],
  munajat: `Ya Ghaffur, préserve-moi du châtiment. Pardonne mes fautes. Ne permets pas que je sois du nombre des châtiés.`
};

MIROIR["71:26"] = {
  reference: "71:26",
  theme: ["supplication", "destruction", "justice"],
  emotion: "Supplication, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Noé dit : Seigneur, ne laisse sur terre aucun mécréant. » Le miroir me montre la prière radicale. « Wa la tazar 'ala al-ardi mina al-kafirina dayyaran » — ne laisse aucun mécréant sur terre. La prière de justice. Le miroir m'interroge : quelle est ma prière pour la justice ?`,
  reflection: `La prière contre les mécréants est une prière pour la justice et la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tazar 'ala al-ardi mina al-kafirina dayyaran » — Seigneur, ne laisse sur terre aucun mécréant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma prière pour la justice ? Est-ce que je prie contre le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière contre le mal est une prière pour le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine répond aux prières des justes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour la justice l'obtient." }
  ],
  munajat: `Ya 'Adl, établis Ta justice. Ne permets pas que les mécréants dominent. Protège la vérité et les véridiques.`
};

MIROIR["71:27"] = {
  reference: "71:27",
  theme: ["reproduction", "mécréance", "génération"],
  emotion: "Supplication, prévoyance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Warith"],
  mirrorVersion: `« Si Tu les laisses, ils égareront Tes serviteurs et n'engendreront que des pécheurs et des mécréants. » Le miroir me montre la conséquence à long terme. « Innaka in tazarhum yudillu 'ibadaka » — si Tu les laisses, ils égareront Tes serviteurs. La mécréance se reproduit. Le miroir m'interroge : est-ce que je participe à la reproduction du mal ?`,
  reflection: `Le mal se reproduit s'il n'est pas arrêté. La prière de Noé est une prière de prévention.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka in tazarhum yudillu 'ibadaka wa la yalidu illa fajiran kaffaran » — si Tu les laisses, ils égareront Tes serviteurs et n'engendreront que des pécheurs et des mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe à la reproduction du mal ? Ma progéniture sera-t-elle juste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice maintenant prévient le mal futur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les générations héritent des choix de leurs parents." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour les générations futures est sage." }
  ],
  munajat: `Ya Warith, je prie pour les générations futures. Fais que ma progéniture soit juste. Ne permets pas que je contribue au mal.`
};

MIROIR["71:28"] = {
  reference: "71:28",
  theme: ["pardon", "parents", "croyants"],
  emotion: "Supplication, amour",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffur", "Al-Rahim"],
  mirrorVersion: `« Seigneur, pardonne-moi, à mes parents et aux croyants qui entreront dans ma maison. » Le miroir me montre la prière inclusive. « Rabbi ghfir li wa li-walidayya wa li-l-mu'minina » — pardonne-moi, à mes parents et aux croyants. La prière inclusive. Le miroir m'interroge : est-ce que je prie pour les autres ?`,
  reflection: `La prière pour soi doit inclure les parents et les croyants. L'intercession est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi ghfir li wa li-walidayya wa li-l-mu'minina yawma yaqumu al-hisab » — Seigneur, pardonne-moi, à mes parents et aux croyants, le jour où les comptes seront établis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour les autres ? Qui inclus-je dans mes prières ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour les autres revient à soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté des croyants est une famille spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour les autres est exaucé." }
  ],
  munajat: `Ya Ghaffur, je prie pour moi, mes parents et les croyants. Pardonne-nous tous. Ne permets pas que je prie seulement pour moi.`
};

MIROIR["71:3"] = {
  reference: "71:3",
  theme: ["adoration", "piété", "obéissance"],
  emotion: "Sérieux, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "At-Tawwab"],
  mirrorVersion: `« Que vous adoriez Allah, que vous Le craigniez et que vous m'obéissiez. » Le miroir me montre le message de Noé. « An ta'budu Allaha wa tattaquhu wa tuti'uni » — que vous adoriez Allah, que vous Le craigniez et que vous m'obéissiez. Le message est simple : adoration, crainte, obéissance. Le miroir m'interroge : est-ce que je suis ce message ?`,
  reflection: `Le message des prophètes est universel : adorer Allah seul, Le craindre, et obéir au messager.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An ta'budu Allaha wa tattaquhu wa tuti'uni » — que vous adoriez Allah, que vous Le craigniez et que vous m'obéissiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah seul ? Est-ce que je Le crains ? Est-ce que j'obéis au Prophète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration sans crainte est superficielle. La crainte sans obéissance est incomplete." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce message est celui de tous les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unit ces trois éléments trouve la voie." }
  ],
  munajat: `Ya Wahid, je T'adore seul. Fais que je Te craigne et que j'obéisse à Ton messager. Ne permets pas que je sois parmi les rebelles.`
};

MIROIR["71:4"] = {
  reference: "71:4",
  theme: ["pardon", "délai", "provision"],
  emotion: "Espoir, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahman"],
  mirrorVersion: `« Il vous pardonnera vos péchés et vous accordera un délai jusqu'à un terme fixé. » Le miroir me montre la promesse d'Allah. « Yaghfir lakum min dhunubikum wa yu'akhkhirakum ila ajalin musamman » — Il vous pardonnera vos péchés et vous accordera un délai jusqu'à un terme fixé. Le pardon et le délai sont liés au repentir. Le miroir m'interroge : est-ce que je me repens ?`,
  reflection: `Le pardon d'Allah est immense. Le délai est une chance de se repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaghfir lakum min dhunubikum wa yu'akhkhirakum ila ajalin musamman » — Il vous pardonnera vos péchés et vous accordera un délai jusqu'à un terme fixé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens ? Profite-je du délai pour me rapprocher d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde, pas un oubli." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pardon divin est toujours disponible pour le repentant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent pendant le délai est pardonné." }
  ],
  munajat: `Ya Ghaffur, pardonne mes péchés. Je me repens pendant le délai que Tu m'accordes. Ne permets pas que je tarde jusqu'à ce qu'il soit trop tard.`
};

MIROIR["71:5"] = {
  reference: "71:5",
  theme: ["appel", "persévérance", "rejet"],
  emotion: "Tristesse, persévérance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Hadi"],
  mirrorVersion: `« Seigneur ! J'ai appelé mon peuple nuit et jour. » Le miroir me montre la persévérance de Noé. « Rabbi inni da'awtu qawmi laylan wa naharan » — Seigneur ! J'ai appelé mon peuple nuit et jour. L'appel était constant. Le miroir m'interroge : est-ce que je persévère dans mon appel ?`,
  reflection: `Noé a appelé son peuple pendant des siècles. La persévérance est la marque du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi inni da'awtu qawmi laylan wa naharan » — Seigneur ! J'ai appelé mon peuple nuit et jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persévère dans mon appel ? Suis-je constant dans ma prédication ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La persévérance transforme l'impossible en possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La constance est une loi de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui persévère finit par réussir." }
  ],
  munajat: `Ya Sabur, aide-moi à persévérer. Fais que je ne me lasse pas de l'appel. Ne permets pas que le rejet me décourage.`
};

MIROIR["71:6"] = {
  reference: "71:6",
  theme: ["fuite", "rejet", "orgueil"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« Mais mon appel n'a fait qu'augmenter leur fuite. » Le miroir me montre l'effet inverse. « Fa-lam yazidhum du'ai illa firaran » — mais mon appel n'a fait qu'augmenter leur fuite. La vérité repousse ceux qui ne veulent pas l'entendre. Le miroir m'interroge : est-ce que je fuis la vérité ?`,
  reflection: `La vérité attire ceux qui cherchent et repousse ceux qui fuient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-lam yazidhum du'ai illa firaran » — mais mon appel n'a fait qu'augmenter leur fuite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis la vérité ? La vérité me repousse-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite de la vérité est une course vers le malheur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est un miroir qui révèle l'état du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille la vérité est transformé." }
  ],
  munajat: `Ya Hadi, je ne veux pas fuir la vérité. Fais que je l'accueille avec humilité. Ne permets pas que la vérité me repousse.`
};

MIROIR["71:7"] = {
  reference: "71:7",
  theme: ["orgueil", "obstruction", "aveuglement"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Hadi"],
  mirrorVersion: `« Chaque fois que je les ai appelés pour que Tu leur pardonnes, ils ont mis leurs doigts dans leurs oreilles. » Le miroir me montre le refus conscient. « Kullama da'awtuhum litaghfira lahum ja'alu asabi'ahum fi adhanihim » — chaque fois que je les ai appelés pour que Tu leur pardonnes, ils ont mis leurs doigts dans leurs oreilles. Le refus est délibéré. Le miroir m'interroge : est-ce que je refuse d'écouter ?`,
  reflection: `Boucher ses oreilles est un acte conscient de refus. L'orgueil empêche d'entendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullama da'awtuhum litaghfira lahum ja'alu asabi'ahum fi adhanihim » — chaque fois que je les ai appelés pour que Tu leur pardonnes, ils ont mis leurs doigts dans leurs oreilles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je refuse d'écouter ? Est-ce que je bouche mes oreilles à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oreille bouchée par orgueil s'ouvre rarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ouïe est un don divin. La refuser est un péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre ses oreilles à la vérité entend Allah." }
  ],
  munajat: `Ya Basir, je ne veux pas boucher mes oreilles. Ouvre mes oreilles à Ta vérité. Ne permets pas que l'orgueil m'empêche d'entendre.`
};

MIROIR["71:8"] = {
  reference: "71:8",
  theme: ["appel", "multiplicité", "rejet"],
  emotion: "Tristesse, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Sabur"],
  mirrorVersion: `« Puis je les ai appelés ouvertement. » Le miroir me montre l'appel public. « Thumma inni a'lantu lahum » — puis je les ai appelés ouvertement. L'appel devient public. Le miroir m'interroge : est-ce que j'appelle ouvertement ?`,
  reflection: `L'appel commence en secret puis devient public. La méthode s'adapte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma inni a'lantu lahum » — puis je les ai appelés ouvertement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'appelle ouvertement ? Ou est-ce que je cache ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel public montre la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité n'a pas peur de la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle ouvertement n'a rien à cacher." }
  ],
  munajat: `Ya Hadi, aide-moi à appeler ouvertement. Fais que je n'aie pas honte de la vérité. Ne permets pas que je cache ma foi.`
};

MIROIR["71:9"] = {
  reference: "71:9",
  theme: ["prédication", "méthode", "sérieux"],
  emotion: "Détermination, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Nasih"],
  mirrorVersion: `« Puis je leur ai parlé ouvertement et en secret. » Le miroir me montre les méthodes variées. « Wa asrartu lahum israran » — puis je leur ai parlé ouvertement et en secret. L'appel utilise toutes les voies. Le miroir m'interroge : est-ce que j'utilise toutes les opportunités ?`,
  reflection: `La prédication utilise tous les moyens : public et privé, ouvert et secret.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-asrartu lahum israran wa a'lantu lahum i'lana » — puis je leur ai parlé ouvertement et en secret." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise toutes les opportunités ? Prêche-je en public et en privé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La variété des méthodes montre la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message doit atteindre tous les cœurs par tous les moyens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise toutes les voies finit par toucher." }
  ],
  munajat: `Ya Hakim, aide-moi à prêcher par tous les moyens. Fais que je n'oublie aucune opportunité. Ne permets pas que je sois limité dans ma méthode.`
};

MIROIR["71:11"] = {
  reference: "71:11",
  theme: ["pluie", "provision", "bénédiction"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Il enverra pour vous, du ciel, une pluie abondante. » Le miroir me montre la promesse de provision. « Yursili al-sama'a 'alaykum midraran » — Il enverra pour vous, du ciel, une pluie abondante. La pluie est une bénédiction. Le miroir m'interroge : est-ce que je compte sur la provision d'Allah ?`,
  reflection: `La pluie est un symbole de la provision divine. Elle vient du ciel par la miséricorde d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yursili al-sama'a 'alaykum midraran » — Il enverra pour vous, du ciel, une pluie abondante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur la provision d'Allah ? Est-ce que je remercie pour les bénédictions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision vient d'Allah, pas des moyens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pluie est une miséricorde pour toute la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source reçoit abondamment." }
  ],
  munajat: `Ya Razzaq, Tu envoies la pluie par Ta miséricorde. Fais que je compte sur Toi. Ne permets pas que j'oublie la source.`
};

MIROIR["71:12"] = {
  reference: "71:12",
  theme: ["richesse", "enfants", "jardins"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Wahhab"],
  mirrorVersion: `« Et Il vous accordera des richesses et des enfants. » Le miroir me montre les bénédictions mondaines. « Wa yumdidkum bi-amwalin wa banin » — et Il vous accordera des richesses et des enfants. Les bénédictions sont multiples. Le miroir m'interroge : est-ce que je suis reconnaissant pour ces bénédictions ?`,
  reflection: `Les richesses et les enfants sont des bénédictions d'Allah. Elles demandent gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yumdidkum bi-amwalin wa banin » — et Il vous accordera des richesses et des enfants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les richesses et les enfants ? Comment je les utilise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bénédictions sont un test autant qu'un don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse et les enfants sont des moyens d'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise les bénédictions pour Allah est béni." }
  ],
  munajat: `Ya Wahhab, Tu m'accordes richesses et enfants. Fais que je sois reconnaissant. Ne permets pas que ces bénédictions me distraient de Toi.`
};

MIROIR["71:13"] = {
  reference: "71:13",
  theme: ["question", "réflexion", "état"],
  emotion: "Interrogation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Qu'ont-ils à ne pas espérer la grandeur d'Allah ? » Le miroir me montre la question cruciale. « Ma lakum la tarjuna lillahi waqaran » — qu'ont-ils à ne pas espérer la grandeur d'Allah ? L'espoir en Allah est nécessaire. Le miroir m'interroge : est-ce que j'espère en la grandeur d'Allah ?`,
  reflection: `Ne pas espérer en la grandeur d'Allah est un signe de mécréance. L'espoir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lakum la tarjuna lillahi waqaran » — qu'ont-ils à ne pas espérer la grandeur d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère en la grandeur d'Allah ? Mon espoir est-il vivant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir en Allah précède toute autre espérance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grandeur d'Allah est au-dessus de tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère en la grandeur d'Allah n'est jamais déçu." }
  ],
  munajat: `Ya 'Azim, j'espère en Ta grandeur. Fais que mon espoir soit vivant. Ne permets pas que je désespère.`
};

MIROIR["71:14"] = {
  reference: "71:14",
  theme: ["création", "étapes", "réflexion"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Alors qu'Il vous a créés par étapes successives. » Le miroir me montre la création progressive. « Wa qad khalaqakum atwaran » — alors qu'Il vous a créés par étapes successives. La création est un processus. Le miroir m'interroge : est-ce que je réfléchis sur ma création ?`,
  reflection: `La création par étapes montre la sagesse d'Allah. Chaque étape a un sens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad khalaqakum atwaran » — alors qu'Il vous a créés par étapes successives." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réfléchis sur ma création ? Chaque étape de ma vie a-t-elle un sens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étapes de la création reflètent les étapes de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers évolue par étapes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les étapes comprend la sagesse." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé par étapes. Fais que je réfléchis sur chaque étape. Ne permets pas que je passe sans comprendre.`
};

MIROIR["71:15"] = {
  reference: "71:15",
  theme: ["cieux", "création", "réflexion"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« N'avez-vous pas vu comment Allah a créé sept cieux superposés ? » Le miroir me montre la grandeur de la création. « Alam taraw kayfa khalaqa Allahu sab'a samawatin tibaqan » — n'avez-vous pas vu comment Allah a créé sept cieux superposés ? La grandeur cosmique. Le miroir m'interroge : est-ce que je contemple les cieux ?`,
  reflection: `Les sept cieux superposés montrent la grandeur et l'ordre d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam taraw kayfa khalaqa Allahu sab'a samawatin tibaqan » — n'avez-vous pas vu comment Allah a créé sept cieux superposés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les cieux ? La grandeur cosmique m'impressionne-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur des cieux reflète la grandeur du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux sont le signe le plus visible de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les cieux trouve le Créateur." }
  ],
  munajat: `Ya Khaliq, les cieux manifestent Ta grandeur. Fais que je les contemple. Ne permets pas que je sois aveugle à Tes signes.`
};

MIROIR["71:16"] = {
  reference: "71:16",
  theme: ["lune", "soleil", "lumière"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Musawwir"],
  mirrorVersion: `« Et y a fait de la lune une lumière et du soleil une lampe. » Le miroir me montre les luminaires. « Wa ja'ala al-qamara fihinna nuran wa ja'ala al-shamsa sirajan » — et y a fait de la lune une lumière et du soleil une lampe. La lumière du soleil et la clarté de la lune. Le miroir m'interroge : est-ce que je remercie pour la lumière ?`,
  reflection: `Le soleil est une lampe et la lune une lumière. Chacun a sa fonction dans la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'ala al-qamara fihinna nuran wa ja'ala al-shamsa sirajan » — et y a fait de la lune une lumière et du soleil une lampe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour la lumière ? Le soleil et la lune me guident-ils vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière physique guide vers la lumière spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil et la lune sont des serviteurs d'Allah pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la lumière trouve la Lumière." }
  ],
  munajat: `Ya Nur, Tu as créé le soleil et la lune pour notre guidance. Fais que je T'en remercie. Ne permets pas que je sois ingrat pour la lumière.`
};

MIROIR["71:17"] = {
  reference: "71:17",
  theme: ["croissance", "terre", "création"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "An-Nabbi'"],
  mirrorVersion: `« Et Allah vous a fait croître de la terre comme des plantes. » Le miroir me montre l'origine végétale. « Wa Allahu anbatakum min al-ardi nabatan » — et Allah vous a fait croître de la terre comme des plantes. L'origine est la terre. Le miroir m'interroge : est-ce que je me souviens de mon origine ?`,
  reflection: `L'homme vient de la terre et y retourne. La croissance est comme celle des plantes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu anbatakum min al-ardi nabatan » — et Allah vous a fait croître de la terre comme des plantes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine ? La terre est-elle ma référence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine terrestre doit inspirer l'humilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie vient de la terre et y retourne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine ne s'enorgueillit pas." }
  ],
  munajat: `Ya Khaliq, je viens de la terre. Fais que je me souvienne de mon origine. Ne permets pas que l'orgueil m'élève au-dessus de ma réalité.`
};

MIROIR["71:18"] = {
  reference: "71:18",
  theme: ["retour", "terre", "résurrection"],
  emotion: "Humilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Mabda'"],
  mirrorVersion: `« Puis Il vous y fera retourner et vous en fera sortir. » Le miroir me montre le cycle complet. « Thumma yu'idukum fiha wa yukhrijukum ikhrajan » — puis Il vous y fera retourner et vous en fera sortir. Le cycle de la vie : venue, retour, sortie. Le miroir m'interroge : est-ce que je prépare mon retour ?`,
  reflection: `La terre est le lieu du départ et du retour. La résurrection est la sortie finale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yu'idukum fiha wa yukhrijukum ikhrajan » — puis Il vous y fera retourner et vous en fera sortir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare mon retour ? Ma sortie sera-t-elle facile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre accueille et libère selon la volonté d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de la vie est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le retour sort en paix." }
  ],
  munajat: `Ya Ba'ith, Tu me feras retourner à la terre puis m'en feras sortir. Prépare-moi pour ce retour. Ne permets pas que je sois surpris.`
};

MIROIR["71:19"] = {
  reference: "71:19",
  theme: ["terre", "tapis", "provision"],
  emotion: "Gratitude, confort",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Et Allah vous a fait de la terre un tapis. » Le miroir me montre la terre comme tapis. « Wa Allahu ja'ala lakumu al-arda bisatan » — et Allah vous a fait de la terre un tapis. La terre est notre espace de vie. Le miroir m'interroge : est-ce que je suis reconnaissant pour ce tapis ?`,
  reflection: `La terre est étendue comme un tapis pour notre confort et notre provision.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu ja'ala lakumu al-arda bisatan » — et Allah vous a fait de la terre un tapis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la terre ? Mon confort sur ce tapis m'oblige-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tapis de la terre demande un comportement digne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est le tapis de toute l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le tapis marche avec grâce." }
  ],
  munajat: `Ya Razzaq, Tu as fait de la terre un tapis pour moi. Fais que je sois reconnaissant. Ne permets pas que je sois ingrat pour ce confort.`
};

MIROIR["71:20"] = {
  reference: "71:20",
  theme: ["passages", "espaces", "provision"],
  emotion: "Gratitude, liberté",
  difficulty: "débutant",
  relatedNames: ["Al-Wasi'", "Ar-Razzaq"],
  mirrorVersion: `« Pour que vous vous y promeniez par ses larges espaces. » Le miroir me montre la liberté de mouvement. « Li-tasluku minha subulan fijajan » — pour que vous vous y promeniez par ses larges espaces. Les passages sont nombreux. Le miroir m'interroge : est-ce que j'utilise ces passages pour le bien ?`,
  reflection: `Les passages de la terre sont des opportunités. Comment je les utilise ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-tasluku minha subulan fijajan » — pour que vous vous y promeniez par ses larges espaces." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise ces passages pour le bien ? Ma liberté est-elle bien employée ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Les passages de la terre mènent vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un chemin vers le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise les passages pour le bien arrive à bon port." }
  ],
  munajat: `Ya Wasi', Tu as fait de la terre un espace de passage. Fais que je l'utilise pour le bien. Ne permets pas que je m'égare dans ces passages.`
};

MIROIR["71:21"] = {
  reference: "71:21",
  theme: ["désobéissance", "richesse", "égarement"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Ghani"],
  mirrorVersion: `« Noé dit : Seigneur ! Ils m'ont désobéi et ont suivi celui dont les richesses et les enfants n'ont fait qu'accroître la perte. » Le miroir me montre l'égarement par les richesses. « Qala Nuhun Rabbi innahum 'asawnī wa ittaba'u man lam yazidhu maluhu wa waladuhu illa khasaran » — Seigneur ! Ils m'ont désobéi et ont suivi celui dont les richesses et les enfants n'ont fait qu'accroître la perte. Les richesses sans guidance sont une perte. Le miroir m'interroge : mes richesses m'égarent-elles ?`,
  reflection: `Les richesses et les enfants sans foi sont une perte. L'égarement vient de l'attachement excessif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Nuhun Rabbi innahum 'asawnī wa ittaba'u man lam yazidhu maluhu wa waladuhu illa khasaran » — Seigneur ! Ils m'ont désobéi et ont suivi celui dont les richesses et les enfants n'ont fait qu'accroître la perte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes richesses m'égarent-elles ? Suis-je parmi ceux qui suivent les égarés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les richesses avec foi sont une bénédiction. Sans foi, elles sont une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens de ce monde sont un test." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui place les richesses au service d'Allah gagne." }
  ],
  munajat: `Ya Rabb, mes richesses ne sont une perte que si je m'y attache sans Toi. Fais qu'elles soient au service de ma foi. Ne permets pas qu'elles m'égarent.`
};

MIROIR["71:22"] = {
  reference: "71:22",
  theme: ["ruse", "complot", "mécréance"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Makir", "Al-Hakim"],
  mirrorVersion: `« Et ils ont ourdi un immense complot. » Le miroir me montre la ruse des mécréants. « Wa makaru makran kubbaran » — et ils ont ourdi un immense complot. Les mécréants complotent contre la vérité. Le miroir m'interroge : est-ce que je suis parmi ceux qui complotent ?`,
  reflection: `Le complot des mécréants est vain face à Allah. Sa ruse est plus grande.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa makaru makran kubbaran » — et ils ont ourdi un immense complot." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi ceux qui complotent ? Ou parmi ceux qui font confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La ruse des humains est impuissante face à celle d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le complot contre la vérité échoue toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah n'a pas besoin de ruse." }
  ],
  munajat: `Ya Hakim, je ne veux pas comploter. Fais que je fasse confiance à Toi. Ne permets pas que je sois parmi les ruses.`
};

MIROIR["71:23"] = {
  reference: "71:23",
  theme: ["idoles", "égarement", "persistance"],
  emotion: "Lucidité, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Et ils ont dit : N'abandonnez jamais vos divinités. » Le miroir me montre l'attachement aux idoles. « Wa qalu la tazarunna alihatikum » — et ils ont dit : N'abandonnez jamais vos divinités. L'attachement aux fausses divinités est persistant. Le miroir m'interroge : ai-je des idoles dans ma vie ?`,
  reflection: `Les idoles ne sont pas seulement des statues. Tout ce qui prend la place d'Allah est une idole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu la tazarunna alihatikum » — et ils ont dit : N'abandonnez jamais vos divinités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je des idoles dans ma vie ? Qu'est-ce qui prend la place d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon des idoles est le premier pas vers la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les idoles sont partout pour celui qui cherche autre qu'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne les idoles trouve Allah." }
  ],
  munajat: `Ya Wahid, je veux abandonner toutes mes idoles. Fais que Tu sois le seul dans mon cœur. Ne permets pas que je sois attaché aux fausses divinités.`
};

MIROIR["71:24"] = {
  reference: "71:24",
  theme: ["égarement", "injustice", "protection"],
  emotion: "Supplication, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muntaqim"],
  mirrorVersion: `« Ils en ont égaré beaucoup. Ne fais donc croître les injustes qu'en égarement. » Le miroir me montre la conséquence de l'égarement. « Wa qad adallu kathiran » — ils en ont égaré beaucoup. L'égarement se propage. Le miroir m'interroge : est-ce que je propage l'égarement ou la guidance ?`,
  reflection: `L'égarement d'un mène à l'égarement de beaucoup. La responsabilité est grande.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad adallu kathiran » — ils en ont égaré beaucoup." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je propage l'égarement ou la guidance ? Mon influence est-elle positive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance d'un peut guider beaucoup." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'influence est une responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide les autres est lui-même guidé." }
  ],
  munajat: `Ya Hadi, je ne veux pas égarer les autres. Fais que je sois une source de guidance. Ne permets pas que mon influence soit négative.`
};

MIROIR["71:25"] = {
  reference: "71:25",
  theme: ["châtiment", "noyade", "injustice"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« A cause de leurs péchés, ils furent noyés, puis on les fit entrer au Feu. » Le miroir me montre le châtiment final. « Mimma khatbayuhumughriqu fa-udkhilu naran » — à cause de leurs péchés, ils furent noyés, puis on les fit entrer au Feu. Le châtiment suit le péché. Le miroir m'interroge : est-ce que je crains ce châtiment ?`,
  reflection: `Le châtiment du peuple de Noé est un avertissement pour tous. Le péché a des conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mimma khatbayuhimughriqu fa-udkhilu naran » — à cause de leurs péchés, ils furent noyés, puis on les fit entrer au Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce châtiment ? Mes péchés mèneront-ils à une fin pareille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment est la conséquence du choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau qui sauve peut aussi châtier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent évite le châtiment." }
  ],
  munajat: `Ya Jabbar, je crains Ton châtiment. Préserve-mi de la noyade et du Feu. Fais que je me repente avant qu'il ne soit trop tard.`
};

MIROIR["71:26"] = {
  reference: "71:26",
  theme: ["supplication", "mécréants", "anéantissement"],
  emotion: "Supplication, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-Qadir"],
  mirrorVersion: `« Et Noé dit : Seigneur ! Ne laisse sur terre aucun mécréant. » Le miroir me montre la supplication de Noé. « Qala Nuhun Rabbi la tazar 'ala al-ardi mina al-kafirina dayyaran » — Seigneur ! Ne laisse sur terre aucun mécréant. La supplication est radicale. Le miroir m'interroge : est-ce que je supplie Allah avec sérieux ?`,
  reflection: `La supplication de Noé vient après des siècles de rejet. La justice demande l'anéantissement du mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Nuhun Rabbi la tazar 'ala al-ardi mina al-kafirina dayyaran » — Seigneur ! Ne laisse sur terre aucun mécréant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je supplie Allah avec sérieux ? Ma supplication est-elle radicale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La supplication radicale vient de la connaissance de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine anéantit le mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le mal prie pour son anéantissement." }
  ],
  munajat: `Ya Qadir, je Te supplie de ne pas laisser le mécréant sur terre. Fais que justice soit faite. Ne permets pas que le mal triomphe.`
};

MIROIR["71:27"] = {
  reference: "71:27",
  theme: ["égarement", "captifs", "protection"],
  emotion: "Supplication, protection",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Wali"],
  mirrorVersion: `« Car si Tu les laisses, ils égareront Tes serviteurs et n'engendreront que des pécheurs et des mécréants. » Le miroir me montre la raison de la supplication. « Innaka in tazarhum yudillu 'ibadaka » — car si Tu les laisses, ils égareront Tes serviteurs. L'égarement se propage par les mécréants. Le miroir m'interroge : est-ce que je demande protection contre l'égarement ?`,
  reflection: `Les mécréants égarent les croyants. La protection est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka in tazarhum yudillu 'ibadaka » — car si Tu les laisses, ils égareront Tes serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande protection contre l'égarement ? Suis-je protégé de l'influence des mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection contre l'égarement est un don divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'égarement se propage comme une maladie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande protection est protégé." }
  ],
  munajat: `Ya Wali, protège-moi de l'égarement des mécréants. Ne permets pas que leur influence m'atteigne. Donne-moi Ta protection.`
};

MIROIR["71:28"] = {
  reference: "71:28",
  theme: ["pardon", "parents", "foi"],
  emotion: "Supplication, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahman"],
  mirrorVersion: `« Seigneur ! Pardonne-moi, à mes parents, à ceux qui entrent dans ma maison en croyant. » Le miroir me montre la supplication pour le pardon. « Rabbi ghfir li wa li-walidayya wa li-man dakhala baytiya mu'minan » — Seigneur ! Pardonne-moi, à mes parents, à ceux qui entrent dans ma maison en croyant. Le pardon est demandé pour soi et les autres. Le miroir m'interroge : est-ce que je demande pardon pour les autres ?`,
  reflection: `Le pardon demandé pour soi doit inclure les parents et les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi ghfir li wa li-walidayya wa li-man dakhala baytiya mu'minan » — Seigneur ! Pardonne-moi, à mes parents, à ceux qui entrent dans ma maison en croyant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande pardon pour les autres ? Inclus-je mes parents dans mes supplications ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon pour les autres précède le pardon pour soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pardon divin embrasse ceux qui se pardonnnent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande pardon pour les autres est pardonné." }
  ],
  munajat: `Ya Ghaffur, pardonne-moi, à mes parents, et à tous les croyants. Accorde-nous Ton pardon. Ne permets pas que nous soyons privés de Ta miséricorde.`
};

// ==================== SURAH 34: SABA (54 verses) - COMPLETE COVERAGE ====================

MIROIR["34:2"] = {
  reference: "34:2",
  theme: ["louange", "omniscience", "royauté"],
  emotion: "Révérence, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hamid", "Al-Malik"],
  mirrorVersion: `« La louange appartient à Allah à Qui appartient tout ce qui est dans les cieux et sur la terre. » Le miroir me montre l'étendue de la louange. « Al-hamdu lillahi » — la louange appartient à Allah. Toute louange Lui revient. « Ma fi al-samawati wa ma fi al-ard » — tout ce qui est dans les cieux et sur la terre. Tout Lui appartient. Le miroir m'invite à la louange constante.`,
  reflection: `Toute louange appartient à Allah. Tout ce qui existe Lui appartient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hamdu lillahi alladhi lahu ma fi al-samawati wa ma fi al-ard » — la louange appartient à Allah à Qui appartient tout ce qui est dans les cieux et sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je loue Allah pour tout ? Est-ce que je reconnais que tout Lui appartient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange est le chemin vers la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers loue Allah par son existence même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue Allah découvre que tout est don." }
  ],
  munajat: `Ya Hamid, je Te loue pour tout. Fais que ma louange soit constante. Ne permets pas que j'oublie de Te remercier.`
};

MIROIR["34:4"] = {
  reference: "34:4",
  theme: ["récompense", "croyants", "gratitude"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Jazil", "Al-Shakur"],
  mirrorVersion: `« Afin qu'Il récompense ceux qui croient et font les bonnes œuvres. » Le miroir me montre la promesse de récompense. « Li-yajziya alladhina amanu wa 'amilu al-salihat » — afin qu'Il récompense ceux qui croient et font les bonnes œuvres. La foi et l'action vont ensemble. Le miroir m'interroge : ma foi produit-elle des œuvres ?`,
  reflection: `La foi sans œuvres est incomplète. La récompense suit la foi active.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yajziya alladhina amanu wa 'amilu al-salihat » — afin qu'Il récompense ceux qui croient et font les bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi produit-elle des œuvres ? Est-ce que je travaille pour ma récompense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les œuvres sont le fruit de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers produit selon sa nature. La foi produit des œuvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit selon sa foi reçoit sa récompense." }
  ],
  munajat: `Ya Jazil, je veux croire et agir. Donne-moi la récompense promise. Ne permets pas que ma foi reste stérile.`
};

MIROIR["34:5"] = {
  reference: "34:5",
  theme: ["opposition", "châtiment", "perseverance"],
  emotion: "Gravité, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Et ceux qui s'efforcent de rendre Nos versets inefficaces, ceux-là auront un châtiment douloureux. » Le miroir me montre la conséquence de l'opposition. « Sa'aw fi ayatina » — s'efforcent de rendre Nos versets inefficaces. L'opposition active au message divin. « 'Adhabun min rijz » — un châtiment douloureux. La conséquence est terrible. Le miroir m'avertit : ne pas s'opposer au message.`,
  reflection: `S'opposer au message divin attire un châtiment douloureux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina sa'aw fi ayatina mu'ajizina ula'ika lahum 'adhabun min rijz » — et ceux qui s'efforcent de rendre Nos versets inefficaces, ceux-là auront un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'oppose au message d'Allah ? Ou est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accepter le message est le contraire de s'y opposer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne s'oppose pas à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message évite le châtiment." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message. Ne permets pas que je m'y oppose. Protège-moi du châtiment des opposants.`
};

MIROIR["34:6"] = {
  reference: "34:6",
  theme: ["science", "révélation", "reconnaissance"],
  emotion: "Révérence, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Haqq"],
  mirrorVersion: `« Ceux à qui le savoir a été donné voient que ce qui t'est révélé est la vérité venant de ton Seigneur. » Le miroir me montre le lien entre savoir et reconnaissance. « Uta' al-'ilm » — ceux à qui le savoir a été donné. Le savoir mène à la vérité. « Yarawnahu haqqan » — voient que c'est la vérité. La vue spirituelle vient du savoir. Le miroir m'interroge : mon savoir mène-t-il à la vérité ?`,
  reflection: `Le savoir véritable mène à la reconnaissance de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yara alladhina utu al-'ilm alladhi unzila ilayka min rabbika haqqan » — ceux à qui le savoir a été donné voient que ce qui t'est révélé est la vérité venant de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon savoir mène-t-il à la vérité ? Est-ce que je reconnais la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le savoir sans reconnaissance est ignorance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers connaît son Créateur par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait vraiment reconnaît la vérité." }
  ],
  munajat: `Ya 'Alim, donne-moi le savoir qui mène à la vérité. Fais que je reconnaisse Ta révélation. Ne permets pas que mon savoir reste stérile.`
};

MIROIR["34:7"] = {
  reference: "34:7",
  theme: ["résurrection", "incrédulité", "promesse"],
  emotion: "Défi, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ba'ith", "Al-Haqq"],
  mirrorVersion: `« Ceux qui ont mécru disent : 'Voulons-vous que nous vous indiquions un homme qui vous annonce que vous serez désintégrés ?' » Le miroir me montre le défi des mécréants. « Narikum rajulan » — vous indiquions un homme. Le défi personnel. « Yukhbirukum » — qui vous annonce. La bonne nouvelle est devenue dérision. Le miroir m'interroge : comment je réagis aux annonces divines ?`,
  reflection: `Les mécréants se moquent de la résurrection. Les croyants l'attendent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qal alladhina kafaru hal nadullukum 'ala rajulin yukhbirukum idha muzziqtum kulla mumazzaqin » — ceux qui ont mécru disent : voulons-vous que nous vous indiquions un homme qui vous annonce que vous serez désintégrés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux annonces divines ? Avec foi ou avec moquerie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est une vérité même si les mécréants s'en moquent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne du cycle de la mort et de la renaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la résurrection prépare son retour." }
  ],
  munajat: `Ya Ba'ith, je crois à la résurrection. Ne permets pas que je me moque de Ta promesse. Prépare-moi à mon retour.`
};

MIROIR["34:8"] = {
  reference: "34:8",
  theme: ["mensonge", "prophète", "châtiment"],
  emotion: "Indignation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sadiq", "Al-Haqq"],
  mirrorVersion: `« A-t-il forgé un mensonge contre Allah ou y a-t-il en lui de la folie ? » Le miroir me montre l'accusation contre le Prophète. « Iftara 'ala Allahi kadhiban » — a-t-il forgé un mensonge contre Allah ? L'accusation est grave. « Am bihi jinnah » — ou y a-t-il en lui de la folie ? La folie est l'autre explication. Le miroir défend le Prophète : il est véridique.`,
  reflection: `Les mécréants accusent le Prophète de mensonge ou de folie. Il est véridique et sain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afatara 'ala Allahi kadhiban am bihi jinnah » — a-t-il forgé un mensonge contre Allah ou y a-t-il en lui de la folie ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défends le Prophète contre les accusations ? Est-ce que je le crois véridique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète est véridique. Ses accusateurs sont les menteurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la véracité du message." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend le Prophète défend la vérité." }
  ],
  munajat: `Ya Haqq, je crois que Ton Prophète est véridique. Défends-le contre les accusations. Ne permets pas que je doute de lui.`
};

MIROIR["34:10"] = {
  reference: "34:10",
  theme: ["David", "bénédiction", "montagne"],
  emotion: "Émerveillement, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mannan", "Al-Jibal"],
  mirrorVersion: `« Nous avons certes donné à David une grâce de Nous. Ô montagnes, répétez avec lui les louanges ! » Le miroir me montre la grâce accordée à David. « Aatayna Dawuda minna fadlan » — Nous avons donné à David une grâce de Nous. La grâce divine. « Ya jibal awwibi ma'ahu » — ô montagnes, répétez avec lui les louanges. La nature participe à la louange. Le miroir m'invite à la louange avec la création.`,
  reflection: `La grâce d'Allah à David inclut la participation de la nature à sa louange.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad atayna Dawuda minna fadlan ya jibal awwibi ma'ahu » — Nous avons certes donné à David une grâce de Nous. Ô montagnes, répétez avec lui les louanges !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je loue Allah avec la création ? Est-ce que je reconnais Sa grâce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange avec la création élève la louange." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes louent Allah à leur manière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue avec la création découvre l'harmonie universelle." }
  ],
  munajat: `Ya Rabb, je loue avec Tes montagnes. Fais que ma louange s'harmonise avec la création. Ne permets pas que je loue seul.`
};

MIROIR["34:11"] = {
  reference: "34:11",
  theme: ["armure", "travail", "excellence"],
  emotion: "Inspiration, excellence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Musawwir", "Al-Asbab"],
  mirrorVersion: `« Et aux oiseaux assemblées. Nous avons pour lui ramolli le fer : 'Fabrique des cottes de mailles et calcule bien les mailles.' » Le miroir me montre le travail exquis. « Saddafna lahu al-hadid » — Nous avons pour lui ramolli le fer. Le fer devient malléable. « Wa qaddir fi al-sardi » — calcule bien les mailles. L'excellence dans le travail. Le miroir m'invite à l'excellence dans mes œuvres.`,
  reflection: `Le travail exquis demande de l'excellence et du calcul précis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa saddafna lahu al-hadid an i'mal salighatin wa qaddir fi al-sardi » — et Nous avons pour lui ramolli le fer : fabrique des cottes de mailles et calcule bien les mailles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille avec excellence ? Est-ce que je calcule bien mes œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excellence dans le travail est une forme d'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne avec précision et excellence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille avec excellence honore son Créateur." }
  ],
  munajat: `Ya Musawwir, enseigne-moi l'excellence. Fais que mes œuvres soient précises. Ne permets pas que je travaille avec négligence.`
};

MIROIR["34:12"] = {
  reference: "34:12",
  theme: ["Salomon", "vent", "jinn"],
  emotion: "Émerveillement, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Riyah", "Al-Jinn"],
  mirrorVersion: `« Et à Salomon le vent, dont le parcours matin est d'un mois et le parcours soir d'un mois. » Le miroir me montre la maîtrise du vent. « Li-Sulaymana al-rih » — et à Salomon le vent. Le vent obéit à Salomon. « Ghuduwwuha shahrun wa rawahuha shahrun » — le parcours matin est d'un mois et le parcours soir d'un mois. La distance est immense. Le miroir m'émerveille devant la puissance d'Allah.`,
  reflection: `Le vent obéit à Salomon. La puissance d'Allah est merveilleuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-Sulaymana al-rih ghuduwwuha shahrun wa rawahuha shahrun » — et à Salomon le vent, dont le parcours matin est d'un mois et le parcours soir d'un mois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'émerveille devant la puissance d'Allah ? Est-ce que je reconnais Ses grâces ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La maîtrise du vent est un don, pas un droit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vent souffle où Allah le dirige." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les dons reçoit plus de dons." }
  ],
  munajat: `Ya Rabb, je m'émerveille de Tes dons. Fais que je les reconnaisse. Ne permets pas que je les prenne pour acquis.`
};

MIROIR["34:13"] = {
  reference: "34:13",
  theme: ["jinn", "travail", "obéissance"],
  emotion: "Émerveillement, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jinn", "Al-Musawwir"],
  mirrorVersion: `« Ils faisaient pour lui ce qu'il voulait : sanctuaires, statues, plateaux comme des bassins, marmites ancrées. » Le miroir me montre l'obéissance des jinn. « Ya'maluna lahu ma yasha'u » — ils faisaient pour lui ce qu'il voulait. L'obéissance totale. « Mahariba wa tamathila » — sanctuaires et statues. L'art est au service de la royauté. Le miroir m'invite à l'obéissance à Allah comme les jinn obéissaient à Salomon.`,
  reflection: `Les jinn obéissaient à Salomon. Nous devons obéir à Allah avec la même diligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'maluna lahu ma yasha'u min maharib wa tamathila » — ils faisaient pour lui ce qu'il voulait : sanctuaires, statues." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis à Allah avec la même diligence que les jinn obéissaient à Salomon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance à Allah dépasse l'obéissance à tout autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah par sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit à Allah parfaitement Lui plaît." }
  ],
  munajat: `Ya Rabb, je veux T'obéir parfaitement. Fais que mon obéissance soit complète. Ne permets pas que je désobéisse.`
};

MIROIR["34:14"] = {
  reference: "34:14",
  theme: ["mort", "pouvoir", "leçon"],
  emotion: "Humilité, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Baqi"],
  mirrorVersion: `« Puis, quand Nous décrétâmes sa mort, il n'y eut pour les mettre en garde contre sa mort que la termite qui rongeait sa canne. » Le miroir me montre la fragilité du pouvoir humain. « Qadayna 'alayhi al-mawt » — quand Nous décrétâmes sa mort. La mort atteint même les rois. « Ma dallahum 'ala mawtihi illa dabbat al-ard » — il n'y eut pour les mettre en garde que la termite. Le pouvoir s'effondre avec la mort. Le miroir m'avertit : le pouvoir est temporaire.`,
  reflection: `La mort atteint même les rois puissants. Le pouvoir s'effondre avec la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma qadayna 'alayhi al-mawt ma dallahum 'ala mawtihi illa dabbat al-ard » — puis, quand Nous décrétâmes sa mort, il n'y eut pour les mettre en garde contre sa mort que la termite qui rongeait sa canne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la fragilité de mon pouvoir ? Est-ce que je prépare ma mort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort est le grand égalisateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est soumis au cycle de la mort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa mort meurt en paix." }
  ],
  munajat: `Ya Mumit, je prépare ma mort. Fais que je ne m'attache pas au pouvoir temporaire. Donne-moi la mort en paix.`
};

MIROIR["34:16"] = {
  reference: "34:16",
  theme: ["ingratitude", "châtiment", "leçon"],
  emotion: "Tristesse, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Mais ils se détournèrent. Alors Nous envoyâmes contre eux l'inondation du barrage. » Le miroir me montre la conséquence de l'ingratitude. « Fa-a'rada » — mais ils se détournèrent. L'ingratitude suit la grâce. « Sayl al-'arim » — l'inondation du barrage. Le châtiment suit l'ingratitude. Le miroir m'avertit : l'ingratitude attire le retrait de la grâce.`,
  reflection: `L'ingratitude attire le retrait de la grâce. Le châtiment suit le détournement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-a'rada fasayyarna 'alayhim sayl al-'arim » — mais ils se détournèrent. Alors Nous envoyâmes contre eux l'inondation du barrage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant ? Est-ce que je risque le retrait de la grâce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude maintient la grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne à ceux qui reçoivent avec gratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant préserve ce qu'il a." }
  ],
  munajat: `Ya Mannan, je suis reconnaissant. Ne permets pas que je me détourne. Préserve mes grâces par ma gratitude.`
};

MIROIR["34:17"] = {
  reference: "34:17",
  theme: ["châtiment", "ingratitude", "remplacement"],
  emotion: "Gravité, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mubdi", "Al-Mu'id"],
  mirrorVersion: `« Ainsi les rétribuâmes-Nous pour leur ingratitude. Ne rétribuons-Nous ainsi que les ingrats. » Le miroir me montre la loi de la rétribution. « Jazaynahum » — ainsi les rétribuâmes-Nous. La rétribution est certaine. « Bima kafaru » — pour leur ingratitude. L'ingratitude attire le châtiment. Le miroir m'avertit : l'ingratitude n'est pas sans conséquence.`,
  reflection: `L'ingratitude attire le châtiment. La rétribution est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika jazaynahum bima kafaru » — ainsi les rétribuâmes-Nous pour leur ingratitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis ingrat ? Est-ce que je risque la rétribution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude évite le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rétribue selon les actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'ingratitude évite le châtiment." }
  ],
  munajat: `Ya Rabb, je veux être reconnaissant. Évite-moi le châtiment des ingrats. Ne permets pas que l'ingratitude s'installe.`
};

MIROIR["34:18"] = {
  reference: "34:18",
  theme: ["voyage", "nuit", "facilité"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Muyassir", "Al-Hadi"],
  mirrorVersion: `« Et Nous plaçâmes entre eux et les cités que Nous avons bénies, des cités apparentes. » Le miroir me montre la facilité du voyage. « Ja'alna baynahum wa bayna al-qura » — et Nous plaçâmes entre eux et les cités. Les étapes sont mesurées. « Quran zahiratan » — des cités apparentes. Le voyage est facile. Le miroir m'invite à reconnaître les facilités d'Allah.`,
  reflection: `Les étapes du voyage sont mesurées et apparentes. La facilité est une grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna baynahum wa bayna al-qura allati barakna fiha quran zahiratan » — et Nous plaçâmes entre eux et les cités que Nous avons bénies, des cités apparentes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les facilités d'Allah dans mon voyage de vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du voyage est une grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers facilite le voyage de ceux qui voyagent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les facilités voyage avec gratitude." }
  ],
  munajat: `Ya Muyassir, Tu facilites mon voyage. Je suis reconnaissant. Fais que je voyage avec gratitude.`
};

MIROIR["34:19"] = {
  reference: "34:19",
  theme: ["plainte", "distance", "ingratitude"],
  emotion: "Tristesse, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Hakim"],
  mirrorVersion: `« Ils dirent : 'Seigneur, allonge nos distances !' Ils se firent tort à eux-mêmes. » Le miroir me montre l'ingratitude sous forme de plainte. « Rabbi ba'id bayna asfarina » — Seigneur, allonge nos distances. La demande d'éloignement. « Zalamu anfusahum » — ils se firent tort à eux-mêmes. La plainte est un tort. Le miroir m'avertit : ne pas se plaindre des facilités.`,
  reflection: `Se plaindre des facilités est une ingratitude qui attire le tort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu rabbana ba'id bayna asfarina wa zalamu anfusahum » — ils dirent : Seigneur, allonge nos distances ! Ils se firent tort à eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me plains des facilités d'Allah ? Est-ce que je me fais tort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance attire plus de facilités." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se plaint pas de ses arrangements." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se plaint perd ce qu'il a." }
  ],
  munajat: `Ya Rabb, je ne veux pas me plaindre. Fais que je sois reconnaissant pour mes facilités. Ne permets pas que je me fasse tort.`
};

MIROIR["34:20"] = {
  reference: "34:20",
  theme: ["Satan", "tentation", "vérification"],
  emotion: "Vigilance, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shaytan", "Al-Mumtahin"],
  mirrorVersion: `« Satan a effectivement confirmé sa conjecture à leur sujet. Ils l'ont suivi, sauf un groupe parmi les croyants. » Le miroir me montre le succès de Satan. « Saddaqa 'alayhim Iblisu zannahu » — Satan a confirmé sa conjecture. La tentation réussit. « Wa ma kana lahum 'alayhim min sultan » — il n'avait pas de pouvoir sur eux. Le pouvoir est dans le choix. Le miroir m'avertit : Satan n'a pas de pouvoir, mais il tente.`,
  reflection: `Satan tente mais n'a pas de pouvoir forcé. Le choix appartient à l'homme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad saddaqa 'alayhim Iblisu zannahu wa ittaba'uhu illa farigan mina al-mu'minin » — Satan a effectivement confirmé sa conjecture à leur sujet. Ils l'ont suivi, sauf un groupe parmi les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis Satan ou est-ce que je lui résiste ? Mon choix détermine mon sort." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Résister à Satan est le choix du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas la tentation de Satan." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui résiste à Satan découvre sa force." }
  ],
  munajat: `Ya Rabb, je résiste à Satan. Fortifie-moi contre sa tentation. Ne permets pas que je le suive.`
};

MIROIR["34:21"] = {
  reference: "34:21",
  theme: ["pouvoir", "tentation", "épreuve"],
  emotion: "Vigilance, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sultan", "Al-Mumtahin"],
  mirrorVersion: `« Il n'avait sur eux aucun pouvoir si ce n'est que Nous voulions distinguer celui qui croit en l'au-delà de celui qui doute. » Le miroir me montre le but de la tentation. « Ma kana lahu 'alayhim min sultan » — il n'avait sur eux aucun pouvoir. Le pouvoir est à Allah. « Illa li-na'lama » — si ce n'est que Nous voulions distinguer. La distinction est le but. Le miroir m'avertit : la tentation est une épreuve.`,
  reflection: `La tentation est une épreuve pour distinguer les croyants des douteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana lahu 'alayhim min sultan illa li-na'lama man yu'minu bi-al-akhirati » — il n'avait sur eux aucun pouvoir si ce n'est que Nous voulions distinguer celui qui croit en l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la tentation ? Suis-je distingué comme croyant ou comme douteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve révèle la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est épreuve et distingue par sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'épreuve la traverse avec succès." }
  ],
  munajat: `Ya Mumtahin, je veux passer l'épreuve. Distingue-moi comme croyant. Ne permets pas que je sois du nombre des douteurs.`
};

MIROIR["34:22"] = {
  reference: "34:22",
  theme: ["idoles", "intercession", "impuissance"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Qadir"],
  mirrorVersion: `« Dis : 'Invoquez ceux que vous prétendez en dehors d'Allah. Ils ne possèdent ni le poids d'un atome ni dans les cieux ni sur la terre.' » Le miroir me montre l'impuissance des idoles. « Ud'u alladhina za'amtum » — invoquez ceux que vous prétendez. L'invocation des faux dieux. « Ma lahum min mithqali dharrah » — ils ne possèdent ni le poids d'un atome. L'impuissance totale. Le miroir m'invite à invoquer Allah seul.`,
  reflection: `Les idoles ne possèdent rien. Seul Allah mérite l'invocation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul id'u alladhina za'amtum min duni Allahi ma lahum min mithqali dharrah » — dis : invoquez ceux que vous prétendez en dehors d'Allah. Ils ne possèdent ni le poids d'un atome." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'invoque en dehors d'Allah ? Ces choses possèdent-elles quelque chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Invoquer Allah seul est le chemin de la puissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a de puissance que par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul découvre Sa puissance." }
  ],
  munajat: `Ya Wahid, je T'invoque Toi seul. Ne permets pas que j'invoque les impuissants. Donne-moi Ta puissance.`
};

MIROIR["34:23"] = {
  reference: "34:23",
  theme: ["intercession", "permission", "autorité"],
  emotion: "Révérence, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shafi'", "Al-Mu'in"],
  mirrorVersion: `« L'intercession auprès de Lui ne profite qu'à celui en faveur de qui Il permet. » Le miroir me montre les conditions de l'intercession. « La tanfa'u al-shafa'atu 'indahu illa li-man adhina lahu » — l'intercession ne profite qu'à celui en faveur de qui Il permet. La permission divine précède l'intercession. Le miroir m'enseigne que tout passe par la permission d'Allah.`,
  reflection: `L'intercession nécessite la permission d'Allah. Rien ne se fait sans Son autorisation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tanfa'u al-shafa'atu 'indahu illa li-man adhina lahu » — l'intercession auprès de Lui ne profite qu'à celui en faveur de qui Il permet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur l'intercession ou est-ce que je cherche la permission d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission d'Allah précède tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par la permission divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la permission divine respecte Son autorité." }
  ],
  munajat: `Ya Rabb, je cherche Ta permission. Accorde-moi l'intercession par Ta grâce. Ne permets pas que je compte sur autre que Toi.`
};

MIROIR["34:24"] = {
  reference: "34:24",
  theme: ["provision", "générosité", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Dis : 'Qui vous nourrit du ciel et de la terre ?' Dis : 'Allah.' » Le miroir me montre la source de la provision. « Man yarzuqukum » — qui vous nourrit. La question est rhétorique. « Mina al-sama'i wa al-ard » — du ciel et de la terre. La provision vient de partout. « Allah » — c'est la réponse unique. Le miroir m'invite à la gratitude envers le Pourvoyeur.`,
  reflection: `Allah est le seul Pourvoyeur. La provision vient du ciel et de la terre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul man yarzuqukum mina al-sama'i wa al-ardi quli Allah » — dis : qui vous nourrit du ciel et de la terre ? Dis : Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie Allah pour ma provision ? Est-ce que je reconnais Sa source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la source attire plus de provision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est nourri par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Pourvoyeur ne manque de rien." }
  ],
  munajat: `Ya Razzaq, Tu me nourris. Je suis reconnaissant. Ne permets pas que j'oublie Ta source.`
};

MIROIR["34:25"] = {
  reference: "34:25",
  theme: ["responsabilité", "indépendance", "compte"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Mas'ul"],
  mirrorVersion: `« Dis : 'Vous ne serez pas interrogés sur nos crimes, et nous ne serons pas interrogés sur ce que vous faites.' » Le miroir me montre l'indépendance des comptes. « La tus'aluna » — vous ne serez pas interrogés. L'interrogatoire est personnel. « 'Amma naktub » — sur nos crimes. Chacun porte ses propres fautes. Le miroir m'enseigne la responsabilité individuelle.`,
  reflection: `Chacun est responsable de ses propres actes. L'interrogatoire est personnel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul la tus'aluna 'amma ajramna wa la nusalu 'amma ta'malun » — dis : vous ne serez pas interrogés sur nos crimes, et nous ne serons pas interrogés sur ce que vous faites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise ma responsabilité individuelle ? Est-ce que je prépare mon compte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité individuelle évite la confusion collective." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque élément de l'univers répond de sa fonction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité la prépare." }
  ],
  munajat: `Ya Mas'ul, je prépare mon compte. Ne permets pas que je compte sur les autres. Donne-moi la clarté de ma responsabilité.`
};

MIROIR["34:26"] = {
  reference: "34:26",
  theme: ["jugement", "équité", "rassemblement"],
  emotion: "Espérance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Dis : 'Notre Seigneur nous réunira, puis Il tranchera entre nous avec la vérité.' » Le miroir me montre le rassemblement final. « Yajma'u baynana » — notre Seigneur nous réunira. Le rassemblement est certain. « Fa-yafsil baynana bi-al-haqq » — puis Il tranchera entre nous avec la vérité. Le jugement est équitable. Le miroir m'invite à la confiance dans le jugement divin.`,
  reflection: `Le rassemblement et le jugement sont certains. La vérité prévaudra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul yajma'u baynana rabbuna thumma yafsil baynana bi-al-haqq » — dis : notre Seigneur nous réunira, puis Il tranchera entre nous avec la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare le rassemblement ? Est-ce que je fais confiance au jugement divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement avec vérité est le meilleur jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera rassemblé pour le jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance au jugement le traverse en paix." }
  ],
  munajat: `Ya Hakam, je fais confiance à Ton jugement. Prépare-moi au rassemblement. Juge-moi avec Ta vérité.`
};

MIROIR["34:27"] = {
  reference: "34:27",
  theme: ["association", "preuve", "tawhid"],
  emotion: "Clarté, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Burhan"],
  mirrorVersion: `« Dis : 'Montrez-moi ceux que vous Lui avez associés !' Mais non ! C'est Lui Allah, le Puissant, le Sage. » Le miroir me montre l'impossibilité de l'association. « Aruni » — montrez-moi. Le défi est lancé. « Alladhina adhaltum bihi » — ceux que vous Lui avez associés. L'association est dévoilée. « Bal huwa Allah » — mais non ! C'est Lui Allah. La vérité est claire. Le miroir m'invite au tawhid pur.`,
  reflection: `L'association est impossible à prouver. Allah est le seul Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul aruni alladhina adhaltum bihi shuraka' » — dis : montrez-moi ceux que vous Lui avez associés !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'associe quelque chose à Allah ? Est-ce que mon tawhid est pur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tawhid pur est le contraire de l'association." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de l'unicité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a le tawhid pur a tout." }
  ],
  munajat: `Ya Wahid, je purifie mon tawhid. Ne permets pas que je T'associe quoi que ce soit. Donne-moi la pureté de l'unicité.`
};

MIROIR["34:28"] = {
  reference: "34:28",
  theme: ["mission", "universalité", "annonce"],
  emotion: "Responsabilité, portée",
  difficulty: "débutant",
  relatedNames: ["Al-Mursal", "Al-Bashir"],
  mirrorVersion: `« Et Nous ne t'avons envoyé qu'aux hommes tous ensemble, porteur de bonne nouvelle et avertisseur. » Le miroir me montre l'universalité du message. « Illa kaffatan » — qu'aux hommes tous ensemble. Le message est pour tous. « Bashiran wa nadhiran » — porteur de bonne nouvelle et avertisseur. Les deux fonctions. Le miroir m'invite à reconnaître la portée du message.`,
  reflection: `Le message du Prophète est universel. Il est bonne nouvelle et avertissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalnaka illa kaffatan li-al-nasi bashiran wa nadhiran » — et Nous ne t'avons envoyé qu'aux hommes tous ensemble, porteur de bonne nouvelle et avertisseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'universalité du message ? Est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne nouvelle et l'avertissement sont deux faces du même message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message universel s'adresse à toute l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message universel fait partie de la communauté universelle." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message universel. Fais que je l'entende comme bonne nouvelle et avertissement. Ne permets pas que je le rejette.`
};

MIROIR["34:29"] = {
  reference: "34:29",
  theme: ["promesse", "question", "impatience"],
  emotion: "Attente, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'ud", "Al-Sa'ah"],
  mirrorVersion: `« Et ils disent : 'Quand cette promesse, si vous êtes véridiques ?' » Le miroir me montre l'impatience des mécréants. « Mata hadha al-wa'du » — quand cette promesse. L'impatience du châtiment. « In kuntum sadiqin » — si vous êtes véridiques. Le défi est lancé. Le miroir m'avertit : ne pas défier la promesse d'Allah.`,
  reflection: `Les mécréants défient la promesse d'Allah par leur impatience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — et ils disent : quand cette promesse, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défie la promesse d'Allah ? Ou est-ce que je l'attends avec patience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attente patiente est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend patiemment l'accomplissement des promesses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend patiemment la promesse la voit s'accomplir." }
  ],
  munajat: `Ya Wa'ud, j'attends Ta promesse avec patience. Ne permets pas que je la défie. Donne-moi la patience dans l'attente.`
};

MIROIR["34:30"] = {
  reference: "34:30",
  theme: ["heure", "imminence", "fuite"],
  emotion: "Urgence, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Sa'ah", "Al-Muhit"],
  mirrorVersion: `« Dis : 'Pour vous, le rendez-vous est d'un jour que vous ne sauriez retarder ni avancer d'un instant.' » Le miroir me montre la précision de l'Heure. « Maw'idukum yawm » — pour vous, le rendez-vous est d'un jour. Le jour est fixé. « La tasta'khiruna 'anhu sa'atan » — que vous ne sauriez retarder ni avancer d'un instant. La précision est absolue. Le miroir m'avertit : l'Heure est précise.`,
  reflection: `L'Heure est fixée avec précision. Nul ne peut la retarder ni l'avancer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul lakum maw'idukum yawman la tasta'khiruna 'anhu sa'atan wa la taqdamun » — dis : pour vous, le rendez-vous est d'un jour que vous ne sauriez retarder ni avancer d'un instant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare ce rendez-vous ? Est-ce que je réalise sa précision ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le rendez-vous est le signe de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a son rendez-vous qui ne peut être changé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare le rendez-vous le rencontre en paix." }
  ],
  munajat: `Ya Sa'ah, je prépare le rendez-vous. Fais que je ne sois pas pris au dépourvu. Donne-moi la préparation constante.`
};

MIROIR["34:31"] = {
  reference: "34:31",
  theme: ["mécréance", "regret", "soumission"],
  emotion: "Gravité, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Hakim"],
  mirrorVersion: `« Et ceux qui ont mécru dirent : 'Nous ne croirons pas en ce Coran ni dans ce qui l'a précédé.' » Le miroir me montre le rejet total. « Lan nu'mina bi-hadha al-Qur'an » — nous ne croirons pas en ce Coran. Le rejet du présent. « Wa la fi alladhi bayna yadayhi » — ni dans ce qui l'a précédé. Le rejet du passé. Le miroir m'avertit : le rejet total attire le châtiment total.`,
  reflection: `Le rejet total du message attire le châtiment total.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qal alladhina kafaru lan nu'mina bi-hadha al-Qur'an wa la fi alladhi bayna yadayhi » — et ceux qui ont mécru dirent : nous ne croirons pas en ce Coran ni dans ce qui l'a précédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette le message ? Ou est-ce que je l'accepte entièrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation totale est le contraire du rejet total." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a jamais rejeté le message de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte entièrement le message est guidé entièrement." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message entièrement. Ne permets pas que je le rejette. Guide-moi entièrement.`
};

MIROIR["34:32"] = {
  reference: "34:32",
  theme: ["responsabilité", "excuse", "leadership"],
  emotion: "Vérité, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mas'ul", "Al-Hisab"],
  mirrorVersion: `« Et ceux qui furent hautains diront à ceux qui furent faibles : 'Est-ce nous qui vous avons détournés de la guidance ?' » Le miroir me montre le rejet de responsabilité. « A-nahnu sarrafnakum » — est-ce nous qui vous avons détournés. La question est rhétorique. « 'Ana al-huda » — de la guidance. Le détournement est dénoncé. Le miroir m'enseigne que chacun est responsable de son choix.`,
  reflection: `Les leaders essaient de rejeter la responsabilité, mais chacun est responsable de son choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qal alladhina istakbaru lilladhina istad'afu a-nahnu sarrafnakum 'ana al-huda » — et ceux qui furent hautains diront à ceux qui furent faibles : est-ce nous qui vous avons détournés de la guidance ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la responsabilité de mes choix ? Ou est-ce que je l'assume ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Assumer la responsabilité est le signe de la maturité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers assume sa fonction sans chercher d'excuses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité la maîtrise." }
  ],
  munajat: `Ya Rabb, j'assume la responsabilité de mes choix. Ne permets pas que je la rejette. Donne-moi la maturité de la responsabilité.`
};

MIROIR["34:34"] = {
  reference: "34:34",
  theme: ["avertissement", "leadership", "rejet"],
  emotion: "Clarté, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nadhir", "Al-Hadi"],
  mirrorVersion: `« Et Nous n'avons envoyé aucun avertisseur dans une cité sans que ses habitants aisés n'aient dit : 'Nous ne croyons pas en votre mission.' » Le miroir me montre le rejet constant des riches. « Mala'uha » — ses habitants aisés. Les riches rejettent le message. « La nu'minu » — nous ne croyons pas. Le rejet est constant. Le miroir m'avertit : les richesses peuvent aveugler.`,
  reflection: `Les riches rejettent souvent le message. Les richesses peuvent aveugler.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna fi qaryatin min nadhirin illa qala mala'uha inna bi-ma ursiltum bihi kafirun » — et Nous n'avons envoyé aucun avertisseur dans une cité sans que ses habitants aisés n'aient dit : nous ne croyons pas en votre mission." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes richesses m'aveuglent ? Ou est-ce que j'accepte le message malgré elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les richesses peuvent être un test, pas une barrière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas aveuglé par ses richesses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message malgré ses richesses est vraiment riche." }
  ],
  munajat: `Ya Rabb, ne permets pas que mes richesses m'aveuglent. Fais que j'accepte Ton message malgré tout. Donne-moi la vraie richesse de la foi.`
};

MIROIR["34:35"] = {
  reference: "34:35",
  theme: ["richesse", "orgueil", "illusion"],
  emotion: "Lucidité, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Al-Hakim"],
  mirrorVersion: `« Et ils dirent : 'Nous avons plus de biens et d'enfants, et nous ne serons pas châtiés.' » Le miroir me montre l'illusion des richesses. « Aktharu amwalan » — nous avons plus de biens. La fierté des richesses. « Wa awlada » — et d'enfants. La fierté de la descendance. « Wa ma nahnu bi-mu'adhabin » — et nous ne serons pas châtiés. L'illusion de l'impunité. Le miroir m'avertit : les richesses ne protègent pas du châtiment.`,
  reflection: `Les richesses et les enfants ne protègent pas du châtiment. L'illusion de l'impunité est dangereuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu nahnu aktharu amwalan wa awlada wa ma nahnu bi-mu'adhabin » — et ils dirent : nous avons plus de biens et d'enfants, et nous ne serons pas châtiés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur mes richesses pour ma protection ? Ou est-ce que je compte sur Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection vient d'Allah, pas des richesses." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne compte pas sur ses richesses pour sa protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah plutôt que sur ses richesses est vraiment protégé." }
  ],
  munajat: `Ya Ghani, je compte sur Toi, pas sur mes richesses. Ne permets pas que je sois illusionné. Protège-moi par Ta grâce, pas par mes biens.`
};

MIROIR["34:36"] = {
  reference: "34:36",
  theme: ["don", "épreuve", "gratitude"],
  emotion: "Gratitude, compréhension",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Mubtali"],
  mirrorVersion: `« Dis : 'Mon Seigneur dispense largement ou restreint Sa provision à qui Il veut.' » Le miroir me montre la sagesse de la distribution. « Yabsutu al-rizqa » — dispense largement. L'élargissement. « Wa yaqdiru » — ou restreint. Le resserrement. « Li-man yasha'u » — à qui Il veut. La volonté divine. Le miroir m'invite à la gratitude dans les deux cas.`,
  reflection: `La provision est élargie ou restreinte selon la sagesse divine. La gratitude convient dans les deux cas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inna rabbi yabsutu al-rizqa li-man yasha'u wa yaqdiru » — dis : mon Seigneur dispense largement ou restreint Sa provision à qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant dans l'élargissement et le resserrement ? Ma gratitude est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude constante est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit sa provision selon la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant dans les deux cas est vraiment croyant." }
  ],
  munajat: `Ya Mannan, je suis reconnaissant dans l'élargissement et le resserrement. Ne permets pas que ma gratitude change selon ma provision. Donne-moi la constance de la reconnaissance.`
};

MIROIR["34:38"] = {
  reference: "34:38",
  theme: ["effort", "opposition", "châtiment"],
  emotion: "Gravité, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Ceux qui s'efforcent de rendre Nos versets inefficaces, ceux-là seront dans le châtiment. » Le miroir me montre l'effort des opposants. « Sa'aw fi ayatina » — s'efforcent de rendre Nos versets inefficaces. L'effort contre le message. « Fi al-'adhab » — seront dans le châtiment. La conséquence est claire. Le miroir m'avertit : l'effort contre le message mène au châtiment.`,
  reflection: `L'effort contre le message mène au châtiment. L'opposition a un prix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina sa'aw fi ayatina mu'ajizina ula'ika fi al-'adhab muhdarun » — ceux qui s'efforcent de rendre Nos versets inefficaces, ceux-là seront dans le châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon effort est-il pour le message ou contre ? Est-ce que je risque le châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort pour le message mène à la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne s'efforce pas contre le message de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'efforce pour le message reçoit la récompense." }
  ],
  munajat: `Ya Rabb, mon effort est pour Ton message. Ne permets pas que je m'y oppose. Donne-moi la récompense de l'effort pour Toi.`
};

MIROIR["34:39"] = {
  reference: "34:39",
  theme: ["provision", "dépense", "remplacement"],
  emotion: "Confiance, générosité",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Dis : 'Mon Seigneur dispense largement Sa provision à qui Il veut et la restreint.' » Le miroir me montre la loi de la provision. « Wa ma anfaqtum min shay'in fa-huwa yukhlifuhu » — ce que vous dépensez, Il le remplace. La dépense est remplacée. « Wa huwa khayru al-raziqin » — et Il est le meilleur des pourvoyeurs. Le remplacement est garanti. Le miroir m'invite à la générosité avec confiance.`,
  reflection: `La dépense est remplacée par Allah. La générosité avec confiance est le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma anfaqtum min shay'in fa-huwa yukhlifuhu wa huwa khayru al-raziqin » — ce que vous dépensez, Il le remplace. Et Il est le meilleur des pourvoyeurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense avec confiance dans le remplacement ? Ou est-ce que je garde par peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité avec confiance attire le remplacement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne et reçoit en permanence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépense avec confiance ne manque jamais." }
  ],
  munajat: `Ya Karim, je dépense avec confiance. Remplace ce que je donne. Ne permets pas que la peur me fasse garder ce qui doit être donné.`
};

MIROIR["34:40"] = {
  reference: "34:40",
  theme: ["rassemblement", "question", "témoin"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Shahid"],
  mirrorVersion: `« Et le jour où Il les rassemble tous, puis dit aux anges : 'Est-ce vous qu'ils adoraient ?' » Le miroir me montre le rassemblement et la question. « Yawma yajma'uhum jami'an » — le jour où Il les rassemble tous. Le rassemblement est total. « A-iyyakum kanu ya'budun » — est-ce vous qu'ils adoraient. La question aux anges. Le miroir m'interroge : qui est-ce que j'adore vraiment ?`,
  reflection: `Le rassemblement révèle qui on adorait vraiment. Les anges n'ont pas été adorés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma yajma'uhum jami'an thumma yaqulu lil-mala'ikati a-iyyakum kanu ya'budun » — et le jour où Il les rassemble tous, puis dit aux anges : est-ce vous qu'ils adoraient ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'adore vraiment ? Les anges ? Les idoles ? Ou Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Adorer Allah seul est le chemin de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'adore que son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul sera honoré au rassemblement." }
  ],
  munajat: `Ya Rabb, j'adore Toi seul. Ne permets pas que j'adore autre chose. Honore-moi au rassemblement par mon adoration pure.`
};

MIROIR["34:41"] = {
  reference: "34:41",
  theme: ["adoration", "anges", "allégation"],
  emotion: "Vérité, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Haqq"],
  mirrorVersion: `« Ils diront : 'Gloire à Toi ! Tu es notre allié, pas eux. Ils adoraient les djinns.' » Le miroir me montre la réponse des anges. « Subhanaka » — gloire à Toi. Les anges se purifient. « Anta waliyyuna min dunihim » — Tu es notre allié, pas eux. L'alliance est clarifiée. « Kanu ya'buduna al-jinn » — ils adoraient les djinns. La vraie adoration est dévoilée. Le miroir m'enseigne que l'adoration des idoles est l'adoration des djinns.`,
  reflection: `Les anges n'ont pas été adorés. L'adoration des idoles est l'adoration des djinns.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu subhanaka anta waliyyuna min dunihim bal kanu ya'buduna al-jinn » — ils diront : gloire à Toi ! Tu es notre allié, pas eux. Ils adoraient les djinns." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore vraiment ? Suis-je conscient de ce qui se cache derrière mes adorations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration pure est l'adoration d'Allah seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas d'autre allié qu'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'adoration pure adore Allah seul." }
  ],
  munajat: `Ya Wali, Tu es mon allié. Je n'adore que Toi. Ne permets pas que j'adore les djinns ou les idoles. Purifie mon adoration.`
};

MIROIR["34:42"] = {
  reference: "34:42",
  theme: ["pouvoir", "aide", "impuissance"],
  emotion: "Vérité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Mu'in"],
  mirrorVersion: `« Aujourd'hui, vous ne pouvez ni nuire ni profiter. » Le miroir me montre l'impuissance finale. « Al-yawma la yamliku ba'dukum li-ba'din naf'an wa la darra » — aujourd'hui, vous ne pouvez ni nuire ni profiter. L'impuissance est totale. Le pouvoir n'appartient qu'à Allah. Le miroir m'enseigne l'humilité finale.`,
  reflection: `L'impuissance finale révèle que le pouvoir n'appartient qu'à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-yawma la yamliku ba'dukum li-ba'din naf'an wa la darra » — aujourd'hui, vous ne pouvez ni nuire ni profiter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise mon impuissance finale ? Est-ce que je compte sur Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance humaine révèle la puissance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est impuissant sans son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise son impuissance compte sur Allah seul." }
  ],
  munajat: `Ya Qadir, je suis impuissant sans Toi. Je compte sur Toi seul. Ne permets pas que je compte sur ma propre puissance.`
};

MIROIR["34:43"] = {
  reference: "34:43",
  theme: ["récitation", "accusation", "orgueil"],
  emotion: "Tristesse, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qur'an", "Al-Haqq"],
  mirrorVersion: `« Et quand Nos versets leur sont récités en toute clarté, ils disent : 'Ce n'est qu'un homme qui veut vous repousser de ce que vos pères adoraient.' » Le miroir me montre le rejet par tradition. « Tula 'alayhim ayatuna bayyinatan » — quand Nos versets leur sont récités en toute clarté. La clarté ne suffit pas. « In huwa illa rajul » — ce n'est qu'un homme. L'accusation contre le Prophète. Le miroir m'avertit : la tradition ne justifie pas le rejet.`,
  reflection: `La clarté du message est rejetée par attachement à la tradition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha tula 'alayhim ayatuna bayyinatan qalu ma hadha illa rajul » — et quand Nos versets leur sont récités en toute clarté, ils disent : ce n'est qu'un homme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la vérité par attachement à la tradition ? Ou est-ce que j'accepte le message clair ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accepter le message clair est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de tradition qui s'oppose à la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message clair malgré la tradition est vraiment guidé." }
  ],
  munajat: `Ya Haqq, j'accepte Ton message clair. Ne permets pas que la tradition m'empêche de voir la vérité. Guide-moi par Ta clarté.`
};

MIROIR["34:44"] = {
  reference: "34:44",
  theme: ["rappel", "livre", "avertissement"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Dhikr", "Al-Kitab"],
  mirrorVersion: `« Mais Nous ne leur avons donné aucun livre à étudier, et Nous ne leur avons envoyé avant toi aucun avertisseur. » Le miroir me montre l'absence d'excuse. « Ma ataynahum min kutubin » — Nous ne leur avons donné aucun livre. Pas de révélation antérieure. « Wa la arsalna ilayhim qablaka min nadhir » — ni envoyé avant toi aucun avertisseur. Pas d'avertisseur précédent. Le miroir m'enseigne que le message est nouveau mais nécessaire.`,
  reflection: `L'absence de révélation antérieure ne justifie pas le rejet du nouveau message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ataynahum min kutubin yadrusunaha wa ma arsalna ilayhim qablaka min nadhir » — mais Nous ne leur avons donné aucun livre à étudier, et Nous ne leur avons envoyé avant toi aucun avertisseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le nouveau message ? Ou est-ce que je le rejette par absence de précédent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le nouveau message est l'opportunité de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte chaque nouvelle loi qui lui est donnée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le nouveau message découvre la guidance." }
  ],
  munajat: `Ya Rabb, j'accepte Ton nouveau message. Ne permets pas que l'absence de précédent m'empêche de croire. Guide-moi par Ta révélation.`
};

MIROIR["34:45"] = {
  reference: "34:45",
  theme: ["précédents", "mécréance", "leçon"],
  emotion: "Leçon, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sunan", "Al-Mubtada"],
  mirrorVersion: `« Ceux qui les ont précédés ont mécru, et ils n'ont atteint qu'un dixième de ce que Nous leur avons donné. » Le miroir me montre la mécréance des précédents. « Kafara alladhina min qablihim » — ceux qui les ont précédés ont mécru. L'histoire se répète. « Ma balaghu 'ashir ma ataynahum » — ils n'ont atteint qu'un dixième de ce que Nous leur avons donné. La comparaison. Le miroir m'avertit : la mécréance des précédents n'excuse pas celle des présents.`,
  reflection: `La mécréance des précédents montre que la guidance n'est pas automatique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kafara alladhina min qablihim wa ma balaghu 'ashir ma ataynahum » — ceux qui les ont précédés ont mécru, et ils n'ont atteint qu'un dixième de ce que Nous leur avons donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends des précédents ? Ou est-ce que je répète leurs erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Apprendre des précédents évite leurs erreurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers apprend de son histoire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des précédents est vraiment sage." }
  ],
  munajat: `Ya Rabb, j'apprends des précédents. Ne permets pas que je répète leurs erreurs. Donne-moi la sagesse de l'histoire.`
};

MIROIR["34:47"] = {
  reference: "34:47",
  theme: ["récompense", "gratuité", "prophète"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Ajir", "Al-Mannan"],
  mirrorVersion: `« Dis : 'Je ne vous demande aucune récompense. Elle est pour vous. Ma récompense n'incombe qu'à Allah.' » Le miroir me montre la gratuité du message. « Ma sa'altukum min ajr » — je ne vous demande aucune récompense. Le message est gratuit. « Huwa lakum » — elle est pour vous. Le message est un don. « In ajriya illa 'ala Allah » — ma récompense n'incombe qu'à Allah. Le Prophète compte sur Allah. Le miroir m'invite à accepter le message gratuit.`,
  reflection: `Le message est un don gratuit. Le Prophète ne demande rien en retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ma sa'altukum min ajr huwa lakum in ajriya illa 'ala Allah » — dis : je ne vous demande aucune récompense. Elle est pour vous. Ma récompense n'incombe qu'à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le message comme un don gratuit ? Ou est-ce que je le rejette par méfiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accepter le don gratuit est le signe de la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte les dons gratuits de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le don gratuit reçoit plus que ce qu'il attendait." }
  ],
  munajat: `Ya Mannan, j'accepte Ton don gratuit. Ne permets pas que la méfiance m'empêche de recevoir. Donne-moi la confiance pour accepter.`
};

MIROIR["34:48"] = {
  reference: "34:48",
  theme: ["vérité", "triomphe", "mensonge"],
  emotion: "Confiance, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Zahir"],
  mirrorVersion: `« Dis : 'Mon Seigneur lance la vérité. Il connaît parfaitement les choses cachées.' » Le miroir me montre le triomphe de la vérité. « Yarqifu al-haqq » — lance la vérité. La vérité triomphe. « 'Alam al-ghuyub » — connaît parfaitement les choses cachées. La connaissance d'Allah est parfaite. Le miroir m'invite à faire confiance au triomphe de la vérité.`,
  reflection: `La vérité triomphe toujours. La connaissance d'Allah est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul yarqifu rabbi bi-al-haqqi 'alim al-ghuyub » — dis : mon Seigneur lance la vérité. Il connaît parfaitement les choses cachées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance au triomphe de la vérité ? Ou est-ce que je doute de sa victoire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge est vaincu par la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fondé sur la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la vérité voit son triomphe." }
  ],
  munajat: `Ya Haqq, je fais confiance à Ton triomphe. Ne permets pas que je doute de la victoire de la vérité. Montre-moi son triomphe.`
};

MIROIR["34:49"] = {
  reference: "34:49",
  theme: ["faux", "disparition", "clarté"],
  emotion: "Clarté, libération",
  difficulty: "débutant",
  relatedNames: ["Al-Batil", "Al-Haqq"],
  mirrorVersion: `« Dis : 'La vérité est venue, et le faux ne peut rien commencer ni recommencer.' » Le miroir me montre la disparition du faux. « Ja'a al-haqq » — la vérité est venue. La vérité est présente. « La yuhdi wa la yu'id » — le faux ne peut rien commencer ni recommencer. Le faux est impuissant. Le miroir m'invite à la clarté de la vérité.`,
  reflection: `Le faux est impuissant devant la vérité. La vérité est présente et triomphante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ja'a al-haqqu wa ma yubdi'u al-batilu wa ma yu'id » — dis : la vérité est venue, et le faux ne peut rien commencer ni recommencer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis dans la vérité ? Ou est-ce que je suis encore attaché au faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité libère du faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît que la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la vérité est libre du faux." }
  ],
  munajat: `Ya Haqq, je vis dans Ta vérité. Libère-moi du faux. Ne permets pas que je sois attaché à ce qui ne peut rien.`
};

MIROIR["34:50"] = {
  reference: "34:50",
  theme: ["guidance", "égarement", "indépendance"],
  emotion: "Clarté, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Dis : 'Si je m'égare, je m'égare à mon propre détriment. Et si je suis guidé, c'est par ce que mon Seigneur m'a révélé.' » Le miroir me montre l'indépendance des chemins. « In dalaltu » — si je m'égare. L'égarement est possible. « Fa-innama adallu 'ala nafsi » — je m'égare à mon propre détriment. La responsabilité est individuelle. « Wa ini ihtadaytu » — et si je suis guidé. La guidance est possible. « Bima aw-ah ilayya rabbi » — c'est par ce que mon Seigneur m'a révélé. La guidance vient d'Allah. Le miroir m'enseigne la responsabilité individuelle.`,
  reflection: `L'égarement est ma responsabilité. La guidance vient d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul in dalaltu fa-innama adallu 'ala nafsi wa ini ihtadaytu bima aw-ah ilayya rabbi » — dis : si je m'égare, je m'égare à mon propre détriment. Et si je suis guidé, c'est par ce que mon Seigneur m'a révélé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'assume la responsabilité de mon égarement ? Est-ce que je reconnais la source de ma guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance d'Allah précède mon effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est guidé par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source de la guidance la reçoit." }
  ],
  munajat: `Ya Hadi, Tu me guides. Je reconnais que ma guidance vient de Toi. Ne permets pas que je m'égare par ma propre faute.`
};

MIROIR["34:51"] = {
  reference: "34:51",
  theme: ["terreur", "vue", "jugement"],
  emotion: "Terreur, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Qahhar"],
  mirrorVersion: `« Si tu voyais quand ils seront terrifiés, sans issue possible, et qu'ils seront saisis de près. » Le miroir me montre la terreur du Jugement. « Law tara idha fazi'u » — si tu voyais quand ils seront terrifiés. La terreur est visible. « Fawqa mahid » — sans issue possible. Aucune échappatoire. « Uhizhu min makani qarib » — saisis de près. La proximité du châtiment. Le miroir m'avertit : la terreur du Jugement est réelle.`,
  reflection: `La terreur du Jugement est réelle et sans issue possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law tara idha fazi'u fawqa mahid wa uhizhu min makani qarib » — si tu voyais quand ils seront terrifiés, sans issue possible, et qu'ils seront saisis de près." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare le Jugement ? Ou est-ce que je serai terrifié sans issue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation évite la terreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera saisi au Jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'est pas terrifié." }
  ],
  munajat: `Ya Qahhar, je me prépare au Jugement. Ne permets pas que je sois terrifié sans issue. Donne-moi la préparation qui évite la terreur.`
};

MIROIR["34:52"] = {
  reference: "34:52",
  theme: ["foi tardive", "regret", "impossibilité"],
  emotion: "Regret, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Iman", "Al-Waqt"],
  mirrorVersion: `« Et ils diront : 'Nous croyons en lui.' Mais comment la foi pourrait-elle les atteindre de loin ? » Le miroir me montre la foi tardive. « A-manna bihi » — nous croyons en lui. La foi déclarée. « Anna lahumu al-tanaushi » — mais comment la foi pourrait-elle les atteindre. L'impossibilité. « Min makani ba'id » — de loin. La distance. Le miroir m'avertit : la foi tardive n'est pas acceptée.`,
  reflection: `La foi tardive n'est pas acceptée. La foi doit venir avant le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu amanna bihi wa anna lahumu al-tanaushi min makani ba'id » — et ils diront : nous croyons en lui. Mais comment la foi pourrait-elle les atteindre de loin ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois maintenant ? Ou est-ce que j'attends trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi maintenant évite le regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croit maintenant, pas plus tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant évite la foi tardive." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que j'attende trop tard. Donne-moi la foi présente, pas la foi tardive.`
};

MIROIR["34:53"] = {
  reference: "34:53",
  theme: ["mécréance", "obstination", "conséquence"],
  emotion: "Leçon, regret",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kufr", "Al-'Adl"],
  mirrorVersion: `« Ils ont mécru en lui auparavant et ils lançaient des suppositions sur l'inconnu de loin. » Le miroir me montre la mécréance obstinée. « Qad kafaru bihi min qablu » — ils ont mécru en lui auparavant. La mécréance préalable. « Wa yaqdhifuna bi-al-ghaybi » — et lançaient des suppositions sur l'inconnu. L'aveuglement. « Min makanin ba'id » — de loin. La distance de la vérité. Le miroir m'avertit : l'obstination dans la mécréance a des conséquences.`,
  reflection: `L'obstination dans la mécréance précède la foi tardive rejetée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad kafaru bihi min qablu wa yaqdhifuna bi-al-ghaybi min makanin ba'id » — ils ont mécru en lui auparavant et ils lançaient des suppositions sur l'inconnu de loin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis obstiné dans ma mécréance ? Ou est-ce que je suis ouvert à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture à la vérité évite l'obstination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas obstiné contre son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est ouvert à la vérité la reçoit." }
  ],
  munajat: `Ya Rabb, je suis ouvert à la vérité. Ne permets pas que je sois obstiné dans la mécréance. Ouvre mon cœur à Ta guidance.`
};

MIROIR["34:54"] = {
  reference: "34:54",
  theme: ["barrière", "séparation", "destin"],
  emotion: "Réalité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hijab", "Al-Qadar"],
  mirrorVersion: `« Et une barrière sera mise entre eux et ce qu'ils désirent. » Le miroir me montre la séparation finale. « Huriza baynahum wa bayna ma yatma'una » — une barrière sera mise entre eux et ce qu'ils désirent. La séparation est totale. « Kama fu'ila bi-ashyahim min qablu » — comme il a été fait avec leurs semblables auparavant. L'histoire se répète. Le miroir m'avertit : la barrière est la conséquence de la mécréance.`,
  reflection: `La barrière finale est la conséquence de la mécréance obstinée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huriza baynahum wa bayna ma yatma'una kama fu'ila bi-ashyahim min qablu » — et une barrière sera mise entre eux et ce qu'ils désirent, comme il a été fait avec leurs semblables auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je risque la barrière finale ? Ou est-ce que je me prépare pour le Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le Paradis évite la barrière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas de barrière avec son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le Paradis n'a pas de barrière." }
  ],
  munajat: `Ya Rabb, je me prépare pour le Paradis. Ne permets pas qu'une barrière me sépare de ce que je désire. Donne-moi l'accès à Tes grâces.`
};

// ==================== SURAH 35: FATIR - MISSING VERSES ====================

MIROIR["35:4"] = {
  reference: "35:4",
  theme: ["messagers", "rejet", "patience"],
  emotion: "Réconfort, constance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "As-Sabur"],
  mirrorVersion: `« Et s'ils te traitent de menteur, des messagers avant toi ont été traités de menteurs. » Le miroir me montre que le rejet n'est pas nouveau. « In yukadhdhibuka » — s'ils te traitent de menteur. L'accusation est douloureuse. « Qad kudhdhiba rusulun min qablika » — des messagers avant toi ont été traités de menteurs. Le rejet est une tradition des mécréants. Le miroir me console : tu n'es pas seul dans cette épreuve.`,
  reflection: `Le rejet du messager est la norme, pas l'exception. La patience est la réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yukadhdhibuka faqad kudhdhiba rusulun min qablika » — et s'ils te traitent de menteur, des messagers avant toi ont été traités de menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis rejeté pour la vérité, est-ce que je me souviens que je ne suis pas seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet par les hommes est acceptation par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte chaque messager de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est rejeté pour la vérité est en bonne compagnie." }
  ],
  munajat: `Ya Rabb, quand je suis rejeté pour Ta vérité, rappelle-moi que je ne suis pas seul. Donne-moi la patience des messagers.`
};

MIROIR["35:6"] = {
  reference: "35:6",
  theme: ["satan", "ennemi", "avertissement"],
  emotion: "Vigilance, prudence",
  difficulty: "débutant",
  relatedNames: ["Ash-Shaytan", "Al-Adww"],
  mirrorVersion: `« Satan est pour vous un ennemi. Prenez-le donc comme ennemi. » Le miroir me montre la réalité de l'ennemi invisible. « Inna ash-shaytana lakum 'aduww » — Satan est pour vous un ennemi. La définition est claire. « Fatta-khidhuhu 'aduwwa » — prenez-le donc comme ennemi. L'action est requise. Le miroir m'avertit : ne sous-estime pas l'ennemi.`,
  reflection: `Satan est l'ennemi déclaré. Le traiter comme tel est la seule réponse sage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ash-shaytana lakum 'aduwwun fatta-khidhuhu 'aduwwa » — Satan est pour vous un ennemi. Prenez-le donc comme ennemi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite Satan comme ennemi ? Ou est-ce que je le laisse m'approcher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ennemi déclaré ne peut être ami." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de compromis avec le mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son ennemi est protégé." }
  ],
  munajat: `Ya Rabb, je reconnais Satan comme ennemi. Protège-moi de ses ruses. Ne permets pas qu'il m'approche.`
};

MIROIR["35:7"] = {
  reference: "35:7",
  theme: ["châtiment", "récompense", "foi"],
  emotion: "Espoir et crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "An-Nar"],
  mirrorVersion: `« Ceux qui ont mécru auront un sévère châtiment. Et ceux qui croient et accomplissent les bonnes œuvres auront un pardon et une énorme récompense. » Le miroir me montre les deux issues. « Alladhina kafaru lahum 'adhabun shadid » — ceux qui ont mécru auront un sévère châtiment. La mécréance mène au châtiment. « Wa alladhina amanu wa 'amilu as-salihati lahum maghfiratun wa ajrun kabir » — ceux qui croient et font le bien auront pardon et énorme récompense. La foi mène au pardon. Le miroir m'invite à choisir.`,
  reflection: `Deux chemins, deux destinations. Le choix appartient à chacun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina kafaru lahum 'adhabun shadidun wa alladhina amanu wa 'amilu as-salihati lahum maghfiratun wa ajrun kabir » — ceux qui ont mécru auront un sévère châtiment. Et ceux qui croient et font le bien auront pardon et énorme récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel chemin est-ce que je prends ? Vers le châtiment ou vers le pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin du pardon est ouvert à tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reflète les conséquences des choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la foi a choisi le meilleur chemin." }
  ],
  munajat: `Ya Rabb, je choisis la foi et les bonnes œuvres. Pardonne-moi et donne-moi l'énorme récompense. Ne me laisse pas parmi les mécréants.`
};

MIROIR["35:8"] = {
  reference: "35:8",
  theme: ["égarement", "guidance", "perception"],
  emotion: "Humilité, prière",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Celui dont les mauvaises actions ont été embellies au point qu'il les voit comme bonnes... » Le miroir me montre le danger de l'auto-justification. « Zuyyina li-nasi su'u 'amalihim » — les mauvaises actions ont été embellies aux gens. L'illusion du mal. « Fahum yaraunaha hasana » — ils les voient comme bonnes. L'aveuglement complet. Le miroir m'avertit : je peux être aveuglé par mes propres fautes.`,
  reflection: `Le pire égarement est celui où l'on croit être guidé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaman zuyyina lahu su'u 'amalihi fa-ra-ahu hasana » — celui dont les mauvaises actions ont été embellies au point qu'il les voit comme bonnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois mes fautes comme fautes ? Ou est-ce que je les justifie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie vision est de voir le mal comme mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas sur la nature des choses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande à Allah de lui montrer ses fautes est protégé de l'illusion." }
  ],
  munajat: `Ya Hadi, montre-moi mes fautes comme fautes. Ne permets pas que je sois aveuglé par mes propres actions. Guide-moi vers la vraie vision.`
};

MIROIR["35:9"] = {
  reference: "35:9",
  theme: ["vents", "résurrection", "signes"],
  emotion: "Espérance, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Ar-Riyah"],
  mirrorVersion: `« C'est Allah qui envoie les vents qui soulèvent des nuages. » Le miroir me montre les signes dans la nature. « Wa Allahu alladhi arsala ar-riyaha » — c'est Allah qui envoie les vents. La maîtrise divine. « Fa-tuthiru sahaban » — qui soulèvent des nuages. L'action des vents. Le miroir m'invite à contempler les signes de la résurrection.`,
  reflection: `Les vents qui portent la vie sont signe de Celui qui donne la vie aux morts.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu alladhi arsala ar-riyaha fa-tuthiru sahaban » — c'est Allah qui envoie les vents qui soulèvent des nuages." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les signes dans la nature ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vent qui vivifie la terre est signe de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de signes de la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit les signes dans la nature croit en la résurrection." }
  ],
  munajat: `Ya Muhyi, les vents sont Tes signes. Ouvre mes yeux sur les signes de la résurrection. Fais que je contemple avec le cœur.`
};

MIROIR["35:10"] = {
  reference: "35:10",
  theme: ["puissance", "humilité", "honneur"],
  emotion: "Humilité, recherche",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aziz", "Al-Kibriya"],
  mirrorVersion: `« Quiconque veut la puissance, c'est à Allah qu'appartient toute puissance. » Le miroir me montre la source de la véritable puissance. « Man kana yuridu al-'izzata » — quiconque veut la puissance. Le désir humain. « Fa-lillahi al-'izzatu jami'an » — c'est à Allah qu'appartient toute puissance. La source unique. Le miroir m'enseigne : cherche la puissance auprès d'Allah, pas ailleurs.`,
  reflection: `La vraie puissance vient d'Allah. La chercher ailleurs est illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kana yuridu al-'izzata fa-lillahi al-'izzatu jami'an » — quiconque veut la puissance, c'est à Allah qu'appartient toute puissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche la puissance ? Auprès d'Allah ou auprès des créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance auprès d'Allah est la seule vraie puissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute puissance dans l'univers vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la puissance auprès d'Allah la trouve." }
  ],
  munajat: `Ya Aziz, je cherche la puissance auprès de Toi seul. Ne permets pas que je la cherche ailleurs. Donne-moi la vraie puissance.`
};

MIROIR["35:11"] = {
  reference: "35:11",
  theme: ["création", "terme", "connaissance"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Alim"],
  mirrorVersion: `« Allah vous a créés de terre, puis d'une goutte, puis Il vous a faits en couples. » Le miroir me montre les étapes de la création. « Khalaqakum min turabin » — créés de terre. L'origine humble. « Thumma min nutfatin » — puis d'une goutte. Le développement. « Thumma ja'alakum azwajan » — puis faits en couples. La complémentarité. Le miroir m'invite à méditer sur mon origine et ma fin.`,
  reflection: `L'origine est humble. Le terme est connu d'Allah. La vie est un don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu khalaqakum min turabin thumma min nutfatin thumma ja'alakum azwajan » — Allah vous a créés de terre, puis d'une goutte, puis Il vous a faits en couples." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine humble ? Ou est-ce que je m'enorgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité de l'origine enseigne l'humilité de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie suit le même processus de création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine connaît sa valeur réelle." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de terre et d'une goutte. Rappelle-moi mon origine. Garde-moi humble et reconnaissant.`
};

MIROIR["35:12"] = {
  reference: "35:12",
  theme: ["mers", "différence", "provision"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Bahr"],
  mirrorVersion: `« Les deux mers ne sont pas égales : l'une est douce, agréable à boire; l'autre est salée, amère. » Le miroir me montre la diversité dans la création. « Ma yastawi al-bahran » — les deux mers ne sont pas égales. La différence. « Hadha 'adhbun furatun » — celle-ci est douce, agréable. La douceur. « Wa hadha milhun ujaj » — et celle-ci est salée, amère. L'amertume. Le miroir m'invite à voir la sagesse dans la différence.`,
  reflection: `La diversité dans la création est signe de sagesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yastawi al-bahran hadha 'adhbun furatun sa'ighun sharabuhu wa hadha milhun ujaj » — les deux mers ne sont pas égales : l'une est douce, agréable à boire; l'autre est salée, amère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la diversité dans la création ? Ou est-ce que je la critique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque différence a sa sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est divers dans son unité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la sagesse dans la différence a compris la création." }
  ],
  munajat: `Ya Razzaq, Tu as créé la diversité avec sagesse. Ouvre mes yeux sur la beauté de la différence. Donne-moi la gratitude pour Ta provision.`
};

MIROIR["35:13"] = {
  reference: "35:13",
  theme: ["nuit", "jour", "soumission"],
  emotion: "Révérence, contemplation",
  difficulty: "débutant",
  relatedNames: ["Ash-Shams", "Al-Qamar"],
  mirrorVersion: `« Il fait pénétrer la nuit dans le jour et le jour dans la nuit. » Le miroir me montre l'alternance cosmique. « Yuliju al-layla fi an-nahari » — Il fait pénétrer la nuit dans le jour. La transition. « Wa yuliju an-nahara fi al-layl » — et le jour dans la nuit. Le cycle. Le miroir m'invite à méditer sur les cycles de la vie.`,
  reflection: `L'alternance du jour et de la nuit est signe de la maîtrise divine sur le temps.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuliju al-layla fi an-nahari wa yuliju an-nahara fi al-layl » — Il fait pénétrer la nuit dans le jour et le jour dans la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les cycles de ma vie ? Ou est-ce que je résiste au changement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque cycle contient une leçon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par cycles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les cycles accepte la sagesse divine." }
  ],
  munajat: `Ya Rabb, Tu alternes la nuit et le jour. Aide-moi à accepter les cycles de ma vie. Donne-moi la sagesse de chaque saison.`
};

MIROIR["35:14"] = {
  reference: "35:14",
  theme: ["invocation", "idolâtrie", "impuissance"],
  emotion: "Clarté, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ghayr"],
  mirrorVersion: `« Si vous les invoquez, ils n'entendent pas votre invocation, et même s'ils entendaient, ils ne pourraient vous répondre. » Le miroir me montre l'impuissance des idoles. « In tad'uhum la yasma'u du'akum » — si vous les invoquez, ils n'entendent pas. L'inutilité. « Wa law sami'u ma istajabu lakum » — et même s'ils entendaient, ils ne pourraient répondre. L'impuissance totale. Le miroir m'avertit : n'invoque pas ce qui ne peut t'aider.`,
  reflection: `L'invocation des idoles est vaine. Seul Allah entend et répond.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tad'uhum la yasma'u du'akum wa law sami'u ma istajabu lakum » — si vous les invoquez, ils n'entendent pas votre invocation, et même s'ils entendaient, ils ne pourraient vous répondre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'invoque dans ma vie ? Ce qui peut m'aider ou ce qui ne peut rien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation d'Allah est la seule qui soit exaucée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers invoque Allah par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul a compris l'essentiel." }
  ],
  munajat: `Ya Wahid, je T'invoque Toi seul. Ne permets pas que j'invoque ce qui ne peut m'aider. Exauce mon invocation.`
};

MIROIR["35:15"] = {
  reference: "35:15",
  theme: ["besoin", "indépendance", "créature"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Faqir"],
  mirrorVersion: `« Ô hommes, c'est vous qui avez besoin d'Allah. Et Allah, Il se suffit à Lui-même et est digne de louange. » Le miroir me montre ma vraie position. « Ya ayyuha an-nasu antumu al-fuqara'u ila Allah » — ô hommes, c'est vous qui avez besoin d'Allah. Le besoin absolu. « Wa Allahu huwa al-ghaniyu al-hamid » — et Allah se suffit à Lui-même et est digne de louange. L'indépendance absolue. Le miroir m'invite à reconnaître ma dépendance.`,
  reflection: `Le besoin est la condition humaine. La reconnaissance est la réponse sage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha an-nasu antumu al-fuqara'u ila Allahi wa Allahu huwa al-ghaniyu al-hamid » — ô hommes, c'est vous qui avez besoin d'Allah. Et Allah, Il se suffit à Lui-même et est digne de louange." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mon besoin absolu d'Allah ? Ou est-ce que je fais semblant d'être indépendant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance du besoin ouvre la porte de la grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a besoin d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son besoin reçoit la provision." }
  ],
  munajat: `Ya Ghani, je reconnais mon besoin absolu de Toi. Pourvoie à mes besoins. Ne permets pas que j'oublie ma dépendance.`
};

MIROIR["35:16"] = {
  reference: "35:16",
  theme: ["volonté", "création", "puissance"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Fa'il"],
  mirrorVersion: `« S'Il voulait, Il vous ferait disparaître et amènerait une création nouvelle. » Le miroir me montre la facilité du remplacement. « In yasha' yudhhibkum » — s'Il voulait, Il vous ferait disparaître. La fragilité. « Wa ya'ti bi-khalqin jadid » — et amènerait une création nouvelle. La facilité. Le miroir m'invite à l'humilité : je ne suis pas irremplaçable.`,
  reflection: `L'existence est un don, pas un droit. La reconnaissance est la réponse appropriée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yasha' yudhhibkum wa ya'ti bi-khalqin jadid » — s'Il voulait, Il vous ferait disparaître et amènerait une création nouvelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec gratitude pour mon existence ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude pour l'existence est la base de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut être remplacé par un autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la gratitude mérite son existence." }
  ],
  munajat: `Ya Qadir, Tu peux me remplacer si Tu veux. Je suis reconnaissant pour mon existence. Garde-moi dans Ta grâce.`
};

MIROIR["35:17"] = {
  reference: "35:17",
  theme: ["facilité", "puissance", "création"],
  emotion: "Confiance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muhit"],
  mirrorVersion: `« Et cela n'est point difficile pour Allah. » Le miroir me montre la facilité divine. « Wa ma dhalika 'ala Allahi bi-'aziz » — et cela n'est point difficile pour Allah. Toute chose est facile pour Lui. Le miroir m'invite à faire confiance à la puissance divine sans limite.`,
  reflection: `Rien n'est difficile pour Allah. La confiance en Lui est toujours justifiée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma dhalika 'ala Allahi bi-'aziz » — et cela n'est point difficile pour Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la facilité divine ? Ou est-ce que je limite Allah par mes doutes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité pour Allah est la base de l'espoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est facile pour son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la facilité divine a une foi complète." }
  ],
  munajat: `Ya Qadir, rien n'est difficile pour Toi. Je fais confiance à Ta puissance. Accomplis ce qui est bon pour moi.`
};

MIROIR["35:18"] = {
  reference: "35:18",
  theme: ["responsabilité", "charge", "individualité"],
  emotion: "Responsabilité, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wazir", "Al-Nafs"],
  mirrorVersion: `« Nulle âme ne portera le fardeau d'une autre. » Le miroir me montre la responsabilité individuelle. « Wa la taziru waziratun wizra ukhra » — nulle âme ne portera le fardeau d'une autre. Chacun est responsable de lui-même. Le miroir m'invite à assumer ma propre responsabilité sans chercher à la transférer.`,
  reflection: `La responsabilité est personnelle. Nul ne peut porter le fardeau d'autrui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taziru waziratun wizra ukhra » — nulle âme ne portera le fardeau d'une autre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'assume ma responsabilité ? Ou est-ce que je cherche à la transférer sur d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la responsabilité est le début de la maturité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature porte sa propre existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité est vraiment libre." }
  ],
  munajat: `Ya Rabb, j'assume ma responsabilité. Ne permets pas que je la transfère sur d'autres. Aide-moi à porter mon fardeau avec dignité.`
};

MIROIR["35:19"] = {
  reference: "35:19",
  theme: ["aveugle", "voyant", "comparaison"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-A'ma", "Al-Basir"],
  mirrorVersion: `« L'aveugle et le voyant ne sont pas égaux. » Le miroir me montre la différence fondamentale. « Wa ma yastawi al-a'ma wa al-basir » — l'aveugle et le voyant ne sont pas égaux. La différence de perception. Le miroir m'invite à chercher la vraie vue, celle du cœur.`,
  reflection: `La vue des yeux est physique. La vue du cœur est spirituelle. Les deux ne sont pas égales.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yastawi al-a'ma wa al-basir » — l'aveugle et le voyant ne sont pas égaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois avec mon cœur ? Ou est-ce que je suis aveugle spirituellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vue du cœur est plus importante que la vue des yeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est visible pour celui qui voit avec le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec le cœur voit la réalité." }
  ],
  munajat: `Ya Basir, ouvre les yeux de mon cœur. Ne permets pas que je sois aveugle spirituellement. Donne-moi la vraie vue.`
};

MIROIR["35:20"] = {
  reference: "35:20",
  theme: ["ténèbres", "lumière", "comparaison"],
  emotion: "Espoir, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Az-Zulumat"],
  mirrorVersion: `« Les ténèbres et la lumière ne sont pas égales. » Le miroir me montre l'opposition fondamentale. « Wa la az-zulumatu wa la an-nur » — les ténèbres et la lumière ne sont pas égales. La différence est absolue. Le miroir m'invite à choisir la lumière.`,
  reflection: `Les ténèbres et la lumière sont incompatibles. Il faut choisir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la az-zulumatu wa la an-nur » — les ténèbres et la lumière ne sont pas égales." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis dans la lumière ou dans les ténèbres ? Quel est mon choix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière chasse les ténèbres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers préfère la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la lumière a choisi la vérité." }
  ],
  munajat: `Ya Nur, je choisis la lumière. Éloigne-moi des ténèbres. Illumine mon cœur et ma vie.`
};

MIROIR["35:21"] = {
  reference: "35:21",
  theme: ["ombre", "chaleur", "comparaison"],
  emotion: "Méditation, sagesse",
  difficulty: "débutant",
  relatedNames: ["Az-Zill", "Al-Harr"],
  mirrorVersion: `« L'ombre et la chaleur torride ne sont pas égales. » Le miroir me montre une autre opposition. « Wa la az-zillu wa la al-harr » — l'ombre et la chaleur torride ne sont pas égales. Le confort contre l'inconfort. Le miroir m'invite à chercher le rafraîchissement de l'ombre spirituelle.`,
  reflection: `L'ombre apaise, la chaleur épuise. La foi est l'ombre qui protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la az-zillu wa la al-harr » — l'ombre et la chaleur torride ne sont pas égales." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche l'ombre de la foi ? Ou est-ce que je brûle dans la chaleur de l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ombre de la foi protège de la chaleur de l'épreuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers cherche l'équilibre entre ombre et lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve l'ombre de la foi trouve le repos." }
  ],
  munajat: `Ya Rabb, je cherche l'ombre de Ta protection. Protège-moi de la chaleur de l'épreuve. Donne-moi le repos en Toi.`
};

MIROIR["35:22"] = {
  reference: "35:22",
  theme: ["mort", "vie", "résurrection"],
  emotion: "Espérance, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mawt", "Al-Hayat"],
  mirrorVersion: `« Les morts et les vivants ne sont pas égaux. » Le miroir me montre la différence vitale. « Wa la al-amwatu wa la al-ahya » — les morts et les vivants ne sont pas égaux. La vie est supérieure à la mort. Le miroir m'invite à méditer sur la vie spirituelle.`,
  reflection: `La mort physique est visible. La mort spirituelle est invisible mais réelle. La vie spirituelle est la vraie vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la al-amwatu wa la al-ahya » — les morts et les vivants ne sont pas égaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vivant spirituellement ? Ou est-ce que je suis mort à l'intérieur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie spirituelle est plus réelle que la vie physique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est vivant par la vie que Dieu lui donne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vivant spirituellement est vraiment vivant." }
  ],
  munajat: `Ya Muhyi, donne-moi la vie spirituelle. Ne permets pas que je sois mort à l'intérieur. Ressuscite mon cœur.`
};

MIROIR["35:23"] = {
  reference: "35:23",
  theme: ["avertisseur", "clarté", "mission"],
  emotion: "Clarté, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Bashir"],
  mirrorVersion: `« Tu n'es qu'un avertisseur. » Le miroir me montre la clarté de la mission prophétique. « In anta illa nadhir » — tu n'es qu'un avertisseur. La fonction est définie. Le miroir m'invite à écouter l'avertissement.`,
  reflection: `L'avertisseur ne force pas. Il avertit. L'écoute est notre responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In anta illa nadhir » — tu n'es qu'un avertisseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute l'avertissement ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est averti par les signes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement se protège du danger." }
  ],
  munajat: `Ya Rabb, j'écoute Ton avertissement. Ne permets pas que je l'ignore. Protège-moi du danger de l'insouciance.`
};

MIROIR["35:24"] = {
  reference: "35:24",
  theme: ["communauté", "avertisseur", "universalité"],
  emotion: "Universalité, appartenance",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Ummah"],
  mirrorVersion: `« Il n'est pas de communauté qui n'ait eu un avertisseur. » Le miroir me montre l'universalité de la guidance. « Wa min ummatin illa khala fiha nadhir » — il n'est pas de communauté qui n'ait eu un avertisseur. La guidance est universelle. Le miroir m'invite à reconnaître la continuité du message.`,
  reflection: `Chaque communauté a reçu un avertisseur. La guidance n'est pas un privilège mais un droit universel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min ummatin illa khala fiha nadhir » — il n'est pas de communauté qui n'ait eu un avertisseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'universalité de la guidance ? Ou est-ce que je la limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'universalité de la guidance est signe de la miséricorde d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple a reçu son guide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'universalité de la guidance a compris la miséricorde d'Allah." }
  ],
  munajat: `Ya Rabb, je reconnais l'universalité de Ta guidance. Merci pour les avertisseurs. Guide-moi comme Tu as guidé les autres.`
};

MIROIR["35:25"] = {
  reference: "35:25",
  theme: ["rejet", "messagers", "tradition"],
  emotion: "Tristesse, constance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "At-Takdhib"],
  mirrorVersion: `« S'ils te traitent de menteur, ceux qui les ont précédés ont aussi traité de menteurs leurs messagers. » Le miroir me montre la continuité du rejet. « In yukadhdhibuka faqad kadhdhaba alladhina min qablihim » — s'ils te traitent de menteur, ceux qui les ont précédés ont aussi traité de menteurs. L'histoire se répète. Le miroir me console : le rejet n'est pas nouveau.`,
  reflection: `Le rejet des messagers est une tradition des mécréants à travers l'histoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yukadhdhibuka faqad kadhdhaba alladhina min qablihim » — s'ils te traitent de menteur, ceux qui les ont précédés ont aussi traité de menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis découragé par le rejet ? Ou est-ce que je me souviens que c'est la tradition des mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet des hommes n'est pas le rejet d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte le message de ses messagers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est rejeté pour la vérité est en bonne compagnie." }
  ],
  munajat: `Ya Rabb, je ne suis pas découragé par le rejet. Rappelle-moi que les messagers avant moi ont été rejetés. Donne-moi leur constance.`
};

MIROIR["35:26"] = {
  reference: "35:26",
  theme: ["châtiment", "justice", "conséquence"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-'Adhab"],
  mirrorVersion: `« Puis J'ai saisi ceux qui ont mécru. Quel fut donc Mon châtiment ! » Le miroir me montre la conséquence finale. « Thumma akhadhtu alladhina kafaru » — puis J'ai saisi ceux qui ont mécru. La prise est certaine. « Fa-kayfa kana nakir » — quel fut donc Mon châtiment ! L'intensité. Le miroir m'avertit : la mécréance a des conséquences.`,
  reflection: `Le châtiment d'Allah est réel. La mécréance n'est pas sans conséquence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma akhadhtu alladhina kafaru fa-kayfa kana nakir » — puis J'ai saisi ceux qui ont mécru. Quel fut donc Mon châtiment !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment d'Allah ? Ou est-ce que je vis dans l'insouciance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment mène à la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reflète la justice de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment se protège." }
  ],
  munajat: `Ya 'Adl, je crains Ton châtiment. Protège-moi de la mécréance. Garde-moi dans Ta miséricorde.`
};

MIROIR["35:27"] = {
  reference: "35:27",
  theme: ["montagnes", "couleurs", "diversité"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« N'as-tu pas vu qu'Allah fait descendre l'eau du ciel ? » Le miroir me montre les signes dans la nature. « Alam tara anna Allahi anzala mina as-sama'i ma'an » — n'as-tu pas vu qu'Allah fait descendre l'eau du ciel ? La source. « Fa-akhrajna bihi thamaratin mukhtalifan alwanuha » — et Nous en avons fait sortir des fruits aux couleurs différentes. La diversité. Le miroir m'invite à contempler les signes.`,
  reflection: `La diversité des fruits et des montagnes est signe de la créativité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna Allahi anzala mina as-sama'i ma'an fa-akhrajna bihi thamaratin mukhtalifan alwanuha » — n'as-tu pas vu qu'Allah fait descendre l'eau du ciel ? Et Nous en avons fait sortir des fruits aux couleurs différentes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les signes dans la nature ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque couleur est un signe du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est coloré par la créativité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les couleurs découvre le Créateur." }
  ],
  munajat: `Ya Khaliq, les couleurs sont Tes signes. Ouvre mes yeux sur la beauté de Ta création. Fais que je contemple avec le cœur.`
};

// ==================== SURAH 72: AL-JINN - MISSING VERSES ====================

MIROIR["72:2"] = {
  reference: "72:2",
  theme: ["guidance", "droiture", "Coran"],
  emotion: "Reconnaissance, orientation",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Ar-Rashid"],
  mirrorVersion: `« Qui guide vers la vérité, et nous avons cru en lui. » Les djinns ont reconnu que le Coran guide vers la vérité. Le miroir m'interroge : est-ce que je suis cette guidance ? Le Coran n'est pas un texte à lire passivement — c'est une direction à suivre. « Nous avons cru en lui » — la foi suit la reconnaissance de la guidance.`,
  reflection: `La reconnaissance de la guidance mène à la foi. Le Coran est le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahdi ila al-rushi fa amanna bihi » — il guide vers la vérité et nous avons cru en lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la guidance du Coran ? Est-ce que je le suis vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance demande la soumission. Croire, c'est suivre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la guidance pour tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance trouve la vérité." }
  ],
  munajat: `Ya Hadi, guide-moi vers la vérité par Ton Coran. Fais que je le suive vraiment.`
};

MIROIR["72:3"] = {
  reference: "72:3",
  theme: ["tawhid", "transcendance", "famille"],
  emotion: "Révérence, purification",
  difficulty: "débutant",
  relatedNames: ["Al-A'la", "Al-Quddus"],
  mirrorVersion: `« Et qu'Il n'a jamais attribué de compagne à notre Seigneur. » Les djinns rejettent les fausses croyances sur Allah. Pas de compagne, pas d'enfant, pas d'associés. Le tawhid est absolu. Le miroir purifie ma conception de Dieu de toute association.`,
  reflection: `Allah est transcendant, sans associé, sans égal. Le tawhid purifie la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu ta'ala jaddu rabbina attakhadha sahibatan wa la walada » — notre Seigneur est exalté, Il n'a pris ni compagne ni enfant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je conçois Allah sans associé ? Mon cœur est-il pur de toute association ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tawhid purifie. L'association souille." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame l'unicité de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise le tawhid connaît Allah." }
  ],
  munajat: `Ya Ahad, purifie mon cœur de toute association. Fais que je Te connaisse comme Tu es.`
};

MIROIR["72:4"] = {
  reference: "72:4",
  theme: ["égarement", "ignorance", "djinns"],
  emotion: "Clarté, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Et que notre fou parmi nous disait des paroles excessives sur Allah. » Les djinns reconnaissent que parmi eux, des ignorants attribuaient des mensonges à Allah. Le miroir m'avertit : l'ignorance mène à l'égarement. Les paroles excessives sur Allah sont graves.`,
  reflection: `L'ignorance mène à l'égarement. La connaissance protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu kana yaqulu safihuna ala Allahi shatatan » — notre fou disait des paroles excessives sur Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis des choses sur Allah sans savoir ? L'ignorance est-elle mon excuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance corrige l'ignorance. La vérité dissipe le mensonge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création ne ment pas sur son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah pèse ses paroles." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'ignorance. Apprends-moi à parler avec connaissance de Toi.`
};

MIROIR["72:5"] = {
  reference: "72:5",
  theme: ["ignorance", "croyance", "djinns"],
  emotion: "Humilité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Hakam"],
  mirrorVersion: `« Et nous pensions que ni humain ni djinn ne mentait sur Allah. » Les djinns avaient une croyance erronée — ils pensaient que personne ne mentait sur Allah. Le miroir m'enseigne : la naïveté peut mener à l'égarement. La vérité doit être vérifiée.`,
  reflection: `La naïveté n'est pas la foi. La vérité doit être vérifiée par la révélation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu zananna an lan taqula al-insu wa al-jinnu ala Allahi kadhiba » — nous pensions que ni humain ni djinn ne mentait sur Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vérifie ce que j'entends sur Allah ? La révélation est-elle ma référence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge existe. La révélation distingue le vrai du faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur Allah ne vient que de Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah par Sa révélation ne se trompe pas." }
  ],
  munajat: `Ya Alim, enseigne-moi Ta vérité par Ta révélation. Ne me laisse pas dans l'ignorance.`
};

MIROIR["72:6"] = {
  reference: "72:6",
  theme: ["djinns", "magie", "association"],
  emotion: "Prudence, avertissement",
  difficulty: "avancé",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Et il y avait parmi les humains des hommes qui cherchaient protection auprès des hommes parmi les djinns. » Les humains cherchaient la protection des djinns au lieu d'Allah. Le miroir m'interroge : où cherché-je ma protection ? L'association prend des formes subtiles.`,
  reflection: `La protection vient d'Allah seul. Chercher protection ailleurs est de l'association.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu kana rijalun mina al-insi ya'udhuna bijali mina al-jinni » — des hommes cherchaient protection auprès des djinns." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où cherché-je ma protection ? En qui est-ce que je me réfugie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est la seule vraie protection. Le reste est illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature cherche refuge en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie en Allah est véritablement protégé." }
  ],
  munajat: `Ya Hafiz, Tu es mon protecteur. Je me réfugie en Toi seul. Préserve-moi de toute association.`
};

MIROIR["72:7"] = {
  reference: "72:7",
  theme: ["croyance", "destin", "ignorance"],
  emotion: "Réalisation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Qadir"],
  mirrorVersion: `« Et ils pensaient comme vous le pensiez, qu'Allah ne ressusciterait personne. » L'ignorance est partagée entre humains et djinns. Le miroir m'avertit : le doute en la résurrection est une erreur ancienne. La vérité est que la résurrection est certaine.`,
  reflection: `Le doute en la résurrection est une erreur. La vérité est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahum zannu kama zanantum an lan yab'atha Allahu ahada » — ils pensaient qu'Allah ne ressusciterait personne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en la résurrection ? Mon cœur en est-il certain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est la vérité. Le doute est l'erreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création témoigne du retour à la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection prépare son retour." }
  ],
  munajat: `Ya Rabb, renforce ma foi en la résurrection. Fais que je vive avec certitude du retour.`
};

MIROIR["72:8"] = {
  reference: "72:8",
  theme: ["cieux", "interdiction", "djinns"],
  emotion: "Humilité, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ali", "Al-Mani'"],
  mirrorVersion: `« Et nous avons touché le ciel, et nous l'avons trouvé rempli de gardiens sévères et de flammes. » Les djinns essaient d'écouter les cieux mais trouvent une protection divine. Le miroir m'enseigne : les cieux sont protégés. L'accès à la connaissance d'Allah passe par la révélation, pas par l'intrusion.`,
  reflection: `Les cieux sont protégés. La connaissance vient par la révélation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna lamasna al-sama'a fawajadnaha muli'at harasan shadidan wa shuhuban » — nous avons touché le ciel et l'avons trouvé rempli de gardiens et de flammes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la connaissance par les moyens légitimes ? La révélation est-elle ma source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection divine garde les secrets. La révélation les partage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux sont gardés par ordre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la révélation reçoit la connaissance légitime." }
  ],
  munajat: `Ya Ali, les cieux Te glorifient. Donne-moi la connaissance par Ta révélation.`
};

MIROIR["72:9"] = {
  reference: "72:9",
  theme: ["cieux", "protection", "écoute"],
  emotion: "Révérence, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "As-Sami'"],
  mirrorVersion: `« Et nous y prenions place pour écouter, mais quiconque écoute maintenant trouve une flamme qui l'attend. » L'accès aux secrets des cieux est interdit. Le miroir m'enseigne : la curiosité illicite a des conséquences. La connaissance vient par les voies légitimes.`,
  reflection: `La curiosité illicite est punie. La connaissance vient par obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna kunnah naq'udu minha maqa'ida lissam'i » — nous prenions place pour écouter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la connaissance par obéissance ? Ou par curiosité illicite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance ouvre les portes. La désobéissance les ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux protègent leurs secrets par ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute par obéissance entend la vérité." }
  ],
  munajat: `Ya Sami', apprends-moi à chercher la connaissance par obéissance. Garde-moi de la curiosité illicite.`
};

MIROIR["72:10"] = {
  reference: "72:10",
  theme: ["guidance", "destin", "djinns"],
  emotion: "Incertitude, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Qadir"],
  mirrorVersion: `« Et nous ne savons pas si le mal est voulu pour ceux qui sont sur terre, ou si leur Seigneur veut pour eux la droiture. » Les djinns expriment leur ignorance du destin. Le miroir m'enseigne : le destin appartient à Allah. Notre rôle est de chercher la guidance et de nous préparer.`,
  reflection: `Le destin appartient à Allah. Notre rôle est de chercher la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna la nadri asharrun irida biman fi al-ardi am arada bihim rabbuhum rushda » — nous ne savons pas si le mal est voulu pour eux ou si Allah veut la droiture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte mon ignorance du destin ? Cherché-je la guidance malgré l'incertitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance du destin appelle à la confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le destin est écrit. La guidance est offerte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah trouve la paix dans l'incertitude." }
  ],
  munajat: `Ya Rabb, je ne connais pas le destin. Mais je Te fais confiance. Guide-moi vers la droiture.`
};

MIROIR["72:11"] = {
  reference: "72:11",
  theme: ["djinns", "groupes", "chemin"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Adl"],
  mirrorVersion: `« Et il y a parmi nous des vertueux et parmi nous il y en a qui ne le sont pas. Nous étions sur des chemins divergents. » Les djinns comme les humains se divisent en vertueux et égarés. Le miroir m'interroge : sur quel chemin suis-je ? La divergence est réelle, le choix est individuel.`,
  reflection: `Les chemins divergent. Le choix du chemin vertueux est personnel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna minna al-salihuna wa minna duna dhalika kunna tara'iqi qidada » — parmi nous, il y a des vertueux et d'autres non. Nous suivions des chemins divergents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon chemin ? Suis-je parmi les vertueux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu est un choix. L'égarement est aussi un choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création se divise entre obéissance et désobéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la vertu rejoint les vertueux." }
  ],
  munajat: `Ya Rabb, guide-moi vers le chemin des vertueux. Ne me laisse pas m'égarer.`
};

MIROIR["72:12"] = {
  reference: "72:12",
  theme: ["impuissance", "fuite", "djinns"],
  emotion: "Soumission, réalisme",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Qadir"],
  mirrorVersion: `« Et nous avons compris que nous ne pourrons jamais réduire Allah en fuite sur terre, et que nous ne pourrons jamais Lui échapper en fuyant. » Les djinns réalisent leur impuissance face à Allah. Le miroir m'enseigne : il n'y a pas de fuite possible. La soumission est le seul chemin.`,
  reflection: `Allah est partout. La fuite est impossible. La soumission est la voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna alamna an lan nu'jiza Allaha fi al-ardi wa lan nu'jizahu haraban » — nous savons que nous ne pouvons pas réduire Allah en fuite ni Lui échapper." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'essaie de fuir Allah ? Ou est-ce que je me soumis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite est illusion. La soumission est vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas fuir son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet trouve la paix." }
  ],
  munajat: `Ya Qahir, je ne peux pas Te fuir. Je me soumets à Toi. Accepte ma soumission.`
};

MIROIR["72:13"] = {
  reference: "72:13",
  theme: ["guidance", "foi", "droiture"],
  emotion: "Espérance, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Rashid"],
  mirrorVersion: `« Et que quand nous avons entendu la guidance, nous avons cru en elle. » L'audition de la guidance mène à la foi. Le miroir m'enseigne : la foi commence par l'écoute. Celui qui écoute avec un cœur ouvert reçoit la guidance.`,
  reflection: `L'écoute de la guidance mène à la foi. Le cœur ouvert reçoit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna lamma sami'na al-huda amanna bihi » — quand nous avons entendu la guidance, nous avons cru en elle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute la guidance avec un cœur ouvert ? La foi suit-elle l'écoute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'écoute ouvre. La foi remplit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est offerte à tous ceux qui écoutent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute avec sincérité croit." }
  ],
  munajat: `Ya Hadi, j'écoute Ta guidance. Ouvre mon cœur à la foi. Fais que je croie vraiment.`
};

MIROIR["72:14"] = {
  reference: "72:14",
  theme: ["soumission", "groupes", "chemin"],
  emotion: "Engagement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Muslim", "Al-Rabb"],
  mirrorVersion: `« Et quiconque se soumet à Allah est sur le droit chemin. » La soumission est le droit chemin. Le miroir m'enseigne : l'islam n'est pas une identité — c'est une voie. Celui qui se soumet est sur le chemin.`,
  reflection: `La soumission est la voie. Le droit chemin est celui de l'islam.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yuslim wajhahu ila Allahi fahuwa muhtamim rushd » — quiconque se soumet à Allah est sur le droit chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumets vraiment à Allah ? Mon islam est-il une soumission réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission est le chemin. L'orgueil est l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose se soumet à Allah par sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet vraiment trouve la droiture." }
  ],
  munajat: `Ya Rabb, je me soumets à Toi. Fais que ma soumission soit réelle. Guide-moi sur le droit chemin.`
};

MIROIR["72:15"] = {
  reference: "72:15",
  theme: ["égarement", "injustice", "destin"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hasib"],
  mirrorVersion: `« Et quant à ceux qui sont injustes, ils seront le combustible de l'enfer. » L'injustice a des conséquences. Le miroir m'avertit : l'injustice n'est pas sans prix. Le combustible de l'enfer est préparé pour les injustes.`,
  reflection: `L'injustice mène à l'enfer. La justice mène au paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma al-qasituna fakau janahim hataba » — quant aux injustes, ils seront le combustible de l'enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis juste ? Ou est-ce que je commets l'injustice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice sauve. L'injustice condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste évite le feu." }
  ],
  munajat: `Ya Adl, préserve-moi de l'injustice. Fais que je sois parmi les justes.`
};

MIROIR["72:17"] = {
  reference: "72:17",
  theme: ["épreuve", "adoration", "châtiment"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Shadid"],
  mirrorVersion: `« Afin que Nous les éprouvions. Et quiconque se détourne de l'évocation de son Seigneur, Il lui fera subir un châtiment ascendant. » L'épreuve est le but. Le miroir m'enseigne : l'adoration est une épreuve. Le détourrement amène un châtiment qui monte.`,
  reflection: `L'épreuve révèle le vrai. Le détournement amène le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-nabluwahum ayyanshaddu aw yartaghisha » — afin que Nous les éprouvions. « Man a'rada an dhikri rabbihi fahuwa yasluhu adaban sa'adan » — quiconque se détourne de l'évocation aura un châtiment ascendant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste ferme dans l'épreuve ? Ou est-ce que je me détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve élève le croyant. Elle abaisse l'hypocrite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est une épreuve continue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste ferme dans l'épreuve reçoit l'élévation." }
  ],
  munajat: `Ya Rabb, renforce-moi dans l'épreuve. Ne permets pas que je me détourne de Ton évocation.`
};

MIROIR["72:18"] = {
  reference: "72:18",
  theme: ["mosquée", "adoration", "tawhid"],
  emotion: "Révérence, consécration",
  difficulty: "débutant",
  relatedNames: ["Al-Masjid", "Al-Wahid"],
  mirrorVersion: `« Les mosquées sont consacrées à Allah, n'invoquez donc personne avec Allah. » Les mosquées sont pour Allah seul. Le miroir purifie mon adoration : pas d'association dans les lieux saints. L'invocation est pour Allah seul.`,
  reflection: `Les mosquées sont pour Allah. L'association n'y a pas sa place.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna al-masajida lillahi fala tad'u ma'a Allahi ahada » — les mosquées sont pour Allah, n'invoquez personne avec Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon adoration est pure ? Est-ce que j'associe quoi que ce soit à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté de l'adoration attire la présence divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une mosquée pour l'adoration d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul dans la mosquée Le rencontre." }
  ],
  munajat: `Ya Wahid, je T'adore seul. Purifie mon adoration de toute association.`
};

MIROIR["72:19"] = {
  reference: "72:19",
  theme: ["prophète", "adoration", "assemblée"],
  emotion: "Révérence, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Abd"],
  mirrorVersion: `« Et que quand le serviteur d'Allah s'est levé pour L'invoquer, ils se sont presque jetés sur lui en masse. » Le Prophète debout dans l'adoration. Les djinns fascinés. Le miroir m'enseigne : la sincérité de l'adoration attire l'attention.`,
  reflection: `L'adoration sincère du Prophète est un modèle. La fascination suit la sincérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu lamma qama abdu Allahi yad'uhu kada'u yatakad-dabun » — quand le serviteur d'Allah s'est levé pour L'invoquer, ils se sont presque jetés sur lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon adoration est aussi sincère ? Attire-t-elle l'attention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité attire. L'hypocrisie repousse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est attirée par l'adoration sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore avec sincérité attire les cœurs." }
  ],
  munajat: `Ya Rabb, fais que mon adoration soit sincère. Attire les cœurs vers Toi par ma sincérité.`
};

MIROIR["72:20"] = {
  reference: "72:20",
  theme: ["invocation", "exclusivité", "tawhid"],
  emotion: "Détermination, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ma'bud"],
  mirrorVersion: `« Dis : Je n'invoque que mon Seigneur et je ne Lui associe personne. » L'exclusivité de l'invocation. Le miroir purifie mon du'a : seulement Allah, pas d'associé. Cette exclusivité est la essence du tawhid.`,
  reflection: `L'invocation exclusive à Allah est le tawhid en action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama ad'u rabbi wa la ushriku bihi ahada » — je n'invoque que mon Seigneur et je ne Lui associe personne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'invoque vraiment ? Mon cœur est-il exclusif à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité ouvre la porte divine. L'association la ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute invocation sincère monte vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul est exaucé." }
  ],
  munajat: `Ya Rabb, je T'invoque seul. Exauce mon invocation. Ne permets pas que j'associe.`
};

MIROIR["72:21"] = {
  reference: "72:21",
  theme: ["impuissance", "guidance", "prophète"],
  emotion: "Humilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Dis : Je ne possède pour vous ni nuisibilité ni droiture. » Le Prophète déclare son impuissance. Le miroir m'enseigne : le messager est un guide, pas un propriétaire. La nuisance et la guidance appartiennent à Allah.`,
  reflection: `Le Prophète est messager, pas maître. La guidance vient d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inni la amliku lakum darran wa la rashada » — je ne possède pour vous ni nuisibilité ni droiture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la guidance appartient à Allah ? Ne m'attends-je pas aux créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance du messager révèle la puissance du Maître." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est impuissante. Allah est le Puissant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son impuissance dépend d'Allah." }
  ],
  munajat: `Ya Hadi, Tu es le Guide. Je suis impuissant. Guide-moi par Ta miséricorde.`
};

MIROIR["72:22"] = {
  reference: "72:22",
  theme: ["protection", "impuissance", "fuite"],
  emotion: "Humilité, dépendance",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Dis : Personne ne me protégera contre Allah, et je ne trouverai aucun refuge en dehors de Lui. » L'impuissance totale face à Allah. Le miroir m'enseigne : il n'y a de protection ni refuge qu'en Allah. La fuite est impossible.`,
  reflection: `La protection et le refuge sont en Allah seul. L'impuissance est la porte de la dépendance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inni lan yujirani mina Allahi ahadun wa lan ajida min dunihi multahada » — personne ne me protégera contre Allah, et je ne trouverai pas de refuge en dehors de Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où cherche-je protection ? En qui me réfugie-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance face à Allah est la vraie force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature cherche refuge en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son impuissance trouve la protection." }
  ],
  munajat: `Ya Hafiz, je me réfugie en Toi seul. Protège-moi de tout mal.`
};

MIROIR["72:23"] = {
  reference: "72:23",
  theme: ["mission", "châtiment", "guidance"],
  emotion: "Clarté, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Bashir"],
  mirrorVersion: `« Sauf une transmission de la part d'Allah et Ses messages. » La mission du Prophète est claire : transmettre. Le miroir m'enseigne : le messager est un transmetteur. Le châtiment est pour ceux qui désobéissent.`,
  reflection: `La mission est de transmettre. La désobéissance amène le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa balaghan mina Allahi wa risalatihi » — une transmission de la part d'Allah et Ses messages." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute le message ? Est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le message est une grâce. Le rejet est un danger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message est pour tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message reçoit la guidance." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message. Guide-moi par Sa transmission.`
};

MIROIR["72:24"] = {
  reference: "72:24",
  theme: ["châtiment", "mécréance", "constatation"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Jusqu'à ce qu'ils voient ce qui leur est promis, ils sauront alors qui est plus faible en soutiens et moins nombreux en effectifs. » La constatation viendra trop tard. Le miroir m'avertit : l'heure de la vérité n'est pas l'heure du repentir.`,
  reflection: `La constatation tardive ne sert à rien. Le repentir doit être anticipé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta idha ra'aw ma yu'aduna » — jusqu'à ce qu'ils voient ce qui leur est promis. « Faya'lamuna man ad'afu nasiran wa aqallu adada » — ils sauront qui est plus faible en soutiens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends la constatation ? Ou est-ce que je me repens maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir anticipé sauve. La constatation tardive perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité éclate toujours, tôt ou tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la constatation est sauvé." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que j'attende la constatation.`
};

MIROIR["72:25"] = {
  reference: "72:25",
  theme: ["science", "promesse", "imminence"],
  emotion: "Attente, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Wa'id"],
  mirrorVersion: `« Dis : Je ne sais pas si ce qui vous est promis est proche, ou si mon Seigneur lui assignera un terme lointain. » L'ignorance du moment. Le miroir m'enseigne : l'important n'est pas le quand, mais le quoi. La promesse est certaine, le moment appartient à Allah.`,
  reflection: `Le moment appartient à Allah. La promesse est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul in adri aqaribu ma tu'aduna am yaj'alu lahu rabbi amada » — je ne sais pas si ce qui est promis est proche ou si mon Seigneur lui assigne un terme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si la promesse était imminente ? Ou est-ce que je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'imminence est une invitation à la vigilance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps appartient à Allah. La promesse s'accomplit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la vigilance est toujours prêt." }
  ],
  munajat: `Ya Alim, je ne connais pas le moment. Mais je crois en la promesse. Garde-moi vigilant.`
};

MIROIR["72:26"] = {
  reference: "72:26",
  theme: ["science", "inconnaissable", "exclusivité"],
  emotion: "Révérence, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghayb", "Al-Alim"],
  mirrorVersion: `« Il est le Connaisseur de l'inconnaissable, et Il ne révèle Son inconnaissable à personne. » La science exclusive de l'inconnaissable. Le miroir m'enseigne : il y a des secrets qui appartiennent à Allah seul. L'humilité est d'accepter cette limite.`,
  reflection: `L'inconnaissable appartient à Allah seul. L'humilité accepte la limite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alimu al-ghaybi fala yuzhiru ala ghaybihi ahada » — le Connaisseur de l'inconnaissable ne révèle Son inconnaissable à personne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma limite ? Ou est-ce que je cherche à savoir ce qui m'est caché ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La science de l'inconnaissable est une exclusivité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des secrets que seule la science divine connaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la limite trouve la paix." }
  ],
  munajat: `Ya Alim al-Ghayb, Tu connais ce qui m'est caché. J'accepte ma limite. Enseigne-moi ce que Tu veux que je sache.`
};

MIROIR["72:27"] = {
  reference: "72:27",
  theme: ["révélation", "messagers", "protection"],
  emotion: "Gratitude, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahy", "Al-Hafiz"],
  mirrorVersion: `« Sauf à celui qu'Il agrée comme messager, et alors Il fait précéder et suivre devant et derrière lui de gardiens. » La révélation est accordée aux messagers agréés. Le miroir m'enseigne : la révélation est protégée. Les gardiens assurent l'intégrité.`,
  reflection: `La révélation est accordée et protégée par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa manit-tarada min rasulin » — sauf celui qu'Il agrée comme messager. « Fa-innahu yasluku min bayni yadayhi wa min khalfihi rasada » — Il fait précéder et suivre de gardiens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois la révélation avec confiance ? Suis-je reconnaissant pour cette protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation est un don protégé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation traverse les mondes avec protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la révélation reçoit un don précieux." }
  ],
  munajat: `Ya Rabb, merci pour Ta révélation protégée. Fais que je la reçoive avec reconnaissance.`
};

MIROIR["72:28"] = {
  reference: "72:28",
  theme: ["transmission", "protection", "science"],
  emotion: "Confiance, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhaymin", "Al-Shahid"],
  mirrorVersion: `« Pour qu'il sache qu'ils ont transmis les messages de leur Seigneur. Et Il cerne ce qui est avec eux, et Il dénombre toute chose en compte. » La transmission est vérifiée. Le miroir m'enseigne : tout est compté. La transmission des messagers est entourée de la science divine.`,
  reflection: `Tout est compté. La transmission est vérifiée par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-ya'lama an qad ablaghu risalati rabbihim » — pour qu'il sache qu'ils ont transmis les messages. « Wa ahata bima ladayhim wa ahsa kulla shay'in adada » — Il cerne tout et compte toute chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que tout est compté ? Ma transmission est-elle fidèle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le compte divin est précis. Rien n'est oublié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est compté par la science divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la conscience du compte est sincère." }
  ],
  munajat: `Ya Shahid, Tu comptes tout. Fais que ma transmission soit fidèle. Ne permets pas que j'oublie le compte.`
};

MIROIR["35:30"] = {
  reference: "35:30",
  theme: ["récompense", "grâce", "augmentation"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Karim"],
  mirrorVersion: `« Afin qu'Il leur accorde leur pleine récompense et les comble de Sa grâce. » Le miroir me montre la générosité divine. « Li-yuwaffiyahum ujurahum » — afin qu'Il leur accorde leur pleine récompense. La totalité. « Wa yazidahum min fadlihi » — et les comble de Sa grâce. L'augmentation. Le miroir m'invite à espérer la générosité d'Allah.`,
  reflection: `La récompense d'Allah est complète. Sa grâce est ajoutée par pure générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yuwaffiyahum ujurahum wa yazidahum min fadlihi » — afin qu'Il leur accorde leur pleine récompense et les comble de Sa grâce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la générosité d'Allah ? Ou est-ce que je limite mes attentes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce d'Allah dépasse toujours l'attendu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit plus que ce qu'il mérite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la grâce d'Allah la reçoit au-delà de ses attentes." }
  ],
  munajat: `Ya Wahhab, j'espère Ta générosité. Donne-moi ma pleine récompense et comble-moi de Ta grâce. Ne me prive pas de Ton excédent.`
};

MIROIR["35:31"] = {
  reference: "35:31",
  theme: ["livre", "vérité", "confirmation"],
  emotion: "Certitude, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Haqq"],
  mirrorVersion: `« Ce que Nous t'avons révélé du Livre est la vérité, confirmant ce qui l'a précédé. » Le miroir me montre la continuité de la révélation. « Wa alladhi awhayna ilayka mina al-kitabi huwa al-haqqu » — ce que Nous t'avons révélé du Livre est la vérité. La véracité. « Musaddiqan lima bayna yadayhi » — confirmant ce qui l'a précédé. La continuité. Le miroir m'invite à reconnaître l'unité de la révélation.`,
  reflection: `Le Coran confirme les révélations précédentes. La vérité est une et continue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhi awhayna ilayka mina al-kitabi huwa al-haqqu musaddiqan lima bayna yadayhi » — ce que Nous t'avons révélé du Livre est la vérité, confirmant ce qui l'a précédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la continuité de la révélation ? Ou est-ce que je la vois comme isolée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est une, mais ses expressions sont multiples." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la vérité unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'unité de la révélation a compris la sagesse divine." }
  ],
  munajat: `Ya Haqq, je reconnais la vérité de Ton Livre. Merci pour la continuité de Ta révélation. Fais que je l'accepte dans son ensemble.`
};

MIROIR["35:32"] = {
  reference: "35:32",
  theme: ["héritiers", "livre", "degrés"],
  emotion: "Responsabilité, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Warith", "Al-Kitab"],
  mirrorVersion: `« Ensuite, Nous en avons fait héritiers ceux que Nous avons choisis parmi Nos serviteurs. » Le miroir me montre l'honneur de l'héritage. « Thumma awrathna al-kitaba alladhina istafayna min 'ibadina » — puis Nous en avons fait héritiers ceux que Nous avons choisis. La sélection. Le miroir m'invite à reconnaître la responsabilité de l'héritage.`,
  reflection: `L'héritage du Livre est un honneur et une responsabilité. Il y a des degrés parmi les héritiers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma awrathna al-kitaba alladhina istafayna min 'ibadina » — ensuite, Nous en avons fait héritiers ceux que Nous avons choisis parmi Nos serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un bon héritier du Livre ? Quel est mon degré parmi les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage du Livre est un don qui demande une réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers hérite de la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore l'héritage du Livre est élevé en degré." }
  ],
  munajat: `Ya Rabb, Tu m'as fait héritier de Ton Livre. Aide-moi à honorer cet héritage. Élève-moi parmi les degrés des croyants.`
};

MIROIR["35:33"] = {
  reference: "35:33",
  theme: ["paradis", "parure", "honneur"],
  emotion: "Espérance, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Zinah"],
  mirrorVersion: `« Jardins d'Eden où ils entreront, parés de bracelets d'or et de perles. » Le miroir me montre la beauté du Paradis. « Jannatu 'adnin yadkhulunaha » — jardins d'Eden où ils entreront. L'entrée. « Yuhallawna fiha min asawira min zahabin wa lu'lu'an » — parés de bracelets d'or et de perles. La parure. Le miroir m'invite à espérer la beauté éternelle.`,
  reflection: `La beauté du Paradis dépasse l'imagination. Elle est la récompense des croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatu 'adnin yadkhulunaha yuhallawna fiha min asawira min zahabin wa lu'lu'an » — jardins d'Eden où ils entreront, parés de bracelets d'or et de perles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la beauté du Paradis ? Ou est-ce que je suis absorbé par les beautés du monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté du Paradis est éternelle, celle du monde est passagère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté de l'univers n'est qu'un reflet de la beauté du Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la beauté du Paradis y est préparé." }
  ],
  munajat: `Ya Rabb, j'espère les jardins d'Eden. Pare-moi de Ta beauté éternelle. Ne me prive pas de la parure des croyants.`
};

MIROIR["35:34"] = {
  reference: "35:34",
  theme: ["gratitude", "paradis", "remerciement"],
  emotion: "Gratitude, joie",
  difficulty: "débutant",
  relatedNames: ["Ash-Shukr", "Al-Jannah"],
  mirrorVersion: `« Et ils diront : 'Louange à Allah qui a écarté de nous l'affliction.' » Le miroir me montre la gratitude au Paradis. « Wa qalu al-hamdu lillahi alladhi adhhaba 'anna al-hazan » — et ils diront : louange à Allah qui a écarté de nous l'affliction. La libération. Le miroir m'invite à la gratitude anticipée.`,
  reflection: `La gratitude éternelle est la langue du Paradis. L'affliction est écartée pour toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu al-hamdu lillahi alladhi adhhaba 'anna al-hazan » — et ils diront : louange à Allah qui a écarté de nous l'affliction." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour ce qui m'a été écarté ? Ou est-ce que je me plains de ce qui reste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude ouvre la porte à plus de bienfaits." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est dans un état de gratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant ici sera reconnaissant là-bas." }
  ],
  munajat: `Ya Rabb, louange à Toi qui écartes l'affliction. Fais que je sois parmi ceux qui Te remercient. Écarte de moi toute affliction.`
};

MIROIR["35:35"] = {
  reference: "35:35",
  theme: ["demeure", "éternité", "grâce"],
  emotion: "Reconnaissance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Maqam", "Al-Fadl"],
  mirrorVersion: `« Notre Seigneur nous a fait entrer par Sa grâce dans la Demeure de la stabilité. » Le miroir me montre la stabilité éternelle. « Alladhi awqana rabbuna fihi maqama » — notre Seigneur nous a fait entrer dans la Demeure de la stabilité. La stabilité. « Min fadlihi » — par Sa grâce. La gratuité. Le miroir m'invite à espérer la stabilité éternelle.`,
  reflection: `La Demeure de la stabilité est le Paradis. L'entrée est par la grâce, pas par le mérite seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi awqana rabbuna fihi maqaman min fadlihi » — notre Seigneur nous a fait entrer par Sa grâce dans la Demeure de la stabilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la stabilité éternelle ? Ou est-ce que je suis agité par le temporel ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La stabilité éternelle est le don de la grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers cherche sa stabilité en son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la stabilité éternelle la reçoit par la grâce." }
  ],
  munajat: `Ya Rabb, fais-moi entrer dans la Demeure de la stabilité. C'est Ta grâce qui compte. Ne me prive pas de ce don éternel.`
};

MIROIR["35:36"] = {
  reference: "35:36",
  theme: ["mécréance", "enfer", "châtiment"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Kufr"],
  mirrorVersion: `« Quant à ceux qui ont mécru, ils auront le feu de l'Enfer. » Le miroir me montre la conséquence de la mécréance. « Wa alladhina kafaru lahum nar jahannam » — quant à ceux qui ont mécru, ils auront le feu de l'Enfer. La destination. Le miroir m'avertit : la mécréance mène à l'Enfer.`,
  reflection: `L'Enfer est la destination de la mécréance. La foi est la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kafaru lahum nar jahannam » — quant à ceux qui ont mécru, ils auront le feu de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains l'Enfer ? Ou est-ce que je vis comme si la mécréance n'avait pas de conséquence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi protège de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reflète la justice de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer se protège par la foi." }
  ],
  munajat: `Ya Rabb, je Te demande protection contre l'Enfer. Garde-moi dans la foi. Ne permets pas que je sois parmi les mécréants.`
};

MIROIR["35:37"] = {
  reference: "35:37",
  theme: ["regret", "retour", "impossibilité"],
  emotion: "Regret, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nadam", "Al-Awbah"],
  mirrorVersion: `« Ils y crieront : 'Seigneur, fais-nous sortir, nous ferons le bien.' » Le miroir me montre le regret tardif. « Wa hum yastarihuna fiha » — ils y crieront. Le cri du désespoir. « Rabbana akhrijna na'mal salihan » — Seigneur, fais-nous sortir, nous ferons le bien. La promesse tardive. Le miroir m'avertit : le regret tardif est inutile.`,
  reflection: `Le regret dans l'Enfer est trop tard. L'opportunité est ici, maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hum yastarihuna fiha rabbana akhrijna na'mal salihan » — ils y crieront : Seigneur, fais-nous sortir, nous ferons le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je profite de l'opportunité maintenant ? Ou est-ce que j'attends le regret tardif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bien maintenant évite le regret de plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de seconde chance après la fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien maintenant évite le regret éternel." }
  ],
  munajat: `Ya Rabb, je fais le bien maintenant. Ne permets pas que j'attende le regret tardif. Donne-moi la droiture maintenant.`
};

MIROIR["35:38"] = {
  reference: "35:38",
  theme: ["connaissance", "cœurs", "science"],
  emotion: "Crainte, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Khafiy"],
  mirrorVersion: `« Allah connaît les secrets des cieux et de la terre, et Il connaît parfaitement le contenu des cœurs. » Le miroir me montre la connaissance absolue d'Allah. « Inna Allaha 'alimu ghayibi as-samawati wa al-ard » — Allah connaît les secrets des cieux et de la terre. La connaissance cosmique. « Huwa 'alimu bi-dhati as-sudur » — Il connaît parfaitement le contenu des cœurs. La connaissance intime. Le miroir m'invite à la vigilance.`,
  reflection: `Rien n'est caché à Allah. Les secrets des cœurs Lui sont connus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha 'alimu ghayibi as-samawati wa al-ard huwa 'alimu bi-dhati as-sudur » — Allah connaît les secrets des cieux et de la terre, et Il connaît parfaitement le contenu des cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience qu'Allah connaît mon cœur ? Ou est-ce que je cache des secrets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance d'Allah est une invitation à la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de secrets pour son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la conscience de la connaissance divine est sincère." }
  ],
  munajat: `Ya Alim, Tu connais les secrets de mon cœur. Aide-moi à vivre dans la sincérité. Ne permets pas que je cache ce qui T'est connu.`
};

MIROIR["35:39"] = {
  reference: "35:39",
  theme: ["succession", "juge", "responsabilité"],
  emotion: "Responsabilité, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Hakam"],
  mirrorVersion: `« C'est Lui qui a fait de vous des successeurs sur terre. » Le miroir me montre la responsabilité de la succession. « Huwa alladhi ja'alakum khala'ifa fi al-ard » — c'est Lui qui a fait de vous des successeurs sur terre. La fonction. Le miroir m'invite à assumer ma responsabilité de successeur.`,
  reflection: `Être successeur sur terre est une responsabilité. Le jugement est à venir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi ja'alakum khala'ifa fi al-ard » — c'est Lui qui a fait de vous des successeurs sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'assume ma responsabilité de successeur ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La succession sur terre est un test, pas un privilège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a été confié à l'homme comme successeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa succession la remplit avec excellence." }
  ],
  munajat: `Ya Rabb, Tu m'as fait successeur sur terre. Aide-moi à assumer cette responsabilité. Juge-moi avec miséricorde.`
};

MIROIR["35:40"] = {
  reference: "35:40",
  theme: ["idolâtrie", "création", "impuissance"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Asnam"],
  mirrorVersion: `« Dis : 'Voyez-vous vos associés que vous invoquez en dehors d'Allah ? Montrez-moi ce qu'ils ont créé de la terre.' » Le miroir me montre l'impuissance des idoles. « A-ra'aytum shuraka'akum alladhina tad'un min duni Allah » — voyez-vous vos associés que vous invoquez en dehors d'Allah ? L'interrogation. « Aruni madha khalaqu mina al-ard » — montrez-moi ce qu'ils ont créé de la terre. Le défi. Le miroir m'invite à voir la vérité.`,
  reflection: `Les idoles ne créent rien. Elles ne méritent pas l'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul a-ra'aytum shuraka'akum alladhina tad'un min duni Allah aruni madha khalaqu mina al-ard » — dis : voyez-vous vos associés que vous invoquez en dehors d'Allah ? Montrez-moi ce qu'ils ont créé de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'invoque en dehors d'Allah ? Qu'est-ce que cela a créé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Seul le Créateur mérite l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé par Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'impuissance des idoles cesse de les adorer." }
  ],
  munajat: `Ya Khaliq, Tu es le seul Créateur. Je n'invoque rien en dehors de Toi. Montre-moi la vérité de Ta création.`
};

MIROIR["35:42"] = {
  reference: "35:42",
  theme: ["serment", "réponse", "hypocrisie"],
  emotion: "Mise en garde, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wa'd", "Al-Hidaya"],
  mirrorVersion: `« Ils ont juré par Allah de toutes leurs forces que si un avertisseur leur venait, ils seraient mieux guidés que n'importe quelle communauté. » Le miroir me montre l'hypocrisie du serment. « Wa aqsamu bi-Allahi jahda aymanihim » — ils ont juré par Allah de toutes leurs forces. Le serment solennel. « La-in ja'ahum nadhirun la-yakununa ahda min ihda al-umam » — si un avertisseur leur venait, ils seraient mieux guidés. La prétention. Le miroir m'avertit : les mots ne valent rien sans les actes.`,
  reflection: `Les serments sans sincérité sont hypocrites. La guidance demande une vraie réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aqsamu bi-Allahi jahda aymanihim la-in ja'ahum nadhirun la-yakununa ahda min ihda al-umam » — ils ont juré par Allah de toutes leurs forces que si un avertisseur leur venait, ils seraient mieux guidés que n'importe quelle communauté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes serments sont sincères ? Ou est-ce que je suis hypocrite dans mes promesses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie guidance est dans les actes, pas dans les serments." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne jure pas, il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère n'a pas besoin de jurer." }
  ],
  munajat: `Ya Rabb, mes serments sont sincères. Ne permets pas que je sois hypocrite dans mes promesses. Donne-moi la guidance vraie, pas la guidance prétendue.`
};

MIROIR["35:43"] = {
  reference: "35:43",
  theme: ["orgueil", "ruse", "sunna"],
  emotion: "Mise en garde, constance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kibr", "As-Sunna"],
  mirrorVersion: `« Par orgueil sur terre et mauvaise ruse. » Le miroir me montre les deux maladies. « Istitkabaran fi al-ard » — par orgueil sur terre. La première maladie. « Wa makra as-sayyi' » — et mauvaise ruse. La deuxième maladie. Le miroir m'avertit : l'orgueil et la ruse ne mènent qu'à la perte.`,
  reflection: `L'orgueil et la ruse sont les armes des mécréants. La sunna d'Allah ne change pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Istitkabaran fi al-ard wa makra as-sayyi' » — par orgueil sur terre et mauvaise ruse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai de l'orgueil ? Est-ce que je rus contre la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité et la sincérité sont les vertus opposées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas d'orgueil, il est soumis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne l'orgueil et la ruse est guidé." }
  ],
  munajat: `Ya Rabb, je Te demande protection contre l'orgueil et la ruse. Purifie mon cœur de ces maladies. Donne-moi l'humilité et la sincérité.`
};

MIROIR["35:44"] = {
  reference: "35:44",
  theme: ["voyage", "précédents", "leçon"],
  emotion: "Réflexion, sagesse",
  difficulty: "débutant",
  relatedNames: ["As-Safar", "Al-'Ibar"],
  mirrorVersion: `« N'ont-ils donc jamais voyagé pour voir comment fut la fin de ceux qui les ont précédés ? » Le miroir me montre l'importance du voyage réflexif. « Afalam yasiru fi al-ard » — n'ont-ils donc jamais voyagé. L'invitation au voyage. « Fa-yanzuru kayfa kana 'aqibatu alladhina min qablihim » — pour voir comment fut la fin de ceux qui les ont précédés. La leçon de l'histoire. Le miroir m'invite à apprendre du passé.`,
  reflection: `Le voyage dans la terre enseigne les leçons de l'histoire. La fin des précédents est un avertissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afalam yasiru fi al-ard fa-yanzuru kayfa kana 'aqibatu alladhina min qablihim » — n'ont-ils donc jamais voyagé pour voir comment fut la fin de ceux qui les ont précédés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les erreurs du passé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un maître pour celui qui veut apprendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers porte les traces de l'histoire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire évite ses erreurs." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire des précédents. Ne permets pas que je répète leurs erreurs. Donne-moi la sagesse du voyage et de la réflexion.`
};

MIROIR["35:45"] = {
  reference: "35:45",
  theme: ["délai", "impuissance", "justice"],
  emotion: "Espoir et crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhlim", "Al-Qadir"],
  mirrorVersion: `« S'Il les saisissait pour ce qu'ils ont acquis, Il précipiterait le châtiment sur eux. » Le miroir me montre le délai divin. « Wa law yu'akhidhu Allahu an-nasa bima kasab » — s'Il les saisissait pour ce qu'ils ont acquis. La justice immédiate. « Ma taraka 'ala zahiriha min dabbatin » — Il ne laisserait sur sa surface aucun être vivant. La totalité. Le miroir m'invite à la gratitude pour le délai.`,
  reflection: `Le délai d'Allah est une miséricorde. Sans elle, personne ne survivrait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law yu'akhidhu Allahu an-nasa bima kasab ma taraka 'ala zahiriha min dabbatin » — s'Il les saisissait pour ce qu'ils ont acquis, Il ne laisserait sur sa surface aucun être vivant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour le délai d'Allah ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une opportunité pour le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers existe par le délai d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le délai profite de l'opportunité du repentir." }
  ],
  munajat: `Ya Rabb, merci pour Ton délai. Je me repens avant qu'il ne soit trop tard. Ne permets pas que j'abuse de Ta patience.`
};

// ==================== SURAH 36: YA SIN - MISSING VERSES ====================

MIROIR["36:2"] = {
  reference: "36:2",
  theme: ["sagesse", "coran", "serment"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Qur'an"],
  mirrorVersion: `« Par le Coran plein de sagesse. » Le miroir me montre le serment divin. « Wa al-Qur'ani al-hakim » — par le Coran plein de sagesse. Le serment est sur le Livre. La sagesse est son attribut. Le miroir m'invite à honorer le Coran comme un livre de sagesse.`,
  reflection: `Le Coran est sage. Chaque verset contient une sagesse pour celui qui réfléchit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-Qur'ani al-hakim » — par le Coran plein de sagesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran comme un livre de sagesse ? Ou est-ce que je le lis sans réflexion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse du Coran transforme celui qui la contemple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est gouverné par la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la sagesse du Coran reçoit la sagesse." }
  ],
  munajat: `Ya Hakim, Ton Coran est plein de sagesse. Ouvre mon cœur à Sa sagesse. Fais que je le lise avec contemplation.`
};

MIROIR["36:3"] = {
  reference: "36:3",
  theme: ["messager", "droiture", "mission"],
  emotion: "Honoration, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Mursalin"],
  mirrorVersion: `« Tu es certes du nombre des messagers. » Le miroir me montre l'honneur conféré au Prophète. « Inna ka la-mina al-mursalina » — tu es certes du nombre des messagers. L'appartenance à la chaîne prophétique. Le miroir m'invite à reconnaître la dignité du messager.`,
  reflection: `Le Prophète appartient à la noble lignée des messagers. Sa mission est divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ka la-mina al-mursalina » — tu es certes du nombre des messagers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la dignité du Prophète ? Est-ce que je suis son exemple ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dignité du messager rejaillit sur ceux qui le suivent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers honore les messagers de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore le messager honore Celui qui l'a envoyé." }
  ],
  munajat: `Ya Rabb, j'honore Ton messager. Fais que je sois parmi ceux qui le suivent. Donne-moi la dignité de son chemin.`
};

MIROIR["36:4"] = {
  reference: "36:4",
  theme: ["droit", "chemin", "guidance"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sirat", "Al-Mustaqim"],
  mirrorVersion: `« Sur un chemin droit. » Le miroir me montre la droiture du Prophète. « 'Ala siratin mustaqim » — sur un chemin droit. La droiture est constante. Le miroir m'invite à suivre le chemin droit.`,
  reflection: `Le chemin droit est le chemin de tous les prophètes. Il mène à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala siratin mustaqim » — sur un chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sur le chemin droit ? Ou est-ce que je dévie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin droit est simple mais demande de la constance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit son chemin droit par la soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le chemin droit atteint la destination." }
  ],
  munajat: `Ya Rabb, je veux suivre le chemin droit. Guide-moi sur ce chemin. Ne permets pas que je dévie à droite ou à gauche.`
};

MIROIR["36:6"] = {
  reference: "36:6",
  theme: ["avertissement", "pères", "oublieux"],
  emotion: "Responsabilité, compassion",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Ghafilin"],
  mirrorVersion: `« Pour que tu avertisses un peuple dont les pères n'ont pas été avertis. » Le miroir me montre la mission d'avertissement. « Li-tundhira qawman ma undhira aba'uhum » — pour que tu avertisses un peuple dont les pères n'ont pas été avertis. Le peuple est sans guidance préalable. Le miroir m'invite à écouter l'avertissement.`,
  reflection: `L'avertissement est une miséricorde pour ceux qui n'ont pas reçu de guidance avant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-tundhira qawman ma undhira aba'uhum » — pour que tu avertisses un peuple dont les pères n'ont pas été avertis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute l'avertissement ? Ou est-ce que je suis comme les pères non avertis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une opportunité, pas une contrainte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est averti par les signes de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement change de destin." }
  ],
  munajat: `Ya Rabb, j'écoute Ton avertissement. Ne permets pas que je sois parmi les insouciants. Guide-moi par Ta miséricorde.`
};

MIROIR["36:8"] = {
  reference: "36:8",
  theme: ["entraves", "cou", "châtiment"],
  emotion: "Compassion, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aghlal", "Al-'Adhab"],
  mirrorVersion: `« Nous avons mis des entraves à leurs cous. » Le miroir me montre l'image de l'entrave. « Inna ja'alna fi a'naqihim aghlalan » — Nous avons mis des entraves à leurs cous. L'entrave spirituelle. Le miroir m'avertit : le rejet de la guidance crée des entraves.`,
  reflection: `Les entraves sont spirituelles avant d'être physiques. Le cou entravé ne peut lever la tête vers la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ja'alna fi a'naqihim aghlalan » — Nous avons mis des entraves à leurs cous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cou est libre ? Ou est-ce que je suis entravé par mes propres rejets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté du cou passe par l'acceptation de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas d'entraves, il est libre dans sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la guidance libère son cou de toute entrave." }
  ],
  munajat: `Ya Rabb, libère mon cou de toute entrave. Accepte ma soumission à Ta guidance. Ne permets pas que je sois entravé par mon rejet.`
};

MIROIR["36:9"] = {
  reference: "36:9",
  theme: ["barrière", "devant", "derrière"],
  emotion: "Tristesse, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hijab", "Al-Ghayy"],
  mirrorVersion: `« Et Nous avons mis une barrière devant eux et une barrière derrière eux. » Le miroir me montre l'isolement complet. « Wa ja'alna min bayni aydihim saddan » — et Nous avons mis une barrière devant eux. L'obstacle devant. « Wa min khalfihim saddan » — et une barrière derrière eux. L'obstacle derrière. Le miroir m'avertit : le rejet complet isole complètement.`,
  reflection: `Les barrières devant et derrière enferment dans l'égarement. La sortie est impossible sans la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna min bayni aydihim saddan wa min khalfihim saddan » — et Nous avons mis une barrière devant eux et une barrière derrière eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis entouré de barrières ? Ou est-ce que je suis ouvert à la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture à la guidance enlève les barrières." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de barrières avec son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la guidance n'a pas de barrières." }
  ],
  munajat: `Ya Rabb, enlève les barrières autour de moi. Ouvre-moi à Ta guidance. Ne permets pas que je sois isolé par mon rejet.`
};

MIROIR["36:10"] = {
  reference: "36:10",
  theme: ["avertissement", "indifférence", "conséquence"],
  emotion: "Indifférence, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Haqq"],
  mirrorVersion: `« Que tu les avertisses ou non, ils ne croiront pas. » Le miroir me montre l'endurcissement du cœur. « Wa sawa'un 'alayhim a-andhartahum am lam tundhirhum » — que tu les avertisses ou non. L'indifférence totale. « La yu'minun » — ils ne croiront pas. L'endurcissement. Le miroir m'avertit : l'indifférence à l'avertissement mène à l'endurcissement.`,
  reflection: `Certains cœurs sont si endurcis que l'avertissement ne les atteint pas. La prière pour la guidance reste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sawa'un 'alayhim a-andhartahum am lam tundhirhum la yu'minun » — que tu les avertisses ou non, ils ne croiront pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cœur est ouvert à l'avertissement ? Ou est-ce qu'il est endurci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur ouvert se laisse transformer par l'avertissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est toujours ouvert à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son cœur ouvert reçoit la guidance." }
  ],
  munajat: `Ya Rabb, garde mon cœur ouvert à Ton avertissement. Ne permets pas qu'il s'endurcisse. Transforme-moi par Ta parole.`
};

// ==================== SURAH 73: AL-MUZAMMIL - MISSING VERSES ====================

MIROIR["73:2"] = {
  reference: "73:2",
  theme: ["nuit", "prière", "effort"],
  emotion: "Consécration, discipline",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Qawiy"],
  mirrorVersion: `« Lève-toi la nuit, un peu, la moitié, ou un peu moins. » La prière nocturne demande un effort. Le miroir m'invite à la discipline : se lever la nuit, même un peu. La constance est plus importante que la quantité.`,
  reflection: `La prière nocturne élève. L'effort constant transforme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qumi al-layla illa qalila » — lève-toi la nuit, un peu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me lève pour Allah ? La nuit est-elle mon temps de prière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit est le temps de l'intimité. Le jour est le temps de l'action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est faite pour le repos... et pour la prière des élus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie la nuit rencontre Allah dans l'intimité." }
  ],
  munajat: `Ya Rabb, aide-moi à me lever pour Toi. Fais de la nuit mon temps de rencontre.`
};

MIROIR["73:3"] = {
  reference: "73:3",
  theme: ["nuit", "prière", "mesure"],
  emotion: "Équilibre, dévotion",
  difficulty: "débutant",
  relatedNames: ["Al-Muqit", "Al-Adl"],
  mirrorVersion: `« Ou la moitié, ou un peu moins. » La prière nocturne a des mesures. Le miroir m'enseigne : la constance prime sur la quantité. Allah demande un effort réaliste, pas impossible.`,
  reflection: `La constance est la clé. La mesure assure la durabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nisfahu aw inqis minhu qalila » — la moitié, ou un peu moins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie la nuit avec constance ? Ou est-ce que je cherche la perfection impossible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance petite est meilleure que l'effort grand mais éphémère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature respecte les cycles et les mesures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec constance reçoit la lumière." }
  ],
  munajat: `Ya Rabb, aide-moi à être constant. Accepte mon petit effort fidèle.`
};

MIROIR["73:4"] = {
  reference: "73:4",
  theme: ["Coran", "récitation", "mesure"],
  emotion: "Dévotion, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Jamil"],
  mirrorVersion: `« Et récite le Coran lentement et distinctement. » La récitation du Coran demande du temps. Le miroir m'enseigne : le Coran n'est pas à lire en vitesse. Il est à réciter avec art et présence.`,
  reflection: `Le Coran est à réciter avec beauté et lenteur. La présence prime sur la quantité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rattili al-qur'ana tartila » — récite le Coran lentement et distinctement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je récite le Coran ? Avec présence ou en vitesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lenteur permet la compréhension. La précipitation fait perdre le sens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la parole d'Allah. Elle mérite d'être récitée avec art." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui récite avec présence reçoit la lumière du Coran." }
  ],
  munajat: `Ya Rabb, apprends-moi à réciter Ton Coran avec beauté. Fais que chaque verset pénètre mon cœur.`
};

MIROIR["73:5"] = {
  reference: "73:5",
  theme: ["révélation", "poids", "mission"],
  emotion: "Responsabilité, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahy", "Al-Thaqil"],
  mirrorVersion: `« Nous allons faire descendre sur toi une parole lourde. » La révélation est un poids. Le miroir m'enseigne : le Coran n'est pas léger. Il porte une responsabilité. Le Prophète a porté ce poids avec grâce.`,
  reflection: `La révélation est un poids. La mission est une responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna sanulqi 'alayka qawlan thaqila » — Nous allons faire descendre sur toi une parole lourde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je porte le Coran comme un poids sacré ? Ou est-ce que je le prends à la légère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le poids de la révélation élève celui qui le porte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah a un poids que les cieux et la terre ne peuvent porter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte le Coran avec respect reçoit sa lumière." }
  ],
  munajat: `Ya Rabb, aide-moi à porter Ton Coran. Fais que je le prenne avec la gravité qu'il mérite.`
};

MIROIR["73:6"] = {
  reference: "73:6",
  theme: ["nuit", "prière", "impact"],
  emotion: "Intimité, efficacité",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Mujib"],
  mirrorVersion: `« La prière de la nuit a plus d'impact et est plus propice à la parole. » La nuit est le temps de l'impact. Le miroir m'enseigne : la prière nocturne a une qualité particulière. Le cœur est plus présent, la parole plus droite.`,
  reflection: `La nuit amplifie la prière. Le cœur y est plus présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna nashi'ata al-layli hiya ashaddu wat'an wa aquamu qila » — la prière de la nuit a plus d'impact et est plus propice à la parole." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais l'impact de la prière nocturne ? Mon cœur y est-il plus présent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit est le temps de la connexion. Le jour est le temps de l'action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit calme le monde pour la prière des élus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie la nuit avec présence reçoit l'impact." }
  ],
  munajat: `Ya Rabb, fais que je connaisse l'impact de la prière nocturne. Ouvre mon cœur à sa qualité.`
};

MIROIR["73:7"] = {
  reference: "73:7",
  theme: ["jour", "occupation", "équilibr"],
  emotion: "Réalisme, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Nahar", "Al-Waqit"],
  mirrorVersion: `« Tu as pendant le jour de longues occupations. » Le jour est occupé. Le miroir m'enseigne : l'équilibre est nécessaire. La nuit pour la prière, le jour pour les obligations. Les deux sont worship quand le cœur est présent.`,
  reflection: `Le jour a ses obligations. La nuit a sa prière. L'équilibre est la voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna laka fi al-nahari sabhan tawila » — tu as pendant le jour de longues occupations." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je gère mon temps avec sagesse ? Le jour pour les obligations, la nuit pour la prière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les occupations du jour sont aussi une adoration quand le cœur est présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle jour-nuit est une miséricorde pour l'équilibre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui équilibre jour et nuit trouve la plénitude." }
  ],
  munajat: `Ya Rabb, aide-moi à équilibrer mes obligations et ma prière. Fais que tout soit adoration.`
};

MIROIR["73:9"] = {
  reference: "73:9",
  theme: ["Seigneur", "orient", "occident", "tawhid"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mashriq", "Al-Maghrib", "Al-Rabb"],
  mirrorVersion: `« Le Seigneur de l'Orient et de l'Occident, il n'y a de divinité que Lui. Prends-Le donc comme Protecteur. » Allah est le Seigneur de toutes les directions. Le miroir m'enseigne : Il est partout, Il est le seul protecteur. La confiance en Lui est la sécurité.`,
  reflection: `Allah est le Seigneur de toutes les directions. Il est le seul protecteur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbu al-mashriqi wa al-maghribi la ilaha illa huwa fattakhidhhu wakila » — le Seigneur de l'Orient et de l'Occident, il n'y a de divinité que Lui. Prends-Le comme Protecteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends Allah comme protecteur ? Ma confiance est-elle en Lui seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection divine englobe tout. Les autres protections sont limitées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Orient et l'Occident témoignent de la seigneurie d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend Allah comme protecteur est véritablement protégé." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur de toutes les directions. Je Te prends comme protecteur. Garde-moi.`
};

MIROIR["73:10"] = {
  reference: "73:10",
  theme: ["patience", "parole", "mécréants"],
  emotion: "Sérénité, dignité",
  difficulty: "débutant",
  relatedNames: ["Al-Sabur", "Al-Halim"],
  mirrorVersion: `« Et supporte patiemment ce qu'ils disent, et éloigne-toi d'eux de façon convenable. » La patience face aux paroles. Le miroir m'enseigne : la réponse aux attaques n'est pas la réaction, mais la patience et le bel éloignement.`,
  reflection: `La patience est la réponse. Le bel éloignement est la dignité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wasbir 'ala ma yaquluna wahjuruhum hajran jamila » — supporte patiemment ce qu'ils disent et éloigne-toi d'eux convenablement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis aux attaques ? Est-ce que je pratique la patience et le bel éloignement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience élève. La réaction abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création supporte avec patience. L'homme doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente avec dignité reçoit l'élévation." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience. Aide-moi à m'éloigner avec dignité.`
};

MIROIR["73:11"] = {
  reference: "73:11",
  theme: ["mécréants", "châtiment", "délai"],
  emotion: "Confiance, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'akhkhir", "Al-Muntaqim"],
  mirrorVersion: `« Et laisse-Moi avec ceux qui crient au mensonge, ceux qui vivent dans l'aisance. » Le délai divin. Le miroir m'enseigne : le temps des mécréants est compté. L'aisance apparente n'est pas une preuve de faveur.`,
  reflection: `Le délai n'est pas l'oubli. L'aisance n'est pas la bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa thirni wa al-mukadh-dhibina uli al-ni'mati wa mahhilhum ruwayda » — laisse-Moi avec les négateurs dans l'aisance, et donne-leur un court délai." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis trompé par l'aisance des mécréants ? Le délai m'alerte-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde pour le repentir. Pas une preuve d'impunité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aisance dans la mécréance est une illusion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le délai se repent avant la fin." }
  ],
  munajat: `Ya Rabb, ne me laisse pas tromper par les apparences. Donne-moi la compréhension du délai.`
};

MIROIR["73:12"] = {
  reference: "73:12",
  theme: ["enfer", "châtiment", "préparation"],
  emotion: "Avertissement, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Shadid"],
  mirrorVersion: `« Nous avons des entraves et un brasier. » Les outils du châtiment. Le miroir m'avertit : l'enfer est réel. Les entraves et le feu attendent les mécréants. La préparation est urgente.`,
  reflection: `L'enfer est réel. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ladayna ankal wa jahima » — Nous avons des entraves et un brasier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains l'enfer ? Ma préparation est-elle sérieuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation sauve. La négligence condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine a ses outils." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'enfer se prépare." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'enfer. Aide-moi à me préparer sérieusement.`
};

MIROIR["73:13"] = {
  reference: "73:13",
  theme: ["enfer", "nourriture", "châtiment"],
  emotion: "Horreur, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Muntaqim"],
  mirrorVersion: `« Une nourriture qui s'attache aux gorges et un châtiment douloureux. » Les détails du châtiment. Le miroir m'avertit : l'enfer est concret. Les descriptions sont vives pour éveiller la crainte.`,
  reflection: `Les descriptions de l'enfer sont vives pour éveiller la crainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ta'aman dha ghussatin wa 'adhaban alima » — une nourriture qui s'attache aux gorges et un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les châtiments ? La crainte me pousse-t-elle à la préparation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La description du châtiment est une miséricorde pour avertir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine a des conséquences concrètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur l'enfer le fuit." }
  ],
  munajat: `Ya Rabb, préserve-moi de ces châtiments. Fais que la crainte me pousse vers Toi.`
};

MIROIR["73:14"] = {
  reference: "73:14",
  theme: ["résurrection", "terre", "montagnes"],
  emotion: "Tremblement, awe",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ba'th", "Al-Qahir"],
  mirrorVersion: `« Le jour où la terre et les montagnes trembleront, et les montagnes deviendront comme du sable dispersé. » Le tremblement du Jour. Le miroir me projette dans cette scène : tout tremble, tout s'effondre. Seule reste la présence d'Allah.`,
  reflection: `Le Jour du tremblement. Tout s'effondre sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tarjuful-ardu wa al-jibalu wa kanati al-jibalu kathiban mahila » — le jour où la terre et les montagnes trembleront, et les montagnes deviendront comme du sable dispersé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je visualise ce Jour ? Suis-je prêt pour le tremblement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble stable s'effondrera. Ce qui est vraiment stable restera." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière tremblera devant son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache à Allah ne tremble pas." }
  ],
  munajat: `Ya Qahir, le Jour vient où tout tremblera. Attache-moi à Toi pour que je ne tremble pas.`
};

MIROIR["73:15"] = {
  reference: "73:15",
  theme: ["prophète", "mission", "avertissement"],
  emotion: "Responsabilité, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Nadhir"],
  mirrorVersion: `« Nous vous avons envoyé un messager pour être témoin contre vous, comme Nous avons envoyé un messager à Pharaon. » La mission du Prophète. Le miroir m'enseigne : le messager est un témoin. Sa mission est d'avertir comme celui envoyé à Pharaon.`,
  reflection: `Le messager est un témoin. Son avertissement est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna arsalna ilaykum rasulan shahidan 'alaykum kama arsalna ila fir'awna rasula » — Nous vous avons envoyé un messager témoin, comme Nous avons envoyé un messager à Pharaon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute l'avertissement du messager ? Ou est-ce que je suis comme Pharaon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde. Le rejet est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu un messager." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le messager est sauvé." }
  ],
  munajat: `Ya Rabb, j'écoute Ton messager. Ne permets pas que je sois comme Pharaon.`
};

MIROIR["73:16"] = {
  reference: "73:16",
  theme: ["Pharaon", "désobéissance", "châtiment"],
  emotion: "Avertissement, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Shadid"],
  mirrorVersion: `« Pharaon a désobéi au messager, Nous l'avons donc saisi d'une punition accablante. » L'exemple de Pharaon. Le miroir m'avertit : la désobéissance au messager a des conséquences. Le châtiment suit l'obstination.`,
  reflection: `La désobéissance au messager amène le châtiment. L'exemple de Pharaon est un avertissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'asaw fir'awnu al-rasula fa-akhadhnahu akhdhan wabila » — Pharaon a désobéi au messager, Nous l'avons saisi d'une punition accablante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis au messager ? Ou est-ce que je suis l'exemple de Pharaon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance sauve. La désobéissance perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine d'exemples à méditer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur Pharaon ne répète pas son erreur." }
  ],
  munajat: `Ya Rabb, préserve-moi de la désobéissance. Fais que j'obéis à Ton messager.`
};

MIROIR["73:17"] = {
  reference: "73:17",
  theme: ["mécréance", "châtiment", "fuite"],
  emotion: "Avertissement, urgence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Muhit"],
  mirrorVersion: `« Comment vous protéger, si vous mécroirez, d'un jour qui rendra les enfants blancs de vieillesse ? » L'horreur du Jour. Le miroir m'avertit : la mécréance expose au Jour terrible. Même les enfants vieilliront de terreur.`,
  reflection: `La mécréance expose au Jour terrible. La foi est la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakayfa tattaquna in kafartum yawman yaj'alu al-wildana shiban » — comment vous protéger si vous mécroirez d'un jour qui rendra les enfants blancs de vieillesse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise l'horreur de ce Jour ? La foi est-elle ma protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi protège. La mécréance expose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour sera terrifiant pour les mécréants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sera protégé de l'horreur." }
  ],
  munajat: `Ya Rabb, je crois en Toi. Protège-moi de l'horreur de ce Jour.`
};

MIROIR["73:18"] = {
  reference: "73:18",
  theme: ["cieux", "charge", "jour"],
  emotion: "Awe, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sama", "Al-Qahir"],
  mirrorVersion: `« Le ciel s'en fendra. Sa promesse s'accomplira. » Le ciel lui-même sera affecté. Le miroir m'enseigne : la grandeur du Jour dépasse toute imagination. Même les cieux ne peuvent supporter la charge.`,
  reflection: `Le ciel s'en fendra. La grandeur du Jour dépasse tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-sama'u munfatirun bihi kana wa'duhu maf'ula » — le ciel s'en fendra. Sa promesse s'accomplira." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur de ce Jour ? Suis-je prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur du Jour pousse à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux et la terre trembleront ce Jour-là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la grandeur du Jour se prépare." }
  ],
  munajat: `Ya Rabb, le Jour est grand. Aide-moi à me préparer. Fais que je sois prêt.`
};

MIROIR["73:19"] = {
  reference: "73:19",
  theme: ["rappel", "chemin", "volonté"],
  emotion: "Espoir, encouragement",
  difficulty: "débutant",
  relatedNames: ["Al-Tadhkira", "Al-Hadi"],
  mirrorVersion: `« Ceci est un rappel. Que celui qui le veut prenne un chemin vers son Seigneur. » Le choix est offert. Le miroir m'invite : le rappel est là, le chemin est ouvert. Le choix m'appartient. La volonté est la clé.`,
  reflection: `Le rappel est offert. Le choix appartient à chacun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadhihi tadhkiratun faman sha'aittakhadha ila rabbihi sabila » — ceci est un rappel. Que celui qui le veut prenne un chemin vers son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends le chemin ? Ma volonté est-elle tournée vers Allah ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le rappel appelle la volonté. La volonté ouvre le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin vers Allah est ouvert pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui le veut vraiment trouve le chemin." }
  ],
  munajat: `Ya Rabb, je veux prendre le chemin vers Toi. Ouvre-moi la voie.`
};

MIROIR["73:20"] = {
  reference: "73:20",
  theme: ["prière", "nuit", "allègement"],
  emotion: "Soulagement, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Rahman", "Al-Ghafur"],
  mirrorVersion: `« Ton Seigneur sait que tu te lèves en prière près des deux tiers de la nuit, ou de la moitié, ou du tiers. » L'effort du Prophète est reconnu. Puis vient l'allègement : « Récitez ce qui est facile pour vous. » Le miroir me montre la miséricorde d'Allah qui reconnaît l'effort et facilite la pratique.`,
  reflection: `Allah reconnaît l'effort et facilite la pratique. La religion est facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbaka ya'lamu annaka taqumu adna min thuluthi al-layli wa nisfahu wa thulthahu » — ton Seigneur sait que tu te lèves près des deux tiers de la nuit, ou la moitié, ou le tiers. « Faqra'u ma tayassara minhu » — récitez ce qui est facile pour vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pratique avec constance ? Est-ce que j'accepte la facilité sans négliger l'effort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort est reconnu. La facilité est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La facilité dans la religion est une miséricorde universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique avec constance et accepte la facilité reste sur le chemin." }
  ],
  munajat: `Ya Rahman, merci pour la facilité. Aide-moi à pratiquer avec constance. Accepte mon effort.`
};

MIROIR["36:12"] = {
  reference: "36:12",
  theme: ["vie", "mort", "résurrection"],
  emotion: "Espérance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« C'est Nous qui donnons la vie et faisons mourir, et c'est vers Nous que sera la destination finale. » Le miroir me montre le cycle de la vie. « Inna Nahnu nuhyi wa numit » — c'est Nous qui donnons la vie et faisons mourir. Le cycle. « Wa ilayna al-masir » — et c'est vers Nous que sera la destination finale. Le retour. Le miroir m'invite à méditer sur la vie, la mort et le retour.`,
  reflection: `La vie et la mort sont entre les mains d'Allah. Le retour vers Lui est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Nahnu nuhyi wa numit wa ilayna al-masir » — c'est Nous qui donnons la vie et faisons mourir, et c'est vers Nous que sera la destination finale." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur ma mort ? Est-ce que je me prépare au retour vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation sur la mort donne sens à la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier suit le cycle vie-mort-retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur le cycle vit avec intention." }
  ],
  munajat: `Ya Muhyi, Ya Mumit, Tu donnes la vie et la mort. Prépare-moi pour le retour vers Toi. Fais que je vive avec la conscience de la mort.`
};

MIROIR["36:13"] = {
  reference: "36:13",
  theme: ["parabole", "cité", "messagers"],
  emotion: "Contemplation, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mathal", "Al-Qarya"],
  mirrorVersion: `« Cite-leur la parabole des habitants de la cité. » Le miroir me montre l'enseignement par la parabole. « Wa adrib lahum mathalan ashaba al-qarya » — cite-leur la parabole des habitants de la cité. L'histoire enseignante. Le miroir m'invite à apprendre des paraboles du Coran.`,
  reflection: `Les paraboles du Coran sont des enseignements vivants. Chaque histoire contient une leçon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adrib lahum mathalan ashaba al-qarya » — cite-leur la parabole des habitants de la cité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends des paraboles du Coran ? Ou est-ce que je les lis sans réflexion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parabole est un miroir pour le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est une parabole de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les paraboles comprend la sagesse." }
  ],
  munajat: `Ya Rabb, j'apprends de Tes paraboles. Ouvre mon cœur aux leçons qu'elles contiennent. Fais que je sois parmi ceux qui comprennent.`
};

MIROIR["36:14"] = {
  reference: "36:14",
  theme: ["messagers", "envoi", "réponse"],
  emotion: "Espérance, leçon",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Mab'uth"],
  mirrorVersion: `« Quand Nous leur envoyâmes deux messagers, ils les traitèrent de menteurs. » Le miroir me montre le rejet initial. « Idh arsalna ilayhimu ithnayni » — quand Nous leur envoyâmes deux messagers. L'envoi double. « Fa-kadhdhabuhuma » — ils les traitèrent de menteurs. Le rejet. Le miroir m'avertit : le rejet des messagers est une tradition ancienne.`,
  reflection: `Le rejet des messagers précède souvent l'acceptation. La persévérance du message est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh arsalna ilayhimu ithnayni fa-kadhdhabuhuma » — quand Nous leur envoyâmes deux messagers, ils les traitèrent de menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le message du premier coup ? Ou est-ce que je suis comme ceux qui rejettent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation du message est un signe de guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte le message de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message rapidement est béni." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message. Ne permets pas que je sois parmi ceux qui rejettent. Donne-moi la droiture de la réponse.`
};

MIROIR["36:15"] = {
  reference: "36:15",
  theme: ["humanité", "messagers", "accusation"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Bashar", "Ar-Rasul"],
  mirrorVersion: `« Ils dirent : 'Vous n'êtes que des hommes comme nous.' » Le miroir me montre l'accusation d'humanité. « Qalu ma antum illa basharun mithluna » — vous n'êtes que des hommes comme nous. L'accusation. Le miroir m'enseigne : le messager est humain, mais sa mission est divine.`,
  reflection: `Le messager est humain, mais le message est divin. L'humanité du messager n'enlève rien à la vérité du message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ma antum illa basharun mithluna » — ils dirent : vous n'êtes que des hommes comme nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le message humain porteur de vérité divine ? Ou est-ce que je le rejette pour son humanité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le messager humain est le signe de la miséricorde d'Allah pour les humains." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé par le même Créateur qui envoie les messagers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le messager humain accepte le message divin." }
  ],
  munajat: `Ya Rabb, j'accepte Ton messager humain. Je reconnais que sa mission est divine. Ne permets pas que son humanité m'empêche de croire.`
};

MIROIR["36:16"] = {
  reference: "36:16",
  theme: ["envoi", "témoignage", "véracité"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mab'uth", "Ash-Shahid"],
  mirrorVersion: `« Ils dirent : 'Notre Seigneur sait que nous sommes vraiment envoyés à vous.' » Le miroir me montre le témoignage des messagers. « Qalu rabbuna ya'lamu inna ilaykum la-mursalun » — notre Seigneur sait que nous sommes vraiment envoyés à vous. La certitude. Le miroir m'invite à croire au témoignage des messagers.`,
  reflection: `Le témoignage des messagers est confirmé par la connaissance d'Allah. Leur véracité est divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu rabbuna ya'lamu inna ilaykum la-mursalun » — ils dirent : notre Seigneur sait que nous sommes vraiment envoyés à vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au témoignage des messagers ? Ou est-ce que je le mets en doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage des messagers est confirmé par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la véracité des messagers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au témoignage des messagers reçoit la guidance." }
  ],
  munajat: `Ya Rabb, je crois au témoignage de Tes messagers. Tu sais qu'ils sont véridiques. Donne-moi la guidance par leur message.`
};

MIROIR["36:17"] = {
  reference: "36:17",
  theme: ["obligation", "transmission", "clarté"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Balagh", "Al-Wajib"],
  mirrorVersion: `« Et il ne nous incombe que de transmettre clairement. » Le miroir me montre la responsabilité des messagers. « Wa ma 'alayna illa al-balaghu al-mubin » — et il ne nous incombe que de transmettre clairement. La mission est claire. Le miroir m'enseigne : la transmission est la responsabilité, l'acceptation est la liberté de l'auditeur.`,
  reflection: `Le messager transmet clairement. L'auditeur est libre d'accepter ou de rejeter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma 'alayna illa al-balaghu al-mubin » — et il ne nous incombe que de transmettre clairement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le message clair ? Ou est-ce que je le rejette malgré sa clarté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté du message met l'auditeur face à sa responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit le message clair de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le message clair a fait son choix." }
  ],
  munajat: `Ya Rabb, j'accepte Ton message clair. Merci pour la transmission claire. Donne-moi la guidance par Ta clarté.`
};

MIROIR["36:18"] = {
  reference: "36:18",
  theme: ["malheur", "accusation", "rejet"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["At-Tabarra", "Ash-Shu'ara"],
  mirrorVersion: `« Ils dirent : 'Nous vous considérons comme un mauvais présage.' » Le miroir me montre l'accusation de malheur. « Qalu inna tatayyarna bikum » — nous vous considérons comme un mauvais présage. L'accusation. Le miroir m'avertit : l'accusation des messagers est une forme de rejet.`,
  reflection: `Accuser les messagers de porter malheur est une accusation injuste. Le messager apporte la guidance, pas le malheur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu inna tatayyarna bikum » — ils dirent : nous vous considérons comme un mauvais présage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accuse les porteurs de vérité de porter malheur ? Ou est-ce que je les accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le messager apporte la bénédiction, pas le malheur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accueille les messagers de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille le messager accueille la bénédiction." }
  ],
  munajat: `Ya Rabb, j'accueille Tes messagers. Ne permets pas que je les accuse de malheur. Donne-moi la bénédiction de leur accueil.`
};

MIROIR["36:19"] = {
  reference: "36:19",
  theme: ["présage", "malheur", "réponse"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["At-Tabarra", "At-Tadhkir"],
  mirrorVersion: `« Votre présage est avec vous. » Le miroir me montre le retournement. « Ta'irukum ma'akum » — votre présage est avec vous. Le malheur vient de vous. Le miroir m'enseigne : le malheur n'est pas dans le messager, mais dans le rejet.`,
  reflection: `Le malheur vient du rejet, pas du messager. L'accusation injuste se retourne contre l'accusateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ta'irukum ma'akum » — ils dirent : votre présage est avec vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crée mon propre malheur par le rejet ? Ou est-ce que j'évite le malheur par l'acceptation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur est dans le rejet, la bénédiction dans l'acceptation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'accuse pas les messagers de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que le malheur vient du rejet change d'attitude." }
  ],
  munajat: `Ya Rabb, je comprends que le malheur vient du rejet. Accepte mon accueil du message. Donne-moi la bénédiction de l'acceptation.`
};

MIROIR["36:20"] = {
  reference: "36:20",
  theme: ["sage", "appel", "foi"],
  emotion: "Espérance, courage",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Iman"],
  mirrorVersion: `« Un homme vint du bout de la cité, en toute hâte. » Le miroir me montre le croyant courageux. « Wa ja'a min aqsa al-madinati rajulun yas'a » — un homme vint du bout de la cité, en toute hâte. La hâte de la foi. Le miroir m'invite à être parmi ceux qui soutiennent la vérité.`,
  reflection: `Le croyant courageux vient de loin pour soutenir la vérité. Sa hâte montre son zèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'a min aqsa al-madinati rajulun yas'a » — un homme vint du bout de la cité, en toute hâte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je viens en hâte vers la vérité ? Ou est-ce que je traîne à l'accepter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La hâte vers la vérité est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers se hâte vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vient en hâte vers la vérité reçoit la guidance." }
  ],
  munajat: `Ya Rabb, je viens en hâte vers Ta vérité. Ne permets pas que je traîne. Donne-moi le zèle du croyant courageux.`
};

MIROIR["36:21"] = {
  reference: "36:21",
  theme: ["suivi", "guidance", "gratuité"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ittiba", "Al-Hidaya"],
  mirrorVersion: `« Suivez ceux qui ne demandent aucune récompense et qui sont bien guidés. » Le miroir me montre le critère du suivi. « Ittabi'u man la yas'alukum ajran » — suivez ceux qui ne demandent aucune récompense. La gratuité. « Wa hum muhtadun » — et qui sont bien guidés. La guidance. Le miroir m'invite à suivre les guides sincères.`,
  reflection: `Le vrai guide ne demande rien en retour. Il est lui-même bien guidé. Le suivre est un chemin sûr.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittabi'u man la yas'alukum ajran wa hum muhtadun » — suivez ceux qui ne demandent aucune récompense et qui sont bien guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je suis ? Des guides sincères ou des guides intéressés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le guide sincère est un don d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit les guides que son Créateur a établis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le guide sincère trouve le chemin." }
  ],
  munajat: `Ya Rabb, je suis les guides sincères que Tu as envoyés. Merci pour leur gratuité et leur guidance. Donne-moi le chemin sûr.`
};

MIROIR["36:22"] = {
  reference: "36:22",
  theme: ["adoration", "gratitude", "créateur"],
  emotion: "Reconnaissance, dévotion",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'bud", "Al-Khaliq"],
  mirrorVersion: `« Pourquoi n'adorerais-je pas Celui qui m'a créé et vers Qui vous serez ramenés ? » Le miroir me montre la logique de l'adoration. « Wa ma liya la a'budu alladhi fatarani » — pourquoi n'adorerais-je pas Celui qui m'a créé ? La création comme raison. « Wa ilayhi turja'un » — et vers Qui vous serez ramenés. Le retour. Le miroir m'invite à adorer le Créateur.`,
  reflection: `La création et le retour vers Allah sont deux raisons suffisantes pour l'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma liya la a'budu alladhi fatarani wa ilayhi turja'un » — pourquoi n'adorerais-je pas Celui qui m'a créé et vers Qui vous serez ramenés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore mon Créateur ? Ou est-ce que j'adore autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration du Créateur est la seule adoration logique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers adore son Créateur par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la logique de l'adoration adore sincèrement." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé et c'est vers Toi que je retourne. J'adore Toi seul. Ne permets pas que j'adore autre que Toi.`
};

MIROIR["36:23"] = {
  reference: "36:23",
  theme: ["idolâtrie", "intercession", "égarement"],
  emotion: "Clarté, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shafa'ah", "Al-Wahid"],
  mirrorVersion: `« Prendrais-je en dehors de Lui des divinités ? » Le miroir me montre l'absurdité de l'idolâtrie. « Atattakhidhu min dunihi alihatan » — prendrais-je en dehors de Lui des divinités ? L'interrogation rhétorique. Le miroir m'enseigne : l'idolâtrie n'a pas de sens.`,
  reflection: `Les idoles ne peuvent ni bénéficier ni nuire. L'intercession sans permission est impossible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Atattakhidhu min dunihi alihatan » — prendrais-je en dehors de Lui des divinités ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends des idoles en dehors d'Allah ? Quelles sont mes idoles cachées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole est tout ce qui prend la place d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas d'idoles, il a un seul Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne les idoles trouve Allah." }
  ],
  munajat: `Ya Wahid, je ne prends pas de divinités en dehors de Toi. Purifie mon cœur de toute idole. Fais que je T'adore seul.`
};

MIROIR["36:24"] = {
  reference: "36:24",
  theme: ["égarement", "impossibilité", "clarté"],
  emotion: "Certitude, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Dalal", "Al-Huda"],
  mirrorVersion: `« Je serais alors dans un égarement évident. » Le miroir me montre la conséquence de l'idolâtrie. « In idhan la-fi dalalin mubin » — je serais alors dans un égarement évident. La conséquence est claire. Le miroir m'enseigne : l'idolâtrie est un égarement manifeste.`,
  reflection: `L'égarement de l'idolâtrie est évident pour celui qui voit avec le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In idhan la-fi dalalin mubin » — je serais alors dans un égarement évident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'égarement de l'idolâtrie ? Ou est-ce que je le minimise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté de l'égarement invite à la droiture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne s'égare pas, il reste sur le chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'égarement clairement l'évite." }
  ],
  munajat: `Ya Rabb, je reconnais l'égarement de l'idolâtrie. Garde-moi sur le chemin droit. Ne permets pas que je m'égare.`
};

MIROIR["36:25"] = {
  reference: "36:25",
  theme: ["foi", "annonciation", "paradis"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Jannah"],
  mirrorVersion: `« J'ai cru en votre Seigneur, écoutez-moi donc. » Le miroir me montre la proclamation de foi. « Inni amantu bi-rabbikum » — j'ai cru en votre Seigneur. La foi déclarée. « Fa-sma'un » — écoutez-moi donc. L'appel à l'écoute. Le miroir m'invite à proclamer ma foi.`,
  reflection: `La foi proclamée est le premier pas vers la guidance des autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inni amantu bi-rabbikum fa-sma'un » — j'ai cru en votre Seigneur, écoutez-moi donc." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je proclame ma foi ? Ou est-ce que je la cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proclamation de la foi invite les autres à croire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame la foi par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui proclame sa foi influence son entourage." }
  ],
  munajat: `Ya Rabb, je proclame ma foi en Toi. Fais que ma proclamation guide les autres. Donne-moi le courage de témoigner.`
};

MIROIR["36:26"] = {
  reference: "36:26",
  theme: ["entrée", "paradis", "félicitation"],
  emotion: "Joie, félicité",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "As-Salam"],
  mirrorVersion: `« Entre au Paradis ! » Le miroir me montre l'accueil immédiat. « Udkhulu al-jannata » — entre au Paradis ! L'invitation divine. Le miroir m'invite à espérer cet accueil pour le croyant sincère.`,
  reflection: `L'entrée au Paradis est immédiate pour le croyant martyr. La récompense suit la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udkhulu al-jannata » — entre au Paradis !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère l'entrée au Paradis ? Ou est-ce que je doute de la miséricorde d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'entrée au Paradis est la récompense de la foi sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination finale de l'univers croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère le Paradis y est préparé." }
  ],
  munajat: `Ya Rabb, j'espère l'entrée au Paradis. Fais que je sois parmi ceux qui entrent par Ta miséricorde. Donne-moi la félicité éternelle.`
};

MIROIR["36:27"] = {
  reference: "36:27",
  theme: ["grâce", "paradis", "récompense"],
  emotion: "Gratitude, joie",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Al-Karam"],
  mirrorVersion: `« Il dit : 'Si mon peuple savait ce que mon Seigneur m'a pardonné !' » Le miroir me montre la gratitude du croyant. « Qala ya layta qawmi ya'lamuna 'ala ma ghafara li rabbi » — si mon peuple savait ce que mon Seigneur m'a pardonné ! La gratitude. Le miroir m'invite à la gratitude pour le pardon.`,
  reflection: `Le croyant au Paradis souhaite que son peuple connaisse la miséricorde d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ya layta qawmi ya'lamuna 'ala ma ghafara li rabbi » — il dit : si mon peuple savait ce que mon Seigneur m'a pardonné !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour le pardon d'Allah ? Est-ce que je souhaite que les autres connaissent cette miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon d'Allah est une grâce qui mérite d'être partagée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier bénéficie de la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la miséricorde d'Allah veut la partager." }
  ],
  munajat: `Ya Ghafur, merci pour Ton pardon. Fais que je sois reconnaissant et que je partage Ta miséricorde avec les autres. Donne-moi la grâce du Paradis.`
};

MIROIR["36:28"] = {
  reference: "36:28",
  theme: ["armée", "protection", "miracle"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Jund", "Al-Hifz"],
  mirrorVersion: `« Nous ne fîmes descendre du ciel aucune armée après lui. » Le miroir me montre la protection divine. « Wa ma anzalna 'ala qawmihi min ba'dihi min jund mina as-sama'i » — Nous ne fîmes descendre aucune armée après lui. Pas besoin d'armée pour punir. Le miroir m'enseigne : la puissance d'Allah n'a pas besoin d'armée.`,
  reflection: `La punition divine ne nécessite pas d'armée. Un simple cri suffit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma anzalna 'ala qawmihi min ba'dihi min jund mina as-sama'i » — Nous ne fîmes descendre du ciel aucune armée après lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la puissance d'Allah sans intermédiaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance d'Allah est directe, sans besoin d'armée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah directement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la puissance directe d'Allah a une foi complète." }
  ],
  munajat: `Ya Qadir, Ta puissance n'a pas besoin d'armée. Je reconnais Ta force directe. Protège-moi par Ta puissance.`
};

MIROIR["36:29"] = {
  reference: "36:29",
  theme: ["cri", "destruction", "impuissance"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Sayha", "Al-Halak"],
  mirrorVersion: `« Ce ne fut qu'un seul Cri, et les voilà éteints. » Le miroir me montre la facilité de la destruction. « In kanat illa sayhatan wahidatan » — ce ne fut qu'un seul Cri. La simplicité. « Fa-idha hum khamidun » — et les voilà éteints. La totalité. Le miroir m'avertit : la punition d'Allah est facile et totale.`,
  reflection: `Un seul cri suffit pour anéantir un peuple. La puissance d'Allah est sans limite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In kanat illa sayhatan wahidatan fa-idha hum khamidun » — ce ne fut qu'un seul Cri, et les voilà éteints." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le cri de la punition ? Ou est-ce que je vis dans l'insouciance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du cri invite à la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut être anéanti par un seul commandement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le cri se prépare par la piété." }
  ],
  munajat: `Ya Rabb, je crains Ton cri. Prépare-moi par la piété. Ne permets pas que je sois parmi les éteints.`
};

MIROIR["36:30"] = {
  reference: "36:30",
  theme: ["tristesse", "messagers", "moquerie"],
  emotion: "Tristesse, compassion",
  difficulty: "débutant",
  relatedNames: ["Al-Hasrah", "Ar-Rasul"],
  mirrorVersion: `« Quel dommage pour les serviteurs ! » Le miroir me montre la tristesse divine. « Ya hasratan 'ala al-'ibad » — quel dommage pour les serviteurs ! La compassion. « Ma ya'tihim min rasulin illa kanu bihi yastahzi'un » — aucun messager ne leur vient sans qu'ils s'en moquent. La moquerie. Le miroir m'avertit : la moquerie des messagers est une tradition regrettable.`,
  reflection: `La moquerie des messagers est une perte pour les serviteurs. La foi est un gain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya hasratan 'ala al-'ibad ma ya'tihim min rasulin illa kanu bihi yastahzi'un » — quel dommage pour les serviteurs ! Aucun messager ne leur vient sans qu'ils s'en moquent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque des messagers ? Ou est-ce que je les honore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur des messagers est la marque de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers honore les messagers de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore les messagers échappe au dommage." }
  ],
  munajat: `Ya Rabb, je n'appartiens pas aux moqueurs. J'honneure Tes messagers. Préserve-moi du dommage de la moquerie.`
};

MIROIR["36:31"] = {
  reference: "36:31",
  theme: ["précédents", "destruction", "leçon"],
  emotion: "Réflexion, mise en garde",
  difficulty: "débutant",
  relatedNames: ["As-Salaf", "Al-'Ibrah"],
  mirrorVersion: `« N'ont-ils pas vu combien de générations Nous avons fait périr avant eux ? » Le miroir me montre la leçon de l'histoire. « Alam yaraw kam ahlakna qablahum mina al-quruni » — n'ont-ils pas vu combien de générations Nous avons fait périr avant eux ? L'histoire enseignante. Le miroir m'invite à apprendre des précédents.`,
  reflection: `Les générations précédentes ont été détruites pour leur mécréance. La leçon est claire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam yaraw kam ahlakna qablahum mina al-quruni » — n'ont-ils pas vu combien de générations Nous avons fait périr avant eux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends des générations précédentes ? Ou est-ce que j'oublie leur destin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des précédents est un avertissement pour les vivants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers porte les traces des générations passées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des précédents évite leur sort." }
  ],
  munajat: `Ya Rabb, j'apprends des générations passées. Ne permets pas que j'oublie leur leçon. Garde-moi parmi les croyants.`
};

MIROIR["36:32"] = {
