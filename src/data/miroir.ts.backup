  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Mihad"],
  mirrorVersion: `« L'Enfer, où ils brûleront. Quel mauvais lit ! » Le miroir décrit : « Jahannama yaslawnaha wa bi'sa al-mihad » — l'Enfer, où ils brûleront. Quel mauvais lit ! Le feu est le lit des mécréants. Le miroir m'avertit : le choix du lit est le choix de la vie.`,
  reflection: `Le lit de l'Enfer est le feu. Le choix d'ici-bas détermine le lit de là-bas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jahannama yaslawnaha wa bi'sa al-mihad » — l'Enfer, où ils brûleront. Quel mauvais lit !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel lit je prépare pour moi-même ? Le feu ou les jardins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le lit d'ici-bas peut devenir le lit de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu purifie ou punit — selon le destinataire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le lit préparé ici détermine le lit de là-bas." }
  ],
  munajat: `Ya Rabb, je ne veux pas du lit de l'Enfer. Prépare-moi un lit dans les jardins. Épargne-moi le feu.`
};

