    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la vengeance divine ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété protège de la vengeance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vengeance divine atteint les injustes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux n'a pas à craindre la vengeance." }
  ],
  munajat: `Ya Rabb, je crains Ta vengeance. Ne permets pas l'insouciance. Protège-moi par ma piété.`
};

MIROIR["15:80"] = {
  reference: "15:80",
  theme: ["thamud", "messagers", "rejet"],
  emotion: "Mise en garde, tristesse",
  difficulty: "débutant",
  relatedNames: ["Thamud", "Ar-Rusul"],
  mirrorVersion: `« Les Thamud ont aussi traité les messagers de menteurs. » Le miroir me montre le rejet des messagers. « Wa laqad kadhaba ashabu al-hijri al-mursalina » — les Thamud ont aussi traité les messagers de menteurs. Le rejet des messagers mène à la destruction. Le miroir m'interroge : est-ce que j'accepte les messagers ?`,
  reflection: `Le rejet des messagers mène à la destruction. Les accepter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad kadhaba ashabu al-hijri al-mursalina » — les Thamud ont aussi traité les messagers de menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les messagers ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des messagers est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les messagers sont envoyés pour guider." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les messagers est guidé." }
  ],
  munajat: `Ya Rabb, j'accepte Tes messagers. Ne permets pas que je les rejette. Guide-moi par leur message.`
};

MIROIR["15:81"] = {
  reference: "15:81",
