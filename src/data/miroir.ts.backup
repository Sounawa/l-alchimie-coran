    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que la rétribution est un bienfait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense vient avant même l'acte, dans l'intention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création reçoit selon sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce la reçoit multipliée." }
  ],
  munajat: `Ya Mannan, Ta justice est un bienfait. Fais que je reconnaisse Tes promesses. Donne-moi la certitude de Ta récompense.`
};

MIROIR["55:62"] = {
  reference: "55:62",
  theme: ["paradis", "jardins", "deux"],
  emotion: "Émerveillement, abondance",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wadud"],
  mirrorVersion: `« Et il y aura deux jardins en plus. » Le miroir me montre l'abondance surabondante. « Wa min duni huma jannatan » — et en dessous, deux autres jardins. La générosité d'Allah n'a pas de limite. Les jardins se multiplient.`,
  reflection: `Deux jardins principaux, puis deux autres. L'abondance du Paradis est sans fin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min duni huma jannatan » — et il y aura deux jardins en plus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'imagine l'abondance infinie du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les jardins du Paradis reflètent les jardins du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le jardin de tous les jardins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive son jardin intérieur reçoit les jardins extérieurs." }
  ],
  munajat: `Ya Karim, Tes jardins sont innombrables. Donne-moi d'y entrer. Fais que j'en désire la beauté.`
};

