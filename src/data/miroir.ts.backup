  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma nahnu bi-maslukin » — et Nous vous remplacerons par des semblables." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis irremplaçable ? Ou est-ce que je reconnais que je peux être remplacé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le remplacement possible appelle à l'excellence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les générations se succèdent. La création continue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'excellente devient irremplaçable par la qualité." }
  ],
  munajat: `Ya Badi', Tu peux me remplacer. Fais que je m'excellence pour ne pas être remplacé. Donne-moi de valoir par les œuvres.`
};

MIROIR["56:62"] = {
  reference: "56:62",
  theme: ["résurrection", "première création", "analogie"],
  emotion: "Certitude, logique",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Khaliq"],
  mirrorVersion: `« Et vous avez connu la première création. Ne vous rappelez-vous donc pas ? » Le miroir me montre la logique. « Wa laqad 'alimtum al-nash'ata al-ula falawla tadhakkarun » — vous avez connu la première création. Ne vous rappelez-vous pas ?`,
  reflection: `Si Allah a créé une première fois, Il peut créer une deuxième fois. La résurrection est logique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad 'alimtum al-nash'ata al-ula falawla tadhakkarun » — et vous avez connu la première création. Ne vous rappelez-vous donc pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple ma première création ? Est-ce que j'en tire la logique de la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La première création prouve la seconde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est le modèle de la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la première création croit à la seconde." }
  ],
  munajat: `Ya Ba'ith, Tu as créé et Tu ressuscites. Donne-moi la certitude de la résurrection. Fais que je contemple la première création pour croire à la seconde.`
};

MIROIR["9:24"] = {
  reference: "9:24",
  theme: ["priorité", "amour", "foi"],
  emotion: "Interrogation, sincérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wadud", "Al-Haqq"],
  mirrorVersion: `« Dis : Si vos pères, vos fils, vos frères, vos épouses, vos clans vous sont plus chers qu'Allah et Son messager, attendez-vous au châtiment. » Le miroir me montre la hiérarchie de l'amour. « Ahabba ilaykum » — vous sont plus chers. L'amour pour Allah doit surpasser tout autre amour. Le miroir m'interroge : qu'est-ce qui m'est le plus cher ?`,
  reflection: `L'amour pour Allah doit être au-dessus de tout. Les liens familiaux ne peuvent pas Lui être préférés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul in kana abaukum wa abna'ukum wa ikhwanukum wa azwajukum ahabba ilaykum min Allah » — dis : Si vos pères, vos fils, vos frères, vos épouses vous sont plus chers qu'Allah..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'est le plus cher ? Est-ce qu'Allah est au sommet de mes amours ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour pour les créatures sans amour pour le Créateur est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour pour Allah est le fondement de tous les autres amours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime Allah par-dessus tout aime tout le reste correctement." }
  ],
  munajat: `Ya Wadud, Tu es le Bien-Aimé. Fais que Tu sois le plus cher à mon cœur. Ne permets pas que les créatures prennent Ta place.`
};

MIROIR["9:25"] = {
  reference: "9:25",
  theme: ["victoire", "nombre", "foi"],
  emotion: "Humilité, leçon",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nasir", "Al-Hakim"],
  mirrorVersion: `« Allah vous a secourus en maints endroits, et le jour de Hunayn, quand vous étiez fiers de votre grand nombre. » Le miroir me montre la leçon de Hunayn. « Yauma hunaynin » — le jour de Hunayn. Les musulmans étaient nombreux et fiers, mais la victoire a failli leur échapper. La fierté du nombre est dangereuse. Le miroir m'interroge : est-ce que je me fie au nombre ou à Allah ?`,
  reflection: `Le nombre sans la bénédiction d'Allah ne sert à rien. La fierté du nombre est une faiblesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad nasarakumu Allahu fi mawatin kathiratin wa yawma hunaynin idh a'jabatkum kathratukum » — Allah vous a secourus en maints endroits, et le jour de Hunayn, quand vous étiez fiers de votre grand nombre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me fie au nombre ou à Allah ? Est-ce que je suis fier de mes ressources ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fierté des moyens cache souvent l'oubli d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La victoire vient d'Allah, pas des moyens humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah seul reçoit la victoire." }
  ],
  munajat: `Ya Nasir, Tu donnes la victoire. Fais que je compte sur Toi, pas sur mes moyens. Ne permets pas que la fierté me fasse perdre Ta bénédiction.`
};

MIROIR["9:26"] = {
  reference: "9:26",
  theme: ["secours", "calme", "anges"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sakinah", "Al-Mala'ika"],
  mirrorVersion: `« Puis Allah fit descendre Sa quiétude sur Son messager et sur les croyants, et fit descendre des armées invisibles. » Le miroir me montre le secours divin. « Anzala sakinatahu » — fit descendre Sa quiétude. « Wa junudan lam tarawha » — des armées invisibles. La quiétude et les anges sont venus rétablir la situation. Le miroir m'interroge : est-ce que je demande la quiétude d'Allah dans mes moments de panique ?`,
  reflection: `La quiétude d'Allah calme les cœurs. Les anges sont les alliés invisibles des croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma anzala Allahu sakinatahu 'ala rasulihi wa 'ala al-mu'minina wa anzala junudan lam tarawha » — puis Allah fit descendre Sa quiétude sur Son messager et sur les croyants, et fit descendre des armées invisibles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la quiétude d'Allah dans mes moments de panique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La quiétude vient de l'intérieur par la grâce d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges participent à l'ordre de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la quiétude d'Allah ne craint rien." }
  ],
  munajat: `Ya Sakinah, fais descendre Ta quiétude sur moi. Calme mon cœur dans les moments de panique. Envoie Tes anges à mon secours.`
};

MIROIR["9:27"] = {
  reference: "9:27",
  theme: ["pardon", "repentir", "miséricorde"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Puis Allah accueille le repentir de qui Il veut. Allah est Pardonneur et Miséricordieux. » Le miroir me montre le pardon divin. « Yatubu Allahi 'ala man yasha' » — Allah accueille le repentir de qui Il veut. Le repentir est accepté. Le miroir m'interroge : est-ce que je me repens pour recevoir le pardon ?`,
  reflection: `Le repentir est accepté par Allah. Sa miséricorde est ouverte à tous ceux qui reviennent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yatubu Allahu 'ala man yasha' wa Allahu ghafurun rahim » — puis Allah accueille le repentir de qui Il veut. Allah est Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens pour recevoir le pardon ? Ou est-ce que je persévère dans le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon attend le repentir. Le repentir attend la décision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent est lavé de ses péchés." }
  ],
  munajat: `Ya Tawwab, Tu accueilles le repentir. Je me repens devant Toi. Accepte mon repentir et pardonne-moi.`
};

MIROIR["9:28"] = {
  reference: "9:28",
  theme: ["pureté", "mosquée", "interdiction"],
  emotion: "Respect, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Tahir", "Al-Masjid"],
  mirrorVersion: `« Ô vous qui croyez ! Les idolâtres ne sont que souillure. Qu'ils ne s'approchent plus de la Mosquée sacrée après cette année. » Le miroir me montre la pureté de la Mosquée. « Innama al-mushrikuna najas » — les idolâtres ne sont que souillure. La Mosquée sacrée doit être purifiée. Le miroir m'interroge : est-ce que je préserve la pureté de mes lieux de culte ?`,
  reflection: `La Mosquée sacrée exige la pureté. L'idolâtrie est une souillure spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama al-mushrikuna najasun fa-la yaqrabu al-masjida al-harama ba'da 'amihim hadha » — les idolâtres ne sont que souillure. Qu'ils ne s'approchent plus de la Mosquée sacrée après cette année." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la pureté de mes lieux de culte ? De mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté extérieure reflète la pureté intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Mosquée sacrée est le lieu le plus pur sur terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la pureté est digne de la Maison d'Allah." }
  ],
  munajat: `Ya Tahir, Tu es le Pur. Purifie mon cœur et mes lieux de culte. Fais que je sois digne de Ta Maison sacrée.`
};

MIROIR["9:29"] = {
  reference: "9:29",
  theme: ["combat", "jizya", "gens du livre"],
  emotion: "Fermeté, justice",
  difficulty: "avancé",
  relatedNames: ["Al-Qahhar", "Al-Hakam"],
  mirrorVersion: `« Combattez ceux qui ne croient pas en Allah... parmi les gens du Livre, jusqu'à ce qu'ils paient la jizya. » Le miroir me montre le statut des gens du Livre. « Qatilu alladhina la yu'minuna » — combattez ceux qui ne croient pas. La jizya est un statut de protection en échange d'un impôt. Le miroir m'interroge : est-ce que je comprends les lois de la communauté islamique ?`,
  reflection: `La jizya permet aux non-musulmans de vivre sous protection islamique. C'est un statut de tolérance et de justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qatilu alladhina la yu'minuna bi-Allahi... hatta yu'tu al-jizyata 'an yadin wa hum saghirun » — combattez ceux qui ne croient pas en Allah... jusqu'à ce qu'ils paient la jizya de leurs propres mains, en état d'humilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends les lois de la communauté islamique ? La place de la tolérance et de la justice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection a un prix. La liberté a des limites." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute communauté a ses lois. L'islam a les siennes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les lois divines les accepte avec sagesse." }
  ],
  munajat: `Ya Hakam, Tu établis les lois. Fais que je les comprenne et les accepte. Donne-moi la sagesse de voir la justice dans Tes commandements.`
};

MIROIR["9:30"] = {
  reference: "9:30",
  theme: ["foi", "erreur", "gens du livre"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Les Juifs disent : Uzayr est fils d'Allah. Les Chrétiens disent : Le Christ est fils d'Allah. » Le miroir me montre les erreurs des gens du Livre. « Qalati al-yahudu 'uzayrun ibnu Allah » — les Juifs disent : Uzayr est fils d'Allah. L'erreur de l'association. Le miroir m'interroge : est-ce que je garde ma foi pure de toute association ?`,
  reflection: `L'erreur des gens du Livre est d'associer à Allah. La vérité est l'unicité absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalati al-yahudu 'uzayrun ibnu Allahi wa qalati al-nasara al-masihu ibnu Allah » — les Juifs disent : Uzayr est fils d'Allah. Les Chrétiens disent : Le Christ est fils d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je garde ma foi pure de toute association ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'association est la plus grande erreur. L'unicité est la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité d'Allah est la vérité universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde l'unicité pure est sur la vérité." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Préserve ma foi de toute association. Fais que je garde l'unicité pure.`
};

MIROIR["9:31"] = {
  reference: "9:31",
  theme: ["obéissance", "religion", "erreur"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Ar-Rabb"],
  mirrorVersion: `« Ils ont pris leurs rabbins et leurs moines comme seigneurs en dehors d'Allah. » Le miroir me montre l'obéissance aveugle. « Ittakhadhu ahbarahum wa ruhbanahum arbaban » — ils ont pris leurs rabbins comme seigneurs. L'obéissance aux hommes au lieu d'Allah est un égarement. Le miroir m'interroge : à qui j'obéis en priorité ?`,
  reflection: `L'obéissance aveugle aux hommes est une forme d'idolâtrie. Seul Allah mérite l'obéissance absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittakhadhu ahbarahum wa ruhbanahum arbaban min duni Allah » — ils ont pris leurs rabbins et leurs moines comme seigneurs en dehors d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui j'obéis en priorité ? Est-ce que j'obéis aux hommes contre les commandements d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance aux hommes doit être soumise à l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute obéissance est relative sauf l'obéissance à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit à Allah seul est vraiment libre." }
  ],
  munajat: `Ya Rabb, Tu es le seul Maître. Fais que je T'obéis par-dessus tout. Ne permets pas que j'obéisse aux hommes contre Toi.`
};

MIROIR["9:32"] = {
  reference: "9:32",
  theme: ["lumière", "opposition", "islam"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Kamil"],
  mirrorVersion: `« Ils veulent éteindre la lumière d'Allah avec leurs bouches. Mais Allah ne veut que parfaire Sa lumière. » Le miroir me montre l'opposition futile. « Yuriduna an yutfi'u nur Allah » — ils veulent éteindre la lumière d'Allah. Mais la lumière d'Allah ne peut pas être éteinte. Le miroir m'interroge : est-ce que j'ai confiance que la lumière d'Allah triomphera ?`,
  reflection: `La lumière d'Allah ne peut être éteinte. Les efforts des mécréants sont vains.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuriduna an yutfi'u nur Allahi bi-afwahihim wa ya'ba Allahu illa an yutimma nurahu » — ils veulent éteindre la lumière d'Allah avec leurs bouches. Mais Allah ne veut que parfaire Sa lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai confiance que la lumière d'Allah triomphera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les efforts contre la vérité la renforcent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière d'Allah éclaire l'univers entier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte la lumière participe à son accomplissement." }
  ],
  munajat: `Ya Nur, Ta lumière est inéteignable. Fais que j'en sois porteur. Confirme ma confiance que Ta lumière triomphera.`
};

MIROIR["9:33"] = {
  reference: "9:33",
  theme: ["islam", "victoire", "religion"],
  emotion: "Confiance, fierté spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Ghalib"],
  mirrorVersion: `« C'est Lui qui a envoyé Son messager avec la guidée et la religion de vérité pour la faire prédominer sur toute religion. » Le miroir me montre la destinée de l'islam. « Li-yuzhirahu 'ala al-dini kullihi » — pour la faire prédominer sur toute religion. L'islam triomphera. Le miroir m'interroge : est-ce que je travaille pour ce triomphe ?`,
  reflection: `L'islam triomphera. Le croyant travaille pour accélérer ce triomphe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi arsala rasulahu bi-al-huda wa dini al-haqqi li-yuzhirahu 'ala al-dini kullihi » — c'est Lui qui a envoyé Son messager avec la guidée et la religion de vérité pour la faire prédominer sur toute religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille pour le triomphe de l'islam ? Ou est-ce que je suis passif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le triomphe est promis mais l'effort est demandé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'islam est la religion universelle destinée à l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le triomphe de l'islam participe au dessein divin." }
  ],
  munajat: `Ya Rabb, Tu as promis le triomphe de l'islam. Fais que je participe à ce triomphe. Utilise-moi pour propager Ta religion.`
};

MIROIR["9:34"] = {
  reference: "9:34",
  theme: ["richesse", "clergé", "injustice"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Ghaniyy"],
  mirrorVersion: `« Ô vous qui croyez ! Beaucoup de rabbins et de moines dévorent les biens des gens par le faux. » Le miroir me montre l'abus religieux. « Ya akuluna amwala al-nas » — dévorent les biens des gens. L'abus religieux est un crime. Le miroir m'interroge : est-ce que je suis vigilant contre les abus religieux ?`,
  reflection: `L'abus religieux est un crime. Le clergé corrompu dévore les biens des gens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kathiran min al-ahbari wa al-ruhbani la-ya'kuluna amwala al-nasi bi-al-batili » — beaucoup de rabbins et de moines dévorent les biens des gens par le faux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vigilant contre les abus religieux ? Ou est-ce que je fais confiance aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance protège contre l'abus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion véridique n'exploite pas les gens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vigilant préserve sa religion et ses biens." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Préserve-moi des abuses religieux. Fais que je sois vigilant et juste.`
};

MIROIR["9:35"] = {
  reference: "9:35",
  theme: ["or", "châtiment", "avarice"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Mawt"],
  mirrorVersion: `« Le jour où ces ors et argents seront chauffés dans le feu de l'Enfer et leurs fronts marqués. » Le miroir me montre le châtiment de l'avarice. « Yuhma 'alayha fi nari jahannama » — chauffés dans le feu de l'Enfer. L'or thésaurisé brûlera son propriétaire. Le miroir m'interroge : est-ce que je paie ma zakat ?`,
  reflection: `L'or thésaurisé sans droit deviendra châtiment. La zakat purifie les biens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yuhma 'alayha fi nari jahannama fa-tukwa biha jibahuhum » — le jour où ces ors et argents seront chauffés dans le feu de l'Enfer et leurs fronts marqués." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je paie ma zakat ? Est-ce que je thésaurise sans droit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'or sans zakat devient châtiment. L'or avec zakat devient bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse est un test de partage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui paie la zakat purifie ses biens." }
  ],
  munajat: `Ya Hasib, Tu demandes des comptes. Fais que je paie ma zakat. Ne permets pas que mon or devienne mon châtiment.`
};

MIROIR["9:37"] = {
  reference: "9:37",
  theme: ["calendrier", "innovation", "mécréance"],
  emotion: "Lucidité, respect",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "As-Sunnah"],
  mirrorVersion: `« Le report d'un mois sacré est un surcroît de mécréance. » Le miroir me montre la manipulation du calendrier. « Innama al-nasi' ziadatun fi al-kufr » — le report est un surcroît de mécréance. Manipuler les mois sacrés est un égarement. Le miroir m'interroge : est-ce que je respecte les lois d'Allah ou est-ce que je les manipule ?`,
  reflection: `La manipulation des lois divines est un égarement. Les mois sacrés doivent être respectés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama al-nasi' ziadatun fi al-kufr » — le report d'un mois sacré est un surcroît de mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les lois d'Allah ? Ou est-ce que je les manipule pour mon profit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La manipulation des lois révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le calendrier divin est parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les lois divines est sur la voie droite." }
  ],
  munajat: `Ya Haqq, Tes lois sont parfaites. Fais que je les respecte. Ne permets pas que je les manipule pour mon profit.`
};

MIROIR["9:38"] = {
  reference: "9:38",
  theme: ["jihad", "vie", "priorité"],
  emotion: "Interpellation, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jihad", "Al-Akhirah"],
  mirrorVersion: `« Ô vous qui croyez ! Qu'avez-vous à ne pas sortir quand on vous dit : Lancez-vous dans le chemin d'Allah ? » Le miroir me montre l'hésitation face au jihad. « Ma lakum » — qu'avez-vous ? La vie présente est-elle plus importante que l'au-delà ? Le miroir m'interroge : qu'est-ce qui m'empêche de répondre à l'appel d'Allah ?`,
  reflection: `La vie présente ne doit pas empêcher de répondre à l'appel d'Allah. L'au-delà est plus important.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu ma lakum idha qila lakumu infiru fi sabil Allahi iththaqaltum ila al-ard » — ô vous qui croyez ! Qu'avez-vous à ne pas sortir quand on vous dit : Lancez-vous dans le chemin d'Allah ? Vous vous êtes alourdis vers la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de répondre à l'appel d'Allah ? La vie présente est-elle plus importante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attachement à la terre alourdit. Le détachement allège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'au-delà est la destination finale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'appel d'Allah trouve sa vraie vie." }
  ],
  munajat: `Ya Rabb, je veux répondre à Ton appel. Détache-moi de cette vie. Fais que l'au-delà soit ma priorité.`
};

MIROIR["9:39"] = {
  reference: "9:39",
  theme: ["châtiment", "substitution", "sérieux"],
  emotion: "Crainte, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Mubdil"],
  mirrorVersion: `« Si vous ne sortez pas, Il vous châtiera d'un châtiment douloureux et vous remplacera par un autre peuple. » Le miroir me montre la conséquence de l'inaction. « Yu'adhdhibkum 'adhaban aliman » — Il vous châtiera d'un châtiment douloureux. Le remplacement est possible. Le miroir m'interroge : est-ce que je prends au sérieux l'appel d'Allah ?`,
  reflection: `L'inaction a des conséquences. Allah peut remplacer ceux qui n'agissent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa tanfiru yu'adhdhibkum 'adhaban aliman wa yastabdil qawman ghayrakum » — si vous ne sortez pas, Il vous châtiera d'un châtiment douloureux et vous remplacera par un autre peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux l'appel d'Allah ? Ou est-ce que je suis complaisant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le remplacement est possible à tout moment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah n'a pas besoin de nous. Nous avons besoin de Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est remplacé perd tout." }
  ],
  munajat: `Ya Qadir, Tu peux me remplacer. Fais que je prenne Ton appel au sérieux. Ne permets pas que je sois remplacé.`
};

MIROIR["9:41"] = {
  reference: "9:41",
  theme: ["jihad", "effort", "obligation"],
  emotion: "Mobilisation, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Jihad", "Al-Jaysh"],
  mirrorVersion: `« Lancez-vous légers et lourds, et luttez avec vos biens et vos personnes dans le chemin d'Allah. » Le miroir me montre l'obligation générale. « Infiru khifafan wa thiqalan » — lancez-vous légers et lourds. Tout le monde doit participer, selon ses moyens. Le miroir m'interroge : avec quoi je participe au chemin d'Allah ?`,
  reflection: `Le jihad est une obligation pour tous. Chacun selon ses moyens participe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Infiru khifafan wa thiqalan wa jahidu bi-amwalikum wa anfusikum fi sabil Allah » — lancez-vous légers et lourds, et luttez avec vos biens et vos personnes dans le chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec quoi je participe au chemin d'Allah ? Mes biens ? Ma personne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort pour Allah demande tout : biens et personnes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jihad est le sommet de l'effort pour Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne tout pour Allah reçoit tout d'Allah." }
  ],
  munajat: `Ya Rabb, je veux participer à Ton chemin. Accepte mon effort, mes biens et ma personne. Fais que je ne retienne rien.`
};

MIROIR["9:42"] = {
  reference: "9:42",
  theme: ["monde", "facilité", "choix"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Dunya", "Al-Haqq"],
  mirrorVersion: `« S'il s'agissait d'un profit immédiat ou d'un voyage facile, ils t'auraient suivi. » Le miroir me montre la motivation intéressée. « Law kana 'aradan qariban » — s'il s'agissait d'un profit immédiat. Les gens suivent quand c'est facile et profitable. Le miroir m'interroge : est-ce que je suis Allah pour le profit ou par conviction ?`,
  reflection: `Les gens suivent quand c'est facile. La foi authentique résiste à la difficulté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kana 'aradan qariban wa safaran qasidan la-ttaba'uka » — s'il s'agissait d'un profit immédiat ou d'un voyage facile, ils t'auraient suivi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis Allah pour le profit ou par conviction ? Ma foi résiste-t-elle à la difficulté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi authentique préfère la vérité au confort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah n'est pas toujours facile, mais il est vrai." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit par conviction reste quand c'est difficile." }
  ],
  munajat: `Ya Haqq, je veux Te suivre par conviction, pas par intérêt. Renforce ma foi pour qu'elle résiste à la difficulté.`
};

MIROIR["9:43"] = {
  reference: "9:43",
  theme: ["permission", "sincérité", "excuse"],
  emotion: "Sagesse, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Qu'Allah te pardonne ! Pourquoi as-tu donné la permission avant d'avoir discerné les véridiques ? » Le miroir me montre l'erreur de la facilité. « Lima adhinta lahum » — pourquoi as-tu donné la permission ? Le Prophète a été trop conciliant. Le discernement est nécessaire. Le miroir m'interroge : est-ce que je discerne avant d'accorder ?`,
  reflection: `La conciliation sans discernement peut être une erreur. Les véridiques doivent être distingués.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Afā Allahu 'anka lima adhinta lahum hatta yatabayyana laka alladhina sadaquū » — qu'Allah te pardonne ! Pourquoi as-tu donné la permission avant d'avoir discerné les véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je discerne avant d'accorder ? Ou est-ce que je suis trop conciliant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conciliation sans discernement favorise les hypocrites." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le discernement est une qualité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui discerne voit les véridiques des faux." }
  ],
  munajat: `Ya Hakim, Tu discernes les cœurs. Donne-moi la sagesse du discernement. Ne permets pas que je sois trompé par ma conciliation.`
};

MIROIR["9:44"] = {
  reference: "9:44",
  theme: ["sincérité", "jihad", "foi"],
  emotion: "Détermination, authenticité",
  difficulty: "débutant",
  relatedNames: ["Al-Sadiq", "Al-Jihad"],
  mirrorVersion: `« Ceux qui croient en Allah et au Jour dernier ne te demandent pas la permission de lutter avec leurs biens et leurs personnes. » Le miroir me montre la foi sans excuse. « La yasta'dhinuka » — ne te demandent pas la permission. Les vrais croyants n'ont pas besoin de permission pour le jihad. Le miroir m'interroge : est-ce que je suis un croyant sans excuse ?`,
  reflection: `Le vrai croyant n'a pas besoin d'excuse pour le jihad. Sa foi le pousse à l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yasta'dhinuka alladhina yu'minuna bi-Allahi wa al-yawmi al-akhiri an yujahidu bi-amwalihim wa anfusihim » — ceux qui croient en Allah et au Jour dernier ne te demandent pas la permission de lutter avec leurs biens et leurs personnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un croyant sans excuse ? Ou est-ce que je cherche des prétextes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les excuses révèlent souvent le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi authentique pousse à l'action sans hésitation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a pas d'excuse a la foi complète." }
  ],
  munajat: `Ya Sadiq, je veux être un croyant sans excuse. Fais que ma foi me pousse à l'action. Ne permets pas que je cherche des prétextes.`
};

MIROIR["9:45"] = {
  reference: "9:45",
  theme: ["doute", "permission", "hypocrisie"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Munafiq"],
  mirrorVersion: `« Seuls te demandent permission ceux qui ne croient pas en Allah et au Jour dernier. » Le miroir me montre les demandeurs d'excuses. « Innama yasta'dhinuka alladhina la yu'minuna » — seuls te demandent permission ceux qui ne croient pas. Les demandes d'excuses révèlent le doute. Le miroir m'interroge : est-ce que je demande des permissions ou est-ce que j'agis ?`,
  reflection: `Les demandes de permission révèlent le manque de foi. Le croyant agit, l'hypocrite demande.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yasta'dhinuka alladhina la yu'minuna bi-Allahi wa al-yawmi al-akhiri » — seuls te demandent permission ceux qui ne croient pas en Allah et au Jour dernier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des permissions ou est-ce que j'agis ? Que révèlent mes demandes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de permission peut être un signe d'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi se voit dans l'action, pas dans les demandes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit sans demander montre sa foi." }
  ],
  munajat: `Ya Khabir, Tu connais les cœurs. Fais que je sois du côté de ceux qui agissent. Ne permets pas que je sois du côté de ceux qui demandent des permissions.`
};

MIROIR["9:46"] = {
  reference: "9:46",
  theme: ["préparation", "hypocrisie", "vérité"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Sari'"],
  mirrorVersion: `« S'ils avaient voulu sortir, ils auraient fait des préparatifs. » Le miroir me montre l'absence de préparation. « La-ahaddu lahu 'iddatan » — ils auraient fait des préparatifs. L'absence de préparation révèle l'absence d'intention. Le miroir m'interroge : est-ce que je me prépare pour le chemin d'Allah ?`,
  reflection: `L'absence de préparation révèle l'absence d'intention. Les actes précèdent les paroles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law aradu al-khurūja la-a'addu lahu 'uddatan » — s'ils avaient voulu sortir, ils auraient fait des préparatifs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour le chemin d'Allah ? Ou est-ce que je parle sans agir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation révèle l'intention. L'absence révèle l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'action demande de la préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare montre sa sincérité." }
  ],
  munajat: `Ya Rabb, je veux me préparer pour Ton chemin. Fais que mes préparatifs soient réels. Ne permets pas que je sois hypocrite dans mes intentions.`
};

MIROIR["9:47"] = {
  reference: "9:47",
  theme: ["corruption", "hypocrisie", "division"],
  emotion: "Lucidité, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Fitna"],
  mirrorVersion: `« S'ils étaient sortis avec vous, ils n'auraient fait qu'accroître votre trouble. » Le miroir me montre le danger des hypocrites. « Ma zadukum illa khabalan » — ils n'auraient fait qu'accroître votre trouble. Les hypocrites corrompent de l'intérieur. Le miroir m'interroge : est-ce que je suis un facteur de division ou d'unité ?`,
  reflection: `Les hypocrites corrompent la communauté. Leur absence est une bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kharaju fikum ma zadukum illa khabalan » — s'ils étaient sortis avec vous, ils n'auraient fait qu'accroître votre trouble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un facteur de division ou d'unité ? Quel est mon impact sur la communauté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La présence des hypocrites est un mal. Leur absence est un bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité est force. La division est faiblesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unit la communauté fait l'œuvre d'Allah." }
  ],
  munajat: `Ya Hafiz, Tu protèges la communauté des hypocrites. Fais que je sois un facteur d'unité. Ne permets pas que je sois source de division.`
};

// ============================================
// SURAH 18 (AL-KAHF) - EXPANSION
// ============================================

MIROIR["18:2"] = {
  reference: "18:2",
  theme: ["coran", "avertissement", "annonciation"],
  emotion: "Gravité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Nadhir", "Al-Bashir"],
  mirrorVersion: `« Pour avertir d'un terrible châtiment de Sa part et annoncer aux croyants une belle récompense. » Le miroir me montre la dualité du Coran. Il avertit et annonce. Le châtiment pour les uns, la récompense pour les autres. Le même message a deux effets selon la réception. Le miroir m'interroge : comment est-ce que je reçois le Coran ?`,
  reflection: `Le Coran est avertissement et annonce. Le même message transforme selon le cœur qui l'accueille.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yundhira ba'san shadidan min ladunhu wa yubashshira al-mu'minina » — Pour avertir d'un terrible châtiment de Sa part et annoncer aux croyants une belle récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je reçois le Coran ? Comme avertissement ou comme annonce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est avertissement pour l'un est annonce pour l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le même soleil fait fondre la cire et durcit l'argile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran avec foi reçoit l'annonce." }
  ],
  munajat: `Ya Nadhir, Ya Bashir, Ton Coran avertit et annonce. Fais que je le reçoive comme une annonce de bien. Ne laisse pas mon cœur durcir face à Ton avertissement.`
};

MIROIR["18:3"] = {
  reference: "18:3",
  theme: ["récompense", "éternité", "foi"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Khuld", "Al-Maqam"],
  mirrorVersion: `« Où ils demeureront éternellement. » Le miroir me montre la promesse de l'éternité. La récompense n'est pas temporaire — elle est éternelle. Ceux qui croient obtiennent un séjour permanent. Le miroir m'interroge : est-ce que j'aspire à cette éternité ?`,
  reflection: `L'éternité est la plus grande promesse. Rien dans ce monde ne dure — mais la récompense divine est permanente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Makithina fihi » — Où ils demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à l'éternité ? Mon cœur la désire-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité contraste avec la fugacité de ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout passe dans ce monde. Seul l'au-delà demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit pour l'éternel ne regrette pas le temporaire." }
  ],
  munajat: `Ya Khuld, Tu promets l'éternité. Fais que je l'espère et que je la cherche. Ne laisse pas les plaisirs passagers me la faire oublier.`
};

MIROIR["18:4"] = {
  reference: "18:4",
  theme: ["fils", "avertissement", "incrédulité"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Et pour avertir ceux qui disent : "Allah S'est attribué un fils." » Le miroir me montre l'erreur de l'attribution. Dire qu'Allah a un fils est une grave erreur. Cela va contre Sa nature transcendante. Le miroir m'interroge : est-ce que je préserve la transcendance d'Allah dans ma compréhension ?`,
  reflection: `Allah n'a pas de fils. Il est au-dessus de toute comparaison humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yundhira alladhina qalu ittakhadha Allahu waladan » — Et pour avertir ceux qui disent : 'Allah S'est attribué un fils.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la transcendance d'Allah ? Est-ce que je L'attribue correctement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Attribuer un fils à Allah est réduire l'Infini au fini." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Créateur n'a pas besoin de progéniture. Il est l'Éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la transcendance ne Lui attribue rien d'humain." }
  ],
  munajat: `Ya Wahid, Tu es transcendant. Purifie ma compréhension de Toi. Ne laisse pas mes pensées Te limiter. Tu es le Créateur sans égal.`
};

MIROIR["18:5"] = {
  reference: "18:5",
  theme: ["connaissance", "ignorance", "pères"],
  emotion: "Clarté, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Haqq"],
  mirrorVersion: `« Ils n'en ont aucune connaissance, ni leurs pères. » Le miroir me montre l'ignorance transmise. L'erreur du fils d'Allah n'est pas nouvelle — elle vient des pères. L'ignorance se transmet de génération en génération. Le miroir m'interroge : est-ce que je questionne les héritages de mes pères ?`,
  reflection: `L'ignorance peut être héréditaire. Questionner l'héritage est le début de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lahum bihi min 'ilmin wa la li abaihim » — Ils n'en ont aucune connaissance, ni leurs pères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai hérité de mes pères sans le questionner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage d'erreur pèse plus que l'héritage de vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération peut briser la chaîne de l'erreur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne l'héritage trouve la vérité." }
  ],
  munajat: `Ya 'Alim, Tu connais la vérité. Aide-moi à questionner mes héritages. Ne laisse pas l'ignorance des pères devenir la mienne.`
};

MIROIR["18:6"] = {
  reference: "18:6",
  theme: ["chagrin", "rejet", "prophète"],
  emotion: "Tristesse, compassion",
  difficulty: "débutant",
  relatedNames: ["Ar-Ra'uf", "Al-Rahim"],
  mirrorVersion: `« Tu vas peut-être te consumer de chagrin pour eux, s'ils ne croient pas en ce récit. » Le miroir me montre l'amour du Prophète pour son peuple. Il se consume de chagrin pour ceux qui rejettent le Coran. Son amour est si grand qu'il souffre de leur refus. Le miroir m'interroge : est-ce que j'ai ce souci pour les autres ?`,
  reflection: `L'amour pour les autres peut causer un grand chagrin quand ils rejettent la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fala'allaka bakhi'un nafsaka 'ala atharihim in lam yu'minu bi hadha al-hadith » — Tu vas peut-être te consumer de chagrin pour eux, s'ils ne croient pas en ce récit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je souffre pour ceux qui rejettent la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chagrin pour les autres révèle l'amour pour eux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le véritable guide souffre pour ceux qu'il guide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime vraiment partage le chagrin du Prophète." }
  ],
  munajat: `Ya Ra'uf, le Prophète souffrait pour son peuple. Donne-moi un cœur qui se soucie des autres. Fais que je ne sois pas indifférent à leur sort.`
};

MIROIR["18:7"] = {
  reference: "18:7",
  theme: ["épreuve", "beauté", "action"],
  emotion: "Vigilance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Mubtala", "Al-Jamil"],
  mirrorVersion: `« Nous avons fait de ce qui est sur terre une parure pour elle, afin d'éprouver qui d'entre eux est le meilleur en action. » Le miroir me montre le but de la beauté terrestre. Ce n'est pas pour le plaisir — c'est pour l'épreuve. La beauté du monde teste qui agit le mieux. Le miroir m'interroge : comment est-ce que j'utilise la beauté de ce monde ?`,
  reflection: `La beauté du monde est un test. L'utiliser pour le bien ou le mal révèle le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ja'alna ma 'ala al-ardi zinatan laha li nabluwahum ayyuhum ahsanu 'amala » — Nous avons fait de ce qui est sur terre une parure pour elle, afin d'éprouver qui d'entre eux est le meilleur en action." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que j'utilise la beauté de ce monde ? Pour le bien ou pour le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté qui égare devient une preuve contre son amateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est beau. L'homme est testé par sa beauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise la beauté pour le bien passe le test." }
  ],
  munajat: `Ya Mubtala, Tu testes par la beauté. Fais que je l'utilise pour le bien. Ne laisse pas la beauté de ce monde m'égarer.`
};

MIROIR["18:8"] = {
  reference: "18:8",
  theme: ["finitude", "passage", "éternité"],
  emotion: "Humilité, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Fani"],
  mirrorVersion: `« Et Nous ferons de ce qui est sur terre un sol aride. » Le miroir me montre le destin de la terre. Toute cette beauté deviendra poussière. La parure disparaîtra. Seul Allah demeure. Le miroir m'interroge : est-ce que je m'attache à ce qui passera ou à Celui qui reste ?`,
  reflection: `La terre deviendra aride. Tout passera. Seul Allah est éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna la ja'iluna ma 'alayha sa'idan juruzan » — Et Nous ferons de ce qui est sur terre un sol aride." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi m'attaché-je ? À ce qui passera ou à l'Éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attachement au passager mène au regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lui-même vieillira. Seul le Créateur ne vieillit pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache à l'Éternel ne perd rien." }
  ],
  munajat: `Ya Baqi, Tu es l'Éternel. Fais que je m'attache à Toi et non à ce qui passera. Ouvre mes yeux sur la fin de toute chose, sauf Toi.`
};

MIROIR["18:9"] = {
  reference: "18:9",
  theme: ["caverne", "jeunes", "miracle"],
  emotion: "Curiosité, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Hafiz"],
  mirrorVersion: `« Penses-tu que les gens de la Caverne et d'ar-Raqim ont constitué une merveille parmi Nos signes ? » Le miroir me montre l'histoire des jeunes de la Caverne. Ce n'est pas la seule merveille d'Allah — c'est une parmi tant d'autres. Les signes d'Allah sont innombrables. Le miroir m'interroge : est-ce que je contemple les signes d'Allah ?`,
  reflection: `L'histoire des Gens de la Caverne est un signe parmi d'autres. Les signes d'Allah sont partout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am hasibta anna ashaba al-kahfi wa al-raqimi kanu min ayatina 'ajaban » — Penses-tu que les gens de la Caverne et d'ar-Raqim ont constitué une merveille parmi Nos signes ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les signes d'Allah dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont partout. L'aveugle seul ne les voit pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Chaque créature témoigne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit un signe peut les voir tous." }
  ],
  munajat: `Ya Wali, Tes signes sont partout. Ouvre mes yeux pour les voir. Fais que chaque signe renforce ma foi en Toi.`
};

MIROIR["18:11"] = {
  reference: "18:11",
  theme: ["sommeil", "protection", "miracle"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Muhaymin"],
  mirrorVersion: `« Donc Nous avons assourdi leurs oreilles dans la Caverne pendant de nombreuses années. » Le miroir me montre la protection par le sommeil. Allah les a endormis pour les protéger. Le sommeil n'était pas une faiblesse — c'était une protection. Le miroir m'interroge : est-ce que je fais confiance à la protection d'Allah ?`,
  reflection: `La protection d'Allah peut prendre des formes inattendues. Le sommeil était une sauvegarde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa darabna 'ala adhanihim fi al-kahfi sinina 'adadan » — Donc Nous avons assourdi leurs oreilles dans la Caverne pendant de nombreuses années." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la protection d'Allah, même quand je ne la comprends pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble faiblesse peut être protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sommeil est une mort temporaire. Allah le contrôle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se remet à Allah est protégé même dans son sommeil." }
  ],
  munajat: `Ya Hafiz, Tu protèges de manière inattendue. Fais que je Te fasse confiance. Protège-moi même quand je ne comprends pas comment.`
};

MIROIR["18:12"] = {
  reference: "18:12",
  theme: ["réveil", "question", "temps"],
  emotion: "Émerveillement, interrogation",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Nasir"],
  mirrorVersion: `« Puis Nous les avons réveillés pour savoir quel des deux groupes saurait calculer la durée de leur séjour. » Le miroir me montre le réveil comme test. Le temps passé est devenu une question. Combien de temps ? La réponse révèle la connaissance. Le miroir m'interroge : est-ce que je calcule le temps passé dans ma propre vie ?`,
  reflection: `Le temps passé est une mesure. Le réveil après le sommeil est un retour à la conscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ba'athnahum li na'lama ayyu al-hizbayni ahsa lima labithu » — Puis Nous les avons réveillés pour savoir quel des deux groupes saurait calculer la durée de leur séjour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de temps ai-je passé dans ma vie ? Est-ce que je le calcule ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps perdu ne peut être rattrapé que par le regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est la monnaie de la vie. Comment est-elle dépensée ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte son temps ne le gaspille pas." }
  ],
  munajat: `Ya Ba'ith, Tu me réveilles chaque jour. Fais que je compte mon temps. Ne laisse pas les années passer sans que je les utilise pour Toi.`
};

MIROIR["18:13"] = {
  reference: "18:13",
  theme: ["jeunesse", "foi", "histoire"],
  emotion: "Inspiration, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mu'min"],
  mirrorVersion: `« Nous allons te raconter leur récit en toute vérité. Ce sont des jeunes qui croyaient en leur Seigneur. » Le miroir me montre la foi des jeunes. L'âge n'est pas un obstacle à la foi. Ces jeunes ont cru quand les anciens ont nié. Le miroir m'interroge : ma foi est-elle comme la leur ?`,
  reflection: `La foi n'a pas d'âge. Les jeunes peuvent être les plus sincères.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna nahnu naqussu 'alayka naba'ahum bi al-haqq, innahum fityatun amanu bi rabbihim » — Nous allons te raconter leur récit en toute vérité. Ce sont des jeunes qui croyaient en leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle sincère comme la leur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jeunesse peut être plus proche de la vérité que la vieillesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur jeune peut être plus pur que le cœur vieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi sincère n'a pas besoin de l'âge." }
  ],
  munajat: `Ya Hadi, les jeunes ont cru en Toi. Donne-moi leur sincérité. Ne laisse pas l'âge ou le statut m'éloigner de la pureté de la foi.`
};

MIROIR["18:14"] = {
  reference: "18:14",
  theme: ["cœur", "fermeté", "guidance"],
  emotion: "Force, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Matin", "Al-Thabit"],
  mirrorVersion: `« Et Nous avons affermi leurs cœurs. » Le miroir me montre l'origine de la fermeté. Ce n'est pas eux qui se sont affermis — c'est Allah qui a affermi leurs cœurs. La fermeté est un don divin. Le miroir m'interroge : est-ce que je demande à Allah d'affermir mon cœur ?`,
  reflection: `La fermeté du cœur vient d'Allah. La demander est la première étape pour l'obtenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rabatna 'ala qulubihim » — Et Nous avons affermi leurs cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande à Allah d'affermir mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur ferme sans Allah est fragile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fermeté est la fondation de la persévérance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la fermeté la reçoit." }
  ],
  munajat: `Ya Matin, affermis mon cœur. Donne-moi la fermeté des Gens de la Caverne. Ne laisse pas mon cœur chanceler face aux épreuves.`
};

MIROIR["18:15"] = {
  reference: "18:15",
  theme: ["association", "refus", "unicité"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Haqq"],
  mirrorVersion: `« Ces gens ont pris en dehors de Lui des divinités. » Le miroir me montre le rejet de l'association. Les jeunes ont refusé de suivre leur peuple dans l'idolâtrie. Ils ont vu l'absurdité d'adorer ce qui ne peut rien. Le miroir m'interroge : est-ce que je refuse les idoles de mon temps ?`,
  reflection: `Le refus de l'idolâtrie est le premier pas vers l'unicité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha'ula'i qawmuni itakhadhu min dunihi alihatan » — Ces gens ont pris en dehors de Lui des divinités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles idoles est-ce que je refuse ? Quelles idoles de mon temps ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole d'aujourd'hui n'est pas de pierre — elle est d'argent, de pouvoir, de plaisir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque époque a ses idoles. Chaque croyant doit les refuser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse les idoles trouve le Chemin." }
  ],
  munajat: `Ya Wahid, les jeunes ont refusé les idoles. Aide-moi à refuser les idoles de mon temps. Ne laisse pas l'argent, le pouvoir ou le plaisir prendre Ta place.`
};

MIROIR["18:16"] = {
  reference: "18:16",
  theme: ["retraite", "refuge", "miséricorde"],
  emotion: "Confiance, espérance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wali"],
  mirrorVersion: `« Et quand vous vous séparez d'eux et de ce qu'ils adorent en dehors d'Allah, réfugiez-vous dans la caverne. » Le miroir me montre la retraite comme stratégie. Parfois, il faut se retirer pour préserver sa foi. La caverne devient refuge et protection. Le miroir m'interroge : où est ma caverne spirituelle ?`,
  reflection: `La retraite peut être une protection. Se retirer du mal pour préserver le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa izi i'tazaltumuhum wa ma ya'buduna illa Allaha fa'wu ila al-kahfi » — Et quand vous vous séparez d'eux et de ce qu'ils adorent en dehors d'Allah, réfugiez-vous dans la caverne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est ma caverne ? Quel refuge protège ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La caverne n'est pas une fuite — c'est une stratégie de préservation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque prophète a eu sa retraite. Chaque croyant en a besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se retire pour Allah est près de Lui." }
  ],
  munajat: `Ya Rahman, donne-moi un refuge pour ma foi. Protège-moi du mal environnant. Fais que je trouve ma caverne spirituelle.`
};

MIROIR["18:17"] = {
  reference: "18:17",
  theme: ["soleil", "protection", "signe"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hafiz"],
  mirrorVersion: `« Tu aurais vu le soleil se décliner de leur caverne vers la droite. » Le miroir me montre la protection du soleil. Le soleil se décline pour ne pas les brûler. La lumière qui brûle les autres les épargne. Le miroir m'interroge : est-ce que je vois la protection d'Allah dans les détails ?`,
  reflection: `La protection d'Allah est dans les détails. Le soleil qui brûle peut épargner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tara al-shamsa ida tala'at tazawaru 'an kahfihim thata al-yamini » — Tu aurais vu le soleil se décliner de leur caverne vers la droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la protection d'Allah dans les détails de ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui brûle les autres peut épargner les protégés d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil obéit à Allah. Il ne brûle que ceux qu'Il permet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est protégé par Allah ne craint pas le soleil." }
  ],
  munajat: `Ya Nur, Tu contrôles le soleil. Protège-moi comme Tu as protégé les Gens de la Caverne. Fais que je voie Ta protection dans les détails.`
};

MIROIR["18:18"] = {
  reference: "18:18",
  theme: ["apparence", "réalité", "chien"],
  emotion: "Méditation, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Batin", "Al-Khaliq"],
  mirrorVersion: `« Tu les aurais cru éveillés alors qu'ils dormaient. » Le miroir me montre la différence entre l'apparence et la réalité. Ils avaient l'air éveillés mais dormaient. Leur chien étendu ajoutait à l'illusion. Le miroir m'interroge : est-ce que je juge par l'apparence ou par la réalité ?`,
  reflection: `L'apparence peut tromper. La réalité est connue d'Allah seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tahsabuhum ayqanan wa hum ruqud » — Tu les aurais cru éveillés alors qu'ils dormaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge par l'apparence ? Ou est-ce que je cherche la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éveil apparent peut être le sommeil réel. Le sommeil apparent peut être la protection réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout n'est pas comme il paraît. La vérité est souvent cachée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne juge pas par l'apparence voit plus clair." }
  ],
  munajat: `Ya Batin, Tu connais la réalité derrière l'apparence. Ne laisse pas mes yeux me tromper. Apprends-moi à chercher la vérité cachée.`
};

MIROIR["18:19"] = {
  reference: "18:19",
  theme: ["réveil", "question", "temps"],
  emotion: "Interrogation, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-'Alim"],
  mirrorVersion: `« Et ainsi Nous les avons réveillés pour qu'ils s'interrogent entre eux. » Le miroir me montre le dialogue du réveil. Le réveil est suivi de questions. Combien de temps ? La réponse surprend. Le miroir m'interroge : qu'est-ce que je dis quand je me réveille ?`,
  reflection: `Le réveil amène la conscience. La conscience amène les questions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika ba'athnahum li yatasa'alu baynahum » — Et ainsi Nous les avons réveillés pour qu'ils s'interrogent entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dis au réveil ? Est-ce que je questionne ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le réveil sans question est une opportunité manquée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque matin est un réveil. Chaque réveil est une chance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne son réveil vit avec intention." }
  ],
  munajat: `Ya Ba'ith, Tu me réveilles chaque jour. Fais que je questionne ma vie. Ne laisse pas le réveil être automatique — fais qu'il soit conscient.`
};

MIROIR["18:20"] = {
  reference: "18:20",
  theme: ["découverte", "danger", "pierre"],
  emotion: "Peur, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Muhaymin"],
  mirrorVersion: `« S'ils vous découvrent, ils vous lapideront ou vous feront retourner à leur religion. » Le miroir me montre le danger de la découverte. Être découvert dans sa foi peut être mortel. La lapidation ou la conversion forcée sont les menaces. Le miroir m'interroge : est-ce que je suis prêt à affronter le danger pour ma foi ?`,
  reflection: `La foi peut être dangereuse. Mais le danger peut être évité par la prudence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hum in yazharu 'alaykum yarjumukum aw yu'idukum fi millatihim » — S'ils vous découvrent, ils vous lapideront ou vous feront retourner à leur religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à affronter le danger pour ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le danger révèle la valeur de ce qu'on protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi a toujours été menacée. Les croyants ont toujours dû être prudents." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa foi par prudence la préserve pour l'éternité." }
  ],
  munajat: `Ya Hafiz, protège ma foi des menaces. Donne-moi la prudence des Gens de la Caverne. Ne laisse pas les dangers m'éloigner de Toi.`
};

MIROIR["18:21"] = {
  reference: "18:21",
  theme: ["découverte", "signe", "controverse"],
  emotion: "Méditation, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "Al-Hujjah"],
  mirrorVersion: `« Et c'est ainsi que Nous les avons fait découvrir, pour qu'ils sachent que la promesse d'Allah est vérité. » Le miroir me montre le but de la découverte. Les Gens de la Caverne ont été découverts pour être un signe. Leur histoire confirme la promesse d'Allah. Le miroir m'interroge : est-ce que ma vie est un signe pour les autres ?`,
  reflection: `La découverte peut avoir un but. Parfois, être révélé est un témoignage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika a'thar'na 'alayhim li ya'lamu anna wa'da Allahi haqq » — Et c'est ainsi que Nous les avons fait découvrir, pour qu'ils sachent que la promesse d'Allah est vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie est un signe pour les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La cachette devenue découverte est devenue témoignage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque histoire est un signe potentiel pour les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont la vie est un signe ne vit pas pour lui-même." }
  ],
  munajat: `Ya Bayyinah, fais de ma vie un signe. Utilise mon histoire pour confirmer Ta promesse. Ne laisse pas ma vie passer sans témoigner de Toi.`
};

MIROIR["18:22"] = {
  reference: "18:22",
  theme: ["nombre", "controverse", "secret"],
  emotion: "Sagesse, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Ils diront : trois, leur chien étant le quatrième. » Le miroir me montre les disputes sur les détails. Combien étaient-ils ? Trois, quatre, cinq, sept ? Les gens disputent sur le nombre. Mais le nombre importe peu. Le miroir m'interroge : est-ce que je me perds dans les détails ?`,
  reflection: `Les disputes sur les détails peuvent faire oublier l'essentiel. Le nombre importe moins que la leçon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sayquluna thalathatun rabi'uhum kalbuhum » — Ils diront : trois, leur chien étant le quatrième." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me perds dans les détails ? Ou est-ce que je retiens l'essentiel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le débat sur le nombre cache souvent le refus du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'essentiel est souvent simple. L'accessoire complique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'essentiel ne se perd pas dans l'accessoire." }
  ],
  munajat: `Ya 'Alim, Tu connais le nombre. Moi, je veux comprendre le message. Ne laisse pas les disputes sur les détails me faire oublier l'essentiel.`
};

MIROIR["9:48"] = {
  reference: "9:48",
  theme: ["tentation", "hypocrisie", "épreuve"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fittan", "Al-Khabir"],
  mirrorVersion: `« Ils ont cherché auparavant à vous tenter et ont retourné contre vous vos affaires. » Le miroir me montre les tentatives de déstabilisation. « Qad btaghaw al-fitna » — ils ont cherché la tentation. Les hypocrites cherchent à déstabiliser la communauté. Le miroir m'interroge : est-ce que je suis vigilant face aux tentatives de déstabilisation ?`,
  reflection: `Les hypocrites cherchent constamment à déstabiliser. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad ibtaghaw al-fitna min qablu » — ils ont cherché auparavant à vous tenter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vigilant face aux tentatives de déstabilisation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance prévient la déstabilisation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve fait partie de la vie communautaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vigilant n'est pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, préserve-moi des tentations des hypocrites. Donne-moi la vigilance nécessaire pour ne pas être déstabilisé.`
};

MIROIR["9:49"] = {
  reference: "9:49",
  theme: ["permission", "hypocrisie", "épreuve"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Balā"],
  mirrorVersion: `« Parmi eux, il en est qui dit : Donne-moi la permission et ne me tente pas. » Le miroir me montre la fausse piété. « La taftinnī » — ne me tente pas. Certains prétendent que le jihad est une tentation pour eux. En réalité, ils sont déjà tombés dans la tentation. Le miroir m'interroge : est-ce que je fuis mes responsabilités sous prétexte de piété ?`,
  reflection: `Fuir ses responsabilités sous prétexte de piété est de l'hypocrisie. La vraie piété assume.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa minhum man yaqulu 'dhan li wa la taftinnī » — parmi eux, il en est qui dit : Donne-moi la permission et ne me tente pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis mes responsabilités sous prétexte de piété ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fausse piété cache souvent la lâcheté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La responsabilité est la marque du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité est vraiment pieux." }
  ],
  munajat: `Ya Khabir, Tu connais les cœurs. Fais que je n'utilise pas la piété comme excuse. Donne-moi le courage d'assumer mes responsabilités.`
};

MIROIR["9:50"] = {
  reference: "9:50",
  theme: ["joie", "tristesse", "hypocrisie"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "An-Nasir"],
  mirrorVersion: `« Si un bonheur t'atteint, cela les afflige. Si un malheur t'atteint, ils disent : Nous avons pris nos précautions. » Le miroir me montre l'hypocrisie en action. « In tusibka hasanatu tasuhum » — si un bonheur t'atteint, cela les afflige. Les hypocrites se réjouissent du mal et s'affligent du bien des croyants. Le miroir m'interroge : comment je réagis au bien et au mal des autres ?`,
  reflection: `L'hypocrite se réjouit du mal des croyants. Le croyant sincère se réjouit de leur bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tusibka hasanatu tasuhum wa in tusibka musibatun yaqulu qad akhadhna amrana min qablu » — si un bonheur t'atteint, cela les afflige. Si un malheur t'atteint, ils disent : Nous avons pris nos précautions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis au bien et au mal des autres ? Est-ce que je me réjouis sincèrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité se voit dans les réactions au bien et au mal des autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fraternité authentique se réjouit du bien des autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réjouit du bien des autres a le cœur pur." }
  ],
  munajat: `Ya Rabb, purifie mon cœur. Fais que je me réjouisse du bien des autres. Ne permets pas que l'envie ou la jalousie m'habitent.`
};

MIROIR["9:52"] = {
  reference: "9:52",
  theme: ["attente", "mécréance", "destin"],
  emotion: "Confiance, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadar", "Al-Husnā"],
  mirrorVersion: `« Dis : Qu'attendez-vous pour nous, sinon l'une des deux excellentes choses ? » Le miroir me montre l'attitude du croyant face à l'avenir. « Ihda al-husnayayn » — l'une des deux excellentes choses. Soit la victoire, soit le martyre. Les deux sont excellentes pour le croyant. Le miroir m'interroge : comment je vois l'avenir ?`,
  reflection: `Le croyant voit l'avenir avec optimisme. La victoire et le martyre sont deux bonheurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul hal tarabbasuna bina illa ihda al-husnayayn » — dis : Qu'attendez-vous pour nous, sinon l'une des deux excellentes choses ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois l'avenir ? Avec optimisme ou avec crainte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'optimisme du croyant n'est pas naïveté — c'est confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le destin du croyant est toujours bon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah voit tout comme bien." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ton destin. Fais que je voie l'avenir avec optimisme. Donne-moi l'une des deux excellentes choses.`
};

MIROIR["9:53"] = {
  reference: "9:53",
  theme: ["dépense", "hypocrisie", "répugnance"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaniyy", "Al-Qabul"],
  mirrorVersion: `« Dis : Dépensez de bon gré ou de mauvais gré, cela ne sera jamais accepté de vous. » Le miroir me montre l'inacceptabilité de la dépense hypocrite. « Lan yutaqabbala minkum » — cela ne sera jamais accepté de vous. La dépense sans sincérité est rejetée. Le miroir m'interroge : est-ce que je dépense avec sincérité ?`,
  reflection: `La dépense sans sincérité est rejetée par Allah. L'intention compte autant que l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul anfiqu taw'an aw karhan lan yutaqabbala minkum » — dis : Dépensez de bon gré ou de mauvais gré, cela ne sera jamais accepté de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense avec sincérité ? Ou est-ce que je le fais à contre-cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dépense forcée n'a pas de valeur spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah accepte ce qui est donné avec un cœur sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sincèrement reçoit plus qu'il ne donne." }
  ],
  munajat: `Ya Rabb, je veux donner avec sincérité. Purifie mon intention. Fais que mes dons soient acceptés par Toi.`
};

MIROIR["9:54"] = {
  reference: "9:54",
  theme: ["dépense", "hypocrisie", "rejet"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qabul", "Al-Ghaniyy"],
  mirrorVersion: `« Ce qui empêche leurs dépenses d'être acceptées, c'est qu'ils n'ont pas cru en Allah et en Son messager. » Le miroir me montre la cause du rejet. « Ma mana'ahum an tuqabbala minhum nafaqatuhum » — ce qui empêche leurs dépenses d'être acceptées. La foi est la condition de l'acceptation. Le miroir m'interroge : est-ce que ma foi est la base de mes actions ?`,
  reflection: `La foi est la condition de l'acceptation des œuvres. Sans foi, les actions sont vides.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma mana'ahum an tuqabbala minhum nafaqatuhum illa annahum kafaru bi-Allahi » — ce qui empêche leurs dépenses d'être acceptées, c'est qu'ils n'ont pas cru en Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est la base de mes actions ? Ou est-ce que j'agis sans fondement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'action sans foi est comme un corps sans âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est le fondement de toute œuvre acceptable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi voit ses actions acceptées." }
  ],
  munajat: `Ya Rabb, fais que ma foi soit la base de toutes mes actions. Ne permets pas que j'agisse sans fondement. Accepte mes œuvres par Ta grâce.`
};

MIROIR["9:55"] = {
  reference: "9:55",
  theme: ["richesse", "enfants", "épreuve"],
  emotion: "Lucidité, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fitna", "Al-Mawt"],
  mirrorVersion: `« Que ni leurs biens ni leurs enfants ne t'émerveillent. Allah veut par là les châtier dans la vie présente. » Le miroir me montre la signification des apparences. « La tu'jibka amwaluhum » — que leurs biens ne t'émerveillent pas. Les biens apparents peuvent être une punition déguisée. Le miroir m'interroge : est-ce que je me laisse impressionner par les apparences ?`,
  reflection: `Les biens apparents peuvent être une punition. La réussite visible n'est pas toujours une bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la tu'jibka amwaluhum wa la awladuhum » — que ni leurs biens ni leurs enfants ne t'émerveillent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse impressionner par les apparences ? La richesse est-elle signe de bénédiction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse apparente peut cacher la punition spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les apparences trompent souvent sur la réalité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit au-delà des apparences connaît la vérité." }
  ],
  munajat: `Ya Rabb, fais que je ne sois pas impressionné par les apparences. Donne-moi de voir la vérité derrière les richesses visibles.`
};

MIROIR["9:56"] = {
  reference: "9:56",
  theme: ["serment", "hypocrisie", "mensonge"],
  emotion: "Vigilance, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Kadhdhab"],
  mirrorVersion: `« Et ils jurent par Allah qu'ils sont des vôtres, alors qu'ils ne le sont pas. » Le miroir me montre le faux serment. « Yahlifuna bi-Allahi innahum minkum » — ils jurent par Allah qu'ils sont des vôtres. Le serment ne fait pas la vérité. Le miroir m'interroge : est-ce que je jure pour cacher la vérité ?`,
  reflection: `Le serment ne change pas la vérité. L'hypocrite jure pour dissimuler son hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yahlifuna bi-Allahi innahum minkum wa ma hum minkum » — et ils jurent par Allah qu'ils sont des vôtres, alors qu'ils ne le sont pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jure pour cacher la vérité ? Ou est-ce que je suis véridique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment sur le mensonge est un double mensonge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité se passe de serment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité n'a pas besoin de jurer." }
  ],
  munajat: `Ya Khabir, Tu connais la vérité. Fais que je sois véridique. Ne permets pas que je jure pour cacher le mensonge.`
};

MIROIR["9:57"] = {
  reference: "9:57",
  theme: ["refuge", "hypocrisie", "fuite"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Muhajir"],
  mirrorVersion: `« S'ils trouvaient un refuge ou des grottes ou un trou, ils s'y précipiteraient. » Le miroir me montre la fuite des hypocrites. « Law yajiduna malja'an » — s'ils trouvaient un refuge. Les hypocrites cherchent à fuir la communauté. Le miroir m'interroge : est-ce que je fuis mes responsabilités communautaires ?`,
  reflection: `L'hypocrite cherche à fuir. Le croyant reste et assume ses responsabilités.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law yajiduna malja'an aw magharatin aw muddakhalan la-wallaw ilayhi wahum yajmahīn » — s'ils trouvaient un refuge ou des grottes ou un trou, ils s'y précipiteraient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis mes responsabilités communautaires ? Ou est-ce que je reste et assume ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite révèle le manque d'engagement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté est un refuge, pas une prison." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume ses responsabilités trouve la paix." }
  ],
  munajat: `Ya Rabb, je veux assumer mes responsabilités. Ne permets pas que je fuie la communauté. Donne-moi le courage de rester.`
};

MIROIR["9:58"] = {
  reference: "9:58",
  theme: ["aumône", "hypocrisie", "critique"],
  emotion: "Vigilance, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sadaqah", "Al-'Adl"],
  mirrorVersion: `« Il en est parmi eux qui te critiquent au sujet de la distribution des aumônes. » Le miroir me montre la critique des hypocrites. « Yalmizuka fi al-sadaqat » — qui te critiquent au sujet de la distribution. L'aumône est critiquée selon qu'ils en profitent ou non. Le miroir m'interroge : est-ce que je critique quand je ne reçois pas ?`,
  reflection: `La critique de l'aumône révèle l'intéressé. Le croyant accepte ce qu'il reçoit avec gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa minhum man yalmizuka fi al-sadaqat » — il en est parmi eux qui te critiquent au sujet de la distribution des aumônes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je critique quand je ne reçois pas ? Ou est-ce que j'accepte avec gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La critique de l'aumône révèle l'égoïsme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aumône est un don, pas un dû." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte avec gratitude reçoit plus." }
  ],
  munajat: `Ya Rabb, fais que j'accepte l'aumône avec gratitude. Ne permets pas que je critique quand je ne reçois pas. Donne-moi un cœur reconnaissant.`
};

MIROIR["9:59"] = {
  reference: "9:59",
  theme: ["contentement", "gratitude", "foi"],
  emotion: "Paix, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Ar-Radi", "Al-Ghaniyy"],
  mirrorVersion: `« S'ils étaient satisfaits de ce qu'Allah et Son messager leur ont donné et disaient : Allah nous suffit. » Le miroir me montre l'attitude du croyant. « Law annahum radiyu » — s'ils étaient satisfaits. Le contentement est la marque du croyant. Le miroir m'interroge : est-ce que je suis satisfait de ce qu'Allah m'a donné ?`,
  reflection: `Le contentement est la marque du croyant. La satisfaction avec ce qu'on a apporte la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law annahum radiyu ma atahumu Allahu wa rasuluhu wa qalu hasbuna Allahu » — s'ils étaient satisfaits de ce qu'Allah et Son messager leur ont donné et disaient : Allah nous suffit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis satisfait de ce qu'Allah m'a donné ? Ou est-ce que je réclame toujours plus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le contentement n'est pas résignation — c'est confiance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Celui qui est satisfait a tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le contentement est une richesse qui ne s'épuise pas." }
  ],
  munajat: `Ya Radi, fais que je sois satisfait de ce que Tu m'as donné. Mon contentement est ma richesse. Allah me suffit.`
};

MIROIR["9:61"] = {
  reference: "9:61",
  theme: ["prophète", "hypocrisie", "respect"],
  emotion: "Révérence, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Rasul", "Al-Mu'azzaz"],
  mirrorVersion: `« Parmi eux, il en est qui offensent le Prophète et disent : Il écoute tout. » Le miroir me montre l'offense au Prophète. « Yu'dhuna al-nabiyya » — qui offensent le Prophète. L'offense au Prophète est grave. Le miroir m'interroge : est-ce que je respecte le Prophète comme il le mérite ?`,
  reflection: `Le respect du Prophète est obligatoire. L'offense à son égard est un grave péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa minhumu alladhina yu'dhuna al-nabiyya » — parmi eux, il en est qui offensent le Prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte le Prophète comme il le mérite ? Ma parole et mon action sont-elles respectueuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'offense au Prophète est offense à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Prophète est honoré dans les cieux et sur la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le Prophète est respecté par Allah." }
  ],
  munajat: `Ya Rabb, fais que je respecte Ton Prophète comme il le mérite. Ne permets pas que je l'offense en parole ou en acte. Honore-le par ma conduite.`
};

MIROIR["9:62"] = {
  reference: "9:62",
  theme: ["serment", "hypocrisie", "satisfaction"],
  emotion: "Vigilance, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Ar-Radi"],
  mirrorVersion: `« Ils vous jurent par Allah pour vous satisfaire. » Le miroir me montre le serment de complaisance. « Yahlifuna bi-Allahi lakum » — ils vous jurent par Allah. Le serment pour satisfaire les gens peut être hypocrite. Le miroir m'interroge : est-ce que je jure pour satisfaire Allah ou les gens ?`,
  reflection: `Le serment pour satisfaire les gens est hypocrite. La satisfaction d'Allah doit primer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahlifuna bi-Allahi lakum li-yurdūkum » — ils vous jurent par Allah pour vous satisfaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jure pour satisfaire Allah ou les gens ? Qui je cherche à satisfaire en priorité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction des gens sans celle d'Allah est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La satisfaction d'Allah est la seule qui compte vraiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui satisfait Allah satisfait tout le monde." }
  ],
  munajat: `Ya Radi, je veux Te satisfaire. Fais que mes serments soient pour Toi, pas pour les gens. Donne-moi la priorité de Ta satisfaction.`
};

MIROIR["9:63"] = {
  reference: "9:63",
  theme: ["enfer", "châtiment", "éternité"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Khuld"],
  mirrorVersion: `« Ne savent-ils pas qu'Allah châtie celui qui s'oppose à Allah et à Son messager ? » Le miroir me montre le châtiment de l'opposition. « A-wa lam ya'lamu anna man yuhadid Allaha wa rasulahu » — ne savent-ils pas que celui qui s'oppose à Allah et à Son messager ? L'opposition a un prix. Le miroir m'interroge : est-ce que je réalise les conséquences de l'opposition à Allah ?`,
  reflection: `L'opposition à Allah et à Son messager mène au châtiment éternel. La conscience de cela prévient l'opposition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam ya'lamu anna man yuhadid Allaha wa rasulahu fa-anna lahu nara jahannama khalidan fiha » — ne savent-ils pas qu'Allah châtie celui qui s'oppose à Allah et à Son messager ? L'Enfer est sa destination éternelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise les conséquences de l'opposition à Allah ? Est-ce que j'évite l'opposition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience du châtiment prévient l'opposition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer attend les opposants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'opposition préserve son éternité." }
  ],
  munajat: `Ya Rabb, je veux éviter l'opposition. Préserve-moi du châtiment de l'Enfer. Fais que je sois du côté d'Allah et de Son messager.`
};

MIROIR["9:64"] = {
  reference: "9:64",
  theme: ["coran", "peur", "hypocrisie"],
  emotion: "Crainte, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qur'an", "Al-Khashiyah"],
  mirrorVersion: `« Les hypocrites craignent qu'une sourate ne soit révélée qui dévoile ce qu'il y a dans leurs cœurs. » Le miroir me montre la peur des hypocrites. « Yahdharu al-munafiquna » — les hypocrites craignent. Ils ont peur que le Coran révèle leurs secrets. Le miroir m'interroge : est-ce que j'ai des secrets que je veux cacher du Coran ?`,
  reflection: `Le Coran révèle ce qui est dans les cœurs. Les hypocrites craignent cette révélation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahdharu al-munafiquna an tunazzala 'alayhim suratun tunabbi'uhum » — les hypocrites craignent qu'une sourate ne soit révélée qui leur annonce ce qu'il y a dans leurs cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai des secrets que je veux cacher du Coran ? Ou est-ce que mon cœur est transparent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transparence du cœur n'a pas peur de la révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est un miroir pour les cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a le cœur pur ne craint pas la révélation." }
  ],
  munajat: `Ya Rabb, purifie mon cœur. Fais que je n'aie rien à cacher du Coran. Donne-moi un cœur transparent devant Ta parole.`
};

MIROIR["9:65"] = {
  reference: "9:65",
  theme: ["moquerie", "hypocrisie", "excuse"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mustahzi"],
  mirrorVersion: `« Si tu les interroges, ils disent : Nous ne faisions que bavarder et jouer. » Le miroir me montre l'excuse des moqueurs. « Innama kunna nakhdud » — nous ne faisions que bavarder. La moquerie envers la religion est minimisée. Le miroir m'interroge : est-ce que je me moque de la religion sous prétexte de plaisanterie ?`,
  reflection: `La moquerie envers la religion n'est pas une plaisanterie. C'est un grave péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in sa'altahum layaqulunna innama kunna nakhduduwa nal'ab » — si tu les interroges, ils disent : Nous ne faisions que bavarder et jouer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque de la religion sous prétexte de plaisanterie ? Ma plaisanterie respecte-t-elle les limites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plaisanterie sur la religion n'est pas une plaisanterie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion mérite le plus grand respect." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la religion en parole est respecté par Allah." }
  ],
  munajat: `Ya Rabb, je veux respecter Ta religion. Ne permets pas que je me moque même en plaisantant. Donne-moi le sérieux dans ma foi.`
};

MIROIR["9:66"] = {
  reference: "9:66",
  theme: ["excuse", "hypocrisie", "mécréance"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Kafir"],
  mirrorVersion: `« Ne vous excusez pas, vous avez mécru après avoir eu la foi. » Le miroir me montre l'inutilité de l'excuse. « La ta'tadhiru » — ne vous excusez pas. La moquerie de la religion est une mécréance après la foi. Le miroir m'interroge : est-ce que je comprends que la moquerie de la religion peut annuler la foi ?`,
  reflection: `La moquerie de la religion peut annuler la foi. L'excuse n'y change rien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ta'tadhiru qad kafartum ba'da imanikum » — ne vous excusez pas, vous avez mécru après avoir eu la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la moquerie de la religion peut annuler la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi peut être perdue par des paroles légères." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi demande du sérieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa foi protège son éternité." }
  ],
  munajat: `Ya Rabb, protège ma foi. Ne permets pas que des paroles légères l'annulent. Donne-moi le sérieux qui préserve la foi.`
};

MIROIR["9:67"] = {
  reference: "9:67",
  theme: ["hypocrisie", "ordonnance", "interdiction"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Munafiq", "Al-Amr"],
  mirrorVersion: `« Les hypocrites, hommes et femmes, sont pareils. Ils ordonnent le blâmable et interdisent le convenable. » Le miroir me montre l'inversion des hypocrites. « Ya'muruna bi-al-munkari wa yanhawna 'ani al-ma'ruf » — ils ordonnent le blâmable et interdisent le convenable. L'hypocrite inverse les valeurs. Le miroir m'interroge : est-ce que j'ordonne le bien et interdis le mal ?`,
  reflection: `L'hypocrite inverse les valeurs. Le croyant ordonne le bien et interdit le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-munafiquna wa al-munafiqatu ba'duhum min ba'din ya'muruna bi-al-munkari wa yanhawna 'ani al-ma'ruf » — les hypocrites, hommes et femmes, sont pareils. Ils ordonnent le blâmable et interdisent le convenable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ordonne le bien et interdis le mal ? Ou est-ce que j'inverse les valeurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inversion des valeurs est un signe d'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien et le mal sont clairs pour le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ordonne le bien et interdit le mal préserve la communauté." }
  ],
  munajat: `Ya Rabb, je veux ordonner le bien et interdire le mal. Fais que je n'inverse pas les valeurs. Donne-moi la clarté du discernement.`
};

MIROIR["9:68"] = {
  reference: "9:68",
  theme: ["châtiment", "enfer", "éternité"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Khuld"],
  mirrorVersion: `« Allah a promis aux hypocrites, hommes et femmes, et aux mécréants le feu de l'Enfer pour l'éternité. » Le miroir me montre le destin des hypocrites. « Wa'ada Allahu al-munafiqina wa al-munafiqati wa al-kuffara » — Allah a promis aux hypocrites et aux mécréants. L'Enfer éternel les attend. Le miroir m'interroge : est-ce que je crains ce destin ?`,
  reflection: `L'Enfer éternel attend les hypocrites et les mécréants. La crainte de ce destin prévient l'hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'ada Allahu al-munafiqina wa al-munafiqati wa al-kuffara nara jahannama khalidina fiha » — Allah a promis aux hypocrites, hommes et femmes, et aux mécréants le feu de l'Enfer pour l'éternité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce destin ? Est-ce que j'évite l'hypocrisie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment prévient l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est la destination des hypocrites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'hypocrisie préserve son éternité." }
  ],
  munajat: `Ya Rabb, je crains le feu de l'Enfer. Préserve-moi de l'hypocrisie. Fais que je sois sincère dans ma foi.`
};

MIROIR["9:69"] = {
  reference: "9:69",
  theme: ["histoire", "châtiment", "mémoire"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qasas", "Al-Muta'allim"],
  mirrorVersion: `« Comme ceux qui vous ont précédés et qui étaient plus forts que vous. » Le miroir me montre l'histoire répétitive. « Ka-alladhina min qablikum » — comme ceux qui vous ont précédés. Les peuples passés étaient plus forts mais ont été punis. L'histoire enseigne. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire est un enseignement. Les peuples passés ont été punis pour leur hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-alladhina min qablikum kanu ashadda minkum quwwatan » — comme ceux qui vous ont précédés et qui étaient plus forts que vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les mêmes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force ne protège pas du châtiment divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de leçons pour ceux qui réfléchissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, fais que j'apprenne de l'histoire. Ne permets pas que je répète les erreurs des peuples passés. Donne-moi la sagesse de l'histoire.`
};

MIROIR["9:70"] = {
  reference: "9:70",
  theme: ["histoire", "prophètes", "châtiment"],
  emotion: "Lucidité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Muballigh"],
  mirrorVersion: `« Est-ce que ne leur est pas parvenue l'histoire de ceux qui les ont précédés ? » Le miroir me montre l'ignorance volontaire. « A-lam ya'tihim naba'u alladhina min qablihim » — est-ce que ne leur est pas parvenue l'histoire ? L'histoire est connue mais ignorée. Le miroir m'interroge : est-ce que j'ignore volontairement les enseignements de l'histoire ?`,
  reflection: `L'histoire des prophètes et des peuples est connue. L'ignorer est une responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-lam ya'tihim naba'u alladhina min qablihim qawmi Nuhin wa 'Adin wa Thamud » — est-ce que ne leur est pas parvenue l'histoire de ceux qui les ont précédés : le peuple de Noé, des 'Ad et des Thamud ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ignore volontairement les enseignements de l'histoire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance volontaire est une faute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont été envoyés à tous les peuples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît l'histoire est responsable." }
  ],
  munajat: `Ya Rabb, fais que je connaisse l'histoire des prophètes et des peuples. Donne-moi la responsabilité d'apprendre. Ne permets pas que j'ignore volontairement.`
};

// ============================================
// SURAH 19 (MARYAM) - EXPANSION
// ============================================

MIROIR["19:2"] = {
  reference: "19:2",
  theme: ["révélation", "miséricorde", "zakariya"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wahhab"],
  mirrorVersion: `« Voici le récit de la miséricorde de ton Seigneur envers Son serviteur Zacharie. » Le miroir me montre la miséricorde personnalisée. Ce n'est pas une miséricorde abstraite — c'est la miséricorde envers Zacharie. La miséricorde d'Allah est personnelle, pas générale. Le miroir m'interroge : est-ce que je sens la miséricorde d'Allah dans ma vie personnelle ?`,
  reflection: `La miséricorde d'Allah est personnelle. Elle touche chaque serviteur individuellement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhikru rahmati rabbika 'abdahu zakariyya » — Voici le récit de la miséricorde de ton Seigneur envers Son serviteur Zacharie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sens la miséricorde d'Allah dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde personnelle est plus réelle que la miséricorde abstraite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être est touché par la miséricorde d'une manière unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la miséricorde personnelle l'apprécie davantage." }
  ],
  munajat: `Ya Rahman, Ta miséricorde m'atteint personnellement. Ouvre mes yeux pour la voir. Fais que je ne la prenne pas pour acquise.`
};

MIROIR["19:3"] = {
  reference: "19:3",
  theme: ["prière", "secret", "invocation"],
  emotion: "Intimité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-Mujib"],
  mirrorVersion: `« Quand il invoqua son Seigneur d'une invocation secrète. » Le miroir me montre la prière secrète. Zacharie a invoqué Allah en secret. La prière secrète est plus intime, plus sincère. Pas de spectateur, juste Allah. Le miroir m'interroge : est-ce que je prie en secret ?`,
  reflection: `La prière secrète est la plus sincère. Sans public, le cœur s'ouvre vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh nada rabbahu nida'an khafiyyan » — Quand il invoqua son Seigneur d'une invocation secrète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie en secret ? Mon cœur s'ouvre-t-il vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière secrète révèle le vrai visage de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans tout l'univers, les êtres se tournent vers leur Créateur en secret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie en secret rencontre Allah sans voile." }
  ],
  munajat: `Ya Sami', Tu entends ma prière secrète. Fais que je Te cherche dans l'intimité. Ne laisse pas le public remplacer le secret.`
};

MIROIR["19:5"] = {
  reference: "19:5",
  theme: ["stérilité", "héritage", "peur"],
  emotion: "Vulnérabilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Wali"],
  mirrorVersion: `« Je crains ce que feront mes héritiers après moi. » Le miroir me montre la peur de l'héritage. Zacharie craint pour ce qui adviendra après lui. Qui maintiendra la foi ? La peur pour les générations futures. Le miroir m'interroge : qu'est-ce que je laisse derrière moi ?`,
  reflection: `L'héritage spirituel préoccupe les justes. Qui continuera la foi ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inni khiftu al-mawaliya min wara'i » — Je crains ce que feront mes héritiers après moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je laisse derrière moi ? Mon héritage est-il spirituel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur pour l'héritage révèle l'amour pour la communauté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération doit transmettre à la suivante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse un héritage spirituel ne meurt pas vraiment." }
  ],
  munajat: `Ya Warith, Tu es l'Héritier de tout. Fais que je laisse un héritage spirituel. Ne laisse pas mes héritiers perdre le chemin.`
};

MIROIR["19:6"] = {
  reference: "19:6",
  theme: ["postérité", "héritier", "prières"],
  emotion: "Espoir, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Mujib"],
  mirrorVersion: `« Qui hérite de moi et hérite de la famille de Jacob. » Le miroir me montre la demande spécifique. Zacharie demande un héritier qui continue la tradition. Pas n'importe quel héritier — un héritier spirituel. Le miroir m'interroge : qu'est-ce que je demande à Allah ?`,
  reflection: `La prière spécifique reflète les désirs profonds du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yarithuni wa yarithu min ali ya'qub » — Qui hérite de moi et hérite de la famille de Jacob." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande à Allah ? Mes prières sont-elles spécifiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière vague reflète un cœur vague." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque prophète a demandé une descendance spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande avec spécificité reçoit avec précision." }
  ],
  munajat: `Ya Wahhab, exauce ma prière spécifique. Donne-moi un héritier spirituel. Fais que ce que je demande reflète ce que Tu veux.`
};

MIROIR["19:7"] = {
  reference: "19:7",
  theme: ["yahya", "nom", "bonne nouvelle"],
  emotion: "Joie, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mubashshir", "Al-Wahhab"],
  mirrorVersion: `« Ô Zacharie, Nous t'annonçons la bonne nouvelle d'un fils dont le nom sera Yahya. » Le miroir me montre l'annonce du nom. Le nom est donné avant la naissance. Yahya — il vivra. Le nom porte la promesse. Le miroir m'interroge : est-ce que je reçois les noms comme des promesses ?`,
  reflection: `Le nom est une identité. Allah nomme avant même la naissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya zakariyya inna nubashshiruka bi ghulamin ismuhu yahya » — Ô Zacharie, Nous t'annonçons la bonne nouvelle d'un fils dont le nom sera Yahya." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel nom porte-je ? Quelle identité Allah m'a-t-Il donnée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le nom donné par Allah est une destinée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être a un nom auprès d'Allah, différent du nom des hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son nom divin connaît sa destinée." }
  ],
  munajat: `Ya Mubashshir, Tu as nommé Yahya avant sa naissance. Donne-moi de connaître mon nom auprès de Toi. Fais que je vive selon l'identité que Tu m'as donnée.`
};

MIROIR["19:8"] = {
  reference: "19:8",
  theme: ["étonnement", "âge", "pouvoir"],
  emotion: "Stupéfaction, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muqtadir"],
  mirrorVersion: `« Seigneur ! Comment aurais-je un fils alors que ma femme est stérile et que j'ai atteint la vieillesse ? » Le miroir me montre l'étonnement devant le miracle. La stérilité et la vieillesse semblent être des obstacles. Mais pour Allah, rien n'est impossible. Le miroir m'interroge : est-ce que je limite le pouvoir d'Allah ?`,
  reflection: `Les impossibles humains sont les possibles divins. Allah brise les limitations.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbay anna yakunu li ghulamun wa kanati imra'ati 'aqiran wa qad balaghtu mina al-kibari 'itiyya » — Seigneur ! Comment aurais-je un fils alors que ma femme est stérile et que j'ai atteint la vieillesse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère impossible ? Est-ce que je limite le pouvoir d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossible est le terrain de jeu du Tout-Puissant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque miracle brise une loi apparente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à l'impossible le voit se réaliser." }
  ],
  munajat: `Ya Qadir, rien n'est impossible pour Toi. Ouvre mon cœur aux miracles. Ne laisse pas ma logique limiter Ta puissance.`
};

MIROIR["19:9"] = {
  reference: "19:9",
  theme: ["pouvoir", "création", "exemple"],
  emotion: "Certitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Ainsi a-t-il été de ton Seigneur. » Le miroir me montre la réponse divine. Pas d'explication — juste la constatation. C'est ainsi. Allah fait ce qu'Il veut. L'exemple d'Adam est rappelé. Le miroir m'interroge : est-ce que j'accepte la souveraineté d'Allah ?`,
  reflection: `La souveraineté d'Allah n'a pas besoin d'explication. C'est ainsi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika qala rabbuka » — Ainsi a-t-il été de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que 'ainsi soit' sans demander pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la souveraineté est le sommet de la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne selon 'ainsi soit-il'." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte 'ainsi' trouve la paix." }
  ],
  munajat: `Ya Khaliq, "ainsi" est Ton décret. Fais que je l'accepte avec soumission. Ne laisse pas mon "pourquoi" m'éloigner de Ton "ainsi".`
};

MIROIR["19:10"] = {
  reference: "19:10",
  theme: ["signe", "prière", "communication"],
  emotion: "Espérance, question",
  difficulty: "débutant",
  relatedNames: ["Al-Ayah", "Al-Mu'ti"],
  mirrorVersion: `« Seigneur, donne-moi un signe. » Le miroir me montre la demande de signe. Zacharie croit mais veut un signe. Pas par doute — par renforcement. Le signe renforce la foi. Le miroir m'interroge : est-ce que je demande des signes ?`,
  reflection: `Le signe demandé avec foi renforce la foi. Demandé avec doute, il la remplace.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi ij'al li ayatan » — Seigneur, donne-moi un signe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des signes ? Pourquoi — par foi ou par doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe pour la foi est une bénédiction. Le signe pour le doute est une malédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes pour ceux qui cherchent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande un signe avec foi le reçoit." }
  ],
  munajat: `Ya Ayah, donne-moi un signe qui renforce ma foi. Ne laisse pas ma demande être un test mais une supplication. Fais que le signe rapproche de Toi.`
};

MIROIR["19:11"] = {
  reference: "19:11",
  theme: ["mihrab", "communication", "signe"],
  emotion: "Silence, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-Khatab"],
  mirrorVersion: `« Ton signe est que tu ne pourras parler aux gens pendant trois jours. » Le miroir me montre le signe du silence. Le signe n'est pas spectaculaire — c'est un silence. Trois jours sans parler. Le silence devient preuve. Le miroir m'interroge : est-ce que j'accepte les signes silencieux ?`,
  reflection: `Le signe peut être un silence. Parfois, ne pas parler est la preuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayatuka alla tukallima al-nasa thalathata ayyamin » — Ton signe est que tu ne pourras parler aux gens pendant trois jours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les signes silencieux d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le silence peut être plus éloquent que les mots." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature parle par le silence autant que par le bruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le silence comprend les signes d'Allah." }
  ],
  munajat: `Ya Sami', Tu parles par le silence. Fais que je comprenne les signes silencieux. Ne laisse pas mon besoin de bruit m'empêcher d'entendre Ton silence.`
};

// ============================================
// SURAH 20 (TA-HA) - EXPANSION
// ============================================

MIROIR["20:2"] = {
  reference: "20:2",
  theme: ["coran", "difficulté", "rappel"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Tanzil", "Al-Mudhakkir"],
  mirrorVersion: `« Nous n'avons pas fait descendre le Coran sur toi pour que tu sois malheureux. » Le miroir me montre le but du Coran. Ce n'est pas pour rendre malheureux — c'est pour le rappel. Le Coran est une miséricorde, pas un fardeau. Le miroir m'interroge : est-ce que je vis le Coran comme une miséricorde ?`,
  reflection: `Le Coran est une miséricorde. S'il semble un fardeau, c'est qu'il est mal compris.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma anzalna 'alayka al-qur'ana li tashqa » — Nous n'avons pas fait descendre le Coran sur toi pour que tu sois malheureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis le Coran comme une miséricorde ou comme un fardeau ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran qui semble un fardeau n'a pas été bien reçu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation divine est toujours miséricorde pour les cœurs ouverts." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran avec joie ne le trouve jamais lourd." }
  ],
  munajat: `Ya Tanzil, Ton Coran est miséricorde. Fais que je le reçoive avec joie. Ne laisse pas ma compréhension le transformer en fardeau.`
};

MIROIR["20:3"] = {
  reference: "20:3",
  theme: ["rappel", "crainte", "coran"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhakkir", "Al-Khashi'"],
  mirrorVersion: `« Mais comme un rappel pour celui qui craint. » Le miroir me montre la condition de la réception. Le Coran est un rappel pour celui qui craint Allah. La crainte ouvre le cœur au rappel. Le miroir m'interroge : est-ce que je crains Allah assez pour que le Coran me parle ?`,
  reflection: `La crainte d'Allah prépare le cœur à recevoir le rappel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa tadhkiratan liman yakhsha » — Mais comme un rappel pour celui qui craint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah ? Le Coran me parle-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sans crainte, le rappel n'entre pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte n'est pas la peur — c'est la révérence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint entend le rappel avec clarté." }
  ],
  munajat: `Ya Mudhakkir, fais que je Te craigne pour que Ton rappel m'atteigne. Ouvre mon cœur à Ton message par la crainte révérencielle.`
};

MIROIR["20:4"] = {
  reference: "20:4",
  theme: ["révélation", "créateur", "terre"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Tanzil", "Al-Khaliq"],
  mirrorVersion: `« Une révélation de Celui qui a créé la terre et les cieux élevés. » Le miroir me montre l'origine de la révélation. Elle vient du Créateur des cieux et de la terre. Pas d'une source humaine — divine. Le miroir m'interroge : est-ce que je reconnais l'origine divine du Coran ?`,
  reflection: `Le Coran vient du Créateur. Cette origine lui donne autorité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzilan mimman khalaqa al-arda wa al-samawati al-'ula » — Une révélation de Celui qui a créé la terre et les cieux élevés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'origine divine du Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation divine a l'autorité du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Celui qui a créé peut parler à Sa création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'auteur obéit au message." }
  ],
  munajat: `Ya Khaliq, Tu es l'auteur du Coran. Fais que je reconnaisse Ton autorité. Donne-moi la soumission à Ta parole.`
};

MIROIR["20:6"] = {
  reference: "20:6",
  theme: ["possession", "cieux", "terre"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Mulk"],
  mirrorVersion: `« À Lui appartient ce qui est dans les cieux, sur la terre, ce qui est entre eux et ce qui est sous le sol. » Le miroir me montre l'étendue de la possession divine. Tout Lui appartient — visible et invisible, haut et bas. Rien n'échappe à Sa souveraineté. Le miroir m'interroge : est-ce que je reconnais que tout appartient à Allah ?`,
  reflection: `Tout appartient à Allah. Nous ne possédons rien — nous sommes des dépositaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu ma fi al-samawati wa ma fi al-ardi wa ma baynahuma wa ma tahta al-thara » — À Lui appartient ce qui est dans les cieux, sur la terre, ce qui est entre eux et ce qui est sous le sol." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que tout appartient à Allah ? Même ce que je crois mien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je possède n'est qu'un dépôt. Le Propriétaire est Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est la propriété d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ne rien posséder possède tout." }
  ],
  munajat: `Ya Malik, tout T'appartient. Fais que je reconnaisse que je ne suis qu'un dépositaire. Ne laisse pas ma possession m'aveugler sur la Tienne.`
};

MIROIR["20:7"] = {
  reference: "20:7",
  theme: ["parole", "secret", "connaissance"],
  emotion: "Vigilance, sincérité",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-'Alim"],
  mirrorVersion: `« Et s'il élève la voix, Il connaît le secret et le plus caché. » Le miroir me montre l'omniscience divine. Parler fort ou bas — Allah entend. Le secret et le plus caché sont connus. Rien n'est caché à Allah. Le miroir m'interroge : est-ce que je vis en sachant que rien n'est caché à Allah ?`,
  reflection: `Allah connaît tout — le dit et le non-dit, le visible et le caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in tajhar bi al-qawli fa innahu ya'lamu al-sirra wa akhfa » — Et s'il élève la voix, Il connaît le secret et le plus caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Est-ce que je sais que Allah le connaît ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret n'est secret que pour les hommes, pas pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est transparent devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en transparence avec Allah n'a rien à cacher." }
  ],
  munajat: `Ya 'Alim, Tu connais mon secret. Fais que je vive en Ta présence. Ne laisse rien me cacher de Toi — ni moi-même.`
};

MIROIR["20:8"] = {
  reference: "20:8",
  theme: ["unicité", "noms", "adoration"],
  emotion: "Révérence, concentration",
  difficulty: "débutant",
  relatedNames: ["Allah", "Al-Asma"],
  mirrorVersion: `« Allah ! Point de divinité que Lui. Il possède les noms les plus beaux. » Le miroir me montre l'unicité et les noms. Allah est unique — et Ses noms sont parfaits. Chaque nom révèle une facette de Sa perfection. Le miroir m'interroge : est-ce que je connais et invoque les beaux noms d'Allah ?`,
  reflection: `Les noms d'Allah sont parfaits. Les connaître est un acte d'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu la ilaha illa huwa lahu al-asma'u al-husna » — Allah ! Point de divinité que Lui. Il possède les noms les plus beaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les beaux noms d'Allah ? Est-ce que je les invoque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas connaître les noms d'Allah, c'est ne pas Le connaître." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque nom divin est reflété dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les noms connaît le Nommé." }
  ],
  munajat: `Ya Allah, Tu as les plus beaux noms. Fais que je les connaisse et les invoque. Par Tes noms, fais-moi Te connaître.`
};

// ============================================
// SURAH 29 (AL-ANKABUT) - MISSING VERSES
// ============================================

MIROIR["29:29"] = {
  reference: "29:29",
  theme: ["lot", "péché", "avertissement"],
  emotion: "Gravité, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Nadhir", "Al-Hakam"],
  mirrorVersion: `« Vous vous approchez des mâles, vous coupez les chemins et vous commettez le blâmable dans vos assemblées. » Le miroir me montre les péchés du peuple de Lot. Ils se sont égarés dans leurs désirs, ont coupé les chemins, commis le blâmable. La décadence morale complète. Le miroir m'interroge : quels péchés mon peuple considère-t-il normaux ?`,
  reflection: `Les péchés deviennent normaux quand la société les accepte. L'avertissement de Lot reste actuel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innakum la ta'tuna al-rijala wa taqta'una al-sabila wa ta'tuna fi nadikumu al-munkar » — Vous vous approchez des mâles, vous coupez les chemins et vous commettez le blâmable dans vos assemblées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels péchés mon peuple normalise-t-il ? Est-ce que je m'y oppose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation sociale du péché ne change pas sa nature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des civilisations montre que la décadence morale précède la chute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'oppose au blâmable préserve son âme." }
  ],
  munajat: `Ya Hakam, Ton jugement est vérité. Fais que je ne normalise jamais le péché. Donne-moi le courage de m'opposer au blâmable.`
};

MIROIR["29:30"] = {
  reference: "29:30",
  theme: ["prière", "protection", "corruption"],
  emotion: "Supplication, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Muhaymin"],
  mirrorVersion: `« Seigneur ! Aide-moi contre ce peuple corrupteur. » Le miroir me montre la prière contre la corruption. Lot ne pouvait pas changer son peuple seul — il a demandé l'aide d'Allah. Face à la corruption généralisée, la prière est l'arme. Le miroir m'interroge : est-ce que je prie contre la corruption qui m'entoure ?`,
  reflection: `Face à la corruption, la prière est puissante. Allah peut changer ce que nous ne pouvons pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi inzurni 'ala al-qawmi al-mufsidin » — Seigneur ! Aide-moi contre ce peuple corrupteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie contre la corruption ? Ou est-ce que je m'y résigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résignation face au mal est une complicité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La corruption attire le châtiment. L'opposition attire la protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie contre la corruption est entendu." }
  ],
  munajat: `Ya Nasir, aide-moi contre la corruption qui m'entoure. Ne laisse pas mon cœur s'y résigner. Donne-moi la force de m'y opposer par la prière.`
};

MIROIR["29:37"] = {
  reference: "29:37",
  theme: ["miracle", "incrédulité", "châtiment"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'jizah", "Al-Qadir"],
  mirrorVersion: `« Ils le traitèrent de menteur, alors le séisme les saisit, et le lendemain matin, ils gisaient dans leurs demeures. » Le miroir me montre la conséquence de l'incrédulité. Le miracle est rejeté, le séisme vient. En une nuit, tout est fini. Le refus de croire a un prix. Le miroir m'interroge : combien de signes est-ce que je rejette ?`,
  reflection: `Le rejet des signes attire le châtiment. La terre elle-même peut devenir instrument de justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakadhdhabuhu fa akhadhat-humu al-rajfatu fa asbahu fi darihim jathimim » — Ils le traitèrent de menteur, alors le séisme les saisit, et le lendemain matin, ils gisaient dans leurs demeures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de signes est-ce que je rejette ? Quels avertissements ignore-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe rejeté devient la preuve contre le rejeteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre tremble pour ceux qui la troublent par leur incrédulité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes les voit se multiplier." }
  ],
  munajat: `Ya Qadir, ne laisse pas mon cœur rejeter Tes signes. Ouvre mes yeux aux avertissements. Garde-moi de l'incrédulité qui attire le châtiment.`
};

// ============================================
// SURAH 21 (AL-ANBIYA) - EXPANSION
// ============================================

MIROIR["21:2"] = {
  reference: "21:2",
  theme: ["révélation", "distraction", "cœur"],
  emotion: "Vigilance, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Tanzil", "Al-Mudhakkir"],
  mirrorVersion: `« Quand leur arrive un nouveau rappel de leur Seigneur, ils l'écoutent en se divertissant. » Le miroir me montre la distraction face à la révélation. Le Coran arrive, mais ils l'écoutent comme un divertissement. Pas comme une guidance — comme un spectacle. Le miroir m'interroge : comment est-ce que j'écoute le Coran ?`,
  reflection: `Écouter le Coran en se divertissant est le refuser. Le cœur doit être présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma ya'tihim min dhikrin min rabbihim muhdathin illa istama'uhu wa hum yal'abun » — Quand leur arrive un nouveau rappel de leur Seigneur, ils l'écoutent en se divertissant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que j'écoute le Coran ? Comme divertissement ou comme guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran-entertainment est une contradiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Parole de Dieu mérite plus que l'attention distraite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le Coran avec le cœur présent est transformé." }
  ],
  munajat: `Ya Mudhakkir, Ton rappel n'est pas un divertissement. Fais que je l'écoute avec le cœur présent. Ne laisse pas ma distraction me priver de Ta guidance.`
};

MIROIR["21:3"] = {
  reference: "21:3",
  theme: ["cœur", "distraction", "secret"],
  emotion: "Gravité, introspection",
  difficulty: "débutant",
  relatedNames: ["Al-Batin", "Al-'Alim"],
  mirrorVersion: `« Leurs cœurs sont distraits. » Le miroir me montre la distraction du cœur. Le problème n'est pas dans les oreilles — dans le cœur. Un cœur distrait ne peut pas recevoir la guidance. Le miroir m'interroge : mon cœur est-il présent ou distrait ?`,
  reflection: `La distraction du cœur est l'obstacle à la guidance. Le cœur doit être réveillé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulubuhum laghiyatun » — Leurs cœurs sont distraits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il présent ou distrait ? Où est-il quand j'écoute le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur distrait peut écouter mille rappels sans en recevoir aucun." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La présence du cœur est la clé de la réception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui éveille son cœur reçoit la guidance." }
  ],
  munajat: `Ya Batin, Tu connais mon cœur. Réveille-le de sa distraction. Fais qu'il soit présent quand Ton rappel arrive. Ne laisse pas mon cœur errer ailleurs.`
};

MIROIR["21:4"] = {
  reference: "21:4",
  theme: ["secours", "secret", "invocation"],
  emotion: "Confiance, abandon",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Mujib"],
  mirrorVersion: `« Mon Seigneur connaît ce qui est dit dans le ciel et sur la terre. » Le miroir me montre la réponse à la distraction. Face aux critiques, le Prophète rappelle qu'Allah connaît tout. Pas besoin de se défendre — Allah sait. Le miroir m'interroge : est-ce que je me repose sur la connaissance d'Allah ?`,
  reflection: `Allah connaît tout — le dit et le non-dit, le vrai et le faux. Pas besoin de justification.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbì ya'lamu al-qawla fi al-sama'i wa al-ard » — Mon Seigneur connaît ce qui est dit dans le ciel et sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repose sur la connaissance d'Allah ? Ou est-ce que je cherche à me justifier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui sait qu'Allah connaît n'a pas besoin de prouver." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout mot est enregistré. Allah est le Témoin parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur la connaissance d'Allah trouve la paix." }
  ],
  munajat: `Ya 'Alim, Tu connais tout. Fais que je me repose sur Ta connaissance. Ne laisse pas mon besoin de justification m'éloigner de Ta vérité.`
};

// ============================================
// SURAH 22 (AL-HAJJ) - EXPANSION
// ============================================

MIROIR["22:2"] = {
  reference: "22:2",
  theme: ["jour", "terre", "effroi"],
  emotion: "Crainte, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'ah", "Al-Zalzalah"],
  mirrorVersion: `« Le Jour où vous le verrez, toute nourrice oubliera ce qu'elle allaitait. » Le miroir me montre l'intensité du Jour du Jugement. L'effroi est tel que les mères oublient leurs bébés. La terre tremble de peur. Ce Jour dépasse toute imagination. Le miroir m'interroge : est-ce que je suis prêt pour ce Jour ?`,
  reflection: `Le Jour du Jugement sera terrifiant. Seule la préparation peut alléger l'effroi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tarawnaha tadhhabu kullu murdi'atin 'amma arda'at » — Le Jour où vous le verrez, toute nourrice oubliera ce qu'elle allaitait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ce Jour ? Qu'est-ce que j'oublirai de peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effroi du Jour révèle la gravité de ce qui est jugé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lui-même tremblera. Seul Allah restera stable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare ne sera pas terrifié." }
  ],
  munajat: `Ya Qari'ah, Ton Jour est terrifiant. Prépare-moi pour ce Jour. Ne laisse pas l'effroi m'atteindre sans préparation. Donne-moi la sécurité parmi les effrayés.`
};

MIROIR["22:3"] = {
  reference: "22:3",
  theme: ["dispute", "ignorance", "égarement"],
  emotion: "Clarté, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Mudill"],
  mirrorVersion: `« Parmi les gens, il y a celui qui dispute au sujet d'Allah sans science. » Le miroir me montre la dispute ignorante. Certains disputent d'Allah sans Le connaître. Leur ignorance les égare. La dispute sans science est dangereuse. Le miroir m'interroge : est-ce que je parle d'Allah avec science ou avec ignorance ?`,
  reflection: `Parler d'Allah sans Le connaître est égarant. La connaissance doit précéder la parole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-nasi man yujadilu fi Allahi bighayri 'ilmin » — Parmi les gens, il y a celui qui dispute au sujet d'Allah sans science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je parle d'Allah avec science ou avec ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute sans science est le chemin de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance d'Allah est le fondement de toute parole sur Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah ne dispute pas — il témoigne." }
  ],
  munajat: `Ya 'Alim, fais que je Te connaisse avant de parler de Toi. Ne laisse pas mon ignorance guider ma langue. Enseigne-moi pour que je parle avec science.`
};

MIROIR["22:4"] = {
  reference: "22:4",
  theme: ["destin", "satan", "égarement"],
  emotion: "Vigilance, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-Mudill", "Al-Shaytan"],
  mirrorVersion: `« Il a été décrété de quiconque le prend pour allié qu'il l'égarera et le conduira au châtiment de la Fournaise. » Le miroir me montre la conséquence de l'alliance avec Satan. Suivre Satan n'est pas sans prix — c'est l'égarement et le châtiment. Le décret est clair. Le miroir m'interroge : qui est mon allié ?`,
  reflection: `L'alliance avec Satan mène à l'égarement. Le choix d'allié détermine la destination.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kutiba 'alayhi annahu man tawallahu fa annahu yudilluhu wa yahdihi ila 'adhabi al-sa'ir » — Il a été décrété de quiconque le prend pour allié qu'il l'égarera et le conduira au châtiment de la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon allié ? Est-ce que je suis les suggestions de Satan ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allié que je choisis détermine mon destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Deux chemins s'offrent : celui de Dieu et celui de Satan. Chacun mène à une destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse l'alliance de Satan refuse l'égarement." }
  ],
  munajat: `Ya Hadi, garde-moi de l'alliance avec Satan. Fais que je choisisse Ton chemin. Ne laisse pas ses suggestions m'égarer vers le châtiment.`
};

MIROIR["22:5"] = {
  reference: "22:5",
  theme: ["création", "phases", "résurrection"],
  emotion: "Émerveillement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Ô hommes ! Si vous doutez de la résurrection, Nous vous avons créés de poussière, puis d'une goutte, puis d'une adhérence... » Le miroir me montre les phases de la création. De la poussière à l'être complet — étape par étape. Si Allah peut créer, Il peut ressusciter. La création est la preuve de la résurrection. Le miroir m'interroge : est-ce que je vois ma création comme preuve de ma résurrection ?`,
  reflection: `La création en phases montre la puissance créatrice. Celui qui crée peut recréer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nasu in kuntum fi raybin mina al-ba'thi fa'inna khalaqnakum min turabin thumma min nutfatin » — Ô hommes ! Si vous doutez de la résurrection, Nous vous avons créés de poussière, puis d'une goutte..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois ma création comme preuve de ma résurrection future ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui peut créer du néant peut ressusciter de la mort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ressuscite chaque printemps. La résurrection humaine suit le même modèle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur sa création ne doute pas de sa résurrection." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé en phases. Fais que je voie cette création comme preuve de ma résurrection. Ne laisse pas le doute s'installer dans mon cœur.`
};

MIROIR["9:72"] = {
  reference: "9:72",
  theme: ["paradis", "promesse", "alliance"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'ud"],
  mirrorVersion: `« Allah a promis aux croyants et aux croyantes des jardins sous lesquels coulent les rives. » Le miroir me montre la promesse du Paradis. « Wa'ada Allahu al-mu'minina wa al-mu'minati jannatin » — Allah a promis aux croyants des jardins. Le Paradis est la promesse d'Allah aux croyants. Le miroir m'interroge : est-ce que je vis pour cette promesse ?`,
  reflection: `Le Paradis est la promesse d'Allah aux croyants sincères. La vie présente est le chemin vers cette promesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'ada Allahu al-mu'minina wa al-mu'minati jannatin tajri min tahtiha al-anharu khalidina fiha » — Allah a promis aux croyants et aux croyantes des jardins sous lesquels coulent les rives, où ils demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis pour cette promesse ? Le Paradis est-il mon objectif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse du Paradis motive la vie présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination finale des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit pour le Paradis y accède." }
  ],
  munajat: `Ya Rabb, Tu as promis le Paradis. Fais que je vive pour cette promesse. Donne-moi d'y accéder par Ta miséricorde.`
};

MIROIR["9:73"] = {
  reference: "9:73",
  theme: ["combat", "hypocrisie", "fermeté"],
  emotion: "Détermination, fermeté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jihad", "Al-Ghazi"],
  mirrorVersion: `« Ô Prophète, lutte contre les mécréants et les hypocrites, et sois dur envers eux. » Le miroir me montre le combat double. « Jahidi al-kuffara wa al-munafiqin » — lutte contre les mécréants et les hypocrites. Deux fronts : l'ennemi visible et l'ennemi caché. Le miroir m'interroge : est-ce que je suis conscient des deux types d'ennemis ?`,
  reflection: `Le croyant lutte sur deux fronts : les mécréants visibles et les hypocrites cachés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nabiyyu jahidi al-kuffara wa al-munafiqina waghluz 'alayhim » — ô Prophète, lutte contre les mécréants et les hypocrites, et sois dur envers eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient des deux types d'ennemis ? Comment je lutte contre l'hypocrisie en moi et autour de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ennemi intérieur est souvent plus dangereux que l'ennemi extérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lutte est une constante dans la vie du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lutte sur les deux fronts protège sa foi." }
  ],
  munajat: `Ya Rabb, aide-moi à lutter contre les mécréants et les hypocrites. Donne-moi la fermeté nécessaire. Protège-moi de l'hypocrisie en moi-même.`
};

MIROIR["9:74"] = {
  reference: "9:74",
  theme: ["serment", "hypocrisie", "mécréance"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Munafiq"],
  mirrorVersion: `« Ils jurent par Allah qu'ils n'ont pas dit, alors qu'ils ont prononcé la parole de mécréance. » Le miroir me montre le mensonge sous serment. « Yahlifuna bi-Allahi ma qalu » — ils jurent par Allah qu'ils n'ont pas dit. Le mensonge sous serment aggrave la faute. Le miroir m'interroge : est-ce que je mens sous serment ?`,
  reflection: `Le mensonge sous serment aggrave la faute. L'hypocrite jure pour cacher sa mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahlifuna bi-Allahi ma qalu wa laqad qalu kalimata al-kufri » — ils jurent par Allah qu'ils n'ont pas dit, alors qu'ils ont prononcé la parole de mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mens sous serment ? Ou est-ce que je suis véridique même quand c'est difficile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sous serment est un double péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sous serment est un devoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité n'a pas besoin de jurer." }
  ],
  munajat: `Ya Rabb, fais que je sois véridique. Ne permets pas que je mente sous serment. Purifie ma parole de tout mensonge.`
};

MIROIR["9:75"] = {
  reference: "9:75",
  theme: ["promesse", "hypocrisie", "avarice"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nadhr", "Al-Bakhil"],
  mirrorVersion: `« Parmi eux, il en est qui ont fait un pacte avec Allah : S'Il nous donne de Sa grâce, nous ferons certainement aumône. » Le miroir me montre la promesse non tenue. « La-in atana Allahu min fadlihi » — s'Il nous donne de Sa grâce. La promesse faite à Allah n'est pas respectée. Le miroir m'interroge : est-ce que je tiens mes promesses à Allah ?`,
  reflection: `Les promesses à Allah doivent être tenues. L'avarice après la richesse est un manquement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa minhum man 'ahada Allaha la-in atana min fadlihi la-nassaddaqanna » — parmi eux, il en est qui ont fait un pacte avec Allah : S'Il nous donne de Sa grâce, nous ferons certainement aumône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens mes promesses à Allah ? Ou est-ce que je deviens avare quand je reçois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse non tenue révèle l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La générosité est une obligation pour le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient ses promesses à Allah est béni." }
  ],
  munajat: `Ya Rabb, je veux tenir mes promesses. Fais que je ne devienne pas avare après avoir reçu. Donne-moi la générosité que j'ai promise.`
};

MIROIR["9:76"] = {
  reference: "9:76",
  theme: ["avarice", "hypocrisie", "détournement"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Bukhl", "Al-Mu'tadi"],
  mirrorVersion: `« Mais quand Il leur a donné de Sa grâce, ils s'en sont avares et ont tourné le dos. » Le miroir me montre le revirement. « Bakhirū bihi » — ils s'en sont avares. La promesse est oubliée quand la richesse arrive. Le miroir m'interroge : est-ce que je change quand je reçois ?`,
  reflection: `La richesse révèle le vrai visage. L'avarice après la promesse est une trahison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma atahum min fadlihi bakhirū bihi wa tawallaw wa hum mu'ridun » — mais quand Il leur a donné de Sa grâce, ils s'en sont avares et ont tourné le dos en se détournant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je change quand je reçois ? Ma promesse résiste-t-elle à la richesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse est un test de fidélité aux promesses." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse révèle le caractère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient sa promesse après la richesse est sincère." }
  ],
  munajat: `Ya Rabb, fais que je tienne ma promesse même après la richesse. Ne permets pas que je sois avare. Garde-moi fidèle à mes engagements.`
};

MIROIR["9:77"] = {
  reference: "9:77",
  theme: ["hypocrisie", "punition", "mémoire"],
  emotion: "Crainte, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'akhkhir", "Al-Khabir"],
  mirrorVersion: `« Il a donc fait que l'hypocrisie soit dans leurs cœurs jusqu'au jour où ils Le rencontreront. » Le miroir me montre la conséquence durable. « Fa-a'qabahum nifaqan » — Il a donc fait que l'hypocrisie soit. Le manquement à la promesse laisse une trace durable. Le miroir m'interroge : est-ce que je réalise que mes manquements laissent des traces ?`,
  reflection: `Le manquement à la promesse laisse une trace dans le cœur. L'hypocrisie s'installe durablement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-a'qabahum nifaqan fi qulubihim ila yawmi yalqawnahu » — Il a donc fait que l'hypocrisie soit dans leurs cœurs jusqu'au jour où ils Le rencontreront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que mes manquements laissent des traces ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fidélité aux promesses purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les traces du cœur se voient au Jour de la Rencontre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est fidèle garde un cœur pur." }
  ],
  munajat: `Ya Rabb, purifie mon cœur de l'hypocrisie. Fais que je sois fidèle à mes promesses. Ne permets pas que mes manquements laissent des traces.`
};

MIROIR["9:78"] = {
  reference: "9:78",
  theme: ["secret", "connaissance", "châtiment"],
  emotion: "Crainte, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "As-Sirr"],
  mirrorVersion: `« Ne savent-ils pas qu'Allah connaît leurs secrets et leurs conversations confidentielles ? » Le miroir me montre la connaissance divine. « Ya'lamu sirrahum wa najwahum » — connaît leurs secrets et leurs conversations. Rien n'est caché à Allah. Le miroir m'interroge : est-ce que je vis en sachant qu'Allah connaît tout ?`,
  reflection: `Allah connaît les secrets et les conversations confidentielles. Rien n'est caché à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam ya'lamu anna Allaha ya'lamu sirrahum wa najwahum » — ne savent-ils pas qu'Allah connaît leurs secrets et leurs conversations confidentielles ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant qu'Allah connaît tout ? Mes secrets sont-ils purs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la connaissance divine purifie les secrets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance d'Allah embrasse tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a des secrets purs n'a pas peur de la connaissance divine." }
  ],
  munajat: `Ya Khabir, Tu connais mes secrets. Purifie-les. Fais que je n'aie rien à cacher de Toi. Donne-moi la conscience de Ta présence.`
};

MIROIR["9:79"] = {
  reference: "9:79",
  theme: ["moquerie", "aumône", "hypocrisie"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sadaqah", "Al-Mustahzi"],
  mirrorVersion: `« Ceux qui critiquent les croyants qui font de bon gré l'aumône et raillent ceux qui ne trouvent que leur effort. » Le miroir me montre la critique méprisante. « Alladhina yalmizuna al-mutta'awwi'ina » — ceux qui critiquent les volontaires. La critique de l'aumône des autres est hypocrite. Le miroir m'interroge : est-ce que je critique l'aumône des autres ?`,
  reflection: `La critique de l'aumône des autres est hypocrite. Allah accepte le peu comme le beaucoup.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yalmizuna al-mutta'awwi'ina min al-mu'minina fi al-sadaqat » — ceux qui critiquent les croyants qui font de bon gré l'aumône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je critique l'aumône des autres ? Ou est-ce que j'encourage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La critique de l'aumône révèle l'envie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aumône est acceptée selon l'intention, pas la quantité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui encourage l'aumône participe à la récompense." }
  ],
  munajat: `Ya Rabb, je veux encourager l'aumône, pas la critiquer. Fais que je voie le bien dans les efforts des autres. Ne permets pas que je sois hypocrite dans mes critiques.`
};

MIROIR["9:81"] = {
  reference: "9:81",
  theme: ["reproche", "hypocrisie", "joie"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khashiyah", "Al-Farh"],
  mirrorVersion: `« Ceux qui ont été laissés en arrière se sont réjouis de rester assis chez eux. » Le miroir me montre la joie injustifiée. « Fariha al-mukhallafuna » — se sont réjouis. La joie de ne pas participer au jihad est signe d'hypocrisie. Le miroir m'interroge : est-ce que je me réjouis de manquer des occasions de bien ?`,
  reflection: `La joie de manquer les occasions de bien est signe d'hypocrisie. Le croyant regrette de ne pas pouvoir participer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fariha al-mukhallafuna bi-maq'adihim khilafa rasuli Allahi » — ceux qui ont été laissés en arrière se sont réjouis de rester assis chez eux, en opposition au messager d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me réjouis de manquer des occasions de bien ? Ou est-ce que je regrette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie du manque révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le regret du manque est signe de foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regrette de ne pas pouvoir participer est sincère." }
  ],
  munajat: `Ya Rabb, je regrette de manquer les occasions de bien. Ne permets pas que je me réjouis de mon manque. Donne-moi la capacité de participer.`
};

MIROIR["9:82"] = {
  reference: "9:82",
  theme: ["rire", "pleurs", "châtiment"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Ad-Dam'", "Ad-Dahik"],
  mirrorVersion: `« Qu'ils rient un peu et qu'ils pleurent beaucoup. » Le miroir me montre l'inversion des émotions. « Falyadhaku qalilan » — qu'ils rient un peu. « Wa lyabkū kathiran » — et qu'ils pleurent beaucoup. Le rire de ce monde sera suivi des pleurs de l'au-delà. Le miroir m'interroge : est-ce que je ris trop et pleure trop peu ?`,
  reflection: `Le rire excessif de ce monde sera suivi des pleurs de l'au-delà. L'équilibre des émotions est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falyadhaku qalilan wa lyabkū kathiran » — qu'ils rient un peu et qu'ils pleurent beaucoup, en rétribution de ce qu'ils ont acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je ris trop et pleure trop peu ? Quel est mon équilibre émotionnel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les pleurs de la repentance valent mieux que le rire de l'insouciance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les émotions ont leur juste place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pleure de crainte d'Allah rit au Paradis." }
  ],
  munajat: `Ya Rabb, fais que je pleure de crainte de Toi. Ne permets pas que je ris dans l'insouciance. Donne-moi l'équilibre des émotions.`
};

MIROIR["9:83"] = {
  reference: "9:83",
  theme: ["permission", "hypocrisie", "exclusion"],
  emotion: "Fermeté, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mani'", "Al-Hukm"],
  mirrorVersion: `« Si Allah te ramène vers un groupe d'entre eux et qu'ils te demandent permission de sortir, dis : Vous ne sortirez jamais avec moi. » Le miroir me montre l'exclusion des hypocrites. « Lan takhruju ma'iya abadan » — vous ne sortirez jamais avec moi. L'exclusion est une punition. Le miroir m'interroge : est-ce que je comprends que l'hypocrisie a des conséquences ?`,
  reflection: `L'hypocrisie a des conséquences. L'exclusion des hypocrites protège la communauté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in raja'aka Allahu ila ta'ifatin minhum fa-ista'dhanuka li-al-khurūji fa-qul lan takhruju ma'iya abadan » — si Allah te ramène vers un groupe d'entre eux et qu'ils te demandent permission de sortir, dis : Vous ne sortirez jamais avec moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que l'hypocrisie a des conséquences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusion protège ceux qui sont sincères." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté doit être protégée des hypocrites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est exclu a le temps de se repentir." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'hypocrisie qui mène à l'exclusion. Fais que je sois sincère pour toujours être inclus dans Ta communauté.`
};

MIROIR["9:84"] = {
  reference: "9:84",
  theme: ["prière", "hypocrisie", "exclusion"],
  emotion: "Fermeté, justice",
  difficulty: "intermédiaire",
  relatedNames: ["As-Salah", "Al-Janazah"],
  mirrorVersion: `« Et ne prie jamais sur l'un d'eux quand il meurt, et ne te tiens pas sur sa tombe. » Le miroir me montre l'exclusion de la prière funéraire. « Wa la tusalli 'ala ahadin minhum mata abadan » — et ne prie jamais sur l'un d'eux quand il meurt. L'hypocrite perd même la prière funéraire. Le miroir m'interroge : est-ce que je réalise que l'hypocrisie peut me priver de la prière des croyants ?`,
  reflection: `L'hypocrite perd la prière funéraire. La mort révèle la vérité de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tusalli 'ala ahadin minhum mata abadan wa la taqum 'ala qabrihi » — et ne prie jamais sur l'un d'eux quand il meurt, et ne te tiens pas sur sa tombe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que l'hypocrisie peut me priver de la prière des croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière funéraire est un honneur pour le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort révèle ce que la vie cache." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui meurt en croyant reçoit la prière des croyants." }
  ],
  munajat: `Ya Rabb, fais que je meure en croyant sincère. Ne permets pas que l'hypocrisie me prive de la prière des croyants. Donne-moi une bonne fin.`
};

MIROIR["9:85"] = {
  reference: "9:85",
  theme: ["épreuve", "richesse", "hypocrisie"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fitna", "Al-Bala"],
  mirrorVersion: `« Et que ni leurs biens ni leurs enfants ne t'émerveillent. Allah veut par là les châtier dans la vie présente. » Le miroir me montre la signification des épreuves. « Innama yuridu Allahu » — Allah veut par là. Les biens apparents peuvent être une punition. Le miroir m'interroge : est-ce que je comprends que les épreuves peuvent être des punitions ?`,
  reflection: `Les biens et les enfants peuvent être des épreuves ou des punitions. Les apparences trompent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tu'jibka amwaluhum wa awladuhum innama yuridu Allahu an yu'adhdhibahum biha fi al-hayati al-dunya » — et que ni leurs biens ni leurs enfants ne t'émerveillent. Allah veut par là les châtier dans la vie présente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que les épreuves peuvent être des punitions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La punition dans la vie présente peut préserver de la punition éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les apparences ne révèlent pas la réalité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les signes d'Allah voit au-delà des apparences." }
  ],
  munajat: `Ya Rabb, donne-moi de comprendre Tes signes. Fais que je ne sois pas trompé par les apparences. Préserve-moi des punitions dans cette vie et dans l'au-delà.`
};

MIROIR["9:86"] = {
  reference: "9:86",
  theme: ["révélation", "hypocrisie", "choix"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tanzil", "Al-Jihad"],
  mirrorVersion: `« Quand une sourate est révélée : Croyez en Allah et luttez avec Son messager, les gens influents parmi eux te demandent permission. » Le miroir me montre la réaction à la révélation. « Istà'dhanaka » — te demandent permission. Quand le jihad est ordonné, les hypocrites demandent à partir. Le miroir m'interroge : comment je réagis aux commandements du Coran ?`,
  reflection: `Les hypocrites fuient les commandements difficiles. Le croyant obéit même quand c'est difficile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha unzilat suratun an aminu bi-Allahi wa jahidu ma'a rasulihi istà'dhanaka ulu al-tawli » — quand une sourate est révélée : Croyez en Allah et luttez avec Son messager, les gens influents parmi eux te demandent permission." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux commandements difficiles du Coran ? Est-ce que je demande une exception ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande d'exception révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est un commandement, pas une suggestion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit sans condition est le vrai croyant." }
  ],
  munajat: `Ya Rabb, je veux obéir à Tes commandements sans exception. Ne permets pas que je demande à fuir mes obligations. Donne-moi la force d'obéir.`
};

MIROIR["9:87"] = {
  reference: "9:87",
  theme: ["reproche", "hypocrisie", "prétexte"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-'Udhr", "Al-Qa'id"],
  mirrorVersion: `« Ils sont satisfaits d'être avec ceux qui restent en arrière. » Le miroir me montre le contentement dans l'inaction. « Radiyu an yakunu ma'a al-khawalif » — ils sont satisfaits d'être avec ceux qui restent en arrière. Le contentement dans l'inaction est un signe d'hypocrisie. Le miroir m'interroge : est-ce que je suis satisfait de mon inaction ?`,
  reflection: `Le contentement dans l'inaction est un signe d'hypocrisie. Le croyant veut avancer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Radiyu an yakunu ma'a al-khawalifi wa tubi'a 'ala qulubihim » — ils sont satisfaits d'être avec ceux qui restent en arrière. Leurs cœurs sont scellés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis satisfait de mon inaction ? Ou est-ce que je veux avancer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le contentement dans l'inaction scelle le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avancement est la marque du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut avancer trouvera le chemin." }
  ],
  munajat: `Ya Rabb, je veux avancer, pas rester en arrière. Ne permets pas que je sois satisfait de l'inaction. Donne-moi la motivation d'avancer.`
};

MIROIR["9:88"] = {
  reference: "9:88",
  theme: ["effort", "foi", "récompense"],
  emotion: "Espoir, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Jihad", "Al-Mujahid"],
  mirrorVersion: `« Mais le Messager et ceux qui croient avec lui luttent avec leurs biens et leurs personnes. » Le miroir me montre l'effort total. « Jahadu bi-amwalihim wa anfusihim » — luttent avec leurs biens et leurs personnes. L'effort total est la marque du croyant. Le miroir m'interroge : est-ce que je lutte avec tout ce que j'ai ?`,
  reflection: `L'effort total avec biens et personnes est la marque du croyant sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakinna al-rasula wa alladhina amanu ma'ahu jahadu bi-amwalihim wa anfusihim » — mais le Messager et ceux qui croient avec lui luttent avec leurs biens et leurs personnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lutte avec tout ce que j'ai ? Ou est-ce que je garde quelque chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort partiel n'est pas l'effort du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'effort total mène à la récompense totale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne tout reçoit tout." }
  ],
  munajat: `Ya Rabb, je veux lutter avec tout ce que j'ai. Ne permets pas que je garde quelque chose pour moi. Donne-moi la générosité totale.`
};

MIROIR["9:89"] = {
  reference: "9:89",
  theme: ["paradis", "réservé", "récompense"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Mu'idd"],
  mirrorVersion: `« Allah a préparé pour eux des jardins sous lesquels coulent les rives. » Le miroir me montre la récompense préparée. « A'adda Allahu lahum jannatin » — Allah a préparé pour eux des jardins. La récompense est prête pour ceux qui luttent. Le miroir m'interroge : est-ce que j'œuvre pour cette récompense préparée ?`,
  reflection: `La récompense est préparée. Il suffit de lutter pour l'obtenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'adda Allahu lahum jannatin tajri min tahtiha al-anharu khalidina fiha » — Allah a préparé pour eux des jardins sous lesquels coulent les rives, où ils demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour cette récompense préparée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense attend ceux qui luttent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est préparé pour les croyants sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lutte trouve la récompense préparée." }
  ],
  munajat: `Ya Rabb, je veux obtenir la récompense que Tu as préparée. Fais que je lutte sincèrement. Donne-moi d'entrer dans les jardins préparés.`
};

MIROIR["9:90"] = {
  reference: "9:90",
  theme: ["excuse", "bédouins", "hypocrisie"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-A'rab", "Al-'Udhr"],
  mirrorVersion: `« Des bédouins sont venus demander la permission de ne pas sortir. » Le miroir me montre les demandes d'excuses. « Jā'a al-mu'adhdhirūna » — les demandeurs d'excuses sont venus. Certains ont des excuses valides, d'autres non. Le miroir m'interroge : est-ce que j'ai une excuse valide ou inventée ?`,
  reflection: `Les excuses peuvent être valides ou inventées. Le discernement est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa jā'a al-mu'adhdhirūna min al-a'rabi li-yu'dhanū » — des bédouins sont venus demander la permission de ne pas sortir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai une excuse valide ou inventée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse inventée n'entre pas dans la justice d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît les cœurs et les excuses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une excuse valide est excusé." }
  ],
  munajat: `Ya Rabb, Tu connais mes excuses. Fais que je n'invente pas de prétextes. Si j'ai une excuse, accepte-la. Sinon, donne-moi la force de participer.`
};

MIROIR["9:91"] = {
  reference: "9:91",
  theme: ["excuse", "faiblesse", "miséricorde"],
  emotion: "Compassion, justice",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-'Udhr"],
  mirrorVersion: `« Il n'y a pas de reproche contre les faibles, les malades, et ceux qui ne trouvent pas de quoi dépenser. » Le miroir me montre les excuses valides. « Lā darara » — il n'y a pas de reproche. La faiblesse, la maladie, la pauvreté sont des excuses valides. Le miroir m'interroge : est-ce que je comprends les limites de l'obligation ?`,
  reflection: `Les excuses valides sont acceptées. La faiblesse et la maladie ne sont pas des péchés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laysa 'ala al-du'afa'i wa la 'ala al-marda wa la 'ala alladhina la yajidūna mā yunfiqūna haraj » — il n'y a pas de reproche contre les faibles, les malades, et ceux qui ne trouvent pas de quoi dépenser." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends les limites de l'obligation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde d'Allah accepte les limitations." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah n'impose pas au-delà de la capacité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une excuse sincère est excusé." }
  ],
  munajat: `Ya Rahman, Tu acceptes les excuses valides. Si je suis faible ou malade, accepte mon excuse. Sinon, donne-moi la force de participer.`
};

MIROIR["9:92"] = {
  reference: "9:92",
  theme: ["regret", "sincérité", "pauvreté"],
  emotion: "Compassion, honneur",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Faqir"],
  mirrorVersion: `« Ni contre ceux qui sont venus te trouver pour que tu leur donnes une monture. » Le miroir me montre le regret des sincères. « Jā'uka li-tahmilahum » — qui sont venus te trouver pour que tu leur donnes une monture. Ils voulaient partir mais n'avaient pas les moyens. Le miroir m'interroge : est-ce que je regrette sincèrement de ne pas pouvoir participer ?`,
  reflection: `Le regret sincère de ne pas pouvoir participer honore le croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la 'ala alladhina idhā mā atawka li-tahmilahum qulta la ajidu mā ahmilukum 'alayhi » — ni contre ceux qui, quand ils sont venus te trouver pour que tu leur donnes une monture, tu as dit : Je ne trouve pas de quoi vous monter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je regrette sincèrement de ne pas pouvoir participer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret du sincère vaut la participation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'intention sincère est comptée comme action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut participer mais ne peut pas est comme celui qui participe." }
  ],
  munajat: `Ya Rabb, je veux participer sincèrement. Si je ne peux pas, accepte mon regret comme participation. Donne-moi les moyens de participer quand je peux.`
};

// ============================================
// SURAH 23 (AL-MU'MINUN) - EXPANSION
// ============================================

MIROIR["23:3"] = {
  reference: "23:3",
  theme: ["foi", "parole", "vaine"],
  emotion: "Vigilance, discipline",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Sadiq"],
  mirrorVersion: `« Et qui se détournent des futilités. » Le miroir me montre le détournement du futile. Les croyants réussissent parce qu'ils évitent ce qui ne profite pas. Le futile n'est pas le péché — c'est l'inutile. Le miroir m'interroge : combien de temps passe-je dans le futile ?`,
  reflection: `Le futile vide le temps sans remplir l'âme. L'éviter est un signe de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum 'ani al-laghwi mu'ridun » — Et qui se détournent des futilités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de temps passe-je dans le futile ? Qu'est-ce que j'évite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps passé dans le futile est du temps volé à l'essentiel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne perd pas son temps. Seul l'homme peut se permettre le futile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite le futile remplit sa vie de sens." }
  ],
  munajat: `Ya Hafiz, garde ma langue du futile. Fais que chaque parole compte. Ne laisse pas le vide remplir mon temps.`
};

MIROIR["23:4"] = {
  reference: "23:4",
  theme: ["aumône", "purification", "zakat"],
  emotion: "Générosité, purification",
  difficulty: "débutant",
  relatedNames: ["Al-Tahhir", "Al-Raziq"],
  mirrorVersion: `« Et qui s'acquittent de la Zakat. » Le miroir me montre la purification par le don. La Zakat purifie le bien et l'âme. Donner n'appauvrit pas — enrichit spirituellement. Le miroir m'interroge : est-ce que je donne pour purifier ?`,
  reflection: `La Zakat est purification. Le bien donné purifie le bien gardé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum lilzzakati fa'ilun » — Et qui s'acquittent de la Zakat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne ? Est-ce que je considère la Zakat comme purification ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bien non purifié par le don devient une chaîne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La circulation du bien reflète la générosité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne pour purifier reçoit en abondance." }
  ],
  munajat: `Ya Tahhir, purifie mon bien par le don. Fais que je donne avec générosité. Ne laisse pas l'avarice corrompre ce que je possède.`
};

MIROIR["23:5"] = {
  reference: "23:5",
  theme: ["chasteté", "protection", "désir"],
  emotion: "Pureté, maîtrise",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Tahhir"],
  mirrorVersion: `« Et qui préservent leurs parties intimes. » Le miroir me montre la protection de l'intimité. La chasteté n'est pas répression — c'est protection. Préserver ce qui est sacré. Le miroir m'interroge : est-ce que je protège mon intimité ?`,
  reflection: `La chasteté protège ce qui est précieux. Le désir maîtrisé devient force.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum li furujihim hafizun » — Et qui préservent leurs parties intimes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je protège mon intimité ? Ma chasteté est-elle une valeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intimité non protégée devient source de troubles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création préserve ses mystères. L'homme doit préserver les siens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège son intimité protège sa dignité." }
  ],
  munajat: `Ya Hafiz, protège mon intimité. Fais que je préserve ma chasteté. Ne laisse pas le désir incontrôlé me déshonorer.`
};

MIROIR["23:6"] = {
  reference: "23:6",
  theme: ["mariage", "exception", "permis"],
  emotion: "Satisfaction, légitimité",
  difficulty: "débutant",
  relatedNames: ["Al-Halal", "Al-Nikah"],
  mirrorVersion: `« Sauf avec leurs épouses ou les esclaves qu'ils possèdent. » Le miroir me montre l'exception licite. La protection a une porte — le mariage. Le licite n'est pas une brèche — c'est une provision. Le miroir m'interroge : est-ce que je me contente du licite ?`,
  reflection: `Le licite est une miséricorde. S'y tenir préserve de l'illicite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa 'ala azwajihim aw ma malakat aymanuhum » — Sauf avec leurs épouses ou les esclaves qu'ils possèdent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me contente du licite ? Ou est-ce que je cherche l'illicite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illicite promet mais ne donne pas. Le licite donne réellement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose a son cadre légitime. Le respecter est la bénédiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se contente du licite trouve la satisfaction." }
  ],
  munajat: `Ya Halal, fais que je me contente de ce qui est licite. Ne laisse pas l'illicite me tenter. Donne-moi la satisfaction dans le cadre que Tu as établi.`
};

MIROIR["23:7"] = {
  reference: "23:7",
  theme: ["limites", "transgression", "châtiment"],
  emotion: "Vigilance, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Hadd", "Al-'Adl"],
  mirrorVersion: `« Quiconque cherche au-delà de cela, ceux-là sont les transgresseurs. » Le miroir me montre les limites claires. Au-delà du licite, c'est la transgression. La limite n'est pas arbitraire — elle est protectrice. Le miroir m'interroge : est-ce que je respecte les limites ?`,
  reflection: `Les limites divines protègent. Les franchir n'apporte que trouble.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa mani ibtagha wara'a dhalika fa ula'ika hum al-'adun » — Quiconque cherche au-delà de cela, ceux-là sont les transgresseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les limites ? Ou est-ce que je cherche à les franchir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transgression promet la liberté mais apporte l'esclavage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers a ses limites. L'homme seul peut choisir de les dépasser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites les trouve protectrices." }
  ],
  munajat: `Ya Hadd, Tes limites me protègent. Fais que je les respecte. Ne laisse pas ma soif de liberté me conduire à la transgression.`
};

MIROIR["23:8"] = {
  reference: "23:8",
  theme: ["trust", "engagement", "parole"],
  emotion: "Intégrité, fidélité",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Wafi"],
  mirrorVersion: `« Et qui gardent les dépôts confiés et respectent leurs engagements. » Le miroir me montre l'intégrité. Le dépôt confié doit être rendu. L'engagement doit être honoré. La parole est sacrée. Le miroir m'interroge : est-ce que je suis digne de confiance ?`,
  reflection: `La confiance est un dépôt. L'honorer est un signe de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum li amanatihim wa 'ahdihim ra'un » — Et qui gardent les dépôts confiés et respectent leurs engagements." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis digne de confiance ? Est-ce que j'honore mes engagements ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance trahie brise le lien social." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur la confiance. Chaque créature tient sa promesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore sa parole honore son Créateur." }
  ],
  munajat: `Ya Amin, fais que je sois digne de confiance. Fais que je garde les dépôts et honore mes engagements. Ne laisse pas ma parole être vide.`
};

MIROIR["23:9"] = {
  reference: "23:9",
  theme: ["prière", "vigilance", "temps"],
  emotion: "Discipline, présence",
  difficulty: "débutant",
  relatedNames: ["Al-Salah", "Al-Hafiz"],
  mirrorVersion: `« Et qui observent strictement leurs prières. » Le miroir me montre la constance dans la prière. Pas occasionnel — strictement. La prière est le pilier, elle doit être maintenue. Le miroir m'interroge : est-ce que je maintiens ma prière avec constance ?`,
  reflection: `La prière constante est le signe de la foi constante. L'observer strictement est un engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hum 'ala salawatihim yuhafizun » — Et qui observent strictement leurs prières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je maintiens ma prière avec constance ? Ou est-ce que je la néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière négligée est le premier signe de la foi négligée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier prie à sa manière. L'homme doit prier consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde sa prière garde sa connexion avec Allah." }
  ],
  munajat: `Ya Hafiz, fais que je garde ma prière. Donne-moi la constance. Ne laisse pas la négligence briser ma connexion avec Toi.`
};

// ============================================
// SURAH 24 (AN-NUR) - EXPANSION
// ============================================

MIROIR["24:2"] = {
  reference: "24:2",
  theme: ["châtiment", "adultère", "justice"],
  emotion: "Gravité, discipline",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hadd"],
  mirrorVersion: `« La fornicatrice et le fornicateur, fouettez-les chacun de cent coups de fouet. » Le miroir me montre la sévérité de la loi. L'adultère n'est pas une affaire privée — c'est un crime avec châtiment. La société est protégée par la loi. Le miroir m'interroge : est-ce que je respecte la loi d'Allah ?`,
  reflection: `La loi divine protège la société. Le châtiment n'est pas cruauté — c'est préservation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-zaniyatu wa al-zani fa jlidu kulla wahidin minhuma mi'ata jaldatin » — La fornicatrice et le fornicateur, fouettez-les chacun de cent coups de fouet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les limites d'Allah ? Est-ce que je comprends que la loi protège ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté sans limite n'est pas liberté — c'est chaos." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses lois. La société aussi. Le respect est la base." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la loi la trouve protectrice." }
  ],
  munajat: `Ya 'Adl, Ta loi est juste. Fais que je la respecte. Ne laisse pas mes désirs me conduire à la transgression qui brise la société.`
};

MIROIR["24:3"] = {
  reference: "24:3",
  theme: ["mariage", "adultère", "incompatibilité"],
  emotion: "Clarté, conséquence",
  difficulty: "débutant",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Le fornicateur n'épousera qu'une fornicatrice ou une associatrice. » Le miroir me montre les conséquences du péché. L'adultère ne peut épouser qu'une adultère ou une polythéiste. Le péché crée des barrières. Le miroir m'interroge : quelles barrières mes péchés créent-ils ?`,
  reflection: `Le péché a des conséquences durables. Les choix d'aujourd'hui limitent les options de demain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-zani la yankihu illa zaniyatan aw mushrikatan » — Le fornicateur n'épousera qu'une fornicatrice ou une associatrice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles conséquences mes péchés auront-ils ? Quelles portes ferment-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le péché d'un instant peut fermer des portes pour la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a des conséquences. Le péché n'est jamais isolé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite le péché préserve ses options futures." }
  ],
  munajat: `Ya Halal, garde-moi du péché qui ferme les portes. Fais que je préserve mon futur par ma conduite présente. Ne laisse pas mes choix d'aujourd'hui me priver des bienfaits de demain.`
};

MIROIR["24:4"] = {
  reference: "24:4",
  theme: ["accusation", "preuve", "témoins"],
  emotion: "Justice, prudence",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Shahid"],
  mirrorVersion: `« Et ceux qui accusent des femmes chastes sans apporter quatre témoins, fouettez-les de quatre-vingts coups. » Le miroir me montre la protection de l'honneur. Accuser sans preuve est un crime. L'honneur est protégé par la preuve. Le miroir m'interroge : est-ce que j'accuse sans preuve ?`,
  reflection: `L'accusation sans preuve détruit l'honneur. La loi protège l'innocent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina yarmuna al-muhsanati thumma lam ya'tu bi arba'ati shuhada'i fa jliduhum thamaniyina jaldatan » — Et ceux qui accusent des femmes chastes sans apporter quatre témoins, fouettez-les de quatre-vingts coups." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accuse sans preuve ? Est-ce que je respecte l'honneur des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation sans preuve est pire que le crime accusé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole est puissante. L'utiliser sans preuve est destructeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège l'honneur des autres protège le sien." }
  ],
  munajat: `Ya 'Adl, garde ma langue des accusations sans preuve. Fais que je respecte l'honneur des autres. Ne laisse pas ma parole détruire injustement.`
};

// ============================================
// SURAH 25 (AL-FURQAN) - EXPANSION
// ============================================

MIROIR["25:2"] = {
  reference: "25:2",
  theme: ["royauté", "création", "bénédiction"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Mubarak"],
  mirrorVersion: `« Béni soit Celui qui possède la royauté et qui est puissant en toutes choses. » Le miroir me montre la bénédiction de la souveraineté. Allah est le Roi béni. Sa puissance englobe tout. La bénédiction suit la reconnaissance de Sa royauté. Le miroir m'interroge : est-ce que je reconnais Allah comme mon Roi ?`,
  reflection: `La royauté d'Allah est bénédiction pour ceux qui la reconnaissent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tabaraka alladhi lahu al-mulku wa huwa 'ala kulli shay'in qadir » — Béni soit Celui qui possède la royauté et qui est puissant en toutes choses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Allah comme mon Roi ? Est-ce que je me soumets à Sa souveraineté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas reconnaître le Roi ne change pas Sa royauté — cela prive de Sa bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier reconnaît la souveraineté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Roi est béni." }
  ],
  munajat: `Ya Malik, Tu es le Roi béni. Fais que je Te reconnaisse comme mon Souverain. Soumets-moi à Ta volonté et bénis-moi par Ta reconnaissance.`
};

MIROIR["25:3"] = {
  reference: "25:3",
  theme: ["idoles", "impuissance", "création"],
  emotion: "Clarté, rejet",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« Et ils ont pris en dehors de Lui des divinités qui n'ont rien créé et sont elles-mêmes créées. » Le miroir me montre l'absurdité de l'idolâtrie. Les idoles ne créent pas — elles sont créées. Elles ne possèdent ni pouvoir ni profit. Le miroir m'interroge : quelles idoles sans pouvoir est-ce que j'adore ?`,
  reflection: `Les idoles sont impuissantes. Adorer ce qui ne peut rien est la plus grande erreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ittakhadhu min dunihi alihatan la yakhluquna shay'an wa hum yukhlaqun » — Et ils ont pris en dehors de Lui des divinités qui n'ont rien créé et sont elles-mêmes créées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles idoles impuissantes est-ce que j'adore ? L'argent ? Le pouvoir ? La beauté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole créée ne peut rien pour son adorateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul le Créateur mérite l'adoration. Toute chose créée est impuissante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejette les idoles impuissantes trouve le Tout-Puissant." }
  ],
  munajat: `Ya Khaliq, Tu es le seul Créateur. Libère mon cœur des idoles impuissantes. Fais que je n'adore que Toi, le Seul qui peut quelque chose.`
};

MIROIR["25:4"] = {
  reference: "25:4",
  theme: ["rejet", "mensonge", "accusation"],
  emotion: "Clarté, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Sadiq"],
  mirrorVersion: `« Et ceux qui ont mécru disent : "Ce n'est qu'un mensonge qu'il a forgé." » Le miroir me montre le rejet par le mensonge. Face à la vérité, ils accusent le Prophète de l'avoir inventée. Le rejet se justifie par l'accusation. Le miroir m'interroge : est-ce que je rejette la vérité en l'accusant ?`,
  reflection: `Rejeter la vérité n'est jamais honnête. L'accusation cache souvent le refus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala alladhina kafaru in hadha illa ifkun iftarahu » — Et ceux qui ont mécru disent : 'Ce n'est qu'un mensonge qu'il a forgé.'" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la vérité ? Comment justifié-je mon rejet ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accuser le messager ne change pas le message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste vérité même si tout le monde la nie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité sans condition la trouve libératrice." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je ne rejette jamais Ton message. Ne laisse pas mes excuses masquer mon refus. Ouvre mon cœur à Ta vérité.`
};

// ============================================
// SURAH 26 (ASH-SHU'ARA) - EXPANSION
// ============================================

MIROIR["26:2"] = {
  reference: "26:2",
  theme: ["signes", "clarté", "coran"],
  emotion: "Certitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "Al-Mubin"],
  mirrorVersion: `« Voici les versets du Livre explicite. » Le miroir me montre la clarté du Coran. Ce n'est pas un livre obscur — c'est explicite. Les signes sont clairs pour celui qui veut voir. Le miroir m'interroge : est-ce que je lis le Coran comme un livre clair ou comme une énigme ?`,
  reflection: `Le Coran est explicite. L'obscurité vient du cœur, pas du texte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu al-kitabi al-mubin » — Voici les versets du Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran comme un livre clair ? Qu'est-ce qui m'empêche de comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le livre explicite devient obscur pour le cœur fermé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La clarté est la nature de la lumière. Le Coran est lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre son cœur trouve le Coran clair." }
  ],
  munajat: `Ya Mubin, Ton Livre est clair. Ouvre mon cœur pour le comprendre. Ne laisse pas mes voiles m'empêcher de voir Ta clarté.`
};

MIROIR["26:3"] = {
  reference: "26:3",
  theme: ["chagrin", "rejet", "amour"],
  emotion: "Compassion, tristesse",
  difficulty: "débutant",
  relatedNames: ["Ar-Ra'uf", "Al-Rahim"],
  mirrorVersion: `« Peut-être vas-tu te consumer de chagrin parce qu'ils ne sont pas croyants ! » Le miroir me montre l'amour du Prophète. Il se consume pour ceux qui ne croient pas. Son souci pour les autres est si grand qu'il souffre. Le miroir m'interroge : est-ce que je souffre pour ceux qui s'égarent ?`,
  reflection: `L'amour pour les autres peut causer un grand chagrin. Le Prophète pleurait pour son peuple.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La'allaka bakhi'un nafsaka alla yakunu mu'minin » — Peut-être vas-tu te consumer de chagrin parce qu'ils ne sont pas croyants !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je souffre pour ceux qui s'égarent ? Mon amour pour eux est-il réel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'indifférence au sort des autres est le contraire de l'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le véritable guide souffre pour ceux qu'il guide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui souffre pour les autres partage le cœur du Prophète." }
  ],
  munajat: `Ya Ra'uf, le Prophète souffrait pour son peuple. Donne-moi un cœur qui se soucie des autres. Ne laisse pas l'indifférence s'installer dans mon cœur.`
};

// ============================================
// SURAH 27 (AN-NAML) - EXPANSION
// ============================================

MIROIR["27:2"] = {
  reference: "27:2",
  theme: ["guidance", "annonce", "croyants"],
  emotion: "Espérance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Bushra"],
  mirrorVersion: `« Une guidance et une bonne nouvelle pour les croyants. » Le miroir me montre le destin du Coran. Il est guidance et bonne nouvelle — pour les croyants. Le même livre est avertissement pour les uns, bonne nouvelle pour les autres. Le miroir m'interroge : qu'est-ce que le Coran est pour moi ?`,
  reflection: `Le Coran est ce que le cœur en fait. Pour le croyant, il est bonne nouvelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hudan wa bushra li al-mu'minin » — Une guidance et une bonne nouvelle pour les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que le Coran est pour moi ? Guidance et bonne nouvelle ou avertissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le même message a deux effets selon la réception." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière illumine ceux qui ouvrent les yeux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran avec foi reçoit la bonne nouvelle." }
  ],
  munajat: `Ya Huda, fais que Ton Coran soit pour moi guidance et bonne nouvelle. Ouvre mon cœur à la recevoir. Ne laisse pas ma réception être fermée.`
};

MIROIR["27:3"] = {
  reference: "27:3",
  theme: ["prière", "aumône", "certitude"],
  emotion: "Engagement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Muqim", "Al-Mu'ti"],
  mirrorVersion: `« Ceux qui accomplissent la prière, s'acquittent de l'aumône et croient avec certitude en l'au-delà. » Le miroir me montre les signes du croyant. La prière, l'aumône, la certitude en l'au-delà. Ces trois piliers définissent la foi. Le miroir m'interroge : ces trois piliers sont-ils présents dans ma vie ?`,
  reflection: `La foi se voit dans la pratique. Les piliers sont interconnectés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yuqimuna al-salata wa yu'tuna al-zakata wa hum bi al-akhirati hum yuqinun » — Ceux qui accomplissent la prière, s'acquittent de l'aumône et croient avec certitude en l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ces trois piliers sont-ils présents dans ma vie ? La prière, l'aumône, la certitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans pratique est morte. La pratique sans certitude est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est un tout. Chaque pilier soutient les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui établit les trois piliers construit une foi solide." }
  ],
  munajat: `Ya Muqim, fais que j'accomplisse la prière. Fais que je donne l'aumône. Fais que je croie en l'au-delà avec certitude. Établis ces trois piliers dans ma vie.`
};

// ============================================
// SURAH 28 (AL-QASAS) - EXPANSION
// ============================================

MIROIR["28:2"] = {
  reference: "28:2",
  theme: ["signes", "clarté", "livre"],
  emotion: "Certitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "Al-Mubin"],
  mirrorVersion: `« Voici les versets du Livre explicite. » Le miroir me montre la clarté renouvelée. Encore une fois, le Coran est appelé explicite. La clarté n'est pas ponctuelle — elle est constante. Le miroir m'interroge : est-ce que je cherche la clarté du Coran ?`,
  reflection: `Le Coran est constamment clair. La confusion vient du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu al-kitabi al-mubin » — Voici les versets du Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la clarté du Coran ? Ou est-ce que je reste dans la confusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté attend le cœur ouvert." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est claire par nature. Le cœur doit vouloir voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la clarté la trouve." }
  ],
  munajat: `Ya Mubin, Ton Livre est explicite. Fais que je le lise avec un cœur ouvert à la clarté. Ne laisse pas mes propres voiles m'empêcher de comprendre.`
};

MIROIR["28:3"] = {
  reference: "28:3",
  theme: ["histoire", "moïse", "pharaon"],
  emotion: "Intérêt, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Qasas", "Al-Mu'allim"],
  mirrorVersion: `« Nous te racontons en toute vérité une partie de l'histoire de Moïse et de Pharaon. » Le miroir me montre l'histoire comme enseignement. L'histoire de Moïse et Pharaon n'est pas du divertissement — c'est une leçon. La vérité de l'histoire purifie. Le miroir m'interroge : est-ce que je tire des leçons de l'histoire ?`,
  reflection: `L'histoire est une maîtresse. Chaque récit porte une leçon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Natlu 'alayka min naba'i musa wa fir'awna bi al-haqq » — Nous te racontons en toute vérité une partie de l'histoire de Moïse et de Pharaon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tire des leçons des histoires du Coran ? Ou est-ce que je les lis comme des contes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire lue sans leçon est temps perdu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine se répète. Les leçons sont éternelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Qasas, Tu racontes les histoires pour enseigner. Fais que j'apprenne des leçons de Moïse et Pharaon. Ne laisse pas l'histoire passer sans m'instruire.`
};

MIROIR["28:4"] = {
  reference: "28:4",
  theme: ["tyrannie", "orgueil", "division"],
  emotion: "Indignation, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Zalim", "Al-Musta'naf"],
  mirrorVersion: `« Pharaon s'éleva sur terre et y répartit son peuple en factions. » Le miroir me montre la stratégie du tyran. L'orgueil mène à la division. Pharaon a divisé pour régner. L'unité du peuple le menaçait. Le miroir m'interroge : est-ce que je vois les stratégies de division aujourd'hui ?`,
  reflection: `La tyrannie divise pour régner. L'unité est la force des opprimés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fir'awna 'ala fi al-ardi wa ja'ala ahlahā shiya'an » — Pharaon s'éleva sur terre et y répartit son peuple en factions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les stratégies de division ? Est-ce que je travaille pour l'unité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division profite au tyran. L'unité profite au peuple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des tyrans est toujours la même. L'histoire des résistants aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la stratégie du tyran ne tombe pas dans ses pièges." }
  ],
  munajat: `Ya Musta'naf, Tu vois les stratégies des tyrans. Ouvre mes yeux pour les voir. Ne laisse pas la division m'affaiblir. Fais que je travaille pour l'unité.`
};

MIROIR["9:93"] = {
  reference: "9:93",
  theme: ["reproche", "richesse", "hypocrisie"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Al-Khasarah"],
  mirrorVersion: `« Le reproche est contre ceux qui te demandent permission alors qu'ils sont riches. » Le miroir me montre le reproche aux riches. « Al-sabilu 'ala alladhina yasta'dhinunaka » — le reproche est contre ceux qui te demandent permission alors qu'ils sont riches. Les riches qui ne participent pas sont blâmables. Le miroir m'interroge : est-ce que je participe selon mes moyens ?`,
  reflection: `Les riches ont plus d'obligation de participer. Leur non-participation est blâmable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama al-sabilu 'ala alladhina yasta'dhinunaka wa hum aghniya' » — le reproche est contre ceux qui te demandent permission alors qu'ils sont riches." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe selon mes moyens ? Ou est-ce que je cache ma capacité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse augmente l'obligation de participation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "À chacun selon sa capacité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache sa capacité est hypocrite." }
  ],
  munajat: `Ya Rabb, je veux participer selon mes moyens. Ne permets pas que je cache ma capacité. Fais que je sois généreux avec ce que Tu m'as donné.`
};

MIROIR["9:94"] = {
  reference: "9:94",
  theme: ["excuse", "mensonge", "hypocrisie"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Kadhdhab"],
  mirrorVersion: `« Ils vous présentent leurs excuses quand vous revenez vers eux. » Le miroir me montre les fausses excuses. « Ya'tadhiruna ilaykum » — ils vous présentent leurs excuses. Les excuses viennent après le fait, pas avant. Le miroir m'interroge : est-ce que j'anticipe mes devoirs ou est-ce que j'excuse après ?`,
  reflection: `Les excuses après le fait révèlent souvent l'hypocrisie. Le croyant agit sans attendre d'être rappelé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'tadhiruna ilaykum idha raja'tum ilayhim » — ils vous présentent leurs excuses quand vous revenez vers eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'anticipe mes devoirs ou est-ce que j'excuse après ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse après le fait est souvent mensongère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît la vérité derrière les excuses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit sans attendre n'a pas besoin d'excuses." }
  ],
  munajat: `Ya Rabb, fais que j'agisse sans attendre d'être rappelé. Ne permets pas que j'utilise des excuses mensongères. Donne-moi la proactivité dans le bien.`
};

MIROIR["9:95"] = {
  reference: "9:95",
  theme: ["serment", "hypocrisie", "relation"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yamin", "Al-Khabir"],
  mirrorVersion: `« Ils vous jureront par Allah, quand vous revenez vers eux, pour que vous vous détourniez d'eux. » Le miroir me montre le serment manipulateur. « Li-tu'ridū 'anhum » — pour que vous vous détourniez d'eux. Le serment sert à éviter les conséquences. Le miroir m'interroge : est-ce que je jure pour éviter les conséquences ?`,
  reflection: `Le serment pour éviter les conséquences est manipulateur. La vérité n'a pas besoin de serment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sayahlifuna bi-Allahi lakum idha yanqalabtum ilayhim li-tu'ridū 'anhum » — ils vous jureront par Allah, quand vous revenez vers eux, pour que vous vous détourniez d'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jure pour éviter les conséquences ? Ou est-ce que j'assume ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment manipulateur aggrave la faute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît les intentions derrière les serments." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume n'a pas besoin de serment." }
  ],
  munajat: `Ya Rabb, fais que je n'utilise pas le serment pour éviter les conséquences. Donne-moi le courage d'assumer mes actes.`
};

MIROIR["9:96"] = {
  reference: "9:96",
  theme: ["satisfaction", "hypocrisie", "condition"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Radi", "Al-Qalb"],
  mirrorVersion: `« Ils vous jureront pour que vous soyez satisfaits d'eux. Mais si vous êtes satisfaits d'eux, Allah n'est pas satisfait des gens pervers. » Le miroir me montre la satisfaction conditionnelle. « Li-tardaw 'anhum » — pour que vous soyez satisfaits d'eux. La satisfaction des hommes ne vaut pas celle d'Allah. Le miroir m'interroge : qui je cherche à satisfaire en priorité ?`,
  reflection: `La satisfaction des hommes ne vaut pas celle d'Allah. Les hypocrites cherchent la satisfaction des hommes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yahlihifuna lakum li-tardaw 'anhum fa-in tardaw 'anhum fa-inna Allaha la yarda 'ani al-qawmi al-fasiqin » — ils vous jureront pour que vous soyez satisfaits d'eux. Mais si vous êtes satisfaits d'eux, Allah n'est pas satisfait des gens pervers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je cherche à satisfaire en priorité ? Les hommes ou Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction des hommes sans celle d'Allah est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La satisfaction d'Allah est la seule qui compte vraiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui satisfait Allah satisfait tout le monde." }
  ],
  munajat: `Ya Radi, je veux Te satisfaire avant tout. Ne permets pas que je cherche la satisfaction des hommes avant la Tienne. Donne-moi la priorité de Ta satisfaction.`
};

MIROIR["9:98"] = {
  reference: "9:98",
  theme: ["bédouins", "hypocrisie", "attente"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-A'rab", "Al-Intizar"],
  mirrorVersion: `« Parmi les bédouins, certains prennent ce qu'ils dépensent comme une perte et attendent pour vous les revers du sort. » Le miroir me montre l'attitude des bédouins hypocrites. « Yaj'alūna ma yunfiqūna maghraman » — prennent ce qu'ils dépensent comme une perte. La dépense pour Allah est vue comme perte. Le miroir m'interroge : est-ce que je vois ma dépense pour Allah comme un investissement ou une perte ?`,
  reflection: `La dépense pour Allah est un investissement, pas une perte. Les hypocrites la voient comme une perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min al-a'rabi man yattakhidhu ma yunfiqu maghraman wa yatarabbasu bikumu al-dawa'ir » — parmi les bédouins, certains prennent ce qu'ils dépensent comme une perte et attendent pour vous les revers du sort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois ma dépense pour Allah comme un investissement ou une perte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dépense pour Allah est l'investissement le plus rentable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'investissement pour Allah rapporte éternellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépense pour Allah reçoit plus qu'il ne donne." }
  ],
  munajat: `Ya Rabb, je vois ma dépense pour Toi comme un investissement. Bénis mon investissement. Ne permets pas que je le voie comme une perte.`
};

MIROIR["9:99"] = {
  reference: "9:99",
  theme: ["bédouins", "foi", "espérance"],
  emotion: "Espoir, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Qurb"],
  mirrorVersion: `« Parmi les bédouins, certains croient en Allah et au Jour dernier et prennent ce qu'ils dépensent comme moyen de se rapprocher d'Allah. » Le miroir me montre les bédouins sincères. « Qurbatan » — comme moyen de se rapprocher. La dépense peut être un moyen de rapprochement. Le miroir m'interroge : est-ce que je dépense pour me rapprocher d'Allah ?`,
  reflection: `La dépense sincère rapproche d'Allah. Elle est un investissement spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min al-a'rabi man yu'minu bi-Allahi wa al-yawmi al-akhiri wa yattakhidhu ma yunfiqu qurbūtātin 'inda Allahi » — parmi les bédouins, certains croient en Allah et au Jour dernier et prennent ce qu'ils dépensent comme moyen de se rapprocher d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense pour me rapprocher d'Allah ? Quel est mon intention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rapprochement par la dépense est un chemin spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah accepte le rapprochement par la dépense sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rapproche par la dépense est rapproché par Allah." }
  ],
  munajat: `Ya Rabb, je veux me rapprocher de Toi par ma dépense. Accepte mon offrande comme rapprochement. Donne-moi de me rapprocher de Toi chaque jour.`
};

MIROIR["9:100"] = {
  reference: "9:100",
  theme: ["premiers", "excellence", "récompense"],
  emotion: "Honneur, motivation",
  difficulty: "débutant",
  relatedNames: ["As-Sabiqun", "Al-Muhajirun"],
  mirrorVersion: `« Les premiers parmi les émigrés et les Auxiliaires, et ceux qui les ont suivis dans le bien, Allah est satisfait d'eux et ils sont satisfaits de Lui. » Le miroir me montre l'excellence des premiers. « Al-sabiqun al-awwalun » — les premiers. Les premiers dans la foi ont un rang spécial. Le miroir m'interroge : est-ce que je suis dans le chemin des premiers ?`,
  reflection: `Les premiers dans la foi ont un rang spécial. Suivre leur exemple est un honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-sabiqun al-awwalun min al-muhajirina wa al-ansar wa alladhina ittaba'uhum bi-ihsan radiya Allahu 'anhum » — les premiers parmi les émigrés et les Auxiliaires, et ceux qui les ont suivis dans le bien, Allah est satisfait d'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis dans le chemin des premiers ? Ou est-ce que je retarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excellence demande de suivre le chemin des meilleurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les meilleurs sont des modèles pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les premiers est avec eux au Paradis." }
  ],
  munajat: `Ya Rabb, je veux suivre le chemin des premiers. Fais que je sois parmi ceux qui suivent avec excellence. Donne-moi la satisfaction que Tu as donnée aux premiers.`
};

MIROIR["9:101"] = {
  reference: "9:101",
  theme: ["hypocrisie", "voisinage", "révélation"],
  emotion: "Vigilance, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Munafiq", "Al-Jiwar"],
  mirrorVersion: `« Parmi les bédouins qui vous entourent, il y a des hypocrites. » Le miroir me montre l'hypocrisie dans le voisinage. « Munafiquna » — il y a des hypocrites. L'hypocrisie existe même parmi les voisins proches. Le miroir m'interroge : est-ce que je suis conscient de l'hypocrisie autour de moi ?`,
  reflection: `L'hypocrisie existe partout, même parmi les proches. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mimman hawlakum min al-a'rabi munafiquna wa min ahli al-madinatin » — parmi les bédouins qui vous entourent, il y a des hypocrites, ainsi que parmi les habitants de Médine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient de l'hypocrisie autour de moi ? Ou est-ce que je suis naïf ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vigilance n'est pas paranoïa — c'est sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'hypocrisie existe dans toutes les communautés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les hypocrites peut les éviter." }
  ],
  munajat: `Ya Rabb, donne-moi la connaissance des hypocrites. Ne permets pas que je sois trompé par ceux qui m'entourent. Protège-moi de l'hypocrisie en moi et autour de moi.`
};

MIROIR["9:102"] = {
  reference: "9:102",
  theme: ["aveu", "mélange", "repentir"],
  emotion: "Espoir, sincérité",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Mu'tarif"],
  mirrorVersion: `« D'autres avouent leurs péchés, ils ont mêlé une bonne action à une mauvaise. » Le miroir me montre le mélange. « I'tarafū bi-dhunubihim » — ils avouent leurs péchés. L'aveu est le début du repentir. Le miroir m'interroge : est-ce que j'avoue mes péchés ou est-ce que je les cache ?`,
  reflection: `L'aveu des péchés est le début du repentir. Le mélange de bonnes et mauvaises actions peut être purifié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akharuna i'tarafū bi-dhunubihim khalatu 'amalan salihan wa akhara sayyi'an » — d'autres avouent leurs péchés, ils ont mêlé une bonne action à une mauvaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'avoue mes péchés ? Ou est-ce que je les cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveu ouvre la porte du pardon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repentir purifie le mélange." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avoue et se repent est purifié." }
  ],
  munajat: `Ya Tawwab, j'avoue mes péchés devant Toi. Pardonne mon mélange de bonnes et mauvaises actions. Purifie-moi par Ton repentir.`
};

MIROIR["9:103"] = {
  reference: "9:103",
  theme: ["aumône", "purification", "bénédiction"],
  emotion: "Espoir, purification",
  difficulty: "débutant",
  relatedNames: ["Az-Zakat", "At-Tahhir"],
  mirrorVersion: `« Prélève de leurs biens une aumône par laquelle tu les purifies. » Le miroir me montre la purification par l'aumône. « Khudh min amwalihim sadaqatan tuhhiruhum » — prélève une aumône par laquelle tu les purifies. L'aumône purifie les biens et le cœur. Le miroir m'interroge : est-ce que je paie mon aumône pour me purifier ?`,
  reflection: `L'aumône purifie les biens et le cœur. Elle est un droit d'Allah sur les richesses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khudh min amwalihim sadaqatan tuhhiruhum wa tuzakkīhim biha » — prélève de leurs biens une aumône par laquelle tu les purifies et les bénis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je paie mon aumône pour me purifier ? Ou est-ce que je la néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification par l'aumône est une grâce d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aumône est le droit des pauvres sur les riches." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui paie l'aumône purifie son cœur et ses biens." }
  ],
  munajat: `Ya Tahir, purifie-moi par mon aumône. Accepte mon offrande comme purification. Bénis mes biens par l'aumône.`
};

MIROIR["9:104"] = {
  reference: "9:104",
  theme: ["repentir", "miséricorde", "science"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-'Alim"],
  mirrorVersion: `« Ne savent-ils pas qu'Allah accueille le repentir de Ses serviteurs ? » Le miroir me montre l'ouverture du repentir. « Huwa al-tawwab » — c'est Lui l'Accueillant du repentir. Allah attend le repentir de Ses serviteurs. Le miroir m'interroge : est-ce que je me repens en sachant qu'Allah m'accueille ?`,
  reflection: `Allah accueille le repentir. Sa miséricorde est toujours ouverte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam ya'lamu anna Allaha huwa yaqbalu al-tawbata 'an 'ibadihi » — ne savent-ils pas qu'Allah accueille le repentir de Ses serviteurs ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens en sachant qu'Allah m'accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir est toujours accueilli par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent est purifié comme au premier jour." }
  ],
  munajat: `Ya Tawwab, j'ai confiance en Ton accueil. Je me repens devant Toi. Accepte mon repentir et purifie-moi.`
};

MIROIR["9:105"] = {
  reference: "9:105",
  theme: ["action", "examen", "messager"],
  emotion: "Responsabilité, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-'Amal", "Al-Shahid"],
  mirrorVersion: `« Et dis : Œuvrez, car Allah verra votre œuvre, ainsi que Son messager et les croyants. » Le miroir me montre la visibilité des actions. « I'malu » — œuvrez. Les actions sont vues par Allah, le messager et les croyants. Le miroir m'interroge : est-ce que j'œuvre en sachant que je suis observé ?`,
  reflection: `Les actions sont observées. Œuvrer en sachant que je suis vu motive la qualité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa quli i'malu fa-sa-yara Allahu 'amalakum wa rasuluhu wa al-mu'minuna » — et dis : Œuvrez, car Allah verra votre œuvre, ainsi que Son messager et les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre en sachant que je suis observé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de l'observation améliore la qualité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est caché d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour être vu par Allah œuvre avec excellence." }
  ],
  munajat: `Ya Shahid, Tu vois mes actions. Fais que j'œuvre avec excellence. Ne permets pas que je sois négligeant parce que je suis observé.`
};

MIROIR["9:106"] = {
  reference: "9:106",
  theme: ["suspension", "jugement", "attente"],
  emotion: "Incertitude, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'akhkhar", "Al-Qada"],
  mirrorVersion: `« D'autres attendent le décret d'Allah, soit qu'Il les châtie, soit qu'Il leur pardonne. » Le miroir me montre l'état suspendu. « Murjawna » — en attente. Certains sont dans l'incertitude du jugement. Le miroir m'interroge : est-ce que je suis dans l'incertitude de mon état ?`,
  reflection: `Certains sont dans l'attente du jugement. L'incertitude peut motiver le repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akharuna murjawna li-amri Allahi immā yu'adhdhibuhum wa immā yatubu 'alayhim » — d'autres attendent le décret d'Allah, soit qu'Il les châtie, soit qu'Il leur pardonne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis dans l'incertitude de mon état ? Ou est-ce que je suis confiant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incertitude peut motiver le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement appartient à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sort de l'incertitude." }
  ],
  munajat: `Ya Rabb, si je suis dans l'incertitude, fais que je me repente. Ne permets pas que je reste dans la suspension. Donne-moi la certitude du pardon.`
};

MIROIR["9:107"] = {
  reference: "9:107",
  theme: ["mosquée", "nuisance", "hypocrisie"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Masjid", "Al-Darar"],
  mirrorVersion: `« Ceux qui ont construit une mosquée pour nuire et pour la mécréance. » Le miroir me montre la fausse construction. « Masjidun diraran » — une mosquée pour nuire. Même la mosquée peut être construite avec de mauvaises intentions. Le miroir m'interroge : quelle est mon intention dans mes œuvres ?`,
  reflection: `L'intention compte plus que l'œuvre visible. Même une mosquée peut être construite pour le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina ittakhadhu masjidan diraran wa kufran » — ceux qui ont construit une mosquée pour nuire et pour la mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon intention dans mes œuvres ? Sont-elles pour Allah ou pour autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'œuvre sans bonne intention est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'intention est le fondement de l'œuvre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une bonne intention voit son œuvre acceptée." }
  ],
  munajat: `Ya Rabb, purifie mon intention dans toutes mes œuvres. Ne permets pas que je construise pour nuire. Fais que tout ce que je fais soit pour Toi.`
};

MIROIR["9:108"] = {
  reference: "9:108",
  theme: ["prière", "pureté", "interdiction"],
  emotion: "Pureté, exclusivité",
  difficulty: "débutant",
  relatedNames: ["At-Taharah", "As-Salah"],
  mirrorVersion: `« N'y prie jamais. Une mosquée fondée sur la piété dès le premier jour mérite plus que tu y pries. » Le miroir me montre le choix de la mosquée. « La tatamm fihi abadan » — n'y prie jamais. La mosquée de la nuisance est interdite. Le miroir m'interroge : où est-ce que je prie et pourquoi ?`,
  reflection: `La prière dans les lieux purs est préférable. La fondation compte plus que l'apparence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La taqum fihi abadan laqad ussisa al-masjidu 'ala al-taqwa min awwali yawmin » — n'y prie jamais. Une mosquée fondée sur la piété dès le premier jour mérite plus que tu y pries." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je prie et pourquoi ? Quel est l'esprit du lieu de prière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fondation détermine la bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté du lieu affecte la pureté de la prière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie dans un lieu pur a une prière pure." }
  ],
  munajat: `Ya Tahir, purifie mes lieux de prière. Fais que je prie dans les lieux fondés sur la piété. Bénis ma prière par la pureté du lieu.`
};

MIROIR["9:109"] = {
  reference: "9:109",
  theme: ["fondation", "comparaison", "ruine"],
  emotion: "Lucidité, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bunya", "Al-Asas"],
  mirrorVersion: `« Lequel est meilleur : celui qui a fondé son édifice sur la piété ou celui qui l'a fondé sur le bord d'un précipice ? » Le miroir me montre la comparaison des fondations. « 'ala taqwa » — sur la piété. « 'ala shafā juruf » — sur le bord d'un précipice. La fondation détermine la stabilité. Le miroir m'interroge : sur quoi je fonde ma vie ?`,
  reflection: `La fondation sur la piété est stable. La fondation sur le précipice est fragile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-man assasa binyanahu 'ala taqwa min Allahi wa ridwanin am man assasa binyanahu 'ala shafā jurufin hārin » — lequel est meilleur : celui qui a fondé son édifice sur la piété et la satisfaction d'Allah, ou celui qui l'a fondé sur le bord d'un précipice qui s'effondre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je fonde ma vie ? Sur la piété ou sur le précipice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fondation détermine la destinée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout édifice a une fondation qui détermine sa stabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fonde sur la piété a un édifice éternel." }
  ],
  munajat: `Ya Rabb, je veux fonder ma vie sur la piété. Ne permets pas que je fonde sur le précipice. Donne-moi une fondation solide qui résiste à l'épreuve.`
};

MIROIR["9:110"] = {
  reference: "9:110",
  theme: ["édifice", "ruine", "hypocrisie"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bunya", "Al-Hazimah"],
  mirrorVersion: `« L'édifice qu'ils ont construit ne cessera d'être un doute dans leurs cœurs. » Le miroir me montre l'incertitude qui suit la mauvaise fondation. « Rabīdatun fi qulubihim » — un doute dans leurs cœurs. La mauvaise construction laisse un doute permanent. Le miroir m'interroge : est-ce que j'ai des doutes sur mes œuvres ?`,
  reflection: `La mauvaise fondation laisse un doute permanent. La bonne fondation apporte la certitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lā yazālu binyānuhumu alladhī banaw rabīdatun fi qulubihim » — l'édifice qu'ils ont construit ne cessera d'être un doute dans leurs cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai des doutes sur mes œuvres ? Ou est-ce que j'ai la certitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute sur les œuvres révèle la mauvaise intention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La certitude vient de la bonne intention." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre avec sincérité n'a pas de doute." }
  ],
  munajat: `Ya Rabb, fais que je n'aie pas de doute sur mes œuvres. Purifie mon intention pour que je sois certain. Ne permets pas que le doute ronge mon cœur.`
};

MIROIR["9:112"] = {
  reference: "9:112",
  theme: ["description", "croyants", "répétition"],
  emotion: "Espoir, identification",
  difficulty: "débutant",
  relatedNames: ["Al-Tawwabun", "Al-'Abidun"],
  mirrorVersion: `« Les repentants, les adorateurs, les louangeurs, les jeûneurs, les inclinés, les prosternés, les commandeurs du bien et les interdicteurs du mal. » Le miroir me montre les qualités des croyants. « Al-tawwabun » — les repentants. « Al-'abidun » — les adorateurs. Neuf qualités sont énumérées. Le miroir m'interroge : est-ce que je me retrouve dans ces qualités ?`,
  reflection: `Les croyants ont des qualités multiples. Chacune est un chemin vers Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-tawwabuna wa al-'abiduna wa al-hamiduna wa al-sa'ihuna wa al-ruka'i wa al-sujud » — les repentants, les adorateurs, les louangeurs, les jeûneurs, les inclinés, les prosternés..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me retrouve dans ces qualités ? Laquelle je veux développer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces qualités sont interconnectées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le croyant complet possède toutes ces qualités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive ces qualités est complet." }
  ],
  munajat: `Ya Rabb, je veux posséder toutes ces qualités. Fais que je sois repentant, adorateur, louangeur, jeûneur, incliné, prosterné, commandeur du bien, interdicteur du mal, et gardien des limites.`
};

MIROIR["9:113"] = {
  reference: "9:113",
  theme: ["pardon", "parents", "mécréance"],
  emotion: "Tristesse, limite",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Istighfar", "Al-Qaraba"],
  mirrorVersion: `« Il n'appartient pas au Prophète et aux croyants de demander pardon pour les idolâtres, même s'ils sont leurs proches parents. » Le miroir me montre les limites du pardon. « Ma kana li-al-nabiyyi wa alladhina amanu » — il n'appartient pas au Prophète et aux croyants. L'amour familial ne peut pas surpasser la vérité. Le miroir m'interroge : est-ce que je demande pardon pour les mécréants proches ?`,
  reflection: `Le pardon pour les mécréants n'est pas permis, même pour les proches. La vérité prime sur les liens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana li-al-nabiyyi wa alladhina amanu an yastaghfiru li-al-mushrikina » — il n'appartient pas au Prophète et aux croyants de demander pardon pour les idolâtres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande pardon pour les mécréants proches ? Ou est-ce que j'accepte les limites divines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour pour les proches ne peut pas nier la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les limites d'Allah sont justes, même si elles sont douloureuses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les limites d'Allah est vraiment soumis." }
  ],
  munajat: `Ya Rabb, j'accepte Tes limites. Aide-moi à comprendre que l'amour pour les proches ne peut pas surpasser la vérité. Donne-moi la force d'accepter Tes décisions.`
};

MIROIR["9:114"] = {
  reference: "9:114",
  theme: ["prière", "promesse", "abraham"],
  emotion: "Exemple, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Ibrahim", "Al-Wa'ad"],
  mirrorVersion: `« La demande de pardon d'Abraham pour son père n'était qu'à cause d'une promesse qu'il lui avait faite. » Le miroir me montre l'exemple d'Abraham. « Illa 'an maw'idatin » — à cause d'une promesse. Abraham avait promis de demander pardon, mais quand il a vu que son père était ennemi d'Allah, il s'est désisté. Le miroir m'interroge : est-ce que je comprends les limites de l'engagement envers les mécréants ?`,
  reflection: `L'engagement envers les mécréants est limité par la vérité. Abraham est un exemple de soumission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kan istighfaru Ibrahimin li-abīhi illa 'an maw'idatin wa'adaha iyyahu » — la demande de pardon d'Abraham pour son père n'était qu'à cause d'une promesse qu'il lui avait faite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends les limites de l'engagement envers les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité prime sur l'engagement humain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Abraham est un exemple de soumission à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit l'exemple d'Abraham est sur la bonne voie." }
  ],
  munajat: `Ya Rabb, donne-moi de suivre l'exemple d'Abraham. Fais que je comprenne les limites de l'engagement humain. Soumets-moi entièrement à Ta vérité.`
};

MIROIR["9:115"] = {
  reference: "9:115",
  theme: ["guidance", "épreuve", "mécréance"],
  emotion: "Confiance, compréhension",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Adl"],
  mirrorVersion: `« Allah n'est point tel qu'Il égare un peuple après l'avoir guidé. » Le miroir me montre la justice de la guidance. « Ma kana Allahu li-yudilla qawman » — Allah n'est point tel qu'Il égare un peuple. La guidance une fois donnée n'est pas retirée sans raison. Le miroir m'interroge : est-ce que j'apprécie la guidance que j'ai reçue ?`,
  reflection: `La guidance est un don précieux. Allah ne la retire pas sans raison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana Allahu li-yudilla qawman ba'da idh hadahum » — Allah n'est point tel qu'Il égare un peuple après l'avoir guidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprécie la guidance que j'ai reçue ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est un trésor à préserver." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve sa guidance la garde." }
  ],
  munajat: `Ya Hadi, merci pour Ta guidance. Fais que je l'apprécie et la préserve. Ne permets pas que je la perde par mon ingratitude.`
};

MIROIR["9:116"] = {
  reference: "9:116",
  theme: ["royauté", "protection", "allié"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Mulk", "Al-Wali"],
  mirrorVersion: `« À Allah appartient la royauté des cieux et de la terre. Il fait vivre et mourir. Et il n'y a pour vous en dehors d'Allah ni allié ni secoureur. » Le miroir me montre la souveraineté absolue. « Lillahi mulku al-samawati wa al-ard » — à Allah appartient la royauté. Il est le seul allié et secoureur. Le miroir m'interroge : est-ce qu'Allah est mon seul allié ?`,
  reflection: `Allah est le seul vrai allié et secoureur. Sa souveraineté est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha lahu mulku al-samawati wa al-ard yuhyi wa yumit wa ma lakum min duni Allahi min waliyyin wa la nasir » — à Allah appartient la royauté des cieux et de la terre. Il fait vivre et mourir. Et il n'y a pour vous en dehors d'Allah ni allié ni secoureur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'Allah est mon seul allié ? Ou est-ce que je cherche d'autres alliés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les autres alliés sont illusoires." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Maître absolu de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah comme allié a tout." }
  ],
  munajat: `Ya Mulk, Tu es mon seul allié et secoureur. Je me confie entièrement à Toi. Ne permets pas que je cherche d'autres alliés.`
};

MIROIR["9:117"] = {
  reference: "9:117",
  theme: ["repentir", "prophète", "compassion"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Ra'uf"],
  mirrorVersion: `« Allah a accueilli le repentir du Prophète, des émigrés et des Auxiliaires qui l'ont suivi à l'heure difficile. » Le miroir me montre le repentir accepté. « Taba Allahu 'ala al-nabiyyi » — Allah a accueilli le repentir du Prophète. Même le Prophète a besoin de repentir. Le miroir m'interroge : est-ce que je me repens comme le Prophète ?`,
  reflection: `Même le Prophète a demandé repentir. Le repentir est pour tous, les meilleurs comme les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad taba Allahu 'ala al-nabiyyi wa al-muhajirina wa al-ansar » — Allah a accueilli le repentir du Prophète, des émigrés et des Auxiliaires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens comme le Prophète ? Ou est-ce que je me crois parfait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir est le chemin du parfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repentir est universel, pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent constamment est le plus proche d'Allah." }
  ],
  munajat: `Ya Tawwab, Tu as accueilli le repentir du Prophète. Accueille aussi le mien. Fais que je me repense constamment, comme le meilleur des exemples.`
};

MIROIR["9:118"] = {
  reference: "9:118",
  theme: ["repentir", "trois", "isolement"],
  emotion: "Espoir, miséricorde",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawwab", "Al-Wasi'"],
  mirrorVersion: `« Et sur les trois qui étaient restés en arrière. La terre, immense, leur semblait exiguë. » Le miroir me montre le repentir des trois. « Wa 'ala al-thalathati alladhina khullifu » — sur les trois qui étaient restés en arrière. Leur regret était si grand que même la terre vaste leur semblait étroite. Le miroir m'interroge : est-ce que mon regret est aussi profond ?`,
  reflection: `Le regret sincère resserre le cœur. La terre immense devient exiguë.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ala al-thalathati alladhina khullifu hatta idha daqat 'alayhim al-ardu bi-ma rahubat » — et sur les trois qui étaient restés en arrière, jusqu'à ce que la terre, immense, leur semblât exiguë." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon regret est aussi profond ? Ou est-ce que je suis superficiel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret profond purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre devient exiguë pour celui qui regrette sincèrement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regrette sincèrement est pardonné." }
  ],
  munajat: `Ya Tawwab, fais que mon regret soit profond comme celui des trois. Ne permets pas que je sois superficiel dans mon repentir. Donne-moi le pardon après le profond regret.`
};

MIROIR["9:120"] = {
  reference: "9:120",
  theme: ["médine", "hypocrisie", "désertion"],
  emotion: "Responsabilité, communauté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Madinah", "Al-Jihad"],
  mirrorVersion: `« Il n'appartient pas aux habitants de Médine et aux bédouins qui les entourent de rester en arrière du messager d'Allah. » Le miroir me montre la responsabilité communautaire. « Ma kana li-ahli al-madinati » — il n'appartient pas aux habitants de Médine. La proximité du Prophète augmente la responsabilité. Le miroir m'interroge : est-ce que je réalise que ma proximité augmente ma responsabilité ?`,
  reflection: `La proximité du Prophète et de la communauté augmente la responsabilité. On ne peut pas déserté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana li-ahli al-madinati wa man hawlahum min al-a'rabi an yatakhallafu 'an rasuli Allahi » — il n'appartient pas aux habitants de Médine et aux bédouins qui les entourent de rester en arrière du messager d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que ma proximité augmente ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité est un privilège et une responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté a des devoirs envers son centre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est proche du Prophète doit le suivre." }
  ],
  munajat: `Ya Rabb, je réalise que ma proximité augmente ma responsabilité. Ne permets pas que je déserte. Donne-moi la force de suivre le Prophète.`
};

MIROIR["9:121"] = {
  reference: "9:121",
  theme: ["dépense", "traversée", "enregistrement"],
  emotion: "Conscience, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nafaqah", "Al-Kitab"],
  mirrorVersion: `« Ils ne font aucune dépense, petite ou grande, et ne traversent aucune vallée sans que cela ne soit inscrit à leur actif. » Le miroir me montre l'enregistrement divin. « Yuktabu lahum » — que cela ne soit inscrit à leur actif. Tout est enregistré, petit ou grand. Le miroir m'interroge : est-ce que je réalise que tout est enregistré ?`,
  reflection: `Tout est enregistré par Allah. Les petites comme les grandes actions comptent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yunfiquna nafaqatan saghiratan wa la kabiratan wa la yaqta'una wadin illa kutiba lahum » — ils ne font aucune dépense, petite ou grande, et ne traversent aucune vallée sans que cela ne soit inscrit à leur actif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que tout est enregistré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enregistrement divin motive l'action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout acte a une répercussion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que tout est enregistré agit avec conscience." }
  ],
  munajat: `Ya Rabb, je réalise que tout est enregistré. Fais que chaque action compte. Ne permets pas que je néglige les petites actions.`
};

MIROIR["9:122"] = {
  reference: "9:122",
  theme: ["savoir", "enseignement", "groupe"],
  emotion: "Responsabilité, apprentissage",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Ilm", "At-Ta'lim"],
  mirrorVersion: `« Pourquoi de chaque clan un groupe ne se forme-t-il pas pour étudier la religion et avertir leur peuple ? » Le miroir me montre le devoir d'apprentissage. « Li-yatafaqqahu fi al-din » — pour étudier la religion. L'apprentissage est un devoir communautaire. Le miroir m'interroge : est-ce que j'apprends ma religion pour l'enseigner ?`,
  reflection: `L'apprentissage de la religion est un devoir. L'enseignement aux autres est une obligation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-lawla nasara min kulli farqatin minhum ta'ifatun li-yatafaqqahu fi al-din wa li-yundhiru qawmahum » — pourquoi de chaque clan un groupe ne se forme-t-il pas pour étudier la religion et avertir leur peuple ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends ma religion pour l'enseigner ? Ou est-ce que je garde le savoir pour moi ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le savoir qui n'est pas partagé est perdu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transmission du savoir est vitale pour la communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend et enseigne est doublement récompensé." }
  ],
  munajat: `Ya Rabb, je veux apprendre ma religion pour l'enseigner. Ne permets pas que je garde le savoir pour moi. Donne-moi la capacité de transmettre.`
};

MIROIR["9:123"] = {
  reference: "9:123",
  theme: ["combat", "proximité", "force"],
  emotion: "Détermination, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jihad", "Al-Qital"],
  mirrorVersion: `« Ô vous qui croyez ! Combattez les mécréants qui sont près de vous. » Le miroir me montre la priorité du combat proche. « Alladhina yalunakum » — qui sont près de vous. Le combat commence par les ennemis les plus proches. Le miroir m'interroge : est-ce que je commence par le combat le plus proche ?`,
  reflection: `Le combat commence par le plus proche. La proximité détermine la priorité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu qatilu alladhina yalunakum min al-kuffari » — ô vous qui croyez ! Combattez les mécréants qui sont près de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je commence par le combat le plus proche ? Ou est-ce que je cherche le combat lointain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le proche a la priorité sur le lointain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La proximité détermine la responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat le proche protège le proche." }
  ],
  munajat: `Ya Rabb, aide-moi à combattre les ennemis les plus proches. Ne permets pas que je néglige le proche pour le lointain. Donne-moi la force de combattre là où je suis.`
};

MIROIR["9:124"] = {
  reference: "9:124",
  theme: ["révélation", "hypocrisie", "foi"],
  emotion: "Discernement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tanzil", "Al-Iman"],
  mirrorVersion: `« Quand une sourate est révélée, il en est parmi eux qui disent : Lequel de vous a vu sa foi augmenter ? » Le miroir me montre les réactions à la révélation. « Ayyukum zadat hadhihi imanahu » — lequel de vous a vu sa foi augmenter ? La révélation augmente la foi des croyants. Le miroir m'interroge : est-ce que la révélation augmente ma foi ?`,
  reflection: `La révélation augmente la foi des croyants et l'hypocrisie des hypocrites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ma unzilat suratun fa-minhum man yaqulu ayyukum zadat hadhihi imanahu » — quand une sourate est révélée, il en est parmi eux qui disent : Lequel de vous a vu sa foi augmenter ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que la révélation augmente ma foi ? Ou est-ce que je reste indifférent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation est un test de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est une lumière pour ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont la foi augmente par la révélation est vraiment croyant." }
  ],
  munajat: `Ya Rabb, fais que la révélation augmente ma foi. Ne permets pas que je reste indifférent. Donne-moi un cœur qui grandit avec Ta parole.`
};

MIROIR["9:125"] = {
  reference: "9:125",
  theme: ["révélation", "hypocrisie", "souillure"],
  emotion: "Mise en garde, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["An-Najas", "Al-Qalb"],
  mirrorVersion: `« Quant à ceux qui ont une maladie dans leurs cœurs, elle ajoute une souillure à leur souillure. » Le miroir me montre l'effet sur les cœurs malades. « Zadathum rijsan ila rijsihim » — elle ajoute une souillure à leur souillure. La révélation aggrave l'état des hypocrites. Le miroir m'interroge : comment la révélation affecte-t-elle mon cœur ?`,
  reflection: `La révélation purifie les cœurs purs et aggrave les cœurs malades.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma alladhina fi qulubihim maradun fa-zadathum rijsan ila rijsihim » — quant à ceux qui ont une maladie dans leurs cœurs, elle ajoute une souillure à leur souillure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment la révélation affecte-t-elle mon cœur ? Est-ce que je suis purifié ou aggravé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation révèle l'état du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le même soleil durcit l'argile et ramollit la cire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est pur est purifié par la révélation." }
  ],
  munajat: `Ya Rabb, purifie mon cœur. Ne permets pas que la révélation m'aggrave. Fais que je sois du côté de ceux qui sont purifiés.`
};

MIROIR["9:126"] = {
  reference: "9:126",
  theme: ["épreuve", "fréquence", "hypocrisie"],
  emotion: "Lucidité, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fitna", "Al-Sanah"],
  mirrorVersion: `« Ne voient-ils pas qu'ils sont éprouvés une ou deux fois par an ? » Le miroir me montre les épreuves régulières. « Yuftanuna fi kulli 'amin marrah » — éprouvés une ou deux fois par an. Les épreuves sont régulières, pas exceptionnelles. Le miroir m'interroge : est-ce que je réalise que les épreuves sont régulières ?`,
  reflection: `Les épreuves sont régulières dans la vie du croyant. Elles sont un test constant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yaraw annahum yuftanuna fi kulli 'amin marrah aw marratayni » — ne voient-ils pas qu'ils sont éprouvés une ou deux fois par an ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que les épreuves sont régulières ? Comment je les affronte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve régulière est une constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve est la loi de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare l'épreuve n'est pas surpris." }
  ],
  munajat: `Ya Rabb, je réalise que les épreuves sont régulières. Prépare-moi à les affronter. Ne permets pas que je sois surpris par l'épreuve.`
};

MIROIR["9:127"] = {
  reference: "9:127",
  theme: ["révélation", "détournement", "hypocrisie"],
  emotion: "Mise en garde, tristesse",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tanzil", "Al-Ra's"],
  mirrorVersion: `« Et quand une sourate est révélée, ils se regardent les uns les autres : Quelqu'un vous regarde-t-il ? Puis ils se détournent. » Le miroir me montre le détournement hypocrite. « Yandurū ba'duhum ila ba'd » — ils se regardent les uns les autres. L'hypocrite se détourne de la révélation. Le miroir m'interroge : est-ce que je me détourne de la révélation ?`,
  reflection: `L'hypocrite se détourne de la révélation. Le croyant l'écoute et l'applique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ma unzilat suratun nazarū ba'duhum ila ba'd hal yarākum min ahadin thumma insarafū » — et quand une sourate est révélée, ils se regardent les uns les autres : Quelqu'un vous regarde-t-il ? Puis ils se détournent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me détourne de la révélation ? Ou est-ce que je l'écoute avec attention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement révèle l'hypocrisie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation demande une réponse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute la révélation avec attention est croyant." }
  ],
  munajat: `Ya Rabb, je veux écouter Ta révélation avec attention. Ne permets pas que je me détourne. Donne-moi un cœur qui répond à Ta parole.`
};

MIROIR["9:129"] = {
  reference: "9:129",
  theme: ["suffisance", "allié", "confiance"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Kafi"],
  mirrorVersion: `« Si donc ils se détournent, dis : Allah me suffit. Il n'y a de divinité que Lui. En Lui je me confie. » Le miroir me montre la réponse au détournement. « Hasbiya Allahu » — Allah me suffit. Quand les autres se détournent, Allah suffit. Le miroir m'interroge : est-ce qu'Allah me suffit quand les autres se détournent ?`,
  reflection: `Allah suffit quand les autres se détournent. La confiance en Lui est le refuge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in tawallaw fa-qul hasbiya Allahu la ilaha illa huwa 'alayhi tawakkaltu » — si donc ils se détournent, dis : Allah me suffit. Il n'y a de divinité que Lui. En Lui je me confie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'Allah me suffit quand les autres se détournent ? Ou est-ce que je cherche le soutien des hommes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement des hommes révèle la suffisance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le seul soutien éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui pour qui Allah suffit n'a besoin de personne d'autre." }
  ],
  munajat: `Ya Wakil, Tu me suffis. Quand les autres se détournent, je me confie en Toi. Fais que Ta suffisance soit ma seule richesse.`
};

// ==================== SURAH 10: YUNUS - COMPLETE COVERAGE ====================

MIROIR["10:1"] = {
  reference: "10:1",
  theme: ["révélation", "sagesse", "livre"],
  emotion: "Révérence, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Hikmah"],
  mirrorVersion: `« Alif, Lam, Ra. Voici les versets du Livre rempli de sagesse. » Le miroir me montre l'introduction au Livre. « Tilka ayatu al-kitabi al-hakimi » — voici les versets du Livre rempli de sagesse. Le Coran est un livre de sagesse. Le miroir m'interroge : est-ce que j'aborde le Coran comme un livre de sagesse ?`,
  reflection: `Le Coran est un livre de sagesse. L'approcher avec sagesse est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alif Lam Ra tilka ayatu al-kitabi al-hakimi » — Alif, Lam, Ra. Voici les versets du Livre rempli de sagesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aborde le Coran comme un livre de sagesse ? Ou est-ce que je le lis superficiellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse du Coran demande une approche sage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la sagesse divine pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui approche le Coran avec sagesse en tire la sagesse." }
  ],
  munajat: `Ya Hakim, Ton Livre est rempli de sagesse. Fais que je l'approche avec sagesse. Donne-moi de comprendre la sagesse de Tes versets.`
};

MIROIR["10:2"] = {
  reference: "10:2",
  theme: ["prophète", "merveille", "révélation"],
  emotion: "Émerveillement, guidance",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nabi", "Al-Wahy"],
  mirrorVersion: `« Est-ce étonnant pour les gens que Nous révélions à un homme d'entre eux ? » Le miroir me montre la réaction à la révélation. « A'ajiba al-nas » — est-ce étonnant pour les gens ? La révélation à un homme parmi eux semble étonnante. Le miroir m'interroge : est-ce que je m'étonne de la révélation ?`,
  reflection: `La révélation à un homme n'est pas étonnante pour le croyant. C'est la miséricorde d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'ajiba al-nasi an awhayna ila rajulin minhum » — est-ce étonnant pour les gens que Nous révélions à un homme d'entre eux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'étonne de la révélation ? Ou est-ce que je l'accepte comme miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement cache souvent le refus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la miséricorde d'Allah pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la révélation sans étonnement est vraiment croyant." }
  ],
  munajat: `Ya Rabb, j'accepte Ta révélation sans étonnement. Je la reçois comme Ta miséricorde. Fais que je ne doute pas de Ton message.`
};

MIROIR["10:3"] = {
  reference: "10:3",
  theme: ["création", "trône", "gestion"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-'Arsh"],
  mirrorVersion: `« Votre Seigneur est Allah qui a créé les cieux et la terre en six jours, puis S'est établi sur le Trône. » Le miroir me montre le Créateur. « Khalaqa al-samawati wa al-arda » — a créé les cieux et la terre. « Istawā 'ala al-'arsh » — S'est établi sur le Trône. Allah est le Créateur et le Gestionnaire. Le miroir m'interroge : est-ce que je reconnais Allah comme Créateur et Gestionnaire ?`,
  reflection: `Allah est le Créateur et le Gestionnaire de l'univers. Rien n'échappe à Sa gestion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbakumu Allahu alladhi khalaqa al-samawati wa al-arda fi sittati ayyamin thumma istawā 'ala al-'arsh » — votre Seigneur est Allah qui a créé les cieux et la terre en six jours, puis S'est établi sur le Trône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Allah comme Créateur et Gestionnaire ? Ou est-ce que j'attribue la gestion à d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création témoigne du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est géré par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît Allah comme Créateur et Gestionnaire est vraiment soumis." }
  ],
  munajat: `Ya Khaliq, Tu es le Créateur et le Gestionnaire. Je me soumets à Ta gestion. Ne permets pas que j'attribue Ta gestion à d'autres.`
};

MIROIR["10:4"] = {
  reference: "10:4",
  theme: ["retour", "promesse", "résurrection"],
  emotion: "Espérance, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'ad", "As-Sadiq"],
  mirrorVersion: `« Vers Lui est le retour de vous tous. La promesse d'Allah est vérité. » Le miroir me montre le retour certain. « Ilayhi marji'ukum » — vers Lui est le retour de vous tous. Le retour à Allah est certain. La promesse est vérité. Le miroir m'interroge : est-ce que je me prépare pour ce retour ?`,
  reflection: `Le retour à Allah est certain. La promesse de résurrection est vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ilayhi marji'ukum jami'an wa'da Allahi haqqa » — vers Lui est le retour de vous tous. La promesse d'Allah est vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour ce retour ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour est certain même quand on l'oublie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature retourne à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le retour le rencontre en paix." }
  ],
  munajat: `Ya Rabb, je me prépare pour mon retour vers Toi. Fais que je ne l'oublie pas. Donne-moi une bonne rencontre avec Toi.`
};

MIROIR["10:5"] = {
  reference: "10:5",
  theme: ["soleil", "lune", "calcul"],
  emotion: "Émerveillement, ordre",
  difficulty: "débutant",
  relatedNames: ["Ash-Shams", "Al-Qamar"],
  mirrorVersion: `« C'est Lui qui a fait du soleil une clarté et de la lune une lumière, et a déterminé ses phases pour que vous sachiez le nombre des années et le calcul. » Le miroir me montre l'ordre cosmique. « Ja'ala al-shamsa diya'an » — a fait du soleil une clarté. L'ordre cosmique est précis. Le miroir m'interroge : est-ce que je contemple l'ordre cosmique ?`,
  reflection: `L'ordre cosmique est précis. Le soleil et la lune servent au calcul et à l'organisation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi ja'ala al-shamsa diya'an wa al-qamara nuran wa qaddarahu manazila lita'lamu 'adada al-sinina wa al-hisab » — c'est Lui qui a fait du soleil une clarté et de la lune une lumière, et a déterminé ses phases pour que vous sachiez le nombre des années et le calcul." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'ordre cosmique ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre cosmique témoigne du Créateur ordonné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ordonné selon la sagesse d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'ordre cosmique connaît le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu as ordonné l'univers avec sagesse. Fais que je contemple Ton ordre. Donne-moi de Te connaître à travers Ta création.`
};

MIROIR["10:6"] = {
  reference: "10:6",
  theme: ["signes", "nuit", "jour"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Layl"],
  mirrorVersion: `« Dans l'alternance de la nuit et du jour, et dans ce qu'Allah a créé dans les cieux et la terre, il y a des signes pour des gens qui craignent. » Le miroir me montre les signes cosmiques. « Fi ikhtilafi al-layli wa al-nahar » — dans l'alternance de la nuit et du jour. Les signes sont partout. Le miroir m'interroge : est-ce que je vois les signes autour de moi ?`,
  reflection: `Les signes d'Allah sont partout. L'alternance du jour et de la nuit est un signe constant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fi ikhtilafi al-layli wa al-nahari wa ma khalaqa Allahu fi al-samawati wa al-ardi la-ayatin li-qawmin yattaqun » — dans l'alternance de la nuit et du jour, et dans ce qu'Allah a créé dans les cieux et la terre, il y a des signes pour des gens qui craignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les signes autour de moi ? Ou est-ce que je suis aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont visibles pour ceux qui craignent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah voit Ses signes partout." }
  ],
  munajat: `Ya Rabb, ouvre mes yeux sur Tes signes. Fais que je ne sois pas aveugle. Donne-moi de Te voir dans chaque aspect de la création.`
};

MIROIR["10:7"] = {
  reference: "10:7",
  theme: ["rencontre", "complaisance", "vie"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Liqa'", "Al-Ghurur"],
  mirrorVersion: `« Ceux qui n'espèrent pas Nous rencontrer et sont satisfaits de la vie présente. » Le miroir me montre l'aveuglement de la vie présente. « La yarjuna liqa'ana » — qui n'espèrent pas Nous rencontrer. L'espoir de la rencontre avec Allah manque. Le miroir m'interroge : est-ce que j'espère la rencontre avec Allah ?`,
  reflection: `L'espoir de la rencontre avec Allah manque à ceux qui sont satisfaits de cette vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina la yarjuna liqa'ana wa radiyu bi-al-hayati al-dunya » — ceux qui n'espèrent pas Nous rencontrer et sont satisfaits de la vie présente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la rencontre avec Allah ? Ou est-ce que je suis satisfait de cette vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction de cette vie aveugle sur l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Cette vie est passage, l'au-delà est destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la rencontre prépare sa rencontre." }
  ],
  munajat: `Ya Rabb, j'espère Te rencontrer. Ne permets pas que je sois satisfait de cette vie. Donne-moi l'espoir de Ta rencontre.`
};

MIROIR["10:8"] = {
  reference: "10:8",
  theme: ["enfer", "destination", "mécréance"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Ma'ad"],
  mirrorVersion: `« Ceux-là ont l'Enfer pour refuge, à cause de ce qu'ils ont acquis. » Le miroir me montre la destination des mécréants. « Ula'ika ma'wahumu al-nar » — ceux-là ont l'Enfer pour refuge. La destination est le résultat des actes. Le miroir m'interroge : quelle est ma destination selon mes actes ?`,
  reflection: `La destination est le résultat des actes. L'Enfer est le refuge des mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika ma'wahumu al-naru bima kanu yaksibun » — ceux-là ont l'Enfer pour refuge, à cause de ce qu'ils ont acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma destination selon mes actes ? Est-ce que je travaille pour le Paradis ou l'Enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les actes déterminent la destination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah donne à chacun selon ses actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le Paradis y entre." }
  ],
  munajat: `Ya Rabb, je veux le Paradis comme destination. Ne permets pas que mes actes me mènent à l'Enfer. Donne-moi des actes qui plaisent à Allah.`
};

MIROIR["10:9"] = {
  reference: "10:9",
  theme: ["foi", "guidance", "bonne œuvre"],
  emotion: "Espoir, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Hidayah"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, leur Seigneur les guidera grâce à leur foi. » Le miroir me montre la guidance par la foi. « Yahdīhim rabbuhum bi-imanihim » — leur Seigneur les guidera grâce à leur foi. La foi et les bonnes œuvres mènent à la guidance. Le miroir m'interroge : est-ce que j'ai la foi et les bonnes œuvres ?`,
  reflection: `La foi et les bonnes œuvres mènent à la guidance. Allah guide les croyants sincères.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa 'amilu al-salihati yahdīhim rabbuhum bi-imanihim » — ceux qui croient et font de bonnes œuvres, leur Seigneur les guidera grâce à leur foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai la foi et les bonnes œuvres ? Suis-je sur le chemin de la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans œuvre est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est le don d'Allah aux croyants sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi et fait de bonnes œuvres est guidé." }
  ],
  munajat: `Ya Hadi, guide-moi par ma foi. Donne-moi la foi sincère et les bonnes œuvres. Ne permets pas que je sois égaré.`
};

MIROIR["10:10"] = {
  reference: "10:10",
  theme: ["paradis", "invocation", "salam"],
  emotion: "Espérance, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "As-Salam"],
  mirrorVersion: `« Leur invocation y sera : Gloire à Toi, ô Allah ! Et leur salut : Paix ! » Le miroir me montre l'invocation paradisiaque. « Da'wahum fiha subhanaka Allahumma » — leur invocation sera : Gloire à Toi, ô Allah ! Le Paradis est un lieu de glorification et de paix. Le miroir m'interroge : quelle est mon invocation ici-bas ?`,
  reflection: `L'invocation du Paradis est la glorification. Le salut est la paix. Ici-bas, on prépare cette invocation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Da'wahum fiha subhanaka Allahumma wa tahiyyatuhum fiha salam » — leur invocation y sera : Gloire à Toi, ô Allah ! Et leur salut : Paix !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est mon invocation ici-bas ? Est-ce que je glorifie Allah comme les habitants du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation d'ici-bas prépare l'invocation du Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le lieu de la glorification éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah ici-bas Le glorifie au Paradis." }
  ],
  munajat: `Ya Subhan, je veux Te glorifier ici-bas comme au Paradis. Fais que mon invocation soit Ta glorification. Donne-moi la paix du Paradis.`
};

MIROIR["10:11"] = {
  reference: "10:11",
  theme: ["hâte", "justice", "mécréance"],
  emotion: "Lucidité, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Ajal", "Al-'Adl"],
  mirrorVersion: `« Si Allah hâtait le mal pour les hommes comme ils hâtent le bien... » Le miroir me montre l'impatience humaine. « Ka-ma yasta'jiluna bi-al-hasanati » — comme ils hâtent le bien. Les hommes sont impatients pour le bien mais Allah retarde le mal par miséricorde. Le miroir m'interroge : est-ce que j'ai de la patience ou est-ce que je hâte tout ?`,
  reflection: `Allah retarde le mal par miséricorde. L'impatience humaine ignore cette miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law yu'ajjilu Allahu li-al-nasi al-sharra isti'jalahum bi-al-khayri » — si Allah hâtait le mal pour les hommes comme ils hâtent le bien..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai de la patience ? Ou est-ce que je hâte tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retard du mal est miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est entre les mains d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a patience reçoit ce qui est bon au bon moment." }
  ],
  munajat: `Ya Rabb, donne-moi la patience. Ne permets pas que je hâte ce qui ne doit pas être hâté. Fais que j'accepte Ton timing parfait.`
};

MIROIR["10:13"] = {
  reference: "10:13",
  theme: ["histoire", "peuples", "mécréance"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Umam", "Al-'Adab"],
  mirrorVersion: `« Nous avons anéanti avant vous des générations qui avaient été injustes. » Le miroir me montre l'histoire des peuples. « Qad ahlakna al-qurūna min qablikum » — Nous avons anéanti les générations avant vous. L'injustice mène à la destruction. Le miroir m'interroge : est-ce que j'apprends de l'histoire des peuples ?`,
  reflection: `L'injustice mène à la destruction. Les peuples passés sont des exemples.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad ahlakna al-qurūna min qablikum lamma zalamu » — Nous avons anéanti avant vous des générations qui avaient été injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire des peuples ? Ou est-ce que je répète les erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice attire la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un enseignement pour ceux qui réfléchissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire évite la destruction." }
  ],
  munajat: `Ya Rabb, fais que j'apprenne de l'histoire des peuples. Ne permets pas que je sois injuste. Préserve-moi de la destruction des injustes.`
};

MIROIR["10:14"] = {
  reference: "10:14",
  theme: ["succession", "responsabilité", "vie"],
  emotion: "Responsabilité, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khilafah", "Al-Mas'uliyyah"],
  mirrorVersion: `« Puis Nous avons fait de vous leurs successeurs sur terre pour voir comment vous agiriez. » Le miroir me montre la responsabilité de la succession. « Ja'alnakum khala'ifa » — Nous avons fait de vous leurs successeurs. La succession sur terre est un test. Le miroir m'interroge : comment j'utilise ma succession sur terre ?`,
  reflection: `La succession sur terre est un test. Comment nous agissons détermine notre destin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ja'alnakum khala'ifa fi al-ardi min ba'dihim li-nanzura kayfa ta'malun » — puis Nous avons fait de vous leurs successeurs sur terre pour voir comment vous agiriez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise ma succession sur terre ? Mes actions sont-elles bonnes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La succession est un test, pas un privilège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un test pour ses habitants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit bien sur terre réussit le test." }
  ],
  munajat: `Ya Rabb, je suis successeur sur terre. Fais que j'agisse bien. Ne permets pas que je gaspille ma succession. Donne-moi de réussir le test.`
};

MIROIR["10:15"] = {
  reference: "10:15",
  theme: ["coran", "altération", "hypocrisie"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qur'an", "At-Tabdil"],
  mirrorVersion: `« Et quand Nos versets leur sont récités avec clarté, ceux qui n'espèrent pas Nous rencontrer disent : Apporte un autre Coran ou change-le. » Le miroir me montre le refus du Coran. « I'ti bi-Qur'anin ghayri hadha » — apporte un autre Coran. Le refus du Coran est clair. Le miroir m'interroge : est-ce que j'accepte le Coran tel qu'il est ?`,
  reflection: `Le Coran ne peut être changé. L'accepter tel qu'il est est la marque du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha tutla 'alayhim ayatuna bayyinatin qala alladhina la yarjuna liqa'ana i'ti bi-Qur'anin ghayri hadha aw baddilhu » — et quand Nos versets leur sont récités avec clarté, ceux qui n'espèrent pas Nous rencontrer disent : Apporte un autre Coran ou change-le." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le Coran tel qu'il est ? Ou est-ce que je veux le changer selon mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désir de changer le Coran révèle le refus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est parfait et inchangeable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le Coran tel qu'il est est vraiment soumis." }
  ],
  munajat: `Ya Rabb, j'accepte Ton Coran tel qu'il est. Ne permets pas que je veuille le changer. Donne-moi la soumission complète à Ta parole.`
};

MIROIR["10:16"] = {
  reference: "10:16",
  theme: ["prophète", "vérité", "témoin"],
  emotion: "Confiance, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nabi", "Ash-Shahid"],
  mirrorVersion: `« Dis : Si Allah avait voulu, je ne vous l'aurais pas récité et Il ne vous l'aurait pas fait connaître. » Le miroir me montre l'origine de la révélation. « Law sha'a Allahu ma talawtuhu 'alaykum » — si Allah avait voulu, je ne vous l'aurais pas récité. La révélation vient d'Allah. Le miroir m'interroge : est-ce que je reconnais l'origine divine du Coran ?`,
  reflection: `La révélation vient d'Allah. Le Prophète n'est que le transmetteur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul law sha'a Allahu ma talawtuhu 'alaykum wa la adrakum bihi » — dis : Si Allah avait voulu, je ne vous l'aurais pas récité et Il ne vous l'aurait pas fait connaître." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'origine divine du Coran ? Ou est-ce que je doute de sa source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'origine divine est la base de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la parole d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'origine divine du Coran est sur la vérité." }
  ],
  munajat: `Ya Rabb, je reconnais que le Coran vient de Toi. Fais que je n'en doute jamais. Donne-moi la certitude de Ton message.`
};

MIROIR["10:17"] = {
  reference: "10:17",
  theme: ["mensonge", "injustice", "châtiment"],
  emotion: "Mise en garde, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kadhib", "Al-Zulm"],
  mirrorVersion: `« Qui est plus injuste que celui qui forge un mensonge contre Allah ? » Le miroir me montre le plus grand crime. « Man azlamu mimmani iftara 'ala Allahi kadhiban » — qui est plus injuste que celui qui forge un mensonge contre Allah ? Le mensonge sur Allah est le plus grand crime. Le miroir m'interroge : est-ce que je préserve ma parole sur Allah ?`,
  reflection: `Le mensonge sur Allah est le plus grand crime. La préservation de la vérité sur Allah est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man azlamu mimmani iftara 'ala Allahi kadhiban aw kadhdhaba bi-ayatihi » — qui est plus injuste que celui qui forge un mensonge contre Allah ou traite Ses signes de mensonges ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve ma parole sur Allah ? Ou est-ce que je forge des mensonges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sur Allah attire le plus grand châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur Allah est sacrée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la vérité sur Allah est préservé." }
  ],
  munajat: `Ya Rabb, je préserve la vérité sur Toi. Ne permets pas que je forge des mensonges. Donne-moi la véracité sur Toi et Tes signes.`
};

MIROIR["10:18"] = {
  reference: "10:18",
  theme: ["idolâtrie", "intercession", "néant"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shirk", "Al-Shafa'ah"],
  mirrorVersion: `« Ils adorent au lieu d'Allah ce qui ne peut ni leur nuire ni leur profiter. » Le miroir me montre l'idolâtrie. « Ma la yadurruhum wa la yanfa'uhum » — ce qui ne peut ni leur nuire ni leur profiter. Les idoles sont impuissantes. Le miroir m'interroge : est-ce que j'adore ce qui peut réellement m'aider ?`,
  reflection: `Les idoles sont impuissantes. Seul Allah peut nuire et profiter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ya'buduna min duni Allahi ma la yadurruhum wa la yanfa'uhum » — ils adorent au lieu d'Allah ce qui ne peut ni leur nuire ni leur profiter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore ce qui peut réellement m'aider ? Ou est-ce que j'adore le néant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration du néant est néant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah a le pouvoir de nuire et de profiter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul adore le Puissant." }
  ],
  munajat: `Ya Rabb, je T'adore Toi seul. Ne permets pas que j'adore le néant. Donne-moi l'adoration sincère du Seul qui peut m'aider.`
};

MIROIR["10:19"] = {
  reference: "10:19",
  theme: ["humanité", "communauté", "désaccord"],
  emotion: "Réflexion, unité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nas", "Al-Ummah"],
  mirrorVersion: `« Les hommes ne formaient qu'une seule communauté, puis ils ont divergé. » Le miroir me montre l'unité originelle. « Kanu ummatan wahidatan » — étaient une seule communauté. L'humanité était unie, puis elle a divergé. Le miroir m'interroge : est-ce que je travaille pour l'unité ou pour la division ?`,
  reflection: `L'humanité était unie. La divergence est venue par le choix humain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana al-nasu illa ummatan wahidatan fa-khtalafu » — les hommes ne formaient qu'une seule communauté, puis ils ont divergé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille pour l'unité ? Ou est-ce que je participe à la division ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité est l'état naturel, la division est artificielle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité est la loi de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour l'unité participe à l'ordre divin." }
  ],
  munajat: `Ya Rabb, je veux travailler pour l'unité. Ne permets pas que je participe à la division. Donne-moi d'être unificateur.`
};

MIROIR["10:20"] = {
  reference: "10:20",
  theme: ["miracle", "signe", "demande"],
  emotion: "Lucidité, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'jizah", "Al-Ayah"],
  mirrorVersion: `« Ils disent : Pourquoi un signe ne lui est-il pas descendu de son Seigneur ? » Le miroir me montre la demande de miracles. « Lawla unzila 'alayhi ayatun » — pourquoi un signe ne lui est-il pas descendu ? La demande de miracles révèle le doute. Le miroir m'interroge : est-ce que je demande des signes ou est-ce que je crois ?`,
  reflection: `La demande de miracles révèle le doute. Le croyant croit sans demander de signes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna lawla unzila 'alayhi ayatun min rabbihi » — ils disent : Pourquoi un signe ne lui est-il pas descendu de son Seigneur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des signes ? Ou est-ce que je crois sans preuve supplémentaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de signes révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le plus grand signe est le Coran lui-même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sans demander de signes a la foi complète." }
  ],
  munajat: `Ya Rabb, je crois sans demander de signes. Donne-moi la foi qui n'a pas besoin de preuves supplémentaires. Renforce ma confiance en Toi.`
};

MIROIR["10:21"] = {
  reference: "10:21",
  theme: ["détresse", "miséricorde", "ingratitude"],
  emotion: "Lucidité, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Ad-Darr", "Ar-Rahman"],
  mirrorVersion: `« Quand Nous faisons goûter aux hommes une miséricorde après un malheur, voilà qu'ils usent de ruse contre Nos signes. » Le miroir me montre l'ingratitude après le soulagement. « Makaru » — ils usent de ruse. La miséricorde après le malheur devrait inciter à la gratitude, pas à la ruse. Le miroir m'interroge : comment je réagis après le soulagement ?`,
  reflection: `Le soulagement après le malheur devrait inciter à la gratitude, pas à la ruse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha adhaqna al-nasa rahmatan min ba'di darra'a massathum idha lahum makrun fi ayatina » — quand Nous faisons goûter aux hommes une miséricorde après un malheur, voilà qu'ils usent de ruse contre Nos signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis après le soulagement ? Avec gratitude ou avec ruse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude après le soulagement est la bonne réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soulagement est une miséricorde qui demande reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant après le soulagement est béni." }
  ],
  munajat: `Ya Rahman, après le malheur, je suis reconnaissant. Ne permets pas que j'use de ruse contre Tes signes. Donne-moi la gratitude constante.`
};

MIROIR["10:22"] = {
  reference: "10:22",
  theme: ["mer", "tempête", "invocation"],
  emotion: "Humble, sincérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bahr", "Ad-Du'a"],
  mirrorVersion: `« C'est Lui qui vous fait voyager sur terre et sur mer. Quand vous êtes sur les navires... vous invoquez Allah avec sincérité. » Le miroir me montre l'invocation dans la tempête. « Da'awtu Allahi mukhlisina lahu al-din » — vous invoquez Allah avec sincérité. La tempête révèle la sincérité de l'invocation. Le miroir m'interroge : est-ce que j'invoque avec la même sincérité dans le calme ?`,
  reflection: `La tempête révèle la sincérité. Dans le calme, l'invocation devrait être tout aussi sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi yusayyirukum fi al-barri wa al-bahr... da'awtumu Allaha mukhlisina lahu al-din » — c'est Lui qui vous fait voyager sur terre et sur mer... vous invoquez Allah avec sincérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque avec la même sincérité dans le calme ? Ou est-ce que je suis hypocrite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité dans la tempête devrait durer dans le calme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mer est le lieu de l'invocation sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque sincèrement dans le calme comme dans la tempête est vraiment croyant." }
  ],
  munajat: `Ya Rabb, je veux T'invoquer avec sincérité dans le calme comme dans la tempête. Ne permets pas que je sois hypocrite. Donne-moi l'invocation sincère constante.`
};

MIROIR["10:23"] = {
  reference: "10:23",
  theme: ["salut", "ingratitude", "agression"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["An-Najat", "Al-Baghy"],
  mirrorVersion: `« Puis quand Il vous a sauvés, voilà que vous vous livrez à l'agression sur la terre sans droit. » Le miroir me montre l'ingratitude après le salut. « Ta'thawna fi al-ardi baghyan » — vous vous livrez à l'agression sur la terre. Le salut devrait humilier, pas enorgueillir. Le miroir m'interroge : comment je réagis après le salut ?`,
  reflection: `Le salut devrait humilier et rendre reconnaissant, pas enorgueillir et agresser.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma anjakakum idha antum ta'thawna fi al-ardi baghyan » — puis quand Il vous a sauvés, voilà que vous vous livrez à l'agression sur la terre sans droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis après le salut ? Avec reconnaissance ou avec arrogance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le salut est un don qui demande reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ingratitude après le salut est un péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant après le salut préserve la bénédiction." }
  ],
  munajat: `Ya Rabb, après le salut, je suis reconnaissant. Ne permets pas que je devienne arrogant. Fais que le salut m'humilie et me rende reconnaissant.`
};

MIROIR["10:24"] = {
  reference: "10:24",
  theme: ["parabole", "monde", "fin"],
  emotion: "Lucidité, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Ad-Dunya", "Al-Mathal"],
  mirrorVersion: `« La vie présente est comparable à une eau que Nous faisons descendre du ciel. » Le miroir me montre la parabole de la vie. « Mathalu al-hayati al-dunya » — la parabole de la vie présente. La vie est comme l'eau qui fait pousser puis se flétrit. Le miroir m'interroge : est-ce que je comprends la nature passagère de cette vie ?`,
  reflection: `La vie présente est passagère comme les plantes qui poussent puis se flétrissent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama mathalu al-hayati al-dunya ka-ma'in anzalnahu min al-sama'i » — la vie présente est comparable à une eau que Nous faisons descendre du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la nature passagère de cette vie ? Ou est-ce que je m'y attache comme si elle était éternelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie passagère demande le détachement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est passager sauf Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la nature passagère de la vie s'y attache correctement." }
  ],
  munajat: `Ya Rabb, je comprends que cette vie est passagère. Ne permets pas que je m'y attache comme si elle était éternelle. Donne-moi le détachement juste.`
};

MIROIR["10:25"] = {
  reference: "10:25",
  theme: ["paix", "maison", "invitation"],
  emotion: "Espérance, guidance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Dar as-Salam"],
  mirrorVersion: `« Allah appelle à la Demeure de la paix et guide qui Il veut vers un chemin droit. » Le miroir me montre l'invitation divine. « Allahu yad'u ila dar al-salam » — Allah appelle à la Demeure de la paix. La destination finale est la paix. Le miroir m'interroge : est-ce que je réponds à l'invitation d'Allah ?`,
  reflection: `Allah appelle à la Demeure de la paix. Répondre à cette invitation est le chemin droit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu yad'u ila dar al-salam wa yahdī man yasha'u ila siratin mustaqim » — Allah appelle à la Demeure de la paix et guide qui Il veut vers un chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réponds à l'invitation d'Allah ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invitation d'Allah demande une réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Demeure de la paix est la destination de tous les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'invitation entre dans la Demeure de la paix." }
  ],
  munajat: `Ya Salam, Tu m'appelles à Ta Demeure de paix. Je réponds à Ton invitation. Guide-moi vers le chemin droit qui y mène.`
};

MIROIR["10:26"] = {
  reference: "10:26",
  theme: ["récompense", "beauté", "paradis"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Husna", "Al-Jannah"],
  mirrorVersion: `« Pour ceux qui font le bien, la meilleure récompense et encore plus. » Le miroir me montre la récompense excellente. « Li-alladhina ahsanu al-husna wa ziyadah » — pour ceux qui font le bien, la meilleure récompense et encore plus. La récompense dépasse l'espérance. Le miroir m'interroge : est-ce que je fais le bien pour cette récompense excellente ?`,
  reflection: `La récompense pour le bien dépasse l'espérance. Allah donne plus que mérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-alladhina ahsanu al-husna wa ziyadah » — pour ceux qui font le bien, la meilleure récompense et encore plus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais le bien pour cette récompense excellente ? Ou est-ce que je néglige le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense d'Allah dépasse toujours l'espérance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien est toujours récompensé au-delà du mérite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien reçoit plus qu'il ne mérite." }
  ],
  munajat: `Ya Rabb, je veux faire le bien pour Ta récompense excellente. Ne permets pas que je néglige le bien. Donne-moi d'être parmi ceux qui font le bien.`
};

MIROIR["10:27"] = {
  reference: "10:27",
  theme: ["châtiment", "justice", "mécréance"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "An-Nar"],
  mirrorVersion: `« Ceux qui ont commis les mauvaises actions, la rétribution d'une mauvaise action sera équivalente. » Le miroir me montre la justice du châtiment. « Jaza'u sayyi'atin sayyi'atin mithluha » — la rétribution d'une mauvaise action sera équivalente. La justice est parfaite. Le miroir m'interroge : est-ce que je crains la rétribution de mes mauvaises actions ?`,
  reflection: `La rétribution est équivalente à l'action. La justice d'Allah est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kasabu al-sayyi'ati jaza'u sayyi'atin mithluha » — ceux qui ont commis les mauvaises actions, la rétribution d'une mauvaise action sera équivalente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la rétribution de mes mauvaises actions ? Ou est-ce que je me sens en sécurité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice parfaite d'Allah effraie les pécheurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a une rétribution équivalente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la rétribution évite les mauvaises actions." }
  ],
  munajat: `Ya 'Adl, Ta justice est parfaite. Je crains la rétribution de mes mauvaises actions. Donne-moi de les éviter et de me repentir.`
};

MIROIR["10:28"] = {
  reference: "10:28",
  theme: ["rassemblement", "témoin", "idole"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hashr", "Ash-Shahid"],
  mirrorVersion: `« Le jour où Nous les rassemblerons tous, puis dirons aux idolâtres : À vos places, vous et vos associés ! » Le miroir me montre le rassemblement du Jugement. « Nahshuruhum jami'an » — Nous les rassemblerons tous. Le rassemblement révélera la vérité. Le miroir m'interroge : suis-je prêt pour ce rassemblement ?`,
  reflection: `Le rassemblement du Jugement révélera la vérité. Les idoles se désavoueront de leurs adorateurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma nahshuruhum jami'an thumma naqulu li-alladhina ashraku makanahum wa shuraka'ukum » — le jour où Nous les rassemblerons tous, puis dirons aux idolâtres : À vos places, vous et vos associés !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ce rassemblement ? Que révélera-t-il sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement révélera ce qui était caché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rassemblement est une certitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour le rassemblement le rencontre en paix." }
  ],
  munajat: `Ya Rabb, je me prépare pour le rassemblement. Fais que je sois du côté des croyants, pas des idolâtres. Ne permets pas que je sois désavoué par ce que j'adore.`
};

MIROIR["10:29"] = {
  reference: "10:29",
  theme: ["témoin", "désaveu", "idole"],
  emotion: "Vérité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-Bara'ah"],
  mirrorVersion: `« Allah suffit comme témoin entre nous et vous. Nous ne prestions aucune attention à votre adoration. » Le miroir me montre le désaveu des idoles. « Ma kunna 'an 'ibadatikum laghifina » — nous ne prestions aucune attention à votre adoration. Les idoles se désavouent. Le miroir m'interroge : est-ce que j'adore ce qui peut témoigner pour moi ?`,
  reflection: `Les idoles se désavouent de leurs adorateurs. Seul Allah peut témoigner pour le croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fakafa bi-Allahi shahidan baynana wa baynakum in kunna 'an 'ibadatikum laghifina » — Allah suffit comme témoin entre nous et vous. Nous ne prestions aucune attention à votre adoration." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore ce qui peut témoigner pour moi ? Ou est-ce que j'adore le néant qui se désavouera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désaveu des idoles révèle la vanité de l'idolâtrie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah est le témoin qui peut sauver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah a un témoin qui peut le sauver." }
  ],
  munajat: `Ya Shahid, sois mon témoin au Jour du Jugement. Ne permets pas que j'adore ce qui se désavouera de moi. Fais que Tu sois mon seul témoin.`
};

MIROIR["10:30"] = {
  reference: "10:30",
  theme: ["épreuve", "créateur", "retour"],
  emotion: "Révélation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Fitrah", "Al-Khaliq"],
  mirrorVersion: `« Là, chaque âme sera éprouvée sur ce qu'elle a fait auparavant. » Le miroir me montre l'épreuve du Jugement. « Tubla kullu nafsin » — chaque âme sera éprouvée. Le retour à Allah est le moment de l'épreuve. Le miroir m'interroge : comment je passerai cette épreuve ?`,
  reflection: `Chaque âme sera éprouvée sur ses actions. Le retour à Allah est le moment de vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hunalika tubla kullu nafsin mā qaddamat » — là, chaque âme sera éprouvée sur ce qu'elle a fait auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je passerai cette épreuve ? Mes actions seront-elles bonnes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve révélera la vérité de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve du Jugement est inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son épreuve la passe avec succès." }
  ],
  munajat: `Ya Rabb, je prépare mon épreuve. Fais que mes actions soient bonnes. Ne permets pas que je sois pris au dépourvu. Donne-moi une épreuve réussie.`
};

MIROIR["10:31"] = {
  reference: "10:31",
  theme: ["provision", "création", "question"],
  emotion: "Réflexion, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Razzaq", "Al-Khaliq"],
  mirrorVersion: `« Dis : Qui vous attribue de la provision du ciel et de la terre ? » Le miroir me pose la question divine. « Man yarzuqukum » — qui vous attribue de la provision ? La question interroge sur la source. Le miroir m'interroge : est-ce que je reconnais la source de ma provision ?`,
  reflection: `La provision vient d'Allah. Reconnaître la source est la base de la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul man yarzuqukum min al-sama'i wa al-ardi » — dis : Qui vous attribue de la provision du ciel et de la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la source de ma provision ? Ou est-ce que je l'attribue à d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la source est gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute provision vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source reçoit plus." }
  ],
  munajat: `Ya Razzaq, Tu es la source de ma provision. Je Te reconnais comme mon Pourvoyeur. Ne permets pas que j'attribue ma provision à d'autres. Donne-moi la gratitude constante.`
};

MIROIR["10:32"] = {
  reference: "10:32",
  theme: ["vérité", "égarement", "choix"],
  emotion: "Lucidité, décision",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Tel est Allah, votre vrai Seigneur. Au-delà de la vérité, qu'y a-t-il donc que l'égarement ? » Le miroir me montre le contraste. « Fa-ana yusrafūn » — comment vous détournez-vous ? La vérité est claire, l'égarement est évident. Le miroir m'interroge : est-ce que je choisis la vérité ou l'égarement ?`,
  reflection: `La vérité et l'égarement sont clairement distincts. Le choix appartient à chacun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-dhalikumu Allahu rabbukumu al-haqq fa-madha ba'da al-haqq illa al-dalal » — tel est Allah, votre vrai Seigneur. Au-delà de la vérité, qu'y a-t-il donc que l'égarement ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis la vérité ou l'égarement ? Mon choix est-il clair ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix de la vérité est le choix de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité et l'égarement sont les deux chemins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la vérité est sur le chemin droit." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Je choisis la vérité, pas l'égarement. Ne permets pas que je me détourne de la vérité. Guide-moi sur le chemin droit.`
};

MIROIR["10:33"] = {
  reference: "10:33",
  theme: ["décret", "mécréance", "obstination"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qada", "Al-Hukm"],
  mirrorVersion: `« Ainsi s'est accomplie la parole de ton Seigneur sur ceux qui ont perversé : Ils ne croiront pas. » Le miroir me montre le décret sur les pervers. « Haqqat kalimatu rabbika » — s'est accomplie la parole de ton Seigneur. L'obstination dans la perversité mène au décret de mécréance. Le miroir m'interroge : est-ce que je m'obstine dans la perversité ?`,
  reflection: `L'obstination dans la perversité mène au décret de mécréance. Le repentir reste possible avant le décret.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika haqqat kalimatu rabbika 'ala alladhina fasqaw annahum la yu'minun » — ainsi s'est accomplie la parole de ton Seigneur sur ceux qui ont perversé : Ils ne croiront pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'obstine dans la perversité ? Ou est-ce que je me repens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obstination scelle le destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret d'Allah s'accomplit sur les obstinés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant le décret est sauvé." }
  ],
  munajat: `Ya Rabb, je me repens avant le décret. Ne permets pas que je m'obstine dans la perversité. Donne-moi le repentir qui sauve du décret.`
};

MIROIR["10:34"] = {
  reference: "10:34",
  theme: ["création", "répétition", "question"],
  emotion: "Réflexion, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Ba'th"],
  mirrorVersion: `« Dis : Parmi vos associés, qui commence la création puis la recommence ? » Le miroir me pose la question sur les associés. « Man yabda'u al-khalqa thumma yu'iduhu » — qui commence la création puis la recommence ? Seul Allah peut créer et recréer. Le miroir m'interroge : est-ce que je reconnais que seul Allah peut créer ?`,
  reflection: `Seul Allah peut créer et recréer. Les associés sont impuissants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul min 'inda shuraka'ikum man yabda'u al-khalqa thumma yu'iduhu » — dis : Parmi vos associés, qui commence la création puis la recommence ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que seul Allah peut créer ? Ou est-ce que j'attribue la création à d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création est le signe du Créateur unique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah crée et recrée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Créateur unique est sur la vérité." }
  ],
  munajat: `Ya Khaliq, Tu es le seul Créateur. Je reconnais que seul Tu peux créer et recréer. Ne permets pas que j'attribue la création à d'autres.`
};

// ==================== SURAH 56: AL-WAQI'AH - COMPLETION (56:63-56:96) ====================

MIROIR["56:63"] = {
  reference: "56:63",
  theme: ["semailles", "création", "réflexion"],
  emotion: "Contemplation, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Razzaq"],
  mirrorVersion: `« Avez-vous considéré ce que vous semez ? » Le miroir me pose une question sur la semence. « A-ra'aytum ma tahruthun » — avez-vous considéré ce que vous semez ? La semence est petite mais porte la vie. Le miroir m'interroge : est-ce que je contemple les petites choses qui portent de grandes réalités ?`,
  reflection: `La semence est un miracle de création. De la petite graine sort la grande plante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-ra'aytum ma tahruthun » — avez-vous considéré ce que vous semez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les petites choses ? Est-ce que je vois le miracle dans la semence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La petite semence contient le grand arbre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie commence par une semence, visible ou invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la semence comprend le pouvoir du Créateur." }
  ],
  munajat: `Ya Khaliq, Tu crées du petit le grand. Fais que je contemple la semence et que je voie Ton pouvoir. Donne-moi la vision du miracle dans les petites choses.`
};

MIROIR["56:64"] = {
  reference: "56:64",
  theme: ["croissance", "créateur", "question"],
  emotion: "Interrogation, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Est-ce vous qui la faites pousser, ou est-ce Nous le Faiseur ? » Le miroir me pose la question cruciale. « A-antum tazra'unahu am nahnu al-zari'un » — est-ce vous qui semez ou est-ce Nous ? La croissance n'est pas l'œuvre de l'homme mais d'Allah. Le miroir m'interroge : à qui j'attribue la croissance ?`,
  reflection: `L'homme sème mais Allah fait pousser. La croissance est un don divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-antum tazra'unahu am nahnu al-zari'un » — est-ce vous qui la faites pousser, ou est-ce Nous le Faiseur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui j'attribue la croissance dans ma vie ? Est-ce à moi ou à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je sème, mais Allah fait pousser. Ma part est petite, Sa part est grande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute croissance dans l'univers vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît que la croissance vient d'Allah ne s'enorgueillit pas." }
  ],
  munajat: `Ya Zari', Tu fais pousser ce que je sème. Je reconnais que la croissance vient de Toi. Ne permets pas que je m'attribue ce qui T'appartient.`
};

MIROIR["56:65"] = {
  reference: "56:65",
  theme: ["destruction", "pouvoir", "avertissement"],
  emotion: "Crainte, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Mumit"],
  mirrorVersion: `« Si Nous voulions, Nous en ferions du déchet, et vous resteriez étonnés. » Le miroir me montre le pouvoir de destruction. « Law nasha'u la-ja'alnahu hutaman » — si Nous voulions, Nous en ferions du déchet. La récolte peut être détruite. Le miroir m'interroge : est-ce que je reconnais que ma récolte est fragile ?`,
  reflection: `La récolte est un don fragile. Allah peut la détruire en un instant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law nasha'u la-ja'alnahu hutaman fa-ziltum ta'jakun » — si Nous voulions, Nous en ferions du déchet, et vous resteriez étonnés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que ma récolte est fragile ? Que tout peut disparaître en un instant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fragilité de la récolte appelle à la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est garanti dans la création. Tout est don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la fragilité est reconnaissant." }
  ],
  munajat: `Ya Qadir, Tu peux détruire ma récolte en un instant. Fais que je sois reconnaissant pour ce que j'ai. Ne permets pas que je prenne pour acquis ce qui est un don.`
};

MIROIR["56:66"] = {
  reference: "56:66",
  theme: ["regret", "perte", "réalité"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Mani'", "Al-Hafiz"],
  mirrorVersion: `« Et vous diriez : Nous sommes accablés de pertes. » Le miroir me montre la réaction à la perte. « Innahu la-mughramun » — nous sommes accablés de pertes. La perte révèle la valeur de ce qu'on avait. Le miroir m'interroge : est-ce que je valorise ce que j'ai avant de le perdre ?`,
  reflection: `La perte révèle la valeur. Le regret vient après, quand il est trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Taquluna inna la-mughramun » — et vous diriez : Nous sommes accablés de pertes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je valorise ce que j'ai ? Ou est-ce que j'attends la perte pour comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude avant la perte évite le regret après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perte est la grande enseignante de la valeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant n'a pas de regrets." }
  ],
  munajat: `Ya Hafiz, garde-moi du regret. Fais que je sois reconnaissant avant de perdre. Ne permets pas que j'apprenne la valeur par la perte.`
};

MIROIR["56:67"] = {
  reference: "56:67",
  theme: ["privation", "réalité", "conséquence"],
  emotion: "Frustration, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Mani'"],
  mirrorVersion: `« Ou nous sommes privés. » Le miroir me montre l'alternative : la privation. « Bal nahnu mahrumun » — ou nous sommes privés. La privation totale est possible. Le miroir m'interroge : est-ce que je réalise que je pourrais tout perdre ?`,
  reflection: `La privation est le contraire de l'abondance. Elle peut toucher n'importe qui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal nahnu mahrumun » — ou nous sommes privés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je pourrais tout perdre ? Que la privation est possible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La privation révèle la valeur de l'abondance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'abondance et la privation sont entre les mains d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la possibilité de la privation est libre." }
  ],
  munajat: `Ya Razzaq, Tu donnes et Tu retiens. Fais que je sois reconnaissant dans l'abondance et patient dans la privation. Donne-moi la sagesse de l'acceptation.`
};

MIROIR["56:68"] = {
  reference: "56:68",
  theme: ["eau", "création", "question"],
  emotion: "Contemplation, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Muhyi"],
  mirrorVersion: `« Avez-vous considéré l'eau que vous buvez ? » Le miroir me pose la question sur l'eau. « A-ra'aytumu al-maa'alladhi tashrabun » — avez-vous considéré l'eau que vous buvez ? L'eau est essentielle, vitale, mais souvent oubliée. Le miroir m'interroge : est-ce que je contemple l'eau comme un miracle ?`,
  reflection: `L'eau est la source de vie. Sans elle, nulle existence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-ra'aytumu al-maa'alladhi tashrabun » — avez-vous considéré l'eau que vous buvez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'eau comme un miracle ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau la plus simple est le plus grand miracle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est le socle de toute vie dans l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'eau contemple la vie elle-même." }
  ],
  munajat: `Ya Muhyi, l'eau est Ta création. Fais que je la contemple avec émerveillement. Ne permets pas que je l'oublie ou que je la gâche.`
};

MIROIR["56:69"] = {
  reference: "56:69",
  theme: ["pluie", "créateur", "source"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Munazzil", "Al-Razzaq"],
  mirrorVersion: `« Est-ce vous qui la faites descendre des nuages, ou est-ce Nous qui la faisons descendre ? » Le miroir me demande qui envoie la pluie. « A-antum anzaltumuhu min al-muzni am nahnu al-munzilun » — est-ce vous qui la faites descendre ou est-ce Nous ? La pluie vient du ciel par le commandement d'Allah. Le miroir m'interroge : est-ce que je reconnais la source ?`,
  reflection: `La pluie est un don du ciel. L'homme ne peut pas la contrôler.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-antum anzaltumuhu min al-muzni am nahnu al-munzilun » — est-ce vous qui la faites descendre des nuages, ou est-ce Nous qui la faisons descendre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que la pluie vient d'Allah ? Que je ne peux pas la contrôler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pluie vient d'en haut, pas d'en bas. Le don précède la demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de l'eau est un miracle continu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source est comblé." }
  ],
  munajat: `Ya Munazzil, Tu fais descendre la pluie. Je reconnais que Tu es la source. Ne permets pas que j'oublie d'où vient l'eau de ma vie.`
};

MIROIR["56:70"] = {
  reference: "56:70",
  theme: ["purification", "châtiment", "choix"],
  emotion: "Crainte, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Tahur", "Al-Qadir"],
  mirrorVersion: `« Si Nous voulions, Nous la rendrions salée. Pourquoi n'êtes-vous donc pas reconnaissants ? » Le miroir me montre l'alternative. « Law nasha'u ja'alnahu ujajan » — si Nous voulions, Nous la rendrions salée. L'eau douce est un choix d'Allah. Le miroir m'interroge : pourquoi ne suis-je pas reconnaissant ?`,
  reflection: `L'eau douce est un miracle. Elle pourrait être salée. La gratitude est la réponse naturelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law nasha'u ja'alnahu ujajan fa-lawla tashkurun » — si Nous voulions, Nous la rendrions salée. Pourquoi n'êtes-vous donc pas reconnaissants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pourquoi ne suis-je pas reconnaissant ? Est-ce que je prends l'eau douce pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau salée est la norme océanique. L'eau douce est l'exception miraculeuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La plupart de l'eau sur terre est salée. L'eau douce est un don précieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour l'eau reçoit plus de bénédictions." }
  ],
  munajat: `Ya Tahur, Tu purifies l'eau pour moi. Je suis reconnaissant pour l'eau douce. Ne permets pas que je l'oublie ou que je sois ingrat.`
};

MIROIR["56:71"] = {
  reference: "56:71",
  theme: ["feu", "création", "question"],
  emotion: "Contemplation, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Nur"],
  mirrorVersion: `« Avez-vous considéré le feu que vous allumez ? » Le miroir me pose la question sur le feu. « A-ra'aytumu al-nara allati turun » — avez-vous considéré le feu que vous allumez ? Le feu est puissant, transformateur, mais il vient d'Allah. Le miroir m'interroge : est-ce que je contemple le feu comme un miracle ?`,
  reflection: `Le feu est une force de la nature, un don d'Allah. Il transforme, purifie, éclaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-ra'aytumu al-nara allati turun » — avez-vous considéré le feu que vous allumez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple le feu comme un miracle ? Ou est-ce que je l'utilise sans pensée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu que j'allume vient d'Allah. Je ne crée pas, j'utilise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu est présent dans toute l'univers. Les étoiles sont des feux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple le feu contemple une puissance divine." }
  ],
  munajat: `Ya Khaliq, le feu est Ta création. Fais que je le contemple avec respect. Ne permets pas que je l'utilise sans reconnaissance.`
};

MIROIR["56:72"] = {
  reference: "56:72",
  theme: ["arbre", "créateur", "origine"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mubdi'"],
  mirrorVersion: `« Est-ce vous qui avez créé son arbre, ou est-ce Nous le Créateur ? » Le miroir me demande qui a créé l'arbre du feu. « A-antum ansha'tum shajarataha am nahnu al-munshi'un » — est-ce vous qui avez créé son arbre ou est-ce Nous ? L'arbre qui donne le feu est une création d'Allah. Le miroir m'interroge : est-ce que je reconnais le Créateur derrière le bois ?`,
  reflection: `L'arbre qui brûle est un don d'Allah. Le feu vient de Sa création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-antum ansha'tum shajarataha am nahnu al-munshi'un » — est-ce vous qui avez créé son arbre, ou est-ce Nous le Créateur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le Créateur derrière le bois qui brûle ? Derrière tout ce que j'utilise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bois est créé par Allah, pas par moi. Je brûle ce qu'Il a créé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout arbre dans l'univers est une création divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le Créateur dans le bois brûlant Le voit partout." }
  ],
  munajat: `Ya Munshi', Tu as créé l'arbre qui brûle. Je reconnais que Tu es le Créateur de tout. Ne permets pas que j'utilise Ta création sans reconnaissance.`
};

MIROIR["56:73"] = {
  reference: "56:73",
  theme: ["rappel", "bénéfice", "guidance"],
  emotion: "Gratitude, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Nafi'"],
  mirrorVersion: `« Nous en avons fait un rappel et un bienfait pour le voyageur du désert. » Le miroir me montre le but du feu. « Ja'alnaha tadhkiratan wa mata'an lil-muqwin » — Nous en avons fait un rappel et un bienfait. Le feu rappelle l'enfer et profite au voyageur. Le miroir m'interroge : est-ce que je vois le sens spirituel dans les éléments ?`,
  reflection: `Le feu a deux fonctions : rappeler (l'enfer) et profiter (le voyageur). Chaque création a un sens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ja'alnaha tadhkiratan wa mata'an lil-muqwin » — Nous en avons fait un rappel et un bienfait pour le voyageur du désert." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le sens spirituel dans le feu ? Le rappel de l'enfer et le bienfait pour l'homme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu qui réchauffe rappelle aussi le feu qui punition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création a un double sens : utilité et rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le sens dans la création approfondit sa foi." }
  ],
  munajat: `Ya Hadi, le feu me rappelle Ton pouvoir. Fais que je voie le sens dans chaque élément. Ne permets pas que j'oublie le rappel dans le bienfait.`
};

MIROIR["56:74"] = {
  reference: "56:74",
  theme: ["gloire", "nom", "adoration"],
  emotion: "Révérence, louange",
  difficulty: "débutant",
  relatedNames: ["Al-'Azim", "Al-Kabir"],
  mirrorVersion: `« Glorifie donc le nom de ton Seigneur, le Très Grand. » Le miroir m'appelle à la glorification. « Fa-sabbih bi-ismi rabbika al-'azim » — glorifie le nom de ton Seigneur, le Très Grand. La réponse à tous les bienfaits est la glorification. Le miroir m'interroge : est-ce que je glorifie le nom d'Allah ?`,
  reflection: `La glorification est la réponse naturelle à la grandeur d'Allah. Son nom est Très Grand.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sabbih bi-ismi rabbika al-'azim » — glorifie donc le nom de ton Seigneur, le Très Grand." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie le nom d'Allah ? Est-ce que je reconnais Sa grandeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur d'Allah me relativise. Je suis petit devant Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers glorifie Allah. L'homme est invité à s'y joindre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie le nom d'Allah est élevé." }
  ],
  munajat: `Ya 'Azim, Tu es le Très Grand. Je glorifie Ton nom. Élève-moi par la glorification. Ne permets pas que j'oublie Ta grandeur.`
};

MIROIR["56:75"] = {
  reference: "56:75",
  theme: ["serment", "étoiles", "couchant"],
  emotion: "Solennité, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khaliq"],
  mirrorVersion: `« Non ! Je jure par le couchant des étoiles. » Le miroir me montre un serment solennel. « Fa-la uqsimu bi-mawaqi'i al-nujum » — Je jure par le couchant des étoiles. Allah jure par Sa création. Le miroir m'interroge : est-ce que je prends au sérieux les serments d'Allah ?`,
  reflection: `Allah jure par les étoiles qui se couchent. Le serment renforce la véracité du message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la uqsimu bi-mawaqi'i al-nujum » — Non ! Je jure par le couchant des étoiles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux les serments d'Allah ? Est-ce que je contemple les étoiles comme Il le fait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étoiles se couchent, mais la parole d'Allah reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les étoiles sont innombrables. Leur couchant est un spectacle cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le serment comprend la véracité." }
  ],
  munajat: `Ya Haqq, Tu jures par les étoiles. Je prends Ton serment au sérieux. Fais que je contemple les étoiles avec le même émerveillement.`
};

MIROIR["56:76"] = {
  reference: "56:76",
  theme: ["serment", "grandeur", "révérence"],
  emotion: "Awe, respect",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Azim", "Al-Kabir"],
  mirrorVersion: `« Et c'est vraiment un immense serment, si vous saviez. » Le miroir me montre la grandeur du serment. « Wa innahu la-qasamun 'azimun law ta'lamun 'azim » — c'est vraiment un immense serment, si vous saviez. La grandeur du serment dépasse la compréhension humaine. Le miroir m'interroge : est-ce que je réalise la grandeur de ce que dit Allah ?`,
  reflection: `Le serment d'Allah est immense. Sa grandeur dépasse notre compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innahu la-qasamun 'azimun law ta'lamun 'azim » — et c'est vraiment un immense serment, si vous saviez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur de ce que dit Allah ? Ou est-ce que je le lis comme des mots ordinaires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'immensité du serment reflète l'immensité du Serment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est témoin du serment d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la grandeur du serment est émerveillé." }
  ],
  munajat: `Ya 'Azim, Ton serment est immense. Fais que je réalise Sa grandeur. Ne permets pas que je prenne Ta parole à la légère.`
};

MIROIR["56:77"] = {
  reference: "56:77",
  theme: ["coran", "honneur", "révélation"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Hakim"],
  mirrorVersion: `« Que c'est un Coran noble. » Le miroir me montre la noblesse du Coran. « Innahu la-Qur'anun karim » — c'est un Coran noble. Le Coran est noble par son origine, son contenu, son but. Le miroir m'interroge : est-ce que je traite le Coran avec la noblesse qu'il mérite ?`,
  reflection: `Le Coran est le livre le plus noble. Sa noblesse demande respect et vénération.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu la-Qur'anun karim » — que c'est un Coran noble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite le Coran avec la noblesse qu'il mérite ? Ou est-ce que je le néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse du Coran élève celui qui le lit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la parole d'Allah, la plus noble des paroles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore le Coran est honoré." }
  ],
  munajat: `Ya Karim, le Coran est Ton livre noble. Fais que je l'honore et le vénère. Ne permets pas que je néglige la plus noble des révélations.`
};

MIROIR["56:78"] = {
  reference: "56:78",
  theme: ["table gardée", "protection", "éternité"],
  emotion: "Awe, sécurité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Muhit"],
  mirrorVersion: `« Dans un Livre bien gardé. » Le miroir me montre la protection du Coran. « Fi kitabin maknun » — dans un Livre bien gardé. Le Coran est conservé dans la Table gardée, protégé de toute altération. Le miroir m'interroge : est-ce que je fais confiance à la protection divine ?`,
  reflection: `Le Coran est protégé dans la Table gardée. Aucune altération ne peut l'atteindre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi kitabin maknun » — dans un Livre bien gardé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la protection divine du Coran ? Ou est-ce que je doute de son authenticité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection du Coran garantit sa transmission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Table gardée contient tout ce qui sera et a été." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la protection du Coran a confiance en son message." }
  ],
  munajat: `Ya Hafiz, Tu protèges le Coran. Je fais confiance à Ta protection. Fais que je vive selon ce Livre bien gardé.`
};

MIROIR["56:79"] = {
  reference: "56:79",
  theme: ["pureté", "toucher", "anges"],
  emotion: "Révérence, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Tahur", "Al-Mala'ika"],
  mirrorVersion: `« Que ne le touchent que les purifiés. » Le miroir me montre la pureté requise. « La yamassuhu illa al-mutahharun » — que ne le touchent que les purifiés. Le Coran exige la pureté de ceux qui le touchent. Le miroir m'interroge : est-ce que je suis pur quand j'approche le Coran ?`,
  reflection: `La pureté est requise pour toucher le Coran. La purification est une préparation spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yamassuhu illa al-mutahharun » — que ne le touchent que les purifiés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis pur quand j'approche le Coran ? Est-ce que je me purifie avant de le toucher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté extérieure reflète la pureté intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges, êtres purs, ont accès au Coran." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se purifie avant le Coran reçoit plus de lumière." }
  ],
  munajat: `Ya Tahur, Tu exiges la pureté. Purifie-moi avant que je touche Ton livre. Ne permets pas que je l'approche sans pureté.`
};

MIROIR["56:80"] = {
  reference: "56:80",
  theme: ["révélation", "seigneur", "univers"],
  emotion: "Gratitude, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Rabb", "Al-Wahhab"],
  mirrorVersion: `« Une révélation du Seigneur des mondes. » Le miroir me montre l'origine du Coran. « Tanzilun min rabbi al-'alamin » — une révélation du Seigneur des mondes. Le Coran vient du Seigneur de tout l'univers. Le miroir m'interroge : est-ce que je réalise la grandeur de celui qui l'a révélé ?`,
  reflection: `Le Coran vient du Seigneur des mondes. Sa source est la plus haute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzilun min rabbi al-'alamin » — une révélation du Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur de celui qui a révélé le Coran ? Que c'est le Seigneur de tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Seigneur des mondes me parle. Quel honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est pour tous les mondes, pas seulement les humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise l'origine du Coran est comblé." }
  ],
  munajat: `Ya Rabb al-'alamin, Tu as révélé le Coran. Je réalise que c'est le Seigneur des mondes qui me parle. Fais que je l'écoute avec révérence.`
};

MIROIR["56:81"] = {
  reference: "56:81",
  theme: ["mépris", "hadith", "question"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hakim"],
  mirrorVersion: `« Est-ce de ce Hadith que vous vous moquez ? » Le miroir me montre la mauvaise attitude. « A-fa-bi-hadha al-hadithi antum mudhinun » — est-ce de ce Hadith que vous vous moquez ? Se moquer du Coran est un grave péché. Le miroir m'interroge : est-ce que je prends le Coran au sérieux ?`,
  reflection: `Le Coran mérite le plus grand respect. S'en moquer est un égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-bi-hadha al-hadithi antum mudhinun » — est-ce de ce Hadith que vous vous moquez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends le Coran au sérieux ? Ou est-ce que je le traite avec légèreté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le message le plus sérieux de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le Coran reçoit son secret." }
  ],
  munajat: `Ya Haqq, je ne me moque pas du Coran. Je le prends au sérieux. Ne permets pas que je le traite avec légèreté.`
};

MIROIR["56:82"] = {
  reference: "56:82",
  theme: ["ingratitude", "négation", "réalité"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Shakur", "Al-Mannan"],
  mirrorVersion: `« Et faites de votre négation votre gagne-pain ? » Le miroir me montre l'ingratitude. « Wa taj'aluna rizqakum annakum tukadhdhibun » — et vous faites de votre négation votre gagne-pain ? La négation devient un mode de vie. Le miroir m'interroge : est-ce que ma vie est fondée sur la négation ou la reconnaissance ?`,
  reflection: `Nier les bienfaits d'Allah est une forme d'ingratitude. La reconnaissance est la voie droite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa taj'aluna rizqakum annakum tukadhdhibun » — et faites de votre négation votre gagne-pain ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie est fondée sur la négation ou la reconnaissance ? Est-ce que je nie les bienfaits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation du bienfait efface le bienfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ingratitude ferme la porte des bénédictions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les bienfaits reçoit plus." }
  ],
  munajat: `Ya Shakur, Tu aimes la reconnaissance. Je reconnais Tes bienfaits. Ne permets pas que je nie ce que Tu m'as donné.`
};

MIROIR["56:83"] = {
  reference: "56:83",
  theme: ["mort", "âme", "moment"],
  emotion: "Solennité, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Warith"],
  mirrorVersion: `« Pourquoi donc, quand l'âme du mourant monte vers la gorge ? » Le miroir me place au moment critique. « Fa-lawla idha balaghati al-hulqum » — pourquoi donc, quand l'âme monte vers la gorge ? Le moment de la mort est solennel. Le miroir m'interroge : est-ce que je suis prêt pour ce moment ?`,
  reflection: `L'âme qui monte vers la gorge est le signe de la mort imminente. Ce moment est inévitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-lawla idha balaghati al-hulqum » — pourquoi donc, quand l'âme du mourant monte vers la gorge ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour le moment où mon âme montera vers la gorge ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort vient à tous. La préparation est urgente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature vivante connaîtra ce moment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour la mort la rencontre en paix." }
  ],
  munajat: `Ya Mumit, l'âme monte vers la gorge au moment de la mort. Prépare-moi pour ce moment. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["56:84"] = {
  reference: "56:84",
  theme: ["regard", "mort", "témoins"],
  emotion: "Solennité, présence",
  difficulty: "débutant",
  relatedNames: ["Al-Shahid", "Al-Muhit"],
  mirrorVersion: `« Et que vous êtes là à regarder. » Le miroir me place comme témoin. « Wa antum hizna » — et vous êtes là à regarder. Les proches regardent le mourant. Le miroir m'interroge : est-ce que je réalise que je serai témoin de ce moment ?`,
  reflection: `Les proches sont témoins du moment de la mort. C'est un moment solennel et douloureux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa antum hizna » — et que vous êtes là à regarder." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je serai témoin de ce moment ? Que je verrai l'âme partir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regard des proches ne peut rien changer au décret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est publique pour les proches, intime pour le mourant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la mort des autres se prépare à la sienne." }
  ],
  munajat: `Ya Shahid, Tu es témoin de tout. Fais que je contemple la mort des autres pour me préparer à la mienne. Ne permets pas que je l'oublie.`
};

MIROIR["56:85"] = {
  reference: "56:85",
  theme: ["proximité", "âme", "merci"],
  emotion: "Intimité, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qarib", "Al-Muhit"],
  mirrorVersion: `« Nous sommes plus proche de lui que vous, mais vous ne voyez pas. » Le miroir me montre la proximité divine. « Nahnu aqrabu ilayhi minkum wa lakin la tubsirun » — Nous sommes plus proche de lui que vous, mais vous ne voyez pas. Allah est plus proche que les proches. Le miroir m'interroge : est-ce que je réalise Sa proximité ?`,
  reflection: `Allah est plus proche de l'âme que les proches. Sa proximité est invisible mais réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nahnu aqrabu ilayhi minkum wa lakin la tubsirun » — Nous sommes plus proche de lui que vous, mais vous ne voyez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise Sa proximité ? Que je ne suis jamais seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité divine est plus réelle que toute présence physique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est proche de chaque âme, vivante ou mourante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la proximité divine ne craint pas la mort." }
  ],
  munajat: `Ya Qarib, Tu es plus proche de moi que quiconque. Fais que je réalise Ta proximité. Ne permets pas que je me sente seul.`
};

MIROIR["56:86"] = {
  reference: "56:86",
  theme: ["vision", "royauté", "question"],
  emotion: "Interpellation, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Basir"],
  mirrorVersion: `« Pourquoi donc, si vous n'avez pas de compte à rendre, ne la faites-vous pas revenir, si vous êtes véridiques ? » Le miroir me lance le défi. « Fa-lawla in kuntum ghayri madinin tarji'unaha in kuntum sadiqin » — pourquoi donc, si vous n'avez pas de compte à rendre, ne la faites-vous pas revenir ? Le défi de ressusciter l'âme. Le miroir m'interroge : est-ce que je réalise mon impuissance ?`,
  reflection: `L'homme ne peut pas faire revenir l'âme. Seul Allah donne et reprend la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-lawla in kuntum ghayri madinin tarji'unaha in kuntum sadiqin » — pourquoi donc, si vous n'avez pas de compte à rendre, ne la faites-vous pas revenir, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise mon impuissance ? Que je ne peux ni donner ni reprendre la vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance devant la mort révèle la puissance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul le Créateur de la vie peut la rendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son impuissance reconnaît la puissance d'Allah." }
  ],
  munajat: `Ya Malik, Tu donnes et reprend la vie. Je reconnais mon impuissance. Ne permets pas que j'oublie que la vie est entre Tes mains.`
};

MIROIR["56:87"] = {
  reference: "56:87",
  theme: ["récompense", "proche", "vision"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Mu'min"],
  mirrorVersion: `« Si le mourant est du nombre des rapprochés, c'est repos et parfum et jardin de délices. » Le miroir me montre la récompense des rapprochés. « Fa-amma in kana mina al-muqarrabin » — si le mourant est du nombre des rapprochés. Les rapprochés ont une belle destinée. Le miroir m'interroge : est-ce que je suis du nombre des rapprochés ?`,
  reflection: `Les rapprochés d'Allah ont une belle récompense : repos, parfum, jardin de délices.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma in kana mina al-muqarrabin fa-rawhun wa rayhanun wa jannatu na'im » — si le mourant est du nombre des rapprochés, c'est repos et parfum et jardin de délices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis du nombre des rapprochés ? Quel sera mon sort après la mort ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le rapprochement avec Allah commence ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les rapprochés d'Allah sont les élus de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rapproche d'Allah ici-bas sera rapproché là-bas." }
  ],
  munajat: `Ya Wali, je veux être du nombre des rapprochés. Rapproche-moi de Toi. Ne permets pas que je sois éloigné.`
};

MIROIR["56:88"] = {
  reference: "56:88",
  theme: ["compagnons", "droit", "récompense"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Rashid"],
  mirrorVersion: `« Et s'il est du nombre des compagnons de la droite, c'est salut pour toi, car tu es des compagnons de la droite. » Le miroir me montre la récompense des compagnons de la droite. « Wa amma in kana min ashabi al-yamani » — et s'il est du nombre des compagnons de la droite. Les compagnons de la droite ont le salut. Le miroir m'interroge : est-ce que je suis des compagnons de la droite ?`,
  reflection: `Les compagnons de la droite reçoivent le salut. Ils sont sur la bonne voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma in kana min ashabi al-yamani fa-salamun laka min ashabi al-yamani » — et s'il est du nombre des compagnons de la droite, c'est salut pour toi, car tu es des compagnons de la droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis des compagnons de la droite ? Quel sera mon salut ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droite est le côté des bénis. La gauche, des maudits." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité sera divisée en trois groupes au Jour dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est des compagnons de la droite a réussi." }
  ],
  munajat: `Ya Hadi, guide-moi vers la droite. Fais que je sois des compagnons de la droite. Ne permets pas que je sois des égarés.`
};

MIROIR["56:89"] = {
  reference: "56:89",
  theme: ["négateurs", "châtiment", "réalité"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Jabbar"],
  mirrorVersion: `« Et s'il est du nombre des négateurs des égarés, c'est accueil d'eau bouillante et brûlement dans la Fournaise. » Le miroir me montre le sort des négateurs. « Wa amma in kana mina al-mukadhdhibina al-dhallin » — et s'il est du nombre des négateurs des égarés. Le châtiment est terrible. Le miroir m'interroge : est-ce que je crains ce sort ?`,
  reflection: `Les négateurs ont un sort terrible : eau bouillante et brûlement dans la Fournaise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma in kana mina al-mukadhdhibina al-dhallin fa-nuzulun min hamin wa tasil jahim » — et s'il est du nombre des négateurs des égarés, c'est accueil d'eau bouillante et brûlement dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce sort ? Est-ce que je fuis la négation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment suit la négation. La foi mène au salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah est parfaite. Chacun reçoit ce qu'il mérite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment se détourne de la négation." }
  ],
  munajat: `Ya 'Adl, Ta justice est parfaite. Fais que je ne sois pas des négateurs. Préserve-moi du châtiment de la Fournaise.`
};

MIROIR["56:90"] = {
  reference: "56:90",
  theme: ["certitude", "vérité", "témoignage"],
  emotion: "Confiance, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Shahid"],
  mirrorVersion: `« Ceci est donc la vérité certaine. » Le miroir me montre la certitude. « Fa-sallaqa haqqun yaqin » — ceci est donc la vérité certaine. La résurrection et le jugement sont une certitude. Le miroir m'interroge : est-ce que je crois avec certitude ?`,
  reflection: `La vérité certaine est que le jugement viendra. La foi doit être certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sallaqa haqqun yaqin » — ceci est donc la vérité certaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois avec certitude ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude est la base de la foi. Le doute est l'ennemi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité certaine est inscrite dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la certitude n'a pas peur." }
  ],
  munajat: `Ya Haqq, la vérité est certaine. Donne-moi la certitude. Ne permets pas que je doute de Ta vérité.`
};

MIROIR["56:91"] = {
  reference: "56:91",
  theme: ["gloire", "nom", "adoration"],
  emotion: "Révérence, louange",
  difficulty: "débutant",
  relatedNames: ["Al-'Azim", "Al-Kabir"],
  mirrorVersion: `« Glorifie donc le nom de ton Seigneur, le Très Grand. » Le miroir me rappelle la glorification. « Fa-sabbih bi-ismi rabbika al-'azim » — glorifie le nom de ton Seigneur, le Très Grand. La réponse à la vérité certaine est la glorification. Le miroir m'interroge : est-ce que je glorifie le nom d'Allah ?`,
  reflection: `La glorification du nom d'Allah est la réponse à la vérité certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sabbih bi-ismi rabbika al-'azim » — glorifie donc le nom de ton Seigneur, le Très Grand." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie le nom d'Allah en réponse à Sa vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification est l'acte le plus élevé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers glorifie le nom du Très Grand." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie le nom d'Allah participe à la louange universelle." }
  ],
  munajat: `Ya 'Azim, Ton nom est le Très Grand. Je glorifie Ton nom. Fais que je ne cesse jamais de Te glorifier.`
};

MIROIR["56:92"] = {
  reference: "56:92",
  theme: ["négation", "égaré", "châtiment"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Et s'il est du nombre des négateurs égarés. » Le miroir me montre la catégorie des négateurs. « Wa amma in kana mina al-mukadhdhibina al-dhallin » — et s'il est du nombre des négateurs égarés. Ceux qui nient sont égarés. Le miroir m'interroge : est-ce que je suis sur la bonne voie ?`,
  reflection: `La négation mène à l'égarement. La foi mène à la guidée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma in kana mina al-mukadhdhibina al-dhallin » — et s'il est du nombre des négateurs égarés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sur la bonne voie ? Ou est-ce que je suis égaré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement est la conséquence de la négation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidée est pour ceux qui croient. L'égarement est pour ceux qui nient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'égarement peut y échapper." }
  ],
  munajat: `Ya Hadi, guide-moi. Ne permets pas que je sois des égarés. Fais que je reste sur la bonne voie.`
};

MIROIR["56:93"] = {
  reference: "56:93",
  theme: ["accueil", "châtiment", "eau bouillante"],
  emotion: "Terreur, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Qahhar"],
  mirrorVersion: `« C'est accueil d'eau bouillante. » Le miroir me montre le châtiment. « Fa-nuzulun min hamin » — c'est accueil d'eau bouillante. L'eau bouillante est une partie du châtiment. Le miroir m'interroge : est-ce que je crains ce châtiment ?`,
  reflection: `L'eau bouillante est un châtiment corporel intense. Elle brûle de l'intérieur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-nuzulun min hamin » — c'est accueil d'eau bouillante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce châtiment ? Est-ce que je fuis ce qui y mène ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau bouillante est l'opposé de l'eau fraîche du paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les éléments peuvent être source de confort ou de châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment fuit les péchés." }
  ],
  munajat: `Ya Jabbar, je crains Ton châtiment. Préserve-moi de l'eau bouillante. Ne permets pas que je mérite ce châtiment.`
};

MIROIR["56:94"] = {
  reference: "56:94",
  theme: ["brûlement", "fournaise", "enfer"],
  emotion: "Terreur, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Qahhar"],
  mirrorVersion: `« Et brûlement dans la Fournaise. » Le miroir me montre la fournaise. « Wa tasil jahim » — et brûlement dans la Fournaise. La fournaise est le feu intense de l'enfer. Le miroir m'interroge : est-ce que je crains la fournaise ?`,
  reflection: `La Fournaise (Jahim) est un des noms de l'enfer. Le feu y est éternel pour les mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tasil jahim » — et brûlement dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la fournaise ? Est-ce que je fais tout pour l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fournaise est l'opposé du paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu de l'enfer dépasse tout feu terrestre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la fournaise se protège par la foi." }
  ],
  munajat: `Ya Qahhar, je crains la fournaise. Préserve-moi du feu. Ne permets pas que j'entre dans la Fournaise.`
};

MIROIR["56:95"] = {
  reference: "56:95",
  theme: ["certitude", "vérité", "témoignage"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Shahid"],
  mirrorVersion: `« Ceci est la vérité certaine. » Le miroir confirme la certitude. « Inna hadha la-huwa haqqu al-yaqin » — ceci est la vérité certaine. La réalité du jugement et de l'au-delà est certaine. Le miroir m'interroge : est-ce que j'ai la certitude ?`,
  reflection: `La vérité certaine est absolue. Il n'y a pas de place pour le doute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadha la-huwa haqqu al-yaqin » — ceci est la vérité certaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai la certitude ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude vient de la foi. Le doute vient de l'insécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité certaine est inscrite dans chaque âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la certitude ne peut être ébranlé." }
  ],
  munajat: `Ya Haqq, donne-moi la certitude. Fais que je sois certain de Ta vérité. Ne permets pas que le doute m'atteigne.`
};

MIROIR["56:96"] = {
  reference: "56:96",
  theme: ["gloire", "nom", "adoration"],
  emotion: "Révérence, louange",
  difficulty: "débutant",
  relatedNames: ["Al-'Azim", "Al-Kabir"],
  mirrorVersion: `« Glorifie donc le nom de ton Seigneur, le Très Grand. » Le miroir conclut par la glorification. « Fa-sabbih bi-ismi rabbika al-'azim » — glorifie le nom de ton Seigneur, le Très Grand. La sourate entière mène à cette conclusion : glorifiez Allah. Le miroir m'interroge : est-ce que ma vie est une glorification ?`,
  reflection: `La glorification est le but de l'existence. Tout mène à glorifier le Très Grand.`,
  tajalli: [
