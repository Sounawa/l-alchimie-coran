    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je soif de l'eau du Paradis ? Est-ce que j'en désire la fraîcheur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau qui jaillit du cœur précède celle du Paradis." },
