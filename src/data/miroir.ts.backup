    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon rendez-vous ? La promesse d'Allah est-elle ma certitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rendez-vous est fixé — nul ne peut y échapper." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a son rendez-vous avec le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La certitude de la promesse transforme la vie présente." }
  ],
  munajat: `Ya Rabb, Ta promesse est vraie. Je me prépare pour le rendez-vous. Ne permets pas que je l'oublie.`
};

