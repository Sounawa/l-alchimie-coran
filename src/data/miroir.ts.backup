    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Voir les conséquences est certain — observer avec patience est demandé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers révèle ses secrets à ceux qui observent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'observation constante est le signe du croyant éveillé." }
  ],
  munajat: `Ya Rabb, garde-moi vigilant. Fais que j'observe et que je voie Ta vérité.`
};

MIROIR["37:181"] = {
  reference: "37:181",
  theme: ["paix", "prophète", "salut"],
  emotion: "Paix, bénédiction",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mursalin"],
  mirrorVersion: `« Paix sur les envoyés ! » Le miroir me montre la salutation finale. « Salaamun 'alal-mursaleen » — paix sur les envoyés ! La bénédiction. La sourate conclut par la paix sur tous les prophètes. Le miroir m'invite à prier pour tous les envoyés.`,
  reflection: `Prier pour tous les prophètes est un acte de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salaamun 'alal-mursaleen » — paix sur les envoyés !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour tous les prophètes d'Allah ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La paix sur les prophètes est la reconnaissance de leur mission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en paix avec les prophètes d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La paix sur les prophètes nous apporte leur bénédiction." }
  ],
  munajat: `Ya Rabb, que Ta paix soit sur tous Tes envoyés. Je prie pour eux et je les honore.`
};

MIROIR["37:182"] = {
  reference: "37:182",
  theme: ["louange", "seigneur", "monde"],
  emotion: "Louange, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hamd", "Rabb Al-'Alamin"],
  mirrorVersion: `« Et louange à Allah, Seigneur des mondes ! » Le miroir me montre la conclusion parfaite. « Wal-hamdu lillahi rabbil-'aalameen » — et louange à Allah, Seigneur des mondes ! La louange. Toute la sourate culmine dans la louange. Le miroir m'invite à la louange finale.`,
  reflection: `La louange est la conclusion parfaite de toute contemplation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wal-hamdu lillahi rabbil-'aalameen » — et louange à Allah, Seigneur des mondes !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie culmine dans la louange d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange d'Allah est le but de toute existence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier loue Allah par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La louange constante est le signe du cœur reconnaissant." }
  ],
  munajat: `Ya Rabb, à Toi la louange, Seigneur des mondes. Je Te loue pour toutes Tes créatures et Tes prophètes.`
};

MIROIR["80:21"] = {
  reference: "80:21",
  theme: ["nourriture", "provision", "origine"],
  emotion: "Questionnement, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Mut'im"],
  mirrorVersion: `« Non ! L'homme n'a pas accompli ce qu'Il lui a ordonné. » Le miroir pose une question sur la nourriture : « Fal-yanzuri al-insanu ila ta'amihi » — que l'homme regarde sa nourriture. Cette question traverse le temps. D'où vient notre nourriture ? Comment est-elle produite ? Le miroir m'invite à la gratitude pour chaque bouchée.`,
  reflection: `La nourriture est un cadeau. D'où vient-elle ? Comment la remercions-nous ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fal-yanzuri al-insanu ila ta'amihi » — que l'homme regarde sa nourriture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ma nourriture ? Est-ce que je réalise le processus derrière chaque bouchée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture est un miracle quotidien que nous ignorons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit par l'ordre d'Allah — chaque grain est un signe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le miracle dans sa nourriture voit Allah partout." }
  ],
  munajat: `Ya Razzaq, Tu me nourris chaque jour. Fais que je voie le miracle dans chaque bouchée. Fais que je remercie.`
};

MIROIR["80:22"] = {
  reference: "80:22",
  theme: ["pluie", "provision", "désintégration"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Munzil", "Al-Ghayth"],
  mirrorVersion: `« Nous avons fait descendre l'eau du ciel en abondance. » Le miroir me montre le processus de la nourriture : l'eau du ciel. « Inna sabaghna al-maa sabghan » — Nous avons versé l'eau abondamment. La source de toute nourriture est cette eau qui tombe du ciel. Le miroir m'enseigne à voir la pluie comme une bénédiction, pas comme une gêne.`,
  reflection: `La pluie est la source de la vie. Chaque goutte est un cadeau d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna sabaghna al-maa sabghan » — Nous avons versé l'eau abondamment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je vois la pluie ? Comme une bénédiction ou une gêne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau qui tombe du ciel nourrit la terre — et nous nourrit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de l'eau est un miracle quotidien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah descend la pluie avec amour — elle porte Sa miséricorde." }
  ],
  munajat: `Ya Munzil, merci pour la pluie. Fais que je la voie comme Ton cadeau. Fais qu'elle nourrisse mon corps et mon âme.`
};

MIROIR["80:23"] = {
  reference: "80:23",
  theme: ["terre", "fissure", "croissance"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fatiq", "Al-Muhit"],
  mirrorVersion: `« Puis Nous avons fissuré la terre profondément. » Le miroir continue : la terre doit s'ouvrir pour recevoir la graine. « Fashaqqaqna al-arda shaqqa » — Nous avons fissuré la terre profondément. La fissure n'est pas une blessure — c'est une ouverture. Le miroir m'enseigne : la terre doit s'ouvrir pour porter la vie.`,
  reflection: `La terre s'ouvre pour recevoir la vie. Les fissures sont des opportunités de croissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fashaqqaqna al-arda shaqqa » — puis Nous avons fissuré la terre profondément." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles fissures dans ma vie sont des opportunités de croissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fissure est l'ouverture nécessaire pour la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre s'ouvre chaque printemps pour la nouvelle vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah fissure ce qui doit s'ouvrir pour porter du fruit." }
  ],
  munajat: `Ya Rabb, merci pour les fissures. Fais que je les voie comme des ouvertures. Fais qu'elles portent la vie.`
};

MIROIR["80:25"] = {
  reference: "80:25",
  theme: ["nourriture", "grains", "vignes"],
  emotion: "Gratitude, diversité",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Muhit"],
  mirrorVersion: `« Et y avons fait pousser des grains. » Le miroir montre le résultat de la pluie et de la terre ouverte : les grains. « Wa anbataha habban » — et y avons fait pousser des grains. La diversité de la nourriture est un cadeau — grains, raisins, légumes. Le miroir m'invite à la gratitude pour la diversité sur ma table.`,
  reflection: `La nourriture est diverse. Chaque type est un cadeau différent d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anbataha habban » — et y avons fait pousser des grains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour la diversité de ma nourriture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité de la nourriture reflète la générosité du Donneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit mille variétés — chaque goût est un cadeau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte la nourriture avec gratitude goûte la présence d'Allah." }
  ],
  munajat: `Ya Razzaq, merci pour les grains. Merci pour la diversité de ma table. Fais que je sois reconnaissant.`
};

MIROIR["80:26"] = {
  reference: "80:26",
  theme: ["vignes", "légumes", "olives"],
  emotion: "Gratitude, abondance",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Mun'im"],
  mirrorVersion: `« Des vignes et des légumes. » Le miroir énumère : « Wa 'inaban wa qadban » — des vignes et des légumes. La liste continue : olives, dattes, jardins, fruits. Chaque type de nourriture a son processus, son goût, sa bénédiction. Le miroir m'invite à savourer chaque bénédiction distinctement.`,
  reflection: `La nourriture vient sous mille formes. Chacune est un cadeau unique d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'inaban wa qadban » — des vignes et des légumes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour chaque type de nourriture distinctement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La variété de la nourriture est un signe de la variété de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque région a ses fruits — la terre est généreuse partout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour la nourriture ouvre la porte à plus de bénédictions." }
  ],
  munajat: `Ya Razzaq, merci pour les vignes, les légumes, les olives. Chaque bouchée est Ton cadeau. Fais que je remercie.`
};

MIROIR["80:27"] = {
  reference: "80:27",
  theme: ["arbres", "jardins", "beauté"],
  emotion: "Émerveillement, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Jamil"],
  mirrorVersion: `« Et des arbres fruitiers. » Le miroir continue : « Wa zaytunan wa nakhlan » — olives et dattiers. Ces arbres sont mentionnés spécifiquement dans le Coran pour leur importance. L'olive pour l'huile, le dattier pour le fruit. Le miroir m'enseigne que la provision vient avec sagesse — chaque arbre a son but.`,
  reflection: `Les arbres portent des fruits par l'ordre d'Allah. Chaque arbre a sa sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa zaytunan wa nakhlan » — olives et dattiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la sagesse dans chaque arbre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'arbre quiet porte le fruit qui nourrit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les arbres sont les poumons de la terre — ils nous donnent la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah a planté chaque arbre avec amour et but." }
  ],
  munajat: `Ya Rabb, merci pour les oliviers et les dattiers. Merci pour chaque arbre qui me nourrit. Fais que je sois reconnaissant.`
};

MIROIR["80:28"] = {
  reference: "80:28",
  theme: ["jardins", "fraîcheur", "plaisir"],
  emotion: "Joie, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Janna", "Al-Raziq"],
  mirrorVersion: `« Et des jardins luxuriants. » Le miroir ajoute : « Wa hada'iqa gholaba » — et des jardins luxuriants. La nourriture n'est pas que fonctionnelle — elle est aussi belle. Les jardins nourrissent les yeux autant que le corps. Le miroir m'enseigne qu'Allah pourvoit avec beauté.`,
  reflection: `La beauté accompagne la provision. Les jardins sont des signes de générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hada'iqa gholaba » — et des jardins luxuriants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'arrête pour apprécier la beauté de la provision ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté de la création nourrit l'âme autant que le corps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jardins sont des fragments du paradis sur terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprécie les jardins goûte au plaisir du paradis." }
  ],
  munajat: `Ya Rabb, merci pour les jardins. Fais que je m'arrête pour apprécier leur beauté. Fais que je sois reconnaissant.`
};

MIROIR["80:29"] = {
  reference: "80:29",
  theme: ["plaisir", "vie", "responsabilité"],
  emotion: "Joie, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Raziq", "Al-Hisab"],
  mirrorVersion: `« Et des fruits et des pâturages. » Le miroir continue la liste : « Wa fakihatan wa abban » — fruits et pâturages. La nourriture pour les humains et la nourriture pour les animaux. Allah pourvoit à toute la création. Le miroir m'interroge : est-ce que je réalise que ma nourriture fait partie d'un écosystème vaste ?`,
  reflection: `La provision d'Allah englobe tout être vivant. Je ne suis qu'un bénéficiaire parmi des milliards.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fakihatan wa abban » — fruits et pâturages." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je partage la provision d'Allah avec toute la création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les pâturages nourrissent les animaux qui nous nourrissent — tout est connecté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah pourvoit à chaque créature — le petit oiseau comme le grand éléphant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour la provision connecte à tout l'écosystème divin." }
  ],
  munajat: `Ya Raziq, Tu nourris toute la création. Fais que je sois reconnaissant pour ma part. Fais que je respecte toute la création.`
};

MIROIR["80:30"] = {
  reference: "80:30",
  theme: ["jouissance", "responsabilité", "feu"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mati'ah", "Al-Nar"],
  mirrorVersion: `« Jouissance pour vous et pour vos troupeaux. » Le miroir clarifie : « Mata'an lakum wa li-an'amikum » — jouissance pour vous et vos troupeaux. La nourriture est une jouissance temporaire, un « mata' ». Elle n'est pas éternelle. Le miroir m'avertit : ne vous attachez pas excessivement à la jouissance — elle a une fin.`,
  reflection: `La jouissance est temporaire. Elle doit être appréciée sans attachement excessif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mata'an lakum wa li-an'amikum » — jouissance pour vous et vos troupeaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je vois la jouissance ? Comme un but ou comme un cadeau temporaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jouissance partagée avec les troupeaux nous rappelle notre animalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature jouit de la provision d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La jouissance est un test — que fais-je avec ce cadeau ?" }
  ],
  munajat: `Ya Rabb, merci pour la jouissance. Fais que je ne m'y attache pas excessivement. Fais que je l'utilise pour Te remercier.`
};

MIROIR["80:31"] = {
  reference: "80:31",
  theme: ["cri", "résurrection", "jour"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Sa'ah", "Al-Ba'ith"],
  mirrorVersion: `« Puis, quand viendra le Cri assourdissant. » Le miroir change de ton : « Fa-idha ja'ati al-sakhah » — quand viendra le Cri. Le mot « sakhah » est le cri assourdissant de la résurrection. Après l'énumération des bienfaits, le rappel du Jour. Le miroir m'enseigne : jouissez, mais n'oubliez pas le compte.`,
  reflection: `Le Cri viendra. La jouissance prendra fin. Le compte suivra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha ja'ati al-sakhah » — puis quand viendra le Cri assourdissant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que le Cri viendra ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Cri réveille les morts et endort les vivants par terreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Cri marque la fin de ce monde et le début de l'autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le Cri n'a pas peur quand il vient." }
  ],
  munajat: `Ya Rabb, le Cri viendra. Prépare-moi. Fais que je vive en sachant que le Jour arrive. Fais que je sois prêt.`
};

MIROIR["80:32"] = {
  reference: "80:32",
  theme: ["fuite", "frère", "jour"],
  emotion: "Solitude, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Waqt"],
  mirrorVersion: `« Ce jour-là, l'homme fuira son frère. » Le miroir peint la scène du Jour : « Yawma yafirru al-mar'u min akhihi » — ce jour-là, l'homme fuira son frère. Les liens les plus forts se brisent. Chacun pour soi. Le miroir m'interroge : en quoi ce jour change-t-il mes relations aujourd'hui ?`,
  reflection: `Le Jour brise les liens humains. Chacun sera seul devant son compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yafirru al-mar'u min akhihi » — ce jour-là, l'homme fuira son frère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui fuirai-je ce jour-là ? Et qui voudrai-je aider mais ne pourrai pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les liens humains sont précieux mais limités — le lien avec Allah est éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour révèle la vraie nature des relations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Seul le lien avec Allah survivra au Jour." }
  ],
  munajat: `Ya Rabb, le Jour viendra où je fuirai même mon frère. Fais que je renforce mon lien avec Toi maintenant. Seul Toi comptera.`
};

MIROIR["80:33"] = {
  reference: "80:33",
  theme: ["mère", "père", "fuite"],
  emotion: "Solitude, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Yawm"],
  mirrorVersion: `« Et de sa mère et de son père. » Le miroir ajoute : « Wa ummihi wa abihi » — et de sa mère et de son père. Les liens les plus sacrés — mère, père — seront rompus. Personne ne peut porter le fardeau d'un autre. Le miroir m'enseigne : le Jour est une solitude absolue.`,
  reflection: `Même les parents ne pourront pas nous aider. Nous sommes seuls devant notre compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ummihi wa abihi » — et de sa mère et de son père." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes parents m'ont donné la vie — mais ne pourront pas m'aider ce Jour-là." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour des parents est grand — mais l'amour d'Allah est plus grand." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme viendra seule le Jour — sans famille, sans appui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La solitude du Jour nous pousse à chercher la compagnie d'Allah maintenant." }
  ],
  munajat: `Ya Rabb, même mes parents ne pourront pas m'aider ce Jour-là. Fais que je me tourne vers Toi maintenant. Sois mon refuge.`
};

MIROIR["80:34"] = {
  reference: "80:34",
  theme: ["épouse", "enfants", "fuite"],
  emotion: "Solitude, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Waqt", "Al-Hisab"],
  mirrorVersion: `« Et de son épouse et de ses enfants. » Le miroir continue : « Wa sahibatihi wa banihi » — et de son épouse et de ses enfants. La famille la plus proche — épouse, enfants — sera abandonnée. Chacun sera trop préoccupé par son propre sort. Le miroir m'interroge : est-ce que j'investis dans les relations éternelles ?`,
  reflection: `La famille proche sera abandonnée. Les relations éternelles sont avec Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sahibatihi wa banihi » — et de son épouse et de ses enfants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma famille est ma priorité maintenant — mais pourront-ils m'aider ce Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les enfants sont une joie — mais aussi une préoccupation le Jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque parent sera trop occupé par son propre compte pour aider ses enfants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie préparation pour le Jour est de renforcer le lien avec Allah." }
  ],
  munajat: `Ya Rabb, ma famille m'est précieuse — mais elle ne pourra pas m'aider ce Jour. Fais que je T'aime plus que tout. Sois mon refuge.`
};

MIROIR["80:35"] = {
  reference: "80:35",
  theme: ["délivrance", "rançon", "jour"],
  emotion: "Espoir, désespoir",
  difficulty: "débutant",
  relatedNames: ["Al-Fida", "Al-'Adl"],
  mirrorVersion: `« Chacun d'eux, ce jour-là, aura son affaire qui l'occupera. » Le miroir montre l'occupation totale : « Likulli imri'in minhum yawma'idhin sha'nun yughnihi » — chacun aura son affaire qui l'occupera. Personne ne sera libre pour les autres. Le miroir m'enseigne : le Jour est individuel.`,
  reflection: `Chacun sera occupé par son propre compte. La solidarité humaine cessera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Likulli imri'in minhum yawma'idhin sha'nun yughnihi » — chacun aura son affaire qui l'occupera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle sera mon affaire ce Jour-là ? Serai-je trop occupé pour aider les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'occupation totale montre l'importance du compte individuel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme est responsable d'elle-même — le Jour le révèle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation individuelle est la seule qui compte." }
  ],
  munajat: `Ya Rabb, chacun sera occupé par son propre compte ce Jour. Fais que je me prépare individuellement. Fais que je sois prêt.`
};

MIROIR["80:36"] = {
  reference: "80:36",
  theme: ["visage", "lumière", "jour"],
  emotion: "Espoir, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Nur", "Al-Musfir"],
  mirrorVersion: `« Ce jour-là, il y aura des visages resplendissants. » Le miroir change de ton : « Wujuhun yawma'idhin musfirah » — ce jour-là, il y aura des visages resplendissants. Le Jour n'est pas que terreur — il est aussi espérance pour les croyants. Le miroir m'enseigne : le Jour révèle la lumière dans les cœurs purs.`,
  reflection: `Le Jour n'est pas que terreur — il est lumière pour les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wujuhun yawma'idhin musfirah » — ce jour-là, il y aura des visages resplendissants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon visage sera-t-il resplendissant ce Jour-là ? Ou assombri ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière du visage reflète la lumière du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour sépare la lumière des ténèbres — dans les cœurs et sur les visages." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est illuminé maintenant aura le visage illuminé alors." }
  ],
  munajat: `Ya Nur, illumine mon cœur maintenant pour que mon visage soit illuminé ce Jour. Fais que je sois parmi les resplendissants.`
};

MIROIR["80:37"] = {
  reference: "80:37",
  theme: ["joie", "bonheur", "récompense"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Karim"],
  mirrorVersion: `« Riant, réjouis. » Le miroir continue : « Dahikah mustabshirah » — riant, réjouis. Les visages resplendissants rient de joie. Le Jour n'est pas que jugement — il est aussi récompense pour les croyants. Le miroir m'enseigne : la joie du Jour suit la patience de la vie.`,
  reflection: `La joie du Jour suit les épreuves de la vie. Les croyants riront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dahikah mustabshirah » — riant, réjouis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rirai de joie ce Jour ? Ou pleurerai de regret ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ceux qui pleurent maintenant riront alors — et inversement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La joie véritable appartient à ceux qui ont choisi Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rire du Jour est le fruit de la foi dans la vie." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi ceux qui rient de joie ce Jour. Fais que ma patience maintenant porte ce fruit.`
};

MIROIR["80:38"] = {
  reference: "80:38",
  theme: ["visage", "poussière", "tristesse"],
  emotion: "Tristesse, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Hazin"],
  mirrorVersion: `« Et d'autres visages, ce jour-là, couverts de poussière. » Le miroir contraste : « Wa wujuhun yawma'idhin 'alayha ghabarah » — et d'autres visages, ce jour-là, couverts de poussière. Le contraste est brutal : resplendissants versus poussiéreux. Le miroir m'interroge : dans quel groupe serai-je ?`,
  reflection: `Deux groupes, deux sorts. La poussière sur le visage reflète la noirceur du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wujuhun yawma'idhin 'alayha ghabarah » — et d'autres visages, ce jour-là, couverts de poussière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon visage sera-t-il poussiéreux ce Jour ? Qu'est-ce qui couvre mon cœur maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poussière extérieure reflète l'obscurité intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour révèle ce qui était caché — la beauté ou la laideur du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ceux qui ont caché leur foi auront le visage découvert." }
  ],
  munajat: `Ya Rabb, ne permets pas que mon visage soit poussiéreux ce Jour. Nettoie mon cœur maintenant. Illumine mon visage.`
};

MIROIR["80:39"] = {
  reference: "80:39",
  theme: ["ignominie", "tristesse", "châtiment"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Taraqah", "Al-Kufr"],
  mirrorVersion: `« Recouverts d'ignominie. » Le miroir ajoute : « Taraqahu qatarah » — recouverts d'ignominie. La poussière n'est pas que physique — elle est spirituelle. L'ignominie recouvre ceux qui ont rejeté la foi. Le miroir m'avertit : l'ignominie dans le cœur se manifeste sur le visage.`,
  reflection: `L'ignominie intérieure devient visible le Jour. Rien n'est caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Taraqahu qatarah » — recouverts d'ignominie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il de l'ignominie dans mon cœur ? Qu'est-ce que je cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignominie cachée dans la vie sera découverte le Jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour est le grand révélateur — tout sera manifeste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La purification maintenant évite l'ignominie alors." }
  ],
  munajat: `Ya Rabb, purifie mon cœur de toute ignominie. Ne permets pas que je sois couvert de honte ce Jour. Fais que je sois pur.`
};

MIROIR["80:40"] = {
  reference: "80:40",
  theme: ["mécréants", "pécheurs", "jour"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Kafirun", "Al-Fasiqun"],
  mirrorVersion: `« Ce sont eux les mécréants, les débauchés. » Le miroir identifie : « Ula'ika hum al-kafarah al-fajarah » — ce sont eux les mécréants, les débauchés. L'identification est claire. Le visage poussiéreux et ignominieux n'est pas un accident — c'est le résultat du choix de la mécréance et de la débauche. Le miroir m'enseigne : les conséquences suivent les choix.`,
  reflection: `Les choix de la vie portent leurs fruits le Jour. La mécréance mène à l'ignominie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika hum al-kafarah al-fajarah » — ce sont eux les mécréants, les débauchés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes choix d'aujourd'hui déterminent mon visage de demain." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mécréance dans le cœur devient ignominie sur le visage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah manifeste les réalités cachées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi maintenant purifie — l'ignominie sera évitée alors." }
  ],
  munajat: `Ya Rabb, protège-moi de la mécréance et de la débauche. Fais que mes choix d'aujourd'hui me conduisent à la lumière.`
};

MIROIR["80:41"] = {
  reference: "80:41",
  theme: ["visage", "poussière", "révélation"],
  emotion: "Réalité, contraste",
  difficulty: "débutant",
  relatedNames: ["Al-Haqiqah", "Al-Zahir"],
  mirrorVersion: `« Recouverts de poussière. » Le miroir répète l'image : « 'alayha ghabarah » — recouverts de poussière. La répétition n'est pas redondance — c'est insistance. La poussière n'est pas accidentelle. Elle est le résultat de l'obscurcissement du cœur par les péchés. Le miroir m'enseigne : les péchés s'accumulent comme la poussière.`,
  reflection: `Les péchés s'accumulent. La purification régulière est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'alayha ghabarah » — recouverts de poussière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle poussière s'accumule sur mon cœur ? Quand est-ce que je me purifie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poussière du péché recouvre la lumière naturelle du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur sans purification s'obscurcit comme un miroir sans nettoyage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La purification quotidienne maintient le cœur lumineux." }
  ],
  munajat: `Ya Tahir, purifie mon cœur de la poussière des péchés. Fais que je me purifie régulièrement. Ne permets pas l'accumulation.`
};

MIROIR["80:42"] = {
  reference: "80:42",
  theme: ["ignominie", "couverture", "révélation"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Zahir", "Al-Batin"],
  mirrorVersion: `« Recouverts d'obscurité. » Le miroir conclut : « Taraqahu qatarah » — recouverts d'obscurité. La sourate 'Abasa commence par la correction du Prophète pour avoir ignoré l'aveugle, et se termine par le contraste des visages au Jour du Jugement. Le fil conducteur : ce que nous faisons avec ceux qui viennent à nous détermine notre sort final.`,
  reflection: `Notre traitement des autres détermine notre visage le Jour. La générosité spirituelle est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Taraqahu qatarah » — recouverts d'obscurité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite ceux qui viennent à moi ? Mon sort en dépend." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obscurité du cœur se manifeste comme obscurité sur le visage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière et l'obscurité ne peuvent coexister — dans le cœur ni sur le visage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clé : accueillir celui qui vient chercher la guidance." }
  ],
  munajat: `Ya Nur, illumine mon cœur et mon visage. Fais que j'accueille ceux qui viennent à Toi. Ne permets pas que je sois couvert d'obscurité.`
};

// ==================== SURAH 81: AT-TAKWIR - ADDITIONAL ENTRIES ====================

MIROIR["81:2"] = {
  reference: "81:2",
  theme: ["étoiles", "effacement", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Nujum", "Al-Munawwar"],
  mirrorVersion: `« Et quand les étoiles s'effaceront. » Le miroir continue l'évocation de la fin : « Wa idha al-nujumu inkadarat » — et quand les étoiles s'effaceront, se troubleront. Les étoiles, symboles de lumière et de guidance dans le ciel nocturne, perdront leur éclat. Le miroir m'interroge : en quoi est-ce que je dépend des lumières temporaires plutôt que de la Lumière éternelle ?`,
  reflection: `Les étoiles s'effaceront. Seule la Lumière d'Allah demeurera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-nujumu inkadarat » — et quand les étoiles s'effaceront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles « étoiles » dans ma vie s'effaceront ? Sur quoi compte-je vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étoiles s'effacent — la Lumière d'Allah ne s'efface jamais." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lui-même sera transformé — les étoiles ne seront plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépend d'Allah seul ne perd rien quand tout s'efface." }
  ],
  munajat: `Ya Nur, les étoiles s'effaceront mais Tu restes. Fais que je dépende de Ta Lumière éternelle, pas des lumières temporaires.`
};

MIROIR["81:3"] = {
  reference: "81:3",
  theme: ["montagnes", "mouvement", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jibal", "Al-Mutaharrik"],
  mirrorVersion: `« Et quand les montagnes seront mises en mouvement. » Le miroir ajoute : « Wa idha al-jibalu suyyirat » — et quand les montagnes seront mises en mouvement. Les montagnes, symboles de stabilité et de permanence, seront déplacées comme des nuages. Le miroir m'enseigne : rien dans ce monde n'est permanent — même le plus stable sera ébranlé.`,
  reflection: `Les montagnes bougeront. Qu'est-ce qui ne bougera pas ? Seul Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-jibalu suyyirat » — et quand les montagnes seront mises en mouvement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme « montagne » — stable, permanent ? Tout bougera." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les montagnes bougent — le Trône d'Allah ne bouge pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre elle-même sera secouée — rien ne restera en place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'appuie sur Allah reste debout quand les montagnes tombent." }
  ],
  munajat: `Ya Rabb, les montagnes bougeront mais Ton Trône ne bouge pas. Fais que je m'appuie sur Toi seul. Sois ma stabilité.`
};

MIROIR["81:4"] = {
  reference: "81:4",
  theme: ["chamelles", "abandon", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ishar", "Al-Tark"],
  mirrorVersion: `« Et quand les chamelles pleines seront négligées. » Le miroir continue : « Wa idha al-'isharu 'uttilat » — et quand les chamelles pleines (de 10 mois) seront abandonnées. Ces chamelles étaient les trésors les plus précieux des Arabes — et elles seront abandonnées. Le miroir m'enseigne : les biens les plus précieux de ce monde seront délaissés au Jour.`,
  reflection: `Les trésors de ce monde seront abandonnés. Qu'est-ce qui compte vraiment ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-'isharu 'uttilat » — et quand les chamelles pleines seront négligées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels « trésors » je crains de perdre ? Au Jour, ils seront abandonnés." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le trésor abandonné devient sans valeur — seul le trésor auprès d'Allah compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création sera témoins de l'abandon des valeurs mondaines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai trésor est ce qu'on porte dans son cœur vers Allah." }
  ],
  munajat: `Ya Rabb, les trésors seront abandonnés. Fais que mon trésor soit auprès de Toi. Les chamelles ne compteront plus — Toi seul compteras.`
};

MIROIR["81:5"] = {
  reference: "81:5",
  theme: ["bêtes", "rassemblement", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Wuhush", "Al-Hashr"],
  mirrorVersion: `« Et quand les bêtes sauvages seront rassemblées. » Le miroir ajoute : « Wa idha al-wuhushu hushirat » — et quand les bêtes sauvages seront rassemblées. Les animaux, qui fuient normalement les humains, seront rassemblés sans peur. Le miroir m'enseigne : le Jour brouille toutes les frontières naturelles — la crainte disparaît devant l'événement absolu.`,
  reflection: `Les frontières naturelles seront abolies. Le Jour est au-delà de toute catégorie connue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-wuhushu hushirat » — et quand les bêtes sauvages seront rassemblées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me semble « naturel » et immuable ? Tout sera bouleversé." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bêtes sauvages rassemblées — la crainte naturelle disparaît." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création sera rassemblée — animaux, humains, anges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rassemblement universel inclut tout — personne n'est exclu." }
  ],
  munajat: `Ya Rabb, les bêtes seront rassemblées. Fais que je sois prêt pour ce rassemblement universel. Tout sera différent ce Jour.`
};

MIROIR["81:6"] = {
  reference: "81:6",
  theme: ["mers", "embrasement", "fin"],
  emotion: "Émerveillement, terreur",
  difficulty: "débutant",
  relatedNames: ["Al-Bihar", "Al-Su'ir"],
  mirrorVersion: `« Et quand les mers seront embrasées. » Le miroir continue : « Wa idha al-biharu sujjirat » — et quand les mers seront embrasées, allumées. Les mers, symboles d'eau et de fraîcheur, deviendront du feu. Le miroir m'enseigne : les éléments mêmes seront transformés — l'eau deviendra feu.`,
  reflection: `Les mers deviendront feu. La transformation des éléments est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-biharu sujjirat » — et quand les mers seront embrasées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme « impossible » ? Tout est possible au Jour." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau devient feu — les opposés se rejoignent dans la transformation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mers embrasées marquent la fin de l'ordre naturel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah transforme ce qu'Il veut — rien n'est figé pour Lui." }
  ],
  munajat: `Ya Rabb, les mers deviendront feu. Fais que je ne m'attache à rien de ce monde. Tout sera transformé.`
};

MIROIR["81:7"] = {
  reference: "81:7",
  theme: ["âmes", "réunion", "fin"],
  emotion: "Espérance, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Nufus", "Al-Zawj"],
  mirrorVersion: `« Et quand les âmes seront accouplées. » Le miroir ajoute : « Wa idha al-nufusu zuwwijat » — et quand les âmes seront accouplées, associées selon leurs œuvres. Les âmes seront regroupées par affinité spirituelle. Le miroir m'enseigne : nous serons avec ceux que nous aimons et ressemblons — le juste avec les justes, le pervers avec les pervers.`,
  reflection: `Nous serons avec nos semblables. La compagnie spirituelle a une importance éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-nufusu zuwwijat » — et quand les âmes seront accouplées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui serai-je accouplé ? Qui sont mes semblables spirituels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accouplement des âmes révèle les vraies affinités — celles du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création tout entière sera réorganisée selon les critères d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le juste sera avec les justes — le pervers avec les pervers. Choisis bien tes compagnons." }
  ],
  munajat: `Ya Rabb, les âmes seront accouplées. Fais que je sois avec les justes. Donne-moi de bonnes compagnies dans ce monde et l'autre.`
};

MIROIR["81:8"] = {
  reference: "81:8",
  theme: ["fille enterrée", "question", "justice"],
  emotion: "Justice, émotion",
  difficulty: "débutant",
  relatedNames: ["Al-Maw'udah", "Al-'Adl"],
  mirrorVersion: `« Et quand la fille enterrée vivante sera questionnée. » Le miroir évoque une scène poignante : « Wa idha al-maw'udatu su'ilat » — et quand la fille enterrée vivante sera questionnée. Les Arabes préislamiques enterraient vivantes leurs filles par honte. Au Jour, ces filles seront questionnées sur leur crime. Le miroir m'enseigne : Allah rendra justice aux plus faibles.`,
  reflection: `La justice d'Allah atteindra les plus vulnérables. Les faibles seront vengés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-maw'udatu su'ilat » — et quand la fille enterrée vivante sera questionnée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles injustices contre les faibles seront révélées ? Qu'ai-je fait pour les vulnérables ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fille questionnée sera la juge de ses bourreaux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute injustice sera révélée et jugée — rien ne sera caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est le Défenseur des faibles — leur justice est garantie." }
  ],
  munajat: `Ya 'Adl, Tu rendras justice aux filles enterrées. Fais que je sois du côté des faibles. Ne permets pas que j'opprime personne.`
};

MIROIR["81:9"] = {
  reference: "81:9",
  theme: ["péché", "question", "justice"],
  emotion: "Justice, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Dhanb", "Al-Su'al"],
  mirrorVersion: `« Pour quel péché elle a été tuée. » Le miroir complète : « Bi-ayyi dhanbin qutilat » — pour quel péché elle a été tuée. La question est rhétorique — quel péché une innocent peut-elle avoir commis ? Le miroir m'enseigne : l'innocence sera la preuve contre les bourreaux.`,
  reflection: `L'innocent n'a pas de péché — le crime est celui du meurtrier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-ayyi dhanbin qutilat » — pour quel péché elle a été tuée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles innocents ai-je blessés ? Leur innocence témoignera contre moi." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question révèle l'innocence de la victime et la culpabilité du meurtrier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute victime innocente aura justice au Jour Dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît chaque crime caché — rien n'échappe à Sa justice." }
  ],
  munajat: `Ya Rabb, chaque innocent aura justice. Fais que je sois du côté des victimes, pas des bourreaux. Ma conscience est pure ?`
};

MIROIR["81:10"] = {
  reference: "81:10",
  theme: ["feuilles", "révélation", "dévoilement"],
  emotion: "Réalité, jugement",
  difficulty: "débutant",
  relatedNames: ["Al-Suhuf", "Al-Kashf"],
  mirrorVersion: `« Et quand les feuilles seront déployées. » Le miroir continue : « Wa idha al-suhufu nushirat » — et quand les feuilles (registres des actions) seront déployées, publiées. Tout sera révélé — les actions secrètes, les intentions cachées. Le miroir m'enseigne : rien ne restera caché au Jour.`,
  reflection: `Les registres seront ouverts. Chaque action sera visible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-suhufu nushirat » — et quand les feuilles seront déployées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Le Jour, tout sera révélé." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les secrets deviennent publics — le caché devient manifeste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera témoin de chaque action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le registre est déjà écrit — chaque action compte." }
  ],
  munajat: `Ya Rabb, les registres seront déployés. Fais que mon registre soit rempli de bonnes œuvres. Rien ne T'échappe.`
};

MIROIR["81:11"] = {
  reference: "81:11",
  theme: ["ciel", "écorchure", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Sama'", "Al-Kashf"],
  mirrorVersion: `« Et quand le ciel sera écorché. » Le miroir ajoute : « Wa idha al-sama'u kushitat » — et quand le ciel sera écorché, dépouillé de son voile. Le ciel, qui cache les réalités célestes, sera ouvert. Le miroir m'enseigne : les voiles seront levés — nous verrons ce qui était caché.`,
  reflection: `Les voiles seront levés. Nous verrons la réalité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-sama'u kushitat » — et quand le ciel sera écorché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels voiles me cachent la réalité ? Le Jour, ils seront levés." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le ciel dépouillé révèle les réalités cachées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera « ouvert » — plus de secrets, plus de mystères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui voit maintenant sera prêt pour la vision complète." }
  ],
  munajat: `Ya Rabb, le ciel sera écorché et les réalités révélées. Fais que je voie maintenant par la foi ce que je verrai alors.`
};

MIROIR["81:12"] = {
  reference: "81:12",
  theme: ["enfer", "embrasement", "révélation"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Su'ir"],
  mirrorVersion: `« Et quand la Fournaise sera attisée. » Le miroir continue : « Wa idha al-jahimu su'irat » — et quand la Fournaise (Jahim) sera attisée, allumée. L'enfer sera visible et actif. Le miroir m'enseigne : la réalité du châtiment sera manifeste — plus de doute possible.`,
  reflection: `L'enfer sera visible. La réalité du châtiment sera indéniable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-jahimu su'irat » — et quand la Fournaise sera attisée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains l'enfer ? La réalité viendra pour tous." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Fournaise attisée est le résultat des péchés accumulés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoignera de la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur de l'enfer maintenant protège de l'enfer plus tard." }
  ],
  munajat: `Ya Rabb, la Fournaise sera attisée. Protège-moi de Ton châtiment. Fais que ma crainte maintenant me sauve plus tard.`
};

MIROIR["81:13"] = {
  reference: "81:13",
  theme: ["paradis", "proximité", "révélation"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Uzlf"],
  mirrorVersion: `« Et quand le Paradis sera approché. » Le miroir ajoute : « Wa idha al-jannatu uzlifat » — et quand le Paradis sera approché, rapproché. Le Paradis sera visible et accessible pour les croyants. Le miroir m'enseigne : la récompense sera manifeste — l'espoir deviendra réalité.`,
  reflection: `Le Paradis sera visible. L'espoir des croyants sera réalisé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-jannatu uzlifat » — et quand le Paradis sera approché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère le Paradis ? Sa vue sera ma plus grande joie." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis approché est le résultat des bonnes œuvres accumulées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoignera de la miséricorde divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'espoir du Paradis maintenant mène au Paradis plus tard." }
  ],
  munajat: `Ya Rabb, le Paradis sera approché. Fais que je le voie et y entre. Mon espoir est en Toi et Ta miséricorde.`
};

MIROIR["81:14"] = {
  reference: "81:14",
  theme: ["connaissance", "âme", "certitude"],
  emotion: "Certitude, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Nafs"],
  mirrorVersion: `« Chaque âme saura ce qu'elle a présenté. » Le miroir conclut la série : « 'Alimat nafsum ma ahrarat » — chaque âme saura ce qu'elle a présenté, avancé. Après toutes ces transformations cosmiques, chaque âme connaîtra son sort. Le miroir m'enseigne : la connaissance finale sera immédiate — pas besoin de jugement externe, l'âme se connaîtra.`,
  reflection: `Chaque âme connaîtra son sort. La connaissance sera intérieure et immédiate.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alimat nafsum ma ahrarat » — chaque âme saura ce qu'elle a présenté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai présenté ? Mon âme le sait déjà — le Jour le révélera." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'âme se connaît déjà — le Jour lève le voile sur cette connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création sera en parfaite connaissance de son état." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance de l'âme est la plus vraie — elle ne peut se mentir." }
  ],
  munajat: `Ya Rabb, mon âme sait ce qu'elle a présenté. Fais que ce soit bon. Ne permets pas que je me mente à moi-même.`
};

MIROIR["81:15"] = {
  reference: "81:15",
  theme: ["serment", "planètes", "mouvement"],
  emotion: "Révérence, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Aymam", "Al-Khunnas"],
  mirrorVersion: `« Non ! Je jure par les planètes qui se cachent. » Le miroir introduit un nouveau serment : « Fa-la uqsimu bil-khunnas » — Non ! Je jure par les planètes qui se cachent. Les khunnas sont les étoiles qui disparaissent le jour et réapparaissent la nuit. Le miroir m'enseigne : Allah jure par Sa création pour attester de la véracité du message.`,
  reflection: `Allah jure par les planètes. La création témoigne de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la uqsimu bil-khunnas » — Non ! Je jure par les planètes qui se cachent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les planètes qui se cachent et réapparaissent — comme la vérité se cache et se révèle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les planètes se cachent mais restent — la vérité peut se cacher mais existe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les étoiles témoignent de la grandeur d'Allah et de Sa vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le serment par les planètes renforce la certitude du message." }
  ],
  munajat: `Ya Rabb, Tu jures par les planètes. Fais que je sois certain de Ton message. Les étoiles témoignent de Ta vérité.`
};

MIROIR["81:16"] = {
  reference: "81:16",
  theme: ["serment", "cours", "disparition"],
  emotion: "Révérence, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Jawari", "Al-Khunnas"],
  mirrorVersion: `« Qui courent et disparaissent. » Le miroir continue : « Al-jawari al-khunnas » — qui courent (dans leurs orbites) et disparaissent (le jour). Les étoiles ont un mouvement constant mais deviennent invisibles. Le miroir m'enseigne : le mouvement et la disparition font partie du plan divin.`,
  reflection: `Les étoiles courent et disparaissent. Le mouvement et le mystère sont dans la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-jawari al-khunnas » — qui courent et disparaissent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon existence est comme une étoile — je cours puis je disparaîtrai." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La disparition n'est pas la fin — les étoiles réapparaissent chaque nuit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en mouvement constant — rien ne s'arrête." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La course et la disparition sont des métaphores de la vie et de la mort." }
  ],
  munajat: `Ya Rabb, les étoiles courent et disparaissent comme je cours et disparaîtrai. Fais que ma course soit vers Toi.`
};

MIROIR["81:17"] = {
  reference: "81:17",
  theme: ["serment", "nuit", "obscurité"],
  emotion: "Révérence, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-'As'as"],
  mirrorVersion: `« Et par la nuit quand elle s'étend. » Le miroir ajoute un autre serment : « Wa al-layli idha 'as'as » — et par la nuit quand elle s'étend, s'approche. La nuit qui avance est un signe de la régularité divine. Le miroir m'enseigne : les cycles de la création témoignent de l'Ordonnateur.`,
  reflection: `La nuit qui s'étend témoigne de l'ordre divin. Les cycles sont réguliers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-layli idha 'as'as » — et par la nuit quand elle s'étend." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La nuit qui avance — suis-je attentif aux signes quotidiens d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit s'étend puis le jour vient — les cycles témoignent de l'ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle jour-nuit est un signe constant de la régularité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La nuit qui s'étend rappelle que l'obscurité précède la lumière." }
  ],
  munajat: `Ya Rabb, la nuit s'étend comme Ton ordre s'étend sur l'univers. Fais que je voie les signes dans chaque cycle.`
};

MIROIR["81:18"] = {
  reference: "81:18",
  theme: ["serment", "aube", "respiration"],
  emotion: "Révérence, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Subh", "Al-Tanaffus"],
  mirrorVersion: `« Et par l'aube quand elle respiration. » Le miroir ajoute : « Wa al-subhi idha tanaffas » — et par l'aube quand elle respiration. L'aube « respire » — la lumière se répand doucement. Le miroir m'enseigne : chaque aube est une nouvelle respiration de la création.`,
  reflection: `L'aube respire — la lumière vient doucement. Chaque matin est un renouveau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-subhi idha tanaffas » — et par l'aube quand elle respiration." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remarque l'aube ? Chaque matin est un don d'Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aube qui respire annonce la vie qui revient — la résurrection quotidienne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube est la respiration de l'univers — le jour renaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque aube est une promesse de résurrection." }
  ],
  munajat: `Ya Rabb, l'aube respire Ta miséricorde. Fais que chaque matin soit un renouveau pour moi. L'aube annonce Ta lumière.`
};

MIROIR["81:19"] = {
  reference: "81:19",
  theme: ["révélation", "messager", "honneur"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Ar-Rasul"],
  mirrorVersion: `« C'est la parole d'un noble messager. » Le miroir révèle le sujet des serments : « Inna huwa qawlu rasulin karim » — c'est la parole d'un noble messager. Le Coran est la parole transmise par Jibril, le messager noble. Le miroir m'enseigne : le message a une origine noble — il mérite le plus grand respect.`,
  reflection: `Le Coran vient d'un messager noble. Sa source est divine et pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna huwa qawlu rasulin karim » — c'est la parole d'un noble messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite le Coran ? Il vient d'un messager noble." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse du messager reflète la noblesse du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges nobles transmettent les messages divins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Lire le Coran, c'est recevoir le message d'un messager noble." }
  ],
  munajat: `Ya Rabb, le Coran vient d'un messager noble. Fais que je l'honore comme il mérite. Sa noblesse m'élève.`
};

MIROIR["81:20"] = {
  reference: "81:20",
  theme: ["force", "trône", "obéissance"],
  emotion: "Révérence, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Quwwah", "Al-'Arsh"],
  mirrorVersion: `« Doué de force, établi auprès du Seigneur du Trône. » Le miroir décrit Jibril : « Dhi quwwatin 'inda dhi al-'arshi makim » — doué de force, établi auprès du Seigneur du Trône. Jibril a la force d'exécuter les ordres d'Allah et la position auprès du Trône. Le miroir m'enseigne : le messager a la force et la proximité.`,
  reflection: `Jibril a la force et la proximité. Il est le modèle du serviteur parfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhi quwwatin 'inda dhi al-'arshi makim » — doué de force, établi auprès du Seigneur du Trône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je la force d'obéir et la proximité d'Allah ? Jibril est mon modèle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force et la proximité vont ensemble — le fort est proche d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges forts exécutent les ordres divins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La force dans l'obéissance mène à la proximité du Trône." }
  ],
  munajat: `Ya Rabb, Jibril a la force et la proximité. Donne-moi la force d'obéir et la proximité de Toi. Il est mon modèle.`
};

MIROIR["81:21"] = {
  reference: "81:21",
  theme: ["obéissance", "confiance", "ange"],
  emotion: "Révérence, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Ta'ah", "Al-Amin"],
  mirrorVersion: `« Obéi là-haut, et digne de confiance. » Le miroir continue : « Mu'tamin fih amin » — obéi là-haut, et digne de confiance. Jibril est obéi par les autres anges et digne de confiance pour la révélation. Le miroir m'enseigne : le messager a l'autorité et la fiabilité.`,
  reflection: `Jibril est obéi et fiable. Sa parole est digne de confiance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mu'tamin fih amin » — obéi là-haut, et digne de confiance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je obéi pour le bien et digne de confiance ? Le messager est mon modèle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance et la confiance sont les marques du serviteur parfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges obéissent au plus noble d'entre eux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance est le fondement de toute mission divine." }
  ],
  munajat: `Ya Rabb, Jibril est obéi et digne de confiance. Fais que je sois fiable dans ma mission. Lui obéir, c'est T'obéir.`
};

MIROIR["81:22"] = {
  reference: "81:22",
  theme: ["compagnon", "vision", "honnêteté"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Sahib", "Al-Ru'ya"],
  mirrorVersion: `« Votre compagnon n'est pas fou. » Le miroir défend le Prophète : « Wa ma sahhibukum bi-majnun » — votre compagnon n'est pas fou. Les Mecquois accusaient le Prophète de folie. Le miroir m'enseigne : le Prophète est sain d'esprit — sa révélation est authentique.`,
  reflection: `Le Prophète n'est pas fou — sa révélation est vraie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma sahhibukum bi-majnun » — votre compagnon n'est pas fou." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défends la vérité quand elle est attaquée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de folie contre le Prophète est fausse — sa révélation est vraie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont souvent accusés de folie par ceux qui refusent la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La défense du Prophète est la défense de la vérité." }
  ],
  munajat: `Ya Rabb, Ton Prophète n'est pas fou. Fais que je le défende contre les accusations. Sa révélation est Ta vérité.`
};

MIROIR["81:23"] = {
  reference: "81:23",
  theme: ["vision", "horizon", "révélation"],
  emotion: "Certitude, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Ru'ya", "Al-Ufuq"],
  mirrorVersion: `« Il l'a vu à l'horizon clair. » Le miroir précise : « Wa laqad ra'ahu bil-ufuqi al-mubin » — il l'a vu à l'horizon clair. Le Prophète a vu Jibril sous sa forme réelle à l'horizon clair. Le miroir m'enseigne : la vision du messager confirme l'authenticité de la révélation.`,
  reflection: `Le Prophète a vu Jibril — la révélation est visuelle et réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ra'ahu bil-ufuqi al-mubin » — il l'a vu à l'horizon clair." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La révélation est réelle — pas une imagination. Je crois en ce que le Prophète a vu." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vision claire confirme la révélation claire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'horizon clair est le lieu de rencontre entre le céleste et le terrestre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vision du messager est la preuve de la réalité de la révélation." }
  ],
  munajat: `Ya Rabb, Ton Prophète a vu Jibril à l'horizon clair. Fais que je croie en cette vision. La révélation est réelle.`
};

MIROIR["81:24"] = {
  reference: "81:24",
  theme: ["secret", "révélation", "transparence"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Sirr", "Al-Wahy"],
  mirrorVersion: `« Il n'est pas avare du secret. » Le miroir continue : « Wa ma huwa 'ala al-ghaybi bi-danim » — il n'est pas avare du secret, il ne cache pas la révélation. Le Prophète transmet tout ce qu'il reçoit, sans rien garder pour lui. Le miroir m'enseigne : le messager est transparent — il transmet tout.`,
  reflection: `Le Prophète transmet tout ce qu'il reçoit. Il ne garde rien pour lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma huwa 'ala al-ghaybi bi-danim » — il n'est pas avare du secret." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transmets ce que je reçois ? Ou est-ce que je garde pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transparence du Prophète est le modèle pour tout messager." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation n'est pas un secret à garder mais un message à partager." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai messager ne garde rien pour lui — tout est pour Allah." }
  ],
  munajat: `Ya Rabb, Ton Prophète transmet tout. Fais que je sois transparent comme lui. Je ne garde rien pour moi.`
};

MIROIR["81:25"] = {
  reference: "81:25",
  theme: ["maudit", "satan", "protection"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Rajim", "Al-Shaytan"],
  mirrorVersion: `« Ce n'est pas la parole d'un démon maudit. » Le miroir précise : « Wa ma huwa bi-qawli shaytanim rajim » — ce n'est pas la parole d'un démon maudit. Le Coran n'est pas inspiré par Satan — il vient d'Allah. Le miroir m'enseigne : la source du message est pure.`,
  reflection: `Le Coran ne vient pas de Satan — il vient d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma huwa bi-qawli shaytanim rajim » — ce n'est pas la parole d'un démon maudit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je certain que la révélation vient d'Allah ? Sa pureté en témoigne." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté du message réfute l'origine satanique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les démons sont maudits et éloignés de la révélation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah protège Sa révélation de toute souillure." }
  ],
  munajat: `Ya Rabb, Ton Coran est pur de toute souillure satanique. Fais que je le reçoive comme Ta parole. Il est saint.`
};

MIROIR["81:26"] = {
  reference: "81:26",
  theme: ["destination", "chemin", "question"],
  emotion: "Réalité, interrogation",
  difficulty: "débutant",
  relatedNames: ["Al-Madhhab", "Al-Tariq"],
  mirrorVersion: `« Où allez-vous donc ? » Le miroir interroge : « Fa-ayna tadhhabun » — où allez-vous donc ? Cette question est posée à ceux qui refusent la révélation. Où allez-vous en vous détournant de la vérité ? Le miroir m'interroge : où vais-je quand je m'éloigne d'Allah ?`,
  reflection: `Où vais-je en me détournant d'Allah ? La question est pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ayna tadhhabun » — où allez-vous donc ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où vais-je ? Quel est mon but ? La question me concerne aussi." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se détourner d'Allah mène nulle part — retourner à Lui mène à tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création va vers Allah — seul l'être humain peut s'en détourner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La question « où allez-vous ? » contient la réponse : revenez à Allah." }
  ],
  munajat: `Ya Rabb, où vais-je sans Toi ? Fais que je retourne à Toi. La question est mon rappel constant.`
};

MIROIR["81:28"] = {
  reference: "81:28",
  theme: ["droit", "chemin", "volonté"],
  emotion: "Guidance, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Mustaqim", "Al-Iradah"],
  mirrorVersion: `« Pour celui d'entre vous qui veut suivre le chemin droit. » Le miroir précise : « Liman sha'a minkum an yastaqima » — pour celui d'entre vous qui veut suivre le chemin droit. La guidance est pour celui qui VEUT suivre le chemin droit. Le miroir m'enseigne : la volonté précède la guidance.`,
  reflection: `La guidance est pour celui qui veut. Ma volonté détermine ma direction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Liman sha'a minkum an yastaqima » — pour celui d'entre vous qui veut suivre le chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je VEUX vraiment suivre le chemin droit ? La guidance dépend de ma volonté." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté de se diriger droit précède la guidance sur le chemin droit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin droit est ouvert à tous — la porte est ouverte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La volonté est la clé — qui veut vraiment trouve la guidance." }
  ],
  munajat: `Ya Rabb, je veux suivre le chemin droit. Guide-moi. Ma volonté est de T'obéir. Ouvre-moi la voie.`
};

MIROIR["81:29"] = {
  reference: "81:29",
  theme: ["volonté", "Seigneur", "chemin"],
  emotion: "Soumission, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mashi'ah", "Al-Rabb"],
  mirrorVersion: `« Et vous ne pouvez le vouloir que si Allah le veut, le Seigneur des mondes. » Le miroir conclut : « Wa ma tasha'una illa an yasha'a Allahu rabbu al-'alamin » — et vous ne pouvez le vouloir que si Allah le veut. La volonté elle-même vient d'Allah. Le miroir m'enseigne : tout revient à Allah — même ma volonté de Le suivre.`,
  reflection: `Ma volonté vient d'Allah. Tout retourne à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma tasha'una illa an yasha'a Allahu rabbu al-'alamin » — vous ne pouvez le vouloir que si Allah le veut, le Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que même ma volonté vient d'Allah ? Tout est grâce." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté humaine dépend de la volonté divine — mais la responsabilité reste humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute volonté dans l'univers est soumise à la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Demander à Allah de vouloir pour moi — c'est le secret de la guidance." }
  ],
  munajat: `Ya Rabb, fais que je veuille ce que Tu veux. Ma volonté est entre Tes mains. Je Te demande de me guider vers le droit chemin.`
};

// ==================== SURAH 82: AL-INFITAR - MISSING VERSES ====================

MIROIR["82:2"] = {
  reference: "82:2",
  theme: ["étoiles", "dispersion", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Nujum", "Al-Intithar"],
  mirrorVersion: `« Et quand les étoiles se disperseront. » Le miroir continue : « Wa idha al-nujumu intatharat » — et quand les étoiles se disperseront. Les étoiles, qui semblent fixes, seront éparpillées. Le miroir m'enseigne : même le cosmos sera bouleversé — rien n'est permanent.`,
  reflection: `Les étoiles seront dispersées. L'ordre cosmique sera rompu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-nujumu intatharat » — et quand les étoiles se disperseront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui semble « fixe » dans ma vie ? Tout sera dispersé." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispersion des étoiles marque la fin de l'ordre connu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ordonné sera désordonné — le chaos précède la nouvelle création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La dispersion des étoiles rappelle que tout est fragile sauf Allah." }
  ],
  munajat: `Ya Rabb, les étoiles seront dispersées. Fais que je ne m'attache à rien de ce monde. Seul Tu es permanent.`
};

MIROIR["82:3"] = {
  reference: "82:3",
  theme: ["mers", "débordement", "fin"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Bihar", "Al-Fujur"],
  mirrorVersion: `« Et quand les mers seront débordées. » Le miroir ajoute : « Wa idha al-biharu fujirat » — et quand les mers seront débordées, ouvertes. Les mers, contenues par leurs rives, déborderont de toute part. Le miroir m'enseigne : les limites seront abolies — les frontières disparaîtront.`,
  reflection: `Les mers déborderont. Les limites seront abolies.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-biharu fujirat » — et quand les mers seront débordées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles « limites » je considère comme immuables ? Tout sera débordé." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les mers débordent — les frontières entre les mondes disparaissent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les océans débordés marquent la fin de la terre connue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le débordement des mers préfigure le débordement de la justice." }
  ],
  munajat: `Ya Rabb, les mers déborderont. Fais que je sois prêt pour ce débordement. Les limites de ce monde tomberont.`
};

MIROIR["82:4"] = {
  reference: "82:4",
  theme: ["tombeaux", "renversés", "résurrection"],
  emotion: "Espérance, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qubur", "Al-Ba'th"],
  mirrorVersion: `« Et quand les tombeaux seront renversés. » Le miroir continue : « Wa idha al-quburu bu'thirat » — et quand les tombeaux seront renversés, dispersés. Les morts sortiront de leurs tombeaux. Le miroir m'enseigne : la mort n'est pas la fin — la résurrection vient.`,
  reflection: `Les tombeaux seront renversés. Les morts ressusciteront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-quburu bu'thirat » — et quand les tombeaux seront renversés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à sortir de mon tombeau ? La résurrection vient pour tous." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tombeau renversé libère son occupant — la mort n'est pas éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre elle-même libérera ses morts — tout sera révélé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La résurrection est la promesse d'Allah — le tombeau n'est qu'un passage." }
  ],
  munajat: `Ya Ba'ith, les tombeaux seront renversés. Fais que je sois prêt pour la résurrection. La mort n'est pas la fin.`
};

MIROIR["82:5"] = {
  reference: "82:5",
  theme: ["connaissance", "avance", "retard"],
  emotion: "Certitude, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Qaddam"],
  mirrorVersion: `« Chaque âme saura ce qu'elle a avancé et retardé. » Le miroir précise : « 'Alimat nafsun ma qaddamat wa akhkharat » — chaque âme saura ce qu'elle a avancé et retardé. Au Jour, chaque âme connaîtra ses œuvres — les bonnes et les mauvaises. Le miroir m'interroge : qu'est-ce que j'ai avancé ? Qu'est-ce que j'ai retardé ?`,
  reflection: `Chaque âme connaîtra ses œuvres. Le bilan sera clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alimat nafsun ma qaddamat wa akhkharat » — chaque âme saura ce qu'elle a avancé et retardé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai avancé de bon ? Qu'est-ce que j'ai retardé de bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avance et le retard sont connus — le compte sera fait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action est enregistrée — rien n'est oublié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance de mes œuvres est déjà là — le Jour la révèle." }
  ],
  munajat: `Ya Rabb, fais que j'aie avancé du bien et non du mal. Fais que je n'aie rien retardé de bon. Mon compte sera clair.`
};

MIROIR["82:7"] = {
  reference: "82:7",
  theme: ["créateur", "forme", "équité"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Qui t'a créé puis t'a donné forme et t'a fait proportionné. » Le miroir répond : « Alladhi khalaqaka fasawwaka fa'adala » — qui t'a créé puis t'a donné forme et t'a fait proportionné. Allah est le Créateur qui forme et équilibre. Le miroir m'enseigne : ma création est un miracle d'équilibre.`,
  reflection: `Ma création est un miracle. Allah m'a formé avec équilibre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi khalaqaka fasawwaka fa'adala » — qui t'a créé puis t'a donné forme et t'a fait proportionné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le miracle de ma création ? Chaque partie est équilibrée." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création équilibrée demande une reconnaissance équilibrée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est proportionnée — l'équilibre est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'équilibre de ma forme reflète l'équilibre que je devrais avoir dans ma vie." }
  ],
  munajat: `Ya Musawwir, Tu m'as créé avec équilibre. Fais que ma vie soit équilibrée. Ma forme est Ton miracle.`
};

MIROIR["82:8"] = {
  reference: "82:8",
  theme: ["forme", "diversité", "création"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Surah", "Al-Khalq"],
  mirrorVersion: `« Sous la forme qu'Il a voulue. » Le miroir ajoute : « Fi ayyi suratin ma sha'a rakkaba » — sous la forme qu'Il a voulue, Il t'a composé. Ma forme est le choix d'Allah. Le miroir m'enseigne : je suis comme Allah m'a voulu — je dois accepter et remercier.`,
  reflection: `Ma forme est le choix d'Allah. Je dois accepter et remercier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi ayyi suratin ma sha'a rakkaba » — sous la forme qu'Il a voulue, Il t'a composé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma forme ? Elle est le choix d'Allah pour moi." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La forme voulue par Allah est la meilleure forme — la gratitude s'impose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa forme voulue par Allah — la diversité est voulue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Accepter sa forme est le premier pas vers la paix avec soi-même." }
  ],
  munajat: `Ya Musawwir, Tu m'as formé comme Tu as voulu. Fais que j'accepte et remercie. Ma forme est Ton choix.`
};

MIROIR["82:9"] = {
  reference: "82:9",
  theme: ["mensonge", "récompense", "réalité"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kadhib", "Al-Din"],
  mirrorVersion: `« Non ! Mais vous traitez de mensonge la rétribution. » Le miroir avertit : « Kalla bal tukadhdhibuna bil-din » — non ! Mais vous traitez de mensonge la rétribution, le Jugement. Le problème n'est pas l'oubli du Créateur — c'est le déni du Jugement. Le miroir m'avertit : nier le Jugement a des conséquences.`,
  reflection: `Nier le Jugement est le problème. La rétribution est réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla bal tukadhdhibuna bil-din » — non ! Mais vous traitez de mensonge la rétribution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment au Jugement ? Ou est-ce que je le nie par ma conduite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Traiter de mensonge le Jugement transforme la vie en fuite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne du Jugement à venir — chaque chose a son terme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Croire au Jugement transforme chaque action — nier conduit à l'inconscience." }
  ],
  munajat: `Ya Rabb, je crois au Jugement. Ne permets pas que je le nie par ma conduite. La rétribution est réelle.`
};

MIROIR["82:10"] = {
  reference: "82:10",
  theme: ["gardiens", "anges", "surveillance"],
  emotion: "Conscience, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hafazah", "Al-Mala'ikah"],
  mirrorVersion: `« Et il y a des gardiens sur vous. » Le miroir révèle : « Wa inna 'alaykum la-hafizin » — et il y a des gardiens sur vous. Des anges enregistrent chaque action. Le miroir m'enseigne : rien n'échappe — tout est noté.`,
  reflection: `Des anges gardiens enregistrent chaque action. Rien n'échappe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna 'alaykum la-hafizin » — et il y a des gardiens sur vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience des anges gardiens ? Ils notent tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les gardiens invisibles voient l'invisible — mes intentions comme mes actions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sous surveillance — rien n'est caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La présence des anges gardiens devrait inspirer la conscience constante." }
  ],
  munajat: `Ya Rabb, les anges gardiens notent tout. Fais que mes actions soient dignes d'être notées. Leur présence m'inspire.`
};

MIROIR["82:11"] = {
  reference: "82:11",
  theme: ["anges", "nobles", "écriture"],
  emotion: "Révérence, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Kiram", "Al-Katibun"],
  mirrorVersion: `« Des scribes nobles. » Le miroir précise : « Kiraman katibin » — des scribes nobles. Les anges qui écrivent sont nobles — ils méritent le respect. Le miroir m'enseigne : mes actions sont enregistrées par des êtres nobles.`,
  reflection: `Des anges nobles écrivent mes actions. Je dois être digne de leur présence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kiraman katibin » — des scribes nobles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que les anges nobles écrivent sur moi ? Mes actions les concernent." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse des scribes reflète l'importance de ce qu'ils écrivent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges nobles sont présents pour chaque créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'honneur d'avoir des anges nobles comme témoins exige des actions honorables." }
  ],
  munajat: `Ya Rabb, les anges nobles écrivent mes actions. Fais que ce qu'ils écrivent soit bon. Leur noblesse m'élève.`
};

MIROIR["82:12"] = {
  reference: "82:12",
  theme: ["connaissance", "action", "secret"],
  emotion: "Conscience, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Fi'l"],
  mirrorVersion: `« Qui savent ce que vous faites. » Le miroir précise : « Ya'lamuna ma taf'alun » — qui savent ce que vous faites. Les anges connaissent mes actions. Le miroir m'enseigne : je ne suis jamais seul — mes actions sont vues.`,
  reflection: `Les anges voient mes actions. Je ne suis jamais seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamuna ma taf'alun » — qui savent ce que vous faites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais en pensant être seul ? Les anges voient tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La solitude n'existe pas — les anges sont toujours présents." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action est vue — l'univers est transparent à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La présence des anges devrait transformer chaque moment en acte de conscience." }
  ],
  munajat: `Ya Rabb, les anges voient tout ce que je fais. Fais que mes actions soient pures. Je ne suis jamais seul.`
};

MIROIR["82:13"] = {
  reference: "82:13",
  theme: ["vertueux", "délices", "récompense"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Abrar", "Al-Na'im"],
  mirrorVersion: `« Les vertueux seront dans les délices. » Le miroir promet : « Inna al-abrara la-fi na'im » — les vertueux seront dans les délices. Les abrar — ceux qui font le bien — seront dans le bonheur. Le miroir m'invite à aspirer à cette récompense.`,
  reflection: `Les vertueux seront dans les délices. Le bien mène au bonheur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-abrara la-fi na'im » — les vertueux seront dans les délices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les vertueux ? Mon sort dépend de mes œuvres." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu dans ce monde mène aux délices dans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bonheur éternel attend ceux qui font le bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les délices promis commencent ici par la paix du cœur vertueux." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les vertueux. Les délices m'attendent si je fais le bien. Guide-moi vers la vertu.`
};

MIROIR["82:14"] = {
  reference: "82:14",
  theme: ["pervers", "enfer", "châtiment"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Fujjar", "Al-Jahim"],
  mirrorVersion: `« Et les pervers dans la Fournaise. » Le miroir avertit : « Wa inna al-fujjara la-fi jahim » — et les pervers seront dans la Fournaise. Les fujjar — ceux qui font le mal — seront dans le feu. Le miroir m'avertit : le mal mène au châtiment.`,
  reflection: `Les pervers seront dans la Fournaise. Le mal mène au châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna al-fujjara la-fi jahim » — et les pervers seront dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je en danger d'être parmi les pervers ? Le mal a des conséquences." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perversité dans ce monde mène à la Fournaise dans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine distingue le vertueux du pervers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Éviter la perversité maintenant sauve de la Fournaise plus tard." }
  ],
  munajat: `Ya Rabb, protège-moi de la perversité. La Fournaise attend ceux qui font le mal. Guide-moi vers la vertu.`
};

MIROIR["82:15"] = {
  reference: "82:15",
  theme: ["brûlement", "jour", "jugement"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-Su'ir"],
  mirrorVersion: `« Ils y brûleront le Jour de la Rétribution. » Le miroir précise : « Yaslawnahum yawm al-din » — ils y brûleront le Jour de la Rétribution. Le châtiment est pour le Jour du Jugement. Le miroir m'enseigne : le compte vient — le châtiment suit.`,
  reflection: `Le châtiment vient au Jour de la Rétribution. Le compte sera fait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaslawnahum yawm al-din » — ils y brûleront le Jour de la Rétribution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le Jour vient. Mon sort dépend de mes actions maintenant." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le brûlement éternel est la conséquence des mauvaises actions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour de la Rétribution est le jour de la justice complète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du Jour transforme chaque action présente." }
  ],
  munajat: `Ya Rabb, le Jour de la Rétribution vient. Fais que je sois épargné du brûlement. Mon compte sera bon.`
};

MIROIR["82:16"] = {
  reference: "82:16",
  theme: ["absence", "écart", "jugement"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghayb", "Al-Fawq"],
  mirrorVersion: `« Et ils ne peuvent s'en écarter. » Le miroir précise : « Wa ma hum 'anha bi-gha'ibin » — et ils ne peuvent s'en écarter, ils ne peuvent y échapper. Le châtiment est inévitable pour les pervers. Le miroir m'enseigne : la justice d'Allah est certaine.`,
  reflection: `Le châtiment est inévitable pour les pervers. La justice est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma hum 'anha bi-gha'ibin » — et ils ne peuvent s'en écarter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Il n'y a pas d'échappatoire — sauf le repentir maintenant." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité d'échapper rend le repentir urgent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah atteint tous les coupables." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'échappatoire est le repentir — maintenant, pas après." }
  ],
  munajat: `Ya Rabb, il n'y a pas d'échappatoire sauf le repentir. Fais que je me repente maintenant. La justice est certaine.`
};

MIROIR["82:17"] = {
  reference: "82:17",
  theme: ["jugement", "rétribution", "question"],
  emotion: "Réalité, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Jaza'"],
  mirrorVersion: `« Et qu'est-ce qui te fera connaître le Jour de la Rétribution ? » Le miroir interroge : « Wa ma adraka ma yawm al-din » — et qu'est-ce qui te fera connaître le Jour de la Rétribution ? Cette question souligne l'importance et la gravité du Jour. Le miroir m'invite à méditer sur la réalité du Jugement.`,
  reflection: `Le Jour de la Rétribution est d'une importance capitale. Médite sur sa réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma yawm al-din » — et qu'est-ce qui te fera connaître le Jour de la Rétribution ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise vraiment la gravité du Jour ? La question m'interpelle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question « qu'est-ce qui te fera connaître » souligne l'immensité du Jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera bouleversé ce Jour-là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Connaître le Jour par la méditation transforme la vie présente." }
  ],
  munajat: `Ya Rabb, fais-moi connaître le Jour de la Rétribution. La méditation sur ce Jour transforme ma vie. Il est immense.`
};

MIROIR["82:18"] = {
  reference: "82:18",
  theme: ["répétition", "jugement", "importance"],
  emotion: "Réalité, emphase",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Takra"],
  mirrorVersion: `« Encore une fois, qu'est-ce qui te fera connaître le Jour de la Rétribution ? » Le miroir répète : « Thumma ma adraka ma yawm al-din » — encore une fois, qu'est-ce qui te fera connaître le Jour de la Rétribution ? La répétition souligne l'importance. Le miroir m'enseigne : ce Jour est si important qu'il mérite d'être répété.`,
  reflection: `La répétition souligne l'importance du Jour. Médite encore.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ma adraka ma yawm al-din » — encore une fois, qu'est-ce qui te fera connaître le Jour de la Rétribution ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La répétition m'interpelle — je dois méditer encore sur ce Jour." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition n'est pas redondance — c'est emphase sur l'essentiel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'importance du Jour mérite d'être soulignée par la répétition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Méditer deux fois sur le Jour double la conscience." }
  ],
  munajat: `Ya Rabb, la répétition me fait méditer encore. Le Jour est si important. Fais que je le prenne au sérieux.`
};

MIROIR["82:19"] = {
  reference: "82:19",
  theme: ["pouvoir", "âme", "jugement"],
  emotion: "Soumission, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mulk", "Al-Nafs"],
  mirrorVersion: `« Ce jour-là, aucune âme ne pourra rien pour une autre. » Le miroir conclut : « Yawma la tamliku nafsun li-nafsin shay'an » — ce jour-là, aucune âme ne pourra rien pour une autre. Le commandement appartient à Allah seul. Le miroir m'enseigne : l'intercession vient d'Allah seul.`,
  reflection: `Nul ne peut aider nul autre — sauf par la permission d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma la tamliku nafsun li-nafsin shay'an » — ce jour-là, aucune âme ne pourra rien pour une autre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur qui compte-je ? Ce Jour, je serai seul — sauf la miséricorde d'Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance des uns envers les autres souligne la puissance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour, toutes les créatures sont égales dans leur impuissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'impuissance humaine ce Jour révèle la puissance divine." }
  ],
  munajat: `Ya Rabb, ce Jour je serai seul et impuissant. Fais que je compte sur Toi seul. Ta miséricorde est mon seul espoir.`
};

MIROIR["81:4"] = {
  reference: "81:4",
  theme: ["chamelles", "négligence", "fin"],
  emotion: "Questionnement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ishar", "Al-Mutarrakah"],
  mirrorVersion: `« Et quand les chamelles pleines seront négligées. » Le miroir continue : « Wa idha al-'isharu 'uttilat » — et quand les chamelles pleines seront négligées. Les chamelles pleines étaient parmi les biens les plus précieux des Arabes. Leur négligence montre l'effondrement des valeurs matérielles. Le miroir m'interroge : quels biens précieux deviendront sans valeur ?`,
  reflection: `Les biens les plus précieux seront abandonnés. La valeur réelle est ailleurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-'isharu 'uttilat » — et quand les chamelles pleines seront négligées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère précieux maintenant mais qui sera négligé alors ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négligence des chamelles montre la fin de l'importance matérielle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les richesses seront abandonnées — personne ne les voudra plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie richesse est ce qui compte le Jour — pas ce qui compte maintenant." }
  ],
  munajat: `Ya Rabb, les richesses seront abandonnées. Fais que j'investisse dans ce qui compte vraiment. Donne-moi la vraie richesse.`
};

MIROIR["81:5"] = {
  reference: "81:5",
  theme: ["bêtes", "rassemblement", "fin"],
  emotion: "Émerveillement, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Wuhush", "Al-Jami'"],
  mirrorVersion: `« Et quand les bêtes sauvages seront rassemblées. » Le miroir ajoute : « Wa idha al-wuhushu hushirat » — et quand les bêtes sauvages seront rassemblées. Le rassemblement des bêtes suggère la justice entre les créatures. Le miroir m'enseigne : la justice d'Allah englobe toute la création — même les animaux auront leur compte.`,
  reflection: `Toute la création sera rassemblée. La justice d'Allah est universelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-wuhushu hushirat » — et quand les bêtes sauvages seront rassemblées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si les bêtes sont rassemblées pour la justice, que dire des humains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bêtes innocentes seront récompensées — les humains coupables seront jugés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah couvre chaque créature — rien n'est oublié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rassemblement des bêtes nous rappelle notre propre rassemblement." }
  ],
  munajat: `Ya Rabb, toute la création sera rassemblée. Fais que je sois prêt pour mon rassemblement. Ta justice est parfaite.`
};

MIROIR["81:6"] = {
  reference: "81:6",
  theme: ["mers", "embrasement", "fin"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Bihar", "Al-Masjurah"],
  mirrorVersion: `« Et quand les mers seront embrasées. » Le miroir continue : « Wa idha al-biharu sujjirat » — et quand les mers seront embrasées. L'image est terrifiante : les océans, symboles de fraîcheur et de profondeur, deviendront du feu. Le miroir m'enseigne : la transformation de la fin atteindra chaque élément de la création.`,
  reflection: `Les mers deviendront feu. La transformation sera totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-biharu sujjirat » — et quand les mers seront embrasées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si les mers deviennent feu, qu'est-ce qui restera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau devient feu — la fraîcheur devient chaleur brûlante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les éléments mêmes seront transformés — l'eau en feu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Seul Allah restera — tout autre que Lui sera transformé." }
  ],
  munajat: `Ya Rabb, les mers deviendront feu. Fais que je m'attache à Toi seul, le Seul qui ne change pas.`
};

MIROIR["81:7"] = {
  reference: "81:7",
  theme: ["âmes", "union", "corps"],
  emotion: "Espoir, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Arwah", "Al-Ba'ith"],
  mirrorVersion: `« Et quand les âmes seront accouplées. » Le miroir ajoute : « Wa idha al-nufusu zuwwijat » — et quand les âmes seront accouplées. Le couplage des âmes peut signifier la réunion avec les corps pour la résurrection, ou le regroupement par affinité. Le miroir m'enseigne : la résurrection est une réunion — corps et âme, ou âmes semblables.`,
  reflection: `Les âmes seront réunies. La résurrection est un rassemblement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-nufusu zuwwijat » — et quand les âmes seront accouplées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui mon âme sera-t-elle accouplée ? Les justes avec les justes ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "L'accouplement des âmes révèle les vraies affinités." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme trouvera sa place — parmi les siens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compagnie dans l'au-delà reflète la compagnie dans la vie." }
  ],
  munajat: `Ya Rabb, réunis mon âme avec les justes. Fais que ma compagnie maintenant soit celle que je veux pour l'éternité.`
};

MIROIR["81:8"] = {
  reference: "81:8",
  theme: ["fille", "enterrement", "question"],
  emotion: "Justice, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Maw'udah", "Al-'Adl"],
  mirrorVersion: `« Et quand la fille enterrée vivante sera interrogée. » Le miroir évoque une pratique barbare : « Wa idha al-maw'udatu su'ilat » — et quand la fille enterrée vivante sera interrogée. L'interrogatoire de la victime innocente annonce la justice. Le miroir m'enseigne : aucune injustice ne sera oubliée — même les victimes anonymes auront leur jour.`,
  reflection: `Les victimes innocentes seront entendues. La justice d'Allah est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-maw'udatu su'ilat » — et quand la fille enterrée vivante sera interrogée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles injustices ignore-je ? Quelles victimes sans voix attendent la justice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victime devenue juge — l'opprimé de devenu interrogateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute injustice sera jugée — aucune victime ne sera oubliée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La question à la victime annonce la condamnation du bourreau." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Fais que les victimes sans voix soient entendues. Ta justice est parfaite — rien n'est oublié.`
};

MIROIR["81:9"] = {
  reference: "81:9",
  theme: ["péché", "question", "raison"],
  emotion: "Justice, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Su'al"],
  mirrorVersion: `« Pour quel péché a-t-elle été tuée. » Le miroir continue : « Bi-ayyi dhanbin qutilat » — pour quel péché a-t-elle été tuée ? La question est rhétorique — elle n'avait commis aucun péché. Son seul « crime » était d'être née fille. Le miroir m'enseigne : la justice d'Allah expose l'injustice des hommes.`,
  reflection: `La question expose l'absurdité du crime. Aucune justification ne tiendra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-ayyi dhanbin qutilat » — pour quel péché a-t-elle été tuée ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles questions serai-je incapable de répondre le Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question sans réponse condamne celui qui l'a fait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine pose les questions que les hommes refusent de poser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La victime innocente pose la question qui juge le coupable." }
  ],
  munajat: `Ya Rabb, Tu poses les questions que les hommes évitent. Fais que je sois du côté de la justice. Fais que je n'aie pas de questions sans réponse.`
};

MIROIR["81:10"] = {
  reference: "81:10",
  theme: ["feuilles", "publication", "révélation"],
  emotion: "Réalité, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Suhuf", "Al-Manshurah"],
  mirrorVersion: `« Et quand les feuilles seront publiées. » Le miroir ajoute : « Wa idha al-suhufu nushirat » — et quand les feuilles seront publiées. Les feuilles des œuvres seront déployées, publiées, rendues visibles. Rien ne restera caché. Le miroir m'enseigne : chaque action est inscrite — et sera révélée.`,
  reflection: `Les feuilles des œuvres seront publiées. Tout sera révélé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-suhufu nushirat » — et quand les feuilles seront publiées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mes feuilles révèleront ? Suis-je prêt pour la publication ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui était caché sera publié — le secret deviendra public." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action est inscrite — le Jour, tout sera lu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme si ses feuilles étaient publiées n'a pas peur de la publication." }
  ],
  munajat: `Ya Rabb, mes œuvres seront publiées. Fais que je vive en sachant que tout est inscrit. Purifie mes feuilles avant la publication.`
};

MIROIR["81:11"] = {
  reference: "81:11",
  theme: ["ciel", "dépouillement", "révélation"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Sama", "Al-Kashf"],
  mirrorVersion: `« Et quand le ciel sera dépouillé. » Le miroir continue : « Wa idha al-sama'u kushitat » — et quand le ciel sera dépouillé, écorché. Le dépouillement du ciel révèle ce qui était caché derrière. Le miroir m'enseigne : les voiles seront levés — l'invisible deviendra visible.`,
  reflection: `Le ciel sera dépouillé. L'invisible sera révélé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-sama'u kushitat » — et quand le ciel sera dépouillé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache derrière mes « ciels » ? Qu'est-ce qui sera révélé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le dépouillement révèle la réalité nue — sans ornement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel cache ce qui est au-delà — son dépouillement révèle le divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a levé les voiles de son cœur n'a pas peur du dépouillement." }
  ],
  munajat: `Ya Rabb, le ciel sera dépouillé et tout sera révélé. Purifie ce qui doit être révélé de moi. Fais que je n'aie rien à cacher.`
};

MIROIR["81:12"] = {
  reference: "81:12",
  theme: ["enfer", "allumage", "réalité"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Nar"],
  mirrorVersion: `« Et quand la Fournaise sera attisée. » Le miroir ajoute : « Wa idha al-jahimu su''irat » — et quand la Fournaise sera attisée, allumée avec intensité. L'enfer n'est pas une possibilité abstraite — il est une réalité qui sera attisée le Jour. Le miroir m'avertit : ne minimisez pas la réalité du châtiment.`,
  reflection: `La Fournaise sera attisée. La réalité du châtiment est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-jahimu su''irat » — et quand la Fournaise sera attisée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux la réalité de la Fournaise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attisement de la Fournaise est proportionné aux crimes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu de l'enfer attend ceux qui l'ont mérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur de la Fournaise maintenant protège de l'attisement alors." }
  ],
  munajat: `Ya Rabb, la Fournaise sera attisée. Protège-moi du feu. Fais que ma vie me préserve de l'enfer.`
};

MIROIR["81:13"] = {
  reference: "81:13",
  theme: ["paradis", "proximité", "réalité"],
  emotion: "Espoir, anticipation",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Muqtarabah"],
  mirrorVersion: `« Et quand le Paradis sera approché. » Le miroir contraste : « Wa idha al-jannatu uzlifat » — et quand le Paradis sera approché, rapproché. Le paradis n'est pas une récompense lointaine — il sera approché, rendu proche. Le miroir m'enseigne : l'espoir du paradis est aussi réel que la peur de l'enfer.`,
  reflection: `Le Paradis sera approché. L'espoir des croyants sera concrétisé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-jannatu uzlifat » — et quand le Paradis sera approché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère le Paradis comme je crains l'enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis approché est la récompense de la foi approchée dans la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis attend ceux qui l'ont mérité — et il vient vers eux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'espoir du Paradis maintenant prépare sa proximité alors." }
  ],
  munajat: `Ya Rabb, le Paradis sera approché. Fais que je sois parmi ceux pour qui il se rapproche. Donne-moi l'espoir qui prépare.`
};

MIROIR["81:14"] = {
  reference: "81:14",
  theme: ["certitude", "âme", "connaissance"],
  emotion: "Clarté, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Yaqin", "Al-'Ilm"],
  mirrorVersion: `« Chaque âme saura ce qu'elle a présenté. » Le miroir conclut cette série : « 'Alimat nafsun ma ahrarat » — chaque âme saura ce qu'elle a présenté. La connaissance sera immédiate, sans besoin de preuve. Chacun verra clairement ce qu'il a avancé pour son salut. Le miroir m'interroge : qu'est-ce que j'avance pour mon âme ?`,
  reflection: `Chaque âme connaîtra ses œuvres. La clarté sera totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alimat nafsun ma ahrarat » — chaque âme saura ce qu'elle a présenté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai présenté pour mon âme ? Qu'est-ce que j'avance vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance immédiate remplace les excuses." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour, les illusions se dissipent — la vérité nue apparaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se connaît maintenant n'a pas peur de se connaître alors." }
  ],
  munajat: `Ya Rabb, je saurai ce que j'ai présenté. Fais que je présente ce qui compte. Prépare-moi pour cette connaissance.`
};

// ==================== SURAH 6 (AL-AN'AM) - MISSING VERSES 83-165 ====================

MIROIR["6:83"] = {
  reference: "6:83",
  theme: ["argument", "ibrahim", "tawhid"],
  emotion: "Conviction, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Burhan", "Ibrahim"],
  mirrorVersion: `« Tel est l'argument que Nous donnâmes à Abraham contre son peuple. » Le miroir me montre la puissance du raisonnement spirituel. « Wa tilka hujjatunaa aataynaaha ibraheema 'alaa qawmih » — tel est l'argument que Nous donnâmes à Abraham contre son peuple. Abraham a débattu avec son peuple au sujet de l'unicité d'Allah, utilisant la logique et l'observation des signes cosmiques. Le miroir m'enseigne que la foi n'est pas aveugle — elle est fondée sur la preuve et la réflexion.`,
  reflection: `La foi d'Abraham était raisonnée. L'argument contre l'idolâtrie vient de l'observation de la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tilka hujjatunaa aataynaaha ibraheema 'alaa qawmih » — tel est l'argument que Nous donnâmes à Abraham contre son peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel argument ai-je pour ma foi ? Est-ce que je réfléchis ou est-ce que je suis aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argument d'Abraham renverse l'idolâtrie — le soleil qui se couche n'est pas dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un argument pour l'unicité d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'argument du cœur est plus puissant que l'argument de la langue." }
  ],
  munajat: `Ya Rabb, donne-moi l'argument de la vérité. Fais que ma foi soit raisonnée comme celle d'Abraham. L'unicité est ma conviction.`
};

MIROIR["6:84"] = {
  reference: "6:84",
  theme: ["bénédiction", "prophètes", "lignée"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Ishaq", "Ya'qub"],
  mirrorVersion: `« Et Nous lui donnâmes Isaac et Jacob. » Le miroir me montre la bénédiction de la descendance. « Wa wahabnaa lahu ishaqa wa ya'qoob » — et Nous lui donnâmes Isaac et Jacob. La lignée prophétique continue. Abraham a reçu non seulement un fils, mais une lignée de prophètes. Le miroir m'enseigne que la bénédiction d'Allah s'étend au-delà de l'individu vers les générations futures.`,
  reflection: `La bénédiction d'Allah s'étend aux générations. La descendance d'Abraham est bénie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabnaa lahu ishaqa wa ya'qoob » — et Nous lui donnâmes Isaac et Jacob." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle bénédiction ai-je reçue ? Est-ce que je la transmets aux générations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bénédiction reçue appelle la gratitude — la gratitude attire plus de bénédictions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers bénit la descendance des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La meilleure descendance est celle qui continue la foi." }
  ],
  munajat: `Ya Wahhab, merci pour Tes bénédictions. Fais que je sois une source de bénédiction pour les générations. La foi est mon héritage.`
};

MIROIR["6:85"] = {
  reference: "6:85",
  theme: ["guidance", "prophètes", "élus"],
  emotion: "Révérence, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Nuh", "Dawud", "Sulayman"],
  mirrorVersion: `« Et Noé, Nous l'avons guidé auparavant. » Le miroir me montre la continuité de la guidance. « Wa noohan hadaynaa min qabl » — et Noé, Nous l'avons guidé auparavant. La guidance précède Abraham. Noé a été guidé, Abraham a été guidé, et la chaîne continue. « Wa min dhurriyyatihi dawooda wa sulaymaan » — et de sa descendance, David et Salomon. Le miroir m'enseigne que la guidance est un fil qui traverse l'histoire.`,
  reflection: `La guidance traverse les générations. Chaque prophète reçoit la lumière d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa noohan hadaynaa min qabl wa min dhurriyyatihi dawooda wa sulaymaan » — et Noé, Nous l'avons guidé auparavant. Et de sa descendance, David et Salomon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'inscris dans la chaîne de la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance n'est pas nouvelle — elle est éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la guidance de son Créateur depuis toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance rejoint la chaîne des guidés." }
  ],
  munajat: `Ya Hadi, guide-moi comme Tu as guidé les prophètes. Fais que je sois un maillon de la chaîne de la lumière. La guidance est mon chemin.`
};

MIROIR["6:86"] = {
  reference: "6:86",
  theme: ["prophètes", "élus", "guidance"],
  emotion: "Respect, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ayyub", "Yusuf", "Musa", "Harun"],
  mirrorVersion: `« Et Job, Joseph, Moïse et Aaron. » Le miroir me montre la diversité des prophètes. « Wa ayyooba wa yoosefa wa moosaa wa haroon » — et Job, Joseph, Moïse et Aaron. Chaque prophète a son histoire, son épreuve, sa mission. Job a enduré la souffrance, Joseph a traversé la trahison et la prison, Moïse a affronté Pharaon. Le miroir m'enseigne que la prophétie prend des formes variées.`,
  reflection: `Chaque prophète a sa mission unique. La diversité des prophètes montre la richesse de la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ayyooba wa yoosefa wa moosaa wa haroon » — et Job, Joseph, Moïse et Aaron." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel prophète m'inspire le plus ? Qu'est-ce que son histoire m'enseigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les épreuves des prophètes sont leurs plus grandes leçons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers raconte les histoires des prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque prophète est un miroir d'un attribut d'Allah." }
  ],
  munajat: `Ya Rabb, merci pour Tes prophètes. Fais que j'apprenne de leurs histoires. Job m'enseigne la patience, Joseph la confiance, Moïse le courage.`
};

MIROIR["6:87"] = {
  reference: "6:87",
  theme: ["élection", "guidance", "droiture"],
  emotion: "Gratitude, inspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Istifa", "Al-Sidq"],
  mirrorVersion: `« Et de leurs pères, de leurs descendants et de leurs frères. » Le miroir me montre l'extension de l'élection. « Wa min aabaa'ihim wa dhurriyyaatihim wa ikhwanihim » — et de leurs pères, de leurs descendants et de leurs frères. La guidance ne s'arrête pas à l'individu — elle s'étend à la famille, à la communauté. « Wajtabaynaahum » — Nous les avons élus. « Wa hadaynaahum ilaa siratin mustaqeem » — et Nous les avons guidés vers un chemin droit. Le miroir m'enseigne que l'élection divine est une chaîne.`,
  reflection: `La guidance s'étend aux familles et aux communautés. L'élection divine est un privilège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min aabaa'ihim wa dhurriyyaatihim wa ikhwanihim wajtabaynaahum wa hadaynaahum ilaa siratin mustaqeem » — et de leurs pères, de leurs descendants et de leurs frères. Nous les avons élus et guidés vers un chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie d'une chaîne de guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élection n'est pas un privilège individuel — elle est communautaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers participe à la chaîne de la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le chemin droit est le même pour tous les élus." }
  ],
  munajat: `Ya Mujtaba, élis-moi parmi Tes serviteurs. Fais que je sois un maillon de la chaîne de guidance. Le chemin droit est mon choix.`
};

MIROIR["6:88"] = {
  reference: "6:88",
  theme: ["guidance", "méthode", "obéissance"],
  emotion: "Clarté, direction",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Huda", "At-Tariqah"],
  mirrorVersion: `« C'est la guidance d'Allah par laquelle Il guide qui Il veut parmi Ses serviteurs. » Le miroir me montre la source de la guidance. « Dhaalika hudallaahi yahdee bihee man yashaaa'u min 'ibaadih » — c'est la guidance d'Allah par laquelle Il guide qui Il veut parmi Ses serviteurs. La guidance n'est pas un effort humain — elle est un don divin. « Wa law ashkaku la-khabita 'anhum maa kaanoo ya'maloon » — s'ils avaient associé, leurs œuvres auraient été vaines. Le miroir m'avertit : l'association annule les œuvres.`,
  reflection: `La guidance vient d'Allah seul. L'association annule les œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhaalika hudallaahi yahdee bihee man yashaaa'u min 'ibaadih wa law ashkaku la-khabita 'anhum maa kaanoo ya'maloon » — c'est la guidance d'Allah. S'ils avaient associé, leurs œuvres auraient été vaines." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recherche la guidance d'Allah ou ma propre direction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance sans association est la seule valable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas l'association — il est purement guidé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guidance est un don — l'association est un rejet." }
  ],
  munajat: `Ya Hadi, guide-moi par Ta guidance. Ne permets pas que j'associe quoi que ce soit à Toi. Mes œuvres ne sont utiles que par Ta guidance.`
};

MIROIR["6:89"] = {
  reference: "6:89",
  theme: ["livre", "balance", "responsabilité"],
  emotion: "Responsabilité, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kitab", "Al-Mizan"],
  mirrorVersion: `« Ce sont ceux à qui Nous avons donné le Livre, le jugement et la prophétie. » Le miroir me montre le dépôt sacré. « Ulaa'ika alladheena aataynaahumul kitaaba wal hukma wan-nubuwwah » — ce sont ceux à qui Nous avons donné le Livre, le jugement et la prophétie. Le dépôt est immense. « Fa-in yakfur bihaa haaa'ulaaa'i » — si ceux-ci mécroient. « Fa-qad wakkalnaa bihaa qawman lastum bihaa bi-kaafireen » — Nous l'avons confié à un peuple qui n'est pas mécréant. Le miroir m'enseigne que le dépôt sacré requiert la foi.`,
  reflection: `Le Livre, le jugement et la prophétie sont des dépôts sacrés. La foi est nécessaire pour les porter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ulaa'ika alladheena aataynaahumul kitaaba wal hukma wan-nubuwwah fa-in yakfur bihaa haaa'ulaaa'i fa-qad wakkalnaa bihaa qawman lastum bihaa bi-kaafireen » — ce sont ceux à qui Nous avons donné le Livre, le jugement et la prophétie. S'ils mécroient, Nous l'avons confié à un peuple croyant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel dépôt ai-je reçu ? Est-ce que j'y suis fidèle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mécréance fait perdre le dépôt — la foi le préserve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers préserve le dépôt de la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le dépôt n'appartient qu'à ceux qui le méritent." }
  ],
  munajat: `Ya Rabb, merci pour le dépôt du Livre. Fais que j'y sois fidèle. Ne permets pas que je le perde par la mécréance.`
};

MIROIR["6:90"] = {
  reference: "6:90",
  theme: ["modèle", "guidance", "suivi"],
  emotion: "Inspiration, direction",
  difficulty: "débutant",
  relatedNames: ["Al-Uswah", "Al-Huda"],
  mirrorVersion: `« Ce sont ceux qu'Allah a guidés. Suis donc leur guidance. » Le miroir me montre le chemin des prophètes. « Ulaa'ika alladheena hadallaahu fa-bi-hudaa humu iqtadih » — ce sont ceux qu'Allah a guidés. Suis donc leur guidance. L'injonction est claire : les prophètes sont les modèles à suivre. « Qul laa as'alukum 'alayhi ajra » — dis : je ne vous demande pas de salaire pour cela. La motivation est pure. « In huwa illaa dhikraa lil-'aalameen » — ce n'est qu'un rappel pour les mondes. Le miroir m'invite à suivre les pas des prophètes.`,
  reflection: `Les prophètes sont les modèles. Leur guidance est la voie droite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ulaa'ika alladheena hadallaahu fa-bi-hudaa humu iqtadih qul laa as'alukum 'alayhi ajra in huwa illaa dhikraa lil-'aalameen » — ce sont ceux qu'Allah a guidés. Suis leur guidance. Dis : je ne demande pas de salaire. C'est un rappel pour les mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la guidance des prophètes ? Ou est-ce que j'ai d'autres modèles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance des prophètes est le chemin — tout autre chemin est égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier suit la guidance prophétique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Suivre les prophètes est le secret de la proximité divine." }
  ],
  munajat: `Ya Rabb, je suis la guidance des prophètes. Fais que mes pas suivent les leurs. Je ne demande pas de salaire — seulement Ta satisfaction.`
};

MIROIR["6:91"] = {
  reference: "6:91",
  theme: ["révélation", "mécréance", "grandeur"],
  emotion: "Indignation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tanzil", "Al-Qur'an"],
  mirrorVersion: `« Ils n'ont pas estimé Allah à Sa juste valeur. » Le miroir me montre l'ingratitude des mécréants. « Wa maa qadarullaaha haqqa qadrih » — ils n'ont pas estimé Allah à Sa juste valeur. L'accusation est grave. « Idh qaaloo maa anzalallaahu 'alaa basharin min shay » — quand ils disent : Allah n'a rien fait descendre sur un être humain. Le déni de la révélation. « Qul man anzalal kitaaba alladhee jaaa'a bihee moosaa nooran wa hudan lin-naas » — dis : qui a fait descendre le Livre que Moïse a apporté ? La réponse est évidente. Le miroir m'enseigne que nier la révélation est un manque de respect envers Allah.`,
  reflection: `Nier la révélation est un manque de respect envers Allah. La grandeur d'Allah demande la reconnaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa maa qadarullaaha haqqa qadrih idh qaaloo maa anzalallaahu 'alaa basharin min shay qul man anzalal kitaaba alladhee jaaa'a bihee moosaa nooran wa hudan lin-naas » — ils n'ont pas estimé Allah à Sa juste valeur quand ils disent : Allah n'a rien révélé. Dis : qui a révélé le Livre de Moïse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'estime Allah à Sa juste valeur ? Ou est-ce que je Le sous-estime ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation est la plus grande preuve de la grandeur d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de la grandeur d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Estimer Allah à Sa juste valeur est le début de la connaissance." }
  ],
  munajat: `Ya 'Adhim, Tu es grand au-delà de toute estimation. Je reconnais Ta révélation. Ne permets pas que je Te sous-estime.`
};

MIROIR["6:92"] = {
  reference: "6:92",
  theme: ["coran", "confirmation", "avertissement"],
  emotion: "Responsabilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Makkah"],
  mirrorVersion: `« Et voici un Livre béni que Nous avons fait descendre. » Le miroir me montre la nature du Coran. « Wa haadha kitaabun anazalnaahu mubaarakun musaddiqul alladhee bayna yadayh » — et voici un Livre béni que Nous avons fait descendre, confirmant ce qui était avant lui. Le Coran est béni et confirmateur. « Wa litunzira ummal-quraa wa man hawlahaa » — pour avertir la Mère des cités et ceux autour. La mission d'avertissement. « Walladheena yu'minoona bil-aakhirati yu'minoona bih » — et ceux qui croient en l'au-delà croient en lui. Le lien avec la foi. Le miroir m'enseigne que le Coran est le critère de la vérité.`,
  reflection: `Le Coran est béni et confirmateur. Il avertit et guide ceux qui croient en l'au-delà.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa haadha kitaabun anazalnaahu mubaarakun musaddiqul alladhee bayna yadayh wa litunzira ummal-quraa wa man hawlahaa walladheena yu'minoona bil-aakhirati yu'minoona bih » — et voici un Livre béni que Nous avons fait descendre, confirmant ce qui était avant. Pour avertir la Mère des cités. Ceux qui croient en l'au-delà croient en lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère le Coran comme béni ? Est-ce qu'il m'avertit et me guide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en l'au-delà et la foi en le Coran sont liées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la lumière pour l'univers entier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Coran est béni parce qu'il vient du Béni." }
  ],
  munajat: `Ya Rabb, le Coran est béni. Fais que je croie en lui et en l'au-delà. Qu'il m'avertisse et me guide vers Toi.`
};

MIROIR["6:93"] = {
  reference: "6:93",
  theme: ["mensonge", "révélation", "châtiment"],
  emotion: "Effroi, vérité",
  difficulty: "avancé",
  relatedNames: ["Al-Kadhib", "Al-Wahy"],
  mirrorVersion: `« Et qui est plus injuste que celui qui forge un mensonge contre Allah ? » Le miroir me montre l'injustice suprême. « Wa man azlamu mimmani iftaraa 'alallaahi kadhiban aw qaala oohiya ilayya » — et qui est plus injuste que celui qui forge un mensonge contre Allah ou dit : il m'a été révélé ? La fausse révélation. « Wa lam yuuha ilayhi shay » — alors que rien ne lui a été révélé. Le mensonge. « Wa man qaala sa-anzilu mithla maa anzalallaah » — et qui dit : je vais faire descendre comme ce qu'Allah a fait descendre. L'arrogance. Le miroir m'avertit que le mensonge contre Allah a des conséquences terribles.`,
  reflection: `Le mensonge contre Allah est l'injustice suprême. La fausse révélation appelle le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man azlamu mimmani iftaraa 'alallaahi kadhiban aw qaala oohiya ilayya wa lam yuuha ilayhi shay » — et qui est plus injuste que celui qui forge un mensonge contre Allah ou dit : il m'a été révélé, alors que rien ne lui a été révélé ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis vrai sur Allah ? Ou est-ce que je Lui attribue ce qu'Il n'a pas dit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sur Allah se retourne contre le menteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas sur son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vérité sur Allah est la seule parole autorisée." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Ne permets pas que je mente sur Toi. Ma parole sur Toi doit être exacte. Le mensonge a des conséquences.`
};

MIROIR["6:94"] = {
  reference: "6:94",
  theme: ["retour", "solitude", "compte"],
  emotion: "Solennité, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ma'ad", "Al-Fard"],
  mirrorVersion: `« Vous êtes venus à Nous, seuls, comme Nous vous avons créés la première fois. » Le miroir me montre le retour à la vérité. « Wa laqad ji'tumoonaa furaadaa kamaa khalaqnaakum awwala marratin » — vous êtes venus à Nous, seuls, comme Nous vous avons créés la première fois. La solitude du retour. « Wa taraktum maa khawwalnaakum waraaa'a zuhoorikum » — et vous avez laissé derrière vous ce que Nous vous avions donné. L'abandon des biens. « Wa maa naraaa ma'akum shufa'aakum » — et Nous ne voyons pas avec vous vos intercesseurs. L'échec de l'intercession. Le miroir me rappelle la réalité du Jour dernier.`,
  reflection: `Le retour est solitaire. Les biens restent derrière. L'intercession échoue sans la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ji'tumoonaa furaadaa kamaa khalaqnaakum awwala marratin wa taraktum maa khawwalnaakum waraaa'a zuhoorikum wa maa naraaa ma'akum shufa'aakum » — vous êtes venus seuls comme Nous vous avons créés. Vous avez laissé ce que Nous vous avions donné. Nous ne voyons pas vos intercesseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aurai avec moi au retour ? Les biens restent — la foi vient." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La solitude du retour révèle ce qui compte vraiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme retourne seule à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Seule la relation avec Allah survit au retour." }
  ],
  munajat: `Ya Rabb, je viendrai seul. Fais que j'aie la foi avec moi. Les biens restent — la relation avec Toi reste. Prépare-moi pour le retour.`
};

MIROIR["6:96"] = {
  reference: "6:96",
  theme: ["création", "lumière", "mesure"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Falaq", "An-Nur"],
  mirrorVersion: `« Fendeur de l'aube, Il a fait de la nuit un repos. » Le miroir me montre la sagesse du créateur. « Faaliqul-isbaah » — fendeur de l'aube. Chaque lever de soleil est un miracle renouvelé. « Wa ja'alal-layla sakana » — et Il a fait de la nuit un repos. L'alternance jour/nuit est une miséricorde. « Wash-shamsa wal-qamara husbanaa » — et le soleil et la lune pour le calcul. L'ordre cosmique. « Dhaalika taqdeerul-'azeezil 'aleem » — c'est le décret du Puissant, du Sage. Le miroir m'invite à contempler l'ordre de la création.`,
  reflection: `L'alternance jour/nuit est une miséricorde. Le soleil et la lune suivent un ordre précis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faaliqul-isbaah wa ja'alal-layla sakana wash-shamsa wal-qamara husbanaa dhaalika taqdeerul-'azeezil 'aleem » — fendeur de l'aube, Il a fait de la nuit un repos. Le soleil et la lune pour le calcul. C'est le décret du Puissant, du Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple l'ordre de la création ? Le lever du soleil m'émerveille-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos de la nuit prépare l'éveil du jour — l'ordre divin est parfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit l'ordre du Créateur avec précision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque aube est une résurrection miniature." }
  ],
  munajat: `Ya Faliq, Tu fend l'aube chaque jour. Fais que je contemple Ton ordre. Le jour et la nuit sont Tes dons. Le soleil et la lune Te louent.`
};

MIROIR["6:97"] = {
  reference: "6:97",
  theme: ["étoiles", "guidance", "navigation"],
  emotion: "Gratitude, direction",
  difficulty: "débutant",
  relatedNames: ["An-Nujum", "Al-Huda"],
  mirrorVersion: `« C'est Lui qui a fait pour vous les étoiles. » Le miroir me montre la guidance cosmique. « Wa huwal-ladhee ja'a la lakumun-nujooma litahtadoo bihaa » — c'est Lui qui a fait pour vous les étoiles pour que vous vous guidiez. Les étoiles ne sont pas que décoratives — elles sont des guides. « Fee zulumaatil-barri wal-bahr » — dans les ténèbres de la terre et de la mer. La guidance dans l'obscurité. « Qad fas-salnaal-aayaati li-qawmin ya'lamoon » — Nous avons détaillé les signes pour un peuple qui sait. Le miroir m'enseigne que la création est un guide pour ceux qui réfléchissent.`,
  reflection: `Les étoiles guident dans les ténèbres. La création est pleine de signes pour ceux qui savent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwal-ladhee ja'a la lakumun-nujooma litahtadoo bihaa fee zulumaatil-barri wal-bahr qad fas-salnaal-aayaati li-qawmin ya'lamoon » — c'est Lui qui a fait les étoiles pour vous guider dans les ténèbres de la terre et de la mer. Nous avons détaillé les signes pour un peuple qui sait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles étoiles me guident dans ma vie ? La Parole d'Allah est mon étoile polaire." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étoiles guident dans la nuit — le Coran guide dans les ténèbres de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un guide pour le voyageur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les étoiles sont les lampes du chemin divin." }
  ],
  munajat: `Ya Hadi, Tu as fait les étoiles pour guider. Fais que je me guide par Tes signes. Dans les ténèbres de ma vie, Ta parole est ma lumière.`
};

MIROIR["6:98"] = {
  reference: "6:98",
  theme: ["origine", "répartition", "multiplication"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Nasha'ah", "Al-Intishar"],
  mirrorVersion: `« C'est Lui qui vous a produits à partir d'une seule âme. » Le miroir me montre l'unité de l'origine. « Wa huwal-ladhee ansha'akam min nafsin waahidah » — c'est Lui qui vous a produits à partir d'une seule âme. L'humanité a une origine commune. « Fa-mustaqarrun wa mustawda' » — puis un lieu de séjour et un lieu de dépôt. Le destin de chaque âme. « Qad fas-salnaal-aayaati li-qawmin yafqahoon » — Nous avons détaillé les signes pour un peuple qui comprend. Le miroir m'enseigne que l'unité d'origine appelle la fraternité.`,
  reflection: `L'humanité a une origine commune. La diversité ne contredit pas l'unité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwal-ladhee ansha'akam min nafsin waahidah fa-mustaqarrun wa mustawda' qad fas-salnaal-aayaati li-qawmin yafqahoon » — c'est Lui qui vous a produits d'une seule âme. Un lieu de séjour et un lieu de dépôt. Nous avons détaillé les signes pour un peuple qui comprend." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'unité de l'humanité ? Mon prochain est-il mon frère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité d'origine appelle l'unité de destination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers célèbre l'unité de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Une seule âme — un seul Créateur." }
  ],
  munajat: `Ya Khaliq, Tu nous as créés d'une seule âme. Fais que je reconnaisse mes frères. L'unité d'origine est le fondement de la fraternité.`
};

MIROIR["6:99"] = {
  reference: "6:99",
  theme: ["eau", "végétation", "résurrection"],
  emotion: "Émerveillement, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'", "An-Nabat"],
  mirrorVersion: `« C'est Lui qui a fait descendre l'eau du ciel. » Le miroir me montre le cycle de la vie. « Wa huwal-ladhee anzala minas-samaa'i maaa'an » — c'est Lui qui a fait descendre l'eau du ciel. La source de la vie. « Fa-akhrajnaa bih nabata kulli shay » — et Nous en avons fait sortir toute plante. La diversité de la création. « Fa-akhrajnaa minhu khadiran » — et Nous en avons fait sortir des herbes vertes. La première vie. « Nukhriju minhu habban mutaraakiba » — d'où Nous faisons sortir des grains empilés. La nourriture. Le miroir m'enseigne que l'eau est le symbole de la résurrection.`,
  reflection: `L'eau fait sortir la vie de la terre. La résurrection suit le même modèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwal-ladhee anzala minas-samaa'i maaa'an fa-akhrajnaa bih nabata kulli shay » — c'est Lui qui a fait descendre l'eau du ciel, et Nous en avons fait sortir toute plante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple le cycle de l'eau et de la vie ? La résurrection suit ce modèle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre morte devient vivante — l'âme morte peut revivre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est la vie dans tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque pluie est une promesse de résurrection." }
  ],
  munajat: `Ya Muhyi, Tu fais descendre la pluie et la vie sort. Fais descendre Ta miséricorde sur mon cœur mort. La résurrection est Ta promesse.`
};

MIROIR["6:100"] = {
  reference: "6:100",
  theme: ["association", "djinn", "imputations"],
  emotion: "Indignation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shirk", "Al-Jinn"],
  mirrorVersion: `« Ils ont fait d'Allah des associés les djinns. » Le miroir me montre l'égarement de l'association. « Ja'alu lillaahi shurakaaa'al-jinna » — ils ont fait d'Allah des associés les djinns. L'absurdité de l'idolâtrie. « Wa khalaqahum » — alors qu'Il les a créés. Le Créateur n'a pas d'égal. « Wa kharaqoo lahu baneena wa banaatin bi-gayri 'ilm » — et ils Lui ont faussement attribué des fils et des filles sans science. Les imputations mensongères. « Subhaanahu wa ta'aalaa 'ammaa yasifoon » — gloire à Lui, Il est au-dessus de ce qu'ils décrivent. Le miroir m'enseigne que l'association est un mensonge sur Allah.`,
  reflection: `L'association est un mensonge sur Allah. Il n'a ni fils ni fille ni associé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ja'alu lillaahi shurakaaa'al-jinna wa khalaqahum wa kharaqoo lahu baneena wa banaatin bi-gayri 'ilm subhaanahu wa ta'aalaa 'ammaa yasifoon » — ils ont fait d'Allah des associés les djinns alors qu'Il les a créés. Ils Lui ont attribué fils et filles sans science. Gloire à Lui, Il est au-dessus de leurs descriptions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'associe à Allah ? Quelle idée fausse ai-je de Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le Créateur — tout ce qui est créé ne peut être Son associé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne L'associe rien — il est en pure soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté du tawhid est la connaissance vraie d'Allah." }
  ],
  munajat: `Ya Ahad, Tu es Un sans associé. Ne permets pas que je T'attribue ce qui ne T'appartient pas. Le tawhid est ma foi. Gloire à Toi.`
};

MIROIR["6:102"] = {
  reference: "6:102",
  theme: ["tawhid", "créateur", "protecteur"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Allah", "Al-Khaliq"],
  mirrorVersion: `« Voilà Allah, votre Seigneur. Nulle divinité que Lui. » Le miroir me ramène à l'essentiel. « Dhaalikumullaahu rabbukum laa ilaaha illaa huwa » — voilà Allah, votre Seigneur. Nulle divinité que Lui. Le tawhid affirmé. « Khaaliqu kulli shay » — Créateur de toute chose. L'universalité de la création. « Fa'buduh » — adorez-Le donc. L'adoration comme réponse. « Wa huwa 'alaa kulli shay-in wakeel » — et Il est le Gardien de toute chose. La protection universelle. Le miroir m'enseigne que le tawhid est le fondement de tout.`,
  reflection: `Le tawhid est le fondement. Allah est le Créateur et le Gardien de toute chose.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhaalikumullaahu rabbukum laa ilaaha illaa huwa khaaliqu kulli shay fa'buduh wa huwa 'alaa kulli shay-in wakeel » — voilà Allah, votre Seigneur. Nulle divinité que Lui. Créateur de toute chose. Adorez-Le. Il est le Gardien de toute chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis le tawhid dans ma vie ? Allah est-il mon unique objet d'adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tawhid n'est pas un concept — c'est une relation exclusive avec le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame l'unicité d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration du tawhid est la libération de tout esclavage." }
  ],
  munajat: `Ya Allah, Tu es mon Seigneur. Nulle divinité que Toi. Tu as tout créé. Je T'adore seul. Tu es mon Gardien.`
};

MIROIR["6:103"] = {
  reference: "6:103",
  theme: ["vision", "connaissance", "transcendance"],
  emotion: "Émerveillement, humilité",
  difficulty: "avancé",
  relatedNames: ["Al-Basir", "Al-Khabir"],
  mirrorVersion: `« Les regards ne L'atteignent pas, et Il atteint tous les regards. » Le miroir me montre la transcendance divine. « Laa tudrikuhul-absaru » — les regards ne L'atteignent pas. Allah est au-delà de la vision humaine. « Wa yudrikuhul-absaru » — et Il atteint tous les regards. Il voit tout ce qui est vu. « Wa huwal-lateeful-khabeer » — et Il est le Subtil, le Bien-Informé. La connaissance parfaite. Le miroir m'enseigne qu'Allah est à la fois transcendant et immanent.`,
  reflection: `Allah dépasse la vision mais connaît tout. Il est le Subtil et le Bien-Informé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laa tudrikuhul-absaru wa yudrikuhul-absaru wa huwal-lateeful-khabeer » — les regards ne L'atteignent pas, et Il atteint tous les regards. Il est le Subtil, le Bien-Informé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Puis-je accepter que je ne puisse pas voir Allah de mes yeux ? Ma foi dépasse ma vue." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je ne Le vois pas — mais Il me voit. C'est la relation de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut contenir son Créateur — mais le Créateur contient l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La transcendance n'exclut pas la proximité — le Subtil est proche." }
  ],
  munajat: `Ya Latif, Tu es au-delà de ma vue mais Tu me vois. Ma foi n'a pas besoin de voir. Ta connaissance m'embrasse.`
};

MIROIR["6:104"] = {
  reference: "6:104",
  theme: ["preuve", "vision", "indépendance"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "Al-Basir"],
  mirrorVersion: `« Des preuves de votre Seigneur vous sont venues. » Le miroir me montre la responsabilité de la connaissance. « Qad ja'atkum basaaa'iru min rabbikum » — des preuves de votre Seigneur vous sont venues. La guidance est arrivée. « Faman absara falinafsih » — quiconque voit, c'est pour lui-même. Le bénéfice individuel. « Wa man 'amiya fa'alayhaa » — et quiconque est aveugle, c'est contre lui-même. Le préjudice personnel. « Wa maaa ana 'alaykum bi-hafeez » — et je ne suis pas votre gardien. L'indépendance du messager. Le miroir m'enseigne que la guidance est une responsabilité personnelle.`,
  reflection: `La guidance est une responsabilité personnelle. Chacun tire bénéfice ou préjudice de sa propre vision.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad ja'atkum basaaa'iru min rabbikum faman absara falinafsih wa man 'amiya fa'alayhaa wa maaa ana 'alaykum bi-hafeez » — des preuves vous sont venues. Quiconque voit, c'est pour lui. Quiconque est aveugle, c'est contre lui. Je ne suis pas votre gardien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois avec les preuves qui me sont venues ? Ou suis-je aveugle malgré la lumière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vue est pour soi — l'aveuglement est contre soi. Personne ne peut voir pour un autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers voit avec les preuves de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vision intérieure est plus importante que la vue des yeux." }
  ],
  munajat: `Ya Rabb, des preuves me sont venues. Fais que je voie pour moi-même. Ne permets pas que je sois aveugle. Je suis responsable de ma vision.`
};

MIROIR["6:105"] = {
  reference: "6:105",
  theme: ["versets", "explication", "polémique"],
  emotion: "Clarté, réponse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ayat", "At-Tafsir"],
  mirrorVersion: `« Nous exposons les versets de diverses manières. » Le miroir me montre la pédagogie divine. « Wa kas-sarnal-aayaati » — et Nous avons exposé les versets. La répétition pédagogique. « Wa li-yaqoolu darasta » — pour qu'ils disent : tu as étudié. L'accusation d'apprentissage humain. « Wa li-nubayyinahu li-qawmin ya'lamoon » — et pour l'expliquer à un peuple qui sait. La clarté pour les savants. Le miroir m'enseigne que les versets sont multi-formes pour atteindre tous les cœurs.`,
  reflection: `Les versets sont exposés de diverses manières. La pédagogie divine s'adapte à chacun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kas-sarnal-aayaati wa li-yaqoolu darasta wa li-nubayyinahu li-qawmin ya'lamoon » — Nous exposons les versets de diverses manières. Pour qu'ils disent : tu as étudié. Pour l'expliquer à un peuple qui sait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je lis les versets ? Est-ce que j'en tire des leçons variées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les accusations des mécréants ne changent rien à la vérité des versets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lit les versets divins dans leurs formes multiples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque lecture est nouvelle — les versets sont vivants." }
  ],
  munajat: `Ya Rabb, expose-moi Tes versets. Fais que je les comprenne. Les accusations des autres ne m'atteignent pas. Je suis parmi ceux qui savent.`
};

MIROIR["6:106"] = {
  reference: "6:106",
  theme: ["révélation", "tawhid", "droiture"],
  emotion: "Soumission, direction",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Hanif"],
  mirrorVersion: `« Suis ce qui t'est révélé de ton Seigneur. » Le miroir me montre le chemin de l'obéissance. « Ittabi' maaa oohiya ilayka min rabbik » — suis ce qui t'est révélé de ton Seigneur. L'obéissance à la révélation. « Laa ilaaha illaa huwa » — nulle divinité que Lui. Le tawhid au centre. « Wa a'rid 'anil mushrikeen » — et détourne-toi des associateurs. L'éloignement de l'égarement. Le miroir m'enseigne que la droiture est de suivre la révélation et d'éviter l'association.`,
  reflection: `La droiture est de suivre la révélation. Le tawhid est le centre de la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittabi' maaa oohiya ilayka min rabbik laa ilaaha illaa huwa wa a'rid 'anil mushrikeen » — suis ce qui t'est révélé. Nulle divinité que Lui. Détourne-toi des associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la révélation ? Ou est-ce que je m'éloigne de la droiture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre la révélation et éviter l'association sont les deux faces de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la révélation divine dans son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur hanif est le cœur qui suit la révélation pure." }
  ],
  munajat: `Ya Rabb, je suis Ta révélation. Nulle divinité que Toi. Je me détourne de l'association. La droiture est mon chemin.`
};

MIROIR["6:107"] = {
  reference: "6:107",
  theme: ["volonté", "contrainte", "témoignage"],
  emotion: "Compréhension, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mashi'ah", "Al-Shahadah"],
  mirrorVersion: `« Si Allah avait voulu, ils n'auraient pas associé. » Le miroir me montre la question de la volonté divine. « Wa law shaaa'allaahu maaa ashrakuu » — si Allah avait voulu, ils n'auraient pas associé. La prédestination. « Wa maa ja'alnaaka 'alayhim hafeeza » — et Nous ne t'avons pas fait leur gardien. L'absence de contrainte. « Wa maa anta 'alayhim bi-wakeel » — et tu n'es pas leur garant. La non-responsabilité. Le miroir m'enseigne que la guidance est un don, pas une contrainte.`,
  reflection: `La volonté divine précède tout. Le messager n'est pas responsable de la foi des autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law shaaa'allaahu maaa ashrakuu wa maa ja'alnaaka 'alayhim hafeeza wa maa anta 'alayhim bi-wakeel » — si Allah avait voulu, ils n'auraient pas associé. Nous ne t'avons pas fait leur gardien. Tu n'es pas leur garant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que la volonté d'Allah précède tout ? Suis-je responsable de la foi des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté humaine existe dans le cadre de la volonté divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la volonté divine sans déviation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prédestination est un mystère — la responsabilité est claire." }
  ],
  munajat: `Ya Rabb, Ta volonté précède tout. Je ne suis pas responsable de la foi des autres. Guide qui Tu veux. Ma responsabilité est ma propre foi.`
};

MIROIR["6:108"] = {
  reference: "6:108",
  theme: ["respect", "blasphème", "sagesse"],
  emotion: "Sagesse, modération",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hikmah", "Al-Adab"],
  mirrorVersion: `« N'insultez pas ceux qu'ils invoquent en dehors d'Allah. » Le miroir me montre la sagesse du respect. « Wa laa tasubbul-ladheena yad'oona min doonillaahi » — n'insultez pas ceux qu'ils invoquent en dehors d'Allah. L'interdiction de l'offense. « Fa-yasubbul-laaha 'adwan bighayri 'ilm » — car ils insulteraient Allah par ignorance et hostilité. La conséquence négative. « Kadhaalika zayyannaa li-kulli ummatin 'amalahum » — ainsi avons-Nous enjolivé à chaque nation ses actions. L'égarement décoré. Le miroir m'enseigne que la sagesse évite l'offense inutile.`,
  reflection: `La sagesse évite l'offense. L'insulte des idoles peut mener à l'insulte d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laa tasubbul-ladheena yad'oona min doonillaahi fa-yasubbul-laaha 'adwan bighayri 'ilm kadhaalika zayyannaa li-kulli ummatin 'amalahum » — n'insultez pas leurs divinités, car ils insulteraient Allah par ignorance. Nous avons enjolivé à chaque nation ses actions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'insulte les croyances des autres ? Ou est-ce que je garde le respect ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect n'est pas l'approbation — la sagesse ne contredit pas la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte l'ordre divin même quand les hommes le nient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sagesse est de dire la vérité sans offenser inutilement." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse. Je ne veux pas offenser inutilement. La vérité est mon message, le respect est ma méthode.`
};

MIROIR["6:109"] = {
  reference: "6:109",
  theme: ["serment", "miracles", "exigence"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aymaan", "Al-Mu'jizat"],
  mirrorVersion: `« Ils jurent par Allah leurs serments les plus solennels. » Le miroir me montre l'hypocrisie des serments. « Wa aqsamu billahi jahda aymaanihim » — ils jurent par Allah leurs serments les plus solennels. La fausse promesse. « La-in jaaa'at-hum aayatun la-yu'minunna bihaa » — si un signe leur vient, ils y croiront. L'exigence conditionnelle. « Qul innamal-aayaatu 'indallaah » — dis : les signes sont auprès d'Allah. La réponse. « Wa maa yush'irukum annahaaa idhaa jaaa'at laa yu'minoon » — et qui vous fait savoir qu'ils croiront quand le signe viendra ? Le doute. Le miroir m'avertit contre les faux serments.`,
  reflection: `Les serments hypocrites ne valent rien. La foi n'est pas conditionnée par les miracles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aqsamu billahi jahda aymaanihim la-in jaaa'at-hum aayatun la-yu'minunna bihaa qul innamal-aayaatu 'indallaah » — ils jurent leurs serments les plus solennels : si un signe vient, nous croirons. Dis : les signes sont auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jure des serments hypocrites ? Ma foi est-elle conditionnée par des signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment hypocrite cache souvent le refus de croire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne jure pas — il croit et obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi sans condition est plus précieuse que la foi exigeant des miracles." }
  ],
  munajat: `Ya Rabb, je ne veux pas jurer des serments hypocrites. Ma foi n'est pas conditionnée par des signes. Je crois en Toi sans exigence.`
};

MIROIR["6:110"] = {
  reference: "6:110",
  theme: ["cœur", "vision", "égarement"],
  emotion: "Tristesse, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qalb", "Al-Absar"],
  mirrorVersion: `« Et Nous détournerons leurs cœurs et leurs regards. » Le miroir me montre les conséquences du refus. « Wa nuqallibu af'idatahum wa absaarahum » — et Nous détournerons leurs cœurs et leurs regards. La conséquence du rejet. « Kamaa lam yu'minoo bihi awwala marratin » — comme ils n'ont pas cru la première fois. Le refus initial. « Wa nadharuhum fee tughyaanihim ya'mahoon » — et Nous les laisserons dans leur transgression errer. L'abandon. Le miroir m'avertit que le rejet de la guidance mène à l'égarement.`,
  reflection: `Le rejet de la guidance mène à l'égarement. Le cœur qui refuse est scellé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nuqallibu af'idatahum wa absaarahum kamaa lam yu'minoo bihi awwala marratin wa nadharuhum fee tughyaanihim ya'mahoon » — Nous détournerons leurs cœurs et leurs regards comme ils n'ont pas cru la première fois. Nous les laisserons errer dans leur transgression." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je refuse la guidance ? Le rejet a des conséquences." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur qui refuse se ferme — la lumière ne peut entrer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne refuse pas la guidance — il l'accepte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur ouvert est le plus grand don — le cœur fermé est le plus grand châtiment." }
  ],
  munajat: `Ya Rabb, ne ferme pas mon cœur. J'accepte Ta guidance. Ne me laisse pas errer dans la transgression. Mon cœur est ouvert à Ta lumière.`
};

MIROIR["6:111"] = {
  reference: "6:111",
  theme: ["miracles", "foi", "anges"],
  emotion: "Réalité, compréhension",
  difficulty: "avancé",
  relatedNames: ["Al-Mala'ika", "Al-Iman"],
  mirrorVersion: `« Même si Nous faisions descendre les anges sur eux. » Le miroir me montre la question des miracles. « Wa law annaa nazzalnaa ilayhimul-maaa'ikah » — même si Nous faisions descendre les anges sur eux. Le miracle suprême. « Wa nallaqat ilayhimul-amwaatu » — et que les morts leur parlaient. La résurrection anticipée. « Wa hasharnaa 'alayhim kulla shay » — et que Nous rassemblions toute chose devant eux. La manifestation totale. « Qibalan maa kaanu li-yu'minoo » — ils ne croiraient pas. Le refus obstiné. « Illaaa an yashaaa'allaah » — sauf si Allah veut. La volonté divine. Le miroir m'enseigne que le miracle ne force pas la foi.`,
  reflection: `Le miracle ne force pas la foi. Le cœur qui refuse reste fermé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law annaa nazzalnaa ilayhumul-maaa'ikah wa nallaqat ilayhimul-amwaatu wa hasharnaa 'alayhim kulla shay qibalan maa kaanu li-yu'minoo illaaa an yashaaa'allaah » — même si Nous envoyions les anges, que les morts parlent, et rassemblions tout — ils ne croiraient pas, sauf si Allah veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel miracle me ferait croire ? Ou est-ce que je crois sans miracle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans miracle est plus pure que la foi par miracle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croit sans voir les anges — la création est son miracle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui refuse a déjà reçu assez de signes." }
  ],
  munajat: `Ya Rabb, je crois sans avoir vu les anges. Ma foi n'a pas besoin de miracles visibles. Le signe de la création me suffit.`
};

MIROIR["6:112"] = {
  reference: "6:112",
  theme: ["ennemis", "prophètes", "démons"],
  emotion: "Vigilance, persévérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-A'da'", "Ash-Shayatin"],
  mirrorVersion: `« Ainsi avons-Nous assigné à chaque prophète des ennemis. » Le miroir me montre l'opposition constante. « Wa kadhaalika ja'alnaa li-kulli nabiyyin 'aduwwan » — ainsi avons-Nous assigné à chaque prophète des ennemis. La loi de l'opposition. « Shayaateenal-insi wal-jinn » — des démons parmi les hommes et les djinns. Les deux types d'ennemis. « Yoohi ba'duhum ilaa ba'din sukhriyal-qawli ghoururaa » — qui s'inspirent mutuellement des paroles trompeuses. La collusion. Le miroir m'enseigne que l'opposition est normale sur le chemin de la vérité.`,
  reflection: `L'opposition est normale pour les prophètes et les croyants. Les ennemis sont parmi les hommes et les djinns.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhaalika ja'alnaa li-kulli nabiyyin 'aduwwan shayaateenal-insi wal-jinn yoohi ba'duhum ilaa ba'din sukhriyal-qawli ghoururaa » — ainsi avons-Nous assigné à chaque prophète des ennemis : des démons parmi les hommes et les djinns. Ils s'inspirent mutuellement des paroles trompeuses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont mes ennemis ? Suis-je prêt à affronter l'opposition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ennemi est permis par Allah — l'épreuve a un but." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas d'ennemis parmi les créatures — mais le chemin de la vérité en a." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les ennemis sont les catalyseurs de la croissance spirituelle." }
  ],
  munajat: `Ya Rabb, les prophètes ont eu des ennemis. Je m'attends à l'opposition. Donne-moi la force de persévérer. Les démons hommes et djinns ne m'effraient pas.`
};

MIROIR["6:113"] = {
  reference: "6:113",
  theme: ["cœur", "inclinaison", "épreuve"],
  emotion: "Discernement, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qalb", "Al-Mayl"],
  mirrorVersion: `« Pour que les cœurs de ceux qui ne croient pas en l'au-delà s'y inclinent. » Le miroir me montre la séduction des paroles trompeuses. « Wa li-tasghaaa ilayhi af'idatul-ladheena laa yu'minoona bil-aakhirah » — pour que les cœurs de ceux qui ne croient pas en l'au-delà s'y inclinent. L'inclinaison vers le faux. « Wa li-yardawhu » — et qu'ils s'en contentent. La satisfaction de l'erreur. « Wa li-yaqtarifoo maa hum muqtarifoon » — et qu'ils acquièrent ce qu'ils acquièrent. Les conséquences. Le miroir m'avertit contre l'inclinaison vers le faux.`,
  reflection: `Les cœurs qui ne croient pas en l'au-delà s'inclinent vers le faux. La foi en l'au-delà protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-tasghaaa ilayhi af'idatul-ladheena laa yu'minoona bil-aakhirah wa li-yardawhu wa li-yaqtarifoo maa hum muqtarifoon » — pour que les cœurs de ceux qui ne croient pas en l'au-delà s'y inclinent, s'en contentent, et acquièrent ce qu'ils acquièrent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quoi mon cœur s'incline-t-il ? Vers la vérité ou vers le faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en l'au-delà protège de l'inclinaison vers le faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'incline vers son Créateur — pas vers le faux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui s'incline vers le faux a perdu la direction." }
  ],
  munajat: `Ya Rabb, je crois en l'au-delà. Ne permets pas que mon cœur s'incline vers le faux. La vérité est mon inclination.`
};

MIROIR["6:114"] = {
  reference: "6:114",
  theme: ["juge", "révélation", "suffisance"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Kitab"],
  mirrorVersion: `« Chercherais-je un autre juge qu'Allah ? » Le miroir me montre la suffisance d'Allah comme juge. « Afaghayrallaahi abtaghee hakaman » — chercherais-je un autre juge qu'Allah ? La question rhétorique. « Wa huwal-ladhee anzala ilaykumul kitaaba mufassilaa » — et c'est Lui qui a fait descendre sur vous le Livre détaillé. La source du jugement. « Walladheena aataynaahumul kitaaba ya'lamoona annahu munazzalum mir-rabbika bil-haqq » — et ceux à qui Nous avons donné le Livre savent qu'il est descendu de ton Seigneur avec la vérité. Le témoignage. Le miroir m'enseigne qu'Allah est le juge suffisant.`,
  reflection: `Allah est le juge suffisant. Le Livre est détaillé et véridique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaghayrallaahi abtaghee hakaman wa huwal-ladhee anzala ilaykumul kitaaba mufassilaa walladheena aataynaahumul kitaaba ya'lamoona annahu munazzalum mir-rabbika bil-haqq » — chercherais-je un autre juge qu'Allah ? C'est Lui qui a fait descendre le Livre détaillé. Ceux qui ont reçu le Livre savent qu'il vient de ton Seigneur avec la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon juge ? Est-ce que je cherche d'autres juges qu'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le juge — le Livre est Son jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte Allah comme juge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Livre détaillé suffit pour tout jugement." }
  ],
  munajat: `Ya Hakam, Tu es mon Juge. Je ne cherche pas d'autre juge. Ton Livre est détaillé et véridique. Il me suffit.`
};

MIROIR["6:116"] = {
  reference: "6:116",
  theme: ["majorité", "vérité", "égarement"],
  emotion: "Mise en garde, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Akthar", "Al-Haqq"],
  mirrorVersion: `« Si tu obéis à la majorité sur terre, ils t'égareront du chemin d'Allah. » Le miroir me montre le danger du conformisme. « Wa in tuti' akthara man fil-ard yudillooka 'an sabeelillaah » — si tu obéis à la majorité sur terre, ils t'égareront du chemin d'Allah. La majorité n'est pas un critère de vérité. « In yattabi'oona illaz-zanna » — ils ne suivent que la conjecture. L'absence de certitude. « Wa in hum illaa yakhruusoon » — et ils ne font que supposer. L'incertitude. Le miroir m'enseigne que la vérité n'est pas democratisée.`,
  reflection: `La majorité n'a pas raison. La vérité n'est pas democratisée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in tuti' akthara man fil-ard yudillooka 'an sabeelillaah in yattabi'oona illaz-zanna wa in hum illaa yakhruusoon » — si tu obéis à la majorité, ils t'égareront. Ils ne suivent que la conjecture et ne font que supposer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la majorité ? Ou est-ce que je suis la vérité même si je suis seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La minorité sur la vérité vaut mieux que la majorité dans l'erreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la vérité, pas la majorité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le chemin étroit est souvent le chemin de la vérité." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Ne permets pas que je sois trompé par la majorité. La vérité est mon guide, pas les nombres.`
};

MIROIR["6:117"] = {
  reference: "6:117",
  theme: ["connaissance", "guidance", "certitude"],
  emotion: "Confiance, assurance",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Huda"],
  mirrorVersion: `« Ton Seigneur connaît mieux qui s'égare de Son chemin. » Le miroir me montre la connaissance parfaite d'Allah. « Inna rabbaka huwa a'lamu man yadillu 'an sabeelih » — ton Seigneur connaît mieux qui s'égare de Son chemin. La connaissance de l'égarement. « Wa huwa a'lamu bil-muhtadeen » — et Il connaît mieux les bien guidés. La connaissance de la guidance. Le miroir m'enseigne qu'Allah sait tout — l'égarement comme la guidance.`,
  reflection: `Allah connaît qui s'égare et qui est guidé. Sa connaissance est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbaka huwa a'lamu man yadillu 'an sabeelih wa huwa a'lamu bil-muhtadeen » — ton Seigneur connaît mieux qui s'égare de Son chemin. Il connaît mieux les bien guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Allah me connaît. Suis-je parmi les bien guidés ou les égarés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance d'Allah me précède — Il sait avant que je sache." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est connu d'Allah dans chaque détail." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être connu d'Allah comme bien guidé est le plus grand honneur." }
  ],
  munajat: `Ya 'Alim, Tu me connais. Fais que je sois parmi les bien guidés. Tu sais qui s'égare — garde-moi sur Ton chemin.`
};

MIROIR["6:118"] = {
  reference: "6:118",
  theme: ["nourriture", "licite", "nom d'Allah"],
  emotion: "Gratitude, pureté",
  difficulty: "débutant",
  relatedNames: ["At-Tayyib", "Al-Halal"],
  mirrorVersion: `« Mangez de ce sur quoi le nom d'Allah a été prononcé. » Le miroir me montre la spiritualité dans la nourriture. « Fa-kuloo mimmaa dhukiras-mullaahi 'alayh » — mangez de ce sur quoi le nom d'Allah a été prononcé. La nourriture licite. « In kuntum bi-aayaatihi mu'mineen » — si vous croyez en Ses signes. La foi comme condition. Le miroir m'enseigne que même la nourriture a une dimension spirituelle.`,
  reflection: `La nourriture licite est bénie. Le nom d'Allah sanctifie ce que nous mangeons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kuloo mimmaa dhukiras-mullaahi 'alayh in kuntum bi-aayaatihi mu'mineen » — mangez de ce sur quoi le nom d'Allah a été prononcé, si vous croyez en Ses signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mange de la nourriture licite ? Le nom d'Allah est-il prononcé sur ce que je mange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture sanctifiée nourrit le corps et l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers mange ce qu'Allah a créé avec Son nom." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La basmala sur la nourriture est une bénédiction invisible." }
  ],
  munajat: `Ya Razzak, merci pour la nourriture. Fais que je mange du licite. Le nom d'Allah sanctifie ce que je mange.`
};

MIROIR["6:119"] = {
  reference: "6:119",
  theme: ["nourriture", "nécessité", "excuse"],
  emotion: "Vigilance, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Ad-Darurah", "Al-Haram"],
  mirrorVersion: `« Qu'avez-vous à ne pas manger de ce sur quoi le nom d'Allah a été prononcé ? » Le miroir me questionne sur mes refus. « Wa maa lakum allaa ta-kuloo mimmaa dhukiras-mullaahi 'alayh » — qu'avez-vous à ne pas manger de ce sur quoi le nom d'Allah a été prononcé ? La question. « Wa qad fas-sala lakum maa harrama 'alaykum » — alors qu'Il vous a détaillé ce qu'Il vous a interdit. La clarté des interdits. « Illaa mad-turirtum ilayh » — sauf si vous y êtes contraints. L'exception. « Wa inna kaseeralan yudilloona bi-ahwaaa'ihim bi-gayri 'ilm » — beaucoup s'égarent par leurs passions sans science. L'égarement. Le miroir m'enseigne que la nécessité a ses lois.`,
  reflection: `Les interdits sont clairs. La nécessité permet l'interdit en cas de contrainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa maa lakum allaa ta-kuloo mimmaa dhukiras-mullaahi 'alayh wa qad fas-sala lakum maa harrama 'alaykum illaa mad-turirtum ilayh » — qu'avez-vous à ne pas manger ce qui a le nom d'Allah ? Il a détaillé les interdits. Sauf si vous y êtes contraints." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les interdits ? Est-ce que j'abuse de l'exception de nécessité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nécessité n'est pas un prétexte — c'est une exception réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte les limites d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La nourriture licite est une clé de la acceptation des dou'as." }
  ],
  munajat: `Ya Rabb, clarifie-moi les interdits. Je ne veux pas abuser de la nécessité. La nourriture licite est mon choix.`
};

MIROIR["6:120"] = {
  reference: "6:120",
  theme: ["péché", "manifeste", "caché"],
  emotion: "Responsabilité, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ithm", "As-Sirr"],
  mirrorVersion: `« Abandonnez le péché, apparent ou caché. » Le miroir me montre l'exigence de la pureté totale. « Wa dharoo zaahiral-ithmi wa baatinah » — abandonnez le péché, apparent ou caché. Les deux dimensions du péché. « Innal-ladheena yaksibunal-ithaama saj-yujzawna bimaa kaanu yaqtarifoon » — ceux qui acquièrent le péché seront rétribués pour ce qu'ils acquéraient. La rétribution. Le miroir m'enseigne que le péché caché compte autant que le péché apparent.`,
  reflection: `Le péché caché compte autant que le péché apparent. Allah connaît tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dharoo zaahiral-ithmi wa baatinah innal-ladheena yaksibunal-ithaama saj-yujzawna bimaa kaanu yaqtarifoon » — abandonnez le péché apparent et caché. Ceux qui acquièrent le péché seront rétribués pour ce qu'ils acquéraient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont mes péchés cachés ? Ce que je cache des hommes est exposé à Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le péché caché des hommes est apparent à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de péché caché — tout est transparent à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté du cœur nécessite l'abandon du péché caché." }
  ],
  munajat: `Ya Rabb, Tu connais mes péchés cachés. Aide-moi à les abandonner. La pureté totale est mon but.`
};

MIROIR["6:121"] = {
  reference: "6:121",
  theme: ["sacrifice", "nom d'Allah", "impureté"],
  emotion: "Pureté, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nahr", "As-Shirk"],
  mirrorVersion: `« Ne mangez pas de ce sur quoi le nom d'Allah n'a pas été prononcé. » Le miroir me montre l'importance de la bénédiction. « Wa laa ta-kuloo mimmaa lam yadhkiris-mullaahi 'alayh » — ne mangez pas de ce sur quoi le nom d'Allah n'a pas été prononcé. L'interdiction. « Wa innahu la-fisq » — c'est certes une perversité. La qualification. « Wa innash-shayaateena la-yuhoona ilaa awliyaaa'ihim li-yujaadilookum » — et les démons inspirent leurs alliés pour disputer avec vous. L'influence démoniaque. « Wa in ata'tumoohum innakum lamushrikoon » — et si vous les obéissez, vous êtes associateurs. Le danger. Le miroir m'avertit que manger sans bénédiction peut mener à l'association.`,
  reflection: `Manger sans le nom d'Allah est un pas vers l'association. La bénédiction protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laa ta-kuloo mimmaa lam yadhkiris-mullaahi 'alayh wa innahu la-fisq wa innash-shayaateena la-yuhoona ilaa awliyaaa'ihim li-yujaadilookum wa in ata'tumoohum innakum lamushrikoon » — ne mangez pas ce qui n'a pas le nom d'Allah. C'est une perversité. Les démons inspirent leurs alliés. Si vous les obéissez, vous êtes associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prononce le nom d'Allah sur ma nourriture ? La bénédiction est-elle une habitude ou une conscience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture sans bénédiction nourrit le corps mais pas l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est béni par le nom de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La basmala est une protection invisible." }
  ],
  munajat: `Ya Rabb, je prononce Ton nom sur ma nourriture. La bénédiction est ma protection. Ne permets pas que je sois parmi ceux qui mangent sans bénédiction.`
};

MIROIR["6:123"] = {
  reference: "6:123",
  theme: ["complot", "grands", "ruse"],
  emotion: "Vigilance, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Makr", "Al-Kubara"],
  mirrorVersion: `« C'est ainsi que Nous avons placé dans chaque cité des grands criminels. » Le miroir me montre la structure sociale de l'injustice. « Wa kadhaalika ja'alnaa fee kulli qaryatin akabira mujrimeehaa » — c'est ainsi que Nous avons placé dans chaque cité des grands criminels. La présence du mal. « Li-yamkuroo feehaa » — pour qu'ils y complotent. L'action. « Wa maa yamkuroona illaa bi-anfusihim » — et ils ne complotent que contre eux-mêmes. La conséquence. « Wa laa yash'uroon » — et ils ne le savent pas. L'ignorance. Le miroir m'enseigne que les complots des grands se retournent contre eux.`,
  reflection: `Les complots des grands se retournent contre eux. Ils ne le savent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhaalika ja'alnaa fee kulli qaryatin akabira mujrimeehaa li-yamkuroo feehaa wa maa yamkuroona illaa bi-anfusihim wa laa yash'uroon » — ainsi Nous plaçons dans chaque cité des grands criminels pour qu'ils y complotent. Ils ne complotent que contre eux-mêmes sans le savoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels complots m'entourent ? Est-ce que je crains les hommes ou Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le complot contre les croyants est un complot contre soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne complote pas — il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La ruse d'Allah est plus grande que toutes les ruses." }
  ],
  munajat: `Ya Rabb, les complots m'entourent. Mais Tu es le Meilleur des Complotteurs pour les croyants. Protège-moi des grands criminels.`
};

MIROIR["6:124"] = {
  reference: "6:124",
  theme: ["révélation", "exigence", "orgueil"],
  emotion: "Humilité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahy", "Al-Kitab"],
  mirrorVersion: `« Quand une révélation leur vient, ils disent : nous ne croirons pas qu'on nous envoie un messager. » Le miroir me montre l'orgueil du refus. « Wa idhaa jaaa'at-hum aayatun qaaloo lan nu'mina hatta nu'taa mithla maaa ootiya rusulullaah » — quand une révélation leur vient, ils disent : nous ne croirons pas qu'on nous envoie un messager. L'exigence d'égalité. « Allaahu a'lamu haythu yaj'alu risaalatah » — Allah sait mieux où placer Son message. La sagesse divine. « Sayuseebul-ladheena ajramoo saaghaatun 'indallaahi wa 'adhaabun shadeed » — ceux qui ont commis des crimes seront atteints d'humiliation et d'un dur châtiment. La conséquence. Le miroir m'enseigne que la révélation n'est pas démocratique.`,
  reflection: `La révélation n'est pas démocratique. Allah choisit qui Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idhaa jaaa'at-hum aayatun qaaloo lan nu'mina hatta nu'taa mithla maaa ootiya rusulullaah allaahu a'lamu haythu yaj'alu risaalatah » — quand une révélation vient, ils disent : nous ne croirons pas jusqu'à recevoir ce que les messagers ont reçu. Allah sait mieux où placer Son message." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'exige d'Allah ce qu'Il ne m'a pas donné ? Ou est-ce que j'accepte Sa sagesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exigence orgueilleuse est un voile sur la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte ce qu'Allah lui donne sans exigence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation humble ouvre plus de portes que l'exigence orgueilleuse." }
  ],
  munajat: `Ya Rabb, je n'exige rien. J'accepte Ta sagesse. Tu sais mieux où placer Ton message. L'humiliation des criminels est Ta justice.`
};

MIROIR["6:125"] = {
  reference: "6:125",
  theme: ["cœur", "ouverture", "fermeture"],
  emotion: "Espoir, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qalb", "As-Sadr"],
  mirrorVersion: `« Celui qu'Allah veut guider, Il lui ouvre la poitrine pour l'Islam. » Le miroir me montre le don de la guidance. « Faman yuridillaahu an yahdiyahu yashrah sadrahu lil-islam » — celui qu'Allah veut guider, Il lui ouvre la poitrine pour l'Islam. L'ouverture. « Wa man yurid an yudillahu yaj'al sadrahu dayyiqan harajan » — et celui qu'Il veut égarer, Il rend sa poitrine étroite et oppressée. La fermeture. « Ka-annamaa yassa''adu fis-samaa » — comme s'il montait au ciel. La difficulté. « Kadhaalika yaj'alullaahir-rijsa 'alal-ladheena laa yu'minoon » — ainsi Allah place l'impureté sur ceux qui ne croient pas. La conséquence. Le miroir m'enseigne que l'ouverture du cœur est un don.`,
  reflection: `L'ouverture du cœur est un don d'Allah. La fermeture est une conséquence du refus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faman yuridillaahu an yahdiyahu yashrah sadrahu lil-islam wa man yurid an yudillahu yaj'al sadrahu dayyiqan harajan ka-annamaa yassa''adu fis-samaa kadhaalika yaj'alullaahir-rijsa 'alal-ladheena laa yu'minoon » — celui qu'Allah veut guider, Il ouvre sa poitrine. Celui qu'Il veut égarer, Il rend sa poitrine étroite comme s'il montait au ciel. Allah place l'impureté sur les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il ouvert ou étroit ? L'islam est-il une libération ou une oppression ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture du cœur précède la guidance — la fermeture suit le refus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a la poitrine ouverte à l'ordre de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'istikhara est la prière pour l'ouverture du cœur." }
  ],
  munajat: `Ya Musharrih, ouvre ma poitrine pour l'Islam. Ne permets pas que mon cœur soit étroit. La guidance est Ton don — je la demande.`
};

MIROIR["6:126"] = {
  reference: "6:126",
  theme: ["chemin", "droiture", "facilité"],
  emotion: "Confiance, paix",
  difficulty: "débutant",
  relatedNames: ["As-Sirat", "Al-Mustaqim"],
  mirrorVersion: `« Et c'est le chemin droit de ton Seigneur. » Le miroir me montre la nature du chemin. « Wa haadha siratu rabbika mustaqeem » — et c'est le chemin droit de ton Seigneur. La droiture. « Qad fas-salnal-aayaati li-qawmin yazzakkaroon » — Nous avons détaillé les signes pour un peuple qui se rappelle. Le rappel. Le miroir m'enseigne que le chemin est clair pour ceux qui se rappellent.`,
  reflection: `Le chemin est droit et clair. Les signes sont détaillés pour ceux qui se rappellent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa haadha siratu rabbika mustaqeem qad fas-salnal-aayaati li-qawmin yazzakkaroon » — et c'est le chemin droit de ton Seigneur. Nous avons détaillé les signes pour un peuple qui se rappelle." },
    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Est-ce que je suis le chemin droit ? Est-ce que je me rappelle des signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin est droit — ceux qui se rappellent le voient clairement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit le chemin droit de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel est la clé pour voir le chemin." }
  ],
  munajat: `Ya Rabb, Ton chemin est droit. Fais que je le voie. Les signes sont détaillés — aide-moi à me rappeler.`
};

MIROIR["6:127"] = {
  reference: "6:127",
  theme: ["paix", "demeure", "sécurité"],
  emotion: "Espérance, sérénité",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Dar"],
  mirrorVersion: `« Pour eux est la demeure de la paix auprès de leur Seigneur. » Le miroir me montre la promesse finale. « Lahum daarus-salaami 'inda rabbihim » — pour eux est la demeure de la paix auprès de leur Seigneur. La paix. « Wa huwa waliyyuhum bimaa kaanoo ya'maloon » — et Il est leur Protecteur pour ce qu'ils faisaient. La rétribution. Le miroir m'enseigne que la paix éternelle attend les croyants.`,
  reflection: `La paix éternelle attend les croyants. Allah est leur Protecteur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum daarus-salaami 'inda rabbihim wa huwa waliyyuhum bimaa kaanoo ya'maloon » — pour eux est la demeure de la paix auprès de leur Seigneur. Il est leur Protecteur pour ce qu'ils faisaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à la demeure de la paix ? Mes œuvres sont-elles dignes de cette protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix éternelle est le reflet de la paix intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers aspire à la paix de son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La paix intérieure est un avant-goût de la demeure de la paix." }
  ],
  munajat: `Ya Salam, la demeure de la paix m'attend. Fais que mes œuvres soient dignes. Tu es mon Protecteur.`
};

MIROIR["6:128"] = {
  reference: "6:128",
  theme: ["rassemblement", "djinn", "châtiment"],
  emotion: "Solennité, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jinn", "Al-Hashr"],
  mirrorVersion: `« Le jour où Il les rassemblera tous. » Le miroir me montre le rassemblement universel. « Yawma yahshuruhum jamee'aa » — le jour où Il les rassemblera tous. Le rassemblement. « Yaa ma'sharal-jinni qad istakthartum minal-ins » — ô communauté des djinns, vous avez abusé des humains. L'accusation. « Wa qaalaa awliyaaa'uhum minal-ins » — et leurs alliés parmi les humains. La complicité. « Rabbanaa tamatta'naa ba'dunaa bi-ba'd » — Seigneur, nous avons joui les uns des autres. La confession. « Wa balagna ajalanalladhee ajjal-ta lana » — et nous avons atteint le terme que Tu as fixé. La fin. « Qal-jaaruz-zannawa antum minhaa » — le feu est votre demeure. Le jugement. Le miroir m'enseigne que le Jour du rassemblement révélera toutes les complicités.`,
  reflection: `Le Jour du rassemblement révélera toutes les complicités. Le feu attend les complices.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yahshuruhum jamee'aa yaa ma'sharal-jinni qad istakthartum minal-ins wa qaalaa awliyaaa'uhum minal-ins rabbanaa tamatta'naa ba'dunaa bi-ba'd » — le jour où Il les rassemblera : ô djinns, vous avez abusé des humains. Et leurs alliés parmi les humains diront : Seigneur, nous avons joui les uns des autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles complicités ai-je ? Avec qui suis-je allié ? Le Jour révélera tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les complicités dans le mal deviennent des accusations au Jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoignera contre les complices." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le terme fixé est la limite de la patience divine." }
  ],
  munajat: `Ya Hashir, Tu nous rassembleras. Ne permets pas que je sois parmi les complices du mal. Le terme est fixé — aide-moi à m'y préparer.`
};

MIROIR["6:129"] = {
  reference: "6:129",
  theme: ["amitié", "consequence", "justice"],
  emotion: "Réalité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wilayah", "Al-Jaza'"],
  mirrorVersion: `« C'est ainsi que Nous faisons se lier les injustes les uns aux autres. » Le miroir me montre la loi des affinités spirituelles. « Wa kadhaalika nulqi ba'daz-zalimeena ba'dan » — c'est ainsi que Nous faisons se lier les injustes les uns aux autres. La conséquence. Les injustes s'attirent par leurs œuvres. Le miroir m'enseigne que nos compagnies révèlent notre état spirituel.`,
  reflection: `Nos compagnies révèlent notre état spirituel. Les injustes s'attirent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhaalika nulqi ba'daz-zalimeena ba'dan » — c'est ainsi que Nous faisons se lier les injustes les uns aux autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes compagnies ? Quelles affinités spirituelles ai-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les justes s'attirent comme les injustes s'attirent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'attire par la loi divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compagnie des justes est une bénédiction." }
  ],
  munajat: `Ya Rabb, fais que mes compagnies soient justes. Les injustes s'attirent — ne permets pas que je sois parmi eux. La bonne compagnie est un don.`
};

MIROIR["81:15"] = {
  reference: "81:15",
  theme: ["planètes", "cours", "serment"],
  emotion: "Émerveillement, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Khunnas", "Al-Jawari"],
  mirrorVersion: `« Non ! Je jure par les planètes qui se cachent. » Le miroir introduit un serment divin : « Fa la uqsimu bil-khunnas » — Non ! Je jure par les planètes qui se cachent. Le « kunnas » sont les étoiles qui se cachent le jour et apparaissent la nuit. Allah jure par Sa création pour attirer l'attention sur Son message. Le miroir m'enseigne : la création est témoin de la vérité.`,
  reflection: `Allah jure par les planètes. La création témoigne pour le Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa la uqsimu bil-khunnas » — Non ! Je jure par les planètes qui se cachent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les planètes comme témoins d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les planètes qui se cachent révèlent le Créateur qui ne se cache pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque planète dans son cours proclame la grandeur d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le serment par les planètes élève leur statut — et le nôtre." }
  ],
  munajat: `Ya Rabb, les planètes témoignent pour Toi. Fais que je voie Ta grandeur dans chaque créature. Les planètes Te proclament.`
};

MIROIR["81:16"] = {
  reference: "81:16",
  theme: ["cours", "disparition", "serment"],
  emotion: "Émerveillement, ordre",
  difficulty: "débutant",
  relatedNames: ["Al-Jawari", "Al-Khunnas"],
  mirrorVersion: `« Qui courent et disparaissent. » Le miroir continue : « Al-jawari al-khunnas » — qui courent et disparaissent. Le mouvement des planètes est à la fois visible et invisible — elles courent dans leur orbite et disparaissent de vue. Le miroir m'enseigne : l'ordre cosmique est à la fois manifeste et caché.`,
  reflection: `Les planètes courent et disparaissent. L'ordre divin est visible et invisible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-jawari al-khunnas » — qui courent et disparaissent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois l'ordre dans le mouvement des planètes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mouvement et la disparition sont les deux faces de l'ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque planète suit son cours — rien ne dévie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit son cours comme les planètes ne s'égare pas." }
  ],
  munajat: `Ya Rabb, les planètes suivent leur cours. Fais que je suive mon cours vers Toi. Ne permets pas que je dévie.`
};

MIROIR["81:17"] = {
  reference: "81:17",
  theme: ["nuit", "obscurité", "serment"],
  emotion: "Paix, mystère",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Ghasaq"],
  mirrorVersion: `« Et par la nuit quand elle s'obscurcit. » Le miroir ajoute : « Wa al-layli idha 'as'as » — et par la nuit quand elle s'obscurcit. La nuit n'est pas absence — elle est présence de l'obscurité. Elle a son rythme, son mystère. Le miroir m'enseigne : chaque moment a sa signification.`,
  reflection: `La nuit s'obscurcit. Chaque moment a son enseignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-layli idha 'as'as » — et par la nuit quand elle s'obscurcit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que la nuit m'enseigne ? Quelle est sa signification dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obscurité de la nuit prépare la lumière du jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est nécessaire — elle porte son secret." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah jure par la nuit — elle a Son amour." }
  ],
  munajat: `Ya Rabb, la nuit porte son secret. Fais que je comprenne son enseignement. Bénis mes nuits comme mes jours.`
};

MIROIR["81:18"] = {
  reference: "81:18",
  theme: ["aube", "respiration", "serment"],
  emotion: "Espoir, renouveau",
  difficulty: "débutant",
  relatedNames: ["Al-Subh", "Al-Tanaffus"],
  mirrorVersion: `« Et par l'aube quand elle respire. » Le miroir continue : « Wa al-subhi idha tanaffas » — et par l'aube quand elle respire. L'aube n'est pas un moment — elle est une respiration, un souffle de vie. Le jour nouveau naît comme un souffle. Le miroir m'enseigne : chaque aube est une nouvelle création.`,
  reflection: `L'aube respire. Chaque jour est une nouvelle vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-subhi idha tanaffas » — et par l'aube quand elle respire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je reçois chaque aube ? Comme une nouvelle vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La respiration de l'aube est le souffle de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube apporte la lumière et la vie — chaque jour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille l'aube accueille la miséricorde nouvelle." }
  ],
  munajat: `Ya Rabb, l'aube respire Ta miséricorde. Fais que chaque matin soit une nouvelle vie. Bénis mes aubes.`
};

MIROIR["81:19"] = {
  reference: "81:19",
  theme: ["parole", "noblesse", "messager"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Qawl", "Al-Karim"],
  mirrorVersion: `« C'est la parole d'un noble messager. » Le miroir révèle : « Innahu la qawlu rasulin karim » — c'est la parole d'un noble messager. Le Coran n'est pas la parole d'un poète ou d'un devin — c'est la parole d'un messager noble, Gabriel. Le miroir m'enseigne : la noblesse du porteur élève le message.`,
  reflection: `Le Coran vient d'un messager noble. Son statut élève le message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu la qawlu rasulin karim » — c'est la parole d'un noble messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite le Coran comme la parole d'un messager noble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse du messager reflète la noblesse de l'Envoyeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les messagers nobles d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La noblesse du messager inspire la noblesse dans le receveur." }
  ],
  munajat: `Ya Rabb, merci pour Ton messager noble. Fais que je reçoive son message avec la noblesse qu'il mérite.`
};

MIROIR["81:20"] = {
  reference: "81:20",
  theme: ["force", "trône", "obéissance"],
  emotion: "Révérence, grandeur",
  difficulty: "débutant",
  relatedNames: ["Al-'Arsh", "Al-Mak'in"],
  mirrorVersion: `« Doué de force, établi auprès du Maître du Trône. » Le miroir décrit : « Dhi quwwatin 'inda dhi al-'arshi makinin » — doué de force, établi auprès du Maître du Trône. Gabriel n'est pas un messager ordinaire — il est puissant, établi près d'Allah. Le miroir m'enseigne : la proximité d'Allah élève le statut.`,
  reflection: `Gabriel est puissant et proche du Trône. Son statut révèle l'importance du message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhi quwwatin 'inda dhi al-'arshi makinin » — doué de force, établi auprès du Maître du Trône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur du messager qui a transmis le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force du messager est au service du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges les plus proches du Trône sont les plus grands." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La proximité du Trône inspire la force dans le messager." }
  ],
  munajat: `Ya Rabb, Ton messager est puissant et proche du Trône. Fais que je respecte son message. Fais que je m'approche de Toi.`
};

MIROIR["81:21"] = {
  reference: "81:21",
  theme: ["obéissance", "confiance", "ange"],
  emotion: "Confiance, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Muta'", "Al-Amin"],
  mirrorVersion: `« Obéi là-haut, et digne de confiance. » Le miroir continue : « Mut'in there thumma amin » — obéi là-haut, et digne de confiance. Gabriel est obéi par les autres anges et digne de confiance dans sa transmission. Le miroir m'enseigne : l'obéissance et la confiance sont les qualités du messager parfait.`,
  reflection: `Gabriel est obéi et digne de confiance. Ses qualités reflètent sa mission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mut'in thumma amin » — obéi là-haut, et digne de confiance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis digne de confiance dans mes paroles et actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance dans le messager permet la confiance dans le message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges obéissent à Gabriel — et lui obéit à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance mutuelle est le fondement de la transmission." }
  ],
  munajat: `Ya Amin, Tu es le Digne de confiance. Fais que je sois digne de confiance. Fais que mes paroles soient vraies.`
};

MIROIR["81:22"] = {
  reference: "81:22",
  theme: ["compagnon", "vision", "messager"],
  emotion: "Confiance, proximité",
  difficulty: "débutant",
  relatedNames: ["Al-Sahib", "Al-Bashir"],
  mirrorVersion: `« Votre compagnon n'est pas un possédé. » Le miroir défend : « Wa ma sahibukum bi-majnun » — votre compagnon n'est pas un possédé. Le Prophète était connu des Quraysh — ils connaissaient son caractère. Son comportement témoignait de sa sincérité. Le miroir m'enseigne : le comportement est le meilleur témoignage.`,
  reflection: `Le Prophète était connu et respecté. Son comportement témoignait de sa vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma sahibukum bi-majnun » — votre compagnon n'est pas un possédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon comportement témoigne-t-il de ma foi ? Les autres voient-ils la vérité en moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de folie révèle la folie des accusateurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont souvent accusés — mais leur comportement les justifie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sincérité du cœur se manifeste dans la cohérence de la vie." }
  ],
  munajat: `Ya Rabb, le Prophète était connu pour sa vérité. Fais que mon comportement témoigne de ma foi. Ne permets pas l'incohérence.`
};

MIROIR["81:23"] = {
  reference: "81:23",
  theme: ["vision", "horizon", "révélation"],
  emotion: "Révérence, révélation",
  difficulty: "débutant",
  relatedNames: ["Al-Ufuq", "Al-Mubin"],
  mirrorVersion: `« Et il l'a vu clairement à l'horizon. » Le miroir confirme : « Wa laqad ra'ahu bil-ufuqi al-mubin » — et il l'a vu clairement à l'horizon. Le Prophète a vu Gabriel sous sa forme originelle. La vision n'était pas une illusion — elle était réelle. Le miroir m'enseigne : la révélation vient par des voies réelles.`,
  reflection: `La vision du Prophète était réelle. La révélation est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ra'ahu bil-ufuqi al-mubin » — et il l'a vu clairement à l'horizon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la réalité de la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vision claire de l'horizon annonce le message clair." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'horizon est le lieu de rencontre entre le visible et l'invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah Se révèle à qui Il veut, où Il veut, quand Il veut." }
  ],
  munajat: `Ya Rabb, Tu T'es révélé à Ton Prophète. Merci pour la révélation claire. Fais que je la reçoive avec clarté.`
};

MIROIR["81:24"] = {
  reference: "81:24",
  theme: ["caché", "révélation", "connaissance"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghayb", "Al-'Ilm"],
  mirrorVersion: `« Et il n'est pas avare concernant le caché. » Le miroir clarifie : « Wa ma huwa 'ala al-ghaybi bi-danin » — et il n'est pas avare concernant le caché. Le Prophète ne retient pas la révélation — il la transmet intégralement. Le miroir m'enseigne : le messager fidèle transmet tout, sans ajouter ni retirer.`,
  reflection: `Le Prophète transmet intégralement. La fidélité du messager garantit la fidélité du message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma huwa 'ala al-ghaybi bi-danin » — et il n'est pas avare concernant le caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transmets fidèlement ce que je reçois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avarice dans la transmission serait une trahison du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est un cadeau — elle doit être partagée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le caché doit le transmettre — c'est un trust." }
  ],
  munajat: `Ya Rabb, le Prophète a transmis intégralement. Fais que je sois fidèle dans ma transmission. Ne permets pas l'avarice.`
};

MIROIR["81:25"] = {
  reference: "81:25",
  theme: ["maudit", "satan", "protection"],
  emotion: "Gratitude, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Rajim", "Al-Shaytan"],
  mirrorVersion: `« Ce n'est point la parole d'un diable maudit. » Le miroir défend : « Wa ma huwa bi-qawli shaytanin rajim » — ce n'est point la parole d'un diable maudit. Le Coran n'est pas inspiré par Satan — il est révélé par Allah. Le miroir m'enseigne : la protection du message garantit sa pureté.`,
  reflection: `Le Coran est pur de toute influence satanique. La protection divine est complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma huwa bi-qawli shaytanin rajim » — ce n'est point la parole d'un diable maudit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que le Coran est pur et protégé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection contre Satan garantit la pureté de la révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah protège Sa parole de toute corruption." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté du message inspire la pureté dans le receveur." }
  ],
  munajat: `Ya Rabb, merci pour la protection de Ta parole. Garde-moi de l'influence de Satan. Fais que je reçoive Ta révélation pure.`
};

MIROIR["81:26"] = {
  reference: "81:26",
  theme: ["destination", "chemin", "attention"],
  emotion: "Questionnement, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Matlah", "Al-Tariq"],
  mirrorVersion: `« Où allez-vous donc ? » Le miroir pose la question : « Fa ayna tadhahabun » — où allez-vous donc ? Cette question traverse les siècles. Quel est notre but ? Où allons-nous vraiment ? Le miroir m'oblige à examiner ma direction.`,
  reflection: `La question « où allez-vous ? » est éternelle. Quel est notre but ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ayna tadhahabun » — où allez-vous donc ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je vais vraiment ? Quel est mon but ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question révèle que beaucoup vont sans savoir où." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chemin a une destination — quelle est la nôtre ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait où il va ne s'égare pas." }
  ],
  munajat: `Ya Rabb, où est-ce que je vais ? Clarifie ma destination. Fais que je sache où je vais — vers Toi.`
};

MIROIR["81:28"] = {
  reference: "81:28",
  theme: ["volonté", "droit", "chemin"],
  emotion: "Liberté, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Iradah", "Al-Mustaqim"],
  mirrorVersion: `« Pour celui d'entre vous qui veut suivre le chemin droit. » Le miroir clarifie : « Liman sha'a minkum an yastaqima » — pour celui d'entre vous qui veut suivre le chemin droit. La guidance est disponible — mais la volonté est nécessaire. Le miroir m'enseigne : la clé est le « vouloir » — qui veut vraiment trouvera.`,
  reflection: `La guidance est pour qui veut. La volonté est la clé du chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Liman sha'a minkum an yastaqima » — pour celui d'entre vous qui veut suivre le chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux vraiment suivre le chemin droit ? Ou est-ce que je veux autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté précède le chemin — qui ne veut pas ne trouve pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin est ouvert — mais il faut marcher." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie volonté attire la guidance divine." }
  ],
  munajat: `Ya Rabb, je veux suivre le chemin droit. Donne-moi la volonté vraie. Fais que je trouve le chemin vers Toi.`
};

MIROIR["81:29"] = {
  reference: "81:29",
  theme: ["volonté", "Allah", "créature"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mashi'ah", "Al-Rabb"],
  mirrorVersion: `« Et vous ne pouvez vouloir que si Allah le veut, le Seigneur des mondes. » Le miroir conclut : « Wa ma tasha'una illa an yasha'a Allahu rabbu al-'alamin » — et vous ne pouvez vouloir que si Allah le veut. Notre volonté elle-même dépend de Sa volonté. Le miroir m'enseigne : même notre capacité de choisir vient de Lui.`,
  reflection: `Notre volonté dépend de Sa volonté. Tout revient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma tasha'una illa an yasha'a Allahu rabbu al-'alamin » — et vous ne pouvez vouloir que si Allah le veut, le Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Même ma volonté dépend de Lui. Comment puis-je être orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La volonté humaine est un don — pas une propriété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature veut ce qu'Allah veut qu'elle veuille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'alignement de notre volonté sur la Sienne est la soumission parfaite." }
  ],
  munajat: `Ya Rabb, même ma volonté vient de Toi. Fais que ma volonté s'aligne sur la Tienne. Fais que je veuille ce que Tu veux.`
};

// ==================== SURAH 82: AL-INFITAR - ADDITIONAL ENTRIES ====================

MIROIR["82:2"] = {
  reference: "82:2",
  theme: ["ciel", "obéissance", "crack"],
  emotion: "Terreur, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Sama", "Al-Muti'ah"],
  mirrorVersion: `« Et quand le ciel sera fendu. » Le miroir continue l'évocation : « Wa idha al-sama'u fatarat » — et quand le ciel sera fendu, fissuré. Le verbe « fatarat » suggère l'obéissance à l'ordre divin. Le ciel se fend parce qu'on lui ordonne de se fendre. Le miroir m'enseigne : la création obéit parfaitement à son Créateur.`,
  reflection: `Le ciel obéit à l'ordre d'Allah. La création entire est soumise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-sama'u fatarat » — et quand le ciel sera fendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis comme le ciel obéit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le ciel se fend par obéissance — moi, j'hésite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création obéit sans question — seul l'homme questionne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance parfaite est la soumission parfaite." }
  ],
  munajat: `Ya Rabb, le ciel obéit parfaitement. Fais que j'obéisse comme lui. Ne permets pas que je résiste à Tes ordres.`
};

MIROIR["82:3"] = {
  reference: "82:3",
  theme: ["mers", "embrasement", "transformation"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Bihar", "Al-Sujjirah"],
  mirrorVersion: `« Et quand les mers seront débordées. » Le miroir ajoute : « Wa idha al-biharu fujjirat » — et quand les mers seront débordées, fait jaillir. Les mers, limitées par leurs rivages, déborderont et se mélangeront. Le miroir m'enseigne : les limites du monde seront levées le Jour.`,
  reflection: `Les mers déborderont. Les limites seront levées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-biharu fujjirat » — et quand les mers seront débordées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles limites dans ma vie seront levées le Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le débordement des mers annonce le débordement de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mers séparées seront réunies — les barrières tomberont." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah lève les limites quand Il veut — nous ne pouvons Le limiter." }
  ],
  munajat: `Ya Rabb, les mers déborderont. Fais que je sois prêt pour la levée des limites. Prépare-moi pour le Jour.`
};

MIROIR["82:4"] = {
  reference: "82:4",
  theme: ["tombes", "renversement", "révélation"],
  emotion: "Réalité, résurrection",
  difficulty: "débutant",
  relatedNames: ["Al-Qubur", "Al-Ba'ith"],
  mirrorVersion: `« Et quand les tombeaux seront bouleversés. » Le miroir continue : « Wa idha al-quburu bu'thirat » — et quand les tombeaux seront bouleversés. Les morts ne resteront pas dans leurs tombes — ils seront réveillés, renversés dehors. Le miroir m'enseigne : la mort n'est pas la fin — c'est une attente.`,
  reflection: `Les tombes seront bouleversées. Les morts se réveilleront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-quburu bu'thirat » — et quand les tombeaux seront bouleversés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma tombe sera bouleversée. Suis-je prêt à me réveiller ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bouleversement des tombes est le réveil des endormis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque tombe contient un dormiteur qui sera réveillé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le réveil n'a pas peur du bouleversement." }
  ],
  munajat: `Ya Ba'ith, les tombes seront bouleversées. Prépare-moi pour mon réveil. Fais que je me réveille parmi les bienheureux.`
};

MIROIR["82:5"] = {
  reference: "82:5",
  theme: ["connaissance", "avance", "retard"],
  emotion: "Clarté, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Chaque âme saura ce qu'elle a avancé et retardé. » Le miroir clarifie : « 'Alimat nafsun ma qaddamat wa akhkhara » — chaque âme saura ce qu'elle a avancé et retardé. La connaissance sera immédiate. Chacun verra ses œuvres — celles faites et celles négligées. Le miroir m'interroge : qu'est-ce que j'avance ? Qu'est-ce que je retarde ?`,
  reflection: `Chaque âme connaîtra ses œuvres. L'avance et le retard seront clairs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alimat nafsun ma qaddamat wa akhkhara » — chaque âme saura ce qu'elle a avancé et retardé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'avance pour mon salut ? Qu'est-ce que je retarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avance sera récompensé — le retard sera regretté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour révèle ce qui était caché — les œuvres bonnes et mauvaises." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avance maintenant n'a pas de retard à regretter." }
  ],
  munajat: `Ya Rabb, je connaîtrai mon avance et mon retard. Fais que j'avance maintenant. Ne permets pas que je retarde le bien.`
};

MIROIR["82:7"] = {
  reference: "82:7",
  theme: ["création", "formation", "Allah"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Sawwar"],
  mirrorVersion: `« Qui t'a créé puis t'a donné forme et t'a équilibré. » Le miroir rappelle : « Alladhi khalaqaka fa-sawwaka fa-'adalak » — Qui t'a créé puis t'a donné forme et t'a équilibré. La création n'est pas accident — elle est œuvre délibérée d'un Créateur attentionné. Le miroir m'enseigne : ma forme et mon équilibre sont des cadeaux.`,
  reflection: `Allah m'a créé, formé, équilibré. Chaque aspect de mon être est Son cadeau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi khalaqaka fa-sawwaka fa-'adalak » — Qui t'a créé puis t'a donné forme et t'a équilibré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que ma forme est un cadeau d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La forme parfaite reflète le Créateur parfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est formée avec sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de la création mène à l'amour du Créateur." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé, formé, équilibré. Merci pour ce cadeau. Fais que je l'utilise pour Te servir.`
};

MIROIR["82:8"] = {
  reference: "82:8",
  theme: ["forme", "choix", "diversité"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Musawwir", "Al-Khaliq"],
  mirrorVersion: `« Dans la forme qu'Il a voulue, Il t'a formé. » Le miroir continue : « Fi ayyi suratin ma sha'a rakkabak » — dans la forme qu'Il a voulue, Il t'a formé. Ma forme n'est pas accidentelle — elle est le choix d'Allah. Le miroir m'enseigne : accepter ma forme est accepter le choix d'Allah.`,
  reflection: `Ma forme est le choix d'Allah. L'accepter est la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi ayyi suratin ma sha'a rakkabak » — dans la forme qu'Il a voulue, Il t'a formé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la forme qu'Allah a choisie pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix d'Allah est le meilleur — même si je ne le comprends pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La diversité des formes reflète la diversité de la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation de ma forme est l'acceptation de mon Créateur." }
  ],
  munajat: `Ya Musawwir, Tu as choisi ma forme. Fais que je l'accepte avec gratitude. Ne permets pas que je la rejette.`
};

MIROIR["82:9"] = {
  reference: "82:9",
  theme: ["mensonge", "religion", "récompense"],
  emotion: "Mise en garde, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Yawm"],
  mirrorVersion: `« Non ! Mais vous traitez de mensonge la Rétribution. » Le miroir avertit : « Kalla bal tukadhdhibuna bil-din » — Non ! Mais vous traitez de mensonge la Rétribution. Le déni du Jour est le problème fondamental. Si on ne croit pas au compte, on ne se prépare pas. Le miroir m'interroge : est-ce que je crois vraiment à la Rétribution ?`,
  reflection: `Le déni de la Rétribution mène à la négligence. La foi au Jour motive la préparation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla bal tukadhdhibuna bil-din » — Non ! Mais vous traitez de mensonge la Rétribution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite de mensonge la Rétribution par mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déni du Jour ne l'empêche pas de venir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour viendra — qu'on y croit ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi au Jour transforme la vie entière." }
  ],
  munajat: `Ya Rabb, je crois en la Rétribution. Fais que ma foi soit vraie. Ne permets pas que je la traite de mensonge par mes actions.`
};

MIROIR["82:10"] = {
  reference: "82:10",
  theme: ["anges", "surveillance", "écriture"],
  emotion: "Conscience, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Hafazah", "Al-Kiram"],
  mirrorVersion: `« Mais il y a des gardiens sur vous. » Le miroir révèle : « Wa innna 'alaykum la-hafizin » — mais il y a des gardiens sur vous. Les anges nous accompagnent, enregistrent nos œuvres. Rien n'est oublié. Le miroir m'enseigne : je ne suis jamais seul — les anges sont témoins.`,
  reflection: `Les anges nous accompagnent. Chaque action est enregistrée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innna 'alaykum la-hafizin » — mais il y a des gardiens sur vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que les anges m'accompagnent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La présence des anges est une responsabilité et un honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque personne a ses anges gardiens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la présence angélique élève le comportement." }
  ],
  munajat: `Ya Rabb, merci pour les anges gardiens. Fais que je vive en sachant qu'ils m'accompagnent. Fais que je ne les déçois pas.`
};

MIROIR["82:11"] = {
  reference: "82:11",
  theme: ["anges", "noblesse", "écriture"],
  emotion: "Révérence, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Kiram", "Al-Katibun"],
  mirrorVersion: `« Des scribes nobles. » Le miroir précise : « Kiraman katibin » — des scribes nobles. Les anges qui écrivent nos œuvres sont nobles. Leur noblesse ajoute à la gravité de l'enregistrement. Le miroir m'enseigne : la noblesse des scribes inspire la noblesse dans nos actions.`,
  reflection: `Les scribes sont nobles. Leur présence nous appelle à la noblesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kiraman katibin » — des scribes nobles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes actions sont dignes d'être écrites par des scribes nobles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse des scribes nous appelle à la noblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges nobles enregistrent tout — le bon et le mauvais." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit avec noblesse honore les scribes nobles." }
  ],
  munajat: `Ya Rabb, les scribes nobles m'accompagnent. Fais que mes actions soient dignes d'eux. Fais que je vive avec noblesse.`
};

MIROIR["82:12"] = {
  reference: "82:12",
  theme: ["connaissance", "action", "enregistrement"],
  emotion: "Conscience, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khatib"],
  mirrorVersion: `« Qui savent ce que vous faites. » Le miroir précise : « Ya'lamuna ma taf'alun » — qui savent ce que vous faites. Les anges ne sont pas des robots — ils comprennent ce qu'ils enregistrent. Le miroir m'enseigne : nos actions ont du sens — elles sont comprises.`,
  reflection: `Les anges comprennent nos actions. Rien n'est insignifiant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamuna ma taf'alun » — qui savent ce que vous faites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si les anges comprennent mes actions, est-ce que je les comprends moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compréhension des anges ajoute au sérieux de l'enregistrement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a un sens — et les anges le connaissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de l'enregistrement élève chaque action." }
  ],
  munajat: `Ya Rabb, les anges comprennent mes actions. Fais que je les comprenne aussi. Fais que chaque action ait un sens.`
};

MIROIR["82:13"] = {
  reference: "82:13",
  theme: ["vertueux", "délices", "récompense"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Abrar", "Al-Na'im"],
  mirrorVersion: `« Les vertueux seront dans des délices. » Le miroir promet : « Inna al-abrar la-fi na'im » — les vertueux seront dans des délices. La récompense suit la vertu. Le délice n'est pas seulement matériel — il est spirituel. Le miroir m'enseigne : la vertu maintenant prépare le délice alors.`,
  reflection: `Les vertueux seront dans les délices. La vertu a sa récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-abrar la-fi na'im » — les vertueux seront dans des délices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les vertueux ? Qu'est-ce que je fais pour le délice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délice suit la vertu — la souffrance suit le vice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah récompense chaque vertu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délice du Paradis est la continuation de la délice de la vertu." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les vertueux. Fais que je goûte aux délices du Paradis. La vertu mène au délice.`
};

MIROIR["82:14"] = {
  reference: "82:14",
  theme: ["méchants", "enfer", "châtiment"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Fujjar", "Al-Jahim"],
  mirrorVersion: `« Et les méchants seront dans la Fournaise. » Le miroir avertit : « Wa inna al-fujjara la-fi jahim » — et les méchants seront dans la Fournaise. Le contraste est clair : vertueux → délices, méchants → fournaise. Le miroir m'enseigne : les choix de la vie déterminent le sort éternel.`,
  reflection: `Les méchants seront dans la Fournaise. Nos choix ont des conséquences éternelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna al-fujjara la-fi jahim » — et les méchants seront dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'éloigne des actions des méchants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méchanceté mène à la fournaise — la vertu mène au délice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah punit chaque méchanceté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La méchanceté a un prix — le méchant le paiera." }
  ],
  munajat: `Ya Rabb, protège-moi de la Fournaise. Fais que je ne sois pas parmi les méchants. Épargne-moi le châtiment.`
};

MIROIR["82:15"] = {
  reference: "82:15",
  theme: ["jour", "brûlement", "rétribution"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-Jahim"],
  mirrorVersion: `« Ils y brûleront le Jour de la Rétribution. » Le miroir précise : « Yaslawnaha yawma al-din » — ils y brûleront le Jour de la Rétribution. Le Jour de la Rétribution n'est pas abstrait — c'est le jour où les comptes sont réglés. Le miroir m'enseigne : la Rétribution est certaine.`,
  reflection: `Le Jour de la Rétribution est certain. Les comptes seront réglés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaslawnaha yawma al-din » — ils y brûleront le Jour de la Rétribution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour le Jour de la Rétribution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le brûlement est le résultat des choix — pas un accident." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Rétribution est la justice parfaite d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas peur de la Rétribution." }
  ],
  munajat: `Ya Rabb, le Jour de la Rétribution vient. Prépare-moi. Fais que je ne brûle pas. Fais que je sois parmi les sauvés.`
};

MIROIR["82:16"] = {
  reference: "82:16",
  theme: ["évasion", "impossibilité", "enfer"],
  emotion: "Réalité, impuissance",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Muhit"],
  mirrorVersion: `« Et ils ne pourront s'en écarter. » Le miroir ajoute : « Wa ma hum 'anha bi-gha'ibin » — et ils ne pourront s'en écarter, y échapper. L'enfer n'est pas temporaire — on ne peut pas s'échapper. Le miroir m'avertit : les conséquences sont permanentes.`,
  reflection: `L'enfer est inévitable pour ses habitants. L'évasion est impossible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma hum 'anha bi-gha'ibin » — et ils ne pourront s'en écarter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que le châtiment peut être permanent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité d'évasion montre la gravité du choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment est juste — l'évasion serait injustice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur de l'impossibilité d'évasion motive la prévention." }
  ],
  munajat: `Ya Rabb, le châtiment est permanent pour ses habitants. Protège-moi de l'enfer. Ne permets pas que j'y sois coincé.`
};

MIROIR["82:17"] = {
  reference: "82:17",
  theme: ["connaissance", "jour", "rétribution"],
  emotion: "Questionnement, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Yawm"],
  mirrorVersion: `« Et qui te fera savoir ce qu'est le Jour de la Rétribution ? » Le miroir questionne : « Wa ma adraka ma yawmu al-din » — et qui te fera savoir ce qu'est le Jour de la Rétribution ? La question souligne l'importance et la gravité du Jour. Le miroir m'enseigne : le Jour est au-delà de notre compréhension complète.`,
  reflection: `Le Jour de la Rétribution dépasse notre compréhension. Sa gravité est immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma yawmu al-din » — et qui te fera savoir ce qu'est le Jour de la Rétribution ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends vraiment la gravité du Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question souligne que le Jour est plus grand que ce que nous pensons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour transforme tout — même notre compréhension." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'incompréhension du Jour devrait nous pousser à la préparation." }
  ],
  munajat: `Ya Rabb, je ne comprends pas pleinement le Jour. Mais je le crains. Prépare-moi pour ce que je ne comprends pas.`
};

MIROIR["82:18"] = {
  reference: "82:18",
  theme: ["question", "répétition", "importance"],
  emotion: "Questionnement, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Yawm"],
  mirrorVersion: `« Encore une fois, qui te fera savoir ce qu'est le Jour de la Rétribution ? » Le miroir répète : « Thumma ma adraka ma yawmu al-din » — encore une fois, qui te fera savoir ce qu'est le Jour de la Rétribution ? La répétition n'est pas redondance — c'est insistance. Le miroir m'enseigne : le Jour est si important qu'il mérite répétition.`,
  reflection: `La répétition souligne l'importance. Le Jour mérite notre attention.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ma adraka ma yawmu al-din » — encore une fois, qui te fera savoir ce qu'est le Jour de la Rétribution ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prête assez d'attention au Jour ? La répétition m'interpelle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition divine est un appel à la vigilance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour est le point de convergence de toute la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'insistance sur le Jour montre son importance capitale." }
  ],
  munajat: `Ya Rabb, Tu insistes sur le Jour. Fais que je l'entende. Fais que je me prépare comme s'il était demain.`
};

MIROIR["82:19"] = {
  reference: "82:19",
  theme: ["pouvoir", "décision", "Allah"],
  emotion: "Soumission, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Malak", "Al-Hukm"],
  mirrorVersion: `« Ce jour-là, personne ne pourra rien pour personne. » Le miroir conclut : « Yawma la tamliku nafsun li-nafsin shay'an » — ce jour-là, personne ne pourra rien pour personne. Le pouvoir humain est limité — le pouvoir absolu appartient à Allah. Le miroir m'enseigne : ce jour-là, seul Allah décide.`,
  reflection: `Le Jour, tout pouvoir appartient à Allah. Personne ne peut aider personne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma la tamliku nafsun li-nafsin shay'an » — ce jour-là, personne ne pourra rien pour personne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur qui compte-je ? Le Jour, seul Allah comptera." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance humaine révèle la puissance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour, toutes les créatures sont égales dans leur impuissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est le seul Maître du Jour — et de tout jour." }
  ],
  munajat: `Ya Rabb, le Jour, seul Tu décides. Fais que je compte sur Toi maintenant. Ne permets pas que je compte sur d'autres.`
};

// ==================== SURAH 83: AL-MUTAFFIFIN - MISSING VERSES 3-36 ====================

MIROIR["83:3"] = {
  reference: "83:3",
  theme: ["fraude", "mesure", "injustice"],
  emotion: "Mise en garde, colère",
  difficulty: "débutant",
  relatedNames: ["Al-Tatfif", "Al-Mizan"],
  mirrorVersion: `« Mais quand c'est à eux de mesurer pour les autres, ils diminuent. » Le miroir poursuit la description : « Wa idha kalahum aw wazanuhum yukhsirun » — mais quand c'est à eux de mesurer pour les autres, ils diminuent. La fraude est active — non seulement ils réclament leur dû, mais ils privent les autres du leur. Le miroir m'avertit : l'injustice active est pire que l'injustice passive.`,
  reflection: `L'injustice active est pire que l'injustice passive. Priver les autres de leur dû est un grave péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha kalahum aw wazanuhum yukhsirun » — mais quand c'est à eux de mesurer pour les autres, ils diminuent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne aux autres leur dû ? Ou est-ce que je les prive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui fraude les autres sera fraudé au Jour — la justice est certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est basé sur l'équilibre — la fraude rompt l'équilibre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fraude dans les mesures reflète la fraude dans le cœur." }
  ],
  munajat: `Ya 'Adl, je ne veux pas être un fraudeur. Fais que je donne aux autres leur dû complet. La justice est Ton attribut.`
};

MIROIR["83:4"] = {
  reference: "83:4",
  theme: ["question", "résurrection", "croyance"],
  emotion: "Interrogation, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-Yaqin"],
  mirrorVersion: `« Ces gens-là ne croient-ils pas qu'ils seront ressuscités ? » Le miroir interroge : « Ala yazunnu ula'ika annahum mab'uthun » — ces gens-là ne croient-ils pas qu'ils seront ressuscités ? La question révèle la source de la fraude : l'absence de croyance au Jugement. Celui qui croit au Jugement ne fraude pas. Le miroir m'interroge : ma conduite révèle-t-elle ma croyance au Jugement ?`,
  reflection: `La fraude vient de l'absence de croyance au Jugement. Celui qui croit vraiment ne fraude pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala yazunnu ula'ika annahum mab'uthun » — ces gens-là ne croient-ils pas qu'ils seront ressuscités ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma conduite révèle-t-elle ma croyance au Jugement ? Si je fraude, je ne crois pas vraiment." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La croyance au Jugement prévient la fraude — l'absence de croyance la permet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est la promesse d'Allah — le Jugement suivra." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie croyance transforme la conduite — pas seulement les paroles." }
  ],
  munajat: `Ya Rabb, je crois en la résurrection et au Jugement. Fais que ma croyance se voie dans ma conduite. Je ne veux pas frauder.`
};

MIROIR["83:5"] = {
  reference: "83:5",
  theme: ["jour", "grandeur", "jugement"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-'Azim"],
  mirrorVersion: `« En un Jour terrible. » Le miroir précise : « Yawmin 'azim » — en un Jour terrible, immense. Le Jour du Jugement est « azim » — grand, terrible, immense. Sa grandeur dépasse toute imagination. Le miroir m'enseigne : la grandeur du Jour devrait nous faire craindre toute injustice.`,
  reflection: `Le Jour est immense et terrible. Sa grandeur devrait nous faire craindre toute injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawmin 'azim » — en un Jour terrible, immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur du Jour ? Mon injustice sera jugée." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur du Jour fait paraître petite toute fraude — mais la punition n'est pas petite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera bouleversé ce Jour immense." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La grandeur du Jour exige la grandeur de notre préparation." }
  ],
  munajat: `Ya 'Azim, le Jour est immense. Fais que je le craigne et ne commette aucune injustice. Sa grandeur m'humble.`
};

MIROIR["83:6"] = {
  reference: "83:6",
  theme: ["debout", "humanité", "jugement"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qiyam", "Al-Nas"],
  mirrorVersion: `« Le Jour où les hommes se tiendront debout devant le Seigneur des mondes. » Le miroir décrit : « Yawma yaqumu an-nasu lirabbi al-'alamin » — le Jour où les hommes se tiendront debout devant le Seigneur des mondes. Toute l'humanité sera debout, en attente du Jugement. Le miroir m'enseigne : ce Jour, personne ne sera assis — tous seront en attente.`,
  reflection: `Toute l'humanité sera debout devant Allah. Le Jugement est pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yaqumu an-nasu lirabbi al-'alamin » — le Jour où les hommes se tiendront debout devant le Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à me tenir debout devant Allah ? Tout le monde sera là." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se tenir debout devant le Seigneur est à la fois terreur et honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'humanité sera rassemblée — personne ne manquera." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Se préparer maintenant pour se tenir debout ce Jour." }
  ],
  munajat: `Ya Rabb, je me tiendrai debout devant Toi. Fais que je sois prêt. Toute l'humanité sera là.`
};

MIROIR["83:7"] = {
  reference: "83:7",
  theme: ["registre", "pervers", "Sijjin"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Sijjin", "Al-Fujjar"],
  mirrorVersion: `« Non ! Le registre des pervers est dans le Sijjin. » Le miroir révèle : « Kalla inna kitaba al-fujjari la-fi sijjin » — non ! Le registre des pervers est dans le Sijjin. Le Sijjin est un lieu bas, un registre caché où sont inscrites les actions des pervers. Le miroir m'avertit : les actions sont enregistrées — où sera mon registre ?`,
  reflection: `Les actions des pervers sont dans le Sijjin. Où sera mon registre ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla inna kitaba al-fujjari la-fi sijjin » — non ! Le registre des pervers est dans le Sijjin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où sera mon registre ? Dans le Sijjin ou dans l'Illiyun ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Sijjin est bas — les actions basses y sont enregistrées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la trace de chaque action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le registre suit le niveau de l'action — haute ou basse." }
  ],
  munajat: `Ya Rabb, ne mets pas mon registre dans le Sijjin. Fais que mes actions soient élevées. Je veux être avec les vertueux.`
};

MIROIR["83:8"] = {
  reference: "83:8",
  theme: ["question", "Sijjin", "révélation"],
  emotion: "Questionnement, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Sijjin", "Al-Ma'rifah"],
  mirrorVersion: `« Et qui te fera connaître ce qu'est le Sijjin ? » Le miroir interroge : « Wa ma adraka ma sijjin » — et qui te fera connaître ce qu'est le Sijjin ? La question souligne l'importance de comprendre ce lieu. Le Sijjin est un registre et un lieu — les deux sont liés.`,
  reflection: `Le Sijjin est un registre et un lieu. Comprendre sa nature est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma sijjin » — et qui te fera connaître ce qu'est le Sijjin ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la gravité du Sijjin ? La question m'invite à méditer." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Sijjin est le contraire de l'Illiyun — bas contre haut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses hauteurs et ses profondeurs — le Sijjin est la profondeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Comprendre le Sijjin, c'est craindre d'y être." }
  ],
  munajat: `Ya Rabb, fais-moi comprendre le Sijjin pour le craindre. Je ne veux pas y être. Sa gravité m'éveille.`
};

MIROIR["83:9"] = {
  reference: "83:9",
  theme: ["registre", "écrit", "évident"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Marqum"],
  mirrorVersion: `« Un registre écrit. » Le miroir précise : « Kitabun marqum » — un registre écrit, numéroté. Chaque action est notée avec précision — rien n'est oublié. Le miroir m'enseigne : l'enregistrement est exact — le compte sera précis.`,
  reflection: `Chaque action est notée avec précision. Le compte sera exact.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kitabun marqum » — un registre écrit, numéroté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Chaque action est numérotée — le compte est précis. Qu'est-ce qui est écrit sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le registre numéroté réfute tout oubli — chaque action compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers enregistre tout avec précision — rien n'est perdu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La numérotation implique l'ordre — chaque action a sa place." }
  ],
  munajat: `Ya Rabb, chaque action est écrite et numérotée. Fais que ce qui est écrit sur moi soit bon. La précision du compte m'éveille.`
};

MIROIR["83:10"] = {
  reference: "83:10",
  theme: ["malheur", "négateurs", "ce Jour"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wayl", "Al-Mukadhdhibun"],
  mirrorVersion: `« Malheur, ce Jour-là, aux négateurs ! » Le miroir s'exclame : « Waylun yawma'idhin lil-mukadhdhibin » — malheur, ce Jour-là, aux négateurs ! Le « wayl » est une destruction, un châtiment. Les négateurs — ceux qui traitent la vérité de mensonge — seront perdus. Le miroir m'avertit : nier la vérité a des conséquences.`,
  reflection: `Les négateurs seront perdus. Traiter la vérité de mensonge a des conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waylun yawma'idhin lil-mukadhdhibin » — malheur, ce Jour-là, aux négateurs !" },
    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Est-ce que je traite une vérité de mensonge ? Le malheur vient aux négateurs." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le négateur de la vérité sera nié par la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste vraie même si on la nie — le négateur ne change rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le malheur du négateur commence par le malheur de nier." }
  ],
  munajat: `Ya Rabb, je ne veux pas être parmi les négateurs. Fais que j'accepte la vérité. Le malheur est pour ceux qui nient.`
};

MIROIR["83:11"] = {
  reference: "83:11",
  theme: ["négateurs", "Jugement", "traitement"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mukadhdhibun", "Al-Din"],
  mirrorVersion: `« Ceux qui traitent le Jour de la Rétribution de mensonge. » Le miroir précise : « Alladhina yukadhdhibuna bi-yawmi al-din » — ceux qui traitent le Jour de la Rétribution de mensonge. Le déni du Jugement est le cœur de la mécréance. Celui qui nie le Jugement vit sans compte. Le miroir m'avertit : nier le Jugement libère de toute contrainte morale.`,
  reflection: `Nier le Jugement libère de toute contrainte morale. La croyance au Jugement discipline.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yukadhdhibuna bi-yawmi al-din » — ceux qui traitent le Jour de la Rétribution de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment au Jugement ? Ma vie le montre-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déni du Jugement permet la fraude — la croyance l'empêche." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne du Jugement — chaque fin annonce un compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La croyance au Jugement transforme chaque action." }
  ],
  munajat: `Ya Rabb, je crois au Jour de la Rétribution. Fais que cette croyance transforme ma vie. Je ne veux pas le nier.`
};

MIROIR["83:12"] = {
  reference: "83:12",
  theme: ["négateurs", "coupables", "Jugement"],
  emotion: "Réalité, explication",
  difficulty: "débutant",
  relatedNames: ["Al-Mujrimun", "Al-Din"],
  mirrorVersion: `« Et nul ne le traite de mensonge, sauf tout criminel pécheur. » Le miroir précise : « Wa ma yukadhdhibu bihi illa kullu mu'tadin athim » — et nul ne le traite de mensonge, sauf tout criminel pécheur. Le déni du Jugement n'est pas intellectuel — il est moral. Le criminel nie le Jugement pour échapper au compte. Le miroir m'enseigne : le déni a une motivation.`,
  reflection: `Le déni du Jugement a une motivation : échapper au compte. C'est une fuite morale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yukadhdhibu bihi illa kullu mu'tadin athim » — et nul ne le traite de mensonge, sauf tout criminel pécheur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon motif de nier ou de croire ? Le déni cache souvent un péché." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le péché pousse au déni — le déni permet le péché. Un cercle vicieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité n'est pas affectée par le déni — le criminel reste criminel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clé : reconnaître son péché pour accepter le Jugement." }
  ],
  munajat: `Ya Rabb, je ne veux pas nier le Jugement pour cacher mes péchés. Je les reconnais et me repens. La vérité est meilleure que la fuite.`
};

MIROIR["83:13"] = {
  reference: "83:13",
  theme: ["versets", "récitation", "éloignement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Tilawah"],
  mirrorVersion: `« Quand Nos versets lui sont récités, il dit : 'Des légendes des anciens !' » Le miroir décrit l'attitude du mécréant : « Idha tutla 'alayhi ayatuna qala asatiru al-awwalin » — quand Nos versets lui sont récités, il dit : des légendes des anciens ! Le refus d'écouter précède le déni. Le miroir m'avertit : comment est-ce que j'écoute le Coran ?`,
  reflection: `Comment j'écoute le Coran révèle mon état. Le refus d'écouter précède le déni.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha tutla 'alayhi ayatuna qala asatiru al-awwalin » — quand Nos versets lui sont récités, il dit : des légendes des anciens !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entends le Coran, comment réagis-je ? Avec respect ou indifférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les « légendes des anciens » sont en fait la vérité éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est vivante — pas une légende morte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute avec le cœur entend la vérité." }
  ],
  munajat: `Ya Rabb, fais que je n'appelle pas Tes versets des légendes. Ouvre mon cœur à Ta révélation. Elle est vivante et vraie.`
};

MIROIR["83:14"] = {
  reference: "83:14",
  theme: ["cœur", "rouille", "péché"],
  emotion: "Diagnostic, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qalb", "Al-Ran"],
  mirrorVersion: `« Non ! Mais ce qu'ils ont acquis a rouillé leur cœur. » Le miroir diagnostique : « Kalla bal rana 'ala qulubihim ma kanu yaksibun » — non ! Mais ce qu'ils ont acquis a rouillé leur cœur. Les péchés accumulent une rouille sur le cœur. Cette rouille empêche la vérité de pénétrer. Le miroir m'interroge : qu'est-ce que j'ai accumulé sur mon cœur ?`,
  reflection: `Les péchés rouillent le cœur. La rouille empêche la vérité de pénétrer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla bal rana 'ala qulubihim ma kanu yaksibun » — non ! Mais ce qu'ils ont acquis a rouillé leur cœur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle rouille ai-je sur mon cœur ? Les péchés s'accumulent." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rouille peut être enlevée par le repentir — le cœur peut être poli." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur s'obscurcit ou s'illumine selon les actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La rouille du cœur est progressive — le polissage doit être constant." }
  ],
  munajat: `Ya Rabb, les péchés ont-ils rouillé mon cœur ? Polis-le par Ton pardon. Je veux un cœur pur et réceptif.`
};

MIROIR["83:15"] = {
  reference: "83:15",
  theme: ["voile", "Seigneur", "vision"],
  emotion: "Perte, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hijab", "Al-Rabb"],
  mirrorVersion: `« Non ! Ce Jour-là, ils seront voilés de leur Seigneur. » Le miroir révèle la conséquence : « Kalla innahum 'an rabbihim yawma'idhin la-mahjubun » — non ! Ce Jour-là, ils seront voilés de leur Seigneur. Le plus grand châtiment est d'être voilé d'Allah. Les croyants verront Allah — les mécréants en seront voilés. Le miroir m'avertit : la vision d'Allah est le plus grand bonheur.`,
  reflection: `Le plus grand châtiment est d'être voilé d'Allah. La vision d'Allah est le plus grand bonheur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla innahum 'an rabbihim yawma'idhin la-mahjubun » — non ! Ce Jour-là, ils seront voilés de leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux voir Allah ? Ce privilège est le plus grand." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile maintenant devient le voile plus tard — ou l'ouverture maintenant devient la vision plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier verra Allah — les croyants jouiront, les mécréants seront exclus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vision d'Allah est l'essence du Paradis — le voile est l'essence de l'enfer." }
  ],
  munajat: `Ya Rabb, je ne veux pas être voilé de Toi. Fais que je Te voie. La vision de Ton visage est mon plus grand désir.`
};

MIROIR["83:16"] = {
  reference: "83:16",
  theme: ["enfer", "brûlement", "entrée"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Dukhul"],
  mirrorVersion: `« Puis ils entreront dans la Fournaise. » Le miroir précise le sort : « Thumma innahum la-salû al-jahim » — puis ils entreront dans la Fournaise. Après le voile d'Allah vient le feu. Le miroir m'enseigne : le châtiment est progressif — d'abord le voile, puis le feu.`,
  reflection: `Le châtiment est progressif — d'abord le voile d'Allah, puis le feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma innahum la-salû al-jahim » — puis ils entreront dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'enfer est la conséquence du déni. Vais-je y entrer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu suit le voile — les deux sont liés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Fournaise existe — elle n'est pas une métaphore." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Éviter la Fournaise commence par éviter ce qui y mène." }
  ],
  munajat: `Ya Rabb, protège-moi de la Fournaise. Je ne veux pas y entrer. Le feu suit le voile — garde-moi proche de Toi.`
};

MIROIR["83:17"] = {
  reference: "83:17",
  theme: ["jugement", "question", "réalité"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fasl", "Al-Tasdiq"],
  mirrorVersion: `« Puis on leur dira : 'C'est ce que vous traitiez de mensonge.' » Le miroir conclut : « Thumma yuqalu hadha alladhi kuntum bihi tukadhdhibun » — puis on leur dira : c'est ce que vous traitiez de mensonge. La réalité qu'ils niaient devient leur réalité. Le miroir m'enseigne : nier ne change rien — la vérité reste vraie.`,
  reflection: `Nier ne change rien. La vérité reste vraie et devient réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yuqalu hadha alladhi kuntum bihi tukadhdhibun » — puis on leur dira : c'est ce que vous traitiez de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je traite de mensonge ? La vérité me rattrapera." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge devient vérité confrontante — le déni devient certitude douloureuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours — le mensonge s'effondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Mieux vaut accepter la vérité maintenant que la subir plus tard." }
  ],
  munajat: `Ya Rabb, je ne veux pas traiter la vérité de mensonge. Fais que je l'accepte maintenant. La vérité est Ta parole.`
};

MIROIR["83:18"] = {
  reference: "83:18",
  theme: ["registre", "vertueux", "Illiyun"],
  emotion: "Espoir, bonheur",
  difficulty: "débutant",
  relatedNames: ["Al-Illiyun", "Al-Abrar"],
  mirrorVersion: `« Non ! Le registre des vertueux est dans l'Illiyun. » Le miroir révèle le contraste : « Kalla inna kitaba al-abrari la-fi 'illiyun » — non ! Le registre des vertueux est dans l'Illiyun. L'Illiyun est le lieu élevé — le registre des vertueux y est gardé. Le miroir m'offre l'espoir : les actions des vertueux sont élevées.`,
  reflection: `Les actions des vertueux sont dans l'Illiyun — le lieu élevé. L'espoir pour les bienfaiteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla inna kitaba al-abrari la-fi 'illiyun » — non ! Le registre des vertueux est dans l'Illiyun." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon registre sera-t-il dans l'Illiyun ? Les actions élevées y sont enregistrées." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'Illiyun est haut — les actions hautes y sont enregistrées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les hauteurs de l'univers accueillent les actions hautes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Élever ses actions, c'est élever son registre." }
  ],
  munajat: `Ya Rabb, fais que mon registre soit dans l'Illiyun. Mes actions élevées y seront enregistrées. Je veux être parmi les vertueux.`
};

MIROIR["83:19"] = {
  reference: "83:19",
  theme: ["question", "Illiyun", "révélation"],
  emotion: "Questionnement, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Illiyun", "Al-Ma'rifah"],
  mirrorVersion: `« Et qui te fera connaître ce qu'est l'Illiyun ? » Le miroir interroge : « Wa ma adraka ma 'illiyun » — et qui te fera connaître ce qu'est l'Illiyun ? La question souligne l'importance de ce lieu élevé. Le miroir m'invite à méditer sur les hauteurs promises aux vertueux.`,
  reflection: `L'Illiyun est un lieu élevé de haute importance. Médite sur sa grandeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma 'illiyun » — et qui te fera connaître ce qu'est l'Illiyun ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à l'Illiyun ? La question m'invite à le désirer." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'Illiyun est le contraire du Sijjin — haut contre bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les hauteurs de l'univers reflètent les hauteurs spirituelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Comprendre l'Illiyun, c'est aspirer à y être." }
  ],
  munajat: `Ya Rabb, fais-moi comprendre l'Illiyun pour l'aspirer. Je veux être dans les hauteurs avec les vertueux.`
};

MIROIR["83:20"] = {
  reference: "83:20",
  theme: ["registre", "écrit", "proche"],
  emotion: "Espérance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Mashhud"],
  mirrorVersion: `« Un registre écrit, vu par les plus proches. » Le miroir précise : « Kitabun marqum yashruhuhu al-muqarrabun » — un registre écrit, numéroté, que voient les plus proches d'Allah. Les anges proches voient ce registre — ils connaissent les noms des vertueux. Le miroir m'enseigne : les anges connaissent les bienfaiteurs.`,
  reflection: `Les anges proches voient le registre des vertueux. Les bienfaiteurs sont connus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kitabun marqum yashruhuhu al-muqarrabun » — un registre écrit, vu par les plus proches." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les anges me connaissent-ils comme vertueux ? Mon nom est-il dans l'Illiyun ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être vu par les anges proches est un honneur — les vertueux sont honorés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges proches d'Allah voient les actions des hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La proximité des anges reflète la proximité d'Allah." }
  ],
  munajat: `Ya Rabb, fais que mon nom soit vu par les anges proches. Je veux être connu comme vertueux. Les anges proches T'honorent.`
};

MIROIR["83:21"] = {
  reference: "83:21",
  theme: ["anges", "vision", "proximité"],
  emotion: "Espérance, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "Al-Muqarrabun"],
  mirrorVersion: `« Les anges les plus proches le voient. » Le miroir précise : les anges les plus proches d'Allah voient le registre de l'Illiyun. Ces anges — Jibril, Mika'il, Israfil — connaissent les noms des vertueux. Le miroir m'enseigne : la compagnie des anges commence ici-bas par les bonnes actions.`,
  reflection: `Les anges proches connaissent les vertueux. La compagnie des anges commence par les bonnes actions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les anges les plus proches le voient — les muqarrabun." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que les anges me connaissent ? Mes actions m'introduisent auprès d'eux." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les anges proches voient ce qui est proche d'Allah — les vertueux sont proches." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges parcourent l'univers — ils notent et connaissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être connu des anges, c'est être connu d'Allah." }
  ],
  munajat: `Ya Rabb, fais que les anges proches me connaissent. Mes actions m'introduisent auprès d'eux. Je veux être proche de Toi.`
};

MIROIR["83:22"] = {
  reference: "83:22",
  theme: ["vertueux", "délices", "position"],
  emotion: "Joie, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Abrar", "Al-Na'im"],
  mirrorVersion: `« Les vertueux seront dans les délices. » Le miroir promet : « Inna al-abrara la-fi na'im » — les vertueux seront dans les délices. Le na'im est le bonheur complet — plaisirs, paix, satisfaction. Le miroir m'invite à aspirer à cette récompense par la vertu.`,
  reflection: `Les vertueux seront dans les délices. La vertu mène au bonheur complet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-abrara la-fi na'im » — les vertueux seront dans les délices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les vertueux ? Le na'im m'attend si je le suis." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu dans ce monde mène aux délices dans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est préparé pour les vertueux — ses délices sont prêts." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les délices du Paradis commencent par la paix du cœur vertueux ici-bas." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les vertueux. Les délices du Paradis m'attendent. La vertu est mon chemin.`
};

MIROIR["83:23"] = {
  reference: "83:23",
  theme: ["divans", "regard", "observation"],
  emotion: "Paix, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Ara'ik", "Al-Nazar"],
  mirrorVersion: `« Sur des divans, ils observeront. » Le miroir décrit : « 'Ala al-ara'iki yanzurun » — sur des divans, ils observeront. Les vertueux seront assis confortablement, observant. Qu'observent-ils ? Le Paradis, les bienfaits, peut-être même Allah. Le miroir m'enseigne : la position du Paradis est de contemplation et de confort.`,
  reflection: `Les vertueux seront dans le confort et la contemplation. La vision est leur bonheur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala al-ara'iki yanzurun » — sur des divans, ils observeront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La position du Paradis est de confort et de contemplation. Est-ce que je désire cette position ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les divans du Paradis répondent aux positions basses de l'humilité ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La contemplation est l'activité la plus élevée — voir le Vrai." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation du Paradis est l'essence du bonheur." }
  ],
  munajat: `Ya Rabb, place-moi sur les divans du Paradis. Je veux contempler Tes bienfaits. Le confort et la vision sont mon désir.`
};

MIROIR["83:24"] = {
  reference: "83:24",
  theme: ["visages", "beauté", "satisfaction"],
  emotion: "Joie, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Wajh", "Al-Na'im"],
  mirrorVersion: `« Tu reconnaîtras sur leurs visages l'éclat de la félicité. » Le miroir décrit : « Ta'rif fi wujuhihim nadrah al-na'im » — tu reconnaîtras sur leurs visages l'éclat de la félicité. Le bonheur intérieur se voit sur le visage. Les visages des vertueux brillent de satisfaction. Le miroir m'enseigne : le bonheur a une apparence visible.`,
  reflection: `Le bonheur intérieur se voit sur le visage. Les visages des vertueux brillent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta'rif fi wujuhihim nadrah al-na'im » — tu reconnaîtras sur leurs visages l'éclat de la félicité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon visage révèle-t-il la félicité ? Le bonheur intérieur se voit." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éclat du visage est le reflet de la lumière du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière se manifeste — sur le visage et dans l'être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La beauté du visage vertueux vient de la beauté de son cœur." }
  ],
  munajat: `Ya Rabb, fais que mon visage brille de félicité. Le bonheur intérieur doit se voir. Je veux refléter Ta lumière.`
};

MIROIR["83:25"] = {
  reference: "83:25",
  theme: ["boisson", "scellé", "parfum"],
  emotion: "Joie, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Sharab", "Al-Khitam"],
  mirrorVersion: `« Ils seront abreuvés d'un vin scellé. » Le miroir promet : « Yusqawna min rahiqin makhtum » — ils seront abreuvés d'un vin scellé. Ce vin du Paradis est pur, non enivrant, scellé pour préserver son excellence. Le miroir m'enseigne : les délices du Paradis sont protégés et purs.`,
  reflection: `Les délices du Paradis sont protégés et purs. Le vin scellé est un symbole de l'excellence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusqawna min rahiqin makhtum » — ils seront abreuvés d'un vin scellé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire aux délices purs du Paradis ? Le vin scellé m'attend." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le scellé préserve la pureté — les délices du Paradis sont intacts." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les boissons du Paradis sont pures — rien de nocif." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La boisson scellée symbolise le plaisir préservé pour les vertueux." }
  ],
  munajat: `Ya Rabb, abreuve-moi du vin scellé du Paradis. Sa pureté et son excellence m'attendent. Je veux boire dans Tes jardins.`
};

MIROIR["83:26"] = {
  reference: "83:26",
  theme: ["parfum", "désir", "scellement"],
  emotion: "Désir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Misk", "Al-Khitam"],
  mirrorVersion: `« Dont le cachet est de musc. » Le miroir précise : « Khatamuhu misk » — dont le cachet est de musc. Le musc est le parfum le plus précieux — le cachet de ce vin est parfumé. Le miroir m'enseigne : les délices du Paradis combinent toutes les excellences.`,
  reflection: `Les délices du Paradis combinent toutes les excellences. Le parfum du musc couronne le délice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khatamuhu misk » — dont le cachet est de musc." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire aux parfums du Paradis ? Le musc est le plus précieux." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le parfum du musc symbolise l'excellence suprême." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les parfums du Paradis dépassent tout parfum terrestre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le parfum du délice anticipe la joie de la consommation." }
  ],
  munajat: `Ya Rabb, fais que je goûte aux délices parfumés du Paradis. Le musc est Ton cadeau. Les parfums célestes m'attendent.`
};

MIROIR["83:27"] = {
  reference: "83:27",
  theme: ["mélange", "tasnim", "source"],
  emotion: "Joie, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Mizaj", "Al-Tasnim"],
  mirrorVersion: `« Et que ceux qui rivalisent rivalisent pour ce mélange de Tasnim. » Le miroir invite : « Wa fi dhalika fal-yatanafasi al-mutanafisun » — et que ceux qui rivalisent rivalisent pour cela. Le mélange de Tasnim est la boisson la plus élevée. Le miroir m'enseigne : la compétition dans ce monde devrait être pour les délices de l'autre.`,
  reflection: `La compétition devrait être pour les délices du Paradis. Tasnim est la source la plus élevée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi dhalika fal-yatanafasi al-mutanafisun » — et que ceux qui rivalisent rivalisent pour cela." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi est-ce que je rivalise ? Pour les délices du Paradis ou pour ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie compétition est pour l'au-delà — pas pour ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tasnim est la source la plus élevée du Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Rivaliser pour le Paradis transforme la compétition en aspiration." }
  ],
  munajat: `Ya Rabb, fais que je rivalise pour le Paradis. Tasnim est mon but. La compétition spirituelle m'élève.`
};

MIROIR["83:28"] = {
  reference: "83:28",
  theme: ["source", "proches", "Tasnim"],
  emotion: "Espérance, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-'Ayn", "Al-Muqarrabun"],
  mirrorVersion: `« Une source dont boiront les plus proches d'Allah. » Le miroir précise : « 'Aynan yashrabu biha al-muqarrabun » — une source dont boiront les plus proches d'Allah. Tasnim est réservée aux muqarrabun — ceux qui sont proches d'Allah. Le miroir m'enseigne : la proximité d'Allah donne accès aux délices les plus élevés.`,
  reflection: `La proximité d'Allah donne accès aux délices les plus élevés. Tasnim est pour les proches.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Aynan yashrabu biha al-muqarrabun » — une source dont boiront les plus proches d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les proches d'Allah ? Tasnim est pour eux." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité ici-bas mène à la proximité là-bas — et à ses délices." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sources du Paradis sont multiples — Tasnim est la plus haute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Boire de Tasnim, c'est goûter à la proximité d'Allah." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi Tes proches. Tasnim est mon désir. La proximité de Toi m'abreuve.`
};

MIROIR["83:29"] = {
  reference: "83:29",
  theme: ["moquerie", "mécréants", "vertueux"],
  emotion: "Réconfort, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mujrimun", "Al-Abrar"],
  mirrorVersion: `« Les criminels riaient de ceux qui croyaient. » Le miroir rappelle la situation d'ici-bas : « Inna alladhina ajramu kanu min alladhina amanu yadhakun » — les criminels riaient de ceux qui croyaient. Dans ce monde, les mécréants se moquent des croyants. Le miroir me réconforte : la moquerie d'aujourd'hui sera inversée demain.`,
  reflection: `La moquerie des mécréants envers les croyants sera inversée au Jour Dernier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina ajramu kanu min alladhina amanu yadhakun » — les criminels riaient de ceux qui croyaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis moqué pour ma foi ? La situation sera inversée." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les rieurs d'aujourd'hui seront les pleureurs de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les apparences de ce monde seront inversées dans l'autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La patience face à la moquerie est une victoire." }
  ],
  munajat: `Ya Rabb, les mécréants se moquent des croyants. Fais que je sois patient. Le rire d'aujourd'hui sera inversé demain.`
};

MIROIR["83:30"] = {
  reference: "83:30",
  theme: ["passage", "clignement", "moquerie"],
  emotion: "Patience, dignité",
  difficulty: "débutant",
  relatedNames: ["Al-Murur", "Al-Ghamz"],
  mirrorVersion: `« Et quand ils passaient près d'eux, ils se clignaient l'œil. » Le miroir décrit la moquerie : « Wa idha marraw bihim yataghamazun » — et quand ils passaient près d'eux, ils se clignaient l'œil. Le clignement est un signe de moquerie, de mépris. Le miroir m'enseigne : les mécréants exprimaient leur mépris discrètement.`,
  reflection: `Le mépris des mécréants s'exprime par des gestes discrets. La patience est la réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha marraw bihim yataghamazun » — et quand ils passaient près d'eux, ils se clignaient l'œil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis au mépris des autres ? La patience est ma dignité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le clignement de mépris deviendra le regard de terreur au Jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les gestes cachés sont connus d'Allah — rien n'échappe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Répondre au mépris par la patience est la victoire des vertueux." }
  ],
  munajat: `Ya Rabb, les mécréants se moquent avec des clignements. Fais que je réponde par la patience. Mon calme est ma force.`
};

MIROIR["83:31"] = {
  reference: "83:31",
  theme: ["retour", "rire", "moquerie"],
  emotion: "Patience, dignité",
  difficulty: "débutant",
  relatedNames: ["Al-Inqilab", "Al-Dahik"],
  mirrorVersion: `« Et quand ils retournaient vers les leurs, ils retournaient joyeux. » Le miroir continue : « Wa idha inqalabu ila ahlihim inqalabu fakihin » — et quand ils retournaient vers les leurs, ils retournaient joyeux, riant. Les moqueurs se congratulent entre eux. Le miroir m'enseigne : la moquerie est collective — les mécréants se soutiennent mutuellement.`,
  reflection: `La moquerie est collective. Les mécréants se soutiennent entre eux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha inqalabu ila ahlihim inqalabu fakihin » — et quand ils retournaient vers les leurs, ils retournaient joyeux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les mécréants se soutiennent entre eux. Les croyants doivent aussi se soutenir." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie de la moquerie deviendra la tristesse du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les groupes se forment autour des valeurs — les moqueurs ensemble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie joie est dans la vérité — pas dans la moquerie." }
  ],
  munajat: `Ya Rabb, les moqueurs se réjouissent ensemble. Fais que les croyants se soutiennent aussi. La vraie joie est avec Toi.`
};

MIROIR["83:32"] = {
  reference: "83:32",
  theme: ["égarement", "jugement", "mécréants"],
  emotion: "Réconfort, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Dalal", "Al-Rushd"],
  mirrorVersion: `« Et quand ils les voyaient, ils disaient : 'Ce sont des égarés.' » Le miroir révèle l'accusation : « Wa idha ra'awhum qalu inna ha'ula'i la-dallun » — et quand ils les voyaient, ils disaient : ce sont des égarés. Les mécréants accusent les croyants d'égarement. Le miroir m'enseigne : l'accusation inverse est une tactique de l'égarement.`,
  reflection: `L'accusation inverse est une tactique de l'égarement. Les égarés accusent les guidés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'awhum qalu inna ha'ula'i la-dallun » — et quand ils les voyaient, ils disaient : ce sont des égarés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'on m'accuse d'égarement ? La vérité est connue d'Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce sont les accusateurs qui sont égarés — les accusés sont guidés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité n'est pas déterminée par le nombre ou le bruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'accusation d'égarement par les égarés confirme la guidance des accusés." }
  ],
  munajat: `Ya Rabb, les mécréants m'accusent d'égarement. Mais Tu sais qui est guidé. Je me confie à Ton jugement, pas au leur.`
};

MIROIR["83:33"] = {
  reference: "83:33",
  theme: ["surveillance", "responsabilité", "compte"],
  emotion: "Réalité, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Ruqaba", "Al-Hisab"],
  mirrorVersion: `« Ils n'ont pas été envoyés pour être leurs gardiens. » Le miroir répond : « Ma ursilu 'alayhim hafizin » — ils n'ont pas été envoyés pour être leurs gardiens. Les mécréants n'ont pas la responsabilité de surveiller les croyants. Le miroir m'enseigne : chacun a son propre compte — je ne suis pas responsable des autres.`,
  reflection: `Chacun a son propre compte. Je ne suis pas responsable des autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma ursilu 'alayhim hafizin » — ils n'ont pas été envoyés pour être leurs gardiens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge les autres ? Je ne suis pas leur gardien." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gardien de chacun est Allah — pas les mécréants ni les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La surveillance appartient à Allah — chacun est responsable de soi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Se concentrer sur son propre compte, pas sur celui des autres." }
  ],
  munajat: `Ya Rabb, je ne suis pas le gardien des autres. Fais que je me concentre sur mon propre compte. Chacun est responsable de soi.`
};

MIROIR["83:34"] = {
  reference: "83:34",
  theme: ["inversion", "rire", "Jour"],
  emotion: "Réconfort, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Fadl", "Al-Yawm"],
  mirrorVersion: `« Aujourd'hui, ceux qui croient rient des mécréants. » Le miroir révèle l'inversion : « Al-yawma alladhina amanu min al-kuffari yadhakun » — aujourd'hui, ceux qui croient rient des mécréants. Le Jour Dernier inverse les rôles — les croyants rient, les mécréants pleurent. Le miroir m'enseigne : la patience sera récompensée.`,
  reflection: `Le Jour Dernier inverse les rôles. La patience sera récompensée par le rire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-yawma alladhina amanu min al-kuffari yadhakun » — aujourd'hui, ceux qui croient rient des mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La patience sera récompensée. Le rire du Jour répond à la moquerie d'ici-bas." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les rieurs d'aujourd'hui deviennent les rieurs de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine inverse les situations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rire du Jour est un rire de délivrance, pas de moquerie." }
  ],
  munajat: `Ya Rabb, fais que je rie au Jour Dernier. La patience sera récompensée. Le rire des croyants répond à la moquerie des mécréants.`
};

MIROIR["83:35"] = {
  reference: "83:35",
  theme: ["divans", "observation", "récompense"],
  emotion: "Joie, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Al-Ara'ik", "Al-Nazar"],
  mirrorVersion: `« Sur des divans, ils observeront. » Le miroir répète la scène : « 'Ala al-ara'iki yanzurun » — sur des divans, ils observeront. Les croyants observeront le sort des mécréants depuis leur position confortable. Le miroir m'enseigne : la position élevée permet de voir ce qui arrive à ceux d'en bas.`,
  reflection: `La position élevée permet de voir le sort des autres. Les croyants observeront depuis leurs divans.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala al-ara'iki yanzurun » — sur des divans, ils observeront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma position future dépend de mes actions présentes. Le divan m'attend." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'observation depuis le haut est un privilège — le divan est la récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les hauteurs du Paradis dominent les profondeurs de l'enfer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'observation n'est pas du mépris — c'est la reconnaissance de la justice." }
  ],
  munajat: `Ya Rabb, place-moi sur les divans du Paradis. L'observation sera ma satisfaction. La justice est établie.`
};

MIROIR["83:36"] = {
  reference: "83:36",
  theme: ["rétribution", "mécréants", "question"],
  emotion: "Justice, conclusion",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Kafirun"],
  mirrorVersion: `« Les mécréants ont-ils été rétribués pour ce qu'ils faisaient ? » Le miroir conclut : « Hal thuwwiba al-kuffaru ma kanu yaf'alun » — les mécréants ont-ils été rétribués pour ce qu'ils faisaient ? La question est rhétorique — oui, ils ont été rétribués. La justice est complète. Le miroir m'enseigne : chaque action a sa rétribution.`,
  reflection: `Chaque action a sa rétribution. La justice est complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal thuwwiba al-kuffaru ma kanu yaf'alun » — les mécréants ont-ils été rétribués pour ce qu'ils faisaient ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma rétribution viendra aussi. Qu'est-ce que j'ai fait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question contient la réponse — la rétribution est certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rend à chacun selon ses œuvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La question finale est pour tous — quel sera mon sort ?" }
  ],
  munajat: `Ya Rabb, la rétribution est certaine. Fais que la mienne soit bonne. Chaque action compte. Je me prépare pour le compte final.`
};

// ==================== SURAH 84: AL-INSHIQAQ - MISSING VERSES 2-5, 7-25 ====================

MIROIR["84:2"] = {
  reference: "84:2",
  theme: ["obéissance", "ciel", "permission"],
  emotion: "Soumission, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ta'ah", "Al-Sama'"],
  mirrorVersion: `« Et aura obéi à son Seigneur et s'y sera pliée. » Le miroir continue : « Wa adhinat li-rabbiba wa huqqat » — et aura obéi à son Seigneur et s'y sera pliée. Le ciel obéit à Allah — il se déchire par Son ordre. Le miroir m'enseigne : toute la création obéit à Allah — seul l'homme peut désobéir.`,
  reflection: `Toute la création obéit à Allah. Seul l'homme peut désobéir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adhinat li-rabbiba wa huqqat » — et aura obéi à son Seigneur et s'y sera pliée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis comme le ciel obéit ? La création est mon modèle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le ciel obéit — l'homme désobéit. La comparaison est humiliante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se plie à la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance du ciel est automatique — l'obéissance de l'homme est un choix." }
  ],
  munajat: `Ya Rabb, le ciel T'obéit. Fais que je T'obéisse aussi. La création est mon modèle d'obéissance.`
};

MIROIR["84:3"] = {
  reference: "84:3",
  theme: ["extension", "terre", "transformation"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Madd", "Al-Ard"],
  mirrorVersion: `« Et quand la terre sera étendue. » Le miroir continue : « Wa idha al-ardu muddat » — et quand la terre sera étendue, aplanie. La terre sera étendue pour le Jugement — plus de montagnes, plus de vallées. Le miroir m'enseigne : la terre sera transformée pour accueillir toute l'humanité.`,
  reflection: `La terre sera transformée pour le Jugement. Plus de montagnes, plus de vallées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-ardu muddat » — et quand la terre sera étendue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre sera transformée. Suis-je prêt pour cette transformation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'extension de la terre marque l'extension du Jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre sera nivelée — le terrain du Jugement sera plat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'extension de la terre reflète l'extension de la justice." }
  ],
  munajat: `Ya Rabb, la terre sera étendue. Fais que je sois prêt. La transformation vient pour tous.`
};

MIROIR["84:4"] = {
  reference: "84:4",
  theme: ["rejet", "charge", "terre"],
  emotion: "Émerveillement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Alqa", "Al-Ard"],
  mirrorVersion: `« Et aura jeté ce qu'elle contient et se sera vidée. » Le miroir continue : « Wa alqat ma fiha wa takhallat » — et aura jeté ce qu'elle contient et se sera vidée. La terre rejettera tout ce qu'elle contient — les morts, les trésors cachés. Le miroir m'enseigne : rien ne reste caché — tout sort au Jour.`,
  reflection: `Rien ne reste caché dans la terre. Tout sort au Jour du Jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alqat ma fiha wa takhallat » — et aura jeté ce qu'elle contient et se sera vidée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Tout sera révélé au Jour." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre vide son contenu — le cœur vide ses secrets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre révèle tout ce qu'elle cache depuis des millénaires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rejet de la terre préfigure le rejet des excuses." }
  ],
  munajat: `Ya Rabb, la terre jettera tout ce qu'elle cache. Fais que ce qu'elle jettera de moi soit bon. Les secrets seront révélés.`
};

MIROIR["84:5"] = {
  reference: "84:5",
  theme: ["obéissance", "terre", "permission"],
  emotion: "Soumission, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ta'ah", "Al-Ard"],
  mirrorVersion: `« Et aura obéi à son Seigneur et s'y sera pliée. » Le miroir conclut : « Wa adhinat li-rabbiba wa huqqat » — et aura obéi à son Seigneur et s'y sera pliée. Comme le ciel, la terre obéit à Allah. Le miroir m'enseigne : la création est soumise — l'homme doit suivre.`,
  reflection: `La création est soumise à Allah. L'homme doit suivre l'exemple.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adhinat li-rabbiba wa huqqat » — et aura obéi à son Seigneur et s'y sera pliée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre obéit — et moi ? Je dois suivre l'exemple de la création." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission de la terre est totale — ma soumission devrait l'être aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ciel et terre obéissent ensemble à leur Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance de la terre est le modèle pour l'humanité." }
  ],
  munajat: `Ya Rabb, la terre T'obéit parfaitement. Fais que je T'obéisse comme elle. La création est mon exemple.`
};

MIROIR["84:7"] = {
  reference: "84:7",
  theme: ["livre", "droite", "compte"],
  emotion: "Espérance, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Yamin"],
  mirrorVersion: `« Quant à celui qui recevra son livre en sa main droite. » Le miroir décrit le premier cas : « Fa-amma man utiya kitabahu bi-yaminih » — quant à celui qui recevra son livre en sa main droite. Recevoir le livre à droite est le signe du succès. Le miroir m'enseigne : le livre à droite signifie un compte facile.`,
  reflection: `Recevoir le livre à droite est le signe du succès. Le compte sera facile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma man utiya kitabahu bi-yaminih » — quant à celui qui recevra son livre en sa main droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon livre sera-t-il à droite ? Le signe du succès m'attend." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La main droite est la main de l'honneur — le livre à droite est l'honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jugement distingue — le livre à droite ou à gauche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le livre à droite commence la joie éternelle." }
  ],
  munajat: `Ya Rabb, fais que je reçoive mon livre à droite. Le signe du succès m'attend. Mon compte sera facile.`
};

MIROIR["84:8"] = {
