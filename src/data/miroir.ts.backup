    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus petite action a une valeur immense." }
  ],
  munajat: `Ya Rabb, merci pour la multiplication des bonnes actions. Fais que j'en accumule. Ne permets pas que je sois paresseux.`
};

MIROIR["6:161"] = {
  reference: "6:161",
  theme: ["droiture", "soumission", "Ibrahim"],
  emotion: "Détermination, identité",
  difficulty: "débutant",
  relatedNames: ["Al-Sirat", "Al-Millah"],
  mirrorVersion: `« Dis : Mon Seigneur m'a guidé vers un chemin droit. » Le miroir proclame : « Qul innani hadani rabbi ila siratin mustaqimin » — dis : Mon Seigneur m'a guidé vers un chemin droit. La guidance est un cadeau. Le miroir m'enseigne : le chemin droit est celui d'Ibrahim.`,
  reflection: `Le chemin droit est celui d'Ibrahim. La guidance est un cadeau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innani hadani rabbi ila siratin mustaqimin » — dis : Mon Seigneur m'a guidé vers un chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je peux dire que je suis guidé ? Vers quel chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance vers le chemin droit est l'identité du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Ibrahim est le chemin universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La déclaration de la guidance renforce la guidance." }
  ],
  munajat: `Ya Rabb, Tu m'as guidé vers le chemin droit. Fais que j'y reste. Ne permets pas que je m'en écarte.`
};

MIROIR["6:163"] = {
  reference: "6:163",
  theme: ["exclusivité", "adoration", "sincérité"],
  emotion: "Purification, dévotion",
  difficulty: "débutant",
  relatedNames: ["Al-Ikhlas", "Al-'Ibadah"],
  mirrorVersion: `« Il n'a pas d'associé. » Le miroir purifie : « La sharika lahu » — il n'a pas d'associé. L'unicité est absolue. Le miroir m'enseigne : l'adoration doit être pure.`,
  reflection: `L'unicité est absolue. L'adoration doit être pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La sharika lahu » — il n'a pas d'associé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels associés cachés ai-je dans mon adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité de l'adoration purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création adore Allah exclusivement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration pure est la clé de la proximité." }
  ],
  munajat: `Ya Rabb, Tu n'as pas d'associé. Fais que mon adoration soit pure. Ne permets pas l'association cachée.`
};

MIROIR["6:164"] = {
  reference: "6:164",
  theme: ["responsabilité", "âme", "charge"],
  emotion: "Libération, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Nafs", "Al-Wizr"],
  mirrorVersion: `« Chaque âme ne porte que sa propre charge. » Le miroir libère : « La taziru waziratun wizra ukhra » — chaque âme ne porte que sa propre charge. La responsabilité est individuelle. Le miroir m'enseigne : personne ne portera le fardeau d'un autre.`,
  reflection: `La responsabilité est individuelle. Personne ne portera le fardeau d'un autre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La taziru waziratun wizra ukhra » — chaque âme ne porte que sa propre charge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma charge ? Est-ce que je la porte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'individualité de la charge soulage des fardeaux des autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine respecte l'individualité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation de sa propre charge est le début de la libération." }
  ],
  munajat: `Ya Rabb, j'accepte ma charge. Fais que je la porte avec courage. Ne permets pas que je cherche à la transférer.`
};

// ==================== SURAH 7: AL-A'RAF - ADDITIONAL ENTRIES ====================

MIROIR["7:13"] = {
  reference: "7:13",
  theme: ["orgueil", "Iblis", "chute"],
  emotion: "Mise en garde, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Takabbur", "Iblis"],
  mirrorVersion: `« Descends d'ici ! Tu n'as pas à t'enorgueillir ici. » Le miroir condamne : « Fahbit minha fama yakunu laka an tatakabbara fiha » — descends d'ici ! Tu n'as pas à t'enorgueillir ici. L'orgueil cause la chute. Le miroir m'enseigne : l'humilité est la condition de la présence divine.`,
  reflection: `L'orgueil cause la chute. L'humilité est la condition de la présence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fahbit minha fama yakunu laka an tatakabbara fiha » — descends d'ici ! Tu n'as pas à t'enorgueillir ici." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel orgueil me menace ? Comment je cultive l'humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La chute suit l'orgueil — l'élévation suit l'humilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil est le péché originel de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité est la clé de la présence divine." }
  ],
  munajat: `Ya Rabb, protège-moi de l'orgueil. Fais que je sois humble. Ne permets pas que je tombe comme Iblis.`
};

MIROIR["7:14"] = {
  reference: "7:14",
  theme: ["délai", "Iblis", "repit"],
  emotion: "Attention, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mahl", "Iblis"],
  mirrorVersion: `« Accorde-moi un délai jusqu'au jour où ils seront ressuscités. » Le miroir rapporte la demande : « Qabilni ila yawmi yub'athun » — accorde-moi un délai jusqu'au jour où ils seront ressuscités. Le délai est accordé mais pas le pardon. Le miroir m'enseigne : le délai n'est pas le salut.`,
  reflection: `Le délai n'est pas le salut. Le temps est limité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qabilni ila yawmi yub'athun » — accorde-moi un délai jusqu'au jour où ils seront ressuscités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise mon délai ? Pour le bien ou le mal ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le délai est une miséricorde — pas une validation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est une provision — à utiliser avec sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise le délai pour se repentir est sauvé." }
  ],
  munajat: `Ya Rabb, merci pour le délai. Fais que je l'utilise pour me repentir. Ne permets pas que je le gaspille.`
};

MIROIR["7:15"] = {
  reference: "7:15",
  theme: ["délai", "permission", "justice"],
  emotion: "Réalité, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Mahl", "Al-Hikmah"],
  mirrorVersion: `« Tu es de ceux à qui un délai est accordé. » Le miroir confirme : « Innaka mina al-munzarina » — tu es de ceux à qui un délai est accordé. Le délai a une limite. Le miroir m'enseigne : le temps n'est pas infini.`,
  reflection: `Le temps n'est pas infini. Le délai a une limite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka mina al-munzarina » — tu es de ceux à qui un délai est accordé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon délai s'écoule. Qu'est-ce que j'en fais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai accordé à l'ennemi est un test pour les hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sagesse divine dépasse notre compréhension." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du délai motive l'action." }
  ],
  munajat: `Ya Rabb, le délai s'écoule. Fais que je ne le gaspille pas. Donne-moi la conscience du temps.`
};

MIROIR["7:16"] = {
  reference: "7:16",
  theme: ["tromperie", "Iblis", "menace"],
  emotion: "Mise en garde, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghurur", "Iblis"],
  mirrorVersion: `« Puisque Tu m'as égaré, je m'assiérai pour eux sur Ton chemin droit. » Le miroir révèle le plan : « Fa-bima awlaytani la-aq'udanna lahum sirataka al-mustaqima » — puisque Tu m'as égaré, je m'assiérai pour eux sur Ton chemin droit. L'ennemi est actif. Le miroir m'enseigne : la vigilance est nécessaire.`,
  reflection: `L'ennemi est actif sur le chemin droit. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-bima awlaytani la-aq'udanna lahum sirataka al-mustaqima » — puisque Tu m'as égaré, je m'assiérai pour eux sur Ton chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me protège de l'embuscade sur le chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance du plan de l'ennemi permet la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin droit est le lieu de la bataille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vigilance constante est la protection." }
  ],
  munajat: `Ya Rabb, protège-moi de l'embuscade. Fais que je sois vigilant sur Ton chemin. Ne permets pas que je sois piégé.`
};

MIROIR["7:17"] = {
  reference: "7:17",
  theme: ["attaque", "Iblis", "stratégie"],
  emotion: "Vigilance, connaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khad'ah", "Iblis"],
  mirrorVersion: `« Puis je les assaillirai de devant, de derrière, de leur droite et de leur gauche. » Le miroir décrit l'attaque : « Thumma la-atiyannahum min bayni aydihim wa min khalfihim » — puis je les assaillirai de devant, de derrière, de leur droite et de leur gauche. L'attaque est multidirectionnelle. Le miroir m'enseigne : toutes les directions sont vulnérables.`,
  reflection: `Toutes les directions sont vulnérables. La protection doit être totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma la-atiyannahum min bayni aydihim wa min khalfihim » — puis je les assaillirai de devant, de derrière, de leur droite et de leur gauche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles directions sont vulnérables dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance des directions d'attaque permet la défense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection d'Allah couvre toutes les directions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière de protection est le bouclier." }
  ],
  munajat: `Ya Rabb, protège-moi de toutes les directions. Fais que je sois conscient des vulnérabilités. Ne permets pas que je sois pris.`
};

MIROIR["7:18"] = {
  reference: "7:18",
  theme: ["enfer", "Iblis", "promesse"],
  emotion: "Réalité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Jahannam", "Iblis"],
  mirrorVersion: `« Sors de là, couvert de honte et banni. » Le miroir condamne : « Ukhruj minhā madh'uman madhūran » — sors de là, couvert de honte et banni. La destinée de l'orgueilleux est la honte. Le miroir m'enseigne : la fin de l'orgueil est l'humiliation.`,
  reflection: `La fin de l'orgueil est l'humiliation. La fin de l'humilité est l'honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ukhruj minhā madh'uman madhūran » — sors de là, couvert de honte et banni." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma destinée ? L'honneur ou la honte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La honte maintenant ou la honte éternelle — le choix est là." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humiliation volontaire maintenant protège de l'humiliation éternelle." }
  ],
  munajat: `Ya Rabb, je choisis l'humilité maintenant. Épargne-moi de la honte éternelle. Ne permets pas que je sois banni.`
};

MIROIR["7:19"] = {
  reference: "7:19",
  theme: ["paradis", "Adam", "permission"],
  emotion: "Bonté, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Adam"],
  mirrorVersion: `« Ô Adam, habite le Paradis, toi et ton épouse. » Le miroir invite : « Ya Adam uskun anta wa zawjuka al-jannata » — ô Adam, habite le Paradis, toi et ton épouse. Le Paradis était la demeure originelle. Le miroir m'enseigne : le retour au Paradis est possible.`,
  reflection: `Le Paradis était la demeure originelle. Le retour est possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya Adam uskun anta wa zawjuka al-jannata » — ô Adam, habite le Paradis, toi et ton épouse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le Paradis est ma destination souhaitée. Comment y retourner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sortie du Paradis a ouvert la voie du retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire d'Adam est le prototype de toutes les histoires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Paradis est plus proche qu'on ne le pense." }
  ],
  munajat: `Ya Rabb, je veux retourner au Paradis. Fais que je prenne le chemin du retour. Ne permets pas que je m'en éloigne.`
};

MIROIR["7:20"] = {
  reference: "7:20",
  theme: ["tentation", "Iblis", "ruse"],
  emotion: "Vigilance, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waswas", "Iblis"],
  mirrorVersion: `« Alors le diable leur souffla afin de leur faire voir ce qui leur était caché. » Le miroir révèle : « Fa-waswasa lahumu al-shaytanu li-yubdiya lahumā » — alors le diable leur souffla afin de leur faire voir ce qui leur était caché. La tentation commence par le souffle. Le miroir m'enseigne : le mal commence petit.`,
  reflection: `Le mal commence petit. Le souffle devient la tempête.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-waswasa lahumu al-shaytanu li-yubdiya lahumā » — alors le diable leur souffla afin de leur faire voir ce qui leur était caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels souffles de tentation ai-je écoutés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souffle de la tentation peut être étouffé par le dhikr." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tentation est universelle — la résistance est possible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du souffle permet de l'arrêter." }
  ],
  munajat: `Ya Rabb, protège-moi du souffle de la tentation. Fais que je le reconnaisse et le refuse. Ne permets pas que je l'écoute.`
};

MIROIR["7:21"] = {
  reference: "7:21",
  theme: ["serment", "Iblis", "tromperie"],
  emotion: "Mise en garde, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yamin", "Iblis"],
  mirrorVersion: `« Et il leur jura : Je suis pour vous un conseiller sincère. » Le miroir expose : « Wa qasamahuma inni lakuma la-mina al-nasihina » — et il leur jura : Je suis pour vous un conseiller sincère. Le serment peut être un mensonge. Le miroir m'enseigne : les apparences peuvent tromper.`,
  reflection: `Les apparences peuvent tromper. Le serment peut être un mensonge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qasamahuma inni lakuma la-mina al-nasihina » — et il leur jura : Je suis pour vous un conseiller sincère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels « conseillers » m'égarent par leurs serments ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai conseiller ne jure pas — il conseille avec vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sincérité se prouve par les fruits, pas par les serments." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vérification du conseiller protège de la tromperie." }
  ],
  munajat: `Ya Rabb, apprends-moi à discerner les vrais conseillers des faux. Ne permets pas que je sois trompé par les serments.`
};

// ==================== SURAH 38: SAD - MISSING VERSES ====================

MIROIR["38:18"] = {
  reference: "38:18",
  theme: ["louange", "montagnes", "soumission"],
  emotion: "Émerveillement, adoration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Musabbih", "Al-Jibal"],
  mirrorVersion: `« Nous avons soumis les montagnes à se prosterner avec lui, soir et matin. » Le miroir me montre la louange cosmique. David (Dawud) ne louait pas Allah seul — les montagnes priaient avec lui. La création entière participe à l'adoration. Le miroir m'invite à rejoindre ce chœur universel.`,
  reflection: `Les montagnes prient. La nature adore. Je suis invité à ce rendez-vous cosmique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna sahkharna al-jibala ma'ahu yusabbihna bi-al-ashiyi wa al-ishraq » — nous avons soumis les montagnes à se prosterner avec lui, soir et matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma louange rejoint-elle celle des montagnes ? Ou suis-je distrait par le monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les montagnes n'ont pas de choix — moi j'ai le choix. Mon adoration est plus précieuse parce que volontaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque montagne, chaque arbre, chaque étoile participe à la louange universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur loue sincèrement, il ressent la connexion avec toute la création." }
  ],
  munajat: `Ya Musabbih, fais que ma louange rejoigne celle des montagnes. Incline mon cœur vers Toi, soir et matin.`
};

MIROIR["38:19"] = {
  reference: "38:19",
  theme: ["oiseaux", "rassemblement", "adoration"],
  emotion: "Harmonie, unité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jami'", "At-Tayr"],
  mirrorVersion: `« Et les oiseaux rassemblés, tous se tournaient vers lui. » Le miroir me montre l'assemblée de la création. Les oiseaux, comme les montagnes, participaient à la louange de David. La diversité de la création s'unit dans l'adoration. Le miroir m'invite à l'unité dans la diversité.`,
  reflection: `Les oiseaux se rassemblent pour louer. La diversité devient unité dans l'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-tayra mahshuratan kullun lahu awwab » — et les oiseaux rassemblés, tous se tournaient vers lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me rassemble avec les autres pour l'adoration ? Ou suis-je isolé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement pour Allah unit les cœurs au-delà des différences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les oiseaux de différentes espèces se rassemblent dans la louange — l'unité transcende la diversité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'âme qui adore en communauté ressent une présence différente." }
  ],
  munajat: `Ya Jami', rassemble-moi avec ceux qui T'adorent. Fais que je fasse partie de l'assemblée des croyants.`
};

MIROIR["38:20"] = {
  reference: "38:20",
  theme: ["force", "sagesse", "royauté"],
  emotion: "Gratitude, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mulk"],
  mirrorVersion: `« Nous avonsffermi son royaume et lui avons donné la sagesse et le discours décisif. » Le miroir me montre les dons accordés à David. La force du royaume, la sagesse du jugement, l'éloquence de la parole — tout venait d'Allah. Le miroir m'enseigne : les dons sont des responsabilités.`,
  reflection: `La sagesse et le pouvoir sont des dons. Ils viennent avec une responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa shadadna mulkahu wa ataynahu al-hikmata wa fasla al-khitab » — nous avonsffermi son royaume et lui avons donné la sagesse et le discours décisif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels dons ai-je reçus ? Comment les utilise-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse sans le pouvoir est incomplète. Le pouvoir sans la sagesse est dangereux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature reçoit ce dont elle a besoin pour sa mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le don véritable est celui utilisé pour le bien des autres." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse. Si Tu me donnes du pouvoir, donne-moi aussi la sagesse pour l'utiliser.`
};

MIROIR["38:21"] = {
  reference: "38:21",
  theme: ["jugement", "épreuve", "justice"],
  emotion: "Vigilance, équité",
  difficulty: "avancé",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Et t'est parvenue nouvelles des deux adversaires qui escaladèrent la muraille du sanctuaire ? » Le miroir me montre l'épreuve du jugement. David fut testé dans sa fonction de juge. Deux hommes vinrent à lui — un test divin. Le miroir m'avertit : les responsabilités viennent avec des tests.`,
  reflection: `Les responsabilités attirent les épreuves. Le juge est testé dans son jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hal ataka naba'u al-khasmi idh tasawwaru al-mihrab » — et t'est parvenue nouvelle des deux adversaires qui escaladèrent la muraille du sanctuaire ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis responsable, suis-je prêt pour les tests qui viennent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve du juge révèle sa vraie nature — juste ou non." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque position attire son test correspondant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'épreuve est la preuve de la confiance divine." }
  ],
  munajat: `Ya Hakam, quand Tu me confies une responsabilité, prépare-moi pour l'épreuve qui l'accompagne. Donne-moi la justice dans le jugement.`
};

MIROIR["38:22"] = {
  reference: "38:22",
  theme: ["dispute", "humilité", "écoute"],
  emotion: "Attention, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sami'", "Al-Khushu'"],
  mirrorVersion: `« Quand ils entrèrent chez David, il eut peur d'eux. Ils dirent : Ne crains pas, nous sommes deux adversaires en dispute. » Le miroir me montre la réaction humaine face à l'inattendu. David eut peur — un prophète, mais humain. Les visiteurs le rassurèrent. Le miroir m'enseigne : la peur naturelle n'est pas une faiblesse.`,
  reflection: `Même les prophètes connaissent la peur. La rassurance vient de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh dakhalu 'ala Dawuda fa-fazi'a minhum qalu la takhaf khasman bagha ba'duna 'ala ba'd » — quand ils entrèrent chez David, il eut peur d'eux. Ils dirent : Ne crains pas, nous sommes deux adversaires en dispute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je face à l'inattendu ? La peur peut-elle coexister avec la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur n'est pas l'opposé de la foi — c'est une réaction humaine naturelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature connaît la peur — elle est un mécanisme de protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi transforme la peur en confiance." }
  ],
  munajat: `Ya Sami', quand la peur me saisit, rassure-moi par Ta présence. Transforme ma peur en confiance en Toi.`
};

MIROIR["38:23"] = {
  reference: "38:23",
  theme: ["injustice", "agneau", "revendication"],
  emotion: "Indignation, empathie",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Haqq"],
  mirrorVersion: `« Celui-ci a quatre-vingt-dix-neuf brebis, et moi je n'en ai qu'une. Il a voulu la prendre. » Le miroir me montre l'injustice flagrante. Un homme avec 99 brebis veut prendre l'unique brebis de l'autre. L'avidité sans bornes. Le miroir m'avertit : l'avidité peut aveugler.`,
  reflection: `L'avidité ne connaît pas de limite. Celui qui a beaucoup veut encore plus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadha akhi lahu tis'un wa tis'una na'jatan wa li na'jatun wahidatum fa-qala akfidniha » — celui-ci a quatre-vingt-dix-neuf brebis, et moi je n'en ai qu'une. Il a voulu la prendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis comme celui qui a 99 et veut la seule de l'autre ? Ou est-ce que je suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avidité inverse l'ordre : avoir plus devrait donner plus, pas prendre plus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne selon le besoin. L'homme veut selon son désir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le contentement est la vraie richesse." }
  ],
  munajat: `Ya 'Adl, protège-moi de l'avidité. Donne-moi le contentement avec ce que Tu m'as donné. Ne permets pas que je sois injuste.`
};

MIROIR["38:24"] = {
  reference: "38:24",
  theme: ["jugement", "réalisation", "repentir"],
  emotion: "Prise de conscience, repentance",
  difficulty: "avancé",
  relatedNames: ["At-Tawwab", "Al-Hadi"],
  mirrorVersion: `« Il dit : Il a certainement été injuste envers toi en demandant ta brebis pour l'ajouter aux siennes. » Le miroir me montre la réalisation soudaine de David. En jugeant l'autre, il se jugea lui-même. La parable était un miroir. Le miroir m'enseigne : quand je juge, je me juge.`,
  reflection: `Le jugement des autres est souvent un miroir de nos propres fautes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala laqad zalamaka bi-su'ali na'jatika ila ni'ajihi » — il dit : Il a certainement été injuste envers toi en demandant ta brebis pour l'ajouter aux siennes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je juge les autres, qu'est-ce que cela révèle sur moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement que je porte sur les autres est souvent le jugement que je devrais porter sur moi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le miroir de la création reflète notre propre image." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie sagesse voit dans le défaut de l'autre une leçon pour soi." }
  ],
  munajat: `Ya Tawwab, quand je juge, montre-moi mon propre reflet. Donne-moi la grâce de me corriger avant de corriger les autres.`
};

MIROIR["38:25"] = {
  reference: "38:25",
  theme: ["pardon", "proximité", "rémission"],
  emotion: "Espoir, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffar", "Al-Qarib"],
  mirrorVersion: `« Nous lui avons pardonné. Il a une place proche de Nous et un beau lieu de retour. » Le miroir me montre la miséricorde immédiate. David réalisa, se repentit, et fut pardonné immédiatement. Le repentir sincère ouvre la porte du pardon. Le miroir m'enseigne : le pardon d'Allah est proche.`,
  reflection: `Le repentir sincère est accepté immédiatement. La proximité d'Allah est restaurée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ghafrna lahu dhalika wa inna lahu 'indana la-zulfa wa husna ma'ab » — nous lui avons pardonné. Il a une place proche de Nous et un beau lieu de retour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens sincèrement ? Ou est-ce que je tarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faute éloigne, mais le repentir sincère rapproche plus qu'avant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour vers Allah est toujours possible, toujours accueilli." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le repentir sincère transforme la faute en grâce." }
  ],
  munajat: `Ya Ghaffar, je me repens de mes fautes. Pardonne-moi comme Tu as pardonné à David. Rapproche-moi de Toi.`
};

MIROIR["38:27"] = {
  reference: "38:27",
  theme: ["création", "vanité", "signification"],
  emotion: "Réflexion, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khaliq"],
  mirrorVersion: `« Nous n'avons pas créé le ciel et la terre et ce qui est entre eux en vain. » Le miroir me montre le dessein de la création. Rien n'est futile, tout a un sens. Le miroir m'invite à chercher le sens dans ma propre existence.`,
  reflection: `La création a un but. Ma vie a un but. Chercher ce sens est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma khalaqna as-sama'a wa al-arda wa ma baynahuma batila » — nous n'avons pas créé le ciel et la terre et ce qui est entre eux en vain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le but de ma vie ? Est-ce que je vis selon ce but ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie sans but est vanité. La vie avec but est plénitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa raison d'être. La création n'est pas un accident." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sens de la vie se découvre dans la connexion avec le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu n'as rien créé en vain. Révèle-moi le but de ma vie. Aide-moi à vivre selon Ton dessein.`
};

MIROIR["38:28"] = {
  reference: "38:28",
  theme: ["égalité", "jugement", "justice"],
  emotion: "Questionnement, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hukm"],
  mirrorVersion: `« Penserions-Nous que ceux qui croient et font le bien soient comme ceux qui corrompent sur terre ? » Le miroir me pose la question rhétorique. Bien sûr que non — ils ne sont pas égaux. La justice divine distingue. Le miroir m'invite à réfléchir sur ma propre distinction.`,
  reflection: `Les croyants et les corrupteurs ne sont pas égaux. Le jugement distinguera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am nahsibu alladhina amanu wa 'amilu as-salihati ka-al-mufsidina fi al-ard » — penserions-Nous que ceux qui croient et font le bien soient comme ceux qui corrompent sur terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je du côté des croyants ou des corrupteurs ? Mon cœur connaît la réponse." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distinction commence ici-bas par les choix quotidiens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers distingue naturellement l'ordre du chaos." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie distinction est celle du cœur." }
  ],
  munajat: `Ya 'Adl, fais que je sois parmi les croyants qui font le bien. Ne permets pas que je sois du côté des corrupteurs.`
};

MIROIR["38:30"] = {
  reference: "38:30",
  theme: ["Salomon", "don", "sagesse"],
  emotion: "Gratitude, admiration",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Wahhab"],
  mirrorVersion: `« Nous avons donné à David Salomon. Quel excellent serviteur, il était repentant. » Le miroir me montre la continuité de la bénédiction. De David à Salomon, la sagesse se transmet. Salomon fut un serviteur excellent, repentant. Le miroir m'enseigne : la bénédiction peut traverser les générations.`,
  reflection: `La sagesse peut être transmise. L'excellence du serviteur réside dans le repentir constant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabna li-Dawuda Sulayman ni'ma al-'abd innahu awwab » — nous avons donné à David Salomon. Quel excellent serviteur, il était repentant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je transmets ? Suis-je un excellent serviteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excellence n'est pas dans la perfection — elle est dans le repentir constant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération reçoit et transmet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le serviteur excellent est celui qui revient constamment." }
  ],
  munajat: `Ya Wahhab, donne-moi la sagesse. Fais de moi un serviteur excellent, repentant. Permets-moi de transmettre le bien.`
};

MIROIR["38:31"] = {
  reference: "38:31",
  theme: ["chevaux", "distraction", "prière"],
  emotion: "Émerveillement, retour",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Munajjah", "As-Salah"],
  mirrorVersion: `« Quand lui furent présentés au crépuscule les chevaux de race. » Le miroir me montre l'épreuve des biens. Salomon avait des chevaux magnifiques, mais ils ne le détournèrent pas de la prière. Le miroir m'avertit : les biens peuvent distraire.`,
  reflection: `Les biens de ce monde sont beaux, mais ils ne doivent pas nous détourner d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh 'urida 'alayhi bi-al-'ashiyi as-safinat al-jiyad » — quand lui furent présentés au crépuscule les chevaux de race." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me distrait de la prière ? Les chevaux d'aujourd'hui prennent quelles formes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les biens peuvent être une bénédiction ou une distraction — selon l'usage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté de la création peut nous rapprocher ou nous éloigner du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit Allah dans la beauté ne se laisse pas distraire par elle." }
  ],
  munajat: `Ya Rabb, les biens de ce monde me distraient parfois. Aide-moi à voir en eux un rappel de Toi, pas un substitut.`
};

MIROIR["38:32"] = {
  reference: "38:32",
  theme: ["préférence", "mémoire", "bien"],
  emotion: "Choix, priorité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Awla", "Adh-Dhikr"],
  mirrorVersion: `« Il dit : J'ai aimé le souvenir de mon Seigneur jusqu'à ce que le soleil se soit couché. » Le miroir me montre la hiérarchie des priorités de Salomon. Les chevaux étaient beaux, mais le souvenir d'Allah était plus beau. Le miroir m'invite à clarifier mes priorités.`,
  reflection: `L'amour des biens ne doit pas surpasser l'amour du souvenir d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala inni ahbabtu hubba al-khayri 'an dhikri rabbi » — il dit : J'ai aimé le souvenir de mon Seigneur [plus que les chevaux]." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aime plus que le souvenir d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour du bien matériel peut exister, mais le souvenir d'Allah doit primer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se couche sur ceux qui choisissent et ceux qui oublient — le choix appartient à chacun." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie priorité se révèle dans les moments de choix." }
  ],
  munajat: `Ya Rabb, le souvenir de Toi est plus précieux que tout. Aide-moi à choisir ce souvenir quand les distractions se présentent.`
};

MIROIR["38:33"] = {
  reference: "38:33",
  theme: ["renoncement", "détachement", "sacrifice"],
  emotion: "Libération, clarté",
  difficulty: "avancé",
  relatedNames: ["At-Takhliyah", "Al-Qalb"],
  mirrorVersion: `« Ramenez-les-moi. Et il se mit à leur couper les pattes et les cous. » Le miroir me montre le détachement radical de Salomon. Les chevaux qui le distraient — il les sacrifia. Le miroir m'invite au détachement de ce qui me détourne d'Allah.`,
  reflection: `Parfois, il faut couper ce qui nous détourne d'Allah — même si c'est précieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ruduuha 'alayya fa-tafallaqa siqan wa ru'usa » — ramenez-les-moi. Et il se mit à leur couper les pattes et les cous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois couper dans ma vie pour me rapprocher d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice de ce qui distrait est un gain spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature sacrifice ce qui nuit à sa survie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui sacrifie pour Allah reçoit plus qu'il ne donne." }
  ],
  munajat: `Ya Rabb, donne-moi la force de couper ce qui me détourne de Toi. Le sacrifice pour Toi est un gain.`
};

MIROIR["38:34"] = {
  reference: "38:34",
  theme: ["épreuve", "blessure", "repentir"],
  emotion: "Humilité, retour",
  difficulty: "avancé",
  relatedNames: ["Al-Mumtahan", "At-Tawwab"],
  mirrorVersion: `« Nous avons certes éprouvé Salomon et placé sur son trône un corps. Puis il se repentit. » Le miroir me montre l'épreuve des grands. Salomon, malgré sa sagesse, fut testé. L'épreuve n'épargne personne. Le miroir m'enseigne : l'épreuve est la preuve de l'attention divine.`,
  reflection: `Les grands sont éprouvés. L'épreuve précède souvent la croissance spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad fatanna Sulaymana wa alqayna 'ala kursiyyihi jasadan thumma anab » — nous avons certes éprouvé Salomon et placé sur son trône un corps. Puis il se repentit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles épreuves traverse-je ? Suis-je comme Salomon qui se repentit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est une invitation au repentir, pas une punition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'or est purifié par le feu. L'âme est purifiée par l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'épreuve bien traversée élève plus que la facilité." }
  ],
  munajat: `Ya Rabb, Tu m'éprouves parce que Tu m'aimes. Donne-moi la grâce de me repentir dans l'épreuve, pas de me révolter.`
};

MIROIR["38:35"] = {
  reference: "38:35",
  theme: ["prière", "pardon", "royaume"],
  emotion: "Humilité, supplication",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaffar", "Al-Warith"],
  mirrorVersion: `« Il dit : Seigneur, pardonne-moi et donne-moi un royaume tel que nul après moi n'en aura. » Le miroir me montre la prière de Salomon après l'épreuve. Pardon et royaume — les deux demandes. Le miroir m'enseigne : on peut demander le succès ET le pardon.`,
  reflection: `La prière après l'épreuve combine humilité et ambition spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbi ghfir li wa hab li mulkan la yanbaghi li-ahadin min ba'di » — il dit : Seigneur, pardonne-moi et donne-moi un royaume tel que nul après moi n'en aura." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande après mes épreuves ? Pardon ou revendication ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon précède le royaume. L'humilité ouvre la porte à l'exaltation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le royaume de Salomon fut unique — sa prière fut exaucée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande un royaume unique reçoit ce qu'il demande." }
  ],
  munajat: `Ya Ghaffar, pardonne-moi mes fautes. Donne-moi ce que Tu as donné à Salomon — un cœur qui T'appartient exclusivement.`
};

MIROIR["38:36"] = {
  reference: "38:36",
  theme: ["vent", "soumission", "pouvoir"],
  emotion: "Émerveillement, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Rih", "Al-Musakhkhar"],
  mirrorVersion: `« Nous avons soumis le vent à son ordre, soufflant doucement où il voulait. » Le miroir me montre le pouvoir accordé à Salomon. Le vent lui obéissait. La création se soumettait à lui. Le miroir m'enseigne : la soumission de la création à l'homme est un don divin.`,
  reflection: `Le vent obéissait à Salomon. La création peut se soumettre à celui qui se soumet à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sakhkharna lahu al-riha tajri bi-amrihi ruhukan haythu asab » — nous avons soumis le vent à son ordre, soufflant doucement où il voulait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi ai-je accès grâce à Allah ? Est-ce que je Lui suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission à Allah attire la soumission de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vent souffle où Allah l'envoie. Pour Salomon, il soufflait où Salomon le voulait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai pouvoir est celui qui sert, pas celui qui opprime." }
  ],
  munajat: `Ya Musakhkhir, Tu as soumis le vent à Salomon. Soumets mon cœur à Ton ordre. Fais qu'il souffle où Tu veux.`
};

MIROIR["38:37"] = {
  reference: "38:37",
  theme: ["démons", "soumission", "service"],
  emotion: "Émerveillement, prudence",
  difficulty: "avancé",
  relatedNames: ["Ash-Shayatin", "Al-Musakhkhar"],
  mirrorVersion: `« Et les démons, constructeurs et plongeurs. » Le miroir me montre l'utilisation paradoxale des démons. Même les forces du mal furent soumises à Salomon. Le bien peut utiliser les forces contraires. Le miroir m'enseigne : la sagesse transforme même les ennemis en serviteurs.`,
  reflection: `Même les démons peuvent être au service du bien, par la volonté d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-shayatina kullan banna'in wa ghawwas » — et les démons, tous constructeurs et plongeurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme « démon » dans ma vie ? Peut-il servir un bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mal peut être contraint à servir le bien, par la puissance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute force dans l'univers peut être dirigée par celui qui a l'autorité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sagesse suprême est de transformer les obstacles en instruments." }
  ],
  munajat: `Ya Rabb, transforme ce qui m'oppresse en ce qui me sert. Soumets les forces hostiles à mon bien.`
};

MIROIR["38:38"] = {
  reference: "38:38",
  theme: ["chaînes", "prisonniers", "pouvoir"],
  emotion: "Autorité, ordre",
  difficulty: "avancé",
  relatedNames: ["Al-Qahir", "Al-Jabbar"],
  mirrorVersion: `« Et d'autres enchaînés ensemble. » Le miroir me montre l'étendue du pouvoir de Salomon. Les démons étaient enchaînés, soumis. L'autorité sur les forces du mal. Le miroir m'enseigne : l'autorité spirituelle inclut la maîtrise sur les forces obscures.`,
  reflection: `Les forces du mal peuvent être enchaînées par celui qui a l'autorité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akharina muqarranina fi al-asfad » — et d'autres enchaînés ensemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai enchaîné dans ma vie ? Quelles passions, quels vices ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'autorité sur soi-même précède l'autorité sur les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre divin enchaîne le chaos." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui enchaîne ses passions peut enchaîner les démons." }
  ],
  munajat: `Ya Qahir, enchaîne mes passions désordonnées. Donne-moi la maîtrise sur moi-même.`
};

MIROIR["38:39"] = {
  reference: "38:39",
  theme: ["générosité", "dons", "gratitude"],
  emotion: "Générosité, liberté",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Manna"],
  mirrorVersion: `« Ceci est Notre don. Donne ou retiens, sans compte à rendre. » Le miroir me montre la liberté dans le don. Salomon avait reçu, il pouvait donner ou retenir. La liberté du serviteur exalté. Le miroir m'enseigne : le vrai don est libre, sans obligation.`,
  reflection: `Celui qui a reçu peut donner librement. La générosité n'est pas une obligation — c'est une grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hada 'atana fa-aman aw amsaka bi-hisab » — ceci est Notre don. Donne ou retiens, sans compte à rendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je donne ? Libre ou forcé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie générosité vient de l'abondance intérieure, pas de l'obligation extérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne librement — le soleil ne compte pas ses rayons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne librement reçoit au-delà de ce qu'il donne." }
  ],
  munajat: `Ya Wahhab, Tu m'as donné librement. Apprends-moi à donner librement, sans compter.`
};

MIROIR["38:40"] = {
  reference: "38:40",
  theme: ["proximité", "rang", "retour"],
  emotion: "Espoir, aspiration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qarib", "Al-Maqam"],
  mirrorVersion: `« Il a une place proche de Nous et un excellent lieu de retour. » Le miroir me montre la promesse de proximité. Salomon n'a pas seulement le pouvoir — il a la proximité. Le rang spirituel accompagne le pouvoir matériel. Le miroir m'invite à aspirer à cette proximité.`,
  reflection: `Le succès matériel n'exclut pas la proximité spirituelle. Les deux peuvent coexister.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna lahu 'indana la-zulfa wa husna ma'ab » — il a une place proche de Nous et un excellent lieu de retour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma place auprès d'Allah ? Est-elle proche ou lointaine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité d'Allah est plus précieuse que tout pouvoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa place auprès du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rang auprès d'Allah se gagne par la soumission sincère." }
  ],
  munajat: `Ya Qarib, je veux être proche de Toi. Donne-moi une place près de Toi et un excellent retour.`
};

MIROIR["38:41"] = {
  reference: "38:41",
  theme: ["Ayub", "épreuve", "prière"],
  emotion: "Supplication, patience",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Mujib"],
  mirrorVersion: `« Et mentionne Notre serviteur Ayub, quand il appela son Seigneur : Le mal m'a touché, et Tu es le plus miséricordieux des miséricordieux. » Le miroir me montre la prière dans l'épreuve. Ayub (Job) invoqua Allah dans sa souffrance. La prière du souffrant. Le miroir m'enseigne : l'épreuve est l'occasion de l'invocation.`,
  reflection: `Dans la souffrance, invoquer Allah par Ses noms de miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur 'abdina Ayyub idh nada rabbahu annani massaniya ash-shaytu bi-nusbin wa 'adhab » — et mentionne Notre serviteur Ayub, quand il appela son Seigneur : Le mal m'a touché, et Tu es le plus miséricordieux des miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je souffre, comment invoqué-je ? Me plains-je ou espéré-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est l'occasion de découvrir la miséricorde d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature souffre — mais le croyant invoque." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière du souffrant est exaucée par le Plus Miséricordieux." }
  ],
  munajat: `Ya Rahman, dans mes épreuves, je T'invoque. Tu es le plus miséricordieux. Guéris-moi comme Tu as guéri Ayub.`
};

MIROIR["38:42"] = {
  reference: "38:42",
  theme: ["guérison", "eau", "fraîcheur"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ash-Shafi", "Al-Ma'"],
  mirrorVersion: `« Frappe la terre de ton pied : voici une eau fraîche pour te laver et boire. » Le miroir me montre la guérison par le simple geste. Allah guérit par des moyens simples. L'eau fraîche — symbole de purification et de vie. Le miroir m'enseigne : la guérison peut venir de là où on ne l'attend pas.`,
  reflection: `La guérison peut venir d'un geste simple, par la volonté d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Urkud bi-rijlika hadha mughtasalun baridun wa sharab » — frappe la terre de ton pied : voici une eau fraîche pour te laver et boire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je frappe pour faire jaillir la guérison ? Quel geste simple Allah m'invite-t-Il à faire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le geste simple cache souvent la plus grande grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est source de vie et de purification — un don divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guérison d'Allah est souvent dans ce qui est proche, pas dans ce qui est loin." }
  ],
  munajat: `Ya Shafi, guéris-moi comme Tu as guéri Ayub. Fais jaillir l'eau fraîche de ma guérison.`
};

MIROIR["38:43"] = {
  reference: "38:43",
  theme: ["famille", "restauration", "miséricorde"],
  emotion: "Gratitude, joie",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Jami'"],
  mirrorVersion: `« Et Nous lui rendîmes sa famille, en la doublant, par une miséricorde de Notre part. » Le miroir me montre la restauration multiple. Ayub perdit tout, puis reçut le double. La miséricorde d'Allah est généreuse. Le miroir m'enseigne : la perte peut précéder le gain multiplié.`,
  reflection: `Quand Allah restaure, Il donne plus que ce qui a été perdu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wahabna lahu ahlahu wa mithlahum ma'ahum rahmatan minna » — et Nous lui rendîmes sa famille, en la doublant, par une miséricorde de Notre part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je perdu ? Allah peut le restaurer au-delà de ce que j'espère." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte est parfois le prélude à un gain plus grand." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature perd pour retrouver au printemps — le cycle divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah est toujours plus grande que la perte." }
  ],
  munajat: `Ya Rahman, Tu as doublé la famille d'Ayub. Restaure ce que j'ai perdu et donne-moi plus que je n'espère.`
};

MIROIR["38:44"] = {
  reference: "38:44",
  theme: ["serment", "patience", "constance"],
  emotion: "Persévérance, fidélité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Ahd"],
  mirrorVersion: `« Prends une poignée de brindilles, frappe avec, et ne viole pas ton serment. » Le miroir me montre la constance dans l'engagement. Ayub avait fait un serment, il devait le tenir. La patience inclut la fidélité aux promesses. Le miroir m'enseigne : le serment envers Allah doit être honoré.`,
  reflection: `La patience inclut le respect des engagements pris envers Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa khudh bi-yadika dighthan fa-idrib bihi wa la tahnath » — prends une poignée de brindilles, frappe avec, et ne viole pas ton serment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels serments ai-je faits ? Les ai-je respectés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fidélité au serment révèle la force du caractère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature tient ses « serments » — les saisons reviennent, le soleil se lève." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le serment respecté purifie l'âme." }
  ],
  munajat: `Ya Sabur, aide-moi à tenir mes promesses envers Toi. Ne permets pas que je viole mes serments.`
};

MIROIR["38:45"] = {
  reference: "38:45",
  theme: ["souvenir", "Ibrahim", "Ishaq", "Ya'qub"],
  emotion: "Révérence, connexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Abrar", "Al-Anbiya'"],
  mirrorVersion: `« Mentionne Nos serviteurs Ibrahim, Ishaq et Ya'qub, hommes de force et de vision. » Le miroir me montre la chaîne prophétique. Ibrahim, Ishaq, Ya'qub — la force et la clairvoyance. Le miroir m'invite à me connecter à cette lignée spirituelle.`,
  reflection: `Les prophètes sont des modèles de force et de vision. S'y connecter inspire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur 'ibadana Ibrahim wa Ishaq wa Ya'qub uli al-aydi wa al-absar » — mentionne Nos serviteurs Ibrahim, Ishaq et Ya'qub, hommes de force et de vision." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle force ai-je ? Quelle vision ? Suis-je connecté à la lignée prophétique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force sans vision est violence. La vision sans force est rêve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont les étoiles qui guident l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connexion aux prophètes se fait par l'imitation de leurs vertus." }
  ],
  munajat: `Ya Rabb, connecte-moi à Tes prophètes. Donne-moi la force d'Ibrahim et la vision de Ya'qub.`
};

MIROIR["38:46"] = {
  reference: "38:46",
  theme: ["purification", "au-delà", "détachement"],
  emotion: "Aspiration, pureté",
  difficulty: "avancé",
  relatedNames: ["Al-Akhirah", "Al-Taharah"],
  mirrorVersion: `« Nous les avons purifiés par une pure pensée, le rappel de la Demeure. » Le miroir me montre la purification par la pensée. Les prophètes étaient purifiés par le souvenir constant de l'au-delà. Le miroir m'enseigne : la pensée de l'au-delà purifie le cœur.`,
  reflection: `La pensée constante de l'au-delà purifie des attachements mondains.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna akhlasnahum bi-khalisatin dhikra al-dar » — nous les avons purifiés par une pure pensée, le rappel de la Demeure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense à l'au-delà ? Cette pensée purifie-t-elle mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification par la pensée de l'au-delà détache du présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature tend vers sa demeure finale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui pense à l'au-delà ne s'attache pas à ce monde." }
  ],
  munajat: `Ya Rabb, purifie mon cœur par la pensée de l'au-delà. Détache-moi de ce monde par le souvenir de la Demeure.`
};

MIROIR["38:47"] = {
  reference: "38:47",
  theme: ["élection", "rang", "excellence"],
  emotion: "Gratitude, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mustafa", "Al-Akhyar"],
  mirrorVersion: `« Ils sont auprès de Nous, des élus, les meilleurs. » Le miroir me montre le statut des prophètes. Élus, les meilleurs — un rang spécial auprès d'Allah. Le miroir m'invite à aspirer à l'excellence.`,
  reflection: `Les prophètes sont les élus. L'excellence est possible pour celui qui aspire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innahum 'indana la-min al-mustafayna al-akhyar » — ils sont auprès de Nous, des élus, les meilleurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les meilleurs ? Ou est-ce que je me contente de la médiocrité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élection divine vient de la qualité du cœur, pas du statut social." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah choisit les meilleurs parmi Ses créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'élu est celui qui a choisi Allah en premier." }
  ],
  munajat: `Ya Mustafa, fais que je sois parmi les élus. Donne-moi l'excellence dans ma foi et mes actions.`
};

MIROIR["38:48"] = {
  reference: "38:48",
  theme: ["Ismail", "Yasa'", "Dhul-Kifl"],
  emotion: "Mémoire, respect",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Anbiya'", "Adh-Dhakir"],
  mirrorVersion: `« Et mentionne Ismail, al-Yasa' et Dhul-Kifl, tous parmi les meilleurs. » Le miroir me montre la diversité des prophètes. Chacun est mentionné, chacun a son rang. Le miroir m'enseigne : l'excellence a plusieurs visages.`,
  reflection: `Les prophètes sont divers, mais tous sont excellents. L'excellence a plusieurs chemins.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhkur Isma'il wa al-Yasa' wa Dha al-Kifl wa kullun min al-akhyar » — et mentionne Ismail, al-Yasa' et Dhul-Kifl, tous parmi les meilleurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon chemin vers l'excellence ? Suis-je fidèle à ma voie unique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité des prophètes montre que l'excellence n'est pas monolithique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque prophète a son rôle unique dans l'histoire sacrée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'excellence personnelle est dans la fidélité à sa propre mission." }
  ],
  munajat: `Ya Rabb, mentionne-moi parmi les meilleurs. Donne-moi ma voie unique vers l'excellence.`
};

// ==================== SURAH 7: AL-A'RAF - VERSETS 13-22 ====================

MIROIR["7:13"] = {
  reference: "7:13",
  theme: ["orgueil", "chute", "jugement"],
  emotion: "Constat, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kibr", "Al-Sufl"],
  mirrorVersion: `« Descends d'ici ! Tu n'as pas à t'enorgueillir ici. » Le miroir juge : « Fahbit minha fama yakunu laka an tatakabbara fiha » — descends d'ici ! Tu n'as pas à t'enorgueillir ici. L'orgueil n'a pas sa place au paradis. Iblis a été chassé par son orgueil. Le miroir m'enseigne : l'orgueil est la racine de la chute.`,
  reflection: `L'orgueil est la racine de la chute. Qu'est-ce qui m'enorgueillit ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fahbit minha fama yakunu laka an tatakabbara fiha » — descends d'ici ! Tu n'as pas à t'enorgueillir ici." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'enorgueillit ? Est-ce que je me crois supérieur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La chute est la conséquence de l'orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis refuse l'orgueil — il accueille l'humilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité est le chemin de l'élévation." }
  ],
  munajat: `Ya Rabb, l'orgueil a fait tomber Iblis. Préserve-moi de l'orgueil. Fais que je sois humble devant Toi.`
};

MIROIR["7:14"] = {
  reference: "7:14",
  theme: ["délai", "requête", "Iblis"],
  emotion: "Détermination, défi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mahl", "Al-Ajal"],
  mirrorVersion: `« Accorde-moi un délai jusqu'au jour où ils seront ressuscités. » Le miroir rapporte : « Qala anzirni ila yawmi yub'athun » — accorde-moi un délai jusqu'au jour où ils seront ressuscités. Iblis demande un délai pour égarer. Le miroir m'enseigne : le délai peut être utilisé pour le bien ou le mal.`,
  reflection: `Le délai peut être utilisé pour le bien ou le mal. Comment j'utilise mon temps ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala anzirni ila yawmi yub'athun » — accorde-moi un délai jusqu'au jour où ils seront ressuscités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise mon délai ? Pour le bien ou pour le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai d'Iblis est pour égarer — mon délai doit être pour me guider." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est une opportunité — il peut construire ou détruire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délai utilisé pour le bien mène au succès." }
  ],
  munajat: `Ya Rabb, donne-moi un délai que j'utilise pour le bien. Ne permets pas que je l'utilise pour le mal. Guide-moi dans mon temps.`
};

MIROIR["7:15"] = {
  reference: "7:15",
  theme: ["délai", "accord", "décret"],
  emotion: "Réalité, permission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qada'", "Al-Qadar"],
  mirrorVersion: `« Tu es de ceux à qui un délai est accordé. » Le miroir déclare : « Qala innaka min al-munzarin » — tu es de ceux à qui un délai est accordé. Allah accorde le délai à Iblis. Le miroir m'enseigne : le délai est une permission divine.`,
  reflection: `Le délai est une permission divine. Comment je l'utilise ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala innaka min al-munzarin » — tu es de ceux à qui un délai est accordé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel délai ai-je ? Comment je l'utilise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai accordé à Iblis montre la patience d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le délai est universel — tous ont un temps limité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délai utilisé sagement mène à la réussite." }
  ],
  munajat: `Ya Rabb, merci pour le délai. Fais que je l'utilise pour me rapprocher de Toi. Ne permets pas que je le gaspille.`
};

MIROIR["7:16"] = {
  reference: "7:16",
  theme: ["égarement", "ennemis", "voies"],
  emotion: "Détermination, hostilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Dalal", "Al-'Aduww"],
  mirrorVersion: `« Puisque Tu m'as égaré, je me mettrai en embuscade sur Ton chemin droit. » Le miroir révèle : « Qala fama agwaytani la-aq'udanna lahum sirataka al-mustaqim » — puisque Tu m'as égaré, je me mettrai en embuscade sur Ton chemin droit. Iblis déclare la guerre. Le miroir m'enseigne : l'ennemi est actif.`,
  reflection: `L'ennemi est actif. Suis-je vigilant ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala fama agwaytani la-aq'udanna lahum sirataka al-mustaqim » — puisque Tu m'as égaré, je me mettrai en embuscade sur Ton chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'ennemi attend sur le chemin. Suis-je sur mes gardes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'embuscade d'Iblis est sur le chemin droit — pas sur les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le combat est réel — la vigilance est nécessaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vigilance constante protège du piège." }
  ],
  munajat: `Ya Rabb, l'ennemi attend sur le chemin. Protège-moi de ses embuscades. Fais que je reste sur le chemin droit.`
};

MIROIR["7:17"] = {
  reference: "7:17",
  theme: ["attaque", "voies", "insouciance"],
  emotion: "Avertissement, danger",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaflah", "Al-Tariq"],
  mirrorVersion: `« Ensuite, je les assaillirai de devant, de derrière, de leur droite et de leur gauche. » Le miroir avertit : « Thumma la-atianahum min bayni aydihim wa min khalfihim wa 'an aymanihim wa 'an shamailihim » — ensuite, je les assaillirai de devant, de derrière, de leur droite et de leur gauche. L'attaque est totale. Le miroir m'enseigne : tous les angles sont vulnérables.`,
  reflection: `Tous les angles sont vulnérables. Où est ma faiblesse ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma la-atianahum min bayni aydihim wa min khalfihim wa 'an aymanihim wa 'an shamailihim » — ensuite, je les assaillirai de devant, de derrière, de leur droite et de leur gauche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quel côté suis-je le plus vulnérable ? Avant ? Arrière ? Droite ? Gauche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection contre l'attaque vient d'Allah seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'attaque d'Iblis est universelle — personne n'est épargné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection d'Allah couvre tous les angles." }
  ],
  munajat: `Ya Rabb, l'ennemi m'attaque de tous les côtés. Protège-moi de toutes les directions. Ne permets pas que je sois vaincu.`
};

MIROIR["7:18"] = {
  reference: "7:18",
  theme: ["châtiment", "orgueil", "enfer"],
  emotion: "Jugement, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahannam", "Al-Kibr"],
  mirrorVersion: `« Sors de là, couvert d'opprobre et banni ! » Le miroir juge : « Ukhruj minha madhu'an madhura » — sors de là, couvert d'opprobre et banni ! L'orgueil mène à l'humiliation. Le miroir m'enseigne : la sortie est la conséquence de l'orgueil.`,
  reflection: `L'orgueil mène à l'humiliation. Qu'est-ce qui m'humilierait ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ukhruj minha madhu'an madhura » — sors de là, couvert d'opprobre et banni !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'orgueil mène à l'humiliation. Qu'est-ce qui m'enorgueillit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation d'Iblis est la conséquence de son orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil précède la chute — l'humilité précède l'élévation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité sincère protège de l'humiliation." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'orgueil qui mène à l'humiliation. Fais que je sois humble. Ne permets pas que je sois banni.`
};

MIROIR["7:19"] = {
  reference: "7:19",
  theme: ["paradis", "habitation", "interdit"],
  emotion: "Accueil, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Tahrim"],
  mirrorVersion: `« Ô Adam, habite le Paradis, toi et ton épouse ; et mangez-en autant que vous voudrez. » Le miroir invite : « Ya Adam uskun anta wa zawjuka al-jannata wa kula minha raghadan hayth shi'tuma » — ô Adam, habite le Paradis, toi et ton épouse ; et mangez-en autant que vous voudrez. Le paradis est offert. Le miroir m'enseigne : le bienfait est accompagné d'une limite.`,
  reflection: `Le bienfait est accompagné d'une limite. Quel est mon interdit ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya Adam uskun anta wa zawjuka al-jannata wa kula minha raghadan hayth shi'tuma » — ô Adam, habite le Paradis, toi et ton épouse ; et mangez-en autant que vous voudrez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits ai-je reçus ? Quel est l'interdit qui accompagne ces bienfaits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bienfait sans limite mène à la transgression." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis a une interdiction — la terre a des limites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La limite est une protection — pas une privation." }
  ],
  munajat: `Ya Rabb, merci pour les bienfaits. Aide-moi à respecter les limites. Ne permets pas que je transgresse.`
};

MIROIR["7:20"] = {
  reference: "7:20",
  theme: ["tentation", "Satan", "désir"],
  emotion: "Avertissement, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waswas", "Al-Shahwah"],
  mirrorVersion: `« Puis Satan leur murmura afin de leur révéler ce qui leur avait été caché. » Le miroir révèle : « Fa-waswasa lahuma al-shaytanu li-yubdiya lahuma ma wuriya 'anhuma » — puis Satan leur murmura afin de leur révéler ce qui leur avait été caché. Le murmure de Satan révèle le caché. Le miroir m'enseigne : la tentation commence par un murmure.`,
  reflection: `La tentation commence par un murmure. Quel murmure m'atteint ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-waswasa lahuma al-shaytanu li-yubdiya lahuma ma wuriya 'anhuma » — puis Satan leur murmura afin de leur révéler ce qui leur avait été caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel murmure m'atteint ? Qu'est-ce que Satan veut me révéler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le caché par Allah est caché pour notre bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tentation est universelle — personne n'est épargné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le murmure rejeté dès le début n'a pas de pouvoir." }
  ],
  munajat: `Ya Rabb, le murmure de Satan m'atteint. Aide-moi à le rejeter. Ne permets pas que je succombe à la tentation.`
};

MIROIR["7:21"] = {
  reference: "7:21",
  theme: ["tromperie", "Satan", "serment"],
  emotion: "Ruse, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghish", "Al-Yamin"],
  mirrorVersion: `« Et il leur jura : Je suis pour vous un bon conseiller. » Le miroir alerte : « Wa qasamahuma inni lakuma la-mina al-nasihina » — et il leur jura : je suis pour vous un bon conseiller. Le serment de Satan est un mensonge. Le miroir m'enseigne : le mensonge peut être voilé par un serment.`,
  reflection: `Le mensonge peut être voilé par un serment. Comment discerner le vrai du faux ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qasamahuma inni lakuma la-mina al-nasihina » — et il leur jura : je suis pour vous un bon conseiller." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui me conseille ? Le conseil vient-il d'un ennemi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le conseiller menteur utilise le serment pour tromper." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tromperie existe — le discernement est nécessaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le conseil d'Allah est le seul conseil sûr." }
  ],
  munajat: `Ya Rabb, le conseiller menteur utilise le serment. Donne-moi le discernement. Fais que je ne sois pas trompé.`
};

MIROIR["7:22"] = {
  reference: "7:22",
  theme: ["désobéissance", "regret", "honte"],
  emotion: "Regret, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ma'siyah", "Al-Nadam"],
  mirrorVersion: `« Ainsi, il les fit tomber par tromperie. » Le miroir constate : « Fa-dallahuma bi-ghurur » — ainsi, il les fit tomber par tromperie. La chute est arrivée par tromperie. Le miroir m'enseigne : la désobéissance commence par une tromperie.`,
  reflection: `La désobéissance commence par une tromperie. Quelle tromperie me fait tomber ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-dallahuma bi-ghurur » — ainsi, il les fit tomber par tromperie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle tromperie me fait tomber ? Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tromperie révèle notre vulnérabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chute d'Adam est un exemple pour nous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la tromperie protège de la chute." }
  ],
  munajat: `Ya Rabb, la tromperie me fait tomber. Protège-moi de la chute. Ne permets pas que je sois trompé.`
};

// ==================== SURAH 7: AL-A'RAF - VERSETS 24-34 ====================

MIROIR["7:24"] = {
  reference: "7:24",
  theme: ["descente", "terre", "ennemis"],
  emotion: "Constat, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hubut", "Al-Ard"],
  mirrorVersion: `« Descendez ! Vous serez ennemis les uns des autres. » Le miroir déclare : « Qala hbitu ba'dukum li-ba'din 'aduww » — descendez ! Vous serez ennemis les uns des autres. La terre est le lieu de l'épreuve. L'hostilité entre hommes et Satan est établie. Le miroir m'enseigne : le conflit est inhérent à la condition terrestre.`,
  reflection: `Le conflit est inhérent à la condition terrestre. Comment je gère mes ennemis ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala hbitu ba'dukum li-ba'din 'aduww » — descendez ! Vous serez ennemis les uns des autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes ennemis ? Comment je réagis à l'hostilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hostilité avec Satan est inévitable — l'hostilité entre hommes peut être surmontée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est le champ de bataille — le paradis est le lieu de paix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'ennemi déclaré est plus facile à combattre que l'ennemi caché." }
  ],
  munajat: `Ya Rabb, j'ai des ennemis sur terre. Aide-moi à les gérer avec sagesse. Fais que je ne sois pas parmi les hostiles.`
};

MIROIR["7:25"] = {
  reference: "7:25",
  theme: ["vie", "mort", "résurrection"],
  emotion: "Réalité, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Hayah", "Al-Mawt"],
  mirrorVersion: `« C'est sur terre que vous vivrez, que vous mourrez et d'où vous serez tirés. » Le miroir rappelle : « Fiha tahyuna wa fiha tamutuna wa minha tukhrajun » — c'est sur terre que vous vivrez, que vous mourrez et d'où vous serez tirés. Le cycle de la vie est complet. Le miroir m'enseigne : la terre est le lieu du passage.`,
  reflection: `La terre est le lieu du passage. Comment je vis ce passage ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fiha tahyuna wa fiha tamutuna wa minha tukhrajun » — c'est sur terre que vous vivrez, que vous mourrez et d'où vous serez tirés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis ce passage terrestre ? Suis-je conscient de ma fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie sur terre mène à la mort — la mort mène à la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle vie-mort-résurrection est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la mort donne du sens à la vie." }
  ],
  munajat: `Ya Rabb, la terre est mon lieu de passage. Fais que j'y vive bien et que j'y meure en paix. Prépare-moi pour la résurrection.`
};

MIROIR["7:26"] = {
  reference: "7:26",
  theme: ["vêtements", "pudeur", "bienfait"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Libas", "Al-Taqwa"],
  mirrorVersion: `« Ô enfants d'Adam ! Nous avons fait descendre sur vous des vêtements pour cacher vos nudités. » Le miroir rappelle : « Ya bani Adama qad anzalna 'alaykum libasan yuwari saw'atikum » — ô enfants d'Adam ! Nous avons fait descendre sur vous des vêtements pour cacher vos nudités. Le vêtement est un bienfait. Le miroir m'enseigne : la pudeur est une vertu.`,
  reflection: `Le vêtement cache la nudité. La taqwa est le vêtement du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya bani Adama qad anzalna 'alaykum libasan yuwari saw'atikum » — ô enfants d'Adam ! Nous avons fait descendre sur vous des vêtements pour cacher vos nudités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Qu'est-ce que je révèle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vêtement extérieur cache le corps — la taqwa cache les défauts de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pudeur est universelle — la nudité est une honte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le meilleur vêtement est la taqwa." }
  ],
  munajat: `Ya Rabb, merci pour les vêtements qui cachent ma nudité. Habille mon cœur de taqwa. Ne permets pas que je sois nu devant Toi.`
};

MIROIR["7:27"] = {
  reference: "7:27",
  theme: ["Satan", "parents", "tentation"],
  emotion: "Avertissement, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shaytan", "Al-Waladan"],
  mirrorVersion: `« Ô enfants d'Adam ! Que Satan ne vous tente pas comme il a fait sortir vos parents du Paradis. » Le miroir avertit : « Ya bani Adama la yaftiannannakumu al-shaytanu kama akhraja abawaykum min al-jannah » — ô enfants d'Adam ! Que Satan ne vous tente pas comme il a fait sortir vos parents du Paradis. L'histoire d'Adam est un avertissement. Le miroir m'enseigne : la tentation de Satan est éternelle.`,
  reflection: `La tentation de Satan est éternelle. Comment m'en protéger ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya bani Adama la yaftiannannakumu al-shaytanu kama akhraja abawaykum min al-jannah » — ô enfants d'Adam ! Que Satan ne vous tente pas comme il a fait sortir vos parents du Paradis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment Satan me tente-t-il ? Suis-je conscient de ses ruses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sortie d'Adam du paradis est un exemple — notre retour au paradis est possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tentation de Satan touche tous les enfants d'Adam." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance des ruses de Satan protège de la tentation." }
  ],
  munajat: `Ya Rabb, Satan veut me tenter comme il a tenté Adam. Protège-moi de ses ruses. Fais que je ne sois pas trompé.`
};

MIROIR["7:28"] = {
  reference: "7:28",
  theme: ["ignorance", "coutume", "réforme"],
  emotion: "Questionnement, guidance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahl", "Al-'Ada"],
  mirrorVersion: `« Et quand ils commettent une turpitude, ils disent : Nous avons trouvé nos ancêtres sur ce chemin. » Le miroir questionne : « Wa idha fa'alu al-fahishata qalu wajadna 'alayha aba'ana » — et quand ils commettent une turpitude, ils disent : nous avons trouvé nos ancêtres sur ce chemin. L'argument de la tradition est faux. Le miroir m'enseigne : la tradition n'excuse pas le mal.`,
  reflection: `La tradition n'excuse pas le mal. Quelles traditions dois-je abandonner ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha fa'alu al-fahishata qalu wajadna 'alayha aba'ana » — et quand ils commettent une turpitude, ils disent : nous avons trouvé nos ancêtres sur ce chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles mauvaises traditions ai-je héritées ? Les ai-je remises en question ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tradition des ancêtres peut être bonne ou mauvaise — le critère est la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les traditions varient — la vérité est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le courage de remettre en question les traditions mène à la vérité." }
  ],
  munajat: `Ya Rabb, les traditions ne sont pas toujours bonnes. Donne-moi le courage de remettre en question le mal. Guide-moi vers la vérité.`
};

MIROIR["7:29"] = {
  reference: "7:29",
  theme: ["ordonnance", "sincérité", "retour"],
  emotion: "Commandement, appel",
  difficulty: "débutant",
  relatedNames: ["Al-Amr", "Al-Ikhlas"],
  mirrorVersion: `« Mon Seigneur a ordonné l'équité. » Le miroir commande : « Qala rabbu ya'muru bi-l-'adl » — mon Seigneur a ordonné l'équité. L'équité est le fondement. Le miroir m'enseigne : l'équité est un commandement divin.`,
  reflection: `L'équité est un commandement divin. Suis-je équitable ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbu ya'muru bi-l-'adl » — mon Seigneur a ordonné l'équité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je équitable dans mes jugements ? Dans mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équité ordonnée par Allah est le standard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équité est universelle — l'injustice est condamnée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'équité du cœur précède l'équité des actions." }
  ],
  munajat: `Ya Rabb, Tu as ordonné l'équité. Fais que je sois équitable. Ne permets pas que je sois injuste.`
};

MIROIR["7:30"] = {
  reference: "7:30",
  theme: ["guidance", "égarement", "choix"],
  emotion: "Réalité, conséquence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Huda", "Al-Dalal"],
  mirrorVersion: `« Il en a guidé une partie, tandis qu'une autre partie a mérité l'égarement. » Le miroir constate : « Fariqan hada wa fariqan haqqat 'alayhi al-dalalah » — il en a guidé une partie, tandis qu'une autre partie a mérité l'égarement. La guidance et l'égarement sont des conséquences. Le miroir m'enseigne : le choix détermine le résultat.`,
  reflection: `Le choix détermine le résultat. Quel est mon choix ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fariqan hada wa fariqan haqqat 'alayhi al-dalalah » — il en a guidé une partie, tandis qu'une autre partie a mérité l'égarement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quel groupe suis-je ? Guidé ou égaré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement est mérité par le choix — la guidance est accordée par le choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité est divisée — les croyants et les mécréants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guidance demandée sincèrement est accordée." }
  ],
  munajat: `Ya Rabb, je veux être parmi les guidés. Guide-moi vers le droit chemin. Ne permets pas que je sois parmi les égarés.`
};

MIROIR["7:31"] = {
