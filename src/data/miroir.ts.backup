MIROIR["22:46"] = {
  reference: "22:46",
  theme: ["cœur", "vue", "oreille"],
  emotion: "Réalité, éveil",
  difficulty: "débutant",
  relatedNames: ["Al-Qalb", "Al-Basr"],
  mirrorVersion: `« N'ont-ils pas voyagé sur terre, pour avoir des cœurs avec lesquels comprendre ? » Le miroir me montre l'importance du cœur. « A-fa-lam yasiru fi al-ardi fa-takuna lahum qulubun ya'qiluna biha » — n'ont-ils pas voyagé pour avoir des cœurs avec lesquels comprendre. Le cœur est l'organe de la compréhension. Le miroir m'interroge : est-ce que mon cœur comprend ?`,
  reflection: `Le cœur est l'organe de la compréhension. L'éveiller est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-lam yasiru fi al-ardi fa-takuna lahum qulubun ya'qiluna biha aw adhanun yasma'una biha » — n'ont-ils pas voyagé sur terre, pour avoir des cœurs avec lesquels comprendre ou des oreilles avec lesquelles entendre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cœur comprend ? Ou est-ce qu'il est scellé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éveil du cœur vient de la contemplation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le voyage sur terre est une école pour le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur comprend voit la vérité partout." }
  ],
  munajat: `Ya Rabb, je veux un cœur qui comprend. Ne permets pas qu'il soit scellé. Éveille mon cœur par la contemplation.`
};

