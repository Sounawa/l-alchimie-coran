    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me joins à cette louange universelle ? Ou est-ce que je reste silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange du croyant complète la louange universelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est en état d'adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue Allah rejoint l'orchestre universel." }
  ],
  munajat: `Ya Rabb, je me joins à la louange universelle. Ne permets pas le silence dans ma bouche. Fais que je loue avec toute la création.`
};

