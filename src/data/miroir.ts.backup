  difficulty: "débutant",
  relatedNames: ["Ar-Rabb", "Ar-Rahman"],
  mirrorVersion: `« Le Seigneur des cieux et de la terre et de ce qui est entre eux, le Tout-Miséricordieux. » Le miroir me montre la majesté divine. « Rabbi as-samawati wa al-ardi wa ma baynahuma ar-rahman » — le Seigneur des cieux et de la terre et de ce qui est entre eux, le Tout-Miséricordieux. La majesté. Le miroir m'enseigne : Allah est le Maître de tout.`,
  reflection: `Le Seigneur de tout, le Tout-Miséricordieux. La majesté est immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi as-samawati wa al-ardi wa ma baynahuma ar-rahman » — le Seigneur des cieux et de la terre et de ce qui est entre eux, le Tout-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Il est le Seigneur de tout. Comment L'adorer convenablement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration du Seigneur de tout est la vraie adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers est sous Sa seigneurie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore le Seigneur de tout est un vrai adorateur." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur de tout. Je T'adore comme Seigneur de tout. Accepte mon adoration.`
};

MIROIR["78:38"] = {
  reference: "78:38",
  theme: ["intercession", "permission", "parole"],
  emotion: "Majesté, réalité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shafa'ah", "Al-Idhn"],
  mirrorVersion: `« Le jour où l'Esprit et les anges se tiendront en rangs, nul ne parlera sauf celui à qui le Tout-Miséricordieux accordera la permission. » Le miroir me montre la majesté du Jour. « Yawma yaqumu ar-ruhu wa al-mala'ikatu saffan la yantiquuna illa man adhina lahu ar-rahman » — le jour où l'Esprit et les anges se tiendront en rangs, nul ne parlera sauf celui à qui le Tout-Miséricordieux accordera la permission. La majesté. Le miroir m'enseigne : ce jour est majestueux.`,
  reflection: `L'Esprit et les anges en rangs. La majesté est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yaqumu ar-ruhu wa al-mala'ikatu saffan la yantiquuna illa man adhina lahu ar-rahman » — le jour où l'Esprit et les anges se tiendront en rangs, nul ne parlera sauf celui à qui le Tout-Miséricordieux accordera la permission." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La majesté est absolue ce jour-là. Comment serai-je traité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour ce jour est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Esprit et les anges concernent tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare sera parmi ceux qui ont la permission." }
  ],
  munajat: `Ya Rabb, prépare-moi pour ce jour majestueux. Donne-moi la permission de parler. Fais-moi partie de ceux qui réussissent.`
};

MIROIR["78:40"] = {
