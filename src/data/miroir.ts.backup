    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le châtiment augmente. Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite l'augmentation du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'augmentation du châtiment est une réalité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi évite l'augmentation du châtiment." }
  ],
  munajat: `Ya Rabb, je veux éviter l'augmentation du châtiment. Donne-moi la foi qui sauve. Ne permets pas que je goûte le châtiment.`
};

