    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le Coran comme l'accomplissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité du Coran inclut et dépasse les révélations précédentes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation finale est pour toute l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Livre est un cadeau et une responsabilité." }
  ],
  munajat: `Ya Rabb, merci pour le Livre de vérité. Fais que je l'honore et le suive. Ne permets pas que je le néglige.`
};

MIROIR["6:155"] = {
