  difficulty: "intermédiaire",
  relatedNames: ["Al-A'imma", "Al-Atba'"],
  mirrorVersion: `« Voici une foule qui se précipite avec vous. Nulle bienvenue pour eux ! Ils vont brûler. » Le miroir montre : les meneurs et les suivants partagent le même sort. En Enfer, les leaders des égarés rencontrent leurs disciples. Le miroir m'enseigne : la responsabilité est partagée.`,
  reflection: `Les leaders et les suivants partagent le sort. Qui suis-je ? Meneur ou suivi ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadha fawjun muktazibun ma'akum la marhaban bihum innahum salun an-nar » — voici une foule qui se précipite avec vous. Nulle bienvenue pour eux ! Ils vont brûler." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui suis-je en train d'entraîner ? Qui suis-je en train de suivre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'influence peut être positive ou négative — choisir avec sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque leader porte la responsabilité de ses suivants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le leader sage guide vers le bien, pas vers le mal." }
  ],
  munajat: `Ya Rabb, si je suis un leader, guide-moi vers le bien. Si je suis un suivant, donne-moi des guides justes.`
};

MIROIR["38:60"] = {
  reference: "38:60",
  theme: ["reproche", "blâme", "responsabilité"],
  emotion: "Regret, conflit",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Lawm", "At-Tabi'a"],
  mirrorVersion: `« Ils diront : Au contraire, pas de bienvenue pour vous ! C'est vous qui nous avez préparé cela. » Le miroir montre le blâme réciproque en Enfer. Les suivants reprochent aux leaders de les avoir égarés. Le miroir m'enseigne : en Enfer, les alliances se brisent.`,
  reflection: `En Enfer, les alliances se brisent. Les reproches remplacent l'amitié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu bal antum la marhaban bikum antum qaddamtumuhu lana » — ils diront : Au contraire, pas de bienvenue pour vous ! C'est vous qui nous avez préparé cela." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui blâmerai-je en Enfer ? Qui me blâmera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le blâme réciproque ne résout rien — la responsabilité est individuelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les alliances basées sur le mal se brisent dans le mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie amitié est celle qui unit dans le bien." }
  ],
  munajat: `Ya Rabb, préserve-moi des alliances qui m'égarent. Donne-moi des compagnons qui me rapprochent de Toi.`
};

MIROIR["38:61"] = {
  reference: "38:61",
  theme: ["malédiction", "égarants", "punition"],
  emotion: "Colère, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-La'nah", "Al-Mudillin"],
  mirrorVersion: `« Ils diront : Seigneur, celui qui nous a égarés, ajoute-lui un double châtiment dans le Feu. » Le miroir montre la prière des damnés contre leurs égarants. Double châtiment pour les meneurs du mal. Le miroir m'enseigne : la responsabilité des leaders est double.`,
  reflection: `La responsabilité des leaders est double. Ceux qui égarent portent une charge supplémentaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu rabbana man qaddama lana hadha fa-zidhu 'adhaban di'fan fi an-nar » — ils diront : Seigneur, celui qui nous a égarés, ajoute-lui un double châtiment dans le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'égare les autres ? Quel châtiment m'attend ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le double châtiment montre la gravité d'égarer autrui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'influence négative a des conséquences éternelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide vers le bien reçoit la récompense de ceux qu'il guide." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'égare les autres. Si j'ai égaré, pardonne-moi. Donne-moi de guider vers Toi.`
};

MIROIR["38:62"] = {
  reference: "38:62",
  theme: ["question", "absence", "faiblesse"],
  emotion: "Questionnement, surprise",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Su'al", "Al-Du'afa'"],
  mirrorVersion: `« Ils diront : Pourquoi ne voyons-nous pas des gens que nous comptions parmi les méchants ? » Le miroir montre la surprise des mécréants. Certains qu'ils pensaient en Enfer ne sont pas là. Le miroir m'enseigne : les apparences peuvent tromper.`,
  reflection: `Les apparences peuvent tromper. Qui est sauvé ? Qui est perdu ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu ma lana la nara rijalan kunna na'udduhum min al-ashrar » — ils diront : Pourquoi ne voyons-nous pas des gens que nous comptions parmi les méchants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je juge mal ? Les apparences cachent-elles la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui paraît méchant peut être sauvé — celui qui paraît juste peut être perdu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah est basé sur le cœur, pas sur les apparences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Seul Allah connaît la vérité des cœurs." }
  ],
  munajat: `Ya Rabb, Tu connais les cœurs. Ne permets pas que je juge par les apparences. Juge-moi par mon cœur, pas par mon apparence.`
};

MIROIR["38:63"] = {
  reference: "38:63",
  theme: ["moquerie", "réalité", "vision"],
  emotion: "Réalisation, confusion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sukhriyah", "Al-Ru'ya"],
  mirrorVersion: `« Nous en avions fait un objet de moquerie, ou nos regards se sont-ils détournés d'eux ? » Le miroir montre le regret des moqueurs. Ceux qu'ils moquaient ne sont pas là — peut-être sont-ils au Paradis. Le miroir m'enseigne : la moquerie peut masquer la vérité.`,
  reflection: `La moquerie peut masquer la vérité. Ceux que je moque peuvent être meilleurs que moi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Attakhadhnahum sikhrayan am zaghat 'anhum al-absar » — nous en avions fait un objet de moquerie, ou nos regards se sont-ils détournés d'eux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que je moque ? Cette personne est-elle meilleure que moi aux yeux d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie est souvent un voile sur la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les moqueurs peuvent être les moqués au Jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La moquerie des croyants est un signe d'égarement." }
  ],
  munajat: `Ya Rabb, préserve-moi de la moquerie. Ouvre mes yeux sur la vérité des autres. Ne permets pas que je me moque de Tes serviteurs.`
};

MIROIR["38:64"] = {
  reference: "38:64",
  theme: ["certitude", "dispute", "enfer"],
  emotion: "Réalité, dispute",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "An-Nizar"],
  mirrorVersion: `« C'est vraiment la vérité : la dispute des gens du Feu. » Le miroir affirme : « Inna dhalika la-haqqun takhasumu ahlu an-nar » — c'est vraiment la vérité : la dispute des gens du Feu. La dispute en Enfer est certaine. Le miroir m'enseigne : les disputes d'ici-bas peuvent continuer en Enfer.`,
  reflection: `Les disputes d'ici-bas peuvent continuer en Enfer. La réconciliation est préférable maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna dhalika la-haqqun takhasumu ahlu an-nar » — c'est vraiment la vérité : la dispute des gens du Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui suis-je en dispute ? La réconciliation est-elle possible maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute qui n'est pas résolue ici peut continuer là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La dispute est le signe de la division — l'unité est dans la paix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La réconciliation d'ici-bas prévient la dispute de là-bas." }
  ],
  munajat: `Ya Rabb, résous mes disputes ici-bas. Ne permets pas qu'elles me suivent dans l'au-delà. Donne-moi la grâce de me réconcilier.`
};

MIROIR["38:65"] = {
  reference: "38:65",
  theme: ["avertissement", "unicité", "nul"],
  emotion: "Sérieux, proclamation",
  difficulty: "débutant",
  relatedNames: ["Al-Ahad", "An-Nadhir"],
  mirrorVersion: `« Dis : Je ne suis qu'un avertisseur. Point de divinité en dehors d'Allah, l'Unique. » Le miroir proclame : « Qul innama ana mundhirun wa ma min ilahin ghairu-Allah al-wahid » — dis : je ne suis qu'un avertisseur. Point de divinité en dehors d'Allah, l'Unique. Le message est clair : tawhid et avertissement.`,
  reflection: `Le message du Prophète est clair : tawhid et avertissement. Je dois l'entendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama ana mundhirun wa ma min ilahin ghairu-Allah al-wahid » — dis : je ne suis qu'un avertisseur. Point de divinité en dehors d'Allah, l'Unique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je entendu l'avertissement ? Mon cœur est-il vraiment unifié autour d'Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement précède le châtiment — l'ignorer est dangereux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité d'Allah est la vérité universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'avertissement est une miséricorde pour celui qui écoute." }
  ],
  munajat: `Ya Ahad, Tu es l'Unique. J'entends l'avertissement. Unifie mon cœur autour de Toi seul. Préserve-moi du châtiment.`
};

MIROIR["38:66"] = {
  reference: "38:66",
  theme: ["seigneur", "cieux", "terre"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Ar-Rabb", "Al-Khaliq"],
  mirrorVersion: `« Le Seigneur des cieux, de la terre et de ce qui est entre eux, le Puissant, le Pardonneur. » Le miroir proclame : « Rabbu as-samawati wa al-ardi wa ma baynahuma al-'aziz al-ghaffar » — le Seigneur des cieux, de la terre et de ce qui est entre eux, le Puissant, le Pardonneur. Allah est le Maître de tout, Puissant et Pardonneur.`,
  reflection: `Allah est le Maître de tout. Sa puissance et Son pardon sont infinis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbu as-samawati wa al-ardi wa ma baynahuma al-'aziz al-ghaffar » — le Seigneur des cieux, de la terre et de ce qui est entre eux, le Puissant, le Pardonneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Reconnais-je Allah comme Seigneur de tout ? Sa puissance me rassure-t-elle ? Son pardon m'encourage-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance et le pardon sont deux attributs qui se complètent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cieux et la terre témoignent de la seigneurie d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui reconnaît la seigneurie d'Allah trouve la paix." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur de tout. Ta puissance me rassure, Ton pardon m'encourage. Je me soumets à Toi.`
};

MIROIR["38:67"] = {
  reference: "38:67",
  theme: ["coran", "grandeur", "détournement"],
  emotion: "Mise en garde, tristesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Quran", "Al-Kabir"],
  mirrorVersion: `« Dis : C'est une grande nouvelle que vous détournez. » Le miroir questionne : « Qul huwa naba'un 'azimun antum 'anhu mu'ridun » — dis : c'est une grande nouvelle que vous détournez. Le Coran est une grande nouvelle, mais beaucoup se détournent. Le miroir m'interroge : me détourne-je aussi ?`,
  reflection: `Le Coran est une grande nouvelle. Me détourne-je de cette nouvelle ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul huwa naba'un 'azimun antum 'anhu mu'ridun » — dis : c'est une grande nouvelle que vous détournez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite le Coran ? Grande nouvelle ou distraction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement du Coran est le chemin vers l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la nouvelle la plus importante pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se tourne vers le Coran se tourne vers Allah." }
  ],
  munajat: `Ya Rabb, le Coran est une grande nouvelle. Ne permets pas que je m'en détourne. Ouvre mon cœur à sa récitation et à sa compréhension.`
};

MIROIR["38:68"] = {
  reference: "38:68",
  theme: ["rejet", "éloignement", "indifférence"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawalli", "Al-I'rad"],
  mirrorVersion: `« Vous vous en éloignez comme d'une chose indifférente. » Le miroir observe : « Antum 'anhu mu'ridun » — vous vous en éloignez. L'indifférence envers le Coran. Le miroir m'avertit : l'indifférence est un danger.`,
  reflection: `L'indifférence envers le Coran est un danger. Comment retrouver l'intérêt ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Antum 'anhu mu'ridun » — vous vous en éloignez comme d'une chose indifférente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je indifférent au Coran ? Quelle est ma relation avec le Livre d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'indifférence est pire que le rejet — le rejet est une position, l'indifférence est une négligence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'indifférence envers la parole d'Allah reflète l'état du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur vivant ne peut être indifférent au Coran." }
  ],
  munajat: `Ya Rabb, je ne veux pas être indifférent au Coran. Réveille mon cœur. Donne-moi l'amour de Ton Livre.`
};

MIROIR["38:69"] = {
  reference: "38:69",
  theme: ["connaissance", "haut", "assemblée"],
  emotion: "Humilité, révélation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Ilm", "Al-Mala'"],
  mirrorVersion: `« Je n'avais aucune connaissance de l'assemblée suprême, quand ils disputaient. » Le miroir montre l'humilité du Prophète. Il ne connaissait pas les discussions des anges avant la révélation. Le miroir m'enseigne : la connaissance vient d'Allah, pas de nous-mêmes.`,
  reflection: `La connaissance vient d'Allah. L'humilité dans la connaissance est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana liya min 'ilmin bi-al-mala'i al-a'la idh yaktasimun » — je n'avais aucune connaissance de l'assemblée suprême, quand ils disputaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la source de ma connaissance ? Allah ou moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans la connaissance attire plus de connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'assemblée suprême discute des affaires de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son ignorance reçoit la connaissance." }
  ],
  munajat: `Ya 'Alim, Tu es la source de toute connaissance. Apprends-moi l'humilité. Donne-moi la connaissance qui vient de Toi.`
};

MIROIR["38:70"] = {
  reference: "38:70",
  theme: ["révélation", "avertissement", "clarté"],
  emotion: "Mission, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Mubin"],
  mirrorVersion: `« Il m'est révélé que je ne suis qu'un avertisseur explicite. » Le miroir clarifie : « In yuha ilayya illa annama ana nadhirun mubin » — il m'est révélé que je ne suis qu'un avertisseur explicite. La mission du Prophète est claire : avertir. Le miroir m'invite à entendre l'avertissement.`,
  reflection: `La mission du Prophète est d'avertir. Ma mission est d'écouter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yuha ilayya illa annama ana nadhirun mubin » — il m'est révélé que je ne suis qu'un avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je entendu l'avertissement explicite ? Qu'est-ce que je fais de cet avertissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement explicite ne laisse pas de place à l'excuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est universel — personne n'est exclu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'avertissement bien reçu mène à la guidance." }
  ],
  munajat: `Ya Rabb, j'entends l'avertissement explicite. Guide-moi vers la réponse appropriée. Ne permets pas que je l'ignore.`
};

MIROIR["38:71"] = {
  reference: "38:71",
  theme: ["création", "homme", "argile"],
  emotion: "Émerveillement, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "At-Tin"],
  mirrorVersion: `« Quand ton Seigneur dit aux anges : Je vais créer un homme d'argile. » Le miroir me ramène à l'origine. L'homme, de l'argile — matière simple, mais création noble. Le miroir m'invite à contempler mon origine.`,
  reflection: `Je suis d'argile. Mon origine est humble. Pourquoi l'orgueil ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh qala rabbuka li-al-mala'ikati inni khaliqun basharan min tin » — quand ton Seigneur dit aux anges : Je vais créer un homme d'argile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où viens-je ? De l'argile. Pourquoi m'enorgueillir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argile devient homme par le souffle divin — la matière devient esprit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création vient de la terre — la terre est la mère universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine ne s'enorgueillit pas." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'argile. Je suis humble devant mon origine. Ne permets pas l'orgueil dans mon cœur.`
};

MIROIR["38:72"] = {
  reference: "38:72",
  theme: ["souffle", "vie", "anges"],
  emotion: "Mystère, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Ruh", "Al-Hayat"],
  mirrorVersion: `« Quand Je l'aurai harmonieusement formé et insufflé en lui Mon souffle, prosternez-vous devant lui. » Le miroir montre le mystère de la vie. Le souffle d'Allah dans l'argile — la matière devient vivante. Les anges doivent se prosterner. Le miroir m'invite à honorer ce souffle.`,
  reflection: `Le souffle d'Allah en moi. Suis-je conscient de cette dignité ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha sawwaytuhu wa nafakhtu fihi min ruhi faqa'u lahu sajideen » — quand Je l'aurai harmonieusement formé et insufflé en lui Mon souffle, prosternez-vous devant lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite ce souffle d'Allah en moi ? Est-il honoré ou négligé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souffle divin est la dignité de l'homme — le négliger est l'indignité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le souffle d'Allah anime toute vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le souffle divin dans le cœur est la connexion permanente avec Allah." }
  ],
  munajat: `Ya Rabb, Ton souffle est en moi. Honore ce souffle. Fais que je vive selon la dignité que Tu m'as donnée.`
};

MIROIR["38:73"] = {
  reference: "38:73",
  theme: ["prosternation", "anges", "obéissance"],
  emotion: "Révérence, obéissance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sujud", "At-Ta'ah"],
  mirrorVersion: `« Les anges se prosternèrent tous ensemble. » Le miroir montre l'obéissance des anges. Tous ensemble, sans exception, ils se prosternèrent. L'obéissance immédiate. Le miroir m'invite à cette obéissance.`,
  reflection: `Les anges obéissent immédiatement. Mon obéissance est-elle aussi immédiate ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sajada al-mala'ikatu kulluhum ajma'un » — les anges se prosternèrent tous ensemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis immédiatement ? Ou est-ce que je tarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance des anges contraste avec la désobéissance d'Iblis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création obéit à Allah — l'homme a le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance immédiate est la marque de l'amour." }
  ],
  munajat: `Ya Rabb, les anges obéissent immédiatement. Donne-moi la grâce de l'obéissance rapide. Ne permets pas que je tarde.`
};

MIROIR["38:74"] = {
  reference: "38:74",
  theme: ["Iblis", "orgueil", "refus"],
  emotion: "Mise en garde, tristesse",
  difficulty: "intermédiaire",
  relatedNames: ["Iblis", "Al-Kibr"],
  mirrorVersion: `« Sauf Iblis qui s'enorgueillit et fut du nombre des mécréants. » Le miroir montre l'exception. Iblis refusa, s'enorgueillit. Un seul refus parmi l'obéissance universelle. Le miroir m'avertit : l'orgueil peut me séparer de tous.`,
  reflection: `Iblis refusa par orgueil. L'orgueil peut me séparer de la communauté des obéissants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila Iblisa istakbara wa kana min al-kafirin » — sauf Iblis qui s'enorgueillit et fut du nombre des mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il de l'orgueil en moi qui me ferait refuser l'obéissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil transforme l'ange en démon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le refus d'Iblis montre que la position élevée ne garantit pas le salut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité protège de la chute d'Iblis." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'orgueil d'Iblis. Ne permets pas que je refuse l'obéissance. Donne-moi l'humilité.`
};

MIROIR["38:75"] = {
  reference: "38:75",
  theme: ["question", "création", "supériorité"],
  emotion: "Interpellation, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khalq", "Al-Fadl"],
  mirrorVersion: `« Ô Iblis, qu'est-ce qui t'a empêché de te prosterner devant ce que J'ai créé de Mes mains ? » Le miroir interroge. Allah a créé Adam de Ses mains — honneur spécial. Iblis a refusé de se prosterner. Le miroir m'invite à réfléchir sur ma propre réaction.`,
  reflection: `Allah a honoré l'homme. Comment je traite cet honneur ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya Iblisu ma mana'aka an tasjuda lima khalaqtu bi-yadayya » — ô Iblis, qu'est-ce qui t'a empêché de te prosterner devant ce que J'ai créé de Mes mains ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'honneur d'Allah envers l'homme ? Envers moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus de reconnaître l'honneur de l'autre est l'orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création d'Allah a une valeur — la reconnaître est la sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore ce qu'Allah honore est honoré." }
  ],
  munajat: `Ya Rabb, Tu as honoré l'homme. Aide-moi à reconnaître cette honneur. Ne permets pas que je méprise ce que Tu as créé.`
};

MIROIR["38:76"] = {
  reference: "38:76",
  theme: ["feu", "argile", "comparaison"],
  emotion: "Orgueil, défi",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nar", "At-Tin"],
  mirrorVersion: `« Je suis meilleur que lui : Tu m'as créé de feu, et Tu l'as créé d'argile. » Le miroir montre l'argument d'Iblis. Il se compare : le feu est supérieur à l'argile. La comparaison par la matière. Le miroir m'avertit : la comparaison mène à l'orgueil.`,
  reflection: `La comparaison mène à l'orgueil. Je compare-t-je ma valeur à celle des autres ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ana khayrun minhu khalaqtani min narin wa khalaqtahu min tin » — je suis meilleur que lui : Tu m'as créé de feu, et Tu l'as créé d'argile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quelle base je me compare aux autres ? La matière ? Les dons ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La supériorité matérielle ne signifie pas la supériorité spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La valeur aux yeux d'Allah n'est pas dans la matière mais dans le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se compare se perd dans l'illusion." }
  ],
  munajat: `Ya Rabb, délivre-moi de la comparaison. Ma valeur est en Toi, pas dans ce que Tu m'as donné. Donne-moi l'humilité.`
};

MIROIR["38:77"] = {
  reference: "38:77",
  theme: ["expulsion", "sortie", "pureté"],
  emotion: "Jugement, exclusion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Takhliyah", "Al-Khuruj"],
  mirrorVersion: `« Sors d'ici ! Tu es banni. » Le miroir prononce le jugement. Iblis est expulsé de la présence divine. L'orgueil a des conséquences. Le miroir m'avertit : l'orgueil peut me faire expulser.`,
  reflection: `L'orgueil peut me faire expulser de la présence divine. L'humilité est le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-khruj minhaka fa-innaka rajim » — sors d'ici ! Tu es banni." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je risque l'expulsion par mon orgueil ? Ou est-ce que je reste humble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'expulsion d'ici précède l'expulsion de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La présence divine accueille les humbles, repousse les arrogants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité maintient dans la présence, l'orgueil expulse." }
  ],
  munajat: `Ya Rabb, ne m'expulse pas de Ta présence. Je me repens de tout orgueil. Garde-moi humble auprès de Toi.`
};

MIROIR["38:78"] = {
  reference: "38:78",
  theme: ["malédiction", "jugement", "éternité"],
  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-La'nah", "Al-Din"],
  mirrorVersion: `« Ma malédiction est sur toi jusqu'au jour du Jugement. » Le miroir prononce la malédiction. Jusqu'au Jugement — une durée immense. Le miroir m'avertit : la désobéissance a des conséquences durables.`,
  reflection: `La désobéissance a des conséquences durables. La malédiction peut durer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna 'alayka la'nati ila yawmi ad-din » — ma malédiction est sur toi jusqu'au jour du Jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle malédiction pèse sur moi ? De quoi dois-je me repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La malédiction d'Allah peut être levée par le repentir sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La malédiction suit les arrogants jusqu'au Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le repentir sincère peut transformer la malédiction en miséricorde." }
  ],
  munajat: `Ya Rabb, si Ta malédiction est sur moi, lève-la par Ton pardon. Je me repens de tout orgueil et de toute désobéissance.`
};

MIROIR["38:79"] = {
  reference: "38:79",
  theme: ["demande", "délai", "Iblis"],
  emotion: "Détermination, demande",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mahl", "Al-Ajal"],
  mirrorVersion: `« Seigneur, donne-moi un délai jusqu'au jour où ils seront ressuscités. » Le miroir montre la demande d'Iblis. Même maudit, il demande un délai. Sa demande est accordée. Le miroir m'enseigne : Allah peut accorder même à Ses ennemis.`,
  reflection: `Allah peut accorder même à Ses ennemis. Sa miséricorde précède Sa justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabb fa-anzirni ila yawmi yub'athun » — Seigneur, donne-moi un délai jusqu'au jour où ils seront ressuscités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande à Allah ? Est-ce pour le bien ou pour le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai accordé à Iblis est pour égarer — mon délai doit être pour me guider." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le délai est une opportunité — son usage détermine le résultat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise son délai pour le bien sera sauvé." }
  ],
  munajat: `Ya Rabb, donne-moi un délai que j'utilise pour me rapprocher de Toi. Ne permets pas que je l'utilise pour m'éloigner.`
};

MIROIR["38:80"] = {
  reference: "38:80",
  theme: ["accord", "délai", "décret"],
  emotion: "Permission, décret",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qada'", "Al-Qadar"],
  mirrorVersion: `« Tu es de ceux à qui un délai est accordé. » Le miroir confirme l'accord. Allah accorde le délai demandé. Le décret est prononcé. Le miroir m'enseigne : la demande peut être exaucée, même pour les mauvaises intentions.`,
  reflection: `La demande peut être exaucée, même pour les mauvaises intentions. Le délai est une responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala fa-innaka min al-munzarin » — tu es de ceux à qui un délai est accordé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel délai ai-je reçu ? Comment je l'utilise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai accordé n'est pas une approbation de l'intention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le délai est universel — tous ont un temps limité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délai utilisé pour le bien transforme la malédiction en bénédiction." }
  ],
  munajat: `Ya Rabb, merci pour le délai. Aide-moi à l'utiliser pour me rapprocher de Toi. Ne permets pas que je le gaspille.`
};

MIROIR["38:81"] = {
  reference: "38:81",
  theme: ["terme", "jour", "résurrection"],
  emotion: "Certitude, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mi'ad", "Al-Ba'th"],
  mirrorVersion: `« Jusqu'au jour du temps fixé. » Le miroirfixe le terme. Le jour du temps fixé — la résurrection. Le terme est clair. Le miroir m'enseigne : le temps est limité.`,
  reflection: `Le temps est limité. Le jour du temps fixé approche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila yawmi al-waqt al-ma'lum » — jusqu'au jour du temps fixé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon temps fixé ? Suis-je prêt pour ce jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jour du temps fixé est le même pour tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour du temps fixé est le rendez-vous universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du jourfixé vivifie le présent." }
  ],
  munajat: `Ya Rabb, le jour du temps fixé approche. Prépare-moi pour ce rendez-vous. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["38:82"] = {
  reference: "38:82",
  theme: ["pouvoir", "égarement", "défi"],
  emotion: "Défi, menace",
  difficulty: "avancé",
  relatedNames: ["Al-Qahr", "Ad-Dalal"],
  mirrorVersion: `« Par Ta puissance, je les égarerai tous. » Le miroir montre le défi d'Iblis. Il jure par la puissance d'Allah. Son but : égarer tous les humains. Le miroir m'avertit : l'ennemi est déterminé.`,
  reflection: `L'ennemi est déterminé à m'égarer. Suis-je aussi déterminé à me guider ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala fabi-'izzatika la-ughwiyannahum ajma'in » — par Ta puissance, je les égarerai tous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'ennemi jure par la puissance d'Allah. Est-ce que je jure par Allah de me guider ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance d'Allah peut protéger de l'égarement d'Iblis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le combat entre la guidance et l'égarement est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection d'Allah est plus forte que l'égarement d'Iblis." }
  ],
  munajat: `Ya 'Aziz, protège-moi de l'égarement d'Iblis. Sa détermination est grande, mais Ta protection est plus grande.`
};

MIROIR["38:83"] = {
  reference: "38:83",
  theme: ["exception", "élus", "protection"],
  emotion: "Espoir, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mukhlisin", "Al-Mustafa"],
  mirrorVersion: `« Sauf Tes serviteurs élus parmi eux. » Le miroir montre l'exception. Iblis ne peut pas égarer les élus. Qui sont les élus ? Ceux qui sont sincères. Le miroir m'invite à être parmi les élus.`,
  reflection: `Les élus sont protégés. La sincérité est la clé de cette protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila 'ibadaka minhum al-mukhlasin » — sauf Tes serviteurs élus parmi eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les élus ? Ma sincérité est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité protège de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les élus sont ceux qui ont choisi Allah en premier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sincérité totale est la protection totale." }
  ],
  munajat: `Ya Rabb, je veux être parmi les élus. Donne-moi la sincérité totale. Protège-moi de l'égarement d'Iblis.`
};

MIROIR["38:84"] = {
  reference: "38:84",
  theme: ["vérité", "parole", "certitude"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Qawl"],
  mirrorVersion: `« La vérité est ce que Je dis. » Le miroir affirme : « Fa-al-haqqu wa al-haqqa aqul » — la vérité est ce que Je dis. La parole d'Allah est vérité. Le miroir m'enseigne : la vérité est du côté d'Allah.`,
  reflection: `La parole d'Allah est vérité. Je peux lui faire confiance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-haqqu wa al-haqqa aqul » — la vérité est ce que Je dis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la parole d'Allah ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité d'Allah contraste avec le mensonge d'Iblis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est le fondement de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'accroche à la vérité d'Allah ne peut être égaré." }
  ],
  munajat: `Ya Haqq, Ta parole est vérité. Je m'y accroche. Ne permets pas que je sois séduit par le mensonge.`
};

MIROIR["38:85"] = {
  reference: "38:85",
