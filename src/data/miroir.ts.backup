    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah sauve ceux qui se repentent sincèrement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement est sauvé." }
  ],
  munajat: `Ya Rabb, je me repens sincèrement. Ne permets pas la persistance. Sauve-moi de mon angoisse par mon repentir.`
};

MIROIR["21:89"] = {
  reference: "21:89",
  theme: ["Zacharie", "invocation", "descendance"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Zakariyya", "Ad-Du'a"],
  mirrorVersion: `« Et Zacharie, quand il implora son Seigneur : Seigneur, ne me laisse pas seul ! » Le miroir me montre l'invocation de Zacharie. « Wa Zakariyya idh nada rabbahu rabbi la tadarni wahidan » — Seigneur, ne me laisse pas seul ! « Wa anta khayru al-warithin » — et Tu es le meilleur des héritiers. L'invocation pour la descendance est légitime. Le miroir m'interroge : est-ce que j'invoque pour mes besoins ?`,
  reflection: `Zacharie a invoqué pour la descendance. Invoquer pour ses besoins légitimes est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Zakariyya idh nada rabbahu rabbi la tadarni wahidan wa anta khayru al-warithin » — et Zacharie, quand il implora son Seigneur : Seigneur, ne me laisse pas seul ! Et Tu es le meilleur des héritiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque pour mes besoins ? Ou est-ce que je me tais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation pour les besoins légitimes est exaucée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah répond à toute invocation sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque pour ses besoins reçoit." }
  ],
  munajat: `Ya Rabb, j'invoque pour mes besoins. Ne me laisse pas seul. Exauce mon invocation comme Tu as exaucé celle de Zacharie.`
};

MIROIR["21:90"] = {
  reference: "21:90",
  theme: ["Zacharie", "exaucement", "Jean"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Zakariyya", "Yahya"],
  mirrorVersion: `« Alors Nous l'exauçâmes et lui donnâmes Jean. » Le miroir me montre l'exaucement. « Fa-stajabna lahu wa wahabna lahu Yahya » — Nous l'exauçâmes et lui donnâmes Jean. « Wa aslahna lahu zawjahu » — et Nous réformâmes son épouse. L'exaucement vient avec la bénédiction. Le miroir m'interroge : est-ce que je m'attends à l'exaucement ?`,
  reflection: `L'exaucement vient avec la bénédiction. S'attendre à l'exaucement est la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-stajabna lahu wa wahabna lahu Yahya wa aslahna lahu zawjahu » — Nous l'exauçâmes et lui donnâmes Jean. Et Nous réformâmes son épouse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'attends à l'exaucement ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exaucement est la réponse à l'invocation sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah exauce les invocations des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attend à l'exaucement le reçoit." }
  ],
  munajat: `Ya Rabb, je m'attends à Ton exaucement. Ne permets pas le doute. Exauce mon invocation avec bénédiction.`
};

MIROIR["21:91"] = {
  reference: "21:91",
  theme: ["Marie", "vertu", "miracle"],
  emotion: "Vénération, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Maryam", "Al-Batul"],
  mirrorVersion: `« Et celle qui a préservé sa chasteté. » Le miroir me montre la vertu de Marie. « Wa allati ahsanat farjaha » — et celle qui a préservé sa chasteté. « Fa nafakhna fiha min ruhina » — Nous avons soufflé en elle de Notre Esprit. La chasteté mène au miracle. Le miroir m'interroge : est-ce que je préserve ma chasteté ?`,
  reflection: `Marie a préservé sa chasteté et a reçu le miracle. La chasteté ouvre la porte aux bénédictions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa allati ahsanat farjaha fa nafakhna fiha min ruhina » — et celle qui a préservé sa chasteté. Nous avons soufflé en elle de Notre Esprit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve ma chasteté ? Ou est-ce que je la compromise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La chasteté ouvre la porte aux miracles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vertu de Marie est un modèle pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve sa chasteté reçoit la bénédiction." }
  ],
  munajat: `Ya Rabb, aide-moi à préserver ma chasteté. Ne permets pas la compromission. Bénis-moi par la pureté.`
};

// ============================================
// SURAH 20 (TA-HA) - MISSING ENTRIES
// ============================================

MIROIR["20:9"] = {
  reference: "20:9",
  theme: ["histoire", "musa", "rappel"],
  emotion: "Attention, intérêt",
  difficulty: "débutant",
  relatedNames: ["Al-Qasas", "Musa"],
  mirrorVersion: `« L'histoire de Moïse t'est-elle parvenue ? » Le miroir me montre l'invitation à l'histoire. Les histoires prophétiques sont des enseignements. L'histoire de Moïse est centrale. Le miroir m'interroge : est-ce que j'apprends des histoires prophétiques ?`,
  reflection: `Les histoires du Coran sont des leçons. Chaque prophète enseigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hal ataka hadithu musa » — L'histoire de Moïse t'est-elle parvenue ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends des histoires prophétiques ? Qu'est-ce que Moïse m'enseigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire n'est pas du divertissement — c'est un enseignement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque histoire prophétique contient une guidance universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les histoires trouve des trésors." }
  ],
  munajat: `Ya Qasas, enseigne-moi par les histoires des prophètes. Moïse, sa vie, ses épreuves — que cela me guide. Fais que je ne lise pas sans comprendre.`
};

MIROIR["20:10"] = {
  reference: "20:10",
  theme: ["feu", "vision", "famille"],
  emotion: "Curiosité, espérance",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Huda"],
  mirrorVersion: `« Il vit un feu et dit à sa famille : Restez ici. » Le miroir me montre la recherche de Moïse. Un feu apparaît — c'est l'occasion. La recherche commence par une observation. Le miroir m'interroge : est-ce que je vois les signes autour de moi ?`,
  reflection: `Les signes d'Allah apparaissent comme des feux dans la nuit. Il faut les remarquer et les suivre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iz ra'a naran fa-qala li-ahlihi umkuthu » — Il vit un feu et dit à sa famille : Restez ici." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les signes autour de moi ? Ou est-ce que je passe à côté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu visible peut cacher une lumière plus grande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque signe est une invitation à s'approcher." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le signe trouve la source." }
  ],
  munajat: `Ya Hadi, fais que je voie Tes signes. Quand un feu apparaît, donne-moi le courage de m'approcher. Ne me laisse pas passer à côté de Tes invitations.`
};

MIROIR["20:11"] = {
  reference: "20:11",
  theme: ["approche", "appel", "bénédiction"],
  emotion: "Awe, écoute",
  difficulty: "débutant",
  relatedNames: ["An-Nadi", "Al-Mubarak"],
  mirrorVersion: `« Quand il y arriva, il fut appelé : Moïse ! » Le miroir me montre l'appel divin. L'approche précède l'appel. Moïse s'approche et est nommé. Le miroir m'interroge : est-ce que je m'approche d'Allah pour être appelé ?`,
  reflection: `L'appel d'Allah vient à celui qui s'approche. La proximité attire la parole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ataha nudiya ya musa » — Quand il y arriva, il fut appelé : Moïse !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'approche d'Allah pour être appelé ? Ma démarche est-elle active ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel nomme personnellement — Allah connaît mon nom." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme qui s'approche est appelée par son nom." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'approche est nommé par Allah." }
  ],
  munajat: `Ya Nadi, appelle-moi par mon nom. Je m'approche de Toi. Fais que mon approche soit réelle et que Ton appel soit personnel.`
};

MIROIR["20:12"] = {
  reference: "20:12",
  theme: ["sandales", "sainteté", "vallée"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["An-Na'l", "Al-Muqaddas"],
  mirrorVersion: `« Ôte tes sandales, tu es dans la vallée sacrée. » Le miroir me montre la préparation pour le sacré. Les sandales doivent être ôtées. La vallée est sacrée — la préparation est nécessaire. Le miroir m'interroge : comment me prépare-je pour la rencontre avec Allah ?`,
  reflection: `Le sacré demande une préparation. Ce qui est du monde doit être ôté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ikh'al na'laka innaka bi-al-wadi al-muqaddasi tuwan » — Ôte tes sandales, tu es dans la vallée sacrée de Tuwa." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment me prépare-je pour la rencontre avec Allah ? Qu'est-ce que je dois ôter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le sacré n'est pas une perte de temps — c'est une nécessité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque lieu sacré demande une préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour le sacré Le rencontre." }
  ],
  munajat: `Ya Muqaddas, je me prépare pour Toi. Fais que j'ôte ce qui doit être ôté. Ma préparation doit être réelle pour la rencontre sacrée.`
};

MIROIR["20:13"] = {
  reference: "20:13",
  theme: ["élection", "révélation", "choix"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Mukhtar", "Al-Wahy"],
  mirrorVersion: `« Je t'ai élu. Écoute donc ce qui sera révélé. » Le miroir me montre l'élection et la révélation. L'élection précède la révélation. Être choisi demande à écouter. Le miroir m'interroge : est-ce que j'écoute ce qui m'est révélé ?`,
  reflection: `L'élection divine est un honneur. Elle demande une écoute active.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anatakhtartuka fastami' lima yuha » — Je t'ai élu. Écoute donc ce qui sera révélé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute ce qui m'est révélé ? Mon élection est-elle active ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élection sans écoute est vide — l'écoute sans élection est impossible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque élu est appelé à écouter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute après l'élection accomplit sa mission." }
  ],
  munajat: `Ya Mukhtar, Tu m'as élu. Je veux écouter ce qui est révélé. Fais que mon écoute soit active et que je comprenne ce que Tu me dis.`
};

MIROIR["20:15"] = {
  reference: "20:15",
  theme: ["heure", "résurrection", "secret"],
  emotion: "Vigilance, préparation",
  difficulty: "débutant",
  relatedNames: ["As-Sa'ah", "Al-Ba'ath"],
  mirrorVersion: `« L'Heure approche — Je la cache presque. » Le miroir me montre l'Heure qui approche. Elle est proche mais cachée. Le secret maintient la vigilance. Le miroir m'interroge : est-ce que je vis comme si l'Heure approche ?`,
  reflection: `L'Heure est certaine mais son moment est caché. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-sa'ata atiyatun akadi ukhfiha » — L'Heure approche — Je la cache presque." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si l'Heure approche ? Ma vigilance est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret de l'Heure est une miséricorde — pour maintenir la vigilance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque instant peut être le dernier — l'Heure est toujours proche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en vigilance n'est pas surpris par l'Heure." }
  ],
  munajat: `Ya Sa'ah, Tu approches. Fais que je vive en vigilance. Le secret de Ton moment me garde éveillé. Prépare-moi pour Ta venue.`
};

MIROIR["20:16"] = {
  reference: "20:16",
  theme: ["croyance", "détournement", "perdition"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Ad-Dall"],
  mirrorVersion: `« Que ne t'en détourne pas celui qui n'y croit pas. » Le miroir me montre le danger du détournement. Ceux qui ne croient pas peuvent nous détourner. L'influence est réelle. Le miroir m'interroge : qui m'influence dans ma foi ?`,
  reflection: `Les incroyants peuvent détourner de la vérité. La vigilance dans les fréquentations est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fala yusuddannaka 'anha man la yu'minu biha » — Que ne t'en détourne pas celui qui n'y croit pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui m'influence dans ma foi ? Mes fréquentations renforcent-elles ou affaiblissent-elles ma croyance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement par les incroyants est une ruse subtile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'influence des proches est la plus puissante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit bien ses compagnons protège sa foi." }
  ],
  munajat: `Ya Mu'min, protège ma foi des influences négatives. Fais que je choisisse bien mes compagnons. Ne laisse pas les incroyants me détourner de la vérité.`
};

MIROIR["20:17"] = {
  reference: "20:17",
  theme: ["bâton", "main", "question"],
  emotion: "Curiosité, attention",
  difficulty: "débutant",
  relatedNames: ["Al-'Asa", "Al-Yad"],
  mirrorVersion: `« Qu'est-ce que tu as dans la main droite, Moïse ? » Le miroir me montre la question divine. Allah interroge sur ce que Moïse tient. Le bâton ordinaire devient extraordinaire. Le miroir m'interroge : qu'est-ce que je tiens qui peut devenir extraordinaire ?`,
  reflection: `Ce que nous avons entre les mains peut devenir miracle si Allah le touche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma tilka bi-yaminika ya musa » — Qu'est-ce que tu as dans la main droite, Moïse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je tiens qui peut devenir extraordinaire par la grâce d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordinaire peut devenir miracle par la touche divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque objet a un potentiel caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remet ce qu'il a à Allah le voit transformer." }
  ],
  munajat: `Ya Rabb, je remets ce que j'ai entre mes mains. Transforme mon ordinaire en extraordinaire. Fais que ce que je tiens serve Ta cause.`
};

MIROIR["20:18"] = {
  reference: "20:18",
  theme: ["bâton", "usage", "humble"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-'Asa", "Al-Mun'im"],
  mirrorVersion: `« C'est mon bâton. Je m'appuie dessus. » Le miroir me montre l'humble explication de Moïse. Le bâton a des usages multiples. Il est utile dans la vie quotidienne. Le miroir m'interroge : est-ce que je reconnais l'utilité de ce que j'ai ?`,
  reflection: `Ce que nous avons est utile. Reconnaître son utilité est le premier pas vers la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala hiya 'asaya atawakkau 'alayha » — Il dit : C'est mon bâton. Je m'appuie dessus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'utilité de ce que j'ai ? Ma gratitude est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'utile d'aujourd'hui peut devenir le miracle de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce que nous avons a un usage — reconnaissons-le." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'utilité reçoit l'extraordinaire." }
  ],
  munajat: `Ya Mun'im, je reconnais l'utilité de ce que Tu m'as donné. Fais que je sois reconnaissant pour l'ordinaire. Transforme-le selon Ta volonté.`
};

MIROIR["20:19"] = {
  reference: "20:19",
  theme: ["jet", "transformation", "obéissance"],
  emotion: "Confiance, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Mutahawwil", "Al-Amr"],
  mirrorVersion: `« Jette-le, Moïse ! » Le miroir me montre l'ordre de jeter. Ce qui est utile doit être lâché. Le lâcher précède la transformation. Le miroir m'interroge : qu'est-ce que je dois lâcher pour voir la transformation ?`,
  reflection: `Le lâcher est nécessaire pour la transformation. Ce qu'on tient trop fort ne peut pas changer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala alqiha ya musa » — Jette-le, Moïse !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois lâcher pour voir la transformation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le lâcher n'est pas une perte — c'est une offrande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui est jeté pour Allah peut revenir transformé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui jette pour Allah voit revenir transformé." }
  ],
  munajat: `Ya Rabb, je jette ce que je tiens. Fais que mon lâcher soit total. Transforme ce que je Te remets selon Ta volonté.`
};

MIROIR["20:20"] = {
  reference: "20:20",
  theme: ["serpent", "mouvement", "peur"],
  emotion: "Effroi, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Hayyah", "Al-Mutahawwil"],
  mirrorVersion: `« Il le jeta et voilà un serpent qui rampe. » Le miroir me montre la transformation spectaculaire. Le bâton devient serpent vivant. L'ordinaire devient vivant. Le miroir m'interroge : est-ce que je crois au pouvoir transformateur d'Allah ?`,
  reflection: `Allah transforme l'inanimé en vivant. Son pouvoir est absolu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-alqaha fa-idha hiya hayyatun tas'a » — Il le jeta et voilà un serpent qui rampe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au pouvoir transformateur d'Allah ? Qu'est-ce qu'Il peut transformer dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur du serpent est naturelle — mais c'est Allah qui l'a créé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute transformation est possible par la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la transformation voit des miracles." }
  ],
  munajat: `Ya Mutahawwil, Tu transformes tout. Je Te remets ma vie pour la transformer. Ne me laisse pas craindre le changement — fais que je l'accueille.`
};

MIROIR["20:21"] = {
  reference: "20:21",
  theme: ["retour", "paix", "main"],
  emotion: "Apaisement, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sakinah", "Al-Kaff"],
  mirrorVersion: `« Saisis-le et ne crains pas. » Le miroir me montre l'ordre de reprendre. Ce qui effrayait doit être saisi. La peur disparaît dans l'obéissance. Le miroir m'interroge : qu'est-ce que je crains de saisir ?`,
  reflection: `La peur disparaît quand on obéit à l'ordre divin. Ce qui effrayait devient inoffensif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khudh'ha wa la takhaf » — Saisis-le et ne crains pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains de saisir ? Ma peur disparaîtra-t-elle dans l'obéissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui effrayait redevient ce qu'il était quand on obéit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La peur est souvent une illusion — l'action la dissipe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui saisit ce qu'il craint par ordre divin le maîtrise." }
  ],
  munajat: `Ya Sakinah, apaise ma peur. Je saisis ce que Tu m'ordonnes de saisir. Fais que ma peur disparaisse dans l'obéissance.`
};

MIROIR["20:22"] = {
  reference: "20:22",
  theme: ["main", "aile", "lumière"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Yad", "An-Nur"],
  mirrorVersion: `« Serre ta main sous ton aile. » Le miroir me montre le deuxième miracle. La main devient lumineuse. Le miracle se multiplie. Le miroir m'interroge : est-ce que je reconnais les multiples miracles d'Allah ?`,
  reflection: `Allah multiplie les signes. Chaque miracle en prépare un autre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dammir yadaka ila janahika » — Serre ta main sous ton aile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les multiples miracles d'Allah dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière vient de l'obscurité de l'aile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque miracle a un contexte et une préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les miracles reçoit davantage de signes." }
  ],
  munajat: `Ya Nur, illumine ma main et ma vie. Je reconnais Tes multiples miracles. Fais que je sois un signe de Ta puissance pour les autres.`
};

MIROIR["20:23"] = {
  reference: "20:23",
  theme: ["signes", "grands", "monstration"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Kubra"],
  mirrorVersion: `« Ainsi te montrerons-Nous Nos plus grands signes. » Le miroir me montre la promesse des grands signes. Les miracles ne sont pas finis. Allah montre Ses plus grands signes. Le miroir m'interroge : quels grands signes puis-je espérer voir ?`,
  reflection: `Les signes d'Allah sont innombrables. Les plus grands sont réservés à ceux qui cherchent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-nuriyaka min ayatina al-kubra » — Ainsi te montrerons-Nous Nos plus grands signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels grands signes puis-je espérer voir ? Mon cœur est-il ouvert ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les grands signes sont montrés à ceux qui sont prêts." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes — les plus grands sont pour les chercheurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche les signes les trouve partout." }
  ],
  munajat: `Ya Ayat, montre-moi Tes plus grands signes. Mon cœur est ouvert. Fais que je voie Ta puissance dans ma vie et dans l'univers.`
};

MIROIR["20:24"] = {
  reference: "20:24",
  theme: ["pharaon", "mission", "libération"],
  emotion: "Responsabilité, courage",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "Al-Ba'th"],
  mirrorVersion: `« Va vers Pharaon, il s'est rebellé. » Le miroir me montre la mission spécifique. Moïse est envoyé vers le tyran. La mission est dangereuse mais nécessaire. Le miroir m'interroge : vers qui suis-je envoyé ?`,
  reflection: `Chaque prophète a une mission. La nôtre est peut-être moins spectaculaire mais tout aussi réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idhhab ila fir'awna innahu tagha » — Va vers Pharaon, il s'est rebellé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers qui suis-je envoyé ? Quelle est ma mission dans ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mission vers le tyran est la plus difficile — et la plus nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque époque a ses tyrans — chaque croyant a sa mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa mission reçoit le soutien divin." }
  ],
  munajat: `Ya Ba'th, envoie-moi vers ceux qui ont besoin de moi. Donne-moi le courage de ma mission. Ne me laisse pas reculer devant la difficulté.`
};

MIROIR["20:25"] = {
  reference: "20:25",
  theme: ["poitrine", "ouverture", "facilitation"],
  emotion: "Supplication, confiance",
  difficulty: "débutant",
  relatedNames: ["Ash-Sharh", "Al-Yasir"],
  mirrorVersion: `« Seigneur, ouvre ma poitrine. » Le miroir me montre la prière de Moïse. Il demande l'ouverture avant la mission. La poitrine ouverte est nécessaire pour la tâche. Le miroir m'interroge : est-ce que je demande l'ouverture avant d'agir ?`,
  reflection: `L'ouverture de la poitrine précède la grande œuvre. La préparation intérieure est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbi ishrah li sadri » — Il dit : Seigneur, ouvre ma poitrine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande l'ouverture avant d'agir ? Ma préparation intérieure est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poitrine fermée ne peut pas accueillir la grande mission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque grand œuvre demande une grande ouverture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande l'ouverture la reçoit." }
  ],
  munajat: `Ya Sharh, ouvre ma poitrine. Je ne peux pas accomplir ma mission sans Ton ouverture. Prépare mon cœur pour ce qui vient.`
};

MIROIR["20:26"] = {
  reference: "20:26",
  theme: ["facilitation", "tâche", "aide"],
  emotion: "Supplication, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Taysir", "Al-Mu'in"],
  mirrorVersion: `« Et facilite ma tâche. » Le miroir me montre la demande de facilitation. La tâche est difficile — Moïse demande la facilitation. L'aide divine est nécessaire. Le miroir m'interroge : est-ce que je demande la facilitation pour mes tâches ?`,
  reflection: `La facilitation est un don d'Allah. La demander est un acte de confiance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yassir li amri » — Et facilite ma tâche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la facilitation pour mes tâches ? Ma confiance est-elle totale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La difficulté sans facilitation est accablante — la facilitation change tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute tâche peut être facilitée par la grâce d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la facilitation la reçoit." }
  ],
  munajat: `Ya Taysir, facilite ma tâche. Je ne peux pas y arriver seul. Ta facilitation est ma seule chance de réussir.`
};

MIROIR["20:27"] = {
  reference: "20:27",
  theme: ["langue", "nœud", "compréhension"],
  emotion: "Honnêteté, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Lisan", "Al-Fath"],
  mirrorVersion: `« Délie un nœud de ma langue. » Le miroir me montre la reconnaissance de la limitation. Moïse a une difficulté d'élocution. Il demande la délivrance. Le miroir m'interroge : qu'est-ce qui me limite et que je dois demander de délier ?`,
  reflection: `La reconnaissance de nos limitations est le premier pas vers la guérison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uhlul 'uqdatan min lisani » — Délie un nœud de ma langue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me limite ? Qu'est-ce que je dois demander de délier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le nœud est une limitation — la délivrance est possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque personne a des nœuds à délier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ses nœuds et les remet à Allah est délié." }
  ],
  munajat: `Ya Fattah, délie les nœuds qui me limitent. Je reconnais mes limitations. Délivre-moi pour que je puisse accomplir ma mission.`
};

MIROIR["20:28"] = {
  reference: "20:28",
  theme: ["compréhension", "parole", "écoute"],
  emotion: "Humilité, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Fahm", "As-Sam"],
  mirrorVersion: `« Afin qu'ils comprennent ma parole. » Le miroir me montre le but de la demande. La délivrance n'est pas pour soi — c'est pour les autres. Ils doivent comprendre. Le miroir m'interroge : est-ce que je pense à ceux qui doivent m'entendre ?`,
  reflection: `La demande de délivrance a un but : la communication avec les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yafqahu qawli » — Afin qu'ils comprennent ma parole." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense à ceux qui doivent m'entendre ? Ma communication est-elle claire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La délivrance personnelle sert la mission collective." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communication claire est un don précieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche à être compris pour la bonne cause est exaucé." }
  ],
  munajat: `Ya Fahm, fais que je sois compris. Ma communication doit être claire pour ceux qui m'écoutent. Aide-moi à me faire comprendre.`
};

MIROIR["20:29"] = {
  reference: "20:29",
  theme: ["ministre", "famille", "soutien"],
  emotion: "Confiance, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Wazir", "Al-Ahl"],
  mirrorVersion: `« Donne-moi un assistant de ma famille. » Le miroir me montre la demande de soutien. La mission est trop grande pour un seul. L'assistant de la famille est le meilleur. Le miroir m'interroge : qui est mon soutien ?`,
  reflection: `La mission demande du soutien. La famille peut être le meilleur soutien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waj'al li waziran min ahli » — Donne-moi un assistant de ma famille." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon soutien ? Est-ce que je demande de l'aide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'assistant est un don — pas un droit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque grande mission a besoin de soutien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande du soutien pour la bonne cause le reçoit." }
  ],
  munajat: `Ya Rabb, donne-moi des assistants pour ma mission. Ma famille peut être mon soutien. Fais que je ne sois pas seul dans ce que Tu m'appelles à faire.`
};

MIROIR["20:30"] = {
  reference: "20:30",
  theme: ["harun", "frère", "partage"],
  emotion: "Amour, fraternité",
  difficulty: "débutant",
  relatedNames: ["Harun", "Al-Akh"],
  mirrorVersion: `« Aaron, mon frère. » Le miroir me montre le choix spécifique. Moïse nomme son frère Aaron. Le frère est le meilleur assistant. Le miroir m'interroge : qui choisirais-je comme assistant ?`,
  reflection: `Le choix de l'assistant est important. Le frère peut être le meilleur choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Haruna akhi » — Aaron, mon frère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui choisirais-je comme assistant ? Mon choix est-il guidé par la confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le frère est souvent celui qui comprend le mieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fraternité dans la mission est un don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a un bon assistant accomplit davantage." }
  ],
  munajat: `Ya Rabb, fais que j'aie des frères dans la mission. La fraternité renforce l'œuvre. Donne-moi des compagnons de confiance.`
};

MIROIR["20:31"] = {
  reference: "20:31",
  theme: ["force", "dos", "association"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Quwwah", "Az-Zahr"],
  mirrorVersion: `« Fortifie mon dos par lui. » Le miroir me montre le renforcement mutuel. L'assistant fortifie le dos. La force partagée est plus grande. Le miroir m'interroge : est-ce que je partage mes forces avec d'autres ?`,
  reflection: `Le renforcement mutuel est la clé de la réussite collective.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iuz-zad bihi azri » — Fortifie mon dos par lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je partage mes forces avec d'autres ? Qui me fortifie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force partagée n'est pas divisée — elle est multipliée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'union fait la force — c'est une loi universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fortifie et est fortifié accomplit plus." }
  ],
  munajat: `Ya Quwwah, fortifie-moi par mes frères. La force partagée est plus grande. Fais que je sois une force pour les autres et qu'ils soient une force pour moi.`
};

MIROIR["20:32"] = {
  reference: "20:32",
  theme: ["association", "affaire", "partage"],
  emotion: "Confiance, unité",
  difficulty: "débutant",
  relatedNames: ["Ash-Sharikah", "Al-Amr"],
  mirrorVersion: `« Et associe-le à mon affaire. » Le miroir me montre l'association dans l'œuvre. L'affaire de Moïse devient aussi celle d'Aaron. Le partage de la responsabilité. Le miroir m'interroge : est-ce que j'associe d'autres à mon œuvre ?`,
  reflection: `L'association dans l'œuvre est un acte de confiance et d'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ashrikhu fi amri » — Et associe-le à mon affaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'associe d'autres à mon œuvre ? Ou est-ce que je garde tout pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'association n'est pas une perte de contrôle — c'est un partage de responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les grandes œuvres sont toujours collectives." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage son œuvre la voit grandir." }
  ],
  munajat: `Ya Rabb, fais que je partage mon œuvre. L'association est un acte de confiance. Donne-moi des compagnons avec qui partager la responsabilité.`
};

MIROIR["20:33"] = {
  reference: "20:33",
  theme: ["glorification", "souvenir", "multiplication"],
  emotion: "Dévotion, unité",
  difficulty: "débutant",
  relatedNames: ["At-Tasbih", "Adh-Dhikr"],
  mirrorVersion: `« Afin que nous T'glorifions beaucoup. » Le miroir me montre le but de l'association. La glorification d'Allah. Le souvenir multiplié. Le miroir m'interroge : quel est le but de mes associations ?`,
  reflection: `Le but ultime de toute association devrait être la glorification d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla nusabbihaka kathiran » — Afin que nous T'glorifions beaucoup." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le but de mes associations ? Est-ce pour Te glorifier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification collective est plus puissante que la solitaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière glorifie Allah — l'homme s'y joint." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah en communauté reçoit plus de lumière." }
  ],
  munajat: `Ya Musabbih, nous Te glorifions ensemble. Fais que nos associations soient pour Ta gloire. Multiplie notre souvenir de Toi.`
};

MIROIR["21:92"] = {
  reference: "21:92",
  theme: ["communauté", "unicité", "religion"],
  emotion: "Unité, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Ummah", "Al-Wahid"],
  mirrorVersion: `« Certes, cette communauté est la vôtre, une seule communauté. » Le miroir me montre l'unité de la communauté. « Inna hadhihi ummatukum ummatan wahidatan » — certes, cette communauté est la vôtre, une seule communauté. « Wa ana rabbukum fa'budun » — et Je suis votre Seigneur, adorez-Moi. L'unité dans l'adoration est essentielle. Le miroir m'interroge : est-ce que je participe à cette unité ?`,
  reflection: `La communauté des croyants est une. L'unité dans l'adoration d'Allah est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadhihi ummatukum ummatan wahidatan wa ana rabbukum fa'budun » — certes, cette communauté est la vôtre, une seule communauté. Et Je suis votre Seigneur, adorez-Moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe à cette unité ? Ou est-ce que je me divise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division affaiblit. L'unité renforce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unité des croyants reflète l'unicité d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui participe à l'unité est fort." }
  ],
  munajat: `Ya Wahid, fais que je participe à l'unité. Ne permets pas la division. Rassemble-moi avec les croyants.`
};

MIROIR["21:93"] = {
  reference: "21:93",
  theme: ["division", "retour", "jugement"],
  emotion: "Vigilance, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Firaq", "Al-Hisab"],
  mirrorVersion: `« Mais ils se sont divisés entre eux en sectes. » Le miroir me montre la division humaine. « Wa taqatta'u amrahum baynahum » — ils se sont divisés entre eux en sectes. « Kullun ilayna raji'un » — tous reviendront vers Nous. La division sera jugée. Le miroir m'interroge : est-ce que je participe à la division ou à l'unité ?`,
  reflection: `La division sera jugée. Choisir l'unité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa taqatta'u amrahum baynahum kullun ilayna raji'un » — mais ils se sont divisés entre eux en sectes. Tous reviendront vers Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe à la division ? Ou est-ce que je travaille pour l'unité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division mène au jugement. L'unité mène à la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous retourneront à Allah pour être jugés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour l'unité est récompensé." }
  ],
  munajat: `Ya Rabb, je travaille pour l'unité. Ne permets pas la division. Rassemble-moi avec les unis.`
};

MIROIR["21:94"] = {
  reference: "21:94",
  theme: ["œuvres", "foi", "récompense"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-A'mal", "Al-Iman"],
  mirrorVersion: `« Quiconque fait de bonnes œuvres tout en étant croyant. » Le miroir me montre le critère de la récompense. « Faman ya'mal mina al-salihati wa huwa mu'min » — quiconque fait de bonnes œuvres tout en étant croyant. « Fala kufrana li-sa'yihi » — il n'y aura pas de déni de son effort. La foi plus les œuvres égalent la récompense. Le miroir m'interroge : est-ce que je combine foi et œuvres ?`,
  reflection: `La foi sans œuvres est incomplète. Combiner foi et bonnes œuvres est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faman ya'mal mina al-salihati wa huwa mu'min fala kufrana li-sa'yihi » — quiconque fait de bonnes œuvres tout en étant croyant, il n'y aura pas de déni de son effort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je combine foi et œuvres ? Ou est-ce que je néglige l'un ou l'autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans œuvres est morte. Les œuvres sans foi sont vaines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah récompense la combinaison de foi et d'œuvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combine foi et œuvres est pleinement récompensé." }
  ],
  munajat: `Ya Rabb, aide-moi à combiner foi et œuvres. Ne permets pas la négligence. Accepte mon effort et récompense-le.`
};

MIROIR["21:95"] = {
  reference: "21:95",
  theme: ["interdiction", "nations", "retour"],
  emotion: "Réalité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Haram", "Al-Qaryah"],
  mirrorVersion: `« Et il est interdit à une cité que Nous avons fait périr. » Le miroir me montre l'interdiction du retour. « Wa haramun 'ala qaryatin ahlaknaha » — il est interdit à une cité que Nous avons fait périr. « Annahum la yarji'un » — qu'ils ne retourneront pas. La destruction est définitive. Le miroir m'interroge : est-ce que je tire les leçons de l'histoire ?`,
  reflection: `Les nations détruites ne reviennent pas. Tirer les leçons de l'histoire est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa haramun 'ala qaryatin ahlaknaha annahum la yarji'un » — il est interdit à une cité que Nous avons fait périr qu'ils ne retourneront pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tire les leçons de l'histoire ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un enseignement pour le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La destruction des nations est un avertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire les leçons de l'histoire évite le même sort." }
  ],
  munajat: `Ya Rabb, aide-moi à tirer les leçons de l'histoire. Ne permets pas l'aveuglement. Protège-moi du sort des mécréants.`
};

MIROIR["21:96"] = {
  reference: "21:96",
  theme: ["Gog", "Magog", "fin"],
  emotion: "Vigilance, préparation",
  difficulty: "débutant",
  relatedNames: ["Ya'juj", "Ma'juj"],
  mirrorVersion: `« Quand seront ouvertes les portes de Gog et Magog. » Le miroir me montre le signe de la fin. « Hatta idha futihat Ya'juj wa Ma'juj » — quand seront ouvertes les portes de Gog et Magog. « Wa hum min kulli hadabin yansilun » — et qu'ils déferleront de toute hauteur. Les signes de la fin viendront. Le miroir m'interroge : est-ce que je suis prêt ?`,
  reflection: `Les signes de la fin viendront. Être prêt pour ce jour est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta idha futihat Ya'juj wa Ma'juj wa hum min kulli hadabin yansilun » — quand seront ouvertes les portes de Gog et Magog, et qu'ils déferleront de toute hauteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt ? Ou est-ce que je suis distrait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes de la fin sont proches." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fin du monde fait partie du plan divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt n'est pas effrayé par les signes." }
  ],
  munajat: `Ya Rabb, je suis prêt pour les signes de la fin. Ne permets pas la distraction. Prépare-moi pour Ta rencontre.`
};

MIROIR["21:97"] = {
  reference: "21:97",
  theme: ["promesse", "vérité", "regard"],
  emotion: "Réalité, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Haqq"],
  mirrorVersion: `« Et la vraie promesse approche. » Le miroir me montre l'imminence de la vérité. « Waqtaraba al-wa'du al-haqqu » — et la vraie promesse approche. « Fa idha hiya shakhisatun absaru alladhina kafaru » — alors les regards de ceux qui ont mécru se figeront. La vérité sera terrifiante pour les mécréants. Le miroir m'interroge : est-ce que je serai parmi ceux dont le regard se fige ?`,
  reflection: `La promesse approche. Les mécréants seront terrifiés. Être parmi les croyants est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waqtaraba al-wa'du al-haqqu fa idha hiya shakhisatun absaru alladhina kafaru » — et la vraie promesse approche. Alors les regards de ceux qui ont mécru se figeront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi les croyants ? Ou parmi ceux dont le regard se fige ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La vérité est terrifiante pour les mécréants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est vraie et approche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit n'a pas peur de la promesse." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les croyants. Ne permets pas la mécréance. Prépare-moi pour la promesse qui approche.`
};

MIROIR["21:98"] = {
  reference: "21:98",
  theme: ["enfer", "carburant", "avertissement"],
  emotion: "Effroi, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Jahannam", "Al-Waqud"],
  mirrorVersion: `« Vous serez, vous et ce que vous adorez en dehors d'Allah, le combustible de l'Enfer. » Le miroir me montre le sort des idolâtres. « Innakum wa ma ta'buduna min duni Allahi hasabu jahannam » — vous serez, vous et ce que vous adorez en dehors d'Allah, le combustible de l'Enfer. Les idoles ne protègent pas. Le miroir m'interroge : qu'est-ce que j'adore en dehors d'Allah ?`,
  reflection: `Les idoles deviennent le combustible de l'Enfer. Adorer Allah seul protège du feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innakum wa ma ta'buduna min duni Allahi hasabu jahannam » — vous serez, vous et ce que vous adorez en dehors d'Allah, le combustible de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore en dehors d'Allah ? Suis-je prêt à en être le combustible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles ne protègent pas, elles mènent au feu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer attend les idolâtres et leurs idoles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'adore qu'Allah n'est pas combustible pour l'Enfer." }
  ],
  munajat: `Ya Rabb, je n'adore que Toi. Ne permets pas l'idolâtrie. Épargne-moi du feu par mon adoration exclusive.`
};

MIROIR["21:99"] = {
  reference: "21:99",
  theme: ["divinités", "éternité", "adoration"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Ilah", "Al-Khuld"],
  mirrorVersion: `« Si ceux-là étaient des divinités, ils n'y entreraient pas. » Le miroir me montre la preuve de la fausseté des idoles. « Law kana ha'ula'i alihatan ma waraduha » — si ceux-là étaient des divinités, ils n'y entreraient pas. « Wa kullun fiha khalidun » — et tous y demeureront éternellement. L'Enfer est éternel pour ses habitants. Le miroir m'interroge : est-ce que je comprends la fausseté des idoles ?`,
  reflection: `Les idoles ne peuvent pas se protéger du feu. Elles ne sont donc pas des divinités.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kana ha'ula'i alihatan ma waraduha wa kullun fiha khalidun » — si ceux-là étaient des divinités, ils n'y entreraient pas. Et tous y demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la fausseté des idoles ? Ou est-ce que je persiste dans l'illusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles ne peuvent même pas se protéger du feu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est éternel pour ses habitants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la fausseté des idoles les abandonne." }
  ],
  munajat: `Ya Rabb, je comprends la fausseté des idoles. Ne permets pas l'illusion. Guide-moi vers l'adoration exclusive.`
};

MIROIR["21:100"] = {
  reference: "21:100",
  theme: ["enfer", "gémissement", "éternité"],
  emotion: "Effroi, avertissement",
  difficulty: "débutant",
  relatedNames: ["Jahannam", "Al-Hazin"],
  mirrorVersion: `« Là, ils auront des sanglots et ils n'y entendront rien. » Le miroir me montre le châtiment auditif. « Lahum fiha zafirun wa hum fiha la yasma'un » — là, ils auront des sanglots et ils n'y entendront rien. Le châtiment est aussi auditif. Le miroir m'interroge : est-ce que j'évite ce châtiment ?`,
  reflection: `Le châtiment de l'Enfer est total : physique, auditif, émotionnel. L'éviter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum fiha zafirun wa hum fiha la yasma'un » — là, ils auront des sanglots et ils n'y entendront rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite ce châtiment ? Ou est-ce que je m'y dirige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment de l'Enfer est total." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est un châtiment complet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite ce châtiment par la foi est sauvé." }
  ],
  munajat: `Ya Rabb, j'évite ce châtiment par la foi. Ne permets pas que je m'y dirige. Sauve-moi de l'Enfer.`
};

MIROIR["21:101"] = {
  reference: "21:101",
  theme: ["promesse", "paradis", "exception"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'd"],
  mirrorVersion: `« Ceux pour qui Notre déclaration s'est précédemment avérée seront éloignés de l'Enfer. » Le miroir me montre l'exception bénie. « Inna alladhina sabaqat lahum mina al-husna » — ceux pour qui Notre déclaration s'est précédemment avérée. « Ula'ika 'anha mub'adun » — ceux-là seront éloignés de l'Enfer. La promesse d'Allah est certaine. Le miroir m'interroge : est-ce que je suis parmi ces élus ?`,
  reflection: `Les élus d'Allah sont éloignés de l'Enfer. Être parmi eux est le plus grand espoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina sabaqat lahum mina al-husna ula'ika 'anha mub'adun » — ceux pour qui Notre déclaration s'est précédemment avérée seront éloignés de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les élus ? Ou est-ce que je suis en danger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse d'Allah pour les élus est certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les élus d'Allah sont protégés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère être parmi les élus travaille pour l'être." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les élus. Ne permets pas le rejet. Éloigne-moi de l'Enfer par Ta promesse.`
};

MIROIR["21:102"] = {
  reference: "21:102",
  theme: ["paradis", "pas", "voix"],
  emotion: "Espérance, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "An-Na'im"],
  mirrorVersion: `« Ils n'entendront pas son souffle. » Le miroir me montre la paix du paradis. « La yasma'una hashasaha » — ils n'entendront pas son souffle. « Wa hum fi ma tashtahi anfusuhum khalidun » — et ils demeureront éternellement dans ce que leurs âmes désirent. Le paradis est paisible. Le miroir m'interroge : est-ce que j'aspire à cette paix ?`,
  reflection: `Le paradis est paisible et éternel. Y aspirer et travailler pour y entrer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yasma'una hashashaha wa hum fi ma tashtahi anfusuhum khalidun » — ils n'entendront pas son souffle. Et ils demeureront éternellement dans ce que leurs âmes désirent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à cette paix ? Ou est-ce que je m'en moque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix du paradis contraste avec le bruit de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis est la récompense des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aspire à la paix du paradis y entre." }
  ],
  munajat: `Ya Rabb, j'aspire à la paix du paradis. Ne permets pas l'indifférence. Accorde-moi le paradis éternel.`
};

MIROIR["21:103"] = {
  reference: "21:103",
  theme: ["effroi", "protection", "sécurité"],
  emotion: "Sécurité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Aman", "Al-Faza'"],
  mirrorVersion: `« Le grand effroi ne les affligera pas. » Le miroir me montre la sécurité des élus. « La yahzunuhumu al-faza'u al-akbaru » — le grand effroi ne les affligera pas. « Wa tatalaqqahumu al-mala'ikatu » — et les anges les accueilleront. La sécurité est totale. Le miroir m'interroge : est-ce que je serai parmi les sécurisés ?`,
  reflection: `Le grand effroi n'atteint pas les élus. Être parmi eux est la plus grande sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yahzunuhumu al-faza'u al-akbaru wa tatalaqqahumu al-mala'ikatu » — le grand effroi ne les affligera pas. Et les anges les accueilleront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi les sécurisés ? Ou est-ce que je serai effrayé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sécurité des élus contraste avec l'effroi des autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le grand effroi touchera tous les hommes sauf les élus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sécurisé par Allah n'a peur de rien." }
  ],
  munajat: `Ya Rabb, sécurise-moi contre le grand effroi. Ne permets pas la peur. Accueille-moi avec Tes anges.`
};

MIROIR["21:104"] = {
  reference: "21:104",
  theme: ["ciel", "enroulement", "création"],
  emotion: "Humilité, émerveillement",
  difficulty: "débutant",
  relatedNames: ["As-Sama'", "Al-Khalq"],
  mirrorVersion: `« Le Jour où Nous enroulerons le ciel comme on enroule un livre. » Le miroir me montre la fin de l'univers. « Yawma natwi al-sama'a ka-tayyi al-sijilli lil-kutub » — le Jour où Nous enroulerons le ciel comme on enroule un livre. « Kama bada'ana awwala khalqin nu'iduhu » — comme Nous avons commencé la première création, Nous la répéterons. La création a une fin. Le miroir m'interroge : est-ce que je suis prêt pour cette fin ?`,
  reflection: `L'univers sera enroulé comme un livre. Être prêt pour cette fin est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma natwi al-sama'a ka-tayyi al-sijilli lil-kutub kama bada'ana awwala khalqin nu'iduhu » — le Jour où Nous enroulerons le ciel comme on enroule un livre. Comme Nous avons commencé la première création, Nous la répéterons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour cette fin ? Ou est-ce que je suis distrait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fin de l'univers est aussi certaine que son début." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a un début et une fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour la fin la rencontre en paix." }
  ],
  munajat: `Ya Rabb, je suis prêt pour la fin. Ne permets pas la distraction. Prépare-moi pour le Jour où Tu enrouleras le ciel.`
};

MIROIR["21:105"] = {
  reference: "21:105",
  theme: ["terre", "héritage", "droit"],
  emotion: "Espérance, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Warith"],
  mirrorVersion: `« Et Nous avons écrit dans les Psaumes après le Rappel, que la terre sera héritée par Mes serviteurs vertueux. » Le miroir me montre la promesse de l'héritage. « Wa laqad katabna fi al-zaburi min ba'di al-dhikri » — Nous avons écrit dans les Psaumes après le Rappel. « Anna al-arda yarithuha 'ibadiya al-salihun » — que la terre sera héritée par Mes serviteurs vertueux. La promesse est écrite. Le miroir m'interroge : est-ce que je suis parmi les vertueux ?`,
  reflection: `La terre sera héritée par les vertueux. Être parmi eux est essentiel pour recevoir l'héritage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad katabna fi al-zaburi min ba'di al-dhikri anna al-arda yarithuha 'ibadiya al-salihun » — Nous avons écrit dans les Psaumes après le Rappel, que la terre sera héritée par Mes serviteurs vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les vertueux ? Ou est-ce que je m'éloigne de la vertu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage de la terre est promis aux vertueux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un héritage promis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vertueux hérite la terre." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les vertueux. Ne permets pas l'éloignement. Fais-moi hériter la terre promise.`
};

MIROIR["21:106"] = {
  reference: "21:106",
  theme: ["message", "adoration", "communauté"],
  emotion: "Joie, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Risalah", "Al-'Ibadah"],
  mirrorVersion: `« Il y a là un message pour un peuple qui adore. » Le miroir me montre la destination du message. « Inna fi hadha la-balaghan li-qawmin 'abidin » — il y a là un message pour un peuple qui adore. Le message est pour ceux qui adorent. Le miroir m'interroge : est-ce que j'adore ?`,
  reflection: `Le message est pour ceux qui adorent. Adorer Allah est essentiel pour recevoir le message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fi hadha la-balaghan li-qawmin 'abidin » — il y a là un message pour un peuple qui adore." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore ? Ou est-ce que je néglige l'adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le message n'est utile que pour ceux qui adorent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration est le but de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore reçoit le message pleinement." }
  ],
  munajat: `Ya Rabb, j'adore et je reçois Ton message. Ne permets pas la négligence. Fais que je sois du peuple qui adore.`
};

MIROIR["21:108"] = {
  reference: "21:108",
  theme: ["révélation", "unicité", "avertissement"],
  emotion: "Clarté, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Wahid"],
  mirrorVersion: `« Dis : il m'a été révélé que votre Dieu est un Dieu unique. » Le miroir me montre le cœur du message. « Qul innama yuha ilayya annama ilahukum ilahun wahid » — il m'a été révélé que votre Dieu est un Dieu unique. « Fa hal antum muslimun » — êtes-vous soumis ? L'unicité exige la soumission. Le miroir m'interroge : est-ce que je suis soumis à l'unicité ?`,
  reflection: `Le message est simple : Allah est unique. Être soumis à cette vérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama yuha ilayya annama ilahukum ilahun wahid fa hal antum muslimun » — dis : il m'a été révélé que votre Dieu est un Dieu unique. Êtes-vous soumis ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis soumis à l'unicité ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unicité d'Allah exige la soumission totale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est la vérité de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet à l'unicité trouve la paix." }
  ],
  munajat: `Ya Wahid, je me soumet à Ton unicité. Ne permets pas la résistance. Fais que je sois parmi les soumis.`
};

MIROIR["21:109"] = {
  reference: "21:109",
  theme: ["détournement", "avertissement", "transmission"],
  emotion: "Responsabilité, détachement",
  difficulty: "débutant",
  relatedNames: ["Al-Tawalli", "Al-Inzar"],
  mirrorVersion: `« S'ils se détournent, dis : je vous ai avertis équitablement. » Le miroir me montre la fin de la mission. « Fa in tawallaw fa qul adhantukum 'ala sawa'in » — s'ils se détournent, dis : je vous ai avertis équitablement. « Wa la a'dri aqaribun am ba'idun maw'idukum » — je ne sais pas si ce qui vous est promis est proche ou lointain. L'avertissement est accompli. Le miroir m'interroge : est-ce que j'accomplis mon devoir d'avertissement ?`,
  reflection: `Le prophète a accompli son devoir. Accomplir notre devoir est essentiel, le résultat appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa in tawallaw fa qul adhantukum 'ala sawa'in wa la a'dri aqaribun am ba'idun maw'idukum » — s'ils se détournent, dis : je vous ai avertis équitablement. Je ne sais pas si ce qui vous est promis est proche ou lointain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accomplis mon devoir d'avertissement ? Ou est-ce que je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le devoir accompli suffit. Le résultat appartient à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est le devoir du prophète et du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accomplit son devoir est justifié." }
  ],
  munajat: `Ya Rabb, j'accomplis mon devoir d'avertissement. Ne permets pas la négligence. Justifie-moi par l'accomplissement de ma mission.`
};

MIROIR["21:110"] = {
  reference: "21:110",
  theme: ["connaissance", "secret", "public"],
  emotion: "Transparence, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Sirr"],
  mirrorVersion: `« Certes, Il sait ce que vous dites haut et ce que vous cachez. » Le miroir me montre la connaissance divine totale. « Innahu ya'lamu al-jahra mina al-qawli » — Il sait ce que vous dites haut. « Wa ya'lamu ma tektumun » — et Il sait ce que vous cachez. Rien n'est caché à Allah. Le miroir m'interroge : est-ce que je suis conscient que Allah sait tout ?`,
  reflection: `Allah connaît tout, le public et le secret. Être conscient de cette connaissance est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu ya'lamu al-jahra mina al-qawli wa ya'lamu ma tektumun » — certes, Il sait ce que vous dites haut et ce que vous cachez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient qu'Allah sait tout ? Ou est-ce que je cache des choses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Rien n'est caché à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance divine est totale et parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est conscient de la connaissance divine ne cache rien." }
  ],
  munajat: `Ya 'Alim, je suis conscient que Tu sais tout. Ne permets pas l'hypocrisie. Purifie-moi de ce que je cache.`
};

MIROIR["21:111"] = {
  reference: "21:111",
  theme: ["épreuve", "ignorance", "patience"],
  emotion: "Humilité, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Fitnah", "Al-Jahl"],
  mirrorVersion: `« Et je ne sais pas si ce n'est peut-être une épreuve pour vous. » Le miroir me montre l'incertitude du prophète. « Wa la a'dri la'allahu fitnatun lakum » — je ne sais pas si ce n'est peut-être une épreuve pour vous. « Wa mata'un ila hin » — et une jouissance temporaire. L'épreuve peut prendre des formes. Le miroir m'interroge : est-ce que je vois les épreuves dans ma vie ?`,
  reflection: `L'épreuve peut être un test ou une jouissance temporaire. Discerner est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la a'dri la'allahu fitnatun lakum wa mata'un ila hin » — je ne sais pas si ce n'est peut-être une épreuve pour vous et une jouissance temporaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les épreuves dans ma vie ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve peut être un test ou une tentation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve fait partie du plan divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui discerne l'épreuve la traverse avec succès." }
  ],
  munajat: `Ya Rabb, aide-moi à discerner les épreuves. Ne permets pas l'aveuglement. Fais que je les traverse avec succès.`
};

MIROIR["21:112"] = {
  reference: "21:112",
  theme: [" invocation", "jugement", "victoire"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Ad-Du'a", "Al-Qada'"],
  mirrorVersion: `« Dis : Seigneur, juge avec vérité ! » Le miroir me montre l'invocation finale. « Qul rabbi ahkum bi-al-haqq » — dis : Seigneur, juge avec vérité ! « Wa rabbuna al-rahman al-must'a'an 'ala ma tasifun » — et notre Seigneur est le Tout-Miséricordieux, dont on cherche l'aide contre ce que vous décrivez. L'invocation est le refuge. Le miroir m'interroge : est-ce que je cherche refuge en Allah ?`,
  reflection: `L'invocation est le refuge contre les descriptions mensongères. Chercher refuge en Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul rabbi ahkum bi-al-haqq wa rabbuna al-rahman al-must'a'an 'ala ma tasifun » — dis : Seigneur, juge avec vérité ! Et notre Seigneur est le Tout-Miséricordieux, dont on cherche l'aide contre ce que vous décrivez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche refuge en Allah ? Ou est-ce que je fais face seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est le refuge contre les mensonges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah est la vérité finale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge en Allah est protégé." }
  ],
  munajat: `Ya Rahman, je cherche refuge en Toi. Juge avec vérité entre moi et ceux qui me décrivent faussement. Protège-moi par Ta miséricorde.`
};

MIROIR["20:34"] = {
  reference: "20:34",
  theme: ["souvenir", "beaucoup", "priorité"],
  emotion: "Dévotion, constance",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikr", "Al-Kathir"],
  mirrorVersion: `« Et nous nous souvenons de Toi beaucoup. » Le miroir me montre la priorité du souvenir. Le dhikr est constant. Beaucoup de souvenir — pas peu. Le miroir m'interroge : combien de fois par jour je me souviens d'Allah ?`,
  reflection: `Le dhikr est la nourriture de l'âme. Sans lui, l'âme s'affame.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nadhkuraka kathiran » — Et nous nous souvenons de Toi beaucoup." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de fois par jour je me souviens d'Allah ? Mon dhikr est-il constant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le peu de dhikr maintient la faim — le beaucoup nourrit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose se souvient d'Allah à sa manière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient beaucoup d'Allah est toujours présent." }
  ],
  munajat: `Ya Dhikr, fais que je me souvienne de Toi beaucoup. Mon dhikr doit être constant. Ne me laisse pas oublier — le souvenir est ma nourriture.`
};

MIROIR["20:35"] = {
  reference: "20:35",
  theme: ["regard", "vision", "espérance"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nazar", "Ar-Ra'ya"],
  mirrorVersion: `« Certes, Tu nous vois. » Le miroir me montre la conscience de la vision divine. Allah nous voit toujours. Cette conscience transforme l'action. Le miroir m'interroge : est-ce que je vis en sachant qu'Allah me voit ?`,
  reflection: `La conscience de la vision divine (muraqabah) est le fondement de la spiritualité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka kunta bina basiran » — Certes, Tu nous vois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant qu'Allah me voit ? Ma conscience est-elle éveillée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sa vue n'est pas une surveillance — c'est une compagnie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'échappe à Sa vision — tout est vu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est vu se comporte avec dignité." }
  ],
  munajat: `Ya Basir, Tu me vois toujours. Fais que je vive dans cette conscience. Ta vision est ma compagnie et mon guide.`
};

MIROIR["20:36"] = {
  reference: "20:36",
  theme: ["exaucement", "don", "accord"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Mu'ti"],
  mirrorVersion: `« Ta demande est exaucée, Moïse. » Le miroir me montre l'exaucement immédiat. Allah répond à la demande. Tout ce que Moïse a demandé est accordé. Le miroir m'interroge : est-ce que je demande avec confiance ?`,
  reflection: `L'exaucement d'Allah est proche pour celui qui demande sincèrement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala qad utuyta su'laka ya musa » — Ta demande est exaucée, Moïse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande avec confiance ? Mes demandes sont-elles sincères ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exaucement suit la sincérité — pas la quantité des demandes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah répond à chaque appel — de manière visible ou invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande avec sincérité est toujours exaucé." }
  ],
  munajat: `Ya Mujib, Tu exauces les demandes sincères. Je viens à Toi avec confiance. Exauce mes demandes selon Ta sagesse.`
};

MIROIR["20:37"] = {
  reference: "20:37",
  theme: ["bonté", "passé", "souvenir"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ihsan", "Al-Madi"],
  mirrorVersion: `« Certes, Nous t'avons favorisé une autre fois. » Le miroir me montre le rappel des faveurs passées. Allah rappelle Ses bienfaits précédents. La gratitude se nourrit du souvenir. Le miroir m'interroge : est-ce que je me souviens des faveurs passées d'Allah ?`,
  reflection: `Le souvenir des bienfaits passés nourrit la confiance pour le présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad mananna 'alayka marratan ukhra » — Certes, Nous t'avons favorisé une autre fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens des faveurs passées d'Allah ? Ma gratitude est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli des bienfaits passés affaiblit la confiance présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vie est remplie de faveurs — le souvenir les préserve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient des bienfaits passés en voit de nouveaux." }
  ],
  munajat: `Ya Muhsin, je me souviens de Tes faveurs passées. Ma gratitude est constante. Fais que je n'oublie jamais ce que Tu as fait pour moi.`
};

MIROIR["20:38"] = {
  reference: "20:38",
  theme: ["inspiration", "mère", "révélation"],
  emotion: "Tendresse, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Umm"],
  mirrorVersion: `« Quand Nous avons inspiré à ta mère. » Le miroir me montre l'inspiration maternelle. Allah a inspiré la mère de Moïse. La protection passe par l'inspiration. Le miroir m'interroge : est-ce que je suis attentif aux inspirations divines ?`,
  reflection: `L'inspiration divine peut venir à travers les parents. Il faut être attentif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iz awhayna ila ummika ma yuha » — Quand Nous avons inspiré à ta mère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis attentif aux inspirations divines ? Par quels canaux me parlent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inspiration à la mère protège l'enfant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection des vulnérables passe par l'inspiration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit l'inspiration divine est protégé." }
  ],
  munajat: `Ya Wahy, inspire-moi et inspire ceux qui m'entourent. Ta protection passe par l'inspiration. Fais que je sois attentif à Tes signes.`
};

MIROIR["20:39"] = {
  reference: "20:39",
  theme: ["coffret", "fleuve", "protection"],
  emotion: "Protection, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Tabut", "An-Nil"],
  mirrorVersion: `« Place-le dans un coffret et jette-le dans le fleuve. » Le miroir me montre le paradoxe de la protection. Jeter dans le fleuve pour sauver. Le danger devient le salut. Le miroir m'interroge : est-ce que je vois la protection d'Allah dans les situations apparemment dangereuses ?`,
  reflection: `La protection d'Allah peut passer par des chemins inattendus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aniqhi fi al-tabuti fa-qhi fi al-yammi » — Place-le dans un coffret et jette-le dans le fleuve." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la protection d'Allah dans les situations dangereuses ? Ma confiance est-elle totale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le fleuve qui semble dangereux peut être le chemin du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les apparences trompent — la protection d'Allah est ailleurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les instructions divines est protégé, peu importe le chemin." }
  ],
  munajat: `Ya Hafiz, Ta protection passe par des chemins inattendus. Fais que je fasse confiance à Tes instructions. Même le danger peut être le salut.`
};

MIROIR["20:40"] = {
  reference: "20:40",
  theme: ["retour", "mère", "réunion"],
  emotion: "Tendresse, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rujua", "Al-Jam"],
  mirrorVersion: `« Pour qu'il soit rendu à sa mère. » Le miroir me montre la réunion comme but. L'enfant revient à sa mère. La séparation était temporaire. Le miroir m'interroge : quelles séparations Allah veut-il transformer en réunions ?`,
  reflection: `La séparation peut être un chemin vers une réunion plus belle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-taqarra 'aynuha wa la tahzana » — Pour qu'il soit rendu à sa mère, que son œil se réjouisse et qu'elle ne s'attriste pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles séparations Allah veut-il transformer en réunions dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La séparation temporaire peut renforcer le lien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute séparation peut être un chemin vers une réunion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la séparation pour la cause d'Allah goûte à la douce réunion." }
  ],
  munajat: `Ya Jami', Tu réunis ce qui est séparé. Transforme mes séparations en réunions. Fais que je Te retrouve et retrouve ceux que j'aime en Toi.`
};

MIROIR["20:41"] = {
  reference: "20:41",
  theme: ["élection", "formation", "préparation"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Istifa", "At-Tahdhib"],
  mirrorVersion: `« Et Je t'ai formé pour Moi. » Le miroir me montre la formation divine. Moïse a été formé pour Allah. La préparation est personnelle. Le miroir m'interroge : pour quoi est-ce que je suis formé ?`,
  reflection: `Chaque vie est une formation pour une mission. La question est de savoir laquelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa istana'tuka li-nafsi » — Et Je t'ai formé pour Moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi suis-je formé ? Quelle est ma mission unique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La formation pour Allah est la formation la plus élevée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être est formé pour quelque chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sait formé pour Allah vit avec but." }
  ],
  munajat: `Ya Musawwir, Tu m'as formé pour Toi. Révèle-moi ma mission. Fais que je vive selon la formation que Tu m'as donnée.`
};

MIROIR["20:42"] = {
  reference: "20:42",
  theme: ["mission", "frère", "permission"],
  emotion: "Détermination, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "Al-Izin"],
  mirrorVersion: `« Va avec ton frère avec Mes signes. » Le miroir me montre l'envoi en mission. Moïse part avec son frère et les signes. La mission est collective et signée. Le miroir m'interroge : avec qui et avec quoi vais-je en mission ?`,
  reflection: `La mission n'est pas solitaire. Les signes d'Allah nous accompagnent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idhhab anta wa akhuka bi-ayati » — Va avec ton frère avec Mes signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui et avec quoi vais-je en mission ? Mes compagnons et mes signes sont-ils prêts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mission sans frère et sans signe est fragile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque mission a besoin de compagnons et de preuves." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui part en mission avec les signes d'Allah réussit." }
  ],
  munajat: `Ya Rabb, envoie-moi en mission avec les bons compagnons et Tes signes. Je ne vais pas seul. Fais que ma mission soit signée par Toi.`
};

MIROIR["20:43"] = {
  reference: "20:43",
  theme: ["pharaon", "transgression", "attention"],
  emotion: "Vigilance, courage",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "At-Tughyan"],
  mirrorVersion: `« Allez vers Pharaon, il a transgressé. » Le miroir me montre la destination de la mission. Pharaon, le transgresseur. La mission vise le cœur de la tyrannie. Le miroir m'interroge : vers quel Pharaon suis-je envoyé ?`,
  reflection: `Chaque époque a ses Pharaons. La mission des croyants est de les affronter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idhhaba ila fir'awna innahu tagha » — Allez vers Pharaon, il a transgressé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers quel Pharaon suis-je envoyé ? Quelle tyrannie dois-je affronter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transgression demande une intervention courageuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tyrannie existe tant que personne ne l'affronte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui affronte la tyrannie avec les signes d'Allah vainc." }
  ],
  munajat: `Ya Rabb, envoie-moi vers les tyrans de mon temps. Donne-moi le courage de les affronter. Mes signes sont Ta vérité.`
};

MIROIR["20:44"] = {
  reference: "20:44",
  theme: ["parole", "douceur", "attention"],
  emotion: "Sagesse, douceur",
  difficulty: "débutant",
  relatedNames: ["Al-Qawl", "Al-Lutf"],
  mirrorVersion: `« Parlez-lui avec douceur, peut-être se rappellera-t-il. » Le miroir me montre la méthode de l'appel. La douceur dans la parole. Le but est le rappel, pas la confrontation. Le miroir m'interroge : ma parole est-elle douce ?`,
  reflection: `La douceur dans la parole ouvre les cœurs fermés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-qula lahu qawlan layyinan la'allahu yatadhakkaru aw yakhsha » — Parlez-lui avec douceur, peut-être se rappellera-t-il ou craindra-t-il." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma parole est-elle douce ? Comment je parle à ceux qui s'opposent à moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douceur n'est pas de la faiblesse — c'est de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La douceur ouvre les portes que la force ne peut ouvrir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle avec douceur touche les cœurs." }
  ],
  munajat: `Ya Latif, enseigne-moi la douceur dans la parole. Fais que mes mots ouvrent les cœurs fermés. La douceur est ma méthode.`
};

MIROIR["20:45"] = {
  reference: "20:45",
  theme: ["peur", "châtiment", "sécurité"],
  emotion: "Inquiétude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khawf", "Al-Aman"],
  mirrorVersion: `« Ils dirent : Seigneur, nous craignons qu'il ne nous traite avec dureté. » Le miroir me montre la peur légitime. Les prophètes ont peur. La crainte du tyran est réelle. Le miroir m'interroge : qu'est-ce que je crains dans ma mission ?`,
  reflection: `La peur est humaine. L'important est de la confier à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbana innana nakhafu an yafruta 'alayna » — Ils dirent : Seigneur, nous craignons qu'il ne nous traite avec dureté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crains dans ma mission ? Ma peur est-elle confiée à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur confiée à Allah devient courage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute mission comporte des risques — la confiance les surmonte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui confie sa peur à Allah reçoit Sa sécurité." }
  ],
  munajat: `Ya Aman, je Te confie ma peur. Les risques sont réels mais Tu es ma sécurité. Fais que ma peur se transforme en confiance en Toi.`
};

MIROIR["20:46"] = {
  reference: "20:46",
  theme: ["présence", "écoute", "vision"],
  emotion: "Réconfort, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'iyyah", "As-Sami'"],
  mirrorVersion: `« Ne craignez pas, Je suis avec vous. » Le miroir me montre la réponse divine. La présence d'Allah dissipe la peur. J'entends et Je vois — la connaissance parfaite. Le miroir m'interroge : est-ce que la présence d'Allah me suffit ?`,
  reflection: `La présence d'Allah est la meilleure protection. Sa connaissance est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala la takhafa innani ma'akuma asma'u wa ara » — Ne craignez pas, Je suis avec vous, J'entends et Je vois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que la présence d'Allah me suffit ? Sa compagnie me rassure-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La présence d'Allah n'enlève pas le danger — elle donne le courage de le traverser." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est avec ceux qui Le cherchent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'Allah est avec lui ne craint rien." }
  ],
  munajat: `Ya Ma'iyyah, Tu es avec moi. Je ne crains pas. Ta présence me suffit. Entends et vois ce que je traverse — Tu es ma protection.`
};

MIROIR["20:47"] = {
  reference: "20:47",
  theme: ["message", "signes", "libération"],
  emotion: "Détermination, clarté",
  difficulty: "débutant",
  relatedNames: ["Ar-Risalah", "Al-Ba'th"],
  mirrorVersion: `« Allez vers lui et dites : Nous sommes les messagers de ton Seigneur. » Le miroir me montre le message à délivrer. L'identité est claire : messagers du Seigneur. La demande : libérer les enfants d'Israël. Le miroir m'interroge : quel est mon message clair ?`,
  reflection: `Le message doit être clair. L'identité et la demande doivent être précises.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tiya fa-qula inna rasula rabbika » — Allez vers lui et dites : Nous sommes les messagers de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon message clair ? Ma demande est-elle précise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le message clair est plus efficace que le message confus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque messager doit savoir ce qu'il porte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a un message clair le délivre avec force." }
  ],
  munajat: `Ya Rabb, donne-moi un message clair. Je sais qui je suis et ce que je demande. Fais que mon message soit compris.`
};

MIROIR["20:48"] = {
  reference: "20:48",
  theme: ["révélation", "châtiment", "refus"],
  emotion: "Avertissement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Wa'id"],
  mirrorVersion: `« Il nous a été révélé que le châtiment atteindra celui qui refuse de croire. » Le miroir me montre l'avertissement. Le châtiment suit le refus. La révélation est claire. Le miroir m'interroge : est-ce que j'avertis avec clarté ?`,
  reflection: `L'avertissement fait partie du message. Le châtiment est réel pour ceux qui refusent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna qad uhiya ilayna anna al-'adhaba 'ala man kadhdhaba » — Il nous a été révélé que le châtiment atteindra celui qui refuse de croire et se détourne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'avertis avec clarté ? Le châtiment est-il mentionné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement n'est pas une menace — c'est une information." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le choix a des conséquences — le refus mène au châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui avertit clairement sauve des vies." }
  ],
  munajat: `Ya Wa'id, le châtiment est réel pour ceux qui refusent. Fais que je ne sois pas du nombre. Aide-moi à avertir avec clarté et amour.`
};

MIROIR["20:49"] = {
  reference: "20:49",
  theme: ["question", "seigneur", "doute"],
  emotion: "Défi, curiosité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rabb", "Al-Mas'alah"],
  mirrorVersion: `« Qui est votre Seigneur, Moïse ? » Le miroir me montre la question du tyran. Pharaon interroge sur l'identité du Seigneur. La question est un défi. Le miroir m'interroge : si on me demande qui est mon Seigneur, que répondrai-je ?`,
  reflection: `La question sur le Seigneur est fondamentale. La réponse révèle la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala faman rabbukuma ya musa » — Il dit : Qui est votre Seigneur, Moïse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si on me demande qui est mon Seigneur, que répondrai-je ? Ma foi est-elle claire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question du tyran est une occasion de témoigner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque croyant doit pouvoir expliquer qui est son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son Seigneur répond avec assurance." }
  ],
  munajat: `Ya Rabb, Tu es mon Seigneur. Fais que je puisse répondre avec clarté à ceux qui questionnent. Ma foi est ma réponse.`
};

MIROIR["20:50"] = {
  reference: "20:50",
  theme: ["créateur", "guidance", "perfection"],
  emotion: "Certitude, louange",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hadi"],
  mirrorVersion: `« Notre Seigneur est Celui qui a donné à chaque chose sa forme puis l'a guidée. » Le miroir me montre la réponse de Moïse. Une réponse parfaite sur la seigneurie. Créateur et Guide. Le miroir m'interroge : est-ce que je connais mon Seigneur à ce point ?`,
  reflection: `Allah est le Créateur qui guide. Chaque chose reçoit forme et guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala rabbuna alladhi a'ta kulla shay'in khalqahu thumma hada » — Notre Seigneur est Celui qui a donné à chaque chose sa forme puis l'a guidée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais mon Seigneur à ce point ? Ma réponse est-elle aussi profonde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création et la guidance sont deux faces de la seigneurie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui existe a une forme et une guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la création et la guidance connaît son Seigneur." }
  ],
  munajat: `Ya Khaliq, Tu as créé et Tu guides. Je Te connais comme Créateur et Guide. Fais que ma réponse sur Toi soit profonde et véridique.`
};

MIROIR["20:51"] = {
  reference: "20:51",
  theme: ["générations", "passé", "question"],
  emotion: "Défi, curiosité",
  difficulty: "débutant",
  relatedNames: ["Al-Qarn", "Al-Awwalun"],
  mirrorVersion: `« Quelle est donc la situation des premières générations ? » Le miroir me montre la question sur l'histoire. Pharaon interroge sur le passé. La question vise à piéger. Le miroir m'interroge : est-ce que je connais l'histoire des générations passées ?`,
  reflection: `L'histoire des générations passées est importante. Allah les connaît toutes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala fama balu al-quruni al-ula » — Il dit : Quelle est donc la situation des premières générations ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais l'histoire des générations passées ? Qu'est-ce que leur sort m'enseigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question sur le passé peut être un piège ou une occasion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les générations passées ont des leçons pour les présents." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, les générations passées ont des leçons. Fais que j'apprenne d'elles. Leur histoire est dans Ton savoir.`
};

MIROIR["20:52"] = {
  reference: "20:52",
  theme: ["savoir", "livre", "perfection"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Kitab"],
  mirrorVersion: `« La connaissance de cela est auprès de mon Seigneur dans un Livre. » Le miroir me montre la réponse sur le savoir. Le savoir parfait est auprès d'Allah. Le Livre contient tout. Le miroir m'interroge : est-ce que je me réfère au savoir d'Allah ?`,
  reflection: `Le savoir d'Allah est parfait et complet. Rien n'y manque.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala 'ilmuha 'inda rabbi fi kitabin » — La connaissance de cela est auprès de mon Seigneur dans un Livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me réfère au savoir d'Allah ? Ma confiance en Son savoir est-elle totale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le savoir humain est limité — le savoir divin est parfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout est enregistré dans le Livre d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfère au savoir d'Allah ne se trompe pas." }
  ],
  munajat: `Ya 'Alim, Ton savoir est parfait. Je me réfère à Toi pour tout ce que j'ignore. Ton Livre contient tout.`
};

MIROIR["20:53"] = {
  reference: "20:53",
  theme: ["terre", "berceau", "chemins"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Mahd"],
  mirrorVersion: `« C'est Lui qui a fait pour vous la terre comme un berceau. » Le miroir me montre la création bienveillante. La terre est un berceau pour l'homme. Les chemins y sont tracés. Le miroir m'interroge : est-ce que je vois la terre comme un berceau bienveillant ?`,
  reflection: `La terre est faite pour l'homme. Elle est un berceau, pas une prison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi ja'ala lakumu al-arda mahdan » — C'est Lui qui a fait pour vous la terre comme un berceau." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la terre comme un berceau ? Ma gratitude pour ce don est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le berceau implique un soin — la terre est soignée pour nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est le berceau de l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la terre comme berceau y trouve la paix." }
  ],
  munajat: `Ya Rabb, la terre est mon berceau. Je suis reconnaissant pour ce don. Fais que je la respecte et l'apprécie comme Tu l'as voulue.`
};

MIROIR["20:54"] = {
  reference: "20:54",
  theme: ["nourriture", "bétail", "gratitude"],
  emotion: "Gratitude, provision",
  difficulty: "débutant",
  relatedNames: ["Ar-Rizq", "Al-An'am"],
  mirrorVersion: `« Mangez et paissez vos troupeaux. » Le miroir me montre la permission de jouir. La provision est accordée. Le bétail et la nourriture sont des dons. Le miroir m'interroge : est-ce que je suis reconnaissant pour la provision ?`,
  reflection: `La provision est un don d'Allah. La gratitude accompagne la jouissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu wa ir'aw an'amakum » — Mangez et paissez vos troupeaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la provision ? Ma gratitude accompagne-t-elle ma consommation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La consommation sans gratitude est une ingratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute provision vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange avec gratitude reçoit plus." }
  ],
  munajat: `Ya Razzaq, je mange avec gratitude. Ta provision est abondante. Fais que je n'oublie jamais de Te remercier pour ce que je consomme.`
};

MIROIR["20:55"] = {
  reference: "20:55",
  theme: ["création", "retour", "résurrection"],
  emotion: "Humilité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khalaq", "Al-Ba'th"],
  mirrorVersion: `« C'est d'elle que Nous vous avons créés, et c'est vers elle que Nous vous retournerons. » Le miroir me montre le cycle de la vie. Création de la terre, retour à la terre, résurrection de la terre. Le cycle est complet. Le miroir m'interroge : est-ce que j'accepte ce cycle ?`,
  reflection: `La terre est notre origine et notre destination finale avant la résurrection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Minha khalaqnakum wa fiha nu'idukum wa minha nukhrijukum taratan ukhra » — C'est d'elle que Nous vous avons créés, et c'est vers elle que Nous vous retournerons, et d'elle Nous vous ferons sortir une autre fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ce cycle ? Mon origine et ma destination sont-elles claires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cycle de la terre n'est pas une fin — c'est un passage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui vient de la terre y retourne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le cycle trouve la paix." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de la terre et j'y retournerai. J'accepte ce cycle. Fais que ma résurrection soit vers le bien.`
};

MIROIR["20:56"] = {
  reference: "20:56",
  theme: ["signes", "refus", "reconnaissance"],
  emotion: "Tristesse, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Kufr"],
  mirrorVersion: `« Nous lui avons montré tous Nos signes, mais il a menti et refusé. » Le miroir me montre le refus obstiné. Les signes étaient clairs mais refusés. Le cœur fermé ne voit pas. Le miroir m'interroge : quels signes ai-je refusés ?`,
  reflection: `Le refus des signes ne vient pas de leur manque de clarté mais de la fermeture du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad araynahu ayatina kullaha fakadhdhaba wa aba » — Nous lui avons montré tous Nos signes, mais il a menti et refusé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes ai-je refusés ? Mon cœur est-il ouvert à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus des signes ne les détruit pas — il détruit celui qui refuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout — le refus est un choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes les voit se multiplier." }
  ],
  munajat: `Ya Rabb, ne me laisse pas refuser Tes signes. Mon cœur est ouvert. Fais que je voie et accepte tout ce que Tu me montres.`
};

MIROIR["20:57"] = {
  reference: "20:57",
  theme: ["magie", "terreur", "défi"],
  emotion: "Défi, moquerie",
  difficulty: "débutant",
  relatedNames: ["As-Sihr", "Al-Khawf"],
  mirrorVersion: `« As-tu fait venir pour nous faire sortir de notre terre par ta magie ? » Le miroir me montre le refus déguisé en accusation. Pharaon accuse Moïse de magie. Le refus devient attaque. Le miroir m'interroge : comment réagis-je quand on m'accuse à tort ?`,
  reflection: `L'accusation fausse est une tactique du tyran. La vérité n'a pas besoin de se défendre par la ruse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala a ji'tana li-tukhrijana min ardina bi-sihrika » — As-tu fait venir pour nous faire sortir de notre terre par ta magie, Moïse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je quand on m'accuse à tort ? Ma réponse est-elle digne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation fausse révèle la peur de l'accusateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont toujours été accusés à tort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est accusé à tort pour la vérité est honoré par Allah." }
  ],
  munajat: `Ya Rabb, quand je suis accusé à tort, sois mon défenseur. Ma dignité est en Toi. Fais que je réponde avec sagesse et calme.`
};

// ============ SURAH 22 (AL-HAJJ) - Missing Entries ============

MIROIR["22:6"] = {
  reference: "22:6",
  theme: ["création", "vie", "mort"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Muhyi"],
  mirrorVersion: `« C'est ainsi qu'Allah est la Vérité, et qu'Il donne la vie aux morts. » Le miroir me montre la puissance créatrice. « Dhalika bi-anna Allaha huwa al-haqqu » — c'est ainsi qu'Allah est la Vérité. « Wa annahu yuhyi al-mawta » — et qu'Il donne la vie aux morts. La vie et la mort sont entre Ses mains. Le miroir m'interroge : est-ce que je reconnais Sa puissance sur la vie ?`,
  reflection: `Allah est la Vérité. Il donne la vie aux morts. Reconnaître Sa puissance est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-anna Allaha huwa al-haqqu wa annahu yuhyi al-mawta » — c'est ainsi qu'Allah est la Vérité, et qu'Il donne la vie aux morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais Sa puissance sur la vie ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie et la mort sont entre les mains d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est la promesse d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la puissance d'Allah sur la vie vit vraiment." }
  ],
  munajat: `Ya Haqq, je reconnais Ta puissance sur la vie. Ne permets pas l'oubli. Donne-moi la vie véritable par Ta grâce.`
};

MIROIR["22:7"] = {
  reference: "22:7",
  theme: ["Heure", "résurrection", "certitude"],
  emotion: "Vigilance, préparation",
  difficulty: "débutant",
  relatedNames: ["As-Sa'ah", "Al-Ba'th"],
  mirrorVersion: `« Et que l'Heure arrivera, il n'y a pas de doute. » Le miroir me montre la certitude de la fin. « Wa anna al-sa'ata atiyatun la rayba fiha » — et que l'Heure arrivera, il n'y a pas de doute. « Wa anna Allaha yab'athu man fi al-qubur » — et qu'Allah ressuscitera ceux qui sont dans les tombes. La résurrection est certaine. Le miroir m'interroge : est-ce que je suis prêt pour l'Heure ?`,
  reflection: `L'Heure est certaine. La résurrection est vraie. Être prêt est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna al-sa'ata atiyatun la rayba fiha wa anna Allaha yab'athu man fi al-qubur » — et que l'Heure arrivera, il n'y a pas de doute. Et qu'Allah ressuscitera ceux qui sont dans les tombes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour l'Heure ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'Heure est certaine. La résurrection est vraie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains seront ressuscités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour l'Heure la rencontre en paix." }
  ],
  munajat: `Ya Rabb, je suis prêt pour l'Heure. Ne permets pas l'insouciance. Prépare-moi pour la résurrection.`
};

MIROIR["22:8"] = {
  reference: "22:8",
  theme: ["dispute", "guidance", "égarement"],
  emotion: "Humilité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Jadal"],
  mirrorVersion: `« Et parmi les hommes, il en est qui dispute au sujet d'Allah sans science. » Le miroir me montre l'ignorance des disputeurs. « Wa mina al-nasi man yujadilu fi Allahi bi-ghayri 'ilmin » — parmi les hommes, il en est qui dispute au sujet d'Allah sans science. La dispute sans science est égarement. Le miroir m'interroge : est-ce que je dispute avec science ou ignorance ?`,
  reflection: `Disputer sans science est égarement. Chercher la connaissance avant de parler est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-nasi man yujadilu fi Allahi bi-ghayri 'ilmin » — parmi les hommes, il en est qui dispute au sujet d'Allah sans science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dispute avec science ? Ou est-ce que je parle par ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute sans science est un égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance est la base de toute discussion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle avec science guide les autres." }
  ],
  munajat: `Ya Rabb, fais que je parle avec science. Ne permets pas l'ignorance. Donne-moi la connaissance avant de disputer.`
};

MIROIR["22:9"] = {
  reference: "22:9",
  theme: ["orgueil", "égarement", "prétention"],
  emotion: "Humilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Kibr", "Al-Dalalah"],
  mirrorVersion: `« Détournant son côté pour égarer du chemin d'Allah. » Le miroir me montre l'orgueil de l'égareur. « Thani 'itfihi li-yudilla 'an sabili Allahi » — détournant son côté pour égarer du chemin d'Allah. L'orgueil mène à l'égarement. Le miroir m'interroge : est-ce que j'égare ou est-ce que je guide ?`,
  reflection: `L'orgueil mène à l'égarement des autres. Guider est essentiel, pas égarer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thani 'itfihi li-yudilla 'an sabili Allahi » — détournant son côté pour égarer du chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'égare ou est-ce que je guide ? Quel est mon impact sur les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Égarer les autres est un péché grave." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah est clair pour ceux qui cherchent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide les autres est guidé." }
  ],
  munajat: `Ya Rabb, fais que je guide et non que j'égare. Ne permets pas l'orgueil. Utilise-moi pour le bien des autres.`
};

MIROIR["22:10"] = {
  reference: "22:10",
  theme: ["châtiment", "mérite", "justice"],
  emotion: "Responsabilité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Jaza'"],
  mirrorVersion: `« Cela pour ce que tes mains ont acquis. » Le miroir me montre la justice du châtiment. « Dhalika bima qaddamat yadaka » — cela pour ce que tes mains ont acquis. « Wa anna Allaha laysa bi-zallamin lil-'abid » — et Allah n'est point injuste envers les serviteurs. La justice est parfaite. Le miroir m'interroge : est-ce que j'accepte que je mérite ce qui m'arrive ?`,
  reflection: `Le châtiment est le résultat de nos actes. Accepter notre responsabilité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bima qaddamat yadaka wa anna Allaha laysa bi-zallamin lil-'abid » — cela pour ce que tes mains ont acquis. Et Allah n'est point injuste envers les serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma responsabilité ? Ou est-ce que je blâme les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment est juste. Nos actes ont des conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa responsabilité se corrige." }
  ],
  munajat: `Ya 'Adl, j'accepte ma responsabilité. Ne permets pas le déni. Corrige-moi avant que le châtiment ne m'atteigne.`
};

MIROIR["22:11"] = {
  reference: "22:11",
  theme: ["conditionnalité", "foi", "épreuve"],
  emotion: "Sincérité, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Fitnah"],
  mirrorVersion: `« Et parmi les hommes, il en est qui adore Allah à la limite. » Le miroir me montre la foi conditionnelle. « Wa mina al-nasi man ya'budu Allaha 'ala harfin » — parmi les hommes, il en est qui adore Allah à la limite. La foi conditionnelle n'est pas sincère. Le miroir m'interroge : ma foi est-elle inconditionnelle ?`,
  reflection: `La foi conditionnelle n'est pas vraie. La foi inconditionnelle est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-nasi man ya'budu Allaha 'ala harfin » — parmi les hommes, il en est qui adore Allah à la limite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle inconditionnelle ? Ou est-ce que j'adore seulement quand tout va bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi conditionnelle n'est pas la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est une soumission totale, pas une transaction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore sans condition est vraiment croyant." }
  ],
  munajat: `Ya Rabb, fais que ma foi soit inconditionnelle. Ne permets pas la transaction. Aide-moi à T'adorer dans toutes les circonstances.`
};

MIROIR["22:12"] = {
  reference: "22:12",
  theme: ["idole", "nuisance", "profit"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Asnam", "An-Nafi'"],
  mirrorVersion: `« Il invoque celui qui peut plus lui nuire que lui profiter. » Le miroir me montre l'absurdité de l'idolâtrie. « Yada'u man la yadurruhu naf'an » — il invoque celui qui ne peut ni lui nuire ni lui profiter. Les idoles sont impuissantes. Le miroir m'interroge : qu'est-ce que j'invoque qui ne peut rien pour moi ?`,
  reflection: `Invoquer ce qui ne peut rien est absurde. Invoquer Allah seul est la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yada'u man la yadurruhu naf'an » — il invoque celui qui ne peut ni lui nuire ni lui profiter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'invoque qui ne peut rien pour moi ? Est-ce que je mets ma confiance en Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles sont impuissantes. Allah est tout-puissant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah peut nuire et profiter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul reçoit réponse." }
  ],
  munajat: `Ya Rabb, je T'invoque Toi seul. Ne permets pas l'invocation des impuissants. Sois mon unique refuge.`
};

MIROIR["22:13"] = {
  reference: "22:13",
  theme: ["égarement", "perte", "mauvais"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Dalalah", "Al-Khusran"],
  mirrorVersion: `« Certes, c'est une perte évidente. » Le miroir me montre la perte de l'idolâtre. « Inna huwa dalalun mubin » — certes, c'est un égarement évident. L'idolâtrie est la plus grande perte. Le miroir m'interroge : est-ce que je réalise que m'égarer est la plus grande perte ?`,
  reflection: `S'égarer est la plus grande perte. Rester sur le droit chemin est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna huwa dalalun mubin » — certes, c'est un égarement évident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que m'égarer est la plus grande perte ? Ou est-ce que je minimise l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement est plus grave que toute perte matérielle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est le plus grand gain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la gravité de l'égarement cherche la guidance." }
  ],
  munajat: `Ya Rabb, je réalise que l'égarement est la plus grande perte. Ne permets pas l'égarement. Guide-moi sur le droit chemin.`
};

MIROIR["22:14"] = {
  reference: "22:14",
  theme: ["paradis", "croyants", "récompense"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Mu'minun"],
  mirrorVersion: `« Allah fait entrer ceux qui croient et font de bonnes œuvres dans des jardins sous lesquels coulent les rivières. » Le miroir me montre la récompense. « Innaha Allaha yudkhilu alladhina amanu wa 'amilu al-salihati jannatin tajri min tahtiha al-anhar » — Allah fait entrer ceux qui croient et font de bonnes œuvres dans des jardins. La foi et les œuvres mènent au paradis. Le miroir m'interroge : est-ce que je combine foi et œuvres ?`,
  reflection: `La foi et les bonnes œuvres mènent au paradis. Les combiner est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaha Allaha yudkhilu alladhina amanu wa 'amilu al-salihati jannatin tajri min tahtiha al-anhar » — Allah fait entrer ceux qui croient et font de bonnes œuvres dans des jardins sous lesquels coulent les rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je combine foi et œuvres ? Ou est-ce que je néglige l'un ou l'autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le paradis attend ceux qui combinent foi et œuvres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jardins du paradis sont la récompense éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combine foi et œuvres entre au paradis." }
  ],
  munajat: `Ya Rabb, fais que je combine foi et œuvres. Ne permets pas la négligence. Fais-moi entrer dans Tes jardins.`
};

MIROIR["22:15"] = {
  reference: "22:15",
  theme: ["ruse", "terre", "ciel"],
  emotion: "Vigilance, réalisme",
  difficulty: "débutant",
  relatedNames: ["Al-Kayd", "As-Sama'"],
  mirrorVersion: `« Que celui qui pense qu'Allah ne le secourra pas dans la vie d'ici-bas et dans l'au-delà étende une corde vers le ciel. » Le miroir me montre le défi. « Man kana yazunnu an lan yansurahu Allahu fi al-dunya wa al-akhirah » — que celui qui pense qu'Allah ne le secourra pas. « Fal-yamdud sababan ila al-sama' » — étende une corde vers le ciel. La ruse humaine est impuissante. Le miroir m'interroge : est-ce que je doute du secours d'Allah ?`,
  reflection: `Le secours d'Allah est certain. En douter est le signe de la faiblesse de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kana yazunnu an lan yansurahu Allahu fi al-dunya wa al-akhirah fal-yamdud sababan ila al-sama' » — que celui qui pense qu'Allah ne le secourra pas dans la vie d'ici-bas et dans l'au-delà étende une corde vers le ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute du secours d'Allah ? Ou est-ce que j'ai confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secours d'Allah est certain. En douter est absurde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah secourt toujours Ses serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au secours d'Allah le reçoit." }
  ],
  munajat: `Ya Rabb, je crois en Ton secours. Ne permets pas le doute. Secours-moi dans cette vie et dans l'au-delà.`
};

MIROIR["22:16"] = {
  reference: "22:16",
  theme: ["révélation", "clarté", "chemin"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Sabil"],
  mirrorVersion: `« Et c'est ainsi que Nous l'avons fait descendre, des signes clairs. » Le miroir me montre la clarté de la révélation. « Wa kadhalika anzalnahu ayatin bayyinatin » — c'est ainsi que Nous l'avons fait descendre, des signes clairs. « Wa anna Allaha yahdi man yurid » — et Allah guide qui Il veut. La guidance est claire. Le miroir m'interroge : est-ce que je suis les signes clairs ?`,
  reflection: `Les signes sont clairs. Les suivre est essentiel pour être guidé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika anzalnahu ayatin bayyinatin wa anna Allaha yahdi man yurid » — c'est ainsi que Nous l'avons fait descendre, des signes clairs. Et Allah guide qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis les signes clairs ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont clairs pour ceux qui veulent voir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est un guide clair pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les signes clairs est guidé." }
  ],
  munajat: `Ya Rabb, je suis Tes signes clairs. Ne permets pas l'aveuglement. Guide-moi par Ta révélation.`
};

MIROIR["22:17"] = {
  reference: "22:17",
  theme: ["communautés", "jugement", "rétribution"],
  emotion: "Responsabilité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Qiyamah", "Al-Firaq"],
  mirrorVersion: `« Certes, ceux qui ont cru, les Juifs, les Sabéens, les Chrétiens, les Zoroastriens et les associateurs, Allah tranchera entre eux le Jour de la Résurrection. » Le miroir me montre la diversité des communautés et le jugement divin. Toutes les communautés seront jugées. Le miroir m'interroge : est-ce que je serai parmi les gagnants ?`,
  reflection: `Toutes les communautés seront jugées. Le jugement appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa alladhina hadu wa al-sabi'ina wa al-nasara wa al-majusa wa alladhina ashraku » — ceux qui ont cru, les Juifs, les Sabéens, les Chrétiens, les Zoroastriens et les associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi les gagnants ? Ou est-ce que je serai perdant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement d'Allah est juste et définitif." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains seront jugés équitablement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment sera parmi les gagnants." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les gagnants. Ne permets pas la perte. Juge-moi avec Ta miséricorde.`
};

MIROIR["22:18"] = {
  reference: "22:18",
  theme: ["prosternation", "création", "obéissance"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["As-Sujud", "Al-Khalq"],
  mirrorVersion: `« N'as-tu pas vu qu'Allah est glorifié par ceux qui sont dans les cieux et la terre ? » Le miroir me montre la prosternation universelle. « Alam tara anna Allaha yasjudu lahu man fi al-samawati wa man fi al-ard » — Allah est glorifié par ceux qui sont dans les cieux et la terre. Toute la création L'adore. Le miroir m'interroge : est-ce que je me prosterne avec la création ?`,
  reflection: `Toute la création se prosterne devant Allah. Joindre cette prosternation universelle est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna Allaha yasjudu lahu man fi al-samawati wa man fi al-ard » — n'as-tu pas vu qu'Allah est glorifié par ceux qui sont dans les cieux et la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prosterne avec la création ? Ou est-ce que je reste debout par orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation est la position naturelle de la créature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier adore Allah dans la prosternation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne rejoint l'univers." }
  ],
  munajat: `Ya Rabb, je me prosterne avec la création. Ne permets pas l'orgueil. Fais que ma prosternation soit sincère.`
};

MIROIR["22:19"] = {
  reference: "22:19",
  theme: ["dispute", "châtiment", "réalité"],
  emotion: "Effroi, réalisme",
  difficulty: "débutant",
  relatedNames: ["Al-Khusam", "An-Nar"],
  mirrorVersion: `« Voici deux adversaires qui disputent au sujet de leur Seigneur. » Le miroir me montre la dispute finale. « Hadhan khasmani ikhtasamu fi rabbihim » — voici deux adversaires qui disputent au sujet de leur Seigneur. Le miroir m'interroge : est-ce que je suis parmi les adversaires qui ont raison ou tort ?`,
  reflection: `Il y a deux camps : les croyants et les mécréants. Choisir le bon camp est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadhan khasmani ikhtasamu fi rabbihim » — voici deux adversaires qui disputent au sujet de leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les croyants ? Ou parmi les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute a une fin. Le jugement tranche." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Deux chemins, deux destins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le camp de la vérité gagne." }
  ],
  munajat: `Ya Rabb, je choisis le camp de la vérité. Ne permets pas l'égarement. Fais que je sois parmi les croyants.`
};

MIROIR["22:20"] = {
  reference: "22:20",
  theme: ["châtiment", "destruction", "corps"],
  emotion: "Effroi, avertissement",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Hal"],
  mirrorVersion: `« Ceux qui ont mécru, on leur taillera des vêtements de feu. » Le miroir me montre le châtiment des mécréants. « Fa alladhina kafaru qutti'at lahum thiyabun min nar » — ceux qui ont mécru, on leur taillera des vêtements de feu. Le châtiment est physique. Le miroir m'interroge : est-ce que je fuis ce châtiment ?`,
  reflection: `Le châtiment des mécréants est terrible. L'éviter par la foi est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa alladhina kafaru qutti'at lahum thiyabun min nar » — ceux qui ont mécru, on leur taillera des vêtements de feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis ce châtiment ? Ou est-ce que je m'en rapproche par la mécréance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu enveloppe ceux qui le méritent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment est la conséquence de la mécréance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit le châtiment par la foi est épargné." }
  ],
  munajat: `Ya Rabb, je fuis le châtiment par la foi. Ne permets pas la mécréance. Épargne-moi du feu.`
};

MIROIR["22:21"] = {
  reference: "22:21",
  theme: ["châtiment", "massue", "fer"],
  emotion: "Effroi, terreur",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Maqami'"],
  mirrorVersion: `« Et au-dessus d'eux, il y aura des masses de fer. » Le miroir me montre l'intensité du châtiment. « Wa lahum maqami'u min hadid » — et au-dessus d'eux, il y aura des masses de fer. Le châtiment est constant et violent. Le miroir m'interroge : est-ce que je crains ce châtiment ?`,
  reflection: `Le châtiment est violent et constant. Le craindre et l'éviter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lahum maqami'u min hadid » — et au-dessus d'eux, il y aura des masses de fer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce châtiment ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La violence du châtiment reflète la gravité de la mécréance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment est proportionné à la faute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment l'évite par la foi." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Ne permets pas l'insouciance. Protège-moi du feu et de ses instruments.`
};

MIROIR["22:22"] = {
  reference: "22:22",
  theme: ["désespoir", "fuite", "retour"],
  emotion: "Désespoir, effroi",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Ya's"],
  mirrorVersion: `« Chaque fois qu'ils voudront en sortir, ils y seront ramenés. » Le miroir me montre l'impossibilité de fuir. « Kullama aradu an yakhruju minha min ghammin u'idu fiha » — chaque fois qu'ils voudront en sortir, ils y seront ramenés. Le désespoir est total. Le miroir m'interroge : est-ce que je comprends que la foi est la seule issue ?`,
  reflection: `Fuir l'Enfer est impossible. La seule issue est de ne pas y entrer par la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullama aradu an yakhruju minha min ghammin u'idu fiha » — chaque fois qu'ils voudront en sortir, ils y seront ramenés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la foi est la seule issue ? Ou est-ce que je compte sur la fuite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Il n'y a pas de sortie de l'Enfer une fois qu'on y est." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est une prison éternelle pour ses habitants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'impossibilité de fuir cherche à ne pas y entrer." }
  ],
  munajat: `Ya Rabb, je comprends que la foi est la seule issue. Ne permets pas que j'entre dans le feu. Sauve-moi par ma foi.`
};

MIROIR["22:23"] = {
  reference: "22:23",
  theme: ["paradis", "bijoux", "récompense"],
  emotion: "Espérance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Hilyah"],
  mirrorVersion: `« Allah fait entrer ceux qui croient et font de bonnes œuvres dans des jardins sous lesquels coulent les rivières. » Le miroir me montre la beauté du paradis. « Innaha Allaha yudkhilu alladhina amanu wa 'amilu al-salihati jannatin » — Allah fait entrer les croyants dans des jardins. « Yuhalawna fiha min asawira min dhahabin » — ils seront parés de bracelets d'or. La récompense est magnifique. Le miroir m'interroge : est-ce que j'aspire à cette beauté ?`,
  reflection: `Le paradis est magnifique. Y aspirer et travailler pour y entrer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuhalawna fiha min asawira min dhahabin wa lu'lu'an » — ils seront parés de bracelets d'or et de perles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à cette beauté ? Ou est-ce que je suis distrait par les beautés de ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté du paradis dépasse toute beauté terrestre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis est la récompense ultime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aspire à la beauté du paradis y entre." }
  ],
  munajat: `Ya Rabb, j'aspire à la beauté du paradis. Ne permets pas la distraction. Accorde-moi cette récompense magnifique.`
};

MIROIR["22:24"] = {
  reference: "22:24",
  theme: ["parole", "pureté", "guidance"],
  emotion: "Pureté, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Qawl", "Al-Tayyib"],
  mirrorVersion: `« Et ils ont été guidés vers la bonne parole. » Le miroir me montre la guidance vers la pureté. « Wa hudu ila al-tayyibi mina al-qawli » — ils ont été guidés vers la bonne parole. « Wa hudu ila sirati al-hamid » — et vers le chemin du Digne de louanges. La guidance mène à la pureté. Le miroir m'interroge : est-ce que ma parole est bonne ?`,
  reflection: `La bonne parole est un signe de guidance. Purifier sa parole est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hudu ila al-tayyibi mina al-qawli wa hudu ila sirati al-hamid » — ils ont été guidés vers la bonne parole et vers le chemin du Digne de louanges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma parole est bonne ? Ou est-ce qu'elle est souillée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne parole reflète le bon cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole pure est la marque des guidés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie sa parole purifie son cœur." }
  ],
  munajat: `Ya Rabb, purifie ma parole. Ne permets pas la souillure. Guide-moi vers la bonne parole et le chemin de la louange.`
};

MIROIR["22:25"] = {
  reference: "22:25",
  theme: ["mosquée", "interdiction", "injustice"],
  emotion: "Colère, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Masjid", "Al-Haram"],
  mirrorVersion: `« Ceux qui ont mécru et éloignent du chemin d'Allah et de la Mosquée sacrée. » Le miroir me montre l'injustice des mécréants. « Inna alladhina kafaru wa yasudduna 'an sabili Allahi wa al-masjidi al-harami » — ceux qui ont mécru et éloignent du chemin d'Allah et de la Mosquée sacrée. L'interdiction est une injustice. Le miroir m'interroge : est-ce que j'éloigne ou est-ce que j'invite ?`,
  reflection: `Éloigner du chemin d'Allah est une injustice grave. Inviter vers Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru wa yasudduna 'an sabili Allahi wa al-masjidi al-harami » — ceux qui ont mécru et éloignent du chemin d'Allah et de la Mosquée sacrée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'éloigne ou est-ce que j'invite ? Quel est mon impact sur les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Éloigner du chemin d'Allah est un péché grave." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Mosquée sacrée est pour tous les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invite vers Allah est béni." }
  ],
  munajat: `Ya Rabb, j'invite vers Toi. Ne permets pas que j'éloigne. Fais que je sois un guide vers Ton chemin.`
};

MIROIR["22:26"] = {
  reference: "22:26",
  theme: ["Abraham", "maison", "purification"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Bayt"],
  mirrorVersion: `« Et quand Nous avons assigné à Abraham l'emplacement de la Maison. » Le miroir me montre l'origine de la Ka'ba. « Wa idh bawwa'na li-Ibrahimah makana al-bayt » — quand Nous avons assigné à Abraham l'emplacement de la Maison. « An la tushrik bi shay'an » — ne M'associe rien. La Maison est fondée sur l'unicité. Le miroir m'interroge : est-ce que je préserve l'unicité dans mon adoration ?`,
  reflection: `La Maison d'Allah est fondée sur l'unicité. Préserver l'unicité dans l'adoration est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh bawwa'na li-Ibrahimah makana al-bayt an la tushrik bi shay'an » — quand Nous avons assigné à Abraham l'emplacement de la Maison : ne M'associe rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve l'unicité dans mon adoration ? Ou est-ce que j'associe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Maison est le symbole de l'unicité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Ka'ba est le centre de l'unicité pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve l'unicité honore la Maison." }
  ],
  munajat: `Ya Rabb, je préserve l'unicité dans mon adoration. Ne permets pas l'association. Honore Ta Maison par ma foi pure.`
};

MIROIR["20:58"] = {
  reference: "20:58",
  theme: ["compétition", "magie", "rendez-vous"],
  emotion: "Défi, détermination",
  difficulty: "débutant",
  relatedNames: ["As-Sihr", "Al-Mi'ad"],
  mirrorVersion: `« Nous t'apporterons une magie semblable. » Le miroir me montre le défi du tyran. Pharaon contre-attaque avec sa propre "magie". La compétition est ouverte. Le miroir m'interroge : comment réagis-je face à la compétition ?`,
  reflection: `La compétition avec le mal est inégale — mais Allah soutient le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fala-natiyannaka bi-mithlihi » — Nous t'apporterons une magie semblable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je face à la compétition ? Ma confiance en Allah est-elle solide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compétition avec Allah perdante est perdue d'avance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal peut imiter le bien — mais il ne peut pas le vaincre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est avec Allah gagne toute compétition." }
  ],
  munajat: `Ya Rabb, la compétition est ouverte. Je suis avec Toi. Fais que je ne craigne pas les défis. Ta vérité vainc toute imitation.`
};

MIROIR["20:59"] = {
  reference: "20:59",
  theme: ["rendez-vous", "temps", "fête"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Mi'ad", "Al-Waqt"],
  mirrorVersion: `« Votre rendez-vous est le jour de la fête. » Le miroir me montre le choix du moment. Moïse fixe un rendez-vous public. La fête devient le jour du jugement. Le miroir m'interroge : quels rendez-vous dois-je fixer ?`,
  reflection: `Le choix du moment est stratégique. Le rendez-vous public révèle la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala mi'adukum yawmu al-zinati » — Votre rendez-vous est le jour de la fête." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels rendez-vous dois-je fixer ? Mon timing est-il guidé par Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jour de la fête devient le jour du jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est un facteur stratégique dans la mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit bien son temps maximise son impact." }
  ],
  munajat: `Ya Rabb, guide mon timing. Mes rendez-vous doivent être bien choisis. Fais que chaque moment soit utilisé pour Ta gloire.`
};

MIROIR["20:60"] = {
  reference: "20:60",
  theme: ["préparation", "magiciens", "rassemblement"],
  emotion: "Tension, anticipation",
  difficulty: "débutant",
  relatedNames: ["As-Saharah", "Al-Hashr"],
  mirrorVersion: `« Pharaon se retira, rassembla ses ruses, puis vint. » Le miroir me montre la préparation de l'ennemi. Le tyran rassemble ses forces. La confrontation approche. Le miroir m'interroge : est-ce que je suis préparé pour mes confrontations ?`,
  reflection: `L'ennemi se prépare. Le croyant doit aussi se préparer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tawalla fir'awnu fa-jama'a kaydahu thumma ata » — Pharaon se retira, rassembla ses ruses, puis vint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis préparé pour mes confrontations ? Ma préparation est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ruses de l'ennemi ne valent rien face à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque confrontation demande une préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare avec Allah est toujours prêt." }
  ],
  munajat: `Ya Rabb, je me prépare pour mes confrontations. Ma force est en Toi. Fais que je sois toujours prêt pour les défis qui viennent.`
};

MIROIR["20:61"] = {
  reference: "20:61",
  theme: ["invention", "châtiment", "avertissement"],
  emotion: "Gravité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Iftira'", "Al-Wa'id"],
  mirrorVersion: `« Malheur à vous ! N'inventez pas de mensonge contre Allah. » Le miroir me montre l'avertissement de Moïse. Il avertit les magiciens. L'invention contre Allah est grave. Le miroir m'interroge : est-ce que j'évite l'invention contre Allah ?`,
  reflection: `L'invention contre Allah a des conséquences graves. L'avertissement est un acte de miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala lahum musa waylakum la taftaru 'ala Allahi kadhiban » — Malheur à vous ! N'inventez pas de mensonge contre Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite l'invention contre Allah ? Mes paroles sur Lui sont-elles véridiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invention contre Allah attire le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur Allah est sacrée — l'invention est un crime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la vérité sur Allah est préservé." }
  ],
  munajat: `Ya Rabb, je ne veux pas inventer de mensonge contre Toi. Mes paroles sur Toi sont véridiques. Préserve-moi de l'invention et du mensonge.`
};

MIROIR["20:62"] = {
  reference: "20:62",
  theme: ["discussion", "secret", "conseil"],
  emotion: "Tension, stratégie",
  difficulty: "débutant",
  relatedNames: ["An-Najwa", "Ash-Shura"],
  mirrorVersion: `« Ils se consultèrent entre eux en secret. » Le miroir me montre la consultation secrète. Les magiciens discutent en privé. La stratégie se décide dans le secret. Le miroir m'interroge : quelles consultations tiens-je ?`,
  reflection: `Les consultations secrètes révèlent les vraies intentions. Le croyant consulte ouvertement avec les siens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tanaza'u amrahum baynahum » — Ils se consultèrent entre eux en secret." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles consultations tiens-je ? Sont-elles pour le bien ou pour le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La consultation secrète pour le mal est une ruse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les secrets finissent toujours par être révélés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui consulte pour le bien reçoit la guidance." }
  ],
  munajat: `Ya Rabb, mes consultations sont pour le bien. Je ne conspire pas dans le secret. Fais que mes conseils soient transparents et justes.`
};

MIROIR["20:63"] = {
  reference: "20:63",
  theme: ["magie", "expulsion", "accusation"],
  emotion: "Accusation, défi",
  difficulty: "débutant",
  relatedNames: ["As-Sihr", "Al-Ikhraj"],
  mirrorVersion: `« Ces deux sont des magiciens qui veulent vous faire sortir de votre terre. » Le miroir me montre l'accusation publique. Les magiciens accusent Moïse et Aaron. L'accusation vise à discréditer. Le miroir m'interroge : comment réagis-je aux accusations publiques ?`,
  reflection: `L'accusation publique est une tactique de l'ennemi. La vérité se défend d'elle-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadhayni la-sahirani yuridani an yukhrijakum min ardikum » — Ces deux sont des magiciens qui veulent vous faire sortir de votre terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je aux accusations publiques ? Ma dignité est-elle préservée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation fausse finit par se retourner contre l'accusateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours de l'accusation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est accusé pour la vérité est justifié par Allah." }
  ],
  munajat: `Ya Rabb, quand je suis accusé publiquement, sois mon défenseur. La vérité me justifie. Fais que je ne réagisse pas avec colère mais avec confiance.`
};

MIROIR["20:64"] = {
  reference: "20:64",
  theme: ["rang", "union", "victoire"],
  emotion: "Détermination, stratégie",
  difficulty: "débutant",
  relatedNames: ["As-Saff", "Al-Jam"],
  mirrorVersion: `« Mettez-vous en rangs serrés. » Le miroir me montre l'importance de l'unité. Les rangs serrés donnent la force. L'union dans la confrontation. Le miroir m'interroge : est-ce que je me mets en rangs avec les croyants ?`,
  reflection: `L'unité dans les rangs est la force. La division est la faiblesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ajimu safari kum » — Mettez-vous en rangs serrés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me mets en rangs avec les croyants ? Mon unité avec eux est-elle réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les rangs serrés des mécréants n'impressionnent pas Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'union fait la force — dans le bien comme dans le mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'unit avec les croyants dans la vérité est fort." }
  ],
  munajat: `Ya Rabb, je me mets en rangs avec les croyants. Notre unité est notre force. Fais que nous restions unis dans la vérité.`
};

MIROIR["20:65"] = {
  reference: "20:65",
  theme: ["question", "choix", "initiative"],
  emotion: "Tension, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Ikhtiyar", "Al-Bid'ah"],
  mirrorVersion: `« Ô Moïse, jeteras-tu ou serons-nous les premiers à jeter ? » Le miroir me montre la question tactique. Les magiciens proposent un choix. Qui commence ? Le miroir m'interroge : qui prend l'initiative dans mes confrontations ?`,
  reflection: `L'initiative peut être un avantage ou un désavantage. La sagesse décide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya musa imma an tulqiya wa imma an nakuna awwala man alqa » — Ô Moïse, jeteras-tu ou serons-nous les premiers à jeter ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui prend l'initiative dans mes confrontations ? Ma sagesse décide-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'initiative n'est pas toujours l'avantage — le résultat compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le timing et l'initiative sont stratégiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse la sagesse décider l'initiative gagne." }
  ],
  munajat: `Ya Rabb, guide mon initiative. Fais que je sache quand avancer et quand attendre. Ma sagesse vient de Toi.`
};

MIROIR["20:66"] = {
  reference: "20:66",
  theme: ["corde", "bâton", "illusion"],
  emotion: "Tension, épreuve",
  difficulty: "débutant",
  relatedNames: ["Al-Hibal", "Al-'Asa"],
  mirrorVersion: `« Il dit : Jetez ! Et voilà leurs cordes et bâtons qui lui semblèrent ramper. » Le miroir me montre l'illusion puissante. La magie crée une illusion. Le réel semble vivant. Le miroir m'interroge : quelles illusions m'environnent ?`,
  reflection: `Les illusions peuvent sembler réelles. La vérité d'Allah les dissipe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala alqu fa-idha hibaluhum wa 'isiyyuhum yukhayyalu ilayhi » — Il dit : Jetez ! Et voilà leurs cordes et bâtons qui lui semblèrent ramper." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles illusions m'environnent ? Ce qui semble réel est-il vrai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illusion est temporaire — la vérité est permanente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les illusions sont partout — la vérité d'Allah les traverse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec les yeux d'Allah ne se trompe pas." }
  ],
  munajat: `Ya Haqq, dissipe mes illusions. Fais que je voie la vérité derrière les apparences. Tes yeux sont les miens.`
};

MIROIR["20:67"] = {
  reference: "20:67",
  theme: ["peur", "cœur", "appréhension"],
  emotion: "Peur, épreuve",
  difficulty: "débutant",
  relatedNames: ["Al-Khawf", "Al-Qalb"],
  mirrorVersion: `« Moïse ressentit quelque peur en lui-même. » Le miroir me montre la peur du prophète. Même Moïse a peur. La peur est humaine. Le miroir m'interroge : quelle peur ressens-je face à l'illusion ?`,
  reflection: `La peur est naturelle. Ce qui compte est de ne pas la laisser paralyser.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-awjasa fi nafsihi khifatan musa » — Moïse ressentit quelque peur en lui-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle peur ressens-je face à l'illusion ? Cette peur me paralyse-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur ne signifie pas la défaite — l'action malgré la peur est la victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plus courageux ont eu peur — ils ont agi quand même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ressent la peur mais agit triomphe." }
  ],
  munajat: `Ya Rabb, la peur m'habite. Mais je ne la laisse pas me paralyser. Avec Toi, j'agis malgré la peur. Donne-moi le courage de l'action.`
};

MIROIR["20:68"] = {
  reference: "20:68",
  theme: ["réassurance", "supériorité", "victoire"],
  emotion: "Confiance, calme",
  difficulty: "débutant",
  relatedNames: ["As-Sakinah", "Al-Fawq"],
  mirrorVersion: `« Nous dîmes : Ne crains pas, c'est toi qui l'emporteras. » Le miroir me montre la réassurance divine. Allah calme la peur de Moïse. La victoire est promise. Le miroir m'interroge : est-ce que j'entends la réassurance d'Allah ?`,
  reflection: `La réassurance d'Allah vient au bon moment. La victoire est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulna la takhaf innaka anta al-a'la » — Nous dîmes : Ne crains pas, c'est toi qui l'emporteras." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends la réassurance d'Allah ? Sa promesse de victoire m'atteint-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur peut précéder la victoire — elle ne l'empêche pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La victoire d'Allah est certaine pour ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend la réassurance d'Allah ne craint plus." }
  ],
  munajat: `Ya Rabb, j'entends Ta réassurance. Je ne crains plus. La victoire est certaine avec Toi. Fais que Ta parole calme ma peur.`
};

MIROIR["20:69"] = {
  reference: "20:69",
  theme: ["jeter", "dévore", "vérité"],
  emotion: "Détermination, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Jette ce que tu as dans ta main droite. » Le miroir me montre l'action décisive. Moïse doit jeter son bâton. La vérité dévore l'illusion. Le miroir m'interroge : qu'est-ce que je dois jeter pour voir la vérité dévorer le mensonge ?`,
  reflection: `L'action décisive avec la vérité d'Allah détruit les illusions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alqi ma fi yaminika talqaf ma sana'u » — Jette ce que tu as dans ta main droite, elle dévorera ce qu'ils ont fabriqué." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois jeter pour voir la vérité dévorer le mensonge ? Mon action est-elle décisive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité dévore le mensonge — pas l'inverse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par l'emporter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui jette la vérité voit le mensonge dévoré." }
  ],
  munajat: `Ya Haqq, je jette Ta vérité. Elle dévore le mensonge qui m'environne. Mon action est décisive avec Toi.`
};

MIROIR["20:70"] = {
  reference: "20:70",
  theme: ["prosternation", "foi", "conversion"],
  emotion: "Awe, soumission",
  difficulty: "débutant",
  relatedNames: ["As-Sujud", "Al-Iman"],
  mirrorVersion: `« Les magiciens se jetèrent prosternés. » Le miroir me montre la conversion spectaculaire. Les magiciens reconnaissent la vérité. La prosternation suit la reconnaissance. Le miroir m'interroge : qu'est-ce qui me ferait tomber en prosternation ?`,
  reflection: `La vérité vue transforme. La prosternation est la réponse naturelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ulqiya al-saharatu sujjadan » — Les magiciens se jetèrent prosternés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me ferait tomber en prosternation ? Ma reconnaissance de la vérité est-elle complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation est la réponse du cœur à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité vue demande une réponse — la prosternation est la plus belle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vérité tombe en prosternation." }
  ],
  munajat: `Ya Rabb, je me prosterne devant Ta vérité. Ma reconnaissance est complète. Fais que chaque vision de Ta vérité me fasse tomber en adoration.`
};

MIROIR["20:71"] = {
  reference: "20:71",
  theme: ["menace", "torture", "persécution"],
  emotion: "Effroi, compassion",
  difficulty: "débutant",
  relatedNames: ["At-Ta'dhib", "Al-Fitnah"],
  mirrorVersion: `« Je vous couperai les mains et les pieds opposés. » Le miroir me montre la réaction du tyran. Pharaon menace de torture. La persécution suit la conversion. Le miroir m'interroge : quelle persécution suis-je prêt à endurer pour ma foi ?`,
  reflection: `La persécution accompagne souvent la foi. Le tyran ne tolère pas la conversion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala amantum lahu qabla an adhana lakum » — Avez-vous cru en lui avant que je ne vous y autorise ? Je vous couperai les mains et les pieds opposés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle persécution suis-je prêt à endurer pour ma foi ? Mon engagement est-il total ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La menace du tyran révèle sa peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les croyants ont toujours été persécutés — ils ont tenu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure la persécution pour Allah est honoré." }
  ],
  munajat: `Ya Rabb, la persécution peut m'atteindre. Fortifie-moi pour l'endurer. Mon engagement est total. Fais que je tienne face à la menace.`
};

MIROIR["20:72"] = {
  reference: "20:72",
  theme: ["préférence", "châtiment", "décision"],
  emotion: "Courage, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Isar", "Al-Qada"],
  mirrorVersion: `« Nous préférons le châtiment que tu nous infliges. » Le miroir me montre le choix courageux. Les magiciens préfèrent le châtiment temporaire au reniement. La foi est plus précieuse que la vie. Le miroir m'interroge : qu'est-ce que je préfère à tout ?`,
  reflection: `Le choix de la foi sur la vie est le test ultime. Le châtiment temporaire vaut mieux que le reniement éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu la nu'athiruka 'ala al-bayyinati » — Nous ne te préférerons pas aux preuves qui nous sont venues." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je préfère à tout ? Ma foi est-elle plus précieuse que ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment du tyran est temporaire — le châtiment d'Allah est éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le choix de la foi est le choix du courageux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préfère la foi à la vie reçoit la vie éternelle." }
  ],
  munajat: `Ya Rabb, je préfère Ta vérité à tout. Même le châtiment temporaire vaut mieux que le reniement. Fais que ma foi soit plus précieuse que tout.`
};

MIROIR["20:73"] = {
  reference: "20:73",
  theme: ["foi", "pardon", "espérance"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Maghfirah"],
  mirrorVersion: `« Nous avons cru en notre Seigneur afin qu'Il nous pardonne nos fautes. » Le miroir me montre le but de la foi. Croire pour être pardonné. L'espérance en la miséricorde. Le miroir m'interroge : mon but dans la foi est-il le pardon ?`,
  reflection: `La foi ouvre la porte du pardon. L'espérance en la miséricorde motive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna amanna birabbina li-yaghfira lana khata-yana » — Nous avons cru en notre Seigneur afin qu'Il nous pardonne nos fautes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon but dans la foi est-il le pardon ? Mon espérance en la miséricorde est-elle vive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans espérance du pardon est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pardon d'Allah est accessible à tout croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit avec espérance reçoit le pardon." }
  ],
  munajat: `Ya Ghafur, je crois en Toi pour être pardonné. Mes fautes sont nombreuses mais Ta miséricorde est plus grande. Pardonne-moi par ma foi.`
};

MIROIR["20:74"] = {
  reference: "20:74",
  theme: ["châtiment", "audace", "réalité"],
  emotion: "Avertissement, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "At-Tahaddi"],
  mirrorVersion: `« Celui qui vient à son Seigneur en criminel aura l'Enfer. » Le miroir me montre la réalité du châtiment. Le criminel face à Allah. L'Enfer est sa destination. Le miroir m'interroge : comment viendrai-je à mon Seigneur ?`,
  reflection: `La comparution devant Allah peut être en criminel ou en croyant. Le choix appartient à chacun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu man ya'ti rabbahu mujriman fa-inna lahu jahannam » — Celui qui vient à son Seigneur en criminel aura l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment viendrai-je à mon Seigneur ? En criminel ou en croyant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le statut de criminel ou de croyant se décide ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La comparution est certaine — le statut est à choisir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se présente en croyant reçoit la miséricorde." }
  ],
  munajat: `Ya Rabb, je veux me présenter à Toi en croyant. Ne me laisse pas être criminel. Fais que ma comparution soit celle d'un serviteur fidèle.`
};

MIROIR["20:75"] = {
  reference: "20:75",
  theme: ["foi", "œuvres", "hauts rangs"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Ad-Darajat"],
  mirrorVersion: `« Celui qui vient à Lui en croyant aura les hauts rangs. » Le miroir me montre la promesse du croyant. La foi et les œuvres justes ouvrent les hauts rangs. La récompense est élevée. Le miroir m'interroge : mes œuvres correspondent-elles à ma foi ?`,
  reflection: `La foi sans œuvres est incomplète. Les hauts rangs demandent les deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man ya'tihi mu'minan qad 'amila al-salihati » — Celui qui vient à Lui en croyant, ayant fait les œuvres justes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes œuvres correspondent-elles à ma foi ? Suis-je en route vers les hauts rangs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les hauts rangs ne s'atteignent pas sans œuvres justes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque rang correspond à un niveau d'œuvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et agit bien atteint les hauts rangs." }
  ],
  munajat: `Ya Rabb, je veux les hauts rangs. Ma foi et mes œuvres doivent s'aligner. Fais que mes actes soient justes pour atteindre les sommets.`
};

MIROIR["20:76"] = {
  reference: "20:76",
  theme: ["jardins", "éternité", "demeure"],
  emotion: "Espérance, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Jannat", "Al-Khuld"],
  mirrorVersion: `« Jardins sous lesquels coulent les rivières. » Le miroir me montre la description du Paradis. Les Jardins, les rivières, l'éternité. La récompense finale. Le miroir m'interroge : est-ce que je désire ces Jardins ?`,
  reflection: `Le Paradis est la destination du croyant. Le désirer motive l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatu 'adnin tajri min tahtiha al-anharu » — Jardins d'Éden sous lesquels coulent les rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire ces Jardins ? Ma motivation est-elle le Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas un rêve — c'est une réalité promise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis existe et attend ses habitants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire le Paradis sincèrement y travaille." }
  ],
  munajat: `Ya Janna, je désire Tes Jardins. Les rivières et l'éternité m'attendent. Fais que je travaille pour cette destination.`
};

MIROIR["20:77"] = {
  reference: "20:77",
  theme: ["inspiration", "nuit", "passage"],
  emotion: "Confiance, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Layl"],
  mirrorVersion: `« Nous avons inspiré à Moïse : Pars de nuit avec Mes serviteurs. » Le miroir me montre la guidance par l'inspiration. La nuit, le voyage, les serviteurs. L'exode est guidé. Le miroir m'interroge : est-ce que je suis les inspirations d'Allah ?`,
  reflection: `L'inspiration d'Allah guide les mouvements. La nuit peut être le temps du passage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad awhayna ila musa an asri bi'ibadi » — Nous avons inspiré à Moïse : Pars de nuit avec Mes serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis les inspirations d'Allah ? Mon timing est-il guidé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit peut être le temps du passage — la lumière vient après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'inspiration divine guide les prophètes et les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit l'inspiration traverse les obstacles." }
  ],
  munajat: `Ya Wahy, inspire-moi mes mouvements. Je pars quand Tu dis de partir. Ma nuit devient passage vers la lumière.`
};

MIROIR["20:78"] = {
  reference: "20:78",
  theme: ["poursuite", "ennemi", "multitude"],
  emotion: "Tension, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Taba'", "Al-Adw"],
  mirrorVersion: `« Pharaon les poursuivit avec ses armées. » Le miroir me montre la poursuite inexorable. L'ennemi suit de près. La multitude contre le petit groupe. Le miroir m'interroge : est-ce que je fais confiance quand l'ennemi me poursuit ?`,
  reflection: `La poursuite de l'ennemi fait partie du chemin. La confiance en Allah doit rester.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-atba'ahum fir'awnu bi-junudihi » — Pharaon les poursuivit avec ses armées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance quand l'ennemi me poursuit ? Ma foi est-elle inébranlable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La multitude qui poursuit ne peut rien contre la protection d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La poursuite est l'épreuve finale avant le salut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est poursuivi pour Allah est protégé par Allah." }
  ],
  munajat: `Ya Hafiz, l'ennemi me poursuit. Mais Tu es ma protection. Fais que je ne craigne pas la multitude — Tu es plus grand.`
};

MIROIR["20:79"] = {
  reference: "20:79",
  theme: ["égarement", "guide", "responsabilité"],
  emotion: "Tristesse, réalité",
  difficulty: "débutant",
  relatedNames: ["Ad-Dalal", "Al-Huda"],
  mirrorVersion: `« Pharaon a égaré son peuple au lieu de le guider. » Le miroir me montre la responsabilité du dirigeant. Le mauvais dirigeant égare. La guidance est refusée. Le miroir m'interroge : est-ce que je suis un guide ou un égareur ?`,
  reflection: `La responsabilité du dirigeant est grande. Égarer est un crime contre les suivants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adalla fir'awnu qawmahu ma hada » — Pharaon a égaré son peuple au lieu de le guider." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un guide ou un égareur ? Ma responsabilité envers ceux qui me suivent est-elle claire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Égarer les autres est un crime — les guider est un honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque dirigeant est responsable de ceux qu'il guide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide vers le bien reçoit la récompense des guidés." }
  ],
  munajat: `Ya Hadi, fais que je sois un guide, pas un égareur. Ma responsabilité est grande. Guide-moi pour que je guide les autres.`
};

MIROIR["20:80"] = {
  reference: "20:80",
  theme: ["mer", "salut", "mémoire"],
  emotion: "Gratitude, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Bahr", "An-Najat"],
  mirrorVersion: `« Ô Enfants d'Israël, Nous vous avons sauvés de votre ennemi. » Le miroir me montre le rappel du salut. Le passage de la mer. Le salut de l'ennemi. Le miroir m'interroge : est-ce que je me souviens des fois où Allah m'a sauvé ?`,
  reflection: `Le salut passé est un rappel pour le présent. La gratitude suit le souvenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya bani isra'il anjaynakum min 'aduwwikum » — Ô Enfants d'Israël, Nous vous avons sauvés de votre ennemi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens des fois où Allah m'a sauvé ? Ma gratitude est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli du salut passé affaiblit la confiance présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque salut est un signe de la protection d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient des saluts passés s'attend à ceux à venir." }
  ],
  munajat: `Ya Najat, Tu m'as sauvé tant de fois. Je me souviens. Ma gratitude est constante. Continue à me sauver de mes ennemis.`
};

MIROIR["20:81"] = {
  reference: "20:81",
  theme: ["provision", "gratitude", "excellence"],
  emotion: "Gratitude, rappel",
  difficulty: "débutant",
  relatedNames: ["Ar-Rizq", "Al-Ihsan"],
  mirrorVersion: `« Mangez des bonnes choses que Nous vous avons accordées. » Le miroir me montre la permission de jouir. Les bonnes choses d'Allah. La gratitude et l'excellence. Le miroir m'interroge : est-ce que je jouis avec gratitude des bonnes choses ?`,
  reflection: `La provision d'Allah est bonne. La gratitude l'accompagne naturellement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu min tayyibati ma razaqnakum » — Mangez des bonnes choses que Nous vous avons accordées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jouis avec gratitude des bonnes choses ? Ou est-ce que je les prends pour acquises ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La consommation sans gratitude est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bonnes choses d'Allah sont faites pour être appréciées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange avec gratitude reçoit plus de bonnes choses." }
  ],
  munajat: `Ya Razzaq, je mange Tes bonnes provisions avec gratitude. Ne me laisse pas les prendre pour acquises. Fais que chaque bouchée soit un remerciement.`
};

MIROIR["20:82"] = {
  reference: "20:82",
  theme: ["pardon", "condition", "miséricorde"],
  emotion: "Espérance, encouragement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "At-Tawbah"],
  mirrorVersion: `« Je pardonne à celui qui se repent, croit et fait le bien. » Le miroir me montre les conditions du pardon. Le repentir, la foi, les œuvres justes. Le pardon suit ces conditions. Le miroir m'interroge : ai-je rempli ces conditions ?`,
  reflection: `Le pardon d'Allah a des conditions. Les remplir assure la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inni la-ghaffarun liman taba wa amana wa 'amila salihan » — Je pardonne à celui qui se repent, croit et fait le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je rempli ces conditions ? Mon repentir, ma foi, mes œuvres sont-ils alignés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les conditions ne sont pas des obstacles — ce sont des chemins." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pardon d'Allah est vaste et accessible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remplit les conditions reçoit le pardon." }
  ],
  munajat: `Ya Ghafur, je me repens, je crois, j'agis bien. Pardonne-moi selon Tes conditions. Fais que ma vie soit alignée sur Ton pardon.`
};

MIROIR["20:83"] = {
  reference: "20:83",
  theme: ["question", "hâte", "rendez-vous"],
  emotion: "Tendresse, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Mi'ad", "Al-Mahabbah"],
  mirrorVersion: `« Qu'est-ce qui t'a fait hâter de quitter ton peuple ? » Le miroir me montre la question d'Allah à Moïse. La hâte pour le rendez-vous divin. L'amour presse. Le miroir m'interroge : qu'est-ce qui me presse vers Allah ?`,
  reflection: `La hâte vers Allah est un signe d'amour. Le rendez-vous divin attire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma a'jalaka 'an qawmika ya musa » — Qu'est-ce qui t'a fait hâter de quitter ton peuple, Moïse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me presse vers Allah ? Mon amour pour Lui est-il pressant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La hâte vers Allah est une hâte bénie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rendez-vous avec Allah attire ceux qui L'aiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se hâte vers Allah est attendu avec amour." }
  ],
  munajat: `Ya Rabb, je me hâte vers Toi. Ton rendez-vous m'attire. Fais que ma hâte soit un signe de mon amour pour Toi.`
};

MIROIR["20:84"] = {
  reference: "20:84",
  theme: ["hâte", "satisfaction", "dévotion"],
  emotion: "Amour, dévotion",
  difficulty: "débutant",
  relatedNames: ["As-Sur'ah", "Ar-Rida"],
  mirrorVersion: `« Ils me suivent, et je me suis hâté vers Toi pour être satisfait. » Le miroir me montre la réponse de Moïse. La hâte pour la satisfaction d'Allah. Le peuple suit. Le miroir m'interroge : quelle est ma motivation dans ma hâte ?`,
  reflection: `La hâte pour la satisfaction d'Allah est la meilleure motivation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hum talaiya wa ja'tu ilayka ya rabbu li-tarda » — Ils me suivent, et je me suis hâté vers Toi, Seigneur, pour être satisfait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma motivation dans ma hâte ? Est-ce pour être satisfait par Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction d'Allah vaut toute hâte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ceux qui se hâtent vers la satisfaction d'Allah sont satisfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la satisfaction d'Allah la trouve." }
  ],
  munajat: `Ya Razi, je me hâte vers Toi pour être satisfait. Ta satisfaction est mon but. Fais que ma hâte soit motivée par Ton amour.`
};

MIROIR["20:85"] = {
  reference: "20:85",
  theme: ["épreuve", "séduction", "égarement"],
  emotion: "Avertissement, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Fitnah", "As-Samiri"],
  mirrorVersion: `« Nous avons mis ton peuple à l'épreuve après ton départ. » Le miroir me montre l'épreuve de l'absence. Le guide parti, le peuple éprouvé. La séduction du Samiri. Le miroir m'interroge : comment je me comporte quand le guide est absent ?`,
  reflection: `L'absence du guide est une épreuve. La fidélité est testée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qula inna fatannna qawmaka min ba'dika » — Nous avons mis ton peuple à l'épreuve après ton départ." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me comporte quand le guide est absent ? Ma fidélité résiste-t-elle à l'épreuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve de l'absence révèle la foi vraie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'absence du guide est un test universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste fidèle en l'absence du guide est sincère." }
  ],
  munajat: `Ya Rabb, l'absence du guide m'éprouve. Fais que je reste fidèle. L'épreuve ne doit pas m'égarer. Ma foi est en Toi, pas seulement dans le guide.`
};

MIROIR["20:86"] = {
  reference: "20:86",
  theme: ["retour", "colère", "déception"],
  emotion: "Colère, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ghadab", "Al-Huzn"],
  mirrorVersion: `« Moïse retourna vers son peuple, colère et triste. » Le miroir me montre la réaction de Moïse. La colère et la tristesse mélangées. La déception du guide. Le miroir m'interroge : comment réagis-je à la déception de ceux qui me suivent ?`,
  reflection: `La déception du peuple blesse le guide. La colère et la tristesse sont naturelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faraja'a musa ila qawmihi ghadbana asifan » — Moïse retourna vers son peuple, colère et triste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je à la déception de ceux qui me suivent ? Ma colère est-elle justifiée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La colère du guide est une colère pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La déception des suivants est l'épreuve du guide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide avec patience supporte la déception." }
  ],
  munajat: `Ya Rabb, la déception m'atteint. Ma colère est pour Toi. Fais que je ne désespère pas de ceux qui me suivent. La patience est ma réponse.`
};

MIROIR["20:87"] = {
  reference: "20:87",
  theme: ["excuse", "bijoux", "tentation"],
  emotion: "Regret, justification",
  difficulty: "débutant",
  relatedNames: ["Al-Udhr", "Az-Zinah"],
  mirrorVersion: `« Nous n'avons pas rompu notre promesse par choix. » Le miroir me montre l'excuse du peuple. La rupture involontaire. La tentation des bijoux. Le miroir m'interroge : quelles excuses avancé-je pour mes manquements ?`,
  reflection: `Les excuses peuvent cacher la vraie responsabilité. La tentation est une réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ma akhlafna maw'idaka bi-malikina » — Nous n'avons pas rompu notre promesse par choix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles excuses avancé-je pour mes manquements ? Sont-elles valides ou des fuites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse sincère est acceptée — l'excuse mensongère est rejetée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La tentation teste les engagements." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa faute sans excuse reçoit le pardon." }
  ],
  munajat: `Ya Rabb, je reconnais mes fautes sans fausses excuses. La tentation m'a atteint mais je reviens à Toi. Pardonne ma faiblesse.`
};

MIROIR["22:28"] = {
  reference: "22:28",
  theme: ["pèlerinage", "bénédiction", "provision"],
  emotion: "Gratitude, dévotion",
  difficulty: "débutant",
  relatedNames: ["Al-Hajj", "Al-Rizq"],
  mirrorVersion: `« Pour assister à des bienfaits qui leur profitent. » Le miroir me montre les bienfaits du pèlerinage. « Li-yashhadu manafi'a lahum » — pour assister à des bienfaits qui leur profitent. « Wa yadhkuru isma Allahi » — et invoquer le nom d'Allah. Le pèlerinage apporte des bienfaits. Le miroir m'interroge : est-ce que je recherche les bienfaits d'Allah ?`,
  reflection: `Le pèlerinage apporte des bienfaits matériels et spirituels. Les rechercher avec gratitude est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yashhadu manafi'a lahum wa yadhkuru isma Allahi » — pour assister à des bienfaits qui leur profitent et invoquer le nom d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recherche les bienfaits d'Allah ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bienfaits d'Allah sont partout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pèlerinage rassemble les croyants dans les bienfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les bienfaits en reçoit plus." }
  ],
  munajat: `Ya Rabb, je reconnais Tes bienfaits. Ne permets pas l'ingratitude. Multiplie Tes bénédictions sur moi.`
};

MIROIR["22:29"] = {
  reference: "22:29",
  theme: ["rituel", "offrande", "purification"],
  emotion: "Dévotion, purification",
  difficulty: "débutant",
  relatedNames: ["Al-Nusuk", "Al-Hady"],
  mirrorVersion: `« Puis qu'ils mettent fin à leur état de sacralité. » Le miroir me montre l'accomplissement du rituel. « Thumma l-yaqdu tafathahum » — puis qu'ils mettent fin à leur état de sacralité. « Wa l-yufu nuzurahum » — et qu'ils accomplissent leurs vœux. Le rituel se termine par l'accomplissement. Le miroir m'interroge : est-ce que j'accomplis mes vœux ?`,
  reflection: `Accomplir les vœux est essentiel. Le rituel complet comprend la promesse et son accomplissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma l-yaqdu tafathahum wa l-yufu nuzurahum » — puis qu'ils mettent fin à leur état de sacralité et qu'ils accomplissent leurs vœux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accomplis mes vœux ? Ou est-ce que je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vœu non accompli est une dette envers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'accomplissement des vœux honore Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accomplit ses vœux est béni." }
  ],
  munajat: `Ya Rabb, j'accomplis mes vœux. Ne permets pas la négligence. Accepte mon accomplissement et bénis-moi.`
};

MIROIR["22:30"] = {
  reference: "22:30",
  theme: ["interdits", "sacralité", "respect"],
  emotion: "Révérence, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hurumat", "Al-Taqwa"],
  mirrorVersion: `« Cela, et quiconque respecte les choses sacrées d'Allah. » Le miroir me montre le respect des interdits. « Dhalika wa man yu'azzim hurumati Allahi » — cela, et quiconque respecte les choses sacrées d'Allah. « Fa-huwa khayrun lahu 'inda rabbih » — c'est mieux pour lui auprès de son Seigneur. Le respect apporte le bien. Le miroir m'interroge : est-ce que je respecte les interdits d'Allah ?`,
  reflection: `Respecter les interdits d'Allah est un acte de piété. Ce respect apporte le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika wa man yu'azzim hurumati Allahi fa-huwa khayrun lahu 'inda rabbih » — cela, et quiconque respecte les choses sacrées d'Allah, c'est mieux pour lui auprès de son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les interdits d'Allah ? Ou est-ce que je les transgresse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des interdits est un signe de piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les interdits d'Allah protègent l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les interdits est honoré par Allah." }
  ],
  munajat: `Ya Rabb, je respecte Tes interdits. Ne permets pas la transgression. Honore-moi par mon respect de Tes sacralités.`
};

MIROIR["22:31"] = {
  reference: "22:31",
  theme: ["association", "pureté", "chute"],
  emotion: "Vigilance, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Tawhid", "Al-Shirk"],
  mirrorVersion: `« Sans rien Lui associer. » Le miroir me montre l'unicité pure. « Hunafa'a lillahi ghayra mushrikina bihi » — sans rien Lui associer. « Wa man yushrik bi-allahi fa-ka'anna kharra mina al-sama'i » — quiconque associe à Allah, c'est comme s'il tombait du ciel. L'association est une chute. Le miroir m'interroge : est-ce que je suis sans association ?`,
  reflection: `L'association est une chute mortelle. Rester pur de toute association est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hunafa'a lillahi ghayra mushrikina bihi wa man yushrik bi-allahi fa-ka'anna kharra mina al-sama'i » — sans rien Lui associer. Quiconque associe à Allah, c'est comme s'il tombait du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis sans association ? Ou est-ce que j'associe inconsciemment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'association est une chute spirituelle mortelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est le fondement de la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste pur de l'association est sauvé." }
  ],
  munajat: `Ya Rabb, garde-moi pur de toute association. Ne permets pas la chute. Protège mon unicité et ma foi.`
};

MIROIR["22:32"] = {
  reference: "22:32",
  theme: ["sacrifices", "respect", "dévotion"],
  emotion: "Révérence, dévotion",
  difficulty: "débutant",
  relatedNames: ["Al-Nusuk", "Al-Ta'zim"],
  mirrorVersion: `« Cela, et quiconque respecte les rites d'Allah. » Le miroir me montre le respect des rites. « Dhalika wa man yu'azzim sha'a'ira Allahi » — cela, et quiconque respecte les rites d'Allah. « Fa-innaha min taqwa al-qulub » — c'est certes la piété des cœurs. Le respect vient du cœur. Le miroir m'interroge : est-ce que mon cœur respecte les rites ?`,
  reflection: `Le respect des rites vient de la piété du cœur. Honorer les symboles d'Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika wa man yu'azzim sha'a'ira Allahi fa-innaha min taqwa al-qulub » — cela, et quiconque respecte les rites d'Allah, c'est certes la piété des cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon cœur respecte les rites ? Ou est-ce que je les pratique mécaniquement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect des rites reflète la piété du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les rites d'Allah unissent les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les rites avec son cœur est pieux." }
  ],
  munajat: `Ya Rabb, mon cœur respecte Tes rites. Ne permets pas la mécanicité. Fais que ma pratique soit empreinte de piété.`
};

MIROIR["22:33"] = {
  reference: "22:33",
  theme: ["bêtes", "bienfaits", "utilisation"],
  emotion: "Gratitude, utilisation",
  difficulty: "débutant",
  relatedNames: ["Al-Budn", "Al-Manafi'"],
  mirrorVersion: `« Vous en retirez des bienfaits jusqu'à un terme fixé. » Le miroir me montre l'utilité des sacrifices. « Lakum fiha manafi'u ila ajalin musamman » — vous en retirez des bienfaits jusqu'à un terme fixé. « Thumma mahilluha ila al-bayti al-'atiq » — puis leur lieu d'immolation est auprès de la Maison ancienne. Les bienfaits ont un terme. Le miroir m'interroge : est-ce que j'utilise les bienfaits d'Allah correctement ?`,
  reflection: `Les bienfaits ont un terme et un but. Les utiliser correctement et avec gratitude est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakum fiha manafi'u ila ajalin musamman thumma mahilluha ila al-bayti al-'atiq » — vous en retirez des bienfaits jusqu'à un terme fixé. Puis leur lieu d'immolation est auprès de la Maison ancienne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise les bienfaits d'Allah correctement ? Ou est-ce que je les gaspille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bienfaits sont pour un temps limité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les bienfaits ont un but et une fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise les bienfaits correctement en reçoit plus." }
  ],
  munajat: `Ya Rabb, j'utilise Tes bienfaits correctement. Ne permets pas le gaspillage. Guide-moi dans leur utilisation.`
};

MIROIR["22:34"] = {
  reference: "22:34",
  theme: ["sacrifice", "communauté", "soumission"],
  emotion: "Soumission, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Dhabh", "Al-Ummah"],
  mirrorVersion: `« À chaque communauté, Nous avons assigné un rite sacrificiel. » Le miroir me montre la diversité des rites. « Wa likulli ummatin ja'alna mansakan » — à chaque communauté, Nous avons assigné un rite sacrificiel. « Li-yadhkuru isma Allahi 'ala ma razaqahum » — pour qu'ils invoquent le nom d'Allah sur ce qu'Il leur a donné. Le sacrifice est un rappel. Le miroir m'interroge : est-ce que je sacrifie avec le rappel d'Allah ?`,
  reflection: `Le sacrifice est un rappel d'Allah sur Ses bienfaits. L'accomplir avec conscience est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa likulli ummatin ja'alna mansakan li-yadhkuru isma Allahi 'ala ma razaqahum » — à chaque communauté, Nous avons assigné un rite sacrificiel pour qu'ils invoquent le nom d'Allah sur ce qu'Il leur a donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sacrifie avec le rappel d'Allah ? Ou est-ce que je le fais par habitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice sans rappel est vide de sens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sacrifice unit les communautés dans la soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sacrifie avec le rappel reçoit la bénédiction." }
  ],
  munajat: `Ya Rabb, je sacrifie avec Ton rappel. Ne permets pas l'habitude. Fais que mon sacrifice soit un acte de conscience.`
};

MIROIR["22:35"] = {
  reference: "22:35",
  theme: ["crainte", "cœur", "patience"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khashyah", "As-Sabr"],
  mirrorVersion: `« Ceux dont les cœurs frémissent quand Allah est mentionné. » Le miroir me montre la crainte du cœur. « Alladhina idha dhukira Allahu wajilat qulubuhum » — ceux dont les cœurs frémissent quand Allah est mentionné. « Wa al-sabirina 'ala ma asabahum » — et qui patientent face à ce qui les atteint. La crainte et la patience sont liées. Le miroir m'interroge : mon cœur frémit-il quand Allah est mentionné ?`,
  reflection: `La crainte du cœur est le signe de la foi vivante. La patience face aux épreuves est son fruit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina idha dhukira Allahu wajilat qulubuhum wa al-sabirina 'ala ma asabahum » — ceux dont les cœurs frémissent quand Allah est mentionné et qui patientent face à ce qui les atteint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur frémit-il quand Allah est mentionné ? Ou est-il endurci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur qui frémit est un cœur vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte d'Allah est la marque des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur frémit est proche d'Allah." }
  ],
  munajat: `Ya Rabb, fais que mon cœur frémisse à Ton rappel. Ne permets pas l'endurcissement. Vivifie mon cœur par Ta crainte.`
};

MIROIR["22:36"] = {
  reference: "22:36",
  theme: ["chameaux", "sacrifice", "rappel"],
  emotion: "Dévotion, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Budn", "Adh-Dhikr"],
  mirrorVersion: `« Et Nous avons fait pour vous des chameaux une chose sacrée. » Le miroir me montre le sacrifice des chameaux. « Wa al-budna ja'alnaha lakum min sha'a'iri Allahi » — et Nous avons fait pour vous des chameaux une chose sacrée. « Lakum fiha khayrun » — vous y trouvez un bien. Le sacrifice apporte le bien. Le miroir m'interroge : est-ce que je comprends la valeur du sacrifice ?`,
  reflection: `Le sacrifice est un rite sacré qui apporte le bien. Le comprendre et l'accomplir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-budna ja'alnaha lakum min sha'a'iri Allahi lakum fiha khayrun » — et Nous avons fait pour vous des chameaux une chose sacrée. Vous y trouvez un bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la valeur du sacrifice ? Ou est-ce que je le vois comme une perte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice n'est pas une perte, c'est un investissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sacrifice unit le croyant à son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la valeur du sacrifice en retire le bien." }
  ],
  munajat: `Ya Rabb, je comprends la valeur du sacrifice. Ne permets pas la vision de perte. Bénis mon sacrifice et accepte-le.`
};

MIROIR["22:37"] = {
  reference: "22:37",
  theme: ["chair", "sang", "piété"],
  emotion: "Pureté, sincérité",
  difficulty: "débutant",
  relatedNames: ["At-Taqwa", "Al-Qulub"],
  mirrorVersion: `« Ni leur chair ni leur sang n'atteindront Allah, mais ce qui L'atteint de vous, c'est la piété. » Le miroir me montre l'essence du sacrifice. « Lan yanala Allaha luhumuha wa la dima'uha » — ni leur chair ni leur sang n'atteindront Allah. « Wa lakin yanaluhu al-taqwa minkum » — mais ce qui L'atteint, c'est la piété. L'intention compte. Le miroir m'interroge : est-ce que ma piété atteint Allah ?`,
  reflection: `Le sacrifice extérieur ne vaut rien sans la piété intérieure. La sincérité est l'essence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan yanala Allaha luhumuha wa la dima'uha wa lakin yanaluhu al-taqwa minkum » — ni leur chair ni leur sang n'atteindront Allah, mais ce qui L'atteint de vous, c'est la piété." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma piété atteint Allah ? Ou est-ce que je me contente de l'apparence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apparence sans la piété est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah regarde les cœurs, pas les apparences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui offre la piété atteint Allah." }
  ],
  munajat: `Ya Rabb, ma piété T'atteint. Ne permets pas l'apparence vide. Accepte mon sacrifice par ma sincérité.`
};

MIROIR["22:38"] = {
  reference: "22:38",
  theme: ["protection", "croyants", "trahison"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Hifz", "Al-Mu'minun"],
  mirrorVersion: `« Certes, Allah défend ceux qui ont cru. » Le miroir me montre la protection divine. « Inna Allaha yuda'u 'ani alladhina amanu » — certes, Allah défend ceux qui ont cru. « Inna Allaha la yuhibbu kulla khawwan kafur » — Allah n'aime pas tout traître ingrat. La protection est pour les croyants fidèles. Le miroir m'interroge : suis-je parmi les protégés ?`,
  reflection: `Allah protège les croyants fidèles. Être fidèle est essentiel pour recevoir Sa protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha yuda'u 'ani alladhina amanu inna Allaha la yuhibbu kulla khawwan kafur » — certes, Allah défend ceux qui ont cru. Allah n'aime pas tout traître ingrat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les protégés ? Ou est-ce que je suis traître et ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection divine est pour les croyants fidèles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Protecteur des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est fidèle est protégé par Allah." }
  ],
  munajat: `Ya Rabb, je suis fidèle. Ne permets pas la trahison. Protège-moi par Ta défense.`
};

MIROIR["22:39"] = {
  reference: "22:39",
  theme: ["permission", "combat", "défense"],
  emotion: "Détermination, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Qital", "Ad-Difa'"],
  mirrorVersion: `« Autorisation est donnée à ceux qui sont attaqués de se défendre. » Le miroir me montre la permission du combat défensif. « Udhina li-alladhina yuqataluna bi-annahum zulimu » — autorisation est donnée à ceux qui sont attaqués parce qu'ils ont été lésés. La défense est permise. Le miroir m'interroge : est-ce que je comprends la justice de la défense ?`,
  reflection: `La défense contre l'agression est un droit. Comprendre cette permission est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udhina li-alladhina yuqataluna bi-annahum zulimu » — autorisation est donnée à ceux qui sont attaqués parce qu'ils ont été lésés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la justice de la défense ? Ou est-ce que je la refuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défense est un droit, pas un crime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice permet la défense contre l'agression." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la justice défend le droit." }
  ],
  munajat: `Ya Rabb, je comprends la justice de la défense. Ne permets pas l'injustice. Donne-moi la force de défendre le droit.`
};

MIROIR["22:40"] = {
  reference: "22:40",
  theme: ["expulsion", "défense", "lieux"],
  emotion: "Justice, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Masajid", "Ad-Dikr"],
  mirrorVersion: `« Ceux qui ont été expulsés de leurs demeures sans droit. » Le miroir me montre l'injustice de l'expulsion. « Alladhina ukhriju min diyarihim bi-ghayri haqqin » — ceux qui ont été expulsés de leurs demeures sans droit. « Illa an yaqulu rabbuna Allah » — seulement parce qu'ils disent : notre Seigneur est Allah. La foi est la cause de la persécution. Le miroir m'interroge : est-ce que je défends les lieux de culte ?`,
  reflection: `Les croyants ont été persécutés pour leur foi. Défendre les lieux de culte est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina ukhriju min diyarihim bi-ghayri haqqin illa an yaqulu rabbuna Allah » — ceux qui ont été expulsés de leurs demeures sans droit, seulement parce qu'ils disent : notre Seigneur est Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défends les lieux de culte ? Ou est-ce que je les abandonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les lieux de culte méritent d'être protégés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mosquées, les églises, les synagogues et les temples sont dignes de protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend les lieux de culte défend la liberté de croyance." }
  ],
  munajat: `Ya Rabb, je défends les lieux de culte. Ne permets pas l'abandon. Protège tous les lieux où Ton nom est invoqué.`
};

MIROIR["22:41"] = {
  reference: "22:41",
  theme: ["victoire", "établissement", "prière"],
  emotion: "Espérance, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nasr", "As-Salah"],
  mirrorVersion: `« Ceux qui, si Nous les établissions sur la terre, accompliraient la prière. » Le miroir me montre la responsabilité de la victoire. « Alladhina in makkannahum fi al-ardi aqamu al-salata » — ceux qui, si Nous les établissions sur la terre, accompliraient la prière. « Wa amaru bi-al-ma'ruf » — ordonneraient le convenable. La victoire implique la responsabilité. Le miroir m'interroge : est-ce que je suis prêt pour cette responsabilité ?`,
  reflection: `La victoire implique la responsabilité d'établir la justice et la prière. Être prêt est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina in makkannahum fi al-ardi aqamu al-salata wa amaru bi-al-ma'ruf » — ceux qui, si Nous les établissions sur la terre, accompliraient la prière et ordonneraient le convenable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour cette responsabilité ? Ou est-ce que je la néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire sans responsabilité est dangereuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'établissement sur la terre est un test." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour la responsabilité reçoit la victoire." }
  ],
  munajat: `Ya Rabb, je suis prêt pour la responsabilité. Ne permets pas la négligence. Établis-moi sur la terre avec justice.`
};

MIROIR["22:42"] = {
  reference: "22:42",
  theme: ["négation", "communautés", "messagers"],
  emotion: "Patience, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Takdhib", "Ar-Rusul"],
  mirrorVersion: `« Et s'ils te traitent de menteur, avant eux, le peuple de Noé, les 'Ad et les Thamud ont traité de menteurs. » Le miroir me montre l'histoire de la négation. « Wa in yukadhdhibuka fa-qad kadhdhaba qablahum qawmu Nuhin wa 'Adun wa Thamud » — s'ils te traitent de menteur, avant eux, le peuple de Noé, les 'Ad et les Thamud ont traité de menteurs. La négation est une tradition. Le miroir m'interroge : est-ce que je patiente face à la négation ?`,
  reflection: `La négation est une tradition des peuples précédents. Patienter est essentiel pour le prophète et le croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yukadhdhibuka fa-qad kadhdhaba qablahum qawmu Nuhin wa 'Adun wa Thamud » — s'ils te traitent de menteur, avant eux, le peuple de Noé, les 'Ad et les Thamud ont traité de menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente face à la négation ? Ou est-ce que je me décourage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation des mécréants ne change pas la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous été niés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente face à la négation est victorieux." }
  ],
  munajat: `Ya Rabb, je patiente face à la négation. Ne permets pas le découragement. Donne-moi la constance des prophètes.`
};

MIROIR["22:43"] = {
  reference: "22:43",
  theme: ["négation", "Abraham", "Lot"],
  emotion: "Patience, constance",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Lut"],
  mirrorVersion: `« Et le peuple d'Abraham et le peuple de Lot. » Le miroir me montre la continuité de la négation. « Wa qawmu Ibrahima wa qawmu Lut » — et le peuple d'Abraham et le peuple de Lot. Les grands prophètes ont été niés. Le miroir m'interroge : est-ce que j'accepte d'être nié pour la vérité ?`,
  reflection: `Les peuples d'Abraham et de Lot ont nié la vérité. Accepter d'être nié pour la vérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qawmu Ibrahima wa qawmu Lut » — et le peuple d'Abraham et le peuple de Lot." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte d'être nié pour la vérité ? Ou est-ce que je compromets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être nié pour la vérité est l'honneur du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La négation accompagne la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte d'être nié pour la vérité est justifié." }
  ],
  munajat: `Ya Rabb, j'accepte d'être nié pour Ta vérité. Ne permets pas le compromis. Honore-moi par la fidélité.`
};

MIROIR["22:44"] = {
  reference: "22:44",
  theme: ["négation", "résidence", "délai"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Madina", "Al-Muhaymin"],
  mirrorVersion: `« Et les habitants de Madyan. Moïse aussi a été traité de menteur. » Le miroir me montre la persistance de la négation. « Wa ashabu Madyana wa kudhdhiba Musa » — et les habitants de Madyan. Moïse aussi a été traité de menteur. « Fa aghwaytu lil-kafirina » — J'ai ensuite donné un délai aux mécréants. Le délai précède le châtiment. Le miroir m'interroge : est-ce que je comprends le délai d'Allah ?`,
  reflection: `Le délai d'Allah est une opportunité pour le repentir. Ne pas l'abuser est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ashabu Madyana wa kudhdhiba Musa fa aghwaytu lil-kafirina » — et les habitants de Madyan. Moïse aussi a été traité de menteur. J'ai ensuite donné un délai aux mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends le délai d'Allah ? Ou est-ce que je l'interprète comme une approbation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde qui précède le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le délai d'Allah est une opportunité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le délai se repent avant qu'il ne soit trop tard." }
  ],
  munajat: `Ya Rabb, je comprends Ton délai. Ne permets pas l'abus. Donne-moi de me repentir avant que le délai ne s'achève.`
};

MIROIR["22:45"] = {
  reference: "22:45",
  theme: ["destruction", "cités", "injustice"],
  emotion: "Vigilance, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Qura", "Al-Halak"],
  mirrorVersion: `« Que de cités Nous avons fait périr, parce qu'elles étaient injustes ! » Le miroir me montre la destruction des injustes. « Fa-ka'ayyin min qaryatin ahlaknaha wa hiya zalimah » — que de cités Nous avons fait périr, parce qu'elles étaient injustes ! « Fa hiya khawiyatun 'ala 'urushiha » — elles sont maintenant vides sur leurs toits effondrés. L'injustice mène à la ruine. Le miroir m'interroge : est-ce que j'évite l'injustice ?`,
  reflection: `L'injustice mène à la destruction. L'éviter est essentiel pour la survie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ka'ayyin min qaryatin ahlaknaha wa hiya zalimah fa hiya khawiyatun 'ala 'urushiha » — que de cités Nous avons fait périr, parce qu'elles étaient injustes ! Elles sont maintenant vides sur leurs toits effondrés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite l'injustice ? Ou est-ce que je la pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice est la cause de la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ruines témoignent de la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'injustice évite la destruction." }
  ],
  munajat: `Ya Rabb, j'évite l'injustice. Ne permets pas l'oppression. Préserve-moi du sort des injustes.`
};

MIROIR["22:47"] = {
  reference: "22:47",
  theme: ["hâte", "promesse", "compteur"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Ajalah", "Al-Wa'd"],
  mirrorVersion: `« Et ils te demandent de hâter le châtiment. » Le miroir me montre l'impatience des mécréants. « Wa yasta'jilunaka bi-al-'adhab » — ils te demandent de hâter le châtiment. « Wa lan yukhlifa Allahu wa'dahu » — Allah ne manquera jamais à Sa promesse. La promesse est certaine. Le miroir m'interroge : est-ce que j'ai confiance en la promesse d'Allah ?`,
  reflection: `La promesse d'Allah est certaine. Avoir confiance même quand le délai est long est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yasta'jilunaka bi-al-'adhab wa lan yukhlifa Allahu wa'dahu » — ils te demandent de hâter le châtiment. Allah ne manquera jamais à Sa promesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai confiance en la promesse d'Allah ? Ou est-ce que je doute à cause du délai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai ne signifie pas l'oubli." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah accomplit toujours Sa promesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a confiance en la promesse patiente." }
  ],
  munajat: `Ya Rabb, j'ai confiance en Ta promesse. Ne permets pas le doute. Accomplis Ta promesse quand Tu le veux.`
};

MIROIR["22:48"] = {
  reference: "22:48",
  theme: ["délai", "cités", "saisie"],
  emotion: "Vigilance, réalisme",
  difficulty: "débutant",
  relatedNames: ["Al-Muhlat", "Al-Akhdh"],
  mirrorVersion: `« Et que de cités J'ai donné un délai, alors qu'elles étaient injustes ! » Le miroir me montre le délai avant la saisie. « Wa ka'ayyin min qaryatin amlaytu laha wa hiya zalimah » — que de cités J'ai donné un délai, alors qu'elles étaient injustes ! « Thumma akhadhtuha » — puis Je les ai saisies. Le délai a une fin. Le miroir m'interroge : est-ce que je profite du délai pour me repentir ?`,
  reflection: `Le délai a une fin. En profiter pour se repentir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ka'ayyin min qaryatin amlaytu laha wa hiya zalimah thumma akhadhtuha » — que de cités J'ai donné un délai, alors qu'elles étaient injustes ! Puis Je les ai saisies." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je profite du délai pour me repentir ? Ou est-ce que je m'y complais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une opportunité, pas une sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La saisie d'Allah est inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui profite du délai pour se repentir est sauvé." }
  ],
  munajat: `Ya Rabb, je profite de Ton délai pour me repentir. Ne permets pas la complaisance. Accepte mon repentir avant la saisie.`
};

MIROIR["22:49"] = {
  reference: "22:49",
  theme: ["avertissement", "clarification", "mission"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Bashir"],
  mirrorVersion: `« Dis : ô hommes, je suis pour vous un avertisseur explicite. » Le miroir me montre la clarté de la mission. « Qul ya ayyuha al-nasu innama ana lakum nadhirun mubin » — je suis pour vous un avertisseur explicite. La mission est claire. Le miroir m'interroge : est-ce que je comprends l'avertissement ?`,
  reflection: `L'avertissement est explicite. Le comprendre et y répondre est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ayyuha al-nasu innama ana lakum nadhirun mubin » — dis : ô hommes, je suis pour vous un avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends l'avertissement ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement explicite n'a pas d'excuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est pour tous les hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'avertissement se sauve." }
  ],
  munajat: `Ya Rabb, je comprends Ton avertissement. Ne permets pas l'ignorance. Sauve-moi par ma réponse à Ton avertissement.`
};

MIROIR["22:50"] = {
  reference: "22:50",
  theme: ["pardon", "récompense", "croyants"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Maghfirah", "Al-Rizq"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, ils ont pardon et récompense généreuse. » Le miroir me montre la récompense des croyants. « Fa alladhina amanu wa 'amilu al-salihati lahum maghfiratun wa rizqun karim » — ils ont pardon et récompense généreuse. La foi et les œuvres mènent au pardon. Le miroir m'interroge : est-ce que j'oeuvre pour cette récompense ?`,
  reflection: `La foi et les œuvres mènent au pardon et à la récompense. Oeuvrer pour cette fin est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa alladhina amanu wa 'amilu al-salihati lahum maghfiratun wa rizqun karim » — ceux qui croient et font de bonnes œuvres, ils ont pardon et récompense généreuse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'oeuvre pour cette récompense ? Ou est-ce que je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon suit la foi et les œuvres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense d'Allah est généreuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui oeuvre pour la récompense la reçoit." }
  ],
  munajat: `Ya Rabb, j'oeuvre pour Ta récompense. Ne permets pas la négligence. Accorde-moi le pardon et la récompense généreuse.`
};

MIROIR["22:51"] = {
  reference: "22:51",
  theme: ["égarer", "effort", "châtiment"],
  emotion: "Vigilance, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'aridun", "An-Nar"],
  mirrorVersion: `« Et ceux qui s'efforcent de rendre vains Nos signes, ceux-là seront les gens de la Fournaise. » Le miroir me montre le sort de ceux qui s'opposent. « Wa alladhina sa'u fi ayatina mu'ajizina ula'ika ashabu al-jahim » — ceux qui s'efforcent de rendre vains Nos signes, ceux-là seront les gens de la Fournaise. L'opposition mène au feu. Le miroir m'interroge : est-ce que je m'efforce de soutenir les signes d'Allah ?`,
  reflection: `S'opposer aux signes d'Allah mène au feu. Les soutenir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina sa'u fi ayatina mu'ajizina ula'ika ashabu al-jahim » — ceux qui s'efforcent de rendre vains Nos signes, ceux-là seront les gens de la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'efforce de soutenir les signes d'Allah ? Ou est-ce que je m'y oppose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'opposition aux signes d'Allah est un chemin vers le feu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont pour la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soutient les signes d'Allah est guidé." }
  ],
  munajat: `Ya Rabb, je soutiens Tes signes. Ne permets pas l'opposition. Guide-moi par Tes signes.`
};

MIROIR["22:52"] = {
  reference: "22:52",
  theme: ["prophète", "tentation", "abolition"],
  emotion: "Réconfort, protection",
  difficulty: "débutant",
  relatedNames: ["Ar-Rusul", "An-Nas"],
  mirrorVersion: `« Nous n'avons envoyé avant toi ni messager ni prophète sans que le démon n'ait tenté de semer le doute. » Le miroir me montre la tentation universelle. « Wa ma arsalna min qablika min rasulin wa la nabiyyin illa idha tamanna alqa al-shaytanu fi umniyyatihi » — le démon tente de semer le doute dans les aspirations de chaque prophète. La tentation est universelle. Le miroir m'interroge : est-ce que je résiste à la tentation ?`,
  reflection: `La tentation est universelle. Y résister avec l'aide d'Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna min qablika min rasulin wa la nabiyyin illa idha tamanna alqa al-shaytanu fi umniyyatihi » — Nous n'avons envoyé avant toi ni messager ni prophète sans que le démon n'ait tenté de semer le doute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je résiste à la tentation ? Ou est-ce que je cède ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tentation est l'arme du démon contre tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Même les prophètes ont été tentés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui résiste à la tentation avec Allah est victorieux." }
  ],
  munajat: `Ya Rabb, aide-moi à résister à la tentation. Ne permets pas la faiblesse. Protège-moi des suggestions du démon.`
};

MIROIR["22:53"] = {
  reference: "22:53",
  theme: ["tentation", "épreuve", "guérison"],
  emotion: "Compréhension, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Fitnah", "Ash-Shifa'"],
  mirrorVersion: `« Afin qu'Allah fasse de ce que suggère le démon une épreuve. » Le miroir me montre le but de la tentation. « Li-yaj'ala ma yulqi al-shaytanu fitnah » — afin qu'Allah fasse de ce que suggère le démon une épreuve. « Fa yashfa Allahu ma fi qulubihim » — Allah guérit ce qui est dans les cœurs. La tentation est une épreuve qui purifie. Le miroir m'interroge : est-ce que je vois la tentation comme une épreuve ?`,
  reflection: `La tentation est une épreuve qui purifie les cœurs. La traverser avec patience est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yaj'ala ma yulqi al-shaytanu fitnah fa yashfa Allahu ma fi qulubihim » — afin qu'Allah fasse de ce que suggère le démon une éprepreuve. Allah guérit ce qui est dans les cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la tentation comme une épreuve ? Ou est-ce que je la subis passivement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tentation peut guérir si elle est traversée avec patience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve purifie le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traverse la tentation avec patience est guéri." }
  ],
  munajat: `Ya Rabb, je vois la tentation comme une épreuve. Ne permets pas la soumission. Guéris mon cœur par la traversée de l'épreuve.`
};

MIROIR["22:54"] = {
  reference: "22:54",
  theme: ["science", "croyance", "guidance"],
  emotion: "Certitude, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Iman"],
  mirrorVersion: `« Et afin que ceux à qui le savoir a été donné sachent que c'est la vérité de la part de ton Seigneur. » Le miroir me montre le rôle de la science. « Wa li-ya'lama alladhina utu al-'ilma annahu al-haqqu min rabbika » — afin que ceux à qui le savoir a été donné sachent que c'est la vérité. La science confirme la vérité. Le miroir m'interroge : est-ce que je cherche la science pour confirmer la vérité ?`,
  reflection: `La science confirme la vérité d'Allah. La rechercher avec sincérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-ya'lama alladhina utu al-'ilma annahu al-haqqu min rabbika » — afin que ceux à qui le savoir a été donné sachent que c'est la vérité de la part de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la science pour confirmer la vérité ? Ou est-ce que je l'évite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La science mène à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le savoir est un don d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la science avec sincérité trouve la vérité." }
  ],
  munajat: `Ya Rabb, je cherche la science pour confirmer Ta vérité. Ne permets pas l'ignorance. Donne-moi le savoir qui mène à la certitude.`
};

MIROIR["22:55"] = {
  reference: "22:55",
  theme: ["doute", "châtiment", "soudaineté"],
  emotion: "Vigilance, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Rayb", "As-Sa'ah"],
  mirrorVersion: `« Et ceux qui ont mécru ne cesseront d'être dans le doute. » Le miroir me montre le doute permanent des mécréants. « Wa la yazalu alladhina kafaru fi miryatim minhu » — ceux qui ont mécru ne cesseront d'être dans le doute. « Hatta ta'tiyahumu al-sa'atu baghtatan » — jusqu'à ce que l'Heure leur vienne soudainement. Le doute précède le châtiment. Le miroir m'interroge : est-ce que je suis libéré du doute ?`,
  reflection: `Le doute est la prison des mécréants. La certitude est la libération du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yazalu alladhina kafaru fi miryatim minhu hatta ta'tiyahumu al-sa'atu baghtatan » — ceux qui ont mécru ne cesseront d'être dans le doute jusqu'à ce que l'Heure leur vienne soudainement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis libéré du doute ? Ou est-ce que je vacille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute est le signe de la foi faible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La certitude est le don d'Allah aux croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est libéré du doute a la foi complète." }
  ],
  munajat: `Ya Rabb, libère-moi du doute. Ne permets pas le vacillement. Donne-moi la certitude parfaite en Toi.`
};

MIROIR["22:56"] = {
  reference: "22:56",
  theme: ["royauté", "jugement", "justice"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mulk", "Al-Hukm"],
  mirrorVersion: `« La souveraineté ce Jour-là appartient à Allah. » Le miroir me montre la royauté finale. « Al-mulku yawma'idhin lillah » — la souveraineté ce Jour-là appartient à Allah. « Yahkumu baynahum » — Il jugera entre eux. La royauté finale implique le jugement. Le miroir m'interroge : est-ce que je me soumets à la royauté d'Allah ?`,
  reflection: `La souveraineté finale appartient à Allah. Se soumettre à Sa royauté maintenant est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-mulku yawma'idhin lillah yahkumu baynahum » — la souveraineté ce Jour-là appartient à Allah. Il jugera entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me soumets à la royauté d'Allah ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résistance à la royauté d'Allah est vaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute souveraineté appartient à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet à la royauté d'Allah est honoré." }
  ],
  munajat: `Ya Malik, je me soums à Ta royauté. Ne permets pas la résistance. Honore-moi par ma soumission.`
};

MIROIR["22:57"] = {
  reference: "22:57",
  theme: ["mécréance", "signes", "châtiment"],
  emotion: "Effroi, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Kufr", "Al-Ayat"],
  mirrorVersion: `« Ceux qui ont mécru et traité de mensonges Nos signes auront un châtiment humiliant. » Le miroir me montre le sort des négateurs. « Wa alladhina kafaru wa kadhdhabu bi-ayatina ula'ika lahum 'adhabun muhin » — ceux qui ont mécru et traité de mensonges Nos signes auront un châtiment humiliant. La négation mène à l'humiliation. Le miroir m'interroge : est-ce que je traite les signes d'Allah avec respect ?`,
  reflection: `Traiter les signes d'Allah de mensonges mène à l'humiliation. Les respecter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kafaru wa kadhdhabu bi-ayatina ula'ika lahum 'adhabun muhin » — ceux qui ont mécru et traité de mensonges Nos signes auront un châtiment humiliant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite les signes d'Allah avec respect ? Ou est-ce que je les traite de mensonges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation est le sort de ceux qui nient les signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les signes d'Allah est honoré." }
  ],
  munajat: `Ya Rabb, je respecte Tes signes. Ne permets pas la négation. Honore-moi par mon respect de Tes signes.`
};

MIROIR["22:58"] = {
  reference: "22:58",
  theme: ["migration", "chemin", "mort"],
  emotion: "Sacrifice, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hijrah", "As-Sabil"],
  mirrorVersion: `« Ceux qui ont émigré dans le chemin d'Allah et qui ont été tués ou sont morts. » Le miroir me montre le sacrifice des migrants. « Wa alladhina hajaru fi sabili Allahi thumma qutilu aw matu » — ceux qui ont émigré dans le chemin d'Allah et qui ont été tués ou sont morts. Le sacrifice pour Allah est honoré. Le miroir m'interroge : est-ce que je suis prêt à sacrifier pour le chemin d'Allah ?`,
  reflection: `Le sacrifice dans le chemin d'Allah est honoré. Être prêt à sacrifier est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina hajaru fi sabili Allahi thumma qutilu aw matu » — ceux qui ont émigré dans le chemin d'Allah et qui ont été tués ou sont morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à sacrifier pour le chemin d'Allah ? Ou est-ce que je préfère le confort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice pour Allah est un honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah mérite tous les sacrifices." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sacrifie pour Allah est récompensé." }
  ],
  munajat: `Ya Rabb, je suis prêt à sacrifier pour Ton chemin. Ne permets pas l'attachement au confort. Honore-moi par le sacrifice.`
};
