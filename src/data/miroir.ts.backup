    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma conscience témoigne ? Est-ce que je l'écoute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage de soi révèle la vérité." },
