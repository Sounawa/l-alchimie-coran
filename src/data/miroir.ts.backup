    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon temps déterminé ? Comment l'utilise-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps déterminé est une occasion de préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit le temps déterminé par son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise bien son temps déterminé réussit." }
  ],
  munajat: `Ya Rabb, mon temps est déterminé. Aide-moi à l'utiliser pour Toi. Ne permets pas que je le gaspille.`
};

MIROIR["77:23"] = {
  reference: "77:23",
  theme: ["pouvoir", "détermination", "décision"],
  emotion: "Soumission, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muqtadir"],
  mirrorVersion: `« Ainsi sommes-Nous capables. » Le miroir me montre la capacité divine absolue. « Fa-qadiruna » — ainsi sommes-Nous capables. La puissance. Le miroir m'enseigne : Allah peut tout.`,
  reflection: `Allah est capable de tout. Sa capacité est absolue.`,
  tajalli: [
