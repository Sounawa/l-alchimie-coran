    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les vents comprend la puissance." }
  ],
  munajat: `Ya Rabb, les vents témoignent de Ta puissance. Ouvre mes yeux aux signes.`
};

MIROIR["77:3"] = {
