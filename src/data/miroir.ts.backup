    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les alliés des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de l'intercession angélique inspire la piété." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi ceux pour qui les anges prient. Donne-mi leur intercession. Ne permets pas que je sois privé de leur soutien.`
};

MIROIR["40:8"] = {
