  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La fiha ghawlun wa la hum 'anha yunzarun » — elle ne leur causera pas de mal de tête, et ils ne s'enivreront pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la pureté ? Ou est-ce que je m'enivre des plaisirs du monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté du Paradis récompense la sobriété dans le monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est pur par la volonté de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sobre dans le monde reçoit la pureté du Paradis." }
  ],
  munajat: `Ya Rabb, je veux la pureté du Paradis. Donne-moi la sobriété dans ce monde. Accorde-moi la boisson qui n'enivre pas.`
};

MIROIR["37:48"] = {
