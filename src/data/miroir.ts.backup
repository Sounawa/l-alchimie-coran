    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La porte du repentir est toujours ouverte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement est purifié." }
  ],
  munajat: `Ya Tawwab, je me repends sincèrement. Ne permets pas que je continue dans l'hypocrisie. Purifie-moi par le repentir.`
};

MIROIR["4:147"] = {
  reference: "4:147",
  theme: ["gratitude", "châtiment", "mérite"],
  emotion: "Gratitude, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Shakur", "Al-'Adl"],
  mirrorVersion: `« Qu'aurait Allah à vous châtier si vous êtes reconnaissants et croyants ? » Le miroir me montre la protection de la gratitude. « In shakartum wa amantum » — si vous êtes reconnaissants et croyants. La gratitude et la foi protègent du châtiment. Le miroir m'interroge : suis-je reconnaissant ?`,
  reflection: `La gratitude et la foi protègent du châtiment. Allah n'a pas besoin de châtier les reconnaissants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma yaf'alu Allahu bi-'adhabikum in shakartum wa amantum » — qu'aurait Allah à vous châtier si vous êtes reconnaissants et croyants ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je reconnaissant ? Ma gratitude est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est Reconnaissant envers les reconnaissants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant est protégé." }
  ],
  munajat: `Ya Shakur, je suis reconnaissant. Ne permets pas que je sois ingrat. Protège-moi par ma gratitude et ma foi.`
};

MIROIR["4:148"] = {
  reference: "4:148",
  theme: ["mal", "publicité", "discrétion"],
  emotion: "Sagesse, pudeur",
  difficulty: "débutant",
  relatedNames: ["Al-Satr", "Al-Hikmah"],
  mirrorVersion: `« Allah n'aime pas qu'on répande le mal en public. » Le miroir me montre la désapprobation de la publicité du mal. « Jahra al-su'i » — répandre le mal en public. La discrétion est préférée. Le miroir m'interroge : est-ce que je cache le mal ou est-ce que je le publie ?`,
  reflection: `La discrétion sur le mal est préférée. La publicité du mal est désapprouvée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yuhibbu Allahu al-jahra bi-al-su'i min al-qawli » — Allah n'aime pas qu'on répande le mal en public." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cache le mal ou est-ce que je le publie ? Ma pudeur est-elle préservée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La discrétion est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal doit être caché, pas publié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache le mal imite Allah." }
  ],
  munajat: `Ya Satr, je cache le mal. Ne permets pas que je le publie. Donne-moi la sagesse de la discrétion.`
};

MIROIR["4:149"] = {
  reference: "4:149",
  theme: ["pardon", "couverture", "excellence"],
  emotion: "Générosité, noblesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Sattar"],
  mirrorVersion: `« Si vous faites le bien ouvertement ou secrètement, ou si vous pardonnez le mal, Allah est Pardonneur et Omnipotent. » Le miroir me montre l'excellence du pardon. « Ta'fu 'an su'in » — si vous pardonnez le mal. Le pardon est une excellence. Le miroir m'interroge : est-ce que je pardonne ?`,
  reflection: `Le pardon est une excellence. Faire le bien et pardonner le mal sont aimés d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tubdu al-khayra aw tukhfun aw ta'fu 'an su'in fa-inna Allaha kana 'afuwwan qadiran » — si vous faites le bien ouvertement ou secrètement, ou si vous pardonnez le mal, Allah est Pardonneur et Omnipotent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pardonne ? Ou est-ce que je garde rancune ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon est la noblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah pardonne à celui qui pardonne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne est pardonné." }
  ],
  munajat: `Ya Ghaffur, je pardonne. Ne permets pas que je garde rancune. Donne-moi la noblesse du pardon.`
};

MIROIR["4:150"] = {
  reference: "4:150",
  theme: ["révélation", "séparation", "partialité"],
  emotion: "Mise en garde, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kitab", "Al-Rusul"],
  mirrorVersion: `« Ceux qui ne croient pas en Allah et en Ses messagers et veulent faire une distinction entre Allah et Ses messagers. » Le miroir me montre l'erreur de la partialité. « Yufariquna » — veulent faire une distinction. La foi doit être complète. Le miroir m'interroge : est-ce que je crois en tout ?`,
  reflection: `La foi doit être complète en Allah et en tous Ses messagers. La distinction est un rejet.`,
  tajalli: [
