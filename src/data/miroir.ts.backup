  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-I'rad"],
  mirrorVersion: `« Nous leur avions donné Nos signes, mais ils s'en détournèrent. » Le miroir me montre le mépris des signes. « Wa ataynahum ayatina fa-kanu 'anha mu'ridin » — Nous leur avions donné Nos signes, mais ils s'en détournèrent. Le mépris des signes mène à l'égarement. Le miroir m'interroge : est-ce que je me détourne des signes ?`,
  reflection: `Le mépris des signes mène à l'égarement. Les contempler est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ataynahum ayatina fa-kanu 'anha mu'ridin » — Nous leur avions donné Nos signes, mais ils s'en détournèrent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me détourne des signes ? Ou est-ce que je les contemple ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contemplation des signes guide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont donnés pour guider." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les signes est guidé." }
  ],
  munajat: `Ya Rabb, je contemple Tes signes. Ne permets pas que je m'en détourne. Ouvre mes yeux aux signes partout.`
};

MIROIR["15:82"] = {
  reference: "15:82",
  theme: ["montagnes", "sécurité", "illusion"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jibal", "Al-Amin"],
  mirrorVersion: `« Ils taillaient des demeures dans les montagnes, en sécurité. » Le miroir me montre l'illusion de sécurité. « Wa yanhiluna mina al-jibali buyutan amina » — ils taillaient des demeures dans les montagnes, en sécurité. La sécurité apparente cache la destruction. Le miroir m'interroge : est-ce que je suis en sécurité réelle ?`,
  reflection: `La sécurité apparente cache la destruction. La vraie sécurité est en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yanhiluna mina al-jibali buyutan amina » — ils taillaient des demeures dans les montagnes, en sécurité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis en sécurité réelle ? Ou est-ce que je vis dans l'illusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie sécurité est en Allah seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes ne protègent pas du décret divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie en Allah est vraiment en sécurité." }
  ],
  munajat: `Ya Rabb, je me réfugie en Toi pour ma sécurité. Ne permets pas que je vive dans l'illusion. Donne-moi la vraie sécurité en Toi.`
};

MIROIR["15:83"] = {
  reference: "15:83",
  theme: ["cri", "matin", "destruction"],
  emotion: "Mise en garde, effroi",
  difficulty: "débutant",
  relatedNames: ["As-Sayhah", "Ad-Damar"],
  mirrorVersion: `« Le Cri les saisit au matin. » Le miroir me montre le moment de la destruction. « Fa-akhadhathumu al-sayhatu musbihin » — le Cri les saisit au matin. La destruction vient au moment imprévu. Le miroir m'interroge : suis-je prêt pour le moment imprévu ?`,
  reflection: `La destruction vient au moment imprévu. Être prêt est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhadhathumu al-sayhatu musbihin » — le Cri les saisit au matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le moment imprévu ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation constante est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La destruction vient quand on ne s'y attend pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est toujours prêt n'est pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, je veux être toujours prêt. Ne permets pas l'insouciance. Prépare-moi pour chaque moment.`
};

MIROIR["15:84"] = {
  reference: "15:84",
  theme: ["fuite", "protection", "impuissance"],
  emotion: "Réalité, impuissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hirab", "An-Nafaq"],
  mirrorVersion: `« Ce qu'ils avaient acquis ne leur servit à rien. » Le miroir me montre l'inutilité des acquisitions sans foi. « Fa-ma aghna 'anhum ma kanu yaksibun » — ce qu'ils avaient acquis ne leur servit à rien. Les acquisitions sans foi sont vaines. Le miroir m'interroge : est-ce que ce que j'acquiers me servira ?`,
  reflection: `Les acquisitions sans foi sont vaines. Acquérir avec foi est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma aghna 'anhum ma kanu yaksibun » — ce qu'ils avaient acquis ne leur servit à rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ce que j'acquiers me servira ? Ou est-ce que c'est vain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les acquisitions avec foi sont utiles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seules les acquisitions avec foi comptent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui acquiert avec foi investit pour l'éternité." }
  ],
  munajat: `Ya Rabb, je veux acquérir avec foi. Ne permets pas que mes acquisitions soient vaines. Donne valeur à mes efforts par ma sincérité.`
};

MIROIR["15:86"] = {
  reference: "15:86",
  theme: ["création", "science", "créateur"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khallaq", "Al-Alim"],
  mirrorVersion: `« Nous t'avons créé, pourquoi ne crois-tu pas ? » Le miroir me montre l'appel à la foi. « Inna rabbaka huwa al-khallaqu al-alim » — ton Seigneur est le Créateur, l'Omniscient. La création est un signe. Le miroir m'interroge : est-ce que je reconnais mon Créateur ?`,
  reflection: `La création est un signe. Reconnaître le Créateur est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbaka huwa al-khallaqu al-alim » — ton Seigneur est le Créateur, l'Omniscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mon Créateur ? Ou est-ce que je L'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance du Créateur est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création témoigne du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son Créateur Le trouve partout." }
  ],
  munajat: `Ya Khallaq, je Te reconnais comme mon Créateur. Ne permets pas que je T'oublie. Ouvre mes yeux à Ta création.`
};

MIROIR["15:87"] = {
  reference: "15:87",
  theme: ["répétition", "coran", "grand"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Mathani", "Al-Qur'an"],
  mirrorVersion: `« Nous t'avons donné sept versets répétés et le grand Coran. » Le miroir me montre le don du Coran. « Wa laqad ataynaka sab'an mina al-mathani wa al-qur'ana al-'azim » — Nous t'avons donné sept versets répétés et le grand Coran. Le Coran est un don immense. Le miroir m'interroge : est-ce que je valorise ce don ?`,
  reflection: `Le Coran est un don immense. Le valoriser est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ataynaka sab'an mina al-mathani wa al-qur'ana al-'azim » — Nous t'avons donné sept versets répétés et le grand Coran." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je valorise ce don ? Ou est-ce que je le néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La valorisation du Coran transforme la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le plus grand don après la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui valorise le Coran reçoit ses bénédictions." }
  ],
  munajat: `Ya Rabb, je valorise Ton Coran. Ne permets pas que je le néglige. Donne-moi d'apprécier ce don immense.`
};

MIROIR["15:88"] = {
  reference: "15:88",
  theme: ["regard", "biens", "récompense"],
  emotion: "Détachement, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mata'", "Al-Akhirah"],
  mirrorVersion: `« Ne regarde pas avec envie les biens que Nous avons accordés à certains. » Le miroir me montre le détachement. « La tamuddanna 'aynayka ila ma matta'na bihi azwajan minhum » — ne regarde pas avec envie les biens que Nous avons accordés à certains. Le détachement des biens est essentiel. Le miroir m'interroge : suis-je détaché des biens de ce monde ?`,
  reflection: `Le détachement des biens de ce monde est essentiel. L'au-delà est meilleur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tamuddanna 'aynayka ila ma matta'na bihi azwajan minhum » — ne regarde pas avec envie les biens que Nous avons accordés à certains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je détaché des biens de ce monde ? Ou suis-je envieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détachement libère le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens de ce monde sont temporaires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est détaché est vraiment libre." }
  ],
  munajat: `Ya Rabb, je veux être détaché des biens de ce monde. Ne permets pas l'envie dans mon cœur. Donne-moi la liberté du détachement.`
};

MIROIR["15:89"] = {
  reference: "15:89",
  theme: ["avertissement", "clarté", "ouvert"],
  emotion: "Urgence, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Mubin"],
  mirrorVersion: `« Dis : "Je suis l'avertisseur explicite." » Le miroir me montre la mission du Prophète. « Wa qul inni ana al-nadhiru al-mubin » — dis : Je suis l'avertisseur explicite. L'avertissement est clair. Le miroir m'interroge : est-ce que j'accepte l'avertissement ?`,
  reflection: `L'avertissement est clair. L'accepter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qul inni ana al-nadhiru al-mubin » — dis : Je suis l'avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'avertissement ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de l'avertissement sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'avertissement est une miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'avertissement est sauvé." }
  ],
  munajat: `Ya Rabb, j'accepte Ton avertissement. Ne permets pas que je l'ignore. Sauve-moi par l'acceptation de Ton message.`
};

MIROIR["15:90"] = {
  reference: "15:90",
  theme: ["division", "punition", "mécréance"],
  emotion: "Mise en garde, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muqassimin", "An-Nakal"],
  mirrorVersion: `« Nous avons châtié ceux qui ont divisé le Coran. » Le miroir me montre la punition des diviseurs. « Kama anzalna 'ala al-muqtasimin » — Nous avons châtié ceux qui ont divisé. La division du Coran est punie. Le miroir m'interroge : est-ce que j'accepte le Coran en entier ?`,
  reflection: `La division du Coran est punie. L'accepter en entier est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kama anzalna 'ala al-muqtasimin » — Nous avons châtié ceux qui ont divisé le Coran." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le Coran en entier ? Ou est-ce que je le divise selon mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation totale du Coran est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est un tout indivisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le Coran en entier est guidé." }
  ],
  munajat: `Ya Rabb, j'accepte Ton Coran en entier. Ne permets pas que je le divise selon mes désirs. Guide-moi par Sa totalité.`
};

MIROIR["15:91"] = {
  reference: "15:91",
  theme: ["coran", "division", "croyance"],
  emotion: "Mise en garde, sincérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qur'an", "Al-Iman"],
  mirrorVersion: `« Ceux qui ont fait du Coran des fractions. » Le miroir me montre le comportement des diviseurs. « Alladhina ja'alu al-qur'ana 'idin » — ceux qui ont fait du Coran des fractions. Le fractionnement est un rejet. Le miroir m'interroge : est-ce que je fractionne le Coran ?`,
  reflection: `Le fractionnement du Coran est un rejet. L'accepter entièrement est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina ja'alu al-qur'ana 'idin » — ceux qui ont fait du Coran des fractions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fractionne le Coran ? Ou est-ce que je l'accepte entièrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation totale est la foi sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est une révélation complète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le Coran entièrement est vraiment croyant." }
  ],
  munajat: `Ya Rabb, j'accepte Ton Coran entièrement. Ne permets pas que je le fractionne. Donne-moi la foi complète en Sa révélation.`
};

MIROIR["15:92"] = {
  reference: "15:92",
  theme: ["jurong", "question", "responsabilité"],
  emotion: "Réalité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Ar-Rabb"],
  mirrorVersion: `« Par ton Seigneur ! Nous les interrogerons tous. » Le miroir me montre la certitude du jugement. « Fa-wa rabbika la-nas'alannahum ajma'in » — par ton Seigneur ! Nous les interrogerons tous. Le jugement est certain. Le miroir m'interroge : suis-je prêt à répondre ?`,
  reflection: `Le jugement est certain. Être prêt à répondre est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-wa rabbika la-nas'alannahum ajma'in » — par ton Seigneur ! Nous les interrogerons tous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à répondre ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation à répondre est la responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun sera interrogé sur ses actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt à répondre a préparé ses réponses." }
  ],
  munajat: `Ya Rabb, je suis prêt à répondre. Ne permets pas l'insouciance. Prépare mes réponses pour le jour du jugement.`
};

MIROIR["15:93"] = {
  reference: "15:93",
  theme: ["actes", "question", "révélation"],
  emotion: "Responsabilité, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-A'mal", "Al-Khabar"],
  mirrorVersion: `« Sur ce qu'ils faisaient. » Le miroir me montre la précision du jugement. « 'amma kanu ya'malun » — sur ce qu'ils faisaient. Les actes seront examinés. Le miroir m'interroge : sont-ce des actes que je veux voir examinés ?`,
  reflection: `Les actes seront examinés. Faire des actes que je veux voir examinés est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'amma kanu ya'malun » — sur ce qu'ils faisaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sont-ce des actes que je veux voir examinés ? Ou ai-je honte de certains actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les actes bons sont ceux qu'on veut voir examinés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque acte sera examiné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait de bons actes les veut examiner." }
  ],
  munajat: `Ya Rabb, je veux faire des actes que je veux voir examinés. Ne permets pas les actes honteux. Purifie mes actes par Ta guidance.`
};

MIROIR["15:94"] = {
  reference: "15:94",
  theme: [" proclamation", "détournement", "clarté"],
  emotion: "Détermination, courage",
  difficulty: "débutant",
  relatedNames: ["Al-I'lan", "Al-Mushrikin"],
  mirrorVersion: `« Proclame ce qu'on t'a ordonné et détourne-toi des associateurs. » Le miroir me montre l'ordre de proclamation. « Fa-sda' bima tu'maru wa a'rid 'ani al-mushrikin » — proclame ce qu'on t'a ordonné et détourne-toi des associateurs. La proclamation est un devoir. Le miroir m'interroge : est-ce que je proclame la vérité ?`,
  reflection: `La proclamation de la vérité est un devoir. Le faire avec courage est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sda' bima tu'maru wa a'rid 'ani al-mushrikin » — proclame ce qu'on t'a ordonné et détourne-toi des associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je proclame la vérité ? Ou est-ce que je la cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proclamation de la vérité est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité doit être proclamée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui proclame la vérité participe à la guidance." }
  ],
  munajat: `Ya Rabb, je proclame la vérité. Ne permets pas que je la cache. Donne-moi le courage de la proclamation.`
};

MIROIR["15:95"] = {
  reference: "15:95",
  theme: ["protection", "moqueurs", "suffisance"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Kafin"],
  mirrorVersion: `« Nous te suffisons contre les moqueurs. » Le miroir me montre la protection divine. « Inna kafaynaka al-mustahzi'in » — Nous te suffisons contre les moqueurs. Allah protège Ses serviteurs. Le miroir m'interroge : est-ce que je me confie à Sa protection ?`,
  reflection: `Allah protège Ses serviteurs. Se confier à Lui est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kafaynaka al-mustahzi'in » — Nous te suffisons contre les moqueurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me confie à Sa protection ? Ou est-ce que je crains les moqueurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Sa protection libère de la peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah suffit à Ses serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah est vraiment protégé." }
  ],
  munajat: `Ya Rabb, je me confie à Ta protection. Ne permets pas que je craigne les moqueurs. Suffis-moi contre tout mal.`
};

MIROIR["15:96"] = {
  reference: "15:96",
  theme: ["associés", "reniement", "connaissance"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shirk", "Al-Ma'rifah"],
  mirrorVersion: `« Ceux qui attribuent à Allah un égal. Ils sauront bientôt. » Le miroir me montre le destin des associateurs. « Alladhina yaj'aluna ma'a Allahi ilahan akhar » — ceux qui attribuent à Allah un égal. L'association est un grand péché. Le miroir m'interroge : est-ce que j'évite toute forme d'association ?`,
  reflection: `L'association est un grand péché. L'éviter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yaj'aluna ma'a Allahi ilahan akhar fa-sawfa ya'lamun » — ceux qui attribuent à Allah un égal. Ils sauront bientôt." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite toute forme d'association ? Ou est-ce que j'associe sans le savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement de l'association est la foi pure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'association est le plus grand péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'association purifie sa foi." }
  ],
  munajat: `Ya Rabb, j'évite toute forme d'association. Ne permets pas que j'associe sans le savoir. Purifie ma foi de toute contamination.`
};

MIROIR["15:97"] = {
  reference: "15:97",
  theme: ["tristesse", "parole", "soulagement"],
  emotion: "Réconfort, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Huzn", "Al-Qawlah"],
  mirrorVersion: `« Nous savons que ta poitrine se serre à cause de ce qu'ils disent. » Le miroir me montre la compréhension d'Allah. « Wa laqad na'lamu annahu la-yadiqu sadruka 'amma yaqulun » — Nous savons que ta poitrine se serre à cause de ce qu'ils disent. Allah comprend nos peines. Le miroir m'interroge : est-ce que je me confie à Celui qui comprend ?`,
  reflection: `Allah comprend nos peines. Se confier à Lui est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad na'lamu annahu la-yadiqu sadruka 'amma yaqulun » — Nous savons que ta poitrine se serre à cause de ce qu'ils disent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me confie à Celui qui comprend ? Ou est-ce que je garde mes peines pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confidence à Allah soulage le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah comprend mieux que quiconque nos peines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah trouve le soulagement." }
  ],
  munajat: `Ya Rabb, je me confie à Toi qui comprend mes peines. Ne permets pas que je les garde pour moi. Soulage mon cœur par Ta compréhension.`
};

MIROIR["15:98"] = {
