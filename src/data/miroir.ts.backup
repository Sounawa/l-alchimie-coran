// ============================================

MIROIR["1:2"] = {
  reference: "1:2",
  theme: ["présence", "amour", "méditation"],
  emotion: "Reconnaissance profonde",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ar-Rahim"],
  mirrorVersion: `« Louange à Allah, Seigneur des mondes. » Ce verset m'invite à élargir ma perspective. « Seigneur des mondes » — pas seulement mon monde, pas seulement le monde humain, mais tous les mondes. Le miroir me montre combien ma louange est souvent centrée sur moi : je Te loue pour ce que Tu m'as donné, pour ce que Tu as fait pour moi. Mais ce verset m'invite à une louange plus vaste — une louange pour l'existence elle-même, pour le fait que quelque chose existe plutôt que rien, pour la beauté de la création dans son ensemble. « Al-hamd » n'est pas simplement « merci » — c'est une reconnaissance que tout bien vient de Lui.`,
  reflection: `La louange est le premier mouvement de l'âme éveillée. Avant de demander, avant même de se tourner, l'âme reconnaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hamdu lillahi » — la louange appartient à Allah. C'est une affirmation, pas une description." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je loue dans ma vie ? Les dons ou le Donateur ? Les bénédictions ou le Béni ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de ma louange — c'est moi qui ai besoin de louer. La louange m'élève, ne L'ajoute rien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est en état de louange silencieuse. Chaque atome vibre de reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur loue vraiment, il entre dans l'harmonie cosmique. Il cesse d'être séparé." }
  ],
  munajat: `Ya Rabb al-alamin, élargis ma louange. Fais que je Te loue non seulement pour Tes dons, mais pour Toi — le Donateur éternel.`
};

MIROIR["1:3"] = {
  reference: "1:3",
  theme: ["amour", "espoir", "confiance"],
  emotion: "Confiance absolue",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ar-Rahim"],
  mirrorVersion: `« Le Tout-Miséricordieux, le Très-Miséricordieux. » Ces deux noms sont répétés des centaines de fois dans le Coran. Pourquoi ? Parce que j'ai besoin de les entendre constamment. Mon cœur oublie. Il oublie que la miséricorde est la première réalité, avant même le jugement. « Ar-Rahman » — la miséricorde qui embrasse toute chose, croyants et non-croyants, humains et animaux. « Ar-Rahim » — la miséricorde particulière pour ceux qui se tournent vers Lui. Le miroir me demande : est-ce que je vis dans cette conscience de Sa miséricorde ? Ou est-ce que je vis dans la peur ?`,
  reflection: `La miséricorde précède tout. Dans un hadith qudsi, Allah dit : « Ma miséricorde a précédé Ma colère. » C'est la règle fondamentale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux noms de miséricorde se suivent — une intensité, une insistance. La miséricorde est Son attribut préféré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je vois Allah ? D'abord comme Juge ou d'abord comme Miséricordieux ? Le miroir révèle mon image de Dieu." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Sa miséricorde est si vaste, qu'est-ce qui m'empêche d'y accéder ? Mon propre refus de croire en elle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie est un signe de Sa miséricorde. Chaque souffle est un cadeau non mérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment ces deux noms ne désespère jamais. La miséricorde est le socle de tout espoir." }
  ],
  munajat: `Ya Rahman, ya Rahim, Ta miséricorde m'entoure de tous côtés. Fais que je ne l'oublie jamais. Fais qu'elle soit mon refuge et ma force.`
};

MIROIR["1:4"] = {
  reference: "1:4",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Responsabilité consciente",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malik", "Al-Hakam"],
  mirrorVersion: `« Maître du Jour de la Rétribution. » Ce verset équilibre les précédents. Après la miséricorde, vient la justice. Après l'amour, la responsabilité. Le miroir me montre que je ne peux pas vivre seulement dans la douceur de « Ar-Rahman » — je dois aussi me souvenir que je suis responsable. « Yawm al-din » — le jour où chaque âme sera jugée selon ses actes. Ce n'est pas une menace, c'est un rappel : mes choix comptent. Chaque instant a un poids éternel.`,
  reflection: `La foi équilibrée tient les deux : la miséricorde qui donne l'espoir, et la justice qui donne le sérieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Maliki yawm al-din » — le Roi du Jour du Jugement. La souveraineté ultime se manifeste ce jour-là." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si ce jour devait être aujourd'hui, serais-je prêt ? Qu'est-ce que je changerais tout de suite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Jour du Jugement n'est pas une vengeance — c'est une mise en ordre. Chaque chose à sa juste place." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers tend vers ce jour. La création tout entière attend le verdict final." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque jour comme s'il était le Jour du Jugement n'aura pas de surprise ce jour-là." }
  ],
  munajat: `Ya Malik yawm al-din, fais que je vive avec conscience de ce jour. Que chaque acte soit posé comme s'il était mon dernier.`
};

MIROIR["1:6"] = {
  reference: "1:6",
  theme: ["guidance", "prière", "confiance"],
  emotion: "Humilité implorante",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Siraj"],
  mirrorVersion: `« Guide-nous dans le chemin droit. » C'est la seule demande de la Fatiha. Pas de demande de richesse, de santé, de succès — seulement la guidance. Le miroir me montre que si j'ai la guidance, j'ai tout. Le chemin droit est celui qui mène à Allah, sans déviation, sans égarement. Et je demande « guide-NOUS » — pas « guide-moi ». Ma guidance est liée à celle des autres. Je ne suis pas seul sur ce chemin.`,
  reflection: `La guidance n'est pas une destination — c'est un chemin. On la demande chaque jour, à chaque prière, car on en a besoin constamment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ihdina » — guide-nous. Le verbe est à l'impératif, mais c'est une supplication, pas un ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je sur le chemin droit ? Comment le sais-je ? Le miroir m'invite à vérifier ma direction." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je demande la guidance, mais est-ce que je la suis quand elle vient ? La guidance demandée doit être la guidance acceptée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers suit un chemin — les planètes, les saisons, les rivières. L'homme a besoin de demander son chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Demander la guidance EST la guidance. Celui qui demande est déjà sur le chemin." }
  ],
  munajat: `Ya Hadi, montre-moi le chemin. Et quand Tu me le montres, donne-moi la force de le suivre. Ne me laisse pas m'égarer après avoir vu.`
};

MIROIR["1:7"] = {
  reference: "1:7",
  theme: ["guidance", "méditation", "confiance"],
  emotion: "Discernement éveillé",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Fattah"],
  mirrorVersion: `« Le chemin de ceux que Tu as comblés de faveurs, non pas de ceux qui ont encouru Ta colère, ni de ceux qui s'égarent. » Ce verset précise le chemin demandé. Trois catégories : les favorisés, les objets de colère, les égarés. Le miroir m'invite à m'examiner : dans quelle catégorie suis-je ? « An'amta 'alayhim » — ceux qu'Allah a bénis avec les prophètes, les véridiques, les martyrs, les vertueux. Je demande à être sur leurs pas. Et je demande explicitement à éviter les deux autres chemins — celui de la rébellion consciente et celui de l'égarement involontaire.`,
  reflection: `Il y a plus d'une façon de se perdre : par rébellion ou par ignorance. Les deux sont dangereuses, mais la première est plus grave car elle connaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois chemins, trois destins. Le choix n'est pas théorique — il est pratique, quotidien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel chemin je prends chaque jour ? Celui des favorisés ? Des rebelles ? Des égarés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ceux qui sont « favorisés » ne sont pas parfaits — ils sont guidés. La faveur n'est pas le mérite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine est une succession de chemins. Chaque génération trace son sillage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande à être avec les favorisés est déjà en leur compagnie — par l'intention." }
  ],
  munajat: `Ya Allah, place-moi avec ceux que Tu as bénis. Épargne-moi la colère de ceux qui savent mais refusent, et l'égarement de ceux qui cherchent mais ne trouvent pas.`
};

// ============================================
// SURAH 2 - AL-BAQARAH (The Cow) - Key Verses
// Existing: 2:152, 2:186, 2:255, 2:286
// ============================================

MIROIR["2:1"] = {
  reference: "2:1",
  theme: ["méditation", "sagesse", "mystère"],
  emotion: "Émerveillement silencieux",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Alif. Lam. Mim. » Ces lettres mystérieuses ouvrent la plus longue sourate du Coran. Le miroir me place devant l'incompréhensible. Je ne sais pas ce que signifient ces lettres. Et c'est précisément le point. Le Coran commence par me dire : tu ne comprends pas tout. Et c'est normal. Il y a des mystères qui resteront mystères. L'intelligence humaine a des limites, et la première sagesse est de les reconnaître.`,
  reflection: `Les lettres mystérieuses (huruf muqatta'at) ouvrent 29 sourates. Les savants ont proposé des interprétations, mais le mystère reste entier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois lettres, trois sons. Un mystère verbal au seuil de la Révélation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je ne comprends pas dans ma vie ? Est-ce que j'accepte le mystère ou est-ce que je le refuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Peut-être que ces lettres ne sont pas faites pour être comprises mais pour être prononcées. Le son lui-même est une guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères que la science n'a pas encore pénétrés. L'humilité est la première attitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte ce qu'il ne comprend pas ouvre la porte à la compréhension de ce qu'il peut comprendre." }
  ],
  munajat: `Ya Hakim, il y a tant de choses que je ne comprends pas. Apprends-moi à vivre avec le mystère sans frustration, à faire confiance là où la connaissance s'arrête.`
};

MIROIR["2:2"] = {
  reference: "2:2",
  theme: ["confiance", "guidance", "méditation"],
  emotion: "Certitude fondée",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hadi"],
  mirrorVersion: `« C'est le Livre au sujet duquel il n'y a aucun doute, une guidance pour ceux qui craignent Allah. » Le miroir me présente une affirmation radicale : pas de doute. Dans un monde où tout est remis en question, le Coran se présente comme un point fixe. Mais cette certitude n'est pas imposée — elle est offerte à « ceux qui craignent Allah ». La taqwa est la condition de la guidance.`,
  reflection: `Le doute a sa place, mais pas devant le Livre. Devant le Livre, on est invité à la certitude — mais une certitude qui se mérite par la taqwa.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La rayba fihi » — pas de doute dedans. Une affirmation absolue au seuil du Livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est certain dans ma vie ? Sur quoi je peux m'appuyer sans hésitation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude du Livre n'est pas une contrainte — c'est une offre. À moi de la saisir par la taqwa." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans un univers changeant, il y a des points fixes. Le Livre est l'un d'eux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La certitude n'est pas un donné — c'est un état du cœur qui se cultive par la crainte respectueuse." }
  ],
  munajat: `Ya Allah, donne-moi la certitude dans Ton Livre. Et donne-moi la taqwa qui me rend digne de Sa guidance.`
};

MIROIR["2:3"] = {
  reference: "2:3",
  theme: ["confiance", "méditation", "force"],
  emotion: "Foi active",
  difficulty: "débutant",
  relatedNames: ["Al-Ghayb", "As-Salam"],
  mirrorVersion: `« Ceux qui croient à l'invisible et accomplissent la prière et dépensent de ce que Nous leur avons attribué. » Le miroir me montre trois piliers de la foi authentique. Premier pilier : croire à l'invisible — ce qui ne se voit pas mais qui est réel. Deuxième pilier : la prière — la connexion régulière avec Allah. Troisième pilier : la générosité — le don de ce qu'on a reçu. Ces trois éléments sont liés.`,
  reflection: `La foi n'est pas seulement croyance — elle est croyance, pratique et partage. Une foi sans fruits n'est pas la foi décrite dans le Coran.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois verbes, trois actions : croire, prier, donner. La foi est dynamique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans ma foi, quelle dimension est la plus faible ? La croyance ? La pratique ? Le partage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« De ce que Nous leur avons attribué » — tout ce que je donne, Je l'ai d'abord reçu. Je suis canal, pas source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier fonctionne par don : le soleil donne sa lumière, la terre donne ses fruits. L'homme doit aussi donner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment à l'invisible n'a plus besoin de preuves visibles. Sa foi est devenue vision." }
  ],
  munajat: `Ya Allah, fais que ma foi soit complète : croyance en Toi, prière pour Toi, don pour les autres. Ne laisse aucune dimension manquer.`
};

MIROIR["2:4"] = {
  reference: "2:4",
  theme: ["confiance", "guidance", "méditation"],
  emotion: "Continuité spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Akhirah", "Ar-Rasul"],
  mirrorVersion: `« Et ceux qui croient à ce qui a été descendu avant toi, et qui ont la certitude de l'au-delà. » Le miroir me montre une foi qui embrasse toute l'histoire sacrée. Pas seulement la révélation finale, mais toutes les révélations qui l'ont précédée. Pas seulement ce monde, mais l'autre. La foi du croyant est large dans le temps et dans l'espace.`,
  reflection: `La foi islamique n'efface pas les révélations précédentes — elle les confirme et les complète. La continuité est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ce qui a été descendu avant toi » — la reconnaissance de toutes les révélations précédentes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de l'au-delà ? Ou est-ce que je vis comme si ce monde était le seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Croire en l'au-delà transforme ce monde. Ce n'est pas une fuite — c'est une mise en perspective." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toutes les traditions authentiques viennent de la même Source. La vérité est une, ses expressions sont multiples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la certitude de l'au-delà voit ce monde différemment. Tout devient préparation." }
  ],
  munajat: `Ya Allah, relie-moi à tous Tes prophètes. Et donne-moi la certitude de la rencontre avec Toi, pour que ce monde soit un chemin vers l'autre.`
};

MIROIR["2:5"] = {
  reference: "2:5",
  theme: ["guidance", "confiance", "espoir"],
  emotion: "Confiance assurée",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muflih"],
  mirrorVersion: `« Ceux-là sont sur la bonne voie venant de leur Seigneur, et ce sont eux qui réussissent. » Le miroir me montre le résultat de la foi décrite dans les versets précédents. La guidance n'est pas une recherche anxieuse — c'est un chemin tracé. Et ce chemin mène à la réussite. « Muflihun » — ceux qui réussissent, qui prospèrent, qui atteignent leur but.`,
  reflection: `La réussite véritable n'est pas ce que le monde appelle succès. C'est l'alignement avec le dessein divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala hudan » — sur une guidance. « Muflihun » — les réussissants. Le chemin et le but sont liés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que la réussite pour moi ? Est-ce que ma définition correspond à celle du Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance vient « de leur Seigneur » — elle est un don, pas un accomplissement. Je ne guide pas moi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, tout suit sa guidance instinctive. L'homme a besoin de la guidance révélée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie réussite est invisible aux yeux du monde. Elle se mesure dans le cœur, dans la proximité avec Allah." }
  ],
  munajat: `Ya Hadi, place-moi sur Ton chemin. Et fais que ma réussite soit celle que Tu définis, pas celle que le monde impose.`
};

MIROIR["2:6"] = {
  reference: "2:6",
  theme: ["sagesse", "méditation", "détachement"],
  emotion: "Réalisme spirituel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Ghani"],
  mirrorVersion: `« Quant à ceux qui ne croient pas, cela leur est égal que tu les avertisses ou non : ils ne croiront pas. » Ce verset me place devant une réalité difficile : il y a des cœurs fermés. Le miroir me montre que je ne peux pas forcer la foi chez les autres. Mon rôle est de transmettre, pas de convertir. Le résultat appartient à Allah. Cette réalisme me libère de l'angoisse de l'échec dans la prédication.`,
  reflection: `La foi est un don, pas un résultat d'arguments. On peut présenter la vérité, mais seul Allah ouvre les cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sawa'un » — égal. L'avertissement ne change rien pour ceux dont les cœurs sont scellés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il des domaines où je m'épuise à convaincre alors que seul Allah peut ouvrir les cœurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mon incapacité à convertir n'est pas un échec — c'est le rappel que la guidance appartient à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, le soleil brille pour tous, mais tous ne l'accueillent pas de la même façon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Accepter que certains ne croiront jamais n'est pas du pessimisme — c'est de la confiance dans le plan divin." }
  ],
  munajat: `Ya Allah, Toi seul ouvres les cœurs. Fais ce que Tu veux avec les cœurs de ceux que j'aime. Et libère-moi du fardeau de vouloir contrôler ce qui ne m'appartient pas.`
};

MIROIR["2:7"] = {
  reference: "2:7",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Gravité révérencieuse",
  difficulty: "avancé",
  relatedNames: ["Al-Khaliq", "Al-Adl"],
  mirrorVersion: `« Allah a scellé leurs cœurs et leurs oreilles, et un voile épais recouvre leurs yeux. » Ce verset décrit l'état de ceux qui ont choisi le rejet persistant. Le miroir me montre que ce « scellement » n'est pas arbitraire — c'est la conséquence de leurs propres choix répétés. Quand on refuse longtemps la lumière, les yeux finissent par s'habituer à l'obscurité. C'est une loi spirituelle, pas une punition capricieuse.`,
  reflection: `Le scellement divin suit le scellement humain. L'homme ferme son cœur, et Allah confirme son choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khatama Allah » — Allah a scellé. Le cœur, les oreilles, les yeux : les trois portes de la perception." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il des portes que j'ai moi-même fermées ? Des domaines où j'ai cessé d'écouter, de voir, de comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le scellement est réversible tant que la vie dure. Le repentir peut briser n'importe quel sceau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la création, chaque fermeture a sa fonction. La graine fermée protège la vie qu'elle contient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint ce verset est précisément celui dont le cœur n'est pas scellé. La crainte est signe d'ouverture." }
  ],
  munajat: `Ya Fattah al-albab, ouvre mon cœur avant qu'il ne se ferme. Garde-moi toujours capable d'entendre, de voir, de croire. Ne me laisse pas m'enfermer dans mes certitudes.`
};

MIROIR["2:8"] = {
  reference: "2:8",
  theme: ["sagesse", "méditation", "guérison"],
  emotion: "Vigilance intérieure",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Batin", "Al-'Alim"],
  mirrorVersion: `« Parmi les gens, il en est qui disent : 'Nous croyons en Allah et au Jour dernier', alors qu'ils ne croient pas. » Ce verset me place devant le danger de l'hypocrisie. Le miroir m'interroge : ma foi est-elle vraie ou apparente ? Est-ce que je dis « je crois » alors que mon cœur reste distant ? L'hypocrisie n'est pas seulement le mensonge aux autres — c'est d'abord le mensonge à soi-même.`,
  reflection: `L'hypocrisie est plus dangereuse que l'incroyance déclarée, car elle cache son état réel sous une façade de piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaquluna » — ils disent. La parole peut masquer la réalité du cœur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je en train de jouer un rôle ? Quels domaines de ma foi sont des paroles sans conviction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui reconnaît son hypocrisie est déjà en chemin vers la sincérité. L'aveu est le début de la guérison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne ment pas. L'arbre est arbre, l'oiseau est oiseau. Seul l'homme peut être autre que ce qu'il prétend." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sincérité (ikhlas) est l'essence de la foi. Sans elle, les actes les plus beaux sont vides." }
  ],
  munajat: `Ya 'Alim al-khafiyyah, Tu connais ce que je cache même de moi-même. Purifie mon cœur de l'hypocrisie. Fais que ma langue et mon cœur soient unis.`
};

MIROIR["2:9"] = {
  reference: "2:9",
  theme: ["sagesse", "confiance", "guérison"],
  emotion: "Lucidité courageuse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Basir"],
  mirrorVersion: `« Ils cherchent à tromper Allah et ceux qui croient, mais ils ne trompent qu'eux-mêmes, sans s'en rendre compte. » Le miroir me montre l'absurdité de l'hypocrite : essayer de tromper Celui qui voit tout. C'est comme essayer de se cacher du soleil en fermant les yeux. On ne trompe que soi-même. Cette auto-duperie est peut-être le plus grand danger spirituel.`,
  reflection: `La tromperie envers Dieu est impossible par définition. Celui qui croit y réussire se ment à lui-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yukhadi'una » — ils cherchent à tromper. Le verbe implique un effort actif de dissimulation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'essaie de cacher à Allah ? Quelles parties de ma vie je garde dans l'ombre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "En réalité, Allah n'a pas besoin de ma sincérité — c'est moi qui ai besoin d'être sincère pour être en paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien ne peut se cacher dans l'univers. Chaque action laisse une trace, chaque pensée a un poids." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'hypocrite est la seule créature qui s'empêche elle-même de voir. Sa cécité est son propre choix." }
  ],
  munajat: `Ya Basir, Tu me vois même quand je ne me vois pas. Libère-moi de l'illusion que je peux Te cacher quoi que ce soit. Tout est nu devant Toi.`
};

MIROIR["2:10"] = {
  reference: "2:10",
  theme: ["guérison", "sagesse", "méditation"],
  emotion: "Compassion lucide",
  difficulty: "avancé",
  relatedNames: ["Ash-Shafi", "Al-Hadi"],
  mirrorVersion: `« Il y a dans leurs cœurs une maladie, et Allah a fait que leur maladie s'aggrave. » Le miroir me montre que le mal spirituel, comme le mal physique, peut s'aggraver s'il n'est pas soigné. L'hypocrisie est une maladie du cœur. Et comme toute maladie, elle demande un diagnostic honnête et un traitement courageux. Le verset ne dit pas qu'Allah punit arbitrairement — Il dit que les conséquences naturelles du mal s'accumulent.`,
  reflection: `La maladie du cœur suit les mêmes lois que la maladie du corps : négligée, elle empire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Marad » — maladie. Le cœur peut tomber malade comme le corps. L'hypocrisie en est une forme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la maladie de mon cœur ? L'orgueil ? L'envie ? L'hypocrisie ? Le premier soin est le diagnostic." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah « fait aggraver » — mais c'est la conséquence du choix de ne pas se soigner. Le médecin ne crée pas la maladie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par conséquences. Chaque action crée son effet. La maladie spirituelle n'échappe pas à cette loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa maladie est déjà en voie de guérison. Le refus du diagnostic est la vraie mort." }
  ],
  munajat: `Ya Shafi, guéris mon cœur de ses maladies. Donne-moi le courage de voir ce qui ne va pas, et la force de le changer avant qu'il ne soit trop tard.`
};

// ============================================
// SURAH 2 - AL-BAQARAH (continued)
// Key verses for comprehensive coverage
// ============================================

MIROIR["2:21"] = {
  reference: "2:21",
  theme: ["présence", "prière", "guidance"],
  emotion: "Appel à l'éveil",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Razzaq"],
  mirrorVersion: `« Ô hommes ! Adorez votre Seigneur qui vous a créés, vous et ceux qui vous ont précédés. Ainsi atteindrez-vous la piété. » Ce verset est un appel universel. « Ô hommes » — pas « Ô croyants », mais tous les humains. Le miroir me montre que l'adoration n'est pas un commandement arbitraire — elle est la reconnaissance de ma source. Celui qui m'a créé mérite mon adoration. Et le résultat n'est pas pour Allah — c'est pour moi : « ainsi atteindrez-vous la piété ». L'adoration me construit.`,
  reflection: `L'adoration est le lien entre le Créateur et la créature. Elle donne sens à l'existence et construit la taqwa.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayyuha al-nas » — ô hommes. L'appel est universel, pas réservé aux croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore vraiment dans ma vie ? Qu'est-ce qui occupe le centre de mes pensées et de mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de mon adoration — c'est moi qui ai besoin d'adorer pour devenir ce que je dois être." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création adore Allah à sa manière. L'homme doit choisir de le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration n'est pas une contrainte — c'est une libération. Elle libère de l'adoration des créatures pour l'adoration du Créateur." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé et je T'oublie. Réveille-moi à Ton adoration. Fais que chaque souffle soit une reconnaissance de ma source.`
};

MIROIR["2:22"] = {
  reference: "2:22",
  theme: ["présence", "gratitude", "méditation"],
  emotion: "Émerveillement reconnaissant",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Razzaq"],
  mirrorVersion: `« C'est Lui qui a fait de la terre un lit pour vous, et du ciel un toit, et qui fait descendre du ciel une eau par laquelle Il fait pousser des fruits pour votre subsistance. » Le miroir me montre les dons quotidiens que je prends pour acquis. La terre comme lit — stable, accueillante. Le ciel comme toit — protecteur, vaste. La pluie qui nourrit — la vie elle-même. Chaque élément de ma vie est un cadeau. Et le verset conclut : « Ne donnez pas des égaux à Allah alors que vous savez. »`,
  reflection: `La reconnaissance est la base de la foi. Reconnaître les dons mène à reconnaître le Donateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois dons : la terre, le ciel, l'eau. Trois besoins fondamentaux : stabilité, protection, nourriture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je prends pour acquis ? L'air que je respire ? L'eau que je bois ? La terre sous mes pieds ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si chaque don est un signe, alors ma vie entière est une révélation continue. Je vis dans un monde qui parle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est aménagé pour la vie humaine. Les conditions précises de notre existence ne sont pas un hasard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit les dons dans chaque chose voit Allah partout. Le monde devient transparent." }
  ],
  munajat: `Ya Razzaq, tout ce que j'ai vient de Toi. Ouvre mes yeux aux dons que j'ignore. Fais que chaque instant soit une reconnaissance.`
};

MIROIR["2:25"] = {
  reference: "2:25",
  theme: ["espoir", "amour", "gratitude"],
  emotion: "Promesse joyeuse",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Karim"],
  mirrorVersion: `« Et annonce la bonne nouvelle à ceux qui croient et accomplissent les bonnes œuvres : ils auront des Jardins sous lesquels coulent les rivières. » Le miroir me montre une promesse concrète. Pas des concepts abstraits, mais des Jardins, de l'eau, de la fraîcheur. La récompense divine répond à des besoins humains réels : la beauté, la fraîcheur, la paix. Et le fruit du Paradis : « quand ils reçoivent son fruit, ils disent : 'C'est ce qui nous a été donné auparavant'. » — la familiarité, la continuité.`,
  reflection: `Le Paradis n'est pas étranger à l'expérience humaine. Il en est l'accomplissement, la plénitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bashshir » — annonce la bonne nouvelle. L'islam est une religion d'espérance, pas de peur seulement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'attend après ? Est-ce que j'espère le Paradis ou est-ce que j'en doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les fruits du Paradis rappellent les fruits d'ici-bas — mais sans déception, sans fin, sans manque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau, les jardins, les fruits — les plaisirs universels de l'humanité. Le Paradis parle un langage que tout homme comprend." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand plaisir du Paradis n'est pas les fruits — c'est la présence d'Allah. Les fruits sont les signes." }
  ],
  munajat: `Ya Karim, promets-moi Tes Jardins. Fais que j'œuvre pour eux maintenant. Et fais que le goût de leurs fruits commence dès ce monde par Ta proximité.`
};

MIROIR["2:30"] = {
  reference: "2:30",
  theme: ["sagesse", "confiance", "méditation"],
  emotion: "Émerveillement interrogatif",
  difficulty: "avancé",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« Quand ton Seigneur dit aux anges : 'Je vais placer sur terre un successeur'. Ils dirent : 'Vas-Tu y placer qui y sèmera le désordre et y répandra le sang ?' » Ce verset me place devant le mystère de ma propre existence. Pourquoi Allah a-t-Il créé l'homme sachant qu'il ferait le mal ? Les anges posent la question légitime. Et Allah répond : « Je sais ce que vous ne savez pas. » Le miroir me montre que la création de l'homme, malgré son potentiel de mal, contient un secret que même les anges ignorent.`,
  reflection: `L'homme est un mystère — capable du pire et du meilleur. Sa création est un risque divin qui a un sens caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalifa » — successeur, lieutenant. L'homme a une responsabilité sur la création." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un bon khalifa ? Est-ce que je construis ou est-ce que je détruis sur ma terre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question des anges était juste — mais ils ne voyaient pas le potentiel de repentir, de spiritualité, d'élévation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est le seul être capable de dépasser sa nature. Il peut choisir le pire — ou transcender vers le meilleur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ce qu'Allah sait et que les anges ignorent, c'est que le cœur humain peut aimer Allah d'un amour que les anges ne connaissent pas." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé malgré le risque. Fais que je sois une preuve de Ta sagesse, pas de Ton erreur. Aide-moi à être un bon khalifa sur cette terre.`
};

MIROIR["2:38"] = {
  reference: "2:38",
  theme: ["guidance", "espoir", "pardon"],
  emotion: "Espoir dans la chute",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "At-Tawwab"],
  mirrorVersion: `« Descendez d'ici tous ! Et si jamais une guidance vous vient de Moi, quiconque suit Ma guidance n'aura pas peur et ne s'affligera pas. » Ce verset vient après la désobéissance d'Adam. La sentence tombe : la descente. Mais avec elle, la promesse : « si une guidance vous vient ». Le miroir me montre que même dans la chute, Allah n'abandonne pas. La guidance suit l'erreur. Le chemin du retour est toujours possible.`,
  reflection: `La chute n'est pas définitive. La guidance est offerte à tous, même à ceux qui ont désobéi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ihbitu » — descendez. La chute est collective (« tous »), la guidance est individuelle (« quiconque suit »)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je dans ma propre descente ? Et quelle guidance suis-je en train d'ignorer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La descente d'Adam n'était pas une punition définitive — c'était le début de l'histoire humaine, avec tous ses rebondissements." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'humanité partage cette condition : la chute originelle et la possibilité du retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance après la chute n'a plus peur ni regret. La guidance efface les conséquences de l'erreur." }
  ],
  munajat: `Ya Hadi, j'ai fait ma propre descente. Mais Tu offres la guidance. Montre-moi le chemin du retour. Et fais que je n'aie ni peur du futur ni regret du passé.`
};

MIROIR["2:45"] = {
  reference: "2:45",
  theme: ["prière", "patience", "confiance"],
  emotion: "Persévérance humble",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Mujib"],
  mirrorVersion: `« Et cherchez secours dans la patience et la prière. Cela est certes difficile, sauf pour les humbles. » Le miroir me montre les deux ressources de l'âme dans l'épreuve : la patience et la prière. La patience pour tenir, la prière pour s'élever. « Difficile » — oui, la spiritualité demande un effort. Mais « sauf pour les humbles » — l'humilité rend légère ce qui pèse aux arrogants.`,
  reflection: `La prière n'est pas une évasion — c'est une force. Elle donne les ressources pour patienter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Istainu » — cherchez secours. Le secours est là, mais il faut le chercher activement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans mes épreuves, quelle est ma première ressource ? La plainte ou la prière ? L'agitation ou la patience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est difficile pour l'orgueilleux devient léger pour l'humble. L'humilité n'est pas une faiblesse — c'est une clé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute croissance demande patience. La graine ne devient arbre qu'avec le temps et les soins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humble trouve la prière facile car il sait qu'il a besoin d'aide. L'orgueilleux la trouve difficile car il croit pouvoir se suffire." }
  ],
  munajat: `Ya Allah, j'ai besoin de patience et de prière. Apprends-moi à chercher secours là où il se trouve vraiment. Humilie mon orgueil pour que Ta présence me devienne légère.`
};

MIROIR["2:62"] = {
  reference: "2:62",
  theme: ["espoir", "confiance", "sagesse"],
  emotion: "Inclusion réconfortante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Ghafur"],
  mirrorVersion: `« Ceux qui croient, ceux qui pratiquent le judaïsme, les chrétiens et les sabéens, quiconque croit en Allah et au Jour dernier et fait une bonne œuvre aura sa récompense. » Ce verset élargit le cercle du salut. Le miroir me montre que la justice divine n'est pas limitée à une communauté. Les critères sont clairs : la foi en Allah, la conscience du Jugement, les bonnes œuvres. Ces trois éléments transcendent les appartenances formelles.`,
  reflection: `La vérité appartient à Allah, pas à une communauté. Celui qui cherche sincèrement sera guidé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Quatre groupes mentionnés — l'islam, le judaïsme, le christianisme, les sabéens. Le critère est la foi et l'œuvre, pas l'étiquette." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui compte vraiment ? Mon étiquette religieuse ou la réalité de ma foi et de mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce verset n'annule pas la nécessité de suivre la révélation finale — mais il affirme que la justice divine va au-delà des apparences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une, mais ses chercheurs sont multiples. Allah juge les cœurs, pas les étiquettes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus grande espérance de ce verset est que la miséricorde divine dépasse nos catégories humaines." }
  ],
  munajat: `Ya 'Adl, Tu juges selon la vérité des cœurs, pas selon les apparences. Fais que ma foi soit sincère et mes actes justes, quoi que je sois appelé.`
};

MIROIR["2:143"] = {
  reference: "2:143",
  theme: ["guidance", "confiance", "méditation"],
  emotion: "Équilibre spirituel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wasat", "Al-Hadi"],
  mirrorVersion: `« Et ainsi Nous avons fait de vous une communauté médiane. » Le miroir me montre l'idéal islamique : le juste milieu. Ni excès ni carence. Ni ascétisme extrême ni matérialisme débridé. « Wasat » — au centre, équilibré. Cette position médiane n'est pas de la médiocrité — c'est de la sagesse. Le centre tient là où les extrêmes s'effondrent.`,
  reflection: `L'islam est la religion de l'équilibre. Chaque excès est une déviation, même dans la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ummatan wasatan » — une communauté médiane. Le milieu est une position stratégique, pas un compromis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je en déséquilibre ? Quel extrême m'attire ? L'islam m'invite au centre." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le milieu n'est pas statique — c'est un équilibre dynamique. Il faut constamment se recentrer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature fonctionne par équilibre. L'écosystème, le corps, l'âme — tout demande le juste milieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve le milieu trouve la paix. Les extrêmes épuisent, le centre restaure." }
  ],
  munajat: `Ya Allah, guide-moi vers le juste milieu. Ni excès ni carence. Fais que mon islam soit équilibré comme Tu l'as voulu.`
};

MIROIR["2:177"] = {
  reference: "2:177",
  theme: ["sagesse", "force", "méditation"],
  emotion: "Compréhension profonde",
  difficulty: "avancé",
  relatedNames: ["Al-Barr", "Al-Birr"],
  mirrorVersion: `« La piété ne consiste pas à tourner vos visages vers l'Orient ou l'Occident. Mais la piété consiste à croire en Allah, au Jour dernier, aux anges, au Livre et aux prophètes... » Ce verset déconstruit la réduction de la foi à des rituels extérieurs. Le miroir me montre que la vraie piété (birr) est intérieure et pratique à la fois. Elle comprend la foi, mais aussi la générosité envers les proches, les orphelins, les pauvres, le voyageur, les mendiants, les prisonniers. Elle comprend la prière ET l'argent donné.`,
  reflection: `La piété n'est pas dans les apparences — elle est dans la foi sincère et les actes concrets.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-birr » — la piété véritable. Le verset énumère une dizaine de manifestations." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma piété est-elle extérieure ou profonde ? Ai-je les actes sans la foi, ou la foi sans les actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La direction de la prière (qibla) est importante, mais pas suffisante. Le cœur compte plus que le geste seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie religion universelle est celle du cœur sincère et de la main généreuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a compris ce verset a compris l'essence de l'islam : la foi qui devient acte." }
  ],
  munajat: `Ya Barr, fais que ma piété soit vraie. Pas seulement des gestes, mais un cœur croyant et des mains généreuses.`
};

// ============================================
// SURAH 2 - AL-BAQARAH - COMPLETE COVERAGE
// Remaining verses: 11-20, 23-24, 26-29, 31-37, 39-44, 46-61, 63-114, 116-142, 144-151, 153-176, 178-185, 187-254, 256-285
// ============================================

MIROIR["2:11"] = {
  reference: "2:11",
  theme: ["sagesse", "guérison", "méditation"],
  emotion: "Étonnement lucide",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muslih", "Al-Hakim"],
  mirrorVersion: `« Quand on leur dit : 'Ne semez pas le désordre sur terre', ils répondent : 'Nous sommes seulement des réformateurs'. » Le miroir me montre le piège de l'auto-justification. Ceux qui sèment le désordre se voient comme des réformateurs. L'hypocrite ne se voit pas hypocrite — il se voit juste, bien intentionné. Cette cécité sur soi-même est peut-être la plus dangereuse. Le verset m'interroge : quel mal est-ce que je justifie en moi au nom du bien ?`,
  reflection: `Le mal le plus subtil est celui qui se déguise en bien. L'autocritique honnête est le remède.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tufsiduna » — vous semez le désordre. « Muslihun » — réformateurs. Le contraste est frappant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'appelle « réforme » dans ma vie alors que c'est peut-être du désordre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai réformateur ne se proclame pas tel — il est reconnu par ses fruits." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de « réformateurs » qui ont semé le chaos. Les intentions ne suffisent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui doute de sa propre bonté est plus proche de la vérité que celui qui s'en certain." }
  ],
  munajat: `Ya Muslih, Tu es le vrai Réformateur. Garde-moi de l'illusion de mes bonnes intentions. Montre-moi mes désordres, même ceux que j'habille de vertus.`
};

MIROIR["2:12"] = {
  reference: "2:12",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Réalité décapante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khabir"],
  mirrorVersion: `« C'est eux les vrais corrupteurs, mais ils ne s'en rendent pas compte. » Le miroir me place devant une vérité qui blesse : l'aveuglement sur sa propre corruption. Ils « ne s'en rendent pas compte » — le danger n'est pas tant le mal que l'inconscience du mal. Celui qui sait qu'il fait mal peut encore se repentir. Celui qui ne le sait pas reste piégé.`,
  reflection: `La pire cécité est celle qui s'ignore. La lucidité sur soi est le premier cadeau de la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hum al-mufsidun » — ce sont eux les corrupteurs. Le verdict divin tranche l'auto-évaluation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je ne « réalise pas » sur moi-même ? Quel aveuglement me caractérise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de sa corruption est déjà un début de purification. L'inconscience est le vrai obstacle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne ment pas sur elle-même. L'eau est eau, le feu est feu. Seul l'homme peut s'illusionner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande à Allah de lui montrer ses corruptions intérieures recevra une réponse — peut-être douloureuse, mais libératrice." }
  ],
  munajat: `Ya Khabir, Toi qui connais mes zones d'ombre, éclaire-les. Même si c'est douloureux, je préfère voir ma corruption que de vivre dans l'illusion.`
};

MIROIR["2:13"] = {
  reference: "2:13",
  theme: ["sagesse", "guidance", "méditation"],
  emotion: "Ironie spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Quand on leur dit : 'Croyez comme les gens ont cru', ils disent : 'Croirons-nous comme les sots ont cru ?' » Le miroir me révèle l'orgueil déguisé en supériorité intellectuelle. Ils méprisent les croyants sincères, les appelant « sots ». L'intelligence sans humilité devient obstacle à la foi. La vraie sagesse commence par reconnaître qu'on ne sait pas tout.`,
  reflection: `L'orgueil intellectuel est un des plus grands obstacles à la guidance. Le cœur simple reçoit; l'esprit arrogant refuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Suhafa' » — sots, ignorants. Le mépris pour les croyants révèle l'orgueil caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je méprise ceux que je juge « moins éclairés » ? Mon intelligence me rend-il orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les « sots » selon le monde peuvent être les sages selon Allah. La vraie intelligence est ailleurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire montre que les plus grands esprits ont souvent reconnu leurs limites. L'arrogance est signe de petitesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La simplicité du cœur accueille la vérité. La complexité de l'ego la repousse." }
  ],
  munajat: `Ya Hadi, délivre-moi de l'orgueil de l'intelligence. Fais que mon esprit serve ma foi au lieu de s'y opposer.`
};

MIROIR["2:14"] = {
  reference: "2:14",
  theme: ["méditation", "sagesse", "guérison"],
  emotion: "Hypocrisie dévoilée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Batin", "Al-Khaliq"],
  mirrorVersion: `« Quand ils rencontrent ceux qui croient, ils disent : 'Nous croyons', mais quand ils sont seuls avec leurs diables, ils disent : 'Nous sommes avec vous'. » Le miroir me montre le double jeu. Une face pour les croyants, une autre pour les corrupteurs. Cette schizophrénie spirituelle est épuisante. L'hypocrite vit dans le mensonge permanent, toujours à jouer un rôle différent selon l'audience.`,
  reflection: `L'authenticité est libératrice. Celui qui est le même partout n'a pas à se souvenir du mensonge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaw » — quand ils sont seuls. L'hypocrisie se révèle dans l'intimité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui suis-je quand personne ne me voit ? Le « moi privé » et le « moi public » sont-ils alignés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah me voit toujours. Il n'y a pas de « seul » pour Lui. L'intimité est transparence divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne porte pas de masque. L'arbre est arbre dans la forêt comme dans la ville." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'homme authentique n'a qu'un seul visage — celui qu'il présente à Allah." }
  ],
  munajat: `Ya Batin, Tu me vois dans mon intimité. Fais que je sois le même en public et en privé, que mon cœur ne porte pas de masque.`
};

MIROIR["2:15"] = {
  reference: "2:15",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Justice ironique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhlik", "Al-Hakim"],
  mirrorVersion: `« Allah Se moque d'eux et les laisse s'égarer dans leur transgression, aveugles. » Le miroir me montre une réponse divine ironique. Ils jouent avec la foi — Allah « joue » avec eux. Ils feignent la guidance — Il les laisse dans l'égarement qu'ils ont choisi. La « moquerie » divine n'est pas petite — c'est une justice poétique. On récolte ce qu'on sème.`,
  reflection: `La justice divine peut prendre des formes ironiques. Celui qui joue avec la vérité finit par perdre dans son propre jeu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yastadrijuhum » — Il les laisse s'enfoncer. La conséquence suit le choix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je joue avec la vérité ? Quel jeu risqué suis-je en train de mener ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement n'est pas imposé — il est laissé. La liberté inclut celle de se perdre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois de conséquence régissent l'univers. Chaque action crée une réalité qui nous rattrape." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint cette ironie divine est déjà sur la voie de la sincérité." }
  ],
  munajat: `Ya Hakim, ne me laisse pas jouer avec la vérité. Si je m'égare, ramène-moi avant que Tu me laisses m'enfoncer.`
};

MIROIR["2:16"] = {
  reference: "2:16",
  theme: ["sagesse", "confiance", "méditation"],
  emotion: "Perte irréversible",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Ce sont eux qui ont acheté l'égarement au prix de la guidance. Leur commerce n'a pas profité et ils ne sont pas guidés. » Le miroir me montre une transaction tragique. Ils avaient la guidance et l'ont échangée contre l'égarement. Un mauvais commerce — le pire qui soit. Le profit qu'ils espéraient ne vient pas, et ce qu'ils ont perdu est irremplaçable.`,
  reflection: `La guidance est un capital précieux. L'échanger pour un profit mondain est la pire affaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ish-taraw » — ils ont acheté. L'égarement se paie de la guidance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai « acheté » au prix de ma guidance ? Quel compromis spirituel ai-je fait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie transaction est l'inverse : acheter la guidance au prix du monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la vie est commerce — qu'échangeons-nous ? Le temporel contre l'éternel ou l'inverse ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la valeur de la guidance ne l'échange contre rien au monde." }
  ],
  munajat: `Ya Hadi, la guidance est mon trésor. Garde-moi de l'échanger pour des profit éphémères. Fais que mon commerce soit avec Toi.`
};

MIROIR["2:17"] = {
  reference: "2:17",
  theme: ["méditation", "sagesse", "espoir"],
  emotion: "Image frappante",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Ils ressemblent à quelqu'un qui a allumé un feu. Quand celui-ci a illuminé tout autour, Allah a retiré leur lumière et les a abandonnés dans les ténèbres. » Le miroir me présente une image puissante. L'hypocrite a un moment de clarté — il « voit » la vérité. Mais cette lumière n'est pas ancrée en lui. Elle se retire, le laissant dans une obscurité pire qu'avant. Voir et perdre la vue est plus tragique que ne jamais voir.`,
  reflection: `La lumière entrevue puis perdue laisse un vide plus grand que l'ignorance initiale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Istawqada » — il a allumé. La lumière est là, puis disparaît." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je connu des moments de clarté que j'ai laissés s'éteindre ? Quelle lumière meurt en moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie lumière ne s'éteint pas. Elle grandit quand on la nourrit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu a besoin de combustible. La foi a besoin de pratique pour durer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande à garder la lumière reçoit le combustible pour qu'elle brûle toujours." }
  ],
  munajat: `Ya Nur, Tu m'as donné la lumière. Garde-la allumée en moi. Ne me laisse pas retourner aux ténèbres après avoir vu Ta clarté.`
};

MIROIR["2:18"] = {
  reference: "2:18",
  theme: ["méditation", "sagesse", "guérison"],
  emotion: "Surde volontaire",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Basir"],
  mirrorVersion: `« Sourds, muets, aveugles, ils ne reviennent pas. » Le miroir me montre les trois sens fermés : l'ouïe pour entendre la vérité, la parole pour la proclamer, la vue pour la reconnaître. Et le diagnostic final : « ils ne reviennent pas ». La fermeture n'est pas une incapacité — c'est un refus de revenir. On peut ouvrir les sens si on veut revenir.`,
  reflection: `La surdité spirituelle est souvent volontaire. On refuse d'entendre pour ne pas avoir à changer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Summun bukmun 'umyun » — sourds, muets, aveugles. Les trois portes de la perception fermées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle porte ai-je fermée ? Qu'est-ce que je refuse d'entendre, de dire, de voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour ouvre les sens. Celui qui revient vers Allah retrouve l'ouïe, la parole, la vue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perception est une grâce qui demande à être cultivée. Les sens spirituels s'atrophient sans usage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise sa surdité et demande à entendre est déjà en train d'entendre." }
  ],
  munajat: `Ya Sami', ya Basir, ouvre mes oreilles, ma bouche, mes yeux. Je veux entendre Ta parole, proclamer Ta vérité, voir Tes signes.`
};

MIROIR["2:19"] = {
  reference: "2:19",
  theme: ["méditation", "sagesse", "confiance"],
  emotion: "Confusion illustrée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhit", "Al-Hadi"],
  mirrorVersion: `« Ou comme celui qui, sous un nuage obscurci par la pluie, est plongé dans les ténèbres, le tonnerre et l'éclair. » Le miroir me présente une autre image de l'hypocrite. La pluie qui devrait être bénédiction devient obscurité. Le tonnerre et l'éclair qui devraient réveiller terrifient au lieu de guider. L'hypocrite vit même les bienfaits comme des menaces, les signes comme des dangers.`,
  reflection: `L'état intérieur détermine la perception extérieure. Le même événement est bénédiction pour le croyant, malédiction pour l'hypocrite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ghashiyy » — nuage obscurci. La pluie qui devrait éclairer obscurcit au contraire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je perçois les événements de ma vie ? Comme des bénédictions ou des menaces ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur sain transforme l'obscurité en chemin. Le cœur malade transforme la lumière en ténèbres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pluie est la même pour tous. C'est l'état du sol qui détermine si elle est bénédiction ou inondation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui change son cœur change sa perception. Le monde devient miroir de l'état intérieur." }
  ],
  munajat: `Ya Allah, change mon cœur pour que je voie Tes bienfaits partout. Ne me laisse pas vivre les bénédictions comme des malédictions.`
};

MIROIR["2:20"] = {
  reference: "2:20",
  theme: ["sagesse", "force", "méditation"],
  emotion: "Puissance écrasante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Muhit"],
  mirrorVersion: `« L'éclair les surprend presque aveugles. Quand il les illumine, ils avancent; quand il fait sombre, ils s'arrêtent. » Le miroir me montre l'inconstance de l'hypocrite. Il avance seulement quand la lumière est là — quand c'est facile, quand il y a profit. Dès que l'obscurité revient, il s'arrête. Il n'a pas de lumière propre, il dépend des circonstances. La foi authentique, elle, brille même dans l'obscurité.`,
  reflection: `Le croyant avance dans la lumière comme dans l'obscurité. Sa foi est une lanterne intérieure, pas un éclair extérieur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yad'u nas'a » — ils marchent ou s'arrêtent selon la lumière. L'inconstance révèle l'absence de foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'avance seulement quand c'est éclairé ? Ma foi survit-elle à l'obscurité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie lumière est intérieure. Elle brille même quand tout est noir dehors." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les étoiles brillent dans la nuit. Le croyant brille dans l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la lumière divine en lui ne craint pas l'obscurité du monde." }
  ],
  munajat: `Ya Nur, allume en moi une lumière qui ne s'éteint pas. Fais que j'avance même dans l'obscurité, guidé par Ta présence intérieure.`
};

MIROIR["2:23"] = {
  reference: "2:23",
  theme: ["confiance", "sagesse", "méditation"],
  emotion: "Défi divin",
  difficulty: "avancé",
  relatedNames: ["Al-Haqq", "Al-Mu'jiz"],
  mirrorVersion: `« Si vous avez un doute sur ce que Nous avons fait descendre sur Notre serviteur, apportez une sourate semblable. » Le miroir me place devant un défi qui reste sans réponse depuis 1400 ans. Le Coran se présente comme inimitable — non pas par arrogance, mais par vérité. Si les hommes pouvaient produire son équivalent, ils l'auraient fait. Le défi reste ouvert. Le Coran est soit ce qu'il prétend être, soit l'imposture la plus audacieuse de l'histoire.`,
  reflection: `Le Coran ne demande pas une foi aveugle — il invite à l'examen. Son inimitabilité est un argument rationnel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'tu » — apportez. Le défi est lancé, et reste sans réponse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je vraiment examiné le Coran ? Ou est-ce que je l'ai accepté ou rejeté sans investigation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incapacité à imiter le Coran n'est pas une preuve pour l'orgueilleux. La preuve demande un cœur ouvert." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plus grands littérateurs arabes ont reconnu l'inimitabilité du Coran. Le défi transcende les croyances." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend ce défi comprend que le Coran vient d'au-delà de l'humain." }
  ],
  munajat: `Ya Haqq, Tu as lancé le défi. Aide-moi à comprendre pourquoi le Coran reste inégalé. Et fais que cette compréhension renforce ma foi.`
};

MIROIR["2:24"] = {
  reference: "2:24",
  theme: ["confiance", "sagesse", "force"],
  emotion: "Avertissement solennel",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nar", "Al-Qadir"],
  mirrorVersion: `« Si vous ne le faites pas — et vous ne le ferez jamais — alors craignez le Feu dont le combustible sera les hommes et les pierres. » Le miroir me montre l'accomplissement prophétique : « vous ne le ferez jamais ». Depuis 14 siècles, personne n'a relevé le défi. L'enfer est présenté comme réalité, pas métaphore. Le « combustible » inclut les hommes et les pierres — une image concrète et terrifiante.`,
  reflection: `L'avertissement n'est pas une menace vide. La réalité de l'enfer doit éveiller, non paralyser.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan taf'alu » — vous ne le ferez jamais. La prophétie s'est réalisée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux l'avertissement de l'enfer ? Ou est-ce que je vis comme si tout était permis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du Feu n'est pas la peur paralysante — c'est la vigilance qui protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu physique consume tout. Le feu spirituel consume ce qui est contraire à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le Feu ici-bas le fuit. Celui qui ne le craint pas le rencontrera." }
  ],
  munajat: `Ya Allah, l'enfer est Ta réalité. Fais que la crainte de Ta justice m'éloigne du mal. Protège-moi du Feu par Ta miséricorde.`
};

MIROIR["2:26"] = {
  reference: "2:26",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Humilité devant le mystère",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-Khaliq"],
  mirrorVersion: `« Allah n'a pas honte de proposer en exemple un moustique, ou quelque chose de plus petit. » Le miroir me montre la grandeur d'Allah dans la petitesse. Il n'a pas besoin de grandes choses pour enseigner — un moustique suffit. Les arrogants trouvent cela indigne. Les croyants y voient la sagesse du Créateur qui utilise toute la création comme signe.`,
  reflection: `La grandeur divine se manifeste autant dans l'infiniment petit que dans l'infiniment grand. Rien n'est trop humble pour servir de signe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ba'udah » — un moustique. La plus petite créature peut porter le plus grand enseignement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je méprise comme « trop petit » pour m'enseigner ? Quel détail ignore-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil refuse les petites leçons. L'humilité trouve la sagesse partout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers révèle Allah dans l'atome comme dans la galaxie. La taille n'est pas la mesure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit Allah dans le moustique Le voit partout." }
  ],
  munajat: `Ya Hakim, apprends-moi à voir Ta sagesse dans les petites choses. Ne me laisse pas mépriser ce que Tu honores par Ton attention.`
};

MIROIR["2:27"] = {
  reference: "2:27",
  theme: ["confiance", "sagesse", "méditation"],
  emotion: "Gravité de la parole",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ahd", "Al-Hafiz"],
  mirrorVersion: `« Ceux qui rompent le pacte d'Allah après l'avoir conclu, coupent ce qu'Allah a ordonné de joindre, et sèment le désordre sur terre. » Le miroir me montre les trois marques de la corruption : rompre les engagements, couper les liens, semer le désordre. Le « pacte d'Allah » n'est pas seulement un contrat formel — c'est l'alliance primordiale de l'âme avec son Créateur. La rompre a des conséquences en cascade.`,
  reflection: `La parole donnée engage l'être tout entier. La briser, c'est se briser soi-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yanquduna » — ils rompent. Le verbe implique un acte délibéré de rupture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel pacte ai-je rompu ? Quel lien ai-je coupé ? La rupture avec Allah commence par les ruptures humaines." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Réparer les liens, c'est réparer le pacte. La guérison passe par la connexion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un tissu de connexions. Chaque rupture affaiblit le tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maintient les liens maintient sa connexion avec Allah." }
  ],
  munajat: `Ya Hafiz al-'ahd, garde-moi fidèle à mes engagements. Répare les liens que j'ai coupés. Ne me laisse pas être de ceux qui rompent.`
};

MIROIR["2:28"] = {
  reference: "2:28",
  theme: ["confiance", "méditation", "gratitude"],
  emotion: "Émerveillement existentiel",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« Comment pouvez-vous ne pas croire en Allah, alors que vous étiez morts et Il vous a donné la vie ? » Le miroir me renvoie à ma propre existence comme preuve. J'étais « mort » — inexistant. Puis j'ai reçu la vie. Ce don premier est la base de tout. Comment douter du Donateur quand le don est évident ? Ma vie elle-même est l'argument.`,
  reflection: `L'existence est le premier miracle. Chaque souffle est une preuve du Vivant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mayyitan » — morts. L'inexistence précédant l'existence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que ma vie est un don ? Que je n'ai rien fait pour mériter d'exister ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie donnée sera reprise. L'intermède entre deux morts est le temps de la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être vivant porte ce miracle : du non-être à l'être. La vie n'est pas une évidence — c'est une grâce." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple sa propre existence contemple le plus grand miracle." }
  ],
  munajat: `Ya Muhyi, Tu m'as donné la vie sans que je la demande. Fais que je vive cette vie en reconnaissance. Ne me laisse pas oublier que j'étais mort et que Tu m'as fait vivre.`
};

MIROIR["2:29"] = {
  reference: "2:29",
  theme: ["gratitude", "méditation", "sagesse"],
  emotion: "Cohérence cosmique",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« C'est Lui qui a créé pour vous tout ce qui est sur terre, puis Il a dirigé Sa volonté vers le ciel et en a fait sept cieux. » Le miroir me montre l'ordre de la création. D'abord la terre — mon domaine, mon environnement. Puis les cieux — ce qui m'entoure et me dépasse. Allah a aménagé le monde pour moi. La création n'est pas anarchique — elle est ordonnée, pensée, offerte.`,
  reflection: `La terre est aménagée pour l'homme. Les cieux témoignent de la grandeur du Créateur. Tout est en place.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma fi al-ard » — tout ce qui est sur terre. L'abondance du don." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois autour de moi ? Un chaos ou un aménagement ? Le miroir révèle ma perception." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création me précède. Je suis accueilli dans un monde déjà préparé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sept cieux symbolisent les dimensions de la création. La science moderne explore ces profondeurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'ordre de la création voit l'Ordonnateur." }
  ],
  munajat: `Ya Khaliq, Tu as tout aménagé pour moi. Ouvre mes yeux à cet ordre. Fais que je sois un bon gestionnaire de ce que Tu m'as confié.`
};

MIROIR["2:31"] = {
  reference: "2:31",
  theme: ["sagesse", "méditation", "connaissance"],
  emotion: "Émerveillement pédagogique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khaliq"],
  mirrorVersion: `« Et Il enseigna à Adam tous les noms. » Le miroir me montre le premier enseignement divin. Adam a reçu la connaissance des « noms » — les essences, les réalités de toute chose. Ce don le distingue des anges. L'homme est un être de connaissance, capable de nommer et comprendre. Le savoir n'est pas un accident — c'est la nature même de l'humanité.`,
  reflection: `La connaissance est un don divin. L'homme a été créé pour savoir et nommer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-asma' kullaha » — tous les noms. La connaissance totale de la création." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais de ma capacité de connaître ? Est-ce que je cultive ce don ou le néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance sans reconnaissance est vide. Savoir le nom des choses sans connaître le Nom du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création attend d'être nommée, comprise. L'homme est l'interprète de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand nom à connaître est Allah. Tout autre nom mène à Lui." }
  ],
  munajat: `Ya 'Alim, Tu as enseigné à Adam les noms. Enseigne-moi ce que je dois savoir pour Te connaître et Te servir.`
};

MIROIR["2:32"] = {
  reference: "2:32",
  theme: ["méditation", "confiance", "sagesse"],
  emotion: "Humilité angélique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Gloire à Toi ! Nous n'avons de connaissance que ce que Tu nous as enseigné. » Les anges répondent par la louange et l'humilité. Le miroir me montre la bonne réaction face à la connaissance : reconnaître qu'elle vient d'Allah. « Nous n'avons de connaissance que ce que Tu nous as enseigné » — la science est un prêt, pas une propriété. L'orgueil du savoir est déplacé.`,
  reflection: `La vraie connaissance inclut la conscience de sa source. Le savant humble est proche d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subhanak » — gloire à Toi. La louange précède l'aveu d'ignorance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je sais quelque chose, est-ce que j'en crédite Allah ou m'en attribue le mérite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance avouée est plus noble que la science revendiquée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute connaissance humaine est redécouverte de ce qui était déjà là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît que son savoir vient d'Allah reçoit davantage." }
  ],
  munajat: `Ya 'Alim, tout ce que je sais vient de Toi. Garde-moi de l'orgueil du savoir. Fais que ma connaissance m'humble au lieu de m'enorgueillir.`
};

MIROIR["2:33"] = {
  reference: "2:33",
  theme: ["sagesse", "confiance", "méditation"],
  emotion: "Démonstration divine",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakam"],
  mirrorVersion: `« Ô Adam, informe-les de ces noms. » Puis quand il les eut informés, Allah dit : « Ne vous avais-Je pas dit que Je connais les mystères des cieux et de la terre ? » Le miroir me montre la démonstration publique. Adam connaissait ce que les anges ignoraient. Allah prouve Sa parole par l'acte. « Je connais » — la connaissance divine précède et englobe toute connaissance humaine.`,
  reflection: `La connaissance divine est la source. Toute vérité humaine participe de Sa vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anbi'hum » — informe-les. Adam devient l'intermédiaire de la connaissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que ce que je sais vient d'Allah ? Suis-je un canal de Sa connaissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui transmet la connaissance ne la possède pas — il la sert." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne du savoir remonte toujours à l'Omniscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance qui ne mène pas à Allah n'est pas la vraie connaissance." }
  ],
  munajat: `Ya 'Alim al-ghuyub, Tu connais ce que je ne connais pas. Utilise-moi pour transmettre Ta connaissance si tel est Ton vouloir.`
};

MIROIR["2:34"] = {
  reference: "2:34",
  theme: ["confiance", "sagesse", "méditation"],
  emotion: "Test de l'obéissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« Et quand Nous dîmes aux anges : 'Prosternez-vous devant Adam', ils se prosternèrent, sauf Iblis qui refusa et s'enfla d'orgueil. » Le miroir me place au moment crucial. Le test n'était pas pour Adam mais pour les anges — et surtout pour Iblis. L'orgueil a fait obstacle à l'obéissance. « Pourquoi me prosternerai-je devant celui que Tu as créé d'argile ? » — l'argument semblait logique, mais la désobéissance était fatale.`,
  reflection: `L'orgueil transforme le commandement divin en débat. L'humilité accepte sans argumenter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iblis aba » — Iblis refusa. Le refus précède la chute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel commandement d'Allah est-ce que je « discute » au lieu d'obéir ? Où est mon orgueil caché ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation devant Adam était prosternation devant le commandement d'Allah, pas devant Adam." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre divin a toujours un sens, même s'il nous échappe. La confiance précède la compréhension." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Iblis connaissait Allah mais ne L'a pas obéi. La connaissance sans soumission est le piège de l'orgueil." }
  ],
  munajat: `Ya Allah, délivre-moi de l'orgueil qui refuse de se prosterner. Quand Tu commandes, fais que j'obéisse sans débat.`
};

MIROIR["2:35"] = {
  reference: "2:35",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Jardin et limite",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Et Nous dîmes : Ô Adam, habite le Paradis, toi et ton épouse, et mangez-en à votre aise, mais n'approchez pas de cet arbre. » Le miroir me montre l'abondance avec une seule limite. Tout le Paradis est permis, un seul arbre est interdit. La vie humaine est marquée par cette structure : des dons immenses et des limites précises. La tentation est de se concentrer sur la limite plutôt que sur les dons.`,
  reflection: `Les interdits divins sont peu nombreux face aux permissions. L'homme se fixe sur l'interdit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kula minha » — mangez-en. L'abondance précède l'interdit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois ? Les dons ou l'interdit ? Ma vie est-elle marquée par la gratitude ou la frustration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdit existe pour protéger. La limite est une grâce, pas une punition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque jardin a ses limites. La liberté absolue est une illusion destructrice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'arbre interdit n'était pas nécessaire. C'est le désir de l'interdit qui a créé le besoin." }
  ],
  munajat: `Ya Razzaq, Tu m'as donné tant de « jardins » dans ma vie. Aide-moi à me concentrer sur Tes dons plutôt que sur Tes interdits.`
};

MIROIR["2:36"] = {
  reference: "2:36",
  theme: ["confiance", "sagesse", "espoir"],
  emotion: "Chute et promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Al-Hadi"],
  mirrorVersion: `« Le diable les fit chuter et les fit sortir de là. » Le miroir me montre le résultat de la désobéissance : l'expulsion. Le Paradis perdu — mais pas définitivement. La chute est suivie de la promesse : « Descendez, vous serez ennemis les uns des autres. » L'histoire humaine commence par la chute et continue par la lutte entre le bien et le mal, en nous et autour de nous.`,
  reflection: `La chute n'est pas la fin. Le retour est possible. La terre d'exil peut devenir terre de retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Azalla » — il les fit chuter. Le verbe montre la responsabilité du tentateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle « chute » ai-je connue ? Et comment est-ce que j'en fais le chemin de retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La chute a précipité l'humanité sur terre, mais la terre est aussi le lieu du repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'histoire humaine est le récit de cette chute et des tentatives de retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Paradis n'est pas perdu pour toujours. Il attend celui qui revient." }
  ],
  munajat: `Ya Ghafur, j'ai chuté comme Adam. Mais Tu as promis le retour. Montre-moi le chemin du Paradis que j'ai quitté par mes propres fautes.`
};

MIROIR["2:37"] = {
  reference: "2:37",
  theme: ["pardon", "espoir", "confiance"],
  emotion: "Repentir exaucé",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Adam reçut de son Seigneur des paroles, et Allah agréa son repentir. » Le miroir me montre la miséricorde immédiatement après la faute. Adam ne reste pas dans la chute — il se repent. « Des paroles » — des mots de retour, de reconnaissance, de supplication. Et Allah « agréa son repentir ». Le cycle faute-repentir-pardon est établi comme modèle pour toute l'humanité.`,
  reflection: `Le repentir n'est pas une faiblesse — c'est la grâce après la chute. Allah accueille toujours le retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalimat » — des paroles. Le repentir s'exprime par des mots, pas seulement par des sentiments." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes « paroles » de repentir ? Est-ce que je reviens vraiment vers Allah après mes chutes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah attend le repentir plus que le pécheur ne veut se repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine est remplie de retours. Chaque tradition honore le repentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les « paroles » d'Adam sont devenues la formule du repentir pour ses descendants." }
  ],
  munajat: `Ya Tawwab, comme Adam, je reviens à Toi. Accepte mon repentir comme Tu as accepté le sien. Donne-moi les paroles qui ouvrent Ton pardon.`
};

MIROIR["2:39"] = {
  reference: "2:39",
  theme: ["confiance", "sagesse", "espoir"],
  emotion: "Alternative claire",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nar"],
  mirrorVersion: `« Quant à ceux qui ne croient pas et traitent de mensonges Nos signes, ce sont les gens du Feu où ils demeureront éternellement. » Le miroir me montre l'alternative sans équivoque. Il y a ceux qui croient et suivent la guidance, et il y a ceux qui rejettent. Les conséquences sont claires : le Feu éternel. Ce n'est pas une menace vide — c'est une réalité à prendre au sérieux.`,
  reflection: `Le rejet de la vérité a des conséquences. L'enfer n'est pas un mythe — c'est l'aboutissement logique du refus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kul'lazi kafaru » — quant à ceux qui ont mécru. Le rejet actif de la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel signe d'Allah est-ce que je « traite de mensonge » ? Quel aspect de la vérité me dérange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mécréance n'est pas simplement l'ignorance — c'est le rejet délibéré de ce qu'on sait être vrai." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les conséquences sont inscrites dans la structure de la réalité. Le refus crée sa propre prison." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'enfer commence ici pour celui qui refuse la vérité. L'au-delà en est l'accomplissement." }
  ],
  munajat: `Ya Hadi, garde-moi dans la guidance. Ne me laisse pas rejeter Tes signes. Protège-moi du Feu par l'acceptation de Ta vérité.`
};

MIROIR["2:40"] = {
  reference: "2:40",
  theme: ["confiance", "gratitude", "sagesse"],
  emotion: "Rappel historique",
  difficulty: "intermédiaire",
  relatedNames: ["An-Ni'mah", "Al-Wafi"],
  mirrorVersion: `« Ô enfants d'Israël, souvenez-vous de Mes bienfaits dont Je vous ai comblés. Soyez fidèles à Mon pacte, Je serai fidèle au vôtre. » Le miroir me montre le dialogue entre la gratitude et la fidélité. « Souvenez-vous » — le rappel est la base. « Soyez fidèles » — la réponse attendue. « Je serai fidèle » — la promesse divine. La relation avec Allah est un échange : reconnaissance contre bénédiction.`,
  reflection: `L'histoire d'Israël est un modèle pour tous. Les bienfaits reçus demandent la reconnaissance et la fidélité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udhkuru ni'mati » — souvenez-vous de Ma faveur. Le souvenir est la première dette." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits d'Allah est-ce que j'oublie ? Suis-je fidèle au pacte que J'ai conclu avec Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fidélité d'Allah précède la nôtre. Il est fidèle même quand nous ne le sommes pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu Ses bienfaits. Chaque communauté sera interrogée sur sa reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le « pacte » n'est pas un contrat légal — c'est une relation d'amour et de confiance." }
  ],
  munajat: `Ya Wafi, Tu as été fidèle à Tes promesses envers moi. Aide-moi à être fidèle au pacte que j'ai avec Toi. Ne me laisse pas oublier Tes bienfaits.`
};

MIROIR["2:41"] = {
  reference: "2:41",
  theme: ["confiance", "guidance", "méditation"],
  emotion: "Continuité de la révélation",
  difficulty: "intermédiaire",
  relatedNames: ["As-Siddiq", "Al-Haqq"],
  mirrorVersion: `« Croyez à ce que J'ai fait descendre en confirmation de ce que vous avez déjà. » Le miroir me montre la cohérence de la révélation. Le Coran ne contredit pas les écritures précédentes — il les confirme. La vérité est une, ses expressions sont multiples. Les enfants d'Israël sont appelés à reconnaître la suite de leur propre histoire dans l'islam.`,
  reflection: `La vérité ne change pas — elle s'approfondit. Reconnaître la suite de sa tradition dans une nouvelle révélation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Musaddiqan » — en confirmation. Le Coran valide ce qui l'a précédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité là où elle se trouve, même si elle vient d'une source nouvelle pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la vérité suivante est la preuve qu'on a compris la vérité précédente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est un fleuve qui coule depuis Adam jusqu'au dernier prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Coran reconnaît Moïse et Jésus qui l'ont annoncé." }
  ],
  munajat: `Ya Haqq, fais que je reconnaisse Ta vérité sous toutes Ses formes. Ne me laisse pas rejeter une révélation parce qu'elle me semble nouvelle.`
};

MIROIR["2:42"] = {
  reference: "2:42",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Clarté exigée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Batin"],
  mirrorVersion: `« Ne mélangez pas le vrai avec le faux, ne cachez pas la vérité sciemment. » Le miroir me montre deux pièges : le mélange et la dissimulation. Mélanger le vrai et le faux — la confusion volontaire. Cacher la vérité — le mensonge par omission. Les deux détruisent la confiance et la guidance. La clarté est une obligation spirituelle.`,
  reflection: `La vérité ne se négocie pas. Le mélange est une trahison, le silence est une complicité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La talbisu » — ne mélangez pas. La confusion est un choix, pas un accident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je mélange le vrai et le faux ? Quelle vérité est-ce que je cache « sciemment » ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui cache la vérité se cache de lui-même. Le menteur est sa première victime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne mélange pas. L'eau est pure ou polluée. La vérité aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La clarté intérieure précède la clarté extérieure. Celui qui ment aux autres ment d'abord à lui-même." }
  ],
  munajat: `Ya Haqq, délivre-moi du mélange et du mensonge. Fais que ma parole soit claire et que mon cœur ne cache rien de Ta vérité.`
};

MIROIR["2:43"] = {
  reference: "2:43",
  theme: ["prière", "confiance", "méditation"],
  emotion: "Commandements fondamentaux",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Ar-Raziq"],
  mirrorVersion: `« Accomplissez la prière, acquittez l'aumône, et inclinez-vous avec ceux qui s'inclinent. » Le miroir me montre les trois piliers pratiques : la prière (connexion verticale), l'aumône (partage horizontal), la communauté (soumission collective). Ces trois actes structurent la vie du croyant. « Avec ceux qui s'inclinent » — la foi n'est pas solitaire, elle est communautaire.`,
  reflection: `La prière sans partage est incomplète. Le partage sans prière est insuffisant. Les deux dans la communauté forment l'islam.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aqimu as-salat » — établissez la prière. Le verbe implique constance et régularité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est ma prière ? Mon aumône ? Ma communauté ? Les trois sont-ils équilibrés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inclinaison collective enseigne l'humilité individuelle. On s'incline mieux ensemble que seul." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière relie le ciel et la terre. L'aumône relie les humains entre eux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La communauté n'est pas une contrainte — elle est le miroir où se reflète ma soumission." }
  ],
  munajat: `Ya Salam, établis ma prière, purifie mon aumône, et fais que je me prosterne avec Tes serviteurs. Les trois pour Toi.`
};

MIROIR["2:44"] = {
  reference: "2:44",
  theme: ["sagesse", "méditation", "guérison"],
  emotion: "Incohérence dénoncée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Commandez-vous aux gens la piété alors que vous l'oubliez pour vous-mêmes ? » Le miroir me montre l'incohérence la plus fréquente : prêcher ce qu'on ne pratique pas. Le décalage entre la parole et l'acte mine l'autorité morale. Ce verset m'interroge : où suis-je en train de dire aux autres ce que je ne fais pas moi-même ?`,
  reflection: `L'exemple vaut mieux que le discours. La cohérence entre dire et faire est la base de la crédibilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tansawna anfusakum » — vous oubliez vous-mêmes. L'aveuglement sur soi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je prêche que je ne pratique pas ? Où est mon incohérence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La meilleure prédication est l'exemple. Le silence accompagné d'actes vaut mieux que les paroles sans actes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de prédicateurs incohérents. L'authenticité est rare et précieuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réforme lui-même n'a pas besoin de prêcher — son exemple suffit." }
  ],
  munajat: `Ya Basir, Tu vois le décalage entre mes paroles et mes actes. Aide-moi à me réformer avant de réformer les autres. Fais que ma vie soit mon message.`
};

MIROIR["2:46"] = {
  reference: "2:46",
  theme: ["confiance", "méditation", "prière"],
  emotion: "Certitude intérieure",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mulaqi", "Al-Khaliq"],
  mirrorVersion: `« Qui s'attendent à la rencontre d'Allah et savent qu'ils retourneront vers Lui. » Le miroir me montre l'attitude du croyant face à la mort : non pas la peur, mais l'attente. « Zann » — la conviction profonde. La rencontre avec Allah est certaine. Cette certitude transforme toute la vie. Chaque acte devient préparation à cette rencontre.`,
  reflection: `La mort n'est pas une fin — c'est un retour. Vivre avec cette conscience change tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Liqa' Allah » — la rencontre d'Allah. Le terme implique un face-à-face attendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en attendant cette rencontre ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui craint la rencontre a quelque chose à cacher. Celui qui l'attend a quelque chose à montrer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout retourne à sa source. L'eau à la mer, l'âme à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La rencontre a déjà lieu pour celui dont le cœur est présent." }
  ],
  munajat: `Ya Mulaqi, fais que j'attende notre rencontre avec joie, pas avec peur. Prépare-moi à Te voir.`
};

MIROIR["2:47"] = {
  reference: "2:47",
  theme: ["gratitude", "confiance", "méditation"],
  emotion: "Reconnaissance privilégiée",
  difficulty: "débutant",
  relatedNames: ["Al-Mun'im", "Al-Fadil"],
  mirrorVersion: `« Ô enfants d'Israël, souvenez-vous de Mes bienfaits dont Je vous ai comblés, et que Je vous ai préférés à tous les mondes. » Le miroir me montre le privilège accordé. « Préférés » — une election qui n'est pas un droit, mais une responsabilité. Les bienfaits reçus doivent être reconnus. Le privilège implique le devoir.`,
  reflection: `L'élection divine n'est pas un orgueil à revendiquer — c'est une responsabilité à assumer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faddaltukum » — Je vous ai préférés. La préférence divine demande reconnaissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels privilèges ai-je reçus ? Est-ce que je les reconnais ou les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence n'est pas définitive. Elle peut être retirée si elle n'est pas honorée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu des bienfaits spécifiques. Chacune sera interrogée sur sa reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus grande préférence est celle qui mène à Allah, pas celle qui éloigne de Lui." }
  ],
  munajat: `Ya Mun'im, Tu m'as privilégié de tant de façons. Aide-moi à honorer ce privilège par la reconnaissance et l'obéissance.`
};

MIROIR["2:48"] = {
  reference: "2:48",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Responsabilité individuelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Dayyan", "Al-'Adl"],
  mirrorVersion: `« Et craignez un jour où nulle âme ne profitera à une autre, où l'on n'acceptera aucune intercession, où l'on ne recevra aucune compensation, et où ils ne seront point secourus. » Le miroir me place devant le Jugement dernier. Chacun est seul. Les relations humaines, les protections, les médiateurs — tout disparaît. Il n'y a que l'individu et son Créateur. Cette solitude radicale appelle une préparation radicale.`,
  reflection: `Le Jour dernier est le moment de vérité. Les illusions tombent. Chacun porte son destin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tujzi nafsun » — nulle âme ne paiera. L'individualité absolue du jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi compté-je ? Qui peut m'aider ce jour-là ? La réponse est : personne, sauf Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession existe, mais par la permission d'Allah, pas par le pouvoir des intercesseurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice absolue du Jour dernier reflète la justice absolue d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit déjà seul avec Allah n'a pas peur de la solitude du Jugement." }
  ],
  munajat: `Ya Dayyan, fais que je ne compte que sur Toi. Prépare-moi pour le jour où je serai seul devant Toi.`
};

MIROIR["2:49"] = {
  reference: "2:49",
  theme: ["gratitude", "méditation", "délivrance"],
  emotion: "Souvenir de la libération",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Al-Ghafur"],
  mirrorVersion: `« Et quand Nous vous avons délivrés des gens de Pharaon qui vous infligeaient le pire châtiment. » Le miroir me montre la délivrance historique d'Israël de l'esclavage égyptien. « Le pire châtiment » — l'oppression extrême. La délivrance divine vient au moment le plus sombre. Chaque croyant a ses « Pharaons » intérieurs et extérieurs dont Allah peut le délivrer.`,
  reflection: `La délivrance suit l'épreuve. L'histoire d'Israël est modèle pour chaque histoire personnelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Najjaynakum » — Nous vous avons sauvés. Le salut vient d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quels « Pharaons » Allah m'a-t-il délivré ? Quelle esclavage a-t-Il brisé dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La délivrance physique précède souvent la délivrance spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de l'oppression et de la libération se répète dans chaque génération." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand Pharaon est en nous — l'ego qui opprime l'âme." }
  ],
  munajat: `Ya Munji, Tu as délivré Israël de Pharaon. Délivre-moi de mes oppresseurs intérieurs et extérieurs. Brise mes chaînes.`
};

MIROIR["2:50"] = {
  reference: "2:50",
  theme: ["gratitude", "méditation", "miracle"],
  emotion: "Miracle de la mer",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Qadir"],
  mirrorVersion: `« Et quand Nous avons fendu la mer pour vous, vous sauvant et noyant les gens de Pharaon sous vos yeux. » Le miroir me place devant le miracle visible. La mer fendue — l'impossible devenu possible. Le sauvetage et la destruction simultanés. Les Israélites ont vu de leurs yeux. Le miracle n'est pas une légende — c'est une intervention divine dans l'histoire.`,
  reflection: `Les miracles sont les signes d'Allah dans l'histoire. Ils restent possibles pour chaque croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faraqna » — Nous avons fendu. L'intervention directe d'Allah dans la nature." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles « mers » Allah a-t-Il fendues pour moi ? Quels passages impossibles a-t-Il ouverts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui sauve les uns détruit les autres. La même mer est passage ou tombeau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois de la nature plient devant la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La mer intérieure peut aussi être fendue — l'océan des passions divisé par la guidance." }
  ],
  munajat: `Ya Fattah, fends les mers de ma vie. Ouvre les passages que je crois impossibles. Sauve-moi et noie mes oppresseurs.`
};

MIROIR["2:51"] = {
  reference: "2:51",
  theme: ["méditation", "pardon", "confiance"],
  emotion: "Alliance et rupture",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Et quand Nous avons donné à Moïse rendez-vous pendant quarante nuits, puis qu'après cela vous avez pris le veau pour idole. » Le miroir me montre la fragilité de la foi humaine. Moïse part quarante jours — et en son absence, le veau d'or. L'homme passe de la révélation à l'idolâtrie en quelques semaines. Cette inconstance est la nôtre. L'absence du guide visible nous fait chuter.`,
  reflection: `La foi sans pratique s'affaisse. L'absence du prophète ne doit pas signifier l'absence d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Arba'ina laylah » — quarante nuits. Le temps de l'épreuve et de la purification." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand le guide n'est pas là, qu'est-ce que j'adore ? Quel « veau d'or » remplace Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence de Moïse était une épreuve — et les Israélites ont échoué. L'épreuve continue pour nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération a ses veaux d'or — l'argent, le pouvoir, la gloire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai croyant n'a pas besoin du prophète visible — il porte le prophète dans son cœur." }
  ],
  munajat: `Ya Tawwab, même quand le guide s'éloigne, garde-moi fidèle. Ne me laisse pas adorer de veaux d'or en l'absence de Ta présence visible.`
};

MIROIR["2:52"] = {
  reference: "2:52",
  theme: ["pardon", "confiance", "espoir"],
  emotion: "Grâce après la faute",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "At-Tawwab"],
  mirrorVersion: `« Puis Nous vous avons pardonné après cela, afin que vous soyez reconnaissants. » Le miroir me montre la miséricorde qui suit l'idolâtrie. Ils ont adoré le veau — et Allah leur a pardonné. Pourquoi ? « Afin que vous soyez reconnaissants ». Le pardon n'est pas une licence à pécher — c'est une invitation à la gratitude. La reconnaissance suit la grâce.`,
  reflection: `Le pardon divin est immense. Il appelle une réponse : la gratitude qui mène à la fidélité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Afawna » — Nous avons pardonné. Le pardon suit la faute grave." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle faute ai-je commise qu'Allah m'a pardonnée ? Est-ce que j'ai répondu par la gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'efface pas la faute — il la transforme en dette de gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde divine précède et suit chaque faute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus grande gratitude est de ne plus recommencer la faute pardonnée." }
  ],
  munajat: `Ya Ghafur, Tu m'as pardonné tant de fois. Fais que ma gratitude soit ma fidélité. Ne me laisse pas abuser de Ton pardon.`
};

MIROIR["2:53"] = {
  reference: "2:53",
  theme: ["guidance", "sagesse", "méditation"],
  emotion: "Don de la Loi",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Furqan"],
  mirrorVersion: `« Et quand Nous avons donné à Moïse le Livre et le Discernement, afin que vous soyez guidés. » Le miroir me montre le don de la Torah. « Le Livre » — la révélation. « Le Discernement » — la capacité de distinguer le vrai du faux. Ces deux dons ensemble forment la guidance. Le Livre sans discernement peut être mal interprété. Le discernement sans Livre peut s'égarer.`,
  reflection: `La guidance demande la révélation ET la compréhension. Les deux viennent d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-Kitab wa al-furqan » — le Livre et le Discernement. Les deux sont nécessaires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je le Livre sans le discernement ? Ou le discernement sans le Livre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le discernement est la lumière qui permet de lire le Livre correctement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute révélation demande un cœur capable de la discerner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand discernement est de reconnaître la vérité quand elle se présente." }
  ],
  munajat: `Ya Hadi, donne-moi Ton Livre et le discernement pour le comprendre. Fais que je sois parmi les guidés.`
};

MIROIR["2:54"] = {
  reference: "2:54",
  theme: ["pardon", "sagesse", "méditation"],
  emotion: "Repentir radical",
  difficulty: "avancé",
  relatedNames: ["At-Tawwab", "Al-Bari"],
  mirrorVersion: `« Tuez-vous vous-mêmes, cela sera meilleur pour vous auprès de votre Créateur. » Le miroir me montre un repentir extrême. Après l'idolâtrie du veau, la pénitence demandée était la mort de ceux qui avaient péché. Certains interprètent cela comme le meurtre des coupables par les innocents. Le message est clair : le péché grave demande un repentir total, même au prix de la vie. Le pardon a un prix.`,
  reflection: `Le repentir n'est pas une parole légère. Certaines fautes demandent une transformation radicale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uqtulu anfusakum » — tuez-vous vous-mêmes. Le commandement est littéral et symbolique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le prix de mon repentir ? Suis-je prêt à « tuer » en moi ce qui a péché ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Tuer son ego » est le repentir spirituel. Mourir à soi pour vivre en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute transformation demande une mort — la mort de l'ancien pour la naissance du nouveau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte de mourir à lui-même reçoit la vraie vie." }
  ],
  munajat: `Ya Bari, je veux me repentir vraiment. Aide-moi à tuer en moi ce qui doit mourir pour que vive ce qui doit vivre.`
};

MIROIR["2:55"] = {
  reference: "2:55",
  theme: ["méditation", "sagesse", "confiance"],
  emotion: "Demande présomptueuse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muti", "Al-Mani'"],
  mirrorVersion: `« Et quand vous dites : Ô Moïse, nous ne croirons pas en toi jusqu'à ce que nous voyions Allah ouvertement. » Le miroir me montre la demande impossible. Voir Allah directement, dans cette vie — une exigence déraisonnable. La foudre les frappa pour leur présomption. Ils voulaient voir l'Invisible — et l'Invisible les a foudroyés. La foi ne demande pas à voir.`,
  reflection: `La demande de voir Allah est une forme d'orgueil. La foi authentique croit sans voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jahratan » — ouvertement, clairement. La demande de vision directe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'exige d'Allah avant de croire ? Quelles conditions ma foi pose-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi qui demande à voir n'est pas la foi. C'est de la connaissance forcée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invisible est le domaine d'Allah. L'homme reçoit les signes, pas la vision directe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit Allah sans mourir a reçu la plus grande grâce — mais ce n'est pas pour l'exiger." }
  ],
  munajat: `Ya Allah, je crois sans voir. Ne me laisse pas exiger des preuves que Tu ne m'as pas promises. Ma foi suffit.`
};

MIROIR["2:56"] = {
  reference: "2:56",
  theme: ["espoir", "méditation", "gratitude"],
  emotion: "Résurrection après la mort",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Ba'ith"],
  mirrorVersion: `« Puis Nous vous avons ressuscités après votre mort, afin que vous soyez reconnaissants. » Le miroir me montre la grâce après le châtiment. La foudre les a tués — et Allah les a ressuscités. La mort spirituelle peut être suivie de la vie spirituelle. Le cycle mort-résurrection est une leçon : même après la faute la plus grave, le retour est possible.`,
  reflection: `La résurrection est possible dans cette vie. Le péché n'a pas le dernier mot.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ba'tharnakum » — Nous vous avons ressuscités. La vie après la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle « mort » ai-je connue dont Allah m'a ressuscité ? Comment ai-je répondu à cette vie nouvelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort spirituelle est plus grave que la mort physique. La résurrection spirituelle plus précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque matin est une résurrection. Chaque repentir est une nouvelle vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui meurt avant de mourir ne meurt pas quand il meurt." }
  ],
  munajat: `Ya Muhyi, Tu m'as ressuscité tant de fois. Fais que chaque nouvelle vie soit vécue en reconnaissance. Ne me laisse pas retourner à la mort.`
};

MIROIR["2:57"] = {
  reference: "2:57",
  theme: ["gratitude", "méditation", "confiance"],
  emotion: "Providence dans le désert",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muhaymin"],
  mirrorVersion: `« Et Nous vous avons couverts de l'ombre des nuages, et fait descendre sur vous la manne et les cailles. » Le miroir me montre la provision divine dans le désert. L'ombre contre le soleil brûlant. La manne — nourriture inconnue. Les cailles — viande inattendue. Dans le désert le plus aride, Allah pourvoit. L'ingratitude est donc incompréhensible.`,
  reflection: `Le désert n'est pas l'absence de provision — c'est le lieu où la provision se révèle extraordinaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-ghamam » — les nuages. « Al-manna wa as-salwa » — la manne et les cailles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quel désert suis-je ? Quelle « manne » Allah m'envoie-t-Il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision dans le désert est plus étonnante que la provision dans l'abondance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le désert est le lieu de la confiance absolue. Là, on dépend entièrement d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie manne est spirituelle — la présence d'Allah dans l'aridité." }
  ],
  munajat: `Ya Razzaq, Tu as nourri Israël dans le désert. Nourris-moi dans mes déserts. Envoie Ton ombre, Ta manne, Tes cailles.`
};

MIROIR["2:58"] = {
  reference: "2:58",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Entrée promise",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Muhaymin"],
  mirrorVersion: `« Et quand Nous avons dit : Entrez dans cette ville, et mangez-y à votre aise. » Le miroir me montre la promesse d'entrée. La ville sainte — Jérusalem — attendait les Israélites. « Mangez à votre aise » — l'abondance promise. « Entrez par la porte en vous prosternant » — l'humilité demandée. L'entrée dans la bénédiction demande l'humilité.`,
  reflection: `La promesse divine s'accomplit. L'entrée demande une attitude : l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udkhulu al-bab » — entrez par la porte. Le mode d'entrée est précis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle « ville » Allah me promet ? Comment dois-je y entrer — avec humilité ou orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation à l'entrée est la reconnaissance que le don n'est pas un droit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque grâce a sa porte. Chaque porte a son mode d'entrée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie ville sainte est le cœur où Allah entre." }
  ],
  munajat: `Ya Warith, fais-moi entrer dans Tes promesses avec humilité. Je me prosterne avant d'entrer.`
};

MIROIR["2:59"] = {
  reference: "2:59",
  theme: ["sagesse", "méditation", "confiance"],
  emotion: "Désobéissance et conséquence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakim"],
  mirrorVersion: `« Mais les injustes changèrent en une autre la parole qui leur avait été dite. » Le miroir me montre la transformation de la parole divine. Allah avait dit une chose — ils en firent une autre. La désobéissance verbale précède la désobéissance actuelle. Changer les mots, c'est déjà changer le sens. Les conséquences suivirent : « Nous envoyâmes du ciel un châtiment. »`,
  reflection: `La parole d'Allah n'est pas à modifier. L'adapter à ses désirs est une forme de rébellion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Baddala » — ils changèrent. La modification de la parole divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle parole d'Allah est-ce que je « change » pour qu'elle me convienne mieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment suit le changement. La conséquence est inscrite dans l'acte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des révélations est l'histoire de leurs altérations par les hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde la parole intacte garde la bénédiction intacte." }
  ],
  munajat: `Ya Hakim, garde-moi de changer Ta parole. Fais que je l'accepte comme Tu l'as donnée, sans modification.`
};

MIROIR["2:60"] = {
  reference: "2:60",
  theme: ["méditation", "gratitude", "confiance"],
  emotion: "Eau du rocher",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mu'ti"],
  mirrorVersion: `« Et quand Moïse demanda de l'eau pour son peuple, Nous dîmes : Frappe le rocher avec ton bâton. » Le miroir me montre la provision miraculeuse. L'eau du rocher — l'impossible qui devient réalité. Douze sources pour douze tribus — chacun reçoit sa part. « Mangez et buvez » — l'invitation à la jouissance reconnaissante. « Ne semez pas le désordre » — l'avertissement contre l'ingratitude.`,
  reflection: `Le rocher peut donner de l'eau. Le désert peut devenir source. Tout est possible avec Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« I-drib bi-asak al-hajar » — frappe le rocher avec ton bâton. L'acte qui déclenche le miracle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel « rocher » dois-je frapper dans ma vie ? Quel bâton Allah m'a-t-Il donné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau jaillit du plus dur. La douceur peut venir de ce qui semble le plus résistant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre elle-même peut donner de l'eau. La création tout entière est une provision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur dur peut devenir source s'il est frappé par le bâton de la guidance." }
  ],
  munajat: `Ya Razzaq, fais jaillir l'eau de mes rochers. Donne-moi le bâton qui ouvre les sources. Abreuve-moi dans mes déserts.`
};

MIROIR["2:61"] = {
  reference: "2:61",
  theme: ["méditation", "sagesse", "ingratitude"],
  emotion: "Ingratitude dénoncée",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Razzaq", "Al-Mun'im"],
  mirrorVersion: `« Et quand vous dites : Ô Moïse, nous ne supporterons plus une seule nourriture. » Le miroir me montre l'ingratitude sous son jour le plus clair. La manne — nourriture céleste — ne suffit plus. Ils veulent des lentilles, des oignons, de l'ail — la nourriture d'Égypte, du pays de l'esclavage. Ils préfèrent la nourriture de l'esclavage à celle de la liberté. Cette demande révèle une âme encore esclave.`,
  reflection: `L'ingratitude n'est pas seulement l'oubli — c'est la préférence pour l'esclavage sur la liberté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan nasbira » — nous ne supporterons pas. L'impatience révèle l'ingratitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle « manne » Allah me donne-t-Il que je méprise ? Quel « Égypte » regretté-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture du désert est supérieure à celle d'Égypte, mais l'ingrat ne le voit pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Beaucoup préfèrent les chaînes connues à la liberté inconnue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regrette l'Égypte n'est pas prêt pour la Terre promise." }
  ],
  munajat: `Ya Razzaq, je ne veux pas regretter mes Égyptes. Apprends-moi à aimer Ta manne. Ne me laisse pas préférer l'esclavage à la liberté.`
};

MIROIR["2:63"] = {
  reference: "2:63",
  theme: ["confiance", "méditation", "alliance"],
  emotion: "Alliance renouvelée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wafi", "Al-Muhaymin"],
  mirrorVersion: `« Et quand Nous avons pris votre engagement et élevé au-dessus de vous le Mont. » Le miroir me montre l'alliance dramatique. Le Mont Sinaï « élevé » au-dessus d'eux comme un toit — une image de la gravité de l'engagement. L'alliance n'est pas une parole légère, c'est un pacte scellé sous la montagne. « Tenez ferme ce que Nous vous avons donné » — la réception demande la fidélité.`,
  reflection: `L'engagement avec Allah est sérieux. Il demande une fidélité constante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Raf'na » — Nous avons élevé. La montagne comme garantie de l'alliance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel engagement ai-je pris avec Allah ? Est-ce que je le tiens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La montagne élevée est devenue protection, pas menace." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création témoigne des alliances divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient son engagement n'a pas peur de la montagne." }
  ],
  munajat: `Ya Wafi, aide-moi à tenir mes engagements envers Toi. Je veux être fidèle à l'alliance que j'ai contractée.`
};

MIROIR["2:64"] = {
  reference: "2:64",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Inconstance déplorée",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Puis vous vous êtes détournés après cela. » Le miroir me montre l'inconstance humaine. L'alliance scellée — et le détournement qui suit. « S'il n'était la grâce d'Allah et Sa miséricorde, vous seriez parmi les perdants. » La grâce divine précède et suit l'infidélité humaine.`,
  reflection: `L'homme se détourne facilement. La miséricorde divine rattrape constamment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tawallaytum » — vous vous êtes détournés. Le mouvement d'éloignement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi me suis-je détourné ? Quelle alliance ai-je abandonnée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement humain est rattrapé par la grâce divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde est le filet qui empêche la chute définitive." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Sans grâce, nous serions perdus. La conscience de cette grâce sauve." }
  ],
  munajat: `Ya Ghafur, je me suis détourné tant de fois. Mais Ta grâce me rattrape. Ne me laisse pas perdre définitivement.`
};

MIROIR["2:65"] = {
  reference: "2:65",
  theme: ["sagesse", "méditation", "loi"],
  emotion: "Conséquence exemplaire",
  difficulty: "avancé",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Vous connaissez ceux d'entre vous qui transgressèrent le Sabbat. » Le miroir me montre la conséquence de la transgression délibérée. Le Sabbat violé — et la transformation en singes. Cette métamorphose n'est pas seulement physique, elle est spirituelle : devenir comme un animal, sans conscience morale. Le péché répété sans repentir animalise l'homme.`,
  reflection: `La transgression persistante déshumanise. L'homme peut devenir pire qu'un animal par ses choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qiradah » — singes. La transformation comme conséquence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle transgression répétée m'animalise ? Où perds-je ma conscience morale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'animalisation n'est pas une punition externe — c'est la conséquence interne du péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme peut descendre plus bas que la bête. La conscience morale peut s'éteindre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint cette transformation garde sa conscience éveillée." }
  ],
  munajat: `Ya Hakam, garde-moi de transgresser délibérément. Protège mon humanité. Ne me laisse pas devenir ce que je ne devrais pas être.`
};

MIROIR["2:66"] = {
  reference: "2:66",
  theme: ["sagesse", "méditation", "avertissement"],
  emotion: "Exemple pour tous",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mudhakkir"],
  mirrorVersion: `« Nous en avons fait un exemple châtié pour leurs contemporains et leurs successeurs, et une exhortation pour les pieux. » Le miroir me montre que les châtiments divins ne sont pas seulement des punitions — ce sont des leçons. « Un exemple » — une histoire à méditer. « Une exhortation pour les pieux » — les croyants tirent des leçons des erreurs des autres.`,
  reflection: `L'histoire est une école. Les erreurs des autres sont des avertissements pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nakkalan » — exemple châtié. La visée pédagogique du châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle leçon tire-je des erreurs des autres ? Est-ce que j'apprends ou répète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sage apprend des erreurs des autres. L'insensé répète les mêmes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine est remplie de leçons non apprises." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire des leçons de tout évite beaucoup d'épreuves." }
  ],
  munajat: `Ya Mudhakkir, fais que j'apprenne des leçons de l'histoire. Ne me laisse pas répéter les erreurs de ceux qui m'ont précédés.`
};

MIROIR["2:67"] = {
  reference: "2:67",
  theme: ["confiance", "méditation", "obéissance"],
  emotion: "Commandement étrange",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Et quand Moïse dit à son peuple : Allah vous ordonne de sacrifier une vache. » Le miroir me montre un commandement qui semble absurde. Pourquoi une vache ? Pourquoi ce sacrifice ? Les questions ont fusé au lieu de l'obéissance immédiate. Ce verset illustre la difficulté humaine à obéir sans comprendre.`,
  reflection: `L'obéissance à Allah ne dépend pas de la compréhension du commandement. La confiance précède le sens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yadhbah » — sacrifier. Un commandement qui semble sans rapport avec leur situation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel commandement d'Allah est-ce que je « discute » au lieu d'obéir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les questions ont rendu le commandement plus difficile. L'obéissance simple aurait été plus facile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les commandements divins ont toujours un sens, même s'il nous échappe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance aveugle du croyant est plus lucide que le questionnement du sceptique." }
  ],
  munajat: `Ya Khaliq, quand Tu commandes, fais que j'obéisse. Ne me laisse pas discuter Tes ordres. Je fais confiance à Ta sagesse.`
};

MIROIR["2:68"] = {
  reference: "2:68",
  theme: ["confiance", "méditation", "questions"],
  emotion: "Complexification volontaire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khaliq"],
  mirrorVersion: `« Ils dirent : Prie ton Seigneur pour nous, qu'Il nous clarifie quelle est-elle. » Le miroir me montre comment les questions inutiles compliquent ce qui devrait être simple. « Une vache » — n'importe quelle vache aurait suffi au début. Les questions ont rendu l'obéissance plus difficile et plus coûteuse.`,
  reflection: `Les questions excessives ne sont pas de la sagesse — c'est de l'hésitation déguisée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tubayyin » — clarifie. La demande de précision qui alourdit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je « complexifie » ce qui devrait être simple ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Moins de questions, plus d'obéissance. La simplicité est la voie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La simplicité du cœur accueille les commandements divins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit simplement n'a pas besoin de comprendre complètement." }
  ],
  munajat: `Ya Hakim, délivre-moi du questionnement excessif. Fais que j'obéisse avec simplicité.`
};

MIROIR["2:69"] = {
  reference: "2:69",
  theme: ["confiance", "méditation", "détails"],
  emotion: "Détails demandés",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Ils dirent : Prie ton Seigneur pour nous, qu'Il nous clarifie sa couleur. » Le miroir me montre l'escalade des questions. D'abord « quelle vache », puis « quelle couleur ». Chaque question ajoute une condition. La réponse : « jaune, de couleur vive » — une précision qui aurait pu être évitée par l'obéissance initiale.`,
  reflection: `Chaque détail demandé rend l'obéissance plus spécifique, plus difficile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sawda' » — jaune. La couleur spécifique demandée et donnée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels détails inutiles est-ce que je demande avant d'agir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La couleur précise n'était pas nécessaire — l'obéissance l'était." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les détails qui semblent importants peuvent être des distractions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'action simple vaut mieux que la spécification complexe." }
  ],
  munajat: `Ya Musawwir, ne me laisse pas me perdre dans les détails. Fais que j'obéisse d'abord.`
};

MIROIR["2:70"] = {
  reference: "2:70",
  theme: ["confiance", "méditation", "hésitation"],
  emotion: "Dernière hésitation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Khaliq"],
  mirrorVersion: `« Ils dirent : Prie ton Seigneur pour nous, qu'Il nous clarifie laquelle, car les vaches se ressemblent à nous. » Le miroir me montre la dernière hésitation avant l'obéissance forcée. « Se ressemblent à nous » — l'excuse pour retarder encore. Chaque hésitation a un coût. La vache finalement sacrifiée était rare et précieuse — le prix de l'hésitation.`,
  reflection: `L'hésitation prolonge l'épreuve et peut augmenter son coût.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tashabaha » — se ressemblent. L'excuse de la confusion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle obéissance est-ce que je retarde par des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance immédiate aurait coûté moins cher." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps passé à hésiter est du temps perdu à obéir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit rapidement paie moins cher que celui qui hésite." }
  ],
  munajat: `Ya Hadi, ne me laisse pas hésiter. Fais que j'obéisse sans délai quand Tu commandes.`
};

MIROIR["2:71"] = {
  reference: "2:71",
  theme: ["confiance", "méditation", "obéissance finale"],
  emotion: "Obéissance accomplie",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Wafi"],
  mirrorVersion: `« Il dit : C'est une vache qui n'a pas été labourée, qui n'a pas arrosé la terre, intacte, sans tache. » Le miroir me montre enfin la description complète. Une vache parfaite — non utilisée pour le travail, pure. « Ils la trouvèrent, mais ils faillirent ne pas le faire. » Même à la fin, l'hésitation persiste. L'obéissance est un combat jusqu'au bout.`,
  reflection: `L'obéissance complète demande de surmonter l'hésitation jusqu'au moment de l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Musallamah » — intacte, sans tache. La perfection de la vache demandée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche d'obéir complètement, même quand je sais ce qu'il faut faire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance presque manquée est un avertissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perfection demandée reflète la perfection de l'obéissance attendue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit sans hésitation accomplit parfaitement." }
  ],
  munajat: `Ya Wafi, aide-moi à obéir complètement, sans hésiter jusqu'au bout. Fais que mon obéissance soit entière.`
};

MIROIR["2:72"] = {
  reference: "2:72",
  theme: ["sagesse", "méditation", "justice"],
  emotion: "Mystère résolu",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Et quand vous avez tué un homme et que chacun de vous a cherché à se disculper. » Le miroir me montre le contexte du commandement de la vache. Un meurtre non résolu — et Allah a utilisé le sacrifice de la vache pour révéler le coupable. Les commandements divins ont des sens cachés qui se révèlent dans l'obéissance.`,
  reflection: `Les commandements d'Allah ont des buts que nous ne pouvons pas toujours percevoir initialement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qatal-tum » — vous avez tué. Le crime caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel crime est caché dans ma vie ? Qu'est-ce qu'Allah pourrait révéler par Son commandement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice de la vache avait un but : révéler la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est caché pour Allah. Ses commandements percent les secrets." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance révèle ce que l'orgueil cache." }
  ],
  munajat: `Ya Hakam, révèle ce qui doit être révélé dans ma vie. Purifie-moi par Ton commandement.`
};

MIROIR["2:73"] = {
  reference: "2:73",
  theme: ["méditation", "guérison", "miracle"],
  emotion: "Résurrection par le miracle",
  difficulty: "avancé",
  relatedNames: ["Al-Muhyi", "Al-Ba'ith"],
  mirrorVersion: `« Nous dîmes : Frappez le cadavre avec une partie de la vache. » Le miroir me montre la résurrection comme preuve. La vache sacrifiée a servi à ressusciter le mort — qui a désigné son meurtrier. Le miracle suit l'obéissance. La résurrection n'est pas seulement pour l'au-delà — elle peut intervenir ici-bas.`,
  reflection: `La vie et la mort sont entre les mains d'Allah. Il peut ressusciter quand Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« I-dribuhu » — frappez-le. Le commandement qui déclenche la résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est « mort » dans ma vie qu'Allah peut ressusciter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cadavre a parlé. La mort n'est pas définitive entre les mains d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection n'est pas seulement future — elle est possible maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance au commandement divin peut ressusciter ce qui semblait mort." }
  ],
  munajat: `Ya Muhyi, ressuscite ce qui est mort en moi. Fais que mon obéissance apporte la vie là où il n'y a que mort.`
};

MIROIR["2:74"] = {
  reference: "2:74",
  theme: ["méditation", "sagesse", "cœur"],
  emotion: "Dureté du cœur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muqallib", "Al-Hadi"],
  mirrorVersion: `« Puis vos cœurs se sont endurcis après cela, devenant comme des pierres ou plus durs encore. » Le miroir me montre la conséquence de l'entêtement : le durcissement du cœur. Les miracles vus n'ont pas ramolli les cœurs — ils les ont endurcis par le refus. « Il y a des pierres d'où jaillissent des rivières » — même les pierres sont plus souples que certains cœurs.`,
  reflection: `Le cœur peut devenir plus dur que la pierre. Les miracles ne ramollissent pas celui qui refuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qasat qulubukum » — vos cœurs se sont endurcis. La dureté comme conséquence du refus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il plus dur que la pierre ? Qu'est-ce qui l'a endurci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pierre peut laisser couler l'eau. Le cœur endurci ne laisse rien passer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature est plus flexible que le cœur orgueilleux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le durcissement de son cœur est déjà en train de s'attendrir." }
  ],
  munajat: `Ya Muqallib, attends mon cœur avant qu'il ne devienne pierre. Fais couler Tes rivières à travers moi.`
};

MIROIR["2:75"] = {
  reference: "2:75",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Espoir déçu",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mu'min"],
  mirrorVersion: `« Espérez-vous qu'ils croient en vous, alors qu'un groupe d'entre eux entendait la parole d'Allah puis la déformait après l'avoir comprise ? » Le miroir me montre l'aveuglement volontaire. Ils entendaient la parole d'Allah — et ils la déformaient sciemment. La connaissance n'est pas la foi. On peut connaître la vérité et la rejeter.`,
  reflection: `La connaissance de la vérité ne garantit pas son acceptation. L'orgueil peut tout déformer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuharrifunaha » — ils la déformaient. La modification consciente de la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle vérité connue est-ce que je déforme pour qu'elle me convienne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La déformation de la parole d'Allah est un choix, pas un malentendu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité peut être connue et rejetée. La connaissance n'est pas la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui déforme la vérité se déforme lui-même." }
  ],
  munajat: `Ya Hadi, garde-moi de déformer Ta parole. Fais que je l'accepte telle qu'elle est.`
};

MIROIR["2:76"] = {
  reference: "2:76",
  theme: ["sagesse", "méditation", "hypocrisie"],
  emotion: "Double langage dénoncé",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Batin"],
  mirrorVersion: `« Quand ils rencontrent ceux qui croient, ils disent : Nous croyons. » Le miroir me montre le double langage. Face aux croyants : « Nous croyons ». Entre eux : « Parlez-vous de ce qu'Allah a révélé ? Pourquoi leur en parler alors qu'ils en feront un argument contre vous ? » L'hypocrisie se révèle dans l'intimité.`,
  reflection: `Le double langage est le signe de l'hypocrisie. La vérité n'a qu'un seul visage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amintum » — avez-vous cru ? La profession de foi publique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis la même chose en public et en privé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité connue devient un « argument » qu'on veut cacher." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le double langage finit par se contredire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache la vérité la porte comme un fardeau." }
  ],
  munajat: `Ya 'Alim, Tu connais mes paroles publiques et privées. Unifie mon langage. Fais que je dise la vérité partout.`
};

MIROIR["2:77"] = {
  reference: "2:77",
  theme: ["méditation", "sagesse", "confiance"],
  emotion: "Ignorance coupable",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Batin"],
  mirrorVersion: `« Ne savent-ils pas qu'Allah sait ce qu'ils cachent et ce qu'ils divulguent ? » Le miroir me montre l'absurdité du secret face à Allah. Ils croient cacher — mais Allah sait tout. « Ce qu'ils cachent et ce qu'ils divulguent » — les deux sont transparents pour Lui. L'hypocrite se ment à lui-même en pensant tromper Dieu.`,
  reflection: `Rien n'est caché à Allah. L'hypocrisie est un aveuglement sur Sa omniscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamu » — Il sait. La connaissance divine englobe tout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « cache » pensant qu'Allah ne sait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le secret n'existe pas pour Allah. Tout est manifeste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'omniscience divine rend vaine toute tentative de dissimulation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en présence de la connaissance divine cesse de cacher." }
  ],
  munajat: `Ya 'Alim, Tu sais tout. Délivre-moi de l'illusion du secret. Je vis devant Toi, transparent.`
};

MIROIR["2:78"] = {
  reference: "2:78",
  theme: ["méditation", "sagesse", "connaissance"],
  emotion: "Ignorance exploitée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hadi"],
  mirrorVersion: `« Parmi eux, il y a des illettrés qui ne connaissent pas le Livre, mais seulement des illusions. » Le miroir me montre l'ignorance exploitée. Les « illettrés » ne connaissent pas le Livre — ils suivent ce qu'on leur dit. « Des illusions » — des mensonges habillés de vérité. L'ignorance rend vulnérable à la manipulation.`,
  reflection: `L'ignorance du Livre rend dépendant des interprétations humaines. La connaissance directe protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ummiyun » — illettrés, ignorants du Livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais le Livre moi-même, ou est-ce que je dépend des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance n'est pas une excuse quand le Livre est accessible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance directe de la révélation protège des manipulations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne connaît pas le Livre par lui-même est manipulable." }
  ],
  munajat: `Ya 'Alim, enseigne-moi Ton Livre. Ne me laisse pas dépendre des interprétations des autres. Donne-moi la connaissance directe.`
};

MIROIR["2:79"] = {
  reference: "2:79",
  theme: ["sagesse", "méditation", "vérité"],
  emotion: "Falsification dénoncée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hafiz"],
  mirrorVersion: `« Malheur à ceux qui écrivent le Livre de leurs mains puis disent : Ceci vient d'Allah, pour le vendre à vil prix. » Le miroir me montre la falsification délibérée. Écrire un faux et l'attribuer à Allah — le crime spirituel suprême. « Pour le vendre à vil prix » — le profit mondain comme motivation. La vérité est monnayée.`,
  reflection: `Attribuer à Allah ce qu'Il n'a pas dit est un crime contre la vérité et contre les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wayl » — malheur. La malédiction sur les falsificateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah ce qu'Il n'a pas dit ? Quelles « vérités » inventé-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le faux attribué à Allah est pire que le faux ordinaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des religions est aussi l'histoire des falsifications." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la parole d'Allah ne l'altère jamais." }
  ],
  munajat: `Ya Haqq, préserve-moi de falsifier Ta parole. Fais que je transmette ce que Tu as dit, rien de plus, rien de moins.`
};

MIROIR["2:80"] = {
  reference: "2:80",
  theme: ["méditation", "sagesse", "espoir"],
  emotion: "Illusion rassurante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Ils disent : Le Feu ne nous touchera que pour quelques jours. » Le miroir me montre l'auto-illusion. Se rassurer sur le châtiment — minimiser la conséquence du péché. « Dis : Avez-vous pris un engagement avec Allah ? » — non, c'est une illusion. La certitude du salut sans preuve est une forme de mécréance.`,
  reflection: `Se rassurer sans fondement est un piège. La certitude du salut doit être fondée sur la promesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayyaman ma'dudah » — quelques jours comptés. La minimisation du châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi se fonde ma certitude du salut ? Est-ce l'engagement d'Allah ou mon imagination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'engagement d'Allah existe — mais pour ceux qui le respectent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'auto-illusion est la pire des illusions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne s'illusionne pas sur son salut travaille pour l'obtenir." }
  ],
  munajat: `Ya Haqq, ne me laisse pas m'illusionner sur mon salut. Donne-moi la certitude fondée sur Ta promesse et mon obéissance.`
};

MIROIR["2:81"] = {
  reference: "2:81",
  theme: ["sagesse", "méditation", "justice"],
  emotion: "Réalité inévitable",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Haqq"],
  mirrorVersion: `« Certes, celui qui a fait le mal et qui est cerné par son péché, ceux-là sont les gens du Feu. » Le miroir me montre la vérité sans illusion. Le mal entoure celui qui le commet — « cerné » par ses propres péchés. Les péchés ne sont pas seulement des actes — ils deviennent une prison. Le Feu n'est pas arbitraire — il est la conséquence du mal.`,
  reflection: `Le péché n'est pas isolé — il cerne celui qui le commet. La prison est construite par le pécheur lui-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muḥīṭ » — cerné, entouré. Le péché comme encerclement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels péchés me « cerne » ? Quelle prison construis-je moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir peut briser l'encerclement. La grâce peut libérer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal crée sa propre géographie — l'enfer est ici avant d'être là-bas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le péché l'entourer peut encore en sortir par le repentir." }
  ],
  munajat: `Ya 'Adl, je suis cerné par mes péchés. Libère-moi par Ton pardon. Brise l'encerclement que j'ai moi-même créé.`
};

MIROIR["2:82"] = {
  reference: "2:82",
  theme: ["espoir", "confiance", "méditation"],
  emotion: "Promesse d'espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wafi"],
  mirrorVersion: `« Et ceux qui croient et font de bonnes œuvres, ce sont les gens du Paradis. » Le miroir me montre la contrepartie. Si le mal mène au Feu, la foi et les œuvres mènent au Paradis. La foi sans œuvres est incomplète. Les œuvres sans foi sont insuffisantes. Les deux ensemble — foi et action — ouvrent la porte du Jardin.`,
  reflection: `Le Paradis se mérite. La foi et les œuvres sont les deux clefs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amanu wa 'amilu as-salihat » — ils ont cru et fait de bonnes œuvres. Les deux ensemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi produit-elle des œuvres ? Mes œuvres sont-elles fondées sur la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas un don sans condition — c'est une promesse avec exigence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La structure de l'univers récompense le bien et punit le mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combine foi et œuvres marche vers le Paradis dès cette vie." }
  ],
  munajat: `Ya Jannah, fais que ma foi produise des œuvres. Ouvre-moi les portes du Paradis par Ta grâce et mes efforts.`
};

MIROIR["2:83"] = {
  reference: "2:83",
  theme: ["méditation", "sagesse", "éthique"],
  emotion: "Éthique concrète",
  difficulty: "débutant",
  relatedNames: ["Al-Barr", "Ar-Rahman"],
  mirrorVersion: `« Et quand Nous avons pris l'engagement des enfants d'Israël de n'adorer qu'Allah, d'être bons envers les parents, les proches, les orphelins, les pauvres. » Le miroir me montre l'éthique concrète de l'alliance. L'adoration d'Allah est liée au traitement des humains. La vertu verticale (adoration) et la vertu horizontale (bonté envers les autres) sont inséparables.`,
  reflection: `La foi authentique se manifeste dans les relations humaines. On ne peut pas adorer Allah et maltraiter les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bil-walidayn ihsanan » — envers les parents, la bonté. La liste continue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment traité-je les catégories mentionnées : parents, proches, orphelins, pauvres, voyageurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration sans bonté envers les autres est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute éthique authentique relie le divin et l'humain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait du bien aux autres fait du bien à son âme." }
  ],
  munajat: `Ya Barr, enseigne-moi la bonté concrète. Fais que mon adoration se reflète dans mes relations avec les autres.`
};

MIROIR["2:84"] = {
  reference: "2:84",
  theme: ["confiance", "méditation", "alliance"],
  emotion: "Pacte de non-violence",
  difficulty: "intermédiaire",
  relatedNames: ["As-Salam", "Al-Hafiz"],
  mirrorVersion: `« Et quand Nous avons pris votre engagement de ne pas verser votre sang et de ne pas vous expulser les uns les autres de vos demeures. » Le miroir me montre le contenu social de l'alliance. Pas de violence entre croyants. Pas d'expulsion de leurs foyers. La communauté de foi est une communauté de paix. Briser cette paix, c'est briser l'alliance.`,
  reflection: `La foi crée une fraternité qui interdit la violence entre croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tasfiku dima'akum » — ne pas verser votre sang. L'interdiction fondamentale." },
    { label: "Le Reflet", ar: "المرçad", color: "var(--mirror)", text: "Comment traité-je mes frères et sœurs dans la foi ? Ai-je brisé cette alliance de paix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La violence entre croyants est une rupture de l'alliance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix entre croyants est le fondement de la communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maintient la paix maintient l'alliance." }
  ],
  munajat: `Ya Salam, fais de moi un artisan de paix. Garde-moi de verser le sang ou d'expulser quiconque de son foyer.`
};

MIROIR["2:85"] = {
  reference: "2:85",
  theme: ["sagesse", "méditation", "incohérence"],
  emotion: "Incohérence dénoncée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Puis vous vous entre-tuez et vous expulsez une partie des vôtres de leurs demeures. » Le miroir me montre la rupture flagrante de l'alliance. Ils avaient accepté le pacte de paix — et ils le brisent. « Vous croyez à une partie du Livre et rejetez le reste. » L'incohérence est manifeste : accepter ce qui arrange et rejeter ce qui dérange.`,
  reflection: `La foi sélective n'est pas la foi. On ne peut pas choisir dans la révélation ce qui nous convient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tu'minuna ba'dihi » — vous croyez à une partie. La sélection dans la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle partie du Livre est-ce que j'accepte ? Quelle partie est-ce que je rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sélective est une forme de rejet de la totalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est totale ou elle n'est pas la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte tout le Livre accepte le Tout." }
  ],
  munajat: `Ya Haqq, délivre-moi de la foi sélective. Fais que j'accepte tout ce que Tu as révélé, même ce qui me coûte.`
};

MIROIR["2:86"] = {
  reference: "2:86",
  theme: ["sagesse", "méditation", "choix"],
  emotion: "Choix tragique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Akhirah", "Al-Haqq"],
  mirrorVersion: `« Ce sont eux qui ont acheté la vie d'ici-bas au prix de l'au-delà. » Le miroir me montre le mauvais commerce. Échanger l'éternel contre le temporel. « Leur châtiment ne sera pas allégé, et ils ne seront point secourus. » La conséquence est claire. Le choix de ce monde contre l'autre a un prix définitif.`,
  reflection: `La vie d'ici-bas n'est pas mauvaise — mais l'échanger contre l'au-delà est la pire des affaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ish-taraw al-hayat ad-dunya » — ils ont acheté la vie d'ici-bas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'échange contre l'au-delà ? Quel prix temporel paie-je pour l'éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bon commerce est l'inverse : acheter l'au-delà au prix d'ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vie est un commerce. Que vendons-nous ? Que gardons-nous ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que l'au-delà est éternel ne l'échange contre rien." }
  ],
  munajat: `Ya Akhirah, ne me laisse pas T'échanger contre ce monde. Fais que je paie le prix de l'éternité maintenant.`
};

// ============================================
// SURAH 2 (AL-BAQARAH) - VERSES 87-286
// ============================================

MIROIR["2:87"] = {
  reference: "2:87",
  theme: ["prophètes", "révélation", "guidance"],
  emotion: "Révérence, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Ruh", "Al-Muhaymin"],
  mirrorVersion: `« Nous avons donné le Livre à Moïse, et après lui, Nous avons envoyé les prophètes. Et Nous avons donné à Jésus, fils de Marie, des preuves évidentes, et Nous l'avons fortifié par le Saint-Esprit. » Le miroir me montre la continuité de la révélation. De Moïse à Jésus, de Jésus à Muhammad — le même Dieu, le même message. Le Saint-Esprit (Ruh al-Qudus) qui fortifiait Jésus est le même qui fortifie chaque croyant. Le miroir m'interroge : est-ce que je reconnais l'unité de la révélation divine ?`,
  reflection: `La chaîne des prophètes est unie. Chacun prépare le suivant. Le dernier scelle le message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa atayna Musa al-kitaba wa qaffayna min ba'dihi bi-r-rusul » — Nous avons donné le Livre à Moïse, et après lui, Nous avons envoyé les prophètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais tous les prophètes ? Ou est-ce que je préfère certains aux autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus d'un prophète est le refus de tous. L'acceptation d'un est l'acceptation de tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est comme une rivière qui coule à travers l'histoire — toujours la même eau, différents lits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la chaîne des prophètes reconnaît l'unité du Message." }
  ],
  munajat: `Ya Allah, Tu as envoyé Tes prophètes les uns après les autres. Fais que je les reconnaisse tous et que je suis le message final.`
};

MIROIR["2:88"] = {
  reference: "2:88",
  theme: ["cœur", "endurcissement", "malédiction"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qasim", "Al-Mu'ti"],
  mirrorVersion: `« Ils disent : 'Nos cœurs sont voilés.' Mais non ! Allah les a maudits pour leur incrédulité. » Le miroir me montre le danger de l'auto-justification. Ils prétendaient que leurs cœurs étaient voilés de l'extérieur, mais Allah révèle que c'est leur propre incrédulité qui a causé le voile. Le cœur n'est pas voilé par Dieu arbitrairement — il s'endurcit par nos choix répétés. Le miroir m'interroge : quelles excuses je donne pour ne pas écouter ?`,
  reflection: `Le voile sur le cœur n'est pas une punition arbitraire — c'est le résultat de nos choix répétés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulubuna ghulf » — nos cœurs sont voilés (enfermés, scellés)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles excuses je donne pour ne pas écouter la vérité ? Mon cœur est-il vraiment fermé ou est-ce mon choix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Dire « mon cœur est fermé » est souvent une façon d'éviter de l'ouvrir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur qui s'endurcit devient comme la pierre — insensible à la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le remède à l'endurcissement est la reconnaissance de notre responsabilité." }
  ],
  munajat: `Ya Rabb, ne permets pas que mon cœur s'endurcisse. Garde-le ouvert à Ta lumière et à Ta guidance.`
};

MIROIR["2:89"] = {
  reference: "2:89",
  theme: ["révélation", "reconnaissance", "jalousie"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Quand leur est venu d'Allah un Livre confirmant celui qu'ils avaient déjà, alors qu'auparavant ils demandaient la victoire sur les mécréants, quand leur est venu ce qu'ils reconnaissaient, ils l'ont renié. » Le miroir me montre le paradoxe tragique de la jalousie. Ils connaissaient la vérité, ils l'attendaient, ils la priaient — mais quand elle est venue, ils l'ont rejetée. Pourquoi ? Parce qu'elle n'est pas venue par l'intermédiaire qu'ils espéraient. Le miroir m'interroge : est-ce que je reconnais la vérité même quand elle ne vient pas comme je l'attends ?`,
  reflection: `La jalousie et l'orgueil peuvent nous faire rejeter ce que nous attendions avec impatience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ils demandaient la victoire, mais quand le Livre est venu, ils l'ont rejeté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la vérité parce qu'elle ne vient pas de la source que je préfère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité n'appartient à personne. La reconnaître où qu'elle soit est le signe de la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière du soleil ne change pas selon la fenêtre par laquelle elle entre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime vraiment la vérité la reconnaît même chez son ennemi." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je La reconnaisse partout, même quand Elle ne vient pas comme je l'attends.`
};

MIROIR["2:90"] = {
  reference: "2:90",
  theme: ["jalousie", "colère", "perdition"],
  emotion: "Gravité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghadab", "Al-Muntaqim"],
  mirrorVersion: `« Comme est mauvais ce qu'ils ont vendu leurs âmes : ne pas croire en ce qu'Allah a fait descendre, par jalousie. » Le miroir me montre le poison de la jalousie. Elle pousse à rejeter la vérité non par conviction, mais par rivalité. Ils ont « vendu leurs âmes » — un commerce désastreux. Le miroir m'interroge : qu'est-ce que ma jalousie me fait rejeter ? Qu'est-ce que je perds par rivalité ?`,
  reflection: `La jalousie est un poison qui nous fait rejeter le bien même quand nous le connaissons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-ghasillin » — par jalousie, ils ont rejeté la révélation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma jalousie me fait rejeter ? Qui est-ce que je ne peux pas voir réussir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jalousie retourne contre nous le bien que l'autre a reçu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque créature a sa place. La jalousie est un désordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réjouit du bien d'autrui reçoit une part de ce bien." }
  ],
  munajat: `Ya Rabb, purifie mon cœur de la jalousie. Fais que je me réjouisse du bien que Tu donnes aux autres.`
};

MIROIR["2:91"] = {
  reference: "2:91",
  theme: ["sélectivité", "hypocrisie", "prophètes"],
  emotion: "Lucidité, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "As-Sadiq"],
  mirrorVersion: `« Croyez à ce qu'Allah a fait descendre, disent-ils. Mais ils ne croient qu'à ce qui a été révélé avant toi. » Le miroir me montre la foi sélective. Ils acceptent les prophètes du passé mais rejettent le présent. C'est une forme subtile de rejet — accepter la vérité passée pour éviter la vérité présente. Le miroir m'interroge : est-ce que je choisis ce que je veux croire ?`,
  reflection: `La foi sélective n'est pas la foi — c'est la préférence déguisée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ils croient à Moïse mais pas à Muhammad — une foi partielle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis dans la révélation ce qui m'arrange et rejette ce qui me dérange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Croire aux prophètes passés sans croire au présent est un non-sens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est une. Refuser une partie de la lumière, c'est refuser la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte toute la révélation accepte le Tout." }
  ],
  munajat: `Ya Rabb, ne me laisse pas choisir dans Ta révélation. Fais que j'accepte tout ce que Tu as envoyé.`
};

MIROIR["2:92"] = {
  reference: "2:92",
  theme: ["idolâtrie", "égarement", "moïse"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Khaliq"],
  mirrorVersion: `« Moïse vous est venu avec des preuves évidentes. En son absence, vous avez pris le veau pour idole. » Le miroir me montre la fragilité de la foi sans pratique. En l'absence du prophète, ils sont retournés à l'idolâtrie. L'idole n'est pas seulement une statue — c'est tout ce qui remplace Dieu dans le cœur. Le miroir m'interroge : qu'est-ce que j'adore en l'absence de guidance visible ?`,
  reflection: `L'idolâtrie est le retour naturel du cœur sans guidance constante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittakhahtumu al-'ijl » — vous avez pris le veau pour idole." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon « veau d'or » ? Qu'est-ce qui remplace Dieu dans mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence du prophète est un test. Le croyant maintient la foi même dans l'absence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque époque a ses idoles. Aujourd'hui, elles sont moins visibles mais tout aussi présentes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment Dieu ne Le remplace par rien." }
  ],
  munajat: `Ya Allah, ne permets pas que je prenne des idoles en Ton absence. Sois toujours présent dans mon cœur.`
};

MIROIR["2:93"] = {
  reference: "2:93",
  theme: ["alliance", "montagne", "engagement"],
  emotion: "Solennité, rappel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jalil", "Al-Muta'ali"],
  mirrorVersion: `« Nous avons élevé la montagne au-dessus de vous et avons dit : 'Tenez fermement ce que Nous vous avons donné.' » Le miroir me montre la scène spectaculaire de l'alliance. La montagne suspendue comme un toit, le peuple prosterné, l'engagement solennel. Ils ont dit « nous avons entendu et obéi » — mais leur histoire montre qu'ils ont oublié. Le miroir m'interroge : qu'ai-je promis à Allah et qu'ai-je oublié ?`,
  reflection: `L'alliance avec Dieu est solennelle. La montagne suspendue symbolise la gravité de l'engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rafa'na fauqakumu at-tura » — Nous avons élevé la montagne au-dessus de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je promis à Allah ? Qu'ai-je oublié de mes engagements spirituels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La montagne au-dessus de la tête force l'attention. Sans elle, nous oublions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont des signes. Elles rappellent la grandeur de Dieu et la gravité de l'engagement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'alliance n'est pas un fardeau — c'est un honneur. Dieu nous a choisis pour elle." }
  ],
  munajat: `Ya Rabb, j'ai entendu et j'ai promis. Aide-moi à ne pas oublier. Rappelle-moi mon engagement.`
};

MIROIR["2:94"] = {
  reference: "2:94",
  theme: ["désir", "mort", "vérité"],
  emotion: "Défi, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Mumit"],
  mirrorVersion: `« Dis : Si la Demeure dernière auprès d'Allah est pour vous seuls, à l'exclusion des autres, souhaitez donc la mort. » Le miroir me montre un défi impossible. Ceux qui prétendent être les seuls élus devraient souhaiter la mort pour rejoindre leur récompense. Mais ils ne le souhaitent pas — parce que leur prétention est fausse. Le miroir m'interroge : ma foi est-elle assez forte pour que je souhaite la rencontre avec Allah ?`,
  reflection: `La vraie foi ne craint pas la mort — elle l'espère comme retour à la Maison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tamannaw al-mawt » — souhaitez donc la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je souhaite la rencontre avec Allah ? Ou est-ce que je m'accroche à ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas souhaiter la mort révèle l'attachement à ce monde et le doute sur l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est la porte de la Demeure dernière. Celui qui croit vraiment ne la craint pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le croyant équilibré ne cherche pas la mort mais ne la craint pas non plus." }
  ],
  munajat: `Ya Rabb, fais que je sois prêt à Te rencontrer. Ne me laisse pas m'accrocher à ce monde au point de craindre la mort.`
};

MIROIR["2:95"] = {
  reference: "2:95",
  theme: ["hypocrisie", "attachement", "vérité"],
  emotion: "Lucidité, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Mais ils ne la souhaiteront jamais, à cause de ce que leurs mains ont avancé. » Le miroir me montre que nos actions déterminent notre relation avec la mort. Ceux qui font le mal craignent la rencontre avec le Juge. Ceux qui font le bien l'espèrent. Le miroir m'interroge : qu'est-ce que mes mains ont avancé ? Suis-je prêt à rendre des comptes ?`,
  reflection: `La peur de la mort est proportionnelle à la conscience de nos mauvaises actions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bima qaddamat aydihim » — à cause de ce que leurs mains ont avancé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai avancé ? Qu'est-ce que je présenterai à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bonnes actions font de la mort une libération. Les mauvaises en font une terreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vie est un prêt. La mort est le moment de rendre ce qu'on a fait du prêt." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien n'a rien à craindre de la mort — il a tout à y gagner." }
  ],
  munajat: `Ya Rabb, je veux Te rencontrer avec des mains pures. Aide-moi à faire le bien pour ne pas craindre la mort.`
};

MIROIR["2:96"] = {
  reference: "2:96",
  theme: ["attachement", "vie", "priorités"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Mumit"],
  mirrorVersion: `« Tu les trouveras les plus attachés à la vie, plus encore que les associateurs. » Le miroir me montre un paradoxe tragique. Ceux qui prétendent être le peuple élu sont plus attachés à cette vie que les païens. La prétention spirituelle ne garantit pas le détachement. Le miroir m'interroge : à quoi suis-je vraiment attaché ? La vie ou l'au-delà ?`,
  reflection: `L'attachement à la vie est universel, mais il devrait diminuer chez ceux qui croient en l'au-delà.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ahsasa an-nasi hayatan » — les plus attachés à la vie parmi les hommes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je devais choisir entre vivre mille ans et mourir demain pour Allah, que choisirais-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Croire en l'au-delà sans y aspirer est une contradiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie est un voyage. L'attachement excessif au voyageur empêche d'arriver à destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vraiment détaché de ce monde peut y vivre pleinement — car il n'a peur de rien perdre." }
  ],
  munajat: `Ya Rabb, je m'accroche à cette vie. Apprends-moi à l'aimer sans m'y attacher. Fais que l'au-delà soit mon vrai but.`
};

MIROIR["2:97"] = {
  reference: "2:97",
  theme: ["gabriel", "révélation", "foi"],
  emotion: "Révérence, guidance",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Ruh al-Amin", "Jibril"],
  mirrorVersion: `« Dis : Quiconque est ennemi de Gabriel — c'est lui qui a fait descendre sur ton cœur la permission d'Allah. » Le miroir me montre le rôle de Gabriel (Jibril). Il est l'intermédiaire entre le ciel et la terre, l'ange qui apporte la révélation au cœur du Prophète. Être ennemi de Gabriel, c'est être ennemi de la révélation elle-même. Le miroir m'interroge : est-ce que j'accueille la révélation ? Est-ce que je reconnais son origine divine ?`,
  reflection: `Gabriel est le porteur de la révélation. Le rejeter, c'est rejeter le message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nazzalahu 'ala qalbika bi-idhni Allah » — il l'a fait descendre sur ton cœur avec la permission d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois la révélation dans mon cœur ? Ou est-ce que je la rejette par orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ange n'est qu'un messager. Le message appartient à Dieu. Rejeter le messager, c'est rejeter l'Envoyeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les médiateurs entre le visible et l'invisible. Gabriel est le plus élevé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui accueille Gabriel accueille la lumière du ciel." }
  ],
  munajat: `Ya Rabb, Tu as envoyé Gabriel avec Ta révélation. Ouvre mon cœur à ce message. Fais que je ne sois pas ennemi de Tes anges.`
};

MIROIR["2:98"] = {
  reference: "2:98",
  theme: ["anges", "ennemis", "guerre"],
  emotion: "Gravité, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-Jabbar"],
  mirrorVersion: `« Quiconque est ennemi d'Allah, de Ses anges, de Ses messagers, de Gabriel et de Michel — Allah est l'ennemi des mécréants. » Le miroir me montre la gravité de l'hostilité envers le divin. Être ennemi des messagers d'Allah, c'est s'attirer Son inimitié. C'est une guerre perdue d'avance. Le miroir m'interroge : suis-je en paix avec Allah et Ses messagers ?`,
  reflection: `L'hostilité envers les messagers divins est l'hostilité envers Dieu Lui-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-inna Allaha 'aduwwun lil-kafirin » — Allah est l'ennemi des mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je en paix avec Dieu ? Ou y a-t-il en moi une hostilité cachée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être ennemi de Dieu n'est pas une position de force — c'est une position de perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, il n'y a pas de neutralité. On est avec Dieu ou contre Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est en paix avec Dieu est en paix avec tout l'univers." }
  ],
  munajat: `Ya Rabb, je veux être Ton ami, pas Ton ennemi. Fais la paix avec moi et fais que je sois en paix avec Toi.`
};

MIROIR["2:99"] = {
  reference: "2:99",
  theme: ["signes", "clarté", "rejet"],
  emotion: "Tristesse, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "An-Nur"],
  mirrorVersion: `« Nous avons fait descendre vers toi des signes évidents. Seuls les pervers les renient. » Le miroir me montre que la clarté des signes ne garantit pas l'acceptation. Les signes sont évidents, mais le cœur pervers les rejette. Le problème n'est pas dans les signes — il est dans le cœur. Le miroir m'interroge : mon cœur est-il ouvert aux signes évidents ?`,
  reflection: `Les signes sont clairs. Le rejet vient du cœur, pas de l'intelligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayatin bayyinatin » — des signes évidents, clairs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes évidents est-ce que je rejette dans ma vie ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pervers ne voit pas parce qu'il ne veut pas voir. L'aveuglement est un choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Chaque atome témoigne de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit les signes voit Dieu partout." }
  ],
  munajat: `Ya Rabb, Tes signes sont partout. Ouvre mes yeux pour les voir et mon cœur pour les accepter.`
};

MIROIR["2:100"] = {
  reference: "2:100",
  theme: ["promesse", "rupture", "habitude"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Ash-Shahid"],
  mirrorVersion: `« Chaque fois qu'ils font un pacte, une partie d'entre eux le rompt. » Le miroir me montre l'habitude de la trahison. Ce n'est pas une exception — c'est une règle chez eux. La promesse est facile à faire, la rupture est facile à justifier. Le miroir m'interroge : est-ce que je tiens mes promesses ? Même quand c'est difficile ?`,
  reflection: `La promesse n'a de valeur que si elle est tenue. La rupture habituelle détruit la confiance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullama 'ahadu 'ahdan nabada dahu » — chaque fois qu'ils font un pacte, une partie le rompt." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles promesses ai-je faites et rompues ? Suis-je fiable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse facile est souvent rompue facilement. La promesse difficile est précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque créature tient son rôle. L'homme seul peut trahir sa parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient sa parole reflète la fidélité de Dieu." }
  ],
  munajat: `Ya Rabb, Tu es fidèle à Tes promesses. Aide-moi à être fidèle aux miennes. Ne me laisse pas trahir ma parole.`
};

MIROIR["2:101"] = {
  reference: "2:101",
  theme: ["rejet", "méconnaissance", "orgueil"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Quand leur est venu un messager d'Allah confirmant ce qu'ils avaient, une partie de ceux qui avaient reçu le Livre rejetèrent le Livre d'Allah. » Le miroir me montre le rejet de la vérité par orgueil. Ils avaient le Livre, ils connaissaient la vérité, mais ils ont rejeté la confirmation venue d'ailleurs. La connaissance sans l'humilité mène au rejet. Le miroir m'interroge : qu'est-ce que je connais mais que je rejette ?`,
  reflection: `La connaissance peut nourrir l'orgueil au lieu de nourrir la foi. L'humilité est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wara'a zahrihim » — ils tournèrent le dos, rejetant le Livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je connais de la vérité mais que je refuse d'accepter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tourner le dos à la vérité qu'on connaît est le comble de l'aveuglement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil ne se cache pas — c'est nous qui nous détournons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité qu'il connaît reçoit plus de vérité." }
  ],
  munajat: `Ya Rabb, je connais des vérités que je refuse. Humilie mon orgueil. Fais que je reconnaisse ce que Tu m'as montré.`
};

MIROIR["2:102"] = {
  reference: "2:102",
  theme: ["sorcellerie", "égarement", "danger"],
  emotion: "Mise en garde, protection",
  difficulty: "avancé",
  relatedNames: ["Al-Hafiz", "Al-Muhaymin"],
  mirrorVersion: `« Ils suivirent ce que les diables racontaient sur le règne de Salomon. Salomon n'a pas mécru, mais ce sont les diables qui ont mécru. » Le miroir me montre le danger de la sorcellerie et des arts occultes. Ce qui semblait être du pouvoir était en fait de l'égarement. La différence entre le miracle prophétique et la magie démoniaque est la source : l'un vient de Dieu, l'autre des diables. Le miroir m'interroge : où puise-je mon pouvoir ? Quelle est ma source ?`,
  reflection: `Le pouvoir sans Dieu est une illusion dangereuse. La vraie force vient de Lui seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa at-ta'u ma tilawash-shayatin » — ils suivirent ce que les diables racontaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où puise-je mon « pouvoir » ? Est-ce de Dieu ou d'ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sorcellerie promet le contrôle mais livre à l'esclavage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il y a des forces dans l'univers. Les utiliser sans Dieu est dangereux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai pouvoir est dans la soumission à Dieu, pas dans la recherche du contrôle." }
  ],
  munajat: `Ya Hafiz, protège-moi des forces occultes. Je veux mon pouvoir de Toi seul. Garde-moi dans Ta lumière.`
};

MIROIR["2:103"] = {
  reference: "2:103",
  theme: ["foi", "récompense", "mieux"],
  emotion: "Espoir, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Ash-Shakur"],
  mirrorVersion: `« S'ils avaient cru et s'étaient prémunis, la récompense d'auprès d'Allah serait meilleure. » Le miroir me montre l'alternative toujours disponible. Au lieu de chercher le pouvoir par la sorcellerie, ils auraient pu croire et recevoir une récompense bien meilleure. Le chemin de la foi est toujours plus beau que les raccourcis. Le miroir m'interroge : quels raccourcis est-ce que je prends au lieu de la foi ?`,
  reflection: `La foi est le chemin le plus beau. Les raccourcis mènent à des impasses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-thawabun min Allahi khayr » — la récompense d'auprès d'Allah est meilleure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels raccourcis est-ce que je prends ? Quelle est la « meilleure récompense » que je manque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le raccourci semble rapide mais mène loin. La foi semble lente mais mène au but." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a son chemin. L'homme a le choix entre le raccourci et le bon chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La récompense d'Allah n'est pas seulement meilleure — elle est éternelle." }
  ],
  munajat: `Ya Rabb, je prends des raccourcis. Montre-moi le chemin de la foi. Donne-moi la patience de le suivre.`
};

MIROIR["2:104"] = {
  reference: "2:104",
  theme: ["respect", "paroles", "intention"],
  emotion: "Respect, attention",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Basir"],
  mirrorVersion: `« Ô vous qui croyez ! Ne dites pas 'Raina' mais dites 'Unzurna'. » Le miroir me montre l'importance des mots. Les croyants utilisaient un mot ambigu qui pouvait être interprété comme un manque de respect. Allah leur enseigne un mot clair et respectueux. Les mots ont un pouvoir — ils reflètent l'intention du cœur. Le miroir m'interroge : comment je parle ? Mes mots sont-ils respectueux ?`,
  reflection: `Les mots ne sont pas neutres. Ils portent l'intention et peuvent blesser ou élever.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qulu unzurna » — dites 'regarde-nous' avec respect." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je parle ? Mes mots sont-ils respectueux envers Dieu et les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mot ambigu peut être interprété mal. Le mot clair protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole distingue l'homme. Elle peut construire ou détruire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle avec pureté entend la réponse divine avec clarté." }
  ],
  munajat: `Ya Rabb, purifie ma parole. Fais que mes mots soient respectueux et que leur intention soit pure.`
};

MIROIR["2:105"] = {
  reference: "2:105",
  theme: ["miséricorde", "exclusivité", "don"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wahhab"],
  mirrorVersion: `« Ni ceux qui ont mécru parmi les gens du Livre, ni les associateurs, n'aiment qu'on fasse descendre sur vous un bien de la part de votre Seigneur. Mais Allah choisit pour Sa miséricorde qui Il veut. » Le miroir me montre la jalousie des uns et la générosité de l'Autre. Certains ne veulent pas que je reçoive le bien — mais Allah donne à qui Il veut. Sa miséricorde n'est limitée par personne. Le miroir m'interroge : est-ce que je crois que le bien peut me venir malgré l'opposition des autres ?`,
  reflection: `La miséricorde d'Allah n'est soumise à l'approbation de personne. Il donne à qui Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu dhul-fadli al-'azim » — Allah est Détenteur de la grâce immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que le bien peut me venir malgré l'opposition ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'opposition des autres ne peut pas bloquer le don de Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grâce de Dieu est comme la pluie — elle tombe où Dieu veut, sans demander la permission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la grâce divine ne craint pas l'opposition des créatures." }
  ],
  munajat: `Ya Wahhab, Tu donnes à qui Tu veux. Donne-moi de Ta miséricorde malgré l'opposition. Je fais confiance à Ta grâce.`
};

MIROIR["2:106"] = {
  reference: "2:106",
  theme: ["abrogation", "sagesse", "évolution"],
  emotion: "Confiance, soumission",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Nous n'abrogeons aucun verset ni ne le faisons oublier sans en apporter un meilleur ou semblable. » Le miroir me montre la sagesse divine dans l'évolution de la révélation. L'abrogation n'est pas une correction — c'est une progression. Dieu remplace par quelque chose de meilleur ou équivalent. La loi divine s'adapte à la capacité des gens. Le miroir m'interroge : est-ce que j'accepte que Dieu change les règles pour mon bien ?`,
  reflection: `L'abrogation est une miséricorde — Dieu adapte la loi à notre capacité et à notre évolution.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma nansakh min ayatin aw nunsiha na'ti bi-khaylin minha aw mithliha » — Nous n'abrogeons aucun verset sans en apporter un meilleur ou semblable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le changement quand Dieu le veut ? Ou est-ce que je m'accroche au passé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le changement n'est pas une erreur — c'est une évolution. Dieu sait mieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, tout évolue. La révélation aussi suit une progression." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'abrogation accepte la sagesse de Dieu au-delà de sa compréhension." }
  ],
  munajat: `Ya Hakim, Ta sagesse dépasse ma compréhension. J'accepte Tes changements. Je sais que Tu veux mon bien.`
};

MIROIR["2:107"] = {
  reference: "2:107",
  theme: ["souveraineté", "protection", "confiance"],
  emotion: "Sécurité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Waliyy"],
  mirrorVersion: `« Ne sais-tu pas qu'à Allah appartient la royauté des cieux et de la terre, et qu'en dehors d'Allah vous n'avez ni protecteur ni secoureur ? » Le miroir me place devant la souveraineté absolue d'Allah. Tout Lui appartient — les cieux, la terre, et moi. En dehors de Lui, pas de protecteur, pas de secourreur. Cette vérité devrait me rassurer et m'humilier en même temps. Le miroir m'interroge : à qui je fais vraiment confiance ? Qui est mon vrai protecteur ?`,
  reflection: `La souveraineté d'Allah est absolue. En dehors de Lui, tout protecteur est illusoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha lahu mulku as-samawati wa al-ard » — à Allah appartient la royauté des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je fais confiance ? Qui est mon « protecteur » ? Est-ce Allah ou autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chercher un protecteur en dehors d'Allah est chercher une illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient à Dieu. Nous sommes Ses hôtes, pas Ses rivaux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise que Dieu est son seul protecteur n'a plus peur de rien." }
  ],
  munajat: `Ya Malik, Tu es le Roi de tout. Sois mon protecteur. Je n'ai pas d'autre refuge que Toi.`
};

MIROIR["2:108"] = {
  reference: "2:108",
  theme: ["questions", "doutes", "foi"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Ou voulez-vous interroger votre messager comme on a interrogé Moïse auparavant ? » Le miroir me montre le danger des questions excessives. Ceux qui ont questionné Moïse de manière excessive ont fini par le rejeter. La curiosité peut devenir un obstacle à la soumission. Le miroir m'interroge : est-ce que je pose des questions pour comprendre ou pour éviter d'obéir ?`,
  reflection: `La question peut être un chemin vers la connaissance ou une fuite devant l'obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am turiduna an tas'alu rasulakum » — voulez-vous interroger votre messager ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pourquoi je pose des questions ? Pour comprendre ou pour éviter d'obéir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les questions infinies sont souvent un masque pour le refus d'accepter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance a ses limites. La soumission commence là où la compréhension s'arrête." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sans tout comprendre a une foi plus profonde que celui qui comprend tout." }
  ],
  munajat: `Ya Rabb, je pose trop de questions. Aide-moi à accepter ce que je ne comprends pas. Ma soumission vaut plus que ma curiosité.`
};

MIROIR["2:109"] = {
  reference: "2:109",
  theme: ["jalousie", "pardon", "patience"],
  emotion: "Patience, pardon",
  difficulty: "débutant",
  relatedNames: ["Al-'Afuww", "Al-Ghaffur"],
  mirrorVersion: `« Beaucoup parmi les gens du Livre aimeraient pouvoir vous rendre mécréants après votre foi, par jalousie de leurs propres âmes. » Le miroir me montre la jalousie de ceux qui voudraient nous détourner de la foi. Face à cela, la réponse n'est pas la colère mais le pardon et la patience jusqu'à ce qu'Allah vienne avec Son ordre. Le miroir m'interroge : comment je réagis à l'hostilité des autres ? Avec colère ou avec patience ?`,
  reflection: `La jalousie des autres ne peut nous atteindre si nous restons fermes dans la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sfahu wa-sfah hatta ya'tiya Allahu bi-amrih » — pardonnez et effacez jusqu'à ce qu'Allah vienne avec Son ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à l'hostilité ? Avec colère ou avec patience et pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jalousie des autres est leur problème. Mon pardon est mon choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps révèle tout. La patience permet à Dieu d'agir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne reflète la miséricorde de Dieu." }
  ],
  munajat: `Ya 'Afuww, les autres sont jaloux et hostiles. Aide-moi à pardonner et à patienter. Que Ta justice vienne en Son temps.`
};

MIROIR["2:110"] = {
  reference: "2:110",
  theme: ["prière", "aumône", "récompense"],
  emotion: "Espoir, action",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Karim"],
  mirrorVersion: `« Accomplissez la prière et acquittez l'aumône. Tout le bien que vous faites pour vous-mêmes, vous le retrouverez auprès d'Allah. » Le miroir me montre le lien entre l'action présente et la récompense future. La prière, l'aumône — ce ne sont pas des obligations vides. C'est un investissement. Tout bien fait revient à nous auprès d'Allah. Le miroir m'interroge : qu'est-ce que j'investis pour l'éternité ?`,
  reflection: `Le bien fait dans ce monde est un dépôt qu'on retrouvera dans l'au-delà.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma tuqaddimu li-anfusikum min khayrin tajiduhu 'inda Allah » — tout le bien que vous faites pour vous-mêmes, vous le retrouverez auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'investis pour l'éternité ? Quel bien retrouverai-je auprès d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bien fait pour Dieu revient à moi. C'est un investissement qui ne perd jamais." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action est une graine. La récolte se fait auprès d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend cela ne compte plus ses bonnes actions — il les multiplie." }
  ],
  munajat: `Ya Shakur, Tu récompenses le bien. Aide-moi à investir dans la prière et l'aumône. Je veux Te retrouver avec un bon dépôt.`
};

MIROIR["2:111"] = {
  reference: "2:111",
  theme: ["exclusivité", "prétention", "vérité"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Ils ont dit : 'Nul n'entrera au Paradis que Juifs ou Chrétiens.' Voilà leurs prétentions. » Le miroir me montre l'erreur de l'exclusivisme religieux. Personne ne peut revendiquer le Paradis comme sa propriété. L'entrée au Paradis dépend de la foi sincère et des œuvres, pas de l'étiquette religieuse. Le miroir m'interroge : est-ce que je pense que le Paradis m'est dû ?`,
  reflection: `Le Paradis n'appartient à personne. Il est la récompense de la foi sincère et des bonnes œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amaniyyuhum » — voilà leurs prétentions, leurs vœux sans fondement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense que le Paradis m'est dû ? Ou est-ce que je travaille pour l'obtenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Prétendre au Paradis sans le mériter est une illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est une destination. On n'y entre pas par la carte d'identité mais par les œuvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille sincèrement pour le Paradis y entre sans revendication." }
  ],
  munajat: `Ya Rabb, je ne veux pas prétendre au Paradis. Je veux le mériter par ma foi et mes œuvres. Accepte mon effort.`
};

MIROIR["2:112"] = {
  reference: "2:112",
  theme: ["soumission", "sincérité", "récompense"],
  emotion: "Espoir, clarté",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mu'min"],
  mirrorVersion: `« Mais si ! Quiconque soumet son être à Allah tout en étant bienfaisant aura sa récompense auprès de son Seigneur. » Le miroir me montre la vraie condition du salut : la soumission (islam) et la bienfaisance (ihsan). Pas l'appartenance ethnique, pas le nom, mais la qualité du cœur et des actes. La promesse est claire : récompense auprès du Seigneur, sans crainte ni tristesse. Le miroir m'interroge : mon être est-il soumis à Allah ?`,
  reflection: `La soumission sincère et la bienfaisance sont les clés du Paradis — pour tous, sans exception.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man aslama wajhahu li-Lahi wa huwa muhsin » — quiconque soumet son être à Allah tout en étant bienfaisant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon être est-il soumis à Allah ? Suis-je bienfaisant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission n'est pas une perte — c'est un gain. Le moi qui se soumet se réalise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers est soumise à Dieu. L'homme peut choisir de l'être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soumet son être entièrement découvre sa véritable nature." }
  ],
  munajat: `Ya Rabb, je soumets mon être à Toi. Aide-moi à être bienfaisant. Donne-moi ma récompense auprès de Toi.`
};

MIROIR["2:113"] = {
  reference: "2:113",
  theme: ["jugement", "disputes", "vérité"],
  emotion: "Lucidité, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Fattah"],
  mirrorVersion: `« Les Juifs disent : 'Les Chrétiens ne tiennent sur rien.' Et les Chrétiens disent : 'Les Juifs ne tiennent sur rien.' Alors qu'ils lisent le Livre. » Le miroir me montre l'absurdité des disputes religieuses. Chacun rejette l'autre alors qu'ils ont le même Livre. Le jugement appartient à Allah, pas à nous. Le miroir m'interroge : est-ce que je juge les autres groupes religieux ?`,
  reflection: `Les disputes religieuses sont souvent basées sur l'ignorance mutuelle et l'orgueil.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allah yahkumu baynahum yawma al-qiyamati » — Allah jugera entre eux le Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge les autres groupes ? Ou est-ce que je laisse le jugement à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Juger les autres, c'est prendre la place de Dieu. C'est un péché d'orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. Les chemins peuvent être multiples. Dieu juge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se concentre sur son propre chemin ne juge pas celui des autres." }
  ],
  munajat: `Ya Hakam, Tu es le Juge. Je ne veux pas juger les autres. Aide-moi à me concentrer sur mon propre chemin.`
};

MIROIR["2:114"] = {
  reference: "2:114",
  theme: ["mosquées", "interdiction", "injustice"],
  emotion: "Indignation, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Muta'ali"],
  mirrorVersion: `« Qui est plus injuste que celui qui interdit les mosquées d'Allah, pour que Son nom n'y soit pas mentionné ? » Le miroir me montre le comble de l'injustice : empêcher le souvenir d'Allah dans Ses maisons. Les mosquées sont les lieux où le nom d'Allah est invoqué. Les fermer, les détruire, les interdire — c'est l'injustice suprême. Le miroir m'interroge : est-ce que je contribue à la préservation des maisons d'Allah ?`,
  reflection: `Les mosquées sont les maisons d'Allah sur terre. Les protéger est un devoir sacré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man azlamu mimman mana'a masajida Allahi » — qui est plus injuste que celui qui interdit les mosquées d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contribue aux maisons d'Allah ? Est-ce que je fréquente les mosquées ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Interdire le souvenir d'Allah, c'est vouloir étouffer Sa lumière. C'est impossible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mosquées sont des phares. Les éteindre plonge le monde dans l'obscurité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui bâtit et protège une mosquée bâtit et protège sa propre maison dans le Paradis." }
  ],
  munajat: `Ya Rabb, protège Tes maisons. Fais que je les fréquente et les soutienne. Ne permets pas que Ton nom soit oublié.`
};

MIROIR["2:115"] = {
  reference: "2:115",
  theme: ["présence", "orientation", "universalité"],
  emotion: "Réconfort, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Muhit", "Al-Wasi'"],
  mirrorVersion: `« À Allah l'Est et l'Ouest. Où que vous vous tourniez, là est la Face d'Allah. » Le miroir me montre l'ubiquité divine. Allah n'est pas limité à une direction. L'Est, l'Ouest, partout est Sa présence. La qibla est une discipline, pas une limitation. Le miroir m'interroge : est-ce que je réalise que je suis toujours en présence d'Allah, quelle que soit la direction ?`,
  reflection: `Allah est partout. La qibla nous unit, mais Sa présence nous environne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aynama tuwallu fa-thamma wajhu Allah » — où que vous vous tourniez, là est la Face d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que je suis toujours en présence d'Allah ? Pas seulement à la mosquée, pas seulement en prière." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La qibla nous oriente vers un point. La présence d'Allah nous enveloppe de tous les points." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est la mosquée d'Allah. Chaque lieu est un lieu de prière pour le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise cela prie partout, tout le temps, car il est toujours face à Allah." }
  ],
  munajat: `Ya Muhit, Tu es partout. Fais que je Te voie dans chaque direction. Fais que chaque lieu soit un lieu de rencontre avec Toi.`
};

MIROIR["2:116"] = {
  reference: "2:116",
  theme: ["filiation", "transcendance", "unicité"],
  emotion: "Révérence, correction",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Ils disent : 'Allah S'est donné un fils.' Gloire à Lui ! Au contraire, à Lui appartient tout ce qui est dans les cieux et sur la terre. » Le miroir me montre l'erreur d'attribuer la filiation à Dieu. Il n'a pas de fils, pas de famille — Il est le Créateur de tout. Tout Lui appartient, tout Lui obéit. Le miroir m'interroge : est-ce que je purifie ma conception de Dieu de toute anthropomorphie ?`,
  reflection: `Dieu n'a pas de famille. Il est le Créateur, non le père. Tout Lui appartient et Lui obéit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subhanahu » — Gloire à Lui ! Il est au-dessus de ce qu'ils disent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je purifie ma conception de Dieu ? Est-ce que je L'imagine à mon image ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'homme projette sa famille sur Dieu. Dieu est au-dessus de toute projection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers est « fils » de Dieu en tant que création. Mais Il n'a pas de fils au sens propre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend vraiment Dieu Le purifie de toute ressemblance avec la création." }
  ],
  munajat: `Ya Wahid, Tu es Unique, sans fils, sans famille. Purifie ma conception de Toi. Ne me laisse pas T'imaginer à mon image.`
};

MIROIR["2:117"] = {
  reference: "2:117",
  theme: ["création", "commandement", "puissance"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Bari'", "Al-Khaliq"],
  mirrorVersion: `« Le Créateur des cieux et de la terre. Et quand Il décide une chose, Il dit seulement : 'Sois !' et elle est. » Le miroir me place devant la puissance créatrice absolue. Allah n'a pas besoin de matériaux, de temps, d'effort. Une parole : « Sois ! » — et la chose existe. Le miroir m'interroge : est-ce que je fais confiance à Celui qui peut créer par un seul mot ?`,
  reflection: `La création divine est instantanée. « Kun fayakun » — Sois, et c'est.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kun fa-yakun » — Sois ! et elle est." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la puissance absolue d'Allah ? Est-ce que je crois qu'Il peut changer ma situation en un instant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Dieu peut créer par un mot, que sont mes difficultés pour Lui ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tout entier est maintenu par ce commandement « Sois ! ». S'Il disait « Ne sois plus ! », tout disparaîtrait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise « Kun fayakun » attend tout de Dieu, car tout est possible pour Lui." }
  ],
  munajat: `Ya Khaliq, Tu dis « Sois ! » et c'est. Change ma situation par Ta parole. Crée en moi ce que Tu veux.`
};

MIROIR["2:118"] = {
  reference: "2:118",
  theme: ["signes", "demande", "foi"],
  emotion: "Patience, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Bayyinah"],
  mirrorVersion: `« Ceux qui ne savent pas disent : 'Pourquoi Allah ne nous parle-t-Il pas, ou ne nous envoie-t-Il un signe ?' » Le miroir me montre l'aveuglement de ceux qui demandent des signes. Les signes sont partout — dans la création, dans la révélation, dans l'histoire. Mais le cœur fermé ne les voit pas. Le miroir m'interroge : quels signes est-ce que je demande alors qu'ils sont déjà là ?`,
  reflection: `Les signes sont partout. Les demander quand on ne les voit pas révèle l'aveuglement du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawla yukallimuna Allah » — pourquoi Allah ne nous parle-t-Il pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes est-ce que je demande ? Qu'est-ce qui est déjà sous mes yeux que je ne vois pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demander un signe supplémentaire est souvent une excuse pour ne pas voir ceux qui existent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Chaque souffle est un miracle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a les yeux ouverts voit des signes partout, tout le temps." }
  ],
  munajat: `Ya Rabb, les signes sont partout. Ouvre mes yeux. Ne me laisse pas demander ce que Tu as déjà donné.`
};

MIROIR["2:119"] = {
  reference: "2:119",
  theme: ["message", "responsabilité", "vérité"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Bashir"],
  mirrorVersion: `« Nous t'avons envoyé avec la vérité, comme annonciateur et avertisseur. Tu ne seras pas interrogé sur les hôtes de la Fournaise. » Le miroir me montre le rôle du Prophète — et par extension, le rôle de tout croyant. Annoncer la bonne nouvelle et avertir. Le résultat n'est pas notre responsabilité. Nous délivrons le message — Allah juge les cœurs. Le miroir m'interroge : est-ce que je délivre le message ? Est-ce que je me préoccupe trop du résultat ?`,
  reflection: `Le messager délivre le message. Le résultat appartient à Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Basiran wa nadziran » — annonciateur et avertisseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je délivre le message ? Ou est-ce que je me tais par peur du résultat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le résultat n'est pas mon affaire. Mon affaire est d'être fidèle au message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque croyant est un messager pour son entourage. Le message doit passer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se libère du souci du résultat peut délivrer le message avec pureté." }
  ],
  munajat: `Ya Rabb, Tu m'as envoyé avec la vérité. Aide-moi à la délivrer sans me soucier du résultat. Ton jugement suffit.`
};

MIROIR["2:120"] = {
  reference: "2:120",
  theme: ["satisfaction", "foi", "soumission"],
  emotion: "Détermination, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Ni les Juifs, ni les Chrétiens ne seront satisfaits de toi jusqu'à ce que tu suives leur religion. Dis : La guidance d'Allah est la vraie guidance. » Le miroir me montre que la recherche de l'approbation des autres est un chemin sans fin. On ne peut jamais satisfaire tout le monde. La seule guidance qui compte est celle d'Allah. Le miroir m'interroge : à qui je cherche à plaire ? Aux autres ou à Allah ?`,
  reflection: `La recherche de l'approbation des autres est un piège. Seule la guidance d'Allah compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan tarda 'anka al-yahudu wa la an-nasara » — les Juifs et les Chrétiens ne seront jamais satisfaits de toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je cherche à plaire ? Est-ce que je sacrifie ma foi pour l'approbation des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Quand on plaît à Allah, l'approbation des autres devient secondaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque groupe a sa religion. La vraie religion est la soumission à Dieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui plaît à Allah n'a pas besoin de l'approbation des créatures." }
  ],
  munajat: `Ya Rabb, je veux Te plaire à Toi seul. Libère-moi du besoin de l'approbation des autres. Ta guidance suffit.`
};

MIROIR["2:121"] = {
  reference: "2:121",
  theme: ["lecture", "application", "bénédiction"],
  emotion: "Engagement, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Ceux à qui Nous avons donné le Livre et qui le récitent comme il se doit, ceux-là y croient. » Le miroir me montre la relation entre la lecture correcte et la foi. « Comme il se doit » — pas seulement la prononciation, mais la compréhension et l'application. La récitation sans la mise en pratique est incomplète. Le miroir m'interroge : comment je lis le Coran ? Est-ce que je le vis ?`,
  reflection: `La lecture « comme il se doit » implique la récitation, la compréhension et l'application.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatlunahu haqqa tilawatihi » — qui le récitent comme il se doit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je lis le Coran ? Est-ce que je le vis ? Ma lecture transforme-t-elle ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Lire sans vivre est une forme de trahison du texte. Le Coran demande l'action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est une guidance pour l'univers. Le lire correctement, c'est s'aligner sur sa sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme il se doit devient lui-même un Coran vivant." }
  ],
  munajat: `Ya Rabb, je veux lire Ton Livre comme il se doit. Pas seulement le prononcer, mais le comprendre et le vivre. Transforme-moi par Ta parole.`
};

MIROIR["2:122"] = {
  reference: "2:122",
  theme: ["mémoire", "gratitude", "faveur"],
  emotion: "Reconnaissance, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Fadil"],
  mirrorVersion: `« Ô enfants d'Israël, souvenez-vous de Mon bienfait dont Je vous ai comblés et de ce que Je vous ai préférés aux mondes. » Le miroir me montre l'importance de la mémoire spirituelle. Les faveurs d'Allah sont innombrables — les oublier est une forme d'ingratitude. Se souvenir est un acte de foi. Le miroir m'interroge : de quelles faveurs je me souviens ? Lesquelles j'oublie ?`,
  reflection: `La mémoire des faveurs divines est le fondement de la gratitude. Oublier, c'est s'éloigner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udkuru ni'matiya » — souvenez-vous de Mon bienfait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quelles faveurs je me souviens ? Lesquelles j'oublie ? Ma vie est-elle marquée par la gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Oublier les faveurs, c'est vivre comme si on n'avait rien reçu. C'est une forme de négation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature reçoit des faveurs. L'homme est le seul à pouvoir les oublier ou s'en souvenir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient des faveurs reçoit plus de faveurs. La gratitude attire le bien." }
  ],
  munajat: `Ya Mannan, Tes faveurs sont innombrables. Aide-moi à m'en souvenir. Que ma vie soit une reconnaissance constante.`
};

MIROIR["2:123"] = {
  reference: "2:123",
  theme: ["paradis", "récompense", "crainte"],
  emotion: "Espérance, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'id"],
  mirrorVersion: `« Et craignez le Feu préparé pour les mécréants. » Le miroir me place devant la réalité du châtiment. La crainte n'est pas la peur paralysante — c'est la conscience qui guide. Le Feu est une réalité pour ceux qui rejettent la vérité. Le miroir m'interroge : ma crainte d'Allah influence-t-elle mes choix ? Ou est-ce que je vis comme si le Feu n'existait pas ?`,
  reflection: `La crainte du Feu est un rappel constant. Elle ne paralyse pas — elle oriente vers le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa attaqu an-nara allati u'iddat li-l-kafirin » — et craignez le Feu préparé pour les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma crainte d'Allah influence-t-elle mes choix ? Ou est-ce que je vis comme si le Feu n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte n'est pas la peur — c'est la conscience éveillée. Celui qui craint vraiment est libre de la peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action a une conséquence. Le Feu est la conséquence du rejet conscient de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah dans ce monde n'aura rien à craindre dans l'autre." }
  ],
  munajat: `Ya Rabb, fais que Ta crainte me guide vers le bien. Protège-moi du Feu par Ta miséricorde.`
};

MIROIR["2:124"] = {
  reference: "2:124",
  theme: ["alliance", "injustice", "leadership"],
  emotion: "Engagement, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Imam", "Al-Hadi"],
  mirrorVersion: `« Quand Abraham fut éprouvé par des paroles de son Seigneur et qu'il s'en acquitta, Il dit : Je ferai de toi un guide pour les gens. » Le miroir me montre le chemin vers le leadership spirituel : l'épreuve et l'acquittement. Ibrahim a été testé et a réussi. La promesse du leadership vient après l'épreuve. Et ce leadership n'inclut pas les injustes. Le miroir m'interroge : quelles épreuves je traverse ? Suis-je prêt pour la responsabilité ?`,
  reflection: `Le leadership spirituel s'acquiert par l'épreuve réussie. Il n'est pas donné aux injustes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ja'iluka li-n-nasi imama » — Je ferai de toi un guide pour les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles épreuves je traverse ? Suis-je prêt pour la responsabilité ? Mon engagement exclut-il l'injustice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injuste ne peut pas guider vers la justice. Le leader doit incarner ce qu'il enseigne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque guide dans l'histoire a été éprouvé avant d'être élevé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traverse l'épreuve avec succès reçoit le privilège de guider les autres." }
  ],
  munajat: `Ya Rabb, éprouve-moi et donne-moi la force de réussir. Si Tu veux faire de moi un guide, purifie-moi de toute injustice.`
};

MIROIR["2:125"] = {
  reference: "2:125",
  theme: ["ka'bah", "prière", "sanctuaire"],
  emotion: "Révérence, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Bayt", "Al-Haram"],
  mirrorVersion: `« Nous avons fait de la Maison un lieu de rassemblement et un sanctuaire pour les gens. » Le miroir me montre la Ka'bah comme centre spirituel. Un lieu de rassemblement — tous convergent vers lui. Un sanctuaire — la sécurité y règne. La Ka'bah n'est pas seulement un bâtiment de pierre ; elle est le point d'ancrage de la prière et le symbole de l'unité. Le miroir m'interroge : est-ce que je me tourne vers ce centre ? Est-ce que j'en fais mon sanctuaire ?`,
  reflection: `La Ka'bah est le centre spirituel de l'humanité. S'y tourner, c'est s'unir à tous les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna al-bayta mathabatan li-n-nasi wa amna » — Nous avons fait de la Maison un lieu de rassemblement et un sanctuaire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me tourne vers ce centre ? La Ka'bah est-elle mon point de repère spirituel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Ka'bah est vide à l'intérieur — comme le cœur doit être vide de tout sauf Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Des millions de personnes se tournent vers ce point. L'unité dans la direction crée l'unité dans le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tourne son cœur vers la Ka'bah tourne son cœur vers Dieu." }
  ],
  munajat: `Ya Rabb, la Ka'bah est Ta Maison. Fais que je m'y tourne avec mon corps et mon cœur. Qu'elle soit mon sanctuaire.`
};

MIROIR["2:126"] = {
  reference: "2:126",
  theme: ["provision", "paix", "prière"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "As-Salam"],
  mirrorVersion: `« Abraham dit : Seigneur, fais de cette cité un lieu de sécurité et accorde des fruits à ceux qui croient. » Le miroir me montre la prière d'Ibrahim pour La Mecque. Deux demandes : la sécurité et la provision. Les deux viennent d'Allah. Et Ibrahim précise : « ceux qui croient » — la provision est liée à la foi. Le miroir m'interroge : pour quoi est-ce que je prie ? Pour moi ou pour les autres ?`,
  reflection: `La prière d'Ibrahim englobe la sécurité et la provision — les besoins fondamentaux de l'homme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbij'al hadza balada amina » — Seigneur, fais de cette cité un lieu de sécurité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi est-ce que je prie ? Mes prières englobent-elles la sécurité et la provision des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sécurité sans la foi peut mener à la corruption. La provision sans la gratitude peut mener à l'ingratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Mecque est devenue un lieu de sécurité et de provision — la prière d'Ibrahim a été exaucée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour les autres reçoit plus que celui qui prie pour lui-même." }
  ],
  munajat: `Ya Raziq, donne-moi ma provision et ma sécurité. Et fais que je prie pour les autres comme Ibrahim a prié pour sa cité.`
};

MIROIR["2:127"] = {
  reference: "2:127",
  theme: ["construction", "prière", "fondation"],
  emotion: "Dévouement, élévation",
  difficulty: "débutant",
  relatedNames: ["Al-Bari'", "Al-Mu'min"],
  mirrorVersion: `« Quand Abraham et Ismaël élevaient les fondations de la Maison : Seigneur, accepte de nous. » Le miroir me montre le travail accompagné de prière. Ils construisaient physiquement tout en invoquant spirituellement. Le travail et la prière ne sont pas séparés. Chaque action peut être un acte d'adoration si elle est faite pour Allah. Le miroir m'interroge : est-ce que je prie en travaillant ? Mon travail est-il pour Allah ?`,
  reflection: `La construction de la Ka'bah était un acte d'adoration. Travailler pour Allah, c'est prier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh yarfa'u Ibrahimu al-qawa'ida mina al-bayt » — quand Abraham et Ismaël élevaient les fondations de la Maison." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie en travaillant ? Mon travail est-il pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Travailler sans invoquer Allah est un travail vide. Invoquer sans travailler est une prière incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Ka'bah est bâtie par des mains humaines mais consacrée par l'intention divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour Allah transforme son travail en prière." }
  ],
  munajat: `Ya Rabb, accepte mon travail comme Ibrahim a prié que Tu acceptes le sien. Fais que chaque action soit pour Toi.`
};

MIROIR["2:128"] = {
  reference: "2:128",
  theme: ["soumission", "descendance", "musulmans"],
  emotion: "Humilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Muslim", "Ar-Rahman"],
  mirrorVersion: `« Seigneur, fais de nous Tes soumis et de notre descendance une nation soumise à Toi. » Le miroir me montre la prière pour la postérité. Ibrahim ne prie pas seulement pour lui — il prie pour ses descendants. La foi se transmet. « Soumis » — musulman — celui qui se donne entièrement à Dieu. Le miroir m'interroge : pour qui est-ce que je prie ? Ma foi sera-t-elle transmise ?`,
  reflection: `La prière pour la descendance est essentielle. La foi n'est pas individuelle — elle est collective.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana wa-j'alna muslimayni laka » — Seigneur, fais de nous Tes soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui est-ce que je prie ? Ma foi sera-t-elle transmise à ceux qui viennent après moi ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Prier pour soi sans prier pour les autres est une foi égoïste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi d'Ibrahim a engendré des milliards de croyants. La prière pour la descendance porte des fruits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour sa descendance reçoit la bénédiction de voir sa foi se perpétuer." }
  ],
  munajat: `Ya Rabb, fais de moi Ton soumis. Fais de ma descendance une nation soumise à Toi. Transmets la foi à travers moi.`
};

MIROIR["2:129"] = {
  reference: "2:129",
  theme: ["prière", "messager", "enseignement"],
  emotion: "Humilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Mursil", "Al-Mu'allim"],
  mirrorVersion: `« Seigneur, envoie parmi eux un messager de leur race qui leur récite Tes versets, leur enseigne le Livre et la sagesse et les purifie. » Le miroir me montre la prière d'Ibrahim et Ismaël pour leur communauté. Ils ne demandent pas la richesse ou le pouvoir — ils demandent un messager. La guidance spirituelle est le plus grand besoin. Le messager récite, enseigne et purifie. Le miroir m'interroge : qu'est-ce que je demande pour ma communauté ?`,
  reflection: `La plus grande bénédiction est la guidance. Un messager qui enseigne et purifie vaut plus que tout trésor.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana wa-b'ath fihim rasulan minhum » — Seigneur, envoie parmi eux un messager de leur race." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande pour ma communauté ? La richesse ou la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le messager est envoyé parce que la communauté a prié. Nos prières peuvent changer l'histoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu des messagers. La prière d'Ibrahim s'est réalisée en Muhammad." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie pour la guidance des autres reçoit plus que ce qu'il a demandé." }
  ],
  munajat: `Ya Mursil, Tu as envoyé des messagers. Merci pour la guidance. Aide-moi à être un transmetteur de Ta parole.`
};

MIROIR["2:130"] = {
  reference: "2:130",
  theme: ["exemple", "égarement", "choix"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Hadi"],
  mirrorVersion: `« Qui donc délaisse la religion d'Abraham, sinon celui qui s'est rendu ignorant à lui-même ? » Le miroir me montre l'importance du choix. Délaisser la foi d'Ibrahim, c'est se faire du tort à soi-même. L'ignorance n'est pas un hasard — c'est un choix. Ibrahim était « hanif » — pur, tourné vers Dieu seul. Le miroir m'interroge : ai-je choisi la voie d'Ibrahim ? Ou me suis-je égaré par ignorance volontaire ?`,
  reflection: `La religion d'Abraham est la pureté de la soumission à Dieu. La délaisser est une auto-destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yarghabu 'an millati Ibrahim illa man safiha nafsahu » — qui délaisse la religion d'Abraham, sinon celui qui s'est rendu ignorant à lui-même ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je choisi la voie d'Ibrahim ? Ou me suis-je égaré par ignorance volontaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de la foi n'est pas une excuse — c'est une faute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Abraham est le père des croyants. Sa voie est la voie de la pureté et de la soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Abraham suit le chemin le plus direct vers Dieu." }
  ],
  munajat: `Ya Rabb, je veux suivre la voie d'Ibrahim. Ne me laisse pas m'égarer par ignorance. Guide-moi vers la pureté.`
};

MIROIR["2:131"] = {
  reference: "2:131",
  theme: ["soumission", "réponse", "obéissance"],
  emotion: "Humilité, consécration",
  difficulty: "débutant",
  relatedNames: ["Al-Muslim", "Al-Muta'"],
  mirrorVersion: `« Quand son Seigneur lui dit : Soumets-toi, il dit : Je me soumets au Seigneur des mondes. » Le miroir me montre la réponse immédiate d'Ibrahim. Dieu appelle à la soumission — Ibrahim répond instantanément. Pas de débat, pas de condition, pas de délai. La soumission est totale. Le miroir m'interroge : comment je réponds quand Dieu m'appelle ?`,
  reflection: `La réponse d'Ibrahim est le modèle de la soumission : immédiate, totale, sans condition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aslim — aslamtu li-rabbi al-'alamin » — Soumets-toi — Je me soumets au Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réponds quand Dieu m'appelle ? Y a-t-il des conditions, des délais dans ma réponse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission avec des conditions n'est pas la soumission. C'est une négociation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est soumis à Dieu. L'homme a le choix — et le choix de la soumission est le plus beau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit « aslamtu » avec sincérité reçoit la paix qui dépasse l'entendement." }
  ],
  munajat: `Ya Rabb, je me soumets à Toi comme Ibrahim s'est soumis. Sans condition, sans délai, totalement. Accepte ma soumission.`
};

MIROIR["2:132"] = {
  reference: "2:132",
  theme: ["héritage", "transmission", "mort"],
  emotion: "Responsabilité, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Warith", "Al-Baqi"],
  mirrorVersion: `« Abraham l'a recommandé à ses fils, de même que Jacob : Ô mes fils, Allah a choisi la religion pour vous. Ne mourez donc pas sans être soumis. » Le miroir me montre la transmission de la foi. Ibrahim et Jacob ont légué la soumission à leurs enfants. La recommandation est claire : ne pas mourir sans être soumis. La mort peut survenir à tout moment — la soumission doit être présente maintenant. Le miroir m'interroge : qu'est-ce que je transmets ? Suis-je prêt pour la mort ?`,
  reflection: `La transmission de la foi est un devoir sacré. La mort peut survenir à tout moment — être prêt, c'est être soumis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wasa biha Ibrahimu banihi » — Abraham l'a recommandé à ses fils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je transmets à ceux qui viennent après moi ? Suis-je prêt pour la mort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mourir sans être soumis est le pire des échecs. Mourir dans la soumission est le plus grand succès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'héritage le plus précieux n'est pas l'argent — c'est la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui meurt dans la soumission rejoint la communauté des prophètes." }
  ],
  munajat: `Ya Rabb, fais que je meure dans la soumission. Aide-moi à transmettre la foi à ceux qui viennent après moi.`
};

MIROIR["2:133"] = {
  reference: "2:133",
  theme: ["témoignage", "mort", "foi"],
  emotion: "Sérénité, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Mawla"],
  mirrorVersion: `« Étiez-vous témoins quand la mort se présenta à Jacob et qu'il dit à ses fils : Qu'adorerez-vous après moi ? Ils dirent : Nous adorerons ton Dieu, le Dieu de tes pères. » Le miroir me montre la scène de la mort de Jacob. Sa dernière préoccupation : la foi de ses enfants. Leur réponse est magnifique : nous adorerons le même Dieu. La foi se transmet de génération en génération. Le miroir m'interroge : quelle est ma préoccupation dernière ?`,
  reflection: `La préoccupation de Jacob à sa mort était la foi de ses enfants. La foi est le plus bel héritage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma ta'buduna min ba'di — ilahuka wa ilahu aba'ika » — Qu'adorerez-vous après moi ? — Ton Dieu, le Dieu de tes pères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma préoccupation dernière ? Si je devais mourir aujourd'hui, de quoi me soucierais-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les soucis matériels s'effacent devant le souci spirituel de la transmission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne de la foi traverse les générations. Chaque maillon est responsable du suivant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui meurt en pensant à la foi de ses proches meurt en paix." }
  ],
  munajat: `Ya Rabb, fais que mes dernières pensées soient pour la foi de ceux que j'aime. Que la chaîne de la foi continue.`
};

MIROIR["2:134"] = {
  reference: "2:134",
  theme: ["responsabilité", "passé", "individu"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Ash-Shahid"],
  mirrorVersion: `« Cette communauté a passé. Elle aura ce qu'elle a acquis et vous aurez ce que vous avez acquis. On ne vous demandera pas compte de ce qu'ils faisaient. » Le miroir me montre l'individualisation de la responsabilité. Le passé est passé. Chacun est responsable de ses propres actes. On ne peut ni s'appuyer sur les mérites des ancêtres ni être puni pour leurs fautes. Le miroir m'interroge : sur quoi je m'appuie ? Sur l'héritage ou sur mes propres actes ?`,
  reflection: `Chacun est responsable de lui-même. L'héritage spirituel est un tremplin, pas un substitut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ummatun qad khalat » — cette communauté a passé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je m'appuie ? Sur l'héritage spirituel ou sur mes propres actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage ne sauve pas. L'héritage est un point de départ, pas une assurance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération est responsable devant Dieu. Pas de culpabilité collective, pas de mérite collectif." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur ses ancêtres néglige sa propre responsabilité. Celui qui assume sa responsabilité honore ses ancêtres." }
  ],
  munajat: `Ya Rabb, je suis responsable de mes actes. Ne me laisse pas m'appuyer sur l'héritage. Aide-moi à acquérir mes propres mérites.`
};

MIROIR["2:135"] = {
  reference: "2:135",
  theme: ["religion", "identité", "monothéisme"],
  emotion: "Clarté, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Muslim"],
  mirrorVersion: `« Ils disent : Devenez Juifs ou Chrétiens, vous serez bien guidés. Dis : Non, la religion d'Abraham le pur monothéiste, qui n'était pas des associateurs. » Le miroir me montre la confusion des étiquettes. Les gens du Livre revendiquent leur identité comme la seule voie. Mais la vraie religion est celle d'Abraham — le hanif, le pur, le monothéiste. Les étiquettes divisent ; la soumission unifie. Le miroir m'interroge : est-ce que je m'accroche à une étiquette ou à la soumission pure ?`,
  reflection: `La religion d'Abraham est la pureté du monothéisme. Les étiquettes sont secondaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal millata Ibrahim hanifan » — la religion d'Abraham le pur monothéiste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'accroche à une étiquette ou à la soumission pure ? Quelle est ma véritable identité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les étiquettes divisent. La soumission unifie. Être « musulman » sans la soumission n'est qu'une étiquette." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Abraham est le père de tous les croyants. Sa religion transcende les étiquettes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la pureté d'Abraham suit le chemin le plus direct vers Dieu." }
  ],
  munajat: `Ya Rabb, fais que je sois un hanif comme Abraham. Libère-moi des étiquettes. Fais que ma soumission soit pure.`
};

MIROIR["2:136"] = {
  reference: "2:136",
  theme: ["foi", "prophètes", "universalité"],
  emotion: "Unité, foi complète",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Dites : Nous croyons en Allah, en ce qu'on a fait descendre sur nous, en ce qu'on a fait descendre sur Abraham, Ismaël, Isaac, Jacob et les tribus, en ce qui a été donné à Moïse et Jésus, et en ce qui a été donné aux prophètes de leur Seigneur. » Le miroir me montre la foi complète. Pas de discrimination entre les prophètes. Tous viennent de Dieu, tous apportent le même message fondamental. La foi englobe tous les messagers. Le miroir m'interroge : est-ce que je crois en tous les prophètes ?`,
  reflection: `La foi complète englobe tous les prophètes sans discrimination. Le message est un.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amanna bi-Lahi wa ma unzila ilayna » — nous croyons en Allah et en ce qui a été révélé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en tous les prophètes ? Y a-t-il des prophètes que j'ai du mal à accepter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Rejeter un prophète, c'est rejeter le message divin lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne des prophètes est unie. La lumière est la même à travers différentes lampes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte tous les prophètes accepte la totalité de la révélation." }
  ],
  munajat: `Ya Rabb, je crois en tous Tes prophètes. Fais que ma foi soit complète, sans exclusion. Unifie mon cœur autour de Ton message.`
};

MIROIR["2:137"] = {
  reference: "2:137",
  theme: ["foi", "rejet", "guidance"],
  emotion: "Clarté, tristesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« S'ils croient comme vous avez cru, ils sont bien guidés. S'ils se détournent, ils sont dans la dissension. » Le miroir me montre le critère de la vraie foi. Croire comme les croyants croient — c'est la guidance. Se détourner — c'est la dissension. Le chemin est clair. Ceux qui rejettent la foi après l'avoir comprise ne sont pas dans l'erreur par ignorance, mais par choix. Le miroir m'interroge : ma foi est-elle comme celle des vrais croyants ?`,
  reflection: `La foi authentique est reconnaissable. Le rejet conscient mène à la dissension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in amanu bi-mithli ma amantum » — s'ils croient comme vous avez cru, ils sont bien guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle comme celle des vrais croyants ? Ou est-elle teintée de doutes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet après la compréhension est pire que l'ignorance. C'est un choix conscient contre la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. Ceux qui la reconnaissent se rassemblent. Ceux qui la rejettent se dispersent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment n'a pas besoin de débattre — sa foi est sa lumière." }
  ],
  munajat: `Ya Hadi, guide-moi vers la foi authentique. Ne me laisse pas me détourner de la vérité après l'avoir connue.`
};

MIROIR["2:138"] = {
  reference: "2:138",
  theme: ["baptême", "coloration", "allégeance"],
  emotion: "Appartenance, identité",
  difficulty: "débutant",
  relatedNames: ["As-Sibghah", "Al-Khaliq"],
  mirrorVersion: `« La coloration d'Allah ! Et qui est meilleur qu'Allah en fait de coloration ? » Le miroir me montre l'image de la coloration divine. Être « coloré » par Allah, c'est être transformé par Sa présence. Comme un tissu qui prend la couleur du bain, l'âme prend la couleur de ce qu'elle contemple. Contempler Allah, c'est être coloré par Lui. Le miroir m'interroge : par quoi suis-je coloré ? Quelle couleur mon âme a-t-elle prise ?`,
  reflection: `L'âme prend la couleur de ce qu'elle contemple. Contempler Dieu, c'est être transformé par Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sibghata Allahi » — la coloration d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Par quoi suis-je coloré ? Quelle couleur mon âme a-t-elle prise ? Contemple-je Allah suffisamment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être coloré par le monde, c'est perdre la couleur divine. Choisir la coloration, c'est choisir l'allégeance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose porte la couleur de son créateur. L'homme peut choisir de porter la couleur de Dieu ou du monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est coloré par Allah ne peut plus être coloré par autre chose. Sa couleur est définitive." }
  ],
  munajat: `Ya Rabb, colore-moi de Ta couleur. Fais que je sois transformé par Ta présence. Que Ton empreinte soit visible sur moi.`
};

MIROIR["2:139"] = {
  reference: "2:139",
  theme: ["dispute", "monothéisme", "appartenance"],
  emotion: "Clarté, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Haqq"],
  mirrorVersion: `« Dis : Discutez-vous avec nous au sujet d'Allah, alors qu'Il est notre Seigneur et le vôtre ? » Le miroir me montre l'absurdité des disputes religieuses. Allah est le Seigneur de tous. Les disputes surviennent quand on s'approprie Dieu. Mais Dieu n'appartient à personne — c'est nous qui Lui appartenons. Le miroir m'interroge : est-ce que je dispute au sujet de Dieu ? Est-ce que je m'approprie Sa vérité ?`,
  reflection: `Dieu est le Seigneur de tous. Disputer sur Lui, c'est oublier qu'Il nous dépasse tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Atuhajjunana fi Allahi wa huwa rabbuna wa rabbukum » — discutez-vous avec nous au sujet d'Allah, alors qu'Il est notre Seigneur et le vôtre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dispute au sujet de Dieu ? Est-ce que je m'approprie Sa vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "S'approprier Dieu, c'est Le réduire à sa propre compréhension. C'est une forme d'idolâtrie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil appartient à tous. Personne ne peut dire « c'est mon soleil »." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que Dieu est le Seigneur de tous cesse de disputer." }
  ],
  munajat: `Ya Rabb, Tu es le Seigneur de tous. Ne me laisse pas Te réduire à ma compréhension. Fais que je T'appartienne sans T'approprier.`
};

MIROIR["2:140"] = {
  reference: "2:140",
  theme: ["revendication", "vérité", "histoire"],
  emotion: "Clarté, correction",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Haqq"],
  mirrorVersion: `« Ou dites-vous qu'Abraham, Ismaël, Isaac, Jacob et les tribus étaient Juifs ou Chrétiens ? Dis : Qui sait le mieux, vous ou Allah ? » Le miroir me montre la falsification de l'histoire. Les gens du Livre revendiquent les prophètes comme leurs. Mais ces prophètes ont vécu avant que le judaïsme et le christianisme n'existent en tant que religions distinctes. Allah sait la vérité. Le miroir m'interroge : est-ce que je falsifie l'histoire pour justifier mes positions ?`,
  reflection: `L'histoire ne peut être réécrite pour servir nos intérêts. Allah est le témoin de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-antum a'lamu amu Allahu » — qui sait le mieux, vous ou Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je falsifie l'histoire pour justifier mes positions ? Suis-je honnête avec la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Revendiquer ce qui ne nous appartient pas est une forme de mensonge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire appartient à Dieu. Nous ne pouvons pas La réécrire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est honnête avec l'histoire reçoit la vérité divine." }
  ],
  munajat: `Ya Rabb, Tu es le Témoin de la vérité. Ne me laisse pas falsifier l'histoire. Donne-moi l'honnêteté intellectuelle.`
};

MIROIR["2:141"] = {
  reference: "2:141",
  theme: ["individu", "responsabilité", "communauté"],
  emotion: "Responsabilité, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Ash-Shahid"],
  mirrorVersion: `« Cette communauté a passé. Elle aura ce qu'elle a acquis et vous aurez ce que vous avez acquis. On ne vous demandera pas compte de ce qu'ils faisaient. » Le miroir me répète cette vérité fondamentale. Chaque communauté est responsable de ses propres actes. On ne peut ni hériter du mérite ni de la culpabilité. La responsabilité est individuelle. Le miroir m'interroge : est-ce que je comprends que je serai jugé seul, pour mes propres actes ?`,
  reflection: `La responsabilité est individuelle. On ne peut pas s'appuyer sur le groupe pour se justifier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ummatun qad khalat » — cette communauté a passé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que je serai jugé seul ? Est-ce que je me cache derrière le groupe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se cacher derrière le groupe, c'est refuser de grandir spirituellement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme viendra seule devant Dieu. Les appartenances s'effaceront." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa responsabilité individuelle grandit dans la foi." }
  ],
  munajat: `Ya Rabb, je suis responsable de mes actes. Aide-moi à ne pas me cacher derrière les autres. Que je sois jugé pour ce que je suis.`
};

MIROIR["2:142"] = {
  reference: "2:142",
  theme: ["qiblah", "changement", "épreuve"],
  emotion: "Confiance, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Musabbib"],
  mirrorVersion: `« Les insensés parmi les gens diront : Qu'est-ce qui les a détournés de la qiblah sur laquelle ils s'orientaient ? » Le miroir me montre l'épreuve du changement. Le changement de qiblah a été un test pour les croyants. Accepter le changement ordonné par Dieu, même sans comprendre, c'est la soumission. Les critiques viennent de ceux qui ne comprennent pas la sagesse divine. Le miroir m'interroge : comment je réagis quand Dieu change quelque chose dans ma vie ?`,
  reflection: `Le changement ordonné par Dieu est un test de soumission. Les critiques viennent de ceux qui ne font pas confiance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma wallahum 'an qiblatihimu » — qu'est-ce qui les a détournés de leur qiblah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand Dieu change quelque chose dans ma vie ? Avec soumission ou résistance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le changement divin n'est pas une erreur — c'est une guidance vers quelque chose de mieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers change constamment. La seule constance est Dieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le changement divin découvre toujours une sagesse cachée." }
  ],
  munajat: `Ya Rabb, quand Tu changes quelque chose, aide-moi à accepter. Je fais confiance à Ta sagesse. Guide-moi vers le nouveau.`
};

MIROIR["2:144"] = {
  reference: "2:144",
  theme: ["qiblah", "désir", "réponse"],
  emotion: "Joie, exaucement",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Wadud"],
  mirrorVersion: `« Nous te voyons tourner le visage vers le ciel. Nous allons donc te tourner vers une qiblah qui te plaît. » Le miroir me montre la réponse divine au désir du Prophète. Il regardait le ciel, espérant une nouvelle direction. Allah a exaucé son vœu. La Ka'bah est devenue la qiblah. Le désir sincère du croyant est entendu par Dieu. Le miroir m'interroge : quel est mon désir le plus profond pour ma foi ?`,
  reflection: `Dieu exauce le désir sincère de Ses serviteurs. La Ka'bah est le symbole de l'unité et du retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad nara taqalluba wajhika fi as-sama' » — Nous te voyons tourner le visage vers le ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon désir le plus profond pour ma foi ? Qu'est-ce que j'espère de Dieu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désir exaucé n'est pas toujours le désir immédiat — c'est souvent le désir profond." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Des millions de croyants se tournent vers la Ka'bah. L'unité dans la direction crée l'unité dans le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire sincèrement Dieu reçoit plus qu'il n'espérait." }
  ],
  munajat: `Ya Mujib, Tu exauces les désirs sincères. Mon désir est de me rapprocher de Toi. Exauce mon vœu et fais de moi Ton serviteur.`
};

MIROIR["2:145"] = {
  reference: "2:145",
  theme: ["qiblah", "obstination", "guidance"],
  emotion: "Tristesse, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« Certes, si tu apportais toutes les preuves à ceux qui ont reçu le Livre, ils ne suivraient pas ta qiblah. » Le miroir me montre les limites de l'argumentation. Même avec toutes les preuves, certains ne croiront pas. L'obstination n'est pas un problème de preuves — c'est un problème de cœur. La guidance n'est pas une question de logique seule. Le miroir m'interroge : est-ce que je comprends que la foi est un don, pas le résultat d'une démonstration ?`,
  reflection: `Les preuves ne suffisent pas pour celui qui refuse de voir. La guidance est un don divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lan tabi'a qiblataka » — ils ne suivraient pas ta qiblah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la foi est un don ? Est-ce que je m'épuise à convaincre ceux qui ne veulent pas voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les preuves ne convainquent que ceux dont le cœur est ouvert. L'obstination est un aveuglement volontaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière existe pour tous. Mais seuls ceux qui ouvrent les yeux la voient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que la guidance est un don prie pour les autres au lieu de débattre." }
  ],
  munajat: `Ya Hadi, Tu guides qui Tu veux. Ne me laisse pas m'épuiser à convaincre. Prie pour ceux dont le cœur est fermé.`
};

MIROIR["2:146"] = {
  reference: "2:146",
  theme: ["reconnaissance", "prophète", "connaissance"],
  emotion: "Tristesse, espérance",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Haqq"],
  mirrorVersion: `« Ceux à qui Nous avons donné le Livre le reconnaissent comme ils reconnaissent leurs fils. » Le miroir me montre la clarté de la reconnaissance. Les gens du Livre connaissent le Prophète comme ils connaissent leurs propres enfants — avec certitude absolue. Mais certains cachent cette connaissance. Le miroir m'interroge : est-ce que je reconnais la vérité quand je la vois ? Ou est-ce que je la cache ?`,
  reflection: `La vérité est reconnaissable pour celui qui cherche vraiment. Cacher la vérité est un choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'rifunahu kama ya'rifuna abna'ahum » — ils le reconnaissent comme ils reconnaissent leurs fils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité quand je la vois ? Ou est-ce que je la cache pour préserver mes intérêts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Reconnaître la vérité et la cacher est pire que l'ignorer. C'est un mensonge conscient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est écrite dans le cœur de chaque homme. Seuls ceux qui se mentent la cachent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité et l'accepte trouve la paix. Celui qui la cache vit dans le trouble." }
  ],
  munajat: `Ya Haqq, Tu es la vérité manifeste. Fais que je Te reconnaisse et que je ne cache pas ce que je sais. Donne-moi le courage de la vérité.`
};

MIROIR["2:147"] = {
  reference: "2:147",
  theme: ["vérité", "doute", "certitude"],
  emotion: "Confiance, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "As-Sadiq"],
  mirrorVersion: `« La vérité vient de ton Seigneur. Ne sois donc pas parmi les sceptiques. » Le miroir me place devant le choix entre la vérité et le doute. La vérité vient d'Allah — elle est certaine. Le doute est un voile qu'on pose sur la vérité. Ne pas être parmi les sceptiques, c'est choisir la certitude. Le miroir m'interroge : suis-je parmi les sceptiques ? Ou est-ce que j'accepte la vérité pleinement ?`,
  reflection: `La vérité divine ne nécessite pas de doute. La certitude est le fondement de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-haqqu min rabbika fala takunanna mina al-mumtarin » — la vérité vient de ton Seigneur, ne sois pas parmi les sceptiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les sceptiques ? Ou est-ce que j'accepte la vérité pleinement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le scepticisme n'est pas de la sagesse — c'est un refus de s'engager." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame la vérité. Seul l'homme peut choisir le doute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité sans réserve reçoit la paix sans mesure." }
  ],
  munajat: `Ya Haqq, Ta vérité est claire. Éloigne-moi du doute. Donne-moi la certitude qui apaise le cœur.`
};

MIROIR["2:148"] = {
  reference: "2:148",
  theme: ["direction", "compétition", "bien"],
  emotion: "Détermination, unité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Musabbib"],
  mirrorVersion: `« À chacun une direction vers laquelle il se tourne. Rivalisez donc dans les bonnes actions. » Le miroir me montre que chaque communauté a sa direction, mais le but est le même. La rivalité ne doit pas être dans les directions, mais dans les bonnes actions. Peu importe où on se tourne — ce qui compte, c'est ce qu'on fait. Le miroir m'interroge : dans quoi je rivalise ? La direction ou les œuvres ?`,
  reflection: `La direction importe moins que l'action. Rivaliser dans le bien, c'est courir vers Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fastabiqu al-khayrat » — rivalisez donc dans les bonnes actions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi je rivalise ? La direction ou les œuvres ? Est-ce que je me compare pour m'améliorer ou pour me vanter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Rivaliser dans la direction mène à la division. Rivaliser dans les œuvres mène à l'élévation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les chemins sont multiples, le but est unique. Que chacun coure vers le bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rivalise dans le bien ne regarde pas les autres — il regarde son propre progrès." }
  ],
  munajat: `Ya Rabb, fais que je rivalise dans les bonnes actions. Ne me laisse pas me comparer aux autres dans les directions. Fais que je coure vers Toi.`
};

MIROIR["2:149"] = {
  reference: "2:149",
  theme: ["qiblah", "direction", "obéissance"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muta"],
  mirrorVersion: `« D'où que tu sortes, tourne ton visage vers la Mosquée sacrée. C'est la vérité venant de ton Seigneur. » Le miroir me montre l'universalité de la direction. Peu importe d'où l'on vient, on se tourne vers la Ka'bah. La direction physique unifie la direction spirituelle. La vérité vient d'Allah — elle n'est pas négociable. Le miroir m'interroge : est-ce que je me tourne vers Dieu de partout ? Ou est-ce que ma direction dépend du contexte ?`,
  reflection: `La direction vers Dieu est universelle. Peu importe où l'on est, on se tourne vers Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min haythu kharajta fa-walli wajhaka shatra al-masjid al-haram » — d'où que tu sortes, tourne ton visage vers la Mosquée sacrée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me tourne vers Dieu de partout ? Ou est-ce que ma direction change selon le contexte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La direction changeante révèle un cœur instable. La direction constante révèle une foi ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Ka'bah est le centre. Tous les chemins y mènent. L'unité dans la direction crée l'unité dans le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se tourne vers Dieu partout se rapproche de Lui partout." }
  ],
  munajat: `Ya Rabb, fais que je me tourne vers Toi de partout. Que ma direction soit constante, comme Ton amour pour moi.`
};

MIROIR["2:150"] = {
  reference: "2:150",
  theme: ["qiblah", "témoignage", "perfection"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Kamil"],
  mirrorVersion: `« D'où que tu sortes, tourne ton visage vers la Mosquée sacrée. Et où que vous soyez, tournez vos visages vers elle. » Le miroir me montre l'insistance divine sur la direction. La répétition n'est pas redondance — c'est importance. La Ka'bah est le point de ralliement universel. Ce n'est pas un détail — c'est une forme d'unité. Le miroir m'interroge : est-ce que je comprends l'importance de cette direction ?`,
  reflection: `La direction vers la Ka'bah est une forme d'unité. Elle rassemble les croyants dans une même orientation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa haythu ma kuntum fa-wallu wujuhakum shatrahu » — et où que vous soyez, tournez vos visages vers elle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends l'importance de cette direction ? Ou est-ce que je la considère comme un détail ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La direction n'est pas le but — elle mène au but. Mais sans direction, on n'arrive nulle part." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Des milliards de prières convergent vers ce point. L'unité spatiale crée l'unité spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le sens de la direction comprend le sens de l'unité." }
  ],
  munajat: `Ya Rabb, je me tourne vers Ta Maison. Fais que cette direction physique mène à une direction spirituelle vers Toi.`
};

MIROIR["2:151"] = {
  reference: "2:151",
  theme: ["gratitude", "messager", "bénédiction"],
  emotion: "Reconnaissance, joie",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "An-Ni'mah"],
  mirrorVersion: `« Ainsi Nous avons envoyé parmi vous un messager de votre race qui vous récite Nos versets, vous purifie, vous enseigne le Livre et la sagesse, et vous enseigne ce que vous ne saviez pas. » Le miroir me montre la réponse à la prière d'Ibrahim. Le messager est envoyé. Il récite, purifie, enseigne. Chaque fonction est une bénédiction. La gratitude est due pour ce don immense. Le miroir m'interroge : est-ce que je suis reconnaissant pour le messager et son enseignement ?`,
  reflection: `Le messager est la plus grande bénédiction. Son enseignement purifie et guide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatlu 'alaykum ayatina wa yuzakkikum wa yu'allimukumu al-kitaba wa al-hikmata » — il vous récite Nos versets, vous purifie et vous enseigne le Livre et la sagesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour le messager ? Est-ce que j'apprends de son enseignement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ignorer l'enseignement du messager, c'est gaspiller la plus grande bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu des messagers. Muhammad est le sceau des prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le messager reçoit tout ce que le messager a apporté." }
  ],
  munajat: `Ya Rabb, merci pour le messager. Aide-moi à suivre son enseignement. Fais que je sois parmi ceux qui se purifient par sa guidance.`
};

MIROIR["2:153"] = {
  reference: "2:153",
  theme: ["prière", "patience", "secours"],
  emotion: "Espoir, persévérance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Mu'in"],
  mirrorVersion: `« Ô vous qui croyez ! Cherchez secours dans la patience et la prière. » Le miroir me montre les deux ressources du croyant face aux difficultés. La patience — endurer avec constance. La prière — se connecter à Dieu. Ces deux piliers soutiennent l'âme dans les tempêtes. Le miroir m'interroge : où je cherche mon secours ? Dans la patience et la prière ou ailleurs ?`,
  reflection: `La patience et la prière sont les ressources inépuisables du croyant. Tout le reste s'épuise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'inu bi-s-sabri wa-s-salah » — cherchez secours dans la patience et la prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où je cherche mon secours ? Est-ce que je patiente ? Est-ce que je prie quand je suis dans la difficulté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chercher le secours ailleurs que dans la patience et la prière mène à la déception." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature fait face à des défis. Le croyant a des ressources que les autres n'ont pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combine la patience et la prière est inébranlable." }
  ],
  munajat: `Ya Rabb, je cherche mon secours dans la patience et la prière. Donne-moi la force de patienter et la constance de prier.`
};

MIROIR["2:154"] = {
  reference: "2:154",
  theme: ["martyre", "vie", "témoignage"],
  emotion: "Espérance, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hayy", "Ash-Shahid"],
  mirrorVersion: `« Ne dites pas de ceux qui sont tués dans le chemin d'Allah qu'ils sont morts. Ils sont vivants, mais vous ne percevez pas. » Le miroir me montre une vérité qui dépasse les apparences. Les martyrs ne sont pas morts — ils sont vivants auprès d'Allah. La mort physique n'est pas la fin. La vraie vie est auprès de Dieu. Le miroir m'interroge : est-ce que je vois avec les yeux du corps ou avec les yeux de la foi ?`,
  reflection: `La mort des martyrs n'est qu'une transition. Ils sont vivants auprès de Dieu, dans une vie que nous ne percevons pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqulu li-man yuqtalu fi sabili Allahi amwat » — ne dites pas de ceux qui sont tués dans le chemin d'Allah qu'ils sont morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois avec les yeux du corps ou avec les yeux de la foi ? Comment je comprends la mort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble mort peut être vivant. Ce qui semble vivant peut être mort. La réalité dépasse les apparences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie et la mort sont entre les mains d'Allah. La mort n'est pas la fin — c'est un passage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que les martyrs sont vivants ne craint plus la mort dans le chemin d'Allah." }
  ],
  munajat: `Ya Hayy, Tu es la source de toute vie. Donne-moi la certitude que la mort dans Ton chemin n'est pas une fin, mais un début.`
};

MIROIR["2:155"] = {
  reference: "2:155",
  theme: ["épreuve", "patience", "annonce"],
  emotion: "Préparation, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mumtahin", "Al-Fattah"],
  mirrorVersion: `« Nous vous éprouverons par la peur, la faim, la diminution des biens, des personnes et des fruits. Et annonce la bonne nouvelle aux patients. » Le miroir me montre les types d'épreuves. Peur, faim, perte — autant de tests. Mais l'annonce est claire : la bonne nouvelle est pour ceux qui patientent. L'épreuve est inévitable ; la récompense est promise. Le miroir m'interroge : suis-je prêt pour les épreuves ?`,
  reflection: `Les épreuves sont variées mais la récompense est unique : la bonne nouvelle pour les patients.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa bashshiri-s-sabirin » — et annonce la bonne nouvelle aux patients." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour les épreuves ? Ma patience est-elle solide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve n'est pas une punition — c'est une sélection pour la bonne nouvelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie contient des épreuves. La différence est dans la réponse : la patience ou la rébellion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente reçoit plus que ce qu'il a perdu." }
  ],
  munajat: `Ya Rabb, les épreuves viendront. Donne-moi la patience de les traverser. Annonce-moi la bonne nouvelle par Ta miséricorde.`
};

MIROIR["2:156"] = {
  reference: "2:156",
  theme: ["patience", "appartenance", "retour"],
  emotion: "Sérénité, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Mawla"],
  mirrorVersion: `« Ceux qui, quand un malheur les atteint, disent : Nous sommes à Allah et c'est vers Lui que nous retournerons. » Le miroir me montre la réponse parfaite au malheur. « Nous sommes à Allah » — reconnaissance de l'appartenance. « C'est vers Lui que nous retournerons » — reconnaissance du retour. Ces deux vérités transforment le malheur en rappel. Le miroir m'interroge : quelle est ma première réaction face au malheur ?`,
  reflection: `La formule « Inna lillahi wa inna ilayhi raji'un » transforme le malheur en rappel spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna lillahi wa inna ilayhi raji'un » — nous sommes à Allah et c'est vers Lui que nous retournerons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma première réaction face au malheur ? La rébellion ou la reconnaissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur n'est pas une perte — c'est un rappel de l'appartenance et du retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers appartient à Dieu et retourne à Lui. Nous sommes de passage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prononce ces mots avec le cœur reçoit la paix immédiate." }
  ],
  munajat: `Ya Rabb, je suis à Toi et je retournerai à Toi. Quand le malheur m'atteint, rappelle-moi cette vérité. Donne-moi la paix dans l'épreuve.`
};

MIROIR["2:157"] = {
  reference: "2:157",
  theme: ["bénédiction", "miséricorde", "guidance"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Hadi"],
  mirrorVersion: `« Ceux-là recevront des bénédictions de leur Seigneur et la miséricorde. Et ceux-là sont les bien guidés. » Le miroir me montre la récompense triple des patients. Bénédictions, miséricorde, guidance — trois dons divins pour ceux qui ont dit « inna lillahi ». La patience n'est jamais perdue. Chaque épreuve traversée avec foi attire ces bénédictions. Le miroir m'interroge : est-ce que je patiente en espérant ces dons ?`,
  reflection: `La patience attire les bénédictions, la miséricorde et la guidance. Le retour sur investissement spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika 'alayhim salawatun min rabbihim wa rahmatun » — ceux-là recevront des bénédictions de leur Seigneur et la miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente en espérant ces dons ? Ma patience a-t-elle une récompense attendue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience sans espérance est de l'endurance. La patience avec espérance est de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers récompense la patience. Les saisons suivent l'hiver. La nuit précède l'aube." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente sincèrement reçoit plus que ce qu'il a perdu." }
  ],
  munajat: `Ya Rahman, donne-moi Tes bénédictions, Ta miséricorde et Ta guidance. Ma patience est pour Toi, ma récompense est en Toi.`
};

MIROIR["2:158"] = {
  reference: "2:158",
  theme: ["sa'y", "pèlerinage", "effort"],
  emotion: "Dévotion, effort",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bayt", "As-Safa"],
  mirrorVersion: `« As-Safa et Al-Marwa sont parmi les rites d'Allah. Quiconque fait le pèlerinage ou la 'umra ne commet pas de péché en faisant le va-et-vient entre eux. » Le miroir me montre le sens du rituel. As-Safa et Al-Marwa — deux collines entre lesquelles Hajar a couru cherchant l'eau pour Ismaël. Ce va-et-vient (sa'y) est devenu un rituel sacré. L'effort physique devient spirituel quand il est fait pour Allah. Le miroir m'interroge : quel est mon sa'y ? Quel effort je fais pour Allah ?`,
  reflection: `Le sa'y commémore l'effort d'Hajar. L'effort pour Allah devient un rituel sacré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna-s-safa wa-l-marwata min sha'a'iri Allah » — As-Safa et Al-Marwa sont parmi les rites d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon sa'y ? Quel effort je fais pour Allah ? Est-ce que je cours vers Lui comme Hajar courait pour son enfant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le va-et-vient physique reflète le va-et-vient spirituel du croyant entre le besoin et la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Des millions de pèlerins répètent ce geste. L'effort d'une femme est devenu le rituel de millions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le sa'y avec le cœur découvre que l'eau jaillit pour ceux qui cherchent." }
  ],
  munajat: `Ya Rabb, je fais mon sa'y vers Toi. Bénis mon effort comme Tu as béni l'effort d'Hajar. Fais jaillir l'eau de Ta miséricorde.`
};

MIROIR["2:159"] = {
  reference: "2:159",
  theme: ["dissimulation", "vérité", "responsabilité"],
  emotion: "Responsabilité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinah", "An-Nur"],
  mirrorVersion: `« Ceux qui cachent les preuves évidentes et la guidance que Nous avons fait descendre après les avoir clarifiées aux gens dans le Livre, ceux-là Allah les maudit. » Le miroir me montre la gravité de la dissimulation de la vérité. Quand on connaît la vérité et qu'on la cache, on trahit la confiance divine. La malédiction n'est pas sur celui qui ignore — elle est sur celui qui sait et cache. Le miroir m'interroge : qu'est-ce que je cache ? La vérité que je connais est-elle partagée ?`,
  reflection: `Cacher la vérité qu'on connaît est une trahison. La connaissance est un dépôt à transmettre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina yaktumuna ma anzalna » — ceux qui cachent ce que Nous avons fait descendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? La vérité que je connais est-elle partagée ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Cacher la vérité, c'est vouloir la garder pour soi. Mais la vérité n'appartient à personne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière qui est cachée devient ténèbres. La vérité non partagée se corrompt." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage la vérité reçoit plus de vérité. Celui qui la cache perd ce qu'il a." }
  ],
  munajat: `Ya Rabb, je ne veux pas cacher Ta vérité. Fais que je sois un transmetteur, pas un dissimulateur. Bénis ma transmission.`
};

MIROIR["2:160"] = {
  reference: "2:160",
  theme: ["repentir", "réforme", "pardon"],
  emotion: "Espoir, miséricorde",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Sauf ceux qui se sont repentis, ont réformé et ont clarifié. Ceux-là, J'accepte leur repentir. » Le miroir me montre l'exception qui donne espoir. Même après avoir caché la vérité, le repentir est possible. Trois conditions : repentir, réforme, clarification. Le passé peut être réparé par le présent. La miséricorde d'Allah précède Sa colère. Le miroir m'interroge : qu'est-ce que je dois réparer ?`,
  reflection: `Le repentir efface le passé. Réforme et clarification sont les signes du repentir sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina tabu wa aslahu wa bayyanu » — sauf ceux qui se sont repentis, ont réformé et ont clarifié." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois réparer ? Mon repentir inclut-il la réforme et la clarification ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le repentir sans réforme est des paroles vides. La réforme sans clarification laisse le dommage non réparé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque erreur peut être réparée. Le repentir ouvre la porte de la miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent, réforme et clarifie reçoit le pardon complet." }
  ],
  munajat: `Ya Tawwab, je me repens de mes fautes. Aide-moi à me réformer et à clarifier ce que j'ai caché. Accepte mon repentir.`
};

MIROIR["2:161"] = {
  reference: "2:161",
  theme: ["mécréance", "châtiment", "éternité"],
  emotion: "Sérieux, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui ne croient pas et meurent mécréants, sur eux sera la malédiction d'Allah, des anges et des hommes réunis. » Le miroir me montre la gravité de la mécréance finale. Mourir dans la mécréance, c'est s'exclure de la miséricorde. La malédiction est universelle — d'Allah, des anges, des hommes. Le miroir m'interroge : est-ce que je comprends la gravité de la foi ? Est-ce que je protège ma foi jusqu'à la fin ?`,
  reflection: `La mécréance finale est la plus grande perte. La foi est le trésor à préserver jusqu'au bout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru wa matu wa hum kuffarun » — ceux qui ne croient pas et meurent mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la gravité de la foi ? Est-ce que je la protège jusqu'à la fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort peut survenir à tout moment. Mourir dans la foi ou la mécréance, c'est le choix de chaque instant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers proclame la vérité. La mécréance est un refus conscient de cette vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la gravité de la mécréance ne cesse de prier pour une bonne fin." }
  ],
  munajat: `Ya Rabb, protège ma foi jusqu'à la fin. Ne me laisse pas mourir dans la mécréance. Accorde-moi une fin dans la soumission.`
};

MIROIR["2:162"] = {
  reference: "2:162",
  theme: ["châtiment", "éternité", "réduction"],
  emotion: "Effroi, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khuld", "Al-Muhit"],
  mirrorVersion: `« Ils y demeureront éternellement. Le châtiment ne leur sera pas allégé et ils n'auront aucun répit. » Le miroir me montre l'éternité du châtiment. Pas de fin, pas d'allègement, pas de répit. La gravité du choix terrestre a des conséquences éternelles. Le miroir m'interroge : est-ce que je vis comme si cette vie était éternelle ? Ou est-ce que je prépare l'éternité ?`,
  reflection: `L'éternité du châtiment est proportionnelle à la gravité du rejet conscient de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalidina fiha » — ils y demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si cette vie était éternelle ? Ou est-ce que je prépare l'éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité du châtiment est proportionnée à l'éternité de la vérité rejetée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les choix d'un instant ont des conséquences éternelles. La justice divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'éternité du châtiment fuit tout ce qui peut y mener." }
  ],
  munajat: `Ya Rabb, sauve-moi du châtiment éternel. Je cherche refuge en Toi contre tout ce qui peut m'éloigner de Ta miséricorde.`
};

MIROIR["2:163"] = {
  reference: "2:163",
  theme: ["unicité", "divinité", "miséricorde"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Ar-Rahman"],
  mirrorVersion: `« Votre Dieu est un Dieu unique. Point de divinité à part Lui, le Tout-Miséricordieux, le Très-Miséricordieux. » Le miroir me place devant l'essence de la foi. Un seul Dieu. Pas de partenaires. Tout est miséricorde. L'unicité est le fondement ; la miséricorde est l'expression. Le miroir m'interroge : est-ce que ma foi est vraiment fondée sur cette unicité ? Est-ce que je vis dans cette miséricorde ?`,
  reflection: `L'unicité de Dieu est le fondement de toute la foi. Sa miséricorde est l'espoir de tout croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ilahukum ilahun wahid » — votre Dieu est un Dieu unique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est vraiment fondée sur cette unicité ? Est-ce que je vis dans cette miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Associer des partenaires à Dieu, c'est diluer la foi. L'unicité concentre toute l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers proclame l'unicité. La diversité de la création pointe vers l'unicité du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend vraiment l'unicité ne peut plus adorer autre chose que Dieu." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Fais que mon cœur soit unifié autour de Toi. Fais que je vive dans Ta miséricorde.`
};

MIROIR["2:164"] = {
  reference: "2:164",
  theme: ["signes", "création", "méditation"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Fatir"],
  mirrorVersion: `« Dans la création des cieux et de la terre, l'alternance de la nuit et du jour, les navires qui voguent sur la mer chargés de profits pour les hommes, l'eau qu'Allah fait descendre du ciel et par laquelle Il fait vivre la terre morte, les bêtes qu'Il y a disséminées, le changement des vents et les nuages soumis entre ciel et terre — en tout cela, il y a des signes pour des gens qui raisonnent. » Le miroir m'invite à contempler l'univers entier. Chaque élément est un signe — les cieux, la terre, le jour, la nuit, les navires, la pluie, les animaux, les vents, les nuages. Tout parle de Dieu. Le miroir m'interroge : vois-je ces signes ? Mon regard s'arrête-t-il sur la création ?`,
  reflection: `L'univers entier est un livre ouvert. Chaque phénomène naturel est un verset qui parle du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La création des cieux et de la terre, l'alternance du jour et de la nuit — tous sont des signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vois-je les signes autour de moi ? Mon regard s'arrête-t-il sur la création pour y voir le Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes ne manquent pas — c'est notre regard qui manque de profondeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque atome de l'univers porte la signature de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la création avec un cœur ouvert voit Dieu partout." }
  ],
  munajat: `Ya Khaliq, Tu as parsemé Tes signes dans toute la création. Ouvre mes yeux pour les voir. Fais que chaque chose me rappelle Toi.`
};

MIROIR["2:165"] = {
  reference: "2:165",
  theme: ["amour", "idolâtrie", "comparaison"],
  emotion: "Amour, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Haqq"],
  mirrorVersion: `« Parmi les hommes, il en est qui prennent des égaux à Allah, les aimant comme on aime Allah. Mais les croyants sont les plus ardents dans l'amour d'Allah. » Le miroir me montre la différence entre l'amour des idoles et l'amour de Dieu. Certains aiment leurs idoles comme on aime Dieu. Mais les croyants aiment Dieu plus que tout. La mesure de la foi est dans l'intensité de l'amour. Le miroir m'interroge : qu'est-ce que j'aime le plus ?`,
  reflection: `L'amour est la mesure de la foi. Aimer Dieu plus que tout, c'est la vraie foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ashaddu hubban li-Llah » — les plus ardents dans l'amour d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aime le plus ? Mon amour pour Dieu est-il le plus fort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Aimer quelque chose autant que Dieu, c'est en faire un égal. C'est l'idolâtrie cachée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour est le moteur de l'univers. L'orienter vers Dieu, c'est s'aligner sur la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime Dieu plus que tout reçoit un amour qui dépasse tout." }
  ],
  munajat: `Ya Wadud, Tu es l'objet de mon amour. Purifie mon cœur de tout amour rival. Fais que je T'aime plus que tout.`
};

MIROIR["2:166"] = {
  reference: "2:166",
  theme: ["idolâtrie", "regret", "séparation"],
  emotion: "Regret, désillusion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Wadud"],
  mirrorVersion: `« Quand ceux qui ont été suivis se désavoueront de ceux qui les ont suivis, et qu'ils verront le châtiment. » Le miroir me montre la rupture finale entre les idoles et leurs adeptes. Au Jour du Jugement, les guides égarés se désavoueront de ceux qui les ont suivis. L'aveuglement prend fin ; la vérité apparaît. Mais il est trop tard. Le miroir m'interroge : qui suis-je ? Est-ce que je suis quelqu'un qui sera là pour moi au Jour du Jugement ?`,
  reflection: `Les idoles se désavouent de leurs adorateurs au Jour du Jugement. Seul Dieu reste fidèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza tabarra'a alladhina ittubi'u mina alladhina ittaba'u » — quand ceux qui ont été suivis se désavoueront de ceux qui les ont suivis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui suis-je ? Est-ce que je suis quelqu'un qui sera là pour moi au Jour du Jugement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre quelqu'un d'autre que Dieu, c'est investir dans une relation qui finira par la trahison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toutes les relations humaines sont temporaires. Seule la relation avec Dieu est éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Dieu seul n'a pas à craindre le désaveu." }
  ],
  munajat: `Ya Rabb, ne me laisse pas suivre ce qui m'abandonnera. Fais que je Te suis Toi seul, qui ne m'abandonneras jamais.`
};

MIROIR["2:167"] = {
  reference: "2:167",
  theme: ["regret", "retour", "impossibilité"],
  emotion: "Désespoir, prise de conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-Wadud"],
  mirrorVersion: `« Si seulement nous pouvions retourner en arrière, nous nous désavouerions d'eux comme ils se sont désavoués de nous. » Le miroir me montre le regret ultime. Au Jour du Jugement, les égarés souhaiteront retourner pour changer leurs choix. Mais le retour est impossible. Le temps de choix est maintenant. Le miroir m'interroge : si je pouvais voir mon futur, que changerais-je aujourd'hui ?`,
  reflection: `Le regret final est stérile. Le temps de changer est maintenant, pas après.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya laytana nuraddu » — si seulement nous pouvions retourner en arrière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je pouvais voir mon futur, que changerais-je aujourd'hui ? Pourquoi attendre le regret ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps de la décision est maintenant. Le temps du regret est trop tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps s'écoule dans une seule direction. On ne peut pas revenir en arrière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui change maintenant n'aura pas à regretter plus tard." }
  ],
  munajat: `Ya Rabb, donne-moi la sagesse de changer maintenant. Ne me laisse pas attendre le moment où le regret sera stérile.`
};

MIROIR["2:168"] = {
  reference: "2:168",
  theme: ["nourriture", "licite", "satan"],
  emotion: "Vigilance, pureté",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Halal"],
  mirrorVersion: `« Ô hommes ! Mangez de ce qui est licite et bon sur terre. Et ne suivez pas les pas de Satan. » Le miroir me montre le choix quotidien de la nourriture. Licite et bon — deux critères. Satan pousse vers l'illicite et le mauvais. Chaque bouchée est un choix spirituel. Le miroir m'interroge : est-ce que je fais attention à ce que je mange ? Est-ce que je comprends que Satan agit même dans mon assiette ?`,
  reflection: `La nourriture licite et bonne est un droit. Satan pousse vers la transgression même dans les choses quotidiennes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu mimma fi al-ardi halalan tayyiban » — mangez de ce qui est licite et bon sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais attention à ce que je mange ? Est-ce que je comprends que Satan agit même dans mon assiette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Manger sans attention, c'est suivre les pas de Satan sans le savoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre a été créée pour nous nourrir. L'homme peut pervertir ce don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange avec conscience transforme son repas en acte d'adoration." }
  ],
  munajat: `Ya Raziq, merci pour Ta provision. Aide-moi à manger ce qui est licite et bon. Ne me laisse pas suivre les pas de Satan.`
};

MIROIR["2:169"] = {
  reference: "2:169",
  theme: ["interdiction", "satan", "immoralité"],
  emotion: "Vigilance, rejet",
  difficulty: "débutant",
  relatedNames: ["An-Nahi", "Al-Haram"],
  mirrorVersion: `« Il vous ordonne l'immoralité, l'odieux et de dire sur Allah ce que vous ne savez pas. » Le miroir me montre le programme de Satan. Trois cibles : l'immoralité (al-fahsha'), l'odieux (al-munkar), et le mensonge sur Allah. Satan ne se contente pas de séduire — il structure la perdition. Le miroir m'interroge : est-ce que je reconnais ces trois pièges dans ma vie ?`,
  reflection: `Satan a une méthode structurée : l'immoralité, l'odieux, et le mensonge sur Dieu. Reconnaître ces pièges, c'est s'en protéger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama ya'murukum bi-s-su'i wa al-fahsha'i » — il vous ordonne l'immoralité et l'odieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ces trois pièges dans ma vie ? L'immoralité, l'odieux, le mensonge sur Dieu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah ordonne le contraire : la pureté, le bien, et la vérité sur Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal a une structure. Le bien aussi. Choisir son camp, c'est choisir sa structure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le programme de Satan peut s'en protéger." }
  ],
  munajat: `Ya Rabb, je cherche refuge en Toi contre Satan. Protège-moi de l'immoralité, de l'odieux et du mensonge. Guide-moi vers la vérité.`
};

MIROIR["2:170"] = {
  reference: "2:170",
  theme: ["tradition", "raison", "révélation"],
  emotion: "Clarté, courage",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Quand on leur dit : Suivez ce qu'Allah a fait descendre, ils disent : Non, nous suivons ce sur quoi nous avons trouvé nos pères. Même si leurs pères ne raisonnaient pas et n'étaient pas sur la bonne voie ? » Le miroir me montre le piège de la tradition aveugle. Suivre les ancêtres sans raison, sans vérification, c'est l'aveuglement. La révélation demande la raison. Le miroir m'interroge : suis-je ce que je suis par tradition ou par conviction ?`,
  reflection: `La tradition sans raison est l'aveuglement. La foi doit être réfléchie, pas héritée aveuglément.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal nat-tabi'u ma alayna aba'ana » — non, nous suivons ce sur quoi nous avons trouvé nos pères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je ce que je suis par tradition ou par conviction ? Ma foi a-t-elle été réfléchie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tradition peut être bonne — mais elle doit être vérifiée par la raison et la révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération doit faire son propre chemin vers la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la vérité par conviction honore ses ancêtres en dépassant leur exemple." }
  ],
  munajat: `Ya Hadi, ne me laisse pas suivre aveuglément. Donne-moi la raison de comprendre et le courage de suivre la vérité.`
};

MIROIR["2:171"] = {
  reference: "2:171",
  theme: ["parabole", "écoute", "compréhension"],
  emotion: "Tristesse, lucidité",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Basir"],
  mirrorVersion: `« La parabole de ceux qui ne croient pas est comme celui qui crie après ce qui n'entend qu'un appel et une voix sourde. Sourds, muets, aveugles, ils ne raisonnent pas. » Le miroir me montre l'état de ceux qui refusent la vérité. Ils entendent le son mais pas le sens. Comme quelqu'un qui crie dans le vide — il n'y a pas de réponse. Le refus de comprendre crée une surdité spirituelle. Le miroir m'interroge : est-ce que j'entends vraiment ? Ou est-ce que j'entends seulement ce que je veux entendre ?`,
  reflection: `L'ouïe spirituelle est un don. Ceux qui refusent d'entendre deviennent sourds au sens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Summun bukmun 'umyun » — sourds, muets, aveugles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends vraiment ? Ou est-ce que j'entends seulement ce que je veux entendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La surdité spirituelle n'est pas physique — c'est un choix du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité parle partout. Mais seuls ceux qui veulent entendre peuvent l'entendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre ses oreilles spirituelles entend ce que les autres ne peuvent pas entendre." }
  ],
  munajat: `Ya Sami', ouvre mes oreilles spirituelles. Ne me laisse pas devenir sourd à Ta vérité. Fais que j'entende vraiment.`
};

MIROIR["2:172"] = {
  reference: "2:172",
  theme: ["nourriture", "gratitude", "pureté"],
  emotion: "Reconnaissance, pureté",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "At-Tayyib"],
  mirrorVersion: `« Ô vous qui croyez ! Mangez des bonnes choses que Nous vous avons attribuées et soyez reconnaissants envers Allah. » Le miroir me montre le lien entre ce que je mange et ma relation avec Dieu. Manger « bon » (tayyib) — pur, licite, sain — et être reconnaissant. La nourriture n'est pas seulement matière ; elle est spirituelle. Ce que je mets dans mon corps affecte mon âme. Le miroir m'interroge : qu'est-ce que je mange ? Suis-je reconnaissant pour ma nourriture ?`,
  reflection: `La nourriture pure nourrit le corps et l'âme. La gratitude sanctifie le repas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu min tayyibati ma razaqnakum » — mangez des bonnes choses que Nous vous avons attribuées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je mange ? Est-ce bon et pur ? Suis-je reconnaissant pour ma nourriture ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Manger sans gratitude, c'est manger sans conscience. La nourriture devient vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit sa nourriture. L'homme reçoit et doit remercier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange avec gratitude transforme son repas en prière." }
  ],
  munajat: `Ya Raziq, Tu me donnes ma nourriture. Fais que je mange ce qui est bon et que je sois reconnaissant. Sanctifie mon repas.`
};

MIROIR["2:173"] = {
  reference: "2:173",
  theme: ["interdits", "nourriture", "nécessité"],
  emotion: "Clarté, mesure",
  difficulty: "débutant",
  relatedNames: ["Al-Haram", "Al-Halal"],
  mirrorVersion: `« Il vous a seulement interdit la bête morte, le sang, la viande de porc et ce qui a été sacrifié pour autre qu'Allah. » Le miroir me montre les limites claires. Peu d'interdits alimentaires, mais précis. La chair de porc, la bête morte, le sang, ce qui est sacrifié pour autre qu'Allah. Ces limites protègent le corps et l'âme. Mais en cas de nécessité, l'interdit devient permis. La religion n'est pas un fardeau. Le miroir m'interroge : est-ce que je respecte ces limites ? Est-ce que je comprends leur sagesse ?`,
  reflection: `Les interdits alimentaires sont limités mais précis. La nécessité lève l'interdiction — la religion est facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama harrama 'alaykumu al-maytata wa ad-dama wa lahma al-khinziri » — Il vous a seulement interdit la bête morte, le sang et la viande de porc." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte ces limites ? Est-ce que je comprends leur sagesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdit n'est pas arbitraire — il protège. Le permis n'est pas une permission — c'est une confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose a été créée pour une raison. L'homme a le choix de respecter ou de transgresser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites divines purifie son corps et son âme." }
  ],
  munajat: `Ya Rabb, aide-moi à respecter Tes limites. Fais que je comprenne que Tes interdits sont une protection.`
};

MIROIR["2:174"] = {
  reference: "2:174",
  theme: ["falsification", "châtiment", "profit"],
  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui cachent ce qu'Allah a fait descendre du Livre et l'échangent contre un vil prix, ceux-là ne remplissent leurs ventres que de feu. » Le miroir me montre le trafic spirituel. Cacher la vérité de Dieu pour un profit matériel. Ce commerce est le plus mauvais. Le profit est vil ; le châtiment est terrible. Le feu remplit les ventres de ceux qui troquent la vérité contre le gain. Le miroir m'interroge : est-ce que je vends ma foi pour un profit ?`,
  reflection: `La vérité divine n'a pas de prix. L'échanger contre un gain matériel, c'est se perdre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama ya'kuluna fi butunihimu nara » — ils ne remplissent leurs ventres que de feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vends ma foi pour un profit ? Est-ce que je cache la vérité pour un gain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le profit matériel est éphémère. La perte spirituelle est éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne peut être achetée ou vendue. Elle est au-dessus de tout prix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde la vérité intacte reçoit un trésor qui ne s'épuise pas." }
  ],
  munajat: `Ya Rabb, garde-moi du commerce de la vérité. Fais que je préserve Ta parole, que je ne l'échange contre rien.`
};

MIROIR["2:175"] = {
  reference: "2:175",
  theme: ["égarement", "guidance", "échange"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Ceux qui achètent l'égarement au prix de la guidance et le châtiment au prix du pardon. » Le miroir me montre le mauvais commerce. Échanger la guidance contre l'égarement, le pardon contre le châtiment. C'est le pire des marchés. On ne perd pas de l'argent — on perd son âme. Le miroir m'interroge : qu'est-ce que j'échange contre ma foi ?`,
  reflection: `Le mauvais choix spirituel est le plus grand des malheurs. Perdre la guidance, c'est tout perdre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika alladhina ishtarawu ad-dalalata bi-l-huda » — ceux qui achètent l'égarement au prix de la guidance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'échange contre ma foi ? Mon âme est-elle en vente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bon commerce : acheter la guidance au prix de l'effort, le pardon au prix du repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque choix est un échange. Chaque décision a un prix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la guidance reçoit plus que ce qu'il a donné." }
  ],
  munajat: `Ya Hadi, ne me laisse pas faire ce mauvais commerce. Donne-moi la guidance et le pardon, non l'égarement et le châtiment.`
};

MIROIR["2:176"] = {
  reference: "2:176",
  theme: ["vérité", "révélation", "châtiment"],
  emotion: "Sérieux, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Furqan"],
  mirrorVersion: `« C'est ainsi qu'Allah fait descendre la vérité par Son Livre. Et ceux qui contestent le Livre sont dans une discorde lointaine. » Le miroir me montre la source de la vérité. Le Livre est la vérité descendue d'Allah. Contester, c'est entrer dans une discorde qui n'a pas de fin. La vérité est une ; la contestation crée la division. Le miroir m'interroge : est-ce que j'accepte la vérité du Livre ? Ou est-ce que je la conteste ?`,
  reflection: `Le Livre est la vérité. Le contester, c'est s'éloigner de la source.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-anna Allahi nazzala al-kitaba bi-l-haqq » — c'est ainsi qu'Allah fait descendre le Livre avec la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la vérité du Livre ? Ou est-ce que je la conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Contester la vérité, c'est se condamner à l'errance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité descend du ciel. La discorde monte des cœurs orgueilleux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité trouve la paix. Celui qui la conteste trouve le trouble." }
  ],
  munajat: `Ya Rabb, je T'accepte Ton Livre comme vérité. Ne me laisse pas contester ce qui est clair. Donne-moi la paix de la vérité.`
};

MIROIR["2:178"] = {
  reference: "2:178",
  theme: ["justice", "mesure", "loi"],
  emotion: "Justice, équité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Ô vous qui croyez ! Le talion vous est prescrit pour les tués : libre pour libre, esclave pour esclave, femme pour femme. » Le miroir me montre la loi du talion — une justice mesurée, proportionnée. Pas de vengeance démesurée, pas d'injustice. La loi protège en limitant. Le miroir m'interroge : quand je suis lésé, quelle est ma réponse ? Justice ou vengeance ?`,
  reflection: `Le talion limite la vengeance. La justice divine est proportionnée, jamais excessive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-qisas » — le talion, la rétribution proportionnée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis lésé, quelle est ma réponse ? Justice équitable ou vengeance démesurée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon est au-dessus du talion. Mais la justice protège la société." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équilibre est la loi de l'univers. Action et réaction sont proportionnées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique la justice proportionnée reflète la justice de Dieu." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Aide-moi à être juste dans mes réponses. Ne me laisse pas dépasser les bornes de l'équité.`
};

MIROIR["2:179"] = {
  reference: "2:179",
  theme: ["vie", "talion", "sagesse"],
  emotion: "Réflexion, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Hakim"],
  mirrorVersion: `« Dans le talion, il y a une vie pour vous, ô gens doués d'intelligence. » Le miroir me montre le paradoxe du talion. La loi du talion semble dure, mais elle protège la vie. La dissuasion empêche les meurtres. La justice mesurée protège la société. Ce qui semble prendre la vie en fait la préserve. Le miroir m'interroge : est-ce que je comprends la sagesse derrière les lois ?`,
  reflection: `La loi du talion protège la vie par la dissuasion. La justice mesurée est une protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lakum fi al-qisasi hayat » — dans le talion, il y a une vie pour vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la sagesse derrière les lois ? Ou est-ce que je les juge superficiellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loi qui semble dure est souvent celle qui protège le mieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équilibre est la loi de l'univers. Toute action a une conséquence mesurée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la sagesse des lois accepte ce qui semble dur." }
  ],
  munajat: `Ya Hakim, Tu es le Sage. Donne-moi l'intelligence de comprendre Tes lois. Fais que je voie la sagesse derrière chaque prescription.`
};

MIROIR["2:180"] = {
  reference: "2:180",
  theme: ["testament", "parents", "obligation"],
  emotion: "Responsabilité, piété",
  difficulty: "débutant",
  relatedNames: ["Al-Wasiyyah", "Al-Warith"],
  mirrorVersion: `« Il est prescrit, quand la mort approche de l'un de vous, s'il laisse des biens, de faire un testament en faveur de ses parents et proches. » Le miroir me montre la responsabilité envers les proches. Le testament n'est pas optionnel — c'est une obligation. Penser aux autres même au moment de partir. Les parents et les proches ont des droits. Le miroir m'interroge : est-ce que j'ai pensé à ceux qui viendront après moi ?`,
  reflection: `Le testament est un devoir envers les proches. Penser aux autres même dans la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kutiba 'alaykum idha hadara ahadakumu al-mawtu » — il est prescrit, quand la mort approche de l'un de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai pensé à ceux qui viendront après moi ? Mon testament est-il équitable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Partir sans testament, c'est laisser le chaos. Partir avec un testament, c'est laisser l'ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce que nous avons est un dépôt. Nous devons le transmettre avec justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pense aux autres dans sa mort pense vraiment aux autres dans sa vie." }
  ],
  munajat: `Ya Rabb, aide-moi à être responsable envers les miens. Fais que je ne parte pas sans avoir réglé mes affaires.`
};

MIROIR["2:181"] = {
  reference: "2:181",
  theme: ["testament", "fraude", "péché"],
  emotion: "Mise en garde, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Hasib"],
  mirrorVersion: `« Quiconque le modifie après l'avoir entendu, le péché en incombera à ceux qui le modifient. » Le miroir me montre la gravité de la fraude testamentaire. Modifier le testament d'un défunt, c'est voler les héritiers. C'est un péché qui pèse sur celui qui fraude. Les morts ne peuvent pas se défendre — Allah les défend. Le miroir m'interroge : est-ce que je respecte les volontés des défunts ?`,
  reflection: `Modifier un testament est un vol. Les morts ont des droits qu'Allah protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man baddalahu ba'da ma sami'ahu » — quiconque le modifie après l'avoir entendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les volontés des défunts ? Ou est-ce que je les manipule pour mon profit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Frauder les morts, c'est frauder les vivants qui héritent. C'est un double vol." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité survit à la mort. Le mensonge finit par être exposé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les volontés des morts respecte la vérité elle-même." }
  ],
  munajat: `Ya Amin, Tu es le Fidèle. Aide-moi à respecter les volontés des défunts. Ne me laisse pas frauder ce qui ne m'appartient pas.`
};

MIROIR["2:182"] = {
  reference: "2:182",
  theme: ["testament", "correction", "équité"],
  emotion: "Justice, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Muslih", "Al-'Adl"],
  mirrorVersion: `« Celui qui craint une partialité ou un péché de la part du testateur et rétablit l'équilibre, alors il n'y a pas de péché sur lui. » Le miroir me montre l'exception qui protège. Si le testateur a été injuste, on peut corriger le testament. La justice prime sur la lettre. Rétablir l'équilibre n'est pas un péché — c'est un devoir. Le miroir m'interroge : est-ce que je cherche la justice ou la lettre de la loi ?`,
  reflection: `La justice prime sur la forme. Corriger une injustice n'est pas un péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man khafa min musin janafan » — celui qui craint une partialité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la justice ou la lettre de la loi ? Suis-je prêt à corriger une injustice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Respecter un testament injuste n'est pas respecter le testateur — c'est respecter son erreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équilibre est la loi de l'univers. Toute injustice doit être corrigée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rétablit la justice est un instrument de la justice divine." }
  ],
  munajat: `Ya 'Adl, donne-moi le courage de corriger les injustices. Fais que je ne me cache pas derrière la lettre de la loi pour ignorer l'esprit.`
};

MIROIR["2:183"] = {
  reference: "2:183",
  theme: ["jeûne", "piété", "prescription"],
  emotion: "Détermination, spiritualité",
  difficulty: "débutant",
  relatedNames: ["Al-Muta'ali", "Al-Khabir"],
  mirrorVersion: `« Ô vous qui croyez ! Le jeûne vous est prescrit comme il a été prescrit à ceux avant vous, peut-être deviendrez-vous pieux. » Le miroir me montre le jeûne comme chemin vers la piété. Ce n'est pas seulement s'abstenir de nourriture — c'est s'abstenir du mal. Le jeûne est une école spirituelle où l'on apprend la maîtrise de soi. Le miroir m'interroge : mon jeûne m'enseigne-t-il la piété ?`,
  reflection: `Le jeûne est universel. Son but : la taqwa — la conscience de Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La'allakum tattaqun » — peut-être deviendrez-vous pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon jeûne m'enseigne-t-il la piété ? Est-ce que je maîtrise mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Jeûner sans piété, c'est avoir faim sans profit spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jeûne purifie le corps et l'âme. C'est une médecine spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui jeûne vraiment découvre que son âme a besoin de peu." }
  ],
  munajat: `Ya Rabb, le jeûne m'est prescrit. Fais qu'il m'enseigne la piété. Purifie mon âme par cette abstinence.`
};

MIROIR["2:184"] = {
  reference: "2:184",
  theme: ["jeûne", "facilité", "rachat"],
  emotion: "Soulagement, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Latif"],
  mirrorVersion: `« Des jours déterminés. Quiconque d'entre vous est malade ou en voyage, qu'il jeûne un nombre égal d'autres jours. Et pour ceux qui peuvent le supporter, il y a un rachat : nourrir un pauvre. » Le miroir me montre la facilité dans la loi. Allah ne veut pas la difficulté. Le malade, le voyageur — des exceptions. Et même pour ceux qui peuvent, une option de rachat. La religion est facilité, pas difficulté. Le miroir m'interroge : est-ce que je vis ma religion comme un fardeau ou comme une facilité ?`,
  reflection: `Allah veut la facilité, pas la difficulté. La religion s'adapte aux circonstances.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuridu Allahu bikumu al-yusra wa la yuridu bikumu al-'usra » — Allah veut la facilité pour vous, pas la difficulté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis ma religion comme un fardeau ou comme une facilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité n'est pas la faiblesse — c'est la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi naturelle s'adapte aux circonstances. La loi divine aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la facilité de Dieu L'aime plus." }
  ],
  munajat: `Ya Rahman, Tu veux la facilité pour moi. Aide-moi à vivre ma religion avec joie, pas comme un fardeau.`
};

MIROIR["2:185"] = {
  reference: "2:185",
  theme: ["ramadan", "coran", "guidance"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Huda"],
  mirrorVersion: `« Le mois de Ramadan dans lequel le Coran a été descendu comme guidance pour les gens et preuves évidentes de la guidance et du discernement. » Le miroir me montre le lien entre le mois et le Livre. Ramadan n'est pas seulement le mois du jeûne — c'est le mois du Coran. Le Livre y a été révélé. Jeûner, c'est se préparer à recevoir la parole. Le miroir m'interroge : quel lien ai-je avec le Coran pendant Ramadan ?`,
  reflection: `Ramadan est le mois du Coran. Jeûner sans se rapprocher du Livre, c'est manquer l'essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Shahru Ramadan alladzi unzila fihi al-Quran » — le mois de Ramadan dans lequel le Coran a été descendu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel lien ai-je avec le Coran pendant Ramadan ? Est-ce que je le lis ? Est-ce que je le vis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Jeûner le corps sans nourrir l'âme du Coran est un jeûne incomplet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la lumière. Ramadan est le moment où cette lumière a commencé à briller." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combine le jeûne du corps avec la lecture du cœur reçoit la pleine bénédiction." }
  ],
  munajat: `Ya Rabb, Ramadan est le mois du Coran. Fais que je me rapproche de Ton Livre. Nourris mon âme de Ta parole.`
};

MIROIR["2:187"] = {
  reference: "2:187",
  theme: ["nuit", "relations", "permitted"],
  emotion: "Intimité, permission",
  difficulty: "débutant",
  relatedNames: ["Al-Halal", "Al-Mubin"],
  mirrorVersion: `« Il vous est permis la nuit du jeûne d'avoir des rapports avec vos femmes. » Le miroir me montre la facilité dans la religion. Le jeûne est une discipline, mais pas une punition. Les relations conjugales sont permises la nuit. Allah connaît les besoins humains. La religion équilibre le spirituel et le naturel. Le miroir m'interroge : est-ce que je comprends que la facilité fait partie de la religion ?`,
  reflection: `La religion équilibre discipline et facilité. Les besoins légitimes sont reconnus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uhilla lakum laylata as-siyami ar-rafathu ila nisa'ikum » — il vous est permis la nuit du jeûne d'avoir des rapports avec vos femmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la facilité fait partie de la religion ? Est-ce que j'accepte les permissions divines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Refuser la permission, c'est refuser la sagesse divine. La facilité n'est pas la faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour pour l'effort, la nuit pour le repos. L'alternance est une loi de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les permissions divines avec gratitude les transforme en adoration." }
  ],
  munajat: `Ya Rabb, merci pour Tes permissions. Fais que je vive ma religion avec équilibre, ni excès ni négligence.`
};

MIROIR["2:188"] = {
  reference: "2:188",
  theme: ["fraude", "justice", "biens"],
  emotion: "Intégrité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haram", "Al-Batil"],
  mirrorVersion: `« Ne dévorez pas injustement vos biens entre vous, et ne les présentez pas aux juges pour dévorer injustement une partie des biens d'autrui, alors que vous savez. » Le miroir me montre la corruption sous toutes ses formes. Dévorer les biens injustement, corrompre les juges — autant de chemins vers l'injustice. Le savoir n'innocente pas ; il condamne. Le miroir m'interroge : est-ce que je prends ce qui ne m'appartient pas ? Est-ce que je corromps pour obtenir ?`,
  reflection: `L'injustice financière est grave. La corruption du système judiciaire est pire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la ta'kulu amwalakum baynakum bi-l-batili » — ne dévorez pas injustement vos biens entre vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends ce qui ne m'appartient pas ? Est-ce que je corromps pour obtenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gain injuste est une perte spirituelle. Le bien mal acquis ne profite jamais vraiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'injustice détruit l'ordre social. La corruption ronge la société de l'intérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui gagne honnêtement gagne deux fois : le bien et la bénédiction." }
  ],
  munajat: `Ya Rabb, garde-moi de l'injustice financière. Fais que je ne prenne que ce qui m'appartient. Purifie mes gains.`
};

MIROIR["2:189"] = {
  reference: "2:189",
  theme: ["lune", "temps", "entrée"],
  emotion: "Questionnement, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Qadir"],
  mirrorVersion: `« Ils t'interrogent sur les nouvelles lunes. Dis : Ce sont des repères pour les hommes et pour le pèlerinage. » Le miroir me montre la fonction des cycles lunaires. Les nouvelles lunes ne sont pas des superstitions — ce sont des repères temporels. Le temps est organisé pour l'homme. Le pèlerinage, le jeûne, tout suit le cycle lunaire. Le miroir m'interroge : est-ce que je respecte le temps divin ?`,
  reflection: `Les cycles lunaires organisent le temps sacré. Le temps est un don à respecter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'alunaka 'ani al-ahillati qul hiya mawaqitu li-n-nasi wa al-hajj » — ils t'interrogent sur les nouvelles lunes. Dis : Ce sont des repères pour les hommes et pour le pèlerinage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte le temps divin ? Est-ce que je comprends l'organisation du temps sacré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps n'est pas une contrainte — c'est une structure. Sans structure, le spirituel se disperse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lune marque le temps. L'homme suit le cycle. L'ordre est dans le rythme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le temps sacré aligne sa vie sur le rythme divin." }
  ],
  munajat: `Ya Rabb, fais que je respecte Ton temps. Aide-moi à vivre selon les cycles que Tu as établis.`
};

MIROIR["2:190"] = {
  reference: "2:190",
  theme: ["combat", "justice", "limites"],
  emotion: "Détermination, mesure",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujahid", "Al-'Adl"],
  mirrorVersion: `« Combattez dans le chemin d'Allah ceux qui vous combattent, mais ne transgressez pas. » Le miroir me montre le combat licite. Se défendre est permis, mais avec des limites. La transgression annule la justice du combat. Le but n'est pas la destruction — c'est la protection. Le miroir m'interroge : est-ce que je connais les limites du licite dans le conflit ?`,
  reflection: `Le combat défensif est permis. La transgression transforme la défense en agression.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qatilu fi sabili Allahi alladhina yuqatilunakum wa la ta'tadu » — combattez dans le chemin d'Allah ceux qui vous combattent, mais ne transgressez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les limites du licite dans le conflit ? Est-ce que je respecte les bornes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Transgresser dans le combat licite, c'est perdre la justification du combat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute force a des limites. La justice réside dans le respect des limites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat dans les limites divines combat avec Dieu." }
  ],
  munajat: `Ya Rabb, si je dois me défendre, aide-moi à rester dans les limites. Ne me laisse pas transgresser ce que Tu as interdit.`
};

MIROIR["2:191"] = {
  reference: "2:191",
  theme: ["combat", "sacralité", "expulsion"],
  emotion: "Détermination, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "Al-Matin"],
  mirrorVersion: `« Tuez-les où que vous les trouviez, et chassez-les d'où ils vous ont chassés. La tentation est plus grave que le meurtre. » Le miroir me montre la gravité de l'oppression. Ceux qui chassent les croyants de leurs foyers méritent une réponse. La tentation — forcer quelqu'un à renier sa foi — est pire que la mort physique. Le miroir m'interroge : est-ce que je comprends la gravité de la persécution religieuse ?`,
  reflection: `L'expulsion et la persécution religieuse sont graves. La défense de la liberté de foi est légitime.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akhrujuhum min haythu akhrajukum » — et chassez-les d'où ils vous ont chassés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la gravité de la persécution religieuse ? La liberté de foi vaut-elle le combat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort du corps est moindre que la mort de la foi. La persécution vise l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La liberté de conscience est sacrée. L'opprimer est un crime contre l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend la liberté de foi défend ce qui est le plus précieux." }
  ],
  munajat: `Ya Rabb, protège ma foi de la persécution. Donne-moi la force de la défendre si elle est menacée.`
};

MIROIR["2:192"] = {
  reference: "2:192",
  theme: ["combat", "cessation", "miséricorde"],
  emotion: "Espoir, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Ar-Rahim"],
  mirrorVersion: `« S'ils cessent, Allah est Pardonneur et Miséricordieux. » Le miroir me montre la porte ouverte. Le combat n'est pas éternel. Dès que l'agresseur cesse, la réponse cesse. Le pardon attend celui qui s'arrête. La miséricorde d'Allah précède Sa justice. Le miroir m'interroge : est-ce que je sais arrêter quand l'autre arrête ?`,
  reflection: `La cessation de l'agression ouvre la porte du pardon. La miséricorde attend le retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ini intahaw fa-inna Allaha ghafurun rahim » — s'ils cessent, Allah est Pardonneur et Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sais arrêter quand l'autre arrête ? Mon pardon est-il prêt pour celui qui cesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Continuer le combat après la cessation de l'agression, c'est devenir l'agresseur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix est l'état naturel. La guerre est l'exception qui doit cesser dès que possible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la paix quand elle est offerte reflète la miséricorde divine." }
  ],
  munajat: `Ya Ghafur, fais que je sache pardonner quand l'autre cesse. Ne me laisse pas poursuivre sans raison.`
};

MIROIR["2:193"] = {
  reference: "2:193",
  theme: ["combat", "religion", "liberté"],
  emotion: "Détermination, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hurriyah"],
  mirrorVersion: `« Combattez-les jusqu'à ce qu'il n'y ait plus de tentation et que la religion soit entièrement à Allah. » Le miroir me montre le but du combat : la liberté religieuse. Pas la conversion forcée, mais l'élimination de la contrainte. La religion à Allah signifie la liberté de pratiquer sans persécution. Le combat cesse quand la liberté est assurée. Le miroir m'interroge : est-ce que je comprends que le but est la liberté, pas la domination ?`,
  reflection: `Le but du combat est la liberté de religion, pas la conversion forcée. La fin de la persécution marque la fin du combat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta takuna fitnatun wa yakuna ad-dinu li-Llah » — jusqu'à ce qu'il n'y ait plus de tentation et que la religion soit entièrement à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que le but est la liberté, pas la domination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion « à Allah » signifie libre, pas forcée. La liberté est le but, la domination est l'erreur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La liberté de conscience est le fondement de la vraie religion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat pour la liberté de tous combat pour la vérité." }
  ],
  munajat: `Ya Rabb, fais que je combatte pour la liberté, pas pour la domination. Que Ton règne soit celui de la liberté.`
};

MIROIR["2:194"] = {
  reference: "2:194",
  theme: ["mois", "sacré", "réciprocité"],
  emotion: "Justice, équilibre",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahr", "Al-Haram"],
  mirrorVersion: `« Le mois sacré pour le mois sacré. Les choses sacrées relèvent de la loi du talion. » Le miroir me montre la réciprocité dans les choses sacrées. La violation d'un mois sacré peut être répondu dans un mois sacré. Mais la transgression reste interdite. La justice s'applique même dans le sacré. Le miroir m'interroge : est-ce que je comprends que la justice transcende le sacré ?`,
  reflection: `La justice s'applique partout, même dans les temps sacrés. La réciprocité est une forme d'équilibre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ash-shahru al-haramu bi-sh-shahri al-haram » — le mois sacré pour le mois sacré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la justice s'applique même dans le sacré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacré n'immunise pas contre la justice. Il élève la responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps sacré n'est pas un temps sans justice. C'est un temps de justice élevée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le sacré dans la justice respecte vraiment le sacré." }
  ],
  munajat: `Ya Rabb, fais que je respecte le sacré tout en pratiquant la justice. Ne me laisse pas utiliser le sacré pour fuir la justice.`
};

MIROIR["2:195"] = {
  reference: "2:195",
  theme: ["dépense", "prospérité", "auto-destruction"],
  emotion: "Générosité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Karim"],
  mirrorVersion: `« Et dépensez dans le chemin d'Allah. Et ne vous jetez pas par vos propres mains dans la destruction. » Le miroir me montre le lien entre la dépense et la protection. Ne pas dépenser dans le chemin d'Allah, c'est se jeter dans la destruction. La richesse non partagée se corrompt. Le don protège celui qui donne. Le miroir m'interroge : est-ce que je dépense dans le chemin d'Allah ? Ou est-ce que je garde tout ?`,
  reflection: `La dépense dans le chemin d'Allah protège de la destruction. La richesse gardée se perd.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anfiq fi sabili Allah » — et dépensez dans le chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense dans le chemin d'Allah ? Ou est-ce que je garde tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Garder par avarice, c'est se jeter dans la destruction. Donner par foi, c'est se protéger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau qui stagne pourrit. L'eau qui coule reste pure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne reçoit plus que ce qu'il a donné." }
  ],
  munajat: `Ya Wahhab, Tu m'as donné. Aide-moi à donner dans Ton chemin. Ne me laisse pas me jeter dans la destruction par avarice.`
};

MIROIR["2:196"] = {
  reference: "2:196",
  theme: ["hajj", "umrah", "offrande"],
  emotion: "Dévotion, accomplissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hajj", "Al-Hadi"],
  mirrorVersion: `« Accomplissez pour Allah le pèlerinage et la visite. Si vous en êtes empêchés, faites une offrande. » Le miroir me montre l'obligation du Hajj et de l'Umrah, mais aussi la facilité en cas d'empêchement. L'offrande (hady) remplace ce qui ne peut être accompli. La religion tient compte des circonstances. L'intention compte autant que l'accomplissement. Le miroir m'interroge : ai-je fait le Hajj si je le peux ? Et si je ne peux pas, quelle est ma compensation ?`,
  reflection: `Le Hajj est une obligation pour qui le peut. L'empêchement a sa compensation. L'intention est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa atimmu al-hajja wa al-'umrata li-Llah » — accomplissez pour Allah le pèlerinage et la visite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je fait le Hajj si je le peux ? Et si je ne peux pas, quelle est ma compensation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Pouvoir faire le Hajj et ne pas le faire est une négligence grave. Ne pas pouvoir et chercher la compensation est une obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Hajj rassemble les croyants. L'offrande partage avec les pauvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accomplit le Hajj avec un cœur pur revient comme nouveau-né." }
  ],
  munajat: `Ya Rabb, si je peux faire le Hajj, aide-moi à l'accomplir. Si je ne peux pas, accepte mon offrande. Mon cœur est avec Ta Maison.`
};

MIROIR["2:197"] = {
  reference: "2:197",
  theme: ["hajj", "mois", "piété"],
  emotion: "Révérence, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Bayt", "Al-Haram"],
  mirrorVersion: `« Le pèlerinage a lieu dans des mois connus. Quiconque s'y engage doit s'abstenir de rapports sexuels, d'injustice et de dispute pendant le pèlerinage. » Le miroir me montre le Hajj comme une école de comportement. Des mois sacrés, des interdits précis. Le pèlerinage n'est pas seulement un voyage physique — c'est une transformation éthique. Le miroir m'interroge : suis-je prêt pour ce voyage ? Qu'est-ce que je dois abandonner ?`,
  reflection: `Le Hajj est une école de purification. Les interdits forment le caractère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hajju ash-hurun ma'lumat » — le pèlerinage a lieu dans des mois connus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ce voyage ? Qu'est-ce que je dois abandonner pour le Hajj ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Hajj sans purification du comportement est un voyage vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Hajj rassemble des millions dans un même état. L'égalité devant Dieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le Hajj avec un cœur pur revient comme nouveau-né." }
  ],
  munajat: `Ya Rabb, le Hajj est un voyage sacré. Prépare mon cœur. Fais que je m'y purifie et que je revienne transformé.`
};

MIROIR["2:198"] = {
  reference: "2:198",
  theme: ["hajj", "pardon", "provision"],
  emotion: "Gratitude, demande",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Razzaq"],
  mirrorVersion: `« Ce n'est pas un péché pour vous de rechercher la grâce de votre Seigneur. Puis quand vous déferlez d'Arafat, invoquez Allah à al-Mash'ar al-Haram. » Le miroir me montre que chercher la provision d'Allah pendant le Hajj n'est pas un péché — c'est une recherche de Sa grâce. Le pèlerinage n'exige pas la pauvreté, mais la piété. Le miroir m'interroge : comment je cherche la provision d'Allah ? Avec piété ou avec avidité ?`,
  reflection: `Chercher la provision d'Allah avec piété fait partie du culte. Le commerce licite pendant le Hajj est permis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laysa 'alaykum junahun an tabtaghu fadlan min rabbikum » — ce n'est pas un péché de rechercher la grâce de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je cherche la provision d'Allah ? Avec piété ou avec avidité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision recherchée avec piété devient bénédiction. L'avidité la transforme en péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature cherche sa provision. L'homme est seul à pouvoir choisir comment la chercher." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la grâce d'Allah avec un cœur pur la trouve dans ce monde et l'autre." }
  ],
  munajat: `Ya Razzaq, je cherche Ta provision avec piété. Bénis ce que Tu me donnes. Ne me laisse pas tomber dans l'avidité.`
};

MIROIR["2:199"] = {
  reference: "2:199",
  theme: ["hajj", "pardon", "retour"],
  emotion: "Humilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "At-Tawwab"],
  mirrorVersion: `« Puis déferlez d'où les gens déferlent, et demandez pardon à Allah. Allah est Pardonneur, Miséricordieux. » Le miroir me montre le mouvement du retour. Déferler avec les gens, puis demander pardon. Le Hajj n'est pas une exception individuelle — c'est un mouvement collectif vers Allah. Le miroir m'interroge : quand je reviens vers Allah, est-ce avec les autres ou seul ?`,
  reflection: `Le retour vers Allah est collectif et individuel. Demander pardon complète le voyage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma afidu min haythu afada an-nas » — puis déferlez d'où les gens déferlent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je reviens vers Allah, est-ce avec les autres ou seul ? Est-ce que je demande vraiment pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demander pardon est le vrai retour. Sans cette demande, le voyage est incomplet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'humanité retourne vers Allah. Le Hajj est une image de ce retour universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande pardon avec sincérité est déjà pardonné avant même de finir sa demande." }
  ],
  munajat: `Ya Ghaffur, je demande Ton pardon. Accepte mon retour. Efface mes fautes et accueille-moi dans Ta miséricorde.`
};

MIROIR["2:200"] = {
  reference: "2:200",
  theme: ["dhikr", "priorité", "monde"],
  emotion: "Réorientation, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Kabir", "Al-'Aliyy"],
  mirrorVersion: `« Et quand vous avez accompli vos rites, invoquez Allah comme vous invoquez vos pères, ou avec plus de ferveur encore. » Le miroir me montre l'importance du dhikr après les rites. Les gens invoquent leurs ancêtres avec passion — Allah mérite plus. Le miroir m'interroge : quelle est ma ferveur dans l'invocation d'Allah ? Est-elle comparable à mon attachement aux choses de ce monde ?`,
  reflection: `L'invocation d'Allah doit dépasser tout autre attachement. La ferveur pour Lui doit être la plus grande.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faidha qadaytum manasikakum fa-dhkuru Allah » — quand vous avez accompli vos rites, invoquez Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma ferveur dans l'invocation d'Allah ? Est-elle comparable à mon attachement aux choses de ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ceux qui invoquent autre qu'Allah avec ferveur perdent leur temps. Lui seul mérite cette ferveur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers invoque Allah. L'homme est le seul à pouvoir choisir d'invoquer autre chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah avec ferveur connaît une présence que les autres ne connaissent pas." }
  ],
  munajat: `Ya Kabir, je veux T'invoquer avec ferveur. Purifie mon cœur des attachements qui me détournent de Toi.`
};

MIROIR["2:201"] = {
  reference: "2:201",
  theme: ["du'a", "balance", "dounia-akhira"],
  emotion: "Équilibre, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Karim"],
  mirrorVersion: `« Parmi les gens, il en est qui disent : Seigneur, donne-nous une bonne part ici-bas et une bonne part dans l'au-delà. » Le miroir me montre le du'a équilibré. Ne pas refuser le monde, mais ne pas s'y limiter. Demander le bien des deux mondes. Le miroir m'interroge : comment je fais mes demandes à Allah ? Suis-je équilibré ou extrême ?`,
  reflection: `Le croyant demande le bien dans les deux mondes. Il refuse l'ascétisme excessif comme le matérialisme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana atina fi-d-dunya hasanatan wa fi-l-akhirati hasanatan » — Seigneur, donne-nous une bonne part ici-bas et dans l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je fais mes demandes à Allah ? Suis-je équilibré ou extrême ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demander seulement ce monde est une perte. Demander seulement l'au-delà est une négligence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce monde et l'autre sont tous deux créés par Allah. Le croyant les embrasse tous les deux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande les deux avec équilibre reçoit les deux avec bénédiction." }
  ],
  munajat: `Ya Rabb, donne-moi une bonne part ici-bas et dans l'au-delà. Protège-moi du châtiment du Feu.`
};

MIROIR["2:202"] = {
  reference: "2:202",
  theme: ["rétribution", "conséquence", "choix"],
  emotion: "Responsabilité, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-'Adl"],
  mirrorVersion: `« Ceux-là auront une part de ce qu'ils ont acquis. Allah est prompt dans les comptes. » Le miroir me montre que chacun reçoit selon ce qu'il a acquis. Pas d'injustice, pas de favoritisme. La part est calculée sur les actions. Le miroir m'interroge : qu'est-ce que j'acquiers ? Quelle sera ma part ?`,
  reflection: `La rétribution est certaine et rapide. Chacun reçoit ce qu'il a mérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika lahum nassibun mimma kasabu » — ceux-là auront une part de ce qu'ils ont acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'acquiers ? Quelle sera ma part ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Acquérir du bien pour ce monde seulement, c'est perdre l'au-delà. Acquérir pour les deux, c'est gagner." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action laisse une trace. Le registre est précis, le compte est rapide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la rapidité du compte vit chaque instant avec conscience." }
  ],
  munajat: `Ya Hasib, rends-moi compte de mes actions avant que Tu ne me les comptes. Donne-moi une part de bien.`
};

MIROIR["2:203"] = {
  reference: "2:203",
  theme: ["hajj", "dhikr", "flexibilité"],
  emotion: "Dévotion, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Shakur", "Al-Halim"],
  mirrorVersion: `« Et invoquez Allah pendant des jours comptés. Celui qui se hâte en deux jours ne commet pas de péché, et celui qui s'attarde ne commet pas de péché non plus. » Le miroir me montre la flexibilité dans le culte. Deux jours ou trois — les deux sont acceptés. Le dhikr reste l'essentiel. Le miroir m'interroge : est-ce que je comprends la flexibilité d'Allah dans Son culte ?`,
  reflection: `La flexibilité dans le culte montre la miséricorde d'Allah. L'essentiel est le dhikr.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa-dhkuru Allah fi ayyamin ma'dudat » — invoquez Allah pendant des jours comptés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la flexibilité d'Allah dans Son culte ? Est-ce que je profite de cette souplesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rigidité dans le culte peut être une forme d'orgueil. La flexibilité est une grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jours sont comptés, le temps est limité. Le dhikr maximise ce temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah sincèrement, que ce soit deux jours ou trois, est accepté." }
  ],
  munajat: `Ya Shakur, accepte mon invocation courte ou longue. Fais que chaque instant soit rempli de Ton souvenir.`
};

MIROIR["2:204"] = {
  reference: "2:204",
  theme: ["hypocrisie", "parole", "apparence"],
  emotion: "Méfiance, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabeer", "Al-Basir"],
  mirrorVersion: `« Parmi les gens, il y a celui dont la parole sur la vie présente te plaît, et qui prend Allah à témoin de ce qu'il a dans le cœur, alors que c'est un acharné disputeur. » Le miroir me montre l'hypocrisie voilée. Une belle parole, un témoignage d'Allah, mais un cœur rempli de disputes. L'apparence cache la réalité. Le miroir m'interroge : est-ce que je me laisse tromper par les belles paroles ? Quelle est ma propre parole ?`,
  reflection: `La belle parole peut cacher un cœur malade. Le véritable croyant est cohérent entre parole et cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina-n-nasi man yu'jibuka qawluhu fi-l-hayati-d-dunya » — celui dont la parole sur la vie présente te plaît." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse tromper par les belles paroles ? Quelle est ma propre parole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La belle parole sans le cœur correspondant est un mensonge. La vérité est dans la cohérence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est cohérent — chaque élément est en accord avec sa nature. L'hypocrite rompt cette harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît ce qui est dans les cœurs. Aucune belle parole ne peut Lui cacher la réalité." }
  ],
  munajat: `Ya Khabeer, Tu connais ce qui est dans mon cœur. Purifie-le. Fais que ma parole soit sincère.`
};

MIROIR["2:205"] = {
  reference: "2:205",
  theme: ["corruption", "hypocrisie", "danger"],
  emotion: "Vigilance, tristesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhaymin", "Al-Hafiz"],
  mirrorVersion: `« Et quand il tourne le dos, il s'efforce de semer la corruption sur terre et de détruire les récoltes et les troupeaux. Allah n'aime pas la corruption. » Le miroir me montre le contraste effrayant. En face, une belle parole ; dans le dos, la destruction. L'hypocrite détruit ce qu'il prétend construire. Le miroir m'interroge : qu'est-ce que je fais quand personne ne me voit ?`,
  reflection: `L'hypocrite détruit en secret ce qu'il prétend construire en public. Allah n'aime pas la corruption.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha tawalla sa'a fi-l-ardi li-yufsida fiha » — et quand il tourne le dos, il s'efforce de semer la corruption." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais quand personne ne me voit ? Suis-je cohérent ou hypocrite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui détruit ce qu'Allah a béni combat contre Allah. La corruption est un ennemi de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre et ses fruits sont un don d'Allah. Les détruire par corruption est un crime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve ce qu'Allah a créé reçoit Sa protection. Celui qui détruit s'expose à Sa colère." }
  ],
  munajat: `Ya Muhaymin, préserve-moi de la corruption et de l'hypocrisie. Fais que je sois cohérent dans le public et le privé.`
};

MIROIR["2:206"] = {
  reference: "2:206",
  theme: ["orgueil", "refus", "avertissement"],
  emotion: "Tristesse, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabbar", "Al-Mutakabbir"],
  mirrorVersion: `« Et quand on lui dit : Crains Allah, la fierté l'entraîne dans le péché. L'Enfer lui suffira. Quel mauvais lit ! » Le miroir me montre l'orgueil qui refuse le conseil. « Crains Allah » devient une insulte pour l'orgueilleux. Son refus l'entraîne vers l'Enfer. Le miroir m'interroge : comment je réagis quand on me conseille ?`,
  reflection: `L'orgueil transforme le conseil en offense. Le refus de craindre Allah mène à l'Enfer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahu ittaqi Allaha akhadhathu-l-'izzatu bi-l-ithm » — quand on lui dit : Crains Allah, la fierté l'entraîne dans le péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand on me conseille ? Est-ce que j'accepte ou est-ce que l'orgueil me pousse au refus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le conseil « crains Allah » est un cadeau. Le refuser, c'est se priver d'une guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil isole de la création et du Créateur. L'humilité connecte à tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille le conseil avec humilité grandit. Celui qui le refuse avec orgueil décline." }
  ],
  munajat: `Ya Allah, protège-moi de l'orgueil. Quand on me conseille, donne-moi l'humilité d'accepter. Ne me laisse pas refuser Ta guidance.`
};

MIROIR["2:207"] = {
  reference: "2:207",
  theme: ["sacrifice", "sincérité", "amour"],
  emotion: "Admiration, inspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Shakur"],
  mirrorVersion: `« Et parmi les gens, il y a celui qui se sacrifie pour rechercher l'agrément d'Allah. Et Allah est compatissant envers les serviteurs. » Le miroir me montre l'antidote à l'hypocrisie. Le sacrifice sincère pour l'agrément d'Allah. Vendre son âme à Allah, pas au monde. Le miroir m'interroge : qu'est-ce que je sacrifie pour Allah ? Quelle est la valeur de mon sacrifice ?`,
  reflection: `Le sacrifice sincère pour Allah est la plus haute offrande. Allah est compatissant envers ceux qui se donnent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina-n-nasi man yashri nafsahu ibtigha'a mardati Allah » — celui qui se sacrifie pour rechercher l'agrément d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je sacrifie pour Allah ? Quelle est la valeur de mon sacrifice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se sacrifier pour le monde, c'est perdre. Se sacrifier pour Allah, c'est gagner éternellement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature vit pour quelque chose. Seul le croyant vit pour l'agrément d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sacrifie sincèrement pour Allah reçoit plus qu'il ne donne." }
  ],
  munajat: `Ya Wadud, je veux me sacrifier pour Toi. Accepte mon offrande. Fais que ma vie soit pour Ton agrément.`
};

MIROIR["2:208"] = {
  reference: "2:208",
  theme: ["soumission", "totalité", "satan"],
  emotion: "Engagement, vigilance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Hadi"],
  mirrorVersion: `« Ô vous qui croyez ! Entrez dans la soumission totale. Et ne suivez pas les pas de Satan, car il est pour vous un ennemi déclaré. » Le miroir me montre que la foi demande une entrée totale. Pas de demi-mesure, pas de compartiments. Et l'ennemi est clair : Satan, qui veut nous détourner. Le miroir m'interroge : suis-je entré totalement dans la soumission ? Ou est-ce que je garde des portes ouvertes ?`,
  reflection: `La foi demande une entrée totale. Les pas de Satan mènent à la sortie de cette soumission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu udkhulu fi-s-silmi kaffatan » — entrez dans la soumission totale." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je entré totalement dans la soumission ? Ou est-ce que je garde des portes ouvertes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission partielle n'est pas la soumission. Satan s'infiltre par les portes non fermées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en soumission à Allah. L'homme est le seul à pouvoir choisir de résister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entre totalement dans la soumission découvre une liberté que le rebelle ne connaît pas." }
  ],
  munajat: `Ya Salam, je veux entrer dans la soumission totale. Ferme les portes que Satan pourrait utiliser. Guide-moi vers la paix.`
};

MIROIR["2:209"] = {
  reference: "2:209",
  theme: ["évidence", "égarement", "chute"],
  emotion: "Gravité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« Si vous défaillez après que les preuves vous soient venues, sachez qu'Allah est Puissant et Sage. » Le miroir me montre la gravité de la défaillance après la guidance. Les preuves sont venues — la responsabilité est engagée. Le miroir m'interroge : qu'est-ce que je fais des preuves qui me sont venues ?`,
  reflection: `La défaillance après la guidance est un grave péché. Allah est Puissant pour punir et Sage dans Son jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in zalaltum min ba'di ma ja'atkumu-l-bayyinatu » — si vous défaillez après que les preuves vous soient venues." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais des preuves qui me sont venues ? Est-ce que je les ignore ou est-ce que je les suis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les preuves sont une responsabilité, pas un privilège. Les ignorer, c'est s'exposer au châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes. Chaque signe est une preuve qui demande une réponse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les preuves et les suit reçoit la guidance continue. Celui qui les ignore s'égare." }
  ],
  munajat: `Ya 'Aziz, les preuves sont venues. Ne me laisse pas défaillir. Tiens-moi ferme dans la guidance.`
};

MIROIR["2:210"] = {
  reference: "2:210",
  theme: ["attente", "jour", "signes"],
  emotion: "Espérance, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malik", "Al-Qahhar"],
  mirrorVersion: `« Attendent-ils seulement qu'Allah vienne à eux dans l'ombre des nuages, ainsi que les anges ? La chose est déjà décidée. » Le miroir me montre l'attente des incrédules. Ils attendent l'impossible — voir Allah avant d'accepter. Mais le décret est déjà pris. Le miroir m'interroge : qu'est-ce que j'attends pour croire ?`,
  reflection: `L'attente de signes extraordinaires est un prétexte. La chose est décidée — croire ou ne pas croire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal yanzuruna illa an ya'tiyahumu Allah fi zulalin mina-l-ghamami » — attendent-ils qu'Allah vienne à eux dans l'ombre des nuages ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends pour croire ? Est-ce que je demande des signes extraordinaires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Attendre des signes avant de croire, c'est inverser l'ordre. La foi précède la vision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout dans l'univers. Les voir demande un cœur ouvert, pas des yeux extraordinaires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend l'évidence absolue pour croire n'aura plus le mérite de la foi." }
  ],
  munajat: `Ya Malik, je crois sans attendre. Les signes sont déjà là. Ouvre mon cœur et mes yeux pour les voir.`
};

MIROIR["2:211"] = {
  reference: "2:211",
  theme: ["question", "guidance", "évidence"],
  emotion: "Interrogation, invitation",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Nur"],
  mirrorVersion: `« Demande aux Enfants d'Israël combien de signes évidents Nous leur avons apportés. » Le miroir me montre l'accumulation des signes. Pas un, pas deux, mais combien ? Une multitude. Et pourtant, l'ingratitude persiste. Le miroir m'interroge : combien de signes ai-je reçus ? Combien ai-je ignorés ?`,
  reflection: `Les signes sont nombreux. L'ingratitude persiste malgré l'évidence. La question interroge notre propre réception.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa'l bani Isra'il kam ataynahum min ayatin bayyinatin » — demande aux Enfants d'Israël combien de signes évidents Nous leur avons apportés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de signes ai-je reçus ? Combien ai-je ignorés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes accumulés augmentent la responsabilité. Plus on reçoit, plus on doit répondre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est remplie de signes. Chaque peuple a reçu sa part de guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes reçoit la gratitude. Celui qui les ignore s'enfonce dans l'aveuglement." }
  ],
  munajat: `Ya Hadi, les signes sont nombreux. Aide-moi à les reconnaître et à les remercier. Ne me laisse pas être ingrat.`
};

MIROIR["2:212"] = {
  reference: "2:212",
  theme: ["dounia", "apparence", "réalité"],
  emotion: "Lucidité, détachement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Haqq"],
  mirrorVersion: `« La vie présente a été embelli pour ceux qui ne croient pas, et ils se moquent de ceux qui croient. Mais les pieux seront au-dessus d'eux au Jour de la Résurrection. » Le miroir me montre l'illusion du monde. Embelli pour les mécréants, il devient une source de moquerie. Mais la réalité finale renverse tout. Le miroir m'interroge : est-ce que je me laisse séduire par l'apparence du monde ?`,
  reflection: `Le monde embelli est une épreuve. Les croyants sont moqués aujourd'hui, mais élevés demain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Zuyina li-l-ladhina kafaru-l-hayatu-d-dunya » — la vie présente a été embelli pour ceux qui ne croient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse séduire par l'apparence du monde ? Quelle est ma priorité réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est beau maintenant peut être vide après. Ce qui est moqué maintenant peut être élevé après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monde est une scène. L'apparence trompe. La réalité se révèle au Jour Dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit au-delà de l'apparence n'est pas trompé. Il investit dans la réalité, pas l'illusion." }
  ],
  munajat: `Ya Haqq, ne me laisse pas tromper par l'apparence du monde. Donne-moi la vision de la réalité. Élève-moi au Jour Dernier.`
};

MIROIR["2:213"] = {
  reference: "2:213",
  theme: ["humanité", "guidance", "division"],
  emotion: "Unité, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Les hommes formaient une seule communauté. Allah envoya les prophètes comme annonciateurs et avertisseurs. Et fit descendre avec eux le Livre avec la vérité, pour trancher entre les gens sur ce où ils divergeaient. » Le miroir me montre l'origine unique de l'humanité. Une seule communauté au début. Les prophètes sont venus rappeler l'unité perdue. Le Livre tranche les divergences. La division n'est pas l'origine — elle est le résultat de l'éloignement. Le miroir m'interroge : est-ce que je travaille pour l'unité ou pour la division ?`,
  reflection: `L'humanité était une. Les prophètes rappellent l'unité. La vérité tranche les divergences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kanu an-nasu ummatan wahida » — les hommes formaient une seule communauté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille pour l'unité ou pour la division ? Ma foi unit-elle ou divise-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division vient de l'égoïsme. L'unité vient de la soumission à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un. La création est unie. L'homme seul se divise." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'unité originelle travaille à la restaurer." }
  ],
  munajat: `Ya Rabb, l'humanité était une. Aide-moi à travailler pour l'unité. Fais que ma foi rassemble et ne divise pas.`
};

MIROIR["2:214"] = {
  reference: "2:214",
  theme: ["épreuve", "patient", "victoire"],
  emotion: "Espoir, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "As-Sabur"],
  mirrorVersion: `« Pensez-vous entrer au Paradis alors que vous n'avez pas encore subi ce qu'ont subi vos prédécesseurs ? L'adversité et le malheur les ont touchés, et ils ont été secoués au point que le messager et ceux qui croyaient avec lui disaient : Quand viendra le secours d'Allah ? — Eh oui, le secours d'Allah est proche. » Le miroir me montre que la victoire vient après l'épreuve. Les prophètes et leurs compagnons ont souffert avant de triompher. La question « quand viendra le secours ? » est humaine — la réponse « il est proche » est divine. Le miroir m'interroge : suis-je prêt à souffrir avant de triompher ?`,
  reflection: `La victoire suit l'épreuve. Le secours d'Allah vient après la patience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mata nasru Allahi — ala inna nasra Allahi qarib » — quand viendra le secours d'Allah ? — eh oui, le secours d'Allah est proche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à souffrir avant de triompher ? Ma patience est-elle solide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Attendre le secours sans passer par l'épreuve, c'est vouloir la récompense sans le travail." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aurore suit la nuit la plus sombre. Le secours suit l'épreuve la plus dure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente dans l'épreuve reçoit le secours qui transforme tout." }
  ],
  munajat: `Ya Fattah, le secours vient après l'épreuve. Donne-moi la patience d'attendre. Fais que je ne désespère jamais.`
};

MIROIR["2:215"] = {
  reference: "2:215",
  theme: ["dépense", "priorité", "charité"],
  emotion: "Générosité, clarté",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Karim"],
  mirrorVersion: `« Ils t'interrogent : Que doivent-ils dépenser ? Dis : Ce que vous dépensez de bien doit aller aux père et mère, aux proches, aux orphelins, aux pauvres et aux voyageurs. » Le miroir me montre l'ordre des priorités dans le don. Parents d'abord, puis proches, puis vulnérables. Le cercle s'élargit. La charité n'est pas aléatoire — elle suit un ordre de responsabilité. Le miroir m'interroge : à qui je donne ? Est-ce que je respecte l'ordre divin ?`,
  reflection: `La charité suit un ordre. Parents, proches, vulnérables — le cercle de la responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-l-walidayni wa-l-aqrabina wa-l-yatama wa-l-masakini wa-bni as-sabil » — aux père et mère, aux proches, aux orphelins, aux pauvres et aux voyageurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je donne ? Est-ce que je respecte l'ordre divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner au loin en oubliant le proche, c'est renverser l'ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les rivières coulent vers la mer. La charité coule du proche vers le lointain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'ordre du don voit ses dons bénis." }
  ],
  munajat: `Ya Raziq, Tu me demandes de donner. Apprends-moi l'ordre de la charité. Fais que mon don atteigne ceux qui en ont besoin.`
};

MIROIR["2:216"] = {
  reference: "2:216",
  theme: ["guerre", "obligation", "sagesse"],
  emotion: "Soumission, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Le combat vous a été prescrit alors qu'il vous est désagréable. Or il se peut que vous ayez de l'aversion pour une chose alors qu'elle vous est bonne, et il se peut que vous aimiez une chose alors qu'elle vous est mauvaise. Allah sait, et vous, vous ne savez pas. » Le miroir me montre le décalage entre nos préférences et la sagesse divine. Nous n'aimons pas certaines obligations — mais elles peuvent être bonnes. Nous aimons certaines choses — mais elles peuvent être mauvaises. Dieu sait, nous ne savons pas. Le miroir m'interroge : est-ce que j'accepte ce que je n'aime pas quand Dieu l'ordonne ?`,
  reflection: `Nos préférences ne coïncident pas toujours avec le bien. Dieu sait ce qui est bon pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa asa an takrahu shay'an wa huwa khayrun lakum » — il se peut que vous ayez de l'aversion pour une chose alors qu'elle vous est bonne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ce que je n'aime pas quand Dieu l'ordonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence personnelle n'est pas le critère de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'enfant n'aime pas le médicament — mais il guérit. L'homme n'aime pas l'épreuve — mais il grandit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte ce qu'il n'aime pas pour l'amour de Dieu reçoit ce qu'il ne peut imaginer." }
  ],
  munajat: `Ya Hakim, Tu sais ce qui est bon pour moi. Aide-moi à accepter ce que je n'aime pas quand Tu l'ordonnes. Je fais confiance à Ta sagesse.`
};

MIROIR["2:217"] = {
  reference: "2:217",
  theme: ["mois", "combat", "justice"],
  emotion: "Gravité, compréhension",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Ils t'interrogent sur le fait de combattre pendant les mois sacrés. Dis : Y combattre est un grave péché. Mais empêcher les gens d'accéder au chemin d'Allah et de Lui être infidèles, est plus grave encore auprès d'Allah. » Le miroir me montre la hiérarchie des interdits. Combattre dans les mois sacrés est grave — mais empêcher l'accès à la voie d'Allah est plus grave. Le plus grand mal n'est pas toujours là où on le croit. La persécution religieuse dépasse la violation des mois sacrés. Le miroir m'interroge : qu'est-ce que je considère comme grave ? Et qu'est-ce qui est réellement grave ?`,
  reflection: `La hiérarchie des interdits n'est pas évidente. Empêcher l'accès à Dieu est pire que combattre dans un mois sacré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« As-siddu 'an sabili Allahi wa kufrun bihi » — empêcher le chemin d'Allah et l'incrédulité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme grave ? Est-ce que je comprends la hiérarchie divine des valeurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le plus visible n'est pas toujours le plus grave. Le mal caché peut dépasser le mal apparent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre a ses saisons sacrées. L'âme a ses chemins sacrés. Les bloquer est le pire crime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la hiérarchie des maux sait où diriger sa lutte." }
  ],
  munajat: `Ya Hakam, Tu connais la hiérarchie des valeurs. Apprends-moi à voir ce qui est réellement grave. Ne me laisse pas distraire par le visible.`
};

MIROIR["2:218"] = {
  reference: "2:218",
  theme: ["hijra", "combat", "foi"],
  emotion: "Espérance, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« Ceux qui ont cru, ceux qui ont émigré et qui ont lutté dans le chemin d'Allah, ceux-là espèrent la miséricorde d'Allah. » Le miroir me montre les trois étapes du chemin. Croire — émigrer — lutter. La foi commence, la hijra transforme, le jihad consacre. Ces trois actions ouvrent la porte de l'espoir en la miséricorde. Le miroir m'interroge : où suis-je dans ce parcours ? Ai-je cru ? Émigré ? Lutté ?`,
  reflection: `La foi, l'émigration et le combat forment le chemin complet. L'espoir en la miséricorde vient de ce parcours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina amanu wa-l-ladhina hajaru wa jahadu fi sabili Allah » — ceux qui ont cru, émigré et lutté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je dans ce parcours ? Ai-je cru ? Émigré ? Lutté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans hijra reste locale. La hijra sans jihad reste incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'oiseau quitte le nid, l'âme quitte le confort. La migration fait partie de la croissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parcourt les trois étapes connaît l'espoir véritable." }
  ],
  munajat: `Ya Ghaffur, j'ai cru. Aide-moi à émigrer vers Toi et à lutter dans Ton chemin. Je place mon espoir en Ta miséricorde.`
};

MIROIR["2:219"] = {
  reference: "2:219",
  theme: ["vin", "jeu", "balance"],
  emotion: "Clarté, mesure",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Mubin"],
  mirrorVersion: `« Ils t'interrogent sur le vin et les jeux de hasard. Dis : Il y a un grand péché et quelques profits pour les gens, mais le péché est plus grand que le profit. » Le miroir me montre la méthode coranique de l'évaluation. Il y a du profit, mais il y a plus de péché. La balance penche. La décision vient de l'évaluation, pas de l'interdiction arbitraire. Le vin a des bénéfices, mais ses méfaits sont plus grands. Le miroir m'interroge : est-ce que j'évalue mes choix à la balance divine ?`,
  reflection: `La balance divine pèse le pour et le contre. Le péché l'emporte sur le profit interdit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ithmuhuma akbaru min naf'ihima » — le péché est plus grand que le profit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évalue mes choix à la balance divine ? Le profit immédiat cache-t-il un plus grand mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le profit apparent cache souvent une perte réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque choix a des conséquences. La sagesse consiste à voir le long terme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le péché plus grand que le profit fuit ce qui nuit à son âme." }
  ],
  munajat: `Ya Hakim, apprends-moi à évaluer mes choix. Ne me laisse pas séduire par le profit immédiat. Fais que je voie le mal caché.`
};

MIROIR["2:220"] = {
  reference: "2:220",
  theme: ["orphelins", "monde", "au-delà"],
  emotion: "Responsabilité, perspective",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Wali"],
  mirrorVersion: `« Ils t'interrogent sur les orphelins. Dis : Leur faire du bien est une bonne action. Et si vous mêlez vos affaires aux leurs, ce sont vos frères. Allah distingue celui qui sème le désordre de celui qui fait le bien. » Le miroir me montre la responsabilité envers les orphelins. Les mêler à nos affaires n'est pas interdit — ce sont nos frères. Mais la distinction entre le bien et le mal reste. Le miroir m'interroge : comment je traite les vulnérables ? Suis-je un agent de désordre ou de bien ?`,
  reflection: `Les orphelins sont nos frères. Leur faire du bien est essentiel. La distinction entre le bien et le mal guide nos actions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Islahun lahum khayr » — leur faire du bien est une bonne action." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite les vulnérables ? Suis-je un agent de désordre ou de bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Exploiter les orphelins sous couvert de les aider est le pire des maux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La société est jugée à la façon dont elle traite ses plus vulnérables." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien aux orphelins reçoit la protection d'Allah." }
  ],
  munajat: `Ya Wali, Tu es le Protecteur des orphelins. Fais que je sois un agent de bien pour eux. Ne me laisse pas exploiter leur vulnérabilité.`
};

MIROIR["2:221"] = {
  reference: "2:221",
  theme: ["mariage", "foi", "choix"],
  emotion: "Clarté, priorité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mu'min"],
  mirrorVersion: `« N'épousez pas les femmes associatrices tant qu'elles n'auront pas cru. Une esclave croyante vaut mieux qu'une associatrice, même si celle-ci vous plaît. » Le miroir me montre le critère du mariage. La beauté et le statut social passent après la foi. L'esclave croyante vaut mieux que la femme libre associatrice. La foi est le critère fondamental. Le miroir m'interroge : quels critères je priorise dans mes choix de vie ?`,
  reflection: `La foi est le critère fondamental du mariage. La beauté et le statut passent après.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tamliktu-l-imru'atu-l-mu'minatu khayrun min mushrikatin » — une esclave croyante vaut mieux qu'une associatrice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels critères je priorise dans mes choix de vie ? La foi est-elle au centre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Choisir la beauté sans la foi, c'est construire sur du sable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les racines décident de la hauteur de l'arbre. La foi est la racine du foyer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la foi pour fondation reçoit la bénédiction dans tout l'édifice." }
  ],
  munajat: `Ya Hadi, guide mes choix. Fais que la foi soit mon critère fondamental. Ne me laisse pas séduire par l'apparence sans la substance.`
};

MIROIR["2:222"] = {
  reference: "2:222",
  theme: ["pureté", "réponse", "amour"],
  emotion: "Purification, proximité",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Mutahhir"],
  mirrorVersion: `« Allah aime ceux qui se repentent et Il aime ceux qui se purifient. » Le miroir me montre ce qu'Allah aime. Deux amours : ceux qui se repentent (tawwabun) et ceux qui se purifient (mutatahhirun). Le repentir répare le passé, la purification prépare l'avenir. Dieu aime ces deux catégories. Le miroir m'interroge : suis-je de ceux qui se repentent ? De ceux qui se purifient ?`,
  reflection: `Dieu aime ceux qui se repentent et ceux qui se purifient. Deux chemins vers Son amour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inn Allah yuhibbu at-tawwabina wa yuhibbu al-mutatahhirin » — Allah aime ceux qui se repentent et Il aime ceux qui se purifient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je de ceux qui se repentent ? De ceux qui se purifient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas se repentir, c'est refuser l'amour divin. Ne pas se purifier, c'est refuser la proximité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature se purifie constamment. L'eau coule, l'air circule. L'âme aussi doit se purifier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent et se purifie devient digne de l'amour divin." }
  ],
  munajat: `Ya Tawwab, Tu aimes ceux qui se repentent. Je me repens. Ya Mutahhir, Tu aimes ceux qui se purifient. Purifie-moi.`
};

MIROIR["2:223"] = {
  reference: "2:223",
  theme: ["mariage", "protection", "cultivation"],
  emotion: "Responsabilité, tendresse",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wadud"],
  mirrorVersion: `« Vos femmes sont pour vous un champ de labour. Allez à votre champ comme vous le voulez. Et préparez-vous pour l'avenir. » Le miroir me montre la relation conjugale comme une cultivation. Le champ nécessite soin, intention et respect. « Comme vous le voulez » inclut la diversité des approches, mais toujours avec le respect. « Préparez-vous pour l'avenir » rappelle la responsabilité. Le miroir m'interroge : comment je cultive mes relations ? Avec respect ou avec négligence ?`,
  reflection: `La relation conjugale est une cultivation. Le respect et la préparation pour l'avenir sont essentiels.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nisa'ukum harthun lakum » — vos femmes sont pour vous un champ de labour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je cultive mes relations ? Avec respect ou avec négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le champ sans soin produit des ronces. La relation sans respect produit de l'amertume." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute terre cultivée avec soin donne des fruits. Toute relation cultivée avec amour donne de la plénitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive avec intention divine récolte plus que ce qu'il a semé." }
  ],
  munajat: `Ya Khaliq, Tu as créé la relation conjugale. Apprends-moi à la cultiver avec respect et intention. Prépare-moi pour l'avenir.`
};

MIROIR["2:224"] = {
  reference: "2:224",
  theme: ["serment", "excuse", "bien"],
  emotion: "Clarté, sincérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wadud"],
  mirrorVersion: `« Ne faites pas d'Allah un sujet de serment pour vous empêcher de faire le bien, de craindre Allah et de réconcilier les gens. » Le miroir me montre le mauvais usage du serment. Jurer par Allah pour éviter le bien n'est pas une piété — c'est une excuse. Le serment ne doit pas bloquer la bienfaisance. Le miroir m'interroge : est-ce que j'utilise la religion comme excuse pour ne pas faire le bien ?`,
  reflection: `Le serment par Allah ne doit pas empêcher le bien. La religion pousse vers le bien, pas vers l'évitement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taj'alu Allah 'urdatan li-aymanikum » — ne faites pas d'Allah un sujet de serment pour vous empêcher." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise la religion comme excuse pour ne pas faire le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion comme excuse pour le mal est une perversion. La religion comme motivation pour le bien est la voie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien est le fil conducteur de l'univers. Tout ce qui l'empêche est contraire à l'ordre divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien malgré ses serments précédents trouve la grâce d'Allah." }
  ],
  munajat: `Ya Haqq, ne me laisse pas utiliser Ton nom comme excuse pour éviter le bien. Pousse-moi vers la bienfaisance et la réconciliation.`
};

MIROIR["2:225"] = {
  reference: "2:225",
  theme: ["serment", "intention", "cœur"],
  emotion: "Compréhension, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Halim"],
  mirrorVersion: `« Allah ne vous tient pas rigueur de la frivolité dans vos serments, mais Il vous tient rigueur de ce que vos cœurs ont acquis. » Le miroir me montre la distinction entre le dire et le vouloir. Les serments dits par légèreté ne sont pas comptés. Ce qui compte, c'est ce que le cœur a intentionné. Allah juge l'intention, pas seulement la parole. Le miroir m'interroge : qu'est-ce que mon cœur a acquis ? Quelle est mon intention réelle ?`,
  reflection: `Allah juge l'intention du cœur, pas les paroles légères. Le cœur est le véritable registre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakin yu'akhidhukum bima kasabat qulubukum » — mais Il vous tient rigueur de ce que vos cœurs ont acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon cœur a acquis ? Quelle est mon intention réelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les paroles légères sont pardonnées. Les intentions lourdes sont jugées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vent emporte les feuilles sèches. Le cœur garde les graines de l'intention." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie son cœur n'a pas peur du jugement sur les paroles." }
  ],
  munajat: `Ya Ghaffur, Tu connais mon cœur. Purifie-le. Ne me juge pas sur mes paroles légères, mais fais que mes intentions soient pures.`
};

MIROIR["2:226"] = {
  reference: "2:226",
  theme: ["serment", "abstinence", "délai"],
  emotion: "Patience, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabur", "Al-Hakim"],
  mirrorVersion: `« Ceux qui jurent de s'abstenir de leurs femmes ont un délai de quatre mois. S'ils reviennent sur leur serment, Allah est Pardonneur, Miséricordieux. » Le miroir me montre le délai accordé pour la réflexion. Quatre mois pour reconsidérer une décision grave. Le retour est possible, le pardon est ouvert. La porte n'est pas fermée définitivement. Le miroir m'interroge : est-ce que je profite des délais pour me corriger ?`,
  reflection: `Le délai est une miséricorde. Le retour sur une mauvaise décision est possible. Le pardon attend.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-l-mutallaqina tarabbusu arba'ati ash-hur » — un délai de quatre mois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je profite des délais pour me corriger ? Suis-je ouvert au retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai sans réflexion est une perte. Le retour sans sincérité est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les saisons se succèdent. Chaque cycle offre une nouvelle chance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient sincèrement pendant le délai trouve le pardon." }
  ],
  munajat: `Ya Sabur, Tu donnes des délais. Aide-moi à les utiliser pour me corriger. Je reviens vers Toi sincèrement.`
};

MIROIR["2:227"] = {
  reference: "2:227",
  theme: ["serment", "divorce", "conséquence"],
  emotion: "Gravité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sami'", "Al-'Alim"],
  mirrorVersion: `« Et s'ils décident le divorce, Allah entend tout et sait tout. » Le miroir me montre la conséquence du non-retour. Le délai passé sans retour, la décision devient effective. Allah entend et sait — rien n'échappe à Sa connaissance. Le miroir m'interroge : est-ce que je comprends que mes décisions ont des conséquences irréversibles ?`,
  reflection: `Les décisions ont des conséquences. Le délai passé, le choix devient réalité. Allah entend et sait tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in 'azamu at-talaqa fa-Allahu Sami'un 'Alim » — s'ils décident le divorce, Allah entend tout et sait tout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que mes décisions ont des conséquences ? Suis-je conscient de la gravité de mes choix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La décision hâtive peut être regrettée. La décision réfléchie est assumée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque choix laisse une trace. Le registre est précis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui décide avec conscience et accepte les conséquences grandit." }
  ],
  munajat: `Ya Sami', Ya 'Alim, Tu entends et sais tout. Aide-moi à prendre mes décisions avec conscience. Assiste-moi dans les conséquences.`
};

MIROIR["2:228"] = {
  reference: "2:228",
  theme: ["divorce", "période", "droits"],
  emotion: "Justice, dignité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Qadir"],
  mirrorVersion: `« Les femmes divorcées observeront un délai de trois menstruations. Il n'est pas permis de cacher ce qu'Allah a créé dans leurs ventres. Et leurs maris ont plus de droit de les reprendre si elles désirent la réconciliation. » Le miroir me montre l'organisation du divorce. Un délai pour la certitude, la transparence sur la grossesse, et le droit de reprise pour la réconciliation. Tout est ordonné avec sagesse. Le miroir m'interroge : est-ce que je respecte l'ordre divin dans mes relations ?`,
  reflection: `Le divorce est encadré. Le délai protège, la transparence assure la justice, le droit de reprise permet la réconciliation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-mutallaqatu yatarabbasna bi-anfusihinna thalathata quru' » — les femmes divorcées observeront un délai de trois menstruations." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte l'ordre divin dans mes relations ? Est-ce que je cherche la réconciliation quand c'est possible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ignorer le délai, c'est ignorer la protection. Cacher la vérité, c'est trahir la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute transition a besoin de temps. Toute vérité a besoin de transparence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'ordre divin dans les relations reçoit la bénédiction dans la transition." }
  ],
  munajat: `Ya 'Adl, Tu as ordonné le divorce avec sagesse. Aide-moi à respecter Ton ordre. Préserve la dignité de tous dans la transition.`
};

MIROIR["2:229"] = {
  reference: "2:229",
  theme: ["divorce", "limites", "justice"],
  emotion: "Sagesse, mesure",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Adl"],
  mirrorVersion: `« Le divorce est permis deux fois. Ensuite, la femme doit être gardée convenablement ou libérée avec bonté. » Le miroir me montre la structure du divorce. Pas de divorce perpétuel, pas de répudiation sans fin. Deux fois, puis la décision. Garder convenablement ou libérer avec bonté. La relation se termine dignement ou se renouvelle. Le miroir m'interroge : est-ce que je respecte les limites dans mes relations ?`,
  reflection: `Le divorce a des limites. La dignité doit être préservée même dans la séparation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« At-talaqu marratan » — le divorce est permis deux fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les limites dans mes relations ? Ma conduite est-elle digne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Abuser des limites, c'est violer la confiance. Respecter les limites, c'est honorer la loi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute relation a ses limites. Les respecter, c'est préserver l'harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites divines dans ses relations reçoit la bénédiction." }
  ],
  munajat: `Ya Hakim, Tu as posé des limites. Aide-moi à les respecter. Fais que mes relations soient dignes, même dans la séparation.`
};

MIROIR["2:230"] = {
  reference: "2:230",
  theme: ["divorce", "remariage", "limites"],
  emotion: "Gravité, loi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« S'il la divorce, elle ne lui sera plus permise qu'après avoir épousé un autre homme. » Le miroir me montre la limite finale du divorce. Trois fois, et la femme devient interdite à son ancien mari. Sauf si elle épouse un autre puis divorce. Cette règle empêche le jeu avec le divorce. Le miroir m'interroge : est-ce que je comprends la gravité des limites divines ?`,
  reflection: `Les limites du divorce empêchent son abus. La loi divine protège la dignité de la femme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in talaqaha fa-la tahillu lahu min ba'du hatta tankiha zawjan ghayruhu » — elle ne lui sera plus permise qu'après avoir épousé un autre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la gravité des limites divines ? Est-ce que je respecte la loi dans mes relations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Jouer avec le divorce, c'est jouer avec ce que Dieu a protégé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les limites dans la nature protègent l'équilibre. Les limites dans les relations protègent la dignité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites divines trouve la baraka dans ses relations." }
  ],
  munajat: `Ya Hakim, Tu as posé des limites pour protéger. Aide-moi à les comprendre et les respecter. Ne me laisse pas jouer avec ce qui est sacré.`
};

MIROIR["2:231"] = {
  reference: "2:231",
  theme: ["divorce", "révélation", "mémoire"],
  emotion: "Responsabilité, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Quand vous divorcez des femmes et qu'elles atteignent leur terme, gardez-les convenablement ou libérez-les convenablement. Ne les retenez pas par force pour leur nuire. » Le miroir me montre la dignité dans la séparation. Garder ou libérer, mais convenablement. Pas de force, pas de nuisance. La relation se termine avec le même respect qu'elle a commencé. Le miroir m'interroge : comment je termine mes relations ? Avec dignité ou avec nuisance ?`,
  reflection: `La séparation doit être digne. Pas de force, pas de nuisance. Le respect doit durer jusqu'à la fin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amsikuhunna bi-ma'rufin aw sarrihuhunna bi-ma'ruf » — gardez-les convenablement ou libérez-les convenablement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je termine mes relations ? Avec dignité ou avec nuisance ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La fin indigne détruit tout le bien du début. La fin digne préserve tout le passé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se couche dignement. Les feuilles tombent paisiblement. La fin fait partie du cycle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui termine avec dignité ouvre la porte à de nouveaux départs bénis." }
  ],
  munajat: `Ya Nur, illumine mes fins comme mes débuts. Aide-moi à quitter avec dignité ceux que Tu m'as donné de connaître.`
};

MIROIR["2:232"] = {
  reference: "2:232",
  theme: ["mariage", "liberté", "obstacle"],
  emotion: "Justice, respect",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Muqsit"],
  mirrorVersion: `« Quand vous divorcez des femmes et qu'elles atteignent leur terme, ne les empêchez pas d'épouser leurs anciens maris s'ils se mettent d'accord convenablement. » Le miroir me montre la liberté de choix. Après le délai, la femme est libre. Les tuteurs ne doivent pas empêcher un remariage convenable. La liberté de choix est protégée par la loi divine. Le miroir m'interroge : est-ce que je respecte la liberté de choix des autres ?`,
  reflection: `La liberté de choix dans le mariage est protégée. Personne ne doit empêcher une union convenable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la ta'diluhunna an yankihna azwijahunna » — ne les empêchez pas d'épouser leurs anciens maris." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la liberté de choix des autres ? Est-ce que j'empêche des unions par orgueil ou intérêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Empêcher un mariage convenable est une injustice. Faciliter un mariage convenable est une bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les fleurs s'ouvrent librement. Les oiseaux choisissent leur compagnon. La liberté est naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui facilite les unions recevra la facilité dans sa propre vie." }
  ],
  munajat: `Ya 'Adl, Tu protèges la liberté de choix. Ne me laisse pas être un obstacle. Fais que je facilite les unions convenables.`
};

MIROIR["2:233"] = {
  reference: "2:233",
  theme: ["allaitement", "responsabilité", "droits"],
  emotion: "Tendresse, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Les mères allaiteront leurs enfants deux années complètes. Et sur le père de l'enfant revient la nourriture et les vêtements des mères. » Le miroir me montre l'organisation de la famille. La mère allaite, le père fournit. Chacun sa responsabilité, chacun son droit. L'équilibre familial repose sur cette répartition. Le miroir m'interroge : est-ce que j'assume ma responsabilité dans ma famille ?`,
  reflection: `La famille est organisée. Mère et père ont des responsabilités complémentaires. Les droits de chacun sont protégés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-walidatu yurdi'na awladahunna hawlayni kamilayn » — les mères allaiteront leurs enfants deux années complètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'assume ma responsabilité dans ma famille ? Est-ce que je respecte les droits des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Négliger sa responsabilité, c'est briser l'équilibre. L'assumer, c'est construire la famille." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature fournit à chaque créature selon ses besoins. La famille doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité reçoit la baraka dans sa famille." }
  ],
  munajat: `Ya Razzaq, Tu pourvois aux besoins de tous. Aide-moi à assumer ma responsabilité. Fais que ma famille soit équilibrée.`
};

MIROIR["2:234"] = {
  reference: "2:234",
  theme: ["deuil", "délai", "dignité"],
  emotion: "Respect, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Hayy"],
  mirrorVersion: `« Ceux parmi vous qui meurent en laissant des femmes, celles-ci observeront un délai de quatre mois et dix jours. » Le miroir me montre l'organisation du deuil. Le délai est précis : quatre mois et dix jours. Le temps de la transition, le temps du respect pour le défunt. Le miroir m'interroge : comment je gère les transitions de ma vie ? Avec patience ou avec précipitation ?`,
  reflection: `Le deuil a son temps. Quatre mois et dix jours pour la transition. Le respect du défunt guide la période.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatarabbasna bi-anfusihinna arba'ata ash-hurin wa 'ashran » — elles observeront un délai de quatre mois et dix jours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère les transitions de ma vie ? Avec patience ou avec précipitation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La précipitation dans le deuil manque de respect. La patience honore le passé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'hiver précède le printemps. Le deuil précède la renaissance. Chaque temps a son rôle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le temps du deuil ouvre la porte à une renaissance bénie." }
  ],
  munajat: `Ya Hayy, Ya Mumit, Tu donnes la vie et la reprends. Aide-moi à respecter les temps de transition. Donne la patience dans les épreuves.`
};

MIROIR["2:235"] = {
  reference: "2:235",
  theme: ["mariage", "intention", "discrétion"],
  emotion: "Espoir, pudeur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Khabeer"],
  mirrorVersion: `« Il n'y a pas de péché pour vous à faire allusion à une demande en mariage. » Le miroir me montre la permission de l'intention. Le délai n'empêche pas l'intention. On peut faire allusion, sans promesse formelle. La discrétion protège les deux parties. Le miroir m'interroge : comment j'exprime mes intentions ? Avec discrétion ou avec précipitation ?`,
  reflection: `L'intention peut être exprimée avec discrétion. Pas de promesse formelle pendant le délai, mais l'allusion est permise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la junaha 'alaykum fi ma 'arradtum bihi min khitbati an-nisa' » — il n'y a pas de péché à faire allusion à une demande en mariage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'exprime mes intentions ? Avec discrétion ou avec précipitation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse prématurée peut briser. L'allusion discrète préserve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les graines sont plantées en secret. Les intentions aussi mûrissent dans la discrétion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui exprime ses intentions avec sagesse prépare un avenir harmonieux." }
  ],
  munajat: `Ya Basir, Tu vois mes intentions. Aide-moi à les exprimer avec sagesse et discrétion. Préserve mes relations.`
};

MIROIR["2:236"] = {
  reference: "2:236",
  theme: ["mariage", "rupture", "compensation"],
  emotion: "Justice, équité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muqsit", "Al-Ghani"],
  mirrorVersion: `« Il n'y a pas de péché pour vous si vous divorcez des femmes sans les avoir touchées ni fixé leur dot. » Le miroir me montre l'équité même dans la rupture précoce. Pas de rapport, pas de dot fixée — mais quand même une compensation selon les moyens. La justice divine protège même dans les situations simples. Le miroir m'interroge : suis-je équitable même quand je n'y suis pas obligé par la loi ?`,
  reflection: `L'équité s'applique même dans la rupture précoce. Une compensation selon les moyens maintient la justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-mta'uhunna 'ala al-munsi'i qadaruhu wa 'ala al-muqtari qadaruh » — donnez-leur une jouissance selon vos moyens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je équitable même quand je n'y suis pas obligé par la loi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équité minimale est un devoir. L'équité maximale est une excellence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne à chaque créature selon ses besoins. L'homme doit donner selon ses moyens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique l'équité spontanément reçoit la grâce d'Allah." }
  ],
  munajat: `Ya Muqsit, Tu es Équitable. Aide-moi à l'être même quand la loi ne m'y oblige pas. Donne-moi un cœur généreux.`
};

MIROIR["2:237"] = {
  reference: "2:237",
  theme: ["mariage", "rupture", "générosité"],
  emotion: "Justice, noblesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Karim", "Al-'Afuw"],
  mirrorVersion: `« Si vous divorcez avant de les avoir touchées mais après avoir fixé la dot, donnez-leur la moitié de ce que vous avez fixé, sauf si elles y renoncent. » Le miroir me montre la générosité dans la rupture. La moitié de la dot, mais la femme peut renoncer. Ou l'homme peut tout donner par générosité. La loi protège, la noblesse élève. Le miroir m'interroge : est-ce que je me contente du minimum légal ou est-ce que je cherche l'excellence morale ?`,
  reflection: `La loi fixe un minimum. La générosité élève au-dessus. Le choix entre le minimum et l'excellence révèle le caractère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa an ta'fu aqrab li-t-taqwa » — et que vous pardonniez est plus proche de la piété." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me contente du minimum légal ou est-ce que je cherche l'excellence morale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le minimum légal suffit. L'excellence morale transforme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil donne plus que nécessaire. L'homme doit donner au-delà du minimum." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique la générosité au-delà de la loi reçoit plus que ce qu'il a donné." }
  ],
  munajat: `Ya Karim, Tu es Généreux. Aide-moi à dépasser le minimum. Fais que je choisisse l'excellence morale dans mes relations.`
};

MIROIR["2:238"] = {
  reference: "2:238",
  theme: ["prière", "constance", "moyenne"],
  emotion: "Discipline, présence",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mu'min"],
  mirrorVersion: `« Soyez assidus aux prières et à la prière médiane. Tenez-vous devant Allah avec humilité. » Le miroir me montre l'importance de la constance dans la prière. « Assidus » — réguliers, constants. « La prière médiane » — la plus importante. Et la posture : « avec humilité » — khushu'. La prière n'est pas un rite mécanique — c'est une présence devant Dieu. Le miroir m'interroge : suis-je assidu dans ma prière ? Ai-je le khushu' ?`,
  reflection: `La prière demande constance et humilité. La présence du cœur est l'essence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hafizu 'ala as-salawati wa-s-salati al-wusta » — soyez assidus aux prières et à la prière médiane." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je assidu dans ma prière ? Ai-je le khushu' ? Mon cœur est-il présent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Prier sans présence, c'est répéter des mots vides. Prier avec le cœur, c'est rencontrer Dieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève chaque jour à l'heure. La prière aussi doit être constante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec constance et humilité reçoit une lumière qui ne s'éteint pas." }
  ],
  munajat: `Ya Rabb, je veux être assidu dans ma prière. Donne-moi le khushu'. Fais que je me tienne devant Toi avec humilité.`
};

MIROIR["2:239"] = {
  reference: "2:239",
  theme: ["prière", "peur", "flexibilité"],
  emotion: "Confiance, adaptation",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Wali"],
  mirrorVersion: `« Si vous êtes en danger, priez en marchant ou montés. Puis quand vous êtes en sécurité, accomplissez la prière normalement. » Le miroir me montre la flexibilité de la prière. Le danger n'annule pas la prière — il l'adapte. Marcher, être monté — peu importe, mais prier. La sécurité revenue, la forme normale revient. La prière s'adapte aux circonstances, mais ne s'annule jamais. Le miroir m'interroge : est-ce que je prie dans toutes les circonstances ou est-ce que je me fais des excuses ?`,
  reflection: `La prière s'adapte aux circonstances. Le danger l'abrège, la sécurité la complète. Mais elle ne s'annule jamais.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in khiftum fa-rijalan aw rukbanan » — si vous êtes en danger, priez en marchant ou montés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie dans toutes les circonstances ou est-ce que je me fais des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse annule la prière. L'adaptation la préserve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arbre plie dans le vent mais ne casse pas. La prière s'adapte mais ne cesse pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie dans toutes les circonstances reçoit la présence divine dans toutes les situations." }
  ],
  munajat: `Ya Wali, protège-moi dans le danger. Mais même sans protection visible, je prie. Fais que ma prière soit constante, adaptée mais jamais annulée.`
};

MIROIR["2:240"] = {
  reference: "2:240",
  theme: ["testament", "protection", "provision"],
  emotion: "Prévoyance, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Ar-Razzaq"],
  mirrorVersion: `« Ceux d'entre vous qui meurent en laissant des femmes, qu'ils fassent un testament en leur faveur : une année de provision sans les faire sortir. » Le miroir me montre la prévoyance pour les vulnérables. Le mari doit prévoir pour sa femme avant de mourir. Une année de provision, sans expulsion. La protection continue au-delà de la vie. Le miroir m'interroge : est-ce que je prévois pour mes proches après moi ?`,
  reflection: `La prévoyance protège les vulnérables. Le testament assure la provision après la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wasiyyatan li-zawjihim mata'an ila al-hawli » — un testament en leur faveur : une année de provision." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prévois pour mes proches après moi ? Mon testament est-il prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mourir sans prévoyance, c'est laisser les vulnérables sans protection. Mourir avec testament, c'est protéger au-delà de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arbre laisse des graines. Le croyant laisse une provision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prévoit pour les siens après sa mort reçoit la protection d'Allah pour les siens." }
  ],
  munajat: `Ya Hafiz, Tu protèges les vulnérables. Aide-moi à prévoir pour les miens. Ne me laisse pas mourir sans testament.`
};

MIROIR["2:241"] = {
  reference: "2:241",
  theme: ["divorce", "provision", "droits"],
  emotion: "Justice, dignité",
  difficulty: "débutant",
  relatedNames: ["Al-Muqsit", "Al-Ghani"],
  mirrorVersion: `« Et pour les femmes divorcées, une provision convenable est un devoir sur les gens de bien. » Le miroir me montre le devoir de provision pour les divorcées. Le divorce n'est pas une expulsion sans ressources. Une provision convenable est un droit. Les gens de bien respectent ce droit. Le miroir m'interroge : est-ce que je respecte les droits de ceux avec qui je me sépare ?`,
  reflection: `La provision pour les divorcées est un droit. Les gens de bien respectent ce devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-l-mutallaqati mata'un bi-l-ma'ruf » — pour les femmes divorcées, une provision convenable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les droits de ceux avec qui je me sépare ? Suis-je un « homme de bien » ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Séparer sans provision, c'est ajouter l'injustice à la séparation. Provisionner convenablement, c'est préserver la dignité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne laisse pas ses créatures sans ressources. L'homme ne doit pas laisser les siennes sans provision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pourvoit convenablement à ceux qu'il quitte reçoit la provision d'Allah dans sa propre vie." }
  ],
  munajat: `Ya Muqsit, Tu es Juste. Aide-moi à respecter les droits de tous. Ne me laisse pas être avare envers ceux que je quitte.`
};

MIROIR["2:242"] = {
  reference: "2:242",
  theme: ["explication", "loi", "compréhension"],
  emotion: "Clarté, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Bayyin"],
  mirrorVersion: `« C'est ainsi qu'Allah vous explique Ses versets, afin que vous compreniez. » Le miroir me montre le but de la révélation. Les détails ne sont pas des complications — ce sont des explications. Dieu veut que nous comprenions. La loi n'est pas un fardeau — c'est une guidance claire. Le miroir m'interroge : est-ce que je cherche à comprendre les versets ou est-ce que je les subis ?`,
  reflection: `La révélation est une explication pour la compréhension. La loi est une guidance, pas un fardeau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika yubayyinu Allahu lakum ayatihi » — c'est ainsi qu'Allah vous explique Ses versets." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche à comprendre les versets ou est-ce que je les subis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loi sans compréhension est une prison. La loi avec compréhension est une libération." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois de la nature sont explicables. Les lois de Dieu sont explicables aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les versets les applique avec amour, pas avec contrainte." }
  ],
  munajat: `Ya Hakim, Tu expliques Tes versets pour que je comprenne. Ouvre mon intelligence. Fais que je comprenne Ta loi avec amour.`
};

MIROIR["2:243"] = {
  reference: "2:243",
  theme: ["résurrection", "foi", "miracle"],
  emotion: "Émerveillement, foi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« N'as-tu pas vu ceux qui sortirent de leurs demeures par milliers, craignant la mort ? Allah leur dit : Mourez. Puis Il les ressuscita. » Le miroir me montre la leçon de la mort et de la résurrection. Fuir la mort ne la prévient pas. Mais Allah peut ressusciter. La mort n'est pas la fin — c'est un passage. Le miroir m'interroge : comment je vis avec la conscience de la mort ? Est-ce que je crois en la résurrection ?`,
  reflection: `Fuir la mort ne la prévient pas. Mais Allah ressuscite. La mort est un passage, pas une fin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala lahumu Allahu mutu thumma ahyahum » — Allah leur dit : Mourez. Puis Il les ressuscita." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis avec la conscience de la mort ? Est-ce que je crois en la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Craindre la mort sans croire en la résurrection, c'est vivre dans la terreur. Croire en la résurrection, c'est vivre dans l'espoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'hiver tue, le printemps ressuscite. La nature montre le cycle de la mort et de la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mort avec foi en la résurrection la transforme en passage vers la vie éternelle." }
  ],
  munajat: `Ya Muhyi, Tu donnes la vie et la reprends. Je crois en la résurrection. Aide-moi à vivre avec cette conscience et cet espoir.`
};

MIROIR["2:244"] = {
  reference: "2:244",
  theme: ["combat", "vie", "mort"],
  emotion: "Courage, foi",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Qawiyy"],
  mirrorVersion: `« Combattez dans le chemin d'Allah et sachez qu'Allah entend tout et sait tout. » Le miroir me montre l'appel au combat. Le combat dans le chemin d'Allah n'est pas une aventure — c'est un devoir accompagné de la conscience divine. Allah entend et sait — rien n'échappe à Sa connaissance. Le miroir m'interroge : est-ce que je lutte dans le chemin d'Allah avec la conscience qu'Il entend et sait ?`,
  reflection: `Le combat dans le chemin d'Allah est un devoir. Allah entend et sait — la conscience divine accompagne le combat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qatilu fi sabili Allahi wa'lamu anna Allaha Sami'un 'Alim » — combattez dans le chemin d'Allah et sachez qu'Allah entend tout et sait tout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lutte dans le chemin d'Allah ? Avec la conscience qu'Il entend et sait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Combattre sans conscience divine, c'est risquer l'égarement. Combattre avec conscience, c'assurer la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature lutte pour sa survie. Le croyant lutte pour sa vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui combat dans le chemin d'Allah avec conscience reçoit la victoire ici-bas et la récompense dans l'au-delà." }
  ],
  munajat: `Ya 'Aziz, Tu es Fort. Aide-moi à combattre dans Ton chemin avec conscience. Entends ma prière et sais mon intention.`
};

MIROIR["2:245"] = {
  reference: "2:245",
  theme: ["dette", "prêt", "récompense"],
  emotion: "Générosité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wasi'", "Al-Ghani"],
  mirrorVersion: `« Quiconque fait un bon prêt à Allah, Allah le lui multiplie. » Le miroir me montre l'image du prêt à Dieu. Donner à Dieu, c'est Lui prêter. Et la récompense est multipliée. Pas de banque qui offre un tel retour. Le prêt à Dieu est l'investissement le plus sûr. Le miroir m'interroge : qu'est-ce que je « prête » à Dieu ? Mon argent, mon temps, mon effort ?`,
  reflection: `Donner à Dieu est un prêt multiplié. L'investissement spirituel a le meilleur rendement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man dza alladzi yuqridu Allaha qardan hasana » — quiconque fait un bon prêt à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « prête » à Dieu ? Mon argent, mon temps, mon effort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Garder pour soi, c'est perdre l'occasion de multiplier. Donner à Dieu, c'est investir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature rend au centuple ce qu'on lui donne. Dieu rend plus encore." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le prêt à Dieu ne garde rien pour lui-même." }
  ],
  munajat: `Ya Wasi', Tu multiplies le prêt. Je Te prête ce que j'ai. Multiplie-le pour moi. Accepte mon investissement.`
};

MIROIR["2:246"] = {
  reference: "2:246",
  theme: ["prophètes", "rois", "élection"],
  emotion: "Espoir, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malik", "Al-Wali"],
  mirrorVersion: `« N'as-tu pas vu les notables des Enfants d'Israël après Moïse, quand ils dirent à un prophète : Désigne-nous un roi pour que nous combattions dans le chemin d'Allah. » Le miroir me montre la demande d'un guide pour le combat. Le peuple veut un roi pour lutter dans le chemin d'Allah. L'intention est bonne — combattre pour Dieu. Mais la question sera : sont-ils sincères ou est-ce des paroles en l'air ? Le miroir m'interroge : quand je demande une opportunité de servir Allah, suis-je sincère ou est-ce des paroles ?`,
  reflection: `La demande d'un guide pour combattre est noble. Mais la sincérité sera testée par l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ijb'a lana malikan nuqatil fi sabili Allah » — désigne-nous un roi pour que nous combattions dans le chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je demande une opportunité de servir Allah, suis-je sincère ou est-ce des paroles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demander le combat sans être prêt à combattre, c'est se mentir à soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le guerrier qui demande une épée doit être prêt à s'en servir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande sincèrement le combat reçoit la force de combattre." }
  ],
  munajat: `Ya Malik, je veux combattre dans Ton chemin. Mais je connais ma faiblesse. Donne-moi un guide et la force de le suivre.`
};

MIROIR["2:247"] = {
  reference: "2:247",
  theme: ["élection", "jugement", "sagesse"],
  emotion: "Confiance, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Leur prophète leur dit : Allah vous a désigné Talut comme roi. Ils dirent : Comment régnerait-il sur nous alors que nous avons plus de droit à la royauté que lui ? » Le miroir me montre le rejet du choix divin. Allah choisit, mais le peuple conteste. Pourquoi lui ? Nous sommes plus dignes. L'orgueil rejette le choix de Dieu. Le miroir m'interroge : comment je réagis quand Allah choisit quelqu'un d'autre que moi ?`,
  reflection: `Le choix divin peut surprendre. L'orgueil conteste, l'humilité accepte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha astafahu 'alaykum » — Allah vous a désigné Talut comme roi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand Allah choisit quelqu'un d'autre que moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Contester le choix divin, c'est contester la sagesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève où Dieu veut. La direction appartient à Celui qui sait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le choix divin reçoit la bénédiction dans l'acceptation." }
  ],
  munajat: `Ya Hakim, Tu choisis qui Tu veux. Aide-moi à accepter Ton choix sans jalousie. Je fais confiance à Ta sagesse.`
};

MIROIR["2:248"] = {
  reference: "2:248",
  theme: ["signes", " confiance", "alliance"],
  emotion: "Espoir, assurance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amin", "Al-Wali"],
  mirrorVersion: `« Leur prophète leur dit : Le signe de sa royauté est que l'arche reviendra à vous, portée par les anges. » Le miroir me montre le signe de l'élection. L'arche de l'alliance revient, portée par les anges. Un signe miraculeux pour confirmer le choix. Dieu ne laisse pas Son peuple sans preuve. Le miroir m'interroge : est-ce que je demande des signes pour confirmer la guidance ?`,
  reflection: `Dieu donne des signes pour confirmer Sa guidance. L'arche revient comme preuve de l'élection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anna al-tahuta ta'tiyukum fihi sakina » — l'arche reviendra à vous, contenant la sérénité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des signes pour confirmer la guidance ? Ou est-ce que je refuse de voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe donné sans foi est rejeté. Le signe reçu avec foi est accepté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes de Dieu sont partout. Les voir demande un cœur ouvert." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes divins reçoit la guidance continue." }
  ],
  munajat: `Ya Amin, Tu donnes des signes. Ouvre mes yeux pour les voir. Confirme ma foi par Tes preuves.`
};

MIROIR["2:249"] = {
  reference: "2:249",
  theme: ["épreuve", "filtre", "patience"],
  emotion: "Lucidité, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Mumtahan", "Al-Sabur"],
  mirrorVersion: `« Quand Talut partit avec ses troupes, il dit : Allah va vous éprouver par une rivière. Celui qui en boira ne sera pas des miens. » Le miroir me montre l'épreuve comme filtre. Une rivière — simple, accessible. Mais l'interdiction de boire trie les sincères des autres. L'épreuve la plus simple révèle les cœurs. Le miroir m'interroge : comment je réagis aux petites épreuves qui filtrent ma sincérité ?`,
  reflection: `L'épreuve simple filtre les cœurs. Boire ou ne pas boire — un choix qui révèle qui est sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha mubtalikum bi-nahar » — Allah va vous éprouver par une rivière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux petites épreuves qui filtrent ma sincérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve simple échoue là où le grand test réussirait. La facilité révèle la vraie nature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'or est testé par le feu. Les cœurs sont testés par les petites interdictions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui passe la petite épreuve est prêt pour la grande." }
  ],
  munajat: `Ya Mumtahan, Tu m'éprouves pour me révéler à moi-même. Aide-moi à passer les petites épreuves. Prépare-moi pour les grandes.`
};

MIROIR["2:250"] = {
  reference: "2:250",
  theme: ["du'a", "patience", "victoire"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "An-Nasir"],
  mirrorVersion: `« Quand ils affrontèrent Goliath et ses troupes, ils dirent : Seigneur, déverse sur nous la patience, affermis nos pas et donne-nous la victoire sur le peuple mécréant. » Le miroir me montre le du'a dans la bataille. Face à l'ennemi, pas de panique — une prière. Patience, fermeté, victoire. Les trois demandes du combattant croyant. Le miroir m'interroge : quelle est ma première réaction face à l'épreuve — la prière ou la panique ?`,
  reflection: `Face à l'épreuve, la prière précède l'action. Patience, fermeté, victoire — les trois dons demandés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana afrigh 'alayna sabran wa thabbit aqdamana » — Seigneur, déverse sur nous la patience, affermis nos pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma première réaction face à l'épreuve — la prière ou la panique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La panique précède la défaite. La prière précède la victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arbre dans la tempête plie mais ne casse pas s'il a des racines profondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie dans la bataille reçoit plus que la victoire — il reçoit la présence divine." }
  ],
  munajat: `Ya Sabur, Ya Nasir, déverse sur moi la patience. Affermis mes pas. Donne-moi la victoire sur mes propres démons.`
};

MIROIR["2:251"] = {
  reference: "2:251",
  theme: ["victoire", "sagesse", "mission"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Hakim"],
  mirrorVersion: `« Ils les mirent en déroute avec la permission d'Allah. Et Dawud tua Goliath. Et Allah lui donna la royauté et la sagesse. » Le miroir me montre la victoire accordée par Dieu. La permission d'Allah précède la victoire. Dawud reçoit royaume et sagesse — le pouvoir et la capacité de l'exercer. Le miroir m'interroge : est-ce que je remercie Allah pour les victoires qu'Il m'accorde ?`,
  reflection: `La victoire vient avec la permission d'Allah. Le pouvoir et la sagesse sont des dons divins.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-hazamuhum bi-idhni Allahi wa qatala Dawudu Jaluta » — ils les mirent en déroute avec la permission d'Allah. Et Dawud tua Goliath." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie Allah pour les victoires qu'Il m'accorde ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Attribuer la victoire à soi-même, c'est oublier la Source. L'attribuer à Dieu, c'est la reconnaître." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève par la permission de Dieu. La victoire aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la Source de sa victoire reçoit la sagesse pour la gérer." }
  ],
  munajat: `Ya Nasir, la victoire vient de Toi. Je Te remercie. Donne-moi la sagesse de gérer ce que Tu m'accordes.`
};

MIROIR["2:252"] = {
  reference: "2:252",
  theme: ["signes", "foi", "révélation"],
  emotion: "Reconnaissance, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« Ce sont là les versets d'Allah que Nous te récitons en toute vérité. Tu es certes du nombre des envoyés. » Le miroir me montre la confirmation du message. Les versets sont récités en vérité. Le Prophète est confirmé comme envoyé. La révélation n'est pas une invention — c'est une vérité descendue. Le miroir m'interroge : est-ce que je reçois le Coran comme une vérité descendue ou comme un texte ordinaire ?`,
  reflection: `Les versets sont récités en vérité. Le Prophète est envoyé. La révélation est authentique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu Allahi natluha 'alayka bi-l-haqq » — ce sont là les versets d'Allah que Nous te récitons en toute vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois le Coran comme une vérité descendue ou comme un texte ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Lire le Coran comme ordinaire, c'est manquer l'essentiel. Le lire comme vérité descendue, c'est recevoir la lumière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière du soleil est réelle. La lumière du Coran est réelle aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran comme vérité descendue est transformé par chaque verset." }
  ],
  munajat: `Ya Haqq, Tu as révélé la vérité. Je la reçois comme telle. Transforme-moi par Ta parole.`
};

MIROIR["2:253"] = {
  reference: "2:253",
  theme: ["prophètes", "rangs", "miracles"],
  emotion: "Respect, distinction",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fadil", "Al-Mujiz"],
  mirrorVersion: `« Parmi ces messagers, Nous en avons favorisé certains par rapport à d'autres. Il en est à qui Allah a parlé, et Il en a élevé d'autres en rang. » Le miroir me montre la hiérarchie des prophètes. Pas tous égaux dans le rang, mais tous envoyés. Certains ont parlé avec Dieu, d'autres ont reçu des miracles. La distinction divine n'est pas une injustice — c'est une sagesse. Le miroir m'interroge : est-ce que j'accepte les distinctions divines ou est-ce que je les conteste ?`,
  reflection: `Les prophètes ont des rangs différents. Dieu distingue selon Sa sagesse. L'égalité n'est pas l'uniformité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilkha ar-rusulu faddalna ba'dahum 'ala ba'd » — parmi ces messagers, Nous en avons favorisé certains par rapport à d'autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les distinctions divines ou est-ce que je les conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Contester les distinctions, c'est contester la sagesse divine. Les accepter, c'est reconnaître Sa science." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les étoiles n'ont pas toutes la même luminosité. Les prophètes n'ont pas tous le même rang." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la hiérarchie divine trouve sa place dans l'ordre céleste." }
  ],
  munajat: `Ya Fadil, Tu distingues qui Tu veux. J'accepte Ton ordre. Donne-moi la place que Tu m'as destinée.`
};

MIROIR["2:254"] = {
  reference: "2:254",
  theme: ["dépense", "jour", "compte"],
  emotion: "Urgence, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Ad-Dayyan"],
  mirrorVersion: `« Ô vous qui croyez ! Dépensez de ce que Nous vous avons attribué avant que ne vienne un jour sans transaction, ni amitié, ni intercession. » Le miroir me montre l'urgence de la dépense. Ce monde est le temps du don. L'au-delà est le temps du compte. Il n'y aura pas de transaction, pas d'ami pour sauver, pas d'intercession sans permission. Le miroir m'interroge : est-ce que je dépense maintenant ou est-ce que j'attends un jour où ce sera trop tard ?`,
  reflection: `Ce monde est le temps du don. L'au-delà est le temps du compte. Dépenser maintenant, c'est investir pour le Jour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min qabli an ya'tiya yawmun la bay'un fihi wa la khullatun » — avant que ne vienne un jour sans transaction, ni amitié." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense maintenant ? Ou est-ce que j'attends un jour où ce sera trop tard ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Attendre le Jour pour dépenser, c'est attendre que la banque soit fermée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps file. L'occasion passe. Le don maintenant vaut plus que le regret plus tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépense maintenant prépare son compte pour le Jour." }
  ],
  munajat: `Ya Rabb, je veux dépenser maintenant. Ne me laisse pas attendre le Jour où ce sera trop tard. Accepte mon don aujourd'hui.`
};

MIROIR["2:256"] = {
  reference: "2:256",
  theme: ["contrainte", "foi", "liberté"],
  emotion: "Liberté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Nulle contrainte en religion ! La bonne direction s'est distinguée de l'égarement. » Le miroir me montre le principe de la liberté de conscience. La foi ne peut être forcée. La vérité se distingue de l'erreur par elle-même. On peut contraindre le corps, pas le cœur. La foi sincère est libre ou elle n'est pas. Le miroir m'interroge : ma foi est-elle libre ou contrainte ?`,
  reflection: `La foi ne peut être forcée. La vérité se distingue par elle-même. La liberté est la condition de la foi sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ikraha fi ad-din » — nulle contrainte en religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle libre ou contrainte ? Est-ce que je crois par choix ou par tradition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Contraindre à la foi, c'est produire de l'hypocrisie. La foi libre seule est vraie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière ne force personne à voir. Elle est là pour ceux qui ouvrent les yeux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit librement possède une foi indestructible." }
  ],
  munajat: `Ya Hadi, Tu as distingué la vérité de l'erreur. Je choisis librement. Ma foi est mienne. Accepte mon choix libre.`
};

MIROIR["2:257"] = {
  reference: "2:257",
  theme: ["amis", "lumière", "ténèbres"],
  emotion: "Sécurité, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "An-Nur"],
  mirrorVersion: `« Allah est le Protecteur de ceux qui croient. Il les fait sortir des ténèbres vers la lumière. Et ceux qui mécroient, leurs protecteurs sont les idoles qui les font sortir de la lumière vers les ténèbres. » Le miroir me montre les deux directions. Les croyants vont des ténèbres vers la lumière. Les mécréants vont de la lumière vers les ténèbres. Le protecteur détermine la direction. Qui est mon protecteur ? Le miroir m'interroge : vers quoi je vais ? Vers la lumière ou les ténèbres ?`,
  reflection: `Le protecteur détermine la direction. Allah mène à la lumière. Les idoles mènent aux ténèbres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yukhrijuhum mina az-zulumati ila an-nur » — Il les fait sortir des ténèbres vers la lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon protecteur ? Vers quoi je vais ? Vers la lumière ou les ténèbres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière n'est pas un lieu — c'est une direction. Les ténèbres aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève et se couche. L'âme aussi a ses levers et ses couchers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah comme protecteur ne craint pas les ténèbres — il sait qu'il en sortira." }
  ],
  munajat: `Ya Waliyy, Tu es mon Protecteur. Fais-moi sortir des ténèbres vers la lumière. Ne me laisse pas retourner vers l'obscurité.`
};

MIROIR["2:258"] = {
  reference: "2:258",
  theme: ["débat", "vie", "mort"],
  emotion: "Émerveillement, foi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« N'as-tu pas vu celui qui disputait avec Ibrahim au sujet de son Seigneur ? Ibrahim dit : Mon Seigneur donne la vie et la mort. Il dit : Moi aussi je donne la vie et la mort. » Le miroir me montre l'aveuglement du pouvoir. Le roi prétend pouvoir donner vie et mort — épargner ou tuer. Mais Ibrahim le confond : Allah fait lever le soleil de l'est, fais-le lever de l'ouest. Le mécréant reste confondu. Le miroir m'interroge : est-ce que je comprends la différence entre le pouvoir apparent et le pouvoir réel ?`,
  reflection: `Le pouvoir humain est limité à épargner ou tuer. Le pouvoir divin crée la vie elle-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-llahu ya'ti bi-sh-shamsi mina-l-mashriqi fa-'ti biha mina-l-maghrib » — Allah fait lever le soleil de l'est, fais-le lever de l'ouest." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la différence entre le pouvoir apparent et le pouvoir réel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Confondre son pouvoir limité avec le pouvoir divin, c'est l'erreur fatale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève chaque jour par la permission divine. Nul ne peut le faire lever ailleurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la Source de tout pouvoir reçoit la vraie autorité." }
  ],
  munajat: `Ya Muhyi, Tu donnes la vie et la mort. Je reconnais Ton pouvoir. Ne me laisse pas illusionner par les pouvoirs apparents.`
};

MIROIR["2:259"] = {
  reference: "2:259",
  theme: ["résurrection", "temps", "foi"],
  emotion: "Émerveillement, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ba'ith", "Al-Qadir"],
  mirrorVersion: `« Ou comme celui qui passait près d'une cité en ruines et dit : Comment Allah va-t-Il ressusciter cela après sa mort ? » Le miroir me montre le doute suivi de la démonstration. L'homme doute de la résurrection — comment ? Allah le fait mourir cent ans, puis le ressuscite. La cité est reconstruite, la nourriture intacte. Le doute devient certitude par l'expérience. Le miroir m'interroge : est-ce que je doute de la résurrection ? Comment ma foi serait-elle renforcée ?`,
  reflection: `Le doute sur la résurrection est naturel. La démonstration divine transforme le doute en certitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa yuhyi hadhihi Allahu ba'da mawtiha » — comment Allah va-t-Il ressusciter cela après sa mort ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute de la résurrection ? Comment ma foi serait-elle renforcée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Douter de la résurrection, c'est douter du Créateur. Croire en la résurrection, c'est croire en Sa puissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ressuscite chaque printemps. La vie revient après la mort apparente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la résurrection dans la nature croit en la résurrection du corps." }
  ],
  munajat: `Ya Ba'ith, Tu ressuscites les morts. Je crois en la résurrection. Fortifie ma foi par Tes signes.`
};

MIROIR["2:260"] = {
  reference: "2:260",
  theme: ["foi", "preuve", "certitude"],
  emotion: "Humilité, recherche",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhyi", "Al-Haqq"],
  mirrorVersion: `« Quand Ibrahim dit : Seigneur, montre-moi comment Tu ressuscites les morts. Allah dit : Ne crois-tu pas ? Il dit : Si, mais pour que mon cœur soit rassuré. » Le miroir me montre la demande de certitude. Ibrahim croit, mais veut la tranquillité du cœur. La foi peut coexister avec le désir de preuve. Allah lui montre comment faire — les oiseaux, le mont, l'appel. Le miroir m'interroge : mon cœur a-t-il besoin d'être rassuré ? Comment je cherche la certitude ?`,
  reflection: `La foi peut chercher la certitude. Le cœur tranquille est le but de la demande de preuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi arini kayfa tuhyi al-mawta » — Seigneur, montre-moi comment Tu ressuscites les morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur a-t-il besoin d'être rassuré ? Comment je cherche la certitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Demander une preuve sans foi est un défi. La demander avec foi est une quête." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont là pour qui les cherche. Le cœur tranquille trouve la preuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la certitude avec foi la trouve au-delà de ses attentes." }
  ],
  munajat: `Ya Muhyi, je crois, mais mon cœur cherche la tranquillité. Montre-moi Tes signes. Rassure mon âme.`
};

MIROIR["2:261"] = {
  reference: "2:261",
  theme: ["charité", "multiplication", "graine"],
  emotion: "Espoir, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Muthi'", "Al-Karim"],
  mirrorVersion: `« L'exemple de ceux qui dépensent leurs biens dans le chemin d'Allah est comme un grain qui a produit sept épis, chaque épi contenant cent grains. » Le miroir me montre la multiplication divine. Un grain, sept épis, cent grains par épi — sept cents fois plus. La mathématique divine dépasse la mathématique humaine. Dieu multiplie sans limite pour qui donne sincèrement. Le miroir m'interroge : est-ce que je crois à cette multiplication ?`,
  reflection: `La multiplication divine dépasse le calcul. Un grain donne sept cents grains. Le don est multiplié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kamathali habbatin anbatat sab'a sanabila » — comme un grain qui a produit sept épis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois à cette multiplication ? Mon don est-il fait avec cette espérance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui ne croit pas à la multiplication ne donne pas. Celui qui croit donne abondamment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature multiplie. Une graine devient une forêt. Un don devient une bénédiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la multiplication donne sans compter, sachant qu'il recevra sans mesure." }
  ],
  munajat: `Ya Karim, Tu multiplies le don. Je donne avec espérance. Multiplie ce que je donne. Accepte ma graine.`
};

MIROIR["2:262"] = {
  reference: "2:262",
  theme: ["charité", "récompense", "sincérité"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Ghani"],
  mirrorVersion: `« Ceux qui dépensent leurs biens dans le chemin d'Allah sans faire suivre leur don ni de tort ni de nuisance, ils ont leur récompense auprès de leur Seigneur. » Le miroir me montre la condition du don. Donner, oui. Mais sans tort ni nuisance après. Le don pur n'a pas de chaîne attachée. La récompense est garantie pour le don sincère. Le miroir m'interroge : est-ce que mon don est suivi de tort ? De nuisance ? De rappel ?`,
  reflection: `Le don pur n'a pas de chaîne. Pas de tort, pas de nuisance, pas de rappel. La récompense est pour le don sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yutbi'una ma anfaqau minnan wa la adza » — sans faire suivre leur don ni de tort ni de nuisance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon don est suivi de tort ? De nuisance ? De rappel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don avec chaîne n'est pas un don — c'est un échange. Le don sans chaîne est un don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pluie tombe sans demander de remerciement. L'arbre donne son ombre sans rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sans chaîne reçoit une récompense sans fin." }
  ],
  munajat: `Ya Shakur, Tu récompenses le don sincère. Purifie mon don. Ne me laisse pas attacher de chaîne à ce que je donne.`
};

MIROIR["2:263"] = {
  reference: "2:263",
  theme: ["parole", "pardon", "charité"],
  emotion: "Sagesse, douceur",
  difficulty: "débutant",
  relatedNames: ["Al-Latif", "Al-Ghaffur"],
  mirrorVersion: `« Une parole gentille et un pardon valent mieux qu'une charité suivie d'un tort. » Le miroir me montre la qualité du don. Donner avec tort, c'est gâcher le don. Une parole gentille, un pardon — parfois cela vaut plus que l'argent. La charité n'est pas seulement matérielle. Le cœur compte plus que le montant. Le miroir m'interroge : comment je donne ? Avec douceur ou avec reproche ?`,
  reflection: `La qualité du don compte plus que la quantité. Une parole douce vaut plus qu'un don amer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qawlun ma'rufun wa maghfiratun khayrun min sadaqatin yatba'uha adza » — une parole gentille et un pardon valent mieux qu'une charité suivie d'un tort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je donne ? Avec douceur ou avec reproche ? Mon don est-il accompagné de tort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner avec reproche, c'est donner d'une main et reprendre de l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil donne sa lumière sans reproche. L'arbre donne son ombre sans condition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne avec un cœur pur donne plus que son argent — il donne son âme." }
  ],
  munajat: `Ya Latif, Tu es doux. Apprends-moi à donner avec douceur. Ne me laisse pas gâcher mon don par un tort.`
};

MIROIR["2:264"] = {
  reference: "2:264",
  theme: ["charité", "hypocrisie", "vanité"],
  emotion: "Mise en garde, sincérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Khabeer"],
  mirrorVersion: `« Ô vous qui croyez ! N'annulez pas vos charités par le rappel ou le tort, comme celui qui dépense par ostentation. » Le miroir me montre le danger de l'annulation. Donner, puis rappeler — le don s'annule. Donner, puis blesser — le don s'annule. L'ostentation vide le don de sa substance. Le miroir m'interroge : est-ce que je donne pour Allah ou pour être vu ? Est-ce que je rappelle ce que j'ai donné ?`,
  reflection: `Le rappel ou le tort annule le don. L'ostentation le vide. Le don pour Allah seul est accepté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ka-lladhi yunfiqu malahu ri'a'a an-nas » — comme celui qui dépense par ostentation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne pour Allah ou pour être vu ? Est-ce que je rappelle ce que j'ai donné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner pour être vu, c'est ne pas donner pour Allah. Le don a une seule direction : Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre reçoit la pluie sans la rappeler. Le croyant reçoit le don sans l'annoncer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne pour Allah seul reçoit plus que ce qu'il a donné — sans rappel possible." }
  ],
  munajat: `Ya Basir, Tu vois mon intention. Purifie-la. Ne me laisse pas donner par ostentation ou rappeler mon don.`
};

MIROIR["2:265"] = {
  reference: "2:265",
  theme: ["charité", "intention", "jardin"],
  emotion: "Beauté, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Ar-Razzaq"],
  mirrorVersion: `« L'exemple de ceux qui dépensent leurs biens en recherchant l'agrément d'Allah et en affermissant leurs âmes est comme un jardin sur une colline. » Le miroir me montre la beauté du don sincère. Un jardin sur une colline — visible, fertile, béni. La pluie le double, sans pluie la rosée suffit. Le don sincère est toujours béni. Le miroir m'interroge : mon don est-il comme ce jardin ? Visible pour Allah, fertile en récompense ?`,
  reflection: `Le don sincère est comme un jardin béni. La récompense vient, avec ou sans pluie visible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kamathali jannatin bi-rabwatin » — comme un jardin sur une colline." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon don est-il comme ce jardin ? Visible pour Allah, fertile en récompense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jardin caché porte des fruits comme le jardin visible. L'intention compte plus que l'exposition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature produit selon sa capacité. Le croyant donne selon sa capacité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cultive son jardin intérieur par le don voit les fruits pousser dans l'invisible." }
  ],
  munajat: `Ya Karim, je veux que mon don soit comme un jardin béni. Arrose-le de Ta grâce. Fais-le fructifier.`
};

MIROIR["2:266"] = {
  reference: "2:266",
  theme: ["perte", "regret", "vieillesse"],
  emotion: "Effroi, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« L'un de vous aimerait-il avoir un jardin de dattiers et de vignes, traversé par des rivières, et voir la vieillesse le surprendre avec des enfants faibles, et qu'un tourbillon de feu le détruise ? » Le miroir me montre l'horreur de la perte. Un jardin parfait, puis le feu qui le consume. La vieillesse arrive, les enfants sont faibles, et tout disparaît. Le don ostentatoire ou suivi de tort finit comme ce jardin — en cendres. Le miroir m'interroge : est-ce que je construis sur du solide ou sur du sable ?`,
  reflection: `Le don annulé finit en cendres. Construire sur l'ostentation, c'est construire sur le sable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yusibuhu al-kibar wa lahu dhurriyyatu du'afa' » — et voir la vieillesse le surprendre avec des enfants faibles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je construis sur du solide ou sur du sable ? Mon don sera-t-il annulé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jardin perdu est plus douloureux que le jardin jamais possédé. Le don annulé est pire que le don non fait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'incendie détruit en un instant ce qui a pris des années à pousser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège son don de l'ostentation et du tort protège son jardin du feu." }
  ],
  munajat: `Ya Hafiz, protège mon don. Ne me laisse pas le perdre par ostentation ou tort. Préserve mon jardin.`
};

MIROIR["2:267"] = {
  reference: "2:267",
  theme: ["charité", "qualité", "sincérité"],
  emotion: "Générosité, excellence",
  difficulty: "débutant",
  relatedNames: ["Al-Tayyib", "Al-Ghani"],
  mirrorVersion: `« Ô vous qui croyez ! Dépensez des bonnes choses que vous avez gagnées. » Le miroir me montre la qualité du don. Donner de ce qu'on a de meilleur, pas de ce qu'on veut jeter. Dieu est Bon, Il n'accepte que le bon. Le don de qualité reflète la qualité de la foi. Le miroir m'interroge : est-ce que je donne de mon meilleur ou de mes restes ?`,
  reflection: `Dieu est Bon, Il n'accepte que le bon. Donner de son meilleur reflète la qualité de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anfiqou min tayyibati ma kasabtum » — dépensez des bonnes choses que vous avez gagnées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne de mon meilleur ou de mes restes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner ce qu'on rejette, c'est ne pas donner. Donner ce qu'on aime, c'est donner vraiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arbre donne ses meilleurs fruits. Le croyant donne ses meilleures choses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne de son meilleur reçoit le meilleur de Dieu." }
  ],
  munajat: `Ya Tayyib, Tu es Bon. Aide-moi à donner de mon meilleur. Ne me laisse pas donner ce que je rejetterais.`
};

MIROIR["2:268"] = {
  reference: "2:268",
  theme: ["satan", "pauvreté", "promesse"],
  emotion: "Vigilance, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Wasi'"],
  mirrorVersion: `« Satan vous menace de pauvreté et vous ordonne l'avarice. Allah vous promet Son pardon et Sa grâce. » Le miroir me montre les deux voix. Satan dit : si tu donnes, tu seras pauvre. Allah dit : donne, et tu seras pardonné et comblé. Les deux promesses s'opposent. Le miroir m'interroge : à quelle voix je crois ? À la peur ou à la promesse ?`,
  reflection: `Satan promet la pauvreté, Allah promet la grâce. Le choix de croire détermine le don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ash-shaytanu ya'idukumu al-faqr » — Satan vous menace de pauvreté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quelle voix je crois ? À la peur ou à la promesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Croire à la pauvreté, c'est croire Satan. Croire à la grâce, c'est croire Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La rivière coule sans craindre de manquer d'eau. Le croyant donne sans craindre de manquer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la promesse d'Allah donne sans peur et reçoit sans mesure." }
  ],
  munajat: `Ya Wasi', je crois à Ta promesse. Ne me laisse pas écouter Satan. Sa grâce est plus grande que ma peur.`
};

MIROIR["2:269"] = {
  reference: "2:269",
  theme: ["sagesse", "don", "bonheur"],
  emotion: "Gratitude, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Allah donne la sagesse à qui Il veut. Et celui à qui la sagesse est donnée a reçu un bien immense. » Le miroir me montre le don suprême. La sagesse — al-hikmah. Plus précieuse que l'or, elle guide le don, la parole, la vie. Le sage donne bien, parle bien, vit bien. Le miroir m'interroge : est-ce que je demande la sagesse ? Est-ce que je la mets en pratique ?`,
  reflection: `La sagesse est le don suprême. Elle guide tout le reste. Le sage reçoit un bien immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yu'ta al-hikmata fa-qad utiya khayran kathiran » — celui à qui la sagesse est donnée a reçu un bien immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la sagesse ? Est-ce que je la mets en pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intelligence sans sagesse est dangereuse. La richesse sans sagesse est éphémère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lois de la nature sont sages. L'homme sage aligne sa vie sur ces lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la sagesse reçoit la clé de tous les biens." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse. C'est le plus grand don. Guide-moi par elle dans tout ce que je fais.`
};

MIROIR["2:270"] = {
  reference: "2:270",
  theme: ["dépense", "connaissance", "rétribution"],
  emotion: "Confiance, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Muhit"],
  mirrorVersion: `« Tout ce que vous dépensez ou promettez comme vœu, Allah le sait. » Le miroir me montre l'enregistrement divin. Chaque dépense, chaque promesse — Dieu sait. Rien n'est perdu, rien n'est oublié. Les injustes n'ont pas de protecteur. Le miroir m'interroge : est-ce que je dépense en sachant que Dieu enregistre ?`,
  reflection: `Dieu sait tout ce qu'on dépense et promet. Rien n'est perdu dans le registre divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma anfaqtum min nafaqatin aw nadhartum min nadhrin fa-ina Allaha ya'lamuh » — tout ce que vous dépensez ou promettez, Allah le sait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense en sachant que Dieu enregistre ? Mon registre est-il bon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli humain ne peut effacer l'enregistrement divin. Chaque don est écrit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne perd rien. Dieu non plus ne perd rien de ce qu'on donne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que Dieu enregistre donne avec joie, sachant que rien n'est perdu." }
  ],
  munajat: `Ya 'Alim, Tu sais tout ce que je donne. Enregistre-le pour moi. Ne me laisse pas être parmi les injustes.`
};

MIROIR["2:271"] = {
  reference: "2:271",
  theme: ["charité", "secret", "public"],
  emotion: "Sagesse, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Khabeer", "Al-Basir"],
  mirrorVersion: `« Si vous manifestez vos charités, c'est bien. Mais si vous les cachez et les donnez aux pauvres, c'est mieux pour vous. » Le miroir me montre la hiérarchie du don. Public — bien. Secret — mieux. Le secret protège de l'ostentation et préserve la dignité du receveur. Le miroir m'interroge : est-ce que je préfère le don secret ou le don public ?`,
  reflection: `Le don public est bon, le don secret est meilleur. Le secret protège des deux côtés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tubdu as-sadaqati fa-ni'ma hiya wa in tukhfuuha wa tu'tuha al-fuqara'i fa-huwa khayrun lakum » — si vous les manifestez, c'est bien. Si vous les cachez aux pauvres, c'est mieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préfère le don secret ou le don public ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don public pour être vu annule le don. Le don public pour encourager l'est bon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les racines sont cachées, les fruits sont visibles. Le don secret produit des fruits visibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne en secret reçoit une récompense que seul Dieu connaît." }
  ],
  munajat: `Ya Khabeer, Tu vois le secret comme le public. Aide-moi à préférer le secret. Protège-moi de l'ostentation.`
};

MIROIR["2:272"] = {
  reference: "2:272",
  theme: ["guidance", "responsabilité", "dépense"],
  emotion: "Clarté, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Ar-Rahman"],
  mirrorVersion: `« Ce n'est pas à toi de les guider, mais Allah guide qui Il veut. Tout ce que vous dépensez de bon sera pour vous-mêmes. » Le miroir me montre la limite de ma responsabilité. Je ne peux pas forcer la guidance. Je dépense pour moi — pour ma récompense. Le destin des autres appartient à Dieu. Le miroir m'interroge : est-ce que j'accepte que je ne peux pas forcer la guidance des autres ?`,
  reflection: `La guidance appartient à Dieu. Le don est pour ma propre récompense, pas pour contrôler les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laysa 'alayka hudahum » — ce n'est pas à toi de les guider." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que je ne peux pas forcer la guidance des autres ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Donner pour changer les autres, c'est manipuler. Donner pour sa récompense, c'est sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil brille pour tous. La guidance vient à qui Dieu veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa limite trouve la paix dans son rôle." }
  ],
  munajat: `Ya Hadi, la guidance m'appartient pas. J'accepte ma limite. Je dépense pour Toi. Tu guides qui Tu veux.`
};

MIROIR["2:273"] = {
  reference: "2:273",
  theme: ["bénéficiaires", "discrétion", "dignité"],
  emotion: "Compassion, respect",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Basir"],
  mirrorVersion: `« Pour les pauvres qui se sont engagés dans le chemin d'Allah et qui ne peuvent parcourir la terre. L'ignorant les croit riches à cause de leur retenue. » Le miroir me montre les pauvres dignes. Ceux qui ne demandent pas, qui cachent leur besoin, qui sont engagés dans le chemin d'Allah. Leur dignité cache leur pauvreté. Dieu les connaît. Le miroir m'interroge : est-ce que je sais reconnaître ceux qui ont vraiment besoin ?`,
  reflection: `Les vrais pauvres ne demandent pas. Leur dignité cache leur besoin. Dieu les connaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lil-fuqara'i alladhina uhsiru fi sabili Allah » — pour les pauvres qui se sont engagés dans le chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sais reconnaître ceux qui ont vraiment besoin ? Ceux qui ne demandent pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ceux qui demandent fort ne sont pas toujours les plus dans le besoin. Ceux qui se taisent le sont souvent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre cache ses trésors. Les pauvres cachent leur besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait donner à ceux qui ne demandent pas reçoit la plus haute récompense." }
  ],
  munajat: `Ya Basir, Tu connais ceux qui sont vraiment dans le besoin. Ouvre mes yeux. Aide-moi à donner à ceux qui ne demandent pas.`
};

MIROIR["2:274"] = {
  reference: "2:274",
  theme: ["dépense", "récompense", "constance"],
  emotion: "Espérance, persévérance",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Karim"],
  mirrorVersion: `« Ceux qui dépensent leurs biens, nuit et jour, secrètement et ouvertement, ils ont leur récompense auprès de leur Seigneur. » Le miroir me montre la constance dans le don. Nuit et jour — tout le temps. Secrètement et ouvertement — toutes les manières. Le don n'est pas occasionnel, il est constant. La récompense est assurée auprès de Dieu. Le miroir m'interroge : est-ce que je donne constamment ou occasionnellement ?`,
  reflection: `Le don constant, jour et nuit, secret et ouvert, assure la récompense divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yunfiquna amwalahum bi-l-layli wa-n-nahari sirran wa 'alaniyatan » — ceux qui dépensent leurs biens, nuit et jour, secrètement et ouvertement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne constamment ou occasionnellement ? Mon don est-il jour et nuit ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le don occasionnel n'a pas la même valeur que le don constant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pluie ne tombe pas une fois. Le soleil ne brille pas une fois. Le don aussi doit être constant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne constamment devient une source intarissable." }
  ],
  munajat: `Ya Shakur, Tu récompenses le don constant. Fais que je donne nuit et jour, secrètement et ouvertement. Accepte ma constance.`
};

MIROIR["2:275"] = {
  reference: "2:275",
  theme: ["usure", "commerce", "guerre"],
  emotion: "Mise en garde, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Hakim"],
  mirrorVersion: `« Ceux qui mangent de l'intérêt ne se tiendront qu comme se tient celui que le diable a bouleversé par son contact. » Le miroir me montre la nature déstabilisante de l'usure. L'usurier perd son équilibre, son calme, sa stabilité. L'argent de l'intérêt apporte le trouble. Allah a permis le commerce et interdit l'intérêt. Le miroir m'interroge : ma relation à l'argent est-elle saine ?`,
  reflection: `L'usure apporte le trouble. Le commerce est permis, l'intérêt est interdit. La différence est dans l'échange équitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina ya'kuluna ar-riba » — ceux qui mangent de l'intérêt." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma relation à l'argent est-elle saine ? Est-ce que je touche à l'intérêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argent de l'intérêt n'apporte pas la bénédiction — il apporte le trouble." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'échange équitable maintient l'équilibre. L'usure le détruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'usure préserve son cœur du trouble." }
  ],
  munajat: `Ya Rabb, Tu as interdit l'usure. Préserve-moi de l'intérêt. Fais que mon argent soit pur, sans trouble.`
};

MIROIR["2:276"] = {
  reference: "2:276",
  theme: ["usure", "bénédiction", "charité"],
  emotion: "Avertissement, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Mubir", "Ar-Raziq"],
  mirrorVersion: `« Allah réduit à néant l'intérêt et fait fructifier les charités. » Le miroir me montre le contraste final. L'intérêt — réduit à néant. Les charités — fructifiées. L'argent de l'intérêt disparaît, l'argent de la charité se multiplie. Le compte final inverse les comptes humains. Le miroir m'interroge : mon argent est-il de l'intérêt ou de la charité ?`,
  reflection: `L'intérêt est réduit à néant, la charité est multipliée. Le compte final révèle la vraie valeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yamhaqu Allahu ar-riba wa yurbi as-sadaqat » — Allah réduit à néant l'intérêt et fait fructifier les charités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon argent est-il de l'intérêt ou de la charité ? Que restera-t-il à la fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble grand maintenant peut être néant après. Ce qui semble petit peut être immense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau stagnante pourrit. L'eau qui coule purifie. L'argent de charité coule." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le compte final ne s'enrichit que par le licite et la charité." }
  ],
  munajat: `Ya Mubir, Tu réduis l'intérêt à néant. Ya Raziq, Tu fructifies la charité. Purifie mon argent. Fais-le fructifier par le licite.`
};

MIROIR["2:277"] = {
  reference: "2:277",
  theme: ["foi", "œuvres", "récompense"],
  emotion: "Espérance, encouragement",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Ghaffur"],
  mirrorVersion: `« Ceux qui croient, font de bonnes œuvres, accomplissent la prière et acquittent la zakat, ils ont leur récompense auprès de leur Seigneur. » Le miroir me montre le paquet complet. Foi, œuvres, prière, zakat — les quatre piliers de la réussite. Ensemble, ils garantissent la récompense. Pas de peur, pas de tristesse pour ceux qui combinent tout. Le miroir m'interroge : est-ce que je pratique les quatre ?`,
  reflection: `La foi complète inclut œuvres, prière et zakat. Les quatre ensemble garantissent la récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina amanu wa 'amilu as-salihati wa aqamu as-salata wa atawu az-zakata » — ceux qui croient, font de bonnes œuvres, accomplissent la prière et acquittent la zakat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pratique les quatre ? Lequel me manque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi sans œuvre est incomplète. L'œuvre sans foi est vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les quatre saisons forment l'année. Les quatre piliers forment le croyant complet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique les quatre n'a ni peur ni tristesse." }
  ],
  munajat: `Ya Wali, je veux être complet. Foi, œuvres, prière, zakat — aide-moi à les pratiquer tous. Je veux ma récompense auprès de Toi.`
};

MIROIR["2:278"] = {
  reference: "2:278",
  theme: ["usure", "obéissance", "avertissement"],
  emotion: "Urgence, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Qahhar"],
  mirrorVersion: `« Ô vous qui croyez ! Craignez Allah et renoncez à ce qui reste de l'intérêt, si vous êtes croyants. » Le miroir me montre l'appel à la désengagement immédiat. Si tu es croyant, abandonne l'intérêt. La foi vraie exige le désengagement de l'illicite. Pas de compromis. Le miroir m'interroge : est-ce que je renonce à l'illicite quand je le découvre ?`,
  reflection: `La foi vraie exige le renoncement à l'illicite. L'appel est urgent et sans compromis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dharu ma baqiya mina ar-riba » — renoncez à ce qui reste de l'intérêt." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je renonce à l'illicite quand je le découvre ? Ou est-ce que je négocie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Garder l'illicite par cupidité, c'est remettre en question sa foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La plante malade doit être coupée. L'argent illicite doit être abandonné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui renonce à l'illicite pour Allah reçoit mieux que ce qu'il a abandonné." }
  ],
  munajat: `Ya Allah, je renonce à l'illicite. Aide-moi à le quitter complètement. Remplace-le par ce qui est licite et béni.`
};

MIROIR["2:279"] = {
  reference: "2:279",
  theme: ["usure", "guerre", "conséquence"],
  emotion: "Gravité, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Si vous ne le faites pas, sachez qu'Allah et Son Messager vous déclarent la guerre. » Le miroir me montre la gravité maximale. Continuer l'usure, c'est déclarer la guerre à Allah. Il n'y a pas de déclaration plus grave. L'intérêt persistant place le croyant en ennemi de Dieu. Le miroir m'interroge : est-ce que je comprends la gravité de ce que je fais ?`,
  reflection: `La guerre avec Allah est la conséquence ultime de l'usure persistante. La gravité ne peut être plus claire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idhan lam taf'alu fa'dhan bi-harbin mina Allahi wa rasulihi » — sachez qu'Allah et Son Messager vous déclarent la guerre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la gravité de ce que je fais ? Quel péché me met en guerre avec Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guerre avec Allah ne peut être gagnée. Le repentir est la seule issue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul ne peut lutter contre le Créateur des cieux et de la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la guerre évite la destruction. Le repentir est toujours ouvert." }
  ],
  munajat: `Ya Qahhar, je ne veux pas Te faire la guerre. Je me repens de tout intérêt. Pardonne-moi et accepte mon repentir.`
};

MIROIR["2:280"] = {
  reference: "2:280",
  theme: ["dette", "difficulté", "miséricorde"],
  emotion: "Compassion, souplesse",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Karim"],
  mirrorVersion: `« Si le débiteur est en difficulté, accordez-lui un délai jusqu'à ce qu'il soit à l'aise. Et faire charité en renonçant à la dette est mieux pour vous. » Le miroir me montre la miséricorde dans les dettes. Le débiteur en difficulté mérite un délai. Mieux encore : renoncer à la dette comme charité. La souplesse et la générosité transforment le créancier. Le miroir m'interroge : comment je traite ceux qui me doivent ? Avec rigueur ou avec miséricorde ?`,
  reflection: `Le délai pour le débiteur en difficulté. La charité en renonçant à la dette. La miséricorde transforme le créancier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kana dzu 'usratin fa-naziratun ila maysarah » — si le débiteur est en difficulté, accordez-lui un délai." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite ceux qui me doivent ? Avec rigueur ou avec miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Exiger quand l'autre ne peut pas, c'est manquer de miséricorde. Renoncer par charité, c'est dépasser la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre attend la graine. Le créancier attend le débiteur. La patience porte des fruits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait charité en renonçant à la dette reçoit plus que ce qu'il a renoncé." }
  ],
  munajat: `Ya Rahman, Tu es Miséricordieux. Aide-moi à l'être aussi. Accorde des délais. Renonce par charité si Tu me le permets.`
};

MIROIR["2:281"] = {
  reference: "2:281",
  theme: ["jour", "compte", "rétribution"],
  emotion: "Responsabilité, préparation",
  difficulty: "débutant",
  relatedNames: ["Ad-Dayyan", "Al-Hasib"],
  mirrorVersion: `« Et craignez un jour où vous serez ramenés vers Allah. Alors chaque âme sera rétribuée selon ce qu'elle a acquis. Et ils ne seront point lésés. » Le miroir me montre le Jour du Jugement. Retour vers Allah, rétribution exacte, pas d'injustice. Chaque action compte. Chaque instant est enregistré. La conscience de ce Jour transforme la vie quotidienne. Le miroir m'interroge : si ce Jour était demain, que présenterais-je ?`,
  reflection: `Le Jour du Jugement vient. Chaque âme est rétribuée exactement. La conscience de ce Jour guide le présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa it-taqu yawman turja'una fihi ila Allah » — et craignez un jour où vous serez ramenés vers Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si ce Jour était demain, que présenterais-je ? Ma vie est-elle préparée ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Vivre sans penser à ce Jour, c'est vivre dans l'illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose retourne à son origine. L'homme retourne à Dieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec conscience du Jour ne regrette rien quand le Jour vient." }
  ],
  munajat: `Ya Dayyan, le Jour vient où je Te rencontrerai. Aide-moi à me préparer. Fais que je présente de bonnes œuvres.`
};

MIROIR["2:282"] = {
  reference: "2:282",
  theme: ["contrat", "témoins", "justice"],
  emotion: "Rigueur, équité",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-'Adl"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous contractez une dette à terme, mettez-la par écrit. » Le miroir me montre l'importance de la documentation. Les contrats doivent être écrits, les témoins doivent être présents. La justice demande la preuve. La mémoire est faillible, l'écrit est permanent. Ce verset est le plus long du Coran — la justice mérite détail. Le miroir m'interroge : est-ce que je suis rigoureux dans mes transactions ?`,
  reflection: `La documentation protège la justice. Les écrits préviennent les conflits. La rigueur honore la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le verset le plus long du Coran — la justice mérite détails." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis rigoureux dans mes transactions ? Mes contrats sont-ils écrits ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La mémoire oublie, l'écrit reste. La confiance ne remplace pas la preuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la trace de tout. L'homme doit aussi garder trace." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui documente avec rigueur protège la justice pour tous." }
  ],
  munajat: `Ya Shahid, Tu es Témoin de tout. Aide-moi à être rigoureux dans mes transactions. Fais que je protège la justice par l'écrit.`
};

MIROIR["2:283"] = {
  reference: "2:283",
  theme: ["gage", "confiance", "voyage"],
  emotion: "Confiance, pragmatisme",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Wakil"],
  mirrorVersion: `« Si vous êtes en voyage et ne trouvez pas de scribe, un gage sera déposé. » Le miroir me montre la souplesse de la loi. Pas de scribe disponible ? Un gage suffit. La loi divine s'adapte aux circonstances. La confiance reste le fondement, mais les garanties pratiques sont permises. Le miroir m'interroge : est-ce que je pratique ma religion avec souplesse ou rigidité ?`,
  reflection: `La loi divine s'adapte aux circonstances. La souplesse n'est pas faiblesse — c'est sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-rihanun mablughatun » — un gage sera déposé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pratique ma religion avec souplesse ou rigidité ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La rigidité n'est pas la piété. La souplesse dans les limites est sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau prend la forme du récipient. La loi aussi s'adapte aux circonstances." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la souplesse de la loi trouve la facilité dans l'obéissance." }
  ],
  munajat: `Ya Rabb, Ta loi est souple. Aide-moi à la pratiquer avec sagesse. Ne me laisse pas être rigide quand Tu permets la souplesse.`
};

MIROIR["2:284"] = {
  reference: "2:284",
  theme: ["tout", "compte", "pouvoir"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Muhit", "Al-Qadir"],
  mirrorVersion: `« À Allah appartient tout ce qui est dans les cieux et sur la terre. Que vous manifestiez ce qui est en vous ou que vous le cachiez, Allah vous en demandera compte. » Le miroir me montre l'omniscience divine. Rien n'échappe à Allah — les cieux, la terre, les cœurs. Le manifeste et le caché, tout est compté. Cette vérité devrait m'humilier et me rassurer : Dieu sait tout. Le miroir m'interroge : qu'est-ce que je cache ? Suis-je prêt à en rendre compte ?`,
  reflection: `Dieu sait tout — le visible et l'invisible. Rien n'échappe à Son compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tubdu ma fi anfusikum aw tukhufuhu yuhasibkum bihi Allah » — que vous manifestiez ce qui est en vous ou que vous le cachiez, Allah vous en demandera compte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Suis-je prêt à en rendre compte ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Cacher à Dieu est impossible. Il voit le cœur mieux que moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers n'est caché au Créateur. Tout est registre vivant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que Dieu voit tout vit dans une transparence constante." }
  ],
  munajat: `Ya Muhit, Tu sais tout ce qui est en moi. Je ne peux rien cacher. Aide-moi à vivre dans la transparence. Purifie ce que Tu vois.`
};

MIROIR["2:285"] = {
  reference: "2:285",
  theme: ["foi", "soumission", "mission"],
  emotion: "Unité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "As-Sami'"],
  mirrorVersion: `« Le Messager a cru en ce qu'on a fait descendre vers lui de la part de son Seigneur, ainsi que les croyants. Tous ont cru en Allah, en Ses anges, en Ses Livres et en Ses messagers. Nous ne faisons aucune distinction entre Ses messagers. » Le miroir me montre la foi complète du Messager et des croyants. Croire en tout : Allah, les anges, les Livres, les messagers. Sans distinction, sans exclusion. La foi est totale ou elle n'est pas. Le miroir m'interroge : ma foi est-elle complète ?`,
  reflection: `La foi complète englobe tout : Dieu, anges, Livres, messagers. Sans distinction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amana ar-rasulu bima unzila ilayhi min rabbihi wa-l-mu'minun » — le Messager a cru... ainsi que les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle complète ? Crois-je en tout sans exclusion ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La foi sélective n'est pas la foi. Choisir dans la révélation, c'est refuser la totalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est une. L'accepter entièrement, c'est s'éclairer complètement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en tout reçoit la plénitude de la foi." }
  ],
  munajat: `Ya Rabb, je crois en tout ce que Tu as révélé. En Tes anges, Tes Livres, Tes messagers. Fais que ma foi soit complète.`
};

// ============================================
// SURAHS 29-56 - ADDITIONAL MIROIR ENTRIES
// ============================================

// Surah 29 - Al-'Ankabut (The Spider)
MIROIR["29:1"] = {
  reference: "29:1",
  theme: ["méditation", "force", "éprouve"],
  emotion: "Réflexion, interrogation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Hayy"],
  mirrorVersion: `« Alif, Lam, Mim. Les gens pensent-ils qu'ils seront laissés à dire 'Nous croyons' sans être éprouvés ? » Le miroir me place devant une question fondamentale. La foi n'est pas une déclaration — c'est une réalité qui doit être vérifiée. L'épreuve (fitna) est le test qui distingue la foi authentique de la foi superficielle. Le miroir m'interroge : ma foi a-t-elle été testée ? Comment ai-je réagi dans l'épreuve ?`,
  reflection: `La foi déclarée sans épreuve reste hypothétique. C'est dans le feu que l'or se révèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'épreuve est inévitable pour le croyant. Pas de foi sans test." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle épreuve a testé ma foi ? Comment ai-je réagi ? Le miroir révèle ma véritable spiritualité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve n'est pas une punition — c'est une graduation. Elle élève celui qui la traverse avec foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers est testée. Le diamant sous pression, l'or dans le feu, l'âme dans l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille l'épreuve comme un test d'amour la transforme en élévation." }
  ],
  munajat: `Ya Allah, éprouve-moi pour que ma foi soit vraie. Donne-moi la force de traverser chaque test avec patience et gratitude.`
};

MIROIR["29:2"] = {
  reference: "29:2",
  theme: ["éprouve", "force", "confiance"],
  emotion: "Lucidité, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-'Alim"],
  mirrorVersion: `« Estiment-ils pouvoir dire 'Nous croyons' sans être mis à l'épreuve ? » Le miroir me montre que la foi n'est pas un label qu'on porte — c'est une substance qu'on doit prouver. L'épreuve n'est pas un accident sur le chemin de la foi — elle est le chemin lui-même. Le miroir m'interroge : qu'est-ce que j'ai fait de ma foi ? Est-elle restée au stade des mots ?`,
  reflection: `La foi sans épreuve est comme une plante sans racine — elle ne tient pas quand le vent souffle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le questionnement divin interpelle : la foi n'est pas une formalité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où en est ma foi ? A-t-elle résisté aux épreuves ? S'est-elle effondrée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve ne détruit pas la foi — elle la révèle. Ce qui s'effondre n'était pas la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un test. Chaque créature fait face à des défis qui révèlent sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'épreuve est un miroir — elle montre qui je suis vraiment, pas qui je prétends être." }
  ],
  munajat: `Ya Rabb, ne me laisse pas avec une foi de mots. Éprouve-moi pour que je sois sincère, et donne-moi la force de passer le test.`
};

MIROIR["29:5"] = {
  reference: "29:5",
  theme: ["espoir", "confiance", "rencontre"],
  emotion: "Espérance, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'id", "Al-Maw'id"],
  mirrorVersion: `« Celui qui espère la rencontre d'Allah, le terme d'Allah vient certainement. » Le miroir me place devant la certitude de la rencontre avec Allah. Le terme (ajal) vient sans faute. L'espérance de cette rencontre transforme la vie — celui qui l'attend vraiment vit différemment. Le miroir m'interroge : est-ce que j'espère vraiment cette rencontre ? Ou est-ce que je la crains ?`,
  reflection: `La rencontre avec Allah est certaine. L'espérance ou la peur révèle l'état du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Le terme d'Allah vient certainement » — la rencontre est inévitable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je me prépare à cette rencontre ? Mon cœur est-il prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui craint la rencontre la redoute ; celui qui l'espère l'attend avec joie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature retourne à son Créateur. La rencontre est inscrite dans la structure de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'espérance de la rencontre transforme chaque jour en préparation joyeuse." }
  ],
  munajat: `Ya Allah, fais que j'espère Ta rencontre. Prépare mon cœur pour ce moment inévitable. Fais que je Te rencontre avec joie.`
};

MIROIR["29:7"] = {
  reference: "29:7",
  theme: ["pardon", "espoir", "récompense"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ash-Shakur"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, Nous effacerons leurs mauvaises actions et les récompenserons selon les meilleures qu'ils ont faites. » Le miroir me montre la générosité d'Allah. Non seulement les péchés sont effacés, mais la récompense est calculée sur les meilleures actions. Le miroir m'interroge : est-ce que je connais cette générosité ? Est-ce que j'en vis ?`,
  reflection: `La miséricorde d'Allah dépasse la justice. Elle efface le mal et multiplie le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La promesse : effacement des péchés + récompense pour les meilleures actions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles bonnes actions ai-je faites ? Et quels péchés ont besoin d'être effacés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense sur les meilleures actions signifie qu'Allah choisit le meilleur de nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est généreux par nature. Le soleil donne sans compter, Allah donne encore plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît cette générosité n'a plus peur de ses péchés — il a honte de ne pas faire plus de bien." }
  ],
  munajat: `Ya Ghaffur, efface mes mauvaises actions. Récompense-moi selon mes meilleures œuvres. Je m'appuie sur Ta générosité.`
};

MIROIR["29:10"] = {
  reference: "29:10",
  theme: ["éprouve", "hypocrisie", "sagesse"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabeer", "Al-Basir"],
  mirrorVersion: `« Parmi les gens, il en est qui disent : 'Nous croyons en Allah', mais dès qu'ils subissent un préjudice pour Allah, ils considèrent l'épreuve des gens comme un châtiment d'Allah. » Le miroir me montre le piège de la foi conditionnelle. Certains croient tant que tout va bien, mais au premier signe de difficulté, ils abandonnent. Le miroir m'interroge : ma foi est-elle conditionnelle ? À quoi suis-je prêt à renoncer ?`,
  reflection: `La foi authentique tient dans l'épreuve. La foi conditionnelle s'effondre au premier obstacle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'hypocrisie subtile : croire quand c'est facile, douter quand c'est difficile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me ferait douter ? Quelle épreuve me ferait renoncer ? Le miroir révèle mes conditions cachées." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est un don — elle purifie la foi de ses conditions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne trompe pas. L'arbre qui résiste à la tempête a des racines profondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît ses faiblesses peut les renforcer. L'honnêteté avec soi-même est le premier pas." }
  ],
  munajat: `Ya 'Alim, Tu connais mon cœur mieux que moi. Montre-moi mes conditions cachées. Fais que ma foi soit inconditionnelle.`
};

MIROIR["29:20"] = {
  reference: "29:20",
  theme: ["méditation", "création", "sagesse"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Badi"],
  mirrorVersion: `« Dis : Parcourez la terre et voyez comment Il a commencé la création. » Le miroir m'invite à l'observation du monde. La terre est un livre ouvert sur la création d'Allah. Chaque créature, chaque paysage, chaque phénomène porte la signature du Créateur. Le miroir m'interroge : est-ce que je regarde vraiment le monde ? Ou est-ce que je traverse la vie sans voir ?`,
  reflection: `La création est un miroir du Créateur. Qui regarde avec attention voit la main d'Allah partout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'invitation au voyage et à l'observation. La terre comme laboratoire spirituel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois quand je regarde la nature ? Un hasard ou une signature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création n'est pas un musée — c'est une école. Chaque créature enseigne quelque chose." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. De l'atome à la galaxie, tout parle de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la création avec le cœur voit Allah dans chaque détail." }
  ],
  munajat: `Ya Khaliq, ouvre mes yeux sur Ta création. Fais que je voie Ta main dans chaque feuille, chaque étoile, chaque souffle.`
};

MIROIR["29:45"] = {
  reference: "29:45",
  theme: ["prière", "méditation", "transformation"],
  emotion: "Révérence, engagement",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-'Alim"],
  mirrorVersion: `« Récite ce qui t'est révélé du Livre et accomplis la prière. La prière préserve de la turpitude et du blâmable. » Le miroir me montre le lien entre la prière et la transformation morale. La prière n'est pas un rituel vide — elle transforme celui qui l'accomplit sincèrement. Elle préserve du mal parce qu'elle connecte à Allah. Le miroir m'interroge : ma prière me transforme-t-elle ? Ou est-elle devenue mécanique ?`,
  reflection: `La prière sincère purifie. Elle connecte l'âme à sa source et la fortifie contre le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La récitation du Coran + la prière = transformation morale." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma prière me protège du mal ? Si non, pourquoi ? Le miroir révèle la qualité de ma connexion." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière qui ne transforme pas n'est peut-être pas une prière — mais un exercice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers prie à sa manière. L'être humain a reçu la prière articulée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière est une ascension quotidienne. Chaque unité est un degré vers Allah." }
  ],
  munajat: `Ya Allah, fais que ma prière soit une véritable connexion. Qu'elle me purifie, me transforme, et me rapproche de Toi.`
};

MIROIR["29:64"] = {
  reference: "29:64",
  theme: ["méditation", "espoir", "réalité"],
  emotion: "Lucidité, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Ba'ith"],
  mirrorVersion: `« Cette vie d'ici-bas n'est qu'amusement et jeu. La Demeure de l'au-delà est la vraie vie. » Le miroir me place devant la question de la réalité. Qu'est-ce qui est réel ? Cette vie que je vis intensément, ou l'au-delà que je ne vois pas ? Le Coran dit : l'au-delà est la vraie vie. Cette vie n'est qu'une ombre, un jeu, un amusement passager. Le miroir m'interroge : pour laquelle de ces vies est-ce que je vis ?`,
  reflection: `La vie éternelle est la vraie vie. Cette vie est un passage, un test, un rêve éphémère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le contraste : amusement (lahw) vs vraie vie (hayawan). La vie éternelle est la référence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi investis-je mon temps ? Dans le jeu éphémère ou dans la vraie vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui vit pour l'au-delà trouve le sens ici-bas. Celui qui vit pour ici-bas perd les deux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers l'éternité. Tout passe, tout se transforme, tout retourne à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre en sachant que l'au-delà est la vraie vie change chaque instant ici-bas." }
  ],
  munajat: `Ya Haqq, fais que je voie la réalité. Que je vive pour la vraie vie, pas pour l'illusion. Éveille-moi du rêve de ce monde.`
};

// Surah 30 - Ar-Rum (The Romans)
MIROIR["30:1"] = {
  reference: "30:1",
  theme: ["espoir", "histoire", "confiance"],
  emotion: "Émerveillement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Ghalib"],
  mirrorVersion: `« Alif, Lam, Mim. Les Romains ont été vaincus. » Le miroir me place devant une prophétie historique. Les Byzantins, chrétiens, ont été vaincus par les Perses, zoroastriens. Mais Allah annonce leur retour. Le miroir me montre que les apparences peuvent tromper. Ce qui semble perdu peut revenir. Le miroir m'interroge : est-ce que je perds espoir quand tout semble perdu ?`,
  reflection: `Les défaites apparentes peuvent cacher des victoires futures. Allah connaît l'issue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Une prophétie historique précise. Les Romains vaincus reviendront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle situation me semble désespérée ? Le miroir me dit : Allah peut retourner toute situation." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défaite d'aujourd'hui peut être la victoire de demain. Rien n'est définitif sauf Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine de retournements. Les empires s'effondrent et renaissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en Allah ne désespère jamais. Chaque défaite est temporaire." }
  ],
  munajat: `Ya 'Aziz, Tu retournes les situations. Ne me laisse pas désespérer. Fais que je voie Ta main même dans les défaites.`
};

MIROIR["30:17"] = {
  reference: "30:17",
  theme: ["prière", "présence", "gratitude"],
  emotion: "Révérence, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Musabbih", "Al-Hamid"],
  mirrorVersion: `« Gloire à Allah quand vous entrez dans le soir et quand vous entrez dans le matin. » Le miroir m'invite à la louange continuelle. Le matin et le soir — les deux transitions du jour — sont des moments de rappel. Chaque changement est une occasion de glorifier Allah. Le miroir m'interroge : comment est-ce que je commence et finis mes journées ?`,
  reflection: `Les moments de transition sont des occasions de rappel. Le matin et le soir sont des dons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La glorification aux moments clés : entrée du soir, entrée du matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment commence-je ma journée ? Comment la finis-je ? Avec Allah ou sans Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange n'est pas pour Allah — elle est pour nous. Elle nous connecte à la source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier glorifie Allah. Le soleil se lève et se couche en adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui commence et finit sa journée avec Allah vit une journée complète." }
  ],
  munajat: `Ya Allah, je Te glorifie au matin et au soir. Fais que chaque transition de ma vie soit un retour à Toi.`
};

MIROIR["30:22"] = {
  reference: "30:22",
  theme: ["méditation", "sagesse", "diversité"],
  emotion: "Émerveillement, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Parmi Ses signes, la création des cieux et de la terre, et la diversité de vos langues et de vos couleurs. » Le miroir me montre que la diversité est un signe d'Allah, pas un problème. Les langues différentes, les couleurs variées — tout cela est voulu par le Créateur. Le miroir m'interroge : est-ce que je vois la diversité comme une richesse ou comme une menace ?`,
  reflection: `La diversité humaine est voulue par Allah. Elle est un signe de Sa créativité infinie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les cieux, la terre, les langues, les couleurs — tous des signes (ayat)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis à la différence ? Avec curiosité ou avec peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité n'est pas une division — c'est une richesse. L'unité dans la diversité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est infiniment divers. Chaque flocon de neige est unique, chaque âme aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que la diversité est un signe voit l'unité derrière les différences." }
  ],
  munajat: `Ya Khaliq, merci pour la diversité. Fais que je voie chaque différence comme un reflet de Ta créativité infinie.`
};

MIROIR["30:27"] = {
  reference: "30:27",
  theme: ["création", "résurrection", "confiance"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Mubdi", "Al-Mu'id"],
  mirrorVersion: `« C'est Lui qui donne la vie et donne la mort. Et quand Il décide une chose, Il dit seulement : 'Sois', et elle est. » Le miroir me place devant la puissance absolue d'Allah. La vie, la mort, la création — tout est dans Sa main. Son commandement « Kun fayakun » — Sois, et c'est — révèle une puissance sans effort. Le miroir m'interroge : est-ce que je vis en conscience de cette puissance ?`,
  reflection: `La parole d'Allah crée. « Sois » suffit. Rien ne résiste à Sa volonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La vie, la mort, le commandement — tout est dans Sa main." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Contre quoi luttes-je seul alors qu'Allah peut dire 'Sois' et régler tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui se soumet à 'Sois' devient un instrument de la volonté divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier obéit à 'Sois'. Chaque atome répond à Sa parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre dans 'Kun fayakun' signifie faire confiance que tout est arrangé." }
  ],
  munajat: `Ya Allah, Ta parole suffit. Dis 'Sois' sur ma vie. Arrange ce que je ne peux pas arranger. Je me soumets à Ton 'Kun'.`
};

MIROIR["30:41"] = {
  reference: "30:41",
  theme: ["conséquence", "méditation", "transformation"],
  emotion: "Responsabilité, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "At-Tawwab"],
  mirrorVersion: `« La corruption est apparue sur terre et dans la mer à cause de ce que les gens ont accompli de leurs propres mains. » Le miroir me montre le lien entre les actions humaines et l'état du monde. Les déséquilibres écologiques, sociaux, personnels — tout est lié à nos choix. Le miroir m'interroge : qu'est-ce que j'ai « accompli de mes propres mains » qui contribue à la corruption ?`,
  reflection: `Nos actions ont des conséquences. L'état du monde reflète l'état des cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La corruption (fasad) sur terre et mer — conséquence des actions humaines." },
    { label: "Le Reflet", ar: "المرصAD", color: "var(--mirror)", text: "Qu'est-ce que je fais qui contribue au fasad ? Et qu'est-ce que je peux réparer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si nos actions créent le fasad, nos actions peuvent aussi le réparer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un système interconnecté. Chaque action a des répercussions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend son impact peut choisir d'être source de guérison, pas de corruption." }
  ],
  munajat: `Ya Rabb, montre-moi ma part de responsabilité. Aide-moi à réparer ce que j'ai corrompu et à être source de guérison.`
};

MIROIR["30:60"] = {
  reference: "30:60",
  theme: ["patience", "confiance", "espérance"],
  emotion: "Sérénité, détermination",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Wakil"],
  mirrorVersion: `« Sois patient. La promesse d'Allah est vérité. » Le miroir me place devant l'ultime conseil de la sourate : la patience. La promesse d'Allah est vraie — elle viendra. La patience n'est pas de la passivité, c'est la confiance active dans la vérité divine. Le miroir m'interroge : est-ce que je tiens bon ? Est-ce que je crois vraiment à la promesse ?`,
  reflection: `La patience est le pont entre la promesse et son accomplissement. Celui qui tient traverse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le commandement final : sabr (patience). La promesse est haqq (vérité)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où ai-je besoin de patience aujourd'hui ? Quelle promesse dois-je croire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience n'est pas une attente vide — c'est une confiance active." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est patient. L'arbre pousse lentement, la montagne se forme sur des millénaires." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est patient avec Allah, Allah est patient avec lui. La patience attire la miséricorde." }
  ],
  munajat: `Ya Sabur, enseigne-moi la patience. Fais que je tienne jusqu'à l'accomplissement de Ta promesse. Je crois en Ta vérité.`
};

// Surah 31 - Luqman (Luqman)
MIROIR["31:1"] = {
  reference: "31:1",
  theme: ["sagesse", "guidance", "méditation"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Alif, Lam, Mim. Voici les versets du Livre plein de sagesse. » Le miroir me place devant le Coran comme source de sagesse. « Hakim » — sage, mais aussi « affermi ». Le Coran n'est pas seulement un livre de conseils — c'est une fondation solide. Le miroir m'interroge : sur quoi est-ce que je construis ma vie ? Sur du sable ou sur la sagesse ?`,
  reflection: `Le Coran est sagesse incarnée. Chaque verset est une brique pour construire une vie solide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kitab hakim » — un livre de sagesse, un livre affermi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de sagesse ai-je tirée du Coran ? Quelle partie de ma vie est construite dessus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse n'est pas dans le livre fermé — elle est dans le livre lu et vécu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est construit sur des lois sages. Le Coran est la loi pour l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran avec le cœur reçoit la sagesse directement de sa Source." }
  ],
  munajat: `Ya Hakim, ouvre mon cœur à la sagesse du Coran. Fais que je ne sois pas seulement un lecteur, mais un vivant de Ta parole.`
};

MIROIR["31:12"] = {
  reference: "31:12",
  theme: ["gratitude", "sagesse", "bénédiction"],
  emotion: "Reconnaissance, humilité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Mannan"],
  mirrorVersion: `« Nous avons donné la sagesse à Luqman : 'Sois reconnaissant envers Allah.' » Le miroir me montre que la gratitude est le fondement de la sagesse. Luqman, ce sage non-prophète, a reçu la sagesse parce qu'il a compris la gratitude. Être reconnaissant envers Allah — c'est reconnaître que tout vient de Lui. Le miroir m'interroge : suis-je reconnaissant ? Est-ce que je vois les dons ou seulement les manques ?`,
  reflection: `La gratitude ouvre la porte à plus de dons. L'ingratitude ferme la source.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "La sagesse de Luqman commence par la gratitude envers Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je remercie aujourd'hui ? Et qu'est-ce que j'ai oublié de remercier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude n'est pas pour Allah — elle est pour nous. Elle nous connecte à la source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un don. Chaque souffle, chaque moment, chaque créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour peu reçoit beaucoup. La gratitude multiplie." }
  ],
  munajat: `Ya Shakur, enseigne-moi la gratitude. Ouvre mes yeux sur les dons que je ne vois pas. Fais que je sois reconnaissant pour tout.`
};

MIROIR["31:16"] = {
  reference: "31:16",
  theme: ["conscience", "responsabilité", "méditation"],
  emotion: "Lucidité, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Latif", "Al-Khabir"],
  mirrorVersion: `« Ô mon fils, fût-ce le poids d'un grain de moutarde dans un rocher, ou dans les cieux ou dans la terre, Allah le fera venir. » Le miroir me place devant la précision absolue de la connaissance d'Allah. Rien n'est caché — même un grain de moutarde au cœur d'un rocher. Le miroir m'interroge : qu'est-ce que je cache ? Qu'est-ce que je pense invisible aux yeux d'Allah ?`,
  reflection: `Rien n'échappe à Allah. La conscience de Sa connaissance devrait transformer mes choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le grain de moutarde — la plus petite chose — est connu d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais en pensant que personne ne voit ? Allah voit tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Cette connaissance n'est pas une surveillance oppressive — c'est une compagnie intime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est transparent devant Allah. Pas d'ombre, pas de cachette." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre en sachant qu'Allah voit tout libère de l'hypocrisie." }
  ],
  munajat: `Ya Latif, Tu connais le grain de moutarde caché. Tu connais mes secrets. Purifie-moi de ce que je cache et que Tu n'aimes pas.`
};

MIROIR["31:27"] = {
  reference: "31:27",
  theme: ["infini", "méditation", "sagesse"],
  emotion: "Émerveillement, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wasi'", "Al-'Azim"],
  mirrorVersion: `« Si tous les arbres de la terre étaient des calames, si la mer s'y ajoutait avec sept mers semblables, les paroles d'Allah ne s'épuiseraient pas. » Le miroir me place devant l'infini d'Allah. Même toute la création transformée en encre ne pourrait pas écrire Ses paroles. Le miroir m'invite à l'humilité : ce que je connais d'Allah n'est qu'une goutte dans un océan infini. Le miroir m'interroge : est-ce que je me satisfais de ma petite connaissance ?`,
  reflection: `L'infini d'Allah dépasse toute imagination. Notre connaissance reste toujours limitée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Les arbres comme calames, les mers comme encre — et ce n'est pas assez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crois savoir d'Allah ? Le miroir me montre mon ignorance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'infini n'est pas intimidant — il est une invitation à l'exploration éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers visible est fini. Allah est infini. La créature ne peut contenir le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son ignorance connaît le début de la sagesse." }
  ],
  munajat: `Ya Wasi', Tu es infini. Je ne Te connais qu'à peine. Ouvre-moi à plus de Toi, encore et encore, pour l'éternité.`
};

MIROIR["31:34"] = {
  reference: "31:34",
  theme: ["mystère", "confiance", "humilité"],
  emotion: "Révérence, lâcher-prise",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghayb", "Al-'Alim"],
  mirrorVersion: `« La connaissance de l'Heure est auprès d'Allah. C'est Lui qui fait descendre la pluie et sait ce que contiennent les matrices. » Le miroir me place devant les limites de ma connaissance. L'Heure, la pluie, le contenu des matrices — ces choses m'échappent. Je ne sais pas ce qui vient. Le miroir m'invite à l'humilité et à la confiance : ce que je ne sais pas, Allah le sait. Le miroir m'interroge : est-ce que je vis dans la confiance ou dans l'anxiété ?`,
  reflection: `Les mystères d'Allah sont des invitations à la confiance, pas à l'angoisse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Cinq connaissances réservées à Allah : l'Heure, la pluie, les matrices, demain, notre lieu de mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'essaie de contrôler qui m'échappe ? Le miroir invite au lâcher-prise." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de demain est une miséricorde — elle permet de vivre aujourd'hui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères. La science en découvre chaque jour sans tout épuiser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte de ne pas tout savoir entre dans la paix de la confiance." }
  ],
  munajat: `Ya 'Alim al-ghayb, Tu sais ce que je ne sais pas. Je me confie à Toi pour demain, pour l'Heure, pour tout ce qui m'échappe.`
};

// Surah 32 - As-Sajdah (The Prostration)
MIROIR["32:1"] = {
  reference: "32:1",
  theme: ["méditation", "révélation", "sagesse"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Malik"],
  mirrorVersion: `« Alif, Lam, Mim. La révélation du Livre, nul doute là-dessus, venant du Seigneur des mondes. » Le miroir me place devant l'origine divine du Coran. « Nul doute » — la certitude. Pas une production humaine, mais une révélation du Seigneur des mondes. Le miroir m'interroge : est-ce que je traite ce Livre comme une révélation divine ? Ou comme un texte ordinaire ?`,
  reflection: `Le Coran est une révélation. Cette certitude devrait transformer notre rapport au texte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La révélation du Livre » — tanziyl, descente. Du ciel vers la terre, d'Allah vers l'homme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je lis le Coran ? Comme une lettre de mon Seigneur ou comme un vieux livre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation descend pour nous élever. Lire sans s'élever, c'est manquer son but." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah relie le ciel et la terre. Le Coran est ce lien tangible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme une lettre de son Seigneur reçoit une réponse dans chaque verset." }
  ],
  munajat: `Ya Rabb al-'alamin, Tu as fait descendre ce Livre. Fais que je le lise comme ce qu'il est : Ta parole à moi.`
};

MIROIR["32:4"] = {
  reference: "32:4",
  theme: ["création", "temps", "méditation"],
  emotion: "Révérence, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« Allah qui a créé les cieux et la terre en six jours, puis S'est établi sur le Trône. » Le miroir me place devant la grandeur d'Allah. Créateur des cieux et de la terre, établi sur le Trône — au-dessus de tout. Le miroir m'invite à la perspective : avant moi, il y avait Lui. Après moi, il y aura Lui. Le miroir m'interroge : est-ce que je vis en conscience de cette grandeur ?`,
  reflection: `Allah est le Créateur et le Roi. Cette conscience relativise toutes mes prétentions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Six jours de création, puis l'établissement sur le Trône. La souveraineté absolue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma grandeur comparée à la Sienne ? Le miroir invite à l'humilité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur d'Allah n'écrase pas — elle rassure. Le Roi protecteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est Son royaume. Chaque atome obéit à Son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la grandeur d'Allah n'a plus besoin de sa propre grandeur." }
  ],
  munajat: `Ya Khaliq, Tu as créé tout ce qui existe. Je suis petit devant Ta grandeur. Sois mon Roi, mon Protecteur, mon Tout.`
};

MIROIR["32:11"] = {
  reference: "32:11",
  theme: ["mort", "ange", "confiance"],
  emotion: "Sérénité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "Al-Mumit"],
  mirrorVersion: `« Dis : L'ange de la mort chargé de vous vous fera mourir. » Le miroir me place devant la certitude de la mort. L'ange de la mort (Malak al-Mawt) viendra pour chaque âme. Pas de fuite possible. Le miroir m'interroge : est-ce que je suis prêt pour cette rencontre ? Mon cœur est-il préparé ?`,
  reflection: `La mort est certaine. L'ange viendra. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'ange de la mort vient pour chaque âme, sans exception." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si l'ange venait maintenant, serais-je prêt ? Qu'ai-je laissé en suspens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin — c'est le passage. Pour le croyant, c'est un retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier traverse des cycles de vie et de mort. L'étoile meurt, l'âme passe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui meurt chaque jour dans le dhikr ne craint pas la mort du corps." }
  ],
  munajat: `Ya Allah, l'ange de la mort viendra. Prépare mon cœur pour ce moment. Fais que je Te rencontre en paix.`
};

MIROIR["32:21"] = {
  reference: "32:21",
  theme: ["éprouve", "leçon", "sagesse"],
  emotion: "Lucidité, apprentissage",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mudabbir"],
  mirrorVersion: `« Nous leur ferons certainement goûter au châtiment inférieur avant le châtiment supérieur. » Le miroir me montre que les épreuves de cette vie sont des avertissements avant le grand châtiment. Les difficultés ici-bas sont des invitations au retour, pas des punitions définitives. Le miroir m'interroge : quelles difficultés suis-je en train de vivre ? Sont-elles des avertissements pour moi ?`,
  reflection: `Les épreuves sont des rappels. Elles nous invitent à nous réveiller avant qu'il ne soit trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le châtiment inférieur (ad-duna) avant le châtiment supérieur (al-'azim)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle épreuve traverse-je ? Est-ce un avertissement ? Quel message contient-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde. Allah avertit avant de punir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers nous avertit : tremblements de terre, maladies, difficultés — des signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'avertissement se corrige avant le jugement." }
  ],
  munajat: `Ya Hakim, si Tu m'avertis par des épreuves, aide-moi à entendre le message. Je me repens et je me corrige.`
};

// Surah 33 - Al-Ahzab (The Confederates)
MIROIR["33:3"] = {
  reference: "33:3",
  theme: ["confiance", "tawakkul", "abandon"],
  emotion: "Sérénité, lâcher-prise",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Hafiz"],
  mirrorVersion: `« Place ta confiance en Allah. Allah suffit comme protecteur. » Le miroir me place devant le tawakkul — la confiance absolue en Allah. Pas une confiance partielle, mais totale. Allah « suffit » — kafa. Il n'y a pas besoin d'autre protecteur. Le miroir m'interroge : en qui est-ce que je place vraiment ma confiance ? En Allah ou dans mes stratégies ?`,
  reflection: `La confiance en Allah libère de l'anxiété. Celui qui se confie vraiment n'a plus peur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tawakkal 'ala Allah » — confie-toi à Allah. « Kafa billahi wakila » — Allah suffit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche la protection ? En Allah ou ailleurs ? Le miroir révèle mes vrais refuges." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance n'est pas la passivité — c'est l'action avec la conscience que le résultat est entre les mains d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature se confie à son Créateur par sa nature. L'oiseau ne s'inquiète pas du lendemain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie vraiment à Allah reçoit Sa paix. L'anxiété est le signe d'un manque de confiance." }
  ],
  munajat: `Ya Wakil, je me confie à Toi. Tu suffis. Sois mon Protecteur, mon Garant, mon Tout.`
};

MIROIR["33:21"] = {
  reference: "33:21",
  theme: ["modèle", "prophète", "imitation"],
  emotion: "Révérence, aspiration",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Uswa"],
  mirrorVersion: `« Vous avez dans le Messager d'Allah un excellent modèle à suivre. » Le miroir me place devant le Prophète comme modèle. Pas seulement un messager, mais un exemple vivant. Chaque aspect de sa vie est une leçon. Le miroir m'interroge : est-ce que je connais vraiment le Prophète ? Est-ce que j'essaie de lui ressembler ?`,
  reflection: `Le Prophète est le modèle parfait. L'imiter, c'est se rapprocher de la perfection humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uswa hasana » — un excellent modèle. Pour celui qui espère Allah et le Jour dernier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle qualité du Prophète puis-je imiter aujourd'hui ? Sa patience ? Sa générosité ? Sa douceur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le modèle n'est pas inaccessible — il est donné pour être imité. Chaque petit pas compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses modèles. Le soleil donne sans attendre. Le Prophète donne encore plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui imite le Prophète par amour reçoit son intercession." }
  ],
  munajat: `Ya Allah, fais que je ressemble à Ton Prophète. Pas seulement en paroles, mais en actes, en caractère, en cœur.`
};

MIROIR["33:35"] = {
  reference: "33:35",
  theme: ["égalité", "récompense", "spiritualité"],
  emotion: "Inclusion, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Ghaffur"],
  mirrorVersion: `« Les musulmans et musulmanes, croyants et croyantes... Allah leur a préparé un pardon et une récompense énorme. » Le miroir me montre l'égalité spirituelle entre hommes et femmes devant Allah. Les mêmes qualités — foi, humilité, patience — sont demandées aux deux. La même récompense est promise. Le miroir m'interroge : est-ce que je traite les femmes avec la dignité qu'Allah leur accorde ?`,
  reflection: `Devant Allah, hommes et femmes sont égaux. La piété fait la différence, pas le genre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Dix catégories de croyants et croyantes — même qualités, même récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je considère les femmes ? Comme Allah les considère ou comme la culture les traite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égalité divine contredit les inégalités culturelles. Allah est plus juste que les traditions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers contient le masculin et le féminin. Devant le Créateur, les deux sont égaux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La spiritualité n'a pas de genre. Le cœur qui se tourne vers Allah est entendu, homme ou femme." }
  ],
  munajat: `Ya 'Adl, Tu es juste. Fais que je voie les hommes et les femmes comme Tu les vois — égaux en dignité et en potentiel spirituel.`
};

MIROIR["33:45"] = {
  reference: "33:45",
  theme: ["prophète", "mission", "lumière"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Ash-Shahid"],
  mirrorVersion: `« Ô Prophète, Nous t'avons envoyé comme témoin, annonciateur et avertisseur. » Le miroir me montre la mission du Prophète : témoin (shahid) de la vérité, annonciateur (mubashshir) de la bonne nouvelle, avertisseur (nadhir) du danger. Trois fonctions pour une mission : sauver les âmes. Le miroir m'interroge : ai-je entendu son message ? Est-ce que je le transmets ?`,
  reflection: `Le Prophète est la lumière qui montre le chemin. L'écouter, c'est accepter la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Témoin, annonciateur, avertisseur — trois fonctions pour une mission complète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel aspect du message du Prophète ai-je besoin d'entendre aujourd'hui ? La bonne nouvelle ou l'avertissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète ne parle pas de lui-même — il transmet ce qu'il reçoit. Le message vient d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière du Prophète éclaire tous les temps et tous les lieux. Son message est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète suit la lumière qui mène à Allah." }
  ],
  munajat: `Ya Allah, merci pour Ton Prophète. Fais que je l'entende comme témoin, que j'accueille sa bonne nouvelle, que je prenne au sérieux son avertissement.`
};

MIROIR["33:70"] = {
  reference: "33:70",
  theme: ["parole", "véracité", "réforme"],
  emotion: "Engagement, clarté",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Haqq"],
  mirrorVersion: `« Ô vous qui croyez ! Craignez Allah et parlez avec droiture. » Le miroir me place devant deux commandements liés : la crainte d'Allah (taqwa) et la parole droite (qawl sadid). La taqwa intérieure se manifeste dans la parole extérieure. Le miroir m'interroge : ma parole est-elle droite ? Est-elle marquée par la conscience d'Allah ?`,
  reflection: `La parole est le miroir du cœur. Une parole droite révèle un cœur droit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Taqwa + qawl sadid = la formule de la réforme personnelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je parle ? Avec droiture ou avec détours ? Le miroir révèle ma langue." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole droite réforme le cœur. Ce que je dis façonne ce que je deviens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole est le propre de l'homme. Elle peut construire ou détruire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise sa langue maîtrise son cœur. La parole est le premier acte spirituel." }
  ],
  munajat: `Ya Haqq, fais que ma parole soit droite. Purifie ma langue de tout mensonge, exagération, calomnie. Fais que je parle avec Ta conscience.`
};

// Surah 34 - Saba (Sheba)
MIROIR["34:1"] = {
  reference: "34:1",
  theme: ["louange", "royauté", "gratitude"],
  emotion: "Révérence, adoration",
  difficulty: "débutant",
  relatedNames: ["Al-Hamid", "Al-Malik"],
  mirrorVersion: `« Louange à Allah à qui appartient tout ce qui est dans les cieux et tout ce qui est sur la terre. » Le miroir me place devant la louange universelle. Tout appartient à Allah — les cieux, la terre, et tout ce qu'ils contiennent. La louange n'est pas optionnelle — elle est la réponse juste à la réalité. Le miroir m'interroge : est-ce que je Loue Allah pour tout ce qu'Il possède ?`,
  reflection: `La louange est la reconnaissance de la réalité. Tout est à Allah, tout mérite d'être loué.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hamdu lillah » — la louange à Allah. Pour tout ce qui est dans les cieux et sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi est-ce que je loue Allah ? Pour ce que je possède ou pour ce qu'Il possède ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange n'est pas pour Allah — elle est pour nous. Elle nous aligne sur la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier loue Allah à sa manière. L'homme le fait avec des mots." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue constamment vit dans la conscience de la présence d'Allah." }
  ],
  munajat: `Ya Hamid, je Te loue pour tout ce qui T'appartient. Fais que chaque souffle soit une louange, chaque moment une reconnaissance.`
};

MIROIR["34:9"] = {
  reference: "34:9",
  theme: ["puissance", "signes", "méditation"],
  emotion: "Émerveillement, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Muhit"],
  mirrorVersion: `« N'ont-ils pas vu ce qui est devant eux et ce qui est derrière eux, du ciel et de la terre ? » Le miroir m'invite à observer les signes d'Allah dans la création. Devant nous, derrière nous — tout est signe. Le ciel et la terre sont des livres ouverts. Le miroir m'interroge : est-ce que je vois les signes ? Ou est-ce que je traverse le monde aveugle ?`,
  reflection: `La création est un livre de signes. Qui regarde avec attention voit la main du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le ciel et la terre, devant et derrière — tout est signe pour celui qui voit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois devant moi ? Un hasard ou une signature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes ne manquent pas — c'est notre regard qui manque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Chaque atome pointe vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit les signes voit Allah partout. Le monde devient un livre vivant." }
  ],
  munajat: `Ya Muhit, ouvre mes yeux sur Tes signes. Fais que je voie Ta main dans tout ce qui m'entoure.`
};

MIROIR["34:37"] = {
  reference: "34:37",
  theme: ["richesse", "proximité", "méditation"],
  emotion: "Clarté, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Al-Wali"],
  mirrorVersion: `« Ce ne sont ni vos biens ni vos enfants qui vous rapprocheront de Nous. » Le miroir me place devant une vérité dérangeante. Les biens, les enfants — ce que nous chérissons le plus — ne nous rapprochent pas d'Allah. Seules les bonnes actions rapprochent. Le miroir m'interroge : sur quoi est-ce que je compte pour me rapprocher d'Allah ? Sur ce que je possède ou sur ce que je fais ?`,
  reflection: `La proximité d'Allah s'achète avec les actes, pas avec les possessions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ni biens ni enfants ne rapprochent. Seules les bonnes actions ('amal salih) rapprochent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai fait aujourd'hui qui me rapproche d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les biens et les enfants peuvent être des obstacles s'ils prennent la place d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne possède rien — il est. La créature ne possède rien — elle agit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne ses biens pour Allah se rapproche. Celui qui garde s'éloigne." }
  ],
  munajat: `Ya Ghani, mes biens ne me rapprochent pas de Toi. Seules mes actions comptent. Aide-moi à faire ce qui Te plaît.`
};

MIROIR["34:46"] = {
  reference: "34:46",
  theme: ["conseil", "sagesse", "méditation"],
  emotion: "Interpellation, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« Dis : Je vous exhorte à une seule chose : levez-vous pour Allah, par deux ou isolément, puis réfléchissez. » Le miroir me place devant une invitation simple mais profonde. Se lever pour Allah — physiquement et spirituellement. Puis réfléchir — méditer sur le message. Le miroir m'interroge : est-ce que je prends du temps pour me lever pour Allah et réfléchir ?`,
  reflection: `La réflexion est la clé de la compréhension. Se lever pour Allah, c'est se donner à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Un seul conseil : levez-vous pour Allah, puis réfléchissez (tafakkur)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je prends du temps pour me lever pour Allah et réfléchir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réflexion sans action est stérile. L'action sans réflexion est aveugle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers invite à la réflexion. Chaque créature est un sujet de contemplation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réfléchit sur le message d'Allah le comprend et le vit." }
  ],
  munajat: `Ya Hadi, je me lève pour Toi. Donne-moi la capacité de réfléchir sur Ton message et de le comprendre vraiment.`
};

// Surah 35 - Fatir (The Originator)
MIROIR["35:1"] = {
  reference: "35:1",
  theme: ["création", "anges", "méditation"],
  emotion: "Émerveillement, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Fatir", "Al-Khaliq"],
  mirrorVersion: `« Louange à Allah, Créateur des cieux et de la terre, Qui a fait des anges des messagers. » Le miroir me place devant la créativité divine. « Fatir » — l'Originateur, Celui qui crée sans modèle. Les anges, les cieux, la terre — tout est Sa création originale. Le miroir m'interroge : est-ce que je contemple la créativité d'Allah ? Est-ce que je Le loue pour Son œuvre ?`,
  reflection: `Allah est l'Originateur. Il crée sans précédent. Sa créativité est infinie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fatir » — l'Originateur. Les anges comme messagers (rusul) avec des ailes (ajniha)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je contemple de la création d'Allah ? Qu'est-ce qui m'émerveille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La créativité d'Allah n'a pas de limite. Chaque créature est unique, originale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est une création originale. Pas de modèle précédent. Tout est neuf." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la créativité d'Allah découvre sa propre capacité à créer." }
  ],
  munajat: `Ya Fatir, Tu es l'Originateur de tout. Je Te loue pour Ta créativité infinie. Fais que je voie chaque créature comme unique.`
};

MIROIR["35:28"] = {
  reference: "35:28",
  theme: ["connaissance", "crainte", "sagesse"],
  emotion: "Humilité, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khashi'a"],
  mirrorVersion: `« Parmi les serviteurs d'Allah, seuls les savants Le craignent. » Le miroir me montre le lien entre la connaissance et la crainte. Plus on connaît Allah, plus on Le craint — pas d'une peur panique, mais d'une révérence profonde. Les « savants » ('ulama) ici sont ceux qui connaissent vraiment, pas seulement intellectuellement. Le miroir m'interroge : ma connaissance d'Allah augmente-t-elle ma crainte révérencielle ?`,
  reflection: `La vraie connaissance produit la crainte révérencielle. Savoir sans craindre, ce n'est pas vraiment savoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yakhsha Allah min 'ibadihi al-'ulama » — seuls les savants Le craignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais Allah ? Est-ce que ma connaissance produit de la crainte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte sans connaissance est superstition. La connaissance sans crainte est orgueil." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers « connaît » son Créateur et Lui obéit par sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment Allah ne peut pas ne pas Le craindre avec amour." }
  ],
  munajat: `Ya 'Alim, augmente ma connaissance de Toi. Fais que cette connaissance produise en moi une crainte révérencielle, pas de la peur.`
};

MIROIR["35:41"] = {
  reference: "35:41",
  theme: ["soutien", "puissance", "méditation"],
  emotion: "Confiance, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qayyum", "Al-Hafiz"],
  mirrorVersion: `« Allah retient les cieux et la terre pour qu'ils ne s'écartent point. » Le miroir me place devant le soutien constant d'Allah. Sans Lui, les cieux et la terre s'effondreraient. Sa création est maintenue par Sa puissance. Le miroir m'interroge : est-ce que je réalise que tout est maintenu par Allah ? Y compris moi ?`,
  reflection: `L'univers ne tient pas par lui-même — il tient par Allah. Chaque instant est un miracle de maintien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yumsiku as-samawati wa al-ard » — Il retient les cieux et la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui tient dans ma vie sans Allah ? Rien. Tout est maintenu par Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si les cieux tiennent, je peux faire confiance que je tiendrai aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est maintenu par Allah. Chaque atome est dans Sa main." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise que tout est maintenu par Allah n'a plus peur de l'effondrement." }
  ],
  munajat: `Ya Qayyum, Tu retiens tout. Retiens-moi aussi. Ne me laisse pas m'effondrer. Maintiens-moi par Ta puissance.`
};

// Surah 36 - Ya-Sin
MIROIR["36:1"] = {
  reference: "36:1",
  theme: ["révélation", "sagesse", "méditation"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Aziz"],
  mirrorVersion: `« Ya Sin. Par le Coran plein de sagesse. » Le miroir me place devant le cœur du Coran. Ya-Sin est appelée « le cœur du Coran ». Ces lettres mystérieuses ouvrent une sourate de sagesse profonde. Le miroir m'interroge : est-ce que je lis le Coran comme une source de sagesse ? Est-ce que je médite sur ses mystères ?`,
  reflection: `Le Coran est sagesse. Chaque lettre, chaque mot porte une profondeur infinie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya Sin » — deux lettres mystérieuses. « Coran hakim » — plein de sagesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que le Coran m'enseigne aujourd'hui ? Quelle sagesse puis-je en tirer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les lettres mystérieuses rappellent que tout n'est pas rationnel. Il y a des mystères." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers contient des mystères. Le Coran en contient aussi. La sagesse est dans l'acceptation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les lettres mystérieuses s'ouvre à l'indicible." }
  ],
  munajat: `Ya Hakim, ouvre-moi à la sagesse du Coran. Fais que je dépasse la lecture superficielle pour toucher les mystères.`
};

MIROIR["36:5"] = {
  reference: "36:5",
  theme: ["révélation", "guidance", "miséricorde"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Ar-Rahim"],
  mirrorVersion: `« Révélation du Puissant, du Très Miséricordieux. » Le miroir me montre la nature du Coran. Il vient de « Al-'Aziz » — le Puissant, l'Invincible. Et de « Ar-Rahim » — le Très Miséricordieux. Puissance et miséricorde ensemble. Le miroir m'interroge : est-ce que je reçois le Coran comme venant du Puissant Miséricordieux ?`,
  reflection: `Le Coran est la parole du Puissant Miséricordieux. Il est à la fois autorité et tendresse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-'Aziz ar-Rahim » — révélation du Puissant, du Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je reçois le Coran ? Comme une contrainte ou comme une miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans miséricorde effraie. La miséricorde sans puissance est impuissante. Allah est les deux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers manifeste la puissance et la miséricorde d'Allah. Le Coran les articule." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme miséricorde du Puissant est transformé par les deux." }
  ],
  munajat: `Ya 'Aziz, Ya Rahim, Ton Coran est ta parole. Reçois-moi avec Sa puissance et Sa miséricorde.`
};

MIROIR["36:36"] = {
  reference: "36:36",
  theme: ["création", "miracle", "méditation"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Gloire à Celui qui a créé de toutes choses des couples. » Le miroir me place devant la dualité dans la création. Le masculin et le féminin, le jour et la nuit, le positif et le négatif — tout est en couple. Cette dualité n'est pas une faille, c'est une perfection. Le miroir m'interroge : est-ce que je vois la beauté dans les opposés ?`,
  reflection: `La création est faite de couples. L'opposition crée l'harmonie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulli shay'in » — de toute chose. « Azwaj » — des couples, des paires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels « couples » dans ma vie ? Les contrastes que j'accepte et ceux que je rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le couple n'est pas une division — c'est une complémentarité. L'un a besoin de l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait de dualités. L'électron et le proton, le jour et la nuit, l'inspiration et l'expiration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la sagesse des couples comprend l'harmonie de l'existence." }
  ],
  munajat: `Ya Khaliq, Tu as créé toutes choses en couples. Fais que je voie la complémentarité partout, pas la division.`
};

MIROIR["36:58"] = {
  reference: "36:58",
  theme: ["paix", "paradis", "récompense"],
  emotion: "Espérance, sérénité",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Karim"],
  mirrorVersion: `« Salam ! Parole de la part d'un Seigneur très miséricordieux. » Le miroir me place devant le salut du Paradis. « Salam » — paix. Le mot le plus beau, prononcé par le Seigneur Lui-même. Le Paradis n'est pas seulement des plaisirs — c'est d'abord la paix. Le miroir m'interroge : est-ce que je cherche la paix ici-bas ? Est-ce que je la prépare pour l'au-delà ?`,
  reflection: `La paix est le don suprême. Le Paradis, c'est d'abord la paix avec Allah, avec soi, avec tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salam » — paix. « Qawlan min Rabbin Rahim » — une parole du Seigneur Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche la paix ? Est-ce que je la prépare pour l'éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix du Paradis commence ici. Celui qui est en paix maintenant la goûte déjà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tend vers l'équilibre, la paix. Le Paradis est l'équilibre parfait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend « Salam » d'Allah ici-bas l'entendra aussi dans l'au-delà." }
  ],
  munajat: `Ya Salam, fais que j'entende Ton « Salam » maintenant et pour l'éternité. Donne-moi la paix ici et là-bas.`
};

MIROIR["36:70"] = {
  reference: "36:70",
  theme: ["coran", "guidance", "vie"],
  emotion: "Espérance, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muhyi"],
  mirrorVersion: `« Pour avertir quiconque est vivant. » Le miroir me montre que le Coran est pour « quiconque est vivant ». La vie ici n'est pas seulement biologique — c'est la vie du cœur. Celui qui est vivant intérieurement peut recevoir l'avertissement. Le miroir m'interroge : suis-je vivant ? Mon cœur est-il réceptif ?`,
  reflection: `La vraie vie est la vie du cœur. Le Coran s'adresse aux cœurs vivants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kana hayyan » — quiconque est vivant. Le Coran avertit les vivants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il vivant ? Réceptif au message ? Ou endurci, mort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran vivifie les cœurs morts. Sa lecture peut ressusciter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie est partout dans l'univers. Le Coran est la vie pour les âmes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran avec un cœur vivant reçoit la vie éternelle." }
  ],
  munajat: `Ya Muhyi, vivifie mon cœur. Fais que je sois au nombre des vivants qui entendent Ton avertissement et Te suivent.`
};

MIROIR["36:82"] = {
  reference: "36:82",
  theme: ["puissance", "commandement", "création"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Amr"],
  mirrorVersion: `« Sa commande, quand Il veut une chose, est de dire : 'Sois', et elle est. » Le miroir me place devant la puissance absolue du commandement divin. « Kun fayakun » — sois, et c'est. Pas de délai, pas d'effort, pas de résistance. La parole suffit. Le miroir m'interroge : est-ce que je vis en confiance dans ce pouvoir ?`,
  reflection: `La parole d'Allah crée instantanément. Rien ne résiste à Son « Sois ».`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama amruhu idha arada shay'an an yaqula lahu kun fayakun » — Son ordre : sois, et c'est." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends qui semble impossible ? Le « Sois » d'Allah peut tout." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah peut dire « Sois » à l'univers, Il peut le dire à ma situation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à « Sois ». Chaque créature existe par Sa parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à « Kun fayakun » n'est jamais bloqué." }
  ],
  munajat: `Ya Qadir, dis « Sois » sur ma vie. Résous ce qui semble impossible. Je me confie à Ta parole toute-puissante.`
};

// ============================================
// SURAH 3 - AL-IMRAN (The Family of Imran)
// Complete coverage: ALL 200 verses
// ============================================

MIROIR["3:1"] = {
  reference: "3:1",
  theme: ["révélation", "foi", "méditation"],
  emotion: "Révérence profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Qayyum"],
  mirrorVersion: `« Alif, Lam, Mim. » Ces lettres mystérieuses ouvrent la sourate Al-Imran. Le miroir me place devant l'indicible, devant ce qui ne peut être traduit mais seulement ressenti. Les lettres isolées du Coran sont comme des portes sans clé visible — elles invitent à l'humilité devant le Mystère. Je ne comprends pas tout, et c'est précisément là que commence la vraie relation avec le Texte sacré. Ces trois lettres sont comme un souffle avant la parole, un silence avant la révélation.`,
  reflection: `Le mystère n'est pas un obstacle à la foi — c'est son socle. Ce que je ne comprends pas m'ouvre à ce qui me dépasse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alif Lam Mim » — trois lettres isolées qui ouvrent plusieurs sourates. Leur sens exact reste un secret divin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment réagis-je face à ce que je ne comprends pas ? Avec frustration ou avec ouverture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incompréhension n'est pas un échec — c'est une invitation à dépasser l'intellect pour entrer dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est écrit dans un langage mystérieux. Les scientifiques déchiffrent des fragments, le croyant accepte le Mystère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ces lettres sont le nom même de Allah dans une forme que Seul Lui connaît pleinement." }
  ],
  munajat: `Ya Allah, je ne comprends pas Tes mystères, mais je T'aime. Fais que mon ignorance soit une porte vers Ta connaissance.`
};

MIROIR["3:2"] = {
  reference: "3:2",
  theme: ["présence", "confiance", "méditation"],
  emotion: "Ancrage absolu",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Qayyum"],
  mirrorVersion: `« Allah ! Point de divinité à part Lui, le Vivant, Celui qui subsiste par Lui-même. » Ce verset reprend les premiers mots d'Ayat al-Kursi. Le miroir me place devant le fondement de toute spiritualité : l'existence absolue d'Allah. « Al-Hayy » — le Vivant. « Al-Qayyum » — le Subsistant. Ces deux noms disent tout : Il est, et Il est par Lui-même. Tout le reste existe par Lui, dépend de Lui, retourne à Lui.`,
  reflection: `La vie véritable est en Allah. Ma vie est un emprunt, une participation à Sa vie éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Deux noms essentiels : Al-Hayy (le Vivant) et Al-Qayyum (le Subsistant). Ils apparaissent aussi dans Ayat al-Kursi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi repose ma vie ? Sur des bases fragiles ou sur le Vivant qui ne meurt pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je cherche la stabilité dans ce qui change — alors que la seule stabilité est en Celui qui ne change pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers est maintenu par le Vivant. Chaque atome existe par Sa volonté continue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'ancre en Al-Hayy reçoit une participation de vie qui transcende la mort." }
  ],
  munajat: `Ya Hayy, ya Qayyum, Tu es la Vie et je vis par Toi. Fais que je m'ancre en Toi, pas dans ce qui passe.`
};

MIROIR["3:3"] = {
  reference: "3:3",
  theme: ["révélation", "guidance", "foi"],
  emotion: "Gratitude profonde",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Il a fait descendre sur toi le Livre avec la vérité, confirmant ce qui était avant lui. » Le miroir me montre la continuité de la révélation divine. Le Coran n'est pas une nouveauté isolée — il est le maillon final d'une chaîne de lumière qui traverse les âges. Les Écritures précédentes sont honorées et confirmées. Cette vision détruit l'exclusivisme étroit : la vérité n'est pas apparue avec moi, elle a toujours été là, sous différentes formes.`,
  reflection: `La vérité est une, ses expressions sont multiples à travers le temps et les prophètes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Musaddiqan lima bayna yadayhi » — confirmant ce qui était avant lui. Le Coran confirme la Torah et l'Évangile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité où qu'elle se trouve ? Ou est-ce que je la limite à mon groupe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confirmation du passé n'est pas une soumission — c'est une reconnaissance de l'unité de la Source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est une, les lampes sont multiples. Chaque révélation est une lampe allumée par le même Feu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'unité de la révélation voit l'unité de l'Humanité sous Dieu." }
  ],
  munajat: `Ya Nur, Tu as envoyé la lumière à travers les âges. Fais que je reconnaisse Ta vérité partout où elle brille.`
};

MIROIR["3:4"] = {
  reference: "3:4",
  theme: ["justice", "jugement", "guidance"],
  emotion: "Sérieux responsable",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Adl"],
  mirrorVersion: `« Auparavant, comme guide pour les gens, et Il a fait descendre le Discernement. » Le miroir me place devant la responsabilité de la guidance reçue. « Al-Furqan » — le Discernement — est ce qui permet de distinguer le vrai du faux, le bien du mal. Ce don n'est pas un privilège passif : c'est un outil actif. Si je ne l'utilise pas pour discerner, je gaspille le don. Le discernement n'est pas seulement intellectuel — il est spirituel, moral, pratique.`,
  reflection: `Le discernement est un muscle spirituel. Plus je l'utilise, plus il se développe. Moins je l'utilise, plus il s'atrophie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-Furqan » — le Discernement, ce qui sépare la vérité de l'erreur. Un nom aussi donné à la Torah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise le discernement dans mes choix quotidiens ? Ou est-ce que je suis aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le discernement ne sépare pas seulement — il unit ce qui doit être uni et sépare ce qui doit être séparé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque chose a sa place. Le discernement me révèle ma place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le discernement ultime est de distinguer Allah de tout ce qui n'est pas Lui." }
  ],
  munajat: `Ya Hakam, Tu as donné le Discernement. Fais que je l'utilise pour voir clair dans ma vie. Ne me laisse pas dans la confusion.`
};

MIROIR["3:5"] = {
  reference: "3:5",
  theme: ["omniscience", "responsabilité", "présence"],
  emotion: "Conscience éveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Khabir"],
  mirrorVersion: `« Certes, rien n'est caché à Allah de ce qui existe sur la terre et dans le ciel. » Le miroir me montre que je suis totalement vu. Pas un geste, pas une pensée, pas une intention n'échappe à Sa connaissance. Cette vérité peut effrayer — mais elle peut aussi libérer. Je n'ai pas à me cacher, car c'est impossible. Je n'ai pas à me justifier devant les autres, car Celui qui voit tout me comprend mieux que quiconque.`,
  reflection: `Être vu par Allah est à la fois un rappel de responsabilité et une invitation à l'authenticité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha la ya'fuzuhu shay'un » — certes, rien n'échappe à Allah. Son omniscience est totale." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Et si je réalise que je ne peux rien cacher, qu'est-ce qui change ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'omniscience divine n'est pas une surveillance oppressive — c'est une attention aimante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est transparent devant son Créateur. L'obscurité n'existe que pour nos yeux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme s'il était vu par Allah devient transparent à lui-même." }
  ],
  munajat: `Ya Alim, Tu me vois totalement. Fais que je vive sous Ton regard avec amour, pas avec peur. Aide-moi à être vrai.`
};

MIROIR["3:6"] = {
  reference: "3:6",
  theme: ["création", "forme", "sagesse"],
  emotion: "Émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« C'est Lui qui vous donne forme dans les matrices comme Il veut. » Le miroir me place devant le mystère de ma propre existence. Je n'ai pas choisi ma forme, mes aptitudes, mon contexte. Tout cela m'a été donné avant même que je sache demander. Cette forme que je critique parfois, ces capacités que j'envie aux autres, ce corps que j'accepte ou rejette — tout est un don configuré par la Sagesse divine.`,
  reflection: `Ma forme est un cadeau, pas un hasard. L'accepter, c'est accepter le Donateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi yusawwirukum fi al-arham » — c'est Lui qui vous forme dans les matrices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma forme ? Ou est-ce que je passe ma vie à vouloir être autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La forme que je critique est précisément celle à travers laquelle je peux exprimer ma plus haute vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est façonnée pour son rôle. La diversité des formes reflète la richesse du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie forme n'est pas le corps — c'est l'âme. Le corps est le vêtement, l'âme est le porteur." }
  ],
  munajat: `Ya Musawwir, Tu m'as façonné selon Ta sagesse. Fais que je m'accepte et que je Te remercie pour ce don. Aide-moi à être beau intérieurement.`
};

MIROIR["3:7"] = {
  reference: "3:7",
  theme: ["révélation", "foi", "humilité"],
  emotion: "Confiance sereine",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Hakim"],
  mirrorVersion: `« C'est Lui qui a fait descendre sur toi le Livre : il s'y trouve des versets clairs... et d'autres ambiguës. » Le miroir me montre la sagesse de la structure du Coran. Les versets clairs (muhkamat) sont le fondement, les ambiguës (mutashabihat) sont des tests. Ceux qui cherchent la discorde suivent les ambiguës. Ceux qui sont enracinés dans la science disent : « Nous y croyons, tout vient de notre Seigneur. » L'humilité devant le Mystère est le signe de la maturité spirituelle.`,
  reflection: `La foi n'a pas besoin de tout comprendre. Elle a besoin de tout accepter venant de la Source.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muhkamat » — claires, « mutashabihat » — ambiguës. Les premières sont la mère du Livre, les secondes sont des tests." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face aux passages difficiles du Coran ? Avec curiosité saine ou avec rejet précipité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ambiguïté n'est pas une faille — c'est une invitation à dépasser l'explication pour entrer dans la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La réalité elle-même a ses zones claires et ses mystères. La science progresse dans les clartés, la foi embrasse les deux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ceux qui sont enracinés dans la science savent que le mystère fait partie de la connaissance." }
  ],
  munajat: `Ya Alim, il y a des choses que je comprends et d'autres qui m'échappent. Fais que je dise toujours : « Nous croyons, tout vient de notre Seigneur. »`
};

MIROIR["3:8"] = {
  reference: "3:8",
  theme: ["confiance", "guidance", "prière"],
  emotion: "Humilité suppliante",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Matin"],
  mirrorVersion: `« Seigneur ! Ne laisse pas nos cœurs dévier après que Tu nous as guidés. » Cette supplication est attribuée aux savants dotés de connaissance. Le miroir me montre la fragilité de la guidance : elle peut être perdue. Ce n'est pas parce que j'ai été guidé hier que je le serai demain. La guidance n'est pas un acquis définitif — elle est un état à préserver. Cette prière exprime la conscience de cette fragilité et la demande de protection.`,
  reflection: `La guidance est un don qu'on peut perdre. La meilleure protection est de la demander chaque jour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tuzigh qulubana » — ne fais pas dévier nos cœurs. Le cœur peut dévier même après la guidance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie pour garder la guidance ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de ne pas dévier est elle-même une protection. Celui qui demande reste sur le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est en mouvement. La stabilité n'est pas statique — elle est un équilibre dynamique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la déviation est précisément celui qui est le moins à risque de dévier." }
  ],
  munajat: `Ya Rabb, Tu m'as guidé. Ne me laisse pas partir. Protège mon cœur de la déviation. Accorde-moi la guidance jusqu'au bout.`
};

MIROIR["3:9"] = {
  reference: "3:9",
  theme: ["foi", "résurrection", "confiance"],
  emotion: "Espérance ferme",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Jami'"],
  mirrorVersion: `« Seigneur ! C'est Toi qui rassembleras les gens pour un jour au sujet duquel il n'y a pas de doute. » Le miroir me place devant la certitude du Jour Final. Les gens seront rassemblés, jugés, chacun recevra son dû. Cette certitude n'est pas une menace — c'est une promesse de justice. Le croyant demande à ne pas être égaré parmi ceux qui nient ce jour. La prière devient une protection active.`,
  reflection: `La certitude du Jugement transforme le présent. Chaque acte devient un investissement pour ce jour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawmin la rayba fihi » — un jour au sujet duquel il n'y a pas de doute. La résurrection est certaine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de ce jour ? Ou est-ce que je vis comme si tout s'arrêtait à la mort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur du Jugement n'est pas la terreur — c'est l'aiguillon qui pousse vers le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers ce rassemblement. Chaque créature retourne à son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son rassemblement avec Allah aujourd'hui n'a pas peur de demain." }
  ],
  munajat: `Ya Jami', Tu nous rassembleras. Fais que je sois parmi ceux qui T'ont obéi. Ne m'égare pas parmi les négateurs.`
};

MIROIR["3:10"] = {
  reference: "3:10",
  theme: ["avertissement", "richesse", "jugement"],
  emotion: "Sérieux profond",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Malik"],
  mirrorVersion: `« Ceux qui ont mécru, ni leurs biens ni leurs enfants ne leur serviront à rien contre Allah. » Le miroir me montre l'illusion des protections matérielles. Nous accumulons des biens, nous nous entourons de personnes, nous croyons que tout cela nous protégera. Mais au moment décisif, face à Allah, rien de tout cela ne compte. La richesse qui n'a pas été dépensée dans le bien devient un témoin à charge.`,
  reflection: `Ce que j'amasse ici-bas m'accompagne-t-il ? Seul ce que je donne dans le chemin d'Allah me suit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan tugniya 'anhum amwaluhum » — leurs biens ne leur serviront à rien. Le feu est leur destination." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je compte pour ma protection ? Sur mes biens ou sur Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse n'est pas mauvaise en soi — c'est l'amour de la richesse qui égare quand elle remplace Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas la richesse monétaire. Seul l'homme a inventé cette fiction de protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie richesse est ce qui te suit après la mort : tes œuvres, ta piété, ta relation avec Allah." }
  ],
  munajat: `Ya Ghani, Tu es le Vraiment Riche. Fais que je ne compte pas sur mes biens mais sur Toi. Apprends-moi à investir dans l'éternel.`
};

MIROIR["3:11"] = {
  reference: "3:11",
  theme: ["avertissement", "histoire", "jugement"],
  emotion: "Gravité réfléchie",
  difficulty: "débutant",
  relatedNames: ["Al-Shadid", "Al-Muntaqim"],
  mirrorVersion: `« Comme le comportement des gens de Pharaon et de ceux qui avant eux ont traité de mensonge Nos signes. » Le miroir me place devant l'histoire comme enseignement. Les peuples qui ont nié la vérité ont tous subi le même sort : la destruction. Ce n'est pas une menace arbitraire — c'est une loi spirituelle. Ceux qui s'opposent à la vérité finissent par être engloutis par leurs propres mensonges.`,
  reflection: `L'histoire n'est pas un récit du passé — c'est un miroir pour le présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kada'bi ali Fir'awn » — comme le comportement des gens de Pharaon. L'histoire se répète pour ceux qui n'apprennent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les mêmes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des peuples passés n'est pas une joie — c'est une tristesse et un avertissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne selon des lois. Les lois spirituelles sont aussi implacables que les lois physiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les peuples détruits comprend que la miséricorde d'Allah précède Sa colère." }
  ],
  munajat: `Ya Rabb, l'histoire est un enseignement. Fais que j'apprenne sans avoir à expérimenter la destruction. Garde-moi sur la vérité.`
};

MIROIR["3:12"] = {
  reference: "3:12",
  theme: ["avertissement", "justice", "vérité"],
  emotion: "Certitude calme",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Jami'"],
  mirrorVersion: `« Dis à ceux qui ont mécru : Vous serez vaincus et rassemblés vers l'Enfer. » Le miroir me montre la certitude de l'issue. Le mal, malgré ses apparences de puissance, est voué à l'échec. La vérité finit par triompher, même si le chemin semble long. Cette certitude n'est pas une complaisance — c'est un rappel de la direction de l'histoire sous la direction divine.`,
  reflection: `Le triomphe de la vérité n'est pas une question de « si » mais de « quand ».`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sayughlabuna » — ils seront vaincus. Le verbe est au passif : Allah est l'Acteur, mais Sa méthode est cachée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je dans cette histoire ? Du côté de la vérité ou du côté de l'erreur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défaite des mécréants n'est pas une victoire personnelle — c'est un rappel de la justice divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, l'ordre finit par triompher du chaos. La vérité est l'ordre, le mensonge est le chaos." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que la vérité triomphe ne s'impatiente pas devant les apparences contraires." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je sois du côté de la vérité. Aide-moi à patienter jusqu'à Ta victoire.`
};

MIROIR["3:13"] = {
  reference: "3:13",
  theme: ["signes", "victoire", "foi"],
  emotion: "Gratitude émerveillée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nasir", "Al-Qadir"],
  mirrorVersion: `« Il y avait déjà pour vous un signe dans les deux troupes qui s'affrontèrent. » Le miroir me renvoie à la bataille de Badr, où une petite troupe de croyants a vaincu une armée plus nombreuse. Ce n'était pas une victoire militaire ordinaire — c'était un signe. Allah a montré que la victoire ne dépend pas des nombres mais de la foi et du soutien divin. Les signes d'Allah sont partout pour ceux qui savent voir.`,
  reflection: `Les victoires inexpliquées sont des rappels : la réussite vient d'Allah, pas des causes apparentes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kanat li-ayatin » — il y avait un signe. La bataille de Badr est un miracle historique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes ai-je vus dans ma vie ? Est-ce que je les reconnais comme venant d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire apparente cache souvent une défaite spirituelle. La défaite apparente cache souvent une victoire spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe pour ceux qui réfléchissent. Chaque événement est un message." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le signe le plus grand est celui que Allah place dans ton cœur : la certitude de Sa présence." }
  ],
  munajat: `Ya Nasir, Tu donnes la victoire à qui Tu veux. Fais que je sois parmi ceux qui Te soutiennent pour que Tu me soutiennes.`
};

MIROIR["3:14"] = {
  reference: "3:14",
  theme: ["désirs", "monde", "épreuve"],
  emotion: "Vigilance lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Bari"],
  mirrorVersion: `« L'amour des plaisirs a été enjolivé aux yeux des hommes : femmes, enfants, trésors thésaurisés... » Le miroir me montre la nature de l'épreuve terrestre. Ces choses ne sont pas mauvaises en soi — elles sont des dons. Mais quand elles deviennent le but au lieu du moyen, elles deviennent des idoles. L'amour de ces choses est naturel, mais il doit être ordonné : aimer Allah d'abord, aimer ces choses en Allah.`,
  reflection: `Les plaisirs de ce monde sont des échelles vers Dieu ou des barrières, selon l'orientation du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Zuyyina li-nnas hubbu al-shahawat » — l'amour des plaisirs a été enjolivé. C'est le test terrestre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aime le plus au monde ? Cet amour est-il ordonné vers Allah ou contre Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces plaisirs peuvent être des portes vers Allah quand ils sont reçus avec gratitude et partagés avec générosité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est beau. La beauté n'est pas un piège — c'est une invitation à reconnaître le Beau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime les créatures en Allah ne s'y attache pas. Il les traverse comme on traverse un pont." }
  ],
  munajat: `Ya Hakim, j'aime les plaisirs de ce monde. Fais que je les aime en Toi, pas contre Toi. Purifie mon amour.`
};

MIROIR["3:15"] = {
  reference: "3:15",
  theme: ["paradis", "récompense", "promesse"],
  emotion: "Espérance joyeuse",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wadud"],
  mirrorVersion: `« Dis : Puis-je vous informer de ce qui est meilleur que cela ? Pour ceux qui craignent Allah, il y aura des Jardins sous lesquels coulent les ruisseaux. » Le miroir me montre la réponse divine à l'amour des biens terrestres. Il ne dit pas « n'aimez pas » — Il dit « il y a mieux ». Le Paradis n'est pas l'absence de plaisir — c'est le plaisir purifié, éternel, sans amertume. La comparaison est claire : temporaire versus éternel, limité versus illimité.`,
  reflection: `Le Paradis est la réponse d'Allah à nos désirs légitimes, mais dans leur forme accomplie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khayrun min dhalikum » — meilleur que cela. Le Paradis dépasse tout ce que ce monde peut offrir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le Paradis ? Ou est-ce que je me contente de ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les plaisirs de ce monde sont des ombres du Paradis. Les aimer, c'est aimer l'ombre, pas la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté de l'univers est un rappel de la beauté du Paradis. Chaque fleur en est une invitation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a goûté au Paradis dans cette vie par la proximité divine n'a pas peur de le perdre." }
  ],
  munajat: `Ya Rabb, Tu as promis le Paradis. Fais que je le désire plus que tout. Prépare-moi pour cette demeure éternelle.`
};

MIROIR["3:16"] = {
  reference: "3:16",
  theme: ["prière", "pardon", "piété"],
  emotion: "Supplication humble",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Rahim"],
  mirrorVersion: `« Ceux qui disent : Seigneur, nous avons cru, pardonne-nous nos péchés et protège-nous du châtiment du Feu. » Le miroir me montre la prière des croyants sincères. Ils ne disent pas « nous sommes parfaits » — ils disent « nous avons cru, pardonne-nous ». La foi n'est pas la perfection — c'est la reconnaissance de l'imperfection et la demande de pardon. Cette prière unit la conscience de la faute et l'espérance du pardon.`,
  reflection: `La prière du croyant est toujours double : reconnaissance de la faute et confiance dans le pardon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ighfir lana dhunubana » — pardonne-nous nos péchés. La demande de pardon suit immédiatement la déclaration de foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma prière quotidienne ? Est-ce que je demande le pardon comme si j'en avais besoin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas donné à ceux qui se croient parfaits — il est donné à ceux qui se savent pécheurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en état de soumission parfaite. Seul l'homme a besoin de demander pardon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La demande de pardon est elle-même une forme d'adoration qui élève le demandeur." }
  ],
  munajat: `Ya Ghaffur, j'ai cru en Toi. Pardonne-moi mes péchés et protège-moi du Feu. Je reviens à Toi.`
};

MIROIR["3:17"] = {
  reference: "3:17",
  theme: ["patience", "vérité", "prière"],
  emotion: "Persévérance sereine",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabur", "Al-Siddiq"],
  mirrorVersion: `« Les endurants, les véridiques, les obéissants, ceux qui dépensent et qui demandent pardon avant l'aube. » Le miroir me présente le portrait des élus. Cinq qualités : la patience dans l'épreuve, la vérité dans la parole et l'action, l'obéissance à Allah, la générosité, et la prière nocturne. Ces qualités ne sont pas innées — elles se cultivent. La prière avant l'aube (tahajjud) est le secret de tout le reste.`,
  reflection: `La grandeur spirituelle se construit dans l'obscurité, avant l'aube, quand personne ne voit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-sabirin, al-sadiqin, al-qanitin, al-munfiqin, al-mustaghfirin bi-al-ashar » — cinq qualités des croyants sincères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Laquelle de ces qualités me manque le plus ? Comment puis-je la cultiver ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces qualités ne sont pas des conditions pour être aimé d'Allah — elles sont des fruits de Son amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube est le moment où la création se réveille. Le croyant se réveille avant pour accueillir le jour avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le tahajjud est la prière des élus. C'est là que se négocient les affaires importantes avec le Roi." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les endurants, les véridiques, les obéissants. Éveille-moi avant l'aube pour Te rencontrer.`
};

MIROIR["3:18"] = {
  reference: "3:18",
  theme: ["témoignage", "foi", "justice"],
  emotion: "Certitude solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Shahid", "Al-Haqq"],
  mirrorVersion: `« Allah atteste, ainsi que les Anges et les doués de science, qu'il n'y a de divinité que Lui. » Le miroir me place devant le témoignage suprême. Allah Lui-même témoigne de Son unicité — et ce témoignage est soutenu par les anges et les savants. La hiérarchie est claire : Allah d'abord, puis les anges, puis les hommes de science. Le témoignage n'est pas seulement verbal — il est existentiel.`,
  reflection: `Le témoignage de l'unicité est le fondement de toute l'existence. Tout ce qui existe en témoigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Shahida Allahu annahu la ilaha illa huwa » — Allah a témoigné qu'il n'y a de divinité que Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon témoignage est cohérent avec ma vie ? Dis-je la ilaha illa Allah par mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de mon témoignage — c'est moi qui ai besoin de Le témoigner pour être complet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de l'unicité par son ordre, sa beauté, sa soumission aux lois divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le témoignage parfait est celui où le témoin devient ce qu'il témoigne." }
  ],
  munajat: `Ya Shahid, Tu as témoigné de Ton unicité. Fais que je sois parmi ceux qui témoignent par leur vie, pas seulement par leurs mots.`
};

MIROIR["3:19"] = {
  reference: "3:19",
  theme: ["religion", "soumission", "vérité"],
  emotion: "Clarté absolue",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Hadi"],
  mirrorVersion: `« Certes, la religion acceptée d'Allah, c'est l'Islam. » Le miroir me place devant la définition de la vraie religion. « Islam » signifie soumission — pas à un dogme, mais à Allah Lui-même. Cette soumission est la religion de tous les prophètes, de Adam à Muhammad. Ce n'est pas une religion parmi d'autres — c'est LA religion, l'attitude juste de la créature devant son Créateur.`,
  reflection: `L'Islam n'est pas une innovation — c'est le retour à la religion primordiale de la soumission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-dina 'inda Allahi al-islam » — certes, la religion auprès d'Allah est l'Islam (la soumission)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis réellement soumis ? Ou est-ce que je dis « musulman » tout en luttant contre la volonté d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission n'est pas une perte de liberté — c'est la seule vraie liberté : être ce qu'on est censé être." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est « musulman » par nature : soumis aux lois divines. Seul l'homme a le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sommet de la soumission est de vouloir ce qu'Allah veut — et de le vouloir parce qu'Il le veut." }
  ],
  munajat: `Ya Rabb, la soumission est Ta religion. Fais que je me soumette vraiment, pas en paroles seulement. Accepte mon islam.`
};

MIROIR["3:20"] = {
  reference: "3:20",
  theme: ["dialogue", "appel", "liberté"],
  emotion: "Invitation respectueuse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« S'ils disputent avec toi, dis : Je me suis soumis à Allah ainsi que ceux qui me suivent. » Le miroir me montre la posture du croyant face à la dispute. On n'impose pas — on témoigne. On ne force pas — on invite. La religion est une affaire de conviction personnelle, pas de contrainte extérieure. « Avez-vous une preuve ? » demande le verset — la preuve est interne, dans le cœur qui a goûté à la soumission.`,
  reflection: `La vérité n'a pas besoin de violence pour se défendre. Elle se défend par elle-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in hajuji fa-qul aslamtu wajhi lillahi » — s'ils disputent, dis : je me suis soumis à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face à la dispute religieuse ? Avec colère ou avec témoignage calme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute est souvent un signe que le cœur n'a pas vraiment goûté à la soumission. Le soumis n'a pas besoin de prouver." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne dispute pas — il est. Le croyant mature ne dispute pas — il témoigne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La meilleure réponse à la dispute est l'état de celui qui a vraiment rencontré Allah." }
  ],
  munajat: `Ya Hadi, guide ceux qui disputent. Fais que je sois un témoin clair, pas un disputant amer. Donne-moi la sagesse de l'appel.`
};

MIROIR["3:21"] = {
  reference: "3:21",
  theme: ["injustice", "avertissement", "jugement"],
  emotion: "Indignation juste",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui ne croient pas aux signes d'Allah, tuent sans raison les prophètes et tuent ceux qui ordonnent la justice... » Le miroir me montre l'extrême de l'injustice : tuer les messagers de Dieu et ceux qui prêchent la justice. Ce verset dénonce la violence contre la vérité. Aujourd'hui, cette violence peut prendre d'autres formes : le rejet, le mépris, l'exclusion de ceux qui parlent vrai.`,
  reflection: `La violence contre la vérité est aussi vieille que l'humanité. Le croyant doit la reconnaître et la dénoncer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yazununa bi-ayati Allahi jawran » — ils ne croient pas aux signes d'Allah par injustice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face à l'injustice ? Suis-je du côté des victimes ou des bourreaux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La violence contre les prophètes n'a pas réussi à éteindre leur message. La vérité survit à ses assassins." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne que l'injustice ne dure pas. L'équilibre finit par se rétablir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend la vérité aujourd'hui rejoint la chaîne des prophètes dans leur mission." }
  ],
  munajat: `Ya Adl, Tu es le Juste. Fais que je sois du côté de la justice. Ne permets pas que je sois complice de l'injustice par mon silence.`
};

MIROIR["3:22"] = {
  reference: "3:22",
  theme: ["jugement", "perdition", "avertissement"],
  emotion: "Tristesse lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Khabyr"],
  mirrorVersion: `« Ce sont ceux-là dont les œuvres sont devenues vaines ici-bas et dans l'au-delà. » Le miroir me montre le tragique du gaspillage spirituel. Des vies entières de travail, d'effort, d'ambition — mais orientées vers le mauvais but. Les œuvres ne sont pas comptées par leur quantité mais par leur direction. Celui qui court dans la mauvaise direction n'arrive nulle part.`,
  reflection: `La valeur d'une œuvre dépend de son intention. Sans bonne intention, l'effort est vain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Habitat a'maluhum » — leurs œuvres sont devenues vaines. Le vide au milieu de l'activité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes œuvres ? Sont-elles orientées vers Allah ou vers autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Une vie apparemment réussie peut être spirituellement vide. Une vie apparemment échouée peut être spirituellement pleine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, rien n'est perdu — sauf ce qui est orienté vers le néant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont les œuvres sont vides découvre que le vide était en lui, pas dans l'œuvre." }
  ],
  munajat: `Ya Rabb, ne permets pas que mes œuvres soient vaines. Orientées-les vers Toi. Donne-moi une intention pure.`
};

MIROIR["3:23"] = {
  reference: "3:23",
  theme: ["hypocrisie", "écriture", "jugement"],
  emotion: "Interpellation ferme",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Haqq"],
  mirrorVersion: `« N'as-tu pas vu ceux qui ont reçu une portion du Livre et qui sont appelés au Livre d'Allah pour qu'Il juge entre eux ? » Le miroir me montre l'hypocrisie de ceux qui croient en une partie de la révélation et en rejettent une autre. Ils acceptent quand ça les arrange, ils refusent quand ça les dérange. La vraie foi accepte tout le Livre, pas seulement ce qui convient à l'ego.`,
  reflection: `La sélection dans la révélation est une forme subtile de rébellion. On croit à condition que...`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Utluwa kitaba Allahi » — on les appelle au Livre d'Allah. Mais ils se détournent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'accepte du Coran ? Et qu'est-ce que je refuse ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Refuser une partie de la révélation, c'est refuser Celui qui l'a révélée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est indivisible. On ne peut pas prendre la lumière et rejeter la chaleur du même soleil." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation totale vient de la confiance totale en Celui qui révèle." }
  ],
  munajat: `Ya Rabb, fais que j'accepte tout Ton Livre. Ne permets pas que je sélectionne selon mes désirs. Soumets-moi à Ta parole entière.`
};

MIROIR["3:24"] = {
  reference: "3:24",
  theme: ["illusion", "jugement", "faux-espoir"],
  emotion: "Mise en garde solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Muhit"],
  mirrorVersion: `« C'est parce qu'ils disent : Le Feu ne nous touchera que pour quelques jours. » Le miroir me montre le danger des fausses assurances. Ils se sont menti à eux-mêmes, et leurs mensonges leur ont paru vrais. L'illusion n'est pas seulement l'erreur — c'est le confort dans l'erreur. La foi n'est pas ce qu'on imagine, c'est ce qu'Allah dit.`,
  reflection: `Les fausses certitudes sont les pires prisons. On croit être sauvé alors qu'on est perdu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan tamassana al-naru illa ayyaman ma'dudat » — le feu ne nous touchera que pour quelques jours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes fausses assurances ? Où est-ce que je me mens à moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir en la miséricorde d'Allah doit être fondé sur Ses conditions, pas sur nos inventions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas l'illusion. Seul l'homme peut se mentir à lui-même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie certitude vient d'Allah. Tout le reste est spéculation." }
  ],
  munajat: `Ya Haqq, détruis mes illusions. Ne permets pas que je me mente à moi-même. Donne-moi la vérité, même si elle me blesse.`
};

MIROIR["3:25"] = {
  reference: "3:25",
  theme: ["jugement", "réalité", "vérité"],
  emotion: "Réalisme spirituel",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Shahid"],
  mirrorVersion: `« Comment seront-ils quand Nous les aurons rassemblés pour un jour au sujet duquel il n'y a pas de doute ? » Le miroir me place devant l'inévitable rencontre. Toutes les illusions, tous les mensonges, toutes les excuses tomberont ce jour-là. Il n'y aura plus de place pour se cacher. La question « comment seront-ils ? » est une invitation à se préparer maintenant.`,
  reflection: `Le Jour du Jugement n'est pas une menace — c'est une réalité à laquelle se préparer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa idha jama'nahum li-yawmin la rayba fihi » — comment seront-ils quand Nous les aurons rassemblés pour un jour sans doute ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si ce jour était demain, comment serais-je ? Que changerais-je aujourd'hui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur de ce jour n'est pas une faiblesse — c'est le signe que le cœur est vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers ce rassemblement. Chaque créature sait qu'elle retourne à son Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour ce jour le rencontre chaque jour dans sa conscience." }
  ],
  munajat: `Ya Jami', ce jour viendra. Prépare-moi. Fais que je ne sois pas pris au dépourvu. Accorde-moi un cœur préparé.`
};

MIROIR["3:26"] = {
  reference: "3:26",
  theme: ["sagesse", "confiance", "méditation"],
  emotion: "Révérence souveraine",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malik", "Al-Mu'ti", "Al-Mani'"],
  mirrorVersion: `« Dis : Ô Allah, Maître de la royauté ! Tu donnes la royauté à qui Tu veux et Tu retires la royauté à qui Tu veux. » Ce verset me place devant la souveraineté absolue d'Allah. Le miroir me montre que tout pouvoir humain est un prêt, pas une propriété. Celui qui a le pouvoir aujourd'hui peut le perdre demain. Celui qui est faible aujourd'hui peut être élevé demain. Cette vision détruit l'orgueil des puissants et l'envie des faibles.`,
  reflection: `Tout pouvoir vient d'Allah et retourne à Lui. L'élévation et l'abaissement sont entre Ses mains.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Malakut » — la royauté, la souveraineté. Allah est le vrai Roi, les autres sont des locataires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel pouvoir ai-je ? Est-ce que je l'attribue à Allah ou est-ce que je m'en orgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte de pouvoir n'est pas une tragédie — c'est un rappel de la Source. L'élévation n'est pas un mérite — c'est un don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est faite de montées et de descentes. Tout pouvoir est temporaire, seule Sa souveraineté est éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend ce verset ne s'attache ni au pouvoir ni à son absence. Il est libre des deux." }
  ],
  munajat: `Ya Malik al-mulk, Tu es le Vrai Roi. Tout ce que j'ai vient de Toi. Garde-moi humble dans l'élévation et patient dans l'abaissement.`
};

MIROIR["3:27"] = {
  reference: "3:27",
  theme: ["création", "transformation", "puissance"],
  emotion: "Émerveillement absolu",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Tu fais pénétrer la nuit dans le jour et Tu fais pénétrer le jour dans la nuit. » Le miroir me montre la danse cosmique orchestrée par Allah. Le jour et la nuit ne s'opposent pas — ils se succèdent, s'entremêlent, se transforment. Cette transformation est la loi de l'univers et de nos vies. Les ténèbres deviennent lumière, la lumière devient ténèbres. Rien n'est figé, tout est en mouvement sous Sa main.`,
  reflection: `Les cycles de la vie reflètent les cycles cosmiques. Accepter le changement, c'est accepter le Créateur du changement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tuliju al-layla fi al-nahari wa tuliju al-nahara fi al-layl » — Tu fais pénétrer la nuit dans le jour et le jour dans la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels cycles traverse ma vie ? Est-ce que j'accepte la nuit comme j'accepte le jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit n'est pas l'absence de jour — c'est sa préparation. Les ténèbres portent la lumière en germe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier respire : expansion et contraction, jour et nuit, été et hiver. Le souffle cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les cycles comprend que chaque état est temporaire — et donc précieux." }
  ],
  munajat: `Ya Khaliq, Tu changes les saisons de ma vie. Fais que j'accepte la nuit comme le jour. Apprends-moi le rythme de Ta création.`
};

MIROIR["3:28"] = {
  reference: "3:28",
  theme: ["allégeance", "foi", "mise en garde"],
  emotion: "Vigilance claire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Nasir"],
  mirrorVersion: `« Que les croyants ne prennent pas les mécréants pour alliés au lieu des croyants. » Le miroir me montre la question de l'allégeance spirituelle. Ce n'est pas une question d'amitié humaine — c'est une question de loyauté fondamentale. À qui mon cœur appartient-il ? Si je choisis les ennemis de la vérité comme mes modèles, mes protecteurs, mes références, je me mets en danger spirituel.`,
  reflection: `L'allégeance n'est pas l'exclusion de l'autre — c'est la clarté sur qui on est et à qui on appartient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yattakhidha al-mu'minuna al-kafirina awliya' » — que les croyants ne prennent pas les mécréants pour alliés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes vrais alliés ? À qui je donne mon cœur et ma confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allégeance aux croyants n'est pas le rejet des autres — c'est la clarté des priorités." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque chose appartient à son créateur. L'homme a le choix de son allégeance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie loyauté est envers Allah. Tout le reste en découle naturellement." }
  ],
  munajat: `Ya Wali, Tu es mon Protecteur. Fais que mon allégeance soit claire. Ne permets pas que je me perde dans de fausses loyautés.`
};

MIROIR["3:29"] = {
  reference: "3:29",
  theme: ["secret", "connaissance", "vérité"],
  emotion: "Transparence totale",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Khabir"],
  mirrorVersion: `« Dis : Que vous cachiez ce qui est dans vos poitrines ou que vous le divulguiez, Allah le sait. » Le miroir détruit l'illusion du secret. Rien n'est caché à Allah — ni les pensées les plus intimes, ni les intentions les plus enfouies. Cette vérité est terrifiante pour celui qui a quelque chose à cacher, mais libératrice pour celui qui cherche la transparence.`,
  reflection: `La vie devant Allah est une vie sans masque. C'est la seule vraie liberté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tukhfi ma fi sudurikum aw tubduhu ya'lamhu Allah » — que vous le cachiez ou le divulguiez, Allah le sait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Et si je sais qu'Allah sait, pourquoi je continue à cacher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transparence totale n'est pas une exigence sociale — c'est une libération spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est transparent à son Créateur. L'obscurité n'existe que pour l'observateur limité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit comme s'il était transparent découvre que la vérité est légère à porter." }
  ],
  munajat: `Ya Alim, Tu sais tout de moi. Fais que je vive dans cette transparence. Libère-moi du poids des secrets.`
};

MIROIR["3:30"] = {
  reference: "3:30",
  theme: ["jugement", "regret", "réalité"],
  emotion: "Urgence éveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Jami'"],
  mirrorVersion: `« Le jour où chaque âme trouvera présent ce qu'elle a fait de bien et ce qu'elle a fait de mal. » Le miroir me place devant le face-à-face ultime. Pas de juge extérieur — chaque âme sera son propre juge, confrontée à ses propres œuvres. Le bien accompli sera une joie, le mal commis sera un regret. Ce jour-là, on souhaitera être loin de ses propres mauvaises actions.`,
  reflection: `Le Jugement n'est pas une surprise — c'est la révélation de ce qu'on a toujours su au fond de soi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tajidu kulla nafsin ma 'amilat min khayrin muhdaran » — chaque âme trouvera présent ce qu'elle a fait de bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je rencontrais mes œuvres aujourd'hui, que verrais-je ? De quoi serais-je fier ? De quoi aurais-je honte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret de ce jour peut être évité par le changement d'aujourd'hui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers enregistre tout. Chaque action laisse une trace qui ne s'efface pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rencontre ses œuvres chaque jour dans l'autocritique sincère n'a pas peur du grand rendez-vous." }
  ],
  munajat: `Ya Hasib, fais que je rencontre mes œuvres aujourd'hui pour les améliorer. Ne permets pas que je sois surpris par mes propres actions.`
};

MIROIR["3:31"] = {
  reference: "3:31",
  theme: ["amour", "prophète", "obéissance"],
  emotion: "Amour inspirant",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Ghaffur"],
  mirrorVersion: `« Dis : Si vous aimez Allah, suivez-moi ; Allah vous aimera et vous pardonnera vos péchés. » Le miroir me montre le lien entre l'amour et l'action. L'amour d'Allah n'est pas un sentiment abstrait — il se manifeste dans le suivi du Prophète. Et ce suivi n'est pas à sens unique : quand je suis le Prophète, Allah m'aime en retour et me pardonne. L'amour divin s'acquiert par l'obéissance prophétique.`,
  reflection: `L'amour se prouve par les actes. Dire « j'aime Allah » sans suivre Son Prophète est une contradiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In kuntum tuhibbuna Allaha fa-ttabi'uni » — si vous aimez Allah, suivez-moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis aimer Allah ? Et est-ce que je suis le Prophète dans ma vie quotidienne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le suivi du Prophète n'est pas une contrainte — c'est le chemin vers l'amour divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour est le moteur de l'univers. L'amour d'Allah pour Sa création se manifeste à travers le Prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est aimé d'Allah n'a besoin de rien d'autre. Tout le reste lui est donné par surcroît." }
  ],
  munajat: `Ya Wadud, je T'aime. Fais que je suive Ton Prophète. Aime-moi et pardonne-moi. Donne-moi l'amour comme guide.`
};

MIROIR["3:32"] = {
  reference: "3:32",
  theme: ["obéissance", "prophète", "désobéissance"],
  emotion: "Appel clair",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-Alim"],
  mirrorVersion: `« Obéissez à Allah et au Messager. Et si vous vous détournez, Allah n'aime pas les mécréants. » Le miroir me place devant le choix binaire : obéir ou se détourner. Il n'y a pas de troisième voie. L'amour d'Allah est conditionné à l'obéissance, et l'obéissance passe par le Messager. Le rejet du message n'est pas une simple différence d'opinion — c'est un choix spirituel avec des conséquences.`,
  reflection: `L'obéissance n'est pas une soumission aveugle — c'est la reconnaissance de qui connaît le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ati'u Allaha wa al-rasula » — obéissez à Allah et au Messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je vraiment obéissant ? Ou est-ce que je choisis ce qui m'arrange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La désobéissance n'est pas la liberté — c'est l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur. L'homme est la seule créature qui peut désobéir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance par amour est plus belle que l'obéissance par peur." }
  ],
  munajat: `Ya Rabb, j'entends Ton appel à l'obéissance. Fais que je sois parmi ceux qui obéissent. Ne permets pas que je me détourne.`
};

MIROIR["3:33"] = {
  reference: "3:33",
  theme: ["élection", "prophètes", "famille"],
  emotion: "Honneur reconnaissant",
  difficulty: "débutant",
  relatedNames: ["Al-Mustafa", "Al-Mujtaba"],
  mirrorVersion: `« Certes, Allah a élu Adam, Noé, la famille d'Abraham et la famille d'Imran au-dessus de tout le monde. » Le miroir me montre la chaîne des élus. Ces familles et ces prophètes ne sont pas choisis au hasard — ils sont sélectionnés pour une mission. L'élection divine n'est pas un privilège vide — c'est une responsabilité immense. À travers eux, la guidance est transmise à l'humanité.`,
  reflection: `L'élection divine est un honneur qui s'accompagne de devoirs. Être choisi, c'est être appelé à servir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Istafa » — Il a élu, choisi. La sélection divine suit une sagesse que nous ne voyons pas toujours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai reçu ? Et comment je l'utilise ? L'élection implique la responsabilité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élection n'est pas un privilège exclusif — c'est une mission inclusive pour guider les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est structuré par des élus : les étoiles guident, les prophètes guident." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque croyant est élu à sa mesure. L'élection personnelle est d'être parmi les croyants." }
  ],
  munajat: `Ya Mustafa, Tu as élu Tes prophètes. Fais que je sois parmi leurs héritiers. Donne-moi la grâce de la guidance.`
};

MIROIR["3:34"] = {
  reference: "3:34",
  theme: ["famille", "descendance", "élection"],
  emotion: "Continuité respectueuse",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Baqi"],
  mirrorVersion: `« Des descendants les uns des autres. Et Allah entend tout et sait tout. » Le miroir me montre la continuité de la bénédiction divine à travers les générations. La prophétie n'est pas isolée — elle se transmet, se renforce, s'enrichit. Les prophètes sont liés par le sang et par la mission. Cette chaîne d'or traverse l'histoire humaine.`,
  reflection: `La bénédiction peut se transmettre. Mais elle peut aussi s'interrompre si la foi s'éteint.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhurriyyatan ba'duha min ba'd » — des descendants les uns des autres. La chaîne générationnelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je transmets à ma descendance ? La foi ou l'indifférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La descendance biologique ne garantit pas la descendance spirituelle. La foi se choisit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par transmission : la vie se transmet, la lumière se transmet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie descendance est spirituelle : les héritiers des prophètes sont ceux qui suivent leur voie." }
  ],
  munajat: `Ya Rabb, fais que je sois un maillon de la chaîne de foi. Transmets la bénédiction à travers moi. Ne permets pas que la chaîne s'arrête.`
};

MIROIR["3:35"] = {
  reference: "3:35",
  theme: ["dévotion", "vœu", "femme"],
  emotion: "Ferveur touchante",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Qabul"],
  mirrorVersion: `« Quand la femme d'Imran dit : Seigneur, je T'ai voué ce qui est dans mon ventre... » Le miroir me place devant la dévotion totale d'une mère. Elle consacre son enfant à Allah avant même sa naissance. Ce vœu n'est pas une parole légère — c'est un engagement sacré. La mère de Marie comprit que l'enfant n'était pas sa propriété mais un dépôt divin.`,
  reflection: `Consacrer à Allah ce qu'on a de plus précieux est le sommet de la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inni nadhartu laka ma fi batni muharraran » — je T'ai voué ce qui est dans mon ventre, en consécration." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai consacré à Allah ? Mes enfants ? Mon temps ? Mes biens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qu'on consacre à Allah n'est pas perdu — c'est sanctifié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est consacré à Allah. L'homme a le choix de consacrer ou de garder." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La consécration n'est pas une perte — c'est un investissement dans l'éternel." }
  ],
  munajat: `Ya Mujib, Tu exauces les vœux. Fais que je Te consacre ce que j'ai de plus précieux. Accepte mon offrande.`
};

MIROIR["3:36"] = {
  reference: "3:36",
  theme: ["fille", "protection", "nom"],
  emotion: "Confiance émue",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Puis quand elle l'eut mis au monde, elle dit : Seigneur, voilà que j'ai mis au monde une fille... et je l'ai nommée Marie. » Le miroir me montre la surprise de la mère : elle attendait un garçon, elle a eu une fille. Mais Allah avait un plan plus grand. Marie deviendra la mère de Jésus, l'une des femmes les plus honorées de l'histoire. L'imprévu divin surpasse toujours nos plans.`,
  reflection: `Ce qu'on considère comme une déception peut être la plus grande bénédiction déguisée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laysa al-dhakaru ka-al-untha » — le garçon n'est pas comme la fille. Mais Allah a Ses préférences." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand les choses ne vont pas comme prévu ? Avec déception ou avec confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fille qu'elle pensait inférieure devint supérieure à tous les garçons de son temps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas la déception. Chaque événement est exactement ce qui doit être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les plans d'Allah sont toujours meilleurs que nos plans, même quand ils semblent contraires." }
  ],
  munajat: `Ya Rabb, je T'offre ce que j'ai reçu, même si ce n'est pas ce que j'attendais. Fais que je voie Ta sagesse dans Tes dons.`
};

MIROIR["3:37"] = {
  reference: "3:37",
  theme: ["provision", "miracle", "soutien"],
  emotion: "Émerveillement gracieux",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Karim"],
  mirrorVersion: `« Son Seigneur l'agréa favorablement, la fit croître belle croissance et confia sa garde à Zacharie. » Le miroir me montre la réponse divine au vœu de la mère. Non seulement Allah accepte l'offrande, mais Il ajoute des faveurs : une belle croissance, un gardien pieux, une provision miraculeuse. Quand Zakariya entre dans le sanctuaire, il trouve des fruits hors saison — un signe que la provision d'Allah ne connaît pas de limites.`,
  reflection: `La provision d'Allah vient de sources qu'on ne soupçonne pas. Elle suit ceux qui se consacrent à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullama dakhala 'alayha Zakariyya al-mihraba wajada 'indaha rizqan » — chaque fois que Zakariya entrait, il trouvait chez elle une provision." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où vient ma provision ? Est-ce que je la reconnais comme venant d'Allah ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La provision miraculeuse n'est pas réservée aux prophètes — elle est promise à tous ceux qui se consacrent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un système de provision. Chaque créature reçoit ce dont elle a besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La plus belle provision est spirituelle : la présence d'Allah dans le cœur." }
  ],
  munajat: `Ya Razzaq, Tu pourvois à ceux qui se consacrent à Toi. Fais que je reçoive ma provision avec gratitude. Pourvois à mes besoins spirituels avant mes besoins matériels.`
};

MIROIR["3:38"] = {
  reference: "3:38",
  theme: ["prière", "espoir", "descendance"],
  emotion: "Supplication fervente",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Wahhab"],
  mirrorVersion: `« Alors Zakariya pria son Seigneur et dit : Seigneur, donne-moi de Ta part une excellente descendance. » Le miroir me montre la réaction de Zakariya face au miracle de Marie. Au lieu de jalousie, il ressent de l'espoir. Si Allah peut pourvoir à Marie, Il peut aussi pourvoir à lui. La prière est inspirée par ce qu'on voit des faveurs divines sur les autres.`,
  reflection: `Les faveurs d'Allah sur les autres sont des invitations à Lui demander pour nous-mêmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi hab li min ladunka dhurriyyatan tayyiba » — Seigneur, donne-moi de Ta part une excellente descendance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois les faveurs d'Allah sur les autres, suis-je jaloux ou inspiré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jalousie ferme la porte de la bénédiction. L'espoir l'ouvre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création répond à la demande. Demander, c'est s'ouvrir à recevoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La meilleure demande est celle qui reconnaît que tout vient « de Ta part » — du don divin." }
  ],
  munajat: `Ya Wahhab, Tu es le Donateur. Inspire-moi par Tes faveurs sur les autres. Donne-moi ce qui est bon pour moi. Exauce ma prière sincère.`
};

MIROIR["3:39"] = {
  reference: "3:39",
  theme: ["annonce", "prophète", "miracle"],
  emotion: "Gratitude émerveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Mubashshir", "Al-Bashir"],
  mirrorVersion: `« Les anges l'appelèrent pendant qu'il se tenait debout en prière dans le sanctuaire : Allah t'annonce la bonne nouvelle de Yahya. » Le miroir me montre la réponse à la prière de Zakariya. Il priait, et pendant sa prière même, la réponse est venue. Yahya (Jean) sera un prophète, un homme de vérité, malgré l'âge avancé de ses parents. La prière sincère dans le sanctuaire attire les faveurs divines.`,
  reflection: `La meilleure position est celle de la prière. C'est là que les réponses viennent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya Yahya khudhi al-kitaba bi-quwwatin » — ô Yahya, prends le Livre avec force. Un prophète dès l'enfance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je quand j'espère une réponse ? Dans la prière ou dans l'inquiétude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réponse vient souvent pendant la prière, pas après. La prière est le moment de la rencontre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond à l'attitude juste. La prière est l'attitude juste par excellence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie vraiment n'a pas besoin d'attendre la réponse — il l'a déjà dans le cœur." }
  ],
  munajat: `Ya Mubashshir, Tu annonces de bonnes nouvelles à Tes serviteurs. Annonce-moi Ta miséricorde. Exauce-moi comme Tu as exaucé Zakariya.`
};

MIROIR["3:40"] = {
  reference: "3:40",
  theme: ["miracle", "doute", "foi"],
  emotion: "Étonnement confiant",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Qahir"],
  mirrorVersion: `« Seigneur, dit-il, comment aurai-je un garçon alors que la vieillesse m'a atteint et que ma femme est stérile ? » Le miroir me montre la réaction humaine face à l'impossible. Même un prophète peut s'étonner devant un miracle. Mais Allah répond : « Ainsi fait Allah ce qu'Il veut. » L'impossibilité humaine est le terrain de la puissance divine.`,
  reflection: `Les impossibilités sont les opportunités d'Allah. Ce qui est impossible pour nous est facile pour Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhaliqi Allahu yaf'alu ma yasha' » — ainsi fait Allah ce qu'Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère impossible ? Et si Allah voulait le rendre possible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute n'est pas toujours le manque de foi — c'est parfois l'émerveillement devant l'inouï." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein d'impossibles devenus possibles. La vie elle-même est un miracle quotidien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte que Allah fait ce qu'Il veut trouve la paix devant l'imprévisible." }
  ],
  munajat: `Ya Qadir, Tu fais ce que Tu veux. Rends possible ce qui me semble impossible. Ma vie est entre Tes mains.`
};

MIROIR["3:41"] = {
  reference: "3:41",
  theme: ["signe", "silence", "prière"],
  emotion: "Acceptation humble",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'ti", "Al-Hakim"],
  mirrorVersion: `« Seigneur, dit Zakariya, donne-moi un signe. Le signe, dit Allah, sera que tu ne pourras pas parler aux gens pendant trois jours. » Le miroir me montre le signe demandé : le silence. Ce n'est pas un châtiment — c'est une bénédiction déguisée. Le silence permet la connexion profonde avec Allah. Zakariya ne pouvait pas parler aux gens, mais il pouvait prier. Le silence extérieur amplifie la prière intérieure.`,
  reflection: `Le silence est un don. Dans le silence, on entend ce qu'on ne peut pas entendre dans le bruit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sayati laka bi-al-nasi thalathata ayyamin illa ramzan » — tu ne pourras parler aux gens pendant trois jours, sauf par geste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon rapport au silence ? Est-ce que je le fuis ou est-ce que je l'accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le silence imposé devient une retraite spirituelle quand il est accepté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est mostly silencieux. Le silence est l'état naturel, le bruit est l'exception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les meilleures prières sont souvent dans le silence, où le cœur parle sans mots." }
  ],
  munajat: `Ya Rabb, si le silence est Ton signe, je l'accepte. Fais que mon silence soit une prière. Apprends-moi à Te parler dans le calme.`
};

MIROIR["3:42"] = {
  reference: "3:42",
  theme: ["femme", "élection", "honneur"],
  emotion: "Honneur reconnaissant",
  difficulty: "débutant",
  relatedNames: ["Al-Mustafa", "Al-Muttaqi"],
  mirrorVersion: `« Et quand les anges dirent : ô Marie, certes Allah t'a élue, purifiée et t'a élue au-dessus des femmes des mondes. » Le miroir me place devant l'honneur suprême fait à une femme. Marie est élue, purifiée, préférée. Cette élection n'est pas un hasard — elle est le fruit de sa dévotion, de sa chasteté, de sa consécration. Les femmes du Paradis la regarderont avec respect.`,
  reflection: `L'honneur divin vient à ceux qui se consacrent entièrement. La pureté du cœur attire l'élection divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allahi istafaki wa tahharaki wa istafaki 'ala nisa'i al-'alamin » — Allah t'a élue, purifiée, et élue au-dessus des femmes des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais pour mériter l'honneur divin ? Ma vie est-elle consacrée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté n'est pas l'absence de vie — c'est la vie orientée vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'élection divine traverse l'histoire. Marie reste un modèle pour tous les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'honneur véritable n'est pas social — il est spirituel, et seul Allah le donne." }
  ],
  munajat: `Ya Rabb, Tu honores qui Tu veux. Fais que je sois parmi Tes élus. Purifie mon cœur comme Tu as purifié Marie.`
};

MIROIR["3:43"] = {
  reference: "3:43",
  theme: ["prière", "adoration", "humilité"],
  emotion: "Dévotion profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Razi", "Al-Majid"],
  mirrorVersion: `« Ô Marie, sois obéissante à ton Seigneur, prosterne-toi et incline-toi avec ceux qui s'inclinent. » Le miroir me montre l'instruction donnée à l'élue : l'adoration. L'élection divine n'est pas un privilège passif — elle demande une réponse active. La prosternation est le signe de la reconnaissance totale. Marie, malgré son statut exceptionnel, reste une servante qui prie.`,
  reflection: `Plus on est élevé spirituellement, plus on se prosterne. L'élévation se mesure à l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya Maryamu aqnuti li-rabiki wa asjudi wa arka'i ma'a al-raki'in » — sois obéissante, prosterne-toi, incline-toi avec ceux qui s'inclinent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est ma prosternation ? Est-ce qu'elle exprime vraiment ma soumission ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation n'est pas une humiliation — c'est la position la plus haute devant Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers se prosterne à sa manière. La prosternation est l'état naturel de la créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Dans la prosternation, le croyant est le plus proche d'Allah. C'est le secret de l'intimité divine." }
  ],
  munajat: `Ya Rabb, enseigne-moi la prosternation vraie. Fais que je me prosterne avec mon cœur, pas seulement avec mon corps.`
};

MIROIR["3:44"] = {
  reference: "3:44",
  theme: ["révélation", "histoire", "croyance"],
  emotion: "Certitude éclairée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Muhit"],
  mirrorVersion: `« Ce sont là des récits de l'Inconnaissable que Nous te révélons. Tu n'étais pas parmi eux quand ils jetaient leurs calames pour décider qui serait le tuteur de Marie. » Le miroir me montre l'origine de la révélation : elle vient de l'Inconnaissable (al-ghayb). Le Prophète n'était pas présent lors des événements passés, mais Allah lui révèle ce qui s'est passé. La révélation n'est pas une invention humaine — c'est une communication divine.`,
  reflection: `La révélation nous donne accès à ce que nous ne pouvons pas savoir par nous-mêmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka min anba'i al-ghaybi nuhiyha ilayk » — ce sont des récits de l'Inconnaissable que Nous te révélons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux récits du Coran comme venant d'Allah ? Ou est-ce que je les traite comme des légendes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est invisible pour nous est visible pour Allah. La révélation comble notre ignorance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers visible cache l'invisible. La science explore le visible, la foi accueille l'invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la révélation sur l'invisible ouvre son cœur à tout ce qu'Allah a à lui révéler." }
  ],
  munajat: `Ya Rabb, je crois à Ta révélation. Ouvre mon cœur aux réalités invisibles. Fais que je ne limite pas ma connaissance au visible.`
};

MIROIR["3:45"] = {
  reference: "3:45",
  theme: ["Jésus", "annonce", "miracle"],
  emotion: "Émerveillement respectueux",
  difficulty: "débutant",
  relatedNames: ["Al-Masih", "Kalimatullah"],
  mirrorVersion: `« Quand les anges dirent : ô Marie, Allah t'annonce la bonne nouvelle d'une parole venant de Lui : son nom est le Messie, Jésus, fils de Marie. » Le miroir me place devant l'annonce la plus extraordinaire. Jésus est appelé « une parole venant d'Allah » (kalimatun minhu). Il est le Messie, illustre dans ce monde et dans l'au-delà, proche d'Allah. Sa naissance est un miracle, sa vie est un miracle, son message est un miracle.`,
  reflection: `Jésus est le miracle de la parole divine devenu chair. Il représente la proximité entre le divin et l'humain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ismuhu al-Masihu 'Isa ibnu Maryama wajihan fi al-dunya wa al-akhirati wa mina al-muqarrabin » — son nom est le Messie, Jésus, fils de Marie, illustre ici-bas et dans l'au-delà, proche d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma relation avec Jésus ? Est-ce que je l'honore comme le Coran l'honore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Jésus est né sans père pour montrer que la vie vient d'Allah, pas des causes normales." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une parole d'Allah. Jésus est cette parole personnifiée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend Jésus comprend que la vie est un don permanent d'Allah." }
  ],
  munajat: `Ya Rabb, honore Jésus dans mon cœur comme Tu l'honores dans Ta révélation. Fais que je voie en lui Ton miracle vivant.`
};

MIROIR["3:46"] = {
  reference: "3:46",
  theme: ["Jésus", "miracle", "bébé"],
  emotion: "Émerveillement pur",
  difficulty: "débutant",
  relatedNames: ["Al-Natiq", "Al-Hakim"],
  mirrorVersion: `« Il parlera aux gens dans le berceau et en son âge mûr. » Le miroir me place devant le miracle de la parole précoce. Un bébé qui parle dans le berceau — c'est le signe que ce n'est pas un enfant ordinaire. La sagesse n'attend pas l'âge. Jésus parle dès la naissance parce qu'il est né avec une mission. Les miracles accompagnent les prophètes dès le début.`,
  reflection: `La sagesse peut venir tôt. L'âge n'est pas une condition pour la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yukallimu al-nasa fi al-mahdi wa kahlan » — il parlera aux gens dans le berceau et en son âge mûr." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quel âge ai-je commencé à parler la vérité ? Et maintenant, est-ce que je la parle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Un bébé qui parle est un signe. Un adulte qui se tait sur la vérité est un contresigne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole est le don qui distingue l'homme. Jésus reçoit ce don en perfection dès le début." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie parole est celle qui vient d'Allah, peu importe l'âge de celui qui la prononce." }
  ],
  munajat: `Ya Rabb, fais que je parle Ta vérité. Même si je suis jeune, même si je suis faible, donne-moi le courage de la parole juste.`
};

MIROIR["3:47"] = {
  reference: "3:47",
  theme: ["miracle", "création", "puissance"],
  emotion: "Soumission émerveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Seigneur, dit-elle, comment aurais-je un enfant alors qu'aucun homme ne m'a touchée ? — Ainsi, dit Allah, Allah crée ce qu'Il veut. » Le miroir me place devant l'impossibilité devenue possible. Marie s'étonne comme Zakariya s'était étonné. Mais la réponse est la même : Allah n'est pas limité par les causes normales. Sa parole « Sois » suffit à faire exister ce qui n'existe pas.`,
  reflection: `La création d'Allah ne dépend pas des causes. Les causes sont Ses créatures, pas Ses contraintes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhaliqi Allahu yakhluqu ma yasha' » — ainsi, Allah crée ce qu'Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère impossible dans ma vie ? Et si Allah décidait de le créer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossible n'existe pas pour Allah. L'impossible est notre catégorie, pas la Sienne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est créé par « Sois ». Chaque créature est un miracle permanent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte que Allah crée ce qu'Il veut n'est jamais coincé dans l'impossible." }
  ],
  munajat: `Ya Khaliq, Tu crées ce que Tu veux. Crée en moi ce qui Te plaît. Fais l'impossible dans ma vie.`
};

MIROIR["3:48"] = {
  reference: "3:48",
  theme: ["Jésus", "enseignement", "sagesse"],
  emotion: "Apprentissage respectueux",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Hakim"],
  mirrorVersion: `« Et Il lui enseignera le Livre, la Sagesse, la Torah et l'Évangile. » Le miroir me montre l'éducation divine de Jésus. Il reçoit quatre enseignements : le Livre (l'écriture), la Sagesse (la compréhension profonde), la Torah (la loi de Moïse), et l'Évangile (la bonne nouvelle). Cette éducation est donnée directement par Allah. Le prophète est d'abord un étudiant avant d'être un maître.`,
  reflection: `Pour enseigner, il faut avoir appris. Jésus reçoit avant de donner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yu'allimuhu al-kitaba wa al-hikmata wa al-tawrata wa al-injila » — Il lui enseignera le Livre, la Sagesse, la Torah et l'Évangile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends ? Est-ce que je cherche la sagesse ou seulement l'information ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le plus grand enseignement vient d'Allah. Les livres sont des moyens, Allah est la Source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est une école. Chaque créature apprend et enseigne à sa manière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie sagesse est de connaître Allah. Tout le reste en découle." }
  ],
  munajat: `Ya Alim, enseigne-moi comme Tu as enseigné Jésus. Donne-moi la sagesse, pas seulement la connaissance. Fais de moi un étudiant éternel.`
};

MIROIR["3:49"] = {
  reference: "3:49",
  theme: ["Jésus", "miracles", "prophète"],
  emotion: "Foi renforcée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'jiz", "Al-Shafi"],
  mirrorVersion: `« Et Il sera le messager vers les enfants d'Israël, disant : Je suis venu à vous avec un signe de votre Seigneur. » Le miroir me montre les miracles de Jésus : façonner l'argile en oiseau, guérir l'aveugle et le lépreux, ressusciter les morts. Ces signes ne sont pas des tours de magie — ils sont des preuves de sa mission prophétique et de la puissance d'Allah. Chaque miracle est un appel à la foi.`,
  reflection: `Les miracles sont des signes pour ceux qui veulent croire. Pour les autres, ils restent des énigmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ubri'u al-akmaha wa al-abrasa wa uh-yi al-mawta bi-idhni Allah » — je guéris l'aveugle et le lépreux, et je ressuscite les morts, par la permission d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes ai-je vus dans ma vie ? Est-ce qu'ils m'ont rapproché d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les miracles de Jésus sont « par la permission d'Allah ». Il n'est qu'un instrument." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un miracle continu. Nous nous y habituons et cessons de le voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand miracle est la guidance du cœur. Guérir l'âme est plus grand que guérir le corps." }
  ],
  munajat: `Ya Rabb, les miracles de Tes prophètes me ramènent à Toi. Fais que je voie Tes signes dans ma vie. Guéris mon cœur comme Jésus guérissait les corps.`
};

MIROIR["3:50"] = {
  reference: "3:50",
  theme: ["Jésus", "confirmation", "loi"],
  emotion: "Compréhension claire",
  difficulty: "débutant",
  relatedNames: ["Al-Musaddiq", "Al-Haqq"],
  mirrorVersion: `« Je suis venu pour confirmer ce qui existait avant moi de la Torah, et pour rendre licites une partie de ce qui vous était interdit. » Le miroir me montre la relation entre Jésus et la loi précédente. Il ne vient pas abolir mais confirmer et alléger. La religion d'Allah est une, mais ses applications s'adaptent aux temps et aux peuples. L'allègement est une miséricorde.`,
  reflection: `La loi divine peut s'adapter sans changer dans son essence. L'esprit reste, la lettre s'ajuste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Musaddiqan lima bayna yadayya mina al-tawrati » — confirmant ce qui était avant moi de la Torah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois les lois religieuses ? Comme des fardeaux ou comme des guidances ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allègement de la loi n'est pas un affaiblissement — c'est une miséricorde adaptée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit des lois qui s'ajustent. La flexibilité est une forme de perfection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'esprit de la loi n'est pas esclave de la lettre." }
  ],
  munajat: `Ya Musaddiq, Tu confirmes et Tu adaptes. Fais que je comprenne l'esprit de Tes lois. Ne permets pas que je m'enferme dans la lettre.`
};

MIROIR["3:51"] = {
  reference: "3:51",
  theme: ["Jésus", "obéissance", "chemin"],
  emotion: "Clarté guidante",
  difficulty: "débutant",
  relatedNames: ["Al-Sirat", "Al-Mustaqim"],
  mirrorVersion: `« Certes, Allah est mon Seigneur et votre Seigneur. Adorez-Le donc : c'est le chemin droit. » Le miroir me montre le message essentiel de Jésus : l'adoration d'Allah seul. Pas l'adoration de lui-même, pas l'adoration d'intermédiaires — l'adoration directe du Seigneur. Le « chemin droit » (al-sirat al-mustaqim) est la voie de la soumission pure, sans complication.`,
  reflection: `La simplicité du message prophétique : adorez Allah. Tout le reste est distraction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha rabbi wa rabbukum fa-'buduhu hadha siratun mustaqim » — Allah est mon Seigneur et votre Seigneur. Adorez-Le : c'est le chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon chemin ? Est-ce le chemin droit de l'adoration d'Allah ou un chemin détourné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin droit n'est pas le chemin facile — c'est le chemin sans détour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit son chemin droit. Seul l'homme s'égare dans les détours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le chemin droit est celui qui mène directement à Allah, sans passer par autre chose." }
  ],
  munajat: `Ya Rabb, montre-moi le chemin droit. Fais que je T'adore sans intermédiaire. Simplifie ma relation avec Toi.`
};

MIROIR["3:52"] = {
  reference: "3:52",
  theme: ["disciples", "soumission", "soutien"],
  emotion: "Engagement solidaire",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Ansar"],
  mirrorVersion: `« Quand Jésus ressentit de leur part de l'incrédulité, il dit : Qui sont mes auxiliaires dans la voie d'Allah ? Les apôtres dirent : Nous sommes les auxiliaires d'Allah. » Le miroir me montre l'appel au soutien. Jésus face à l'opposition cherche des alliés. Les apôtres répondent par une déclaration de foi et d'engagement. Être « auxiliaire d'Allah » (ansar Allah) est un honneur et une responsabilité.`,
  reflection: `La vérité a toujours besoin de défenseurs. Être auxiliaire d'Allah, c'est soutenir Sa cause.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man ansari ila Allah » — qui sont mes auxiliaires dans la voie d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un auxiliaire d'Allah ? Comment je soutiens Sa cause ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Soutenir Allah, c'est soutenir la vérité, la justice, la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est soutenu par Allah. L'homme peut choisir de soutenir ce qui le soutient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les auxiliaires d'Allah reçoivent Son soutien en retour. L'alliance est mutuelle." }
  ],
  munajat: `Ya Nasir, je veux être Ton auxiliaire. Fais que je soutienne Ta cause. Donne-moi le courage de me déclarer pour Toi.`
};

MIROIR["3:53"] = {
  reference: "3:53",
  theme: ["foi", "soumission", "témoignage"],
  emotion: "Déclaration ferme",
  difficulty: "débutant",
  relatedNames: ["Al-Shahid", "Al-Musaddiq"],
  mirrorVersion: `« Seigneur, nous avons cru à ce que Tu as fait descendre et nous avons suivi le messager. Inscris-nous donc parmi ceux qui témoignent. » Le miroir me montre la prière des apôtres. Ils croient, ils suivent, et ils demandent à être inscrits parmi les témoins. La foi n'est pas complète sans le témoignage. Croire intérieurement est le début ; témoigner extérieurement est l'accomplissement.`,
  reflection: `La foi demande à être témoignée. Le croyant est un témoin, pas un spectateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faktubna ma'a al-shahidin » — inscris-nous parmi ceux qui témoignent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon nom est-il inscrit parmi les témoins ? Est-ce que je témoigne de ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage n'est pas une parole — c'est une vie qui atteste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne. L'homme est le témoin conscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être inscrit parmi les témoins, c'est être inscrit dans le Livre d'Allah." }
  ],
  munajat: `Ya Shahid, inscris-moi parmi les témoins. Fais que ma vie soit un témoignage de ma foi.`
};

MIROIR["3:54"] = {
  reference: "3:54",
  theme: ["ruse", "plan", "sagesse"],
  emotion: "Confiance calme",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khayr"],
  mirrorVersion: `« Et ils [les mécréants] ruserent, et Allah rusa. Et Allah est le meilleur des ruseurs. » Le miroir me montre la réponse divine aux complots humains. Les ennemis de Jésus ont tramé contre lui, mais Allah a un plan supérieur. Le mot « makr » (ruse) appliqué à Allah signifie Sa capacité à retourner les complots contre leurs auteurs. La sagesse divine surpasse toute ruse humaine.`,
  reflection: `Les plans des hommes ne peuvent pas déjouer les plans d'Allah. Ce qui semble une défaite peut être une victoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa makaru wa makara Allahu wa Allahu khayru al-makirin » — ils ruserent, et Allah rusa. Et Allah est le meilleur des ruseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois des complots contre la vérité, est-ce que je désespère ou est-ce que je fais confiance au plan d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La ruse des ennemis de Jésus a abouti à son élévation, pas à sa destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne selon le plan divin. Les apparences peuvent tromper, la réalité non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que Allah est le meilleur planificateur ne s'inquiète pas des ruses des autres." }
  ],
  munajat: `Ya Hakim, Tu es le meilleur des planificateurs. Fais que je Te fasse confiance quand les autres complotent. Retourne leurs ruses contre eux.`
};

MIROIR["3:55"] = {
  reference: "3:55",
  theme: ["Jésus", "élévation", "retour"],
  emotion: "Espérance mysterieuse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rafi'", "Al-Wafi"],
  mirrorVersion: `« Quand Allah dit : Ô Jésus, Je vais mettre fin à ta vie terrestre et t'élever vers Moi. » Le miroir me montre le destin de Jésus : la mort apparente suivie de l'élévation. Son ennemis pensaient l'avoir tué, mais Allah l'a élevé. La fin terrestre n'est pas la fin réelle. Ce verset annonce aussi le retour de Jésus avant le Jour du Jugement.`,
  reflection: `La mort n'est pas la fin. L'élévation suit ceux qui servent Allah sincèrement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya 'Isa inni mutawaffika wa rafi'uka ilayya » — ô Jésus, Je vais te faire mourir et t'élever vers Moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois la mort ? Comme une fin ou comme une élévation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble une défaite (la mort) est en fait une victoire (l'élévation)." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas de vraie fin. Chaque fin est un commencement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'élévation vers Allah est le destin de tout croyant fidèle." }
  ],
  munajat: `Ya Rafi', élève-moi vers Toi comme Tu as élevé Jésus. Fais que ma mort soit une élévation, pas une chute.`
};

MIROIR["3:56"] = {
  reference: "3:56",
  theme: ["jugement", "récompense", "châtiment"],
  emotion: "Réalité spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Adl"],
  mirrorVersion: `« Quant à ceux qui ont mécru, Je les châtierai d'un dur châtiment dans ce monde et dans l'au-delà. » Le miroir me montre la conséquence du rejet de la vérité. Le châtiment n'est pas arbitraire — il est la conséquence logique du choix de l'égarement. La miséricorde d'Allah est immense, mais elle n'est pas sans limites pour ceux qui la rejettent obstinément.`,
  reflection: `Le châtiment est l'autre face de la miséricorde rejetée. Choisir l'erreur, c'est choisir ses conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-mani kafara minhum fa-u'adhdhibuhu 'adhaban shadidan » — quant à ceux qui ont mécru, Je les châtierai d'un dur châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon choix ? La foi qui mène à la miséricorde ou la mécréance qui mène au châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment n'est pas voulu par Allah — il est choisi par celui qui rejette la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne selon des lois. Les conséquences suivent les choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie protection contre le châtiment est la foi sincère, pas la simple appartenance nominale." }
  ],
  munajat: `Ya Rabb, protège-moi de Ton châtiment. Fais que je choisisse la foi. Accorde-moi Ta miséricorde.`
};

MIROIR["3:57"] = {
  reference: "3:57",
  theme: ["récompense", "justice", "foi"],
  emotion: "Espérance méritée",
  difficulty: "débutant",
  relatedNames: ["Al-Wafi", "Al-Shakur"],
  mirrorVersion: `« Et quant à ceux qui ont cru et fait de bonnes œuvres, Il leur donnera leur pleine récompense. » Le miroir me montre la promesse d'Allah aux croyants sincères. La récompense n'est pas partielle — elle est pleine, complète, sans diminution. Allah n'est pas ingrat envers ceux qui L'ont servi. La récompense divine dépasse toujours le mérite humain.`,
  reflection: `La récompense d'Allah est généreuse. Ce qu'Il donne surpasse ce qu'on mérite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuwaffihim ujurahum » — Il leur donnera leur pleine récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour la récompense d'Allah ? Ou est-ce que j'œuvre pour d'autres choses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense d'Allah n'est pas un salaire — c'est un don qui dépasse le mérite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rend toujours ce qui est dû. La justice divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La meilleure récompense est Allah Lui-même. Les jardins ne sont que des décorations." }
  ],
  munajat: `Ya Wafi, Tu donnes la pleine récompense. Fais que j'œuvre pour Toi. Accorde-moi ce que Tu as promis aux croyants.`
};

MIROIR["3:58"] = {
  reference: "3:58",
  theme: ["récitation", "signes", "sagesse"],
  emotion: "Révérence studieuse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabyr"],
  mirrorVersion: `« Voilà ce que Nous te récitons des versets et du rappel plein de sagesse. » Le miroir me montre la nature du Coran : des versets (ayat) et un rappel plein de sagesse (dhikr hakim). Le Coran n'est pas un livre ordinaire — c'est une récitation divine qui contient la sagesse éternelle. Chaque verset est un signe, chaque rappel est une guidance.`,
  reflection: `Le Coran est la sagesse devenue parole. Le lire, c'est entendre la sagesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu Allahi natluha 'alayka bi-al-haqq » — voilà les versets d'Allah que Nous te récitons avec vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je lis le Coran ? Comme un texte ordinaire ou comme une récitation divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récitation n'est pas une simple lecture — c'est une transmission vivante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un verset d'Allah. Le Coran en est le résumé intelligible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui récite le Coran avec le cœur entend Allah Lui-même." }
  ],
  munajat: `Ya Rabb, fais que je récite Ton Livre avec vénération. Ouvre mon cœur à sa sagesse. Fais que chaque verset pénètre mon être.`
};

MIROIR["3:59"] = {
  reference: "3:59",
  theme: ["Jésus", "Adam", "création"],
  emotion: "Compréhension éclairée",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Badi'"],
  mirrorVersion: `« Pour Allah, Jésus est comme Adam. Il l'a créé de poussière, puis Il lui a dit : Sois ! et il fut. » Le miroir me montre la comparaison entre Jésus et Adam. Adam a été créé sans père ni mère, Jésus a été créé sans père. Les deux sont des créatures d'Allah, créées par Sa parole « Sois ! » Cette comparaison détruit l'idée que Jésus serait divin à cause de sa naissance miraculeuse.`,
  reflection: `Le miracle de la création ne divinise pas la créature. Adam et Jésus sont tous deux des serviteurs d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna masala 'Isa 'inda Allahi ka-masali Adam » — pour Allah, Jésus est comme Adam." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois les miracles ? Comme des signes de divinité ou comme des signes de puissance créatrice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Plus la création est miraculeuse, plus elle témoigne du Créateur, pas de la divinité de la créature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est créé par « Sois ! ». Chaque créature porte ce témoignage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La création de Jésus et d'Adam nous rappelle que nous sommes tous des créatures." }
  ],
  munajat: `Ya Khaliq, Tu crées par Ta parole. Fais que je reconnaisse Ta puissance créatrice. Ne permets pas que je divinise ce qui n'est que création.`
};

MIROIR["3:60"] = {
  reference: "3:60",
  theme: ["vérité", "certitude", "doute"],
  emotion: "Confiance absolue",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Yaqin"],
  mirrorVersion: `« C'est la vérité venant de ton Seigneur. Ne sois donc pas parmi ceux qui doutent. » Le miroir me place devant le choix : la vérité ou le doute. La révélation sur Jésus est la vérité (al-haqq) venant d'Allah. Le doute n'est pas la sagesse — c'est l'hésitation devant ce qui est clair. La certitude (al-yaqin) est demandée au croyant.`,
  reflection: `La vérité venue d'Allah ne mérite pas le doute. La certitude est une grâce à demander.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-haqqu min rabbika » — c'est la vérité venant de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je doute ? Et pourquoi je doute de ce qui vient d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute n'est pas l'ouverture d'esprit — c'est le refus d'accepter ce qui dérange." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne doute pas de son Créateur. Seul l'homme hésite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La certitude est un don d'Allah. Celui qui la cherche la reçoit." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je ne doute pas de Ta révélation. Donne-moi la certitude qui apaise le cœur.`
};

MIROIR["3:61"] = {
  reference: "3:61",
  theme: ["débat", "imprécation", "vérité"],
  emotion: "Fermeté engagée",
  difficulty: "avancé",
  relatedNames: ["Al-Haqq", "Al-Fasil"],
  mirrorVersion: `« À quiconque contredit ce que tu as reçu de science, dis : Venez, appelons nos fils et vos fils, nos femmes et vos femmes... puis nous prononcerons l'imprécation d'Allah sur les menteurs. » Le miroir me montre la méthode ultime de résolution des conflits religieux : l'appel à Allah comme juge. L'imprécation (mubahala) est un acte solennel où chaque partie demande à Allah de maudire celle qui ment. Cette méthode montre la confiance absolue dans la vérité.`,
  reflection: `La vérité n'a pas peur du jugement d'Allah. Le menteur ne peut pas accepter ce défi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fal nat'an nabtahil » — alors appelons la malédiction d'Allah sur les menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai assez confiance dans ma foi pour accepter le jugement d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les chrétiens de Najran n'ont pas accepté la mubahala, reconnaissant implicitement leur faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité n'a pas peur du test. Le mensonge fuit l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance dans la vérité permet de défier le monde entier." }
  ],
  munajat: `Ya Haqq, je crois en Ta vérité. Fais que je n'aie pas peur de me soumettre à Ton jugement. Confirme ma foi par Ta confirmation.`
};

MIROIR["3:62"] = {
  reference: "3:62",
  theme: ["vérité", "témoignage", "unicité"],
  emotion: "Certitude solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Haqq"],
  mirrorVersion: `« C'est bien là le récit véridique. Il n'y a de divinité qu'Allah. » Le miroir me ramène à l'essentiel : l'unicité d'Allah. Après le récit détaillé sur Jésus, le verset conclut par la shahada. Tout ce qui précède — les miracles, les prophètes, les histoires — converge vers cette vérité centrale : Il n'y a de divinité qu'Allah.`,
  reflection: `L'unicité d'Allah est la conclusion de toute l'histoire sacrée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadha lahuwa al-qasasu al-haqqu wa ma min ilahin illa Allah » — c'est le récit véridique. Il n'y a de divinité qu'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie converge vers cette vérité ? Tout ce que je fais, est-ce pour Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire de Jésus, comme celle d'Adam, mène à la même conclusion : Allah est Un." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame l'unicité. L'homme est appelé à la reconnaître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise vraiment l'unicité d'Allah n'a plus besoin de rien d'autre." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Fais que toute ma vie témoigne de Ton unicité. Unifie mon cœur autour de Toi.`
};

MIROIR["3:63"] = {
  reference: "3:63",
  theme: ["détournement", "avertissement", "mains"],
  emotion: "Avertissement final",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Shadid"],
  mirrorVersion: `« S'ils se détournent... Allah connaît bien les corrupteurs. » Le miroir me montre le dernier mot du débat. Ceux qui se détournent après avoir entendu la vérité sont les corrupteurs. Allah les connaît parfaitement. Le détournement n'est pas une neutralité — c'est un choix avec des conséquences.`,
  reflection: `Se détourner de la vérité quand elle est claire est une corruption de l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in tawallaw fa-inna Allaha 'alimun bi-al-mufsidin » — s'ils se détournent, Allah connaît bien les corrupteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je me détourne de la vérité, suis-je conscient que Allah me connaît ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement n'est pas une liberté — c'est une corruption." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas se détourner de son Créateur. Seul l'homme peut choisir le détournement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît les corrupteurs même quand ils se cachent derrière de belles apparences." }
  ],
  munajat: `Ya Rabb, ne permets pas que je me détourne de Ta vérité. Connaissant mon cœur, purifie-le de toute corruption.`
};

MIROIR["3:64"] = {
  reference: "3:64",
  theme: ["dialogue", "parole commune", "unicité"],
  emotion: "Ouverture fraternelle",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Jami'"],
  mirrorVersion: `« Dis : Ô gens du Livre, venez à une parole commune entre nous et vous : que nous n'adorions qu'Allah, sans rien Lui associer. » Le miroir me montre l'invitation au dialogue interreligieux sur un fondement commun : l'adoration du Dieu unique. Cette invitation est respectueuse mais ferme : le monothéisme pur est le terrain d'entente. Les différences secondaires peuvent être discutées après l'accord sur l'essentiel.`,
  reflection: `Le dialogue interreligieux a un fondement : l'unicité de Dieu. Sur cette base, la discussion est possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta'alu ila kalimatin sawa'in baynana wa baynakum » — venez à une parole commune entre nous et vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'aborde le dialogue avec ceux qui croient différemment ? Avec arrogance ou avec invitation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole commune n'est pas un compromis — c'est le fondement véridique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité de Dieu est la vérité universelle. Toute l'humanité peut s'y rassembler." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui propose la parole commune montre qu'il cherche l'unité dans la vérité." }
  ],
  munajat: `Ya Wahid, Tu es le Dieu unique de tous. Fais que je sois un pont vers les autres, pas un obstacle. Aide-moi à trouver la parole commune.`
};

MIROIR["3:65"] = {
  reference: "3:65",
  theme: ["Abraham", "religion", "dispute"],
  emotion: "Rappel clair",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Muslim"],
  mirrorVersion: `« Ô gens du Livre, pourquoi disputez-vous au sujet d'Abraham, alors que la Torah et l'Évangile ne sont descendus qu'après lui ? » Le miroir me montre l'absurdité de certaines disputes. Chacun réclame Abraham, mais Abraham a vécu avant les divisions. Il n'était ni juif ni chrétien — il était un soumis (musulman) à Allah. La vérité historique tranche le débat.`,
  reflection: `Abraham appartient à tous ceux qui suivent son exemple de soumission, pas à un groupe exclusif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana Ibrahimu yahudiyyan wa la nasraniyyan wa lakin kana hanifan musliman » — Abraham n'était ni juif ni chrétien, mais un croyant pur, soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je revendique les prophètes ? Comme ma propriété exclusive ou comme des guides pour l'humanité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les divisions religieuses sont postérieures aux prophètes. La religion des prophètes est une." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est antérieure aux divisions. Retourner à la source, c'est dépasser les sectes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être comme Abraham, c'est être au-delà des étiquettes, dans la soumission pure." }
  ],
  munajat: `Ya Rabb, fais que je sois comme Abraham : un croyant pur, soumis à Toi seul. Ne permets pas que les divisions me séparent de la vérité.`
};

MIROIR["3:66"] = {
  reference: "3:66",
  theme: ["dispute", "connaissance", "ignorance"],
  emotion: "Réprolation lucide",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Jahl"],
  mirrorVersion: `« Vous voilà disputant au sujet de ce dont vous avez quelque science... et vous ne disputez pas de ce dont vous n'avez aucune science ! » Le miroir me montre le paradoxe humain : on dispute de ce qu'on connaît un peu et on ignore ce qu'on devrait connaître. Les gens du Livre disputaient d'Abraham tout en ignorant la vérité sur lui. La dispute cache souvent l'ignorance.`,
  reflection: `La dispute sur les détails cache souvent l'ignorance de l'essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha'ula'i qawmun jadaltum fihim » — les voilà, ceux au sujet desquels vous disputez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi je dispute ? Et de quoi je devrais vraiment me préoccuper ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispute sur les ancêtres est futile si on ne suit pas leur exemple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance vraie ne mène pas à la dispute — elle mène à la pratique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment ne dispute pas — il témoigne." }
  ],
  munajat: `Ya Alim, Tu connais tout. Fais que je cesse les disputes futiles et que je me concentre sur ce qui compte vraiment.`
};

MIROIR["3:67"] = {
  reference: "3:67",
  theme: ["Abraham", "soumission", "pureté"],
  emotion: "Modèle inspirant",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Muslim"],
  mirrorVersion: `« Abraham n'était ni juif ni chrétien, mais il était un croyant pur, soumis à Allah. » Le miroir me montre le modèle parfait : Abraham le hanif, le croyant pur, le musulman, le soumis. Avant les étiquettes religieuses, il y a l'attitude du cœur. Abraham n'appartenait à aucun groupe — il appartenait à Allah. Cette pureté est la religion universelle.`,
  reflection: `La religion d'Abraham est la religion de la pureté et de la soumission, sans complication.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hanifan musliman » — croyant pur, soumis. L'essence de la religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je comme Abraham ? Un croyant pur, soumis, sans étiquette exclusive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appartenance à un groupe ne sauve pas — l'attitude du cœur sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La soumission est l'état naturel de tout l'univers. Abraham a retrouvé cet état." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté (hanifiya) est le retour à l'état originel de la créature." }
  ],
  munajat: `Ya Rabb, fais que je sois comme Abraham : un croyant pur, soumis à Toi seul. Enlève de mon cœur toute soumission à autre que Toi.`
};

MIROIR["3:68"] = {
  reference: "3:68",
  theme: ["Abraham", "famille", "foi"],
  emotion: "Appartenance vraie",
  difficulty: "débutant",
  relatedNames: ["Al-Awliya", "Al-Mu'minin"],
  mirrorVersion: `« Les plus proches d'Abraham sont ceux qui l'ont suivi, ainsi que ce prophète et ceux qui ont cru. » Le miroir me montre la vraie parenté spirituelle. Ce n'est pas le sang qui unit à Abraham — c'est la foi. Les croyants sont sa vraie famille, pas ses descendants biologiques qui ont perdu la foi. Le Prophète Muhammad et ses compagnons sont plus proches d'Abraham que ceux qui se réclament de lui sans le suivre.`,
  reflection: `La famille spirituelle transcende la famille biologique. La foi crée des liens plus forts que le sang.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna awla al-nasi bi-Ibrahim al-ladhina ittaba'uhu » — les plus proches d'Abraham sont ceux qui l'ont suivi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quelle famille j'appartiens vraiment ? Celle du sang ou celle de la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les descendants biologiques d'Abraham qui n'ont pas cru sont ses enfants biologiques mais pas ses héritiers spirituels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La famille universelle des croyants traverse le temps et les continents." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La proximité avec les prophètes se mérite par le suivi, pas par la généalogie." }
  ],
  munajat: `Ya Rabb, fais que je sois de la famille d'Abraham par la foi, pas par le sang. Inclus-moi parmi ceux qui le suivent vraiment.`
};

MIROIR["3:69"] = {
  reference: "3:69",
  theme: ["tentation", "égarement", "protection"],
  emotion: "Vigilance nécessaire",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Une partie des gens du Livre aimerait vous égarer. Or, ils n'égarent qu'eux-mêmes, et ils ne s'en rendent pas compte. » Le miroir me montre la réalité des intentions cachées. Certains parmi les gens du Livre voulaient égarer les musulmans. Mais Allah rassure : ils n'égarent qu'eux-mêmes. Le complot contre la vérité se retourne toujours contre ses auteurs.`,
  reflection: `Les complots contre la vérité sont autodestructeurs. La protection d'Allah suffit au croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wadda kathirun min ahli al-kitabi law yaruddunakum min ba'di imanikum kuffaran » — beaucoup aimeraient vous faire revenir mécréants après votre foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face à ceux qui veulent m'égarer ? Avec peur ou avec confiance en Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ceux qui veulent égarer les autres sont les premiers égarés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas être égaré. Seul l'homme peut choisir l'égarement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection d'Allah est plus forte que tous les complots." }
  ],
  munajat: `Ya Hafiz, protège-moi de ceux qui veulent m'égarer. Fais que je reste ferme dans ma foi malgré les tentations.`
};

MIROIR["3:70"] = {
  reference: "3:70",
  theme: ["gens du Livre", "mécréance", "signes"],
  emotion: "Étonnement triste",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Bayyinah"],
  mirrorVersion: `« Ô gens du Livre, pourquoi ne croyez-vous pas aux signes d'Allah alors que vous êtes témoins ? » Le miroir me montre le paradoxe du refus. Ils connaissent la vérité, ils la voient, et pourtant ils la rejettent. Le témoignage intérieur ne suffit pas si le cœur refuse de se soumettre. La connaissance sans soumission est stérile.`,
  reflection: `Voir la vérité ne suffit pas — il faut l'accepter. La connaissance sans soumission est un danger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa antum tashhadun » — alors que vous êtes témoins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je sais et que je refuse d'accepter ? Où est mon refus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus de la vérité qu'on connaît est le pire des refus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de la vérité. Seul l'homme peut refuser ce qu'il voit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le témoignage intérieur est un don. Le refuser est un crime contre soi-même." }
  ],
  munajat: `Ya Rabb, fais que je n'accepte pas la vérité seulement quand elle m'arrange. Donne-moi le courage de croire en tout ce qui vient de Toi.`
};

MIROIR["3:71"] = {
  reference: "3:71",
  theme: ["hypocrisie", "vérité", "mensonge"],
  emotion: "Dénonciation claire",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batin"],
  mirrorVersion: `« Ô gens du Livre, pourquoi mêlez-vous le mensonge à la vérité et pourquoi cachez-vous la vérité alors que vous savez ? » Le miroir me montre l'hypocrisie dans sa forme la plus subtile : mélanger le vrai et le faux pour confondre. Cacher la vérité qu'on connaît est pire que l'ignorer. La responsabilité du savoir est de le transmettre, pas de le dissimuler.`,
  reflection: `Mêler le vrai et le faux est une ruse de l'ego. La vérité doit être transmise pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lima talbisuna al-haqa bi-al-batili » — pourquoi mêlez-vous le mensonge à la vérité ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mélange le vrai et le faux ? Quand ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Cacher la vérité qu'on connaît est un crime contre la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas le mélange. La vérité y est pure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache la vérité se cache à lui-même." }
  ],
  munajat: `Ya Haqq, ne permets pas que je cache Ta vérité. Fais que je sois un transmetteur pur, pas un dissimulateur.`
};

MIROIR["3:72"] = {
  reference: "3:72",
  theme: ["hypocrisie", "ruse", "égarement"],
  emotion: "Mise en garde sérieuse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Une partie des gens du Livre dit : Croyez au début de la journée à ce qui a été révélé aux croyants, et mécroyez à la fin de la journée. » Le miroir me montre la ruse hypocrite : simuler la foi pour semer le doute. Ces gens voulaient créer la confusion chez les croyants. Mais leurs complots retombent sur eux-mêmes. La sincérité est le remède contre toutes les ruses.`,
  reflection: `La simulation de la foi ne trompe qu'un temps. Allah connaît les cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aminu bi-alladhi unzila 'ala alladhina amanu » — croyez à ce qui a été révélé aux croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je joue un rôle dans ma foi ? Ou est-ce que je suis sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La simulation hypocrite révèle la faiblesse de ceux qui la pratiquent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne simule pas. Il est ce qu'il est." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sincérité est la monnaie du Paradis. L'hypocrisie mène à l'Enfer." }
  ],
  munajat: `Ya Rabb, protège-moi de l'hypocrisie. Fais que ma foi soit sincère, sans simulation, sans arrière-pensée.`
};

MIROIR["3:73"] = {
  reference: "3:73",
  theme: ["exclusivisme", "guidance", "erreur"],
  emotion: "Correction ferme",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Rashid"],
  mirrorVersion: `« Ne croyez que ceux qui suivent votre religion. — Dis : La véritable guidance est la guidance d'Allah. » Le miroir me montre l'erreur de l'exclusivisme. Croire que seul son groupe est guidé est une forme d'orgueil. La guidance n'appartient à personne — elle vient d'Allah et va à qui Allah veut. L'ouverture du cœur est nécessaire pour recevoir la guidance.`,
  reflection: `La guidance est un don d'Allah, pas une propriété exclusive. L'orgueil ferme la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-huda huda Allah » — la guidance est la guidance d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'approprie la guidance ? Ou est-ce que je la reconnais comme un don ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui croit détenir exclusivement la guidance la perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est universelle comme la lumière du soleil. Personne ne la possède." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité ouvre la porte de la guidance. L'orgueil la ferme." }
  ],
  munajat: `Ya Hadi, Tu es le Guide. Fais que je ne m'approprie pas Ta guidance. Ouvre mon cœur à tous ceux que Tu guides.`
};

MIROIR["3:74"] = {
  reference: "3:74",
  theme: ["miséricorde", "don", "élection"],
  emotion: "Gratitude humble",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Wahhab"],
  mirrorVersion: `« Il donne Sa miséricorde particulière à qui Il veut. Et Allah est Détenteur de la grâce immense. » Le miroir me montre la liberté absolue d'Allah dans le don de Sa miséricorde. Elle n'est pas méritée — elle est donnée. Personne ne peut réclamer la miséricorde comme un dû. Elle reste un don, et le donateur est libre.`,
  reflection: `La miséricorde est un don, pas un salaire. L'accepter comme don cultive la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yakhtassu bi-rahmatihi man yasha' » — Il donne Sa miséricorde particulière à qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère la miséricorde comme un don ou comme un dû ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La miséricorde n'est pas arbitraire — elle suit la sagesse d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est inondé de miséricorde. Chaque créature en est un signe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la miséricorde comme don reçoit encore plus." }
  ],
  munajat: `Ya Rahman, Ta miséricorde est un don. Je ne la mérite pas mais je la demande. Donne-moi Ta grâce particulière.`
};

MIROIR["3:75"] = {
  reference: "3:75",
  theme: ["confiance", "trahison", "justice"],
  emotion: "Prudence éclairée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amin", "Al-Wakil"],
  mirrorVersion: `« Parmi les gens du Livre, il y en a qui, si tu leur confies un trésor, te le rendent ; et il y en a qui, si tu leur confies un dinar, ne te le rendent pas. » Le miroir me montre la diversité des comportements humains. La confiance ne doit pas être aveugle. Certains sont dignes de confiance, d'autres non. La prudence n'est pas de la méfiance excessive — c'est de la sagesse.`,
  reflection: `La confiance doit être accordée avec discernement, pas aveuglément.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min ahli al-kitabi man in ta'manhu bi-qintarin yu'addihi ilayk » — parmi les gens du Livre, il y en a qui, si tu leur confies un trésor, te le rendent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je fais confiance ? Et pourquoi ? Est-ce que je connais vraiment les gens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prudence n'est pas de la méfiance — c'est de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est digne de confiance. Les humains sont variés dans leur fiabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie confiance est en Allah. Les humains sont testés par la confiance." }
  ],
  munajat: `Ya Amin, Tu es le Digne de confiance. Fais que je sois digne de confiance et que je sache à qui faire confiance. Donne-moi la prudence sage.`
};

MIROIR["3:76"] = {
  reference: "3:76",
  theme: ["piété", "confiance", "alliance"],
  emotion: "Encouragement droit",
  difficulty: "débutant",
  relatedNames: ["Al-Muttaqi", "Al-Wakil"],
  mirrorVersion: `« Ceux qui honorent leurs engagements et qui craignent Allah... Allah aime ceux qui Le craignent. » Le miroir me montre le lien entre la piété (taqwa) et la fidélité aux engagements. Honorer sa parole est un signe de piété. Allah aime ceux qui ont de la crainte respectueuse envers Lui — pas une peur paralysante, mais une conscience éveillée.`,
  reflection: `La piété se manifeste dans la fidélité à sa parole. Les engagements sont sacrés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bala man awfa bi-'ahdihi wa ittaqa » — si ! Celui qui honore son engagement et qui craint Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels engagements ai-je pris ? Est-ce que je les honore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété n'est pas abstraite — elle se voit dans les engagements respectés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers honore ses engagements. Les lois physiques ne faillent jamais." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah aime ceux qui honorent leurs engagements — c'est une forme d'adoration." }
  ],
  munajat: `Ya Muttaqi, fais que je sois pieux. Aide-moi à honorer tous mes engagements. Fais que je sois parmi ceux que Tu aimes.`
};

MIROIR["3:77"] = {
  reference: "3:77",
  theme: ["trahison", "prix", "jugement"],
  emotion: "Avertissement solennel",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Adl"],
  mirrorVersion: `« Ceux qui vendent à bon prix leur engagement avec Allah et leurs serments n'auront aucune part dans l'au-delà. » Le miroir me montre la gravité de la trahison des engagements sacrés. Vendre son alliance pour un gain matériel est le pire des commerces. Le profit de ce monde ne vaut rien comparé à la perte de l'au-delà. La trahison spirituelle n'a pas de prix.`,
  reflection: `Les engagements avec Allah ne se marchandent pas. Les trahir pour un gain est une perte totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yashtaruna bi-'ahdi Allahi thamanan qalila » — ceux qui vendent à bon prix leur engagement avec Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vends ? Qu'est-ce que j'achète au prix de mon engagement spirituel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gain matériel de la trahison est une perte spirituelle éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne trahit jamais. Les lois naturelles sont fidèles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La trahison de l'alliance avec Allah prive de tout bien dans l'au-delà." }
  ],
  munajat: `Ya Rabb, garde-moi de trahir mon engagement avec Toi. Aucun gain ne vaut la perte de Ton alliance. Fais que je sois fidèle.`
};

MIROIR["3:78"] = {
  reference: "3:78",
  theme: ["falsification", "parole", "hypocrisie"],
  emotion: "Dénonciation claire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khabyr"],
  mirrorVersion: `« Il y a parmi eux un groupe qui tord le Livre avec leur langue pour que vous le preniez pour du Livre. » Le miroir me montre la falsification subtile : faire dire au texte ce qu'il ne dit pas. Les hypocrites font semblant de lire le Livre tout en le déformant. La parole humaine se substitue à la parole divine. La vigilance est nécessaire.`,
  reflection: `La falsification peut être subtile. Il faut connaître le vrai pour reconnaître le faux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yalwuna alsinatahum bi-al-kitabi » — ils tordent leurs langues avec le Livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tords le sens des textes pour qu'ils disent ce que je veux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La falsification est plus grave que l'ignorance. Elle détourne la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne peut pas être tordue. Seule sa représentation peut l'être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment le Livre ne peut pas être trompé par les falsifications." }
  ],
  munajat: `Ya Haqq, préserve-moi de falsifier Ta parole. Fais que je la transmette telle qu'elle est, sans torsion, sans ajout, sans retrait.`
};

MIROIR["3:79"] = {
  reference: "3:79",
  theme: ["prophète", "adoration", "pureté"],
  emotion: "Clarté absolue",
  difficulty: "débutant",
  relatedNames: ["Al-Abd", "Al-Rabb"],
  mirrorVersion: `« Il ne conviendrait pas à un homme qu'Allah lui donne le Livre, la sagesse et la prophétie, puis qu'il dise aux gens : Soyez mes adorateurs et non ceux d'Allah. » Le miroir me montre la fonction du prophète : guider vers Allah, pas vers lui-même. Le prophète est un serviteur qui appelle à adorer le Seigneur, pas un intermédiaire qui demande l'adoration pour lui.`,
  reflection: `Le prophète ne demande pas qu'on l'adore — il demande qu'on adore Allah à travers son enseignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kunu 'ibadan li min duni Allah » — soyez mes adorateurs en dehors d'Allah. Ce que le prophète ne dirait jamais." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui j'adore ? Le prophète mène-t-il à Allah ou me détourne-t-il d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai prophète reste un serviteur. Seul Allah est adoré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création adore Allah. Les prophètes sont les guides de cette adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le prophète correctement arrive à Allah, pas au prophète." }
  ],
  munajat: `Ya Rabb, fais que je T'adore à travers l'enseignement de Tes prophètes. Ne permets pas que je m'égare en adorant autre que Toi.`
};

MIROIR["3:80"] = {
  reference: "3:80",
  theme: ["obéissance", "alliance", "prophète"],
  emotion: "Ordre clair",
  difficulty: "débutant",
  relatedNames: ["Al-Amr", "Al-Tawwab"],
  mirrorVersion: `« Il ne vous ordonnerait pas de prendre les anges et les prophètes pour seigneurs. » Le miroir me montre l'impossibilité qu'un prophète ordonne l'adoration d'autre qu'Allah. Les prophètes viennent pour briser les idoles, pas pour en créer de nouvelles. L'adoration des anges ou des prophètes contredit leur message même.`,
  reflection: `Les intermédiaires ne doivent pas devenir des objets d'adoration. Le chemin mène à Allah seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la ya'murakum an tattakhidhu al-mala'ikata wa al-nabiyina arbaban » — il ne vous ordonnerait pas de prendre les anges et les prophètes pour seigneurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je des intermédiaires que j'adore ? Des saints, des prophètes, des anges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les intermédiaires sont des moyens, pas des fins. Allah seul est la fin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est moyen vers le Créateur. Rien ne doit être adoré en dehors de Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai chemin est direct : le cœur vers Allah, sans intermédiaire qui devient idole." }
  ],
  munajat: `Ya Rabb, fais que je n'adore que Toi. Les prophètes et les anges sont Tes serviteurs, pas des seigneurs. Garde mon adoration pure.`
};

MIROIR["3:81"] = {
  reference: "3:81",
  theme: ["alliance", "prophète", "promesse"],
  emotion: "Engagement solennel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ahd", "Al-Wafi"],
  mirrorVersion: `« Quand Allah prit l'engagement des prophètes : Je vous ai donné du Livre et de la sagesse. Puis un messager viendra confirmer ce que vous avez. » Le miroir me montre l'alliance primordiale des prophètes. Tous ont promis de croire au messager final qui confirmerait leur message. Cette alliance unit tous les prophètes dans une chaîne de fidélité.`,
  reflection: `Les prophètes sont liés par une alliance. Croire au dernier, c'est honorer l'engagement des premiers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh akhadha Allahu mithaqa al-nabiyina » — quand Allah prit l'engagement des prophètes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels engagements ai-je pris ? Est-ce que je les honore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance des prophètes inclut tous les croyants qui suivent leur chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance divine traverse l'histoire. Chaque prophète est un maillon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Honorer l'alliance des prophètes, c'est croire en tous et suivre le dernier." }
  ],
  munajat: `Ya Wafi, Tu as pris l'alliance des prophètes. Fais que je sois fidèle à cette alliance. Crois en tous Tes prophètes et suis le dernier.`
};

MIROIR["3:82"] = {
  reference: "3:82",
  theme: ["détournement", "égarement", "justice"],
  emotion: "Conséquence claire",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Fasiqun"],
  mirrorVersion: `« Quiconque se détourne après cela est un pervers. » Le miroir me montre le statut de celui qui refuse l'alliance prophétique. Le détournement après avoir connaissance n'est pas une liberté — c'est une perversion. La connaissance crée la responsabilité. Se détourner de la vérité connue est le comble de l'égarement.`,
  reflection: `La connaissance engage. Se détourner après avoir connu est pire que ne jamais connaître.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man tawalla ba'da dhalika fa-ula'ika humu al-fasiqun » — ceux qui se détournent après cela sont les pervers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je connais et dont je me détourne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perversité (fisq) commence par le détournement de la vérité connue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas se détourner de son Créateur. Seul l'homme peut choisir la perversion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se détourne de l'alliance prophétique se détourne de tout bien." }
  ],
  munajat: `Ya Rabb, préserve-moi de la perversion du détournement. Fais que je reste ferme dans l'alliance avec Tes prophètes.`
};

MIROIR["3:83"] = {
  reference: "3:83",
  theme: ["soumission", "religion", "universe"],
  emotion: "Harmonie universelle",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Kawn"],
  mirrorVersion: `« Désirent-ils une autre religion que celle d'Allah, alors que tout ce qui est dans les cieux et la terre Lui est soumis ? » Le miroir me montre la soumission universelle. Tout dans l'univers est soumis à Allah — les étoiles, les planètes, les anges, les animaux. Seul l'homme a le choix de se soumettre ou de se rebeller. L'islam est la religion naturelle de l'univers.`,
  reflection: `La soumission à Allah est l'état naturel. La rébellion est l'exception humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaghayra dini Allahi yabghuna wa lahu aslama man fi al-samawati wa al-ard » — désirent-ils une autre religion que celle d'Allah, alors que tout dans les cieux et la terre Lui est soumis ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vie est-elle en harmonie avec l'univers soumis ? Ou suis-je en rébellion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion d'Allah n'est pas une invention — c'est la loi de l'univers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est musulman. L'homme est invité à rejoindre cette soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La soumission à Allah est la paix. La rébellion est le conflit avec l'univers." }
  ],
  munajat: `Ya Rabb, fais que ma soumission soit comme celle de l'univers. Harmonise ma vie avec Ta création. Fais que je sois en paix avec Ta loi.`
};

MIROIR["3:84"] = {
  reference: "3:84",
  theme: ["foi", "prophètes", "unité"],
  emotion: "Déclaration unifiante",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Nabiyin"],
  mirrorVersion: `« Dis : Nous croyons en Allah, à ce qu'on a fait descendre sur nous, sur Abraham, Ismaël, Isaac, Jacob... » Le miroir me montre la foi universelle qui embrasse tous les prophètes. La foi du musulman inclut tous les messagers d'Allah sans distinction ni exclusion. Nous croyons à toute la révélation, pas à une partie seulement.`,
  reflection: `La foi complète inclut tous les prophètes. La sélection est un rejet déguisé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amanna bi-Allahi wa ma unzila 'alayna » — nous croyons en Allah et à ce qui a été descendu sur nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi inclut-elle tous les prophètes ? Ou en rejette-je certains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Croire en tous les prophètes, c'est croire à la chaîne complète de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière divine a traversé tous les prophètes. Chacun est une lampe allumée par le même feu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en tous les prophètes est en harmonie avec toute l'histoire sacrée." }
  ],
  munajat: `Ya Rabb, je crois en tous Tes prophètes. Fais que ma foi soit complète, sans exclusion, sans sélection. Unifie mon cœur avec Ta révélation entière.`
};

MIROIR["3:85"] = {
  reference: "3:85",
  theme: ["islam", "salut", "exclusivité"],
  emotion: "Vérité claire",
  difficulty: "débutant",
  relatedNames: ["Al-Islam", "Al-Najat"],
  mirrorVersion: `« Et quiconque désire une religion autre que l'Islam, cela ne sera pas accepté de lui. » Le miroir me montre l'exclusivité de la voie du salut. L'islam — la soumission à Allah — est la seule religion acceptée. Ce n'est pas de l'intolérance — c'est la cohérence. Comment pourrait-on accepter autre chose que la soumission au Créateur ?`,
  reflection: `La soumission au Créateur est la seule attitude juste. Les alternatives sont des égarements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yabtaghi ghayra al-islami dinan fa-lan yuqbala minhu » — quiconque désire une autre religion que l'islam, cela ne sera pas accepté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vraiment dans l'islam ? Ou est-ce que je cherche d'autres chemins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'islam n'est pas une marque — c'est l'attitude juste de la créature devant le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est dans l'islam. L'homme est invité à rejoindre cette harmonie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation de l'islam est la clé de l'acceptation dans l'au-delà." }
  ],
  munajat: `Ya Rabb, fais que je sois vraiment dans l'islam. Ne permets pas que je cherche d'autres chemins. Accepte ma soumission sincère.`
};

MIROIR["3:86"] = {
  reference: "3:86",
  theme: ["guidance", "mécréance", "égarement"],
  emotion: "Réalité spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Comment Allah guiderait-Il des gens qui ont mécru après avoir cru et témoigné de la vérité du Messager ? » Le miroir me montre le danger de l'apostasie. Ceux qui ont cru, témoigné, puis mécru se sont fermé la porte de la guidance. Le retour est possible, mais la guidance n'est plus garantie pour ceux qui ont rejeté la vérité après l'avoir connue.`,
  reflection: `La guidance peut être retirée. La mécréance après la foi est le plus grand danger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa yahdi Allahu qawman kafaru ba'da imanihim » — comment Allah guiderait-Il des gens qui ont mécru après avoir cru ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens fermement à ma foi ? Ou est-ce que je risque de la perdre ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La guidance retirée est le pire châtiment. C'est l'abandon spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut pas mécroire. Seul l'homme peut se détourner après avoir cru." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection de la guidance est la première prière du croyant." }
  ],
  munajat: `Ya Hadi, protège ma guidance. Ne permets pas que je mécroie après avoir cru. Tiens mon cœur fermement dans Ta main.`
};

MIROIR["3:87"] = {
  reference: "3:87",
  theme: ["châtiment", "mécréance", "malédiction"],
  emotion: "Gravité sévère",
  difficulty: "débutant",
  relatedNames: ["Al-La'na", "Al-Ghadab"],
  mirrorVersion: `« Ceux-là, leur rétribution est la malédiction d'Allah, des anges et de tous les hommes. » Le miroir me montre la gravité de l'apostasie. La malédiction (la'na) signifie l'éloignement de la miséricorde. Être maudit par Allah, les anges et tous les hommes est le comble du rejet. C'est l'exclusion totale de la communauté de la foi.`,
  reflection: `La malédiction n'est pas une punition arbitraire — c'est la conséquence du choix de se séparer d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika jazauhum anna 'alayhim la'nata Allahi » — ceux-là, leur rétribution est qu'ils ont sur eux la malédiction d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois la malédiction ? Est-ce que je la crains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La malédiction est l'opposé de la bénédiction. Choisir l'une, c'est rejeter l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est béni par sa soumission. Seul le rebelle se place sous la malédiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection contre la malédiction est de rester fermement dans la foi." }
  ],
  munajat: `Ya Rabb, protège-moi de Ta malédiction. Garde-moi dans Ta bénédiction. Ne permets pas que je sois parmi les exclus.`
};

MIROIR["3:88"] = {
  reference: "3:88",
  theme: ["éternité", "châtiment", "punition"],
  emotion: "Permanence effrayante",
  difficulty: "débutant",
  relatedNames: ["Al-Khalud", "Al-Abad"],
  mirrorVersion: `« Ils y demeureront éternellement. Le châtiment ne leur sera pas allégé, et ils ne seront pas exaucés. » Le miroir me montre l'éternité du châtiment pour ceux qui mécroient après avoir cru. Pas d'allègement, pas d'exaucement, pas de sortie. La gravité de l'apostasie se mesure à la permanence de ses conséquences.`,
  reflection: `L'éternité du châtiment montre la gravité du crime spirituel. La miséricorde n'est pas sans limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalidina fihi » — ils y demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la permanence des conséquences de mes choix spirituels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité du châtiment correspond à l'éternité du rejet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les conséquences dans l'univers sont durables. Les conséquences spirituelles sont éternelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur de l'éternité du châtiment est un moteur de persévérance dans la foi." }
  ],
  munajat: `Ya Rabb, la perspective de l'éternité dans le châtiment me terrifie. Garde-moi ferme dans la foi. Ne permets pas que je connaisse cette permanence terrible.`
};

MIROIR["3:89"] = {
  reference: "3:89",
  theme: ["repentir", "miséricorde", "espoir"],
  emotion: "Espoir libérateur",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Sauf ceux qui se repentent après cela et se réforment. Allah est Pardonneur et Miséricordieux. » Le miroir me montre la porte ouverte du repentir. Même après l'apostasie, le retour est possible. Le repentir (tawba) efface le passé. La réforme (islah) prouve la sincérité. La miséricorde d'Allah précède Sa colère.`,
  reflection: `Le repentir est toujours possible. La porte n'est jamais fermée pour celui qui revient sincèrement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina tabu min ba'di dhalika wa aslahu » — sauf ceux qui se repentent après cela et se réforment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je me suis égaré, est-ce que je reviens ? Le repentir est-il sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir efface même le pire des crimes : l'apostasie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers offre toujours une seconde chance. Le printemps suit l'hiver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La miséricorde d'Allah est plus vaste que tous les péchés." }
  ],
  munajat: `Ya Tawwab, Tu aimes le repentir. Si je m'égare, fais-moi revenir. Accepte mon repentir et ma réforme. Ta miséricorde est mon seul espoir.`
};

MIROIR["3:90"] = {
  reference: "3:90",
  theme: ["mécréance", "entêtement", "répétition"],
  emotion: "Avertissement sévère",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Maqt", "Al-Ghadab"],
  mirrorVersion: `« Ceux qui ont mécru après avoir cru, puis ont accru leur mécréance, leur repentir ne sera jamais accepté. » Le miroir me montre le danger de la répétition. Mécréance après foi, puis augmentation de la mécréance — c'est l'entêtement dans l'erreur. Pour ceux-là, la porte se ferme. L'entêtement scelle le destin.`,
  reflection: `La répétition du mal peut fermer la porte du repentir. L'entêtement est spirituellement mortel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru ba'da imanihum thumma izdadu kufran » — ceux qui ont mécru après avoir cru, puis ont accru leur mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je répète mes erreurs ? Mon entêtement me mène-t-il à la fermeture ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "L'augmentation de la mécréance montre que le repentir n'était pas sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La répétition crée une habitude. L'habitude crée un destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'entête dans le mal scelle son propre sort." }
  ],
  munajat: `Ya Rabb, garde-moi de l'entêtement dans l'erreur. Fais que chaque erreur soit suivie d'un repentir sincère. Ne permets pas que ma mécréance augmente.`
};

MIROIR["3:91"] = {
  reference: "3:91",
  theme: ["ransom", "châtiment", "regret"],
  emotion: "Réalité irréversible",
  difficulty: "débutant",
  relatedNames: ["Al-Hasana", "Al-Jahim"],
  mirrorVersion: `« Ceux qui ont mécru et sont morts mécréants, la terre entière pleine d'or ne serait pas acceptée d'eux comme rançon. » Le miroir me montre l'impossibilité de la compensation tardive. Au Jour du Jugement, même toute la richesse du monde ne rachèterait pas une vie passée dans la mécréance. Le regret sera immense, mais la compensation sera refusée.`,
  reflection: `Le temps de la compensation est maintenant. Après la mort, c'est trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan tuqbala minhu midalu ardi zahaban » — la terre entière pleine d'or ne serait pas acceptée de lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je donnerais pour racheter mes erreurs ? Et si c'était trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compensation avec de l'or est refusée. Seules les œuvres sincères comptent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est le point de non-retour. Après elle, tout est figé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie compensation est de donner sa vie à Allah maintenant, pas son or après." }
  ],
  munajat: `Ya Rabb, je ne veux pas arriver au Jour du Jugement avec seulement des regrets. Fais que je Te donne ma vie maintenant. Accepte mon offrande avant qu'il soit trop tard.`
};

MIROIR["3:92"] = {
  reference: "3:92",
  theme: ["don", "sacrifice", "piété"],
  emotion: "Invitation généreuse",
  difficulty: "débutant",
  relatedNames: ["Al-Birr", "Al-Karim"],
  mirrorVersion: `« Vous n'atteindrez la vraie piété que si vous faites dépense de ce que vous aimez. » Le miroir me montre le critère de la vraie générosité : donner ce qu'on aime, pas ce qu'on n'aime pas. La piété (birr) se mesure au sacrifice. Ce qu'on garde pour soi révèle ce qu'on aime vraiment. Ce qu'on donne révèle ce qu'on aime davantage : Allah ou les biens.`,
  reflection: `La vraie générosité coûte. Donner ce qu'on n'aime pas n'est pas un sacrifice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan tanalu al-birra hatta tunfiqu mimma tuhibbun » — vous n'atteindrez la piété que si vous faites dépense de ce que vous aimez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aime le plus ? Est-ce que j'en fais dépense dans le chemin d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner ce qu'on aime prouve qu'on aime Allah plus que la chose donnée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne généreusement. Le soleil donne sa lumière sans compter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne ce qu'il aime reçoit d'Allah ce qui vaut infiniment plus." }
  ],
  munajat: `Ya Karim, Tu aimes la générosité. Fais que je donne ce que j'aime. Apprends-moi à préférer Ton amour à tout autre amour. Accepte mon sacrifice.`
};

MIROIR["3:93"] = {
  reference: "3:93",
  theme: ["nourriture", "loi", "falsification"],
  emotion: "Clarification historique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Toute nourriture était permise aux enfants d'Israël, sauf celle qu'Israël s'interdisait avant que la Torah ne fût descendue. » Le miroir me montre l'histoire des interdits alimentaires. Les restrictions n'étaient pas originelles — elles ont été introduites plus tard. La Torah a officialisé ce qui était déjà une coutume. Ce verset établit l'antériorité de la permission originelle.`,
  reflection: `Les interdits peuvent être des constructions humaines. La permission divine est originelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu al-ta'ami kana hillan li-bani Isra'ila » — toute nourriture était permise aux enfants d'Israël." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels interdits ai-je créés pour moi-même ? Sont-ils divins ou humains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission originelle reflète la générosité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est bonne par essence. Les interdits sont des exceptions pour des raisons précises." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Comprendre l'histoire des lois permet de distinguer le divin de l'humain." }
  ],
  munajat: `Ya Rabb, clarifie-moi Tes lois. Fais que je distingue ce qui vient de Toi de ce qui vient des hommes. Libère-moi des interdits auto-imposés.`
};

MIROIR["3:94"] = {
  reference: "3:94",
  theme: ["mensonge", "invention", "avertissement"],
  emotion: "Mise en garde solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Kadhib", "Al-Muftari"],
  mirrorVersion: `« Après cela, quiconque invente un mensonge contre Allah, ceux-là sont les injustes. » Le miroir me montre la gravité d'attribuer à Allah ce qu'Il n'a pas dit. Inventer des interdits ou des permissions au nom d'Allah est un mensonge grave. L'injustice (zulm) est de mettre des paroles dans la bouche d'Allah.`,
  reflection: `Attribuer à Allah ce qu'Il n'a pas dit est le comble de l'injustice. La prudence est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man iftara 'ala Allahi al-kadhiba ba'da dhalika » — quiconque invente un mensonge contre Allah après cela." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah des paroles qu'Il n'a pas dites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sur Allah déforme Sa religion et égare les gens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur le Créateur ne peut pas être inventée. Elle est révélée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ment sur Allah se place dans une position terrible au Jour du Jugement." }
  ],
  munajat: `Ya Rabb, préserve-moi du mensonge sur Toi. Fais que je ne dise que ce que Tu as dit. Garde ma langue de l'invention religieuse.`
};

MIROIR["3:95"] = {
  reference: "3:95",
  theme: ["Abraham", "soumission", "pureté"],
  emotion: "Appel clair",
  difficulty: "débutant",
  relatedNames: ["Al-Hanif", "Al-Muslim"],
  mirrorVersion: `« Dis : Allah a dit la vérité. Suivez donc la religion d'Abraham, le croyant pur qui n'était pas des associateurs. » Le miroir me montre le retour à la source. La religion d'Abraham est la religion de la pureté (hanifiya). Pas d'association, pas de complication — la soumission pure à Allah. C'est le chemin de tous les prophètes.`,
  reflection: `Retourner à Abraham, c'est retourner à l'essence de la religion : la soumission pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittabi'u millata Ibrahim hanifan » — suivez la religion d'Abraham, le croyant pur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis vraiment la religion d'Abraham ? La soumission pure ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion d'Abraham est antérieure à toutes les divisions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté d'Abraham est la pureté de l'univers : soumission au Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Abraham vraiment suit tous les prophètes." }
  ],
  munajat: `Ya Rabb, fais que je suive la religion d'Abraham. Donne-moi la pureté de cœur qui soumet tout à Toi. Éloigne-moi de toute association.`
};

MIROIR["3:96"] = {
  reference: "3:96",
  theme: ["Kaaba", "bénédiction", "première"],
  emotion: "Révérence sacrée",
  difficulty: "débutant",
  relatedNames: ["Al-Bayt", "Al-Mubarak"],
  mirrorVersion: `« La première Maison qui a été édifiée pour les gens, c'est bien celle de Bakka, bénie et une guidance pour l'univers. » Le miroir me place devant la Maison sacrée. La Kaaba est la première maison de culte pour l'humanité. Bénie (mubarakah), elle est une guidance pour tous les mondes. Le pèlerinage vers elle est un retour aux sources.`,
  reflection: `La Kaaba est le centre spirituel de l'humanité. S'y tourner, c'est s'unir à tous les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna awwala baytin wudi'a li-al-nasi la-alladhi bi-Bakkata mubarakan » — la première Maison édifiée pour les gens est celle de Bakka, bénie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon rapport avec la Maison sacrée ? Est-ce que je m'y tourne en esprit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Kaaba n'est pas qu'un bâtiment — c'est le centre spirituel de l'humanité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Maison sacrée est un point de convergence pour l'univers entier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la Kaaba comprend l'unité de la communauté humaine sous Dieu." }
  ],
  munajat: `Ya Rabb, Ta Maison est bénie. Fais que je m'y tourne en esprit et en corps. Inclus-moi parmi les visiteurs de Ta Maison sacrée.`
};

MIROIR["3:97"] = {
  reference: "3:97",
  theme: ["pèlerinage", "obligation", "capacité"],
  emotion: "Appel pressant",
  difficulty: "débutant",
  relatedNames: ["Al-Hajj", "Al-Mustati"],
  mirrorVersion: `« Le pèlerinage à la Maison est un devoir envers Allah pour quiconque peut le faire. » Le miroir me montre l'obligation du pèlerinage. C'est un droit d'Allah sur Ses serviteurs capables. La capacité (istita'a) inclut les moyens physiques et financiers. Ce devoir n'est pas une option pour celui qui peut l'accomplir.`,
  reflection: `Le pèlerinage est un droit d'Allah. Si je peux, je dois. La capacité crée l'obligation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-Allahi 'ala al-nasi hijju al-bayti man istata'a ilayhi sabila » — le pèlerinage à la Maison est un devoir pour quiconque peut le faire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je peux accomplir le pèlerinage ? Si oui, qu'est-ce que j'attends ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La capacité est un don d'Allah. L'utiliser pour Le visiter est la reconnaissance du don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Des millions convergent vers ce point. L'humanité entière tourne autour de ce centre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le pèlerinage accompli purifie comme le jour de la naissance." }
  ],
  munajat: `Ya Rabb, si j'ai la capacité, ouvre-moi le chemin du pèlerinage. Fais que je réponde à Ton appel. Accepte mon pèlerinage.`
};

MIROIR["3:98"] = {
  reference: "3:98",
  theme: ["signes", "témoignage", "gens du Livre"],
  emotion: "Interpellation directe",
  difficulty: "débutant",
  relatedNames: ["Al-Bayyinat", "Al-Shahadah"],
  mirrorVersion: `« Dis : Ô gens du Livre, pourquoi ne croyez-vous pas aux signes d'Allah ? Allah est témoin de ce que vous faites. » Le miroir me montre l'appel direct aux gens du Livre. Les signes (ayat) sont manifestes, mais le refus persiste. Allah témoin de tout — rien n'est caché. Le refus n'est pas un manque de preuves mais un manque de volonté.`,
  reflection: `Les signes sont là. Le refus vient du cœur, pas de l'absence de preuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lima takfuruna bi-ayati Allah » — pourquoi ne croyez-vous pas aux signes d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes d'Allah je refuse ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus des signes est le refus de la guidance offerte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est signe. Chaque créature témoigne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah est témoin du refus comme de l'acceptation." }
  ],
  munajat: `Ya Rabb, fais que je ne refuse aucun de Tes signes. Ouvre mes yeux à Ta création. Fais que je croie en tout ce qui vient de Toi.`
};

MIROIR["3:99"] = {
  reference: "3:99",
  theme: ["obstacle", "égarement", "justice"],
  emotion: "Dénonciation claire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabil", "Al-Muwajjah"],
  mirrorVersion: `« Dis : Ô gens du Livre, pourquoi détournez-vous du chemin d'Allah celui qui croit ? » Le miroir me montre l'obstruction active à la guidance. Certains ne se contentent pas de ne pas croire — ils veulent empêcher les autres de croire. Cette obstruction est une injustice. Le chemin d'Allah doit être ouvert pour tous.`,
  reflection: `Obstruer le chemin d'Allah est un crime spirituel. La guidance doit être accessible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lima tasudduna 'an sabili Allahi » — pourquoi détournez-vous du chemin d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je détourne les autres du chemin d'Allah ? Par mes paroles ou mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Obstruire le chemin d'Allah est pire que ne pas l'emprunter soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'obstrue aucun chemin. Tout y circule librement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre le chemin d'Allah reçoit la même récompense que celui qui l'emprunte." }
  ],
  munajat: `Ya Rabb, ne permets pas que je sois un obstacle sur Ton chemin. Fais que je sois un guide, pas un égareur. Ouvre les chemins par moi.`
};

MIROIR["3:100"] = {
  reference: "3:100",
  theme: ["obéissance", "égarement", "avertissement"],
  emotion: "Mise en garde urgente",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Dalal"],
  mirrorVersion: `« Ô vous qui avez cru, si vous obéissez à un groupe de ceux à qui le Livre a été donné, ils vous feront redevenir mécréants après avoir cru. » Le miroir me montre le danger de l'obéissance à ceux qui veulent égarer. L'obéissance n'est pas neutre — elle peut mener à l'apostasie. La vigilance est nécessaire quant à ceux qu'on suit.`,
  reflection: `L'obéissance peut mener à l'égarement. Il faut discerner à qui on obéit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tuti'u fariqan min alladhina utu al-kitaba yaruddukum ba'da imanikum kafirin » — si vous obéissez à un groupe de ceux à qui le Livre a été donné, ils vous feront redevenir mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui j'obéis ? Est-ce que ceux que je suis me rapprochent d'Allah ou m'en éloignent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance n'est pas toujours vertu — elle dépend de qui on obéit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah seul. L'homme peut choisir d'obéir à d'autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie obéissance est à Allah et à Son messager, pas aux égareurs." }
  ],
  munajat: `Ya Rabb, garde-moi de l'obéissance à ceux qui veulent m'égarer. Fais que je n'obéisse qu'à Toi et à Ton messager. Protège ma foi.`
};

// ==================== SURAH 3: AL-IMRAN - Versets 101-200 ====================

MIROIR["3:101"] = {
  reference: "3:101",
  theme: ["foi", "guidance", "question"],
  emotion: "Interrogation intérieure",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mu'min"],
  mirrorVersion: `« Comment pouvez-vous ne pas croire, alors que les versets d'Allah vous sont récités et que Son messager est parmi vous ? » Le miroir me pose cette question directe. Les conditions de la foi sont réunies : la révélation est présente, le guide est là. Qu'est-ce qui empêche la croyance ? Le miroir m'interroge sur mes propres blocages.`,
  reflection: `La foi n'est pas impossible — les conditions sont souvent remplies. L'obstacle est intérieur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kayfa takfuruna » — comment pouvez-vous ne pas croire ? Une question rhétorique qui interpelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de croire vraiment ? La révélation est là, la guidance est présente." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incrédulité est un choix, pas une fatalité. La foi est possible pour tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame la vérité. L'homme seul peut choisir de fermer les yeux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie question n'est pas « comment croire » mais « pourquoi ne pas croire »." }
  ],
  munajat: `Ya Hadi, les versets sont là et Tu es proche. Ouvre mon cœur à la foi. Éloigne les obstacles que j'ai moi-même placés.`
};

MIROIR["3:102"] = {
  reference: "3:102",
  theme: ["taqwa", "piété", "mort"],
  emotion: "Vigilance spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muttaqin", "Al-Haqq"],
  mirrorVersion: `« Ô vous qui avez cru, craignez Allah comme Il doit être craint. » Le miroir me montre la distance entre ma taqwa et ce qu'elle devrait être. « Comme Il doit être craint » — pas comme je le fais actuellement. Cette crainte n'est pas la peur, mais la conscience constante de Sa présence. Ne mourez qu'en état de soumission — la mort comme finalité de la vie.`,
  reflection: `La taqwa véritable transcende la peur ordinaire. C'est une conscience qui façonne chaque acte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Haqqa tuqatihi » — comme Il doit être craint. Le véritable niveau de taqwa." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma taqwa est-elle à la hauteur ? Ou est-elle superficielle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah n'oppresse pas — elle libère de la peur de tout le reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers « craint » Allah par sa soumission naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint vraiment Allah ne craint plus rien d'autre." }
  ],
  munajat: `Ya Rabb, enseigne-moi la vraie taqwa. Pas la peur, mais la conscience de Toi. Fais que je me soumette totalement avant de Te rencontrer.`
};

MIROIR["3:103"] = {
  reference: "3:103",
  theme: ["unité", "fraternité", "gratitude"],
  emotion: "Reconnaissance communautaire",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Jami'"],
  mirrorVersion: `« Et attachez-vous tous au câble d'Allah, et ne vous divisez pas. » Le miroir me montre le remède à la division : le câble d'Allah (habl Allah). Ce câble est le Coran, la révélation, la vérité. S'y attacher ensemble crée l'unité. Rappelez-vous la grâce d'Allah : vous étiez ennemis, Il a réuni vos cœurs. La fraternité est un don divin.`,
  reflection: `L'unité n'est pas une construction humaine — c'est une grâce divine. Les cœurs sont unis par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Habl Allah » — le câble d'Allah. Une métaphore de force et de lien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'attache au câble d'Allah ? Ou est-ce que je crée des divisions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ennemis d'hier sont les frères d'aujourd'hui. La transformation est possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est uni par des lois uniques. La diversité n'empêche pas l'unité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache au câble d'Allah est uni à tous ceux qui s'y attachent." }
  ],
  munajat: `Ya Jami', réunis mon cœur avec les croyants. Attache-moi à Ton câble. Ne permets pas que je sois une source de division.`
};

MIROIR["3:104"] = {
  reference: "3:104",
  theme: ["communauté", "commandement", "bien"],
  emotion: "Responsabilité collective",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Khair"],
  mirrorVersion: `« Qu'il sorte de vous une communauté qui appelle au bien, ordonne le convenable et interdit le blâmable. » Le miroir me montre ma responsabilité dans la communauté. Appeler au bien, commander le convenable, interdire le blâmable — trois missions. Ces bienheureux — ce sont eux qui réussissent.`,
  reflection: `La communauté a besoin de guides qui orientent vers le bien. Chaque croyant a un rôle à jouer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta'muruna bi al-ma'ruf wa tanhawna 'an al-munkar » — ordonner le bien et interdire le mal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'appelle au bien ? Est-ce que j'interdis le mal ? Ou suis-je passif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ordonner le bien commence par le faire soi-même. Interdire le mal commence par l'éviter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par un ordre. L'homme est appelé à maintenir l'ordre moral." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide vers le bien est lui-même guidé." }
  ],
  munajat: `Ya Khair, fais de moi un appelant au bien. Donne-moi la force d'interdire le mal. Fais que je sois parmi les bienheureux.`
};

MIROIR["3:105"] = {
  reference: "3:105",
  theme: ["division", "avertissement", "épreuve"],
  emotion: "Mise en garde solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Adl"],
  mirrorVersion: `« Ne soyez pas comme ceux qui se sont divisés et ont divergé, après que les preuves leur soient venues. » Le miroir me montre le danger de la division après la guidance. Ce n'est pas la divergence d'opinion qui est condamnée — c'est la division qui brise la communauté. Les preuves étaient claires, mais ils ont choisi la séparation.`,
  reflection: `La division après la guidance est une ingratitude. L'unité est une obligation spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tafarraqu wa ikhtalafu » — se diviser et diverger. Deux maux distincts mais liés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contribue à l'unité ou à la division ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La division est souvent le fruit de l'ego, pas de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un malgré sa diversité. La créature divisée perd sa force." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui divise détruit ce qu'Allah a uni." }
  ],
  munajat: `Ya Wahid, garde-moi de la division. Unifie mon cœur avec les croyants. Ne permets pas que je sois parmi ceux qui brisent l'unité.`
};

MIROIR["3:106"] = {
  reference: "3:106",
  theme: ["jugement", "visage", "lumière"],
  emotion: "Attente du Jour dernier",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "An-Nur"],
  mirrorVersion: `« Ce jour-là, des visages seront illuminés et d'autres assombris. » Le miroir me projette vers le Jour du Jugement. Les visages reflètent les œuvres. Lumière pour ceux qui ont cru, ténèbres pour ceux qui ont rejeté. Le visage ne ment pas — il révèle l'état intérieur.`,
  reflection: `Le visage au Jour dernier révèle ce que le cœur a caché pendant la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wujuhun yawma'idhin musfirah » — des visages ce jour-là illuminés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment sera mon visage ce jour-là ? Illuminé ou assombri ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière du visage vient de la lumière du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière et les ténèbres sont les deux réalités de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a illuminé son cœur par la foi aura un visage illuminé." }
  ],
  munajat: `Ya Nur, illumine mon visage par la lumière de la foi. Ne permets pas que je sois parmi ceux aux visages assombris. Donne-moi la lumière au Jour dernier.`
};

MIROIR["3:107"] = {
  reference: "3:107",
  theme: ["paradis", "lumière", "joie"],
  emotion: "Espérance lumineuse",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Karim"],
  mirrorVersion: `« Quant à ceux dont les visages seront illuminés, ils seront dans la miséricorde d'Allah, où ils demeureront éternellement. » Le miroir me montre la destination finale des croyants. La miséricorde d'Allah n'est pas temporaire — elle est éternelle. Les visages illuminés reflètent cette joie sans fin.`,
  reflection: `Le Paradis n'est pas une récompense temporaire. C'est un état éternel dans la miséricorde d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi rahmati Allah » — dans la miséricorde d'Allah. L'éternité dans le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je sur le chemin de cette lumière ? Mon visage sera-t-il illuminé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité dans la miséricorde commence par la miséricorde dans cette vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination finale de toute chose créée pour le bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte à la miséricorde d'Allah ici-bas la reconnaîtra là-bas." }
  ],
  munajat: `Ya Rahman, fais que je sois parmi ceux dont les visages sont illuminés. Place-moi dans Ta miséricorde pour l'éternité.`
};

MIROIR["3:108"] = {
  reference: "3:108",
  theme: ["versets", "justice", "clarté"],
  emotion: "Confiance dans la révélation",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Adl"],
  mirrorVersion: `« Ce sont les versets d'Allah que Nous te récitons avec vérité. » Le miroir me montre l'authenticité de la révélation. Les versets ne sont pas des contes — ils sont vérité. Allah ne veut pas d'injustice pour les mondes. La révélation est juste et pour le bien de tous.`,
  reflection: `La révélation est vérité et justice. Allah ne veut que le bien pour Sa création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayat Allah » — ce sont les versets d'Allah. La source est divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère les versets comme vérité ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice d'Allah est dans la révélation. Il ne veut pas l'injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est pour tous les mondes, pas seulement pour une communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la justice d'Allah comprend la révélation." }
  ],
  munajat: `Ya Haqq, Tes versets sont vérité. Fais que je les lise avec confiance. Ne permets pas que je doute de Ta révélation.`
};

MIROIR["3:109"] = {
  reference: "3:109",
  theme: ["souveraineté", "création", "retour"],
  emotion: "Humilité devant la grandeur",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Khaliq"],
  mirrorVersion: `« À Allah appartient tout ce qui est dans les cieux et sur la terre. » Le miroir me montre l'étendue de la souveraineté divine. Tout Lui appartient — les cieux, la terre, et tout ce qu'ils contiennent. Et c'est vers Lui que tout retourne. Je ne possède rien — je suis un gérant temporaire.`,
  reflection: `La vraie possession n'existe pas. Tout appartient à Allah et retourne à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillahi ma fi al-samawati wa al-ard » — à Allah appartient tout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je crois posséder ? Tout retourne à Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne rien posséder vraiment est une libération, pas une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient à son Créateur. Rien n'est sans propriétaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend qu'il ne possède rien possède tout en Allah." }
  ],
  munajat: `Ya Malik, tout T'appartient. Fais que je gère ce que Tu m'as confié avec justice. Rappelle-moi que tout retourne à Toi.`
};

MIROIR["3:110"] = {
  reference: "3:110",
  theme: ["communauté", "exemplarité", "mission"],
  emotion: "Responsabilité noble",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khair", "Al-Hadi"],
  mirrorVersion: `« Vous êtes la meilleure communauté qu'on ait fait surgir pour les hommes. » Le miroir me montre l'honneur et la responsabilité de la communauté croyante. Pourquoi la meilleure ? Parce qu'elle ordonne le bien, interdit le mal, et croit en Allah. Cette excellence n'est pas un privilège — c'est une mission.`,
  reflection: `L'excellence de la communauté vient de sa mission. Sans mission, elle devient ordinaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khayra ummatin ukhrijat li al-nas » — la meilleure communauté surgie pour les hommes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je participe à cette excellence ? Ou est-ce que je la diminue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excellence n'est pas donnée — elle se construit par les actions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a un rôle. La communauté croyante a le rôle de guider." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit sa mission vit son excellence." }
  ],
  munajat: `Ya Khair, fais de moi un membre actif de cette communauté. Aide-moi à ordonner le bien et interdire le mal. Ne permets pas que je sois un poids.`
};

MIROIR["3:111"] = {
  reference: "3:111",
  theme: ["nuisance", "foi", "rétribution"],
  emotion: "Confiance face à l'adversité",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Ils ne vous nuiront que par quelques dommages. » Le miroir me montre la limite du mal que peuvent faire les ennemis. Quelques dommages — rien de fatal. S'ils vous combattent, ils tourneront le dos. La protection d'Allah est réelle. Les dégâts des ennemis sont limités par le décret divin.`,
  reflection: `Le mal des ennemis est limité. Allah protège ceux qui croient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan yadurrukum illa dha » — ils ne vous nuiront qu'un peu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les ennemis plus que je ne fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuisance limitée est une promesse. La protection divine est réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mal dans l'univers est limité par la miséricorde divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est protégé par Allah ne peut être vraiment touché." }
  ],
  munajat: `Ya Hafiz, protège-moi de la nuisance des ennemis. Rappelle-moi que leur mal est limité. Donne-moi confiance en Ta protection.`
};

MIROIR["3:112"] = {
  reference: "3:112",
  theme: ["humiliation", "alliance", "protection"],
  emotion: "Mise en garde solennelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Aziz", "Al-Jabbar"],
  mirrorVersion: `« Frappés d'humiliation où qu'ils se trouvent, sauf s'ils sont protégés par un pacte d'Allah ou un pacte des hommes. » Le miroir me montre les conséquences de l'égarement. Ceux qui délaissent Allah vivent dans l'humiliation. Seule protection : un lien avec Allah ou avec les hommes. L'isolement spirituel mène à la perte.`,
  reflection: `L'humiliation est le fruit de l'éloignement d'Allah. La protection vient du lien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Duribat 'alayhim al-dhillatu » — l'humiliation a été frappée sur eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recherche la protection d'Allah ? Ou est-ce que je m'isole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation n'est pas une fatalité — c'est une conséquence du choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être a besoin d'appartenance. L'isolement est contre-nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a l'alliance d'Allah n'a pas besoin d'autre protection." }
  ],
  munajat: `Ya 'Aziz, protège-moi de l'humiliation. Donne-moi Ton alliance. Ne permets pas que je sois isolé de Toi.`
};

MIROIR["3:113"] = {
  reference: "3:113",
  theme: ["droiture", "gens du livre", "nuit"],
  emotion: "Reconnaissance de la sincérité",
  difficulty: "débutant",
  relatedNames: ["Al-Qa'im", "Al-Haqq"],
  mirrorVersion: `« Ils ne sont pas tous pareils. Parmi les gens du Livre, il est une communauté droite. » Le miroir me montre que la généralisation est une erreur. Parmi ceux qui ont reçu le Livre, il y a des justes. Ils récitent les versets d'Allah la nuit et se prosternent. La sincérité existe partout où les cœurs sont droits.`,
  reflection: `La vérité n'est pas monopolisée. Les cœurs droits existent dans toutes les communautés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ummatun qa'imah » — une communauté droite. Droiture malgré les différences." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge les groupes ? Ou est-ce que je vois les individus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droiture n'appartient à aucun groupe — elle est dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La diversité des chemins vers la vérité ne contredit pas l'unicité de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah reconnaît la droiture où qu'elle se trouve." }
  ],
  munajat: `Ya Haqq, fais que je voie la droiture partout où elle existe. Ne permets pas que je généralise injustement. Donne-moi un cœur reconnaissant.`
};

MIROIR["3:114"] = {
  reference: "3:114",
  theme: ["foi", "actions", "récompense"],
  emotion: "Espérance méritée",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Shakur"],
  mirrorVersion: `« Ils croient en Allah et au Jour dernier, ordonnent le convenable, interdisent le blâmable, et se concurrencent dans les bonnes œuvres. » Le miroir me montre les signes de la foi authentique : croyance en Allah et au Jour dernier, action en conséquence, compétition dans le bien. Ces gens-là sont parmi les justes.`,
  reflection: `La foi authentique se manifeste par des actions. La concurrence dans le bien est un signe de vie spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusari'una fi al-khayrat » — ils se concurrencent dans les bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me concurrence dans le bien ? Ou suis-je passif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La concurrence dans le bien n'est pas l'orgueil — c'est l'émulation positive." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers croît par l'accumulation du bien. L'homme participe à cette croissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se concurrence dans le bien ne peut être surpassé que par lui-même." }
  ],
  munajat: `Ya Shakur, fais que je me concurrence dans les bonnes œuvres. Donne-moi la foi authentique. Place-moi parmi les justes.`
};

MIROIR["3:115"] = {
  reference: "3:115",
  theme: ["bien", "récompense", "reconnaissance"],
  emotion: "Confiance en la justice divine",
  difficulty: "débutant",
  relatedNames: ["Al-Shakur", "Al-'Adl"],
  mirrorVersion: `« Quoi qu'ils fassent de bien, il ne leur sera pas refusé. » Le miroir me montre que chaque bonne action est comptée. Aucun bien n'est perdu. Allah connaît ceux qui Le craignent. La récompense est certaine — il suffit de faire le bien sincèrement.`,
  reflection: `Aucun bien n'est perdu. Allah connaît et récompense chaque action sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan yukfara » — il ne sera pas nié. La certitude de la reconnaissance divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais le bien avec confiance ? Ou est-ce que je doute de la récompense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance d'Allah est plus vaste que toute action humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque atome de bien contribue à l'équilibre de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien pour Allah voit le bien multiplier en lui." }
  ],
  munajat: `Ya Shakur, Tu ne nies aucun bien. Fais que je multiplie les bonnes actions. Donne-moi confiance en Ta reconnaissance.`
};

MIROIR["3:116"] = {
  reference: "3:116",
  theme: ["mécréance", "protection", "perdition"],
  emotion: "Avertissement sévère",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Hafiz"],
  mirrorVersion: `« Ceux qui ne croient pas, ni leurs biens ni leurs enfants ne les préserveront d'Allah. » Le miroir me montre l'illusion de la sécurité sans foi. Les biens et les enfants ne protègent de rien devant Allah. Ce sont les compagnons du Feu, ils y demeureront éternellement. La vraie protection est dans la foi.`,
  reflection: `Les biens et les enfants sont des illusions de protection. Seule la foi sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan tughniya 'anhum » — ils ne leur seront d'aucune utilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "En quoi est-ce que je cherche la protection ? Dans les biens ou dans la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui protège ici-bas peut perdre dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection véritable est spirituelle, pas matérielle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a que des biens n'a rien qui compte vraiment." }
  ],
  munajat: `Ya Wali, ne permets pas que je compte sur les biens ou les enfants pour ma protection. Donne-moi la foi comme seule sauvegarde.`
};

MIROIR["3:117"] = {
  reference: "3:117",
  theme: ["dépense", "vent", "ruine"],
  emotion: "Réalité amère",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhaymin", "Al-Hakim"],
  mirrorVersion: `« Ce qu'ils dépensent dans cette vie est comparable à un vent glacial qui frappe les récoltes d'un peuple injuste envers lui-même, et les détruit. » Le miroir me montre la futilité des dépenses sans foi. Un vent glacial détruit la récolte — ainsi les bonnes actions sans foi sont anéanties. L'injustice envers soi-même est de perdre le fruit de ses efforts.`,
  reflection: `Les dépenses sans sincérité sont comme des récoltes détruites. L'intention compte autant que l'action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalu ma yunfiquna » — l'exemple de ce qu'ils dépensent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes dépenses sont-elles sincères ? Ou sont-elles perdues comme la récolte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dépense sans foi est une perte. La dépense avec foi est un investissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, rien n'est gaspillé — sauf par l'homme sans guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépense pour Allah reçoit au-delà de ce qu'il donne." }
  ],
  munajat: `Ya Rabb, fais que mes dépenses soient sincères. Ne permets pas qu'elles soient comme une récolte détruite. Donne-moi la pureté d'intention.`
};

MIROIR["3:118"] = {
  reference: "3:118",
  theme: ["confiance", "intimité", "protection"],
  emotion: "Vigilance nécessaire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Nasih"],
  mirrorVersion: `« Ô vous qui avez cru, ne prenez pas de confidents en dehors de vous. » Le miroir me montre la limite de la confiance extérieure. Ceux qui sont en dehors peuvent souhaiter le mal. Ils ne ménagent aucun effort pour vous corrompre. La haine sort de leurs bouches, et ce que cachent leurs poitrines est pire. L'intimité spirituelle demande discernement.`,
  reflection: `La confiance aveugle est dangereuse. Le discernement dans l'intimité est une protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tattakhidhu bitanatan min dunikum » — ne prenez pas de confidents hors de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je confie mes secrets ? Sont-ils dignes de confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méfiance n'est pas paranoïa — c'est sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature protège son intimité. L'homme doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le confident véritable est Allah Lui-même." }
  ],
  munajat: `Ya Wali, enseigne-moi le discernement dans mes confidences. Protège-moi de ceux qui veulent mon mal. Donne-moi des confidents dignes de confiance.`
};

MIROIR["3:119"] = {
  reference: "3:119",
  theme: ["hypocrisie", "haine", "révélation"],
  emotion: "Connaissance amère",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Batin"],
  mirrorVersion: `« Vous les aimez, mais ils ne vous aiment pas. » Le miroir me montre l'asymétrie des relations. Vous croyez en tous les Livres, mais eux ne croient pas en votre Livre. Quand ils vous rencontrent, ils disent « nous croyons », mais quand ils sont seuls, ils se mordent les doigts de rage. La sincérité est à sens unique. Allah connaît ce qu'ils cachent.`,
  reflection: `L'amour non réciproqué est une illusion. La véritable fraternité est dans la foi commune.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tuhibbunahum wa hum la yuhibbunakum » — vous les aimez mais ils ne vous aiment pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que j'investis mon amour sans retour ? Est-ce que je suis aveugle à la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour sincère mérite la réciprocité. Sans réciprocité, c'est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour dans l'univers est un échange. Un amour à sens unique déséquilibre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah connaît les cœurs. Rien ne Lui est caché." }
  ],
  munajat: `Ya Khabir, Tu connais ce qui est caché dans les cœurs. Protège-moi de ceux qui prétendent m'aimer mais me haïssent. Donne-moi des frères sincères.`
};

MIROIR["3:120"] = {
  reference: "3:120",
  theme: ["joie", "malheur", "patience"],
  emotion: "Réconfort face à l'hostilité",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Hafiz"],
  mirrorVersion: `« Si un bonheur vous atteint, cela les afflige. Et si un malheur vous frappe, ils s'en réjouissent. » Le miroir me montre l'hostilité cachée. Mais la réponse est claire : si vous êtes patients et pieux, leur ruse ne vous nuira en rien. Allah cerne ce qu'ils font. La patience et la taqwa sont le bouclier contre les complots.`,
  reflection: `L'hostilité des autres est impuissante devant la patience et la piété du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tasbiru wa tattaqu » — si vous êtes patients et pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réagis à l'hostilité avec patience ? Ou est-ce que je me laisse entraîner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience n'est pas passivité — c'est une force active." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, ce qui résiste persiste. La patience est la loi de la durée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est patient et pieux est protégé par Allah." }
  ],
  munajat: `Ya Sabur, enseigne-moi la patience face à l'hostilité. Donne-moi la taqwa comme bouclier. Fais que les ruses des autres ne me nuisent pas.`
};

MIROIR["3:121"] = {
  reference: "3:121",
  theme: ["bataille", "préparation", "confiance"],
  emotion: "Mobilisation spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nasir", "Al-Hakim"],
  mirrorVersion: `« Quand tu as quitté ta famille au petit matin pour assigner aux croyants leurs postes de combat. » Le miroir me montre la préparation minutieuse du Prophète avant Uhud. Chaque croyant avait son poste. La confiance en Allah ne dispense pas de la préparation. Les deux vont ensemble.`,
  reflection: `La confiance en Allah et la préparation sont complémentaires, non contradictoires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tubawwi'u al-mu'minina maq'ida » — assigner aux croyants leurs postes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare mes batailles spirituelles ? Ou est-ce que j'improvise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance totale en Allah inclut la confiance dans les moyens qu'Il a créés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ordonné. La préparation reflète cet ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare avec Allah ne peut échouer." }
  ],
  munajat: `Ya Nasir, aide-moi à préparer mes batailles. Donne-moi la confiance en Toi et l'effort dans les moyens. Fais que je sois toujours prêt.`
};

MIROIR["3:122"] = {
  reference: "3:122",
  theme: ["faiblesse", "confiance", "victoire"],
  emotion: "Rappel de la dépendance divine",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Qawiyy"],
  mirrorVersion: `« Quand deux de vos groupes faillirent perdre courage, alors qu'Allah était leur allié. » Le miroir me montre que la faiblesse humaine peut survenir même chez les croyants. Mais Allah reste l'allié. En Allah, que les croyants se confient. La confiance en Allah surpasse les craintes humaines.`,
  reflection: `Même les croyants peuvent faiblir. Mais Allah ne faillit jamais. Il est l'allié fidèle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu waliyyuhuma » — et Allah est leur allié à tous les deux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je faiblis, est-ce que je me souviens qu'Allah est mon allié ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse humaine est l'occasion de manifester la force divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a des moments de faiblesse. L'alliance divine est constante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah comme allié n'a besoin de personne d'autre." }
  ],
  munajat: `Ya Wali, Tu es mon allié même quand je faiblis. Donne-moi confiance en Ton alliance. Ne permets pas que la peur me fasse oublier que Tu es là.`
};

MIROIR["3:123"] = {
  reference: "3:123",
  theme: ["victoire", "foi", "reconnaissance"],
  emotion: "Gratitude pour le secours divin",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Manna'n"],
  mirrorVersion: `« Allah vous a donné la victoire à Badr, alors que vous étiez humiliés. » Le miroir me montre le paradoxe divin : la victoire vient dans la faiblesse. À Badr, les musulmans étaient peu nombreux et mal équipés. Mais Allah a envoyé Son secours. Craignez Allah, puissiez-vous être reconnaissants.`,
  reflection: `La victoire vient d'Allah, pas des moyens. La reconnaissance est la réponse juste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa antum adhillah » — alors que vous étiez humiliés, faibles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je déjà expérimenté la victoire d'Allah dans ma faiblesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse est le terrain où Allah manifeste Sa force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers montre que la vie vient de l'improbable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la victoire d'Allah dans la faiblesse comprend la vie." }
  ],
  munajat: `Ya Nasir, Tu m'as donné la victoire quand j'étais faible. Fais que je sois reconnaissant. Ne permets pas que j'oublie Ton secours.`
};

MIROIR["3:124"] = {
  reference: "3:124",
  theme: ["anges", "secours", "foi"],
  emotion: "Rappel du soutien invisible",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "An-Nasir"],
  mirrorVersion: `« Quand tu disais aux croyants : Ne vous suffit-il pas que votre Seigneur fasse descendre sur vous trois mille anges ? » Le miroir me montre le secours invisible. Les anges descendent par milliers pour soutenir les croyants. Le monde invisible est actif. La foi inclut la croyance en ce qui ne se voit pas.`,
  reflection: `Le secours d'Allah peut être invisible. Les anges participent à la bataille des croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thalathati alafin mina al-mala'ikah » — trois mille anges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au secours invisible ? Ou est-ce que je ne crois qu'au visible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invisible est plus réel que le visible — il le soutient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de réalités invisibles qui soutiennent le visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'invisible ne craint pas le visible." }
  ],
  munajat: `Ya Rabb, envoie Ton secours invisible sur moi. Fais que je croie aux anges qui me soutiennent. Ouvre mes yeux à l'invisible.`
};

MIROIR["3:125"] = {
  reference: "3:125",
  theme: ["patience", "piété", "anges"],
  emotion: "Encouragement à la persévérance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Muttaqi"],
  mirrorVersion: `« Mais si vous êtes patients et pieux, et qu'ils vous assaillent aussitôt, votre Seigneur vous enverra en renfort cinq mille anges. » Le miroir me montre l'augmentation du secours avec la persévérance. La patience et la taqpa activent le soutien divin. Plus l'épreuve est grande, plus le secours est vaste.`,
  reflection: `La patience et la piété ouvrent les portes du secours divin. Plus on persévère, plus l'aide augmente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khamsati alafin » — cinq mille anges. La multiplication du secours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persévère dans la patience ? Le secours augmente avec la persévérance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est proportionnelle au secours qui vient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi de l'univers : plus la résistance est grande, plus la force se développe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure reçoit au-delà de ce qu'il endure." }
  ],
  munajat: `Ya Sabur, donne-moi la patience et la piété. Envoie Ton secours quand l'épreuve s'intensifie. Fais que je persévère jusqu'à la victoire.`
};

MIROIR["3:126"] = {
  reference: "3:126",
  theme: ["victoire", "bonne nouvelle", "foi"],
  emotion: "Réconfort divin",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Wali"],
  mirrorVersion: `« Allah ne l'a fait que comme une bonne nouvelle pour vous. » Le miroir me montre que le secours des anges est une bonne nouvelle, pas une nécessité. La victoire vient d'Allah, pas des anges. Ceux qui sont fermes dans leur foi sont réconfortés.`,
  reflection: `Le secours est une bonne nouvelle, pas une condition. La foi ferme n'a pas besoin de preuves supplémentaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bushra » — bonne nouvelle. Le secours est un cadeau, pas un dû." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère le secours comme un dû ? Ou comme une bonne nouvelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire vient d'Allah seul, pas des moyens intermédiaires." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de bonnes nouvelles pour ceux qui savent voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que tout est bonne nouvelle vit dans la gratitude." }
  ],
  munajat: `Ya Bashir, merci pour les bonnes nouvelles. Fais que je ne demande pas de preuves. Donne-moi une foi ferme qui n'a pas besoin de confirmation.`
};

MIROIR["3:127"] = {
  reference: "3:127",
  theme: ["victoire", "mécréants", "colère"],
  emotion: "Justice divine manifestée",
  difficulty: "débutant",
  relatedNames: ["Al-Qawiyy", "Al-Muntaqim"],
  mirrorVersion: `« Pour couper une partie des mécréants ou les humilier, afin qu'ils retournent déçus. » Le miroir me montre la justice dans la victoire. Couper une partie — diminuer l'ennemi. Les humilier — montrer leur faiblesse. Qu'ils retournent déçus — leur projet échoue. La victoire des croyants est la défaite des injustes.`,
  reflection: `La victoire n'est pas seulement le succès des croyants — c'est aussi la défaite des injustes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fayaqta'a tarafan » — pour couper une partie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La victoire a-t-elle un sens pour moi ? Est-ce que je vois la justice qui s'y manifeste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défaite des injustes est aussi une miséricorde pour eux — elle peut les réveiller." },
    { label: "L'Universel", ar: "الكن", color: "#34d399", text: "Dans l'univers, le mal finit par être contenu. La justice triomphe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la justice comprend la victoire." }
  ],
  munajat: `Ya Qawiyy, Ta victoire est justice. Coupe les racines de l'injustice. Fais que les mécréants retournent déçus. Établis Ta vérité.`
};

MIROIR["3:128"] = {
  reference: "3:128",
  theme: ["pardon", "châtiment", "sagesse"],
  emotion: "Confiance dans le décret divin",
  difficulty: "avancé",
  relatedNames: ["Al-Hakim", "Al-Ghaffur"],
  mirrorVersion: `« Tu n'as aucune part dans la décision : soit qu'Il leur pardonne, soit qu'Il les châtie. » Le miroir me montre que le destin des autres n'est pas entre mes mains. Même le Prophète n'a pas de part dans cette décision. Pardon ou châtiment — cela appartient à Allah seul. Mon rôle est d'être patient et de transmettre.`,
  reflection: `Le destin des autres appartient à Allah. Mon rôle est de transmettre, pas de décider.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laysa laka mina al-amri shay' » — tu n'as aucune part dans la décision." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'approprie le destin des autres ? Ou est-ce que je le remets à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Lâcher le destin des autres est une libération." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a son propre destin. Nul ne porte le destin d'un autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que le destin n'est pas à lui trouve la paix." }
  ],
  munajat: `Ya Hakim, le destin n'est pas à moi. Je remets les autres entre Tes mains. Pardonne-leur ou châtie-les selon Ta sagesse. Donne-moi la paix du détachement.`
};

MIROIR["3:129"] = {
  reference: "3:129",
  theme: ["souveraineté", "cieux", "terre"],
  emotion: "Humilité devant la grandeur",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Ghani"],
  mirrorVersion: `« À Allah appartient tout ce qui est dans les cieux et sur la terre. » Le miroir revient à cette vérité fondamentale. Tout appartient à Allah. Il pardonne à qui Il veut et châtie qui Il veut. Sa décision est souveraine. Sa miséricorde et Sa justice sont parfaites.`,
  reflection: `La souveraineté d'Allah est absolue. Son pardon et Son châtiment sont selon Sa sagesse parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaghfiru liman yasha'u wa yu'adhdhibu man yasha'u » — Il pardonne à qui Il veut et châtie qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la souveraineté d'Allah ? Ou est-ce que je La conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La souveraineté d'Allah n'est pas arbitraire — elle est sagesse et justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à la souveraineté d'Allah sans question." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la souveraineté d'Allah accepte tout." }
  ],
  munajat: `Ya Malik, tout T'appartient. J'accepte Ta décision. Pardonne-moi et guide-moi. Je remets tout entre Tes mains.`
};

MIROIR["3:130"] = {
  reference: "3:130",
  theme: ["usure", "avertissement", "doublé"],
  emotion: "Mise en garde sévère",
  difficulty: "débutant",
  relatedNames: ["Al-Halim", "Al-'Adl"],
  mirrorVersion: `« Ô vous qui avez cru, ne pratiquez pas l'usure en multipliant doublée votre capital. » Le miroir me montre le danger de l'usure (riba). L'argent doublé, triplé, multiplié sans effort — c'est une illusion. L'usure corrompt les relations et les cœurs. Craignez Allah, puissiez-vous réussir.`,
  reflection: `L'usure est une croissance artificielle qui corrompt. La vraie réussite est dans la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ad'afan muda'afah » — doublée et redoublée. La multiplication illusoire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la croissance facile ? Ou est-ce que j'accepte l'effort juste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La croissance par l'usure est en fait une décroissance spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, la vraie croissance prend du temps. L'artificiel ne dure pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse l'usure refuse l'illusion." }
  ],
  munajat: `Ya 'Adl, garde-moi de l'usure. Donne-moi la réussite par l'effort juste. Ne permets pas que je sois séduit par la croissance facile.`
};

MIROIR["3:131"] = {
  reference: "3:131",
  theme: ["feu", "mécréants", "avertissement"],
  emotion: "Crainte salutaire",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Khafid"],
  mirrorVersion: `« Et craignez le Feu préparé pour les mécréants. » Le miroir me montre la réalité de l'enfer. Il est préparé pour les mécréants, mais la crainte est pour tous. La conscience de l'enfer n'est pas de la peur morbide — c'est un rappel de la réalité qui motive la justice.`,
  reflection: `L'enfer n'est pas une menace vide. C'est une réalité qui doit influencer nos choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-nar allati u'iddat li al-kafirin » — le Feu préparé pour les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de l'enfer ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte de l'enfer est une miséricorde — elle prévient le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque action a une conséquence. L'enfer est la conséquence ultime du mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'enfer évite ce qui y mène." }
  ],
  munajat: `Ya Rabb, fais que je craigne Ton feu. Préserve-moi de ce qui y mène. Donne-moi la conscience de l'au-delà.`
};

MIROIR["3:132"] = {
  reference: "3:132",
  theme: ["obéissance", "miséricorde", "prophète"],
  emotion: "Encouragement à la soumission",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Rasul"],
  mirrorVersion: `« Et obéissez à Allah et au Messager, afin qu'on vous fasse miséricorde. » Le miroir me montre le chemin de la miséricorde : l'obéissance. Obéir à Allah et à Son Messager n'est pas une contrainte — c'est le chemin vers la miséricorde. L'obéissance n'est pas servitude, c'est liberté.`,
  reflection: `L'obéissance à Allah et au Messager est la clé de la miséricorde. La soumission est le chemin de la libération.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ati'u Allah wa al-rasula la'allakum turhamun » — obéissez afin qu'on vous fasse miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis vraiment ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance n'est pas soumission à un tyran — c'est alignement avec le Bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah parfaitement. L'homme est invité à en faire autant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit librement a choisi la plus haute liberté." }
  ],
  munajat: `Ya Rahman, fais que j'obéisse à Toi et à Ton Messager. Accorde-moi Ta miséricorde. Libère-moi par la soumission.`
};

MIROIR["3:133"] = {
  reference: "3:133",
  theme: ["paradis", "course", "pardon"],
  emotion: "Emulation spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Karim"],
  mirrorVersion: `« Et concourez au pardon de votre Seigneur, et à un Paradis aussi vaste que les cieux et la terre. » Le miroir me montre l'invitation à la course spirituelle. Le pardon et le Paradis sont les prix. Le Paradis est vaste comme les cieux et la terre — préparé pour ceux qui craignent Allah. La concurrence dans le bien n'est pas de l'orgueil.`,
  reflection: `Le Paradis est un prix qui vaut la course. La concurrence spirituelle est une émulation positive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sabiqa ila maghfiratin min rabbikum » — courez vers le pardon de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cours vers le pardon ? Ou est-ce que je marche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La course spirituelle n'est pas une compétition avec les autres — avec soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en mouvement constant. La créature est appelée à bouger vers le bien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui court vers Allah Le trouve au début de la course, pas à la fin." }
  ],
  munajat: `Ya Ghaffur, je cours vers Ton pardon. Prépare-moi une place dans Ton Paradis. Fais que je ne me lasse pas de la course.`
};

MIROIR["3:134"] = {
  reference: "3:134",
  theme: ["dépense", "colère", "pardon"],
  emotion: "Modèle du croyant parfait",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhsin", "Al-Halim"],
  mirrorVersion: `« Ceux qui dépensent dans l'aisance et dans la gêne, qui dominent leur colère et pardonnent à autrui. » Le miroir me montre les qualités des bien-aimés d'Allah. Dépenser dans toutes les circonstances. Maîtriser la colère. Pardonner aux autres. Allah aime les bienfaiteurs. Ces qualités sont interconnectées.`,
  reflection: `La générosité, la maîtrise de soi, et le pardon sont les marques des bien-aimés d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-kazimina al-ghayz » — ceux qui retiennent leur colère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je maîtrise ma colère ? Est-ce que je pardonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La maîtrise de la colère n'est pas sa suppression — c'est sa transformation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est patient. L'homme est invité à la même patience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah aime les bienfaiteurs. Le pardon est la plus haute forme de bienfaisance." }
  ],
  munajat: `Ya Halim, enseigne-moi à maîtriser ma colère. Donne-moi la générosité dans toutes les circonstances. Aide-moi à pardonner comme Tu pardonnes.`
};

MIROIR["3:135"] = {
  reference: "3:135",
  theme: ["péché", "repentir", "espérance"],
  emotion: "Espoir après la chute",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Et ceux qui, s'ils ont commis une turpitude ou se sont fait du tort à eux-mêmes, se souviennent d'Allah et demandent pardon. » Le miroir me montre le chemin du retour après le péché. Se souvenir d'Allah. Demander pardon pour ses fautes. Qui pardonne les péchés hormis Allah ? Le repentir est toujours possible.`,
  reflection: `Le péché n'est pas la fin. Le souvenir d'Allah et le repentir ouvrent la porte du pardon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yaghfiru al-dhunuba illa Allah » — qui pardonne les péchés hormis Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je pèche, est-ce que je me souviens d'Allah ? Ou est-ce que je m'éloigne davantage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le péché est une occasion de se rapprocher d'Allah par le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un cycle de retours. Le repentir est le retour de l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah attend le repentir plus que le pécheur ne Le cherche." }
  ],
  munajat: `Ya Tawwab, quand je pèche, fais que je me souvienne de Toi. Accorde-moi Ton pardon. Je me repens sincèrement. Ne permets pas que je désespère.`
};

MIROIR["3:136"] = {
  reference: "3:136",
  theme: ["récompense", "paradis", "réussite"],
  emotion: "Promesse de félicité",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Fawz"],
  mirrorVersion: `« Ceux-là ont pour récompense le pardon de leur Seigneur, ainsi que des Jardins sous lesquels coulent les ruisseaux. » Le miroir me montre la récompense de ceux qui se repentent. Le pardon et le Paradis. Ils y demeureront éternellement. Quelle belle récompense pour ceux qui font le bien !`,
  reflection: `Le pardon et le Paradis sont la récompense du repentir sincère. L'éternité dans le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatun tajri min tahtiha al-anhar » — des Jardins sous lesquels coulent les ruisseaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cours vers cette récompense ? Ou est-ce que je suis distrait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense n'est pas méritée — elle est donnée par grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est le retour à l'état originel. L'âme y retrouve sa maison." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ceux qui obtiennent le Paradis y sont chez eux, pas en visiteurs." }
  ],
  munajat: `Ya Rabb, accorde-moi le pardon et le Paradis. Fais que je sois parmi ceux qui y demeurent éternellement. Quelle belle récompense !`
};

MIROIR["3:137"] = {
  reference: "3:137",
  theme: ["histoire", "précédents", "voyage"],
  emotion: "Perspective historique",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Avant vous, certes, beaucoup de pratiques ont eu cours. » Le miroir me montre l'importance de l'histoire. Les civilisations ont précédé. Les cycles se répètent. Parcourez la terre et voyez ce qu'il est advenu des négateurs. L'histoire est un enseignant.`,
  reflection: `L'histoire est un maître. Ce qui est arrivé aux anciens est un avertissement pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa siru fi al-ard » — parcourez la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les mêmes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire n'est pas le passé — elle est un miroir du présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la trace de tout ce qui a été. L'histoire est inscrite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne connaît pas l'histoire est condamné à la répéter." }
  ],
  munajat: `Ya Khabir, enseigne-moi par l'histoire. Ne permets pas que je répète les erreurs des anciens. Donne-moi la sagesse du passé.`
};

MIROIR["3:138"] = {
  reference: "3:138",
  theme: ["clarification", "guidance", "exhortation"],
  emotion: "Clarté de la révélation",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Bayan"],
  mirrorVersion: `« Voici une explication pour les gens, une guide et une exhortation pour ceux qui craignent. » Le miroir me montre les trois fonctions du Coran. Explication (bayan) pour tous. Guide (huda) pour le chemin. Exhortation (maw'iza) pour ceux qui craignent. La révélation est complète.`,
  reflection: `Le Coran explique, guide, et exhorte. Il est complet pour tous les besoins spirituels.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bayanun li al-nas » — une explication pour les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère le Coran comme explication, guide et exhortation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran n'est pas un livre ancien — il est actuel pour chaque époque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la lumière qui traverse le temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran avec cœur trouve chaque fois une nouvelle guidance." }
  ],
  munajat: `Ya Hadi, fais que le Coran soit mon explication, mon guide et mon exhortation. Ne permets pas que je le laisse sur l'étagère.`
};

MIROIR["3:139"] = {
  reference: "3:139",
  theme: ["force", "espoir", "foi"],
  emotion: "Courage renouvelé",
  difficulty: "débutant",
  relatedNames: ["Al-Aziz", "Al-Mu'izz"],
  mirrorVersion: `« Ne faiblissez pas et ne vous affligez pas, alors que vous êtes les supérieurs, si vous êtes croyants. » Le miroir me montre le paradoxe de la foi : la supériorité spirituelle même dans la faiblesse apparente. Si vous êtes croyants — la condition est claire. La vraie force vient de la foi.`,
  reflection: `La supériorité n'est pas matérielle — elle est spirituelle. La foi donne la vraie force.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa antum al-a'lawna » — vous êtes les supérieurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens supérieur par la foi ? Ou est-ce que je me sens faible par les apparences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La supériorité par la foi n'est pas de l'arrogance — c'est de la conscience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte la force de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment est supérieur à toute force apparente." }
  ],
  munajat: `Ya 'Aziz, donne-moi la force de la foi. Ne permets pas que je me sente faible face aux apparences. Fais que je sois vraiment croyant.`
};

MIROIR["3:140"] = {
  reference: "3:140",
  theme: ["épreuve", "cycle", "sagesse"],
  emotion: "Compréhension des cycles",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mudabbir"],
  mirrorVersion: `« Si une blessure vous atteint, une blessure semblable a atteint les autres. » Le miroir me montre les cycles de l'histoire. Les jours alternent entre les gens. C'est ainsi qu'Allah distingue les croyants. L'épreuve n'est pas un accident — elle est une sélection.`,
  reflection: `Les jours alternent. L'épreuve est universelle et sélective à la fois.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tilka al-ayyamu nudawiluha bayna al-nas » — ces jours, Nous les faisons alterner entre les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les cycles ? Ou est-ce que je m'y oppose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alternance n'est pas une instabilité — c'est une loi de l'existence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en mouvement perpétuel. La stabilité est dans l'acceptation du mouvement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les cycles ne s'inquiète ni du haut ni du bas." }
  ],
  munajat: `Ya Hakim, j'accepte les cycles de la vie. Fais que je comprenne Ta sagesse dans l'alternance. Donne-moi la constance dans le changement.`
};

MIROIR["3:141"] = {
  reference: "3:141",
  theme: ["épreuve", "séparation", "vérité"],
  emotion: "Révélation par l'épreuve",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Fattah"],
  mirrorVersion: `« Et qu'Allah distingue ceux qui croient et qu'Il rapproche des martyrs. » Le miroir me montre la fonction de l'épreuve : la distinction. L'épreuve révèle qui est vraiment croyant. Les martyrs sont rapprochés d'Allah par leur sacrifice. L'épreuve n'est pas une punition — c'est une purification.`,
  reflection: `L'épreuve distingue le vrai du faux. Elle purifie et rapproche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yumahhisa Allahu alladhina amanu » — pour qu'Allah purifie ceux qui croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'épreuve révèle-t-elle ma foi ? Ou mon hypocrisie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve n'est pas une punition — c'est une opportunité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'or est purifié par le feu. L'âme est purifiée par l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est purifié par l'épreuve devient transparent à la lumière divine." }
  ],
  munajat: `Ya Haqq, purifie-moi par l'épreuve. Fais que je sois parmi les croyants sincères. Rapproche-moi de Toi par chaque difficulté.`
};

MIROIR["3:142"] = {
  reference: "3:142",
  theme: ["question", "paradis", "vérité"],
  emotion: "Interrogation salutaire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jannah", "Al-'Alim"],
  mirrorVersion: `« Comptez-vous entrer au Paradis sans qu'Allah ne distingue ceux d'entre vous qui ont lutté ? » Le miroir me pose cette question directe. Le Paradis n'est pas un don automatique. Il demande la lutte, l'effort, la distinction. La facilité n'est pas le chemin du Paradis.`,
  reflection: `Le Paradis se mérite par la lutte. L'automatisme n'existe pas dans la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am hasibtum » — comptez-vous ? Une question qui interroge les attentes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte entrer au Paradis sans effort ? Ou est-ce que je lutte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lutte n'est pas une condition — elle est le chemin lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers n'est obtenu sans effort. Le Paradis suit la même loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lutte déjà habite le Paradis de l'effort." }
  ],
  munajat: `Ya Rabb, je ne compte pas entrer au Paradis sans effort. Donne-moi la force de lutter. Fais que chaque effort me rapproche de Toi.`
};

MIROIR["3:143"] = {
  reference: "3:143",
  theme: ["mort", "désir", "réalité"],
  emotion: "Confrontation avec la mort",
  difficulty: "avancé",
  relatedNames: ["Al-Mumit", "Al-Hayy"],
  mirrorVersion: `« Vous souhaitiez la mort sans l'avoir rencontrée. Eh bien, vous l'avez vue maintenant, en regardant. » Le miroir me montre le décalage entre le désir et la réalité. Souhaiter le martyre est facile quand on ne l'a pas vu. Quand on le voit, c'est différent. La mort n'est pas une abstraction — elle est une réalité concrète.`,
  reflection: `Le désir de la mort est facile. La confrontation avec la mort réveille.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kun tumannauna al-mawt » — vous souhaitiez la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je souhaite sans en avoir fait l'expérience ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désir non éprouvé est une illusion. La réalité transforme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est partout dans l'univers. L'homme est le seul à la fuir tout en la cherchant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a rencontré la mort en parle autrement que celui qui la souhaite." }
  ],
  munajat: `Ya Mumit, la mort est une réalité. Fais que je ne la souhaite pas légèrement. Donne-moi de la rencontrer avec foi et courage.`
};

MIROIR["3:144"] = {
  reference: "3:144",
  theme: ["prophète", "mort", "permanence"],
  emotion: "Rappel de la mortalité du Prophète",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Hayy"],
  mirrorVersion: `« Muhammad n'est qu'un messager. Des messagers sont passés avant lui. S'il mourait ou était tué, reviendriez-vous sur vos talons ? » Le miroir me montre que le Prophète est mortel. Les messagers avant lui sont morts. La foi n'est pas attachée à la personne physique du Prophète, mais au message qu'il porte. Revient en arrière celui qui nuit à lui-même.`,
  reflection: `Le Prophète est mortel, le message est éternel. La foi transcende la personne physique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma Muhammadun illa rasul » — Muhammad n'est qu'un messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle attachée au Prophète ou au message ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort du Prophète ne tue pas le message — elle le confirme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes sont mortels. La révélation est éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend cela comprend la différence entre le messager et le message." }
  ],
  munajat: `Ya Rabb, je crois en Ton message éternel. Le Prophète T'a quitté, mais sa guidance reste. Ne permets pas que je retourne en arrière.`
};

MIROIR["3:145"] = {
  reference: "3:145",
  theme: ["mort", "destin", "terme"],
  emotion: "Acceptation du décret",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Qadar"],
  mirrorVersion: `« Nulle âme ne peut mourir que par la permission d'Allah, et selon un terme prescrit. » Le miroir me montre que la mort n'est pas un accident — c'est un décret. Chaque âme a son terme prescrit. Rien ne peut avancer ni retarder ce terme. La mort vient au moment fixé par Allah.`,
  reflection: `La mort est un rendez-vous fixé. Nul ne peut le manquer ni le devancer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ajalin musamman » — un terme prescrit." },
    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de mon terme prescrit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas une punition — c'est un rendez-vous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers a son terme. L'homme n'échappe pas à cette loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte son terme vit en paix." }
  ],
  munajat: `Ya Qadir, mon terme est fixé par Toi. Fais que je le rencontre en état de soumission. Ne permets pas que je craigne ce qui est inévitable.`
};

MIROIR["3:146"] = {
  reference: "3:146",
  theme: ["prophètes", "combat", "patience"],
  emotion: "Exemple des anciens",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Nasir"],
  mirrorVersion: `« Combien de prophètes ont combattu, en compagnie de nombreux disciples, sans se décourager. » Le miroir me montre l'exemple des prophètes et leurs compagnons. Ils ont combattu sans fléchir. Ils n'ont pas abandonné. Allah aime les endurants. La patience dans le combat est une marque de foi.`,
  reflection: `Les prophètes ont combattu avec patience. Leur exemple nous guide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma wahana » — ils ne se sont pas affaiblis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me décourage dans mes combats spirituels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse apparente cache souvent la force réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'endurance est la loi de la vie. Tout ce qui dure a enduré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah aime les endurants. L'endurance est un chemin vers Son amour." }
  ],
  munajat: `Ya Sabur, donne-moi l'endurance des prophètes. Ne permets pas que je me décourage. Fais que je sois parmi ceux que Tu aimes.`
};

MIROIR["3:147"] = {
  reference: "3:147",
  theme: ["invocation", "pardon", "humilité"],
  emotion: "Prière des combattants",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Rahim"],
  mirrorVersion: `« Leur seule parole était : Seigneur, pardonne-nous nos péchés et nos excès, affermis nos pas et donne-nous la victoire sur le peuple mécréant. » Le miroir me montre la prière parfaite des croyants dans l'épreuve. Demander le pardon pour ses péchés et excès. Demander la fermeté dans les pas. Demander la victoire. Trois demandes essentielles.`,
  reflection: `La prière dans l'épreuve : pardon, fermeté, victoire. Simple et complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana ighfir lana dhunubana » — Seigneur, pardonne-nous nos péchés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma prière dans l'épreuve ? Est-elle aussi simple et complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire vient après le pardon demandé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être dans l'épreuve a besoin de ces trois demandes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière sincère dans l'épreuve est exaucée." }
  ],
  munajat: `Ya Ghaffur, pardonne mes péchés et mes excès. Affermis mes pas. Donne-moi la victoire sur mes ennemis intérieurs et extérieurs.`
};

MIROIR["3:148"] = {
  reference: "3:148",
  theme: ["réponse", "victoire", "récompense"],
  emotion: "Gratitude pour l'exaucement",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Fattah"],
  mirrorVersion: `« Allah leur a donc donné la récompense d'ici-bas et la belle récompense de l'au-delà. » Le miroir me montre que la prière est exaucée. La récompense d'ici-bas : la victoire. La belle récompense de l'au-delà : le Paradis. Allah aime les bienfaiteurs. La prière sincère obtient double récompense.`,
  reflection: `La prière sincère est doublement récompensée : ici-bas et dans l'au-delà.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'atahum Allah thawaba al-dunya » — Allah leur a donné la récompense d'ici-bas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère les deux récompenses ? Ou est-ce que je me contente d'une seule ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense d'ici-bas n'est pas le but — elle est un signe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute action sincère a un effet dans le présent et dans l'éternité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien pour Allah reçoit au-delà de son attente." }
  ],
  munajat: `Ya Mujib, exauce mes prières. Donne-moi la récompense d'ici-bas et la belle récompense de l'au-delà. Fais que je sois parmi les bienfaiteurs.`
};

MIROIR["3:149"] = {
  reference: "3:149",
  theme: ["obéissance", "égarement", "mécréants"],
  emotion: "Mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Wali"],
  mirrorVersion: `« Ô vous qui avez cru, si vous obéissez à ceux qui ne croient pas, ils vous feront retourner sur vos talons, et vous redeviendrez perdants. » Le miroir me montre le danger de l'obéissance aux mécréants. Ils veulent nous faire retourner en arrière. L'obéissance aux ennemis de la foi mène à la perte.`,
  reflection: `L'obéissance aux ennemis de la foi mène à la régression spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuruddukum 'ala a'qabikum » — ils vous feront retourner sur vos talons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui j'obéis ? Est-ce que cela me rapproche d'Allah ou m'en éloigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance à Allah est la seule qui ne déçoit pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'obéissance est une loi de l'univers. La question est : à qui obéit-on ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit à Allah ne peut être retourné." }
  ],
  munajat: `Ya Hadi, garde-moi de l'obéissance à ceux qui ne croient pas. Ne permets pas que je retourne en arrière. Affermis mes pas dans la foi.`
};

MIROIR["3:150"] = {
  reference: "3:150",
  theme: ["alliance", "protection", "confiance"],
  emotion: "Réassurance divine",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Nasir"],
  mirrorVersion: `« Mais Allah est votre Maître, et Il est le meilleur des secoureurs. » Le miroir me montre la véritable source de protection. Allah est le Maître. Il est le meilleur des secoureurs. Pourquoi chercher d'autres protecteurs quand le meilleur est disponible ? L'alliance avec Allah surpasse toute autre alliance.`,
  reflection: `Allah est le meilleur protecteur. Pourquoi chercher ailleurs ce qu'Il offre au mieux ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa khayru al-nasirin » — et Il est le meilleur des secoureurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je demande de l'aide ? À Allah en premier ou en dernier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le meilleur secoureur n'est pas celui qui aide le plus, mais celui qui aide le mieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est secouru par Allah. L'homme est invité à reconnaître ce secours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah comme secoureur n'a pas besoin de comparer." }
  ],
  munajat: `Ya Wali, Tu es mon Maître et le meilleur des secoureurs. Je me tourne vers Toi en premier. Ne permets pas que je cherche ailleurs ce que Tu offres au mieux.`
};

MIROIR["3:151"] = {
  reference: "3:151",
  theme: ["terreur", "mécréance", "châtiment"],
  emotion: "Réalité du châtiment",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Khafid"],
  mirrorVersion: `« Nous allons jeter la terreur dans les cœurs des mécréants. » Le miroir me montre la conséquence de l'association. Ils associent à Allah ce dont Il n'a fait descendre aucune preuve. Le Feu sera leur refuge. La terreur dans les cœurs est un châtiment anticipé.`,
  reflection: `L'association attire la terreur. Le Feu est la destination finale des associateurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sanulqi fi qulubi alladhina kafaru al-ru'b » — Nous jetterons la terreur dans leurs cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il de l'association dans mon cœur ? La terreur en est la conséquence." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix du cœur vient de l'unicité. La terreur vient de l'association." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'association désunit l'être. La désunion intérieure crée la terreur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unifie son cœur avec Allah ne connaît pas la terreur." }
  ],
  munajat: `Ya Wahid, préserve-moi de l'association. Unifie mon cœur avec Toi. Ne permets pas que la terreur entre dans mon cœur.`
};

MIROIR["3:152"] = {
  reference: "3:152",
  theme: ["promesse", "victoire", "désobéissance"],
  emotion: "Rappel de la promesse divine",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wadi", "Al-Haqq"],
  mirrorVersion: `« Allah a certainement tenu Sa promesse quand vous les tailliez en pièces avec Sa permission. » Le miroir me montre la fidélité d'Allah à Sa promesse. La victoire était là. Puis vous avez fléchi et vous avez disputé. Vous avez désobéi après qu'Il vous a fait voir ce que vous aimez. La victoire était accordée, mais le comportement humain l'a compromise.`,
  reflection: `La promesse d'Allah est tenue. C'est le comportement humain qui peut la compromettre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qad sadaqa Allahu wa'dahu » — Allah a certainement tenu Sa promesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je déjà compromis une promesse divine par mon comportement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire accordée peut être perdue par la désobéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tient ses promesses. L'homme peut romper les siennes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit maintient la promesse. Celui qui désobéit la compromet." }
  ],
  munajat: `Ya Haqq, Tu tiens Tes promesses. Fais que je ne les compromette pas par ma désobéissance. Donne-moi la constance dans l'obéissance.`
};

MIROIR["3:153"] = {
  reference: "3:153",
  theme: ["fuite", "détresse", "prophète"],
  emotion: "Rappel douloureux",
  difficulty: "avancé",
  relatedNames: ["Ar-Ra'uf", "Al-Rahim"],
  mirrorVersion: `« Quand vous fuyiez, sans vous retourner vers personne, tandis que le Messager vous appelait. » Le miroir me montre la scène de Uhud. Les croyants fuyaient. Le Prophète appelait derrière eux. Allah leur a donné la tristesse après la tristesse. Pour qu'ils ne s'affligent pas de ce qui leur a échappé ni de ce qui les a atteints.`,
  reflection: `La fuite devant l'épreuve laisse des traces. Mais Allah peut transformer la tristesse en leçon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tuhshurunala taduru » — vous fuyiez sans vous retourner." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je déjà fui en laissant l'appel du Prophète derrière moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite ne résout rien — elle ajoute la tristesse à la tristesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque fuite laisse une trace. Le retour efface la trace." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend l'appel du Prophète et retourne retrouve ce qu'il avait perdu." }
  ],
  munajat: `Ya Ra'uf, quand je fuis, fais que j'entende l'appel du Prophète. Ne permets pas que la tristesse s'ajoute à la tristesse. Donne-moi la force de retourner.`
};

MIROIR["3:154"] = {
  reference: "3:154",
  theme: ["sommeil", "paix", "épreuve"],
  emotion: "Miséricorde dans l'épreuve",
  difficulty: "intermédiaire",
  relatedNames: ["As-Salam", "Al-Mannan"],
  mirrorVersion: `« Puis Il fit descendre sur vous, après l'angoisse, un sommeil qui vous enveloppa. » Le miroir me montre la miséricorde d'Allah dans l'épreuve. Le sommeil comme répit. Une partie était en proie à ses propres pensées. Ils pensaient d'Allah autre que la vérité. Le sommeil apaise, mais les pensées peuvent corrompre.`,
  reflection: `Le sommeil est une miséricorde. Mais les pensées humaines peuvent troubler même ce répit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nu'assan » — un sommeil. La miséricorde dans l'épreuve." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux moments de répit ? Est-ce que j'en profite ou est-ce que je m'inquiète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le répit n'est pas l'oubli — c'est la préparation à la suite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sommeil est universel. Dans l'épreuve, il devient don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le sommeil d'Allah accepte Sa miséricorde." }
  ],
  munajat: `Ya Salam, merci pour le sommeil qui apaise. Ne permets pas que mes pensées corrompent Ton répit. Donne-moi la paix dans les moments de repos.`
};

MIROIR["3:155"] = {
  reference: "3:155",
  theme: ["fuite", "péché", "pardon"],
  emotion: "Espoir après la faute",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Tawwab"],
  mirrorVersion: `« Ceux d'entre vous qui ont fui le jour où les deux armées se rencontrèrent, c'est que le diable les a fait trébucher. » Le miroir me montre que la fuite est une chute. Le diable a fait trébucher. Mais Allah leur a pardonné. Même la faute grave peut être pardonnée. Allah est Pardonneur et Miséricordieux.`,
  reflection: `La chute n'est pas définitive. Le pardon est possible même après la fuite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa qad ghafara Allahu lahum » — Allah leur a pardonné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je fui devant l'épreuve ? Est-ce que j'espère le pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La chute du diable peut être relevée par le pardon d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de chutes et de relèvements." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le pardon d'Allah est plus grand que toute chute." }
  ],
  munajat: `Ya Ghaffur, j'ai fui devant l'épreuve. Pardonne-moi ma faiblesse. Relève-moi par Ton pardon. Ne permets pas que le diable me garde à terre.`
};

MIROIR["3:156"] = {
  reference: "3:156",
  theme: ["mort", "foi", "exemple"],
  emotion: "Éviter le mauvais exemple",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Ba'ith"],
  mirrorVersion: `« Ô vous qui avez cru, ne soyez pas comme ceux qui ont mécru et qui disent de leurs frères quand ils voyagent ou partent en expédition : S'ils étaient restés avec nous, ils ne seraient pas morts. » Le miroir me montre l'erreur de ceux qui nient le destin. La mort vient à son heure, pas par coïncidence. Ne soyez pas comme eux.`,
  reflection: `La mort ne peut être évitée par la présence ou l'absence. Elle vient au terme fixé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kanu 'indana ma matu » — s'ils étaient avec nous, ils ne seraient pas morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense comme les mécréants sur la mort ? Ou est-ce que j'accepte le destin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La présence ne protège pas de la mort. L'absence ne l'attire pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort est partout. Nul n'y échappe par la géographie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le destin comprend que la mort n'est pas un accident." }
  ],
  munajat: `Ya Qadir, j'accepte le destin. Ne permets pas que je parle comme ceux qui ne croient pas. Donne-moi la foi en Ton décret.`
};

MIROIR["3:157"] = {
  reference: "3:157",
  theme: ["martyre", "récompense", "miséricorde"],
  emotion: "Espoir dans le sacrifice",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Shahid"],
  mirrorVersion: `« Si vous êtes tués ou mourrez dans le chemin d'Allah, c'est la miséricorde d'Allah qui est meilleure. » Le miroir me montre que la mort dans le chemin d'Allah n'est pas une perte. C'est une miséricorde. La récompense du martyre surpasse tout ce que ce monde peut offrir.`,
  reflection: `La mort pour Allah n'est pas une perte — c'est un gain éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rahmatun min Allah » — une miséricorde d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je considère la mort dans le chemin d'Allah ? Comme une perte ou comme un gain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble perte est le plus grand gain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne perd rien. Le martyre transforme la mort en vie éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le martyre n'est pas la fin — c'est le commencement de la vraie vie." }
  ],
  munajat: `Ya Rahman, si je meurs dans Ton chemin, accepte-moi. Donne-moi la miséricorde du martyre. Ne permets pas que je craigne la mort pour Toi.`
};

MIROIR["3:158"] = {
  reference: "3:158",
  theme: ["mort", "rassemblement", "retour"],
  emotion: "Certitude du retour",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Hashir"],
  mirrorVersion: `« Que vous soyez tués ou mouriez, c'est vers Allah que vous serez rassemblés. » Le miroir me montre l'inévitable rendez-vous. La mort nous prend tous, d'une manière ou d'une autre. Le rassemblement vers Allah est certain. Peu importe le comment — le où est fixé.`,
  reflection: `Le rassemblement vers Allah est certain. La manière importe moins que la destination.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila Allah tuhsharun » — vers Allah vous serez rassemblés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience d'être rassemblé vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas une dispersion — c'est un rassemblement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne vers sa source. L'homme retourne vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il sera rassemblé prépare sa rencontre." }
  ],
  munajat: `Ya Hashir, je serai rassemblé vers Toi. Prépare ma rencontre. Fais que je sois prêt, quelle que soit la manière de mon départ.`
};

MIROIR["3:159"] = {
  reference: "3:159",
  theme: ["douceur", "pardon", "consultation"],
  emotion: "Modèle de leadership",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Ra'uf", "Al-Halim"],
  mirrorVersion: `« C'est par une miséricorde d'Allah que tu as été si doux avec eux. » Le miroir me montre le modèle du Prophète. La douceur est une miséricorde d'Allah. Si tu avais été rude, ils se seraient dispersés. Pardonne-leur, demande pardon pour eux, consulte-les. La consultation (shura) est un principe de gouvernance.`,
  reflection: `La douceur rassemble. La rudesse disperse. La consultation implique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa bi ma rahmatin min Allah linta lahum » — c'est par une miséricorde d'Allah que tu as été doux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je doux avec les autres ? Ou est-ce que ma rudesse les fait fuir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douceur n'est pas la faiblesse — c'est la force sous sa forme la plus élevée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par la douceur de ses lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est doux a reçu la miséricorde d'Allah." }
  ],
  munajat: `Ya Ra'uf, enseigne-moi la douceur du Prophète. Ne permets pas que ma rudesse fasse fuir les autres. Donne-moi la sagesse de la consultation.`
};

MIROIR["3:160"] = {
  reference: "3:160",
  theme: ["victoire", "aide", "confiance"],
  emotion: "Certitude du secours divin",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Wali"],
  mirrorVersion: `« Si Allah vous donne Son secours, nul ne peut vous vaincre. S'Il vous abandonne, qui donc après Lui vous donnera secours ? » Le miroir me montre l'absolue nécessité du secours divin. Avec Lui, invincibilité. Sans Lui, impuissance totale. C'est en Allah que les croyants doivent mettre leur confiance.`,
  reflection: `La victoire vient d'Allah seul. Sans Lui, aucune force ne peut sauver.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yansurkum Allahu fala ghaliba lakum » — si Allah vous aide, nul ne peut vous vaincre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur d'autres secours qu'Allah ? Ou est-ce que je Lui fais vraiment confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon par Allah n'est pas Sa faiblesse — c'est la conséquence de l'abandon de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne tient que par le soutien d'Allah. Sans Lui, tout s'effondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a le secours d'Allah a tout." }
  ],
  munajat: `Ya Nasir, donne-moi Ton secours. Sans Toi, je suis impuissant. En Toi, je mets toute ma confiance. Ne m'abandonne pas à moi-même.`
};

MIROIR["3:161"] = {
  reference: "3:161",
  theme: ["confiance", "fraude", "intention"],
  emotion: "Honnêteté dans la responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Hasib"],
  mirrorVersion: `« Un prophète ne saurait frauder. » Le miroir me montre l'intégrité absolue requise des prophètes. Quiconque fraude portera sa fraude au Jour de la résurrection. Chaque âme sera rétribuée pour ce qu'elle a acquis. La confiance (amana) ne doit jamais être trahie.`,
  reflection: `La fraude n'est jamais cachée à Allah. Chaque âme porte ses actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kana li nabiyyin an yaghulla » — un prophète ne saurait frauder." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je intègre dans mes responsabilités ? Ou est-ce que je fraude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fraude ne trompe pas Allah — elle trompe celui qui la commet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur la confiance. La fraude rompt l'ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est intègre avec Allah est intègre avec tous." }
  ],
  munajat: `Ya Amin, préserve-moi de la fraude. Donne-moi l'intégrité des prophètes. Ne permets pas que je trahisse la confiance.`
};

MIROIR["3:162"] = {
  reference: "3:162",
  theme: ["agrément", "colère", "comparaison"],
  emotion: "Clarté des deux chemins",
  difficulty: "débutant",
  relatedNames: ["Al-Radi", "Al-Ghadib"],
  mirrorVersion: `« Celui qui suit l'agrément d'Allah est-il comparable à celui qui a encouru Sa colère ? » Le miroir me montre l'immense différence entre les deux chemins. L'agrément d'Allah mène au Paradis. La colère d'Allah mène à l'enfer. Il n'y a pas de comparaison possible.`,
  reflection: `Les deux chemins ne sont pas égaux. L'agrément d'Allah surpasse tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afaman ittab'a ridwana Allah » — celui qui suit l'agrément d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel chemin je suis ? L'agrément ou la colère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La différence n'est pas visible maintenant — elle sera manifeste au Jour dernier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers distingue les chemins. L'homme est libre de choisir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'agrément le trouve. Celui qui encourt la colère l'a choisie." }
  ],
  munajat: `Ya Radi, fais que je suis Ton agrément. Ne permets pas que j'encoure Ta colère. Montre-moi la différence entre les deux chemins.`
};

MIROIR["3:163"] = {
  reference: "3:163",
  theme: ["rangs", "jugement", "différence"],
  emotion: "Réalité des degrés",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Ils auront des rangs différents auprès d'Allah. » Le miroir me montre que les actions ne sont pas égales. Chacun aura son rang selon ses œuvres. Allah voit ce qu'ils font. La différence des actions crée la différence des rangs.`,
  reflection: `Les rangs sont différents selon les œuvres. Rien n'est perdu ni confondu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Darajatun 'inda Allah » — des rangs auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel sera mon rang ? Est-ce que je travaille à l'élever ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les rangs ne sont pas fixes — ils se méritent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ordonné en degrés. L'homme aussi aura ses degrés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les rangs œuvre pour le plus haut." }
  ],
  munajat: `Ya 'Adl, accorde-moi un rang élevé. Fais que mes œuvres me rapprochent de Toi. Ne permets pas que je sois parmi les derniers.`
};

MIROIR["3:164"] = {
  reference: "3:164",
  theme: ["grâce", "prophète", "enseignement"],
  emotion: "Gratitude pour la guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Hadi"],
  mirrorVersion: `« Allah a conféré une faveur aux croyants en suscitant parmi eux un messager. » Le miroir me montre l'immense grâce du Prophète. Il récite les versets, purifie les cœurs, enseigne le Livre et la sagesse. Avant lui, ils étaient dans un égarement évident. La guidance est un don immense.`,
  reflection: `Le Prophète est une grâce immense. Son enseignement transforme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad manna Allah 'ala al-mu'minin » — Allah a conféré une faveur aux croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grâce du Prophète ? Est-ce que je suis son enseignement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sans le Prophète, l'égarement était évident. Avec lui, la guidance est claire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté reçoit son guide. La communauté de Muhammad a reçu le meilleur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce du Prophète suit son exemple." }
  ],
  munajat: `Ya Mannan, merci pour le Prophète. Fais que je suive son enseignement. Ne permets pas que je retourne à l'égarement d'avant lui.`
};

MIROIR["3:165"] = {
  reference: "3:165",
  theme: ["épreuve", "question", "réflexion"],
  emotion: "Interrogation après l'épreuve",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mudabbir"],
  mirrorVersion: `« Quand un malheur vous atteint, vous dites : D'où cela vient-il ? » Le miroir me montre la réaction humaine face à l'épreuve. Au lieu d'accepter, on questionne. Vous avez infligé le double de ce malheur à vos ennemis. Dites-vous : D'où cela vient-il ? C'est de vous-mêmes.`,
  reflection: `L'épreuve vient souvent de nos propres actes. La question « d'où » détourne du « pourquoi ».`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anna hadha » — d'où cela ? La question qui détourne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand l'épreuve vient, est-ce que je questionne ? Ou est-ce que je réflechis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question « d'où » cache souvent la vraie cause : nous-mêmes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est cause et effet. L'épreuve a souvent des causes internes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se voit dans l'épreuve comprend son origine." }
  ],
  munajat: `Ya Hakim, quand l'épreuve vient, fais que je me voie. Ne permets pas que je questionne sans comprendre. Donne-moi la lucidité sur moi-même.`
};

MIROIR["3:166"] = {
  reference: "3:166",
  theme: ["épreuve", "distinction", "test"],
  emotion: "Compréhension du test",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-'Alim"],
  mirrorVersion: `« Ce qui vous a atteints le jour où les deux armées se sont rencontrées, c'est par la permission d'Allah. » Le miroir me montre que rien n'arrive sans la permission d'Allah. L'épreuve est un test. Pour distinguer les croyants authentiques. Rien n'est perdu dans le décret divin.`,
  reflection: `L'épreuve vient par la permission d'Allah. Elle distingue et purifie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi idhni Allah » — par la permission d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que tout arrive par la permission d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission d'Allah n'est pas Son agrément — elle est Sa sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers n'arrive par hasard. Tout est permis par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la permission d'Allah dans tout accepte tout." }
  ],
  munajat: `Ya 'Alim, je sais que tout arrive par Ta permission. Aide-moi à accepter. Fais que je comprenne Ta sagesse dans l'épreuve.`
};

MIROIR["3:167"] = {
  reference: "3:167",
  theme: ["hypocrisie", "révélation", "test"],
  emotion: "Exposition des hypocrites",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khallas", "Al-Fattah"],
  mirrorVersion: `« Et qu'Il distingue les hypocrites. » Le miroir me montre que l'épreuve révèle les hypocrites. Quand on leur dit : Venez combattre, ils disent : Si nous avions su, nous serions venus. Ils sont plus proches de la mécréance que de la foi. L'épreuve révèle les cœurs.`,
  reflection: `L'épreuve distingue les vrais des faux. L'hypocrisie ne résiste pas au test.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-yastabayyana al-munafiqun » — et pour distinguer les hypocrites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'épreuve révèle ma foi ou mon hypocrisie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hypocrisie n'est pas un état permanent — elle peut être transformée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve est le feu qui sépare l'or du plomb." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère ne craint pas l'épreuve qui révèle." }
  ],
  munajat: `Ya Fattah, révèle ce qui est caché dans mon cœur. Si je suis hypocrite, purifie-moi. Fais que l'épreuve ne montre que la foi.`
};

MIROIR["3:168"] = {
  reference: "3:168",
  theme: ["hypocrisie", "paroles", "frères"],
  emotion: "Condamnation de l'hypocrisie",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Haqq"],
  mirrorVersion: `« Ceux qui sont restés chez eux disent de leurs frères : S'ils nous avaient obéis, ils n'auraient pas été tués. » Le miroir me montre la lâcheté des hypocrites. Ils restent chez eux, puis critiquent ceux qui ont combattu. Dis-leur : Écartez donc de vous la mort, si vous êtes véridiques.`,
  reflection: `Les hypocrites critiquent après coup. Ils ne peuvent éviter leur propre mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law ata'una ma qutilu » — s'ils nous avaient obéis, ils n'auraient pas été tués." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je critique ceux qui agissent ? Ou est-ce que j'agis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La critique facile ne protège pas de sa propre mort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun porte sa propre mort. Nul ne peut la transférer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit n'a pas besoin de critiquer. Celui qui critique n'agit pas." }
  ],
  munajat: `Ya Khabir, garde-moi de l'hypocrisie. Ne permets pas que je critique ceux qui agissent. Donne-moi la force d'agir plutôt que de parler.`
};

MIROIR["3:169"] = {
  reference: "3:169",
  theme: ["martyrs", "vie", "récompense"],
  emotion: "Espoir pour les martyrs",
  difficulty: "débutant",
  relatedNames: ["Al-Hayy", "Al-Shahid"],
  mirrorVersion: `« Ne pense pas que ceux qui ont été tués dans le chemin d'Allah soient morts. » Le miroir me montre la réalité des martyrs. Ils sont vivants auprès de leur Seigneur, bien pourvus. La mort dans le chemin d'Allah n'est pas une mort — c'est une transition vers une vie meilleure.`,
  reflection: `Les martyrs sont vivants. Leur mort apparente cache une vie réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal ahya'un 'inda rabbihim yurzaqun » — ils sont vivants auprès de leur Seigneur, bien pourvus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je considère la mort des martyrs ? Comme une perte ou comme une vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort visible est une vie invisible. La vie visible peut être une mort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie n'est pas dans le corps — elle est dans la relation avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les martyrs ont compris ce que les vivants ignorent." }
  ],
  munajat: `Ya Hayy, les martyrs sont vivants auprès de Toi. Donne-moi leur compréhension. Fais que ma vie soit une vraie vie, pas une mort déguisée.`
};

MIROIR["3:170"] = {
  reference: "3:170",
  theme: ["martyrs", "joie", "attente"],
  emotion: "Joie des martyrs",
  difficulty: "débutant",
  relatedNames: ["Al-Farih", "Ar-Razzaq"],
  mirrorVersion: `« Ils se réjouissent de ce qu'Allah leur a donné de Sa grâce. » Le miroir me montre la joie des martyrs. Ils ont reçu la grâce d'Allah. Ils se réjouissent pour ceux qui ne les ont pas encore rejoints. Ils sont sans crainte et sans chagrin. La vraie joie est auprès d'Allah.`,
  reflection: `Les martyrs sont dans la joie. Ils attendent leurs frères sans crainte ni chagrin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Farihina bima atahumu Allah » — ils se réjouissent de ce qu'Allah leur a donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma joie ? Est-ce comparable à celle des martyrs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie sans crainte ni chagrin n'existe qu'auprès d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie joie est complète. Sans mélange de crainte ou de chagrin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte à cette joie ne peut plus la comparer aux joies du monde." }
  ],
  munajat: `Ya Raziq, donne-moi la joie des martyrs. Fais que je me réjouisse de Ta grâce. Éloigne de moi la crainte et le chagrin.`
};

MIROIR["3:171"] = {
  reference: "3:171",
  theme: ["martyrs", "bonne nouvelle", "récompense"],
  emotion: "Espoir pour les vivants",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Karim"],
  mirrorVersion: `« Ils se réjouissent aussi de la bonne nouvelle à leurs successeurs. » Le miroir me montre que les martyrs attendent ceux qui viendront après. La bonne nouvelle : qu'ils n'ont rien à craindre et ne seront pas affligés. La récompense d'Allah est pour tous ceux qui suivent le chemin.`,
  reflection: `La bonne nouvelle s'étend aux successeurs. La récompense n'est pas limitée aux premiers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bushra » — bonne nouvelle. L'annonce qui réjouit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je de ceux qui suivent ? La bonne nouvelle m'est-elle destinée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne nouvelle n'est pas pour quelques-uns — elle est pour tous ceux qui croient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaîne des croyants traverse le temps. Chaque maillon reçoit la même promesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le chemin rejoint ceux qui l'ont précédé." }
  ],
  munajat: `Ya Bashir, donne-moi la bonne nouvelle. Fais que je sois parmi les successeurs. Que je n'aie rien à craindre et ne sois pas affligé.`
};

MIROIR["3:172"] = {
  reference: "3:172",
  theme: ["réponse", "obéissance", "blessure"],
  emotion: "Gloire des fidèles",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujib", "Al-Wali"],
  mirrorVersion: `« Ceux qui ont répondu à Allah et au Messager après avoir été blessés. » Le miroir me montre l'héroïsme des croyants après Uhud. Blessés, ils ont quand même répondu à l'appel. À ceux qui ont bien agi et craint Allah, une récompense immense est promise.`,
  reflection: `La réponse après la blessure est le signe de la vraie foi. La récompense suit l'effort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina istajabu lillahi wa al-rasuli » — ceux qui ont répondu à Allah et au Messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Répondrais-je à l'appel même après avoir été blessé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La blessure n'empêche pas la réponse. Elle peut même l'intensifier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La réponse à l'appel est la loi de l'univers. L'homme peut y répondre ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond après la blessure a répondu vraiment." }
  ],
  munajat: `Ya Mujib, fais que je réponde à Ton appel même dans la difficulté. Donne-moi la force de ceux qui ont bien agi. Promets-moi la récompense immense.`
};

MIROIR["3:173"] = {
  reference: "3:173",
  theme: ["foi", "confiance", "multiplier"],
  emotion: "Force dans la foi",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Kafi"],
  mirrorVersion: `« Ceux à qui les gens ont dit : Les gens se sont rassemblés contre vous, craignez-les. Cela a augmenté leur foi, et ils ont dit : Allah nous suffit, et Il est le meilleur garant. » Le miroir me montre la réaction des croyants face à la menace. La foi augmente au lieu de diminuer. Allah nous suffit — le tawakkul parfait.`,
  reflection: `La menace extérieure peut augmenter la foi. « Allah nous suffit » est la réponse parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hasbuna Allah wa ni'ma al-wakil » — Allah nous suffit, et Il est le meilleur garant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand la menace vient, ma foi augmente-t-elle ou diminue-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La menace révèle la foi. La peur révèle le manque de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La confiance en Allah est plus solide que n'importe quelle armée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit « Allah nous suffit » a tout dit." }
  ],
  munajat: `Ya Wakil, Allah me suffit. Tu es le meilleur garant. Fais que ma foi augmente face à la menace. Ne permets pas que je craigne les hommes.`
};

MIROIR["3:174"] = {
  reference: "3:174",
  theme: ["retour", "grâce", "protection"],
  emotion: "Gratitude pour la protection",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Manna'n"],
  mirrorVersion: `« Ils revinrent avec la grâce d'Allah et Sa faveur, sans avoir été touchés par le mal. » Le miroir me montre le résultat du tawakkul. Ils ont suivi le plaisir d'Allah. Ils reviennent avec la grâce, la faveur, et sans mal. Le tawakkul porte ses fruits.`,
  reflection: `La confiance en Allah apporte la grâce, la faveur, et la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi ni'matin min Allah wa fadl » — avec la grâce d'Allah et Sa faveur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Allah ? Quel est le fruit de ma confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mal ne touche pas celui qu'Allah protège." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection d'Allah est invisible mais réelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient avec la grâce a fait le bon voyage." }
  ],
  munajat: `Ya Hafiz, ramène-moi avec Ta grâce et Ta faveur. Protège-moi de tout mal. Fais que je suive Ton plaisir.`
};

MIROIR["3:175"] = {
  reference: "3:175",
  theme: ["satan", "peur", "ami"],
  emotion: "Mise en garde contre Satan",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Khallas"],
  mirrorVersion: `« C'est Satan qui vous fait peur de ses amis. » Le miroir me montre l'origine de la peur. Satan veut que nous craignions ses amis au lieu de craindre Allah. Ne les craignez pas. Craignez-Moi, si vous êtes croyants. La peur mal placée est une ruse de Satan.`,
  reflection: `La peur des ennemis vient de Satan. La crainte d'Allah est la bonne peur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama dhalikumu al-shaytanu yukhawwifu awliya'ahu » — c'est Satan qui vous fait peur de ses amis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi ai-je peur ? Des amis de Satan ou d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur des créatures détourne de la crainte du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La peur est une énergie. Sa direction détermine son effet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah seul n'a peur de rien d'autre." }
  ],
  munajat: `Ya Rabb, je Te crains et ne crains pas les amis de Satan. Libère-moi de la peur mal placée. Donne-moi la crainte qui libère.`
};

MIROIR["3:176"] = {
  reference: "3:176",
  theme: ["course", "mécréance", "tristesse"],
  emotion: "Détachement des égareurs",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Ghani"],
  mirrorVersion: `« Que ne t'affligent pas ceux qui se précipitent vers la mécréance. » Le miroir me montre que la course des mécréants vers l'égarement ne doit pas attrister. Ils ne nuiront à Allah en rien. Allah ne veut pas leur faire part de Sa grâce dans l'au-delà. Leur sort est scellé par leur choix.`,
  reflection: `La course vers la mécréance ne nuit pas à Allah. Elle nuit à ceux qui la font.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yadurru Allaha shay'an » — ils ne nuiront à Allah en rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'égarement des autres m'attriste ? Ou est-ce que je me concentre sur mon chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement des autres est leur choix. Mon chemin est mon choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne perd rien par l'égarement de quelques-uns." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se concentre sur son chemin n'est pas distrait par celui des autres." }
  ],
  munajat: `Ya Ghani, l'égarement des autres ne T'affecte pas. Fais qu'il ne m'affecte pas non plus. Donne-moi la concentration sur mon chemin.`
};

MIROIR["3:177"] = {
  reference: "3:177",
  theme: ["commerce", "foi", "perte"],
  emotion: "Clarté de la transaction",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Haqq"],
  mirrorVersion: `« Ceux qui achètent la mécréance au prix de la foi ne nuiront à Allah en rien. » Le miroir me montre la transaction inversée. Acheter la mécréance au prix de la foi. Un mauvais commerce. Ils ne nuisent qu'à eux-mêmes. Le châtiment douloureux les attend.`,
  reflection: `Échanger la foi contre la mécréance est le pire commerce. On ne perd qu'à ce change.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina ishtrawu al-kufra bi al-iman » — ceux qui achètent la mécréance au prix de la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'échange ? Est-ce un bon commerce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mauvais commerce n'est pas la perte d'Allah — c'est la perte du commerçant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque transaction a un gagnant et un perdant. Ici, le commerçant est le perdant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la valeur de la foi ne l'échange contre rien." }
  ],
  munajat: `Ya Rabb, je ne veux pas échanger ma foi contre quoi que ce soit. Donne-moi la valeur de la foi. Ne permets pas que je sois parmi les perdants.`
};

MIROIR["3:178"] = {
  reference: "3:178",
  theme: ["délai", "mécréants", "ruse"],
  emotion: "Compréhension du délai",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halim", "Al-Muntaqim"],
  mirrorVersion: `« Que ceux qui ont mécru ne pensent pas que le délai que Nous leur accordons soit un bien pour eux. » Le miroir me montre l'illusion du délai. Le temps accordé aux mécréants n'est pas une bénédiction. C'est une augmentation de leur châtiment. Ils s'enfoncent dans le péché. Le délai est une ruse.`,
  reflection: `Le délai accordé aux mécréants n'est pas une grâce — c'est une augmentation de leur perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nuhli lahum » — le délai que Nous leur accordons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends le délai d'Allah ? Est-ce que je l'utilise pour me repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai peut être une bénédiction ou une malédiction selon l'usage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est neutre. Son effet dépend de celui qui l'utilise." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le délai ne le gaspille pas." }
  ],
  munajat: `Ya Halim, le délai est une opportunité. Fais que je l'utilise pour me rapprocher de Toi. Ne permets pas que je m'y enlise.`
};

MIROIR["3:179"] = {
  reference: "3:179",
  theme: ["test", "distinction", "mélange"],
  emotion: "Compréhension de l'épreuve",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Khallas"],
  mirrorVersion: `« Allah ne laissera pas les croyants dans l'état où vous êtes, jusqu'à ce qu'Il distingue le mauvais du bon. » Le miroir me montre que le mélange actuel est temporaire. L'épreuve viendra pour séparer. Allah connaît les inconnaissables des cieux et de la terre. La distinction viendra.`,
  reflection: `Le mélange des croyants et des hypocrites est temporaire. L'épreuve distinguera les deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta yamiza al-khabith min al-tayyib » — jusqu'à ce qu'Il distingue le mauvais du bon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'épreuve qui vient me distinguera-t-elle comme bon ou mauvais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distinction n'est pas un jugement — c'est une révélation de la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers distingue naturellement. L'homme sera distingué par l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est bon n'a pas peur de la distinction." }
  ],
  munajat: `Ya Fattah, distingue en moi ce qui est bon de ce qui est mauvais. Purifie-moi par l'épreuve. Fais que je sois compté parmi les bons.`
};

MIROIR["3:180"] = {
  reference: "3:180",
  theme: ["avarice", "richesse", "rétribution"],
  emotion: "Avertissement aux avares",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Karim"],
  mirrorVersion: `« Que ceux qui gardent avarement ce qu'Allah leur a donné de Sa grâce ne pensent pas que c'est un bien pour eux. » Le miroir me montre l'illusion de l'avarice. Garder ce qu'Allah a donné n'est pas un bien. C'est ce qu'ils ont qui sera leur collier au Jour de la résurrection. À Allah l'héritage des cieux et de la terre.`,
  reflection: `L'avarice n'enrichit pas — elle emprisonne. Ce qu'on garde devient un collier au Jour dernier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma yabkhaluna » — ce qu'ils gardent avarement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je garde avarement ? Est-ce que je comprends que cela me sera collier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner libère. Garder emprisonne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par don. L'avarice contredit cette loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne vraiment possède. Celui qui garde vraiment perd." }
  ],
  munajat: `Ya Ghani, Tu es le riche et je suis le pauvre. Fais que je donne et ne garde pas avarement. Ne permets pas que ce que j'ai soit mon collier.`
};

MIROIR["3:181"] = {
  reference: "3:181",
  theme: ["paroles", "mensonge", "châtiment"],
  emotion: "Avertissement sévère",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-'Alim"],
  mirrorVersion: `« Allah a certainement entendu la parole de ceux qui ont dit : Allah est pauvre et nous sommes riches. » Le miroir me montre l'audace des mécréants. Ils osent dire qu'Allah est pauvre. Nous enregistrons leurs paroles et leur jugement injuste des prophètes. Le châtiment du Feu les attend.`,
  reflection: `Les paroles sont entendues par Allah. Les accusations contre Allah ne restent pas sans réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allah sami'a qawla » — Allah a entendu la parole." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles paroles je dis ? Est-ce qu'Allah les entend ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accuser Allah ne Le touche pas — elle touche l'accusateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute parole est enregistrée. Le silence de la réponse n'est pas l'absence de réponse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend qu'Allah entend fait attention à ses paroles." }
  ],
  munajat: `Ya Sami', Tu entends toutes mes paroles. Fais que je ne dise que ce qui Te plaît. Ne permets pas que je sois parmi les accusateurs.`
};

MIROIR["3:182"] = {
  reference: "3:182",
  theme: ["œuvres", "conséquence", "justice"],
  emotion: "Responsabilité de ses actes",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hasib"],
  mirrorVersion: `« Cela est ainsi, pour ce que vos mains ont préparé. » Le miroir me montre que le châtiment n'est pas arbitraire. Il est la conséquence des œuvres. Allah n'est pas injuste envers les serviteurs. Chacun reçoit ce qu'il a préparé.`,
  reflection: `Le châtiment est la conséquence des œuvres. Allah n'est pas injuste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bima qaddamat aydikum » — pour ce que vos mains ont préparé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ont préparé mes mains ? Quel sera le résultat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment n'est pas ajouté — il est la récolte de ce qui a été semé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est causal. Chaque cause a son effet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la causalité comprend la responsabilité." }
  ],
  munajat: `Ya 'Adl, Tu n'es pas injuste. Fais que je prépare le bien. Ne permets pas que mes mains préparent le mal. Donne-moi une bonne récolte.`
};

MIROIR["3:183"] = {
  reference: "3:183",
  theme: ["exigence", "sacrifice", "excuse"],
  emotion: "Examen des excuses",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Haqq"],
  mirrorVersion: `« Ceux qui ont dit : Allah a pris un engagement avec nous de ne croire en aucun messager. » Le miroir me montre l'excuse des gens du Livre. Ils prétendent qu'Allah leur a demandé un sacrifice consumé par le feu. Mais les messagers avant Muhammad sont venus avec des preuves et ce qu'ils demandaient. Pourquoi les avez-vous tués alors ? L'excuse ne tient pas.`,
  reflection: `Les excuses des mécréants sont des prétextes. L'histoire montre leur incohérence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qurbanan ta'kulu al-nar » — un sacrifice consumé par le feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles excuses j'invente pour ne pas croire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse qui masque le refus n'est pas une raison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne dépend pas de nos exigences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut croire trouve des raisons. Celui qui ne veut pas trouve des excuses." }
  ],
  munajat: `Ya Haqq, ne permets pas que je cache mon refus derrière des excuses. Donne-moi un cœur qui accepte la vérité sans condition.`
};

MIROIR["3:184"] = {
  reference: "3:184",
  theme: ["prophètes", "accusation", "patience"],
  emotion: "Modèle de constance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Hadi"],
  mirrorVersion: `« S'ils te traitent de menteur, des prophètes avant toi ont été traités de menteurs. » Le miroir me montre que le rejet du Prophète n'est pas nouveau. Ils sont venus avec des preuves claires, des livres et des écritures illuminantes. La patience face au rejet est la voie des prophètes.`,
  reflection: `Le rejet n'est pas une preuve de fausseté. Les prophètes ont été rejetés avant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad kuddhiba rusulun min qablika » — des messagers avant toi ont été traités de menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis patient face au rejet ? Ou est-ce que je me décourage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet des hommes n'est pas le rejet d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité a toujours été contestée. Cela ne l'affaiblit pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est rejeté pour la vérité est en bonne compagnie." }
  ],
  munajat: `Ya Sabur, donne-moi la patience des prophètes face au rejet. Ne permets pas que je me décourage. Fais que je suis la voie de ceux qui ont été patients.`
};

MIROIR["3:185"] = {
  reference: "3:185",
  theme: ["mort", "vie", "rétribution"],
  emotion: "Réalité ultime",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Toute âme goûtera la mort. » Le miroir me montre l'inévitable rendez-vous. La mort nous atteindra tous. Les biens de ce monde ne sont qu'une jouissance trompeuse. La vraie vie est dans l'au-delà. C'est là que les rétributions seront complètes.`,
  reflection: `La mort est certaine. Ce monde est trompeur. L'au-delà est la vraie vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu nafsin dha'iqatu al-mawt » — toute âme goûtera la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience de la mort ? Ou est-ce que je fuis cette réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin — c'est le passage vers la vraie vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers passe. Seul Allah demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte la mort avec foi goûte ensuite la vie éternelle." }
  ],
  munajat: `Ya Mumit, je goûterai la mort. Prépare-moi à ce rendez-vous. Fais que ce monde ne me trompe pas. Donne-moi la vraie vie dans l'au-delà.`
};

MIROIR["3:186"] = {
  reference: "3:186",
  theme: ["épreuve", "biens", "personnes"],
  emotion: "Préparation aux épreuves",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Muhaymin"],
  mirrorVersion: `« Vous serez certainement éprouvés dans vos biens, vos personnes, et vous entendrez des mécréants beaucoup de paroles blessantes. » Le miroir me montre l'annonce des épreuves. Biens, personnes, paroles blessantes — trois terrains d'épreuve. Si vous êtes patients et pieux, c'est une résolution ferme.`,
  reflection: `Les épreuves sont annoncées. La patience et la piété sont la réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tublawunna » — vous serez certainement éprouvés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ces épreuves ? Ma patience et ma piété sont-elles fermes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'annonce de l'épreuve est une préparation. Savoir permet de se préparer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve est universelle. La réponse différencie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prévu n'est pas pris au dépourvu." }
  ],
  munajat: `Ya Sabur, prépare-moi aux épreuves. Donne-moi la patience et la piété. Fais que je ne sois pas pris au dépourvu.`
};

MIROIR["3:187"] = {
  reference: "3:187",
  theme: ["alliance", "livre", "trahison"],
  emotion: "Constat de la trahison",
  difficulty: "débutant",
  relatedNames: ["Al-Amin", "Al-Haqq"],
  mirrorVersion: `« Allah a pris l'engagement de ceux qui ont reçu le Livre de l'exposer clairement aux gens. » Le miroir me montre l'alliance rompue. Ils devaient exposer le Livre, mais ils l'ont caché. Ils l'ont jeté derrière leur dos. Ils l'ont vendu à vil prix. Quel mauvais commerce !`,
  reflection: `L'alliance avec Allah est sérieuse. La trahir est un mauvais commerce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa nabadhahu wara'a zuhurihim » — ils l'ont jeté derrière leur dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai jeté derrière mon dos ? Quelle alliance ai-je rompue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Jeter derrière le dos n'efface pas — ça cache temporairement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité cachée reste vraie. L'alliance rompue reste un engagement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cache la vérité se cache à lui-même." }
  ],
  munajat: `Ya Amin, garde-moi fidèle à mes alliances. Ne permets pas que je jette Ta vérité derrière mon dos. Fais que je l'expose clairement.`
};

MIROIR["3:188"] = {
  reference: "3:188",
  theme: ["complaisance", "corruption", "illusion"],
  emotion: "Avertissement aux complaisants",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Batin"],
  mirrorVersion: `« Ne pense pas que ceux qui se réjouissent de ce qu'ils ont fait aiment être loués pour ce qu'ils n'ont pas fait. » Le miroir me montre l'illusion des complaisants. Ils se réjouissent de leurs fautes et veulent être loués pour ce qu'ils n'ont pas fait. Ils ont un châtiment douloureux.`,
  reflection: `Se réjouir de ses fautes et vouloir être loué pour ce qu'on n'a pas fait est une double illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuhabbuna an yuhmada » — ils aiment être loués." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me réjouis de mes fautes ? Est-ce que je veux être loué pour ce que je n'ai pas fait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange non méritée est une dette." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La réalité ne change pas par la louange. Ce qui n'est pas n'est pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut la louange pour ce qu'il n'a pas fait se ment à lui-même." }
  ],
  munajat: `Ya Khabir, Tu connais la réalité de mes actes. Ne permets pas que je me réjouisse de mes fautes. Fais que je ne cherche que la louange méritée.`
};

MIROIR["3:189"] = {
  reference: "3:189",
  theme: ["souveraineté", "cieux", "terre"],
  emotion: "Reconnaissance de la grandeur",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Khaliq"],
  mirrorVersion: `« À Allah appartient la royauté des cieux et de la terre. » Le miroir me revient à cette vérité fondamentale. Tout appartient à Allah. La royauté, la souveraineté, la possession — tout Lui revient. Et Allah est Omnipotent.`,
  reflection: `La souveraineté d'Allah est absolue. Il est Omnipotent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillahi mulku al-samawati wa al-ard » — à Allah appartient la royauté des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si tout appartient à Allah, qu'est-ce que je possède vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Reconnaître la souveraineté d'Allah libère de l'illusion de possession." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est à Son Créateur. L'homme est un gérant, pas un propriétaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la souveraineté d'Allah reconnaît sa propre position." }
  ],
  munajat: `Ya Malik, Tu possèdes tout. Je ne suis qu'un gérant. Fais que je gère bien ce que Tu m'as confié. Rappelle-moi toujours Ta souveraineté.`
};

MIROIR["3:190"] = {
  reference: "3:190",
  theme: ["création", "signes", "réflexion"],
  emotion: "Émerveillement méditatif",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Dans la création des cieux et de la terre, et dans l'alternance de la nuit et du jour, il y a des signes pour les doués d'intelligence. » Le miroir m'ouvre à la contemplation de l'univers. Chaque création est un signe. L'alternance nuit-jour est un rythme. Les doués d'intelligence voient et réfléchissent.`,
  reflection: `La création est un livre de signes. L'alternance est un rythme. Les intelligents lisent et comprennent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ayatin li-uli al-albab » — des signes pour les doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les signes de la création ? Ou est-ce que je passe à côté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes ne sont pas cachés — ils sont partout. Il faut les yeux pour les voir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un message. Chaque atome porte une signature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit les signes de la création lit le message du Créateur." }
  ],
  munajat: `Ya Khaliq, ouvre mes yeux aux signes de Ta création. Fais que je sois parmi les doués d'intelligence. Ne permets pas que je passe à côté de Tes messages.`
};

MIROIR["3:191"] = {
  reference: "3:191",
  theme: ["rappel", "réflexion", "prière"],
  emotion: "Modèle des croyants",
  difficulty: "débutant",
  relatedNames: ["Al-Dhakir", "Al-Hakim"],
  mirrorVersion: `« Ceux qui se rappellent d'Allah debout, assis et couchés sur le côté, et méditent sur la création des cieux et de la terre. » Le miroir me montre le modèle du croyant permanent. Le rappel dans toutes les positions. La méditation sur la création. Notre Seigneur, Tu n'as pas créé cela en vain.`,
  reflection: `Le rappel constant et la méditation sur la création sont les marques des croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yadhkuruna Allaha qiyaman wa qu'udan » — ceux qui se rappellent d'Allah debout et assis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me rappelle d'Allah dans toutes les positions ? Ou seulement dans certaines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel constant n'est pas une contrainte — c'est une compagnie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en rappel constant de son Créateur. L'homme est invité à en faire autant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle constamment est constamment rappelé." }
  ],
  munajat: `Ya Dhakir, fais que je me rappelle de Toi dans toutes les positions. Donne-moi la méditation sur Ta création. Fais que je dise : Tu n'as pas créé cela en vain.`
};

MIROIR["3:192"] = {
  reference: "3:192",
  theme: ["enfer", "supplication", "humilité"],
  emotion: "Supplication craintive",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Qadir"],
  mirrorVersion: `« Notre Seigneur, celui que Tu fais entrer dans le Feu, Tu l'as couvert d'ignominie. » Le miroir me montre la supplication des croyants. Ils craignent le Feu. Ils savent que l'enfer est une ignominie. Pour les injustes, il n'y a pas de secoureurs.`,
  reflection: `Le Feu est une ignominie. La supplication sincère en préserve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man yudkhilihi al-nar fa qad akhzaytahu » — celui que Tu fais entrer dans le Feu, Tu l'as couvert d'ignominie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le Feu ? Est-ce que je supplie pour en être préservé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignominie du Feu est éternelle pour les injustes. La miséricorde est pour les repentis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Feu n'est pas une menace vide — c'est une réalité qui attend." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le Feu maintenant ne le craindra pas alors." }
  ],
  munajat: `Ya Rabb, préserve-moi du Feu. Ne me couvre pas d'ignominie. Je Te supplie de me sauver des injustes.`
};

MIROIR["3:193"] = {
  reference: "3:193",
  theme: ["appel", "réponse", "foi"],
  emotion: "Réponse à l'appel divin",
  difficulty: "débutant",
  relatedNames: ["Al-Da'i", "Al-Hadi"],
  mirrorVersion: `« Notre Seigneur, nous avons entendu un appelant appeler à la foi : Croyez en votre Seigneur. Nous avons donc cru. » Le miroir me montre la chaîne de la foi. L'appel, l'écoute, la réponse, la foi. Seigneur, pardonne-nous nos péchés, efface nos méfaits, fais-nous mourir avec les vertueux.`,
  reflection: `L'appel à la foi trouve une réponse. La foi naît de l'écoute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sami'na munadiyan yunadi li al-iman » — nous avons entendu un appelant appeler à la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entends l'appel à la foi ? Est-ce que je réponds ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel est constant. La réponse détermine le sort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond à l'appel de son Créateur. L'homme est libre de répondre ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'appel à la foi a déjà cru." }
  ],
  munajat: `Ya Da'i, j'entends Ton appel. Je crois. Pardonne mes péchés, efface mes méfaits. Fais-moi mourir avec les vertueux.`
};

MIROIR["3:194"] = {
  reference: "3:194",
  theme: ["promesse", "réponse", "victoire"],
  emotion: "Attente confiante",
  difficulty: "débutant",
  relatedNames: ["Al-Sadiq", "Al-Wadi"],
  mirrorVersion: `« Notre Seigneur, accorde-nous ce que Tu nous as promis par Tes messagers. » Le miroir me montre la prière qui réclame la promesse. Les croyants demandent l'accomplissement. Ne nous couvre pas d'ignominie au Jour de la résurrection. Toi qui ne manques pas à Ta promesse.`,
  reflection: `La promesse d'Allah sera tenue. La prière demande son accomplissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa atina ma wa'adtana » — accorde-nous ce que Tu nous as promis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réclame la promesse d'Allah ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse sera tenue. La prière la précipite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers attend l'accomplissement des promesses divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande l'accomplissement de la promesse y participe." }
  ],
  munajat: `Ya Sadiq, accorde-moi ce que Tu as promis. Ne me couvre pas d'ignominie. Tu ne manques jamais à Ta promesse.`
};

MIROIR["3:195"] = {
  reference: "3:195",
  theme: ["réponse", "égalité", "œuvres"],
  emotion: "Justice divine complète",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-'Adl"],
  mirrorVersion: `« Votre Seigneur a donc exaucé : Je ne laisserai perdre aucune œuvre de celui qui fait le bien, homme ou femme. » Le miroir me montre la justice parfaite d'Allah. Homme ou femme — même valeur. Ceux qui ont émigré, été expulsés, ont souffert, combattu — Je couvrirai leurs fautes. Je les ferai entrer aux Jardins.`,
  reflection: `Allah ne perd aucune bonne œuvre. Homme et femme sont égaux devant la rétribution.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa astajaba lahum rabbuhum » — leur Seigneur a donc exaucé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que mes œuvres ne seront pas perdues ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La souffrance d'ici-bas est la monnaie de la récompense de l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne perd rien. Chaque effort est compté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien pour Allah voit toutes ses œuvres comptées." }
  ],
  munajat: `Ya Mujib, Tu as exaucé. Ne perds pas mes œuvres. Couvre mes fautes et fais-moi entrer aux Jardins. Je suis parmi ceux qui font le bien.`
};

MIROIR["3:196"] = {
  reference: "3:196",
  theme: ["illusion", "mécréants", "déception"],
  emotion: "Mise en garde contre les apparences",
  difficulty: "débutant",
  relatedNames: ["Al-Batin", "Al-Haqq"],
  mirrorVersion: `« Que ne t'abusent pas les allées et venues des mécréants dans le pays. » Le miroir me montre l'illusion des apparences. Les mécréants semblent prospères. Ils vont et viennent librement. Mais c'est une jouissance temporaire. Puis leur refuge sera l'enfer.`,
  reflection: `La prospérité apparente des mécréants est une illusion. Leur destination finale est terrible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yaghurrannaqa taqallubu alladhina kafaru » — que ne t'abusent pas leurs allées et venues." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis impressionné par la prospérité des mécréants ? Ou est-ce que je vois la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apparence cache la réalité. Le mouvement cache la destination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne juge pas par les apparences. Le jugement est sur la réalité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la destination finale n'est pas trompé par le chemin." }
  ],
  munajat: `Ya Batin, ne permets pas que je sois trompé par les apparences. Montre-moi la réalité derrière l'illusion. Fais que je voie la destination finale.`
};

MIROIR["3:197"] = {
  reference: "3:197",
  theme: ["jouissance", "temporaire", "enfer"],
  emotion: "Rappel de la brièveté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "An-Nar"],
  mirrorVersion: `« Fa qalilun thumma ma'wahum jahannam » — une faible jouissance, puis leur refuge sera l'enfer. Le miroir me montre le contraste saisissant. La jouissance d'ici-bas est faible et temporaire. L'enfer est éternel. Quel mauvais lit !`,
  reflection: `La jouissance de ce monde est brève. L'enfer est éternel. Le contraste est absolu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa qalilun » — peu, une faible jouissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'échange l'éternel contre le temporaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temporaire ne vaut pas l'éternel. Le peu ne vaut pas le tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers distingue le temporaire de l'éternel. L'homme doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le contraste ne choisit pas le mauvais lit." }
  ],
  munajat: `Ya Rabb, ne permets pas que je choisisse le temporaire contre l'éternel. Donne-moi la perspective vraie. Fais que je ne sois pas dupe du peu.`
};

MIROIR["3:198"] = {
  reference: "3:198",
  theme: ["paradis", "taqwa", "éternité"],
  emotion: "Espoir pour les pieux",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Muttaqi"],
  mirrorVersion: `« Mais ceux qui craignent leur Seigneur auront des Jardins sous lesquels coulent des ruisseaux. » Le miroir me montre la récompense des pieux. Des Jardins éternels. Une hospitalité d'Allah. Ce qui est auprès d'Allah est meilleur pour les bienfaisants.`,
  reflection: `La crainte d'Allah mène aux Jardins éternels. La récompense surpasse tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatun tajri min tahtiha al-anhar » — des Jardins sous lesquels coulent les ruisseaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains mon Seigneur ? Est-ce que j'espère les Jardins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah n'est pas la peur — c'est la conscience qui mène au Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination de toute âme droite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant sera en sécurité alors." }
  ],
  munajat: `Ya Rabb, je Te crains. Donne-moi les Jardins éternels. Fais que je sois parmi les bienfaisants. Ce qui est auprès de Toi est meilleur.`
};

MIROIR["3:199"] = {
  reference: "3:199",
  theme: ["gens du livre", "foi", "révélation"],
  emotion: "Reconnaissance de la foi universelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'min", "Al-Hadi"],
  mirrorVersion: `« Parmi les gens du Livre, il en est qui croient en Allah et ce qui est descendu sur vous et sur eux. » Le miroir me montre que la foi n'est pas limitée à une communauté. Certains parmi les gens du Livre croient vraiment. Ils sont humbles devant Allah et ne vendent pas les versets à vil prix. Ceux-là ont leur récompense.`,
  reflection: `La foi existe partout où les cœurs sont sincères. Les versets ne sont pas une marchandise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yu'minuna bi Allah » — ils croient en Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la foi là où elle existe ? Ou est-ce que je limite le salut ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi n'appartient à aucun groupe — elle appartient aux cœurs sincères." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. Les chemins sont multiples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah reconnaît la foi sincère d'où qu'elle vienne." }
  ],
  munajat: `Ya Mu'min, je reconnais la foi sincère partout où elle existe. Ne permets pas que je limite Ton salut. Donne-moi un cœur qui reconnaît la vérité.`
};

MIROIR["3:200"] = {
  reference: "3:200",
  theme: ["patience", "persévérance", "victoire"],
  emotion: "Exhortation finale",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Nasir"],
  mirrorVersion: `« Ô vous qui avez cru, endurez avec patience, rivalisez d'endurance, soyez fermes et craignez Allah, afin que vous réussissiez. » Le miroir me montre l'exhortation finale de la sourate. Quatre commandements : patience, endurance, fermeté, taqwa. La réussite est le résultat de ces quatre vertus.`,
  reflection: `La réussite vient de la patience, l'endurance, la fermeté et la taqwa.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Isbiru wa sabiru wa rabitu wa ittaqu Allah » — endurez, rivalisez d'endurance, soyez fermes, craignez Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'applique ces quatre commandements ? Suis-je sur le chemin de la réussite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience active, l'endurance compétitive, la fermeté face aux défis, la taqwa constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers enseigne la patience. L'homme doit l'apprendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique ces quatre vertus réussit forcément." }
  ],
  munajat: `Ya Sabur, donne-moi la patience, l'endurance, la fermeté et la taqwa. Fais que je réussisse. J'applique Ton exhortation finale.`
};

// ============================================
// SURAH 4 - AN-NISA (The Women) - Key Verses
// ============================================

MIROIR["4:1"] = {
  reference: "4:1",
  theme: ["présence", "méditation", "gratitude"],
  emotion: "Unité reconnaissante",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« Ô hommes ! Craignez votre Seigneur qui vous a créés d'un seul être et a créé de celui-ci son épouse, et qui a fait naître de ces deux-là une multitude d'hommes et de femmes. » Le miroir me ramène à l'origine unique de l'humanité. Nous sommes tous frères et sœurs — pas métaphoriquement, mais littéralement. Adam et Ève sont les parents de tous. Cette unité d'origine devrait fonder une fraternité universelle. Les divisions que nous créons sont des illusions.`,
  reflection: `L'humanité est une famille. Les différences sont superficielles, l'origine est commune.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nafsin wahida » — une seule âme. L'humanité entière vient d'une source unique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite mes frères et sœurs humains ? Avec le respect dû à la famille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les divisions que je considère naturelles — race, nation, classe — sont des constructions humaines, pas divines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier manifeste l'unité dans la diversité. La création est une, multiple dans ses expressions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'unité de l'humanité voit l'unité de la création. La fraternité est la vision juste." }
  ],
  munajat: `Ya Khaliq, Tu nous as créés d'un seul. Fais que je voie en chaque être humain mon frère ou ma sœur. Unifie mon cœur avec Ta création.`
};

// ============================================
// SURAH 5 - AL-MA'IDAH (The Table) - Key Verses
// ============================================

MIROIR["5:16"] = {
  reference: "5:16",
  theme: ["guidance", "espoir", "méditation"],
  emotion: "Lumière directionnelle",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Par elle, Allah guide ceux qui cherchent Sa satisfaction dans les chemins du salut. » Le miroir me montre que la guidance est liée à l'intention. « Ceux qui cherchent Sa satisfaction » — c'est la condition. La guidance n'est pas automatique. Elle vient à ceux qui veulent vraiment plaire à Allah. Le chemin du salut (subul as-salam) existe, mais il faut le chercher sincèrement.`,
  reflection: `La guidance répond à la sincérité. Qui cherche vraiment trouve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subul as-salam » — les chemins du salut. Pluriel : il y a plusieurs chemins qui mènent à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cherche vraiment ? La satisfaction d'Allah ou autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La recherche de Sa satisfaction n'est pas une contrainte — c'est le chemin le plus direct vers la paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers suit sa voie tracée. L'homme a besoin de chercher la sienne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche Sa satisfaction la trouve déjà. La recherche est elle-même la guidance." }
  ],
  munajat: `Ya Hadi, je cherche Ta satisfaction. Montre-moi les chemins du salut. Ne me laisse pas errer dans les chemins de perdition.`
};

// ============================================
// SURAH 6 - AL-AN'AM (The Cattle) - Key Verses
// ============================================

MIROIR["6:162"] = {
  reference: "6:162",
  theme: ["présence", "amour", "détachement"],
  emotion: "Offrande totale",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Khaliq"],
  mirrorVersion: `« Dis : Ma prière, mes actes de dévotion, ma vie et ma mort appartiennent à Allah, Seigneur des mondes. » Ce verset est une déclaration d'appartenance radicale. Le miroir me demande : à qui appartient ma vie ? À mon travail ? À ma famille ? À mon ego ? Ce verset dit : tout est à Allah. Ma vie, ma mort, mes prières, mes sacrifices — tout. Cette offrande n'est pas une perte — c'est la vraie possession.`,
  reflection: `Ce qui est offert à Allah devient éternel. Ce qui est gardé pour soi disparaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Quatre offrandes : la prière, la dévotion, la vie, la mort. Le tout de l'existence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je garde pour moi ? Qu'est-ce que j'ai du mal à offrir à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Offrir à Allah n'est pas perdre — c'est investir dans l'éternel. Ce qui est gardé pour soi se perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne à son Seigneur. L'offrande anticipe ce retour et le rend conscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a tout offert a tout gagné. Il ne possède rien et possède tout." }
  ],
  munajat: `Ya Rabb, je T'offre ma vie et ma mort. Prends tout ce que je suis. Fais que tout en moi soit pour Toi.`
};

// ============================================
// SURAH 7 - AL-A'RAF (The Heights) - Key Verses
// ============================================

MIROIR["7:180"] = {
  reference: "7:180",
  theme: ["présence", "méditation", "amour"],
  emotion: "Intimité nommée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Asma' al-Husna"],
  mirrorVersion: `« À Allah appartiennent les plus beaux noms. Invoquez-Le par ces noms et éloignez-vous de ceux qui profanent Ses noms. » Le miroir me montre la puissance de l'invocation par les noms divins. Chaque nom est une porte vers Sa présence. Ar-Rahman pour la miséricorde, Al-Wadud pour l'amour, Al-Hakim pour la sagesse. Invoquer par ces noms n'est pas une formule — c'est une rencontre.`,
  reflection: `Les noms divins sont des ponts entre le créature et le Créateur. Chaque nom révèle un aspect de Sa réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-asma' al-husna » — les plus beaux noms. La tradition en compte 99, mais ils sont illimités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel nom divin me touche le plus en ce moment ? Ce nom m'indique ce dont mon cœur a besoin." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Invoquer par Ses noms n'est pas obtenir — c'est se positionner. Je me place sous l'aspect de Dieu que j'invoque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création manifeste Ses noms. L'univers entier prononne en silence Ses attributs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment un nom divin ne l'invoque pas — il y entre. Le nom devient son état." }
  ],
  munajat: `Ya Dhu al-jalal wa al-ikram, apprends-moi Tes noms. Fais que chaque nom que je prononce soit une véritable rencontre avec Toi.`
};

// ============================================
// SURAH 8 - AL-ANFAL (The Spoils) - Key Verses
// ============================================

MIROIR["8:2"] = {
  reference: "8:2",
  theme: ["présence", "méditation", "force"],
  emotion: "Tremblement sacré",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aziz", "Al-Jalil"],
  mirrorVersion: `« Les vrais croyants sont ceux dont les cœurs tremblent quand on mentionne Allah. » Le miroir m'interroge sur ma réaction face au nom d'Allah. Est-ce que mon cœur tremble ? Ou est-ce que le mot a perdu son impact ? Le tremblement n'est pas de la peur pathologique — c'est la conscience de la Majesté. C'est le signe que le cœur est vivant, qu'il n'est pas endurci.`,
  reflection: `La mention d'Allah devrait éveiller quelque chose dans le cœur. Si elle ne produit rien, c'est que le cœur s'est endurci.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tajillu qulubuhum » — leurs cœurs tremblent. Le verbe évoque l'émotion intense, le frisson sacré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entends le nom d'Allah, que se passe-t-il en moi ? Un tremblement ? Une indifférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tremblement du cœur n'est pas une faiblesse — c'est une force. C'est le signe que le cœur est sensible à la Présence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création tremble devant son Créateur. Seul le cœur humain peut choisir de s'endurcir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur tremble a déjà rencontré Allah. Le tremblement est le premier effet de la proximité." }
  ],
  munajat: `Ya Jalil, fais que mon cœur tremble devant Ta Majesté. Ne le laisse pas s'endurcir par l'habitude. Réveille ma sensibilité à Ta présence.`
};

// ============================================
// SURAH 9 - AT-TAWBAH (The Repentance) - Key Verses
// ============================================

MIROIR["9:18"] = {
  reference: "9:18",
  theme: ["présence", "prière", "confiance"],
  emotion: "Fréquentation sacrée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Masjid", "At-Tawwab"],
  mirrorVersion: `« Ne peuplent les mosquées d'Allah que celui qui croit en Allah et au Jour dernier. » Le miroir me montre que la fréquentation des lieux sacrés n'est pas un acte neutre. Elle dit quelque chose de ma foi. La mosquée n'est pas un bâtiment comme les autres — c'est un espace dédié à Allah. La fréquenter avec foi, accomplir la prière, donner l'aumône — ces actes sont liés. Ils forment un tout.`,
  reflection: `La mosquée est l'espace de la rencontre avec Allah. La fréquenter avec présence est un acte de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaurdu masajid Allah » — ne peuplent les mosquées d'Allah. La fréquentation est un peuplement spirituel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je fréquente les lieux de culte ? Avec présence ou par habitude ? Avec quelle intention ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas le bâtiment qui sanctifie — c'est l'intention du fidèle. La mosquée sans foi est un bâtiment vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une mosquée — chaque lieu peut devenir espace de prosternation pour le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai habitant de la mosquée est celui qui y trouve Allah, pas celui qui y vient par habitude." }
  ],
  munajat: `Ya Allah, fais de ma présence dans Tes mosquées une véritable rencontre avec Toi. Ne me laisse pas devenir un visiteur habituel sans présence.`
};

// ============================================
// SURAH 10 - YUNUS (Jonah) - Key Verses
// ============================================

MIROIR["10:12"] = {
  reference: "10:12",
  theme: ["méditation", "confiance", "guérison"],
  emotion: "Lucidité spirituelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujib", "Al-Ghani"],
  mirrorVersion: `« Quand le malheur touche l'homme, il Nous invoque couché sur le côté, assis ou debout. Mais quand Nous le délivrons, il s'en va comme s'il ne Nous avait jamais invoqués. » Le miroir me montre une tendance humaine universelle : l'oubli dans l'aisance. Dans la difficulté, je crie vers Allah. Dans la facilité, je L'oublie. Ce verset est un diagnostic de mon cœur inconstant. La question est : comment maintenir la conscience de Dieu dans la facilité ?`,
  reflection: `L'homme est facilement oublieux. La facilité endort, l'épreuve réveille. Le défi est de rester éveillé dans la facilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois positions : couché, assis, debout. L'invocation dans l'épreuve est constante, dans toutes les postures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je n'invoque Allah que dans la difficulté ? Qu'en est-il dans l'aisance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité devrait augmenter la gratitude, pas l'oubli. L'épreuve n'est pas nécessaire pour se souvenir d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création se souvient d'Allah en tout temps. L'homme seul alterne entre mémoire et oubli." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah dans la facilité a conquis son ego. Il n'a plus besoin de l'épreuve pour se souvenir." }
  ],
  munajat: `Ya Mujib, Tu m'exauces dans l'épreuve. Ne me laisse pas T'oublier dans l'aisance. Fais que ma gratitude soit aussi constante que mes supplications.`
};

// ============================================
// SURAH 11 - HUD - Key Verses
// ============================================

MIROIR["11:90"] = {
  reference: "11:90",
  theme: ["pardon", "espoir", "confiance"],
  emotion: "Espérance active",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Ar-Rahim"],
  mirrorVersion: `« Et demandez pardon à votre Seigneur, puis revenez à Lui. Mon Seigneur est Miséricordieux, Amoureux. » Le miroir me place devant deux attributs extraordinaires : « Miséricordieux » et « Amoureux » (Wadud). Allah m'aime. Cette vérité transforme tout. Je ne suis pas en face d'un juge froid, mais d'un Amant qui attend mon retour. Le repentir n'est pas une formalité — c'est un retour à l'Amour.`,
  reflection: `Allah est Wadud — Celui qui aime et qui est digne d'amour. Le repentir est une réponse à Son amour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wadud » — l'un des plus beaux noms divins. Il signifie aimant, affectueux, digne d'amour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me vois par rapport à Allah ? Comme un coupable devant un juge ou comme un aimé devant un Amant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mon repentir ne L'ajoute rien — c'est Lui qui m'invite à revenir. L'amour précède le retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour est la force qui maintient l'univers. L'attraction gravitationnelle est un reflet de l'amour divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est aimé par Dieu n'a plus peur du jugement. L'amour couvre tout." }
  ],
  munajat: `Ya Wadud, Tu m'aimes même quand je m'éloigne. Fais que je revienne à Toi non par peur, mais par amour. Sois l'Amour de mon cœur.`
};

// ============================================
// SURAH 12 - YUSUF (Joseph) - Key Verses
// ============================================

MIROIR["12:21"] = {
  reference: "12:21",
  theme: ["confiance", "espoir", "sagesse"],
  emotion: "Confiance mystérieuse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Wali"],
  mirrorVersion: `« Et celui qui l'acheta d'Égypte dit à sa femme : 'Fais-lui bon accueil, peut-être nous sera-t-il utile ou l'adopterons-nous comme fils.' » Ce verset cache un secret. L'homme qui achète Yusuf ne sait pas qu'il achète son futur sauveur de la famine. Le miroir me montre que les apparences trompent. Ce qui semble être une tragédie — être vendu comme esclave — devient le début d'une élévation. Allah travaille dans les coulisses.`,
  reflection: `Les apparences ne sont pas la réalité. Ce qui semble être un mal peut être un bien caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "L'acheteur de Yusuf agit sans savoir qu'il accomplit un plan divin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me semble être un mal dans ma vie ? Et si c'était le début d'un bien caché ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vente de Yusuf comme esclave était le premier pas vers son accession au pouvoir. La descente précédait l'ascension." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par des chaînes de causes invisibles. Rien n'est isolé. Tout est connecté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah dans l'épreuve verra plus tard le sens caché de ce qu'il traverse." }
  ],
  munajat: `Ya Khaliq, Tu vois ce que je ne vois pas. Fais que je fasse confiance à Ton plan même quand je ne comprends pas. Ouvre mes yeux au bien caché dans le mal apparent.`
};

// ============================================
// SURAH 13 - AR-RA'D (The Thunder) - Key Verses
// ============================================

MIROIR["13:11"] = {
  reference: "13:11",
  theme: ["confiance", "méditation", "sagesse"],
  emotion: "Responsabilité éveillée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Muhit"],
  mirrorVersion: `« Allah ne change pas l'état d'un peuple tant que les gens ne changent pas ce qui est en eux-mêmes. » Ce verset est l'un des plus importants pour comprendre le changement. Le miroir me montre que le changement extérieur dépend du changement intérieur. Si ma situation ne change pas, c'est peut-être parce que je ne change pas moi-même. Le changement commence à l'intérieur — dans les intentions, les croyances, les habitudes.`,
  reflection: `Le changement extérieur suit le changement intérieur. On récolte ce qu'on sème en soi-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma bi-anfusihim » — ce qui est en eux-mêmes. Le changement intérieur précède le changement extérieur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je veux changer dans ma vie ? Et qu'est-ce que je dois d'abord changer en moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Attendre un changement extérieur sans changer intérieurement est une illusion. Le monde reflète l'état du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers réagit à nos états. Le chaos extérieur reflète souvent le chaos intérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand pouvoir de l'homme est de se changer lui-même. Tout le reste en découle." }
  ],
  munajat: `Ya Allah, je veux que ma situation change. Aide-moi à changer ce qui doit changer en moi. Fais que l'extérieur reflète l'intérieur que je veux devenir.`
};

// ============================================
// SURAH 14 - IBRAHIM - Key Verses
// ============================================

MIROIR["14:7"] = {
  reference: "14:7",
  theme: ["gratitude", "espoir", "confiance"],
  emotion: "Reconnaissance féconde",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Karim"],
  mirrorVersion: `« Et quand votre Seigneur a proclamé : Si vous êtes reconnaissants, Je vous augmenterai. » Le miroir me montre la loi de la gratitude. La reconnaissance n'est pas seulement une attitude morale — c'est une force d'attraction. La gratitude attire plus de dons. L'ingratitude ferme la porte. Ce qui est remercié se multiplie. Ce qui est ignoré se retire.`,
  reflection: `La gratitude est une loi cosmique. Elle attire l'abondance. L'ingratitude repousse les bénédictions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La'in shakartum la-azidannakum » — si vous êtes reconnaissants, Je vous augmenterai. Une promesse divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de choses dans ma vie je remercie ? Et combien je prends pour acquises ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude n'est pas une obligation envers Dieu — c'est une clé pour recevoir plus. Je remercie pour moi, pas pour Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond à l'état du cœur. Un cœur reconnaissant attire l'abondance. Un cœur fermé repousse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour tout — même l'épreuve — voit tout se transformer en bénédiction." }
  ],
  munajat: `Ya Shakur, Tu récompenses la gratitude. Apprends-moi à Te remercier pour tout. Fais que ma reconnaissance attire Tes bénédictions.`
};

// ============================================
// SURAH 15 - AL-HIJR - Key Verses
// ============================================

MIROIR["15:28"] = {
  reference: "15:28",
  theme: ["méditation", "sagesse", "détachement"],
  emotion: "Humilité originelle",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Et quand ton Seigneur dit aux anges : Je vais créer un mortel d'argile crissante, issue d'une boue noire modifiée. » Le miroir me ramène à mon origine matérielle. « Argile crissante » — sonnante, résonnante. « Boue noire modifiée » — transformée. Mon corps vient de la terre. Je ne suis pas fait de matière noble, mais de boue. Et pourtant, Allah a insufflé en moi Son esprit. Le contraste est saisissant : origine humble, destination élevée.`,
  reflection: `L'homme est un mélange paradoxal : boue et esprit, origine basse et destinée haute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salsal » — argile crissante. « Hama' » — boue. L'origine matérielle de l'homme est humble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où je viens ? De la terre. Où je vais ? Vers Dieu. Le contraste me garde humble." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mon origine humble ne me rabaisse pas — elle exalte le don de l'esprit. La valeur n'est pas dans la matière, mais dans ce que Dieu y met." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie vient de la matière inerte. La conscience naît de l'inconscient. L'univers entier témoigne de cette élévation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine ne s'enorgueillit pas. Celui qui connaît sa destination ne désespère pas." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de boue et Tu as mis en moi Ton esprit. Garde-moi humble dans mon origine et conscient de ma dignité.`
};

// ============================================
// SURAH 16 - AN-NAHL (The Bee) - Key Verses
// ============================================

MIROIR["16:53"] = {
  reference: "16:53",
  theme: ["gratitude", "confiance", "méditation"],
  emotion: "Reconnaissance totale",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "An-Ni'mah"],
  mirrorVersion: `« Tout ce que vous avez comme bienfait vient d'Allah. Puis quand le malheur vous touche, c'est Lui que vous implorez à haute voix. » Le miroir me montre la source unique de tout bien. « Tout » — sans exception. La santé, la richesse, les relations, les talents — tout vient de Lui. Et quand le malheur frappe, je reviens à Lui. Pourquoi attendre le malheur pour me tourner vers Lui ?`,
  reflection: `Tout bien vient d'Allah. Le reconnaître constamment évite de devoir attendre l'épreuve pour s'en souvenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu ni'matin » — tout bienfait. Le « tout » est absolu, sans exception." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attribue à moi-même ? Mon intelligence ? Mes efforts ? Ma chance ? Tout vient de Lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur me fait crier vers Allah. Pourquoi le bonheur ne me fait-il pas crier de reconnaissance ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un don. L'existence elle-même est un cadeau non mérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le don dans tout voit Allah partout. Le monde devient une cascade de bénédictions." }
  ],
  munajat: `Ya Wahhab, tout ce que j'ai vient de Toi. Ne me laisse pas attribuer Tes dons à moi-même. Fais que chaque bienfait me ramène à Toi.`
};

// ============================================
// SURAH 17 - AL-ISRA (The Night Journey) - Key Verses
// ============================================

MIROIR["17:23"] = {
  reference: "17:23",
  theme: ["méditation", "gratitude", "présence"],
  emotion: "Reconnaissance filiale",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Barr"],
  mirrorVersion: `« Et ton Seigneur a décrété : N'adorez que Lui, et soyez bons envers vos parents. » Le miroir me montre le lien direct entre l'adoration de Dieu et le bien envers les parents. Ces deux commandements sont liés. La piété envers Dieu se manifeste dans la piété envers les parents. « Soyez bons » — ihsan — n'est pas seulement la justice, mais l'excellence, la beauté dans le comportement.`,
  reflection: `La piété envers les parents est l'expression concrète de la piété envers Dieu. On ne peut pas séparer les deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qada » — décrété. Ce n'est pas une suggestion, c'est un décret divin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite mes parents ? Avec ihsan — excellence ? Ou avec le minimum ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "On ne peut pas prétendre aimer Dieu et maltraiter les parents. L'amour divin se manifeste dans l'amour humain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie vient d'une mère et d'un père. Honorer ses origines est reconnaître le don de la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bien fait aux parents est un bien fait à soi-même. La chaîne de la vie se referme dans la gratitude." }
  ],
  munajat: `Ya Rahman, Tu m'as commandé d'être bon envers mes parents. Aide-moi à les honorer comme Tu le veux. Fais que mon amour pour Toi se manifeste dans mon amour pour eux.`
};

// ============================================
// SURAH 18 - AL-KAHF (The Cave) - Key Verses
// ============================================

MIROIR["18:23"] = {
  reference: "18:23",
  theme: ["confiance", "méditation", "détachement"],
  emotion: "Remise totale",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Hakim"],
  mirrorVersion: `« Et ne dis jamais à propos d'une chose : 'Je ferai cela demain', sans ajouter : 'Si Allah le veut'. » Le miroir me montre mon illusion de contrôle. Je planifie, je projette, j'organise — comme si je maîtrisais l'avenir. « Insha'Allah » n'est pas une formule vide — c'est une reconnaissance que l'avenir n'est pas à moi. Je fais mes plans, mais je les remets entre les mains d'Allah.`,
  reflection: `L'avenir appartient à Allah. Dire « insha'Allah » est un acte de foi, pas une superstition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Insha'Allah » — si Allah le veut. Trois mots qui remettent l'avenir à sa place." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de fois je dis « je ferai » sans « insha'Allah » ? Mon ego croit contrôler l'avenir." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Dire « insha'Allah » n'affaiblit pas mes plans — il les bénit. La remise à Allah fortifie, n'affaiblit pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier dépend de la volonté divine. Chaque atome n'existe que par Sa permission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit vraiment « insha'Allah » est libéré de l'anxiété de l'avenir. Il a remis le futur à son Propriétaire." }
  ],
  munajat: `Ya Wakil, je remets mon avenir entre Tes mains. Fais que chaque projet soit accompagné de « insha'Allah » — pas comme une formule, mais comme une véritable remise.`
};

// ============================================
// SURAH 19 - MARYAM - Key Verses
// ============================================

MIROIR["19:4"] = {
  reference: "19:4",
  theme: ["prière", "espoir", "confiance"],
  emotion: "Supplication d'un vieillard",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sami'", "Al-Mujib"],
  mirrorVersion: `« Seigneur, mes os sont affaiblis et ma tête s'est enflammée de cheveux blancs. » Zakariya prie dans sa vieillesse. Le miroir me montre une prière qui vient de la fragilité. Il n'a plus la force de la jeunesse. Mais sa foi est plus forte que jamais. La faiblesse physique devient le terrain de la force spirituelle. Il demande l'impossible — un fils dans sa vieillesse — et Allah l'exauce.`,
  reflection: `La fragilité est le terrain de la grâce. Dieu exauce les prières qui viennent de la fin des forces humaines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Zakariya décrit sa faiblesse avant de faire sa demande. L'aveu de fragilité précède l'exaucement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je fragile ? C'est précisément là que la grâce peut opérer. Ma faiblesse est une opportunité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faiblesse n'empêche pas l'exaucement — elle l'attire. Dieu préfère les prières des cœurs brisés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, la vie jaillit souvent de la mort. La graine meurt pour donner l'arbre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa faiblesse ouvre la porte à la force divine. La puissance s'accomplit dans la faiblesse." }
  ],
  munajat: `Ya Sami', Tu entends les prières des faibles. Je viens à Toi avec ma fragilité. Exauce-moi comme Tu as exaucé Zakariya. Fais jaillir la vie de mes impossibilités.`
};

// ============================================
// SURAH 20 - TA-HA - Key Verses
// ============================================

MIROIR["20:5"] = {
  reference: "20:5",
  theme: ["méditation", "présence", "sagesse"],
  emotion: "Majesté transcendante",
  difficulty: "avancé",
  relatedNames: ["Al-Rahman", "Al-Aliyy"],
  mirrorVersion: `« Le Tout-Miséricordieux S'est établi sur le Trône. » Ce verset est l'un des plus mystérieux du Coran. « Istawa » — S'est établi, S'est élevé. Comment ? Nous ne savons pas. Le miroir me place devant la transcendance d'Allah. Il est au-dessus de tout, pas géographiquement, mais ontologiquement. Son Trône embrasse les cieux et la terre, et Il est au-dessus de tout. Cette image n'est pas à comprendre littéralement — elle est à contempler.`,
  reflection: `La transcendance d'Allah dépasse l'imagination. Le Trône est un symbole de Sa souveraineté absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Istawa 'ala al-'arsh » — S'est établi sur le Trône. Le Trône est le plus grand des objets créés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Puis-je me représenter la grandeur d'Allah ? Ou est-ce que je Le réduis à mes concepts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Son élévation ne signifie pas Sa distance. Celui qui est sur le Trône est aussi plus proche que la veine jugulaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est sous Son Trône. Chaque atome, chaque galaxie, chaque cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Comprendre ce verset n'est pas possible — le vivre est possible. La contemplation remplace l'explication." }
  ],
  munajat: `Ya Rahman 'ala al-'arsh, Tu es au-dessus de tout. Élève mon cœur vers Toi. Fais que je Te contemple même si je ne Te comprends pas.`
};

// ============================================
// SURAH 21 - AL-ANBIYA (The Prophets) - Key Verses
// ============================================

MIROIR["21:107"] = {
  reference: "21:107",
  theme: ["amour", "espoir", "méditation"],
  emotion: "Tendresse universelle",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ar-Rasul"],
  mirrorVersion: `« Et Nous ne t'avons envoyé que comme miséricorde pour les mondes. » Ce verset définit la mission du Prophète. Il n'est pas venu pour juger, punir, ou détruire. Il est venu comme miséricorde. « Pour les mondes » — pas seulement pour les humains, mais pour toute la création. Le miroir me montre que l'islam est une religion de miséricorde. Chaque enseignement du Prophète est une expression de cette miséricorde universelle.`,
  reflection: `Le Prophète est la miséricorde incarnée. Le suivre, c'est entrer dans cette miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rahmatan lil-'alamin » — une miséricorde pour les mondes. La mission est universelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis une miséricorde pour les autres ? Ou est-ce que je suis une source de durété ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde du Prophète n'est pas une faiblesse — c'est une force. La vraie force se manifeste dans la douceur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création bénéficie de cette miséricorde. Les animaux, les plantes, les minéraux — tout est concerné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète devient lui-même une miséricorde pour les mondes. La miséricorde se transmet." }
  ],
  munajat: `Ya Allah, Tu as envoyé Ton Prophète comme miséricorde. Fais que je sois une miséricorde pour les autres. Fais que mon existence soit un bien pour tout ce qui m'entoure.`
};

// ============================================
// SURAH 22 - AL-HAJJ (The Pilgrimage) - Key Verses
// ============================================

MIROIR["22:46"] = {
  reference: "22:46",
  theme: ["méditation", "sagesse", "guérison"],
  emotion: "Éveil du cœur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Hadi"],
  mirrorVersion: `« N'ont-ils pas voyagé sur la terre, pour avoir des cœurs avec lesquels ils comprennent et des oreilles avec lesquelles ils entendent ? Ce ne sont pas les yeux qui s'aveuglent, mais les cœurs dans les poitrines. » Le miroir me montre que la vraie cécité n'est pas physique. On peut avoir des yeux qui voient et un cœur aveugle. Le voyage sur la terre n'est pas touristique — il est spirituel. Voir les ruines des civilisations passées devrait éveiller le cœur.`,
  reflection: `La vraie vue est celle du cœur. Les yeux peuvent voir sans que le cœur ne comprenne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulubun ya'qiluna » — des cœurs qui comprennent. Le cœur est l'organe de l'intelligence spirituelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il voyant ou aveugle ? Qu'est-ce que je vois sans vraiment comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voyage n'est pas nécessairement spatial — chaque expérience de vie est un voyage qui peut éveiller." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de l'humanité est remplie de leçons. Les ruines parlent à ceux qui savent écouter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est ouvert n'a pas besoin de voyager loin pour voir. Chaque instant est une révélation." }
  ],
  munajat: `Ya Basir, ouvre les yeux de mon cœur. Ne me laisse pas voir sans comprendre, entendre sans écouter. Fais que chaque expérience de ma vie soit un enseignement.`
};

// ============================================
// SURAH 23 - AL-MU'MINUN (The Believers) - Key Verses
// ============================================

MIROIR["23:15"] = {
  reference: "23:15",
  theme: ["méditation", "sagesse", "détachement"],
  emotion: "Réalisme sacré",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Puis, après cela, vous mourrez. » Ce verset est d'une simplicité glaçante. Pas de développements, pas d'adoucissements. Vous mourrez. Le miroir me place devant cette vérité nue. Je peux l'oublier, la nier, la repousser — elle reste vraie. La mort est la compagne silencieuse de chaque instant. La sagesse n'est pas de craindre la mort, mais de vivre en sachant qu'elle vient.`,
  reflection: `La mort est certaine. Vivre avec cette conscience transforme chaque instant en opportunité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma innakum ba'da dhalika la-mayyitun » — puis vous mourrez. Une affirmation directe, sans détour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je ferais différemment si je savais que je meurs bientôt ? Pourquoi ne pas le faire maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin de la vie — elle en est le cadre. Elle donne son urgence et sa valeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers passe. Les étoiles, les galaxies, les civilisations. Seul Dieu demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a fait la paix avec sa mort a conquis la vie. Il ne vit plus dans la peur, mais dans l'urgence sacrée." }
  ],
  munajat: `Ya Allah, je vais mourir. Aide-moi à ne pas l'oublier. Fais que chaque jour soit vécu comme s'il était le dernier. Ne me laisse pas m'endormir dans l'illusion de l'éternité.`
};

// ============================================
// SURAH 24 - AN-NUR (The Light) - Key Verses
// ============================================

MIROIR["24:21"] = {
  reference: "24:21",
  theme: ["guérison", "confiance", "méditation"],
  emotion: "Protection implorée",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Ô vous qui croyez ! Ne suivez pas les traces de Satan. Et quiconque suit les traces de Satan... celui-là ordonne la turpitude et le blâmable. » Le miroir me montre que le mal a une entrée : les traces de Satan. Suivre, c'est entrer dans son sillage. Le mal ne commence pas par un acte énorme — il commence par un petit pas dans la mauvaise direction. La protection est de ne pas poser ce premier pas.`,
  reflection: `Le mal commence par un petit pas. La protection est de ne pas commencer le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khutuwat ash-shaytan » — les traces de Satan. Les pas dans son sillage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles traces suis-je en train de suivre ? Les pas de qui est-ce que j'imite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre les traces du Prophète est l'opposé de suivre celles de Satan. Chaque pas a une direction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout chemin a des traces. La vie laisse des empreintes. Choisir quelles traces suivre, c'est choisir sa destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne suit pas les traces de Satan n'a pas à craindre leur destination. Le refus du premier pas protège de tout le reste." }
  ],
  munajat: `Ya Wali, protège-moi des traces de Satan. Ne me laisse pas faire le premier pas dans la mauvaise direction. Guide mes pas sur Ton chemin.`
};

// ============================================
// SURAH 25 - AL-FURQAN (The Criterion) - Key Verses
// ============================================

MIROIR["25:63"] = {
  reference: "25:63",
  theme: ["méditation", "force", "confiance"],
  emotion: "Dignité paisible",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Hakim"],
  mirrorVersion: `« Les serviteurs du Tout-Miséricordieux sont ceux qui marchent humblement sur terre et qui, quand les ignorants s'adressent à eux, disent : 'Paix'. » Le miroir me montre le comportement du véritable serviteur d'Allah. Deux traits : l'humilité dans la démarche et la paix dans la réponse à l'ignorance. On n'a pas besoin de prouver, de riposter, de s'abaisser au niveau de l'ignorant. « Paix » — un mot qui ferme la porte à la dispute et ouvre celle à la dignité.`,
  reflection: `La vraie force se manifeste dans la douceur. Répondre à l'ignorance par la paix est un acte de puissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yamshtuna 'ala al-ard hawnan » — ils marchent sur terre humblement. La démarche révèle l'état du cœur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réponds quand on m'agresse verbalement ? Est-ce que je m'abaisse au niveau de l'agresseur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Salam » n'est pas une soumission — c'est une supériorité. On refuse de jouer le jeu de l'ignorant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne répond pas à l'agression. L'arbre continue de donner des fruits même si on le lapide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a vraiment intégré ce verset ne se laisse plus entraîner dans les bassesses. Il reste au-dessus." }
  ],
  munajat: `Ya Rahman, fais de moi Ton véritable serviteur. Apprends-moi à marcher humblement et à répondre par la paix. Ne me laisse pas m'abaisser au niveau de l'ignorance.`
};

// ============================================
// SURAH 26 - ASH-SHU'ARA (The Poets) - Key Verses
// ============================================

MIROIR["26:78"] = {
  reference: "26:78",
  theme: ["confiance", "méditation", "amour"],
  emotion: "Confiance d'Ibrahim",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hadi"],
  mirrorVersion: `« Celui qui m'a créé et me guide, qui me nourrit et me donne à boire, et quand je suis malade, me guérit. » Ibrahim décrit son Seigneur par ce qu'Il fait pour lui. Le miroir me montre une relation personnelle et concrète. Pas de théologie abstraite, mais une expérience vécue : création, guidance, nourriture, guérison. Chaque verbe décrit une intervention divine dans sa vie. C'est ainsi qu'on connaît Allah — par Son action dans notre vie.`,
  reflection: `Connaître Allah, c'est expérimenter Son action. La théorie ne suffit pas — il faut la rencontre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Cinq verbes : créer, guider, nourrir, abreuver, guérir. L'action divine est constante et multiforme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je connais Allah ? Par des concepts ou par Son action dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ibrahim dit « quand je suis malade, Il me guérit » — la maladie aussi est sous Sa maîtrise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création dépend de ces dons : existence, direction, nourriture, eau, santé. Nul n'est autonome." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ces dons dans chaque instant entre dans une reconnaissance continue. Sa vie devient prière." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé, guidé, nourri, abreuvé, guéri. Fais que je reconnaisse Ta main dans chaque aspect de ma vie. Que chaque reconnaissance me rapproche de Toi.`
};

// ============================================
// SURAH 27 - AN-NAML (The Ant) - Key Verses
// ============================================

MIROIR["27:19"] = {
  reference: "27:19",
  theme: ["gratitude", "méditation", "sagesse"],
  emotion: "Reconnaissance inspirée",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shakur", "Al-Hakim"],
  mirrorVersion: `« Il sourit, amusé par ses paroles, et il dit : Seigneur, inspire-moi de rendre grâce pour le bienfait dont Tu m'as comblé. » Sulayman entend la fourmi et son cœur s'émeut. Le miroir me montre que la gratitude n'est pas automatique — elle doit être inspirée. « Inspire-moi » — le don de la gratitude est lui-même un don à demander. Sulayman, avec toute sa sagesse, demande à savoir remercier.`,
  reflection: `La gratitude est un don à demander. On ne remercie pas automatiquement — on doit apprendre à le faire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ilham » — inspiration. La gratitude vraie vient de l'inspiration divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande à Allah de m'inspirer la gratitude ? Ou est-ce que je crois la posséder déjà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sulayman a tout, mais il demande à savoir remercier. La gratitude est plus précieuse que les dons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fourmi a parlé et Sulayman a remercié. Chaque créature peut enseigner à l'homme la reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait remercier possède le secret du bonheur. La gratitude transforme tout en cadeau." }
  ],
  munajat: `Ya Shakur, inspire-moi la gratitude. Je ne sais pas remercier comme il faut. Apprends-moi à voir Tes dons et à Te rendre grâce dignement.`
};

// ============================================
// SURAH 28 - AL-QASAS (The Stories) - Key Verses
// ============================================

MIROIR["28:77"] = {
  reference: "28:77",
  theme: ["méditation", "détachement", "sagesse"],
  emotion: "Équilibre spirituel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhsin", "Al-Akhirah"],
  mirrorVersion: `« Recherche ce qu'Allah t'a donné comme demeure dernière, et n'oublie pas ta part d'ici-bas. » Le miroir me montre l'équilibre islamique. Ni rejet du monde ni attachement à lui. « Ta part d'ici-bas » — il y a une part légitime. Le bien matériel n'est pas mauvais en soi. Mais il doit être recherché en vue de l'au-delà. L'ici-bas est un moyen, pas une fin.`,
  reflection: `L'islam n'est pas un rejet du monde, mais une orientation juste de tout, y compris des biens matériels.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nasibika min al-dunya » — ta part d'ici-bas. Une part légitime, pas un rejet total." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma part d'ici-bas ? Est-ce que je la prends en vue de l'au-delà ou comme une fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'au-delà ne commence pas après la mort — il commence par l'intention avec laquelle je vis ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers son Créateur. Chaque chose retourne à sa source. L'homme doit le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend sa part d'ici-bas pour l'au-delà transforme le monde en pont vers Dieu." }
  ],
  munajat: `Ya Allah, fais que je recherche l'au-delà sans négliger ma part d'ici-bas. Enseigne-moi à utiliser ce monde comme un moyen, pas comme une fin.`
};

// ==================== SURAH 86-114 CONTINUATION ====================
// Task ID: 2-d - Additional miroir entries

// ========== SURAH 86 - AT-TARIQ (Additional entries) ==========
MIROIR["86:1"] = {
  reference: "86:1",
  theme: ["méditation", "présence", "sagesse"],
  emotion: "Émerveillement, vigilance",
  difficulty: "débutant",
  relatedNames: ["As-Sami", "Al-Basir"],
  mirrorVersion: `« Par le ciel et par l'astre nocturne ! » Le miroir lève les yeux vers le « tariq » — l'astre nocturne, l'étoile qui perce les ténèbres. Dans la nuit du monde, il y a toujours une lumière qui veille. Le miroir m'interroge : dans mes nuits intérieures, quelle étoile me guide ?`,
  reflection: `L'étoile nocturne (tariq) est celle qui « frappe » l'obscurité. Sa lumière ne s'éteint jamais.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le tariq — ce qui vient la nuit, l'étoile perçante, le visiteur nocturne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui « frappe » ma conscience dans mes nuits ? Quelle étoile m'éclaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étoile nocturne ne brille que dans les ténèbres. Sans nuit, pas de révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein d'étoiles. Chacune est un témoin silencieux de la grandeur divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son tariq intérieur n'a plus peur de la nuit." }
  ],
  munajat: `Ya Rabb, envoie-moi mon tariq. Fais qu'une étoile brille dans mes ténèbres. Ne me laisse pas seul dans la nuit.`
};

MIROIR["86:2"] = {
  reference: "86:2",
  theme: ["méditation", "sagesse", "connaissance"],
  emotion: "Questionnement, curiosité",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Khabir"],
  mirrorVersion: `« Et qu'est-ce qui t'apprendra ce qu'est l'astre nocturne ? » Le miroir me pose la question rhétorique par excellence. « Ma adraka » — qu'est-ce qui t'apprendra ? La connaissance du mystère dépasse ma capacité. Le miroir m'invite à l'humilité : je ne peux pas tout comprendre.`,
  reflection: `Certaines réalités ne s'apprennent pas — elles se révèlent. L'humilité ouvre la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma adraka » — qu'est-ce qui t'apprendra ? Question rhétorique de l'indicible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cherche à comprendre par l'intellect qui demande le cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question n'appelle pas une réponse — elle appelle une expérience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un mystère. Le comprendre demande plus que l'intelligence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte de ne pas tout comprendre comprend l'essentiel." }
  ],
  munajat: `Ya Alim, il y a tant que je ne comprends pas. Apprends-moi à accepter le mystère. Ouvre mon cœur à ce que mon intellect ne peut atteindre.`
};

MIROIR["86:3"] = {
  reference: "86:3",
  theme: ["méditation", "lumière", "force"],
  emotion: "Espérance, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "As-Siraj"],
  mirrorVersion: `« L'astre perçant de clarté ! » Le miroir révèle la nature du tariq : « najm ath-thaqib » — l'étoile perçante, brillante. Elle perce les ténèbres. Sa lumière est intense. Le miroir m'interroge : ma foi est-elle perçante ou tamisée ?`,
  reflection: `La vraie lumière ne se contente pas d'éclairer — elle perce. Elle transforme ce qu'elle touche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Najm ath-thaqib — l'étoile qui perce, la lumière intense qui transperce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma lumière intérieure est-elle perçante ou diffuse ? Atteint-elle les coins sombres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui perce les ténèbres peut aussi blesser. La vérité n'est pas toujours douce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les étoiles les plus brillantes percent les nuits les plus sombres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui porte une lumière perçante ne craint plus les ténèbres — ni en lui, ni autour de lui." }
  ],
  munajat: `Ya Nur, fais de moi une étoile perçante. Que ma lumière transperce les ténèbres, en moi et autour de moi. Ne me laisse pas être une lumière tamisée.`
};

// ========== SURAH 87 - AL-A'LA (Additional entries) ==========
MIROIR["87:1"] = {
  reference: "87:1",
  theme: ["méditation", "louange", "présence"],
  emotion: "Exaltation, glorification",
  difficulty: "débutant",
  relatedNames: ["Al-A'la", "Al-Muta'ali"],
  mirrorVersion: `« Glorifie le nom de ton Seigneur, le Très-Haut. » Le miroir m'invite à l'élévation. « Sabbih » — glorifie, élève, purifie. Le nom d'Allah est « al-A'la » — le Très-Haut. Le miroir m'interroge : ma vie est-elle orientée vers le haut ou vers le bas ?`,
  reflection: `La glorification n'est pas seulement verbale — elle est une orientation constante vers le Très-Haut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Sabbih isma rabbika al-a'la — Glorifie le nom de ton Seigneur, le Très-Haut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je glorifie dans ma vie ? Mon Seigneur ou mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "En glorifiant le Très-Haut, je m'élève aussi. La louange est une ascension." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier glorifie Allah. Les cieux, la terre, tout célèbre Sa grandeur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie vraiment le Très-Haut s'identifie à Lui. Il devient « a'la » par participation." }
  ],
  munajat: `Ya A'la, Tu es le Très-Haut. Élève-moi vers Toi par ma glorification. Ne me laisse pas collé au bas.`
};

MIROIR["87:2"] = {
  reference: "87:2",
  theme: ["création", "ordre", "sagesse"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Qui a créé et agencé. » Le miroir me montre la précision divine. « Khalaqa » — créé. « Fa sawwa » — et agencé, harmonisé, équilibré. La création n'est pas chaos — elle est ordre, beauté, mesure. Le miroir m'interroge : ma vie est-elle agencée ou chaotique ?`,
  reflection: `La création divine est parfaitement ordonnée. Le désordre vient de l'homme, pas du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Khalaqa (créa) fa sawwa (et agença). Deux verbes divins : créer et ordonner." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vie est-elle créée ET agencée ? Ou suis-je dans le chaos ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'agencement suit la création. D'abord exister, puis s'organiser." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un chef-d'œuvre d'agencement. Chaque partie a sa place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse Allah agencer sa vie découvre l'harmonie parfaite." }
  ],
  munajat: `Ya Musawwir, Tu as créé et agencé. Agence aussi ma vie selon Ton ordre. Ne me laisse pas dans le chaos.`
};

MIROIR["87:3"] = {
  reference: "87:3",
  theme: ["guidance", "création", "chemin"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Qadir"],
  mirrorVersion: `« Qui a déterminé et guidé. » Le miroir montre la providence divine. « Qaddara » — déterminé, décrété. « Fa hada » — et guidé. La création n'est pas abandonnée — elle est guidée. Le miroir me rassure : je ne suis pas perdu dans l'univers.`,
  reflection: `La création inclut la guidance. Chaque créature reçoit sa direction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Qaddara (détermina) fa hada (et guida). Le décret et la direction." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je accepté ce qui est déterminé ? Suis-je ouvert à la guidance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La détermination sans guidance serait cruelle. Les deux vont ensemble." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers est déterminée ET guidée. Rien n'est laissé au hasard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le décret découvre la guidance cachée dedans." }
  ],
  munajat: `Ya Hadi, Tu as déterminé mon chemin. Guide-moi sur cette route. Ne me laisse pas errer hors de Ta direction.`
};

// ========== SURAH 93 - AD-DUHA (Additional entries) ==========
MIROIR["93:1"] = {
  reference: "93:1",
  theme: ["espoir", "lumière", "présence"],
  emotion: "Réconfort, espérance",
  difficulty: "débutant",
  relatedNames: ["Ad-Duha", "An-Nur"],
  mirrorVersion: `« Par le matin ! » Le miroir me tourne vers « ad-duha » — le matin, l'aube, la première lumière. C'est le moment où les ténèbres cèdent, où l'espoir renaît. Le miroir me rassure : après chaque nuit vient le matin.`,
  reflection: `Le matin est la promesse tenue. La nuit n'est jamais définitive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ad-duha — le matin, la lumière croissante, le moment de clarté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon matin ? Quelle nuit attend son aube ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le matin vient toujours. La question n'est pas « si » mais « quand »." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque jour, l'univers renouvelle la promesse du matin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend le matin avec confiance le voit toujours arriver." }
  ],
  munajat: `Ya Rabb, fais lever mon matin. Ne me laisse pas dans la nuit éternelle. Je T'attends, ô Aube de mon cœur.`
};

MIROIR["93:2"] = {
  reference: "93:2",
  theme: ["présence", "confiance", "paix"],
  emotion: "Sérénité, certitude",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mu'min"],
  mirrorVersion: `« Et par la nuit quand elle s'apaise ! » Le miroir me montre « as-saja » — la nuit qui se calme, se repose. La nuit n'est pas que ténèbres — elle est aussi repos. Le miroir m'invite à trouver la paix dans mes nuits.`,
  reflection: `La nuit apaisée est un don. Le repos fait partie de la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Al-layli idha saja — la nuit quand elle se calme, se repose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes nuits sont-elles apaisées ? Ou agitées par le souci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit qui s'apaise prépare le matin. Le repos précède le renouveau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers alterne activité et repos. Le rythme est naturel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'apaise dans la nuit s'éveille fort le matin." }
  ],
  munajat: `Ya Salam, apaise mes nuits. Ne me laisse pas dans l'agitation éternelle. Donne-moi le repos qui prépare le jour.`
};

// ========== SURAH 94 - ASH-SHARH (Additional entries) ==========
MIROIR["94:1"] = {
  reference: "94:1",
  theme: ["espoir", "guérison", "expansion"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Basit"],
  mirrorVersion: `« N'avons-Nous pas ouvert pour toi ta poitrine ? » Le miroir me rappelle l'« inshirah » — l'ouverture, l'expansion de la poitrine. Allah a ouvert le cœur du Prophète et lui a donné de l'espace. Le miroir m'interroge : mon cœur est-il ouvert ou refermé sur lui-même ?`,
  reflection: `L'ouverture de la poitrine est l'expansion spirituelle. Un cœur étroit ne peut pas accueillir la lumière.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Alam nashrah laka sadrak — N'avons-Nous pas ouvert ta poitrine ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il ouvert ? Ai-je de l'espace pour respirer spirituellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture vient d'Allah. Je ne peux pas m'ouvrir moi-même — je peux seulement demander." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est expansion. Le cœur qui s'ouvre s'aligne sur le mouvement cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont la poitrine est ouverte n'a plus peur. L'espace intérieur suffit pour tout." }
  ],
  munajat: `Ya Fattah, ouvre ma poitrine. Donne-moi de l'espace. Ne me laisse pas étouffer dans le resserrement.`
};

MIROIR["94:2"] = {
  reference: "94:2",
  theme: ["guérison", "allègement", "miséricorde"],
  emotion: "Soulagement, légèreté",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Hafiz"],
  mirrorVersion: `« Et déchargé de ton fardeau. » Le miroir me montre le « wizr » — le fardeau, le poids. Allah l'a ôté. Le Prophète portait un lourd fardeau de révélation et de responsabilité — Allah l'a allégé. Le miroir m'interroge : qu'est-ce qui m'écrase ?`,
  reflection: `Le fardeau enlevé n'est pas oublié — il est déposé. On peut demander à Allah de porter ce qu'on ne peut pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Wada'na 'anka wizrak — Et Nous avons déposé de toi ton fardeau." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel fardeau je porte ? Est-ce que je le dépose ou est-ce que je le garde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le fardeau déposé devient offrande. Ce qui m'écrase peut nourrir ma confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne porte rien en vain. Ce qui pèse trop est déposé naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dépose son fardeau découvre qu'il n'était pas nécessaire de le porter." }
  ],
  munajat: `Ya Rabb, dépose mon fardeau. Je n'en peux plus. Prends ce qui m'écrase — Tu es le Meilleur Porteur.`
};

MIROIR["94:3"] = {
  reference: "94:3",
  theme: ["guérison", "reconnaissance", "allègement"],
  emotion: "Gratitude, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Qui pesait sur ton dos. » Le miroir précise : « anqada » — qui pesait, qui accablait le dos. Le dos porte le fardeau. Allah l'a allégé. Le miroir me rappelle que mes fardeaux peuvent être soulagés.`,
  reflection: `Le dos qui ploie peut être redressé. Allah est Celui qui allège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Allazi anqada zahrak — qui accablait ton dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui pèse sur mon dos ? Ma conscience ? Mes responsabilités ? Mes erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le dos qui porte trop se courbe. Mais ce qui se courbe peut se redresser." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création porte naturellement ce qu'elle peut. Le surpoids vient de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse Allah porter son dos marche droit — même sous la pression." }
  ],
  munajat: `Ya Rabb, mon dos ploie. Redresse-moi. Porte ce qui m'accable. Fais que je marche droit malgré tout.`
};

MIROIR["94:4"] = {
  reference: "94:4",
  theme: ["honneur", "dignité", "élévation"],
  emotion: "Gratitude, fierté spirituelle",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'izz", "Al-Majid"],
  mirrorVersion: `« Et élevé pour toi ton renom. » Le miroir me montre « rafa'a » — élevé. Le renom, la réputation, la mention du Prophète sont élevés. Le miroir m'enseigne : l'humilité vraie mène à l'élévation.`,
  reflection: `Allah élève celui qu'Il aime. La vraie grandeur vient de Lui, pas de la promotion personnelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Wa rafa'na laka dhikrak — Et Nous avons élevé ta mention, ton renom." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon « renom » ? Qu'est-ce que les gens disent de moi ? Qu'est-ce qu'Allah en dit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation du renom n'est pas la gloire personnelle — c'est la reconnaissance de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers élève naturellement ce qui est juste. La vérité monte d'elle-même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne cherche pas le renom le reçoit. L'humilité est l'ascenseur divin." }
  ],
  munajat: `Ya Mu'izz, élève mon renom — pas pour ma gloire, mais pour que la vérité soit connue. Fais que je sois mentionné en bien.`
};

// ========== SURAH 108 - AL-KAWTHAR (Additional entries) ==========
MIROIR["108:2"] = {
  reference: "108:2",
  theme: ["prière", "sacrifice", "dévotion"],
  emotion: "Dévotion, offrande",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Karim"],
  mirrorVersion: `« Accomplis la prière pour ton Seigneur et sacrifie. » Le miroir m'appelle à l'action : « salli » — prie. « Wanhar » — sacrifie. La prière et le sacrifice vont ensemble. Le miroir m'interroge : ma prière est-elle suivie de sacrifice ?`,
  reflection: `La prière sans offrande est incomplète. Le sacrifice suit naturellement la prière vraie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Fasalli li-rabbika wanhar — Prie pour ton Seigneur et sacrifie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma prière est-elle accompagnée de sacrifice ? Qu'est-ce que j'offre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice n'est pas perte — c'est investissement. Ce qu'on offre revient multiplié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par échange. Donner et recevoir sont liés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie vraiment sacrifie automatiquement. La prière vraie coûte." }
  ],
  munajat: `Ya Rabb, je prie et je sacrifie. Accepte mon offrande. Fais que ma prière ne soit pas vaine.`
};

MIROIR["108:3"] = {
  reference: "108:3",
  theme: ["justice", "protection", "confiance"],
  emotion: "Réconfort, assurance",
  difficulty: "débutant",
  relatedNames: ["Al-Qati", "Al-Muntaqim"],
  mirrorVersion: `« C'est bien celui qui te déteste qui sera sans postérité. » Le miroir tranche : « abtar » — sans postérité, coupé, stérile. Celui qui déteste le Prophète est retranché. Le miroir me rassure : les ennemis de la vérité n'ont pas d'avenir.`,
  reflection: `L'opposition à la vérité est stérile. Seule la vérité porte des fruits durables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Inna shani'aka huwa al-abtar — C'est ton détesteur qui est sans postérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui déteste la vérité en moi ? Quels ennemis de ma foi sont stériles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stérilité n'est pas toujours visible maintenant. Le temps révèle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers favorise ce qui est vrai. Le faux finit par s'éteindre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est du côté de la vérité n'a pas à craindre les détesteurs." }
  ],
  munajat: `Ya Rabb, mes ennemis sont nombreux. Mais Tu dis qu'ils sont stériles. Confirme Ta parole. Fais que la vérité triomphe.`
};

// ========== SURAH 112 - AL-IKHLAS (Additional entries) ==========
MIROIR["112:2"] = {
  reference: "112:2",
  theme: ["unicité", "absolu", "méditation"],
  emotion: "Silence, plénitude",
  difficulty: "intermédiaire",
  relatedNames: ["As-Samad", "Al-Qayyum"],
  mirrorVersion: `« Allah, le Absolu. » Le miroir me place devant « as-Samad » — l'Absolu, Celui sur qui tout dépend, qui ne dépend de rien. C'est le nom qui synthétise l'indépendance divine. Le miroir m'interroge : sur qui ou quoi je dépend ?`,
  reflection: `As-Samad est Celui qui se suffit à Lui-même. Tout le reste dépend de Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Allahu as-samad — Allah le Absolu, l'Indépendant, le Refuge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce dont je dépends ? Mon indépendance est-elle illusoire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "En dépendant de as-Samad, je deviens libre de tout le reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers dépend de Allah. Lui seul est indépendant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît as-Samad trouve en Lui son refuge absolu." }
  ],
  munajat: `Ya Samad, Tu es l'Absolu. Je dépends de Toi. Fais que je me réfugie en Toi seul. Sois mon indépendance.`
};

MIROIR["112:3"] = {
  reference: "112:3",
  theme: ["unicité", "transcendance", "pureté"],
  emotion: "Purification, élévation",
  difficulty: "débutant",
  relatedNames: ["Al-Ahad", "Al-Witr"],
  mirrorVersion: `« Il n'a pas engendré. » Le miroir affirme la transcendance : « lam yalid » — Il n'a pas engendré. Allah n'a pas de fils, pas de descendance. Il est au-delà de la génération. Le miroir purifie ma conception de Dieu.`,
  reflection: `Dieu n'est pas soumis aux lois de la reproduction. Il est le Créateur, pas le procréateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Lam yalid — Il n'a pas engendré. Pas de descendance divine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma conception de Dieu ? Est-elle pure de toute anthropomorphie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas engendrer n'est pas carence — c'est transcendance. Allah est au-dessus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La génération est une loi des créatures. Le Créateur est au-dessus de Ses lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que Dieu n'engendre pas comprend aussi qu'Il n'a pas besoin de compagnie." }
  ],
  munajat: `Ya Rabb, Tu n'as pas engendré. Tu es au-dessus de tout. Purifie ma conception de Toi. Ne me laisse pas Te réduire à mes catégories.`
};

MIROIR["112:4"] = {
  reference: "112:4",
  theme: ["unicité", "incomparabilité", "absolu"],
  emotion: "Adoration, silence",
  difficulty: "débutant",
  relatedNames: ["Al-Ahad", "Al-Khaliq"],
  mirrorVersion: `« Et Il n'a pas été engendré. » Le miroir complète : « wa lam yulad » — et Il n'a pas été engendré. Allah n'a pas de père, pas d'origine. Il est l'Origine sans origine. Le miroir m'invite à adorer Celui qui n'a pas de commencement.`,
  reflection: `Dieu n'a pas été créé. Il est le Premier sans précédent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Wa lam yulad — Et Il n'a pas été engendré. Pas de parents divins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui a précédé Dieu ? Rien. Puis-je adorer sans comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas avoir été engendré signifie : éternel. Le Premier est aussi le Dernier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a un début. Son Créateur n'en a pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore le Sans-Commencement touche à l'éternité." }
  ],
  munajat: `Ya Awwal, Tu es le Premier sans commencement. Je T'adore. Fais que je Te connaisse comme Tu es, pas comme je T'imagine.`
};

// ========== SURAH 114 - AN-NAS (Additional entries) ==========
MIROIR["114:2"] = {
  reference: "114:2",
  theme: ["protection", "royauté", "confiance"],
  emotion: "Réfuge, sécurité",
  difficulty: "débutant",
  relatedNames: ["Malik", "An-Nas"],
  mirrorVersion: `« Le Roi des humains. » Le miroir me présente « Malik an-nas » — le Roi des humains. Pas le roi d'un territoire, mais le Roi des âmes. Tous les hommes Lui appartiennent. Le miroir m'invite à me réfugier auprès du Vrai Roi.`,
  reflection: `Le Roi des humains possède les cœurs, pas les terres. Sa souveraineté est intérieure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Malik an-nas — Le Roi des humains, Celui qui possède tous les hommes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quel roi je soumets ? Lequel possède vraiment mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Roi des humains est aussi leur Père. Sa royauté est bienveillante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains sont sujets du Roi. Il n'y a pas d'exception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie chez le Roi des humains est protégé de tous les autres rois." }
  ],
  munajat: `Ya Malik an-nas, Tu es mon Roi. Je me réfugie en Toi. Protège-moi de tous les pouvoirs humains.`
};

MIROIR["114:3"] = {
  reference: "114:3",
  theme: ["protection", "divinité", "adoration"],
  emotion: "Soumission, refuge",
  difficulty: "débutant",
  relatedNames: ["Ilah", "An-Nas"],
  mirrorVersion: `« Le Dieu des humains. » Le miroir ajoute « Ilah an-nas » — le Dieu des humains. Pas seulement le Dieu des cieux, mais le Dieu des hommes. Proche, accessible, adorer. Le miroir m'invite à me réfugier auprès de mon Dieu.`,
  reflection: `Le Dieu des humains est Celui qui se laisse adorer par eux. Il est proche de Sa création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Ilah an-nas — Le Dieu des humains, l'objet de leur adoration." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon dieu ? Celui que j'adore vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Dieu des humains est aussi leur Refuge. Il peut protéger ce qu'Il peut adorer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être humain cherche un dieu. Le vrai Dieu se révèle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le Dieu des humains ne cherche plus d'autre divinité." }
  ],
  munajat: `Ya Ilah an-nas, Tu es mon Dieu. Je T'adore et je me réfugie en Toi. Sois ma divinité unique.`
};

MIROIR["114:4"] = {
  reference: "114:4",
  theme: ["protection", "mal", "guérison"],
  emotion: "Refuge, guérison",
  difficulty: "débutant",
  relatedNames: ["Al-Khannas", "An-Nas"],
  mirrorVersion: `« Du mal du tentateur qui se dérobe. » Le miroir identifie l'ennemi : « al-waswas al-khannas » — le tentateur qui souffle le doute et se dérobe. C'est le mal insidieux, le murmure intérieur. Le miroir m'avertit : l'ennemi est intérieur.`,
  reflection: `Le tentateur se cache dans les recoins du cœur. Il souffle et disparaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Min sharr al-waswas al-khannas — Du mal du tentateur fuyant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels murmures m'agitent ? Quelles tentations se cachent en moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tentateur fuit quand on le nomme. La lumière le chasse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ombre existe mais recule devant la lumière. Le mal n'est pas éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son tentateur peut le mettre en fuite." }
  ],
  munajat: `Ya Rabb, protège-moi du tentateur. Chasse ses murmures. Illumine les coins où il se cache.`
};

MIROIR["114:5"] = {
  reference: "114:5",
  theme: ["protection", "intériorité", "conscience"],
  emotion: "Vigilance, purification",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sadr", "Al-Qalb"],
  mirrorVersion: `« Qui souffle dans les poitrines des humains. » Le miroir localise : « fi sudur an-nas » — dans les poitrines des humains. Le mal vient de l'intérieur. Le tentateur s'insinue dans le cœur. Le miroir m'appelle à la vigilance intérieure.`,
  reflection: `La poitrine est le siège du cœur. C'est là que le mal s'insinue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Allazi yuwaswisu fi sudur an-nas — Qui souffle dans les poitrines des hommes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel souffle traverse ma poitrine ? Est-ce le souffle de vérité ou de tentation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poitrine peut être purifiée. Le souffle mauvais peut être chassé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque humain est tenté. C'est la condition commune." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui surveille sa poitrine devient conscient de chaque souffle." }
  ],
  munajat: `Ya Rabb, surveille ma poitrine. Chasse les mauvais souffles. Purifie l'espace de mon cœur.`
};

MIROIR["114:6"] = {
  reference: "114:6",
  theme: ["protection", "universel", "refuge"],
  emotion: "Confiance totale, abandon",
  difficulty: "débutant",
  relatedNames: ["Al-Jinn", "Al-Ins"],
  mirrorVersion: `« Des djinns et des humains. » Le miroir élargit : « mina al-jinnati wa an-nas » — des djinns et des humains. Le mal peut venir des êtres visibles et invisibles. Le miroir m'invite à une protection complète.`,
  reflection: `Les ennemis sont de deux sortes : visibles et invisibles. Allah protège des deux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Mina al-jinnati wa an-nas — Des djinns et des humains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quels ennemis je crains ? Les visibles ? Les invisibles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les djinns et les humains sont tous créatures. Allah est au-dessus des deux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers visible et invisible est sous la protection d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réfugie en Allah n'a peur ni des visibles ni des invisibles." }
  ],
  munajat: `Ya Rabb, je me réfugie en Toi contre tous les maux — des djinns et des humains. Sois ma protection totale.`
};

// ============================================
// SURAHS 37-56 - ADDITIONAL MIROIR ENTRIES
// ============================================

// Surah 37 - As-Saffat (The Rangers)
MIROIR["37:1"] = {
  reference: "37:1",
  theme: ["anges", "ordre", "adoration"],
  emotion: "Révérence, ordre",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Mudabbir"],
  mirrorVersion: `« Par ceux qui sont rangés en rangs. » Le miroir me place devant l'ordre cosmique. Les anges (as-saffat) se rangent en ordre parfait. L'univers n'est pas chaos — il est ordonné. Le miroir m'interroge : est-ce que ma vie est ordonnée ? Ou suis-je dispersé ?`,
  reflection: `L'ordre est une forme d'adoration. Les anges adorent par leur ordre même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« As-saffat » — ceux qui se rangent. L'ordre comme adoration." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est organisée ma vie ? Est-ce le chaos ou l'ordre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre n'est pas la rigidité — c'est l'harmonie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ordonné. Les planètes, les atomes, les anges — tout suit un ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ordonne sa vie participe à l'ordre universel." }
  ],
  munajat: `Ya Mudabbir, Toi qui ordonnes toute chose. Aide-moi à mettre de l'ordre dans ma vie, comme les anges dans leurs rangs.`
};

MIROIR["37:102"] = {
  reference: "37:102",
  theme: ["sacrifice", "obéissance", "foi"],
  emotion: "Soumission, confiance",
  difficulty: "avancé",
  relatedNames: ["Al-Wali", "Al-Mawla"],
  mirrorVersion: `« Ô mon fils, je me vois en rêve t'égorgeant. Vois donc ce que tu voies. » Le miroir me place devant l'épreuve ultime d'Ibrahim. Il voit en rêve qu'il doit sacrifier son fils — et il s'y prépare. Pas d'hésitation, pas de négociation. La confiance absolue en Allah. Le miroir m'interroge : qu'est-ce que je suis prêt à sacrifier pour Allah ?`,
  reflection: `Le sacrifice d'Ibrahim est le modèle de la soumission totale. Rien n'est au-dessus d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Le rêve, l'ordre, la préparation. Ibrahim n'hésite pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse de sacrifier ? Qu'est-ce qui est au-dessus d'Allah dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas demandé le sacrifice final — Il a demandé la volonté de sacrifier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sacrifice est la loi de l'existence. Le grain meurt pour devenir épi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt à tout sacrifier reçoit tout en retour." }
  ],
  munajat: `Ya Wali, donne-moi la foi d'Ibrahim. Que rien ne soit au-dessus de Toi dans ma vie. Je suis prêt à sacrifier.`
};

MIROIR["37:180"] = {
  reference: "37:180",
  theme: ["transcendance", "pureté", "adoration"],
  emotion: "Révérence, glorification",
  difficulty: "débutant",
  relatedNames: ["As-Subuh", "Al-Quddus"],
  mirrorVersion: `« Gloire à ton Seigneur, le Seigneur de la puissance, Il est au-dessus de ce qu'ils décrivent. » Le miroir me place devant la transcendance d'Allah. « Au-dessus de ce qu'ils décrivent » — aucune description ne L'atteint. Nos mots sont limités, nos concepts sont limités. Le miroir m'invite à l'humilité : je ne connais qu'une infime partie d'Allah.`,
  reflection: `Allah transcende toute description. La meilleure attitude est le silence adorant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subhana Rabbika » — Gloire à ton Seigneur. « 'Amma yasifun » — au-dessus de ce qu'ils décrivent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je conçois Allah ? Mes concepts L'atteignent-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incapacité à décrire n'est pas une limite — c'est une protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne peut contenir son Créateur. Le créé ne peut saisir le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte de ne pas tout comprendre entre dans l'adoration pure." }
  ],
  munajat: `Ya Subuh, Tu es au-dessus de tout ce que je peux dire. Gloire à Toi. J'adore dans le silence de l'incompréhension aimante.`
};

// Surah 38 - Sad
MIROIR["38:1"] = {
  reference: "38:1",
  theme: ["rappel", "coran", "méditation"],
  emotion: "Attention, révérence",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikr", "Al-Qur'an"],
  mirrorVersion: `« Sad. Par le Coran, au Rappel plein de majesté. » Le miroir me place devant le Coran comme Rappel (Dhikr) majestueux. Ce n'est pas un livre ordinaire — c'est un rappel de la vérité éternelle. Le miroir m'interroge : est-ce que je me laisse rappeler ? Ou est-ce que j'oublie ?`,
  reflection: `Le Coran est un rappel. Qui se laisse rappeler retrouve le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-Qur'ani dhi al-dhikr » — Par le Coran, au Rappel plein de majesté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi le Coran me rappelle-t-il aujourd'hui ? De quoi ai-je oublié ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel ne sert à rien si on oublie aussitôt." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un rappel. Chaque créature rappelle son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se laisse rappeler constamment ne s'égare jamais." }
  ],
  munajat: `Ya Rabb, fais que je me laisse rappeler par Ton Coran. Ouvre mes oreilles au Rappel majestueux.`
};

MIROIR["38:17"] = {
  reference: "38:17",
  theme: ["patience", "épreuve", "confiance"],
  emotion: "Persévérance, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Hakim"],
  mirrorVersion: `« Endure avec patience ce qu'ils disent et rappelle-toi Notre serviteur David. » Le miroir me montre le modèle de David (Dawud), homme de patience et de force. Face aux paroles blessantes, la réponse n'est pas la riposte — c'est la patience. Le miroir m'interroge : comment réagis-je aux paroles difficiles ?`,
  reflection: `La patience face aux paroles est une force. David a supporté, et il a été honoré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Isbir 'ala ma yaqulun » — Endure ce qu'ils disent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'entends qui me blesse ? Comment est-ce que je réagis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience n'est pas la faiblesse — c'est la force maîtrisée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature supporte les tempêtes sans riposter. Elle attend que ça passe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente face aux paroles reçoit une patience qui transcende les mots." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience de David. Que les paroles ne m'atteignent pas. Donne-moi la force du silence.`
};

MIROIR["38:49"] = {
  reference: "38:49",
  theme: ["mémoire", "piété", "espérance"],
  emotion: "Souvenir, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wali"],
  mirrorVersion: `« Ceci est un rappel. Les pieux auront une belle destination. » Le miroir me place devant la promesse aux pieux. Le rappel (dhikr) conduit à la destination (ma'ab). Les pieux (muttaqun) sont ceux qui craignent Allah et Le suivent. Le miroir m'interroge : suis-je parmi les pieux ? Quelle est ma destination ?`,
  reflection: `La piété conduit à la belle destination. Le rappel maintient sur le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhikra » — un rappel. « Li-l-muttaqina » — pour les pieux. « Husnun ma'ab » — belle destination." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est ma piété ? Est-ce que j'espère la belle destination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La belle destination commence ici. La piété transforme le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a une destination. La nôtre est entre nos mains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde la belle destination en vue supporte tout le reste." }
  ],
  munajat: `Ya Wali, fais que je sois parmi les pieux. Garde-moi sur le chemin vers la belle destination.`
};

// Surah 39 - Az-Zumar (The Crowds)
MIROIR["39:1"] = {
  reference: "39:1",
  theme: ["révélation", "sagesse", "adoration"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Aziz"],
  mirrorVersion: `« La révélation du Livre vient d'Allah, le Puissant, le Sage. » Le miroir me place devant l'origine du Coran. « Al-'Aziz » — le Puissant, « Al-Hakim » — le Sage. Puissance et sagesse ensemble. Le Livre vient d'un Être qui combine la puissance absolue et la sagesse parfaite. Le miroir m'interroge : est-ce que je lis ce Livre avec la conscience de Sa source ?`,
  reflection: `Le Coran vient du Puissant Sage. Chaque mot porte cette double signature.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitab » — la révélation du Livre. D'Allah « Al-'Aziz Al-Hakim »." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je lis le Coran ? Comme un texte humain ou comme une révélation divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans sagesse est tyrannie. La sagesse sans puissance est impuissance. Allah est les deux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers manifeste la puissance et la sagesse d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme venant du Puissant Sage est transformé." }
  ],
  munajat: `Ya 'Aziz, Ya Hakim, Ton Livre vient de Toi. Fais que je le lise avec la conscience de sa source sacrée.`
};

MIROIR["39:22"] = {
  reference: "39:22",
  theme: ["cœur", "islam", "lumière"],
  emotion: "Gratitude, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "An-Nur"],
  mirrorVersion: `« Celui dont Allah a ouvert le cœur à l'islam suit la lumière de son Seigneur. » Le miroir me montre que l'islam est une ouverture du cœur, pas une contrainte extérieure. « Sharaha » — ouvert, élargi. Le cœur ouvert reçoit la lumière. Le miroir m'interroge : mon cœur est-il ouvert ? Est-ce que je suis dans la lumière ?`,
  reflection: `L'islam véritable est une ouverture du cœur. La lumière suit l'ouverture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man sharaha Allahu sadrahu li-l-islam » — Celui dont Allah a ouvert la poitrine à l'islam." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il ouvert ou fermé ? Est-ce que je respire dans l'islam ou est-ce que j'étouffe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture n'est pas de nous — elle vient d'Allah. Demander l'ouverture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ouvert à la lumière. Le cœur fermé reste dans les ténèbres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est ouvert ne fait qu'un avec la lumière." }
  ],
  munajat: `Ya Fattah, ouvre mon cœur à l'islam. Élargis ma poitrine. Fais que je suive Ta lumière sans obstacle.`
};

MIROIR["39:42"] = {
  reference: "39:42",
  theme: ["âme", "mort", "vie"],
  emotion: "Révérence, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Muhyi"],
  mirrorVersion: `« Allah reçoit les âmes au moment de leur mort, et celles qui ne meurent pas pendant leur sommeil. » Le miroir me place devant le mystère du sommeil et de la mort. Chaque nuit, l'âme est « reçue » par Allah. Le sommeil est une petite mort. Le miroir m'interroge : est-ce que je me couche en sachant que mon âme retourne à Allah ?`,
  reflection: `Le sommeil est un rappel quotidien de la mort. Chaque réveil est une résurrection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allah yatawaffa al-anfus » — Allah reçoit les âmes. Au sommeil et à la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je me couche ? En pensant à Allah ? En préparant mon âme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque réveil est un don. Allah m'a rendu mon âme pour une journée de plus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature dort et se réveille. Le cycle mort-vie est dans chaque créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dort en pensant à Allah se réveille en Sa présence." }
  ],
  munajat: `Ya Muhyi, Ya Mumit, chaque nuit Tu reçois mon âme. Fais que je me couche en paix et que je me réveille en Toi.`
};

// Surah 40 - Ghafir (The Forgiver)
MIROIR["40:1"] = {
  reference: "40:1",
  theme: ["révélation", "pardon", "avertissement"],
  emotion: "Attention, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafir", "Al-'Aziz"],
  mirrorVersion: `« Ha, Mim. La révélation du Livre vient d'Allah, le Puissant, le Celui qui pardonne. » Le miroir me place devant deux attributs divins : puissance et pardon. « Al-'Aziz » — le Puissant, « Al-Ghafir » — le Pardonneur. La puissance peut faire peur, mais le pardon rassure. Le miroir m'interroge : est-ce que je connais ce Dieu puissant qui pardonne ?`,
  reflection: `Allah combine la puissance absolue et le pardon illimité. Le croyant n'a pas à craindre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-'Aziz » — le Puissant. « Al-Ghafir » — le Pardonneur. Deux faces d'un même Dieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle image ai-je d'Allah ? Puissante sans pardon ? Ou les deux ensemble ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon du Puissant est plus précieux que le pardon du faible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers manifeste la puissance d'Allah. Sa miséricorde le soutient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le Pardonneur Puissant n'a plus peur de ses péchés." }
  ],
  munajat: `Ya Ghafir, Ya 'Aziz, Tu es puissant et Tu pardonnes. Je viens à Toi avec mes péchés, confiant dans Ton pardon.`
};

MIROIR["40:3"] = {
  reference: "40:3",
  theme: ["pardon", "répentir", "châtiment"],
  emotion: "Espérance, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "At-Tawwab"],
  mirrorVersion: `« Pardonneur des péchés, Accueilleur du repentir, Dur en punition. » Le miroir me montre les trois faces d'Allah. « Ghafir al-dhanb » — pardonneur des péchés. « Qabil al-tawb » — qui accepte le repentir. « Shadid al-'iqab » — dur en punition. Le choix est offert : se repentir et être pardonné, ou persister et être puni. Le miroir m'interroge : quel chemin est-ce que je choisis ?`,
  reflection: `Allah offre le pardon, mais ne tolère pas l'insolence. La balance entre espoir et vigilance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "Trois attributs : pardon, acceptation du repentir, punition sévère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens ? Ou est-ce que je compte sur le pardon sans changer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dureté de la punition est proportionnée à la tendresse du pardon refusé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses lois. Les transgresser a des conséquences. Mais le repentir est possible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les trois attributs vit dans la gratitude et la vigilance." }
  ],
  munajat: `Ya Ghaffur, je choisis le repentir. Je ne veux pas de la punition. Accepte mon retour, pardonne mes péchés.`
};

MIROIR["40:44"] = {
  reference: "40:44",
  theme: ["confiance", "abandon", "tawakkul"],
  emotion: "Confiance totale, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wakil", "Al-Hafiz"],
  mirrorVersion: `« Je vous confie à Allah. Allah voit bien Ses serviteurs. » Le miroir me montre le mot du croyant d'Égypte face à Pharaon. Il a essayé de convaincre, mais face au refus, il confie tout à Allah. « Wakiltu ila Allah » — je confie à Allah. Le miroir m'interroge : à qui est-ce que je confie mes affaires difficiles ?`,
  reflection: `La confiance en Allah est le dernier recours et le meilleur. Quand tout échoue, Il reste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wakiltu ila Allah » — je confie à Allah. « Inna Allah basirun bi-l-'ibad » — Allah voit Ses serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je n'arrive pas à confier ? Qu'est-ce que je garde pour moi alors qu'Allah peut le porter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Confier à Allah n'est pas de la passivité — c'est la plus haute action spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est confié à Allah. Chaque créature est vue par Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui confie tout à Allah reçoit tout d'Allah." }
  ],
  munajat: `Ya Wakil, je Te confie tout. Tu vois ma situation. Prends-en soin, car je ne peux pas.`
};

// Surah 41 - Fussilat (Explained in Detail)
MIROIR["41:1"] = {
  reference: "41:1",
  theme: ["révélation", "miséricorde", "clarté"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mubin"],
  mirrorVersion: `« Ha, Mim. Révélation de la part du Tout-Miséricordieux, du Très-Miséricordieux. » Le miroir me place devant l'origine du Coran : « min ar-Rahman ar-Rahim ». Le Livre vient de la miséricorde. Chaque verset est une goutte de miséricorde. Le miroir m'interroge : est-ce que je lis le Coran comme un don de miséricorde ?`,
  reflection: `Le Coran est miséricorde incarnée. Qui le lit reçoit la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzilun min ar-Rahman ar-Rahim » — révélation du Tout-Miséricordieux, Très-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je lis le Coran ? Comme une contrainte ou comme une miséricorde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde est offerte à tous. Le Coran est l'invitation à la recevoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est imprégné de miséricorde. Le Coran en est l'expression articulée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme miséricorde devient miséricorde pour les autres." }
  ],
  munajat: `Ya Rahman, Ya Rahim, Ton Livre est miséricorde. Fais que je le reçoive comme tel et que je devienne porteur de miséricorde.`
};

MIROIR["41:34"] = {
  reference: "41:34",
  theme: ["pardon", "bien", "transformation"],
  emotion: "Sagesse, courage",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhsin", "Al-Afw"],
  mirrorVersion: `« Le bien et le mal ne sont pas égaux. Repousse le mal par le bien, et voilà que celui avec qui tu avais une animosité devient un ami chaleureux. » Le miroir me montre la puissance du bien face au mal. La réponse au mal n'est pas le mal — c'est le bien. Cette approche transforme les ennemis en amis. Le miroir m'interroge : comment est-ce que je réponds au mal ?`,
  reflection: `Le bien est plus fort que le mal. Répondre par le bien transforme l'ennemi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idfa' bi-l-lati hiya ahsan » — repousse par ce qui est meilleur. Le résultat : un ami chaleureux (waliyyun hamim)." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réponds à ceux qui me font du mal ? Par le mal ou par le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bien n'est pas de la faiblesse — c'est une force supérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau éteint le feu. Le bien éteint le mal. C'est une loi cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond par le bien transforme le monde autour de lui." }
  ],
  munajat: `Ya Muhsin, apprends-moi à répondre par le bien. Transforme mes ennemis en amis par la puissance du bien.`
};

// Surah 42 - Ash-Shura (The Consultation)
MIROIR["42:1"] = {
  reference: "42:1",
  theme: ["mystère", "révélation", "méditation"],
  emotion: "Révérence, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« Ha, Mim. 'Ayn, Sin, Qaf. » Le miroir me place devant les lettres mystérieuses. Ha, Mim, 'Ayn, Sin, Qaf — cinq lettres dont le sens nous échappe. Allah nous rappelle qu'il y a des mystères. Tout n'est pas accessible à notre raison. Le miroir m'invite à l'humilité : je ne comprends pas tout, et c'est ainsi.`,
  reflection: `Les lettres mystérieuses rappellent les limites de notre compréhension. La foi accepte le mystère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha Mim 'Ayn Sin Qaf » — cinq lettres. Leur sens est connu d'Allah seul." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je ne comprends pas ? Est-ce que je l'accepte ou est-ce que je le rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mystère n'est pas un obstacle — c'est une invitation à la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères. La science en découvre chaque jour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère s'ouvre à l'infini." }
  ],
  munajat: `Ya 'Alim al-ghuyub, Tu connais le sens de ces lettres. Moi, je m'incline devant le mystère. Fais que je fasse confiance.`
};

MIROIR["42:13"] = {
  reference: "42:13",
  theme: ["unité", "religion", "message"],
  emotion: "Inclusion, clarté",
  difficulty: "débutant",
  relatedNames: ["Ad-Din", "Al-Hanif"],
  mirrorVersion: `« Il vous a légiféré en matière de religion ce qu'Il avait enjoint à Noé, ce que Nous t'avons révélé, ce que Nous avons enjoint à Abraham, à Moïse et à Jésus. » Le miroir me montre l'unité du message divin. De Noé à Muhammad, le même message : l'unicité d'Allah, la soumission, la droiture. Le miroir m'interroge : est-ce que je comprends cette continuité ?`,
  reflection: `La religion d'Allah est une. Les prophètes sont des maillons d'une même chaîne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Shara'a lakum mina al-din » — Il vous a légiféré la religion. La même pour Noé, Ibrahim, Musa, 'Isa et Muhammad." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que ma religion est celle de tous les prophètes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité du message ne nie pas la diversité des lois. L'essence est commune." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un. La vérité est une. Les chemins peuvent varier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'unité du message comprend l'universalité de l'islam." }
  ],
  munajat: `Ya Rabb, merci pour la continuité de Ton message. Fais que je sois fidèle à la religion de tous les prophètes.`
};

MIROIR["42:49"] = {
  reference: "42:49",
  theme: ["souveraineté", "don", "sagesse"],
  emotion: "Acceptation, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Wahhab"],
  mirrorVersion: `« À Allah appartient la royauté des cieux et de la terre. Il crée ce qu'Il veut. » Le miroir me place devant la souveraineté absolue d'Allah. « Yahkumu » — Il juge, décide. « Yakhluqu ma yasha' » — Il crée ce qu'Il veut. Le miroir m'interroge : est-ce que j'accepte Sa souveraineté sur ma vie ?`,
  reflection: `Allah est le Créateur souverain. Accepter Sa volonté est le début de la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillahi mulku as-samawati wa al-ard » — à Allah appartient la royauté des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse dans ce qu'Allah a créé pour moi ? Qu'est-ce que je conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de Sa volonté n'est pas de la résignation — c'est de la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier accepte la volonté du Créateur. L'homme seul peut choisir de résister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la souveraineté d'Allah reçoit Sa paix." }
  ],
  munajat: `Ya Malik, Tu es le Roi de tout. J'accepte Ta volonté sur ma vie. Donne-moi la paix de l'acceptation.`
};

// Surah 43 - Az-Zukhruf (The Gold Adornments)
MIROIR["43:1"] = {
  reference: "43:1",
  theme: ["révélation", "clarté", "méditation"],
  emotion: "Attention, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Mubin", "Al-Hakim"],
  mirrorVersion: `« Ha, Mim. Par le Livre clair ! » Le miroir me place devant la clarté du Coran. « Al-Kitab al-mubin » — le Livre explicite, évident. Le Coran n'est pas obscur — il est clair pour celui qui veut voir. Le miroir m'interroge : est-ce que je vois la clarté ? Ou est-ce que je complique ce qui est simple ?`,
  reflection: `Le Coran est clair. Ce qui nous empêche de comprendre, c'est nous-mêmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-kitab al-mubin » — par le Livre clair, évident, explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'empêche de voir la clarté du Coran ? Mes préjugés ? Mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté du Coran n'est pas pour l'intellect seul — elle est pour le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est clair dans sa structure. Le Coran l'est dans son message." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui approche le Coran avec un cœur pur y voit la clarté." }
  ],
  munajat: `Ya Mubin, Ton Livre est clair. Purifie mon cœur pour que je voie cette clarté.`
};

MIROIR["43:67"] = {
  reference: "43:67",
  theme: ["amis", "jour dernier", "séparation"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-'Adl"],
  mirrorVersion: `« Les amis, ce jour-là, seront ennemis les uns des autres, sauf les pieux. » Le miroir me place devant le Jour dernier. Les amitiés de ce monde peuvent se transformer en inimitié. Seules les amitiés fondées sur la piété survivent. Le miroir m'interroge : sur quoi sont fondées mes amitiés ? Sur l'intérêt ou sur Allah ?`,
  reflection: `Les amitiés pour Allah durent. Les amitiés pour l'intérêt s'effondrent au Jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-akhilla' yawma'idhin ba'duhum li-ba'd 'aduww » — les amis intimes seront ennemis ce jour-là. Sauf les pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles amitiés ai-je ? Pour Allah ou pour autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amitié pour Allah n'est pas exclusive — elle est inclusive et durable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les liens humains sont fragiles. Seul le lien divin est indestructible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime pour Allah est aimé d'Allah." }
  ],
  munajat: `Ya Wali, purifie mes amitiés. Fais que j'aime pour Toi et que je sois aimé en Toi.`
};

// Surah 44 - Ad-Dukhan (The Smoke)
MIROIR["44:1"] = {
  reference: "44:1",
  theme: ["mystère", "signe", "méditation"],
  emotion: "Révérence, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mubin", "Al-Hakim"],
  mirrorVersion: `« Ha, Mim. Par le Livre explicite ! » Le miroir me place devant le serment divin par le Livre. « Wal-kitab al-mubin » — par le Livre explicite. Allah jure par Sa propre révélation. Le miroir m'interroge : est-ce que je prends ce Livre au sérieux ?`,
  reflection: `Allah jure par le Coran. Ce Livre mérite notre plus haute attention.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha Mim, wa al-kitab al-mubin » — Ha Mim, par le Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère le Coran comme Allah le considère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment par le Livre élève le Livre. Le lecteur doit s'élever aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Livre est le signe visible de la parole invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran avec la conscience du serment divin le lit différemment." }
  ],
  munajat: `Ya Rabb, Tu as juré par Ton Livre. Fais que je le prenne au sérieux, que je le lise avec la conscience de Sa grandeur.`
};

MIROIR["44:58"] = {
  reference: "44:58",
  theme: ["facilité", "coran", "miséricorde"],
  emotion: "Gratitude, facilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Muyassir"],
  mirrorVersion: `« Nous ne l'avons rendu facile qu'en ta langue, peut-être se rappelleront-ils. » Le miroir me montre la miséricorde dans la facilité. Le Coran a été révélé en arabe pour être accessible à ses premiers auditeurs. La facilité est une miséricorde. Le miroir m'interroge : est-ce que je profite de cette facilité ?`,
  reflection: `Le Coran est rendu facile pour nous. La difficulté n'est pas dans le texte, mais dans nos cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa innama yassarnahu bi-lisanik » — Nous ne l'avons rendu facile qu'en ta langue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran ? Si non, pourquoi ? La facilité est offerte." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du Coran n'est pas une simplification — c'est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah facilite pour chaque peuple. La langue est un pont, pas un obstacle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui profite de la facilité reçoit le rappel." }
  ],
  munajat: `Ya Rahman, merci pour la facilité du Coran. Fais que je lise, que je comprenne, que je me rappelle.`
};

// Surah 45 - Al-Jathiyah (The Kneeling)
MIROIR["45:1"] = {
  reference: "45:1",
  theme: ["révélation", "signes", "méditation"],
  emotion: "Attention, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Mubin", "Al-Hakim"],
  mirrorVersion: `« Ha, Mim. La révélation du Livre vient d'Allah, le Puissant, le Sage. » Le miroir me place devant l'origine du Coran. « Min Allah » — d'Allah. Pas d'un humain, pas d'une invention. Le Livre vient du Puissant Sage. Le miroir m'interroge : est-ce que je reconnais cette origine ?`,
  reflection: `Le Coran vient d'Allah. Cette vérité transforme notre rapport au texte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitab min Allah » — révélation du Livre venant d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je traite le Coran ? Comme une parole divine ou humaine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si le Coran vient d'Allah, il mérite mon attention maximale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé par Allah. Le Coran est révélé par Lui. Les deux sont signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'origine divine du Coran le lit avec révérence." }
  ],
  munajat: `Ya 'Aziz, Ya Hakim, Ton Livre vient de Toi. Fais que je le lise avec la conscience de son origine sacrée.`
};

MIROIR["45:20"] = {
  reference: "45:20",
  theme: ["coran", "guidance", "lumière"],
  emotion: "Gratitude, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Ceci est une lumière pour les humains et une guidance et une miséricorde pour un peuple persuadé. » Le miroir me montre le triple don du Coran : lumière (nur), guidance (hudan), miséricorde (rahma). Pour qui ? Pour le peuple « persuadé » (yaqin) — ceux qui croient avec certitude. Le miroir m'interroge : est-ce que j'ai cette certitude ?`,
  reflection: `Le Coran est lumière pour celui qui croit. La certitude ouvre la porte à la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nurun li-nnas » — lumière pour les humains. « Hudan wa rahma » — guidance et miséricorde. « Li-qawmin yuqinun » — pour un peuple persuadé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai le yaqin (certitude) ? Sans lui, la lumière reste obscure." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière est offerte à tous. La certitude est la clé pour la recevoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique permet de voir. La lumière du Coran permet de comprendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la certitude voit le Coran comme lumière, guidance et miséricorde." }
  ],
  munajat: `Ya Nur, fais que j'aie la certitude. Donne-moi Ta lumière, Ta guidance, Ta miséricorde par le Coran.`
};

// Surah 46 - Al-Ahqaf (The Dunes)
MIROIR["46:1"] = {
  reference: "46:1",
  theme: ["révélation", "sagesse", "méditation"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Aziz"],
  mirrorVersion: `« Ha, Mim. La révélation du Livre vient d'Allah, le Puissant, le Sage. » Le miroir me place devant la régularité du message. Encore une fois : Ha, Mim. Encore une fois : révélation d'Allah. La constance du message rappelle son importance. Le miroir m'interroge : est-ce que j'entends ce message répété ?`,
  reflection: `La répétition dans le Coran n'est pas redondance — c'est insistance sur l'essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitab min Allah al-'Aziz al-Hakim » — révélation du Livre d'Allah, le Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute ce qui est répété ? Ou est-ce que je l'ignore parce que je l'ai déjà entendu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition est un rappel. L'essentiel mérite d'être répété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature répète ses cycles. Le lever du soleil est quotidien et toujours nouveau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute la répétition comme si c'était la première fois reste éveillé." }
  ],
  munajat: `Ya 'Aziz, Ya Hakim, fais que j'entende Ta répétition. Ne me laisse pas m'habituer à Ton message.`
};

MIROIR["46:31"] = {
  reference: "46:31",
  theme: ["appel", "réponse", "guidance"],
  emotion: "Urgence, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Da'i", "Al-Mujib"],
  mirrorVersion: `« Ô notre peuple, répondez à celui qui vous appelle vers Allah et croyez en lui. » Le miroir me place devant l'appel et la réponse. « Da'i » — celui qui appelle. Le Prophète appelle vers Allah. La réponse attendue : croire et suivre. Le miroir m'interroge : est-ce que j'ai répondu à l'appel ?`,
  reflection: `L'appel vers Allah est constant. La réponse est notre responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aijibu da'i Allah » — répondez à celui qui appelle vers Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réponds à l'appel d'Allah ? Avec enthousiasme ou avec tiédeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel d'Allah n'est pas une contrainte — c'est une invitation à la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond à l'appel du Créateur par son existence même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'appel entre dans la compagnie d'Allah." }
  ],
  munajat: `Ya Da'i, j'entends Ton appel. Je réponds. Je crois. Guide-moi vers Toi.`
};

// Surah 47 - Muhammad
MIROIR["47:1"] = {
  reference: "47:1",
  theme: ["foi", "mécréance", "actes"],
  emotion: "Clarté, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Ceux qui ont mécru et obstrué le chemin d'Allah, Il a rendu leurs œuvres vaines. » Le miroir me place devant le contraste entre foi et mécréance. Les mécréants « obstruent » le chemin — ils s'opposent activement. Le résultat : leurs œuvres sont « vaines » (batil). Le miroir m'interroge : mes œuvres sont-elles vides de sens ou pleines de foi ?`,
  reflection: `Les œuvres sans foi sont vides. La foi donne sens à tout ce qu'on fait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ahdathu a'malahum » — Il a rendu leurs œuvres vaines. Les œuvres sans foi sont vides." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais qui pourrait être vain ? Quel acte manque de foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi vivifie les œuvres. Un petit acte avec foi vaut plus qu'un grand acte sans foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah. Ses « œuvres » ne sont pas vaines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait chaque acte avec foi voit tout prendre sens." }
  ],
  munajat: `Ya Rabb, ne laisse pas mes œuvres être vaines. Remplis-les de foi. Donne sens à chaque geste.`
};

MIROIR["47:12"] = {
  reference: "47:12",
  theme: ["paradis", "récompense", "comparaison"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Ar-Raziq"],
  mirrorVersion: `« Allah fera entrer ceux qui croient et font de bonnes œuvres dans des Jardins sous lesquels coulent les rivières. » Le miroir me place devant la promesse du Paradis. « Jannatin » — jardins. « Tajri min tahtiha al-anhar » — sous lesquels coulent les rivières. L'image de fraîcheur et d'abondance. Le miroir m'interroge : est-ce que j'espère ce Paradis ?`,
  reflection: `Le Paradis est la promesse ultime. L'espérance du Paradis motive les bonnes œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatin tajri min tahtiha al-anhar » — Jardins sous lesquels coulent les rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec l'espérance du Paradis ? Est-ce que je le prépare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis commence ici dans le cœur qui espère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est source de vie. Les rivières du Paradis sont source de vie éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère le Paradis le goûte déjà dans l'espérance." }
  ],
  munajat: `Ya Raziq, promets-moi le Paradis. Je veux ces Jardins, ces rivières. Fais que mes œuvres y conduisent.`
};

// Surah 48 - Al-Fath (The Victory)
MIROIR["48:1"] = {
  reference: "48:1",
  theme: ["victoire", "promesse", "foi"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "An-Nasr"],
  mirrorVersion: `« En vérité, Nous t'avons accordé une victoire éclatante. » Le miroir me place devant la promesse de victoire. « Fathun mubin » — une victoire évidente, claire. Allah promet la victoire à Son Prophète et aux croyants. Le miroir m'interroge : est-ce que je crois à la victoire d'Allah ? Même quand tout semble perdu ?`,
  reflection: `La victoire vient d'Allah. Elle peut sembler lointaine, mais elle est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fathun mubin » — une victoire claire, évidente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi ai-je besoin de victoire ? Est-ce que je fais confiance à Allah pour la donner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire peut venir de manière inattendue. Traverser l'épreuve est déjà une victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour triomphe de la nuit. Le printemps triomphe de l'hiver. La victoire est dans la structure de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la victoire d'Allah la voit arriver." }
  ],
  munajat: `Ya Fattah, accorde-moi la victoire. Sur mes passions, sur mes difficultés, sur tout ce qui m'empêche de Toi.`
};

MIROIR["48:10"] = {
  reference: "48:10",
  theme: ["allégeance", "prophète", "alliance"],
  emotion: "Engagement, fidélité",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Ar-Rasul"],
  mirrorVersion: `« Ceux qui te prêtent allégeance prêtent allégeance à Allah. » Le miroir me montre le lien entre l'allégeance au Prophète et l'allégeance à Allah. « Yubayi'una » — ils prêtent allégeance. Le Prophète est le représentant d'Allah sur terre. Lui obéir, c'est obéir à Allah. Le miroir m'interroge : est-ce que je suis le Prophète ?`,
  reflection: `Le Prophète est le chemin vers Allah. Le suivre, c'est suivre Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina yubayi'unaka innama yubayi'una Allah » — ceux qui te prêtent allégeance prêtent allégeance à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je suis le Prophète ? Mon allégeance est-elle réelle ou verbale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allégeance n'est pas une contrainte — c'est un chemin de liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers suit l'ordre d'Allah. Suivre le Prophète, c'est s'aligner sur cet ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne son allégeance au Prophète reçoit l'allégeance d'Allah." }
  ],
  munajat: `Ya Rabb, je prête allégeance à Ton Prophète. Fais que je le suive vraiment. Sois mon allié dans cette alliance.`
};

// Surah 49 - Al-Hujurat (The Rooms)
MIROIR["49:1"] = {
  reference: "49:1",
  theme: ["respect", "prophète", "précédence"],
  emotion: "Humilité, révérence",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "Al-Hadi"],
  mirrorVersion: `« Ô vous qui croyez ! Ne vous mettez pas en avant d'Allah et de Son Messager. » Le miroir me place devant la question de la précédence. « La tuqaddimu » — ne vous mettez pas en avant. L'ego veut toujours passer devant. La foi demande de laisser Allah et Son Messager passer devant. Le miroir m'interroge : où est-ce que je me mets en avant ?`,
  reflection: `L'ego veut la première place. La foi reconnaît que la première place est pour Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tuqaddimu bayna yaday Allah wa rasulihi » — ne vous mettez pas en avant d'Allah et de Son Messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je me mets en avant ? Dans mes décisions ? Dans mes opinions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Se mettre en arrière d'Allah n'est pas de la faiblesse — c'est de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne précède pas son Créateur. La créature suit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse passer Allah en premier arrive en premier." }
  ],
  munajat: `Ya Rabb, je ne veux pas me mettre en avant de Toi. Apprends-moi à suivre, à patienter, à laisser Toi et Ton Messager passer devant.`
};

MIROIR["49:11"] = {
  reference: "49:11",
  theme: ["respect", "moquerie", "fraternité"],
  emotion: "Respect, fraternité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Akhu"],
  mirrorVersion: `« Qu'un groupe ne se moque pas d'un autre groupe : ceux-ci sont peut-être meilleurs qu'eux. » Le miroir me place devant le respect mutuel. La moquerie, le mépris — tout cela vient de l'orgueil. Mais « peut-être meilleurs qu'eux » — Allah seul connaît la valeur des gens. Le miroir m'interroge : est-ce que je me moque des autres ?`,
  reflection: `La moquerie révèle l'orgueil. La valeur d'une personne n'est pas visible à l'œil nu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yaskhar qawmun min qawmin 'asa an yakunu khayran minhum » — qu'un groupe ne se moque pas d'un autre groupe : peut-être sont-ils meilleurs qu'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque des autres ? De qui ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui que je méprise est peut-être plus proche d'Allah que moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se moque pas. Chaque créature a sa place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte tous les humains respecte le Créateur qui les a faits." }
  ],
  munajat: `Ya Karim, purifie-moi de la moquerie. Fais que je voie chaque personne comme Tu la vois — digne de respect.`
};

// Surah 50 - Qaf
MIROIR["50:1"] = {
  reference: "50:1",
  theme: ["coran", "serment", "méditation"],
  emotion: "Attention, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Majid", "Al-Qur'an"],
  mirrorVersion: `« Qaf. Par le Coran glorieux ! » Le miroir me place devant le serment divin. « Wa al-Qur'an al-majid » — par le Coran glorieux, majestueux. Allah jure par Son propre Livre. La gloire du Coran est mise en avant. Le miroir m'interroge : est-ce que je vois la gloire du Coran ?`,
  reflection: `Le Coran est glorieux. Qui le lit avec cette conscience le voit sous un nouveau jour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaf, wa al-Qur'an al-majid » — Qaf, par le Coran glorieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que le Coran représente pour moi ? Un texte ordinaire ou un Livre glorieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment par le Coran élève le Livre. Le lecteur doit s'élever à Sa hauteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gloire du Coran reflète la gloire d'Allah. Le mot révèle le Parleur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran glorieux devient glorieux par son contact." }
  ],
  munajat: `Ya Majid, Ton Coran est glorieux. Fais que je le lise avec la conscience de Sa grandeur.`
};

MIROIR["50:22"] = {
  reference: "50:22",
  theme: ["réveil", "vision", "jugement"],
  emotion: "Lucidité, effroi",
  difficulty: "avancé",
  relatedNames: ["Al-Basir", "Al-Mubin"],
  mirrorVersion: `« Tu étais inattentif à cela. Nous avons levé ton voile : ta vue est aujourd'hui perçante. » Le miroir me place devant le moment du réveil. « Ghafila » — inattentif, insouciant. Le voile est levé. La vue devient « hadida » — perçante, tranchante. Le miroir m'interroge : suis-je inattentif maintenant ? Quel voile ai-je sur les yeux ?`,
  reflection: `L'insouciance voile la réalité. Le réveil lève le voile. Mieux vaut se réveiller avant que le voile ne soit levé de force.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La qad kunta 'an hadha ghaflan » — tu étais inattentif à cela. « Fa kashafna 'anka ghitaa'ak » — Nous avons levé ton voile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi suis-je inattentif ? Quel voile me cache la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le réveil volontaire est une miséricorde. Le réveil forcé est un jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est toujours éveillé. L'homme seul peut choisir de dormir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réveille maintenant n'aura pas de surprise au Jour dernier." }
  ],
  munajat: `Ya Basir, lève mon voile maintenant. Réveille-moi de mon insouciance. Je ne veux pas attendre le Jour dernier pour voir.`
};

// Surah 51 - Adh-Dhariyat (The Winnowing Winds)
MIROIR["51:1"] = {
  reference: "51:1",
  theme: ["vent", "création", "méditation"],
  emotion: "Émerveillement, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Rih", "Al-Khaliq"],
  mirrorVersion: `« Par les vents qui éparpillent ! » Le miroir me place devant les phénomènes naturels. « Adh-dhariyat » — les vents qui dispersent. Allah jure par les vents. La nature est signe de Son pouvoir. Le miroir m'interroge : est-ce que je vois les phénomènes naturels comme des signes ?`,
  reflection: `Les vents sont des signes. Qui contemple le vent contemple le Souffle du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adh-dhariyat dharwan » — par les vents qui dispersent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois le vent souffler, qu'est-ce que je pense ? Un phénomène naturel ou un signe divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vent qui disperse peut aussi rassembler. Le même souffle qui éparpille purifie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en mouvement constant. Le vent est l'un de ces mouvements." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le vent comme signe voit la main d'Allah dans chaque brise." }
  ],
  munajat: `Ya Khaliq, fais que je voie les vents comme Tes signes. Chaque brise est un rappel de Ta présence.`
};

MIROIR["51:20"] = {
  reference: "51:20",
  theme: ["signes", "création", "méditation"],
  emotion: "Émerveillement, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Sur la terre, il y a des signes pour ceux qui croient avec certitude. » Le miroir me montre que la terre est un livre de signes. « Ayat » — des signes. Pour qui ? « Li-l-muqinin » — pour ceux qui ont la certitude. La terre parle à ceux qui écoutent. Le miroir m'interroge : est-ce que j'écoute la terre ?`,
  reflection: `La terre est un livre ouvert. Chaque paysage, chaque créature est un verset.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi al-ard ayatun li-l-muqinin » — sur la terre, des signes pour les certains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois quand je regarde la terre ? Un hasard ou une signature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude ouvre les yeux. Le doute les ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est signe. La terre en est une page visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la certitude voit des signes partout." }
  ],
  munajat: `Ya Khaliq, donne-moi la certitude. Ouvre mes yeux sur les signes de la terre. Fais que chaque regard soit une lecture de Ta création.`
};

// Surah 52 - At-Tur (The Mount)
MIROIR["52:1"] = {
  reference: "52:1",
  theme: ["montagne", "serment", "création"],
  emotion: "Révérence, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jabal", "Al-Khaliq"],
  mirrorVersion: `« Par le Mont ! » Le miroir me place devant le serment par la montagne. « At-tur » — la montagne, probablement le Sinaï où Moïse a reçu la révélation. Allah jure par la montagne. La création physique devient support du serment divin. Le miroir m'interroge : est-ce que je vois la grandeur dans la création ?`,
  reflection: `Les montagnes sont des signes de stabilité et de grandeur. Elles témoignent du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa at-tur » — par le Mont." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois une montagne, qu'est-ce que je ressens ? De l'émerveillement ou de l'indifférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La montagne est immobile, mais elle témoigne du Dieu vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont les piliers de la terre. Elles pointent vers le ciel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la montagne contemple la grandeur d'Allah." }
  ],
  munajat: `Ya 'Azim, les montagnes témoignent de Ta grandeur. Fais que je voie Ta main dans chaque sommet.`
};

MIROIR["52:48"] = {
  reference: "52:48",
  theme: ["patience", "louange", "attente"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Hamid"],
  mirrorVersion: `« Et supporte patiemment le jugement de ton Seigneur, car tu es sous Nos yeux. » Le miroir me place sous le regard d'Allah. « Bi-a'yunina » — sous Nos yeux. Le Prophète est sous le regard divin. Cette conscience devrait apaiser. Le miroir m'interroge : est-ce que je vis sous le regard d'Allah ?`,
  reflection: `Être sous le regard d'Allah est à la fois un honneur et une protection. Il ne perd jamais de vue Ses serviteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa sabir li-hukmi rabbik » — supporte patiemment le jugement de ton Seigneur. « Innaka bi-a'yunina » — tu es sous Nos yeux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que je suis sous le regard d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regard d'Allah n'est pas une surveillance oppressive — c'est une protection aimante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est sous le regard du Créateur. Rien ne Lui échappe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est vu par Allah n'a plus besoin d'être vu par les autres." }
  ],
  munajat: `Ya Basir, je suis sous Ton regard. Donne-moi la paix de cette conscience. Protège-moi par Ta vue.`
};

// Surah 53 - An-Najm (The Star)
MIROIR["53:1"] = {
  reference: "53:1",
  theme: ["étoile", "serment", "révélation"],
  emotion: "Émerveillement, attention",
  difficulty: "intermédiaire",
  relatedNames: ["An-Najm", "Al-Hakim"],
  mirrorVersion: `« Par l'étoile quand elle décline ! » Le miroir me place devant le serment par l'étoile. « An-najm » — l'étoile. « Idha hawa » — quand elle décline. Les étoiles suivent leur cours. Allah jure par ce phénomène cosmique. Le miroir m'interroge : est-ce que je contemple les étoiles comme signes ?`,
  reflection: `Les étoiles suivent leur course. Leur régularité témoigne de l'ordre du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa an-najm idha hawa » — par l'étoile quand elle décline." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je regarde les étoiles, qu'est-ce que je vois ? Des lumières ou des signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étoile qui décline n'est pas une perte — c'est un mouvement ordonné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli d'étoiles. Chacune suit son cours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les étoiles contemple l'ordre cosmique." }
  ],
  munajat: `Ya Khaliq, les étoiles témoignent de Ton ordre. Fais que je voie chaque étoile comme un signe de Ta présence.`
};

MIROIR["53:32"] = {
  reference: "53:32",
  theme: ["pardon", "modération", "espoir"],
  emotion: "Espérance, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Mu'tadil"],
  mirrorVersion: `« Allah est le Pardonneur, le Reconnaissant, pour peu que vous évitiez les péchés majeurs et que vous vous en écartiez. » Le miroir me montre le chemin du pardon. Éviter les grands péchés (« al-kaba'ir »), s'écarter des petites fautes. Le pardon d'Allah suit cette voie de modération. Le miroir m'interroge : quels sont mes grands péchés ? Est-ce que je m'en écarte ?`,
  reflection: `Le pardon d'Allah a des conditions. La modération et l'effort d'évitement ouvrent la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaha min al-kaba'iri wa al-fawahishi tujtanibun » — si vous évitez les grands péchés et les turpitudes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont mes grands péchés ? Est-ce que je m'en écarte vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas automatique — il demande un effort de notre part." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses lois. Les transgresser a des conséquences. Mais le pardon est possible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les grands péchés reçoit le pardon des petits." }
  ],
  munajat: `Ya Ghaffur, aide-moi à éviter les grands péchés. Pardonne-moi mes fautes. Je m'efforce de m'en écarter.`
};

// Surah 54 - Al-Qamar (The Moon)
MIROIR["54:1"] = {
  reference: "54:1",
  theme: ["lune", "miracle", "signe"],
  emotion: "Émerveillement, foi",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nur", "Al-Qamar"],
  mirrorVersion: `« L'Heure s'est approchée et la lune s'est fendue. » Le miroir me place devant le miracle du fendage de la lune. Un signe physique donné au Prophète. La lune, symbole de beauté et de régularité, se plie à la volonté d'Allah. Le miroir m'interroge : est-ce que je crois aux miracles ? À la puissance d'Allah sur la nature ?`,
  reflection: `Le miracle du fendage de la lune montre qu'Allah peut tout. Rien ne Lui résiste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iqtarabati as-sa'at wa inshaqqa al-qamar » — L'Heure s'est approchée et la lune s'est fendue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que Allah peut fendre la lune ? Peut-Il fendre mes problèmes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah peut fendre la lune, Il peut tout. Mes limites ne sont pas les Siennes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah. La lune, le soleil, les étoiles — tout suit Son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au miracle de la lune croit que tout est possible pour Allah." }
  ],
  munajat: `Ya Qadir, Tu as fendu la lune. Fends mes obstacles, mes doutes, mes peurs. Rien ne Te résiste.`
};

MIROIR["54:49"] = {
  reference: "54:49",
  theme: ["destin", "création", "sagesse"],
  emotion: "Acceptation, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadar", "Al-Hakim"],
  mirrorVersion: `« Nous avons créé toute chose avec mesure. » Le miroir me place devant le destin. « Bi-qadar » — avec mesure, avec décret. Rien n'est hasard. Tout est mesuré, calculé, ordonné. Le miroir m'interroge : est-ce que j'accepte la mesure d'Allah dans ma vie ?`,
  reflection: `Le destin est la mesure d'Allah. L'accepter, c'est entrer dans la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kulla shay'in khalaqnahu bi-qadar » — Nous avons créé toute chose avec mesure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse dans la mesure d'Allah ? Qu'est-ce que je voudrais différent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mesure n'est pas une contrainte — c'est une perfection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est parfaitement mesuré. Chaque atome est à sa place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mesure reçoit la paix de la perfection." }
  ],
  munajat: `Ya Qadir, Tu as mesuré toute chose. J'accepte Ta mesure. Donne-moi la paix de l'acceptation.`
};

// Surah 55 - Ar-Rahman (The Most Merciful)
MIROIR["55:1"] = {
  reference: "55:1",
  theme: ["miséricorde", "nom", "bonté"],
  emotion: "Gratitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ar-Rahim"],
  mirrorVersion: `« Le Tout-Miséricordieux. » Le miroir me place devant le nom le plus beau. « Ar-Rahman » — le Tout-Miséricordieux. Ce nom ouvre la sourate et la résume. Tout ce qui suit est manifestation de cette miséricorde. Le miroir m'interroge : est-ce que je connais la miséricorde d'Allah ? Est-ce que j'en vis ?`,
  reflection: `Ar-Rahman est le nom qui contient tous les autres. La miséricorde est l'essence de la relation d'Allah avec Sa création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ar-Rahman » — le Tout-Miséricordieux. Le nom qui ouvre et résume la sourate." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je vis la miséricorde d'Allah ? Est-ce que j'en suis conscient chaque jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde d'Allah précède notre existence. Elle nous crée et nous soutient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est maintenu par la miséricorde d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur Ar-Rahman découvre la miséricorde dans chaque souffle." }
  ],
  munajat: `Ya Rahman, Tu es le Tout-Miséricordieux. Fais que je connaisse Ta miséricorde, que j'en vive, que je la transmette.`
};

MIROIR["55:26"] = {
  reference: "55:26",
  theme: ["impermanence", "création", "éternité"],
  emotion: "Humilité, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Fani"],
  mirrorVersion: `« Tout ce qui est sur elle doit disparaître. » Le miroir me place devant l'impermanence. « 'Alayha » — sur elle (la terre). « Faan » — disparaître, périr. Tout sur terre passe. Seul Allah demeure. Le miroir m'interroge : à quoi m'attache-je qui doit disparaître ?`,
  reflection: `Tout sur terre est temporaire. L'attachement à ce qui passe mène à la souffrance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu man 'alayha faan » — tout ce qui est sur elle doit disparaître." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi m'attache-je ? Qu'est-ce qui doit disparaître dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui disparaît n'est pas perdu — c'est transformé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en transformation constante. Rien ne reste identique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que tout passe ne s'attache qu'à Celui qui reste." }
  ],
  munajat: `Ya Baqi, tout passe sauf Toi. Fais que je m'attache à Toi seul, non à ce qui disparaît.`
};

MIROIR["55:60"] = {
  reference: "55:60",
  theme: ["récompense", "bien", "gratitude"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Jazaa"],
  mirrorVersion: `« Y a-t-il une récompense pour le bien autre que le bien ? » Le miroir me place devant la logique divine de la récompense. Le bien attire le bien. « Hal jaza'u al-ihsani illa al-ihsan » — la récompense de la bienfaisance n'est-elle pas la bienfaisance ? Le miroir m'interroge : quel bien est-ce que je fais ? Quel bien est-ce que j'attends ?`,
  reflection: `Le bien attire le bien. Faire le bien, c'est planter des graines de bien pour soi-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal jaza'u al-ihsani illa al-ihsan » — y a-t-il une récompense pour le bien autre que le bien ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel bien est-ce que je fais aujourd'hui ? Quel bien est-ce que je veux recevoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bien fait pour la récompense reste bien. Mais le bien fait pour Allah est supérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature rend le bien pour le bien. L'eau donne, la terre rend." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien sans attendre reçoit le bien au-delà de son attente." }
  ],
  munajat: `Ya Shakur, je fais le bien. Accepte-le et rends-moi le bien. Fais que je sois source de bien pour les autres.`
};

MIROIR["55:78"] = {
  reference: "55:78",
  theme: ["louange", "nom", "majesté"],
  emotion: "Adoration, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Mubarak", "Ar-Rahman"],
  mirrorVersion: `« Béni soit le Nom de ton Seigneur, plein de majesté et de munificence. » Le miroir me place devant la doxologie finale. « Tabaraka » — béni. « Ismu Rabbik » — le Nom de ton Seigneur. « Dhi al-jalal wa al-ikram » — plein de majesté et de munificence. Le miroir m'invite à la louange. Le miroir m'interroge : est-ce que je loue le Nom d'Allah ?`,
  reflection: `Le Nom d'Allah est béni. Le louer, c'est reconnaître Sa majesté et Sa générosité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tabaraka ismu rabbika dhi al-jalali wa al-ikram » — béni soit le Nom de ton Seigneur, plein de majesté et de munificence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je loue le Nom d'Allah ? Est-ce que je reconnais Sa majesté et Sa générosité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La majesté d'Allah n'écrase pas — elle élève. Sa générosité n'appauvrit pas — elle enrichit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers loue le Nom d'Allah par son existence même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue le Nom béni participe à la bénédiction." }
  ],
  munajat: `Ya Rabb, Ton Nom est béni. Je Le loue pour Sa majesté et Sa générosité. Fais que je vive dans Sa bénédiction.`
};

// Surah 56 - Al-Waqi'ah (The Event)
MIROIR["56:1"] = {
  reference: "56:1",
  theme: ["événement", "jour dernier", "réalité"],
  emotion: "Gravité, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Waqi'ah", "Al-Qiyamah"],
  mirrorVersion: `« Quand l'événement surviendra. » Le miroir me place devant le Jour dernier. « Al-waqi'ah » — l'événement inévitable. Ce n'est pas « si » mais « quand ». L'événement viendra. Le miroir m'interroge : suis-je prêt pour cet événement ?`,
  reflection: `L'événement est certain. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza waqa'at al-waqi'ah » — quand l'événement surviendra." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si l'événement survenait maintenant, serais-je prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'événement n'est pas qu'une menace — c'est une justice pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers cet événement. Chaque seconde m'en rapproche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque jour comme si l'événement était demain ne sera pas surpris." }
  ],
  munajat: `Ya Rabb, l'événement viendra. Prépare-moi. Fais que je sois du côté des croyants.`
};

MIROIR["56:10"] = {
  reference: "56:10",
  theme: ["élus", "rapprochés", "récompense"],
  emotion: "Espérance, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Muqarrabun", "As-Sabiqun"],
  mirrorVersion: `« Et les premiers qui sont les premiers. » Le miroir me montre la catégorie la plus élevée : « As-sabiqun » — les premiers, les devanciers. « Al-muqarrabun » — les rapprochés. Ceux qui sont allés les premiers vers Allah, qui se sont rapprochés de Lui. Le miroir m'interroge : suis-je parmi les devanciers ou parmi les retardataires ?`,
  reflection: `Les premiers sont les rapprochés. La course vers Allah a des gagnants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa as-sabiqun as-sabiqun » — et les premiers qui sont les premiers. « Ula'ika al-muqarrabun » — ceux-là sont les rapprochés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans ma course vers Allah, suis-je en tête ou à la traîne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les premiers dans ce monde sont souvent les derniers dans l'autre. Les premiers vers Allah sont les vrais gagnants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers court vers Allah. Certains courent plus vite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut être premier peut le devenir. La porte est ouverte." }
  ],
  munajat: `Ya Rabb, je veux être parmi les premiers, les rapprochés. Donne-moi la vitesse, la détermination, l'amour de Te rejoindre.`
};

MIROIR["56:63"] = {
  reference: "56:63",
  theme: ["création", "réflexion", "agriculture"],
  emotion: "Contemplation, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Raziq"],
  mirrorVersion: `« Avez-vous considéré ce que vous labourez ? » Le miroir m'invite à contempler l'agriculture. Ce que nous semons, ce que nous récoltons — tout est don d'Allah. Le laboureur pense faire l'œuvre, mais c'est Allah qui fait pousser. Le miroir m'interroge : est-ce que je reconnais Allah dans ce que je « produis » ?`,
  reflection: `L'agriculture est un miracle quotidien. Le laboureur sème, Allah fait pousser.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afa'aytum ma tahruna » — avez-vous considéré ce que vous labourez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « produis » dans ma vie ? Est-ce que je reconnais que c'est Allah qui fait pousser ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort humain + la grâce divine = la récolte. L'un ne va pas sans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit par la volonté d'Allah. Chaque grain est un miracle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît Allah dans la croissance des plantes Le reconnaît dans tout." }
  ],
  munajat: `Ya Khaliq, Tu fais pousser ce que je sème. Reçois ma gratitude pour chaque récolte. Fais que je Te voie dans chaque croissance.`
};

MIROIR["56:96"] = {
  reference: "56:96",
  theme: ["louange", "nom", "majesté"],
  emotion: "Adoration, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-'Azim", "Ar-Rabb"],
  mirrorVersion: `« Glorifie donc le Nom de ton Seigneur, le Très Grand. » Le miroir me place devant la doxologie finale. « Fasabbih bi-ismi Rabbika al-'azim » — glorifie le Nom de ton Seigneur, le Très Grand. La sourate se termine par la louange, comme elle a commencé par l'événement. Le miroir m'interroge : est-ce que ma vie commence par l'événement et se termine par la louange ?`,
  reflection: `La vie est entre l'événement et la louange. Tout doit tendre vers la glorification.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fasabbih bi-ismi Rabbika al-'azim » — glorifie le Nom de ton Seigneur, le Très Grand." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je glorifie le Nom d'Allah ? Est-ce que ma vie est une glorification ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification n'est pas que des mots — elle est une vie entière tournée vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers glorifie Allah par son existence. L'homme Le glorifie par sa conscience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie le Nom du Très Grand participe à Sa grandeur." }
  ],
  munajat: `Ya 'Azim, je glorifie Ton Nom. Fais que ma vie entière soit une glorification de Ton Nom béni.`
};

// ============================================
// SURAHS 29-56 - COMPREHENSIVE MIROIR EXPANSION
// Task ID: 2-b-continue
// ============================================

// === SURAH 29 - AL-ANKABUT (Additional Verses) ===

MIROIR["29:3"] = {
  reference: "29:3",
  theme: ["épreuve", "patience", "vérité"],
  emotion: "Confrontation lucide",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-'Alim"],
  mirrorVersion: `« Nous avons éprouvé ceux qui ont vécu avant eux ; Allah connaîtra ceux qui disent la vérité et ceux qui mentent. » Le miroir me renvoie une image dérangeante de ma propre authenticité. L'épreuve n'est pas un châtiment — c'est un révélateur. Comme l'or dans le creuset, ce qui est vrai ressort intact, ce qui est faux se consume. Quand je traverse une difficulté, le miroir me demande : qu'est-ce que cette épreuve révèle de moi ? Mon « oui » à Allah dans l'aisance — devient-il un « non » dans l'adversité ?`,
  reflection: `L'épreuve est le test de l'authenticité. La vraie foi n'est pas celle du confort mais celle qui persiste quand tout s'effondre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-ladhina khalaw min qablihim » — ceux qui ont vécu avant eux. L'histoire est un cycle d'épreuves et de révélations." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mes épreuves révèlent ? Suis-je constant ou inconstant ? Le miroir montre la différence entre mes paroles et mes actes." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah connaît déjà la vérité — l'épreuve n'est pas pour Lui, elle est pour moi. C'est moi qui ai besoin de me voir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est testée : la graine dans la terre, l'oiseau dans le vent. L'épreuve est universelle, la réponse est individuelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se connaît dans l'épreuve se connaît vraiment. La facilité masque ; la difficulté révèle." }
  ],
  munajat: `Ya 'Alim, Tu me connais mieux que je me connais. Utilise l'épreuve pour me montrer ma vérité. Et si je suis faux, purifie-moi.`
};

MIROIR["29:4"] = {
  reference: "29:4",
  theme: ["justice", "compte", "issue"],
  emotion: "Mise en garde solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Adl"],
  mirrorVersion: `« Ou bien ceux qui commettent les mauvaises actions pensent-ils qu'ils pourront Nous échapper ? » Le miroir me montre l'illusion de l'impunité. Combien de fois ai-je pensé « personne ne verra » ? Le verset me rappelle que le regard d'Allah n'est pas le regard des hommes. Il n'y a pas de cachette pour le cœur. Le miroir m'interroge : est-ce que je modifie mon comportement selon qui me regarde ? Si oui, alors je n'ai pas encore compris que c'est Allah qui me regarde.`,
  reflection: `Nul ne peut échapper à Allah. Sa connaissance enveloppe tout — les actes visibles et les intentions cachées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am hasiba alladhina ya'malun as-sayyi'ati » — pensent-ils que Nous ne pourrons pas les atteindre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais en cachette ? Qu'est-ce que je cache même à moi-même ? Le miroir pénètre les ténèbres." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité d'échapper est une bonne nouvelle pour le croyant — nulle part où aller sans Sa présence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est témoin. Les anges enregistrent. La terre se souvient. Rien n'est oublié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise qu'il ne peut fuir cesse de fuir — et dans cet arrêt, trouve la paix." }
  ],
  munajat: `Ya Hakam, je ne peux Te fuir. Alors je viens à Toi. Prends ma fuite et transforme-la en retour.`
};

MIROIR["29:6"] = {
  reference: "29:6",
  theme: ["effort", "guidance", "indépendance"],
  emotion: "Responsabilité personnelle",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Ghani"],
  mirrorVersion: `« Quiconque fait effort, le fait pour lui-même. Allah Se suffit à Lui-même et n'a besoin de rien. » Le miroir me libère d'une illusion fondamentale : je ne fais pas de faveur à Allah en L'adorant. L'effort spirituel est un cadeau que je me fais à moi-même. Allah n'a pas besoin de mon adoration — c'est moi qui ai besoin d'adorer. Le miroir me renvoie la responsabilité : ma prière, mon jeûne, mon aumône — tout cela me revient. Allah est Al-Ghani, le Riche par excellence. Je suis le pauvre qui s'enrichit par l'effort.`,
  reflection: `L'effort spirituel n'ajoute rien à Allah — Il est parfait. Mais il ajoute tout à moi. Je suis le bénéficiaire de ma propre transformation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man jahada fa-innama yujahidu li-nafsih » — quiconque fait effort, le fait pour lui-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui est-ce que j'adorer ? Par obligation ? Par peur ? Ou parce que je sais que c'est pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de moi — et c'est précisément ce qui rend Son amour extraordinaire. Il m'aime sans besoin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier adore Allah par sa soumission naturelle. Seul l'homme a le choix — et donc la responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand l'effort devient amour, la distinction entre « pour moi » et « pour Lui » disparaît. Je suis à Lui, et Lui est ma finalité." }
  ],
  munajat: `Ya Ghani, Tu n'as pas besoin de moi mais Tu m'appelles. Je viens, sachant que c'est moi qui profite de chaque pas vers Toi.`
};

MIROIR["29:8"] = {
  reference: "29:8",
  theme: ["famille", "obéissance", "priorité"],
  emotion: "Conflit résolu",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Haqq"],
  mirrorVersion: `« Nous avons enjoint à l'homme de bien traiter ses parents. Mais s'ils t'incitent à M'associer ce dont tu n'as aucune connaissance, ne leur obéis pas. » Le miroir me place devant une tension douloureuse : l'amour pour les parents et l'amour pour Allah. Le verset affirme d'abord le devoir filial — « bien traiter ses parents » — puis trace une limite infranchissable : l'association. Le miroir m'interroge : ai-je des « parents » spirituels — des influences, des traditions, des personnes — qui m'éloignent d'Allah ? Et si oui, ai-je le courage de tracer la limite ?`,
  reflection: `La piété envers les parents est un devoir, mais la piété envers Allah est le devoir suprême. Quand les deux entrent en conflit, Allah prime.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wassayna al-insana bi-walidayhi husna » — Nous avons enjoint à l'homme la bienfaisance envers ses parents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'éloigne d'Allah ? Des parents ? Des amis ? Des habitudes ? Le miroir montre les conflits de loyauté." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Désobéir aux parents pour obéir à Allah n'est pas une vraie désobéissance — c'est une obéissance supérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature suit l'ordre de son Créateur. L'homme seul peut suivre l'ordre de la création contre son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit Allah contre tout le reste découvre qu'Allah lui rend tout le reste — purifié." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Quand les liens terrestres me tirent vers le faux, donne-moi la force de choisir Ta vérité.`
};

MIROIR["29:9"] = {
  reference: "29:9",
  theme: ["foi", "œuvres", "retour"],
  emotion: "Espérance confiante",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Wali"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, Nous les ferons certainement entrer parmi les justes. » Le miroir me montre le chemin clair : foi plus œuvres. La foi sans œuvres est incomplète ; les œuvres sans foi sont vides. Les deux ensemble ouvrent la porte de la compagnie des justes — « as-salihin ». Le miroir m'interroge : suis-je en chemin vers cette compagnie ? Mes croyances et mes actes sont-ils alignés ?`,
  reflection: `La foi et les œuvres sont les deux ailes de l'oiseau spirituel. Une seule aile ne permet pas de voler vers les justes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Walladhina amanu wa 'amilu as-salihati » — ceux qui croient et font de bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi : est-elle visible dans mes actes ? Mes actes : sont-ils nourris par ma foi ? Le miroir révèle l'alignement." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les justes ne sont pas une caste fermée — ils sont ceux qui ont uni foi et œuvre. La porte est ouverte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par cette union : chaque chose « croit » en sa fonction et « agit » selon elle. L'homme doit choisir cette cohérence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "À la fin, on n'est jugé ni sur la foi seule ni sur les œuvres seules — mais sur l'alchimie des deux." }
  ],
  munajat: `Ya Wali, je veux être parmi les justes. Unis ma foi et mes œuvres. Fais que l'une nourrisse l'autre.`
};

MIROIR["29:11"] = {
  reference: "29:11",
  theme: ["connaissance", "foi", "hypocrisie"],
  emotion: "Clarification salvatrice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khallaq"],
  mirrorVersion: `« Allah connaît certainement ceux qui croient et certainement ceux qui sont hypocrites. » Le miroir me place devant une vérité intimidante : Allah voit au-delà des apparences. Je peux dire « je crois » de ma bouche mais mon cœur peut dire autre chose. L'hypocrisie n'est pas seulement le mensonge aux autres — c'est le mensonge à soi-même. Le miroir m'interroge : si Allah ouvrait mon cœur maintenant, qu'y verrait-Il ? Une foi sincère ou une performance sociale ?`,
  reflection: `La connaissance d'Allah est absolue. Rien ne Lui est caché — ni la foi sincère, ni l'hypocrisie cachée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ya'lamanna Allahu alladhina amanu » — Allah connaîtra certainement ceux qui croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur : est-il un avec ma langue ? Y a-t-il un écart entre ce que je dis et ce que je suis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hypocrite pense tromper Allah — mais il ne trompe que lui-même. La vérité finit toujours par éclater." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la création, rien n'est hypocrite. La fleur ne prétend pas être ce qu'elle n'est pas. Seul l'homme peut être deux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guérison de l'hypocrisie commence par l'aveu : « Seigneur, je crains l'hypocrisie en moi. Purifie mon cœur. »" }
  ],
  munajat: `Ya 'Alim, Tu connais mon cœur mieux que moi. Si Tu y trouves de l'hypocrisie, purifie-la. Si Tu y trouves de la foi, renforce-la.`
};

MIROIR["29:12"] = {
  reference: "29:12",
  theme: ["égarement", "responsabilité", "tentation"],
  emotion: "Mise en garde solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Ceux qui ont mécru disent à ceux qui ont cru : \"Suivez notre chemin et nous porterons vos péchés.\" Mais ils ne porteront rien de leurs péchés. Ce sont des menteurs. » Le miroir me montre les fausses promesses de ce monde. Combien de voix me disent « viens, ne t'inquiète pas, nous prendrons la responsabilité » ? La société, les amis, les influences — tous peuvent m'inviter sur des chemins douteux avec des promesses creuses. Mais au Jour du Jugement, chacun portera son propre fardeau. Le miroir m'interroge : qui suis-je en train de suivre ? Et cette personne pourra-t-elle porter mes péchés ?`,
  reflection: `Nul ne peut porter les péchés d'autrui. Chaque âme est responsable d'elle-même. Les promesses d'impunité sont des mensonges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittabi'u sabilana wal nahmil khatayakum » — suivez notre chemin et nous porterons vos péchés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles voix m'appellent vers ce qui est douteux ? Quelles promesses creuses ai-je acceptées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le seul qui puisse porter les péchés — c'est Celui qui n'a pas de péchés. Et Allah ne porte pas ; Il pardonne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature suit son propre chemin. Personne ne peut marcher pour un autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La véritable liberté, c'est de savoir que je suis seul responsable — et donc seul maître de mon destin." }
  ],
  munajat: `Ya Hadi, protège-moi des fausses promesses et des guides égarés. Je suis seul responsable — aide-moi à bien choisir.`
};

MIROIR["29:13"] = {
  reference: "29:13",
  theme: ["responsabilité", "charge", "jugement"],
  emotion: "Lucidité solennelle",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Wazir"],
  mirrorVersion: `« Ils porteront leurs fardeaux et d'autres fardeaux en plus des leurs. » Le miroir révèle une vérité accablante : non seulement les égarés portent leurs propres péchés, mais ils portent aussi le poids d'avoir égaré les autres. Celui qui invite au mal porte le mal qu'il fait plus le mal qu'il provoque. Le miroir m'interroge : suis-je en train d'alourdir mon fardeau en influençant d'autres ? Chaque conseil que je donne, chaque exemple que je montre — sera pesé.`,
  reflection: `La responsabilité est individuelle ET collective. Celui qui égare les autres ajoute à son propre fardeau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yahmilunna athqalahum wa athqalan ma'a athqalihim » — ils porteront leurs fardeaux et d'autres fardeaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'influence ? Et vers quoi ? Le miroir pèse mon impact sur les autres." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne nouvelle inversée : celui qui guide vers le bien porte son bien PLUS le bien qu'il provoque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action crée des ondes. La pierre jetée dans l'eau ne s'arrête pas à l'impact — elle crée des cercles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sage craint son influence et la surveille. Le fou ignore son impact et s'étonne du résultat." }
  ],
  munajat: `Ya Hasib, chaque action compte, chaque influence pèse. Fais que je sois une source de bien, pas de mal pour les autres.`
};

MIROIR["29:14"] = {
  reference: "29:14",
  theme: ["prophète", "patience", "appel"],
  emotion: "Persévérance admirable",
  difficulty: "débutant",
  relatedNames: ["An-Nuh", "As-Sabur"],
  mirrorVersion: `« Nous avons envoyé Noé vers son peuple. Il resta parmi eux mille ans moins cinquante. » Le miroir me place devant une patience extraordinaire. 950 ans d'appel. 950 ans de rejet. 950 ans d'un message ignoré. Et pourtant, Noé n'a pas abandonné. Le miroir m'interroge : quelle est ma patience dans l'appel ? Combien de temps est-ce que je persévère avant d'abandonner ? Noé me montre que le temps n'est pas le critère — la fidélité l'est.`,
  reflection: `La mission de Noé défie toute logique humaine. Près d'un millénaire d'appel. La patience prophétique n'a pas de limite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-labitha fihim alfa sanatin illa khamsina 'ama » — il resta parmi eux mille ans moins cinquante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma patience quand on m'ignore ? Quand on me rejette ? Le miroir mesure mon endurance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Noé n'a pas échoué — il a été fidèle. Le succès n'est pas le résultat, c'est la persévérance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature patiente. L'eau creuse la pierre non par force mais par constance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte les résultats perd la foi. Celui qui compte la fidélité gagne tout." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience de Noé. Que je ne compte pas les années mais que je compte ma fidélité à Toi.`
};

MIROIR["29:15"] = {
  reference: "29:15",
  theme: ["délivrance", "arche", "signe"],
  emotion: "Gratitude révérencielle",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "An-Naji"],
  mirrorVersion: `« Nous le sauvâmes, lui et les occupants de l'arche, et Nous en fîmes un signe pour l'univers. » Le miroir me montre le schéma divin : l'épreuve, puis la délivrance. L'arche de Noé n'est pas qu'un bateau — c'est le symbole de la protection d'Allah pour ceux qui croient. Le déluge a englouti les négateurs, mais l'arche a porté les croyants. Le miroir m'interroge : suis-je dans l'arche ? Quel est mon refuge quand les eaux montent ?`,
  reflection: `L'arche est un signe éternel : la foi est le seul refuge authentique. Tout le reste coule quand l'épreuve arrive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anjaynahu wa ashab as-safinati » — Nous le sauvâmes, lui et les occupants de l'arche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand les épreuves déferlent, où est mon arche ? La foi ? La famille ? L'argent ? Le miroir montre les vrais refuges." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui sauve Noé n'est pas l'arche — c'est l'ordre d'Allah. L'arche sans l'ordre n'est qu'un bois flotté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arche flotte sur les eaux du déluge comme la foi flotte sur les eaux du doute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La délivrance n'est pas la fin de l'épreuve — c'est la présence d'Allah au milieu de l'épreuve." }
  ],
  munajat: `Ya Munji, sauve-moi comme Tu as sauvé Noé. Fais de ma foi une arche solide dans les tempêtes de la vie.`
};

MIROIR["29:16"] = {
  reference: "29:16",
  theme: ["prophète", "monothéisme", "appel"],
  emotion: "Conviction courageuse",
  difficulty: "débutant",
  relatedNames: ["Al-Ibrahim", "Al-Wahid"],
  mirrorVersion: `« Quand Abraham dit à son peuple : \"Adorez Allah et craignez-Le. Cela est meilleur pour vous, si vous saviez.\" » Le miroir me place face à l'appel primordial d'Abraham : l'adoration exclusive d'Allah. Pas de négociation, pas de compromis. « Adorez Allah » — un verbe, un objet. La simplicité même. « Si vous saviez » — l'invitation à la connaissance. Le miroir m'interroge : est-ce que je sais vraiment ce qui est meilleur pour moi ? Ou est-ce que je suis des traditions aveugles ?`,
  reflection: `L'appel d'Abraham est radical dans sa simplicité : Allah seul. Tout le reste n'est qu'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'budu Allaha wa ttaquh » — adorez Allah et craignez-Le." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon adoration : est-elle exclusive ? Ou suis-je en train d'adorer d'autres « divinités » sans le savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Si vous saviez » — mais on ne peut savoir qu'en goûtant. Le savoir viendra de l'expérience de l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose adore Allah par sa nature. L'homme seul a besoin d'être invité à faire ce qui est naturel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul découvre que toutes les autres « adorations » étaient des chaînes déguisées." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Fais que mon adoration soit uniquement pour Toi. Détache-moi des fausses divinités.`
};

MIROIR["29:17"] = {
  reference: "29:17",
  theme: ["idolâtrie", "provision", "indépendance"],
  emotion: "Révélation libératrice",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Ghani"],
  mirrorVersion: `« Vous adorez en dehors d'Allah des idoles et vous inventez des mensonges. Ceux que vous adorez en dehors d'Allah ne possèdent aucune provision pour vous. » Le miroir me montre mes fausses sources de sécurité. Les idoles du peuple d'Abraham étaient des statues — mais mes idoles peuvent être mon travail, mes relations, mon statut. Le verset me rappelle : toutes ces choses ne possèdent aucune provision pour moi. Elles ne donnent que ce qu'Allah permet. Le miroir m'interroge : où est-ce que je cherche ma provision ?`,
  reflection: `Les idoles ne nourrissent pas. Seul Allah nourrit. Chercher la provision ailleurs est une erreur de source.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama ta'buduna min duni Allahi awthana » — vous adorez en dehors d'Allah des idoles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes idoles modernes ? Qu'est-ce que je crains de perdre comme si c'était ma source de vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles ne donnent rien — mais elles prennent tout : mon temps, mon cœur, ma priorité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque provision dans l'univers vient d'Allah. La faim elle-même est un rappel de notre dépendance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand on coupe le lien avec l'idole, on ne perd rien — on gagne la Source directe." }
  ],
  munajat: `Ya Raziq, Tu es mon Pourvoyeur. Coupe mon attachement aux idoles. Fais que je reconnaisse que toute provision vient de Toi.`
};

MIROIR["29:18"] = {
  reference: "29:18",
  theme: ["message", "responsabilité", "désaveu"],
  emotion: "Clarté rassurante",
  difficulty: "débutant",
  relatedNames: ["Al-Baligh", "Ash-Shahid"],
  mirrorVersion: `« Si vous niez, d'autres nations avant vous ont nié. Il n'incombe au Messager que de transmettre clairement. » Le miroir me libère du fardeau du résultat. Le Prophète — et tout porteur de message — n'est responsable que de la transmission, pas de l'acceptation. Le rejet n'est pas un échec du messager. Le miroir m'interroge : quand je partage la vérité, est-ce que je m'accroche au résultat ? Ou est-ce que je fais ma part et je laisse le reste à Allah ?`,
  reflection: `La responsabilité du messager s'arrête à la transmission claire. L'acceptation appartient à celui qui écoute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama 'ala ar-rasuli al-balaghu al-mubin » — il n'incombe au Messager que de transmettre clairement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je parle, est-ce clair ? Est-ce que je transmets ou est-ce que j'essaie de convaincre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désaveu des autres n'est pas un échec du message — c'est un choix dont ils sont responsables." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers transmet sans s'attacher au résultat. Le soleil brille, peu importe qui le regarde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie transmission se fait par l'être, pas par les mots. Sois le message. Le reste suivra." }
  ],
  munajat: `Ya Baligh, aide-moi à transmettre clairement. Et libère-moi du besoin de contrôler les résultats.`
};

MIROIR["29:19"] = {
  reference: "29:19",
  theme: ["création", "résurrection", "contemplation"],
  emotion: "Émerveillement reconnaissant",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Ba'ith"],
  mirrorVersion: `« N'ont-ils pas vu comment Allah commence la création puis la recommence ? Cela est facile pour Allah. » Le miroir m'invite à observer la création comme un livre ouvert. Chaque jour, je vois la mort et la renaissance : la feuille qui tombe, la graine qui germe. Le cycle est devant mes yeux. La résurrection n'est pas une nouveauté — c'est le prolongement d'un processus que je vois chaque jour. Le miroir m'interroge : est-ce que je regarde vraiment la création ? Ou est-ce que je passe à côté sans voir ?`,
  reflection: `La création quotidienne est une preuve de la résurrection. Qui peut commencer peut recommencer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awalam yaraw kayfa yubdi'u Allah al-khalqa thumma yu'iduh » — n'ont-ils pas vu comment Allah commence la création puis la recommence ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois dans la nature ? Un décor ou un message ? Le miroir m'invite à voir avec les yeux du cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection n'est pas un miracle isolé — c'est le cycle naturel de l'existence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque saison est une résurrection. Chaque lever de soleil est un rappel : qui peut faire cela peut tout faire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la création ne peut pas douter du Créateur. L'œuvre prouve l'Artisan." }
  ],
  munajat: `Ya Khaliq, montre-moi Ta création avec Tes yeux. Fais que chaque feuille, chaque fleur me parle de Ta puissance.`
};

MIROIR["29:21"] = {
  reference: "29:21",
  theme: ["châtiment", "miséricorde", "balance"],
  emotion: "Espérance prudente",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'azzib", "Ar-Rahman"],
  mirrorVersion: `« Il châtie qui Il veut et fait miséricorde à qui Il veut. » Le miroir me place devant la souveraineté absolue d'Allah. Je ne peux ni mériter la miséricorde par mes œuvres ni l'exiger par mon statut. Elle est don, pur don. Mais ce verset n'est pas une menace — c'est une invitation à l'humilité. Je ne contrôle pas le verdict, mais je peux orienter mon cœur vers la miséricorde. Le miroir m'interroge : sur quoi compte-je ? Sur mes mérites ou sur Sa grâce ?`,
  reflection: `La miséricorde d'Allah précède Sa colère. « Ma miséricorde embrasse toute chose » (7:156). Mais elle n'est pas automatique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yu'adhdhibu man yasha'u wa yarhamu man yasha' » — Il châtie qui Il veut et fait miséricorde à qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je en sécurité ou en danger ? Le miroir montre que la réponse dépend de mon orientation vers la miséricorde." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde n'est pas un dû — c'est un cadeau. Le châtiment n'est pas une injustice — c'est une conséquence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est tenu par cette balance : justice et miséricorde. L'un sans l'autre serait incomplet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère la miséricorde tout en craignant le châtiment marche sur le chemin droit." }
  ],
  munajat: `Ya Rahman, je ne mérite rien mais j'espère tout de Ta miséricorde. Fais que je sois parmi ceux que Tu veux.`
};

MIROIR["29:22"] = {
  reference: "29:22",
  theme: ["fuite", "omniprésence", "impuissance"],
  emotion: "Réalisation accablante",
  difficulty: "débutant",
  relatedNames: ["Al-Muhit", "Al-Qahhar"],
  mirrorVersion: `« Vous ne pourrez vous échapper ni sur terre ni dans le ciel. Et vous n'avez, en dehors d'Allah, ni protecteur ni secoureur. » Le miroir me montre l'absurdité de la fuite. Où irais-je ? La terre et le ciel Lui appartiennent. Il n'y a pas de cachette dans la création. Le miroir m'interroge : est-ce que j'essaie de fuir quelque chose en ce moment ? Une responsabilité ? Un rappel ? Une épreuve ? Et où est-ce que je cours ?`,
  reflection: `Nulle part où fuir. Nul protecteur en dehors d'Allah. La fuite elle-même est une illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma lakum min duni Allahi min waliyyin wa la nasir » — vous n'avez, en dehors d'Allah, ni protecteur ni secoureur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fuis ? Et vers quoi ? Le miroir montre que toute fuite est un cercle qui ramène à Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité de fuir n'est pas une prison — c'est une sécurité. On ne peut pas perdre Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque atome contient Sa présence. L'espace Lui appartient. Il n'y a pas de « dehors »." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand on arrête de fuir, on découvre qu'on était déjà là où on voulait aller." }
  ],
  munajat: `Ya Muhit, Tu m'entoures de toutes parts. Je ne peux pas Te fuir — alors je viens à Toi. Sois mon Protecteur et mon Secoureur.`
};

MIROIR["29:23"] = {
  reference: "29:23",
  theme: ["mécréance", "désespoir", "fermeture"],
  emotion: "Avertissement solennel",
  difficulty: "débutant",
  relatedNames: ["Al-Ra'uf", "Al-Wali"],
  mirrorVersion: `« Ceux qui ne croient pas aux signes d'Allah et à Sa rencontre, ce sont eux qui ont désespéré de Ma miséricorde. » Le miroir établit un lien que je n'avais pas vu : le désespoir de la miséricorde est lié au rejet des signes. Ce n'est pas Allah qui ferme la porte — c'est celui qui refuse de voir les signes qui se ferme lui-même. Le miroir m'interroge : quels signes est-ce que j'ignore ? Quelles rencontres est-ce que j'évite ?`,
  reflection: `Le désespoir n'est pas un état passif — c'est le résultat actif du refus de croire. On se ferme soi-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ula'ika qanitu min rahmati » — ce sont eux qui ont désespéré de Ma miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon désespoir ? Et qu'est-ce que je refuse de voir qui pourrait le dissiper ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde est toujours là — mais il faut les yeux pour la voir. Les signes sont les lunettes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Chaque souffle est une miséricorde. Refuser de voir, c'est se priver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche les signes les trouve partout. Celui qui les refuse ne les voit nulle part." }
  ],
  munajat: `Ya Ra'uf, ne me laisse pas désespérer. Ouvre mes yeux à Tes signes. Fais que je Te rencontre dans chaque moment.`
};

MIROIR["29:24"] = {
  reference: "29:24",
  theme: ["rejet", "menace", "soutien"],
  emotion: "Réconfort divin",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Wali"],
  mirrorVersion: `« La réponse de son peuple ne fut que : \"Tuez-le ou brûlez-le.\" Mais Allah le sauva du feu. » Le miroir me montre l'ingratitude extrême et la protection extrême. Le peuple d'Abraham répond à son appel par le meurtre. Mais Allah répond par le salut. Le feu qui devait le consumer ne consume que ses liens. Le miroir m'interroge : quand je fais face au rejet, est-ce que je me souviens qu'Allah est mon Sauveur ?`,
  reflection: `Le feu des hommes ne peut pas brûler celui qu'Allah protège. Le rejet humain ne peut pas vaincre le soutien divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anjaynahu min an-nar » — Nous le sauvâmes du feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels feux menacent ma vie ? Et où est mon confiance — dans les pompiers humains ou dans le Sauveur divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu qui brûle peut aussi illuminer. Ce qui détruit peut purifier. Tout dépend de qui tient la flamme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu est soumis à Allah. Il brûle ce qu'Il veut, épargne ce qu'Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Dans le feu de l'épreuve, on ne peut qu'être consumé — ou traverser, comme Abraham, protégé par une autre main." }
  ],
  munajat: `Ya Nasir, sauve-moi des feux de cette vie. Quand les hommes me rejettent, sois mon refuge et mon salut.`
};

MIROIR["29:25"] = {
  reference: "29:25",
  theme: ["idolâtrie", "amitié", "jugement"],
  emotion: "Réalisation lucide",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Mawla"],
  mirrorVersion: `« Vous avez adopté des idoles en dehors d'Allah, par affection mutuelle en ce bas monde. Ensuite, au Jour de la Résurrection, vous vous renierez les uns les autres. » Le miroir me révèle la fragilité des amitiés basées sur le faux. Les idoles que j'adore — statuts, opinions, conformité sociale — créent des liens artificiels. Mais au Jour du Jugement, chacun sera seul. Les complices du mal deviendront ennemis. Le miroir m'interroge : sur quoi reposent mes amitiés ? Sur le faux partagé ou sur le vrai recherché ?`,
  reflection: `Les amitiés basées sur l'égarement s'effondrent au Jugement. Seules les amitiés en Allah subsistent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tatakhaluna ba'dukum ba'dan » — vous vous renierez les uns les autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes amis ? Et pourquoi ? Parce que nous partageons le faux ou parce que nous cherchons le vrai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amitié en Allah ne se renie pas — elle s'éternise. Le vrai lien transcende ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les atomes s'unissent par affinité naturelle. Les âmes s'unissent par affinité spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'ami véritable est celui qui te rappelle Allah, pas celui qui t'éloigne de Lui." }
  ],
  munajat: `Ya Wali, purifie mes amitiés. Fais qu'elles soient basées sur Toi, non sur les idoles de ce monde.`
};

MIROIR["29:26"] = {
  reference: "29:26",
  theme: ["foi", "migration", "abandon"],
  emotion: "Courage résolu",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Hadi"],
  mirrorVersion: `« Lot crut en lui. Il dit : \"J'émigre vers mon Seigneur. C'est Lui le Tout-Puissant, le Sage.\" » Le miroir me montre la réponse immédiate de Lot : la foi. Pas d'hésitation, pas de calcul. Et puis la migration — « hijra » — le départ vers Allah. Le miroir m'interroge : quelle est ma réponse à l'appel divin ? Suis-je prêt à « émigrer » — à quitter mes zones de confort pour aller vers mon Seigneur ?`,
  reflection: `La hijra n'est pas seulement géographique — elle est intérieure. Quitter le connu pour l'Inconnu, le confort pour la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu huwa al-'Azizu al-Hakim » — c'est Lui le Tout-Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dois quitter pour aller vers Allah ? Une habitude ? Un attachement ? Une peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La migration vers Allah n'est pas une perte — c'est un gain. On quitte le limité pour l'Illimité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création « migre » vers Allah. L'eau vers la mer, l'air vers le ciel, l'âme vers son Origine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie hijra est le mouvement du cœur. Le corps peut rester, le cœur peut partir." }
  ],
  munajat: `Ya 'Aziz, ya Hakim, je veux émigrer vers Toi. Montre-moi ce que je dois quitter et donne-moi le courage de partir.`
};

MIROIR["29:27"] = {
  reference: "29:27",
  theme: ["bénédiction", "prophétie", "postérité"],
  emotion: "Gratitude reconnaissante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahhab", "Ar-Rahim"],
  mirrorVersion: `« Nous lui donnâmes Isaac et Jacob, et Nous plaçâmes dans sa descendance la prophétie et le Livre. » Le miroir me montre la continuité de la bénédiction. Abraham reçoit — et sa descendance reçoit après lui. La prophétie et le Livre traversent les générations. Le miroir m'interroge : qu'est-ce que je transmets ? Quelle est ma « descendance » — biologique ou spirituelle — qui bénéficiera de ce que j'ai reçu ?`,
  reflection: `La bénédiction n'est pas pour soi seul — elle traverse les générations. Recevoir et transmettre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna fi dhurriyyatihi an-nubuwwata wa al-kitab » — Nous plaçâmes dans sa descendance la prophétie et le Livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je laisse derrière moi ? Quelle bénédiction traverse par moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plus grande descendance d'Abraham n'est pas biologique — elle est spirituelle. Les croyants sont ses enfants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération hérite et transmet. La chaîne ne se brise que par l'ingratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit avec gratitude transmet avec générosité. La bénédiction circule." }
  ],
  munajat: `Ya Wahhab, merci pour ce que j'ai reçu. Fais que je transmette avec fidélité ce qui m'a été donné.`
};

MIROIR["29:28"] = {
  reference: "29:28",
  theme: ["prophète", "déviance", "appel"],
  emotion: "Tristesse active",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-'Adl"],
  mirrorVersion: `« Et Lot, quand il dit à son peuple : \"Vous commettez une turpitude que nullement n'a commise avant vous.\" » Le miroir me place devant l'appel courageux de Lot. Il nomme le mal — sans ambages, sans concession. Son peuple pratique ce que personne n'avait fait avant. Le miroir m'interroge : est-ce que je nomme les maux de mon temps ? Ou est-ce que je me tais par peur du conflit ?`,
  reflection: `Nommer le mal est le premier pas vers sa guérison. Le silence devant la turpitude est une complicité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innakum la'tauna al-fahishata » — vous commettez une turpitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels maux est-ce que je refuse de nommer ? Quelles turpitudes est-ce que je tolère par confort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui est « nouveau » dans le mal n'est pas progrès — c'est dégradation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature a ses lois. Les violer n'est pas liberté — c'est auto-destruction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui nomme le mal au risque d'être rejeté ressemble aux prophètes." }
  ],
  munajat: `Ya Hadi, donne-moi le courage de nommer le mal quand je le vois. Protège-moi de la complicité par silence.`
};

MIROIR["29:31"] = {
  reference: "29:31",
  theme: ["anges", "annonce", "jugement"],
  emotion: "Révélation terrifiante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Qadi"],
  mirrorVersion: `« Quand Nos anges apportèrent la bonne nouvelle à Abraham, ils dirent : \"Nous allons anéantir les habitants de cette cité.\" » Le miroir me place à l'intersection de la bonne et de la mauvaise nouvelle. Pour Abraham et Lot, c'est le salut. Pour le peuple de Lot, c'est la destruction. Le même message porte deux réalités selon celui qui l'entend. Le miroir m'interroge : quelle nouvelle vais-je recevoir d'Allah ? La bonne ou la mauvaise ?`,
  reflection: `Le message d'Allah est un — mais l'effet diffère selon l'état du receveur. Pour le croyant, guidance. Pour le mécréant, condamnation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna muhliku ahli hadhihi al-qaryah » — Nous allons anéantir les habitants de cette cité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel message m'attend ? Le salut ou la destruction ? Le miroir invite à la préparation." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction d'un peuple injuste est une miséricorde pour l'univers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est maintenu par la balance. Quand le mal dépasse la mesure, la correction vient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque annonce porte en elle le jugement — pour le bien ou pour le mal, selon le cœur qui reçoit." }
  ],
  munajat: `Ya Qadi, Ton jugement est juste. Prépare-moi pour la bonne nouvelle. Épargne-moi de la mauvaise.`
};

MIROIR["29:32"] = {
  reference: "29:32",
  theme: ["intercession", "famille", "sauvetage"],
  emotion: "Inquiétude compatissante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Munji", "Al-Wali"],
  mirrorVersion: `« Il dit : \"Mais Lot s'y trouve.\" Ils dirent : \"Nous savons parfaitement qui s'y trouve.\" » Le miroir me montre l'intercession d'Abraham pour Lot. Il s'inquiète pour son neveu. Mais les anges le rassurent : Allah sait qui est là. Le sauvetage de Lot est déjà programmé. Le miroir m'interroge : pour qui est-ce que je m'inquiète ? Et est-ce que je sais qu'Allah connaît parfaitement leur situation ?`,
  reflection: `L'intercession est naturelle pour le cœur compatissant. Mais Allah connaît mieux que nous qui mérite d'être sauvé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nahnu a'lamu bi-man fiha » — Nous savons parfaitement qui s'y trouve." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon inquiétude pour les autres : est-elle fondée sur la confiance en Allah ou sur le doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de notre intercession pour savoir qui sauver — mais Il aime notre compassion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est connue d'Allah. Pas une feuille ne tombe sans Sa connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui intercède ressemble à Allah qui intercède pour Ses serviteurs." }
  ],
  munajat: `Ya 'Alim, Tu connais la situation de ceux que j'aime. Je Te les confie. Sauve qui peut être sauvé.`
};

MIROIR["29:33"] = {
  reference: "29:33",
  theme: ["détresse", "réconfort", "sauvetage"],
  emotion: "Soulagement profond",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Al-Wali"],
  mirrorVersion: `« Quand Nos anges vinrent à Lot, il fut contrarié pour eux et se sentit impuissant à les protéger. » Le miroir me montre Lot dans la détresse. Il veut protéger ses hôtes mais il se sent faible. Et les anges le rassurent : « Nous sommes les anges de ton Seigneur. » La protection vient d'en haut. Le miroir m'interroge : quand je me sens impuissant, est-ce que je me souviens que la protection finale vient d'Allah ?`,
  reflection: `L'impuissance humaine précède souvent l'intervention divine. Quand je ne peux plus, Allah peut encore.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tadhak 'alayhim » — ne crains pas pour eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je impuissant ? Et quelle protection divine m'attend que je ne vois pas encore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance est une porte ouverte pour la puissance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature faible est protégée par une force invisible. L'univers est un réseau de soutiens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand je ne peux plus rien faire, c'est souvent qu'Allah va faire quelque chose." }
  ],
  munajat: `Ya Munji, je suis impuissant mais Tu es Tout-Puissant. Interviens là où je ne peux rien faire.`
};

MIROIR["29:34"] = {
  reference: "29:34",
  theme: ["châtiment", "transgression", "justice"],
  emotion: "Sérieux solennel",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Nous ferons descendre sur les habitants de cette cité un châtiment du ciel pour leurs transgressions. » Le miroir me place devant la conséquence inévitable. Les transgressions s'accumulent — et le châtiment descend. Ce n'est pas une vengeance — c'est une justice. Le miroir m'interroge : quelles transgressions est-ce que j'accumule ? Et quel châtiment prépare-t-il ?`,
  reflection: `Le châtiment ne vient pas sans raison. Il est la réponse aux transgressions accumulées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min as-sama'i 'adhaban bima kanu yafsuqun » — un châtiment du ciel pour leurs transgressions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'accumule ? Des œuvres ou des transgressions ? Le miroir pèse mon compte." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment peut être évité par le repentir. La porte reste ouverte jusqu'au dernier moment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers réagit aux transgressions. Les catastrophes naturelles sont souvent liées aux comportements humains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du châtiment possible est une protection. Celui qui craint ne transgresse pas." }
  ],
  munajat: `Ya 'Adl, Ta justice est parfaite. Pardonne mes transgressions avant qu'elles ne nécessitent une correction.`
};

MIROIR["29:35"] = {
  reference: "29:35",
  theme: ["signe", "ruines", "rappel"],
  emotion: "Méditation grave",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhakkir", "Al-Baqi"],
  mirrorVersion: `« Nous avons laissé de cette cité un signe évident pour des gens qui raisonnent. » Le miroir m'invite à contempler les ruines. Ce qui était une cité florissante est devenu un signe — une leçon. Les ruines parlent. Elles disent : « Nous étions. Nous avons transgressé. Nous avons disparu. » Le miroir m'interroge : est-ce que je raisonne à partir des signes ? Ou est-ce que je passe à côté sans voir ?`,
  reflection: `Les ruines sont des livres ouverts. Qui lit les signes du passé évite les erreurs du futur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad tarakna minha ayatan bayyinah » — Nous avons laissé un signe évident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles ruines contemplé-je ? Les civilisations effondrées ? Les vies brisées ? Que m'enseignent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La ruine n'est pas la fin — c'est le début du rappel. Du négatif naît le positif." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de signes. Les étoiles mortes, les montagnes érodées — tout parle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit les signes ne s'étonne pas de l'effondrement. Il s'étonne de la durée de la miséricorde." }
  ],
  munajat: `Ya Mudhakkir, fais que je lise les signes. Que chaque ruine me rappelle que tout passe, sauf Toi.`
};

MIROIR["29:36"] = {
  reference: "29:36",
  theme: ["prophète", "droiture", "corruption"],
  emotion: "Exhortation claire",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Madin"],
  mirrorVersion: `« Et vers Madyan, leur frère Chou'ayb. Il dit : \"Ô mon peuple, adorez Allah et attendez le Jour dernier. Ne répandez pas la corruption sur terre.\" » Le miroir me place devant l'appel complet de Chou'ayb : adoration du Seigneur, attente du Jour dernier, refus de la corruption. Les trois sont liés. Qui adore Allah vraiment ne corrompt pas la terre. Qui attend le Jour dernier agit avec responsabilité. Le miroir m'interroge : suis-je un corrupteur ou un réparateur ?`,
  reflection: `La corruption sur terre n'est pas seulement écologique — elle est morale, sociale, spirituelle. Tout acte compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la ta'thaw fi al-ardi mufsidin » — ne répandez pas la corruption sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « sème » sur terre ? Du bien ou du mal ? De la réparation ou de la corruption ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La corruption peut être inversée par la réparation. Chaque bien ajouté compense un mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre réagit à ce qu'on lui donne. La corruption appelle la stérilité ; le bien appelle la fertilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui quitte ce monde en laissant plus de bien que de mal a réussi." }
  ],
  munajat: `Ya Rabb, je ne veux pas être un corrupteur. Fais de moi un réparateur de Ta terre.`
};

MIROIR["29:38"] = {
  reference: "29:38",
  theme: ["destruction", "rappel", "héritage"],
  emotion: "Méditation sérieuse",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Baqi"],
  mirrorVersion: `« Et 'Aad et Thamoud. Cela vous est évident grâce à leurs demeures. » Le miroir me montre les vestiges de civilisations disparues. 'Aad et Thamoud — des peuples puissants, des constructions impressionnantes — et tout a disparu. Il ne reste que des ruines et des leçons. Le miroir m'interroge : qu'est-ce qui reste de moi ? Qu'est-ce qui subsistera de mon passage sur terre ?`,
  reflection: `Les civilisations passent. Les constructions s'effondrent. Seul demeure ce qui a été fait pour Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad tabayyana lakum min masakinihim » — cela vous est évident grâce à leurs demeures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma « demeure » — qu'en restera-t-il ? Des murs ? Ou une empreinte spirituelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plus belle demeure est invisible : c'est celle qu'on construit dans les cœurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers recycle tout. Seul l'impact spirituel traverse les cycles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les ruines disent : « Construisez pour l'éternel, pas pour l'éphémère. »" }
  ],
  munajat: `Ya Warith, Tu hérites de la terre et de ce qu'elle porte. Fais que j'hérite de Toi et que Tu hérites de moi purifié.`
};

MIROIR["29:39"] = {
  reference: "29:39",
  theme: ["orgueil", "rejet", "destruction"],
  emotion: "Avertissement solennel",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Et Coré, Pharaon et Haman. Moïse vint à eux avec des preuves évidentes. Mais ils s'enorgueillirent sur terre. » Le miroir me montre le schéma répétitif : le prophète apporte les preuves, les puissants s'enorgueillissent, la destruction suit. L'orgueil est le fil conducteur. Il empêche de voir l'évidence. Le miroir m'interroge : où est mon orgueil ? Quelles « preuves » est-ce que je refuse de voir ?`,
  reflection: `L'orgueil ne refuse pas la vérité par ignorance — il la refuse par arrogance. C'est un choix, pas un hasard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fastakbaru fi al-ardi » — ils s'enorgueillirent sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon orgueil : où se cache-t-il ? Dans mon savoir ? Mon statut ? Mes opinions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil est une prison dont on a la clé — mais qu'on refuse d'utiliser." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne s'enorgueillit pas de sa grandeur. Seul l'homme peut se croire au-dessus de sa condition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'antidote de l'orgueil est la gratitude. Qui rend grâce ne peut s'enorgueillir." }
  ],
  munajat: `Ya Rabb, purifie-moi de l'orgueil. Apprends-moi l'humilité devant Tes preuves.`
};

MIROIR["29:40"] = {
  reference: "29:40",
  theme: ["justice", "proportion", "châtiment"],
  emotion: "Réalisation lucide",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Nous avons pris chacun pour son péché. Il y en eut sur qui Nous avons envoyé une pluie de pierres. Il y en eut que le Cri saisit. Il y en eut que Nous fîmes engloutir par la terre. » Le miroir me montre la diversité des châtiments — mais leur point commun : chacun selon son péché. La justice d'Allah est proportionnée. Pas de punition arbitraire, pas de châtiment immérité. Le miroir m'interroge : quel est « mon » péché ? Et quelle serait « ma » correction ?`,
  reflection: `Chaque péché appelle une correction spécifique. La justice divine est personnalisée, pas générique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullan akhadhna bi-dhanbih » — Nous avons pris chacun pour son péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon péché spécifique : quel est-il ? Et quelle correction lui correspond ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La correction n'est pas vengeance — c'est équilibrage. Le mal doit être compensé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque cause a son effet. La justice est la loi de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se corrige lui-même évite la correction divine." }
  ],
  munajat: `Ya 'Adl, corrige-moi moi-même avant d'être corrigé. Fais que ma correction soit douce, pas violente.`
};

MIROIR["29:41"] = {
  reference: "29:41",
  theme: ["parabole", "faiblesse", "association"],
  emotion: "Réalisation éclairante",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Qawi"],
  mirrorVersion: `« Ceux qui ont pris des protecteurs en dehors d'Allah ressemblent à l'araignée qui s'est fait une maison. La maison de l'araignée est la plus fragile des maisons. » Le miroir me place devant une image saisissante : l'araignée et sa toile. La toile est délicate, belle même — mais si fragile. Un souffle suffit à la déchirer. Ainsi sont les protections que je prends en dehors d'Allah. Elles ont l'apparence de la sécurité, mais elles s'effondrent au premier vent. Le miroir m'interroge : où est ma « toile d'araignée » ?`,
  reflection: `La fragilité de la toile d'araignée est la fragilité de tout refuge en dehors d'Allah. Beau mais vain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalu alladhina ittakhadhu min duni Allahi awliya' » — l'exemple de ceux qui prennent des protecteurs en dehors d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles toiles tisse-je ? L'argent ? Les relations ? Le statut ? Sont-elles solides ou fragiles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La maison d'Allah est indestructible. Pourquoi choisir la fragile quand l'éternelle est disponible ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'araignée tisse par instinct. L'homme tisse par choix. Et son choix révèle son intelligence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la fragilité de ses refuges cherche le Refuge absolu." }
  ],
  munajat: `Ya Qawi, Tu es ma forteresse. Délivre-moi des toiles fragiles que je tisse pour me protéger.`
};

MIROIR["29:42"] = {
  reference: "29:42",
  theme: ["connaissance", "idolâtrie", "vérité"],
  emotion: "Lucidité éclairante",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Haqq"],
  mirrorVersion: `« Allah sait ce qu'ils invoquent en dehors de Lui. C'est Lui le Tout-Puissant, le Sage. » Le miroir me rassure et m'alerte. Allah sait — rien ne Lui échappe. Les idoles que j'invoque, conscientes ou inconscientes, sont connues de Lui. Le miroir m'interroge : si Allah ouvrait un inventaire de mes invocations, que verrait-Il ? Vers quoi me tourne-je vraiment quand j'ai besoin ?`,
  reflection: `Allah connaît mes fausses divinités même quand je ne les nomme pas. Rien n'est caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu ya'lamu ma yad'una min dunihi » — Allah sait ce qu'ils invoquent en dehors de Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans le stress, dans le besoin : qui j'appelle ? Le miroir révèle mes vraies divinités." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah sait — mais ne condamne pas automatiquement. Il attend le retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute invocation est entendue. La question est : par qui ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'inventaire de mes appels révèle ma carte du cœur." }
  ],
  munajat: `Ya 'Alim, Tu connais mes appels. Purifie-les. Fais que je n'appelle que Toi.`
};

MIROIR["29:43"] = {
  reference: "29:43",
  theme: ["parabole", "compréhension", "sagesse"],
  emotion: "Clarté pédagogique",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Mudhakkir"],
  mirrorVersion: `« Voilà les paraboles que Nous proposons aux gens. Mais seuls les savants les comprennent. » Le miroir m'invite à devenir « savant » — non pas en livres, mais en compréhension. Les paraboles du Coran sont comme des portes : ouvertes pour ceux qui réfléchissent, fermées pour ceux qui passent. Le miroir m'interroge : quelles paraboles est-ce que je comprends ? Et quelles portes reste-t-il à ouvrir ?`,
  reflection: `La parabole est un pont entre le visible et l'invisible. Le savant est celui qui traverse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ya'qqiluha illa al-'ulama' » — seuls les savants les comprennent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je « savant » ? Pas en diplômes — en compréhension des signes." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le savant n'est pas celui qui sait beaucoup — c'est celui qui comprend ce qu'il sait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une parabole. Le savant le lit comme un livre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compréhension est un don — mais un don qui s'obtient par la demande." }
  ],
  munajat: `Ya Hakim, fais de moi un savant — non en paroles, mais en compréhension de Tes paraboles.`
};

MIROIR["29:44"] = {
  reference: "29:44",
  theme: ["création", "vérité", "certitude"],
  emotion: "Assurance profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Khaliq"],
  mirrorVersion: `« Allah a créé les cieux et la terre en toute vérité. Il y a là un signe pour les croyants. » Le miroir m'invite à contempler la création comme manifestation de la vérité. Les cieux et la terre ne sont pas un hasard — ils sont intention, design, vérité. Pour le croyant, chaque étoile, chaque fleur, chaque souffle est un signe. Le miroir m'interroge : vois-je la vérité dans la création ? Ou la réduis-je à du décor ?`,
  reflection: `La création est un livre de vérité. Le croyant est celui qui lit ce livre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa Allahu as-samawati wa al-arda bi al-haqq » — Allah a créé les cieux et la terre en toute vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon regard sur la création : est-ce un regard de croyant ou d'indifférent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité de la création nous renvoie à la vérité du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est la première révélation — avant même le Coran." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vérité dans la création voit Allah partout." }
  ],
  munajat: `Ya Haqq, ouvre mes yeux à la vérité de Ta création. Fais que chaque signe me rapproche de Toi.`
};

MIROIR["29:46"] = {
  reference: "29:46",
  theme: ["dialogue", "respect", "communauté"],
  emotion: "Ouverture sage",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Ar-Rahman"],
  mirrorVersion: `« Ne discutez avec les gens du Livre que de la meilleure manière. » Le miroir m'invite au dialogue respectueux. La discussion n'est pas confrontation — elle est rencontre. Le verset pose un cadre : la meilleure manière. Pas la plus agressive, pas la plus critique — la meilleure. Le miroir m'interroge : comment discute-je avec ceux qui croient différemment ?`,
  reflection: `Le dialogue interreligieux est un devoir — mais dans le respect et la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tujadilu ahla al-kitabi illa bi-allati hiya ahsan » — ne discutez avec les gens du Livre que de la meilleure manière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes discussions : sont-elles des combats ou des échanges ? Le miroir montre ma méthode." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La meilleure manière de discuter n'est pas de convaincre — c'est de comprendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La diversité des croyances est un fait. La qualité du dialogue est un choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le respect de l'autre est aussi le respect de la vérité — car la vérité n'a pas besoin d'agressivité." }
  ],
  munajat: `Ya Rahman, apprends-moi le dialogue respectueux. Fais que je sois une porte ouverte, pas un mur.`
};

MIROIR["29:47"] = {
  reference: "29:47",
  theme: ["Coran", "révélation", "reconnaissance"],
  emotion: "Gratitude profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Hadi"],
  mirrorVersion: `« C'est ainsi que Nous t'avons fait descendre le Livre. Ceux à qui Nous avons donné le Livre y croient. » Le miroir me place devant le don du Coran. Ce Livre n'est pas un hasard — il est une descente, une révélation, un cadeau. Ceux qui connaissent les Écritures précédentes le reconnaissent. Le miroir m'interroge : est-ce que je reconnais la valeur de ce que j'ai reçu ?`,
  reflection: `Le Coran est la continuité de la révélation. Le reconnaître, c'est se reconnecter à la chaîne prophétique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina atayna hum al-kitaba yu'minuna bih » — ceux à qui Nous avons donné le Livre y croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma relation au Coran : est-ce un objet ou une guidance ? Une habitude ou une révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran ne descend pas vers moi — il m'élève vers lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation traverse l'histoire. Chaque Livre est une étape vers le Livre final." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Coran reconnaît la source de toutes les révélations." }
  ],
  munajat: `Ya Karim, merci pour Ton Livre. Fais que je le reconnaisse comme le plus grand des dons.`
};

MIROIR["29:48"] = {
  reference: "29:48",
  theme: ["prophète", "illettrisme", "miracle"],
  emotion: "Émerveillement reconnaissant",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nabi", "Al-Ummi"],
  mirrorVersion: `« Tu ne récitais aucun Livre avant celui-ci. Tu n'écrivais pas de ta main droite. » Le miroir me place devant le miracle du Prophète illettré. Il n'était pas un lettré qui aurait pu composer. Il n'avait pas de préparation littéraire. Et pourtant, il a apporté le plus beau texte. Le miroir m'interroge : est-ce que je reconnais le miracle ? Ou est-ce que je cherche des explications humaines ?`,
  reflection: `L'illettrisme du Prophète est une preuve de l'origine divine du Coran. Nul homme n'aurait pu composer cela.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kunta tatlwa min qablihi min kitab » — tu ne récitais aucun Livre avant celui-ci." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma reconnaissance du miracle : est-elle intellectuelle ou existentielle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le plus grand miracle n'est pas le texte — c'est la transformation qu'il opère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité vient souvent par les canaux les plus inattendus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le miracle du Coran est qu'il transforme le cœur illettré en cœur savant." }
  ],
  munajat: `Ya Rabb, fais que je reconnaisse Ton miracle. Transforme mon cœur illettré par Ta révélation.`
};

MIROIR["29:49"] = {
  reference: "29:49",
  theme: ["Coran", "cœur", "certitude"],
  emotion: "Certitude intérieure",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Yaqin"],
  mirrorVersion: `« C'est plutôt des signes évidents dans les poitrines de ceux qui ont reçu la science. » Le miroir me montre la vraie localisation du Coran : pas sur le papier, mais dans les cœurs. Les signes évidents ne sont pas seulement dans le texte — ils sont gravés dans la poitrine des croyants. Le Coran vit en eux. Le miroir m'interroge : où est mon Coran ? Sur l'étagère ou dans ma poitrine ?`,
  reflection: `Le Coran descend dans le cœur. Le papier n'est que le véhicule. La destination est la poitrine du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi suduri alladhina utu al-'ilma » — dans les poitrines de ceux qui ont reçu la science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur : combien de versets y sont gravés ? Le miroir mesure l'habitation du Coran en moi." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran ne me demande pas de le mémoriser — il me demande de l'habiter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation a besoin d'un réceptacle. Le cœur du croyant est ce réceptacle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Coran dans le cœur devient lumière — et cette lumière guide toutes les décisions." }
  ],
  munajat: `Ya Rabb, fais que Ton Livre descende dans ma poitrine. Qu'il y devienne une lumière qui ne s'éteint jamais.`
};

MIROIR["29:50"] = {
  reference: "29:50",
  theme: ["miracle", "demande", "révélation"],
  emotion: "Patience confiante",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'jiz", "Al-Hadi"],
  mirrorVersion: `« Ils disent : \"Pourquoi n'a-t-on pas fait descendre sur lui des signes de son Seigneur ?\" Réponds : \"Les signes sont auprès d'Allah.\" » Le miroir me place devant l'exigence humaine de miracles spectaculaires. On veut des preuves visibles, des prodiges éclatants. Mais les signes sont auprès d'Allah — et le plus grand signe est déjà là : le Coran. Le miroir m'interroge : quels signes est-ce que j'exige ? Et lesquels est-ce que j'ignore ?`,
  reflection: `Le plus grand miracle est déjà donné : la révélation elle-même. Chercher d'autres signes peut être une fuite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-ayatu 'inda Allah » — les signes sont auprès d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels miracles est-ce que j'attends ? Et quels miracles est-ce que je refuse de voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai miracle n'est pas ce qui étonne — c'est ce qui transforme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un miracle. Mais l'habitude rend invisible l'extraordinaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes présents n'a pas besoin de signes supplémentaires." }
  ],
  munajat: `Ya Mu'jiz, ouvre mes yeux aux signes que Tu as déjà donnés. Je n'ai pas besoin de miracles supplémentaires — j'ai besoin de voir.`
};

MIROIR["29:51"] = {
  reference: "29:51",
  theme: ["Coran", "suffisance", "bénédiction"],
  emotion: "Gratitude satisfait",
  difficulty: "débutant",
  relatedNames: ["Al-Kafi", "Al-Hadi"],
  mirrorVersion: `« Ne leur suffit-il pas que Nous ayons fait descendre sur toi le Livre qui leur est récité ? » Le miroir me place devant la suffisance du Coran. Quoi de plus grand que la Parole d'Allah ? Le Livre qui est récité, médité, vécu — n'est-ce pas le plus grand cadeau ? Le miroir m'interroge : est-ce que le Coran me suffit ? Ou est-ce que je cherche ailleurs ce qu'il contient déjà ?`,
  reflection: `Le Coran est suffisant. Il contient tout ce dont l'âme a besoin. Chercher ailleurs est une distraction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa lam yakfihim anna anzalna 'alayka al-kitaba yutla 'alayhim » — ne leur suffit-il pas que Nous ayons fait descendre le Livre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le Coran me suffit-il ? Ou cherche-je ailleurs des guidances qu'il contient déjà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran n'est pas un livre parmi d'autres — il est le livre qui contient tous les livres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Parole d'Allah précède la création. Elle est la matrice de tout ce qui existe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui pour qui le Coran suffit n'a besoin de rien d'autre." }
  ],
  munajat: `Ya Kafi, le Coran me suffit. Fais que je n'aille pas chercher ailleurs ce qu'il contient déjà.`
};

MIROIR["29:52"] = {
  reference: "29:52",
  theme: ["témoin", "vérité", "jugement"],
  emotion: "Confiance absolue",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Haqq"],
  mirrorVersion: `« Dis : Allah suffit comme témoin entre vous et moi. » Le miroir me place devant le Témoin ultime. Je n'ai pas besoin de convaincre les autres, de prouver ma bonne foi, de me justifier. Allah est témoin — et Son témoignage suffit. Le miroir m'interroge : est-ce que je vis comme si Allah était témoin ? Ou est-ce que je vis pour le regard des autres ?`,
  reflection: `Allah est le Témoin parfait. Son regard suffit. Les opinions humaines sont secondaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kafa bi Allahi shahidan bayni wa baynakum » — Allah suffit comme témoin entre vous et moi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour qui est-ce que je vis ? Le regard d'Allah ou le regard des hommes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Quand Allah est témoin, les autres témoins deviennent superflus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est témoin de tout — le visible et l'invisible, le dit et le non-dit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre comme si Allah était témoin — c'est la définition de la piété." }
  ],
  munajat: `Ya Shahid, Tu es mon Témoin. Fais que je vive pour Ton regard, pas pour celui des hommes.`
};

MIROIR["29:53"] = {
  reference: "29:53",
  theme: ["hâte", "châtiment", "patience"],
  emotion: "Mise en garde lucide",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Muntaqim"],
  mirrorVersion: `« Ils te demandent de hâter le châtiment. S'il n'y avait pas un terme fixé, le châtiment leur serait venu. » Le miroir me montre l'inconscience humaine. On demande le châtiment par défi, par incrédulité. Mais le châtiment existe — il est simplement retardé par la miséricorde. Le terme fixé est une opportunité de repentir. Le miroir m'interroge : est-ce que je profite du délai ? Ou est-ce que je l'utilise pour persister ?`,
  reflection: `Le délai est une miséricorde. Le châtiment n'est pas absent — il est différé pour permettre le retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lawla ajalun musamman la-ja'ahum al-'adhab » — s'il n'y avait pas un terme fixé, le châtiment leur serait venu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment utilise-je le temps ? Pour me rapprocher d'Allah ou pour m'éloigner ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Ce que je demande par défi peut m'arriver par justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses délais. Les conséquences ne sont pas toujours immédiates — mais elles sont certaines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délai est une chance. Chaque jour de plus est un jour de repentir possible." }
  ],
  munajat: `Ya Sabur, utilise le délai pour me rapprocher de Toi. Ne me laisse pas gaspiller la miséricorde du temps.`
};

MIROIR["29:54"] = {
  reference: "29:54",
  theme: ["châtiment", "enveloppement", "certitude"],
  emotion: "Avertissement sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Muhit", "Al-Qahhar"],
  mirrorVersion: `« Ils te demandent de hâter le châtiment. L'Enfer enveloppera les mécréants. » Le miroir me montre l'inéluctabilité. Le châtiment demandé par défi deviendra réalité par justice. L'Enfer n'est pas une métaphore — c'est une destination. « Muhit » — enveloppant. Comme l'eau enveloppe le nageur, le feu enveloppera le mécréant. Le miroir m'interroge : suis-je conscient de la réalité de l'Enfer ? Ou est-ce que je le pousse à l'arrière de mon esprit ?`,
  reflection: `L'Enfer est réel. La demande par défi ne l'empêche pas — elle l'accélère pour le demandeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna jahannama muhitatun bi al-kafirin » — l'Enfer enveloppera les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma conscience de l'Enfer : est-elle vive ou émoussée ? Le miroir ravive la réalité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'Enfer n'est pas une menace — c'est une conséquence. Et toute conséquence peut être évitée par le changement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu existe dans ce monde comme avertissement. Il existera dans l'autre comme réalité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer le fuit. Celui qui ne le craint pas s'en approche." }
  ],
  munajat: `Ya Muhit, préserve-moi de l'Enfer. La peur que j'en ai est une protection. Ne la laisse pas s'éteindre.`
};

MIROIR["29:55"] = {
  reference: "29:55",
  theme: ["châtiment", "totalité", "réalisation"],
  emotion: "Terreur lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Le jour où le châtiment les enveloppera d'en haut et d'en dessous d'eux, et Il dira : \"Goûtez à ce que vous faisiez !\" » Le miroir me montre la totalité du châtiment. Pas d'échappatoire — dessus, dessous, partout. Et la parole finale : « Goûtez à ce que vous faisiez. » Le lien entre l'acte et la conséquence est direct. Le miroir m'interroge : qu'est-ce que je « goûterai » ?`,
  reflection: `Le châtiment est la matérialisation des actes. On goûte ce qu'on a préparé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yaghshahum al-'adhabu min fawqihim wa min tahti arjulihim » — le jour où le châtiment les enveloppera d'en haut et d'en dessous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que suis-je en train de préparer ? Quel goût aura ma récolte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis aussi enveloppe. On goûte ce qu'on a fait — du bien ou du mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est cohérent. La cause et l'effet sont liés dans tous les domaines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le goût de mes actes commence ici — et se prolonge dans l'éternité." }
  ],
  munajat: `Ya Rabb, je ne veux pas goûter le mal que j'ai fait. Efface-le. Fais que je goûte le bien que Tu m'as donné.`
};

MIROIR["29:56"] = {
  reference: "29:56",
  theme: ["adoration", "espace", "appel"],
  emotion: "Invitation expansive",
  difficulty: "débutant",
  relatedNames: ["Al-Wasi", "Al-Hadi"],
  mirrorVersion: `« Ô Mes serviteurs qui avez cru ! Ma terre est vaste. Adorez-Moi donc ! » Le miroir m'ouvre un espace infini. La terre d'Allah est vaste — pourquoi me restreindre à ce qui m'éloigne de Lui ? L'adoration n'a pas de limite spatiale. Partout est lieu de rencontre. Le miroir m'interroge : où est-ce que j'adore ? Et est-ce que je me limite à des lieux ?`,
  reflection: `La terre entière est une mosquée. L'adoration n'a pas de frontières spatiales.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya 'ibadi alladhina amanu inna ardi wasi'atun fa-iyyaya fa'budun » — Ma terre est vaste. Adorez-Moi donc !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où et comment j'adore ? Me limite-je ? Ou explore-je l'espace infini de l'adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vasteté de la terre est une invitation à la vasteté du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un espace d'adoration. Chaque atome chante Sa gloire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est vaste peut adorer partout. La mosquée extérieure reflète la mosquée intérieure." }
  ],
  munajat: `Ya Wasi, Ta terre est vaste et mon cœur est étroit. Élargis mon cœur pour qu'il puisse T'adorer partout.`
};

MIROIR["29:57"] = {
  reference: "29:57",
  theme: ["mort", "destin", "réalité"],
  emotion: "Acceptation lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Toute âme goûtera à la mort. Puis c'est vers Nous que vous serez ramenés. » Le miroir me place devant l'inévitable. La mort n'est pas une possibilité — c'est une certitude. Chaque âme, sans exception, passera par là. Et après ? Le retour vers Allah. Le miroir m'interroge : ai-je « goûté » à la mort dans ma conscience ? Ou est-ce que je vis comme si j'étais éternel ?`,
  reflection: `La mort est le passage obligé. La conscience de la mort transforme la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu nafsin dha'iqatu al-mawt » — toute âme goûtera à la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment la mort influence-t-elle ma vie ? Est-ce que je vis chaque jour comme si c'était le dernier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Goûter à la mort en conscience, c'est commencer à vivre vraiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est soumis au cycle vie-mort-vie. La mort n'est qu'une étape." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte à la mort avant la mort ne la craint plus." }
  ],
  munajat: `Ya Mumit, fais que je goûte à la mort en conscience. Que je vive chaque jour comme un don.`
};

MIROIR["29:58"] = {
  reference: "29:58",
  theme: ["récompense", "demeure", "stabilité"],
  emotion: "Espérance joyeuse",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Wali"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, Nous les installerons certainement dans les hauteurs du Paradis. » Le miroir me montre la destination. La foi et les œuvres mènent aux « hauteurs » — « ghuraf » — les chambres élevées du Paradis. La promesse est certaine — « la-nuskinannahum » — Nous les installerons certainement. Le miroir m'interroge : est-ce que je construis ma demeure d'en haut ? Ou est-ce que je m'attache à celle d'en bas ?`,
  reflection: `Le Paradis a ses niveaux. Les hauteurs sont pour ceux qui élèvent leur foi et leurs œuvres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lanuskinannahum ghurafa mina al-jannah » — Nous les installerons certainement dans les hauteurs du Paradis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où construis-je ? Ici-bas ou là-haut ? Le miroir montre où je place mon investissement." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les hauteurs d'ici-bas sont basses comparées aux hauteurs du Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses niveaux. Chaque élévation spirituelle correspond à une élévation réelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La demeure que je prépare maintenant sera celle que j'habiterai éternellement." }
  ],
  munajat: `Ya Rabb, installe-moi dans les hauteurs. Je ne veux pas les bassesses de ce monde. Élève-moi.`
};

MIROIR["29:59"] = {
  reference: "29:59",
  theme: ["patience", "confiance", "réfuge"],
  emotion: "Sérénité confiante",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Wakil"],
  mirrorVersion: `« Ceux qui patientent et placent leur confiance en leur Seigneur. » Le miroir me montre le duo gagnant : patience et confiance. Les deux vont ensemble. La patience sans confiance est de l'endurance amère. La confiance sans patience est de l'impatience déguisée. Ensemble, elles forment la paire qui mène au succès spirituel. Le miroir m'interroge : ma patience est-elle accompagnée de confiance ? Ou est-ce que j'endure sans croire ?`,
  reflection: `La patience et la confiance sont les deux ailes de l'oiseau spirituel. Sans l'une, l'autre ne peut voler.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina sabaru wa 'ala rabbihim yatawakkalun » — ceux qui patientent et placent leur confiance en leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma patience : est-elle confiante ou résignée ? Le miroir distingue les deux." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance rend la patience douce. Sans elle, la patience est un fardeau." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature patiente et fait confiance. La graine attend sans angoisse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a confiance n'a pas besoin de comprendre — il sait que Celui qui comprend veille." }
  ],
  munajat: `Ya Wakil, je veux patienter avec confiance. Apprends-moi les deux. Fais que ma patience soit habitée par la certitude.`
};

MIROIR["29:60"] = {
  reference: "29:60",
  theme: ["provision", "création", "sustentation"],
  emotion: "Gratitude apaisée",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Khaliq"],
  mirrorVersion: `« Combien de créatures ne portent point leur provision ! Allah les nourrit ainsi que vous. » Le miroir me libère de l'anxiété. Si Allah nourrit les oiseaux qui ne stockent pas, les bêtes qui ne planifient pas — ne me nourrira-t-Il pas, moi qui planifie et stocke ? La provision est Sa responsabilité, pas la mienne. Le miroir m'interroge : où est mon inquiétude pour la provision ? Et où est ma confiance en Celui qui nourrit tout ?`,
  reflection: `La provision vient d'Allah. Les calculs humains sont secondaires. Celui qui pourvoit aux créatures me pourvoit aussi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allah yarzuquhum wa iyyakum » — Allah les nourrit ainsi que vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon anxiété pour la provision : est-elle justifiée ou est-elle un manque de confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je fais mon effort, Allah fait le reste. La provision n'est pas que le résultat de mon travail." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un système de distribution. Chaque créature reçoit sa part." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que la provision vient d'Allah cesse de s'inquiéter et commence à faire confiance." }
  ],
  munajat: `Ya Raziq, Tu nourris toutes les créatures. Nourris-moi aussi. Libère-moi de l'anxiété de la provision.`
};

MIROIR["29:61"] = {
  reference: "29:61",
  theme: ["création", "reconnaissance", "tawhid"],
  emotion: "Réalisation éclairante",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musabbib"],
  mirrorVersion: `« Si tu leur demandes : \"Qui a créé les cieux et la terre ?\" Ils diront : \"Allah.\" » Le miroir me montre que même les associateurs connaissent le Créateur. La question rhétorique obtient la bonne réponse. Le problème n'est pas l'ignorance du Créateur — c'est le refus de L'adorer seul. Le miroir m'interroge : est-ce que je fais le lien entre la connaissance du Créateur et l'adoration exclusive ?`,
  reflection: `Connaître le Créateur ne suffit pas. L'adorer seul est ce qui compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Layaqulunna Allah » — ils diront certainement : \"Allah.\"" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Je connais Allah. Est-ce que je L'adore seul ? Le miroir relie connaissance et pratique." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance sans adoration est un arbre sans fruit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame le Créateur. Seul l'homme peut nier ce que tout proclame." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai tawhid n'est pas seulement de dire « Allah » — c'est de vivre pour Lui seul." }
  ],
  munajat: `Ya Khaliq, Tu es le Créateur. Fais que ma connaissance de Toi se transforme en adoration exclusive.`
};

MIROIR["29:62"] = {
  reference: "29:62",
  theme: ["provision", "abondance", "restriction"],
  emotion: "Acceptation confiante",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Qabid", "Al-Basit"],
  mirrorVersion: `« Allah dispense la provision à qui Il veut parmi Ses serviteurs, ou la mesure. » Le miroir me place devant la sagesse de la distribution. L'abondance pour certains, la restriction pour d'autres — tout est calculé. Je ne peux juger ma provision par comparaison. Chaque portion est dosée par la Sagesse. Le miroir m'interroge : est-ce que j'accepte ma portion ? Ou est-ce que je regarde l'assiette du voisin ?`,
  reflection: `La provision est personnalisée. L'abondance n'est pas toujours bénédiction ; la restriction n'est pas toujours punition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allah yabsutu ar-rizqa li man yasha'u min 'ibadihi wa yaqdiru » — Allah dispense la provision à qui Il veut ou la mesure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma provision : est-ce que je l'accepte ? Ou est-ce que je la compare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La restriction peut être une protection. L'abondance peut être une épreuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature reçoit ce dont elle a besoin — pas plus, pas moins. L'homme seul veut toujours plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est content de sa provision est riche, quelle que soit la quantité." }
  ],
  munajat: `Ya Raziq, j'accepte ma provision. Si elle est restreinte, elle est suffisante. Si elle est abondante, elle est responsabilité. Aide-moi à être content.`
};

MIROIR["29:63"] = {
  reference: "29:63",
  theme: ["miséricorde", "reconnaissance", "gratitude"],
  emotion: "Gratitude éclairée",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mun'im"],
  mirrorVersion: `« Si tu leur demandes : \"Qui fait descendre l'eau du ciel et revivifie la terre après sa mort ?\" Ils diront : \"Allah.\" » Le miroir me montre encore une connaissance universelle. La pluie, la revivification — tout le monde reconnaît que c'est Allah. Mais reconnaître n'est pas remercier. Le miroir m'interroge : est-ce que je remercie pour la pluie ? Pour la vie qui renaît chaque printemps ?`,
  reflection: `La reconnaissance du don doit suivre la reconnaissance du Donateur. Savoir qui donne implique de remercier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Layaqulunna Allah » — ils diront certainement : \"Allah.\"" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Je sais que c'est Allah qui donne. Est-ce que je remercie ? Le miroir relie savoir et gratitude." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pluie est une miséricorde visible. La revivification est un signe de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de l'eau est un cycle de miséricorde. Chaque goutte est un cadeau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la miséricorde dans la pluie voit la miséricorde dans tout." }
  ],
  munajat: `Ya Rahman, merci pour la pluie, pour la vie. Fais que je voie Ta miséricorde partout et que je La remercie toujours.`
};

MIROIR["29:65"] = {
  reference: "29:65",
  theme: ["détresse", "invocation", "sincérité"],
  emotion: "Retour lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Munji"],
  mirrorVersion: `« Quand ils montent sur un navire, ils invoquent Allah, Lui vouant un culte sincère. » Le miroir me montre la sincérité qui émerge dans la crise. Sur le bateau, au milieu des vagues, les cœurs se purifient. Les faux dieux sont oubliés. Seul Allah reste. Le miroir m'interroge : est-ce que j'attends la tempête pour être sincère ? Ou est-ce que je peux l'être dans le calme ?`,
  reflection: `La détresse purifie l'invocation. Mais le croyant véritable invoque sincèrement même dans le confort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha rakibu fi al-fulki da'aw Allaha mukhlisina lahu ad-din » — quand ils montent sur un navire, ils invoquent Allah sincèrement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma sincérité : est-elle constante ou circonstancielle ? Le miroir révèle la différence." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tempête peut être un cadeau si elle me ramène à la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'océan est immense et l'homme est petit. La perspective se rétablit sur l'eau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sincère dans le calme n'a pas besoin de la tempête pour le redevenir." }
  ],
  munajat: `Ya Mujib, je veux être sincère toujours, pas seulement dans la tempête. Purifie mon invocation dans le calme comme dans la crise.`
};

MIROIR["29:66"] = {
  reference: "29:66",
  theme: ["ingratitude", "jouissance", "oubli"],
  emotion: "Mise en garde sérieuse",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Mun'im"],
  mirrorVersion: `« Une fois sauvés, ils commettent des excès sur terre, injustement. » Le miroir me montre le cycle de l'ingratitude. La crise pousse à l'invocation, le salut pousse à l'oubli. Les excès remplacent la gratitude. Le miroir m'interroge : qu'est-ce que je fais après qu'Allah m'a sauvé ? Est-ce que je Lui suis reconnaissant ? Ou est-ce que je retourne à mes anciennes habitudes ?`,
  reflection: `Le salut devrait augmenter la gratitude, pas l'oubli. L'ingratitude après le sauvetage est un grave défaut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yakfuru bima ataynahum wa li yatamatta'u » — pour nier ce que Nous leur avons donné et jouir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Après chaque sauvetage : est-ce que je suis reconnaissant ? Ou est-ce que je retourne à l'oubli ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai test n'est pas la crise — c'est ce qui suit la solution." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature rend grâce naturellement. L'homme seul peut recevoir et oublier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient du sauvetage reste en état de gratitude permanent." }
  ],
  munajat: `Ya Shakur, après chaque sauvetage, fais que je sois reconnaissant. Ne me laisse pas retourner à l'oubli.`
};

MIROIR["29:67"] = {
  reference: "29:67",
  theme: ["sanctuaire", "sécurité", "reconnaissance"],
  emotion: "Gratitude sécurisante",
  difficulty: "débutant",
  relatedNames: ["Al-Haram", "Al-Amin"],
  mirrorVersion: `« N'ont-ils pas vu que Nous avons établi un sanctuaire sûr, alors qu'autour d'eux on se fait ravir ? » Le miroir me montre le contraste : la sécurité à l'intérieur, le danger à l'extérieur. La Mecque est un havre de paix dans un environnement hostile. Ce sanctuaire est un don d'Allah. Le miroir m'interroge : est-ce que je reconnais les sanctuaires dans ma vie ? Les moments de sécurité dans un monde chaotique ?`,
  reflection: `Les sanctuaires de sécurité sont des dons. Les reconnaître est un devoir de gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam yaraw anna ja'alna haraman aminan » — n'ont-ils pas vu que Nous avons établi un sanctuaire sûr ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont mes sanctuaires ? Ma maison ? Ma communauté ? Ma foi ? Est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vrai sanctuaire n'est pas un lieu — c'est un état. La sécurité intérieure dans un monde extérieur hostile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a son refuge. L'oiseau a son nid, le poisson a son banc, le croyant a son sanctuaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le plus grand sanctuaire est le cœur en paix avec Allah." }
  ],
  munajat: `Ya Amin, merci pour mes sanctuaires. Fais que mon cœur soit un sanctuaire de paix dans un monde agité.`
};

MIROIR["29:68"] = {
  reference: "29:68",
  theme: ["mensonge", "injustice", "châtiment"],
  emotion: "Avertissement solennel",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Qui est plus injuste que celui qui invente un mensonge contre Allah ou qui dément la vérité ? » Le miroir me place devant l'injustice suprême : mentir sur Allah. Attribuer à Allah ce qu'Il n'a pas dit, ou nier ce qu'Il a dit — c'est le comble de l'injustice. Le miroir m'interroge : est-ce que je respecte la vérité d'Allah ? Est-ce que je Lui attribue ce qu'Il a dit — ni plus ni moins ?`,
  reflection: `Le mensonge sur Allah est la plus grave des injustices. La vérité doit être préservée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man azlamu mimmani iftara 'ala Allahi kadhiba » — qui est plus injuste que celui qui invente un mensonge contre Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve la vérité d'Allah ? Ou est-ce que je L'adapte à mes désirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité d'Allah est parfaite. La modifier, c'est la corrompre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas. Il témoigne de la vérité. Seul l'homme peut inverser le témoignage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve la vérité d'Allah préserve son propre lien avec Lui." }
  ],
  munajat: `Ya Haqq, préserve-moi de mentir sur Toi. Fais que je dise de Toi ce que Tu as dit de Toi — ni plus, ni moins.`
};

// === SURAH 30 - AR-RUM (Additional Verses) ===

MIROIR["30:2"] = {
  reference: "30:2",
  theme: ["victoire", "défaite", "alternance"],
  emotion: "Espérance confiante",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Mu'izz"],
  mirrorVersion: `« Les Byzantins ont été vaincus. » Le miroir me place devant l'actualité prophétique. Les Byzantins, chrétiens mais gens du Livre, ont été vaincus par les Perses. Pourtant, le Coran annonce leur retour. Ce qui est bas sera élevé, ce qui est élevé sera abaissé. Le miroir m'interroge : quand je vois une situation « perdue », est-ce que je garde espoir ?`,
  reflection: `L'histoire a ses cycles. La défaite n'est pas définitive, ni la victoire. Allah alterne les temps.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ghulibati ar-rum » — les Byzantins ont été vaincus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle situation « perdue » vois-je ? Et quelle espérance puis-je garder ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défaite annonce souvent la victoire. La nuit précède l'aube." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un cycle. Les empires s'élèvent et tombent. Rien n'est permanent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les cycles ne désespère jamais." }
  ],
  munajat: `Ya Fattah, Tu ouvres ce qui est fermé. Dans ma situation « perdue », ouvre une porte de victoire.`
};

MIROIR["30:3"] = {
  reference: "30:3",
  theme: ["victoire", "promesse", "temps"],
  emotion: "Attente confiante",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "As-Sadiq"],
  mirrorVersion: `« Dans la terre la plus proche. Mais après leur défaite, ils seront vainqueurs. » Le miroir me montre la précision coranique. « La terre la plus proche » — la Palestine, la Syrie. Et la promesse : la victoire après la défaite. Le Coran prédit l'imprévisible. Le miroir m'interroge : est-ce que je fais confiance aux promesses d'Allah ?`,
  reflection: `La promesse d'Allah est vérité. Le temps peut sembler long, mais l'accomplissement vient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi adna al-ardi wa hum min ba'di ghalabihim sayaghlibun » — dans la terre la plus proche, mais après leur défaite, ils seront vainqueurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles promesses d'Allah attends-je ? Et avec quelle confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défaite peut être le prélude à une plus grande victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps travaille pour la vérité. L'injustice peut triompher un temps, mais pas toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend avec confiance voit la promesse s'accomplir." }
  ],
  munajat: `Ya Wa'd, Tes promesses sont vérité. Fais que je les attende avec confiance, pas avec impatience.`
};

MIROIR["30:4"] = {
  reference: "30:4",
  theme: ["victoire", "temps", "destin"],
  emotion: "Patience active",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Al-Qadir"],
  mirrorVersion: `« Dans quelques années. L'ordre appartient à Allah, avant comme après. » Le miroir me montre l'horizon temporel. « Bid'a sinin » — quelques années. Pas demain, pas dans un siècle. Quelques années. Et le rappel : l'ordre est à Allah. Le temps est entre Ses mains. Le miroir m'interroge : est-ce que j'accepte le timing d'Allah ?`,
  reflection: `Le temps d'Allah n'est pas le mien. Ses délais ont une sagesse que je ne vois pas toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi bid'i sinin » — dans quelques années." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le délai d'Allah ? Ou est-ce que je veux tout maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde. Le temps permet la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses rythmes. Les saisons ne s'accélèrent pas pour notre impatience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le délai d'Allah reçoit plus que ce qu'il attendait." }
  ],
  munajat: `Ya Rabb, j'accepte Ton délai. Fais que le temps d'attente soit un temps de préparation.`
};

MIROIR["30:5"] = {
  reference: "30:5",
  theme: ["victoire", "promesse", "foi"],
  emotion: "Certitude joyeuse",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Wa'd"],
  mirrorVersion: `« Ce jour-là, les croyants se réjouiront du secours d'Allah. » Le miroir me montre la joie future. Les croyants — pas les Byzantins — se réjouiront. Pourquoi ? Parce que la victoire byzantine sera un signe pour les musulmans. Le secours d'Allah se manifeste. Le miroir m'interroge : est-ce que je me réjouis des victoires d'Allah, même quand elles ne sont pas les miennes ?`,
  reflection: `La victoire d'Allah est source de joie pour tous les croyants. Nous sommes une communauté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma'idhin yafrahu al-mu'minuna bi-nasri Allah » — ce jour-là, les croyants se réjouiront du secours d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Me réjouis-je des victoires des autres ? Ou est-ce que je ne vois que les miennes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie joie est celle du secours d'Allah, pas de la victoire personnelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La victoire de la vérité réjouit tous les alliés de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réjouit du bien où qu'il soit a le cœur large." }
  ],
  munajat: `Ya Nasir, fais que je me réjouisse de Ton secours, partout où il se manifeste.`
};

MIROIR["30:6"] = {
  reference: "30:6",
  theme: ["promesse", "certitude", "foi"],
  emotion: "Confiance absolue",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Haqq"],
  mirrorVersion: `« Promesse d'Allah. Allah ne manque jamais à Sa promesse. Mais la plupart des gens ne savent pas. » Le miroir me place devant la fiabilité absolue d'Allah. « Wa'da Allah » — promesse d'Allah. Et le commentaire : « Allah ne manque jamais à Sa promesse. » Mais la plupart ignorent cette certitude. Le miroir m'interroge : est-ce que je fais partie de ceux qui savent ?`,
  reflection: `La promesse d'Allah est absolument fiable. Le doute vient de l'ignorance, pas de la réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'da Allahi la yukhlifu Allahu wa'dahu » — promesse d'Allah. Allah ne manque jamais à Sa promesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur les promesses d'Allah ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'infidélité aux promesses est humaine. La fidélité absolue est divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tient parce qu'Allah tient Ses promesses. La régularité cosmique est une promesse tenue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah ne doute jamais de Sa parole." }
  ],
  munajat: `Ya Haqq, Ta promesse est vérité. Fais que je sois parmi ceux qui savent, pas parmi ceux qui doutent.`
};

MIROIR["30:7"] = {
  reference: "30:7",
  theme: ["apparence", "réalité", "vision"],
  emotion: "Lucidité éclairée",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Batin", "Al-Khallaq"],
  mirrorVersion: `« Ils connaissent l'apparence de la vie présente. Ils sont inattentifs à l'au-delà. » Le miroir me montre le contraste de vision. L'apparence du monde est visible, l'au-delà est invisible. Les gens s'arrêtent à la surface. Le miroir m'interroge : ma vision s'arrête-t-elle à l'apparence ? Ou est-ce que je vois au-delà ?`,
  reflection: `L'apparence est trompeuse. La réalité se cache derrière. Voir vraiment, c'est voir l'invisible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamuna zahiran mina al-hayati ad-dunya » — ils connaissent l'apparence de la vie présente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je « vois » ? La surface ou la profondeur ? L'apparence ou la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'au-delà est la réalité. Ce monde n'en est que l'ombre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers visible cache l'univers invisible. La matière cache l'énergie. L'apparence cache l'essence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'invisible dans le visible a percé le voile." }
  ],
  munajat: `Ya Batin, ouvre mes yeux à la réalité cachée. Fais que je ne me laisse pas tromper par les apparences.`
};

MIROIR["30:8"] = {
  reference: "30:8",
  theme: ["réflexion", "création", "but"],
  emotion: "Interrogation profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khaliq"],
  mirrorVersion: `« N'ont-ils pas médité sur eux-mêmes ? Allah n'a créé les cieux et la terre que pour une juste fin. » Le miroir m'invite à l'introspection cosmique. Méditer sur soi, c'est méditer sur le tout. La création a un but — une « juste fin ». Rien n'est hasard. Le miroir m'interroge : est-ce que je médite sur ma propre existence ? Sur le sens de ma présence ici ?`,
  reflection: `La méditation sur soi mène à la compréhension du tout. Je ne suis pas séparé de l'univers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam yatafakkaru fi anfusihim » — n'ont-ils pas médité sur eux-mêmes ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que ma propre existence m'enseigne ? Et quelle est ma juste fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le but n'est pas à la fin — il imprègne tout le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a une direction. Chaque chose tend vers sa finalité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît sa fin connaît son chemin." }
  ],
  munajat: `Ya Hakim, j'ai été créé pour un but. Fais que je le connaisse et que je l'accomplisse.`
};

MIROIR["30:9"] = {
  reference: "30:9",
  theme: ["histoire", "puissance", "chute"],
  emotion: "Humilité devant l'histoire",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Mudhakkir"],
  mirrorVersion: `« N'ont-ils pas voyagé sur la terre pour voir la fin de ceux qui les ont précédés ? Ils étaient plus puissants qu'eux. » Le miroir m'invite au voyage historique. Les civilisations passées étaient plus fortes — et pourtant, elles ont disparu. La puissance n'est pas garantie. Le miroir m'interroge : est-ce que je tire les leçons de l'histoire ?`,
  reflection: `L'histoire est maîtresse de vie. Les ruines des civilisations enseignent l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kanu ashadda minhum quwwatan » — ils étaient plus puissants qu'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma puissance : est-elle une garantie ? Ou une responsabilité éphémère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans justice conduit à la chute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les civilisations sont des vagues. Elles montent et descendent. Seul l'éternel demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit l'histoire ne s'enorgueillit jamais." }
  ],
  munajat: `Ya Mudhakkir, l'histoire m'enseigne. Fais que je sois humble et que je tire les leçons du passé.`
};

MIROIR["30:10"] = {
  reference: "30:10",
  theme: ["corruption", "conséquence", "justice"],
  emotion: "Réalisation grave",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hakam"],
  mirrorVersion: `« Puis, la mauvaise fin de ceux qui ont fait le mal, car ils ont traité de mensonges Nos signes. » Le miroir établit le lien entre le comportement et le résultat. La mauvaise fin n'est pas un hasard — elle est la conséquence du rejet des signes. Le miroir m'interroge : quelle « fin » prépare mon comportement actuel ?`,
  reflection: `Le comportement détermine la fin. Le rejet des signes mène à la mauvaise fin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma kana 'aqibatu alladhina asau as-su'a » — puis la mauvaise fin de ceux qui ont fait le mal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon comportement actuel : quelle fin prépare-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne fin est possible par le changement maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action plante une graine. La récolte vient toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui anticipe la fin change le présent." }
  ],
  munajat: `Ya 'Adl, Ta justice est parfaite. Fais que mon comportement prépare une bonne fin.`
};

MIROIR["30:11"] = {
  reference: "30:11",
  theme: ["création", "résurrection", "cycle"],
  emotion: "Contemplation émerveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Mubdi", "Al-Mu'id"],
  mirrorVersion: `« C'est Allah qui commence la création, puis Il la recommence. Puis vous serez ramenés vers Lui. » Le miroir me place devant le cycle divin. Le début, le retour, le rassemblement. Tout mouvement a pour origine et pour destination Allah. Le miroir m'interroge : est-ce que je suis conscient de mon origine et de ma destination ?`,
  reflection: `Nous venons d'Allah et nous retournons à Lui. Le voyage a un début et une fin, et les deux sont Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahi yabda'u al-khalqa thumma yu'iduh » — c'est Allah qui commence la création puis la recommence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où viens-je ? Où vais-je ? Le miroir clarifie le parcours." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour n'est pas la fin — c'est l'accomplissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout cycle dans l'univers pointe vers ce grand cycle : création, retour, rassemblement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine et sa destination ne s'égare pas." }
  ],
  munajat: `Ya Mubdi, ya Mu'id, je viens de Toi et je retourne à Toi. Fais que le voyage soit fidèle.`
};

MIROIR["30:12"] = {
  reference: "30:12",
  theme: ["résurrection", "réalisation", "désespoir"],
  emotion: "Terreur lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Qiyamah", "Al-Haqq"],
  mirrorVersion: `« Le jour où l'Heure se lèvera, les criminels seront dans le désespoir. » Le miroir me projette vers ce moment. L'Heure se lève — et les criminels réalisent. Trop tard. Le désespoir n'est pas le doute ici — c'est la prise de conscience de l'irréversible. Le miroir m'interroge : est-ce que je réalise maintenant, avant qu'il ne soit trop tard ?`,
  reflection: `Le désespoir des criminels vient de la prise de conscience tardive. Le temps de l'action est maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yaqumu as-sa'atu yublisu al-mujrimun » — le jour où l'Heure se lèvera, les criminels seront dans le désespoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma prise de conscience : est-elle maintenant ou sera-t-elle trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désespoir des criminels contraste avec l'espoir des croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure est certaine. Seul le timing est inconnu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise maintenant n'aura pas à désespérer alors." }
  ],
  munajat: `Ya Qiyamah, fais que je réalise maintenant. Ne me laisse pas attendre l'Heure pour comprendre.`
};

MIROIR["30:13"] = {
  reference: "30:13",
  theme: ["idolâtrie", "intercession", "désillusion"],
  emotion: "Désillusion salutaire",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Haqq"],
  mirrorVersion: `« Ils n'auront aucun intercesseur parmi ceux qu'ils associaient. Ils renieront ceux qu'ils associaient. » Le miroir me montre l'effondrement des fausses espérances. Les idoles qu'on invoquait — statuts, richesses, influences — se taisent au moment critique. Le reniement est mutuel : on renie ce qu'on adorait, et ce qu'on adorait ne peut rien pour nous. Le miroir m'interroge : sur quoi fuis-je mon espoir ?`,
  reflection: `Les idoles se taisent au Jour du Jugement. Seul Allah intercède par Sa permission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lam yakun lahum min shuraka'ihim shufa'a' » — ils n'auront aucun intercesseur parmi ceux qu'ils associaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes intercesseurs : qui sont-ils ? Seront-ils là au moment critique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le seul intercesseur utile est celui qu'Allah permet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est direct : chaque chose agit par la permission d'Allah. Les intermédiaires sont limités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui place son espoir en Allah seul n'a pas besoin d'intercesseurs." }
  ],
  munajat: `Ya Wahid, Tu es mon seul espoir. Coupe mon attachement aux fausses idoles.`
};

MIROIR["30:14"] = {
  reference: "30:14",
  theme: ["résurrection", "séparation", "jugement"],
  emotion: "Solennité anticipée",
  difficulty: "débutant",
  relatedNames: ["Al-Fasil", "Al-Qadi"],
  mirrorVersion: `« Le jour où l'Heure se lèvera, ce jour-là ils se sépareront. » Le miroir me montre la grande séparation. Les groupes se distinguent : croyants et mécréants, obéissants et désobéissants. Les mélanges de ce monde prennent fin. La séparation est claire. Le miroir m'interroge : de quel côté serai-je ?`,
  reflection: `Le mélange actuel n'est pas permanent. La séparation viendra, et chaque groupe trouvera sa place.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma taqumu as-sa'atu yawma'idhin yatafarraqun » — le jour où l'Heure se lèvera, ce jour-là ils se sépareront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quel groupe ferai-je partie ? La réponse se construit maintenant." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La séparation n'est pas une punition — c'est une mise en ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tend vers la séparation et l'ordre. Le chaos initial s'organise." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit son groupe maintenant ne sera pas surpris par la séparation." }
  ],
  munajat: `Ya Fasil, place-moi parmi les croyants. Fais que ma séparation soit vers le bien.`
};

MIROIR["30:15"] = {
  reference: "30:15",
  theme: ["récompense", "foi", "œuvre"],
  emotion: "Espérance joyeuse",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Wali"],
  mirrorVersion: `« Quant à ceux qui ont cru et fait de bonnes œuvres, ils seront dans un jardin, heureux. » Le miroir me montre la destination des croyants. Le jardin — « rawdah » — un lieu de délices. Heureux — « yuhbarun » — dans un état de joie. La foi et les œuvres portent leurs fruits. Le miroir m'interroge : est-ce que je construis ce bonheur ?`,
  reflection: `Le bonheur éternel est le fruit de la foi et des œuvres. La plantation se fait ici, la récolte là-bas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ammá alladhina amanu wa 'amilu as-salihati fahum fi rawdatin yuhbarun » — ceux qui ont cru et fait de bonnes œuvres seront dans un jardin, heureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon bonheur futur : est-ce que je le prépare maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bonheur du jardin n'est pas un hasard — c'est le fruit d'une plantation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque graine porte en elle le potentiel du jardin. Chaque foi porte le Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bonheur commence ici — le jardin n'en est que l'extension." }
  ],
  munajat: `Ya Rabb, je veux être dans Ton jardin. Fais que ma foi et mes œuvres y mènent.`
};

MIROIR["30:16"] = {
  reference: "30:16",
  theme: ["châtiment", "mécréance", "conséquence"],
  emotion: "Avertissement sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Quant à ceux qui ont mécru et traité de mensonges Nos signes et la rencontre de l'au-delà, ils seront présentés au châtiment. » Le miroir me montre l'autre face. La mécréance, le démenti, le rejet de l'au-delà — tout mène au châtiment. La présentation n'est pas une invitation — c'est une confrontation. Le miroir m'interroge : qu'est-ce que je refuse de croire ?`,
  reflection: `Le refus de croire a ses conséquences. Le châtiment n'est pas arbitraire — il est la suite logique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma alladhina kafaru wa kadhdhabu bi-ayatina wa liqa'i al-akhirati » — ceux qui ont mécru et traité de mensonges Nos signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse ? Quels signes est-ce que je traite de mensonges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment peut être évité par l'acceptation maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque rejet crée un vide. Le vide attire la conséquence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes évite la présentation au châtiment." }
  ],
  munajat: `Ya 'Adl, je refuse le châtiment. Fais que j'accepte tous Tes signes et que je croie en la rencontre.`
};

MIROIR["30:18"] = {
  reference: "30:18",
  theme: ["louange", "temps", "permanence"],
  emotion: "Adoration continue",
  difficulty: "débutant",
  relatedNames: ["Al-Hamid", "Al-Majid"],
  mirrorVersion: `« À Lui la louange dans les cieux et la terre, au crépuscule et à midi. » Le miroir m'invite à la louange continue. Les cieux et la terre — partout. Le crépuscule et midi — tout temps. La louange n'a pas de limite spatiale ou temporelle. Le miroir m'interroge : ma louange est-elle continue ou ponctuelle ?`,
  reflection: `La louange d'Allah est permanente. Chaque moment, chaque lieu est une opportunité d'adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lahu al-hamdu fi as-samawati wa al-ardi wa 'ashiyyan wa idha az-zahira » — à Lui la louange dans les cieux et la terre, au crépuscule et à midi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma louange : quand et où ? Est-elle limitée ou continue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La louange n'est pas pour Allah — elle est pour nous. Elle élève celui qui loue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers tout entier Le loue. L'homme s'ajoute au chœur cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui loue en tout temps devient la louange vivante." }
  ],
  munajat: `Ya Hamid, fais que ma louange soit continue. Que chaque moment soit une occasion de T'adorer.`
};

MIROIR["30:19"] = {
  reference: "30:19",
  theme: ["vie", "mort", "résurrection"],
  emotion: "Contemplation émerveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« Il fait sortir le vivant du mort et le mort du vivant. Il redonne vie à la terre après sa mort. » Le miroir me montre les miracles quotidiens. La vie de la mort, la mort de la vie — chaque jour. La terre morte qui verdit — chaque printemps. La résurrection n'est pas une anomalie — c'est le cycle normal. Le miroir m'interroge : est-ce que je vois les résurrections quotidiennes ?`,
  reflection: `La vie jaillit de la mort chaque jour. La résurrection finale n'est qu'une extension de ce cycle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yukhriju al-hayya mina al-mayyiti wa mukhriju al-mayyiti mina al-hayy » — Il fait sortir le vivant du mort et le mort du vivant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles résurrections vois-je ? Les petites me préparent-elles à la grande ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin — c'est un passage vers une autre vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un cycle incessant de vie et de mort. Chaque fin est un début." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la résurrection dans la nature croit à la résurrection finale." }
  ],
  munajat: `Ya Muhyi, Tu fais sortir la vie de la mort. Fais sortir la vie spirituelle de ma mort intérieure.`
};

MIROIR["30:20"] = {
  reference: "30:20",
  theme: ["création", "humanité", "dispersion"],
  emotion: "Humilité reconnaissante",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Parmi Ses signes : Il vous a créés de terre, puis vous voilà des hommes qui se dispersent. » Le miroir me ramène à mon origine : la terre. De la poussière à l'humanité dispersée — quel voyage ! Le signe est dans la création elle-même. Le miroir m'interroge : est-ce que je me souviens de mon origine ? Et est-ce que je contemple ma dispersion comme signe ?`,
  reflection: `De la terre à l'humanité — le voyage est extraordinaire. Chaque être humain est un miracle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min ayatihi an khalaqakum min turabin » — parmi Ses signes : Il vous a créés de terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon origine : la terre. Ma destinée : ? Le miroir relie le début et la fin." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispersion n'est pas éparpillement — c'est expansion du signe divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité est la terre élevée. La poussière devenue consciente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de son origine ne s'enorgueillit jamais." }
  ],
  munajat: `Ya Khaliq, de la terre Tu m'as fait. Fais que je n'oublie jamais mon humble origine.`
};

MIROIR["30:23"] = {
  reference: "30:23",
  theme: ["sommeil", "repos", "signe"],
  emotion: "Gratitude paisible",
  difficulty: "débutant",
  relatedNames: ["Al-Musabbit", "Ar-Rahman"],
  mirrorVersion: `« Parmi Ses signes : votre sommeil la nuit et le jour, et votre quête de Sa grâce. » Le miroir me montre le signe dans l'ordinaire. Le sommeil — cette petite mort quotidienne. La quête — ce mouvement vers la provision. Chaque jour contient ces deux signes. Le miroir m'interroge : est-ce que je vois le signe dans le sommeil ? Et dans mon travail ?`,
  reflection: `Le sommeil et le travail sont des signes. La nuit pour le repos, le jour pour la quête.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min ayatihi manamukum bi al-layli wa an-nahari wa ibtaga'ukum min fadlih » — parmi Ses signes : votre sommeil la nuit et le jour, et votre quête de Sa grâce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon sommeil et mon travail : les vois-je comme signes ou comme routines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sommeil est une soumission. Le travail est une quête. Les deux sont adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers alterne repos et activité. Le rythme est dans tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le signe dans l'ordinaire voit Allah partout." }
  ],
  munajat: `Ya Rahman, merci pour le sommeil et le travail. Fais que les deux soient des adorations.`
};

MIROIR["30:24"] = {
  reference: "30:24",
  theme: ["foudre", "pluie", "vie"],
  emotion: "Émerveillement reconnaissant",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Munazzil"],
  mirrorVersion: `« Parmi Ses signes : Il vous montre l'éclair, objet de crainte et d'espoir. » Le miroir me montre le double visage du signe. L'éclair effraie et espère. La pluie qui suit fait vivre. Le signe n'est pas toujours confortable — mais il est toujours vivant. Le miroir m'interroge : est-ce que je vois les signes même quand ils m'effraient ?`,
  reflection: `L'éclair est à la fois crainte et espoir. La pluie qui suit est vie. Le signe peut être ambigu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yurikumu al-barqa khawfan wa tama'an » — Il vous montre l'éclair, objet de crainte et d'espoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes m'effraient ? Et quels espoirs portent-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte et l'espoir sont les deux ailes de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature a ses beautés et ses dangers. Les deux sont signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille le signe même effrayant découvre l'espoir caché." }
  ],
  munajat: `Ya Muhyi, dans la crainte, montre-moi l'espoir. Fais que chaque éclair m'annonce la pluie de Ta grâce.`
};

MIROIR["30:25"] = {
  reference: "30:25",
  theme: ["création", "obéissance", "ordre"],
  emotion: "Révérence soumise",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amr", "Al-Khaliq"],
  mirrorVersion: `« Parmi Ses signes : les cieux et la terre tiennent par Son ordre. Ensuite, quand Il vous appelle, vous sortirez de la terre. » Le miroir me montre l'ordre qui soutient tout. Les cieux et la terre ne tiennent pas par hasard — ils tiennent par « amr ». Et cet ordre appellera les morts. Le miroir m'interroge : est-ce que j'entends l'appel ?`,
  reflection: `L'ordre d'Allah soutient l'univers. Le même ordre nous rappellera à la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min ayatihi an taquma as-sama'u wa al-ardu bi-amrih » — parmi Ses signes : les cieux et la terre tiennent par Son ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vie tient-elle par Son ordre ? Ou par mes propres forces ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre qui maintient l'univers le fera sortir de la terre au Jour de la Résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose obéit à Son ordre. Seul l'homme peut choisir de désobéir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit maintenant répondra facilement à l'appel final." }
  ],
  munajat: `Ya Amir, Ton ordre soutient tout. Fais que j'obéisse à Ton ordre maintenant pour répondre facilement à Ton appel.`
};

MIROIR["30:26"] = {
  reference: "30:26",
  theme: ["création", "obéissance", "soumission"],
  emotion: "Humilité reconnaissante",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« À Lui tous ceux qui sont dans les cieux et la terre. Tous Lui sont soumis. » Le miroir me montre la soumission universelle. Chaque créature, dans les cieux et sur la terre, appartient à Allah et Lui est soumise. L'exception humaine — la possibilité de désobéir — est un choix, pas une nature. Le miroir m'interroge : ma soumission est-elle un choix conscient ?`,
  reflection: `La soumission est la norme de l'univers. La désobéissance humaine est une anomalie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu man fi as-samawati wa al-ard kullun lahu qanitun » — à Lui tous ceux qui sont dans les cieux et la terre. Tous Lui sont soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma soumission : est-elle consciente ou par défaut ? Le miroir mesure l'intention." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie liberté est dans la soumission consciente, pas dans la rébellion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est une symphonie de soumission. Chaque chose joue sa partition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la soumission retrouve l'harmonie universelle." }
  ],
  munajat: `Ya Malik, je suis à Toi. Fais que ma soumission soit un choix conscient et joyeux.`
};

MIROIR["30:28"] = {
  reference: "30:28",
  theme: ["parabole", "association", "justice"],
  emotion: "Réalisation éclairante",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-'Adl"],
  mirrorVersion: `« Il vous propose une parabole tirée de vous-mêmes : avez-vous des associés parmi vos esclaves ? » Le miroir me place devant l'absurdité de l'association. Si je ne partagerais pas ma propriété avec mes serviteurs, comment puis-je associer des créatures à Allah ? La parabole est claire. Le miroir m'interroge : est-ce que je comprends l'absurdité de mes propres associations ?`,
  reflection: `L'association avec Allah est irrationnelle. Nous ne l'accepterions pas pour nous-mêmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakum shuraka'u mimma razaqnakum » — avez-vous des associés parmi ce que Nous vous avons donné ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes « associés » : qui sont-ils ? Et accepterais-je de partager ma propre propriété ainsi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si je n'accepte pas l'association pour moi, comment puis-je l'accepter pour Allah ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a qu'un Maître. Chaque chose reconnaît Son Seigneur unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'absurdité de l'association n'y retombe jamais." }
  ],
  munajat: `Ya Wahid, Tu es Unique. Délivre-moi de toute association, visible ou invisible.`
};

MIROIR["30:29"] = {
  reference: "30:29",
  theme: ["injustice", "ignorance", "égarément"],
  emotion: "Compassion lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Les injustes suivent leurs passions sans connaissance. Qui peut guider celui qu'Allah égare ? » Le miroir me montre le cercle vicieux de l'égarement. L'injustice mène à la passion aveugle, qui mène à l'égarement divin. Qui peut briser le cercle ? Le miroir m'interroge : est-ce que je suis mes passions sans connaissance ?`,
  reflection: `L'injustice aveugle. La passion sans connaissance mène à l'égarement irréversible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Baldara al-ladhina zalamu awhum » — les injustes suivent leurs passions sans connaissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes passions : sont-elles guidées par la connaissance ou par l'aveuglement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est possible tant qu'on la cherche. L'égarement vient quand on refuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne suit pas de passions — il suit l'ordre. L'homme seul peut dévier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son aveuglement peut retrouver la vue." }
  ],
  munajat: `Ya Hadi, guide-moi. Ne me laisse pas suivre mes passions sans connaissance.`
};

MIROIR["30:30"] = {
  reference: "30:30",
  theme: ["nature", "création", "islam"],
  emotion: "Retour authentique",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fitrah", "Al-Khaliq"],
  mirrorVersion: `« Dirige ton visage vers la religion en pur monothéiste. C'est la nature qu'Allah a originellement donnée aux hommes. » Le miroir me montre ma nature profonde. La fitrah — cette inclination innée vers le monothéisme. Je suis fait pour adorer Allah seul. Le détournement est une déformation. Le miroir m'interroge : est-ce que je reviens à ma nature première ?`,
  reflection: `La fitrah est notre nature originelle. Le monothéisme n'est pas étranger — il est naturel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aqim wajhaka li ad-dini hanifa fitrata Allahi allati fatara an-nasa 'alayha » — dirige ton visage vers la religion en pur monothéiste, selon la nature qu'Allah a originellement donnée aux hommes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma nature profonde : suis-je en accord avec elle ? Ou l'ai-je déformée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour à la fitrah n'est pas une régression — c'est une guérison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature suit sa nature. L'homme peut choisir de trahir la sienne — ou de l'honorer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient à sa fitrah trouve la paix originelle." }
  ],
  munajat: `Ya Fatir, Tu m'as créé sur la fitrah. Fais que j'y retourne et que je n'en dévie plus.`
};

MIROIR["30:31"] = {
  reference: "30:31",
  theme: ["repentir", "adoration", "unicité"],
  emotion: "Retour sincère",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Wahid"],
  mirrorVersion: `« Revenez à Lui, craignez-Le, accomplissez la prière et ne soyez pas des associateurs. » Le miroir me donne le programme du retour. Inaba — le retour. Taqwa — la crainte. Salat — la prière. Tawhid — l'unicité. Quatre étapes pour le chemin de retour. Le miroir m'interroge : suis-je sur ce chemin ?`,
  reflection: `Le retour à Allah a des étapes : repentir, crainte, prière, unicité. Chacune est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Munibina ilayhi wa ttaquhu wa aqimu as-salata wa la takunu mina al-mushrikina » — revenez à Lui, craignez-Le, accomplissez la prière et ne soyez pas des associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma pratique : contient-elle les quatre éléments ? Lequel me manque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'association n'est pas seulement les idoles visibles — elle peut être dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier « revient » à Allah par sa soumission naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient vraiment trouve Allah qui l'attend." }
  ],
  munajat: `Ya Tawwab, je reviens à Toi. Accepte mon retour et complète les quatre étapes en moi.`
};

MIROIR["30:32"] = {
  reference: "30:32",
  theme: ["division", "sectes", "égarément"],
  emotion: "Tristesse lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Wahid"],
  mirrorVersion: `« Parmi ceux qui ont divisé leur religion et sont devenus des sectes, chaque groupe se réjouit de ce qu'il a. » Le miroir me montre l'égarement de la division. La religion est une — mais les hommes la fragmentent. Chaque secte se réjouit de sa parcelle, ignorant le tout. Le miroir m'interroge : est-ce que je participe à la division ? Ou est-ce que j'œuvre pour l'unité ?`,
  reflection: `La division de la religion est un égarement. Chaque secte se contente de son fragment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mina alladhina farraqu dinahum wa kanu shiya'an » — parmi ceux qui ont divisé leur religion et sont devenus des sectes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma pratique : est-elle inclusive ou exclusive ? Divisante ou unificatrice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La véritable religion unit. La division est signe d'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un. La diversité ne contredit pas l'unité — elle l'exprime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit l'unité dans la diversité a compris la religion." }
  ],
  munajat: `Ya Jami', unis les cœurs. Fais que je ne sois pas un agent de division mais un artisan d'unité.`
};

MIROIR["30:33"] = {
  reference: "30:33",
  theme: ["détresse", "invocation", "oubli"],
  emotion: "Réalisation lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Ar-Rahman"],
  mirrorVersion: `« Quand un mal atteint les gens, ils invoquent leur Seigneur, en revenant à Lui repentants. » Le miroir me montre le schéma répétitif. Le mal frappe, l'invocation suit. La détresse purifie l'attention. Mais que se passe-t-il quand le mal disparaît ? Le miroir m'interroge : mon invocation est-elle constante ou circonstancielle ?`,
  reflection: `La détresse nous ramène à Allah. Mais la gratitude dans l'aisance est supérieure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza massahu ad-durru da'aw rabbahum munibina ilayhi » — quand un mal atteint les gens, ils invoquent leur Seigneur, en revenant à Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon invocation : est-elle constante ou seulement dans la détresse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation dans l'aisance prépare pour la détresse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers invoque constamment — par son existence même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque constamment n'a pas besoin de la détresse pour se souvenir." }
  ],
  munajat: `Ya Mujib, fais que je T'invoque dans l'aisance comme dans la détresse. Ne me laisse pas attendre le mal pour me souvenir.`
};

MIROIR["30:34"] = {
  reference: "30:34",
  theme: ["ingratitude", "jouissance", "oubli"],
  emotion: "Avertissement sérieux",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Mannan"],
  mirrorVersion: `« Puis quand Nous leur donnons une miséricorde, voilà qu'une partie d'entre eux attribue des associés à leur Seigneur. » Le miroir me montre l'ingratitude après le bienfait. La miséricorde reçue devient occasion d'association. Au lieu de remercier le Donateur, on attribue le don à d'autres causes. Le miroir m'interroge : à qui attribué-je mes bienfaits ?`,
  reflection: `Le bienfait mal utilisé devient un mal. L'ingratitude transforme la bénédiction en malédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yakfuru bima ataynahum » — pour nier ce que Nous leur avons donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes bienfaits : à qui les attribué-je ? À Allah ou à d'autres causes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude transforme le bienfait en bénédiction continue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne nie pas son Créateur. Seul l'homme peut recevoir et oublier la source." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie vraiment ne peut pas associer." }
  ],
  munajat: `Ya Shakur, merci pour Tes bienfaits. Fais que je ne Les attribue qu'à Toi.`
};

MIROIR["30:35"] = {
  reference: "30:35",
  theme: ["révélation", "argument", "association"],
  emotion: "Clarification nécessaire",
  difficulty: "débutant",
  relatedNames: ["Al-Hujjah", "Al-Burhan"],
  mirrorVersion: `« Avons-Nous fait descendre sur eux une autorité qui parle de ce qu'ils Lui associent ? » Le miroir me montre l'absence d'argument divin pour l'association. Les associateurs n'ont aucune révélation qui justifie leur pratique. L'association est une invention humaine, pas une commande divine. Le miroir m'interroge : mes pratiques sont-elles basées sur la révélation ou sur l'invention ?`,
  reflection: `L'association n'a pas de fondement révélé. C'est une invention humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am anzalna 'alayhim sultanan » — avons-Nous fait descendre sur eux une autorité ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes pratiques : sont-elles fondées sur la révélation ou sur la tradition humaine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation invite à l'unicité — pas à l'association." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame l'unicité. L'association est étrangère à la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'argument divin trouve l'unicité." }
  ],
  munajat: `Ya Hujjah, montre-moi Tes arguments. Fais que je ne suive que ce qui vient de Toi.`
};

MIROIR["30:36"] = {
  reference: "30:36",
  theme: ["bienfait", "joie", "ingratitude"],
  emotion: "Mise en garde sérieuse",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Mun'im"],
  mirrorVersion: `« Quand Nous faisons goûter une miséricorde aux gens, ils s'en réjouissent. » Le miroir me montre la réaction naturelle : la joie pour le bienfait. Mais la question est : que fait-on de cette joie ? Est-elle accompagnée de gratitude ? Ou s'arrête-t-elle à la jouissance ? Le miroir m'interroge : ma joie pour les bienfaits est-elle reconnaissante ?`,
  reflection: `La joie du bienfait n'est pas complète sans la gratitude. La jouissance sans remerciement est vide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza massahu al-hasanatu » — quand nous touchés par le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma joie : est-elle reconnaissante ou simplement jouisseuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude augmente la joie. La jouissance seule l'épuise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit et rend grâce. L'homme peut recevoir et oublier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie dans la joie prépare la joie éternelle." }
  ],
  munajat: `Ya Wahhab, merci pour Tes bienfaits. Fais que ma joie soit toujours reconnaissante.`
};

MIROIR["30:37"] = {
  reference: "30:37",
  theme: ["provision", "restriction", "expansion"],
  emotion: "Confiance sereine",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Qabid", "Al-Basit"],
  mirrorVersion: `« N'ont-ils pas vu qu'Allah dispense la provision à qui Il veut ou la restreint ? » Le miroir me place devant la sagesse de la distribution. L'expansion et la restriction ne sont pas arbitraires — elles sont pédagogiques. La restriction enseigne, l'expansion teste. Le miroir m'interroge : est-ce que j'apprends de ma provision ?`,
  reflection: `La provision est dosée avec sagesse. L'expansion et la restriction sont des enseignements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yabsutu ar-rizqa li man yasha'u wa yaqdir » — Il dispense la provision à qui Il veut ou la restreint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma provision : qu'est-ce qu'elle m'enseigne ? La gratitude ou l'ingratitude ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La restriction peut être un cadeau caché. L'expansion peut être un test." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature alterne abondance et rareté. Chaque saison a son enseignement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la sagesse de la provision ne se plaint jamais." }
  ],
  munajat: `Ya Raziq, j'accepte ma provision. Enseigne-moi ce qu'elle a à m'apprendre.`
};

MIROIR["30:38"] = {
  reference: "30:38",
  theme: ["charité", "parenté", "récompense"],
  emotion: "Générosité active",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wahhab"],
  mirrorVersion: `« Donne au proche son dû, au pauvre et au voyageur. Cela est meilleur pour ceux qui cherchent la face d'Allah. » Le miroir me donne le programme de la générosité. Le proche — « dha al-qurba ». Le pauvre — « al-miskin ». Le voyageur — « ibn as-sabil ». Trois bénéficiaires, une récompense : la face d'Allah. Le miroir m'interroge : ma générosité cherche-t-elle la face d'Allah ?`,
  reflection: `La charité a ses destinataires prioritaires. La motivation détermine la récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ati dha al-qurba haqqahu wa al-miskina wa ibna as-sabil » — donne au proche son dû, au pauvre et au voyageur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma charité : va-t-elle aux bons destinataires ? Avec la bonne motivation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La charité ne diminue pas le bien — elle l'augmente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne sans compter. Le soleil illumine gratuitement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne pour la face d'Allah reçoit bien plus qu'il ne donne." }
  ],
  munajat: `Ya Karim, apprends-moi à donner pour Ta face. Fais que ma générosité soit sincère.`
};

MIROIR["30:39"] = {
  reference: "30:39",
  theme: ["usure", "charité", "bénédiction"],
  emotion: "Clarification financière",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Barakah", "Al-Mali"],
  mirrorVersion: `« Ce que vous donnez à usure pour augmenter les biens des gens ne l'augmente pas auprès d'Allah. Mais ce que vous donnez en aumône en cherchant la face d'Allah, ceux-là verront leur récompense multipliée. » Le miroir me montre la différence entre l'augmentation apparente et l'augmentation réelle. L'usure augmente les chiffres mais pas la bénédiction. L'aumône multiplie auprès d'Allah. Le miroir m'interroge : quelle augmentation recherche-je ?`,
  reflection: `L'augmentation visible n'est pas l'augmentation réelle. La bénédiction d'Allah est la vraie richesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ataytum min riban » — ce que vous donnez à usure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes gains : sont-ils bénis ? Quelle augmentation recherche-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aumône augmente vraiment. L'usure augmente en apparence seulement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne sans intérêt. L'arbre donne ses fruits sans demander de retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la bénédiction préfère l'aumône à l'usure." }
  ],
  munajat: `Ya Barakah, bénis mes biens. Fais que je préfère l'augmentation auprès de Toi à l'augmentation apparente.`
};

MIROIR["30:40"] = {
  reference: "30:40",
  theme: ["création", "provision", "mort"],
  emotion: "Révérence reconnaissante",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Raziq", "Al-Mumit"],
  mirrorVersion: `« C'est Allah qui vous a créés, puis vous a pourvus, puis vous fera mourir, puis vous fera revivre. » Le miroir me place devant le cycle divin complet. Création, provision, mort, résurrection — les quatre étapes de notre parcours. Allah est à chaque étape. Le miroir m'interroge : à quelle étape me trouve-je ? Et quel est mon rôle ici ?`,
  reflection: `Le cycle de la vie est entre les mains d'Allah. Chaque étape a son sens et sa responsabilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi khalaqakum thumma razaqakum thumma yumitukum thumma yuhyikum » — c'est Allah qui vous a créés, puis vous a pourvus, puis vous fera mourir, puis vous fera revivre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où suis-je dans ce cycle ? Et comment accomplis-je mon rôle actuel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin — elle est le passage vers la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit ce cycle. Chaque chose est créée, nourrie, puis transformée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le cycle vit chaque étape en paix." }
  ],
  munajat: `Ya Khaliq, Ya Raziq, Ya Mumit, accompagne-moi à chaque étape. Fais que je vive ma provision et prépare ma mort.`
};

MIROIR["30:42"] = {
  reference: "30:42",
  theme: ["corruption", "histoire", "conséquence"],
  emotion: "Leçon historique",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhakkir", "Al-'Adl"],
  mirrorVersion: `« Parcourez la terre et regardez la fin de ceux qui ont précédé. La plupart étaient des associateurs. » Le miroir m'invite au voyage archéologique. Les ruines des civilisations passées — la plupart ont péri à cause de l'association. L'histoire enseigne. Le miroir m'interroge : est-ce que je tire les leçons des civilisations disparues ?`,
  reflection: `L'histoire est un maître. Les civilisations associatrices ont péri. Le tawhid est la voie de survie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anzuru kayfa kana 'aqibatu al-ladhina min qablihim » — regardez la fin de ceux qui ont précédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles leçons tire-je de l'histoire ? Mon association sera-t-elle ma chute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ruines sont des avertissements. Le tawhid est la construction durable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers recycle les civilisations comme il recycle les saisons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Mudhakkir, l'histoire m'enseigne. Fais que je ne répète pas les erreurs des civilisations disparues.`
};

MIROIR["30:43"] = {
  reference: "30:43",
  theme: ["orientation", "jour", "retour"],
  emotion: "Préparation active",
  difficulty: "débutant",
  relatedNames: ["Al-Qiyamah", "Al-Wali"],
  mirrorVersion: `« Ordonne ton visage vers la religion droite, avant qu'un jour vienne d'Allah et qui est inéluctable. » Le miroir m'invite à la préparation urgente. Le jour vient — « la yuraddu » — inéluctable. L'orientation doit précéder l'arrivée. Le miroir m'interroge : suis-je orienté ? Ou est-ce que j'attends le dernier moment ?`,
  reflection: `L'orientation doit précéder le Jour. La préparation ne peut être reportée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aqim wajhaka li ad-dini al-qayyimi min qabli an ya'tiya yawmun la maradda lahu » — oriente ton visage vers la religion droite, avant qu'un jour vienne d'Allah et qui est inéluctable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon orientation : est-elle prise ? Ou est-ce que je diffère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jour inéluctable rend urgente l'orientation d'aujourd'hui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est orienté. Chaque chose a sa direction. L'homme doit choisir la sienne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'oriente maintenant ne sera pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, j'oriente mon visage vers Toi. Fais que cette orientation soit prise maintenant, pas demain.`
};

MIROIR["30:44"] = {
  reference: "30:44",
  theme: ["foi", "mécréance", "responsabilité"],
  emotion: "Responsabilité claire",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Quiconque a mécru, sa mécréance pèse sur lui. Quiconque fait le bien, se prépare à lui-même. » Le miroir me montre l'individuation des conséquences. La mécréance pèse sur le mécréant. Les bonnes œuvres bénéficient à l'ouvrier. Personne ne porte le fardeau d'autrui. Le miroir m'interroge : que pèse-je sur moi-même ?`,
  reflection: `Les conséquences sont personnelles. Chacun prépare son propre sort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kafara fa-'alayhi kufruh » — quiconque a mécru, sa mécréance pèse sur lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je prépare pour moi-même ? Du bien ou du mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bien fait à soi-même est le meilleur investissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte l'individuation. Chaque chose reçoit ce qu'elle mérite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la responsabilité individuelle agit avec soin." }
  ],
  munajat: `Ya 'Adl, je suis responsable de moi-même. Fais que je prépare du bien, pas du mal.`
};

MIROIR["30:45"] = {
  reference: "30:45",
  theme: ["grâce", "mécréance", "reconnaissance"],
  emotion: "Gratitude profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Mun'im"],
  mirrorVersion: `« Afin qu'Il récompense par Sa grâce ceux qui croient et font de bonnes œuvres. Il n'aime pas les mécréants. » Le miroir me montre la motivation divine. La grâce — « fadl » — est la récompense. La foi et les œuvres en sont le canal. L'ingratitude ferme le canal. Le miroir m'interroge : suis-je un canal ouvert pour la grâce ?`,
  reflection: `La grâce d'Allah attend le croyant reconnaissant. L'ingratitude ferme la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li yajziya alladhina amanu wa 'amilu as-salihati min fadlih » — afin qu'Il récompense par Sa grâce ceux qui croient et font de bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon canal à grâce : est-il ouvert ? La foi et les œuvres y circulent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce est disponible. L'obstacle n'est pas chez Allah — il est chez nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un canal de grâce. Chaque chose reçoit et transmet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce devient grâce pour les autres." }
  ],
  munajat: `Ya Wahhab, Ta grâce m'attend. Fais que je sois un canal ouvert par ma foi et mes œuvres.`
};

MIROIR["30:46"] = {
  reference: "30:46",
  theme: ["vent", "navire", "grâce"],
  emotion: "Gratitude contemplative",
  difficulty: "débutant",
  relatedNames: ["Al-Musayyir", "Ar-Rahman"],
  mirrorVersion: `« Parmi Ses signes : Il envoie les vents comme annonceurs de Sa grâce. » Le miroir me montre la douceur de la provision. Les vents annoncent la pluie. Les navires voguent par Sa permission. Le commerce et la découverte sont des dons. Le miroir m'interroge : est-ce que je vois les signes dans les phénomènes naturels ?`,
  reflection: `Les vents sont des messagers de grâce. La navigation est un don. Le commerce est une bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min ayatihi an yursila ar-riyaha mubashshiratin » — parmi Ses signes : Il envoie les vents comme annonceurs de Sa grâce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les vents que je sens : les vois-je comme signes ? Et la navigation comme grâce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vent peut être tempête ou annonce. Tout dépend de la perspective." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'atmosphère est un système de grâce. Le vent distribue la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la grâce dans le vent voit la grâce partout." }
  ],
  munajat: `Ya Musayyir, merci pour les vents et la navigation. Fais que je voie Ta grâce dans chaque souffle.`
};

MIROIR["30:47"] = {
  reference: "30:47",
  theme: ["prophètes", "victoire", "foi"],
  emotion: "Espérance confirmée",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Haqq"],
  mirrorVersion: `« Nous avons envoyé des prophètes à leurs peuples. Ils vinrent avec des preuves. Nous sauvâmes ceux qui crurent. » Le miroir me montre le schéma prophétique. Le prophète vient avec des preuves. Les croyants sont sauvés. Les mécréants subissent les conséquences. Le miroir m'interroge : est-ce que je reconnais les prophètes et leurs preuves ?`,
  reflection: `Le schéma prophétique est constant : prophète, preuves, salut des croyants, perte des mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-najja alladhina amanu » — Nous sauvâmes ceux qui crurent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi : suis-je du côté des sauvés ou du côté des perdants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le salut n'est pas magique — il est la conséquence de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un cycle de prophètes et de réponses. Chaque réponse compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les prophètes et leurs preuves est déjà sauvé." }
  ],
  munajat: `Ya Nasir, sauve-moi comme Tu as sauvé les croyants de chaque époque. Je reconnais Tes prophètes et leurs preuves.`
};

MIROIR["30:48"] = {
  reference: "30:48",
  theme: ["pluie", "vie", "création"],
  emotion: "Émerveillement reconnaissant",
  difficulty: "débutant",
  relatedNames: ["Al-Munazzil", "Al-Muhyi"],
  mirrorVersion: `« C'est Allah qui envoie les vents qui soulèvent des nuages. Puis Il les étend dans le ciel comme Il veut. » Le miroir me montre le processus de la pluie. Les vents soulèvent, les nuages s'assemblent, la pluie tombe, la vie surgit. Un processus complexe, orchestré par Allah. Le miroir m'interroge : est-ce que je vois la complexité et la beauté de chaque goutte ?`,
  reflection: `La pluie est un processus miraculeux. Chaque goutte est le fruit d'une orchestration divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi yursila ar-riyaha fa-tuthiru sahapan » — c'est Allah qui envoie les vents qui soulèvent des nuages." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La prochaine pluie : verrai-je le processus ou seulement le résultat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pluie n'est pas automatique — elle est un don constant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de l'eau est une merveille d'ingénierie cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le processus de la pluie voit Allah à l'œuvre." }
  ],
  munajat: `Ya Munazzil, merci pour la pluie. Fais que je voie Ta main dans chaque goutte.`
};

MIROIR["30:49"] = {
  reference: "30:49",
  theme: ["espoir", "désespoir", "grâce"],
  emotion: "Soulagement profond",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Ar-Rahman"],
  mirrorVersion: `« Avant cela, ils étaient dans le désespoir. Regarde les effets de la miséricorde d'Allah. » Le miroir me montre le contraste : le désespoir d'avant, la grâce d'après. La terre arde devient jardin. Les cœurs secs deviennent vivants. La miséricorde d'Allah transforme tout. Le miroir m'interroge : suis-je dans le désespoir ou dans l'espoir ?`,
  reflection: `Le désespoir précède souvent la grâce. La miséricorde d'Allah transforme le mort en vivant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kanu min qabli an tunazzila 'alayhim min qablili la-mublisin » — avant cela, ils étaient dans le désespoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon désespoir : est-il fondé ? Ou est-ce que la grâce peut venir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désespoir peut être le prélude à la plus grande grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le désert fleurit après la pluie. La mort précède la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend la grâce d'Allah ne désespère jamais vraiment." }
  ],
  munajat: `Ya Muhyi, transforme mon désespoir en espoir. Fais que Ta grâce inonde ma terre aride.`
};

MIROIR["30:50"] = {
  reference: "30:50",
  theme: ["résurrection", "vie", "création"],
  emotion: "Contemplation émerveillée",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Muhyi"],
  mirrorVersion: `« Regarde les effets de la miséricorde d'Allah : comment Il redonne vie à la terre morte. C'est Lui qui fait revivre les morts. » Le miroir me montre le signe quotidien de la résurrection. La terre morte qui verdit — c'est la résurrection en miniature. Celui qui peut faire cela peut ressusciter les corps. Le miroir m'interroge : est-ce que je vois la résurrection dans chaque printemps ?`,
  reflection: `La résurrection de la terre est le signe de la résurrection des corps. Chaque printemps prouve le pouvoir d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anzuru ila athari rahmati Allahi kayfa yuhyi al-arda ba'da mawtiha » — regarde les effets de la miséricorde d'Allah : comment Il redonne vie à la terre morte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Chaque printemps : est-ce que j'y vois la résurrection ? Ou seulement le changement de saison ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas définitive. La vie revient toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un cycle incessant de mort et de résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la résurrection de la terre croit à la résurrection finale." }
  ],
  munajat: `Ya Ba'ith, montre-moi Ta résurrection dans la nature. Fais que je croie à la résurrection des corps.`
};

MIROIR["30:51"] = {
  reference: "30:51",
  theme: ["vent", "destruction", "ingratitude"],
  emotion: "Mise en garde lucide",
  difficulty: "débutant",
  relatedNames: ["Al-Musayyir", "Al-Qadir"],
  mirrorVersion: `« Si Nous envoyons un vent et qu'ils voient leur récolte jaunir, ils deviennent ingrats après. » Le miroir me montre la fragilité de la gratitude. Le même vent qui peut annoncer la pluie peut aussi flétrir. La réaction humaine est souvent conditionnée par le résultat. Le miroir m'interroge : ma gratitude est-elle conditionnelle ?`,
  reflection: `La gratitude conditionnelle n'est pas de la vraie gratitude. Le vent peut être grâce ou épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in arsala ar-riha fa-asfarat » — si Nous envoyons un vent et qu'ils voient leur récolte jaunir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma gratitude : est-elle constante ou dépendante du résultat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve peut être une grâce cachée. La perte peut être un gain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vent a ses caprices. L'acceptation transcende les résultats." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant même dans la perte a compris la gratitude." }
  ],
  munajat: `Ya Rabb, fais que ma gratitude soit constante, pas conditionnelle. Même quand le vent flétrit, je remercie.`
};

MIROIR["30:52"] = {
  reference: "30:52",
  theme: ["mort", "audition", "guidance"],
  emotion: "Réalisation claire",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Muhyi"],
  mirrorVersion: `« Tu ne fais pas entendre les morts, ni entendre les sourds l'appel quand ils tournent le dos. » Le miroir me montre la distinction entre la mort physique et la mort spirituelle. Les morts n'entendent pas. Les sourds qui tournent le dos n'écoutent pas. La guidance nécessite un cœur vivant et une oreille ouverte. Le miroir m'interroge : suis-je vivant et à l'écoute ?`,
  reflection: `La mort spirituelle empêche l'écoute. La guidance demande un cœur vivant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innaka la tusmi'u al-mawta » — tu ne fais pas entendre les morts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur : est-il vivant ? Mon oreille : est-elle ouverte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort spirituelle est pire que la mort physique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers écoute son Créateur. Seul l'homme peut refuser d'entendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend l'appel est déjà vivant." }
  ],
  munajat: `Ya Sami', vivifie mon cœur. Fais que j'entende Ton appel et que je ne sois pas parmi les morts spirituels.`
};

MIROIR["30:53"] = {
  reference: "30:53",
  theme: ["aveuglement", "guidance", "vision"],
  emotion: "Clarté nécessaire",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Basir"],
  mirrorVersion: `« Tu ne peux guider les aveugles hors de leur égarement. Tu ne fais entendre que ceux qui croient en Nos signes. » Le miroir me montre les limites de la guidance humaine. On ne peut guider qui refuse de voir. Les croyants seuls entendent vraiment. La foi précède l'écoute profonde. Le miroir m'interroge : suis-je parmi ceux qui entendent ?`,
  reflection: `La guidance intérieure précède la guidance extérieure. La foi ouvre les oreilles du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma anta bi-hadi al-'umyi 'an dalalatihim » — tu ne peux guider les aveugles hors de leur égarement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vision : suis-je voyant ou aveugle ? Mon écoute : entends-je vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi ouvre les yeux et les oreilles. L'égarement les ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers voit et entend son Créateur par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux signes entend ce que les autres n'entendent pas." }
  ],
  munajat: `Ya Hadi, ouvre mes yeux et mes oreilles. Fais que je croie en Tes signes et que j'entende vraiment.`
};

MIROIR["30:54"] = {
  reference: "30:54",
  theme: ["création", "faiblesse", "force"],
  emotion: "Humilité reconnaissante",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qawi"],
  mirrorVersion: `« C'est Allah qui vous a créés faibles, puis après la faiblesse Il a donné la force, puis après la force Il a donné la faiblesse et la vieillesse. » Le miroir me montre le cycle de la vie. Faiblesse → force → faiblesse. Nous commençons impuissants, nous redevenons impuissants. La force est un prêt, pas une acquisition. Le miroir m'interroge : est-ce que j'utilise ma force pour Allah ou contre Lui ?`,
  reflection: `La force est un prêt temporaire. La faiblesse est notre état naturel. Utilisons la force pour le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi khalaqakum min da'fin » — c'est Allah qui vous a créés faibles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma force actuelle : comment l'utilisé-je ? Et comment prépare-je ma faiblesse future ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie force est dans la reconnaissance de notre faiblesse fondamentale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte ce cycle. Chaque chose a sa phase de force et de déclin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît sa faiblesse fondamentale ne s'enorgueillit jamais de sa force." }
  ],
  munajat: `Ya Qawi, Tu es Fort et je suis faible. Fais que j'utilise ma force temporaire pour Ton service.`
};

MIROIR["30:55"] = {
  reference: "30:55",
  theme: ["temps", "résurrection", "perception"],
  emotion: "Révélation étonnante",
  difficulty: "débutant",
  relatedNames: ["Al-Qiyamah", "Al-Khallaq"],
  mirrorVersion: `« Le jour où l'Heure se lèvera, les criminels diront : \"Nous n'avons demeuré qu'une heure.\" » Le miroir me montre la relativité du temps. La vie entière semble une heure au Jour du Jugement. Les criminels n'ont pas conscience de la durée. La perception du temps change selon l'état. Le miroir m'interroge : est-ce que je vis comme si le temps comptait ?`,
  reflection: `Le temps est relatif. La vie paraît courte au Jugement. Chaque instant compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma labithna illa sa'atan » — nous n'avons demeuré qu'une heure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma perception du temps : est-elle juste ? Est-ce que je profite de chaque instant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Une vie bien vécue peut sembler courte mais pleine. Une vie mal vécue semble courte et vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est une dimension de l'univers. L'éternité en change la perception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque instant comme précieux ne regrette rien au Jour du Jugement." }
  ],
  munajat: `Ya Rabb, fais que je vive chaque instant avec conscience. Que ma vie soit pleine, pas juste courte.`
};

MIROIR["30:56"] = {
  reference: "30:56",
  theme: ["savoir", "temps", "certitude"],
  emotion: "Sagesse apaisée",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Ceux qui ont reçu la science et la foi diront : \"Vous avez demeuré selon le décret d'Allah, jusqu'au Jour de la Résurrection.\" » Le miroir me montre la perspective des savants croyants. Ils comprennent le temps. Le décret d'Allah gouverne la durée. La résurrection est le terme. Le miroir m'interroge : est-ce que j'ai cette science et cette foi ?`,
  reflection: `La science et la foi donnent la juste perspective sur le temps. Le décret d'Allah gouverne tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad labithtum bi qadari Allahi ila yawmi al-ba'th » — vous avez demeuré selon le décret d'Allah, jusqu'au Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma perspective sur le temps : est-elle éclairée par la science et la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps n'est pas subi — il est vécu selon le décret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte le décret temporel. Chaque chose a sa durée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le décret d'Allah accepte le temps." }
  ],
  munajat: `Ya 'Alim, donne-moi la science et la foi. Fais que je comprenne le temps comme Tu le comprends.`
};

MIROIR["30:57"] = {
  reference: "30:57",
  theme: ["excuse", "jour", "injustice"],
  emotion: "Réalisation définitive",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Fasil"],
  mirrorVersion: `« Ce jour-là, les excuses des injustes ne leur seront d'aucune utilité. » Le miroir me montre l'inefficacité des excuses tardives. Le Jour du Jugement n'est pas le moment des négociations. Les excuses n'effacent pas les actes. Le miroir m'interroge : quelles excuses suis-je en train de préparer ? Et seront-elles utiles ?`,
  reflection: `Les excuses tardives sont inutiles. Le temps des excuses est maintenant, pas au Jour du Jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-awma idhin la yanfa'u alladhina zalamu ma'dhiratuhum » — ce jour-là, les excuses des injustes ne leur seront d'aucune utilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes excuses actuelles : sont-elles sincères ou sont-elles des délais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir maintenant vaut mieux que les excuses demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'accepte pas les excuses — il suit les lois. Le Jour du Jugement aussi suit les lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent maintenant n'aura pas besoin d'excuses demain." }
  ],
  munajat: `Ya Haqq, je me repens maintenant. Ne me laisse pas attendre le Jour où les excuses seront inutiles.`
};

MIROIR["30:58"] = {
  reference: "30:58",
  theme: ["parabole", "Coran", "guidance"],
  emotion: "Clarification divine",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudhakkir"],
  mirrorVersion: `« Nous avons certes proposé aux gens dans ce Coran toutes sortes de paraboles. » Le miroir me montre la richesse pédagogique du Coran. Les paraboles — « mathal » — sont multiples. Chaque type de personne peut y trouver son enseignement. Le miroir m'interroge : quelles paraboles me parlent ? Et est-ce que je les comprends ?`,
  reflection: `Le Coran propose des paraboles pour tous. Chacun peut y trouver son enseignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad darabna li an-nasi fi hadha al-qurani min kulli mathalin » — Nous avons certes proposé aux gens dans ce Coran toutes sortes de paraboles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles paraboles du Coran me touchent ? Et qu'est-ce qu'elles m'enseignent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parabole n'est pas un embellissement — elle est un enseignement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une parabole vivante. Le Coran en est le commentaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend les paraboles comprend le Coran." }
  ],
  munajat: `Ya Hadi, fais que je comprenne Tes paraboles. Ouvre mon cœur à l'enseignement du Coran.`
};

MIROIR["30:59"] = {
  reference: "30:59",
  theme: ["scellement", "cœur", "compréhension"],
  emotion: "Avertissement sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Khatim", "Al-Hadi"],
  mirrorVersion: `« C'est ainsi qu'Allah scelle les cœurs de ceux qui ne savent pas. » Le miroir me montre la conséquence de l'ignorance volontaire. Le refus de savoir mène au scellement. Le cœur qui ne veut pas voir devient aveugle. Le miroir m'interroge : mon cœur est-il ouvert à la connaissance ?`,
  reflection: `Le scellement du cœur est la conséquence du refus de savoir. L'ignorance volontaire a son prix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kama yakhtimu 'ala qulubi alladhina la ya'lamun » — c'est ainsi qu'Allah scelle les cœurs de ceux qui ne savent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur : est-il ouvert ou scellé ? Cherché-je à savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le scellement peut être rompu par le désir sincère de savoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ouvert à la connaissance. Seul le cœur fermé reste dans l'ignorance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche à savoir évite le scellement." }
  ],
  munajat: `Ya Rabb, ne scelle pas mon cœur. Fais que je cherche la connaissance et que mon cœur reste ouvert.`
};
// ============================================

MIROIR["60:1"] = {
  reference: "60:1",
  theme: ["alliégeance", "amour", "priorité"],
  emotion: "Engagement, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Wadud"],
  mirrorVersion: `« Ô vous qui croyez ! Ne prenez pas Mes ennemis et les vôtres pour alliés. » Le miroir me place devant une question brûlante : qui sont mes alliés ? Le verset parle d'une incompatibilité fondamentale — on ne peut pas être allié des ennemis d'Allah tout en prétendant L'aimer. Ce n'est pas de l'intolérance, c'est de la cohérence. L'amour exige une orientation. Je ne peux pas regarder dans deux directions à la fois. Le miroir m'interroge : vers qui mon cœur se tourne-t-il quand il cherche du soutien ?`,
  reflection: `L'amour d'Allah implique un choix. Les alliances du cœur révèlent nos priorités réelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la tattakhidhu 'aduwri wa 'aduwwakum awliya' » — ô vous qui croyez, ne prenez pas Mes ennemis et les vôtres pour alliés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes alliances ? Vers qui je me tourne pour le soutien, le confort, la validation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce n'est pas Allah qui a besoin de mon allégeance — c'est moi qui ai besoin de la Sienne. Lui être allié, c'est être allié de mon propre bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans tout l'univers, chaque chose a son orientation propre. L'électron gravite autour du noyau. L'être humain doit choisir son centre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'allégeance à Allah n'est pas une contrainte — c'est un retour à l'ordre naturel des choses. L'âme retrouve son centre." }
  ],
  munajat: `Ya Wali, sois mon Allié. Fais que mon cœur ne cherche refuge qu'en Toi. Libère-moi des alliances qui m'éloignent de Toi.`
};

MIROIR["60:2"] = {
  reference: "60:2",
  theme: ["épreuve", "foi", "protection"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Muhaymin"],
  mirrorVersion: `« S'ils vous dominaient, ils seraient vos ennemis. » Le miroir me montre la réalité cachée derrière les apparences. Ceux qui semblent bienveillants peuvent être des ennemis dans leur cœur. Mais Allah nous protège en révélant leurs intentions. L'épreuve n'est pas seulement externe — elle est dans la capacité de voir clair. Le miroir m'interroge : suis-je lucide sur les intentions de ceux qui m'entourent ?`,
  reflection: `La protection divine passe par la lucidité. Voir clair est une miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In yanzhurukum hum 'aduwwun » — s'ils vous dominaient, ils seraient vos ennemis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les gens comme ils sont ou comme je voudrais qu'ils soient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hostilité cachée des autres n'est pas mon problème — c'est le leur. Mon problème, c'est de rester attaché à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature a ses prédateurs et ses proies. La conscience humaine doit apprendre à distinguer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qu'Allah protège n'a peur de rien. La vraie sécurité est spirituelle." }
  ],
  munajat: `Ya Hafiz, protège-moi des hostilités cachées. Donne-moi la lucidité de voir clair et la sagesse de rester attaché à Toi.`
};

MIROIR["60:3"] = {
  reference: "60:3",
  theme: ["jour dernier", "alliégeance", "désaveu"],
  emotion: "Gravité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Malik"],
  mirrorVersion: `« Le Jour de la Résurrection, Il rejettera vos amitiés. » Le miroir me projette vers le Jour dernier. Toutes les amitiés qui m'ont détourné d'Allah seront rejetées. Les alliés de ce monde deviendront des étrangers dans l'autre. Le miroir m'interroge : quelles amitiés me seront utiles ce Jour-là ? Seule l'amitié en Allah reste.`,
  reflection: `Les amitiés de ce monde sont éphémères. Seule l'amitié en Allah est éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma al-qiyamati yakfru ba'dukum 'an ba'd » — le Jour de la Résurrection, vous vous désavouerez les uns les autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si le Jour dernier arrivait maintenant, quelles amitiés me seraient utiles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désaveu du Jour dernier n'est pas une trahison — c'est la révélation de la vérité. Les fausses amitiés sont déjà fausses maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers tend vers la vérité finale. Les masques tombent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui construit des amitiés en Allah construit pour l'éternité." }
  ],
  munajat: `Ya Hasib, fais que mes amitiés soient en Toi. Prépare-moi pour le Jour où tout sera révélé.`
};

MIROIR["60:5"] = {
  reference: "60:5",
  theme: ["prière", "protecteur", "descendance"],
  emotion: "Supplication, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Wakil"],
  mirrorVersion: `« Seigneur ! Ne fais pas de nous une cible pour les mécréants. » Cette prière d'Ibrahim est devenue la nôtre. Le miroir me montre que je ne suis pas seul à craindre l'hostilité du monde. Les prophètes eux-mêmes ont prié pour être protégés. Le miroir m'interroge : est-ce que je prie pour ma protection spirituelle ?`,
  reflection: `La prière pour la protection est une sunnah prophétique. Demander à Allah d'être notre Protecteur est un acte de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana la taj'alna fitnatan lilladhina kafaru » — Seigneur, ne fais pas de nous une cible pour les mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande à Allah ? Est-ce que je prie pour ma protection spirituelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection demandée n'est pas une fuite — c'est une lucidité. Se protéger du mal pour mieux faire le bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature cherche protection. L'être humain la cherche auprès de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la protection d'Allah l'obtient. La demande est déjà une réponse." }
  ],
  munajat: `Ya Wali, sois mon Protecteur. Ne permets pas que je sois une cible pour ceux qui Te rejettent. Protège ma foi et ma descendance.`
};

MIROIR["60:6"] = {
  reference: "60:6",
  theme: ["modèle", "patience", "foi"],
  emotion: "Inspiration, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Quddus", "Al-Mu'min"],
  mirrorVersion: `« Vous avez eu en eux un bel exemple. » Ibrahim et les croyants avec lui sont nos modèles. Le miroir me montre que la foi n'est pas théorique — elle se vit, se transmet, s'incarne. Les exemples sont des miroirs vivants. Le miroir m'interroge : qui sont mes modèles ? Ressemblent-ils à Ibrahim ?`,
  reflection: `Les modèles de foi sont des phares. Les suivre, c'est suivre leur lumière.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad kana lakum fihim uswatun hasanah » — vous avez eu en eux un bel exemple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes modèles ? Quelles qualités j'admire en eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Je suis aussi un modèle pour d'autres. Que transmets-je par mon exemple ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'exemple est plus puissant que la parole. Chaque vie est un enseignement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Suivre l'exemple des prophètes, c'est suivre la lumière d'Allah à travers eux." }
  ],
  munajat: `Ya Rabb, fais que je suive l'exemple d'Ibrahim. Donne-moi sa patience, sa foi, sa confiance en Toi. Fais que je sois aussi un bon exemple.`
};

MIROIR["60:7"] = {
  reference: "60:7",
  theme: ["réconciliation", "espoir", "pouvoir"],
  emotion: "Espérance, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Muqtadir", "Al-Latif"],
  mirrorVersion: `« Il est possible qu'Allah établisse de l'amitié entre vous et ceux d'entre eux que vous traitez comme ennemis. » Le miroir me surprend : l'ennemi d'aujourd'hui peut devenir l'ami de demain. Allah a le pouvoir de transformer les cœurs. L'hostilité n'est pas une fatalité. Le miroir m'interroge : est-ce que je garde mes portes ouvertes à la réconciliation ?`,
  reflection: `Allah peut tout transformer. L'hostilité humaine n'est pas éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Asa Allahu an yaj'ala baynakum wa bayna alladhina 'adaytum minhum mawaddah » — il est possible qu'Allah établisse de l'amitié entre vous et vos ennemis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Y a-t-il des gens que j'ai condamnés définitivement ? Est-ce que je crois au pouvoir d'Allah de transformer les cœurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si Allah peut transformer mes ennemis, Il peut aussi me transformer. La réconciliation commence par moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est figé dans l'univers. Tout est en mouvement vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son cœur ouvert à la réconciliation participe au pouvoir d'Allah." }
  ],
  munajat: `Ya Muqtadir, Tu peux tout transformer. Ouvre les cœurs. Fais que l'hostilité se change en amitié. Transforme-moi aussi.`
};

MIROIR["60:8"] = {
  reference: "60:8",
  theme: ["justice", "bienfaisance", "équité"],
  emotion: "Justice, humanité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Barr"],
  mirrorVersion: `« Allah ne vous défend pas d'être bienfaisants et équitables envers ceux qui ne vous ont pas combattus. » Le miroir me montre que la justice islamique n'est pas aveugle. On peut être juste avec ceux qui ne nous combattent pas. La bienfaisance n'est pas réservée aux croyants. Le miroir m'interroge : suis-je juste avec ceux qui sont différents de moi ?`,
  reflection: `La bienfaisance est universelle. La justice est pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yanhakumu Allahu 'ani alladhina lam yuqatilukum » — Allah ne vous défend pas d'être bienfaisants envers ceux qui ne vous ont pas combattus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite ceux qui sont différents de moi ? Suis-je juste et bienfaisant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bienfaisance envers les autres n'est pas une faiblesse — c'est une force. C'est se conformer à l'ordre d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La bienfaisance est une loi universelle. Allah est bienfaisant envers tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est bienfaisant avec tous reflète la bienfaisance d'Allah." }
  ],
  munajat: `Ya 'Adl, Tu es Juste et Bienfaisant. Fais que je sois juste avec tous, bienfaisant envers ceux qui ne me combattent pas.`
};

MIROIR["60:9"] = {
  reference: "60:9",
  theme: ["protection", "alliégeance", "justice"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Allah vous défend seulement de prendre pour alliés ceux qui vous ont combattus. » Le miroir me montre la limite : l'alliance est interdite avec ceux qui combattent la foi. Ce n'est pas de la haine — c'est de la protection. On ne peut pas être allié de ses agresseurs. Le miroir m'interroge : où est ma limite ?`,
  reflection: `La protection de soi et de sa foi est un devoir. L'alliance avec les agresseurs est une trahison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yanhakumu Allahu 'ani alladhina qatilukum » — Allah vous défend seulement de prendre pour alliés ceux qui vous ont combattus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes limites ? Où s'arrête ma tolérance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défense n'est pas de l'hostilité — c'est de la protection. Se protéger pour mieux aimer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a ses mécanismes de défense. L'être humain défend sa foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît ses limites est libre. La liberté est dans les frontières justes." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse de connaître mes limites. Protège-moi de l'alliance avec ceux qui combattent la foi.`
};

MIROIR["60:10"] = {
  reference: "60:10",
  theme: ["émigration", "foi", "épreuve"],
  emotion: "Accueil, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muhajir", "Al-Wali"],
  mirrorVersion: `« Ô vous qui croyez ! Quand les croyantes viennent à vous en émigrées, éprouvez-les. » Le miroir me place dans le contexte de l'émigration. Les femmes qui quittent tout pour leur foi méritent d'être accueillies, mais après vérification. L'accueil n'est pas aveugle. Le miroir m'interroge : comment j'accueille ceux qui viennent vers la foi ?`,
  reflection: `L'accueil des nouveaux croyants demande sagesse et vérification.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu idha ja'akumu al-mu'minatu muhajiratin » — ô vous qui croyez, quand les croyantes viennent à vous en émigrées..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'accueille ceux qui viennent vers la foi ? Suis-je prudent et bienveillant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve demandée n'est pas de la méfiance — c'est de la protection. Protéger la communauté et la personne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque transition demande vérification. L'adaptation n'est pas instantanée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vient vers Allah avec sincérité passe l'épreuve du cœur." }
  ],
  munajat: `Ya Rabb, accueille ceux qui viennent vers Toi. Donne-moi la sagesse d'accueillir avec bienveillance et discernement.`
};

MIROIR["60:11"] = {
  reference: "60:11",
  theme: ["compensation", "justice", "dépense"],
  emotion: "Équité, générosité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Al-Kafi"],
  mirrorVersion: `« Si l'une de vos épouses vous échappe et passe chez les mécréants, donnez à ceux dont les épouses ont fui l'équivalent de ce qu'ils avaient dépensé. » Le miroir me montre une justice pratique. Les pertes matérielles sont compensées. Allah ne laisse pas les croyants dans le besoin. Le miroir m'interroge : est-ce que je fais confiance à la compensation divine ?`,
  reflection: `La justice d'Allah comprend les pertes matérielles. Rien n'est perdu pour toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in fatakum ahadun min azwajikum ila al-kuffari fa'ataw » — si l'une de vos épouses vous échappe, donnez compensation..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je perds quelque chose, est-ce que je fais confiance à la compensation divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compensation n'est pas que matérielle — Allah compense aussi spirituellement. Chaque perte cache un gain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature compense toujours. Rien n'est perdu, tout se transforme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la perte avec patience reçoit une compensation supérieure." }
  ],
  munajat: `Ya Ghani, Tu es Celui qui compense. Fais que je fasse confiance à Ta justice, même dans mes pertes.`
};

MIROIR["60:12"] = {
  reference: "60:12",
  theme: ["alliégeance", "femmes", "engagement"],
  emotion: "Engagement, communauté",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Ghaffur"],
  mirrorVersion: `« Ô Prophète ! Quand les croyantes viennent te prêter allégeance... » Le miroir me montre l'allégeance des femmes au Prophète. Elles s'engagent sur des principes clairs : ne pas associer, ne pas voler, ne pas commettre l'adultère, etc. L'allégeance est un contrat spirituel. Le miroir m'interroge : à quoi je m'engage ?`,
  reflection: `L'allégeance est un engagement mutuel. Le croyant s'engage sur des principes clairs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nabiyyu idha ja'aki al-mu'minatu yubayi'naka » — ô Prophète, quand les croyantes viennent te prêter allégeance..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je me suis engagé envers Allah ? Est-ce que je respecte mon engagement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'allégeance n'est pas une soumission passive — c'est un choix actif, une orientation consciente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers a son engagement. L'homme choisit le sien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'allégeance à Allah est le plus beau des contrats. Ses termes sont clairs, Sa récompense est certaine." }
  ],
  munajat: `Ya Wali, j'ai prêté allégeance à Tes commandements. Aide-moi à les respecter. Accepte mon engagement.`
};

MIROIR["60:13"] = {
  reference: "60:13",
  theme: ["alliégeance", "communauté", "châtiment"],
  emotion: "Mise en garde, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Khaliq"],
  mirrorVersion: `« Ô vous qui croyez ! Ne prenez pas pour alliés des gens contre lesquels Allah est courroucé. » Le miroir me met en garde. L'alliance avec ceux qu'Allah rejette conduit au rejet. La destination finale dépend des alliances choisies ici-bas. Le miroir m'interroge : mes alliances me rapprochent-elles d'Allah ou m'en éloignent-elles ?`,
  reflection: `Les alliances choisies déterminent la destination finale. Choisir ses alliés, c'est choisir son avenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu la tatawallaw qawman ghadiba Allahu 'alayhim » — ô vous qui croyez, ne prenez pas pour alliés des gens contre lesquels Allah est courroucé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes alliés me rapprochent-ils d'Allah ? Ma compagnie influence-t-elle ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet final n'est pas une punition arbitraire — c'est la conséquence des choix faits ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque chose rejoint son semblable. L'âme rejoint ce qu'elle a aimé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'alliance avec Allah est le seul refuge contre le rejet final." }
  ],
  munajat: `Ya Rabb, fais que mes alliés soient ceux que Tu aimes. Préserve-moi de l'alliance avec ceux qui T'ont rejeté.`
};

// ============================================
// SURAH 61 - AS-SAFF (LES RANGS)
// 14 verses
// ============================================

MIROIR["61:1"] = {
  reference: "61:1",
  theme: ["louange", "gloire", "toute-puissance"],
  emotion: "Adoration, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« Tout ce qui est dans les cieux et sur terre glorifie Allah. » Le miroir me place dans le chœur universel. Tout glorifie — les étoiles, les planètes, les atomes. Seul l'être humain a le choix de le faire ou non. Le miroir m'interroge : ma voix rejoint-elle le chœur cosmique ?`,
  reflection: `La glorification est le chant de l'univers. L'homme est invité à y participer consciemment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sabbaha li-Allahi ma fi as-samawati wa ma fi al-ard » — tout ce qui est dans les cieux et sur terre glorifie Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie est une glorification ? Est-ce que je rejoins le chœur universel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification n'est pas un devoir imposé — c'est la nature même de l'existence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en état de prière permanente. Chaque atome dit « Allah »." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah de tout son être devient la glorification même." }
  ],
  munajat: `Ya 'Aziz, toute la création Te glorifie. Fais que ma voix se joigne au chœur universel. Fais que ma vie soit une glorification.`
};

MIROIR["61:2"] = {
  reference: "61:2",
  theme: ["cohérence", "parole", "acte"],
  emotion: "Mise en garde, authenticité",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Haqq"],
  mirrorVersion: `« Ô vous qui croyez ! Pourquoi dites-vous ce que vous ne faites pas ? » Le miroir me saisit. Le décalage entre mes paroles et mes actes est exposé. Je parle de foi, de sacrifice, de dévotion — mais mes actes suivent-ils ? Le miroir m'interroge : ma vie est-elle cohérente avec mes déclarations ?`,
  reflection: `La cohérence entre parole et acte est le signe de la foi authentique. Dire sans faire est une forme d'hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lima taquluna ma la taf'alun » — pourquoi dites-vous ce que vous ne faites pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dis sans le faire ? Où est le décalage entre mes paroles et mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question n'est pas une accusation — c'est une invitation à l'authenticité. Allah veut que je sois vrai." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, il n'y a pas de décalage. L'arbre ne parle pas de donner des fruits — il en donne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aligne ses actes sur ses paroles devient parole vivante." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Aide-moi à être vrai. Fais que mes actes suivent mes paroles. Détruis l'hypocrisie en moi.`
};

MIROIR["61:3"] = {
  reference: "61:3",
  theme: ["hypocrisie", "haïssable", "cohérence"],
  emotion: "Gravité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Basir"],
  mirrorVersion: `« C'est une chose haïssable auprès d'Allah que vous disiez ce que vous ne faites pas. » Le miroir me montre la gravité de l'incohérence. Ce n'est pas un petit défaut — c'est quelque chose qu'Allah déteste. La parole sans l'acte est un mensonge spirituel. Le miroir m'interroge : suis-je prêt à changer mes paroles ou mes actes ?`,
  reflection: `L'incohérence entre parole et acte est spirituellement toxique. Allah aime la sincérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kabura maqtan 'inda Allahi an taqulu ma la taf'alun » — c'est une chose haïssable auprès d'Allah que vous disiez ce que vous ne faites pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dis sans le faire ? Suis-je prêt à changer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qu'Allah déteste n'est pas la faiblesse — c'est la prétention. Mieux vaut se taire que de promettre sans faire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne ment pas. Chaque chose est ce qu'elle fait." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit peu mais fait beaucoup est aimé d'Allah." }
  ],
  munajat: `Ya Khabir, Tu connais mes décalages. Purifie-moi de l'hypocrisie. Fais que je sois vrai devant Toi et les hommes.`
};

MIROIR["61:5"] = {
  reference: "61:5",
  theme: ["prophète", "opposition", "réussite"],
  emotion: "Tristesse, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Muhsin"],
  mirrorVersion: `« Ô mon peuple ! Pourquoi me nuisez-vous alors que je suis venu à vous avec la clairvoyance ? » Le miroir me place dans la bouche de Moïse. Le prophète vient avec la guidance, et les gens lui nuisent. L'ingratitude spirituelle est un phénomène récurrent. Le miroir m'interroge : comment j'accueille la guidance qui me vient ?`,
  reflection: `La guidance est un don. La rejeter ou nuire à celui qui l'apporte est un péché grave.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya qawmi lima tu'dhunanani wa qad ta'lamunna anni rasulu Allahi ilaykum » — ô mon peuple, pourquoi me nuisez-vous alors que vous savez que je suis le messager d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'accueille la guidance ? Est-ce que je résiste à ceux qui me conseillent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Nuire au guide, c'est se nuire à soi-même. La guidance est pour mon bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est une grâce. La refuser, c'est se priver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille la guidance avec gratitude reçoit davantage." }
  ],
  munajat: `Ya Hadi, Tu m'envoies des guides. Fais que je les accueille avec gratitude. Ne permets pas que je sois de ceux qui résistent.`
};

MIROIR["61:6"] = {
  reference: "61:6",
  theme: ["Jésus", "Muhammad", "annonce"],
  emotion: "Révélation, continuité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Masih", "Ahmad"],
  mirrorVersion: `« Et quand Jésus, fils de Marie, dit : Ô Enfants d'Israël, je suis le messager d'Allah vers vous, confirmant ce qui est venu avant moi, et annonçant un messager à venir après moi, dont le nom sera Ahmad. » Le miroir me montre la continuité des prophètes. Jésus annonce Muhammad. La prophétie est une chaîne, pas des épisodes isolés. Le miroir m'interroge : est-ce que je reconnais la continuité de la guidance ?`,
  reflection: `La prophétie est une chaîne continue. Chaque prophète annonce le suivant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qala 'Isa ibnu Maryama ya bani Isra'ila inni rasulu Allahi ilaykum musaddiqan lima bayna yadayya mina at-tawrati wa mubashshiran bi-rasulin ya'ti min ba'di ismuhu Ahmad » — Jésus annonce un messager à venir nommé Ahmad." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la continuité de la guidance ? Est-ce que je vois le fil qui relie tous les prophètes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ahmad n'est pas un nom nouveau — c'est le même message, le même Dieu, la même vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est universelle. Elle traverse les temps et les peuples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît un prophète les reconnaît tous." }
  ],
  munajat: `Ya Rabb, je reconnais la chaîne des prophètes. De Moïse à Jésus à Muhammad, un même message. Fais que je le suive.`
};

MIROIR["61:7"] = {
  reference: "61:7",
  theme: ["injustice", "égarement", "guidance"],
  emotion: "Mise en garde, compassion",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Et qui est plus injuste que celui qui invente un mensonge contre Allah alors qu'il est appelé à l'Islam ? » Le miroir me montre l'injustice ultime : mentir sur Allah tout en étant invité à la soumission. L'invitation est là, mais le cœur se détourne. Le miroir m'interroge : est-ce que j'accepte l'invitation à la soumission ?`,
  reflection: `L'invitation à l'Islam est universelle. La rejeter par mensonge sur Allah est le comble de l'injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man azlamu mimmani iftara 'ala Allahi al-kadhiba wa huwa yud'a ila al-islam » — qui est plus injuste que celui qui ment sur Allah alors qu'il est appelé à l'Islam ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'invitation à la soumission ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice n'est pas contre Allah — Il n'en a pas besoin. Elle est contre soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invitation est universelle. Chaque être est appelé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'invitation trouve la paix. Celui qui refuse s'éloigne de lui-même." }
  ],
  munajat: `Ya Hadi, Tu m'invites à la soumission. Je réponds présent. Préserve-moi du mensonge sur Toi.`
};

MIROIR["61:9"] = {
  reference: "61:9",
  theme: ["victoire", "religion", "toute-puissance"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghalib", "Al-'Aziz"],
  mirrorVersion: `« C'est Lui qui a envoyé Son messager avec la guidance et la religion de vérité, pour la faire prévaloir sur toute autre religion. » Le miroir me montre la promesse d'Allah : la vérité prévaudra. Peu importe les apparences actuelles, le résultat final est certain. Le miroir m'interroge : est-ce que je travaille pour cette victoire ?`,
  reflection: `La victoire de la vérité est promise. Le croyant y participe par sa fidélité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi arsala rasulahu bi-al-huda wa dini al-haqqi li-yuzhirahu 'ala ad-dini kullihi » — c'est Lui qui a envoyé Son messager avec la vérité pour la faire prévaloir sur toute religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la victoire finale de la vérité ? Est-ce que j'y participe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire de la religion n'est pas une conquête militaire — c'est la victoire des cœurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par prévaloir. C'est une loi cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sert la vérité participe à Sa victoire." }
  ],
  munajat: `Ya Ghalib, Tu as promis la victoire de la vérité. Fais que j'y participe. Donne-moi la certitude de Ton triomphe.`
};

MIROIR["61:10"] = {
  reference: "61:10",
  theme: ["commerce", "salut", "invitation"],
  emotion: "Espérance, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "Ar-Rahman"],
  mirrorVersion: `« Ô vous qui croyez ! Vous indiquerai-je un commerce qui vous sauvera d'un châtiment douloureux ? » Le miroir m'invite à un commerce spirituel. Le commerce du monde demande investissement et risque. Le commerce avec Allah demande foi et œuvres. Le gain est le salut. Le miroir m'interroge : suis-je prêt à investir dans ce commerce ?`,
  reflection: `Le commerce avec Allah est le plus rentable. L'investissement est la foi, le gain est le salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal adullukum 'ala tijaratin tunjikum min 'adhabin alim » — vous indiquerai-je un commerce qui vous sauvera d'un châtiment douloureux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'investis pour mon salut ? Suis-je prêt au commerce avec Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le commerce avec Allah n'est pas un échange — c'est un don. On investit ce qu'Il nous a donné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est échange. L'âme échange sa vie terrestre contre la vie éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait ce commerce découvre que le gain est déjà là." }
  ],
  munajat: `Ya Fattah, ouvre-moi les portes de ce commerce. Je veux investir dans mon salut. Accepte mon investissement.`
};

MIROIR["61:11"] = {
  reference: "61:11",
  theme: ["foi", "jihad", "commerce"],
  emotion: "Engagement, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Mujahid", "Al-Mu'min"],
  mirrorVersion: `« Vous croirez en Allah et en Son messager, et vous luttez dans le sentier d'Allah avec vos biens et vos personnes. » Le miroir me montre les termes du commerce : foi et lutte. On ne peut pas croire sans lutter, ni lutter sans croire. Les deux vont ensemble. Le miroir m'interroge : est-ce que je lutte avec ce que j'ai ?`,
  reflection: `La foi sans lutte est incomplète. La lutte sans foi est vaine. Les deux sont nécessaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tu'minu bi-Allahi wa rasulihi wa tujahiduna fi sabili Allahi bi-amwalikum wa anfusikum » — vous croirez en Allah et en Son messager, et vous luttez dans le sentier d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lutte avec mes biens et ma personne ? Ou est-ce que je garde tout pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lutte n'est pas une perte — c'est un investissement. Ce qu'on donne pour Allah revient multiplié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, tout se bat pour sa survie. Le croyant se bat pour l'éternité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lutte pour Allah découvre que la vraie lutte est contre son propre ego." }
  ],
  munajat: `Ya Rabb, je crois en Toi et en Ton messager. Donne-moi la force de lutter dans Ton sentier avec tout ce que j'ai.`
};

MIROIR["61:12"] = {
  reference: "61:12",
  theme: ["victoire", "pardon", "récompense"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« Il vous pardonnera vos péchés et vous fera entrer dans des jardins sous lesquels coulent les rivières. » Le miroir me montre le retour sur investissement : pardon et jardins. Le commerce avec Allah est le plus rentable. L'investissement est la lutte, le gain est le paradis. Le miroir m'interroge : est-ce que je fais confiance à cette promesse ?`,
  reflection: `Le retour sur investissement spirituel dépasse toute attente. Pardon et paradis attendent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaghfir lakum dhunubakum wa yudkhilakum jannatin tajri min tahtiha al-anhar » — Il vous pardonnera vos péchés et vous fera entrer dans des jardins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en cette promesse ? Est-ce que j'investis pour ce retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas une récompense pour la perfection — c'est une grâce pour l'effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers le jardin. La terre est le chemin, le paradis est la destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte au pardon ici-bas en aura soif là-bas." }
  ],
  munajat: `Ya Ghaffur, promets-moi le pardon. Promets-moi les jardins. J'investis dans Ta promesse.`
};

MIROIR["61:13"] = {
  reference: "61:13",
  theme: ["victoire", "proximité", "récompense"],
  emotion: "Joie, anticipation",
  difficulty: "débutant",
  relatedNames: ["An-Nasr", "Al-Qarib"],
  mirrorVersion: `« Et une autre chose que vous aimez : un secours d'Allah et une victoire proche. » Le miroir me montre que le commerce inclut aussi la victoire dans ce monde. Allah ne réserve pas tout pour l'au-delà. Le secours et la victoire sont proches. Le miroir m'interroge : est-ce que j'attends le secours d'Allah avec confiance ?`,
  reflection: `Le secours d'Allah est proche. La victoire est certaine pour ceux qui luttent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ukhra tuhibbunaha nasrun mina Allahi wa fathun qarib » — et une autre chose que vous aimez : un secours d'Allah et une victoire proche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends le secours d'Allah ? Est-ce que je crois en la victoire proche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La victoire n'est pas la fin — c'est un moyen. Le but est Allah Lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le secours est une loi universelle. Chaque difficulté porte en elle sa propre issue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend le secours d'Allah l'obtient. L'attente elle-même est une prière." }
  ],
  munajat: `Ya Nasir, envoie-moi Ton secours. Donne-moi la victoire proche. Je l'attends de Toi seul.`
};

MIROIR["61:14"] = {
  reference: "61:14",
  theme: ["alliégeance", "victoire", "modèle"],
  emotion: "Inspiration, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Hawariyyun", "An-Nasr"],
  mirrorVersion: `« Ô vous qui croyez ! Soyez les alliés d'Allah, comme Jésus, fils de Marie, a dit aux apôtres : Qui sont mes alliés pour Allah ? » Le miroir me montre l'appel final : être les alliés d'Allah. Les apôtres ont répondu : « Nous sommes les alliés d'Allah. » Le miroir m'interroge : qui suis-je prêt à être allié ?`,
  reflection: `L'alliance avec Allah est le plus grand honneur. Les apôtres l'ont comprise et y ont répondu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu kunu ansara Allahi kama qala 'Isa ibnu Maryama li-al-hawariyyina man ansari ila Allah » — soyez les alliés d'Allah, comme Jésus a dit aux apôtres : qui sont mes alliés pour Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à être l'allié d'Allah ? À répondre comme les apôtres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être l'allié d'Allah n'est pas un fardeau — c'est un honneur. C'est être du bon côté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers est alliée d'Allah par sa soumission. L'homme choisit son alliance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est allié d'Allah n'a pas besoin d'autre allié." }
  ],
  munajat: `Ya Rabb, je veux être Ton allié. Je réponds à Ton appel. Accepte-moi parmi Tes alliés.`
};

// ============================================
// SURAH 62 - AL-JUMU'AH (LE VENDREDI)
// 11 verses
// ============================================

MIROIR["62:1"] = {
  reference: "62:1",
  theme: ["louange", "gloire", "roi"],
  emotion: "Adoration, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Quddus"],
  mirrorVersion: `« Tout ce qui est dans les cieux et sur terre glorifie Allah, le Roi, le Saint. » Le miroir me place dans la louange universelle. Tout glorifie — le Roi, le Saint. Ces noms révèlent la majesté et la pureté d'Allah. Le miroir m'interroge : est-ce que je participe à cette glorification ?`,
  reflection: `La glorification universelle est un appel à participer. Le Roi et le Saint sont glorifiés par toute la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusabbihu li-Allahi ma fi as-samawati wa ma fi al-ardi al-maliki al-quddusi » — tout ce qui est dans les cieux et sur terre glorifie Allah, le Roi, le Saint." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma vie glorifie-t-elle le Roi et le Saint ? Est-ce que je reconnais Sa majesté et Sa pureté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de ma glorification — c'est moi qui ai besoin de Le glorifier. C'est mon honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un temple. Chaque créature est un adorateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie le Roi et le Saint entre dans Sa cour." }
  ],
  munajat: `Ya Malik, ya Quddus, je Te glorifie. Fais que ma vie soit une louange perpétuelle. Accepte ma glorification.`
};

MIROIR["62:2"] = {
  reference: "62:2",
  theme: ["prophète", "récitation", "enseignement"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Ummi", "Al-Mu'allim"],
  mirrorVersion: `« C'est Lui qui a envoyé parmi les illettrés un messager des leurs. » Le miroir me montre la miséricorde d'Allah envers les illettrés — ceux qui n'avaient pas reçu de livre. Le Prophète vient des leurs, parle leur langue, comprend leur condition. Le miroir m'interroge : est-ce que j'accueille l'enseignement du Prophète ?`,
  reflection: `La guidance vient de manière adaptée. Le Prophète illettré enseigne les illettrés avec sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi ba'tha fi al-ummiyyina rasulan minhum » — c'est Lui qui a envoyé parmi les illettrés un messager des leurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accueille l'enseignement du Prophète ? Est-ce que je le suis dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illettrance du Prophète n'est pas une faiblesse — c'est un signe. La guidance vient d'Allah, pas des livres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est adaptée à chaque peuple. Le message est universel, le messager est local." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète illettré devient lettré en Allah." }
  ],
  munajat: `Ya Rabb, Tu as envoyé un messager des nôtres. Fais que je le suive. Enseigne-moi à travers lui.`
};

MIROIR["62:4"] = {
  reference: "62:4",
  theme: ["préférence", "grâce", "bonté"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Mun'im", "Al-Fadil"],
  mirrorVersion: `« C'est la grâce d'Allah qu'Il donne à qui Il veut. » Le miroir me place devant la grâce divine. La guidance, la prophétie, la foi — tout est grâce, non mérite. Allah donne à qui Il veut. Le miroir m'interroge : est-ce que je reconnais que ma foi est une grâce ?`,
  reflection: `La foi est une grâce, non un mérite. Reconnaître la grâce, c'est cultiver la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika fadlu Allahi yu'tihi man yasha' » — c'est la grâce d'Allah qu'Il donne à qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ma foi comme une grâce ? Est-ce que j'en suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce n'est pas injuste — elle est libre. Allah donne par amour, pas par dette." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute grâce dans l'univers vient d'Allah. Le soleil, la pluie, la vie — tout est don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce reçoit davantage." }
  ],
  munajat: `Ya Mun'im, ma foi est Ta grâce. Je Te remercie. Ne me la retire pas. Donne-moi encore plus de Ta faveur.`
};

MIROIR["62:5"] = {
  reference: "62:5",
  theme: ["torah", "âne", "responsabilité"],
  emotion: "Mise en garde, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Hakim"],
  mirrorVersion: `« L'exemple de ceux qui ont été chargés de la Torah puis ne l'ont pas observée est celui de l'âne qui porte des livres. » Le miroir me montre une image frappante : l'âne qui porte des livres sans les comprendre. Les juifs qui avaient la Torah sans la pratiquer sont comme cet âne. Le miroir m'interroge : suis-je comme cet âne avec le Coran ?`,
  reflection: `Porter la révélation sans la pratiquer est une responsabilité sans bénéfice. Le Coran est un guide, pas un ornement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalu alladhina hummilu at-tawrata thumma lam yahmiluha ka-mathali al-himari yahmilu asfara » — l'exemple de ceux qui portent la Torah sans l'observer est comme l'âne qui porte des livres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je porte le Coran sans le pratiquer ? Suis-je comme l'âne avec les livres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'âne n'est pas blâmé — il ne peut pas comprendre. L'homme est blâmé — il peut comprendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance sans action est stérile. La nature agit selon sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique ce qu'il lit transforme le livre en vie." }
  ],
  munajat: `Ya Rabb, ne permets pas que je sois comme l'âne qui porte des livres. Fais que je pratique ce que je lis.`
};

MIROIR["62:6"] = {
  reference: "62:6",
  theme: ["amitié", "mort", "prétention"],
  emotion: "Défi, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Mumit"],
  mirrorVersion: `« Dis : Ô vous qui êtes juifs, si vous prétendez être les amis d'Allah à l'exclusion des autres, souhaitez donc la mort. » Le miroir me montre un défi divin. Si les juifs sont vraiment les élus d'Allah, qu'ils souhaitent la mort pour aller vers Lui. Mais ils ne le souhaitent pas. Le miroir m'interroge : ma foi me fait-elle souhaiter la rencontre avec Allah ?`,
  reflection: `La vraie foi désire la rencontre avec Allah. La peur de la mort révèle l'attachement au monde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ayyuha alladhina hadu in za'amtum annakum awliya'u Allahi min duni an-nasi fa-tamannu al-mawt » — dites : ô vous qui êtes juifs, si vous prétendez être les amis d'Allah, souhaitez donc la mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je souhaite la rencontre avec Allah ? Ou est-ce que je m'accroche à ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Souhaiter la mort n'est pas un désir morbide — c'est un désir d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme goûtera la mort. La question est : comment l'accueillir ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime vraiment Allah désire Sa rencontre." }
  ],
  munajat: `Ya Rabb, fais que je désire Ta rencontre. Ne permets pas que je m'accroche à ce monde au point de craindre la mort.`
};

MIROIR["62:8"] = {
  reference: "62:8",
  theme: ["mort", "fuite", "destin"],
  emotion: "Réalité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Dis : La mort que vous fuyez va certainement vous rencontrer. » Le miroir me place devant l'inévitable. La mort est certaine, peu importe les efforts pour la fuir. On ne peut pas y échapper. Le miroir m'interroge : est-ce que je vis en sachant que la mort viendra ?`,
  reflection: `La mort est inévitable. Vivre en conscience de la mort, c'est vivre pleinement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inna al-mawta alladhi tafirruna minhu fa-innahu mulaqikum » — dis : la mort que vous fuyez va certainement vous rencontrer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en conscience de la mort ? Est-ce que je me prépare à la rencontre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Fuir la mort, c'est fuir la vérité. L'accueillir, c'est accepter la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers meurt et renaît. La mort est une transition, pas une fin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mort découvre qu'elle est une porte." }
  ],
  munajat: `Ya Mumit, la mort viendra. Prépare-moi. Fais que je ne la fuie pas mais que je m'y prépare.`
};

MIROIR["62:10"] = {
  reference: "62:10",
  theme: ["vendredi", "commerce", "dispersion"],
  emotion: "Urgence, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Ghani"],
  mirrorVersion: `« Puis quand la prière est terminée, dispersez-vous sur terre et cherchez la grâce d'Allah. » Le miroir me montre l'équilibre entre culte et travail. Après la prière du vendredi, on retourne aux affaires — mais en cherchant la grâce d'Allah. Le miroir m'interroge : mon travail est-il une quête de la grâce d'Allah ?`,
  reflection: `Le travail après la prière est aussi un acte de foi. Chercher la grâce d'Allah dans le quotidien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha qudiyati as-salatu fa-ntashiru fi al-ardi wa abtaghu min fadli Allahi » — puis quand la prière est terminée, dispersez-vous sur terre et cherchez la grâce d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon travail est-il une quête de la grâce d'Allah ? Ou est-ce seulement pour le gain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispersion n'est pas un éloignement — c'est une extension. Le culte continue dans le travail." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier travaille. Chaque créature cherche sa subsistance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour Allah transforme son travail en prière." }
  ],
  munajat: `Ya Ghani, fais que mon travail soit une quête de Ta grâce. Bénis mes efforts. Ne permets pas que je sois distrait de Toi.`
};

MIROIR["62:11"] = {
  reference: "62:11",
  theme: ["vendredi", "distraction", "commerce"],
  emotion: "Mise en garde, priorité",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabeer"],
  mirrorVersion: `« Et quand ils voient un commerce ou un divertissement, ils s'y précipitent et te laissent debout. » Le miroir me montre l'attitude de certains compagnons pendant la prière du vendredi. Le commerce et le divertissement les attirent plus que la prière. Le miroir m'interroge : qu'est-ce qui m'attire plus que la prière ?`,
  reflection: `Les distractions du monde peuvent nous éloigner de la prière. La priorité doit rester à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'aw tijaratan aw lahwan in-faddu ilayha wa tarakuka qa'im » — et quand ils voient un commerce ou un divertissement, ils s'y précipitent et te laissent debout." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'attire plus que la prière ? Le commerce, le divertissement, les réseaux sociaux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le commerce n'est pas interdit — c'est la priorité qui compte. La prière d'abord, puis le commerce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les distractions sont partout. La question est : qu'est-ce qui a la priorité ?" },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne la priorité à Allah dans la prière L'a dans tout." }
  ],
  munajat: `Ya Rabb, ne permets pas que les distractions m'éloignent de la prière. Donne-moi la force de rester avec Toi.`
};

// ============================================
// SURAH 63 - AL-MUNAFIQUN (LES HYPOCRITES)
// 11 verses
// ============================================

MIROIR["63:1"] = {
  reference: "63:1",
  theme: ["hypocrisie", "témoignage", "mensonge"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Ash-Shahid"],
  mirrorVersion: `« Quand les hypocrites viennent à toi, ils disent : Nous attestons que tu es le messager d'Allah. » Le miroir me montre le mensonge des hypocrites. Ils disent avec leurs lèvres ce que leurs cœurs nient. Le témoignage de la langue sans le cœur est un mensonge. Le miroir m'interroge : mon témoignage est-il sincère ?`,
  reflection: `Le témoignage sincère engage le cœur et la langue. L'hypocrisie est de dire sans croire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iza ja'aka al-munafiquna qalu nashhadu innaka la-rasulu Allahi » — quand les hypocrites viennent à toi, ils disent : nous attestons que tu es le messager d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon témoignage de foi est-il sincère ? Ou est-ce des paroles sans le cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah connaît le cœur. On ne peut pas Lui mentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, il n'y a pas de mensonge. Chaque chose est ce qu'elle est." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vrai avec Allah est vrai avec lui-même." }
  ],
  munajat: `Ya Haqq, connais mon cœur. Fais que mon témoignage soit sincère. Purifie-moi de l'hypocrisie.`
};

MIROIR["63:2"] = {
  reference: "63:2",
  theme: ["serment", "obstacle", "hypocrisie"],
  emotion: "Mise en garde, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-'Alim"],
  mirrorVersion: `« Ils ont pris leurs serments comme une protection et se sont détournés du chemin d'Allah. » Le miroir me montre comment les hypocrites utilisent le serment comme masque. Ils jurent pour cacher leur mécréance. Le serment devient un obstacle. Le miroir m'interroge : mes serments sont-ils sincères ou des masques ?`,
  reflection: `Le serment utilisé pour cacher la vérité est un péché. La sincérité doit traverser nos paroles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Attakhadhu aymanahum junnatan fasaddu 'an sabili Allahi » — ils ont pris leurs serments comme une protection et se sont détournés du chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise mes paroles pour cacher mes intentions ? Mes serments sont-ils sincères ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment qui cache la vérité n'est pas une protection — c'est une prison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une loi universelle. Tout finit par être révélé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vrai n'a pas besoin de masques." }
  ],
  munajat: `Ya 'Alim, Tu connais mes intentions. Fais que mes serments soient sincères. Ne permets pas que je cache la vérité.`
};

MIROIR["63:3"] = {
  reference: "63:3",
  theme: ["foi", "hypocrisie", "cœur"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Khaliq"],
  mirrorVersion: `« C'est parce qu'ils ont cru puis ont mécru. » Le miroir me montre le chemin de l'hypocrisie : croire puis mécroire. La foi n'est pas acquise une fois pour toutes — elle peut être perdue. Le miroir m'interroge : ma foi est-elle ferme ou chancelante ?`,
  reflection: `La foi n'est pas une acquisition définitive. Elle doit être entretenue, protégée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-annahum amanu thumma kafaru » — c'est parce qu'ils ont cru puis ont mécru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle ferme ? Qu'est-ce qui pourrait me la faire perdre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mécroire après avoir cru est pire que ne jamais avoir cru. C'est un retour en arrière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, tout croît ou décroît. Rien n'est statique. La foi aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa foi reçoit la fermeté." }
  ],
  munajat: `Ya Hadi, protège ma foi. Ne permets pas qu'elle chancelle. Donne-moi la fermeté jusqu'à la fin.`
};

MIROIR["63:4"] = {
  reference: "63:4",
  theme: ["apparence", "réalité", "hypocrisie"],
  emotion: "Discernement, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Khabir"],
  mirrorVersion: `« Quand tu les vois, leurs corps te plaisent. Et s'ils parlent, tu écoutes leurs paroles. » Le miroir me montre le piège des apparences. Les hypocrites sont beaux, éloquents, convaincants. Mais leurs cœurs sont vides. Le miroir m'interroge : est-ce que je me laisse séduire par les apparences ?`,
  reflection: `L'apparence peut tromper. La beauté et l'éloquence ne sont pas des preuves de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha ra'aytahum tu'jibuka ajsamuhum wa in yaqulu tasma' li-qawlihim » — quand tu les vois, leurs corps te plaisent. Et s'ils parlent, tu écoutes leurs paroles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse séduire par les apparences ? Par l'éloquence sans la substance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté extérieure sans la beauté intérieure est un masque." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, les couleurs vives peuvent cacher le poison. Le discernement est nécessaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regarde avec les yeux du cœur voit au-delà des apparences." }
  ],
  munajat: `Ya Basir, ouvre mes yeux. Ne permets pas que je sois trompé par les apparences. Donne-moi le discernement.`
};

MIROIR["63:5"] = {
  reference: "63:5",
  theme: ["pardon", "refus", "obstination"],
  emotion: "Mise en garde, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "At-Tawwab"],
  mirrorVersion: `« Et quand on leur dit : Venez, le messager d'Allah demandera pardon pour vous, ils détournent leurs têtes. » Le miroir me montre l'obstination des hypocrites. Même l'offre du pardon est rejetée. L'orgueil les empêche de se repentir. Le miroir m'interroge : est-ce que je refuse les occasions de repentir ?`,
  reflection: `Le refus du pardon est un signe d'hypocrisie. L'humble accepte le repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qila lahum ta'alaw yastaghfir lakum rasulu Allahi lawaw ru'usahum » — et quand on leur dit : Venez, le messager d'Allah demandera pardon pour vous, ils détournent leurs têtes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je saisis les occasions de repentir ? Ou est-ce que je les détourne par orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Détourner la tête du pardon, c'est se condamner soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se tourne vers Allah. Seul l'orgueilleux se détourne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le pardon découvre que la porte est toujours ouverte." }
  ],
  munajat: `Ya Ghaffur, je viens à Toi pour le pardon. Ne permets pas que l'orgueil m'en éloigne. Accepte mon repentir.`
};

MIROIR["63:7"] = {
  reference: "63:7",
  theme: ["dépense", "hypocrisie", "communauté"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Ghani"],
  mirrorVersion: `« Ce sont eux qui disent : Ne dépensez pas pour ceux qui sont avec le messager d'Allah. » Le miroir me montre l'égoïsme des hypocrites. Ils découragent la dépense pour la communauté. Ils veulent affamer les croyants. Le miroir m'interroge : est-ce que je soutiens la communauté ?`,
  reflection: `La dépense pour la communauté est un devoir. La retenir est un signe d'hypocrisie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hum alladhina yaquluna la tunfiqu 'ala man 'inda rasuli Allahi hatta yanfaddu » — ce sont eux qui disent : ne dépensez pas pour ceux qui sont avec le messager d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je soutiens la communauté ? Est-ce que je dépense pour les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les trésors appartiennent à Allah. Les retenir, c'est oublier la source." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne sans compter. Le soleil donne sa lumière à tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne pour Allah reçoit au-delà de son don." }
  ],
  munajat: `Ya Raziq, Tu es le Pourvoyeur. Fais que je donne pour Ta communauté. Ne permets pas que je sois avare.`
};

MIROIR["63:8"] = {
  reference: "63:8",
  theme: ["orgueil", "honneur", "hypocrisie"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Mu'izz"],
  mirrorVersion: `« Ils disent : Si nous retournons à Médine, le plus puissant en expulsera le plus faible. » Le miroir me montre l'orgueil des hypocrites. Ils pensent que la puissance est à eux. Mais l'honneur appartient à Allah et à Son messager. Le miroir m'interroge : d'où vient ma confiance ? De moi-même ou d'Allah ?`,
  reflection: `La vraie puissance vient d'Allah. L'orgueil est une illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaquluna la'in raja'na ila al-madinati la-yukhrijanna al-a'azzu minha al-azall » — ils disent : si nous retournons à Médine, le plus puissant en expulsera le plus faible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où vient ma confiance ? De moi-même ou d'Allah ? Est-ce que je me crois puissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans Allah est une illusion. Le faible avec Allah est fort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute puissance dans l'univers vient d'Allah. Il est la source de toute force." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa faiblesse reçoit la puissance d'Allah." }
  ],
  munajat: `Ya 'Aziz, Tu es le Puissant. Je suis faible sans Toi. Donne-moi Ta force. Ne permets pas que je m'enorgueillis.`
};

MIROIR["63:10"] = {
  reference: "63:10",
  theme: ["dépense", "mort", "regret"],
  emotion: "Urgence, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Hasib"],
  mirrorVersion: `« Et dépensez de ce que Nous vous avons donné avant que la mort ne vienne à l'un de vous. » Le miroir me montre l'urgence de la dépense. La mort peut venir à tout moment. Ce qu'on n'a pas donné sera perdu. Le miroir m'interroge : qu'est-ce que je donne avant que la mort ne vienne ?`,
  reflection: `La dépense avant la mort est une obligation. Attendre, c'est risquer de perdre tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anfiqu mimma razaqnakum min qabli an ya'tiya ahadakumu al-mawt » — et dépensez de ce que Nous vous avons donné avant que la mort ne vienne à l'un de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je donne maintenant ? Est-ce que j'attends trop pour donner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner maintenant, c'est investir pour l'éternité. Garder, c'est risquer tout perdre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort vient sans avertissement. Seule la préparation compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne avant la mort donne vraiment. Après, c'est trop tard." }
  ],
  munajat: `Ya Mumit, la mort peut venir à tout moment. Fais que je donne maintenant. Ne permets pas que je retarde.`
};

MIROIR["63:11"] = {
  reference: "63:11",
  theme: ["délai", "mort", "réalisation"],
  emotion: "Réalité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Mumit"],
  mirrorVersion: `« Et Allah n'accordera jamais de délai à une âme quand son terme sera venu. » Le miroir me montre la finalité de la mort. Quand le terme vient, il n'y a pas de prolongation. Pas de deuxième chance. Le miroir m'interroge : suis-je prêt à rencontrer Allah maintenant ?`,
  reflection: `Le terme est fixé. Il n'y a pas de négociation possible avec la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Allahu la yu'akhkhiru nafsan idha ja'a ajaluha » — et Allah n'accordera jamais de délai à une âme quand son terme sera venu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à rencontrer Allah maintenant ? Si mon terme était aujourd'hui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai demandé à la mort est impossible. Le délai demandé à Allah maintenant est possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose a son terme. L'univers lui-même a un terme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit chaque jour comme le dernier ne sera pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, mon terme est connu de Toi. Prépare-moi. Fais que je sois prêt quand il viendra.`
};

// ============================================
// SURAH 64 - AT-TAGHABUN (LA PERTE ET LE GAIN)
// 18 verses
// ============================================

MIROIR["64:1"] = {
  reference: "64:1",
  theme: ["gloire", "création", "toute-puissance"],
  emotion: "Adoration, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« Tout ce qui est dans les cieux et sur terre glorifie Allah. À Lui la royauté. » Le miroir me place dans la louange universelle. La création tout entière célèbre son Créateur. La royauté Lui appartient — pas aux rois de ce monde. Le miroir m'interroge : ma vie participe-t-elle à cette glorification ?`,
  reflection: `La glorification est le chant de l'univers. La royauté est à Allah seul.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusabbihu li-Allahi ma fi as-samawati wa ma fi al-ard, lahu al-mulk » — tout ce qui est dans les cieux et sur terre glorifie Allah. À Lui la royauté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Allah ? Est-ce que je reconnais Sa royauté sur ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La royauté d'Allah n'est pas une oppression — c'est une protection. Sous Son règne, je suis en sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un royaume où Allah est le Roi. Chaque créature est un sujet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la royauté d'Allah devient noble." }
  ],
  munajat: `Ya Malik, Tu es le Roi. Je reconnais Ta royauté sur ma vie. Fais que je vive sous Ton règne.`
};

MIROIR["64:2"] = {
  reference: "64:2",
  theme: ["créateur", "foi", "mécréance"],
  emotion: "Gratitude, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hadi"],
  mirrorVersion: `« C'est Lui qui vous a créés. Parmi vous, il y a des mécréants et des croyants. » Le miroir me montre la diversité des réponses à la création. Allah crée, mais les créatures choisissent : croire ou mécroire. Le miroir m'interroge : quel est mon choix ?`,
  reflection: `La création est un don. La réponse est un choix. Croire ou mécroire — telle est la question.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi khalaqakum fa-minkum kafirun wa minkum mu'min » — c'est Lui qui vous a créés. Parmi vous, il y a des mécréants et des croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon choix ? Suis-je du côté des croyants ou des mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah crée la capacité de croire et de mécroire. Le choix nous appartient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque chose a sa place. Le croyant et le mécréant ont leur place aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la foi choisit la meilleure part." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé. Je choisis la foi. Aide-moi à rester parmi les croyants.`
};

MIROIR["64:3"] = {
  reference: "64:3",
  theme: ["création", "beauté", "forme"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Musawwir", "Al-Khaliq"],
  mirrorVersion: `« Il a créé les cieux et la terre avec vérité et vous a donné votre forme — et quelle belle forme ! » Le miroir me place devant ma propre création. Ma forme n'est pas un hasard — elle est voulue, pensée, harmonieuse. Le miroir m'interroge : est-ce que j'accepte ma forme comme un don ?`,
  reflection: `La forme humaine est une grâce. L'accepter, c'est remercier le Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa as-samawati wa al-arda bi-al-haqqi wa sawwarakum fa-ahsana suwarakum » — il a créé les cieux et la terre avec vérité et vous a donné votre forme — et quelle belle forme !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma forme ? Est-ce que je la vois comme belle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté de la forme n'est pas dans la perfection — elle est dans l'intention du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa forme. Chaque forme a sa beauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit sa forme comme un don l'utilise pour Allah." }
  ],
  munajat: `Ya Musawwir, Tu m'as formé. Merci pour cette forme. Aide-moi à l'utiliser pour Toi.`
};

MIROIR["64:4"] = {
  reference: "64:4",
  theme: ["connaissance", "secret", "cœur"],
  emotion: "Révérence, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Il sait ce qui est dans les cieux et sur terre, et Il sait ce que vous cachez et ce que vous divulguez. » Le miroir me place devant la connaissance absolue d'Allah. Rien n'est caché — ni dans les cieux, ni sur terre, ni dans mon cœur. Le miroir m'interroge : qu'est-ce que je cache ?`,
  reflection: `La connaissance d'Allah est totale. Rien ne Lui échappe — ni les secrets, ni les pensées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamu ma fi as-samawati wa al-ard wa ya'lamu ma tusirruna wa ma tu'linun » — Il sait ce qui est dans les cieux et sur terre, et Il sait ce que vous cachez et ce que vous divulguez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Suis-je en paix avec ce que je cache ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le secret n'est pas un péché — c'est ce qu'on cache qui compte. Cacher le bien est différent de cacher le mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, rien n'est vraiment caché. Tout finit par être révélé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a rien à cacher est libre." }
  ],
  munajat: `Ya 'Alim, Tu connais tout. Je ne peux rien Te cacher. Purifie ce que je cache. Fais que je sois transparent devant Toi.`
};

MIROIR["64:5"] = {
  reference: "64:5",
  theme: ["histoire", "mécréance", "châtiment"],
  emotion: "Mise en garde, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« Ne vous est-elle pas parvenue la nouvelle de ceux qui ont mécru auparavant et qui ont goûté les conséquences de leur conduite ? » Le miroir me montre l'histoire comme enseignement. Les peuples passés ont mécru et ont subi les conséquences. L'histoire n'est pas un divertissement — c'est une leçon. Le miroir m'interroge : qu'est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire est une enseignante. Les peuples passés sont des exemples — en bien ou en mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam ya'tikum naba'u alladhina kafaru min qablu fa-dhawu wabala amrihim » — ne vous est-elle pas parvenue la nouvelle de ceux qui ont mécru auparavant et qui ont goûté les conséquences de leur conduite ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends de l'histoire ? Est-ce que je tire des leçons des peuples passés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les conséquences ne sont pas une punition arbitraire — c'est le résultat naturel des choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action a une réaction. C'est une loi universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, l'histoire est pleine de leçons. Fais que j'apprenne des erreurs des autres. Ne permets pas que je les répète.`
};

MIROIR["64:6"] = {
  reference: "64:6",
  theme: ["messagers", "mécréance", "excuse"],
  emotion: "Responsabilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "An-Nadhir"],
  mirrorVersion: `« C'est parce que leurs messagers leur apportaient les preuves et qu'ils ont dit : Des humains nous guideraient-ils ? » Le miroir me montre l'excuse des mécréants : les messagers sont humains. L'orgueil les empêche d'accepter la guidance d'un homme. Le miroir m'interroge : est-ce que je refuse la guidance à cause de qui la porte ?`,
  reflection: `La guidance peut venir par n'importe qui. L'orgueil peut nous en empêcher.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-annahu qad ja'at-hum rusuluhum bi-al-bayyinati fa-qalu abasharun yahdunana » — c'est parce que leurs messagers leur apportaient les preuves et qu'ils ont dit : des humains nous guideraient-ils ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je refuse la guidance à cause de qui la porte ? L'orgueil m'empêche-t-il d'écouter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le messager humain est un honneur pour l'humanité — pas une faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance vient toujours par un intermédiaire. L'ange, le prophète, le livre — tous sont des moyens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la guidance, peu importe qui la porte, trouve le chemin." }
  ],
  munajat: `Ya Rabb, fais que j'accepte la guidance peu importe qui la porte. Ne permets pas que l'orgueil m'en empêche.`
};

MIROIR["64:7"] = {
  reference: "64:7",
  theme: ["résurrection", "négation", "châtiment"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Haqq"],
  mirrorVersion: `« Ceux qui ont mécru prétendent qu'ils ne seront jamais ressuscités. » Le miroir me montre le déni de la résurrection. Les mécréants nient ce qui est certain. Le déni ne change pas la réalité. Le miroir m'interroge : est-ce que je crois vraiment en la résurrection ?`,
  reflection: `La résurrection est certaine. La nier ne l'empêche pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Za'ama alladhina kafaru an lan yub'athu » — ceux qui ont mécru prétendent qu'ils ne seront jamais ressuscités." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en la résurrection ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Nier la résurrection ne l'annule pas. C'est se mentir à soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, tout se transforme. La mort n'est pas une fin — c'est une transition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection vit différemment." }
  ],
  munajat: `Ya Ba'ith, je crois en la résurrection. Prépare-moi pour ce jour. Fais que je vive en conscience de la vie éternelle.`
};

MIROIR["64:8"] = {
  reference: "64:8",
  theme: ["foi", "révélation", "messager"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mursal"],
  mirrorVersion: `« Croyez donc en Allah, en Son messager et en la lumière que Nous avons fait descendre. » Le miroir m'appelle à la foi complète. « Aminu » — croyez. « Billahi » — en Allah. « Wa rasulihi » — et en Son messager. « Wa al-nuri » — et en la lumière. La foi englobe Allah, le messager et la révélation. Le miroir m'interroge : est-ce que ma foi est complète ?`,
  reflection: `La foi complète englobe le Créateur, le messager et la révélation. Les trois sont liés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aminu billahi wa rasulihi wa al-nuri alladhi anzalna » — croyez en Allah, en Son messager et en la lumière que Nous avons fait descendre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est complète ? Est-ce que je crois en Allah, en Son messager et en Sa révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière sans le messager est incomprise. Le messager sans la lumière est vide. Allah est la source des deux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière du soleil illumine le monde. La lumière de la révélation illumine le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la lumière devient lumière." }
  ],
  munajat: `Ya Hadi, je crois en Toi, en Ton messager et en Ta lumière. Illumine mon cœur. Fais que je sois parmi les croyants complets.`
};

MIROIR["64:9"] = {
  reference: "64:9",
  theme: ["rassemblement", "jour dernier", "erreur"],
  emotion: "Espérance, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Hakim"],
  mirrorVersion: `« Le jour où Il vous rassemblera pour le Jour du Rassemblement, ce sera le jour de la perte et du gain. » Le miroir me projette vers le Jour dernier. Certains perdront, d'autres gagneront. Le résultat dépend des choix d'ici-bas. Le miroir m'interroge : suis-je du côté de la perte ou du gain ?`,
  reflection: `Le Jour du Rassemblement est le jour de vérité. Chacun verra le résultat de ses choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yajma'ukum li-yawmi al-jam'i dhalika yawmu at-taghbuni » — le jour où Il vous rassemblera pour le Jour du Rassemblement, ce sera le jour de la perte et du gain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je du côté de la perte ou du gain ? Qu'est-ce que je gagne ou perds ici-bas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte n'est pas une punition — c'est le résultat des choix. Le gain n'est pas un hasard — c'est le résultat de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque action a une conséquence. Le Jour dernier révèle toutes les conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le gain et la perte ici-bas gagne là-bas." }
  ],
  munajat: `Ya Jami', rassemble-moi parmi les gagnants. Fais que je sois du côté du gain, pas de la perte.`
};

MIROIR["64:10"] = {
  reference: "64:10",
  theme: ["mécréance", "feu", "éternité"],
  emotion: "Mise en garde, gravité",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Jahim"],
  mirrorVersion: `« Et ceux qui ont mécru et traité de mensonges Nos signes, ce sont les gens du Feu où ils demeureront éternellement. » Le miroir me montre la conséquence ultime : le Feu éternel pour les mécréants. La mécréance n'est pas un petit péché — c'est un choix éternel. Le miroir m'interroge : est-ce que je comprends la gravité de la mécréance ?`,
  reflection: `Le Feu est la conséquence de la mécréance. La foi est le chemin vers le salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina kafaru wa kadhdhabu bi-ayatina ula'ika ashabu an-nari khalidina fiha » — et ceux qui ont mécru et traité de mensonges Nos signes, ce sont les gens du Feu où ils demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la gravité de la mécréance ? Est-ce que je protège ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Feu n'est pas une punition arbitraire — c'est la conséquence du refus de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, le feu existe réellement. Le Feu de l'au-delà est sa manifestation spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit le Feu en ce monde en allant vers Allah le fuit aussi dans l'autre." }
  ],
  munajat: `Ya Rabb, préserve-moi du Feu. Fais que je reste parmi les croyants. Ne permets pas que je sois du nombre des mécréants.`
};

MIROIR["64:12"] = {
  reference: "64:12",
  theme: ["obéissance", "obéissance", "pureté"],
  emotion: "Soumission, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Aziz"],
  mirrorVersion: `« Obéissez à Allah et obéissez au messager. » Le miroir me montre le chemin simple : obéir à Allah et à Son messager. Pas de complications, pas d'excuses. L'obéissance est le chemin. Le miroir m'interroge : est-ce que j'obéis vraiment ?`,
  reflection: `L'obéissance à Allah et au messager est le chemin droit. Simple à dire, exigeant à vivre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ati'u Allaha wa ati'u ar-rasula » — obéissez à Allah et obéissez au messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis vraiment ? Ou est-ce que je choisis ce qui m'arrange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance n'est pas une soumission aveugle — c'est une confiance éclairée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque chose obéit à sa nature. L'homme choisit d'obéir ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit trouve la liberté. L'obéissance à Allah libère." }
  ],
  munajat: `Ya Rabb, je veux obéir. Aide-moi à obéir à Toi et à Ton messager. Ne permets pas que je désobéisse.`
};

MIROIR["64:13"] = {
  reference: "64:13",
  theme: ["unicité", "confiance", "foi"],
  emotion: "Paix, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Wakil"],
  mirrorVersion: `« Allah ! Nulle divinité que Lui. Et qu'Allah place sa confiance en Lui. » Le miroir me place devant l'unicité absolue. Allah seul mérite la confiance. Le miroir m'interroge : en qui je mets ma confiance ?`,
  reflection: `L'unicité d'Allah est le fondement de la foi. En Lui seul, on peut se confier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu la ilaha illa huwa wa 'ala Allahi fa-l-yatawakkal al-mu'minun » — Allah ! Nulle divinité que Lui. Et que les croyants placent leur confiance en Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "En qui je mets ma confiance ? En Allah ou dans les créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah n'exclut pas l'effort — elle le soutient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque chose se fie à son Créateur. L'homme doit choisir de le faire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah découvre qu'Il suffit." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Je me confie à Toi. Sois Celui qui suffit.`
};

MIROIR["64:14"] = {
  reference: "64:14",
  theme: ["famille", "épreuve", "attachement"],
  emotion: "Lucidité, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Ô vous qui croyez ! Parmi vos épouses et vos enfants, il y a des ennemis pour vous. » Le miroir me montre un danger caché : la famille peut devenir un obstacle. L'attachement excessif aux proches peut détourner d'Allah. Le miroir m'interroge : ma famille m'éloigne-t-elle d'Allah ?`,
  reflection: `La famille est une bénédiction, mais peut devenir un obstacle si l'attachement est excessif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu inna min azwajikum wa awladikum 'aduwwan lakum » — ô vous qui croyez ! Parmi vos épouses et vos enfants, il y a des ennemis pour vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma famille m'éloigne-t-elle d'Allah ? Comment équilibrer amour familial et amour divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La famille n'est pas l'ennemi — c'est l'attachement excessif qui l'est." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, les liens familiaux sont naturels. L'excès d'attachement est humain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime sa famille en Allah transforme l'amour humain en amour divin." }
  ],
  munajat: `Ya Rabb, ma famille est un don. Fais que je l'aime en Toi. Ne permets pas qu'elle me détourne de Toi.`
};

MIROIR["64:15"] = {
  reference: "64:15",
  theme: ["biens", "épreuve", "piété"],
  emotion: "Lucidité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Malik"],
  mirrorVersion: `« Vos biens et vos enfants ne sont qu'une tentation. » Le miroir me montre que tout ce que j'ai est une épreuve. Les biens, les enfants — tout est test. Le miroir m'interroge : comment je gère mes biens et ma famille ?`,
  reflection: `Tout est épreuve. Les biens et les enfants testent notre foi et notre gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama amwalukum wa awladukum fitnah » — vos biens et vos enfants ne sont qu'une tentation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère mes biens et ma famille ? Sont-ils des tentations ou des bénédictions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tentation n'est pas le péché — c'est l'occasion de la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers est un test. La réussite est dans la bonne réponse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit tout comme épreuve passe le test avec succès." }
  ],
  munajat: `Ya Rabb, tout est épreuve. Aide-moi à passer le test. Fais que mes biens et ma famille me rapprochent de Toi.`
};

MIROIR["64:16"] = {
  reference: "64:16",
  theme: ["piété", "dépense", "provision"],
  emotion: "Engagement, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Warith", "Al-Ghani"],
  mirrorVersion: `« Craignez Allah autant que vous le pouvez. » Le miroir me montre la piété comme orientation, pas perfection. On craint Allah selon sa capacité. Puis le verset continue : « Dépensez de ce que Nous vous avons donné. » La piété inclut la générosité. Le miroir m'interroge : est-ce que je crains Allah selon ma capacité ?`,
  reflection: `La piété est un effort constant. La générosité en fait partie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittaqu Allaha ma istata'tum » — craignez Allah autant que vous le pouvez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah selon ma capacité ? Est-ce que je dépense de ce que j'ai reçu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété n'est pas la peur — c'est la conscience respectueuse. Elle mène à la générosité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature vit dans la conscience de son Créateur. L'homme doit le faire par choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah découvre que cette crainte est amour." }
  ],
  munajat: `Ya Rabb, je Te crains autant que je le peux. Aide-moi à donner de ce que j'ai reçu. Augmente ma piété.`
};

MIROIR["64:17"] = {
  reference: "64:17",
  theme: ["prêt", "récompense", "générosité"],
  emotion: "Espérance, générosité",
  difficulty: "débutant",
  relatedNames: ["Al-Shakur", "Al-Karim"],
  mirrorVersion: `« Si vous faites un bon prêt à Allah, Il vous le multipliera. » Le miroir me montre le beau prêt à Allah. Ce qu'on donne pour Allah revient multiplié. Allah est le Meilleur des débiteurs. Le miroir m'interroge : est-ce que je fais ce prêt à Allah ?`,
  reflection: `Le prêt à Allah est la dépense dans Son chemin. Le retour dépasse toute attente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tuqridu Allaha qardan hasanan yuda'ifkum » — si vous faites un bon prêt à Allah, Il vous le multipliera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais ce prêt à Allah ? Qu'est-ce que je Lui prête ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah n'a pas besoin de notre prêt — c'est nous qui avons besoin de Sa multiplication." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, ce qu'on donne revient. La semence devient récolte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prête à Allah découvre que le retour est infini." }
  ],
  munajat: `Ya Shakur, Tu es le Reconnaissant. Accepte mon prêt. Multiplie-le au-delà de mon attente.`
};

MIROIR["64:18"] = {
  reference: "64:18",
  theme: ["connaissance", "secret", "sagesse"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Le Connaisseur de l'invisible et du visible, le Puissant, le Sage. » Le miroir me place devant les noms d'Allah. Il connaît tout — le caché et le manifeste. Il est Puissant et Sage. Ces noms me rassurent. Le miroir m'interroge : est-ce que je me confie à Celui qui sait tout ?`,
  reflection: `La connaissance d'Allah est totale. Sa puissance et Sa sagesse sont parfaites. En Lui, je peux me confier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alimu al-ghaybi wa ash-shahadati al-'azizu al-hakim » — le Connaisseur de l'invisible et du visible, le Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me confie à Celui qui sait tout ? À Celui qui est puissant et sage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sa connaissance n'est pas surveillance — c'est protection. Sa puissance n'est pas oppression — c'est soutien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est connu d'Allah. Rien ne Lui échappe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie au Connaisseur trouve la paix." }
  ],
  munajat: `Ya 'Alim, ya 'Aziz, ya Hakim, Tu sais tout. Tu es puissant et sage. Je me confie à Toi.`
};

// ============================================
// SURAH 65 - AT-TALAQ (LE DIVORCE)
// 12 verses
// ============================================

MIROIR["65:1"] = {
  reference: "65:1",
  theme: ["divorce", "période", "loi"],
  emotion: "Sagesse, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Ô Prophète ! Quand vous divorcez d'avec les femmes, divorcez selon leur période. » Le miroir me montre la sagesse des lois divines. Le divorce n'est pas un abandon — c'est un processus réglé. La période de viduité protège la femme. Le miroir m'interroge : est-ce que je respecte les lois d'Allah dans mes relations ?`,
  reflection: `Les lois divines protègent les plus vulnérables. Le divorce réglé protège la femme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha an-nabiyyu idza tallaqtumu an-nisa' fa-talliquhunna li-'iddatihinna » — ô Prophète ! Quand vous divorcez d'avec les femmes, divorcez selon leur période." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les lois d'Allah dans mes relations ? Suis-je juste avec les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loi divine n'est pas une contrainte — c'est une protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque processus a ses règles. L'homme doit les respecter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les lois d'Allah trouve la bénédiction." }
  ],
  munajat: `Ya Hakim, Tes lois sont sages. Aide-moi à les respecter. Fais que je sois juste dans mes relations.`
};

MIROIR["65:2"] = {
  reference: "65:2",
  theme: ["période", "témoins", "réconciliation"],
  emotion: "Justice, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Ash-Shahid"],
  mirrorVersion: `« Quand elles atteignent leur terme, retenez-les convenablement ou séparez-vous d'elles convenablement. » Le miroir me montre deux options à la fin de la période : la réconciliation ou la séparation, mais toujours avec convenance. Le miroir m'interroge : est-ce que je me sépare avec dignité ?`,
  reflection: `La séparation peut être digne. La réconciliation aussi. La convenance est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha balaghna ajalahunna fa-amsikuhunna bi-ma'rufin aw fariquhunna bi-ma'ruf » — quand elles atteignent leur terme, retenez-les convenablement ou séparez-vous d'elles convenablement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sépare avec dignité ? Est-ce que je retiens avec bonté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La séparation n'est pas un échec — c'est parfois la meilleure solution. La dignité doit être préservée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, les unions et les séparations ont leur temps. La dignité reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se sépare avec dignité préserve son âme." }
  ],
  munajat: `Ya 'Adl, la justice et la dignité. Fais que je sois juste dans mes séparations comme dans mes unions.`
};

MIROIR["65:4"] = {
  reference: "65:4",
  theme: ["période", "femmes", "compassion"],
  emotion: "Compassion, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Rahman", "Al-Hakim"],
  mirrorVersion: `« Pour celles qui ont désespéré de menstruer, la période est de trois mois. » Le miroir me montre la loi divine qui s'adapte aux situations. Les femmes ménopausées ont une période raccourcie. La compassion s'adapte aux circonstances. Le miroir m'interroge : est-ce que j'adapte ma compassion aux situations ?`,
  reflection: `La loi divine s'adapte aux circonstances. La compassion est proportionnée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa allati ya'isna mina al-mahidi min nisa'ikum » — pour celles qui ont désespéré de menstruer..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adapte ma compassion aux situations ? Est-ce que je suis flexible dans ma bienveillance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adaptation n'est pas une faiblesse — c'est une sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque créature s'adapte à son environnement. L'homme doit s'adapter avec sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adapte sa compassion reflète la miséricorde d'Allah." }
  ],
  munajat: `Ya Rahman, Tu es le Miséricordieux. Fais que ma compassion s'adapte aux situations. Sois compatissant envers moi.`
};

MIROIR["65:5"] = {
  reference: "65:5",
  theme: ["commandement", "limites", "science"],
  emotion: "Obéissance, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« C'est le commandement d'Allah qu'Il a fait descendre vers vous. » Le miroir me montre l'origine des lois : Allah Lui-même. Ce ne sont pas des inventions humaines, mais des commandements divins. Le miroir m'interroge : est-ce que je reconnais l'origine divine des lois ?`,
  reflection: `Les lois divines viennent d'Allah. Les reconnaître, c'est reconnaître Sa souveraineté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka hududu Allahi » — ce sont les limites d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'origine divine des lois ? Est-ce que je respecte les limites d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les limites d'Allah ne sont pas des interdits arbitraires — ce sont des protections." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers a ses limites. Les franchir, c'est le désordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les limites d'Allah trouve l'ordre et la paix." }
  ],
  munajat: `Ya Rabb, Tes limites sont sages. Aide-moi à les respecter. Ne permets pas que je les franchisse.`
};

MIROIR["65:6"] = {
  reference: "65:6",
  theme: ["hébergement", "dépense", "justice"],
  emotion: "Justice, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Raziq", "Al-'Adl"],
  mirrorVersion: `« Faites-les demeurer où vous habitez, selon vos moyens. » Le miroir me montre les obligations du mari envers la femme divorcée. L'hébergement et la dépense selon les moyens. La justice continue même après la séparation. Le miroir m'interroge : est-ce que je suis juste même quand je n'y suis pas obligé par la loi ?`,
  reflection: `La justice continue au-delà des obligations légales. L'honneur est dans la bienveillance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Askinuhunna min haythu sakantum min wujdikum » — faites-les demeurer où vous habitez, selon vos moyens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis juste même quand je n'y suis pas obligé ? Est-ce que je vais au-delà du minimum ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice minimale est un devoir. La justice au-delà est une excellence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque créature reçoit ce dont elle a besoin. L'homme doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste au-delà du minimum reflète la générosité d'Allah." }
  ],
  munajat: `Ya 'Adl, aide-moi à être juste au-delà du minimum. Fais que je sois généreux même quand je ne suis pas obligé.`
};

MIROIR["65:7"] = {
  reference: "65:7",
  theme: ["dépense", "moyens", "justice"],
  emotion: "Équité, réalisme",
  difficulty: "débutant",
  relatedNames: ["Ar-Raziq", "Al-Muqsit"],
  mirrorVersion: `« Que celui qui a des ressources dépense selon ses moyens. » Le miroir me montre la loi de la proportionnalité. On dépense selon ce qu'on a. Les riches donnent plus, les pauvres moins. La justice est dans la proportion, pas dans l'égalité absolue. Le miroir m'interroge : est-ce que je dépense selon mes moyens ?`,
  reflection: `La dépense est proportionnée aux moyens. Allah ne demande pas l'impossible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Layunaffiq dhu sa'atin min sa'atihi » — que celui qui a des ressources dépense selon ses moyens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dépense selon mes moyens ? Suis-je réaliste dans mes dépenses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah ne demande pas ce qu'on n'a pas. Il demande selon ce qu'Il a donné." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, chaque créature donne selon sa capacité. L'arbre donne selon sa taille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne selon ses moyens est accepté par Allah." }
  ],
  munajat: `Ya Raziq, Tu m'as donné selon Ta générosité. Fais que je donne selon mes moyens. Accepte ma contribution.`
};

MIROIR["65:8"] = {
  reference: "65:8",
  theme: ["villes", "désobéissance", "châtiment"],
  emotion: "Mise en garde, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Jabbar"],
  mirrorVersion: `« Que de villes se sont rebellées contre le commandement de leur Seigneur et de Ses messagers ! » Le miroir me montre l'histoire des peuples désobéissants. La rébellion contre Allah et Ses messagers mène au châtiment. L'histoire est pleine d'exemples. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire est un enseignement. Les peuples rebelles sont des exemples.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ka'ayyin min qaryatin 'atat 'an amri Rabbiha wa rusulihi » — que de villes se sont rebellées contre le commandement de leur Seigneur et de Ses messagers !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les erreurs du passé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rébellion n'est pas la liberté — c'est l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque désordre a des conséquences. L'histoire le montre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire n'a pas besoin de la répéter." }
  ],
  munajat: `Ya Rabb, l'histoire est un enseignement. Fais que j'apprenne des erreurs des autres. Ne permets pas que je me rebelle.`
};

MIROIR["65:9"] = {
  reference: "65:9",
  theme: ["châtiment", "amertume", "issue"],
  emotion: "Gravité, réalisation",
  difficulty: "débutant",
  relatedNames: ["Al-Shadid", "Al-Muntaqim"],
  mirrorVersion: `« Elles ont goûté la conséquence de leur conduite, et la conséquence en fut funeste. » Le miroir me montre le résultat de la désobéissance : un goût amer. Les conséquences ne sont pas abstraites — elles se goûtent. Le miroir m'interroge : quel goût ma vie aura-t-elle ?`,
  reflection: `Les conséquences se goûtent. La désobéissance laisse un goût amer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-dhaqat wabala amriha wa kana 'aqibatu amriha khusr » — elles ont goûté la conséquence de leur conduite, et la conséquence en fut funeste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel goût ma vie aura-t-elle ? Est-ce que j'anticipe les conséquences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le goût amer n'est pas la punition — c'est le résultat naturel du choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque action a un goût. Les bonnes actions sont douces, les mauvaises sont amères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui anticipe les conséquences choisit le goût doux." }
  ],
  munajat: `Ya Rabb, je veux que ma vie soit douce. Fais que j'anticipe les conséquences. Préserve-moi du goût amer.`
};

MIROIR["65:10"] = {
  reference: "65:10",
  theme: ["préparation", "châtiment", "sagesse"],
  emotion: "Urgence, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Shadid", "Al-Hakim"],
  mirrorVersion: `« Allah a préparé pour eux un châtiment sévère. Craignez Allah, ô vous qui êtes doués d'intelligence. » Le miroir me montre l'urgence de la préparation. Le châtiment est prêt. Seuls les intelligents le craignent et se préparent. Le miroir m'interroge : suis-je de ceux qui craignent et se préparent ?`,
  reflection: `Le châtiment est prêt. La crainte d'Allah est le signe de l'intelligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'adda Allahu lahum 'adhaban shadidan fa-ttaqu Allaha ya uli al-albab » — Allah a préparé pour eux un châtiment sévère. Craignez Allah, ô vous qui êtes doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je de ceux qui craignent et se préparent ? Mon intelligence me pousse-t-elle à la piété ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte n'est pas la terreur — c'est la conscience responsable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'univers, chaque créature intelligente anticipe les dangers. L'homme doit faire de même avec l'au-delà." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant n'aura pas peur du châtiment." }
  ],
  munajat: `Ya Rabb, je Te crains. Prépare-moi. Fais que mon intelligence me pousse à la piété.`
};

MIROIR["65:11"] = {
  reference: "65:11",
  theme: ["messager", "récitation", "guidance"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Un messager qui vous récite les versets d'Allah. » Le miroir me montre le don de la révélation. Le messager récite les versets qui éclairent le chemin. La guidance est offerte. Le miroir m'interroge : est-ce que j'écoute la récitation ?`,
  reflection: `La récitation est une lumière. L'écouter, c'est s'éclairer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rasulan yatlu 'alaykum ayati Allahi » — un messager qui vous récite les versets d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute la récitation ? Est-ce que je me laisse éclairer par les versets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le messager ne récite pas pour lui-même — il récite pour nous. L'écouter, c'est honorer son effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière existe pour être reçue. Les versets sont une lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute la récitation avec le cœur devient lumière." }
  ],
  munajat: `Ya Nur, Tu es la Lumière. Fais que j'écoute Ta récitation. Éclaire mon cœur par Tes versets.`
};

MIROIR["65:12"] = {
  reference: "65:12",
  theme: ["création", "sept", "commandement"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Malik"],
  mirrorVersion: `« Allah qui a créé sept cieux et autant de terres. » Le miroir me place devant la grandeur de la création. Sept cieux, sept terres — la création est immense. Le commandement descend à travers tout cela. Le miroir m'interroge : est-ce que je réalise la grandeur d'Allah ?`,
  reflection: `La création est immense. Allah est le Créateur de tout. Son commandement traverse les cieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu alladhi khalaqa sab'a samawatin wa mina al-ardi mithlahunna » — Allah qui a créé sept cieux et autant de terres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise la grandeur d'Allah ? Est-ce que je suis émerveillé par Sa création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur de la création n'écrase pas — elle élève. Plus Allah est grand, plus je suis honoré de Le connaître." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est immense. La terre est un grain de sable. Allah est plus grand que tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la grandeur d'Allah devient petit devant Lui — et c'est là sa grandeur." }
  ],
  munajat: `Ya Khaliq, Tu as créé les sept cieux. Je suis émerveillé. Fais que je Te connais dans Ta grandeur.`
};

// ==================== SURAH 66: AT-TAHRIM (12 verses) ====================

MIROIR["66:1"] = {
  reference: "66:1",
  theme: ["interdiction", "prophète", "femmes"],
  emotion: "Attention, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Ô Prophète ! Pourquoi t'interdis-tu ce qu'Allah t'a rendu licite, recherchant ainsi l'agrément de tes épouses ? » Le miroir me montre une scène intime du foyer prophétique. Le Prophète lui-même, dans sa dévotion, s'interdisait ce qu'Allah avait permis — par souci de plaire à ses épouses. Et Allah intervient pour dire : ne t'interdis pas ce que J'ai rendu licite. Le miroir m'interroge : est-ce que je m'impose des restrictions qu'Allah n'a pas demandées ? La religion n'est pas une accumulation d'interdits auto-imposés.`,
  reflection: `Allah corrige Son Prophète par amour. L'excès de zèle peut devenir un fardeau non demandé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha an-nabiyyu lima tuharrimu ma ahalla Allahu laka » — ô Prophète, pourquoi t'interdis-tu ce qu'Allah t'a rendu licite ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'impose des restrictions qu'Allah n'a pas demandées ? Ma spiritualité est-elle équilibrée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction non demandée n'est pas de la piété — c'est un fardeau. Allah veut la facilité, pas la difficulté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la religion, il y a équilibre. Ni permissivité excessive, ni rigidité inutile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la voie médiane trouve la paix. L'excès mène à l'épuisement." }
  ],
  munajat: `Ya Hakim, Tu es la Sagesse. Apprends-moi l'équilibre. Ne permets pas que je m'impose ce que Tu n'as pas demandé.`
};

MIROIR["66:2"] = {
  reference: "66:2",
  theme: ["serment", "expiation", "pardon"],
  emotion: "Soulagement, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« Allah a déjà prescrit pour vous la dispense de vos serments. » Le miroir me montre la miséricorde dans la loi. Quand on fait un serment et qu'on ne peut pas le tenir, Allah a prévu une expiation. Il ne nous laisse pas coincés dans nos promesses impossibles. Le miroir m'interroge : est-ce que je connais les dispenses qu'Allah a prévues ?`,
  reflection: `Allah a prévu des issues. Les serments peuvent être expiés. La religion est pratique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad farada Allahu lakum tahillatu aymanihim » — Allah a déjà prescrit pour vous la dispense de vos serments." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les dispenses qu'Allah a prévues ? Est-ce que je sais comment expier mes serments ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'expiation n'est pas une défaite — c'est une miséricorde. Allah facilite ce qu'Il demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la loi divine, il y a toujours une issue. Allah ne veut pas la difficulté pour Ses serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les dispenses d'Allah ne se sent jamais piégé." }
  ],
  munajat: `Ya Ghaffur, Tu es le Pardonneur. Merci pour Tes dispenses. Apprends-moi Tes lois avec facilité.`
};

MIROIR["66:3"] = {
  reference: "66:3",
  theme: ["secret", "révélation", "confiance"],
  emotion: "Gravité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sami'", "Al-'Alim"],
  mirrorVersion: `« Et quand le Prophète confia un secret à l'une de ses épouses... » Le miroir me montre la fragilité de la confiance. Un secret confié a été divulgué — et Allah l'a révélé à Son Prophète. Les secrets ne restent pas cachés devant Allah. Le miroir m'interroge : est-ce que je garde les secrets qu'on me confie ?`,
  reflection: `Les secrets confiés doivent être gardés. Allah voit et sait tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh asarra an-nabiyyu ila ba'di azwajihi hadithan » — et quand le Prophète confia un secret à l'une de ses épouses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je garde les secrets ? Est-ce que je trahis la confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La trahison du secret n'est pas qu'une faute sociale — c'est une faute spirituelle. Allah voit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans les relations humaines, la confiance est fragile. La trahir, c'est briser le lien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde les secrets est digne de confiance auprès d'Allah." }
  ],
  munajat: `Ya Sami', Tu entends tout. Fais que je garde les secrets. Ne permets pas que je trahisse la confiance.`
};

MIROIR["66:4"] = {
  reference: "66:4",
  theme: ["repentir", "cœurs", "réconciliation"],
  emotion: "Espoir, invitation",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Si vous vous repentez à Allah, vos cœurs se réconcilieront. » Le miroir me montre le lien entre le repentir et la réconciliation des cœurs. Le péché crée la distance. Le repentir réunit. Quand on se repent, les cœurs se rapprochent. Le miroir m'interroge : est-ce que je me repens pour réconcilier mon cœur ?`,
  reflection: `Le repentir réunit les cœurs. La distance vient du péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tabtah ila Allahi qad tataba 'ala qulubikum » — si vous vous repentez à Allah, vos cœurs se réconcilieront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens ? Est-ce que je cherche la réconciliation des cœurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distance entre les cœurs n'est pas définitive — le repentir peut la guérir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cœurs sont liés par la pureté. Le péché les sépare, le repentir les réunit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent trouve la réconciliation — avec Allah et avec les autres." }
  ],
  munajat: `Ya Tawwab, Tu es Celui qui accepte le repentir. Je me repens. Réconcilie mon cœur avec Toi et avec les autres.`
};

MIROIR["66:5"] = {
  reference: "66:5",
  theme: ["remplacement", "épouses", "choix"],
  emotion: "Réalité, mise en perspective",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Wali"],
  mirrorVersion: `« S'il vous répudie, il se peut que son Seigneur lui donne en échange des épouses meilleures que vous. » Le miroir me montre que rien n'est définitif. Même les relations les plus établies peuvent changer. Mais la menace contient une promesse : Allah peut remplacer par mieux. Le miroir m'interroge : est-ce que je m'accroche à ce qui n'est pas bon pour moi ?`,
  reflection: `Allah peut remplacer ce qu'on perd par mieux. La perte n'est pas toujours un mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Asa rabbuhu in tallaqakunna an yubdilahu azwajan khayran minkunna » — il se peut que son Seigneur lui donne en échange des épouses meilleures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'accroche à ce qui n'est pas bon ? Est-ce que je fais confiance au remplacement divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte peut être un gain. Allah remplace par mieux quand on Lui fait confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la vie, tout peut être remplacé. Rien n'est irremplaçable auprès d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la perte avec confiance reçoit le meilleur remplacement." }
  ],
  munajat: `Ya Qadir, Tu es le Capable. Si je perds quelque chose, remplace-le par mieux. Je Te fais confiance.`
};

MIROIR["66:6"] = {
  reference: "66:6",
  theme: ["famille", "enfer", "protection"],
  emotion: "Urgence, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Wali"],
  mirrorVersion: `« Ô vous qui croyez ! Préservez vos personnes et vos familles d'un Feu dont le combustible sera les hommes et les pierres. » Le miroir me place devant ma responsabilité familiale. Je dois me protéger ET protéger ma famille du Feu. Cette protection n'est pas physique — elle est spirituelle. Le miroir m'interroge : est-ce que je protège ma famille de l'enfer ?`,
  reflection: `La responsabilité familiale inclut la protection spirituelle. L'enfer est une réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu qu anfusakum wa ahlikum naran » — ô vous qui croyez, préservez vos personnes et vos familles d'un Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je protège ma famille ? Est-ce que je les prépare pour l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection n'est pas le contrôle — c'est la guidance par l'exemple et l'enseignement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La famille est une unité spirituelle. Chaque membre est responsable des autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa famille du Feu est béni par Allah." }
  ],
  munajat: `Ya Rabb, je Te demande la protection pour ma famille. Préserve-nous du Feu. Guide-nous tous vers Toi.`
};

MIROIR["66:7"] = {
  reference: "66:7",
  theme: ["mécréants", "excuses", "jugement"],
  emotion: "Réalité, finalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Ô vous qui avez mécru ! Ne vous excusez pas aujourd'hui. » Le miroir me place devant le Jour du Jugement. Les mécréants voudront s'excuser, mais il sera trop tard. Les excuses ne seront pas acceptées. Le miroir m'interroge : est-ce que j'agis maintenant avant qu'il ne soit trop tard ?`,
  reflection: `Les excuses ne servent à rien le Jour du Jugement. Seules les actions comptent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina kafaru la ta'tadiru al-yawm » — ô vous qui avez mécru, ne vous excusez pas aujourd'hui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'agis maintenant ? Est-ce que je repousse les excuses pour agir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse est un masque pour l'inaction. Agir maintenant, c'est éviter les regrets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps de l'action est maintenant. Demain, les excuses ne serviront à rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit maintenant n'aura pas besoin d'excuses demain." }
  ],
  munajat: `Ya Rabb, ne permets pas que je sois de ceux qui s'excusent le Jour du Jugement. Fais que j'agisse maintenant.`
};

MIROIR["66:9"] = {
  reference: "66:9",
  theme: ["guerre", "hypocrites", "fermeté"],
  emotion: "Force, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aziz", "Al-Jabbar"],
  mirrorVersion: `« Ô Prophète ! Mène la guerre contre les mécréants et les hypocrites, et sois rude envers eux. » Le miroir me montre la fermeté nécessaire face à l'opposition. Le Prophète doit combattre les ennemis extérieurs ET les hypocrites intérieurs. Les deux menaces nécessitent la fermeté. Le miroir m'interroge : suis-je ferme face à ce qui menace ma foi ?`,
  reflection: `La fermeté est nécessaire. Les hypocrites sont parfois plus dangereux que les ennemis déclarés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha an-nabiyyu jahidi al-kuffara wa al-munafiqina » — ô Prophète, mène la guerre contre les mécréants et les hypocrites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je ferme face aux menaces ? Est-ce que je laisse l'hypocrisie s'installer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rudesse n'est pas la brutalité — c'est la fermeté nécessaire pour protéger la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la vie, il y a des ennemis visibles et cachés. Les deux demandent vigilance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est ferme avec les hypocrites protège la communauté." }
  ],
  munajat: `Ya Aziz, Tu es le Fort. Donne-moi la fermeté face à ce qui menace ma foi. Ne permets pas l'hypocrisie en moi.`
};

MIROIR["66:10"] = {
  reference: "66:10",
  theme: ["exemples", "épouses", "châtiment"],
  emotion: "Mise en garde, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Muntaqim"],
  mirrorVersion: `« Allah a proposé en parabole pour ceux qui ont mécru : la femme de Noé et la femme de Loth. » Le miroir me montre que la proximité avec les prophètes ne sauve pas automatiquement. Les épouses de Noé et de Loth étaient mariées à des prophètes, mais elles ont mécru. Le lien familial ne remplace pas la foi personnelle. Le miroir m'interroge : est-ce que je compte sur mes relations au lieu de ma foi ?`,
  reflection: `La proximité avec les pieux ne sauve pas. Chacun est responsable de sa propre foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Daraba Allahu mathalan lilladhina kafaru imra'ata Nuhin wa imra'ata Lut » — la femme de Noé et la femme de Loth." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur mes relations ? Ma foi est-elle personnelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le lien familial n'est pas un sauf-conduit. Chacun est jugé pour ses propres actes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'histoire, beaucoup ont cru être sauvés par leurs relations — ils ont été déçus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur sa foi personnelle est sauvé." }
  ],
  munajat: `Ya Rabb, ne permets pas que je compte sur mes relations. Fais que ma foi soit personnelle et authentique.`
};

MIROIR["66:11"] = {
  reference: "66:11",
  theme: ["foi", "exemple", "femme"],
  emotion: "Espoir, inspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Et Allah a proposé en parabole pour ceux qui croient : la femme de Pharaon. » Le miroir me montre le contraste. La femme de Pharaon — mariée au pire tyran — a cru. Son environnement hostile ne l'a pas empêchée. Elle a demandé à Allah une maison au Paradis. Le miroir m'interroge : est-ce que je laisse mon environnement déterminer ma foi ?`,
  reflection: `La foi peut fleurir dans l'environnement le plus hostile. La femme de Pharaon est un exemple.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa daraba Allahu mathalan lilladhina amanu imra'ata Fir'awna » — la femme de Pharaon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je laisse mon environnement déterminer ma foi ? Est-ce que je demande une maison au Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'environnement hostile peut être l'occasion de la foi la plus pure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi n'a pas de conditions extérieures. Elle est un choix intérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit dans l'adversité reçoit une place spéciale auprès d'Allah." }
  ],
  munajat: `Ya Rabb, comme la femme de Pharaon, je Te demande une maison au Paradis. Protège-moi de mon environnement. Fais que ma foi soit pure.`
};

MIROIR["66:12"] = {
  reference: "66:12",
  theme: ["Marie", "pureté", "miracle"],
  emotion: "Émerveillement, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Quddus", "Ar-Ruh"],
  mirrorVersion: `« Et Marie, fille d'Imran, qui préserva sa chasteté. » Le miroir me montre la pureté comme chemin vers la proximité divine. Marie a préservé sa chasteté, et Nous avons insufflé en elle de Notre Esprit. La pureté attire la présence divine. Le miroir m'interroge : est-ce que je préserve ma pureté pour recevoir la présence ?`,
  reflection: `La pureté attire la présence divine. Marie est un exemple de chasteté et de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Maryama bnata 'Imrana allati ahsanat farjaha » — Marie, fille d'Imran, qui préserva sa chasteté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve ma pureté ? Est-ce que je prépare mon cœur pour la présence divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté n'est pas une contrainte — c'est une préparation pour recevoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur pur est comme un cristal — il laisse passer la lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve sa pureté reçoit l'inspiration divine." }
  ],
  munajat: `Ya Quddus, Tu es le Pur. Purifie mon cœur. Fais que je préserve ma chasteté pour Toi. Insuffle en moi de Ton Esprit.`
};

// ==================== SURAH 67: AL-MULK (30 verses) ====================

MIROIR["67:1"] = {
  reference: "67:1",
  theme: ["bénédiction", "royauté", "puissance"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Qadir"],
  mirrorVersion: `« Béni soit Celui qui détient la Royauté et qui est Puissant sur toute chose. » Le miroir m'invite à contempler la souveraineté absolue d'Allah. « Tabaraka » — béni, exalté, source de bénédiction. Il détient la Royauté — pas une partie, pas temporairement, mais totalement et éternellement. Et Sa Puissance s'étend à toute chose. Le miroir m'interroge : si Allah est le Roi absolu, qu'est-ce que mes prétentions au contrôle signifient ?`,
  reflection: `La Royauté appartient à Allah. Notre contrôle est illusoire. La vraie liberté est dans la reconnaissance de Sa souveraineté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tabaraka alladhi bi-yadihi al-mulku wa huwa 'ala kulli shay'in qadir » — béni soit Celui qui détient la Royauté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que j'essaie de contrôler ce qui m'échappe ? Le miroir me montre mes illusions de maîtrise." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Royauté d'Allah n'est pas une menace — c'est une assurance. Le Roi veille sur Ses sujets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier démontre la Royauté divine. Chaque étoile obéit, chaque atome se soumet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la Royauté d'Allah devient noble — car il appartient au Roi des rois." }
  ],
  munajat: `Ya Malik, Tu es le Roi. Je reconnais Ta souveraineté. Libère-moi de mes illusions de contrôle. Fais-moi entrer dans Ton Royaume.`
};

MIROIR["67:2"] = {
  reference: "67:2",
  theme: ["création", "mort", "vie", "épreuve"],
  emotion: "Réalisation, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« C'est Lui qui a créé la mort et la vie pour vous éprouver et savoir qui de vous est le meilleur en œuvre. » Le miroir me montre que la mort et la vie ne sont pas accidentelles — elles sont créées, avec un but. L'épreuve n'est pas une punition, c'est une opportunité de révéler le meilleur de nous-mêmes. Le miroir m'interroge : quelle est la qualité de mes œuvres ?`,
  reflection: `La vie est une épreuve. La mort n'est pas une fin mais un retour vers Celui qui nous a créés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi khalaqa al-mawta wa al-hayata li-yabluwakum ayyukum ahsanu 'amala » — Il a créé la mort et la vie pour vous éprouver." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la qualité de mes œuvres ? Suis-je conscient que chaque instant est une épreuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve n'est pas pour Allah — Il sait déjà. Elle est pour nous, pour nous révéler à nous-mêmes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est soumise à ce cycle : vie, mort, évaluation. L'homme est le seul à pouvoir choisir consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'épreuve transforme chaque instant en opportunité d'excellence." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé pour l'épreuve. Aide-moi à être parmi les meilleurs en œuvre. Ne permets pas que je gaspille cette vie.`
};

MIROIR["67:4"] = {
  reference: "67:4",
  theme: ["création", "perfection", "répétition"],
  emotion: "Émerveillement, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Puis ramène ton regard deux fois : le regard reviendra humilié et épuisé. » Le miroir m'invite à chercher les imperfections dans la création — et à ne pas en trouver. Même après plusieurs regards, on ne trouve aucune faille. La création est parfaite. Le miroir m'interroge : est-ce que je contemple la création avec émerveillement ?`,
  reflection: `La création est parfaite. L'imperfection est dans notre regard, pas dans ce qui est créé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma irji'i al-basara karrayni » — puis ramène ton regard deux fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je critique dans la création ? Le miroir me montre que mes critiques viennent de mon ignorance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regard qui cherche les défauts revient épuisé — le regard qui contemple la beauté revient nourri." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est une œuvre d'art parfaite. Chaque détail est calculé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la perfection dans la création voit le Créateur." }
  ],
  munajat: `Ya Musawwir, Tu as façonné la création avec perfection. Ouvre mes yeux pour voir Ta beauté partout.`
};

MIROIR["67:5"] = {
  reference: "67:5",
  theme: ["étoiles", "décoration", "protection"],
  emotion: "Émerveillement, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hafiz"],
  mirrorVersion: `« Nous avons décoré le ciel le plus proche de lampes et Nous en avons fait des projectiles contre les démons. » Le miroir me montre la dualité des étoiles : beauté et protection. Elles décorent le ciel ET protègent contre les intrusions démoniaques. La beauté n'est pas qu'esthétique — elle a une fonction spirituelle. Le miroir m'interroge : est-ce que je vois la fonction spirituelle de la beauté ?`,
  reflection: `La beauté a un but. Les étoiles sont à la fois décoration et protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqayyayna al-sama'a al-dunya bi-masabih wa ja'alnaha rujuman lil-shayatin » — Nous avons décoré le ciel de lampes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les étoiles ? Est-ce que je vois leur fonction protectrice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté n'est pas superficielle — elle est une protection contre les forces négatives." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel est un livre. Les étoiles sont ses lettres. Chacune a un sens." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les étoiles avec le cœur reçoit leur lumière." }
  ],
  munajat: `Ya Khaliq, Tu as décoré le ciel. Fais que je contemple Ta création avec émerveillement. Protège-moi par Ta lumière.`
};

MIROIR["67:6"] = {
  reference: "67:6",
  theme: ["enfer", "mécréants", "châtiment"],
  emotion: "Gravité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Jabbar"],
  mirrorVersion: `« Et pour ceux qui ont mécru en leur Seigneur, il y a le châtiment de l'Enfer. » Le miroir me place devant la conséquence de la mécréance. L'Enfer n'est pas une invention — c'est une réalité pour ceux qui rejettent leur Seigneur. Le miroir m'interroge : est-ce que je prends ce châtiment au sérieux ?`,
  reflection: `L'Enfer est une réalité. La mécréance a des conséquences éternelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lilladhina kafaru bi-rabbihim 'adhabu jahannam » — pour ceux qui ont mécru, il y a le châtiment de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends ce châtiment au sérieux ? Est-ce que je crains Allah comme Il le mérite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La menace de l'Enfer n'est pas de la cruauté — c'est un avertissement miséricordieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice demande que le rejet de la vérité ait des conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint l'Enfer maintenant sera protégé plus tard." }
  ],
  munajat: `Ya Rabb, je Te demande la protection contre l'Enfer. Ne permets pas que je sois parmi les mécréants. Guide-moi vers la foi.`
};

MIROIR["67:7"] = {
  reference: "67:7",
  theme: ["enfer", "rage", "sons"],
  emotion: "Terreur, réalisation",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Qahir"],
  mirrorVersion: `« Quand ils y seront jetés, ils l'entendront rugir. » Le miroir me montre l'Enfer comme une créature vivante — pas un simple lieu, mais quelque chose qui rage. Les habitants l'entendront rugir comme une bête furieuse. Le miroir m'interroge : est-ce que je peux imaginer ce rugissement ?`,
  reflection: `L'Enfer est vivant. Il rugit de rage contre ceux qui y sont jetés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha ulqu fiha sami'at laha shahiq » — quand ils y seront jetés, ils l'entendront rugir." },
    { label: "Le Reflet", ar: "المرصad", color: "var(--mirror)", text: "Est-ce que je peux imaginer ce rugissement ? Est-ce que je fuis ce qui mène à l'Enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rugissement de l'Enfer est proportionné à la gravité du rejet de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer n'est pas un concept abstrait — c'est une réalité terrifiante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite ce qui mène à l'Enfer n'entendra jamais ce rugissement." }
  ],
  munajat: `Ya Rabb, préserve-moi du rugissement de l'Enfer. Je cherche refuge en Toi contre tout ce qui mène à ce lieu.`
};

MIROIR["67:8"] = {
  reference: "67:8",
  theme: ["enfer", "colère", "éclatement"],
  emotion: "Terreur, urgence",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Ghadib"],
  mirrorVersion: `« Il est sur le point d'éclater de rage. » Le miroir me montre l'intensité de l'Enfer. Pas seulement rugir — éclater de rage. À chaque fois qu'un groupe y est jeté, ses gardiens demandent : « Un avertisseur n'est-il pas venu vers vous ? » Le miroir m'interroge : l'avertisseur est venu — qu'est-ce que j'en fais ?`,
  reflection: `L'Enfer est prêt à éclater. Les avertissements sont venus. Nous sommes responsables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Takadu tamayyazu mina al-ghayz » — il est sur le point d'éclater de rage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'avertisseur est venu vers moi. Qu'est-ce que j'en fais ? Est-ce que j'écoute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La colère de l'Enfer répond à l'indifférence des hommes face aux avertissements." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple a reçu des avertisseurs. Chaque personne a des signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute les avertissements maintenant n'aura pas à les entendre de l'Enfer." }
  ],
  munajat: `Ya Rabb, les avertissements sont venus vers moi. Fais que je les écoute. Ne permets pas que je sois parmi ceux qui ignorent.`
};

MIROIR["67:9"] = {
  reference: "67:9",
  theme: ["avertisseur", "mentir", "châtiment"],
  emotion: "Regret, réalisation",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Muntaqim"],
  mirrorVersion: `« Ils diront : Si, un avertisseur nous est venu, mais nous avons menti et nous avons dit : Allah n'a rien fait descendre. » Le miroir me montre le regret des habitants de l'Enfer. Ils reconnaissent que l'avertisseur est venu — mais ils ont choisi de mentir. Le miroir m'interroge : est-ce que je mens à la vérité quand elle se présente ?`,
  reflection: `Le regret dans l'Enfer est la reconnaissance tardive de la vérité refusée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu bala qad ja'ana nadhirun fa-kadhdhabna » — un avertisseur nous est venu mais nous avons menti." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mens à la vérité ? Est-ce que je refuse les signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mentir à la vérité ne change pas la vérité — ça change seulement notre destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité se présente à chacun. Le refus ne l'annule pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité quand elle vient n'aura pas de regret." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Ne permets pas que je mente à Ta vérité. Fais que je l'accepte quand elle vient.`
};

MIROIR["67:10"] = {
  reference: "67:10",
  theme: ["écoute", "intelligence", "regret"],
  emotion: "Regret, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-'Alim"],
  mirrorVersion: `« Si nous avions écouté ou réfléchi, nous ne serions pas parmi les gens du Feu. » Le miroir me montre le chemin simple du salut : écouter et réfléchir. Pas des exploits extraordinaires — juste l'écoute et la réflexion. Le miroir m'interroge : est-ce que j'écoute vraiment ? Est-ce que je réfléchis ?`,
  reflection: `L'écoute et la réflexion sont les clés du salut. Si simples, et pourtant si négligées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kunna nasma'u aw na'qilu ma kunna fi ashab al-sa'ir » — si nous avions écouté ou réfléchi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute ? Est-ce que je réfléchis ? Ou est-ce que je suis distrait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin vers l'Enfer n'est pas compliqué — c'est le refus de l'écoute et de la réflexion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout. L'écoute et la réflexion suffisent pour les voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute et réfléchit est déjà sur le chemin du salut." }
  ],
  munajat: `Ya Hadi, guide-moi par l'écoute et la réflexion. Ne permets pas que je sois distrait. Fais que je sois parmi les sauvés.`
};

MIROIR["67:11"] = {
  reference: "67:11",
  theme: ["péché", "reconnaissance", "feu"],
  emotion: "Regret, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Muntaqim"],
  mirrorVersion: `« Ils reconnaîtront leur péché. Que périssent les gens du Feu ! » Le miroir me montre que dans l'Enfer, la vérité éclate. Ils reconnaissent leur péché — trop tard. La reconnaissance qui aurait pu sauver devient une condamnation. Le miroir m'interroge : est-ce que je reconnais mes péchés maintenant ?`,
  reflection: `La reconnaissance des péchés maintenant sauve. La reconnaissance tardive condamne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'tarafu bi-dhanbihim » — ils reconnaîtront leur péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mes péchés maintenant ? Ou est-ce que j'attends qu'il soit trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des péchés n'est pas une honte — c'est une guérison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par éclater. Mieux vaut la reconnaître maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ses péchés maintenant trouve le pardon. Après, c'est trop tard." }
  ],
  munajat: `Ya Ghaffur, je reconnais mes péchés. Pardonne-moi. Ne permets pas que je sois parmi ceux qui reconnaissent trop tard.`
};

MIROIR["67:12"] = {
  reference: "67:12",
  theme: ["crainte", "secret", "pardon"],
  emotion: "Espoir, réconfort",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-'Alim"],
  mirrorVersion: `« Ceux qui craignent leur Seigneur bien qu'ils ne Le voient pas, ont un pardon et une grande récompense. » Le miroir me montre la beauté de la crainte invisible. Ceux qui craignent Allah sans Le voir — leur foi est pure, non basée sur l'évidence visible. Le miroir m'interroge : est-ce que je crains Allah même quand personne ne me voit ?`,
  reflection: `La crainte invisible est la foi la plus pure. Elle mérite le pardon et la récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina yakhshawna rabbahum bi-al-ghaybi lahum maghfiratun » — ceux qui craignent leur Seigneur bien qu'ils ne Le voient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah dans le secret ? Est-ce que ma foi est visible ou invisible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte invisible n'est pas de la peur — c'est de la conscience respectueuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah voit ce qui est caché. La crainte invisible Lui est la plus précieuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah dans le secret est protégé partout." }
  ],
  munajat: `Ya 'Alim, Tu vois ce qui est caché. Fais que je Te craigne même quand personne ne me voit. Accorde-moi Ton pardon.`
};

MIROIR["67:13"] = {
  reference: "67:13",
  theme: ["parole", "secret", "connaissance"],
  emotion: "Révérence, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-'Alim"],
  mirrorVersion: `« Que vous parliez en secret ou à voix haute, Il connaît le contenu des cœurs. » Le miroir me montre que rien n'est caché à Allah. Le murmure le plus bas, la pensée la plus intime — tout est connu. Le miroir m'interroge : est-ce que je suis conscient que chaque pensée est vue ?`,
  reflection: `Allah connaît le contenu des cœurs. Rien n'est caché, même le plus secret.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa asirru al-qawli wa jahruhu innahu ya'lamu sarira al-sudur » — Il connaît le contenu des cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache dans mon cœur ? Est-ce que je suis conscient qu'Allah le sait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance divine n'est pas une intrusion — c'est une intimité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur est le lieu le plus secret. Allah y a accès." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie son cœur n'a rien à cacher." }
  ],
  munajat: `Ya Sami', Tu entends tout. Purifie mon cœur. Fais que je n'aie rien à cacher devant Toi.`
};

MIROIR["67:14"] = {
  reference: "67:14",
  theme: ["créateur", "connaissance", "intimité"],
  emotion: "Confiance, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Khabir"],
  mirrorVersion: `« Ne connaît-Il pas ce qu'Il a créé, Lui qui est le Subtil, le Bien-Informé ? » Le miroir me montre que la connaissance d'Allah n'est pas théorique — elle est personnelle. Il a créé, donc Il connaît intimement. Le Créateur connaît Sa création mieux qu'elle ne se connaît elle-même. Le miroir m'interroge : est-ce que je fais confiance à Sa connaissance ?`,
  reflection: `Le Créateur connaît Sa création. Cette connaissance est intime et bienveillante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-la ya'lamu man khalaqa wa huwa al-latif al-khabir » — ne connaît-Il pas ce qu'Il a créé ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Sa connaissance de moi ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah me connaît mieux que moi-même. Cette connaissance est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est connue de son Créateur. Cette connaissance maintient l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise qu'Allah le connaît trouve la paix — il n'a plus à prouver." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé et Tu me connais. Je fais confiance à Ta connaissance. Aide-moi à me connaître à travers Toi.`
};

MIROIR["67:15"] = {
  reference: "67:15",
  theme: ["terre", "soumission", "provision"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Khaliq"],
  mirrorVersion: `« C'est Lui qui vous a soumis la terre. Parcourez donc ses vastes étendues et mangez de Sa provision. » Le miroir me montre la terre comme un don. Allah l'a soumise — nous n'avons pas à la conquérir, elle est déjà donnée. Le miroir m'interroge : est-ce que je suis reconnaissant pour ce don ?`,
  reflection: `La terre est soumise. La provision est disponible. La reconnaissance est due.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi ja'ala lakumu al-arda dhalulan » — c'est Lui qui vous a soumis la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la terre ? Est-ce que je parcours ses espaces avec gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terre est soumise non par faiblesse mais par décret divin — pour notre bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre porte l'humanité. Sa soumission est un acte de service." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le don de la terre vit en harmonie avec elle." }
  ],
  munajat: `Ya Razzaq, Tu m'as soumis la terre. Merci pour ce don. Fais que je vive en harmonie avec Ta création.`
};

MIROIR["67:16"] = {
  reference: "67:16",
  theme: ["ciel", "sécurité", "avertissement"],
  emotion: "Humilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Muhaymin"],
  mirrorVersion: `« Êtes-vous à l'abri que Celui qui est au ciel ne vous engloutisse sous la terre ? » Le miroir me montre la fragilité de notre sécurité. Nous croyons être à l'abri — mais le ciel peut s'effondrer. La sécurité n'est pas un droit, c'est une miséricorde. Le miroir m'interroge : est-ce que je suis conscient de ma vulnérabilité ?`,
  reflection: `La sécurité est une miséricorde, pas un droit. Nous sommes vulnérables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-amintum man fi al-sama'i an yakhsifa bikumu al-arda » — êtes-vous à l'abri que Celui qui est au ciel ne vous engloutisse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends ma sécurité pour acquise ? Est-ce que je suis conscient de ma vulnérabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La menace n'est pas pour nous faire peur — c'est pour nous éveiller à la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre peut s'ouvrir. Le ciel peut s'effondrer. Tout dépend d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa vulnérabilité trouve la vraie sécurité en Allah." }
  ],
  munajat: `Ya Qahir, Tu es le Maître. Je reconnais ma vulnérabilité. Protège-moi de tout effondrement. Ma sécurité est en Toi.`
};

MIROIR["67:17"] = {
  reference: "67:17",
  theme: ["ciel", "pierres", "avertissement"],
  emotion: "Vigilance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Ou êtes-vous à l'abri que Celui qui est au ciel n'envoie contre vous un ouragan de pierres ? » Le miroir me montre que le châtiment peut venir du ciel — pas seulement de la terre. Les pierres peuvent tomber. Le miroir m'interroge : est-ce que je fuis ce qui mérite le châtiment ?`,
  reflection: `Le châtiment peut venir de n'importe où. La protection d'Allah est notre seule sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw amintum man fi al-sama'i an yursila 'alaykum hasiban » — ou envoie contre vous un ouragan de pierres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fuis ce qui mérite le châtiment ? Est-ce que je cherche la protection d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les avertissements ne sont pas des menaces vides — ils sont des rappels de réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est pleine de peuples châtiés par le ciel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant n'a pas à craindre les pierres du ciel." }
  ],
  munajat: `Ya Rabb, je cherche Ta protection contre tout châtiment. Ne permets pas que je mérite Ton courroux. Protège-moi du ciel et de la terre.`
};

MIROIR["67:18"] = {
  reference: "67:18",
  theme: ["prédécesseurs", "mensonge", "châtiment"],
  emotion: "Leçon, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui vécurent avant eux ont crié au mensonge. Et quelle fut Ma réprobation ! » Le miroir me montre que l'histoire se répète. Les peuples passés ont crié au mensonge — et ils ont été châtiés. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `L'histoire est un enseignement. Les peuples passés sont des exemples.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad kadhdhaba alladhina min qablihim fa-kayfa kana nukir » — ceux qui vécurent avant eux ont crié au mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je répète les erreurs du passé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire n'est pas un récit — c'est un avertissement vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ruines des peuples passés témoignent de la réalité du châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire n'a pas besoin de la répéter." }
  ],
  munajat: `Ya Hakim, Tu as châtié les peuples passés. Fais que j'apprenne de leur exemple. Ne permets pas que je sois parmi ceux qui nient la vérité.`
};

MIROIR["67:19"] = {
  reference: "67:19",
  theme: ["oiseaux", "création", "soumission"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« N'ont-ils pas vu les oiseaux au-dessus d'eux, déployant leurs ailes et les repliant ? » Le miroir m'invite à contempler les oiseaux. Ils volent par la grâce d'Allah. Leur vol est une prière silencieuse. Le miroir m'interroge : est-ce que je contemple les créatures d'Allah ?`,
  reflection: `Les oiseaux sont des signes. Leur vol est maintenu par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yaraw ila al-tayri fawqahum saffatin » — n'ont-ils pas vu les oiseaux au-dessus d'eux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les créatures ? Est-ce que je vois les signes d'Allah dans la nature ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les oiseaux ne volent pas par leur propre force — c'est Allah qui les soutient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature est un signe. Les oiseaux sont parmi les plus évidents." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les oiseaux comprend la soumission." }
  ],
  munajat: `Ya Khaliq, les oiseaux volent par Ta grâce. Fais que je contemple Ta création avec émerveillement. Apprends-moi la soumission.`
};

MIROIR["67:20"] = {
  reference: "67:20",
  theme: ["armées", "protection", "mécréance"],
  emotion: "Réalisation, vulnérabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Wali"],
  mirrorVersion: `« Qui donc est une armée pour vous, qui vous aiderait en dehors du Tout-Miséricordieux ? » Le miroir me montre que sans Allah, nous sommes sans défense. Les mécréants n'ont aucune armée réelle. Le miroir m'interroge : est-ce que je compte sur autre qu'Allah pour ma protection ?`,
  reflection: `Sans Allah, il n'y a pas de protection. Les armées humaines sont illusoires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-mman hadha alladhi huwa jundun lakum » — qui donc est une armée pour vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur qui est-ce que je compte ? Sur Allah ou sur les illusions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'armée la plus puissante ne peut rien sans la permission d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie force vient d'Allah. Tout le reste est illusion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah a l'armée la plus puissante." }
  ],
  munajat: `Ya Rabb, je compte sur Toi seul. Tu es ma protection. Ne permets pas que je cherche la sécurité ailleurs.`
};

MIROIR["67:21"] = {
  reference: "67:21",
  theme: ["provision", "mécréance", "dons"],
  emotion: "Gratitude, dépendance",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Qui donc vous nourrirait s'Il suspendait Sa provision ? » Le miroir me montre que la provision vient d'Allah. S'Il la suspend, personne ne peut la remplacer. Le mécréant mange de la provision d'Allah tout en Le niant. Le miroir m'interroge : est-ce que je suis reconnaissant pour ma provision ?`,
  reflection: `La provision vient d'Allah. La reconnaissance est le minimum que nous devons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-mman hadha alladhi huwa yazda'ukum » — qui donc vous nourrirait ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour ma provision ? Est-ce que je reconnais la source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Manger sans reconnaissance est une ingratitude. La provision continue est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est nourrie par Allah. La reconnaissance est universellement due." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour sa provision voit sa provision augmenter." }
  ],
  munajat: `Ya Razzaq, Tu me nourris. Je suis reconnaissant. Ne permets pas que je sois ingrat. Continue Ta provision avec bénédiction.`
};

MIROIR["67:22"] = {
  reference: "67:22",
  theme: ["marche", "guidance", "égarement"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Sirat"],
  mirrorVersion: `« Celui qui marche penché sur son visage est-il mieux guidé que celui qui marche droit sur un chemin droit ? » Le miroir me montre l'image du mécréant : penché sur son visage, incapable de voir le chemin. Le croyant marche droit. Le miroir m'interroge : est-ce que je marche droit ?`,
  reflection: `La guidance se voit dans la démarche. Le droit chemin est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-faman yamshi mukibban 'ala wajhihi » — celui qui marche penché sur son visage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je marche droit ? Est-ce que je suis sur le chemin clair ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement n'est pas une alternative — c'est une chute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin droit existe. L'égarement est le refus de le suivre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui marche droit voit la destination." }
  ],
  munajat: `Ya Hadi, guide-moi sur le droit chemin. Ne permets pas que je sois parmi ceux qui marchent penchés. Fais que je voie le chemin.`
};

MIROIR["67:23"] = {
  reference: "67:23",
  theme: ["création", "facultés", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« C'est Lui qui vous a créés, vous a donné l'ouïe, la vue et les cœurs. » Le miroir me montre les dons fondamentaux : l'ouïe, la vue, le cœur. Ces facultés que j'utilise sans y penser sont des dons précieux. Le miroir m'interroge : est-ce que je suis reconnaissant pour ces dons ?`,
  reflection: `L'ouïe, la vue, le cœur sont des dons. La gratitude est le minimum.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi ansha'akum wa ja'ala lakumu al-sam'a wa al-absara wa al-af'idah » — c'est Lui qui vous a créés et vous a donné l'ouïe, la vue et les cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise ces dons pour Allah ? Ou est-ce que je les utilise pour autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ces facultés ne sont pas des droits — ce sont des responsabilités." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a ses facultés. L'homme a les plus nobles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise ses facultés pour Allah atteint leur but." }
  ],
  munajat: `Ya Khaliq, Tu m'as donné l'ouïe, la vue et le cœur. Fais que je les utilise pour Toi. Ne permets pas que je sois ingrat.`
};

MIROIR["67:24"] = {
  reference: "67:24",
  theme: ["dispersion", "rassemblement", "création"],
  emotion: "Humilité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hashr", "Al-Nashir"],
  mirrorVersion: `« C'est Lui qui vous a dispersés sur la terre, et c'est vers Lui que vous serez rassemblés. » Le miroir me montre le cycle : dispersion sur la terre, rassemblement vers Allah. Nous sommes dispersés maintenant — mais le rassemblement viendra. Le miroir m'interroge : est-ce que je prépare ce rassemblement ?`,
  reflection: `La dispersion est temporaire. Le rassemblement vers Allah est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi dhara'akum fi al-ardi wa ilayhi tuhsharun » — c'est Lui qui vous a dispersés et c'est vers Lui que vous serez rassemblés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare le rassemblement ? Est-ce que je sais que je retournerai à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispersion n'est pas l'oubli — le rassemblement rappellera tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nous sommes dispersés dans le temps et l'espace. Nous serons rassemblés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare le rassemblement ne sera pas surpris." }
  ],
  munajat: `Ya Hashr, Tu nous rassembleras. Je prépare ce jour. Ne permets pas que je sois surpris par le rassemblement.`
};

MIROIR["67:25"] = {
  reference: "67:25",
  theme: ["promesse", "question", "Heure"],
  emotion: "Attente, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wa'id"],
  mirrorVersion: `« Et ils disent : À quand cette promesse, si vous êtes véridiques ? » Le miroir me montre le doute des mécréants. Ils demandent quand viendra la promesse — comme si elle n'était pas certaine. Le miroir m'interroge : est-ce que je doute de la promesse d'Allah ?`,
  reflection: `La promesse d'Allah est certaine. Le doute ne la change pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — à quand cette promesse, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute de la promesse d'Allah ? Est-ce que je demande « quand » ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question « quand » ne retarde pas la promesse — elle révèle le doute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure viendra. Le doute ne l'empêchera pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la promesse se prépare, il ne demande pas « quand »." }
  ],
  munajat: `Ya Haqq, Ta promesse est vraie. Je crois. Ne permets pas que je doute. Aide-moi à me préparer.`
};

MIROIR["67:26"] = {
  reference: "67:26",
  theme: ["science", "invisible", "Heure"],
  emotion: "Humilité, limite",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Dis : Seul Allah le sait. » Le miroir me montre la limite de la connaissance humaine. Le Prophète lui-même ne sait pas quand vient l'Heure. Seul Allah sait. Le miroir m'interroge : est-ce que j'accepte mes limites ?`,
  reflection: `Seul Allah connaît l'Heure. L'homme a des limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama al-'ilmu 'inda Allahi » — dis : seul Allah le sait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte mes limites ? Est-ce que je reconnais que certains savoirs sont à Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de l'Heure n'est pas une faiblesse — c'est une sagesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure est cachée pour que chaque instant soit vécu avec préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'ignorance de l'Heure vit chaque jour comme le dernier." }
  ],
  munajat: `Ya 'Alim, Tu connais l'Heure. Je ne la connais pas. Aide-moi à vivre chaque jour comme si c'était le dernier.`
};

MIROIR["67:27"] = {
  reference: "67:27",
  theme: ["Heure", "vision", "regret"],
  emotion: "Urgence, terreur",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Sa'ah"],
  mirrorVersion: `« Quand ils la verront de près, les visages de ceux qui ont mécru seront affligés. » Le miroir me montre le moment où l'Heure devient visible. Trop tard pour le repentir. Les visages seront affligés. Le miroir m'interroge : est-ce que j'agis avant qu'il ne soit trop tard ?`,
  reflection: `Quand l'Heure sera visible, le regret sera inutile. L'action est pour maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ra'awha zulfatin si'at wujuhu alladhina kafaru » — quand ils la verront de près, les visages seront affligés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'agis maintenant ? Ou est-ce que j'attends le moment où le regret sera inutile ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'affliction des visages est proportionnée au temps gaspillé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Heure approche. Chaque instant la rapproche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui agit maintenant n'aura pas d'affliction ce jour-là." }
  ],
  munajat: `Ya Rabb, je veux agir maintenant. Ne permets pas que je sois parmi les affligés ce jour-là. Fais que je me prépare.`
};

MIROIR["67:28"] = {
  reference: "67:28",
  theme: ["mort", "croyants", "miséricorde"],
  emotion: "Question, espoir",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mumit"],
  mirrorVersion: `« Dis : Que vous en semble-t-il ? Si Allah me fait mourir ainsi que ceux qui sont avec moi, ou s'Il nous fait miséricorde... » Le miroir me montre que la mort et la miséricorde sont entre les mains d'Allah. Quoi qu'il arrive, les mécréants n'ont pas de protection. Le miroir m'interroge : est-ce que je compte sur la miséricorde d'Allah ?`,
  reflection: `La mort et la miséricorde dépendent d'Allah. Les mécréants sont sans protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ara'aytum in ahlakaniyya Allahu wa man ma'iya aw rahimana » — si Allah me fait mourir ou s'Il nous fait miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur la miséricorde d'Allah ? Est-ce que je me prépare à la mort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort du croyant est une miséricorde. La mort du mécréant est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort vient pour tous. La différence est dans ce qui suit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur la miséricorde d'Allah la reçoit." }
  ],
  munajat: `Ya Rahman, je compte sur Ta miséricorde. Si Tu me fais mourir, fais que ce soit sur la foi. Si Tu me fais vivre, fais que ce soit dans l'obéissance.`
};

MIROIR["67:29"] = {
  reference: "67:29",
  theme: ["confiance", "miséricorde", "patience"],
  emotion: "Confiance, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Ar-Rahman"],
  mirrorVersion: `« Dis : C'est Lui le Tout-Miséricordieux. Nous croyons en Lui et c'est en Lui que nous plaçons notre confiance. » Le miroir me montre la réponse du croyant face à l'incertitude : confiance en ar-Rahman. Nous croyons et nous nous confions. Le miroir m'interroge : est-ce que ma confiance est complète ?`,
  reflection: `La confiance en ar-Rahman est la réponse à toute incertitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul huwa al-rahmanu amanna bihi wa 'alayhi tawakkalna » — c'est Lui le Tout-Miséricordieux, nous croyons en Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma confiance est complète ? Ou est-ce que je garde des réserves ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance n'est pas passive — c'est un acte de foi active." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La confiance en Allah est la position la plus sûre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se confie à Allah n'est jamais abandonné." }
  ],
  munajat: `Ya Rahman, je crois en Toi et je me confie à Toi. Ma confiance est complète. Ne permets pas que je doute.`
};

MIROIR["67:30"] = {
  reference: "67:30",
  theme: ["eau", "provision", "prière"],
  emotion: "Supplication, dépendance",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Muhit"],
  mirrorVersion: `« Dis : Que vous en semble-t-il ? Si votre eau s'engloutissait, qui donc vous apporterait de l'eau vive ? » Le miroir me montre la dépendance absolue. Sans eau, nous mourons. Allah seul peut nous donner de l'eau vive. Le miroir m'interroge : est-ce que je reconnais ma dépendance absolue ?`,
  reflection: `L'eau est la vie. Sans elle, nous sommes perdus. Allah seul la fournit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ara'aytum in asbaha ma'ukum ghawran » — si votre eau s'engloutissait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ma dépendance absolue ? Ou est-ce que je prends l'eau pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau n'est pas un droit — c'est un don. Chaque goutte est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est la base de la vie. Sa rareté rappelle notre fragilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa dépendance absolue reçoit la provision continue." }
  ],
  munajat: `Ya Razzaq, Tu es Celui qui donne l'eau vive. Je reconnais ma dépendance absolue. Ne permets pas que mon eau s'engloutisse. Donne-moi de Ta provision.`
};

// ==================== SURAH 68: AL-QALAM (52 verses) ====================

MIROIR["68:1"] = {
  reference: "68:1",
  theme: ["calame", "écriture", "science"],
  emotion: "Révérence, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Katib"],
  mirrorVersion: `« Noun. Par le calame et ce qu'ils écrivent. » Le miroir m'invite à contempler le mystère de l'écriture divine. Le calame — cet instrument humble — est mentionné par Allah comme témoin de Sa révélation. L'écriture n'est pas qu'une technique humaine : elle est un lien entre le ciel et la terre. Le Coran lui-même est écrit, préservé dans des feuillets honorés. Le miroir m'interroge : est-ce que je valorise l'écrit sacré ?`,
  reflection: `Le calame est un instrument divin. L'écriture préserve la révélation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nun wa al-qalami wa ma yasturun » — Noun. Par le calame et ce qu'ils écrivent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran comme une écriture vivante ? Est-ce que je médite sur le texte écrit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'écriture divine n'est pas figée — elle est vivante, parlante, transformante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'écriture est un don divin. Elle permet de transmettre à travers le temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit l'écrit divin avec le cœur entend la voix du Calame." }
  ],
  munajat: `Ya 'Alim, Tu as écrit par le calame. Fais que je lise Ton écriture avec le cœur. Ouvre-moi les secrets du texte sacré.`
};

MIROIR["68:2"] = {
  reference: "68:2",
  theme: ["prophète", "folie", "grâce"],
  emotion: "Réconfort, affirmation",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Hadi"],
  mirrorVersion: `« Tu n'es pas, par la grâce de ton Seigneur, un possédé. » Le miroir me montre comment les ennemis du Prophète l'ont qualifié de possédé. Mais Allah affirme : non, tu n'es pas fou, tu es comblé de grâce. La grâce d'Allah protège des accusations mensongères. Le miroir m'interroge : est-ce que je laisse les accusations des autres définir ma valeur ?`,
  reflection: `La grâce d'Allah définit notre valeur, pas les accusations des autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma anta bi-ni'mati rabbika bi-majnun » — tu n'es pas, par la grâce de ton Seigneur, un possédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je laisse les autres définir ma valeur ? Ou est-ce que j'accepte la définition d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les accusations des autres ne changent pas la réalité — seule la vérité compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont toujours été accusés. La grâce d'Allah est leur protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est confirmé par Allah n'a pas besoin de la confirmation des hommes." }
  ],
  munajat: `Ya Rabb, Tu m'as créé avec grâce. Ne permets pas que les accusations des autres me définissent. Confirme-moi dans Ta vérité.`
};

MIROIR["68:3"] = {
  reference: "68:3",
  theme: ["récompense", "continuité", "certitude"],
  emotion: "Espoir, assurance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Jazil"],
  mirrorVersion: `« Et tu as certainement une récompense continue. » Le miroir me montre la promesse divine : une récompense qui ne s'arrête pas. Le Prophète, accusé et rejeté, reçoit cette assurance : ta récompense est certaine et continue. Le miroir m'interroge : est-ce que je me concentre sur la récompense éternelle plutôt que sur les difficultés présentes ?`,
  reflection: `La récompense d'Allah est certaine et continue. Les difficultés présentes ne l'annulent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna laka la-ajran ghayra mamnun » — et tu as certainement une récompense continue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me concentre sur la récompense ? Ou est-ce que je me laisse décourager par les difficultés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense continue signifie que chaque acte compte pour l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans l'économie divine, rien n'est perdu. Chaque effort est compté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour la récompense continue ne s'épuise jamais." }
  ],
  munajat: `Ya Wahhab, Tu as promis une récompense continue. Fais que je travaille pour cette récompense. Ne permets pas que je me décourage.`
};

MIROIR["68:5"] = {
  reference: "68:5",
  theme: ["vision", "vérité", "révélation"],
  emotion: "Certitude, anticipation",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Haqq"],
  mirrorVersion: `« Tu verras, et ils verront. » Le miroir me montre que la vérité sera révélée. Le Prophète verra, et ses accusateurs verront. Le temps viendra où chacun verra la réalité. Le miroir m'interroge : est-ce que je patiente en attendant que la vérité éclate ?`,
  reflection: `La vérité sera révélée. Le temps la montrera à tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sa tubsiruna wa yubsirun » — tu verras, et ils verront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente ? Est-ce que je fais confiance au dévoilement de la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ceux qui nient la vérité maintenant la verront clairement plus tard — mais trop tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne peut être cachée éternellement. Elle éclate toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vérité maintenant n'a pas besoin d'attendre pour agir." }
  ],
  munajat: `Ya Basir, Tu vois tout. Fais que je voie la vérité maintenant. Ne permets pas que je sois parmi ceux qui la voient trop tard.`
};

MIROIR["68:6"] = {
  reference: "68:6",
  theme: ["dément", "connaissance", "examen"],
  emotion: "Vigilance, examen",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Lequel de vous est démént. » Le miroir me montre que la folie sera révélée. Qui est vraiment fou ? Celui qui suit la vérité ou celui qui la nie ? L'examen viendra. Le miroir m'interroge : est-ce que je m'examine moi-même avant d'être examiné ?`,
  reflection: `La vraie folie est le rejet de la vérité. L'examen révélera qui est qui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ayyukumu al-maftun » — lequel de vous est démént." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'examine ? Ou est-ce que j'accuse les autres sans me voir moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui accuse les autres de folie est souvent le plus fou." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La folie se reconnaît à ses fruits : le rejet de la vérité, la désobéissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'examine maintenant n'a pas peur de l'examen final." }
  ],
  munajat: `Ya 'Alim, Tu connais celui qui est démént. Examine-moi. Si je suis égaré, guide-moi. Si je suis sur la vérité, confirme-moi.`
};

MIROIR["68:7"] = {
  reference: "68:7",
  theme: ["guidance", "égarement", "connaissance"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Ton Seigneur connaît mieux celui qui s'égare de Son chemin, et Il connaît mieux les bien-guidés. » Le miroir me montre que la classification finale appartient à Allah. Lui seul sait vraiment qui est égaré et qui est guidé. Les apparences peuvent tromper. Le miroir m'interroge : est-ce que je juge les autres ou est-ce que je laisse le jugement à Allah ?`,
  reflection: `Allah seul connaît vraiment les cœurs. Le jugement final Lui appartient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu ya'lamu man dalla 'an sabilihi wa ya'lamu al-muhtadin » — Il connaît qui s'égare et les bien-guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je juge les autres ? Ou est-ce que je laisse le jugement à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui est sûr de sa guidance ne juge pas les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance et l'égarement sont des états intérieurs, pas des apparences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah connaît son propre état." }
  ],
  munajat: `Ya Hadi, Tu connais les bien-guidés et les égarés. Guide-moi. Ne permets pas que je juge les autres. Montre-moi mon propre état.`
};

MIROIR["68:8"] = {
  reference: "68:8",
  theme: ["obéissance", "menteurs", "refus"],
  emotion: "Fermeté, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "As-Sadiq"],
  mirrorVersion: `« N'obéis pas aux menteurs. » Le miroir me montre un commandement clair : ne pas obéir à ceux qui mentent. Les menteurs cherchent à détourner de la vérité. Le Prophète est averti de ne pas les suivre. Le miroir m'interroge : est-ce que j'obéis à des menteurs ?`,
  reflection: `L'obéissance aux menteurs mène à l'égarement. La vérité exige le refus du mensonge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la tuti'i al-mukadhdhibin » — n'obéis pas aux menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que j'obéis ? Est-ce que je suis des menteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge peut sembler attractif, mais il mène à la perdition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les menteurs sont nombreux. La vérité est un choix conscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse les menteurs protège son cœur de la corruption." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Ne permets pas que j'obéisse aux menteurs. Donne-moi le discernement pour les reconnaître.`
};

MIROIR["68:9"] = {
  reference: "68:9",
  theme: ["compromis", "désir", "flatterie"],
  emotion: "Vigilance, fermeté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Qawiyy"],
  mirrorVersion: `« Ils aimeraient que tu transiges, et alors ils transigeraient. » Le miroir me montre la tentation du compromis. Les ennemis veulent que le Prophète fléchisse — et alors ils fléchiront aussi. Le compromis avec la vérité est une trahison. Le miroir m'interroge : est-ce que je transige avec la vérité pour plaire aux autres ?`,
  reflection: `Le compromis avec la vérité est une trahison. La vérité ne se négocie pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waddu law tuhdinu fa-yuhdinun » — ils aimeraient que tu transiges, et alors ils transigeraient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transige avec la vérité ? Est-ce que je cherche à plaire plutôt qu'à être vrai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La flexibilité sur les principes n'est pas de la sagesse — c'est de la faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les principes sont le squelette du caractère. Sans eux, on s'effondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne transige pas avec la vérité reçoit la force de la vérité." }
  ],
  munajat: `Ya Qawiyy, Tu es le Fort. Donne-moi la force de ne pas transiger avec la vérité. Ne permets pas que je cherche à plaire plutôt qu'à être vrai.`
};

MIROIR["68:10"] = {
  reference: "68:10",
  theme: ["jurement", "mépris", "hypocrisie"],
  emotion: "Mise en garde, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khashi'", "Al-Basir"],
  mirrorVersion: `« Et n'obéis pas à tout vil jureur. » Le miroir me montre le type de personne à éviter : le jureur vil. Celui qui jure beaucoup pour masquer sa faiblesse, qui méprise les autres. Ces personnes cherchent l'attention mais ne valent pas l'écoute. Le miroir m'interroge : est-ce que j'écoute ceux qui ne valent pas l'écoute ?`,
  reflection: `Le jureur vil mérite le rejet. Son serment est vide, son mépris est réel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa-la tuti'i kulla hallafin mahin » — n'obéis pas à tout vil jureur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est-ce que j'écoute ? Est-ce que je perds mon temps avec ceux qui ne valent pas l'écoute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jureur cache sa faiblesse derrière ses serments. Le méprisant cache son vide derrière son mépris." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole abondante cache souvent le vide intérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui discerné les vils jureurs préserve son temps et son cœur." }
  ],
  munajat: `Ya Basir, Tu vois au-delà des apparences. Donne-moi le discernement pour reconnaître les vils jureurs. Ne permets pas que je perde mon temps avec eux.`
};

MIROIR["68:11"] = {
  reference: "68:11",
  theme: ["calomnie", "médisance", "propagation"],
  emotion: "Mise en garde, rejet",
  difficulty: "débutant",
  relatedNames: ["As-Sami'", "Al-Muhaimin"],
  mirrorVersion: `« Diffamateur, colporteur de calomnies. » Le miroir me montre le profil du mécréant : il diffame, il colporte les calomnies. Il prend le mal et le propage. Le miroir m'interroge : est-ce que je colporte les calomnies ? Est-ce que je suis un diffuseur de mal ?`,
  reflection: `La calomnie est un poison. Le colporteur est un empoisonneur social.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hammazin mashshain bi-namim » — diffamateur, colporteur de calomnies." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je colporte les calomnies ? Est-ce que je suis un diffuseur de mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le colporteur détruit la société. Sa langue est une arme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La médisance détruit les relations. La calomnie détruit les réputations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde sa langue du mal préserve sa place au Paradis." }
  ],
  munajat: `Ya Sami', Tu entends tout. Préserve ma langue de la calomnie. Ne permets pas que je sois un colporteur de mal.`
};

MIROIR["68:12"] = {
  reference: "68:12",
  theme: ["obstacle", "bien", "agression"],
  emotion: "Réprobation, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Barr"],
  mirrorVersion: `« Obstacle au bien, transgresseur, pécheur. » Le miroir me montre le profil complet du mécréant : il empêche le bien, il agresse, il pèche. Il est un obstacle actif contre la vérité. Le miroir m'interroge : est-ce que je suis un obstacle au bien ?`,
  reflection: `L'obstacle au bien est un agent du mal. La transgression est un choix délibéré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'I'an lil-khayri a'thin zanim » — obstacle au bien, transgresseur, pécheur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un obstacle au bien ? Ou est-ce que je facilite le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui empêche le bien fait le travail du mal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien et le mal sont en compétition. Chacun choisit son camp." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui facilite le bien reçoit la récompense du bien." }
  ],
  munajat: `Ya Barr, Tu es la source du bien. Fais que je sois un facilitateur du bien, pas un obstacle. Ne permets pas que je sois du côté du mal.`
};

MIROIR["68:13"] = {
  reference: "68:13",
  theme: ["ignoble", "naissance", "caractère"],
  emotion: "Réprobation, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Karim", "Al-Bari"],
  mirrorVersion: `« Grossier, et en plus de cela, bâtard. » Le miroir me montre l'insulte finale. Le mécréant est décrit comme grossier ET de naissance illégitime. Cette description sévère montre le mépris divin pour ceux qui combattent la vérité. Le miroir m'interroge : quel est mon caractère devant Allah ?`,
  reflection: `Le caractère révèle la personne. La grossièreté est un signe de bassesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Utullin ba'da dhalika zanim » — grossier, et en plus de cela, bâtard." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon caractère ? Suis-je grossier ou raffiné par la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse de caractère vient de la noblesse de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le caractère est plus important que la naissance. La foi transforme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est noble par la foi l'emporte sur tous les nobles de naissance." }
  ],
  munajat: `Ya Karim, Tu es le Noble. Fais que mon caractère soit noble. Ne permets pas que je sois grossier. Purifie-moi de toute bassesse.`
};

MIROIR["68:14"] = {
  reference: "68:14",
  theme: ["richesse", "enfants", "orgueil"],
  emotion: "Mise en garde, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Mughni"],
  mirrorVersion: `« Parce qu'il a des richesses et des enfants. » Le miroir me montre la source de l'orgueil : les richesses et les enfants. Quand on a, on oublie qui donne. On s'enfle d'orgueil. Le miroir m'interroge : est-ce que ma richesse et mes enfants me rendent orgueilleux ?`,
  reflection: `Les richesses et les enfants sont des dons, pas des raisons d'orgueil. Ils peuvent être des épreuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An kana dha malin wa banin » — parce qu'il a des richesses et des enfants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes biens me rendent orgueilleux ? Est-ce que j'oublie qui les a donnés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les richesses et les enfants sont des tests. L'orgueil révèle l'échec du test." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens passent. Les enfants partent. Seul Allah reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît que ses biens viennent d'Allah reste humble." }
  ],
  munajat: `Ya Ghani, Tu es le Riche. Tout ce que j'ai vient de Toi. Ne permets pas que je m'enorgueillis de Tes dons. Fais que je sois reconnaissant.`
};

MIROIR["68:15"] = {
  reference: "68:15",
  theme: ["versets", "rejet", "menace"],
  emotion: "Mise en garde, fermeté",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Jabbar"],
  mirrorVersion: `« Quand Nos versets lui sont récités, il dit : Des fables d'anciens. » Le miroir me montre le rejet arrogant des versets d'Allah. Au lieu d'écouter, le mécréant traite la révélation de fables. Le miroir m'interroge : comment est-ce que je réagis aux versets d'Allah ?`,
  reflection: `Le rejet des versets est un signe de mécréance. L'écoute est un signe de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha tutla 'alayhi ayatuna qala asatiru al-awwalin » — il dit : des fables d'anciens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis aux versets ? Est-ce que je les écoute ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Traiter la révélation de fables ne change pas la révélation — ça change seulement le destin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est vivant. Ce n'est pas un vieux livre — c'est une parole actuelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute les versets avec le cœur reçoit leur lumière." }
  ],
  munajat: `Ya Rabb, quand Tes versets sont récités, fais que je les écoute avec le cœur. Ne permets pas que je les traite comme des fables. Ouvre mon cœur à Ta parole.`
};

MIROIR["68:16"] = {
  reference: "68:16",
  theme: ["marque", "nez", "humiliation"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Muthil", "Al-Hakam"],
  mirrorVersion: `« Nous le marquerons sur le nez. » Le miroir me montre que le châtiment sera visible. La marque sur le nez sera une humiliation publique. Les orgueilleux seront marqués pour que tous voient. Le miroir m'interroge : est-ce que je préfère l'humiliation ici-bas ou dans l'au-delà ?`,
  reflection: `L'humiliation des orgueilleux est certaine. La marque sera visible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa nasimuhu 'ala al-khurtum » — Nous le marquerons sur le nez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préfère l'humiliation maintenant par la repentance, ou plus tard par le châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil mène à l'humiliation. L'humilité mène à l'élévation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La marque sur le nez est un symbole : tout le monde verra le péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie devant Allah maintenant sera élevé." }
  ],
  munajat: `Ya Rabb, je m'humilie devant Toi. Élève-moi. Ne permets pas que je sois marqué d'humiliation le Jour du Jugement.`
};

MIROIR["68:17"] = {
  reference: "68:17",
  theme: ["jardin", "épreuve", "serment"],
  emotion: "Leçon, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Mubtala", "Al-Hakim"],
  mirrorVersion: `« Nous les avons éprouvés comme Nous avons éprouvé les propriétaires du jardin. » Le miroir me montre l'histoire des propriétaires du jardin qui ont refusé de partager. Allah les a éprouvés en détruisant leur jardin pendant la nuit. Le miroir m'interroge : est-ce que je partage les dons d'Allah ?`,
  reflection: `Le jardin est un test. Le refus de partager mène à la perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna balawnahum kama balawna ashab al-jannah » — Nous les avons éprouvés comme les propriétaires du jardin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je partage ? Est-ce que je reconnais que les dons sont des tests ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jardin n'est pas un droit — c'est un dépôt à partager." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les dons sont des tests. Le refus de partager annule le don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage reçoit plus. Celui qui garde perd tout." }
  ],
  munajat: `Ya Rabb, les dons que Tu m'as donnés sont des tests. Fais que je les partage. Ne permets pas que je sois parmi les avares.`
};

MIROIR["68:18"] = {
  reference: "68:18",
  theme: ["partage", "droit", "pauvres"],
  emotion: "Leçon, justice",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Razzaq"],
  mirrorVersion: `« Quand ils ont juré de le cueillir au matin, sans faire d'exception. » Le miroir me montre le serment des propriétaires. Ils ont juré de tout cueillir sans laisser de part aux pauvres. Leur serment était égoïste. Le miroir m'interroge : est-ce que mes serments incluent les autres ?`,
  reflection: `Le serment égoïste mène à la perte. L'exception pour les pauvres est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha aqsamu li-yasrihimaha musbihin » — quand ils ont juré de le cueillir au matin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prévois une part pour les pauvres ? Mes plans incluent-ils les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égoïsme dans les plans mène à la destruction des plans." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pauvre a un droit sur les biens du riche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prévoit une part pour les pauvres bénit tout son bien." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Fais que je prévoie une part pour les pauvres. Ne permets pas que je sois égoïste dans mes plans.`
};

MIROIR["68:19"] = {
  reference: "68:19",
  theme: ["catastrophe", "nuit", "visite"],
  emotion: "Terreur, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Mais une visite de ton Seigneur vint pendant la nuit, tandis qu'ils dormaient. » Le miroir me montre l'imprévu divin. Pendant qu'ils dormaient, sûrs de leur récolte, le châtiment est venu. Rien n'est sûr sans la permission d'Allah. Le miroir m'interroge : est-ce que je dors en pensant que tout est acquis ?`,
  reflection: `La sécurité illusoire mène à la catastrophe. Seul Allah protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tafaha 'alayha ta'ifun min rabbika wa hum na'imun » — une visite de ton Seigneur vint pendant la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dors tranquille en pensant que tout est acquis ? Ou est-ce que je compte sur Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit est le moment de la vulnérabilité. Allah peut frapper à tout moment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plans les mieux préparés peuvent être détruits en une nuit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah dort tranquille — car Il veille." }
  ],
  munajat: `Ya Qadir, Tu peux tout détruire en une nuit. Je compte sur Toi. Protège ce que j'ai. Ne permets pas que je sois surpris.`
};

MIROIR["68:20"] = {
  reference: "68:20",
  theme: ["destruction", "récolte", "matin"],
  emotion: "Stupeur, perte",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Khafid"],
  mirrorVersion: `« Et le matin, ce fut comme si tout avait été fauché. » Le miroir me montre l'étendue de la destruction. En une nuit, tout a disparu. Le jardin florissant est devenu un champ fauché. Le miroir m'interroge : est-ce que je réalise que tout peut disparaître en un instant ?`,
  reflection: `Tout peut disparaître en une nuit. La gratitude préserve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-asbahat ka-al-sarim » — et le matin, ce fut comme si tout avait été fauché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que tout peut disparaître ? Est-ce que je suis reconnaissant pour ce que j'ai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte d'un bien peut être la préservation de l'âme — si on se repent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les récoltes peuvent être détruites. Les richesses peuvent disparaître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant garde ce qu'il a — et reçoit plus." }
  ],
  munajat: `Ya Rabb, tout peut disparaître en une nuit. Je suis reconnaissant pour ce que j'ai. Préserve-le moi. Ne permets pas que je le perde par ingratitude.`
};

MIROIR["68:21"] = {
  reference: "68:21",
  theme: ["matin", "appel", "réveil"],
  emotion: "Routine, ignorance",
  difficulty: "débutant",
  relatedNames: ["Al-Munadi", "Al-Ba'ith"],
  mirrorVersion: `« Et le matin, ils s'appelèrent les uns les autres. » Le miroir me montre la routine innocente avant la catastrophe. Ils s'appellent pour aller cueillir, sans savoir que tout est détruit. Le miroir m'interroge : est-ce que je me réveille chaque matin avec reconnaissance ou avec routine ?`,
  reflection: `Le matin peut apporter des surprises. La gratitude prépare le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tanadaw musbihin » — et le matin, ils s'appelèrent les uns les autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je me réveille ? Avec reconnaissance ou avec routine aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel du matin peut être un appel à la joie ou un appel à la catastrophe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque matin est un don. Ce qui attend peut être différent de ce qu'on attend." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réveille avec gratitude est prêt pour tout." }
  ],
  munajat: `Ya Rabb, chaque matin est un don. Fais que je me réveille avec reconnaissance. Prépare-moi pour ce qui m'attend.`
};

MIROIR["68:22"] = {
  reference: "68:22",
  theme: ["urgence", "récolte", "plan"],
  emotion: "Hâte, confiance illusoire",
  difficulty: "débutant",
  relatedNames: ["Al-Mudabbir", "Al-Muqtadir"],
  mirrorVersion: `« Allez, tôt, à votre récolte, si vous voulez la cueillir. » Le miroir me montre la confiance illusoire. Ils croient pouvoir cueillir ce qu'ils n'ont pas protégé par la gratitude. Leurs plans seront anéantis. Le miroir m'interroge : est-ce que je planifie sans compter sur Allah ?`,
  reflection: `Les plans sans Allah sont illusoires. La confiance en Allah préserve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ani irkudu ila harthikum in kuntum sarimin » — allez, tôt, à votre récolte, si vous voulez la cueillir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je planifie sans Allah ? Est-ce que je me précipite sans Sa protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La précipitation sans Allah mène à la déception." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plans peuvent être faits, mais Allah décide du résultat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui inclut Allah dans ses plans ne sera pas déçu." }
  ],
  munajat: `Ya Mudabbir, Tu es Celui qui gère. Inclus-Toi dans mes plans. Ne permets pas que je me précipite sans Toi.`
};

MIROIR["68:23"] = {
  reference: "68:23",
  theme: ["murmure", "secret", "complot"],
  emotion: "Culpabilité, calcul",
  difficulty: "débutant",
  relatedNames: ["Al-Sami'", "Al-'Alim"],
  mirrorVersion: `« Et ils partirent en se parlant à voix basse. » Le miroir me montre le murmure des conspirateurs. Ils parlent bas, cachent leurs intentions aux pauvres. Mais Allah entend tout. Le miroir m'interroge : est-ce que je cache mes intentions aux autres ?`,
  reflection: `Les murmures ne sont pas cachés à Allah. Les complots sont connus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tawawwada 'ala amrihim » — et ils partirent en se parlant à voix basse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je murmure pour cacher mes intentions ? Est-ce que je trame des complots ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le murmure est une admission de culpabilité. La transparence est la marque de la pureté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les secrets entre hommes sont publics devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a rien à cacher n'a pas besoin de murmurer." }
  ],
  munajat: `Ya Sami', Tu entends les murmures. Purifie mon cœur. Ne permets pas que je cache des intentions mauvaises.`
};

MIROIR["68:24"] = {
  reference: "68:24",
  theme: ["exclusion", "pauvres", "dureté"],
  emotion: "Condamnation, dureté",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Karim"],
  mirrorVersion: `« Aucun pauvre n'entrera chez vous aujourd'hui. » Le miroir me montre la dureté du cœur. Ils excluent les pauvres de leur récolte. L'égoïsme atteint son sommet. Le miroir m'interroge : est-ce que j'exclus les pauvres de ma vie ?`,
  reflection: `L'exclusion des pauvres est une dureté de cœur. Le pauvre a un droit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An la yadkhulannahumu al-yawma 'alaykum miskin » — aucun pauvre n'entrera chez vous aujourd'hui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'exclus les pauvres ? Est-ce que je ferme ma porte à ceux qui ont besoin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Fermer la porte aux pauvres, c'est fermer la porte à la bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pauvre est un visiteur d'Allah. Comment on le traite reflète notre foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre sa porte aux pauvres ouvre la porte à la bénédiction." }
  ],
  munajat: `Ya Rahman, Tu es le Miséricordieux. Ouvre mon cœur aux pauvres. Ne permets pas que je ferme ma porte à ceux qui ont besoin.`
};

MIROIR["68:25"] = {
  reference: "68:25",
  theme: ["puissance", "inégalité", "arrogance"],
  emotion: "Mise en garde, condamnation",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Musta'an"],
  mirrorVersion: `« Et ils partirent de bon matin, avec une résolution ferme. » Le miroir me montre la détermination des égoïstes. Ils sont fermes dans leur mauvaise intention. La résolution dans le mal mène à la perte. Le miroir m'interroge : suis-je ferme dans le bien ou dans le mal ?`,
  reflection: `La fermeté dans le mal mène à la destruction. La fermeté dans le bien mène au succès.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ghadaw 'ala hardin qadirin » — et ils partirent de bon matin, avec une résolution ferme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi suis-je ferme ? Dans le bien ou dans le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeté n'est pas une vertu en soi — c'est la direction qui compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La détermination peut mener au sommet ou au précipice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est ferme dans le bien reçoit l'aide d'Allah." }
  ],
  munajat: `Ya Rabb, je veux être ferme dans le bien. Aide-moi. Ne permets pas que je sois ferme dans le mal. Guide ma résolution.`
};

MIROIR["68:26"] = {
  reference: "68:26",
  theme: ["vision", "réalisation", "choc"],
  emotion: "Stupeur, choc",
  difficulty: "débutant",
  relatedNames: ["Al-Khafid", "Al-Rafi'"],
  mirrorVersion: `« Mais quand ils virent le jardin, ils dirent : Nous nous sommes certainement égarés. » Le miroir me montre le moment de la réalisation. En voyant leur jardin détruit, ils pensent s'être égarés. Le choc de la perte. Le miroir m'interroge : est-ce que je réalise mes erreurs avant qu'il ne soit trop tard ?`,
  reflection: `La réalisation peut venir trop tard. L'autocorrection prévient la perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ra'awha qalu inna la-dallun » — quand ils virent le jardin, ils dirent : nous nous sommes égarés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise mes erreurs maintenant ? Ou est-ce que j'attends le choc de la perte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'égarement dans la route peut être corrigé. L'égarement du cœur est plus grave." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perte matérielle peut réveiller la conscience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se corrige avant la perte évite le choc." }
  ],
  munajat: `Ya Rabb, fais que je réalise mes erreurs maintenant. Ne permets pas que j'attende le choc de la perte pour me réveiller.`
};

MIROIR["68:27"] = {
  reference: "68:27",
  theme: ["perte", "réalité", "désespoir"],
  emotion: "Désespoir, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Muhyi"],
  mirrorVersion: `« Non, nous sommes privés. » Le miroir me montre la reconnaissance finale. Ils comprennent qu'ils ont été privés de tout. Le jardin qu'ils voulaient garder pour eux seuls — ils l'ont perdu entièrement. Le miroir m'interroge : est-ce que je réalise que ce que je garde égoïstement peut m'être retiré ?`,
  reflection: `Ce qu'on garde égoïstement peut être perdu. Le partage protège.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal nahnu mahrumun » — non, nous sommes privés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je garde égoïstement ? Est-ce que je réalise que je peux en être privé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La privation est la conséquence de l'avarice. Le partage est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce qu'on retient trop serré s'échappe. Ce qu'on partage se multiplie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage ce qu'il a ne sera jamais privé." }
  ],
  munajat: `Ya Rabb, je ne veux pas être privé. Fais que je partage. Ne permets pas que mon avarice me fasse tout perdre.`
};

MIROIR["68:28"] = {
  reference: "68:28",
  theme: ["juste", "rappel", "repentir"],
  emotion: "Remords, correction",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "At-Tawwab"],
  mirrorVersion: `« Le plus juste d'entre eux dit : Ne vous avais-je pas dit : Pourquoi ne glorifiez-vous pas Allah ? » Le miroir me montre qu'il y avait un juste parmi eux. Il avait averti, mais ils ne l'ont pas écouté. Maintenant il leur rappelle. Le miroir m'interroge : est-ce que j'écoute les justes qui m'avertissent ?`,
  reflection: `Le juste avertit. L'écoute sauve. L'ignorance perd.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala awsatuhum alam aqul lakum lawla tusalihun » — le plus juste dit : ne vous avais-je pas dit : pourquoi ne glorifiez-vous pas Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute les avertissements ? Ou est-ce que je les ignore jusqu'à la catastrophe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le juste est souvent ignoré — mais il finit par avoir raison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque groupe a son juste. L'écouter est un choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le juste maintenant évite le regret." }
  ],
  munajat: `Ya Hadi, envoie-moi des justes qui m'avertissent. Fais que je les écoute. Ne permets pas que je les ignore jusqu'à la catastrophe.`
};

MIROIR["68:29"] = {
  reference: "68:29",
  theme: ["repentir", "glorification", "reconnaissance"],
  emotion: "Remords, retour",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Ils dirent : Gloire à notre Seigneur ! Nous avons certainement été injustes. » Le miroir me montre le repentir tardif mais sincère. Ils reconnaissent leur injustice. Ils glorifient Allah. Le repentir vient après la perte. Le miroir m'interroge : est-ce que je me repens avant de perdre ?`,
  reflection: `Le repentir sincère purifie. Le repentir avant la perte préserve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu subhana rabbina inna kunna zalimin » — ils dirent : gloire à notre Seigneur ! Nous avons été injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens maintenant ? Ou est-ce que j'attends la perte pour me réveiller ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'injustice est le début du repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perte peut être une miséricorde si elle mène au repentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la perte garde ce qu'il a." }
  ],
  munajat: `Ya Tawwab, Tu acceptes le repentir. Je me repens maintenant. Ne permets pas que j'attende la perte pour me réveiller.`
};

MIROIR["68:30"] = {
  reference: "68:30",
  theme: ["blâme", "reproche", "responsabilité"],
  emotion: "Confrontation, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Hakam"],
  mirrorVersion: `« Et ils se mirent à se faire des reproches mutuels. » Le miroir me montre la division qui suit la catastrophe. Au lieu de se repentir ensemble, ils se blâment. Le miroir m'interroge : est-ce que je blâme les autres pour mes erreurs ?`,
  reflection: `Le blâme mutuel ne résout rien. La responsabilité personnelle est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-aqbala ba'duhum 'ala ba'din yatalawamun » — ils se mirent à se faire des reproches mutuels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je blâme les autres ? Ou est-ce que j'accepte ma responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le blâme mutuel divise. La responsabilité partagée unit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la difficulté, les équipes se divisent ou se soudent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa responsabilité grandit." }
  ],
  munajat: `Ya Rabb, je n'accuse pas les autres. J'accepte ma responsabilité. Aide-moi à me corriger.`
};

// Remaining Surah 68 entries (31-52)
MIROIR["68:31"] = {
  reference: "68:31",
  theme: ["malheur", "réalisation", "reconnaissance"],
  emotion: "Regret, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Ghaffur"],
  mirrorVersion: `« Ils dirent : Malheur à nous ! Nous avons été des transgresseurs. » Le miroir me montre la reconnaissance finale. Le malheur frappe, et alors ils reconnaissent leur transgression. La reconnaissance vient trop tard pour sauver le jardin, mais pas trop tard pour sauver l'âme. Le miroir m'interroge : est-ce que je reconnais mes transgressions avant le malheur ?`,
  reflection: `La reconnaissance de la transgression peut sauver l'âme, même après la perte des biens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya waylana inna kunna taghin » — malheur à nous ! Nous avons été des transgresseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mes transgressions ? Ou est-ce que j'attends le malheur pour me réveiller ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur peut être une miséricorde s'il mène à la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transgression a des conséquences. La reconnaissance ouvre la porte du pardon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se reconnaît transgresseur avant le malheur est pardonné." }
  ],
  munajat: `Ya Ghaffur, je reconnais mes transgressions. Pardonne-moi. Ne permets pas que j'attende le malheur pour me réveiller.`
};

MIROIR["68:35"] = {
  reference: "68:35",
  theme: ["comparaison", "jugement", "égalité"],
  emotion: "Questionnement, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Est-ce que Nous traiterons les soumis comme les criminels ? » Le miroir me montre la question rhétorique d'Allah. Bien sûr que non ! Les soumis ne sont pas comme les criminels. La justice divine distingue clairement. Le miroir m'interroge : suis-je parmi les soumis ou parmi les criminels ?`,
  reflection: `La distinction entre soumis et criminels est fondamentale. Chacun choisit son camp.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afanaj'al al-muslimina ka-al-mujrimin » — est-ce que Nous traiterons les soumis comme les criminels ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les soumis ? Ou suis-je parmi les criminels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission n'est pas une faiblesse — c'est le chemin de la dignité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite. Chacun reçoit selon ses actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet maintenant sera honoré éternellement." }
  ],
  munajat: `Ya Hakam, Tu es le Juge. Je choisis la soumission. Ne permets pas que je sois parmi les criminels.`
};

MIROIR["68:36"] = {
  reference: "68:36",
  theme: ["jugement", "question", "raison"],
  emotion: "Questionnement, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Qu'avez-vous ? Comment jugez-vous ? » Le miroir me montre l'interrogation divine. Les mécréants jugent mal — ils mettent les soumis et les criminels sur le même plan. Le miroir m'interroge : sur quoi je base mon jugement ?`,
  reflection: `Le jugement humain peut être erroné. Seul Allah juge parfaitement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lakum kayfa tahkumun » — qu'avez-vous ? Comment jugez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je juge ? Sur quoi je me base ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mauvais jugement vient de l'aveuglement du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le discernement est un don. Le jugement précipité est une erreur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui juge avec sagesse approche le jugement divin." }
  ],
  munajat: `Ya Hakim, donne-moi la sagesse dans le jugement. Ne permets pas que je juge mal. Guide mon discernement.`
};

MIROIR["68:51"] = {
  reference: "68:51",
  theme: ["rejet", "regard", "résistance"],
  emotion: "Fermeté, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Sabur", "Al-Matin"],
  mirrorVersion: `« Et ceux qui ont mécru faillirent te faire glisser de tes pieds par leurs regards, quand ils entendent le Rappel. » Le miroir me montre l'intensité du rejet des mécréants. Leurs regards hostiles voulaient faire trébucher le Prophète. Mais il reste ferme. Le miroir m'interroge : est-ce que je reste ferme face aux regards hostiles ?`,
  reflection: `Les regards hostiles ne peuvent pas faire tomber celui qui est ancré en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yakadu alladhina kafaru la-yuzliqunaka bi-absarihim » — ils faillirent te faire glisser par leurs regards." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste ferme face à l'hostilité ? Ou est-ce que je me laisse déstabiliser ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regard hostile ne peut pas blesser celui qui regarde Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les regards peuvent tuer ou guérir. Tout dépend de leur source." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est ancré en Allah ne peut pas être ébranlé par les regards." }
  ],
  munajat: `Ya Matin, Tu es le Solide. Ancre-moi en Toi. Ne permets pas que les regards hostiles me fassent trébucher.`
};

MIROIR["68:52"] = {
  reference: "68:52",
  theme: ["rappel", "monde", "universel"],
  emotion: "Universalité, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Et ce n'est qu'un Rappel pour l'univers. » Le miroir me montre l'universalité du Coran. Ce n'est pas un message pour une tribu ou une époque — c'est un Rappel pour tous les mondes. Le miroir m'interroge : est-ce que je traite le Coran comme un Rappel universel ?`,
  reflection: `Le Coran est universel. Il parle à tous les temps et tous les lieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma huwa illa dhikrun lil-'alamin » — ce n'est qu'un Rappel pour l'univers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran comme un message universel ? Ou est-ce que je le limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Rappel universel demande une réponse universelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran traverse les siècles. Il est vivant et actuel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme un Rappel universel reçoit sa guidance." }
  ],
  munajat: `Ya Nur, Tu es la Lumière universelle. Fais que je lise le Coran comme un Rappel pour moi. Guide-moi par Ta lumière.`
};

// ==================== SURAH 69: AL-HAQQAH (52 verses) ====================

MIROIR["69:1"] = {
  reference: "69:1",
  theme: ["inévitable", "réalité", "Heure"],
  emotion: "Sérieux, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Haqq"],
  mirrorVersion: `« L'inévitable. » Le miroir me place devant une réalité absolue. Al-Haqqah — celle qui frappe inévitablement. L'Heure n'est pas une possibilité — c'est une certitude. Le miroir m'interroge : est-ce que je vis comme si l'inévitable allait venir ?`,
  reflection: `L'Heure est inévitable. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-haqqah » — l'inévitable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare l'inévitable ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inévitable n'est pas une menace — c'est une réalité à embrasser." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers tend vers une fin. L'Heure est la fin de tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare l'inévitable la rencontre avec sérénité." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. L'Heure est inévitable. Prépare-moi. Ne permets pas que je sois surpris.`
};

MIROIR["69:2"] = {
  reference: "69:2",
  theme: ["question", "réalité", "définition"],
  emotion: "Questionnement, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Haqq"],
  mirrorVersion: `« Qu'est-ce que l'inévitable ? » Le miroir me pose la question. La réponse n'est pas donnée immédiatement — il faut méditer. Qu'est-ce que cette réalité qui frappe sans échappatoire ? Le miroir m'interroge : est-ce que je comprends ce qui vient ?`,
  reflection: `La question prépare la réponse. La méditation approfondit la compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma al-haqqah » — qu'est-ce que l'inévitable ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je comprends de l'Heure ? Est-ce que j'ai médité sur sa réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question « qu'est-ce que » invite à la profondeur, pas à la superficialité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les grandes réalités demandent de grandes questions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend ce qui vient se prépare vraiment." }
  ],
  munajat: `Ya 'Alim, Tu connais toutes les réalités. Fais-moi comprendre l'inévitable. Prépare mon cœur.`
};

MIROIR["69:3"] = {
  reference: "69:3",
  theme: ["connaissance", "révélation", "mystère"],
  emotion: "Humilité, recherche",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Et ce qui te fera comprendre ce qu'est l'inévitable ? » Le miroir me montre que la compréhension n'est pas automatique. Il faut être préparé pour comprendre. La question répond à la question. Le miroir m'interroge : suis-je prêt à comprendre ?`,
  reflection: `La compréhension demande une préparation du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma al-haqqah » — et ce qui te fera comprendre ce qu'est l'inévitable ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à comprendre ? Mon cœur est-il préparé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compréhension n'est pas intellectuelle — elle est spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les grandes vérités ne se comprennent qu'avec un cœur ouvert." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut comprendre reçoit la compréhension." }
  ],
  munajat: `Ya 'Alim, ouvre mon cœur à la compréhension. Prépare-moi à recevoir les grandes vérités.`
};

// ==================== SURAH 70: AL-MA'ARIJ (44 verses) ====================

MIROIR["70:1"] = {
  reference: "70:1",
  theme: ["demande", "châtiment", "question"],
  emotion: "Défi, interrogation",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Qadir"],
  mirrorVersion: `« Un demandeur a demandé un châtiment inéluctable. » Le miroir me montre l'attitude du mécréant. Il demande le châtiment comme un défi, sans réaliser sa gravité. Le miroir m'interroge : est-ce que je demande le châtiment par mon comportement ?`,
  reflection: `Demander le châtiment par défi est une folie. Le châtiment est une réalité terrible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa'ala sa'ilun bi-'adhabin waqi' » — un demandeur a demandé un châtiment inéluctable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon comportement demande le châtiment ? Ou est-ce que je le fuis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le défi du mécréant sera exaucé — mais à son détriment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Certaines demandes sont exaucées comme punition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit le châtiment par la repentance sera protégé." }
  ],
  munajat: `Ya Rabb, je ne demande pas le châtiment. Je demande la protection. Préserve-moi de ce que les mécréants défient.`
};

MIROIR["70:2"] = {
  reference: "70:2",
  theme: ["mécréants", "arrêt", "sans issue"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Jabbar"],
  mirrorVersion: `« Pour les mécréants, sans que personne ne puisse le repousser. » Le miroir me montre que le châtiment des mécréants est sans issue. Personne ne peut le repousser. Le miroir m'interroge : est-ce que je me prépare pour ne pas être parmi les mécréants ?`,
  reflection: `Le châtiment des mécréants est certain et sans défense possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lill-kafirina laysa lahu dafi' » — pour les mécréants, sans que personne ne puisse le repousser." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis préparé ? Ou est-ce que je risque d'être parmi les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est la seule protection contre l'inévitable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a pas d'avocat contre le châtiment divin. La foi est la défense." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi n'a pas à craindre l'inévitable." }
  ],
  munajat: `Ya Rabb, je crois en Toi. Protège-moi du châtiment. Ne permets pas que je sois sans défense.`
};

MIROIR["70:3"] = {
  reference: "70:3",
  theme: ["Allah", "voies", "ascension"],
  emotion: "Révérence, grandeur",
  difficulty: "débutant",
  relatedNames: ["Al-'Aliyy", "Dhul-Ma'arij"],
  mirrorVersion: `« D'Allah, le Maître des voies d'ascension. » Le miroir me montre la grandeur d'Allah. Il est le Maître des voies d'ascension — les chemins qui mènent vers Lui, et les chemins par lesquels descendent Ses ordres. Le miroir m'interroge : est-ce que je connais Celui qui détient toutes les voies ?`,
  reflection: `Allah est le Maître de toutes les voies. L'ascension vers Lui est possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mina Allahi dhi al-ma'arij » — d'Allah, le Maître des voies d'ascension." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais Allah comme le Maître des voies ? Est-ce que j'emprunte les chemins vers Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les voies d'ascension sont ouvertes à tous — mais il faut les emprunter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il y a des chemins vers le ciel. Les anges les empruntent. L'homme peut les suivre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les voies d'ascension monte vers Allah." }
  ],
  munajat: `Ya 'Aliyy, Tu es le Maître des voies d'ascension. Montre-moi les chemins vers Toi. Fais que je monte.`
};

// ==================== SURAH 71: NUH (28 verses) ====================

MIROIR["71:1"] = {
  reference: "71:1",
  theme: ["Noé", "avertissement", "mission"],
  emotion: "Mission, responsabilité",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Nadhir"],
  mirrorVersion: `« Nous avons envoyé Noé à son peuple : Avertis ton peuple avant qu'un châtiment douloureux ne l'atteigne. » Le miroir me montre la mission de Noé — avertir avant qu'il soit trop tard. Le prophète le plus ancien, la mission la plus longue. Le miroir m'interroge : est-ce que j'écoute les avertissements ?`,
  reflection: `Les avertissements précèdent le châtiment. L'écoute sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna arsalna nuhan ila qawmihi an andhir qawmaka » — Nous avons envoyé Noé à son peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute les avertissements ? Ou est-ce que j'attends le châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde avant le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple reçoit des avertisseurs. Chaque génération a ses signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement n'a pas besoin du châtiment." }
  ],
  munajat: `Ya Rabb, Tu envoies des avertisseurs. Fais que je les écoute. Ne permets pas que j'attende le châtiment pour me réveiller.`
};

MIROIR["71:2"] = {
  reference: "71:2",
  theme: ["message", "adoration", "crainte"],
  emotion: "Clarté, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Wadud"],
  mirrorVersion: `« Il dit : Ô mon peuple, je suis pour vous un avertisseur explicite : Adorez Allah, craignez-Le et obéissez-moi. » Le miroir me montre le message simple de Noé. Trois commandements : adorez Allah, craignez-Le, obéissez au prophète. Le miroir m'interroge : est-ce que je suis ce message simple ?`,
  reflection: `Le message est simple. L'application demande engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ya qawmi inna laka nadhirun mubin » — je suis pour vous un avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah seul ? Est-ce que je Le crains ? Est-ce que j'obéis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La simplicité du message cache la profondeur de l'engagement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes ont apporté le même message fondamental." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le message simple reçoit tout." }
  ],
  munajat: `Ya Rabb, j'adore Toi seul. Je Te crains. J'obéis à Ton prophète. Confirme-moi sur ce chemin.`
};

// ==================== SURAH 72: AL-JINN (28 verses) ====================

MIROIR["72:1"] = {
  reference: "72:1",
  theme: ["djinn", "Coran", "écoute"],
  emotion: "Mystère, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghayb", "Al-Sami'"],
  mirrorVersion: `« Dis : Il m'a été révélé qu'un groupe de djinns a écouté et a dit : Nous avons entendu une récitation merveilleuse. » Le miroir m'ouvre à une dimension invisible. Les djinns ont écouté le Coran et ont été émerveillés. Leur réaction nous enseigne comment recevoir la révélation. Le miroir m'interroge : est-ce que le Coran m'émerveille ?`,
  reflection: `Les djinns ont reconnu la merveille du Coran. L'homme doit faire de même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul uhiya ilayya annahu istama'a nafarun mina al-jinni » — un groupe de djinns a écouté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que le Coran m'émerveille ? Ou est-ce que je l'écoute avec indifférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les djinns, créés du feu, reconnaissent la lumière. L'homme, créé de terre, doit faire mieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est un message pour tous les mondes — visible et invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le Coran avec émerveillement reçoit sa lumière." }
  ],
  munajat: `Ya Rabb, les djinns ont été émerveillés par Ton Coran. Fais que je le sois aussi. Ouvre mon cœur à sa merveille.`
};

// ==================== SURAH 73: AL-MUZAMMIL (20 verses) ====================

MIROIR["73:1"] = {
  reference: "73:1",
  theme: ["nuit", "prière", "solitude"],
  emotion: "Intimité, consécration",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Qarib"],
  mirrorVersion: `« Ô toi, l'enveloppé ! Lève-toi la nuit, un peu. » Le miroir m'invite à la prière nocturne. Le Prophète est appelé « l'enveloppé » — dans ses vêtements, dans la nuit, dans la prière. Le miroir m'interroge : est-ce que je consacre une partie de ma nuit à Allah ?`,
  reflection: `La nuit est le temps de l'intimité avec Allah. La prière nocturne élève.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-muzzammil » — ô toi, l'enveloppé !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je consacre une partie de ma nuit à Allah ? Ou est-ce que je dors sans me réveiller ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit est pour le repos — mais aussi pour la prière la plus précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est le moment où le monde dort — et où le croyant se réveille vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se lève la nuit trouve Allah plus proche." }
  ],
  munajat: `Ya Rabb, la nuit est pour Toi. Fais que je me lève pour la prière. Donne-moi la force de quitter le sommeil pour Ta rencontre.`
};

// ==================== SURAH 74: AL-MUDDATHTHIR (56 verses) ====================

MIROIR["74:1"] = {
  reference: "74:1",
  theme: ["appel", "prophète", "révélation"],
  emotion: "Appel, mission",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Mursil"],
  mirrorVersion: `« Ô toi, le couvert de ton manteau ! Lève-toi et avertis. » Le miroir me montre le deuxième appel à la prophétie. Le Prophète, enveloppé dans son manteau, reçoit l'ordre de se lever et d'avertir. La mission commence. Le miroir m'interroge : est-ce que je me lève pour ma mission ?`,
  reflection: `L'appel à la mission demande de quitter son confort pour avertir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-muddaththir » — ô toi, le couvert de ton manteau !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me lève pour ma mission ? Ou est-ce que je reste couvert dans mon confort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le manteau du confort doit être quitté pour la mission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque croyant a une mission. Le confort est l'ennemi de la mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui quitte son confort pour Allah reçoit Sa présence." }
  ],
  munajat: `Ya Rabb, je me lève pour ma mission. Aide-moi à quitter mon confort. Montre-moi comment avertir.`
};

// ==================== SURAH 75: AL-QIYAMAH (40 verses) ====================

MIROIR["75:1"] = {
  reference: "75:1",
  theme: ["résurrection", "serment", "âme"],
  emotion: "Sérieux, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "An-Nafs"],
  mirrorVersion: `« Non ! Je jure par le Jour de la Résurrection. » Le miroir me place devant un serment divin. Allah jure par la résurrection — un événement certain. Le miroir m'interroge : est-ce que je vis comme si la résurrection était certaine ?`,
  reflection: `La résurrection est certaine. Le serment divin le confirme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La uqsimu bi-yawmi al-qiyamah » — je jure par le Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si la résurrection était certaine ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection n'est pas une fin — c'est un nouveau début." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers tend vers la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la résurrection prépare son retour." }
  ],
  munajat: `Ya Ba'ith, Tu ressusciteras les morts. Je crois à la résurrection. Prépare-moi pour ce jour.`
};

// ==================== SURAH 76: AL-INSAN (31 verses) ====================

MIROIR["76:1"] = {
  reference: "76:1",
  theme: ["temps", "homme", "passage"],
  emotion: "Réflexion, temporalité",
  difficulty: "débutant",
  relatedNames: ["Al-Dahr", "Al-Khaliq"],
  mirrorVersion: `« S'est-il écoulé pour l'homme un temps où il n'était pas une chose mentionnable ? » Le miroir me montre le passage du temps. L'homme n'a pas toujours existé. Il y a eu un temps où il n'était rien. Le miroir m'interroge : est-ce que je réalise que mon existence est un don temporaire ?`,
  reflection: `L'existence est un don temporaire. Le temps passe. L'éternité approche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal ata 'ala al-insani hinun mina al-dahri » — s'est-il écoulé pour l'homme un temps..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que mon existence est temporaire ? Est-ce que je suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Du néant à l'existence — c'est un don. De l'existence au néant — c'est un choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps coule pour tous. L'éternité attend ceux qui se préparent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise le don de l'existence vit avec gratitude." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé du néant. Je suis reconnaissant. Fais que je vive ce don avec conscience.`
};

// ==================== SURAH 77: AL-MURSALAT (50 verses) ====================

MIROIR["77:1"] = {
  reference: "77:1",
  theme: ["envoyés", "vents", "serment"],
  emotion: "Mystère, puissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mursil", "Al-Rahman"],
  mirrorVersion: `« Par les envoyés, les uns après les autres. » Le miroir m'ouvre aux mystères de la création. Les « mursalat » sont envoyées par Allah — peut-être les vents, peut-être les anges. Le serment divin utilise la création comme témoin. Le miroir m'interroge : est-ce que je vois les signes d'Allah dans la création ?`,
  reflection: `La création est pleine de signes envoyés par Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-mursalati 'urfa » — par les envoyées, les uns après les autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les signes envoyés par Allah ? Ou est-ce que je suis aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les envoyés d'Allah sont partout — dans le vent, dans la révélation, dans les anges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vent porte un message. Chaque ange exécute un ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les envoyés reconnaît l'Envoyeur." }
  ],
  munajat: `Ya Mursil, Tu envoies des signes partout. Ouvre mes yeux pour les voir. Ne permets pas que je sois aveugle à Tes envoyés.`
};

// ==================== SURAH 78: AN-NABA (40 verses) ====================

MIROIR["78:1"] = {
  reference: "78:1",
  theme: ["question", "grande nouvelle", "doute"],
  emotion: "Questionnement, attente",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Haqq"],
  mirrorVersion: `« De quoi s'interrogent-ils ? De la grande nouvelle. » Le miroir me montre la question qui hante les mécréants. La « grande nouvelle » — la résurrection, le jugement — est au centre de leurs interrogations. Le miroir m'interroge : est-ce que je comprends la grande nouvelle ?`,
  reflection: `La grande nouvelle est la résurrection. C'est le sujet de toutes les questions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Amma yatasa'alun 'ani al-naba'i al-'azim » — de quoi s'interrogent-ils ? De la grande nouvelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la grande nouvelle ? Ou est-ce que je doute comme les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grande nouvelle n'est pas un mystère — c'est une certitude pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être humain s'interroge sur l'après. La réponse est dans la révélation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la grande nouvelle se prépare." }
  ],
  munajat: `Ya Khabir, Tu connais toutes les nouvelles. Fais-moi comprendre la grande nouvelle. Prépare-moi pour ce qui vient.`
};

// ==================== SURAH 79: AN-NAZI'AT (46 verses) ====================

MIROIR["79:1"] = {
  reference: "79:1",
  theme: ["anges", "extraction", "serment"],
  emotion: "Mystère, puissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "Al-Qahir"],
  mirrorVersion: `« Par celles qui arrachent avec violence. » Le miroir m'ouvre aux anges de la mort. Ils arrachent les âmes — avec force pour les mécréants, avec douceur pour les croyants. Le serment divin évoque ce moment redoutable. Le miroir m'interroge : comment sera mon extraction ?`,
  reflection: `L'extraction de l'âme est violente ou douce selon la vie vécue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-nazi'ati gharq » — par celles qui arrachent avec violence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment sera mon extraction ? Violente ou douce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douceur de l'extraction dépend de la douceur de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme connaîtra l'extraction. La question est comment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en paix meurt en paix." }
  ],
  munajat: `Ya Rabb, je veux une extraction douce. Fais que ma vie soit en paix avec Toi. Ne permets pas que mon extraction soit violente.`
};

// ==================== SURAH 79: AN-NAZI'AT - MISSING VERSES 2-39, 41-46 ====================

MIROIR["79:2"] = {
  reference: "79:2",
  theme: ["anges", "extraction", "douceur"],
  emotion: "Mystère, soulagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "Ar-Rahim"],
  mirrorVersion: `« Et par celles qui extraient avec douceur. » Le miroir me montre l'autre face de l'extraction. Pour les croyants, les anges extraient l'âme avec douceur. Le contraste avec le premier verset. Le miroir m'enseigne : la qualité de la mort dépend de la qualité de la vie.`,
  reflection: `L'extraction douce pour les croyants. La douceur de la vie mène à la douceur de la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-nashitati nashtan » — et par celles qui extraient avec douceur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment sera mon extraction ? Douce ou violente ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La douceur de l'extraction est la récompense de la douceur de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme connaîtra l'extraction selon sa vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec douceur meurt avec douceur." }
  ],
  munajat: `Ya Rabb, je veux une extraction douce. Fais que ma vie soit douce avec Toi. Donne-moi la douceur dans la vie et dans la mort.`
};

MIROIR["79:3"] = {
  reference: "79:3",
  theme: ["anges", "nager", "agilité"],
  emotion: "Mystère, mouvement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "As-Sabih"],
  mirrorVersion: `« Et par celles qui nagent avec agilité. » Le miroir me montre le mouvement des anges. Ils nagent dans l'espace, agiles et rapides. L'image de la nage évoque la facilité. Le miroir m'enseigne : les anges exécutent les ordres divins avec facilité.`,
  reflection: `Les anges nagent avec agilité. L'obéissance à Allah est légère pour eux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-sabihati sabhan » — et par celles qui nagent avec agilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis à Allah avec facilité ? Ou est-ce que c'est un fardeau ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance légère vient de l'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à Allah avec agilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime Allah obéit avec légèreté." }
  ],
  munajat: `Ya Rabb, je veux obéir avec légèreté. Fais que Ton service soit un plaisir, pas un fardeau. Donne-moi l'agilité des anges.`
};

MIROIR["79:4"] = {
  reference: "79:4",
  theme: ["anges", "course", "rapidité"],
  emotion: "Mystère, vitesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "As-Sabiq"],
  mirrorVersion: `« Et par celles qui devancent en courant. » Le miroir me montre la course des anges. Ils devancent, ils courent vers l'accomplissement des ordres divins. La rapidité de l'obéissance. Le miroir m'enseigne : l'obéissance à Allah doit être rapide.`,
  reflection: `Les anges devancent en courant. La rapidité dans l'obéissance est vertu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-sabiqati sabqan » — et par celles qui devancent en courant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je devance dans l'obéissance ? Ou est-ce que je traîne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rapidité dans le bien est un signe de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers exécute les ordres d'Allah sans délai." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui devance dans le bien reçoit les meilleures récompenses." }
  ],
  munajat: `Ya Rabb, je veux devancer dans l'obéissance. Ne permets pas que je traîne. Donne-moi la rapidité des anges.`
};

MIROIR["79:5"] = {
  reference: "79:5",
  theme: ["anges", "affaires", "gestion"],
  emotion: "Mystère, organisation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malak", "Al-Mudabbir"],
  mirrorVersion: `« Et par celles qui gèrent les affaires. » Le miroir me montre la gestion divine par les anges. Ils administrent l'univers sur ordre d'Allah. L'organisation parfaite. Le miroir m'enseigne : tout est géré par les anges sous le commandement d'Allah.`,
  reflection: `Les anges gèrent les affaires. L'univers est parfaitement organisé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa al-mudabbirati amran » — et par celles qui gèrent les affaires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je gère mes affaires selon l'ordre d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gestion selon Allah mène à l'harmonie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est géré parfaitement par les anges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui gère selon l'ordre d'Allah réussit." }
  ],
  munajat: `Ya Rabb, je veux gérer mes affaires selon Ton ordre. Donne-moi la sagesse de la gestion divine. Organise ma vie selon Ta volonté.`
};

MIROIR["79:6"] = {
  reference: "79:6",
  theme: ["tremblement", "jour", "terre"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rajifah", "Al-Qari'a"],
  mirrorVersion: `« Le jour où le premier souffle fera trembler la terre. » Le miroir me montre le premier signe de la fin. La terre tremble sous le premier souffle. Le chaos commence. Le miroir m'avertit : ce jour est réel.`,
  reflection: `Le premier souffle fait trembler la terre. La fin commence avec un tremblement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tarjufu al-rajifah » — le jour où le premier souffle fera trembler la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre tremblera. Est-ce que je suis prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tremblement extérieur révèle le tremblement intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre stable maintenant tremblera alors." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est stable dans la foi ne tremble pas." }
  ],
  munajat: `Ya Rabb, la terre tremblera. Stabilise-moi dans la foi. Ne permets pas que je tremble comme la terre.`
};

MIROIR["79:7"] = {
  reference: "79:7",
  theme: ["suite", "tremblement", "coeur"],
  emotion: "Terreur, succession",
  difficulty: "débutant",
  relatedNames: ["Ar-Radifah", "Al-Qalb"],
  mirrorVersion: `« Suivra de près le second. » Le miroir me montre la succession des événements terrifiants. Le premier tremblement est suivi du second. Les cœurs sont bouleversés. Le miroir m'avertit : les épreuves se succèdent.`,
  reflection: `Le second tremblement suit le premier. Les épreuves se succèdent sans répit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tatba'uha al-radifah » — suivra de près le second." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les épreuves se succèdent. Comment serai-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La succession des épreuves révèle la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les événements de la fin se succèdent rapidement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste ferme dans la foi résiste à la succession." }
  ],
  munajat: `Ya Rabb, les épreuves se succèdent. Donne-moi la fermeté dans la foi. Ne permets pas que je succombe à la succession.`
};

MIROIR["79:8"] = {
  reference: "79:8",
  theme: ["coeur", "peur", "jour"],
  emotion: "Terreur, angoisse",
  difficulty: "débutant",
  relatedNames: ["Al-Qulub", "Al-Khawf"],
  mirrorVersion: `« Ce jour-là, les cœurs seront terrifiés. » Le miroir me montre la terreur intérieure. Les cœurs, pas les corps, sont terrifiés. La peur est profonde. Le miroir m'avertit : ce jour-là, même les forts auront peur.`,
  reflection: `Les cœurs terrifiés. La peur pénètre au plus profond.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulubun yawma-idhin wajilah » — ce jour-là, les cœurs seront terrifiés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur sera-t-il terrifié ? Ou sera-t-il apaisé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La terreur des cœurs ce jour-là dépend de leur état maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les cœurs seront concernés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apaise son cœur maintenant sera apaisé ce jour-là." }
  ],
  munajat: `Ya Rabb, apaise mon cœur. Ne permets pas qu'il soit terrifié ce jour-là. Donne-moi la paix intérieure maintenant.`
};

MIROIR["79:9"] = {
  reference: "79:9",
  theme: ["regard", "humiliation", "abaissement"],
  emotion: "Honte, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Absar", "Al-Khashi'"],
  mirrorVersion: `« Leurs regards seront abaissés. » Le miroir me montre l'humiliation. Les regards baissés par honte et peur. L'abaissement total. Le miroir m'avertit : ce jour-là, l'orgueil disparaît.`,
  reflection: `Les regards abaissés. L'humiliation remplace l'orgueil.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Absaruhum khashi'ah » — leurs regards seront abaissés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon regard sera-t-il abaissé par honte ? Ou levé par fierté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abaissement du regard maintenant par humilité évite l'abaissement forcé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les regards seront abaissés ce jour-là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'abaisse maintenant par humilité sera élevé ce jour-là." }
  ],
  munajat: `Ya Rabb, je m'abaisse par humilité. Ne permets pas que je sois abaissé par honte. Élève-moi par mon humilité.`
};

MIROIR["79:10"] = {
  reference: "79:10",
  theme: ["négation", "retour", "incrédulité"],
  emotion: "Sarcasme, déni",
  difficulty: "débutant",
  relatedNames: ["Al-Kafirun", "Ar-Rujū'"],
  mirrorVersion: `« Ils disent : Serons-nous ramenés à notre état premier ? » Le miroir me montre l'incrédulité des négateurs. Ils nient la résurrection. Le sarcasme remplace la foi. Le miroir m'avertit : nier la résurrection est le comble de l'égarement.`,
  reflection: `Les négateurs nient le retour. Leur incrédulité les perd.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaquluna a-inna la-marduduna fi al-hafirah » — ils disent : Serons-nous ramenés à notre état premier ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois au retour ? Ou est-ce que je doute comme eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi au retour change la vie maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour est certain, même si les négateurs nient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au retour se prépare." }
  ],
  munajat: `Ya Rabb, je crois au retour. Ne permets pas que je nie comme les négateurs. Prépare-moi pour le retour.`
};

MIROIR["79:11"] = {
  reference: "79:11",
  theme: ["négation", "décomposition", "impossibilité"],
  emotion: "Sarcasme, déni",
  difficulty: "débutant",
  relatedNames: ["Al-'Izam", "An-Nakir"],
  mirrorVersion: `« Quand nous serons des ossements pourris ? » Le miroir me montre l'argument des négateurs. Les ossements pourris ne peuvent pas revivre selon eux. L'incrédulité basée sur l'apparence. Le miroir m'enseigne : Allah peut tout ressusciter.`,
  reflection: `Les ossements pourris peuvent revivre par la puissance d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-idha kunna 'izaman nakirah » — quand nous serons des ossements pourris ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute de la résurrection ? Ou est-ce que je crois en la puissance d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La décomposition n'est pas un obstacle pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah a créé de rien, Il peut ressusciter de tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la puissance d'Allah n'a pas de doute." }
  ],
  munajat: `Ya Rabb, je crois en Ta puissance. Tu peux ressusciter de tout. Ne permets pas que je doute.`
};

MIROIR["79:12"] = {
  reference: "79:12",
  theme: ["négation", "perte", "désespoir"],
  emotion: "Sarcasme, déni",
  difficulty: "débutant",
  relatedNames: ["Al-Khasarah", "An-Nakir"],
  mirrorVersion: `« Ce serait alors un retour ruineux. » Le miroir me montre la conclusion des négateurs. Selon eux, le retour serait une perte. L'incrédulité totale. Le miroir m'enseigne : le retour est un gain pour les croyants, une perte pour les négateurs.`,
  reflection: `Le retour est ruineux pour les négateurs, profitable pour les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka idhan karratun khasirah » — ce serait alors un retour ruineux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon retour sera-t-il ruineux ou profitable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi fait du retour un gain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour est certain. La question est profitable ou ruineux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi a un retour profitable." }
  ],
  munajat: `Ya Rabb, je veux un retour profitable. Donne-moi la foi qui transforme le retour en gain. Ne permets pas que mon retour soit ruineux.`
};

MIROIR["79:13"] = {
  reference: "79:13",
  theme: ["cri", "unique", "simplicité"],
  emotion: "Réalité, soudaineté",
  difficulty: "débutant",
  relatedNames: ["As-Sayha", "Al-Wahidah"],
  mirrorVersion: `« Il n'y aura qu'un seul cri. » Le miroir me montre la simplicité de la résurrection. Un seul cri suffit. Pas de complication. La puissance divine est simple. Le miroir m'enseigne : la résurrection est facile pour Allah.`,
  reflection: `Un seul cri suffit pour la résurrection. La puissance d'Allah est simple et absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-innama hiya zajratun wahidah » — il n'y aura qu'un seul cri." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La résurrection est proche. Un cri suffit. Suis-je prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La simplicité du cri cache la complexité de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répondra au cri instantanément." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt n'a pas peur du cri." }
  ],
  munajat: `Ya Rabb, le cri est proche. Prépare-moi pour ce moment. Ne permets pas que je sois surpris par le cri.`
};

MIROIR["79:14"] = {
  reference: "79:14",
  theme: ["surface", "éveil", "résurrection"],
  emotion: "Stupeur, soudaineté",
  difficulty: "débutant",
  relatedNames: ["As-Sah", "An-Nushur"],
  mirrorVersion: `« Et voilà qu'ils seront à la surface de la terre. » Le miroir me montre le résultat du cri. Tous sont ressuscités, à la surface. L'éveil est immédiat. Le miroir m'enseigne : la résurrection est instantanée.`,
  reflection: `Tous sont à la surface après le cri. La résurrection est immédiate.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha hum bi al-sahir » — et voilà qu'ils seront à la surface de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Je serai à la surface. Comment serai-je ressuscité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La surface de la terre révèle ce qui était caché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains seront ressuscités ensemble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est ressuscité en croyant est béni." }
  ],
  munajat: `Ya Rabb, ressuscite-moi en croyant. Fais que je sois parmi les ressuscités honorés. Ne permets pas que je sois parmi les perdants.`
};

MIROIR["79:15"] = {
  reference: "79:15",
  theme: ["histoire", "Moïse", "rappel"],
  emotion: "Méditation, leçon",
  difficulty: "débutant",
  relatedNames: ["Musa", "At-Tadhkirah"],
  mirrorVersion: `« T'est-il parvenu le récit de Moïse ? » Le miroir me montre l'histoire comme enseignement. L'histoire de Moïse est une leçon. Le récit est arrivé au Prophète. Le miroir m'enseigne : les histoires des prophètes sont des leçons pour nous.`,
  reflection: `L'histoire de Moïse est une leçon. Les récits prophétiques sont des enseignements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal ataka hadithu Musa » — t'est-il parvenu le récit de Moïse ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends de l'histoire de Moïse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire de Moïse n'est pas du passé, elle est actuelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les histoires des prophètes sont universelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des histoires des prophètes se rapproche d'Allah." }
  ],
  munajat: `Ya Rabb, enseigne-moi par les histoires des prophètes. Fais que je tire des leçons de l'histoire de Moïse. Rapproche-moi de Toi par le savoir.`
};

MIROIR["79:16"] = {
  reference: "79:16",
  theme: ["Moïse", "vallée", "sacré"],
  emotion: "Mystère, vénération",
  difficulty: "débutant",
  relatedNames: ["Musa", "Tuwa"],
  mirrorVersion: `« Quand son Seigneur l'appela dans la vallée bénie de Tuwa. » Le miroir me montre l'appel divin. Moïse est appelé dans un lieu sacré. La vallée bénie. Le miroir m'enseigne : Allah appelle Ses prophètes dans des lieux bénis.`,
  reflection: `La vallée de Tuwa est bénie. L'appel divin se fait dans la bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha nadahu rabbuhu bi al-wadi al-muqaddasi Tuwa » — quand son Seigneur l'appela dans la vallée bénie de Tuwa." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où m'appelle Allah ? Quel est mon lieu béni ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel d'Allah sanctifie le lieu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les lieux bénis sont partout où Allah est invoqué." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à l'appel d'Allah entre dans la bénédiction." }
  ],
  munajat: `Ya Rabb, appelle-moi dans Ton lieu béni. Sanctifie ma vie par Ton appel. Fais que je réponde à Ton appel comme Moïse.`
};

MIROIR["79:17"] = {
  reference: "79:17",
  theme: ["Moïse", "Pharaon", "mission"],
  emotion: "Courage, mission",
  difficulty: "débutant",
  relatedNames: ["Musa", "Fir'awn"],
  mirrorVersion: `« Va vers Pharaon, il s'est rebellé. » Le miroir me montre la mission difficile. Moïse doit affronter le plus grand tyran. La rébellion de Pharaon. Le miroir m'enseigne : la vérité doit être transmise même aux rebelles.`,
  reflection: `La mission de Moïse : affronter Pharaon. La vérité ne craint pas les tyrans.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idhhab ila Fir'awna innahu tagha » — va vers Pharaon, il s'est rebellé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma mission ? Qui dois-je affronter pour la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mission difficile est la plus noble." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours des tyrans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mission difficile reçoit l'aide divine." }
  ],
  munajat: `Ya Rabb, donne-moi le courage de Ta mission. Aide-moi à affronter les obstacles. Ne permets pas que je fuie devant la difficulté.`
};

MIROIR["79:18"] = {
  reference: "79:18",
  theme: ["Moïse", "Pharaon", "purification"],
  emotion: "Espoir, guidance",
  difficulty: "débutant",
  relatedNames: ["Musa", "Tazkiyah"],
  mirrorVersion: `« Dis-lui : Voudrais-tu te purifier ? » Le miroir me montre l'invitation à la purification. Moïse offre à Pharaon la purification. L'offre est ouverte. Le miroir m'enseigne : même le pire tyran peut se purifier.`,
  reflection: `La purification est offerte à tous. Même Pharaon peut se purifier.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-qul hal laka ila an tazakka » — dis-lui : Voudrais-tu te purifier ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux me purifier ? Ou est-ce que je refuse comme Pharaon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'offre de purification est toujours ouverte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La purification est le chemin vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la purification se rapproche d'Allah." }
  ],
  munajat: `Ya Rabb, je veux me purifier. Accepte ma purification. Ne permets pas que je refuse comme Pharaon.`
};

MIROIR["79:19"] = {
  reference: "79:19",
  theme: ["Moïse", "guidance", "chemin"],
  emotion: "Espoir, direction",
  difficulty: "débutant",
  relatedNames: ["Musa", "Al-Huda"],
  mirrorVersion: `« Et que je te guide vers ton Seigneur pour que tu Le craignes. » Le miroir me montre le but de la guidance. La guidance mène à la crainte d'Allah. Le chemin vers le Seigneur. Le miroir m'enseigne : la guidance a un but précis.`,
  reflection: `La guidance mène à la crainte d'Allah. Le chemin est clair.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ahdiyaka ila rabbika fa takhsha » — et que je te guide vers ton Seigneur pour que tu Le craignes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux être guidé vers la crainte d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance sans la crainte est incomplète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte d'Allah est le sommet de la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est guidé vers la crainte d'Allah atteint le but." }
  ],
  munajat: `Ya Rabb, guide-moi vers Toi. Fais que je Te craigne. Ne permets pas que je m'égare du chemin.`
};

MIROIR["79:20"] = {
  reference: "79:20",
  theme: ["Moïse", "signe", "grandeur"],
  emotion: "Émerveillement, certitude",
  difficulty: "débutant",
  relatedNames: ["Musa", "Al-Ayah"],
  mirrorVersion: `« Il lui montra le grand signe. » Le miroir me montre la démonstration divine. Moïse montre le grand signe à Pharaon. La preuve est manifeste. Le miroir m'enseigne : Allah donne des signes évidents.`,
  reflection: `Le grand signe est montré. La preuve est évidente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-arahu al-ayata al-kubra » — il lui montra le grand signe." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes Allah me montre-t-Il ? Comment j'y réagis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe grand est montré même à ceux qui refusent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de signes divins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes reconnaît le Signateur." }
  ],
  munajat: `Ya Rabb, montre-moi Tes signes. Fais que je les reconnaisse. Ne permets pas que je sois aveugle devant Tes signes.`
};

MIROIR["79:21"] = {
  reference: "79:21",
  theme: ["Pharaon", "négation", "désobéissance"],
  emotion: "Tristesse, rejet",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "Al-Kufr"],
  mirrorVersion: `« Mais il nia et désobéit. » Le miroir me montre le rejet obstiné. Pharaon voit le signe mais nie et désobéit. L'aveuglement volontaire. Le miroir m'avertit : voir les signes ne suffit pas sans la foi.`,
  reflection: `Pharaon nie et désobéit malgré le signe. L'aveuglement est volontaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kadhdhaba wa 'asa » — mais il nia et désobéit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nie et désobéis ? Ou est-ce que je crois et obéis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi et l'obéissance vont ensemble." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La négation malgré les signes est l'égarement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit et obéit est sur le droit chemin." }
  ],
  munajat: `Ya Rabb, je crois et j'obéis. Ne permets pas que je nie et désobéisse comme Pharaon. Guide-moi sur le droit chemin.`
};

MIROIR["79:22"] = {
  reference: "79:22",
  theme: ["Pharaon", "rejet", "opposition"],
  emotion: "Hostilité, rejet",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "At-Tawalla"],
  mirrorVersion: `« Puis il tourna le dos et s'en alla. » Le miroir me montre le rejet total. Pharaon tourne le dos et part. Le rejet est complet. Le miroir m'avertit : le rejet de la vérité est une perte.`,
  reflection: `Pharaon tourne le dos et s'en va. Le rejet de la vérité est total.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma adbara yas'a » — puis il tourna le dos et s'en alla." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tourne le dos à la vérité ? Ou est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la vérité est le gain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tourner le dos à la vérité est une perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité gagne tout." }
  ],
  munajat: `Ya Rabb, j'accepte la vérité. Ne permets pas que je tourne le dos comme Pharaon. Donne-moi l'acceptation de la vérité.`
};

MIROIR["79:23"] = {
  reference: "79:23",
  theme: ["Pharaon", "rassemblement", "appel"],
  emotion: "Orgueil, défiance",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "Al-Hashr"],
  mirrorVersion: `« Il rassembla les gens et leur cria. » Le miroir me montre l'appel à l'opposition. Pharaon rassemble son peuple contre Moïse. La mobilisation contre la vérité. Le miroir m'avertit : rassembler contre la vérité est un crime.`,
  reflection: `Pharaon rassemble contre la vérité. L'opposition organisée est dangereuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-hashara fa nadha » — il rassembla les gens et leur cria." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rassemble pour la vérité ou contre elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement pour la vérité est béni." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rassembler contre la vérité est une perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rassemble pour la vérité gagne." }
  ],
  munajat: `Ya Rabb, je rassemble pour la vérité. Ne permets pas que je rassemble contre elle. Donne-moi le rassemblement béni.`
};

MIROIR["79:24"] = {
  reference: "79:24",
  theme: ["Pharaon", "divinité", "orgueil"],
  emotion: "Orgueil, blasphème",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "Al-Uluhiyyah"],
  mirrorVersion: `« Il dit : Je suis votre seigneur, le très-haut. » Le miroir me montre l'apogée de l'orgueil. Pharaon se dédie dieu. Le blasphème ultime. Le miroir m'avertit : s'attribuer la divinité est le comble de l'égarement.`,
  reflection: `Pharaon se proclame dieu. L'orgueil atteint son sommet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-qala ana rabbukum al-a'la » — il dit : Je suis votre seigneur, le très-haut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'attribue ce qui appartient à Allah ? Ou est-ce que je me soumets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soumission à Allah est la vraie grandeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil contre Allah est la perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet à Allah est élevé." }
  ],
  munajat: `Ya Rabb, je me soumets à Toi. Ne permets pas que je m'attribue ce qui T'appartient. Donne-moi l'humilité de la soumission.`
};

MIROIR["79:25"] = {
