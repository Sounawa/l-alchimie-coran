  difficulty: "débutant",
  relatedNames: ["Al-Jund", "Al-Ahzab"],
  mirrorVersion: `« Une armée des coalisés sera mise en déroute. » Le miroir me montre la défaite certaine. « Jundun mina al-ahzabi mahzum » — une armée des coalisés sera mise en déroute. La défaite. Le miroir m'enseigne : les coalitions contre la vérité seront vaincues.`,
  reflection: `Les coalitions contre la vérité seront vaincues. La vérité triomphe toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jundun mina al-ahzabi mahzum » — une armée des coalisés sera mise en déroute." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de la coalition pour la vérité ? Ou contre elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La coalition pour la vérité triomphe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est la coalition pour la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejoint la coalition pour la vérité triomphe." }
  ],
  munajat: `Ya Rabb, je rejoins la coalition pour la vérité. Ne permets pas que je sois vaincu avec les coalitions contre la vérité. Donne-moi la victoire.`
};

MIROIR["38:12"] = {
  reference: "38:12",
  theme: ["précédents", "prophètes", "négation"],
  emotion: "Mise en garde, leçon",
  difficulty: "débutant",
  relatedNames: ["An-Nuh", "Hud", "Salih"],
  mirrorVersion: `« Avant eux, le peuple de Noé, les 'Ad et Pharaon ont crié au mensonge. » Le miroir me montre les précédents. « Kadhdhabat qablahum qawmu Nuhin wa 'Adun wa Fir'awnu dhu al-awtad » — avant eux, le peuple de Noé, les 'Ad et Pharaon ont crié au mensonge. L'histoire. Le miroir m'avertit : les précédents ont menti.`,
  reflection: `Les peuples précédents ont nié les prophètes. Leur sort est connu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat qablahum qawmu Nuhin wa 'Adun wa Fir'awnu dhu al-awtad » — avant eux, le peuple de Noé, les 'Ad et Pharaon ont crié au mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nie comme les précédents ? Ou est-ce que je crois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite le sort des précédents." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas nié son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit évite le sort des négateurs." }
  ],
  munajat: `Ya Rabb, je crois en Tes prophètes. Ne permets pas que je nie comme les précédents. Sauve-moi de leur sort.`
};

