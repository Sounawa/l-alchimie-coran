    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui boit de cette eau n'a plus jamais soif." }
  ],
  munajat: `Ya Mu'dhib, Tu offres des sources qui coulent. Donne-moi d'y boire. Étanche ma soif éternelle.`
};

