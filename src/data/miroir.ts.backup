    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'aborde le Livre ? Avec humilité pour le mystère et confiance pour la clarté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mystère et la clarté sont les deux faces du même don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est mystère pour le contemplatif et clarté pour le chercheur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les deux reçoit la plénitude du Livre." }
  ],
  munajat: `Ya Mubin, Ton Livre est mystère et clarté. Fais que je l'approche avec les deux attitudes. Ouvre-moi à Sa compréhension.`
};

MIROIR["28:5"] = {
  reference: "28:5",
  theme: ["oppression", "justice", "promesse"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Mu'izz"],
  mirrorVersion: `« Nous voulions favoriser ceux qui avaient été humiliés sur terre et en faire des dirigeants. » Le miroir me montre la promesse d'Allah pour les opprimés. « Wa nuridu an namunna 'ala alladhina istud'ifu fi al-ardi » — Nous voulions favoriser ceux qui avaient été humiliés sur terre. « Wa naj'alahum a'immatan » — et en faire des dirigeants. L'humiliation actuelle n'est pas le destin final. Le miroir m'invite à faire confiance à la promesse divine pour les opprimés.`,
  reflection: `L'oppression n'est pas le dernier mot. Allah élève ceux qui sont abaissés injustement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nuridu an namunna 'ala alladhina istud'ifu fi al-ardi wa naj'alahum a'immatan » — Nous voulions favoriser les humiliés sur terre et en faire des dirigeants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je opprimé ? Fais-je confiance à la promesse d'Allah ? Suis-je oppresseur ? Vais-je changer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation des opprimés n'est pas vengeance — c'est justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rétablit l'équilibre. Les opprimés seront élevés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est opprimé avec patience recevra une élévation éternelle." }
  ],
  munajat: `Ya Nasir, Tu élèves les opprimés. Si je suis opprimé, donne-moi patience. Si je suis oppresseur, donne-moi repentir. Rétablis la justice.`
};

MIROIR["28:56"] = {
  reference: "28:56",
  theme: ["guidance", "amour", "indépendance"],
  emotion: "Humilité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Muhibb"],
  mirrorVersion: `« Tu ne guides pas celui que tu aimes, mais c'est Allah qui guide qui Il veut. » Le miroir me montre la limite de mon influence. « Innaka la tahdi man ahbabta » — tu ne guides pas celui que tu aimes. « Wa lakinna Allaha yahdi man yasha' » — mais c'est Allah qui guide qui Il veut. L'amour ne suffit pas pour guider. La guidance est un don divin. Le miroir m'invite à faire confiance à Allah pour la guidance de ceux que j'aime.`,
  reflection: `On ne peut pas forcer la guidance. On peut aimer, prier, et faire confiance à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka la tahdi man ahbabta wa lakinna Allaha yahdi man yasha' » — tu ne guides pas celui que tu aimes, mais c'est Allah qui guide qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui j'aimerais guider ? Est-ce que j'accepte que la guidance est entre les mains d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance à guider n'est pas un échec — c'est une reconnaissance de la souveraineté divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est un mystère divin. Personne ne peut la donner à la place d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah pour la guidance de ses proches trouve la paix." }
  ],
  munajat: `Ya Hadi, je ne peux pas guider ceux que j'aime. Mais Toi, Tu guides qui Tu veux. Guide mes proches. Fais-moi confiance en Ta sagesse.`
};

MIROIR["28:77"] = {
  reference: "28:77",
  theme: ["monde", "au-delà", "équilibre"],
  emotion: "Sagesse, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Hasanah", "Al-Akhirah"],
  mirrorVersion: `« Recherche ce qu'Allah t'a donné comme demeure future, mais n'oublie pas ta part de ce monde. » Le miroir me montre l'équilibre entre les deux mondes. « Ibtaghi ma ataka Allahu al-dara al-akhirah » — recherche ce qu'Allah t'a donné comme demeure future. « Wa la tansa naseebaka min al-dunya » — mais n'oublie pas ta part de ce monde. L'au-delà est la priorité, mais ce monde a aussi sa part. Le miroir m'invite à cet équilibre.`,
  reflection: `L'au-delà est le but, mais ce monde est le moyen. Il faut vivre pour l'un sans négliger l'autre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ibtaghi ma ataka Allahu al-dara al-akhirah wa la tansa naseebaka min al-dunya » — recherche ce qu'Allah t'a donné comme demeure future, mais n'oublie pas ta part de ce monde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je balance les deux mondes ? Est-ce que je néglige l'un pour l'autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équilibre n'est pas compromis — c'est sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait pour servir l'au-delà, pas pour être adoré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve l'équilibre entre les deux mondes réussit dans les deux." }
  ],
  munajat: `Ya Rabb, donne-moi l'équilibre. Fais que je recherche l'au-delà tout en prenant ma part de ce monde. Ne permets pas que je néglige l'un ou l'autre.`
};

MIROIR["28:88"] = {
  reference: "28:88",
  theme: ["adoration", "éternité", "unicité"],
  emotion: "Révérence, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Wahid"],
  mirrorVersion: `« N'invoque pas une autre divinité avec Allah. Point de divinité à part Lui. Tout périra sauf Sa Face. » Le miroir conclut par l'unicité. « Wa la tad'u ma'a Allahi ilahan akhar » — n'invoque pas une autre divinité avec Allah. « La ilaha illa huwa » — point de divinité à part Lui. « Kullu shay'in halikun illa wajhahu » — tout périra sauf Sa Face. Tout passe, Lui reste. Le miroir m'invite à m'attacher à Ce qui ne passe pas.`,
  reflection: `Tout dans ce monde passera. Seul Allah demeure. S'attacher à Lui, c'est s'attacher à l'éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tad'u ma'a Allahi ilahan akhar la ilaha illa huwa kullu shay'in halikun illa wajhahu » — n'invoque pas d'autre divinité, point de dieu que Lui, tout périra sauf Sa Face." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je m'attache ? À ce qui passera ou à Ce qui reste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La disparition de tout n'est pas une tragédie — c'est une révélation de Ce qui compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier passera. Seul le Créateur demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache à Allah s'attache à l'éternel." }
  ],
  munajat: `Ya Baqi, tout passera sauf Toi. Fais que je m'attache à Toi seul. Ne permets pas que je perde mon temps avec ce qui disparaîtra.`
};

// ============================================
// SURAHS 52-56 - COMPLETE MIROIR COVERAGE
// Task ID: surahs52-56
// ============================================

// === SURAH 52 - AT-TUR (The Mount) - 49 verses ===
// Existing: 52:1, 52:21, 52:48
// Adding: 52:2-20, 52:22-47, 52:49

MIROIR["52:2"] = {
  reference: "52:2",
  theme: ["révélation", "écriture", "matériel"],
  emotion: "Révérence, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Hakim"],
  mirrorVersion: `« Par le Livre écrit sur un parchemin déployé ! » Le miroir me place devant la matérialité de la révélation. Le Coran n'est pas qu'une idée spirituelle — c'est un livre physique, écrit, déployé. Allah jure par ce Livre concret. Le miroir m'interroge : comment je traite ce Livre ? Est-ce que je le lis comme un texte ordinaire ou comme le serment divin lui-même ?`,
  reflection: `Le Coran est à la fois esprit et lettre. Sa matérialité est sacrée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kitabin masturin » — par le Livre écrit sur un parchemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite le Coran matériel ? Avec respect ou négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le livre matériel pointe vers la réalité spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'écriture est un don divin qui préserve la parole à travers le temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore le Livre matériel honore la Parole éternelle." }
  ],
  munajat: `Ya Rabb, fais que je honore Ton Livre dans sa forme et dans son sens. Ne permets pas que je le traite légèrement.`
};

MIROIR["52:3"] = {
  reference: "52:3",
  theme: ["révélation", "écriture", "préservation"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Muhaymin"],
  mirrorVersion: `« Sur un parchemin déployé ! » Le miroir me montre l'ouverture du Livre. « Fi raqqin manshur » — sur un parchemin déployé. Le Livre n'est pas caché, il est ouvert, accessible. Le miroir m'invite à accéder à cette ouverture divine.`,
  reflection: `La révélation est déployée pour nous. Elle n'est pas cachée aux chercheurs sincères.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi raqqin manshur » — sur un parchemin déployé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'approche le Livre déployé ? Ou est-ce que je reste à distance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le parchemin déployé attend celui qui veut lire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est comme un parchemin où se lit la parole divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Livre déployé lit les secrets de l'existence." }
  ],
  munajat: `Ya Muhaymin, Ton Livre est ouvert pour moi. Fais que je l'approche avec sincérité et que j'y trouve la guidance.`
};

MIROIR["52:4"] = {
  reference: "52:4",
  theme: ["maison", "sacré", "adoration"],
  emotion: "Révérence, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Bayt", "Al-Ma'mur"],
  mirrorVersion: `« Par la Maison fréquentée ! » Le miroir me place devant la Maison sacrée. « Wa al-bayti al-ma'mur » — par la Maison fréquentée. La Kaaba est le centre spirituel, le point de convergence. Le miroir m'interroge : où est mon centre ? Vers quoi je converge ?`,
  reflection: `La Maison fréquentée est le point de rassemblement de tous les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-bayti al-ma'mur » — par la Maison fréquentée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le centre de ma vie ? Est-ce que je fréquente la Maison d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La Maison physique pointe vers la maison du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa qibla, sa direction vers le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fréquente la Maison d'Allah trouve sa propre maison." }
  ],
  munajat: `Ya Rabb, fais que Ta Maison soit le centre de ma vie. Fais que je fréquente Ta maison avec amour et constance.`
};

MIROIR["52:5"] = {
  reference: "52:5",
  theme: ["création", "ciel", "élévation"],
  emotion: "Émerveillement, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Aliyy", "Al-Kabir"],
  mirrorVersion: `« Par le toit surélevé ! » Le miroir lève mon regard vers le ciel. « Wa al-saqfi al-marfu'i » — par le toit surélevé. Le ciel est comme un toit au-dessus de nous. Le miroir m'invite à contempler l'élévation et à chercher ce qui est élevé.`,
  reflection: `Le ciel nous rappelle la grandeur du Créateur. Lever les yeux, c'est élever l'âme.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-saqfi al-marfu'i » — par le toit surélevé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lève les yeux vers le ciel ? Ou est-ce que je reste les yeux fixés sur le bas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le toit élevé protège et inspire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel couvre toute la terre, comme la miséricorde couvre toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple le ciel élevé élève son âme." }
  ],
  munajat: `Ya Aliyy, Tu es le Très-Haut. Fais que je lève mon regard vers Toi et que je cherche l'élévation de mon âme.`
};

MIROIR["52:6"] = {
  reference: "52:6",
  theme: ["création", "mer", "puissance"],
  emotion: "Émerveillement, respect",
  difficulty: "débutant",
  relatedNames: ["Al-Qawiyy", "Al-Qadir"],
  mirrorVersion: `« Par la mer embrasée ! » Le miroir me place devant la mer en feu. « Wa al-bahri al-masjur » — par la mer embrasée. L'image est puissante : la mer en feu. Le miroir m'interroge sur ma capacité à reconnaître la puissance divine dans la nature.`,
  reflection: `La mer embrasée peut représenter l'enfer ou les mystères de la création. La nature révèle la puissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-bahri al-masjur » — par la mer embrasée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que la nature me révèle d'Allah ? Est-ce que je contemple Ses signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mer qui peut embraser contient la puissance du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les océans couvrent la majeure partie de la terre, témoins de la grandeur divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la mer embrasée comprend le pouvoir du Feu." }
  ],
  munajat: `Ya Qawiyy, Tu es le Puissant. Fais que je contemple Tes signes dans la nature avec humilité et émerveillement.`
};

MIROIR["52:7"] = {
  reference: "52:7",
  theme: ["jugement", "certitude", "châtiment"],
  emotion: "Sérieux, préparation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Qahhar"],
  mirrorVersion: `« Le châtiment de ton Seigneur aura lieu inévitablement. » Le miroir me confronte à la certitude du jugement. « Inna 'adhaba rabbika la-waqi'un » — le châtiment de ton Seigneur aura lieu. Il n'y a pas d'échappatoire. Le miroir m'invite à la préparation.`,
  reflection: `Le châtiment est certain pour les injustes. La préparation est urgente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna 'adhaba rabbika la-waqi'un » — le châtiment de ton Seigneur aura lieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience du jugement ? Ou est-ce que je me complais dans l'insouciance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude du châtiment n'est pas que menace — c'est appel à la repentance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est régi par des lois. La justice est une de ces lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment le fuit par le repentir." }
  ],
  munajat: `Ya Hakam, Ton jugement est certain. Fais que je me prépare avec crainte et repentir. Épargne-moi Ton châtiment.`
};

MIROIR["52:8"] = {
  reference: "52:8",
  theme: ["jugement", "inévitabilité", "préparation"],
  emotion: "Urgence, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Nul ne pourra le repousser. » Le miroir me montre l'impuissance humaine face au décret divin. « Ma lahu min dafi'in » — nul ne pourra le repousser. Quand Allah décide, nul ne peut s'opposer. Le miroir m'invite à la soumission avant l'inévitable.`,
  reflection: `Le décret divin est inarrêtable. La sagesse est de s'y soumettre avant qu'il ne soit trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lahu min dafi'in » — nul ne pourra le repousser." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense pouvoir fuir le décret d'Allah ? Ou est-ce que je me soumets maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité de fuir est une miséricorde pour celui qui se soumet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers se soumet au décret divin. L'homme a le choix de se soumettre de bon gré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet volontairement évite la soumission forcée." }
  ],
  munajat: `Ya Qadir, Ton décret est inarrêtable. Je me soumettrai maintenant, volontairement. Épargne-moi la soumission forcée du châtiment.`
};

MIROIR["52:9"] = {
  reference: "52:9",
  theme: ["jugement", "ciel", "tremblement"],
  emotion: "Crainte, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Jabbar"],
  mirrorVersion: `« Le jour où le ciel sera violemment ébranlé. » Le miroir me place au Jour du Jugement. « Yawma tamuru al-sama'u mawran » — le jour où le ciel sera violemment ébranlé. L'univers entier tremblera. Le miroir m'invite à imaginer ce jour et à me préparer.`,
  reflection: `Le ciel ébranlé montre que même les fondements de l'univers seront bouleversés au Jour du Jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tamuru al-sama'u mawran » — le jour où le ciel sera violemment ébranlé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je me prépare pour ce jour ? Est-ce que j'ai conscience de sa réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ébranlement du ciel est le signe de la nouvelle création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers stable maintenant sera bouleversé pour la nouvelle création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est établi sur le Rocher ne craint pas l'ébranlement." }
  ],
  munajat: `Ya Qahhar, le jour du tremblement vient. Établis-moi sur le Roc de la foi. Ne permets pas que je tremble avec les tremblants.`
};

MIROIR["52:10"] = {
  reference: "52:10",
  theme: ["jugement", "terre", "transformation"],
  emotion: "Humilité, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Matin", "Al-Bari"],
  mirrorVersion: `« Et les montagnes se mettront en mouvement. » Le miroir continue l'image du Jour. « Wa tasirru al-jibalu sayran » — et les montagnes se mettront en mouvement. Ce qui est stable sera mobile. Ce qui est solide sera mou. Le miroir m'interroge : sur quoi je m'appuie ?`,
  reflection: `Les montagnes, symboles de stabilité, seront mues. Rien ne reste sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tasirru al-jibalu sayran » — et les montagnes se mettront en mouvement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je m'appuie dans ma vie ? Sur des montagnes qui bougeront ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mouvement des montagnes révèle ce qui ne bouge pas : Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes sont les piliers de la terre, mais même elles seront ébranlées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'appuie sur l'Inébranlable ne craint pas le mouvement." }
  ],
  munajat: `Ya Matin, Tu es le Solide. Fais que je m'appuie sur Toi seul. Quand tout bougera, que je reste stable en Toi.`
};

MIROIR["52:11"] = {
  reference: "52:11",
  theme: ["malheur", "jugement", "regret"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khafid", "Ar-Rafi'"],
  mirrorVersion: `« Ce jour-là, malheur aux négateurs ! » Le miroir annonce le destin des négateurs. « Fawaylun yawma'idhin lil-mukadhdhibin » — ce jour-là, malheur aux négateurs. Le « wayl » est une expression de malheur intense. Le miroir m'avertit de ne pas être parmi eux.`,
  reflection: `Le malheur est le destin de ceux qui nient la vérité. La négation est un choix aux conséquences éternelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fawaylun yawma'idhin lil-mukadhdhibin » — ce jour-là, malheur aux négateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment ? Ou est-ce que je nie par mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur annoncé est évitable par la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La négation de la vérité a des conséquences cosmiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité avant le Jour échappe au malheur du Jour." }
  ],
  munajat: `Ya Rabb, je ne veux pas être parmi les négateurs. Confirme ma foi et protège-moi de la négation. Épargne-moi le wayl.`
};

MIROIR["52:12"] = {
  reference: "52:12",
  theme: ["frivolité", "jugement", "détournement"],
  emotion: "Mise en garde, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Ash-Shahid"],
  mirrorVersion: `« Ceux qui sont plongés dans la frivolité. » Le miroir me montre le portrait des perdants. « Alladhina hum fi khawdin yal'abun » — ceux qui sont plongés dans la frivolité. Le jeu, le divertissement, l'insouciance. Le miroir m'interroge : dans quoi je suis plongé ?`,
  reflection: `La frivolité est le contraire du sérieux spirituel. Être plongé dans le jeu, c'est oublier le réel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina hum fi khawdin yal'abun » — ceux qui sont plongés dans la frivolité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de temps je passe dans la frivolité ? Et combien dans le sérieux spirituel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jeu de ce monde est sérieux au Jour du Jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est sérieux dans son adoration. L'homme seul joue avec sa destinée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend la vie comme jeu perd le jeu éternel." }
  ],
  munajat: `Ya Rabb, fais que je ne sois pas plongé dans la frivolité. Éveille-moi au sérieux de l'existence. Ne permets pas que je joue avec ma destinée.`
};

MIROIR["52:13"] = {
  reference: "52:13",
  theme: ["jugement", "enfer", "poussée"],
  emotion: "Crainte, horreur",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Qahhar"],
  mirrorVersion: `« Le jour où ils seront rudoyés vers le feu de l'Enfer. » Le miroir me montre l'humiliation finale. « Yawma yuda'una ila nari jahannama d'an » — le jour où ils seront rudoyés vers le feu. La poussée est violente, l'humiliation totale. Le miroir m'avertit.`,
  reflection: `L'Enfer n'est pas une métaphore. C'est une réalité que le Coran décrit avec précision pour éveiller.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yuda'una ila nari jahannama d'an » — le jour où ils seront rudoyés vers le feu de l'Enfer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce jour ? Ou est-ce que je l'ai oublié ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poussée vers l'Enfer est le résultat d'une vie de choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer existe pour ceux qui choisissent de s'en approcher par leurs actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit l'Enfer maintenant ne sera pas poussé vers lui plus tard." }
  ],
  munajat: `Ya Rabb, épargne-moi la poussée vers le Feu. Fais que je Te craigne maintenant pour que je ne sois pas humilié plus tard.`
};

MIROIR["52:14"] = {
  reference: "52:14",
  theme: ["enfer", "réalité", "ironie"],
  emotion: "Désespoir, ironie",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« Voici le Feu que vous traitiez de mensonge ! » Le miroir me place face à l'ironie tragique. « Hadhiqu al-naru allati kuntum biha tukadhdhibun » — voici le Feu que vous traitiez de mensonge. La réalité les rattrape. Le miroir m'avertit : ce que je nie maintenant deviendra réalité.`,
  reflection: `Nier le Feu ne le fait pas disparaître. La réalité est ce qu'elle est, indépendamment de nos croyances.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadhiqu al-naru allati kuntum biha tukadhdhibun » — voici le Feu que vous traitiez de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je traite de mensonge maintenant ? Qu'est-ce qui me rattrapera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation du Feu ne l'éteint pas — elle alimente son injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité existe indépendamment de notre acceptation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la réalité du Feu maintenant l'évite plus tard." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je n'accepte que la vérité. Ne permets pas que je nie ce qui est réel.`
};

MIROIR["52:15"] = {
  reference: "52:15",
  theme: ["magie", "vision", "aveuglement"],
  emotion: "Confusion, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Hadi"],
  mirrorVersion: `« Est-ce de la magie ? Ou ne voyez-vous pas ? » Le miroir me confronte à l'aveuglement. « A sihrun hadha am antum la tubsirun » — est-ce de la magie ? Ou ne voyez-vous pas ? Les négateurs trouvent des excuses pour ne pas voir. Le miroir m'interroge : quelles excuses je trouve ?`,
  reflection: `L'aveuglement est souvent un choix. On ne voit pas ce qu'on ne veut pas voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A sihrun hadha am antum la tubsirun » — est-ce de la magie ? Ou ne voyez-vous pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse de voir ? Quelles excuses je trouve pour ne pas croire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie magie est celle qui ouvre les yeux, pas celle qui les ferme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Seuls les aveugles ne voient pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la vision la reçoit. Celui qui refuse reste aveugle." }
  ],
  munajat: `Ya Basir, Tu vois tout. Ouvre mes yeux à la vérité. Ne permets pas que je trouve des excuses pour ne pas voir.`
};

MIROIR["52:16"] = {
  reference: "52:16",
  theme: ["enfer", "endurance", "choix"],
  emotion: "Désespoir, ironie",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hakam"],
  mirrorVersion: `« Brûlez dedans ! Endurez ou n'endurez pas, ce sera égal pour vous. » Le miroir me montre l'inutilité de l'endurance en Enfer. « Aslaw faha fa sbiru aw la tasbiru sawa'un 'alaykum » — brûlez ! Endurez ou n'endurez pas, c'est égal. Le châtiment est éternel, l'endurance ne sert plus. Le miroir m'avertit : l'endurance doit être maintenant, pas après.`,
  reflection: `L'endurance des épreuves dans ce monde est méritoire. En Enfer, elle ne sert plus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aslaw faha fa sbiru aw la tasbiru sawa'un 'alaykum » — brûlez ! Endurez ou n'endurez pas, c'est égal." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'endure maintenant pour Allah ? Ou est-ce que je pense pouvoir endurer plus tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'endurance maintenant sauve de l'endurance inutile plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps de l'endurance utile est ce monde. L'au-delà est le temps des conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure maintenant pour Allah évite l'endurance inutile du Feu." }
  ],
  munajat: `Ya Rabb, fais que j'endure maintenant pour Toi. Ne permets pas que je connaisse l'endurance inutile du Feu.`
};

MIROIR["52:17"] = {
  reference: "52:17",
  theme: ["paradis", "récompense", "paix"],
  emotion: "Espoir, désir",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Karim"],
  mirrorVersion: `« Les pieux seront dans des Jardins et dans la félicité. » Le miroir me montre le contraste. « Inna al-muttaqina fi jannatin wa na'im » — les pieux seront dans des Jardins et dans la félicité. Pendant que les négateurs brûlent, les pieux jouissent. Le miroir m'invite à choisir mon camp.`,
  reflection: `Le Paradis est la récompense de la piété. Le contraste avec l'Enfer est saisissant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-muttaqina fi jannatin wa na'im » — les pieux seront dans des Jardins et dans la félicité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les pieux ? Quel est mon camp ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La félicité est la récompense de la peur d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait pour le paradis. L'enfer est l'exception." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant jouira plus tard." }
  ],
  munajat: `Ya Rahman, je veux être parmi les pieux. Donne-moi la taqwa et accorde-moi les Jardins de la félicité.`
};

MIROIR["52:18"] = {
  reference: "52:18",
  theme: ["paradis", "joie", "récompense"],
  emotion: "Joie, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Jamil"],
  mirrorVersion: `« Joyeux de ce que leur Seigneur leur a donné. » Le miroir me montre la joie des habitants du Paradis. « Farihina bima atahum rabbuhum » — joyeux de ce que leur Seigneur leur a donné. La joie est dans le don divin. Le miroir m'invite à anticiper cette joie.`,
  reflection: `La joie du Paradis est dans la reconnaissance du don divin. La gratitude y est naturelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Farihina bima atahem rabbuhum » — joyeux de ce que leur Seigneur leur a donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis joyeux maintenant des dons d'Allah ? Ou est-ce que je me plains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie anticipée du Paradis commence par la joie présente des dons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est don. La joie est la réponse appropriée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est joyeux maintenant des dons sera joyeux plus tard des dons éternels." }
  ],
  munajat: `Ya Mannan, fais que je sois joyeux de Tes dons. Ne permets pas que je me plaise. Prépare-moi à la joie éternelle.`
};

MIROIR["52:19"] = {
  reference: "52:19",
  theme: ["paradis", "nourriture", "boisson"],
  emotion: "Gratitude, contentement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Mangez et buvez agréablement, pour ce que vous faisiez. » Le miroir me montre la récompense concrète. « Kulu wa ishrabu han'i'an bima kuntum ta'malun » — mangez et buvez agréablement, pour ce que vous faisiez. Les œuvres passées nourrissent le présent éternel. Le miroir m'invite à semer maintenant pour récolter plus tard.`,
  reflection: `Les œuvres de ce monde sont les semences du Paradis. Ce qu'on fait maintenant, on le mange plus tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu wa ishrabu han'i'an bima kuntum ta'malun » — mangez et buvez agréablement, pour ce que vous faisiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je sème maintenant ? Qu'est-ce que je récolterai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture du Paradis est le fruit des œuvres de la terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute semence produit son fruit. Les œuvres bonnes produisent le Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sème maintenant mange plus tard." }
  ],
  munajat: `Ya Razzaq, fais que je sème de bonnes œuvres. Donne-moi de récolter au Paradis ce que je sème maintenant.`
};

MIROIR["52:20"] = {
  reference: "52:20",
  theme: ["paradis", "repos", "conjoints"],
  emotion: "Paix, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Karim"],
  mirrorVersion: `« Accoudés sur des lits rangés, et Nous les marierons à des houris aux grands yeux. » Le miroir me montre le repos du Paradis. « Muttaki'ina 'ala sururin masfufatin » — accoudés sur des lits rangés. « Wa zawwajnahum bi-hurin 'in » — et Nous les marierons à des houris. Le repos et l'amour. Le miroir m'invite à désirer cette récompense.`,
  reflection: `Le Paradis offre le repos parfait et les compagnies parfaites. Tout ce que le cœur désire y est satisfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Muttaki'ina 'ala sururin masfufatin wa zawwajnahum bi-hurin 'in » — accoudés sur des lits rangés, mariés à des houris aux grands yeux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le repos éternel ? Ou est-ce que je suis attaché aux plaisirs temporaires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repos du Paradis vient de l'effort de ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout être cherche le repos et l'amour. Le Paradis les offre parfaitement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille maintenant se repose éternellement plus tard." }
  ],
  munajat: `Ya Wadud, Tu offres le repos et l'amour. Fais que je travaille maintenant pour me reposer plus tard en Ta compagnie.`
};

MIROIR["52:22"] = {
  reference: "52:22",
  theme: ["paradis", "abondance", "gratitude"],
  emotion: "Contentement, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Wahhab"],
  mirrorVersion: `« Et Nous les pourvoirons de fruits et de viandes selon leur désir. » Le miroir me montre l'abondance du Paradis. « Wa ammadnahum bi-fakihatin wa lahmin mimma yashtahun » — Nous les pourvoirons de fruits et de viandes selon leur désir. Chaque désir est satisfait. Le miroir m'invite à contempler la générosité infinie d'Allah.`,
  reflection: `Au Paradis, le désir et sa satisfaction sont alignés. Plus de frustration, seulement la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ammadnahum bi-fakihatin wa lahmin mimma yashtahun » — Nous les pourvoirons de fruits et de viandes selon leur désir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon plus grand désir ? Est-ce que je l'oriente vers le Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction des désirs au Paradis vient de la maîtrise des désirs sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit avec effort. Le Paradis produit par le simple désir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maîtrise ses désirs maintenant les satisfera tous plus tard." }
  ],
  munajat: `Ya Wahhab, Tu donnes selon le désir au Paradis. Fais que je maîtrise mes désirs maintenant pour les satisfaire plus tard.`
};

MIROIR["52:23"] = {
  reference: "52:23",
  theme: ["paradis", "boisson", "paix"],
  emotion: "Sérénité, contentement",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mutakabbir"],
  mirrorVersion: `« Ils y échangeront des coupes où ne seront ni vanité ni péché. » Le miroir me montre la pureté des échanges au Paradis. « Yatanazawna fiha ka'san la laghwun fiha wa la ta'thim » — ils y échangeront des coupes où ne seront ni vanité ni péché. Les conversations sont pures. Le miroir m'invite à purifier mes conversations maintenant.`,
  reflection: `Au Paradis, les conversations sont exemptes de vanité et de péché. La parole y est pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatanazawna fiha ka'san la laghwun fiha wa la ta'thim » — ils y échangeront des coupes où ne seront ni vanité ni péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le contenu de mes conversations ? Vanité ? Péché ? Ou pureté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté des conversations au Paradis vient de la pureté des conversations sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole est un don divin. Son usage pur est un acte d'adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie sa parole maintenant purifiera son paradis plus tard." }
  ],
  munajat: `Ya Salam, Tu es la Paix. Purifie ma parole de la vanité et du péché. Fais que mes conversations Te plaisent.`
};

MIROIR["52:24"] = {
  reference: "52:24",
  theme: ["paradis", "service", "jeunesse"],
  emotion: "Paix, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Karim"],
  mirrorVersion: `« Et parmi eux circuleront des garçons à leur service, pareils à des perles bien conservées. » Le miroir me montre le service au Paradis. « Wa yatufu 'alayhim ghilmanun lahum ka-annahum lu'lu'un maknun » — parmi eux circuleront des garçons à leur service, pareils à des perles. Le service est beau et honoré. Le miroir m'invite à réfléchir sur le service.`,
  reflection: `Au Paradis, même le service est beau et précieux. La beauté imprègne tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yatufu 'alayhim ghilmanun lahum ka-annahum lu'lu'un maknun » — parmi eux circuleront des garçons pareils à des perles bien conservées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je sers ? Comment je suis servi ? Le service est-il honoré dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le beau service au Paradis vient du service sincère sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière sert Allah. Le service est l'essence de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sert bien maintenant sera bien servi plus tard." }
  ],
  munajat: `Ya Malik, Tu es le Roi. Fais que je serve avec excellence. Donne-moi la beauté du service au Paradis.`
};

MIROIR["52:25"] = {
  reference: "52:25",
  theme: ["paradis", "conversation", "souvenir"],
  emotion: "Nostalgie, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Et ils se tourneront les uns vers les autres, s'interrogeant mutuellement. » Le miroir me montre les conversations du Paradis. « Wa aqbala ba'duhum 'ala ba'din yatasa'alun » — ils se tourneront les uns vers les autres, s'interrogeant. Les conversations sont tournées vers le souvenir. Le miroir m'invite à converser sur ce qui compte.`,
  reflection: `Au Paradis, les conversations seront sur le passé, sur la gratitude, sur le cheminement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aqbala ba'duhum 'ala ba'din yatasa'alun » — ils se tourneront les uns vers les autres, s'interrogeant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi je converse ? De quoi je me souviens ? Les conversations sont-elles mémorables ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les conversations du Paradis naissent des conversations de la terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le souvenir partagé est un trésor. Le Paradis est rempli de ces trésors." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui converse bien maintenant converse mieux plus tard." }
  ],
  munajat: `Ya Khabir, Tu connais mes conversations. Fais qu'elles soient dignes du souvenir. Donne-moi les belles conversations du Paradis.`
};

MIROIR["52:26"] = {
  reference: "52:26",
  theme: ["paradis", "souvenir", "crainte"],
  emotion: "Gratitude, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hafiz"],
  mirrorVersion: `« Nous étions auparavant, parmi les nôtres, plein de crainte. » Le miroir me montre le souvenir des bienheureux. « Inna kunna qablu fi ahlina mushfiqin » — nous étions auparavant, parmi les nôtres, plein de crainte. La crainte d'Allah sur terre devient la sécurité au Paradis. Le miroir m'invite à craindre maintenant.`,
  reflection: `La crainte d'Allah dans ce monde est le prélude à la sécurité de l'au-delà.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kunna qablu fi ahlinu mushfiqin » — nous étions auparavant, parmi les nôtres, plein de crainte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah maintenant ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte maintenant mène à la sécurité plus tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La crainte respectueuse est le signe de la vraie connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint maintenant sera en sécurité plus tard." }
  ],
  munajat: `Ya Hafiz, Tu préserves ceux qui Te craignent. Fais que je Te craigne maintenant pour être en sécurité plus tard.`
};

MIROIR["52:27"] = {
  reference: "52:27",
  theme: ["gratitude", "bénédiction", "guidance"],
  emotion: "Reconnaissance, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Hadi"],
  mirrorVersion: `« Mais Allah nous a favorisés et nous a protégés du châtiment du vent brûlant. » Le miroir me montre la gratitude des bienheureux. « Fa manna Allahu 'alayna wa waqana 'adhaba al-samum » — mais Allah nous a favorisés et nous a protégés. La reconnaissance est au cœur du Paradis. Le miroir m'invite à reconnaître les faveurs maintenant.`,
  reflection: `La reconnaissance des faveurs divines commence sur terre et culmine au Paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa manna Allahu 'alayna wa waqana 'adhaba al-samum » — mais Allah nous a favorisés et nous a protégés du châtiment du vent brûlant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les faveurs d'Allah ? Ou est-ce que je les prends pour acquises ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection divine vient de la gratitude humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque protection est une faveur. Chaque faveur mérite reconnaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les faveurs maintenant en reçoit plus plus tard." }
  ],
  munajat: `Ya Mannan, Tu m'as favorisé et protégé. Fais que je reconnaisse Tes faveurs. Protège-moi de tout châtiment.`
};

MIROIR["52:28"] = {
  reference: "52:28",
  theme: ["invocation", "unicité", "adoration"],
  emotion: "Dévotion, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Nous L'invoquions auparavant. C'est Lui le Bienfaiteur, le Très Miséricordieux. » Le miroir me montre l'invocation des bienheureux. « Inna kunna min qablu nad'uh » — nous L'invoquions auparavant. « Innahu huwa al-barr al-rahim » — c'est Lui le Bienfaiteur, le Très Miséricordieux. L'invocation est le lien qui unit la terre au Paradis. Le miroir m'invite à invoquer maintenant.`,
  reflection: `L'invocation est le fil continu de la vie du croyant. Elle commence ici et s'achève dans la satisfaction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kunna min qablu nad'uh innahu huwa al-barr al-rahim » — nous L'invoquions auparavant. C'est Lui le Bienfaiteur, le Très Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah ? Est-ce que je reconnais qu'Il est le Bienfaiteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation maintenant mène à la réponse éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature invoque son Créateur, consciemment ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque maintenant sera exaucé plus tard." }
  ],
  munajat: `Ya Barr, Tu es le Bienfaiteur. Fais que je T'invoque constamment. Exauce-moi et accorde-moi Ta miséricorde.`
};

MIROIR["52:29"] = {
  reference: "52:29",
  theme: ["prophète", "rappel", "don"],
  emotion: "Réconfort, identité",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Rappelle donc ! Tu n'es ni un devin ni un possédé. » Le miroir confirme la mission du Prophète. « Fa dhakkir fama anta bi-ni'mati rabbika bi-kahinin wa la majnun » — rappelle donc ! Tu n'es ni un devin ni un possédé. La clarté de la mission prophétique. Le miroir m'invite à rappeler.`,
  reflection: `Le Prophète n'était ni devin ni fou. Il était le rappelateur véridique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa dhakkir fama anta bi-ni'mati rabbika bi-kahinin wa la majnun » — rappelle ! Tu n'es ni un devin ni un possédé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rappelle ? Est-ce que je transmets le message avec clarté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel n'est pas une accusation — c'est une grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monde a besoin de rappel. Le rappelateur est un bienfaiteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rappelle la vérité participe à la mission prophétique." }
  ],
  munajat: `Ya Nur, Tu as envoyé le Prophète comme rappelateur. Fais que je rappelle Ta vérité avec clarté et sagesse.`
};

MIROIR["52:30"] = {
  reference: "52:30",
  theme: ["accusation", "poésie", "patience"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabur", "Al-Hakim"],
  mirrorVersion: `« Ou bien disent-ils : C'est un poète ! Nous attendons pour lui les hasards du destin. » Le miroir me montre l'accusation des négateurs. « Am yaquluna shairun natarabbasu bihi rayba al-manun » — ou bien disent-ils : C'est un poète ! Nous attendons les hasards. L'accusation de mensonge contre la vérité. Le miroir m'invite à la patience face aux accusations.`,
  reflection: `Les négateurs trouvent toujours des excuses pour rejeter la vérité. Le poète est leur bouc émissaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yaquluna shairun natarabbasu bihi rayba al-manun » — ou bien disent-ils : C'est un poète ! Nous attendons les hasards du destin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand on m'accuse à tort, est-ce que je suis patient ? Est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation des négateurs ne change pas la vérité du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité a toujours été accusée. Les prophètes ont toujours été rejetés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure l'accusation pour la vérité reçoit la récompense des véridiques." }
  ],
  munajat: `Ya Sabur, Tu es Patient. Fais que je sois patient face aux accusations. Confirme ma vérité et ne permets pas que les mensonges triomphent.`
};

MIROIR["52:31"] = {
  reference: "52:31",
  theme: ["défi", "attente", "réponse"],
  emotion: "Défi, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Ghalib"],
  mirrorVersion: `« Dis : Attendez ! Je suis avec vous parmi ceux qui attendent. » Le miroir me montre la réponse divine au défi. « Qul tarabbasu fa-inni ma'akum min al-mutarabbisin » — dis : Attendez ! Je suis avec vous parmi ceux qui attendent. Le défi des négateurs sera répondu. Le miroir m'invite à attendre avec confiance.`,
  reflection: `La réponse d'Allah vient. L'attente des négateurs sera leur perte, l'attente des croyants sera leur victoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul tarabbasu fa-inni ma'akum min al-mutarabbisin » — dis : Attendez ! Je suis avec vous parmi ceux qui attendent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends la réponse d'Allah ? Avec confiance ou impatience ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "L'attente des croyants est espérance, l'attente des négateurs est angoisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout vient en son temps. La patience est la clé de l'attente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend avec confiance reçoit au moment parfait." }
  ],
  munajat: `Ya Qadir, Tu réponds en Ton temps. Fais que j'attende avec confiance et patience. Ne permets pas que l'attente soit mon angoisse.`
};

MIROIR["52:32"] = {
  reference: "52:32",
  theme: ["raison", "libre-arbitre", "égarement"],
  emotion: "Interrogation, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Est-ce leur raison qui leur commande cela ? Ou sont-ils des gens transgresseurs ? » Le miroir m'interroge sur la source de mes actions. « Am ta'muruhum aqluhum am hum qawmun taghun » — est-ce leur raison qui leur commande cela ? Ou sont-ils des transgresseurs ? La question est profonde : d'où viennent mes choix ?`,
  reflection: `La raison devrait commander à l'âme. Mais quand l'âme transgresse, elle ignore la raison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am ta'muruhum aqluhum am hum qawmun taghun » — est-ce leur raison qui leur commande cela ? Ou sont-ils des transgresseurs ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où viennent mes choix ? De la raison ou de la transgression ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La raison éclairée mène à Allah. La transgression mène à l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'intelligence est un don. Son usage pour le bien ou le mal est un choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit sa raison éclairée suit le chemin droit." }
  ],
  munajat: `Ya 'Alim, Tu connais la source de mes choix. Fais que ma raison me commande le bien. Ne permets pas que je transgresse.`
};

MIROIR["52:33"] = {
  reference: "52:33",
  theme: ["accusation", "mensonge", "fabrication"],
  emotion: "Patience, vérité",
  difficulty: "débutant",
  relatedNames: ["As-Siddiq", "Al-Haqq"],
  mirrorVersion: `« Ou bien disent-ils : Il l'a inventé ! » Le miroir me montre l'accusation de fabrication. « Am yaquluna taqawwalahu » — ou bien disent-ils : Il l'a inventé ! Le mensonge contre la vérité. Le miroir m'invite à tenir ferme face aux accusations.`,
  reflection: `Accuser le Prophète d'avoir inventé le Coran est une stratégie des négateurs. La vérité se défend d'elle-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yaquluna taqawwalahu » — ou bien disent-ils : Il l'a inventé !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand on accable la vérité, est-ce que je défends ? Ou est-ce que je me tais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de fabrication ne peut pas annuler la vérité de la révélation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité existe indépendamment des accusations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend la vérité participe à sa victoire." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je défende la vérité face aux accusations. Confirme Ta parole contre les mensonges.`
};

MIROIR["52:34"] = {
  reference: "52:34",
  theme: ["défi", "coran", "inimitabilité"],
  emotion: "Défi, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'jiz", "Al-Hakim"],
  mirrorVersion: `« Qu'ils produisent donc une parole semblable, s'ils sont véridiques ! » Le miroir me montre le défi coranique. « Fa ya'tu bi-hadithin mithlihi in kanu sadiqin » — qu'ils produisent donc une parole semblable, s'ils sont véridiques ! Le défi est lancé. Le Coran est inimitable. Le miroir m'invite à méditer sur l'unicité du Livre.`,
  reflection: `Le défi de produire quelque chose de semblable au Coran reste sans réponse. Le Livre est unique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ya'tu bi-hadithin mithlihi in kanu sadiqin » — qu'ils produisent une parole semblable, s'ils sont véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'unicité du Coran ? Est-ce que je le traite comme unique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité de reproduire le Coran prouve son origine divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole divine est unique comme le Créateur est unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'unicité du Coran reconnaît l'unicité du Révélateur." }
  ],
  munajat: `Ya Rabb, Ton Livre est unique et inimitable. Fais que je le reconnaisse comme tel. Fais que je le traite avec l'honneur qu'il mérite.`
};

MIROIR["52:35"] = {
  reference: "52:35",
  theme: ["création", "créateur", "raison"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Ont-ils été créés de rien ou sont-ils eux les créateurs ? » Le miroir m'interroge sur l'origine. « Am khuliqu min ghayri shay'in am hum al-khaliqun » — ont-ils été créés de rien ou sont-ils les créateurs ? La question est logique : tout ce qui existe a un créateur. Le miroir m'invite à réfléchir.`,
  reflection: `L'existence d'une création implique l'existence d'un Créateur. Le néant ne peut pas créer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am khuliqu min ghayri shay'in am hum al-khaliqun » — ont-ils été créés de rien ou sont-ils les créateurs ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réfléchis à mon origine ? Est-ce que je reconnais mon Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question de l'origine mène nécessairement au Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers pointe vers son Origine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine connaît sa destination." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé. Fais que je reconnaisse mon origine et que je vive en conséquence. Ne permets pas que j'oublie qui je suis.`
};

MIROIR["52:36"] = {
  reference: "52:36",
  theme: ["création", "univers", "créateur"],
  emotion: "Humilité, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Fatir", "Al-Musawwir"],
  mirrorVersion: `« Ont-ils créé les cieux et la terre ? » Le miroir m'interroge sur la grandeur. « Am khalaqu al-samawati wa al-ard » — ont-ils créé les cieux et la terre ? La question élargit la perspective. L'homme est petit, l'univers est grand. Le miroir m'invite à l'humilité.`,
  reflection: `L'homme n'a pas créé l'univers. Il est une créature parmi d'autres dans un univers immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am khalaqu al-samawati wa al-ard » — ont-ils créé les cieux et la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais ma petitesse face à l'univers ? Ou est-ce que je suis arrogant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de ma petitesse mène à la grandeur du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un signe de la grandeur du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'humilie devant la grandeur est élevé par le Grand." }
  ],
  munajat: `Ya Fatir, Tu as créé les cieux et la terre. Fais que je reconnaisse ma petitesse et Ta grandeur. Élève-moi par mon humilité.`
};

MIROIR["52:37"] = {
  reference: "52:37",
  theme: ["provision", "trésor", "indépendance"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Ghani"],
  mirrorVersion: `« Ont-ils les trésors de ton Seigneur ? » Le miroir m'interroge sur la source de provision. « Am 'indahum khaza'inu rabbika » — ont-ils les trésors de ton Seigneur ? La provision vient d'Allah seul. Le miroir m'invite à faire confiance au Pourvoyeur.`,
  reflection: `Les trésors d'Allah sont inépuisables. Nul ne contrôle la provision sauf Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am 'indahum khaza'inu rabbika » — ont-ils les trésors de ton Seigneur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où vient ma provision ? Est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision n'est pas contrôlée par les hommes mais par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature reçoit sa provision du Trésorier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance au Trésorier ne manque jamais." }
  ],
  munajat: `Ya Razzaq, Tu es le Pourvoyeur. Fais que je Te fasse confiance pour ma provision. Ne permets pas que je cherche ailleurs ce qui vient de Toi.`
};

MIROIR["52:38"] = {
  reference: "52:38",
  theme: ["connaissance", "révélation", "échelle"],
  emotion: "Humilité, écoute",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sami'", "Al-'Alim"],
  mirrorVersion: `« Ont-ils une échelle pour écouter ? » Le miroir m'interroge sur la source de connaissance. « Am lahum sullamun yastami'una fihi » — ont-ils une échelle pour écouter ? La connaissance vient d'Allah par révélation. Le miroir m'invite à écouter la révélation.`,
  reflection: `La connaissance divine vient par révélation, pas par escalade. Les anges descendent, les hommes ne montent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lahum sullamun yastami'una fihi » — ont-ils une échelle pour écouter ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où vient ma connaissance spirituelle ? De la révélation ou de l'imagination ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie connaissance descend, elle ne s'escalade pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le pont entre le ciel et la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute la révélation entend la voix du Ciel." }
  ],
  munajat: `Ya Sami', Tu fais descendre la révélation. Fais que je l'écoute avec mon cœur. Ne permets pas que je cherche la connaissance ailleurs.`
};

MIROIR["52:39"] = {
  reference: "52:39",
  theme: ["famille", "fille", "justice"],
  emotion: "Indignation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hakam"],
  mirrorVersion: `« Allah a-t-Il des filles et vous des fils ? » Le miroir m'interroge sur les croyances des Arabes. « Am lahu al-banatu wa lakumu al-banun » — Allah a-t-Il des filles et vous des fils ? L'injustice de l'attribution de filles à Allah. Le miroir m'invite à purifier ma conception d'Allah.`,
  reflection: `Les Arabes attribuaient des filles à Allah alors qu'ils méprisaient les filles. Double injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lahu al-banatu wa lakumu al-banun » — Allah a-t-Il des filles et vous des fils ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attribue à Allah qui ne Lui appartient pas ? Ma conception est-elle pure ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est au-dessus de ce que les hommes imaginent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transcendance d'Allah est absolue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie sa conception d'Allah Le connaît vraiment." }
  ],
  munajat: `Ya Adl, Tu es Juste et transcendant. Purifie ma conception de Toi. Ne permets pas que je T'attribue ce qui ne T'appartient pas.`
};

MIROIR["52:40"] = {
  reference: "52:40",
  theme: ["récompense", "sincérité", "désintéressement"],
  emotion: "Sincérité, vérification",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Karim"],
  mirrorVersion: `« Est-ce que tu leur demandes une récompense ? » Le miroir m'interroge sur mes motivations. « Am tas'aluhum ajran » — est-ce que tu leur demandes une récompense ? Le Prophète ne demandait rien. Le miroir m'invite à vérifier ma sincérité.`,
  reflection: `Le Prophète ne demandait aucune récompense matérielle. Son message était désintéressé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am tas'aluhum ajran » — est-ce que tu leur demandes une récompense ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends en retour de mon service ? Une récompense ou rien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désintéressement est la preuve de la sincérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil donne sans demander. Le croyant fait de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne demande rien reçoit tout." }
  ],
  munajat: `Ya Ghani, Tu donnes sans attendre. Fais que je serve sans attendre de récompense. Purifie mon intention.`
};

MIROIR["52:41"] = {
  reference: "52:41",
  theme: ["connaissance", "invisible", "science"],
  emotion: "Humilité, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Ou bien détiennent-ils l'Inconnaissable ? » Le miroir m'interroge sur la prétention à tout savoir. « Am 'indahum al-ghaybu fahum yaktubun » — ou bien détiennent-ils l'Inconnaissable ? L'invisible appartient à Allah seul. Le miroir m'invite à reconnaître mes limites.`,
  reflection: `L'inconnaissable est le domaine d'Allah. Les hommes ne peuvent pas le connaître par eux-mêmes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am 'indahum al-ghaybu fahum yaktubun » — ou bien détiennent-ils l'Inconnaissable qu'ils écrivent ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prétends savoir ce que je ne sais pas ? Ou est-ce que je reconnais mes limites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'ignorance est le début de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invisible est plus vaste que le visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ne pas savoir apprend du Savant." }
  ],
  munajat: `Ya 'Alim, Tu connais l'invisible. Fais que je reconnaisse mes limites. Ne permets pas que je prétende savoir ce que je ne sais pas.`
};

MIROIR["52:42"] = {
  reference: "52:42",
  theme: ["complot", "confiance", "protection"],
  emotion: "Confiance, sérénité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Wakil"],
  mirrorVersion: `« Ou bien cherchent-ils un stratagème ? » Le miroir m'interroge sur les complots. « Am yuriduna kaydan » — ou bien cherchent-ils un stratagème ? Les négateurs complotent. Mais qui protège ? Le miroir m'invite à faire confiance à Allah.`,
  reflection: `Les complots des hommes sont impuissants face à la protection divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yuriduna kaydan » — ou bien cherchent-ils un stratagème ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains les complots ? Ou est-ce que je fais confiance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les complots des méchants se retournent contre eux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection divine enveloppe les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est protégé par Allah ne craint rien." }
  ],
  munajat: `Ya Hafiz, Tu es le Protecteur. Protège-moi des complots. Fais que je ne craigne que Toi.`
};

MIROIR["52:43"] = {
  reference: "52:43",
  theme: ["divinité", "intercession", "unicité"],
  emotion: "Vérité, unicité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Ont-ils une divinité en dehors d'Allah ? » Le miroir m'interroge sur les idoles. « Am lahum ilahun ghayru Allah » — ont-ils une divinité en dehors d'Allah ? La question est cruciale : qui adorent-ils ? Le miroir m'invite à examiner mes propres idoles.`,
  reflection: `Les idoles peuvent être visibles ou invisibles. Tout ce qui prend la place d'Allah est idole.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lahum ilahun ghayru Allah » — ont-ils une divinité en dehors d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui prend la place d'Allah dans ma vie ? Quelles sont mes idoles cachées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Il n'y a de divinité qu'Allah. Tout le reste est création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est la vérité fondamentale de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a pas d'autre divinité qu'Allah trouve la liberté." }
  ],
  munajat: `Ya Ahad, Tu es l'Unique. Purifie mon cœur de toutes les idoles. Fais que Tu sois ma seule divinité.`
};

MIROIR["52:44"] = {
  reference: "52:44",
  theme: ["miracle", "vision", "incrédulité"],
  emotion: "Tristesse, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadir", "Al-Basir"],
  mirrorVersion: `« S'ils voyaient un morceau du ciel s'écrouler, ils diraient : Ce sont des nuages superposés ! » Le miroir me montre l'aveuglement des négateurs. « Wa in yaraw kisfan mina al-sama'i saqitan yaqulu sahahun maknun » — s'ils voyaient un morceau du ciel s'écrouler, ils diraient : des nuages ! L'incrédulité est volontaire. Le miroir m'invite à examiner ma propre capacité à voir.`,
  reflection: `Même les miracles ne convainquent pas celui qui ne veut pas croire. L'incrédulité est un choix du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yaraw kisfan mina al-sama'i saqitan yaqulu sahahun maknun » — s'ils voyaient un morceau du ciel s'écrouler, ils diraient : des nuages superposés !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je refuse de voir ? Quels miracles j'explique par le hasard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vue des miracles dépend de l'ouverture du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un miracle pour celui qui a des yeux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a les yeux ouverts voit les signes partout." }
  ],
  munajat: `Ya Basir, ouvre mes yeux aux signes. Ne permets pas que j'explique Tes miracles par le hasard. Fais que je voie vraiment.`
};

MIROIR["52:45"] = {
  reference: "52:45",
  theme: ["patience", "épreuve", "délai"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Hakim"],
  mirrorVersion: `« Laisse-les donc jusqu'à ce qu'ils rencontrent leur jour. » Le miroir m'invite à la patience. « Fa tharhum hatta yulaqu yawmahum » — laisse-les donc jusqu'à ce qu'ils rencontrent leur jour. Le délai divin n'est pas l'oubli. Le miroir m'invite à faire confiance au timing d'Allah.`,
  reflection: `Le délai accordé aux injustes n'est pas une impunité. C'est une patience divine avec une fin certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa tharhum hatta yulaqu yawmahum » — laisse-les donc jusqu'à ce qu'ils rencontrent leur jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis patient avec ceux qui m'opposent ? Est-ce que je fais confiance au jugement d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde pour le repentir, pas une licence pour l'injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est un don qui peut devenir un fardeau pour l'insouciant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente avec confiance reçoit la justice au moment parfait." }
  ],
  munajat: `Ya Sabur, Tu es Patient. Fais que je sois patient avec ceux qui s'opposent. Donne-moi confiance en Ton timing parfait.`
};

MIROIR["52:46"] = {
  reference: "52:46",
  theme: ["jugement", "impuissance", "conséquence"],
  emotion: "Sérieux, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Le jour où leur ruse ne leur servira à rien et où ils ne seront pas secourus. » Le miroir me montre l'impuissance finale. « Al-yawma la yughni 'anhum kayduhum shay'an wa la hum yunsarun » — le jour où leur ruse ne servira à rien. Le stratagème échoue, le secours manque. Le miroir m'avertit de ne pas compter sur la ruse.`,
  reflection: `La ruse et les alliances humaines échoueront au Jour du Jugement. Seule la vérité restera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-yawma la yughni 'anhum kayduhum shay'an wa la hum yunsarun » — le jour où leur ruse ne servira à rien et ils ne seront pas secourus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je compte ? Ma ruse ? Mes alliés ? Ou Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance finale révèle la puissance de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours, même si elle tarde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah seul est secouru toujours." }
  ],
  munajat: `Ya Qahhar, Tu es le Dominateur. Fais que je ne compte que sur Toi. Ne permets pas que je sois parmi ceux dont la ruse échoue.`
};

MIROIR["52:47"] = {
  reference: "52:47",
  theme: ["châtiment", "injustice", "double"],
  emotion: "Sérieux, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Muntaqim"],
  mirrorVersion: `« Et pour les injustes, il y a un châtiment en dehors de cela. » Le miroir me montre la multiplicité du châtiment. « Wa inna lil-zalimina 'adhaban duna dhalika » — pour les injustes, il y a un châtiment en dehors de cela. Le châtiment commence même avant le grand Jour. Le miroir m'avertit de l'injustice.`,
  reflection: `L'injustice attire le châtiment dans ce monde et dans l'autre. Nulle injustice ne reste impunie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna lil-zalimina 'adhaban duna dhalika » — et pour les injustes, il y a un châtiment en dehors de cela." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis juste ? Ou est-ce que je commets l'injustice ? Le châtiment est-il déjà là ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice est la protection, l'injustice est l'exposition au châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fondé sur la justice. L'injustice brise l'ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste est protégé des châtiments." }
  ],
  munajat: `Ya Adl, Tu es Juste. Fais que je sois juste. Protège-moi des châtiments de l'injustice.`
};

MIROIR["52:49"] = {
  reference: "52:49",
  theme: ["louange", "nuit", "constance"],
  emotion: "Dévotion, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hamid", "As-Sabur"],
  mirrorVersion: `« Et glorifie-Le une partie de la nuit et au déclin des étoiles. » Le miroir m'invite à la louange nocturne. « Wa mina al-layli fasabbihhu wa idbara al-nujum » — et glorifie-Le une partie de la nuit et au déclin des étoiles. La nuit est le temps de l'intimité. Le miroir m'invite à la prière nocturne.`,
  reflection: `La nuit est propice à la louange. Quand le monde dort, le croyant veille avec son Seigneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-layli fasabbihhu wa idbara al-nujum » — et glorifie-Le une partie de la nuit et au déclin des étoiles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie la nuit ? Est-ce que je profite du silence pour la louange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit est le jardin des amants d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit couvre le monde de silence, propice à l'écoute divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veille la nuit en louange entre dans l'intimité divine." }
  ],
  munajat: `Ya Hamid, Tu es le Loué. Fais que je Te loue dans la nuit. Donne-moi la force de veiller quand les autres dorment.`
};

// === SURAH 53 - AN-NAJM (The Star) - 62 verses ===
// Existing: 53:1, 53:32, 53:39
// Adding: 53:2-31, 53:33-38, 53:40-62

MIROIR["53:2"] = {
  reference: "53:2",
  theme: ["prophète", "égarement", "guidance"],
  emotion: "Confiance, vérification",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "As-Siraj"],
  mirrorVersion: `« Votre compagnon ne s'est pas égaré et n'a pas été induit en erreur. » Le miroir défend le Prophète. « Ma dalla sahibukum wa ma ghawa » — votre compagnon ne s'est pas égaré et n'a pas été induit en erreur. L'accusation d'égarement est fausse. Le miroir m'invite à vérifier mes propres sources de guidance.`,
  reflection: `Le Prophète était sur le droit chemin. Ses accusateurs étaient les égarés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma dalla sahibukum wa ma ghawa » — votre compagnon ne s'est pas égaré et n'a pas été induit en erreur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui j'accuse d'égarement ? Et moi, suis-je sur le droit chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation d'égarement vient souvent des égarés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est un chemin droit. Le mensonge est un labyrinthe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète suit le chemin sans égarement." }
  ],
  munajat: `Ya Hadi, Tu es le Guide. Fais que je suive Ton Prophète sans dévier. Ne permets pas que je sois parmi les égarés.`
};

MIROIR["53:3"] = {
  reference: "53:3",
  theme: ["prophète", "désir", "révélation"],
  emotion: "Vérification, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Amin"],
  mirrorVersion: `« Et il ne prononce rien sous l'effet de la passion. » Le miroir établit l'objectivité du Prophète. « Wa ma yantiqu 'ani al-hawa » — et il ne prononce rien sous l'effet de la passion. La révélation n'est pas subjective. Le miroir m'invite à vérifier mes propres motivations.`,
  reflection: `Le Prophète ne parlait pas de son propre chef. Chaque parole était révélation ou sagesse inspirée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yantiqu 'ani al-hawa » — et il ne prononce rien sous l'effet de la passion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je parle sous l'effet de la passion ? Ou est-ce que je parle avec sagesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole inspirée est au-dessus des passions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est objective. La passion est subjective." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui parle sans passion parle avec vérité." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Purifie ma parole des passions. Fais que je ne parle que la vérité.`
};

MIROIR["53:4"] = {
  reference: "53:4",
  theme: ["révélation", "inspiration", "origine"],
  emotion: "Révérence, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Munazzil"],
  mirrorVersion: `« Ce n'est rien d'autre qu'une révélation inspirée. » Le miroir établit l'origine divine. « In huwa illa wahyun Yuha » — ce n'est rien d'autre qu'une révélation inspirée. Le Coran vient d'Allah. Le miroir m'invite à honorer la révélation.`,
  reflection: `Le Coran est une révélation divine, pas une invention humaine. Son origine est le Ciel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In huwa illa wahyun yuha » — ce n'est rien d'autre qu'une révélation inspirée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite le Coran comme révélation divine ? Ou comme un livre ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation descend, elle ne s'invente pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le lien entre le Ciel et la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la révélation reconnaît le Révélateur." }
  ],
  munajat: `Ya Munazzil, Tu as fait descendre la révélation. Fais que je l'honore comme elle mérite. Ne permets pas que je la traite légèrement.`
};

MIROIR["53:5"] = {
  reference: "53:5",
  theme: ["ange", "révélation", "force"],
  emotion: "Révérence, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Jibril", "Al-Ruh al-Amin"],
  mirrorVersion: `« Un ange très puissant l'a enseigné. » Le miroir me montre le médiateur. « 'Allamahu shadidu al-quwa » — un ange très puissant l'a enseigné. Jibril, l'ange de la révélation. Le miroir m'invite à honorer ceux qui transmettent la vérité.`,
  reflection: `Jibril est l'ange de la révélation, fort et digne de confiance. Il a transmis le Coran au Prophète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Allamahu shadidu al-quwa » — un ange très puissant l'a enseigné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'honore ceux qui m'enseignent la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enseignement spirituel vient par des intermédiaires purs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les messagers entre les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore le messager honore Celui qui envoie." }
  ],
  munajat: `Ya Rabb, Tu envoies les anges avec la révélation. Fais que j'honore Ton messager et Ton message.`
};

MIROIR["53:6"] = {
  reference: "53:6",
  theme: ["ange", "sagesse", "apparence"],
  emotion: "Émerveillement, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Jibril", "Al-Hakim"],
  mirrorVersion: `« D'un esprit sage, qui est apparu sous sa forme réelle. » Le miroir me montre la manifestation angélique. « Dhu mirratin fa-stawa » — d'un esprit sage, qui est apparu sous sa forme réelle. Jibril a pris sa forme originelle. Le miroir m'invite à contempler la réalité spirituelle.`,
  reflection: `Les anges ont des formes réelles que les humains peuvent parfois voir. Leur nature est spirituelle mais ils peuvent se manifester.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhu mirratin fa-stawa » — d'un esprit sage, qui est apparu sous sa forme réelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma capacité à percevoir la réalité spirituelle ? Suis-je ouvert aux manifestations divines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La forme réelle révèle la vraie nature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monde spirituel est plus réel que le monde matériel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la réalité spirituelle voit la vérité." }
  ],
  munajat: `Ya Rabb, Tu montres la réalité à qui Tu veux. Ouvre mes yeux à la réalité spirituelle. Ne permets pas que je reste aveugle.`
};

MIROIR["53:7"] = {
  reference: "53:7",
  theme: ["vision", "élévation", "horizon"],
  emotion: "Émerveillement, élévation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aliyy", "Al-Kabir"],
  mirrorVersion: `« Alors qu'il se trouvait à l'horizon supérieur. » Le miroir me montre l'élévation. « Wa huwa bi-l-ufuqi al-a'la » — alors qu'il se trouvait à l'horizon supérieur. La vision s'est faite à un niveau élevé. Le miroir m'invite à élever ma perspective.`,
  reflection: `La révélation vient d'en haut. L'horizon supérieur représente le point de rencontre entre le divin et l'humain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa bi-l-ufuqi al-a'la » — alors qu'il se trouvait à l'horizon supérieur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon horizon ? Suis-je orienté vers le haut ou vers le bas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation spirituelle vient de la rencontre avec le divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers s'étend vers le haut. L'âme doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'élève vers l'horizon supérieur rencontre la révélation." }
  ],
  munajat: `Ya Aliyy, Tu es le Très-Haut. Élève mon horizon vers Toi. Fais que je rencontre la révélation dans l'élévation.`
};

MIROIR["53:8"] = {
  reference: "53:8",
  theme: ["rapprochement", "proximité", "intimité"],
  emotion: "Intimité, émerveillement",
  difficulty: "avancé",
  relatedNames: ["Al-Qarib", "Al-Wali"],
  mirrorVersion: `« Puis il se rapprocha et descendit. » Le miroir me montre le rapprochement divin. « Thumma dana fa-tadalla » — puis il se rapprocha et descendit. Allah Se rapproche de Son Prophète. Le miroir m'invite à désirer ce rapprochement.`,
  reflection: `Le rapprochement divin est un mystère d'amour. Allah Se fait proche de Ses serviteurs sincères.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma dana fa-tadalla » — puis il se rapprocha et descendit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le rapprochement d'Allah ? Qu'est-ce que je fais pour L'approcher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rapprochement divin répond à l'effort humain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah Se rapproche de chaque créature qui L'appelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche le rapprochement est déjà rapproché." }
  ],
  munajat: `Ya Qarib, Tu es le Proche. Rapproche-Toi de moi comme Tu T'es rapproché de Ton Prophète. Fais que je sois parmi Tes proches.`
};

MIROIR["53:9"] = {
  reference: "53:9",
  theme: ["proximité", "intimité", "distance"],
  emotion: "Émerveillement, intimité",
  difficulty: "avancé",
  relatedNames: ["Al-Qarib", "Al-Wadud"],
  mirrorVersion: `« Il était à deux portées d'arc, ou même plus près. » Le miroir me montre l'extrême proximité. « Fa kana qaba qawsayni aw adna » — il était à deux portées d'arc, ou même plus près. La distance entre le Créateur et le Prophète était minime. Le miroir m'invite à désirer cette proximité.`,
  reflection: `La proximité divine dépasse l'imagination. Le Prophète a atteint un degré de proximité unique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa kana qaba qawsayni aw adna » — il était à deux portées d'arc, ou même plus près." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quelle distance je suis d'Allah ? Et à quelle distance je voudrais être ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distance spirituelle n'est pas spatiale mais relationnelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La proximité divine est le sommet de l'expérience spirituelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est proche d'Allah n'a pas d'autre désir." }
  ],
  munajat: `Ya Qarib, Tu es si proche. Rapproche-moi de Toi comme Tu as rapproché Ton Prophète. Ne permets pas que la distance s'installe.`
};

MIROIR["53:10"] = {
  reference: "53:10",
  theme: ["révélation", "communication", "vérité"],
  emotion: "Révérence, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mutakallim", "As-Sadiq"],
  mirrorVersion: `« Et Il révéla à Son serviteur ce qu'Il révéla. » Le miroir me montre le mystère de la révélation. « Fa awha ila 'abdihi ma awha » — et Il révéla à Son serviteur ce qu'Il révéla. Le contenu de la révélation est entre Allah et Son Prophète. Le miroir m'invite à accepter ce qui est révélé.`,
  reflection: `La révélation est un acte divin mystérieux. Son contenu est vérité, transmis au Prophète fidèlement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa awha ila 'abdihi ma awha » — et Il révéla à Son serviteur ce qu'Il révéla." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la révélation comme vérité ? Ou est-ce que je la conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation est don, pas négociation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité descend du Ciel, elle ne monte pas de la terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la révélation reçoit la lumière." }
  ],
  munajat: `Ya Mutakallim, Tu parles à Tes serviteurs. Fais que j'accepte Ta révélation avec soumission. Ne permets pas que je conteste Ta parole.`
};

MIROIR["53:11"] = {
  reference: "53:11",
  theme: ["vision", "vérité", "cœur"],
  emotion: "Certitude, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "As-Sadiq"],
  mirrorVersion: `« Le cœur n'a pas menti sur ce qu'il a vu. » Le miroir établit la véracité de la vision. « Ma kadhaba al-fu'adu ma ra'a » — le cœur n'a pas menti sur ce qu'il a vu. La vision du Prophète était véridique. Le miroir m'invite à la sincérité du cœur.`,
  reflection: `Le cœur du Prophète a vu la vérité et ne l'a pas déformée. La sincérité est la garantie de la perception spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kadhaba al-fu'adu ma ra'a » — le cœur n'a pas menti sur ce qu'il a vu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur ment-il sur ce qu'il voit ? Est-ce que je suis sincère avec moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur sincère voit la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sincérité du cœur est la lentille de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur ne ment pas voit la réalité." }
  ],
  munajat: `Ya Basir, Tu vois la vérité. Purifie mon cœur du mensonge. Fais que je voie la vérité comme elle est.`
};

MIROIR["53:12"] = {
  reference: "53:12",
  theme: ["vision", "dispute", "certitude"],
  emotion: "Confiance, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« Allez-vous disputer avec lui sur ce qu'il voit ? » Le miroir m'interroge sur mes disputes. « Afatumarunahu 'ala ma yara » — allez-vous disputer avec lui sur ce qu'il voit ? La dispute sur la vision prophétique est vaine. Le miroir m'invite à cesser les disputes inutiles.`,
  reflection: `Disputer avec le Prophète sur sa vision est futile. Il a vu, les autres n'ont pas vu. La certitude ne se négocie pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afatumarunahu 'ala ma yara » — allez-vous disputer avec lui sur ce qu'il voit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avec qui je dispute ? Sur quoi je dispute ? Est-ce que je conteste ce que je ne comprends pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contestation de la vérité ne change pas la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité existe indépendamment de l'acceptation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte ce qu'il ne comprend pas encore grandit." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je cesse de disputer sur ce que je ne comprends pas. Donne-moi l'humilité d'accepter.`
};

MIROIR["53:13"] = {
  reference: "53:13",
  theme: ["vision", "révélation", "cérémonie"],
  emotion: "Révérence, émerveillement",
  difficulty: "avancé",
  relatedNames: ["Al-Majid", "Al-Karim"],
  mirrorVersion: `« Il l'a certes vu une autre fois. » Le miroir me montre la répétition de la vision. « Wa laqad ra'ahu nazlatan ukhra » — il l'a certes vu une autre fois. La vision n'était pas unique. Le miroir m'invite à la constance dans l'expérience spirituelle.`,
  reflection: `Le Prophète a eu plusieurs visions. La répétition confirme et approfondit l'expérience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ra'ahu nazlatan ukhra » — il l'a certes vu une autre fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai des expériences spirituelles répétées ? Ou est-ce que je cherche toujours de nouvelles expériences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La répétition n'est pas ennui — c'est approfondissement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève chaque jour. La constance est divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui approfondit l'expérience reçoit plus de lumière." }
  ],
  munajat: `Ya Majid, Tu es Glorieux. Fais que j'approfondisse mes expériences spirituelles. Ne permets pas que je cherche la nouveauté au détriment de la profondeur.`
};

MIROIR["53:14"] = {
  reference: "53:14",
  theme: ["vision", "arbre", "limite"],
  emotion: "Émerveillement, révérence",
  difficulty: "avancé",
  relatedNames: ["As-Sidrat", "Al-Muntaha"],
  mirrorVersion: `« Près du Lotus de la limite extrême. » Le miroir me montre le point ultime. « 'inda sidrati al-muntaha » — près du Lotus de la limite extrême. Sidrat al-Muntaha est le point au-delà duquel nul ne passe. Le miroir m'invite à reconnaître les limites.`,
  reflection: `Le Lotus de la Limite marque la frontière entre le créé et le Créateur. C'est le point le plus élevé accessible à la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Inda sidrati al-muntaha » — près du Lotus de la limite extrême." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes limites ? Est-ce que je les reconnais ? Ou est-ce que je les dépasse par orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des limites est sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose a sa limite. Le Créateur seul est illimité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît ses limites les utilise pour s'élever." }
  ],
  munajat: `Ya Muntaha, Tu es la Limite et l'Infini. Fais que je reconnaisse mes limites. Ne permets pas que je les dépasse par orgueil.`
};

MIROIR["53:15"] = {
  reference: "53:15",
  theme: ["paradis", "séjour", "récompense"],
  emotion: "Espoir, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Ma'wa"],
  mirrorVersion: `« Près du Jardin du séjour. » Le miroir me montre la proximité du Paradis. « 'inda jannati al-ma'wa » — près du Jardin du séjour. Le Paradis est proche de Sidrat al-Muntaha. Le miroir m'invite à désirer le Paradis.`,
  reflection: `Le Jardin du Séjour est la demeure éternelle des bienheureux. Il est proche du point le plus élevé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Inda jannati al-ma'wa » — près du Jardin du séjour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le Paradis ? Qu'est-ce que je fais pour m'en rapprocher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis est le but, Sidrat al-Muntaha est le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers le Jardin du Séjour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire le Paradis s'en rapproche." }
  ],
  munajat: `Ya Rabb, le Paradis est près de la limite. Fais que je désire le Jardin du Séjour. Rapproche-moi de Ta proximité éternelle.`
};

MIROIR["53:16"] = {
  reference: "53:16",
  theme: ["voile", "révélation", "mystère"],
  emotion: "Mystère, révérence",
  difficulty: "avancé",
  relatedNames: ["Al-Satr", "Al-Mughith"],
  mirrorVersion: `« Au moment où le Lotus était couvert de ce qui le couvrait. » Le miroir me montre le voile. « Idh yaghsha al-sidrata ma yaghsha » — au moment où le Lotus était couvert de ce qui le couvrait. Le mystère de la révélation. Le miroir m'invite à accepter le mystère.`,
  reflection: `Le voile qui couvrait le Lotus est un mystère. La révélation divine a des aspects que nous ne pouvons pas comprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh yaghsha al-sidrata ma yaghsha » — au moment où le Lotus était couvert de ce qui le couvrait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me voile la vérité ? Est-ce que j'accepte que certains mystères restent mystères ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile protège autant qu'il cache." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est voilé de mystères. La foi les accepte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère reçoit la lumière accessible." }
  ],
  munajat: `Ya Rabb, Tes mystères sont grands. Fais que j'accepte ce que je ne comprends pas. Ne permets pas que je refuse le mystère.`
};

MIROIR["53:17"] = {
  reference: "53:17",
  theme: ["regard", "égarement", "constance"],
  emotion: "Stabilité, concentration",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Matin"],
  mirrorVersion: `« Le regard ne dévia pas et ne s'égara pas. » Le miroir me montre la constance du regard. « Ma zaghha al-basaru wa ma tagha » — le regard ne dévia pas et ne s'égara pas. La concentration parfaite du Prophète. Le miroir m'invite à la constance.`,
  reflection: `Le Prophète a maintenu son regard fixé sur la vision sans dévier. La concentration spirituelle est la clé de l'expérience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma zaghha al-basaru wa ma tagha » — le regard ne dévia pas et ne s'égara pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon regard est-il constant ? Ou dévie-t-il sans cesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance du regard révèle la force de l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil ne dévie pas de sa course. Le croyant ne doit pas dévier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le regard est constant voit ce que les autres ne voient pas." }
  ],
  munajat: `Ya Sabur, Tu es Patient. Fais que mon regard soit constant. Ne permets pas qu'il dévie ou s'égare.`
};

MIROIR["53:18"] = {
  reference: "53:18",
  theme: ["vision", "signes", "grandeur"],
  emotion: "Émerveillement, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kabir", "Al-'Azim"],
  mirrorVersion: `« Il a certes vu les plus grands signes de son Seigneur. » Le miroir me montre la grandeur de la vision. « Laqad ra'a min ayati rabbihi al-kubra » — il a certes vu les plus grands signes. Les signes divins sont multiples et grands. Le miroir m'invite à chercher les signes.`,
  reflection: `Le Prophète a vu les plus grands signes divins. Les signes d'Allah sont partout pour qui sait les voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad ra'a min ayati rabbihi al-kubra » — il a certes vu les plus grands signes de son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes je vois ? Est-ce que je cherche les signes d'Allah dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont visibles pour ceux qui ont les yeux ouverts." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un signe. Chaque créature est un miracle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche les signes les trouve partout." }
  ],
  munajat: `Ya 'Azim, Tes signes sont grands. Ouvre mes yeux aux signes. Fais que je voie les plus grands signes de Ta création.`
};

MIROIR["53:19"] = {
  reference: "53:19",
  theme: ["idolâtrie", "faux dieux", "question"],
  emotion: "Interrogation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« Avez-vous considéré Al-Lat et Al-'Uzza ? » Le miroir m'interroge sur mes idoles. « Afara'aytumu al-lata wa al-'uzza » — avez-vous considéré Al-Lat et Al-'Uzza ? Les idoles des Arabes sont nommées. Le miroir m'invite à examiner mes propres idoles.`,
  reflection: `Al-Lat et Al-'Uzza étaient des idoles vénérées. Le Coran les nomme pour les confronter à la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afara'aytumu al-lata wa al-'uzza » — avez-vous considéré Al-Lat et Al-'Uzza ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles sont mes idoles modernes ? Qu'est-ce que je vénère en dehors d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les idoles sont des créations. Allah seul est Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'idolâtrie est universelle sous différentes formes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui brise ses idoles intérieures trouve la liberté." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Montre-moi mes idoles cachées. Aide-moi à les briser pour ne vénérer que Toi.`
};

MIROIR["53:20"] = {
  reference: "53:20",
  theme: ["idolâtrie", "faux dieux", "question"],
  emotion: "Interrogation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Ahad"],
  mirrorVersion: `« Et Manat, la troisième ? » Le miroir continue l'interrogation. « Wa manata al-thalithata al-ukhra » — et Manat, la troisième ? La troisième idole est nommée. Le miroir m'invite à examiner toutes mes idoles.`,
  reflection: `Manat était la troisième idole majeure des Arabes. Le Coran les nomme toutes pour les confronter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa manata al-thalithata al-ukhra » — et Manat, la troisième, l'autre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien d'idoles j'ai ? Ai-je identifié toutes mes idoles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La multiplicité des idoles montre l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'idolâtrie prend mille formes mais le tawhid est unique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui identifie toutes ses idoles peut toutes les briser." }
  ],
  munajat: `Ya Ahad, Tu es l'Unique. Aide-moi à identifier toutes mes idoles. Fais que je les brise toutes pour n'avoir que Toi.`
};

MIROIR["53:21"] = {
  reference: "53:21",
  theme: ["justice", "attribution", "fille"],
  emotion: "Indignation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Hakim"],
  mirrorVersion: `« Aurez-vous le garçon et Lui la fille ? » Le miroir me montre l'injustice de l'attribution. « Alakumu al-dhakaru wa lahu al-untha » — aurez-vous le garçon et Lui la fille ? Les Arabes préféraient les garçons et attribuaient les filles à Allah. Le miroir m'invite à examiner mes propres préférences injustes.`,
  reflection: `L'injustice d'attribuer à Allah ce qu'ils méprisaient pour eux-mêmes. La projection de nos préférences sur Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alakumu al-dhakaru wa lahu al-untha » — aurez-vous le garçon et Lui la fille ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attribue à Allah que je ne voudrais pas pour moi ? Quelle est mon injustice cachée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah est au-dessus des attributions humaines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite, nos projections sont imparfaites." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie sa conception d'Allah Le connaît vraiment." }
  ],
  munajat: `Ya Adl, Tu es Juste. Purifie ma conception de Toi. Ne permets pas que je T'attribue ce qui ne convient pas à Ta majesté.`
};

MIROIR["53:22"] = {
  reference: "53:22",
  theme: ["justice", "partage", "équité"],
  emotion: "Vérité, rectification",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Qasit"],
  mirrorVersion: `« Quel partage injuste ! » Le miroir juge l'injustice. « Tilka idhan qismatun diza » — quel partage injuste ! L'attribution des filles à Allah est injuste. Le miroir m'invite à l'équité dans mes jugements.`,
  reflection: `Le partage injuste des Arabes était une insulte à Allah. La justice doit être la base de toutes nos attributions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka idhan qismatun diza » — quel partage injuste !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mes partages sont-ils justes ? Comment je distribue mes jugements, mes faveurs, mes efforts ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice du partage révèle l'injustice du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fondé sur l'équilibre. L'injustice le perturbe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste dans ses partages participe à l'ordre divin." }
  ],
  munajat: `Ya 'Adl, Tu es Juste. Fais que mes partages soient justes. Ne permets pas que je sois injuste dans mes attributions.`
};

MIROIR["53:23"] = {
  reference: "53:23",
  theme: ["noms", "convention", "révélation"],
  emotion: "Discernement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hadi"],
  mirrorVersion: `« Ce ne sont que des noms que vous et vos ancêtres avez inventés. » Le miroir déconstruit les idoles. « In hiya illa asma'un sammaytumuha antum wa aba'ukum » — ce ne sont que des noms que vous avez inventés. Les idoles sont des créations mentales. Le miroir m'invite à vérifier mes croyances.`,
  reflection: `Les idoles sont des noms sans réalité. Les conventions humaines ne créent pas la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In hiya illa asma'un sammaytumuha antum wa aba'ukum » — ce ne sont que des noms que vous et vos ancêtres avez inventés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles conventions je suis aveuglément ? Quels noms j'accepte sans vérification ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les noms humains ne créent pas la réalité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité précède les noms. Les noms doivent suivre la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vérifie ses croyances trouve la vérité." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je vérifie mes croyances. Ne permets pas que je suive des conventions sans fondement.`
};

MIROIR["53:24"] = {
  reference: "53:24",
  theme: ["désir", "intercession", "illusion"],
  emotion: "Discernement, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Ash-Shafi'"],
  mirrorVersion: `« Ils n'ont pour eux aucune autorité. » Le miroir montre l'absence de pouvoir. « Ma lahum min sultanim » — ils n'ont pour eux aucune autorité. Les idoles sont impuissantes. Le miroir m'invite à ne pas compter sur les puissances illusoires.`,
  reflection: `Les idoles n'ont aucun pouvoir réel. Seul Allah a l'autorité suprême.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lahum min sultanim » — ils n'ont pour eux aucune autorité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je compte qui n'a pas de pouvoir réel ? Quelles sont mes idoles impuissantes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pouvoir apparent cache souvent l'impuissance réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul le Créateur a l'autorité. La création est impuissante." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah seul a la vraie puissance." }
  ],
  munajat: `Ya Wali, Tu es le Protecteur. Fais que je ne compte que sur Toi. Ne permets pas que je cherche la protection ailleurs.`
};

MIROIR["53:25"] = {
  reference: "53:25",
  theme: ["intercession", "autorité", "appartenance"],
  emotion: "Vérité, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Malik", "Al-Ghani"],
  mirrorVersion: `« L'intercession n'appartient qu'à Allah. » Le miroir montre le monopole divin. « Lillahi al-shafa'atu jami'an » — l'intercession n'appartient qu'à Allah. L'intercession est divine. Le miroir m'invite à chercher l'intercession auprès d'Allah.`,
  reflection: `L'intercession est un pouvoir divin. Nul n'intercède sans Sa permission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillahi al-shafa'atu jami'an » — l'intercession n'appartient qu'à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Auprès de qui je cherche l'intercession ? Est-ce que je vais directement à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession par d'autres passe par l'intercession d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout retourne à Allah. L'intercession aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'intercession d'Allah la trouve." }
  ],
  munajat: `Ya Malik, l'intercession T'appartient. Fais que je la cherche auprès de Toi. Accorde-moi Ton intercession au Jour du Jugement.`
};

MIROIR["53:26"] = {
  reference: "53:26",
  theme: ["anges", "intercession", "permission"],
  emotion: "Humilité, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Mu'min"],
  mirrorVersion: `« Combien d'anges dans les cieux dont l'intercession ne sert à rien. » Le miroir montre la limite des anges. « Wa kam min malakin fi al-samawati la tughni shafa'atuhum shay'an » — combien d'anges dont l'intercession ne sert à rien. Les anges ont besoin de permission. Le miroir m'invite à comprendre l'ordre divin.`,
  reflection: `Même les anges ne peuvent intercéder sans la permission d'Allah. L'ordre divin est strict.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kam min malakin fi al-samawati la tughni shafa'atuhum shay'an » — combien d'anges dans les cieux dont l'intercession ne sert à rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur des intermédiaires ? Ou est-ce que je vais directement à la Source ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intercession sans permission est impossible. La permission divine est la clé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre divin régit tout, même les anges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obtient la permission divine obtient tout." }
  ],
  munajat: `Ya Rabb, même les anges ont besoin de Ta permission. Fais que je cherche Ta permission avant tout. Accorde-moi l'intercession permise.`
};

MIROIR["53:27"] = {
  reference: "53:27",
  theme: ["anges", "noms", "genre"],
  emotion: "Rectification, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Haqq"],
  mirrorVersion: `« Ceux qui ne croient pas en l'au-delà donnent aux anges des noms de femmes. » Le miroir rectifie la conception. « Inna alladhina la yu'minuna bi-al-akhirati la yusammuna al-mala'ikata tasmiyata al-untha » — ceux qui ne croient pas donnent aux anges des noms de femmes. Les anges ne sont ni hommes ni femmes. Le miroir m'invite à purifier ma conception.`,
  reflection: `Les anges sont des créatures de lumière, sans genre. Les nommer avec des noms féminins est une erreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina la yu'minuna bi-al-akhirati la yusammuna al-mala'ikata tasmiyata al-untha » — ceux qui ne croient pas en l'au-delà donnent aux anges des noms de femmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles conceptions erronées j'ai sur les réalités spirituelles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réalité spirituelle est au-delà des catégories humaines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création spirituelle diffère de la création matérielle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la nature des réalités spirituelles s'approche de la vérité." }
  ],
  munajat: `Ya Rabb, les anges sont Tes serviteurs de lumière. Purifie ma conception d'eux. Ne permets pas que je les imagine selon mes catégories limitées.`
};

MIROIR["53:28"] = {
  reference: "53:28",
  theme: ["connaissance", "ignorance", "conjecture"],
  emotion: "Humilité, véracité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Haqq"],
  mirrorVersion: `« Ils n'ont aucune connaissance de cela. Ils ne suivent que la conjecture. » Le miroir montre l'ignorance. « Ma lahum bihi min 'ilmin in yattabi'una illa al-zann » — ils n'ont aucune connaissance. Ils ne suivent que la conjecture. La conjecture ne remplace pas la connaissance. Le miroir m'invite à la véracité.`,
  reflection: `Suivre la conjecture sans connaissance est dangereux. La vérité nécessite la connaissance, pas l'imagination.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma lahum bihi min 'ilmin in yattabi'una illa al-zann » — ils n'ont aucune connaissance de cela. Ils ne suivent que la conjecture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de mes croyances sont basées sur la conjecture plutôt que la connaissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conjecture est utile comme hypothèse, dangereuse comme certitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est connaissable. La conjecture n'est pas connaissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît vraiment ne conjecture plus." }
  ],
  munajat: `Ya 'Alim, Tu connais tout. Fais que je cherche la connaissance, pas la conjecture. Ne permets pas que je confonde l'imagination avec la vérité.`
};

MIROIR["53:29"] = {
  reference: "53:29",
  theme: ["détournement", "ignorance", "patience"],
  emotion: "Patience, distance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Hakim"],
  mirrorVersion: `« Détourne-toi donc de celui qui tourne le dos à Notre rappel. » Le miroir m'invite au détachement. « Fa a'rid 'an man tawalla 'an dhikrina » — détourne-toi donc de celui qui tourne le dos à Notre rappel. Le détachement des insouciants est nécessaire. Le miroir m'invite à choisir mes fréquentations.`,
  reflection: `Se détourner de ceux qui se détournent d'Allah est une protection. La fréquentation influence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa a'rid 'an man tawalla 'an dhikrina » — détourne-toi donc de celui qui tourne le dos à Notre rappel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je fréquente ? Ces personnes m'approchent-elles d'Allah ou m'en éloignent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement des insouciants est une protection pour le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les associations influencent l'état spirituel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit bien ses compagnons choisit bien son chemin." }
  ],
  munajat: `Ya Sabur, Tu es Patient. Aide-moi à me détourner de ceux qui se détournent de Toi. Donne-moi de bons compagnons.`
};

MIROIR["53:30"] = {
  reference: "53:30",
  theme: ["désir", "limites", "science"],
  emotion: "Compassion, détachement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Voilà la limite de leur science. » Le miroir montre la limitation. « Dhalika mablaghuhum min al-'ilm » — voilà la limite de leur science. Leur connaissance est limitée à leurs désirs. Le miroir m'invite à étendre ma connaissance au-delà de mes désirs.`,
  reflection: `La connaissance limitée par le désir n'est pas vraie connaissance. Elle est projection de soi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika mablaghuhum min al-'ilm » — voilà la limite de leur science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma connaissance est-elle limitée par mes désirs ? Ou s'étend-elle à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie connaissance transcende le désir personnel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance illimitée est celle qui accepte la réalité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît au-delà de ses désirs connaît vraiment." }
  ],
  munajat: `Ya 'Alim, Ta connaissance est illimitée. Étends ma connaissance au-delà de mes désirs. Ne permets pas que je sois limité par ce que je veux croire.`
};

MIROIR["53:31"] = {
  reference: "53:31",
  theme: ["propriété", "univers", "rétribution"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Hakam"],
  mirrorVersion: `« À Allah appartient ce qui est dans les cieux et sur terre. » Le miroir me montre la propriété divine. « Wa lillahi ma fi al-samawati wa ma fi al-ard » — à Allah appartient ce qui est dans les cieux et sur terre. Tout Lui appartient. Le miroir m'invite à reconnaître ma non-propriété.`,
  reflection: `Tout appartient à Allah. Nous sommes des gérants, pas des propriétaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lillahi ma fi al-samawati wa ma fi al-ard » — à Allah appartient ce qui est dans les cieux et sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme mien ? Tout est à Allah. Comment je gère ce qui est à Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la non-propriété libère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît que tout est à Allah est libre de tout." }
  ],
  munajat: `Ya Malik, Tu es le Roi de tout. Fais que je reconnaisse que rien n'est à moi. Aide-moi à bien gérer ce qui T'appartient.`
};

MIROIR["53:33"] = {
  reference: "53:33",
  theme: ["détournement", "avertissement", "comportement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Khabir"],
  mirrorVersion: `« As-tu vu celui qui tourne le dos ? » Le miroir m'interroge sur les détournés. « Afara'ayta alladhi tawalla » — as-tu vu celui qui tourne le dos ? Le détournement d'Allah est un comportement observable. Le miroir m'invite à observer mes propres orientations.`,
  reflection: `Tourner le dos à Allah est un choix visible dans les actes. L'orientation du cœur se voit dans la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afara'ayta alladhi tawalla » — as-tu vu celui qui tourne le dos ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tourne le dos à Allah dans certains domaines ? Qu'est-ce que j'évite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tourner le dos à Allah, c'est se priver de Sa face." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature s'oriente vers son Créateur, sauf l'insouciant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tourne son cœur vers Allah ne peut plus Lui tourner le dos." }
  ],
  munajat: `Ya Basir, Tu vois mes orientations. Fais que je ne Te tourne jamais le dos. Tourne mon cœur vers Toi en tout temps.`
};

MIROIR["53:34"] = {
  reference: "53:34",
  theme: ["avarice", "générosité", "comportement"],
  emotion: "Mise en garde, rectification",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wahhab"],
  mirrorVersion: `« Et donne peu ? » Le miroir montre l'avarice. « Wa a'ta qalilan » — et donne peu. L'avarice est un signe de détournement. Le miroir m'invite à examiner ma générosité.`,
  reflection: `Donner peu est un symptôme spirituel. La générosité est un signe de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa a'ta qalilan » — et donne peu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien je donne ? Est-ce que je suis généreux ou avare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité est le signe d'un cœur rempli d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne abondamment. Le croyant doit faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne beaucoup reçoit beaucoup." }
  ],
  munajat: `Ya Karim, Tu es Généreux. Fais que je sois généreux. Ne permets pas que l'avarice s'installe dans mon cœur.`
};

MIROIR["53:35"] = {
  reference: "53:35",
  theme: ["connaissance", "invisible", "prétention"],
  emotion: "Humilité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Possède-t-il la connaissance de l'invisible ? » Le miroir m'interroge sur la prétention. « A'indahu 'ilmu al-ghaybi fa-hua yara » — possède-t-il la connaissance de l'invisible ? La prétention à tout savoir est fausse. Le miroir m'invite à l'humilité épistémique.`,
  reflection: `Nul ne connaît l'invisible sauf Allah. La prétention est un signe d'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A'indahu 'ilmu al-ghaybi fa-hua yara » — possède-t-il la connaissance de l'invisible pour voir ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prétends savoir ce que je ne sais pas ? L'invisible m'est-il accessible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'ignorance est le début de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invisible est le domaine d'Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît ne pas savoir l'invisible connaît sa limite." }
  ],
  munajat: `Ya 'Alim, Tu connais l'invisible. Fais que je reconnaisse mon ignorance. Ne permets pas que je prétende savoir ce qui m'est caché.`
};

MIROIR["53:36"] = {
  reference: "53:36",
  theme: ["révélation", "écriture", "tradition"],
  emotion: "Vérification, authenticité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kitab", "Al-Munazzil"],
  mirrorVersion: `« Ou bien ne lui a-t-on pas annoncé ce qui est dans les Livres de Musa ? » Le miroir me montre la continuité de la révélation. « Am lum yunabba' bi-ma fi suhufi Musa » — ou bien ne lui a-t-on pas annoncé ce qui est dans les Livres de Musa ? La révélation est continue. Le miroir m'invite à respecter la continuité.`,
  reflection: `La révélation de Musa confirmait déjà la vérité. Le Coran vient confirmer et compléter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lum yunabba' bi-ma fi suhufi Musa » — ou bien ne lui a-t-on pas annoncé ce qui est dans les Livres de Musa ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la continuité de la révélation ? Est-ce que je respecte les livres précédents ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est une, les révélations sont multiples." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le fil continu de la guidance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la continuité reconnaît l'Unité du Révélateur." }
  ],
  munajat: `Ya Munazzil, Tu as révélé à Musa et à Muhammad. Fais que je reconnaisse Ta révélation continue. Ne permets pas que je rejette une partie de Ton message.`
};

MIROIR["53:37"] = {
  reference: "53:37",
  theme: ["révélation", "Ibrahim", "continuité"],
  emotion: "Respect, continuité",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Hanif"],
  mirrorVersion: `« Et d'Ibrahim qui a parfaitement accompli ? » Le miroir me montre Ibrahim. « Wa Ibrahima alladhi waffa » — et d'Ibrahim qui a parfaitement accompli. Ibrahim est le modèle de la soumission parfaite. Le miroir m'invite à suivre son exemple.`,
  reflection: `Ibrahim a accompli parfaitement sa mission. Il est le père des monothéistes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Ibrahima alladhi waffa » — et d'Ibrahim qui a parfaitement accompli." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis l'exemple d'Ibrahim ? Ai-je accompli ma mission ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accomplissement parfait est possible. Ibrahim l'a fait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ibrahim est le père de tous les monothéistes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Ibrahim suit le chemin parfait." }
  ],
  munajat: `Ya Rabb, Ibrahim a parfaitement accompli. Aide-moi à suivre son exemple. Donne-moi la force d'accomplir ma mission.`
};

MIROIR["53:38"] = {
  reference: "53:38",
  theme: ["responsabilité", "charge", "individualité"],
  emotion: "Responsabilité, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Dayyan"],
  mirrorVersion: `« Aucune âme chargée ne portera la charge d'une autre. » Le miroir établit la responsabilité individuelle. « Ala taziru waziratun wizra ukhra » — aucune âme ne portera la charge d'une autre. La responsabilité est personnelle. Le miroir m'invite à assumer ma propre responsabilité.`,
  reflection: `Nul ne peut porter les péchés d'un autre. Chacun est responsable de ses propres actes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala taziru waziratun wizra ukhra » — aucune âme chargée ne portera la charge d'une autre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'assume ma responsabilité ? Ou est-ce que je la rejette sur les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité personnelle est le fondement de la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature répond de ses actes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité trouve la liberté." }
  ],
  munajat: `Ya Hasib, Tu me demanderas des comptes. Fais que j'assume ma responsabilité. Ne permets pas que je la rejette sur les autres.`
};

MIROIR["53:40"] = {
  reference: "53:40",
  theme: ["effort", "récompense", "résultat"],
  emotion: "Espoir, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Ash-Shakur"],
  mirrorVersion: `« Et que l'homme n'obtiendra que ce qu'il a œuvré. » Le miroir établit le lien entre effort et résultat. « Wa an laysa lil-insani illa ma sa'a » — et que l'homme n'obtiendra que ce qu'il a œuvré. Les œuvres déterminent le résultat. Le miroir m'invite à œuvrer pour le meilleur.`,
  reflection: `Le résultat est proportionnel à l'effort. Ce qu'on sème, on récolte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa an laysa lil-insani illa ma sa'a » — et que l'homme n'obtiendra que ce qu'il a œuvré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'œuvre ? Quel résultat je peux attendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La relation entre effort et résultat est juste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne sur le principe de la semence et de la récolte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le meilleur obtient le meilleur." }
  ],
  munajat: `Ya Shakur, Tu récompenses les œuvres. Fais que j'œuvre pour le meilleur. Donne-moi la récompense de mes efforts sincères.`
};

MIROIR["53:41"] = {
  reference: "53:41",
  theme: ["effort", "rétribution", "complétude"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Muhsi", "Al-Jaza'"],
  mirrorVersion: `« Et que son effort sera vu. » Le miroir me montre la visibilité de l'effort. « Wa anna sa'yahu sawfa yura » — et que son effort sera vu. Rien n'est perdu. Le miroir m'invite à œuvrer avec confiance.`,
  reflection: `Tout effort est vu et enregistré. La rétribution est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna sa'yahu sawfa yura » — et que son effort sera vu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille avec la confiance que mon effort sera vu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La visibilité de l'effort est une promesse de justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien dans l'univers n'est perdu. Tout effort compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que son effort est vu œuvre avec excellence." }
  ],
  munajat: `Ya Muhsi, Tu comptes mes efforts. Fais que je travaille avec confiance. Ne permets pas que je me décourage en pensant que mon effort est vain.`
};

MIROIR["53:42"] = {
  reference: "53:42",
  theme: ["retour", "finalité", "appartenance"],
  emotion: "Sérénité, orientation",
  difficulty: "débutant",
  relatedNames: ["Al-Masir", "Al-Muta'ali"],
  mirrorVersion: `« Et que tout aboutit finalement à ton Seigneur. » Le miroir montre la finalité. « Wa anna ila rabbika al-muntaha » — et que tout aboutit finalement à ton Seigneur. Tout retourne à Allah. Le miroir m'invite à orienter ma vie vers cette finalité.`,
  reflection: `La finalité de tout est Allah. Le retour à Lui est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna ila rabbika al-muntaha » — et que tout aboutit finalement à ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience du retour à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour à Allah donne sens à tout le voyage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier retourne à son Origine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit orienté vers le retour arrive bien." }
  ],
  munajat: `Ya Masir, Tu es ma finalité. Fais que je vive orienté vers mon retour à Toi. Ne permets pas que je m'égare en chemin.`
};

MIROIR["53:43"] = {
  reference: "53:43",
  theme: ["joie", "tristesse", "contrôle"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mudi", "Al-Mu'id"],
  mirrorVersion: `« Et que c'est Lui qui fait rire et qui fait pleurer. » Le miroir me montre le contrôle divin des émotions. « Wa annahu huwa adhaka wa abka » — et que c'est Lui qui fait rire et qui fait pleurer. Les émotions viennent d'Allah. Le miroir m'invite à accepter mes émotions.`,
  reflection: `Le rire et les pleurs sont des dons divins. Les accepter comme venant d'Allah apaise.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu huwa adhaka wa abka » — et que c'est Lui qui fait rire et qui fait pleurer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'accepte mes émotions ? Est-ce que je reconnais qu'elles viennent d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les deux états sont des dons divins avec leur sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La joie et la tristesse alternent comme le jour et la nuit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les deux états trouve la paix." }
  ],
  munajat: `Ya Rabb, Tu fais rire et pleurer. Fais que j'accepte mes émotions comme venant de Toi. Donne-moi la sagesse dans les deux états.`
};

MIROIR["53:44"] = {
  reference: "53:44",
  theme: ["vie", "mort", "puissance"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Muhyi"],
  mirrorVersion: `« Et que c'est Lui qui fait mourir et qui fait revivre. » Le miroir me montre le cycle de la vie. « Wa annahu huwa amata wa ahy » — et que c'est Lui qui fait mourir et qui fait revivre. La vie et la mort sont entre Ses mains. Le miroir m'invite à faire confiance au Donneur de vie.`,
  reflection: `La mort et la vie sont des étapes divines. Le Créateur qui donne la vie la reprend et la redonne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu huwa amata wa ahy » — et que c'est Lui qui fait mourir et qui fait revivre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis avec la conscience de la mort ? Est-ce que je fais confiance au Donneur de vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas une fin — c'est une transition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers meurt et renaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mort accepte la vie." }
  ],
  munajat: `Ya Muhyi, Tu donnes la vie et la mort. Fais que j'accepte les deux avec confiance. Donne-moi une vie bénie et une mort paisible.`
};

MIROIR["53:45"] = {
  reference: "53:45",
  theme: ["création", "dualité", "paire"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Et que c'est Lui qui a créé les deux sexes. » Le miroir me montre la dualité de la création. « Wa annahu khalaqa al-zawjayni al-dhakara wa al-untha » — et que c'est Lui qui a créé les deux sexes. La dualité est divine. Le miroir m'invite à respecter la création.`,
  reflection: `La création en paires est un signe divin. Le masculin et le féminin sont des créations divines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa annahu khalaqa al-zawjayni al-dhakara wa al-untha » — et que c'est Lui qui a créé les deux sexes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la dualité de la création ? Comment je traite les différences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dualité est un signe, pas une division." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est créé en paires. La complémentarité est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la dualité comprend l'unité du Créateur." }
  ],
  munajat: `Ya Khaliq, Tu as créé les deux sexes. Fais que je respecte Ta création. Aide-moi à comprendre la sagesse de la dualité.`
};

MIROIR["53:46"] = {
  reference: "53:46",
  theme: ["création", "semence", "origine"],
  emotion: "Humilité, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bari", "Al-Musawwir"],
  mirrorVersion: `« D'une goutte de sperme quand elle est éjaculée. » Le miroir me montre l'humble origine. « Min nutfatin idha tumna » — d'une goutte de sperme quand elle est éjaculée. L'origine est petite, le résultat est grand. Le miroir m'invite à l'humilité.`,
  reflection: `L'être humain vient d'une goutte minuscule. La grandeur du résultat contraste avec la petitesse de l'origine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min nutfatin idha tumna » — d'une goutte de sperme quand elle est éjaculée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon humble origine ? Ou est-ce que je suis orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur vient de la petitesse par la puissance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute grande chose vient d'une petite semence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de son origine reste humble." }
  ],
  munajat: `Ya Bari, Tu m'as créé d'une goutte. Fais que je reste humble. Ne permets pas que j'oublie mon humble origine.`
};

MIROIR["53:47"] = {
  reference: "53:47",
  theme: ["résurrection", "puissance", "promesse"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Mu'id"],
  mirrorVersion: `« Et que c'est à Lui de recréer. » Le miroir me montre la résurrection. « Wa anna 'alayhi al-nash'ata al-ukhra » — et que c'est à Lui de recréer. La résurrection est certaine. Le miroir m'invite à préparer ce retour.`,
  reflection: `Celui qui a créé peut recréer. La résurrection est une promesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna 'alayhi al-nash'ata al-ukhra » — et que c'est à Lui de recréer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la résurrection ? Est-ce que je me prépare pour elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est plus facile que la première création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature meurt et ressuscite chaque année." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection vit différemment." }
  ],
  munajat: `Ya Ba'ith, Tu ressusciteras les morts. Fais que je croie en la résurrection. Prépare-moi pour le jour du retour.`
};

MIROIR["53:48"] = {
