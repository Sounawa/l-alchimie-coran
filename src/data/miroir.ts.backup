MIROIR["55:22"] = {
  reference: "55:22",
  theme: ["perles", "corail", "trésor"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Karim"],
  mirrorVersion: `« De ces deux mers sortent les perles et le corail. » Le miroir me montre les trésors marins. « Yakhruju minhuma al-lu'lu'u wa al-marjan » — de ces deux mers sortent les perles et le corail. Les trésors sont cachés. Le miroir m'invite à chercher les trésors.`,
  reflection: `Les perles et le corail viennent des mers. Les trésors sont cachés dans les profondeurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yakhruju minhuma al-lu'lu'u wa al-marjan » — de ces deux mers sortent les perles et le corail." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels trésors sont cachés dans ma vie ? Est-ce que je cherche les perles spirituelles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perle se forme dans l'obscurité, comme la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les océans cachent des trésors inimaginables." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui plonge profondément trouve les perles." }
  ],
  munajat: `Ya Ghani, Tu caches des trésors. Fais que je cherche les perles spirituelles. Ne permets pas que je reste en surface.`
};

