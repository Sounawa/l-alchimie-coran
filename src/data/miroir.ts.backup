    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche à distinguer le vrai du faux ? La clarté est-elle ma quête ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distinction entre vrai et faux est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges aident à la distinction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la distinction la reçoit." }
  ],
  munajat: `Ya Rabb, aide-moi à distinguer le vrai du faux. Envoie Tes anges pour me guider.`
};

MIROIR["77:5"] = {
