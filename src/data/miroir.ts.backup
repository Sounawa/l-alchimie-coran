  theme: ["faiblesse", "force", "succession"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mustad'afun", "Al-A'imah"],
  mirrorVersion: `« Nous voulons favoriser ceux qui ont été faibles sur terre. » Le miroir me montre le plan d'Allah pour les faibles. « Wa nuridu an namunna 'ala alladhina istud'ifu fi al-ardi » — Nous voulons favoriser ceux qui ont été faibles. La faiblesse n'est pas permanente. Le miroir m'interroge : est-ce que je fais confiance au plan d'Allah ?`,
  reflection: `La faiblesse n'est pas permanente. Faire confiance au plan d'Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nuridu an namunna 'ala alladhina istud'ifu fi al-ardi wa naj'alahum a'immatan » — Nous voulons favoriser ceux qui ont été faibles sur terre et faire d'eux des dirigeants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance au plan d'Allah ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance dans le plan d'Allah transforme la faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les faibles d'aujourd'hui sont les forts de demain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance au plan d'Allah est favorisé." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ton plan. Ne permets pas le doute. Transforme ma faiblesse en force par Ton plan.`
};

MIROIR["28:56"] = {
  reference: "28:56",
  theme: ["guidance", "amour", "volonté"],
  emotion: "Réalité, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Huda", "Al-Mahabbah"],
  mirrorVersion: `« Tu ne guides pas celui que tu aimes, mais c'est Allah qui guide qui Il veut. » Le miroir me montre la réalité de la guidance. « Innaka la tahdi man ahbabta » — tu ne guides pas celui que tu aimes. La guidance est entre les mains d'Allah. Le miroir m'interroge : est-ce que je demande la guidance pour ceux que j'aime ?`,
  reflection: `La guidance est entre les mains d'Allah. La demander pour ceux qu'on aime est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innaka la tahdi man ahbabta walakinna Allaha yahdi man yasha'u » — tu ne guides pas celui que tu aimes, mais c'est Allah qui guide qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la guidance pour ceux que j'aime ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de guidance pour les autres est un acte d'amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est le plus grand don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la guidance pour les autres participe à leur salut." }
  ],
  munajat: `Ya Hadi, je demande la guidance pour ceux que j'aime. Ne permets pas le désespoir. Guide ceux que j'aime vers Toi.`
};

MIROIR["28:77"] = {
  reference: "28:77",
  theme: ["monde", "au-delà", "équilibre"],
  emotion: "Sagesse, équilibre",
  difficulty: "débutant",
  relatedNames: ["Ad-Dunya", "Al-Akhirah"],
  mirrorVersion: `« Recherche ce qu'Allah t'a donné comme demeure dernière, et n'oublie pas ta part de ce monde. » Le miroir me montre l'équilibre entre les deux mondes. « Wa ibtaghi fi ma ataka Allahu al-dara al-akhirata » — recherche ce qu'Allah t'a donné comme demeure dernière. L'équilibre est la clé. Le miroir m'interroge : est-ce que je maintiens l'équilibre entre les deux mondes ?`,
  reflection: `L'équilibre entre les deux mondes est la clé. Le maintenir est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ibtaghi fi ma ataka Allahu al-dara al-akhirata wa la tansa nasibaka mina al-dunya » — recherche ce qu'Allah t'a donné comme demeure dernière, et n'oublie pas ta part de ce monde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je maintiens l'équilibre entre les deux mondes ? Ou est-ce que je penche d'un côté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équilibre est la voie du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce monde et l'au-delà sont deux dons d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maintient l'équilibre réussit dans les deux mondes." }
  ],
  munajat: `Ya Rabb, je maintiens l'équilibre entre les deux mondes. Ne permets pas le déséquilibre. Donne-moi de réussir ici et dans l'au-delà.`
};

MIROIR["28:88"] = {
  reference: "28:88",
  theme: ["invocation", "divinités", "permanence"],
  emotion: "Certitude, adoration",
  difficulty: "débutant",
  relatedNames: ["Ad-Du'a", "Al-Baqi"],
  mirrorVersion: `« N'invoque pas avec Allah une autre divinité. Il n'y a de divinité que Lui. » Le miroir me montre l'exclusivité de l'adoration. « Wa la tad'u ma'a Allahi ilahan akhar » — n'invoque pas avec Allah une autre divinité. L'exclusivité est absolue. Le miroir m'interroge : est-ce que mon invocation est exclusive ?`,
  reflection: `L'exclusivité de l'adoration est absolue. L'observer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tad'u ma'a Allahi ilahan akhar la ilaha illa huwa kullu shay'in halikun illa wajhahu » — n'invoque pas avec Allah une autre divinité. Il n'y a de divinité que Lui. Tout périra sauf Sa Face." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon invocation est exclusive ? Ou est-ce que je l'associe à autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité dans l'invocation purifie le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout périra sauf Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque exclusivement Allah Le rencontre." }
  ],
  munajat: `Ya Rabb, mon invocation est exclusive à Toi. Ne permets pas l'association. Fais que je T'invoque Lui seul.`
};

