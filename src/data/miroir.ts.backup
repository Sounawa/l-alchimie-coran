    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les pieux ? Comment atteindre la piété ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété mène au succès." },
