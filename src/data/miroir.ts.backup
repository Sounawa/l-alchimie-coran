  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Ummah"],
  mirrorVersion: `« Afin que vous ne disiez pas : Le Livre n'a été révélé qu'à deux groupes. » Le miroir prévient : « An taqulu innama unzila al-kitabu 'ala ta'ifatayni » — afin que vous ne disiez pas : Le Livre n'a été révélé qu'à deux groupes. L'excuse de l'exclusion est éliminée. Le miroir m'enseigne : la révélation est pour tous.`,
  reflection: `La révélation est pour tous. L'excuse de l'exclusion est éliminée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An taqulu innama unzila al-kitabu 'ala ta'ifatayni » — afin que vous ne disiez pas : Le Livre n'a été révélé qu'à deux groupes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles excuses j'utilise pour ne pas suivre le Livre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élimination des excuses montre la responsabilité de chacun." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Livre est pour tous les temps et tous les peuples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation du Livre sans excuse est le signe de la foi." }
  ],
  munajat: `Ya Rabb, j'accepte Ton Livre sans excuse. Fais que je le suive complètement. Ne permets pas que je me dérobe.`
};

MIROIR["6:157"] = {
