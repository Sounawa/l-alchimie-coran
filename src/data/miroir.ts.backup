    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla la wazar » — non ! Il n'y a point de refuge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise qu'il n'y a pas de refuge ? Ma préparation est-elle sérieuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La présence d'Allah est le seul refuge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La présence d'Allah est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge en Allah maintenant le trouve alors." }
  ],
  munajat: `Ya Rabb, je cherche refuge en Toi maintenant. Fais que je sois parmi ceux qui trouvent refuge.`
};

