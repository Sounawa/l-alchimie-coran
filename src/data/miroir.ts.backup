    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tamshi fi al-ardi marahan » — ne marche pas sur terre avec arrogance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma démarche est humble ? Ou est-ce que je marche avec orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans la démarche reflète l'humilité du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre appartient à Allah, marcher humblement est un devoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui marche humblement sur terre est élevé auprès d'Allah." }
  ],
  munajat: `Ya Rabb, je veux marcher humblement sur terre. Ne permets pas l'orgueil dans ma démarche. Donne-moi l'humilité dans tout mon être.`
};

MIROIR["17:44"] = {
