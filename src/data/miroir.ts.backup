  theme: ["guide", "livre", "miséricorde"],
  emotion: "Gratitude, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Rahma"],
  mirrorVersion: `« Ou que vous ne disiez : Si un Livre nous avait été révélé, nous aurions été mieux guidés. » Le miroir élimine : « Aw taqulu law anna kitaban unzila 'alayna lakunna ahda minhum » — ou que vous ne disiez : Si un Livre nous avait été révélé, nous aurions été mieux guidés. L'excuse du manque est éliminée. Le miroir m'enseigne : le Livre est là.`,
  reflection: `Le Livre est là. L'excuse du manque est éliminée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw taqulu law anna kitaban unzila 'alayna lakunna ahda minhum » — ou que vous ne disiez : Si un Livre nous avait été révélé, nous aurions été mieux guidés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis « si » au lieu d'agir sur ce que j'ai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Livre présent est suffisant pour la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est complète — aucun manque." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'action sur le présent vaut mieux que le rêve du passé." }
  ],
  munajat: `Ya Rabb, j'ai le Livre. Fais que je l'utilise pour me guider. Ne permets pas que je dise « si ».`
};

MIROIR["6:158"] = {
