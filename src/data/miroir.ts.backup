  theme: ["Salomon", "diables", "plongée"],
  emotion: "Puissance, soumission",
  difficulty: "débutant",
  relatedNames: ["Sulayman", "Ash-Shayatin"],
  mirrorVersion: `« Et parmi les diables, il y en avait qui plongeaient pour lui et faisaient d'autres travaux. » Le miroir me montre l'assujettissement des diables. « Wa mina al-shayatini man yaghussuna lahu » — et parmi les diables, il y en avait qui plongeaient pour lui. Les diables sont assujettis. Le miroir m'interroge : est-ce que je comprends la puissance d'Allah sur toute créature ?`,
  reflection: `Même les diables sont assujettis par Allah. Sa puissance est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-shayatini man yaghussuna lahu wa ya'maluna 'amalan duna dhalik » — et parmi les diables, il y en avait qui plongeaient pour lui et faisaient d'autres travaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la puissance d'Allah sur toute créature ? Ou est-ce que je la limite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les diables sont aussi sous le contrôle d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature est soumise à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la puissance d'Allah ne craint rien d'autre." }
  ],
  munajat: `Ya Rabb, je comprends Ta puissance absolue. Ne permets pas la peur. Montre-moi que toute créature T'est soumise.`
};

MIROIR["21:83"] = {
  reference: "21:83",
  theme: ["Job", "épreuve", "patience"],
  emotion: "Patience, confiance",
  difficulty: "débutant",
  relatedNames: ["Ayyub", "As-Sabr"],
  mirrorVersion: `« Et Job, quand il implora son Seigneur : le mal m'a touché. » Le miroir me montre l'épreuve de Job. « Wa Ayyuba idh nada rabbahu anni massaniya al-durru » — et Job, quand il implora son Seigneur : le mal m'a touché. L'épreuve peut être immense. Le miroir m'interroge : est-ce que j'invoque dans l'épreuve ?`,
  reflection: `Job a été éprouvé et a invoqué Allah. L'invocation dans l'épreuve est la voie du croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Ayyuba idh nada rabbahu anni massaniya al-durru wa anta arhamu al-rahimin » — et Job, quand il implora son Seigneur : le mal m'a touché. Et Tu es le plus Miséricordieux des miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque dans l'épreuve ? Ou est-ce que je me plains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est l'occasion de l'invocation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous été éprouvés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque dans l'épreuve est secouru." }
  ],
  munajat: `Ya Rabb, j'invoque dans mon épreuve. Ne permets pas le désespoir. Secours-moi par Ta miséricorde.`
};

MIROIR["21:84"] = {
  reference: "21:84",
  theme: ["Job", "guérison", "miséricorde"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ayyub", "Ash-Shifa'"],
  mirrorVersion: `« Alors Nous l'exauçâmes et le délivrâmes de son mal. » Le miroir me montre la guérison de Job. « Fa-stajabna lahu » — alors Nous l'exauçâmes. « Fa-kashafna ma bihi min durri » — et Nous délivrâmes de son mal. La guérison vient après l'invocation. Le miroir m'interroge : est-ce que j'attends la guérison avec patience ?`,
