MIROIR["55:41"] = {
  reference: "55:41",
  theme: ["reconnaissance", "criminels", "signes"],
  emotion: "Crainte, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakam"],
  mirrorVersion: `« Les criminels seront reconnus à leurs traits. » Le miroir me montre la reconnaissance par les signes. « Yu'rafu al-mujrimuna bi-simahum » — les criminels seront reconnus à leurs traits. L'apparence trahit l'intérieur. Le miroir m'invite à purifier mon intérieur.`,
  reflection: `Les traits des criminels les trahiront. L'intérieur se reflète sur l'extérieur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yu'rafu al-mujrimuna bi-simahum » — les criminels seront reconnus à leurs traits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon apparence dit de mon intérieur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification de l'intérieur purifie l'apparence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour, rien ne sera caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie son intérieur est reconnu innocent." }
  ],
  munajat: `Ya 'Alim, Tu vois l'intérieur et l'extérieur. Purifie mon cœur. Ne permets pas que mes traits me trahissent comme criminel.`
};

