    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment ? La désobéissance est-elle une option pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment prévient la désobéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour terrible est une réalité pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte saine mène à l'obéissance." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Préserve-moi de la désobéissance. Donne-moi la crainte qui mène à l'obéissance.`
};

MIROIR["39:14"] = {
  reference: "39:14",
  theme: ["religion", "Allah", "exclusivité"],
  emotion: "Engagement, pureté",
  difficulty: "débutant",
  relatedNames: ["Ad-Din", "Al-Ikhlas"],
  mirrorVersion: `« Dis : Allah seul j'adore, en Lui vouant mon culte exclusif. » Le miroir répète le message. L'exclusivité de l'adoration — le message central. Le miroir m'invite à vérifier encore ma religion.`,
  reflection: `Ma religion est-elle pour Allah seul ? Y a-t-il d'autres destinataires ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qula-Allaha a'budu mukhlisan lahu dini » — dis : Allah seul j'adore, en Lui vouant mon culte exclusif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est ma religion ? À Allah seul ou à d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion exclusive pour Allah est la vraie religion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion pour Allah seul est le chemin de tous les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'exclusivité de la religion est la clé du salut." }
  ],
  munajat: `Ya Rabb, ma religion est pour Toi seul. Purifie-la de tout associé. Fais que je T'adore exclusivement.`
};

MIROIR["39:15"] = {
  reference: "39:15",
  theme: ["choix", "idoles", "liberté"],
  emotion: "Liberté, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ikhtiyar", "Al-Awtan"],
  mirrorVersion: `« Adorez ce que vous voulez en dehors de Lui. » Le miroir montre la liberté de choix. Vous êtes libres de choisir vos idoles. Mais les conséquences suivent. Le miroir m'invite à réfléchir sur mon choix.`,
  reflection: `Qu'est-ce que j'adore en dehors d'Allah ? Mon choix est-il éclairé ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'budu ma shi'tum min dunihi » — adorez ce que vous voulez en dehors de Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'adore en dehors d'Allah ? Est-ce que je réalise les conséquences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté de choix implique la responsabilité des conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le choix est universel — les conséquences sont aussi universelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le choix éclairé est celui qui connaît les conséquences." }
  ],
  munajat: `Ya Rabb, je choisis de T'adorer Toi seul. Ne permets pas que je choisisse d'autres dieux. Guide mon choix vers Toi.`
};

MIROIR["39:16"] = {
  reference: "39:16",
  theme: ["protection", "ombres", "feu"],
  emotion: "Mise en garde, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Jawab"],
  mirrorVersion: `« Ils auront des ombres de feu au-dessus d'eux et des feux au-dessous. » Le miroir décrit l'enfer des injustes. Des feux au-dessus et au-dessous — nulle évasion. Le miroir m'avertit : la protection de l'enfer n'est pas pour les injustes.`,
  reflection: `Les injustes n'ont pas de protection. Suis-je juste ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahum min fawqihim zulalun min al-nari wa min tahtihim zulalun » — ils auront des ombres de feu au-dessus d'eux et des feux au-dessous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je suis injuste, quel sera mon sort ? Où sera ma protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection de l'enfer est pour les justes, pas pour les injustes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu entoure les injustes de tous les côtés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La justice est la protection contre le feu." }
  ],
  munajat: `Ya Rabb, préserve-moi du feu. Fais que je sois juste pour être protégé. Ne permets pas que je sois entouré par le feu.`
};

MIROIR["39:17"] = {
  reference: "39:17",
  theme: ["annonces", "taghut", "guidance"],
  emotion: "Espoir, bonnes nouvelles",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bisharah", "Al-Huda"],
  mirrorVersion: `« Annonce la bonne nouvelle à Mes serviteurs qui écoutent la parole et suivent ce qu'elle a de meilleur. » Le miroir annonce la bonne nouvelle. Ceux qui écoutent et suivent le meilleur — ils sont guidés. Le miroir m'invite à cette écoute.`,
  reflection: `Est-ce que j'écoute la parole ? Est-ce que je suis le meilleur ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-ladhina ijtanabu al-taghuta an ya'buduha wa anabu ila-Allahi lahum al-bushra » — et ceux qui évitent le Taghut et ne l'adorent pas, et reviennent à Allah — à eux la bonne nouvelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite le Taghut ? Est-ce que je reviens à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Éviter le Taghut et revenir à Allah — le chemin de la bonne nouvelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La bonne nouvelle est pour ceux qui choisissent Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le retour à Allah est la clé de la bonne nouvelle." }
  ],
  munajat: `Ya Rabb, je veux la bonne nouvelle. J'évite le Taghut et je reviens à Toi. Annonce-moi Ta bonne nouvelle.`
};

MIROIR["39:18"] = {
  reference: "39:18",
  theme: ["écoute", "meilleur", "suivi"],
  emotion: "Attention, guidance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sam'", "Al-Ittiba'"],
  mirrorVersion: `« Ceux qui écoutent la parole et suivent ce qu'elle a de meilleur. » Le miroir montre le critère de la guidance. Écouter et suivre le meilleur — pas n'importe quoi. Le miroir m'invite à ce discernement.`,
  reflection: `Est-ce que je suis le meilleur de ce que j'entends ? Ou est-ce que je suis n'importe quoi ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yastami'una al-qawla fa-yattabi'una ahsanahu » — ceux qui écoutent la parole et suivent ce qu'elle a de meilleur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est le meilleur de ce que j'entends ? Est-ce que je le suis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre le meilleur est le chemin de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le meilleur est ce qu'Allah a choisi — le suivre est la sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le discernement du meilleur est une grâce divine." }
  ],
  munajat: `Ya Rabb, donne-moi le discernement du meilleur. Fais que je suive ce qu'il y a de meilleur. Guide-moi vers le meilleur.`
};

MIROIR["39:19"] = {
  reference: "39:19",
  theme: ["châtiment", "sauvetage", "impossibilité"],
  emotion: "Réalité, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'adhab", "Al-Munji"],
  mirrorVersion: `« Celui contre qui la parole de ton Seigneur s'est réalisée, peux-tu le sauver du feu ? » Le miroir pose la question impossible. Quand le décret divin est prononcé, nul ne peut le changer. Le miroir m'avertit : le temps de la décision est maintenant.`,
  reflection: `Le décret peut être prononcé sur moi. Le temps de la décision est maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-man haqqa 'alayhi al-kalimatu a-anta tunqidhu man fi an-nar » — celui contre qui la parole de ton Seigneur s'est réalisée, peux-tu le sauver du feu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si le décret est prononcé sur moi, qui me sauvera ? Le temps est maintenant." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le décret n'est pas encore prononcé — le repentir est encore possible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret divin est inévitable quand il est prononcé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'urgence du repentir est la clé du salut." }
  ],
  munajat: `Ya Rabb, je me repens avant que le décret ne soit prononcé. Accepte mon repentir maintenant. Ne permets pas que la parole s'accomplisse contre moi.`
};

MIROIR["39:20"] = {
  reference: "39:20",
  theme: ["chambres", "superposition", "grâce"],
  emotion: "Espoir, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghuraf", "Al-Fadl"],
  mirrorVersion: `« Ceux qui craignent leur Seigneur auront des chambres superposées sous lesquelles coulent des rivières. » Le miroir montre la récompense de la crainte. Des chambres superposées — l'élévation pour ceux qui craignent. Le miroir m'invite à cette crainte.`,
  reflection: `La crainte d'Allah élève. Quel niveau de chambres m'attend ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakinna alladhina ittaqaw rabbahum lahum ghurafun min fawqiha ghurafun mabniyatun tajri min tahtiha al-anhar » — mais ceux qui craignent leur Seigneur auront des chambres superposées sous lesquelles coulent des rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains mon Seigneur ? Quel niveau m'attend ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'ici-bas élève là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'élévation au Paradis correspond à la crainte sur terre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte vraie élève au plus haut niveau." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Élève-moi aux chambres les plus hautes. Donne-moi la crainte qui élève.`
};

MIROIR["39:21"] = {
  reference: "39:21",
  theme: ["pluie", "terre", "résurrection"],
  emotion: "Méditation, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Matar", "Al-Ba'th"],
  mirrorVersion: `« Ne vois-tu pas qu'Allah fait descendre l'eau du ciel, puis Il l'infiltre dans la terre ? » Le miroir me montre le signe de la résurrection. L'eau descend, pénètre la terre, fait vivre — comme la résurrection. Le miroir m'invite à méditer sur ce signe.`,
  reflection: `La terre morte revit par l'eau. Le mort revivra par la résurrection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna-Allaha anzala mina as-sama'i maa'an fasalakahu yanabi'a fi al-ard » — ne vois-tu pas qu'Allah fait descendre l'eau du ciel, puis Il l'infiltre dans la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les signes de la résurrection ? La terre morte revit — le mort revivra." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection de la terre annonce la résurrection des corps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de l'eau est un signe universel de la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la nature croit en la résurrection." }
  ],
  munajat: `Ya Rabb, je médite sur Tes signes. La terre morte revit — fais que je croie en la résurrection. Donne-moi la certitude.`
};

// Continuing with Surah 39 remaining verses...

MIROIR["39:23"] = {
  reference: "39:23",
  theme: ["coran", "harmonie", "peau"],
  emotion: "Émerveillement, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Quran", "Al-Tanzil"],
  mirrorVersion: `« Allah a fait descendre le plus beau récit, un Livre dont les versets se ressemblent. » Le miroir me montre l'harmonie du Coran. Les versets se ressemblent, se répètent — la peau de celui qui craint frissonne. Le miroir m'invite à ressentir cette harmonie.`,
  reflection: `Le Coran fait frissonner la peau de celui qui craint. Ma peau frissonne-t-elle ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahu nazzala ahsana al-hadithi kitaban mutashabihan mathaniya taqsha'irru minhu juludu alladhina yakhawna rabbahum » — Allah a fait descendre le plus beau récit, un Livre dont les versets se ressemblent. La peau de ceux qui craignent leur Seigneur frissonne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que le Coran fait frissonner ma peau ? Est-ce que je le ressens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le frissonnement de la peau est le signe de la crainte vivante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'harmonie du Coran reflète l'harmonie de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur vivant réagit au Coran par le frissonnement." }
  ],
  munajat: `Ya Rabb, fais que le Coran fasse frissonner ma peau. Donne-moi la crainte vivante. Ne permets pas que mon cœur s'endurcisse.`
};

MIROIR["39:24"] = {
  reference: "39:24",
  theme: ["protection", "châtiment", "comparaison"],
  emotion: "Mise en garde, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wajh", "Al-Su'"],
  mirrorVersion: `« Celui qui se protégera de son mauvais sort par son visage, contre le châtiment terrible... » Le miroir pose la question rhétorique. Qui voudrait se protéger du feu avec son visage ? Le miroir m'invite à me protéger avant le châtiment.`,
  reflection: `Se protéger du feu avec son visage est impossible. Comment me protéger avant le châtiment ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-man yattaqi bi-wajhihi su'a al-'adhabi yawma al-qiyamah » — celui qui se protégera de son mauvais sort par son visage, contre le châtiment terrible le jour de la résurrection..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je me protège du châtiment ? Avec mon visage ou avec mes œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection avant le châtiment est possible — après, c'est trop tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection du châtiment est l'urgence universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La protection maintenant est le choix du sage." }
  ],
  munajat: `Ya Rabb, je me protège du châtiment maintenant par mes œuvres. Ne permets pas que je doive me protéger avec mon visage. Donne-moi la protection avant le châtiment.`
};

MIROIR["39:25"] = {
  reference: "39:25",
  theme: ["négateurs", "châtiment", "imprévu"],
  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mukadhdhibun", "Al-Ba's"],
  mirrorVersion: `« Ceux qui ont vécu avant eux ont crié au mensonge, et le châtiment les a atteints d'où ils ne le pressentaient pas. » Le miroir avertit : le châtiment peut venir d'où on ne l'attend pas. Les anciens ont nié, le châtiment est venu par surprise. Le miroir m'avertit : l'imprévu peut m'atteindre.`,
  reflection: `Le châtiment peut venir d'où je ne l'attends pas. Comment me préparer ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhaba alladhina min qablihim fa-atiahumu al-'adhabu min haythu la yash'urun » — ceux qui ont vécu avant eux ont crié au mensonge, et le châtiment les a atteints d'où ils ne le pressentaient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nie ? D'où peut venir le châtiment que je n'attends pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'imprévu du châtiment montre l'omniscience d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment peut venir de n'importe quelle direction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation constante est la seule protection." }
  ],
  munajat: `Ya Rabb, je ne veux pas être atteint par l'imprévu. Prépare-moi à tout moment. Ne permets pas que je sois surpris par le châtiment.`
};

// ==================== SURAH 40: GHAFIR - MISSING VERSES ====================

MIROIR["40:5"] = {
  reference: "40:5",
  theme: ["nations", "négation", "résultat"],
  emotion: "Mise en garde, histoire",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Umam", "Al-Takdhib"],
  mirrorVersion: `« Avant eux, le peuple de Noé a traité de mensonge, ainsi que les factions après eux. » Le miroir me montre l'histoire répétée. Nation après nation a nié — le même résultat. Le miroir m'avertit : le schéma se répète.`,
  reflection: `L'histoire se répète. Les nations ont nié — quel sera mon sort ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat qablahum qawmu Nuhin wa al-ahzabun min ba'dihim » — avant eux, le peuple de Noé a traité de mensonge, ainsi que les factions après eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le schéma des négateurs ? Ou est-ce que je crois ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le schéma de la négation mène toujours au même résultat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des nations est une leçon universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, je veux apprendre de l'histoire des nations. Ne permets pas que je répète leurs erreurs. Donne-moi la foi qui sauve.`
};

MIROIR["40:6"] = {
  reference: "40:6",
  theme: ["jugement", "mécréants", "réalisation"],
  emotion: "Certitude, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Hukm", "Al-Kafirun"],
  mirrorVersion: `« Ainsi la parole de ton Seigneur s'est réalisée contre ceux qui ont mécru. » Le miroir affirme la réalisation du décret. La parole d'Allah s'est accomplie contre les mécréants. Le miroir m'avertit : la parole peut s'accomplir contre moi aussi.`,
  reflection: `La parole peut s'accomplir contre moi. Comment l'éviter ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika haqqat kalimatu rabbika 'ala alladhina kafaru annahum ashabu an-nar » — ainsi la parole de ton Seigneur s'est réalisée contre ceux qui ont mécru : ils sont les compagnons du feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La parole s'accomplira-t-elle contre moi ? Suis-je parmi les mécréants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi prévient l'accomplissement de la parole contre soi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah s'accomplit toujours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi sincère est la protection contre l'accomplissement négatif." }
  ],
  munajat: `Ya Rabb, je crois en Toi. Ne permets pas que Ta parole s'accomplisse contre moi. Donne-moi la foi qui sauve.`
};

MIROIR["40:7"] = {
  reference: "40:7",
  theme: ["anges", "prière", "croyants"],
  emotion: "Espoir, intercession",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ikah", "Al-Shafa'ah"],
  mirrorVersion: `« Ceux qui portent le Trône et ceux qui l'entourent célèbrent les louanges de leur Seigneur et croient en Lui. » Le miroir me montre la prière des anges. Ils portent le Trône, célèbrent, et prient pour les croyants. Le miroir m'invite à recevoir cette prière.`,
  reflection: `Les anges prient pour les croyants. Suis-je parmi ceux pour qui ils prient ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yahmiluna al-'arsha wa man hawlahu yusabbihuna bi-hamdi rabbihim wa yu'minuna bihi » — ceux qui portent le Trône et ceux qui l'entourent célèbrent les louanges de leur Seigneur et croient en Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les anges prient pour moi si je suis croyant. Suis-je croyant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière des anges accompagne la foi des croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les alliés des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière angélique est une grâce pour le croyant." }
  ],
  munajat: `Ya Rabb, fais que les anges prient pour moi. Je suis croyant. Accorde-moi leur intercession.`
};

MIROIR["40:8"] = {
  reference: "40:8",
  theme: ["paradis", "prière", "anges"],
  emotion: "Espoir, aspiration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jannah", "Ad-Du'a'"],
  mirrorVersion: `« Seigneur, fais-les entrer aux jardins d'Eden que Tu leur as promis. » Le miroir me montre la prière angélique. Ils demandent le Paradis pour les croyants. Le miroir m'invite à espérer cette réponse.`,
  reflection: `Les anges demandent le Paradis pour moi. Est-ce que j'espère cette réponse ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana wa adkhilhum jannati 'Adnin allati wa'adtahum » — Seigneur, fais-les entrer aux jardins d'Eden que Tu leur as promis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les anges demandent le Paradis pour moi. Est-ce que je travaille pour l'obtenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande angélique est exaucée pour le croyant sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est la destination des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'espérance du Paradis vivifie les œuvres." }
  ],
  munajat: `Ya Rabb, les anges demandent le Paradis pour moi. Exauce leur prière. Fais-moi entrer aux jardins d'Eden.`
};

MIROIR["40:9"] = {
  reference: "40:9",
  theme: ["protection", "corruption", "prière"],
  emotion: "Espoir, supplication",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hifz", "Al-Fasad"],
  mirrorVersion: `« Et préserve-les des mauvaises actions. » Le miroir montre la prière angélique continue. Les anges demandent la préservation du mal. Le miroir m'invite à cette préservation.`,
  reflection: `Les anges demandent ma préservation du mal. Est-ce que je me préserve ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qihim al-sayyi'at » — et préserve-les des mauvaises actions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles mauvaises actions dois-je éviter ? Les anges prient pour moi — est-ce que je coopère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préservation demandée par les anges nécessite ma coopération." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La préservation du mal est la protection universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La coopération avec la prière angélique mène à la préservation." }
  ],
  munajat: `Ya Rabb, préserve-moi des mauvaises actions. Les anges prient pour moi — je coopère. Ne permets pas que je tombe dans le mal.`
};

MIROIR["40:10"] = {
  reference: "40:10",
  theme: ["avertissement", "mécréance", "regret"],
  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nadhir", "Al-Kufr"],
  mirrorVersion: `« Ceux qui ont mécru seront criés : L'aversion d'Allah est plus grande que votre aversion envers vous-mêmes. » Le miroir montre le cri du Jour. L'aversion d'Allah pour la mécréance est immense. Le miroir m'avertit : la mécréance est la pire des choses.`,
  reflection: `L'aversion d'Allah pour la mécréance est immense. Est-ce que je m'éloigne de la mécréance ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru yunadawna la-maqtu-Allahi akbaru min maqtikum anfusakum » — ceux qui ont mécru seront criés : L'aversion d'Allah est plus grande que votre aversion envers vous-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'éloigne de la mécréance ? L'aversion d'Allah pour elle est immense." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aversion d'Allah pour la mécréance montre Sa sainteté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mécréance est la pire des choses dans l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'éloignement de la mécréance est le chemin de l'amour d'Allah." }
  ],
  munajat: `Ya Rabb, je m'éloigne de la mécréance. Ne permets pas que Tu m'aies en aversion. Donne-moi la foi qui plaît à Allah.`
};

MIROIR["40:11"] = {
  reference: "40:11",
  theme: ["mort", "résurrection", "réponse"],
  emotion: "Réalité, admission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mawt", "Al-Ba'th"],
  mirrorVersion: `« Ils diront : Seigneur, Tu nous as fait mourir deux fois et Tu nous as fait revivre deux fois. » Le miroir montre la réalisation des mécréants. La mort et la résurrection — ils comprennent enfin. Le miroir m'avertit : comprendre avant qu'il ne soit trop tard.`,
  reflection: `La mort et la résurrection sont des réalités. Est-ce que je comprends maintenant ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu rabbana amathtana ithnayni wa ahyaytana ithnayni » — ils diront : Seigneur, Tu nous as fait mourir deux fois et Tu nous as fait revivre deux fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la mort et la résurrection maintenant ? Ou est-ce que j'attends le Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Comprendre maintenant est plus précieux que comprendre le Jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mort et la résurrection sont des étapes universelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compréhension anticipée prépare au rendez-vous." }
  ],
  munajat: `Ya Rabb, je comprends la mort et la résurrection maintenant. Ne permets pas que j'attende le Jour pour comprendre. Prépare-moi à ce rendez-vous.`
};

MIROIR["40:12"] = {
  reference: "40:12",
  theme: ["cause", "mécréance", "arrogance"],
  emotion: "Réalisation, regret",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabab", "Al-Kibr"],
  mirrorVersion: `« Cela vous arrive parce que, quand Allah était invoqué seul, vous mécroyiez. » Le miroir montre la cause du châtiment. L'invocation d'Allah seul était refusée. Le miroir m'enseigne : la mécréance a une cause claire.`,
  reflection: `La mécréance a une cause : refuser l'invocation d'Allah seul. Est-ce que j'invoque Allah seul ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalikum bi-annahu idha du'iya-Allahu wahdahu kafartum » — cela vous arrive parce que, quand Allah était invoqué seul, vous mécroyiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah seul ? Ou est-ce que j'ai des associés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation d'Allah seul est la clé du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invocation exclusive est la prière universelle des créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'invocation d'Allah seul ouvre toutes les portes." }
  ],
  munajat: `Ya Rabb, je T'invoque Toi seul. Ne permets pas que j'aie des associés. Fais que mon invocation soit exclusivement pour Toi.`
};


MIROIR["16:91"] = {
  reference: "16:91",
  theme: ["alliance", "serment", "fidélité"],
  emotion: "Engagement, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ahd", "Al-Wafa'"],
  mirrorVersion: `« Soyez fidèles au pacte d'Allah après l'avoir contracté. » Le miroir me montre l'importance de la fidélité. « Awfu bi-'ahdi Allahi » — soyez fidèles au pacte d'Allah. L'alliance avec Allah est sacrée. Le miroir m'interroge : est-ce que je respecte mes alliances ?`,
  reflection: `L'alliance avec Allah est sacrée. La fidélité est une obligation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awfu bi-'ahdi Allahi idha 'ahadtum » — soyez fidèles au pacte d'Allah après l'avoir contracté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte mes alliances ? Ou est-ce que je les romps ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fidélité à l'alliance garantit la protection divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance est le fondement de la relation avec Dieu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte son alliance est respecté par Allah." }
  ],
  munajat: `Ya Rabb, je respecte mon alliance avec Toi. Ne permets pas que je la rompe. Donne-moi la fidélité à mon engagement.`
};

MIROIR["16:92"] = {
  reference: "16:92",
  theme: ["tromperie", "exemple", "serment"],
  emotion: "Mise en garde, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghushsh", "Al-Mathal"],
  mirrorVersion: `« Ne soyez pas comme celle qui défaisait son fil après l'avoir solidement tressé. » Le miroir me montre l'exemple de la tromperie. « Kallati naqadat ghazlahā » — comme celle qui défaisait son fil. Défaire ce qu'on a construit est une tromperie. Le miroir m'interroge : est-ce que je défais mes engagements ?`,
  reflection: `Défaire ce qu'on a construit est une tromperie. La constance est une vertu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la takunu ka-llati naqadat ghazlahā min ba'di quwwatin ankanan » — ne soyez pas comme celle qui défaisait son fil après l'avoir solidement tressé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je défais mes engagements ? Ou est-ce que je les maintiens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance dans l'engagement est la force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'engagement maintenu est une construction solide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maintient ses engagements est fiable." }
  ],
  munajat: `Ya Rabb, je veux maintenir mes engagements. Ne permets pas que je sois comme celle qui défait son fil. Donne-moi la constance.`
};

MIROIR["16:93"] = {
  reference: "16:93",
  theme: ["égarement", "guidance", "volonté"],
  emotion: "Humilité, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Si Allah avait voulu, Il aurait fait de vous une seule communauté. » Le miroir me montre la diversité par volonté divine. « Law sha'a Allahu la-ja'alakum ummatan wahidatan » — si Allah avait voulu, Il aurait fait de vous une seule communauté. La diversité est par la volonté d'Allah. Le miroir m'interroge : est-ce que j'accepte la diversité comme volonté divine ?`,
  reflection: `La diversité est par la volonté d'Allah. L'accepter est une forme de soumission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law sha'a Allahu la-ja'alakum ummatan wahidatan wa lakin yudillu man yasha'u wa yahdi man yasha'u » — si Allah avait voulu, Il aurait fait de vous une seule communauté, mais Il égare qui Il veut et guide qui Il veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la diversité comme volonté divine ? Ou est-ce que je la conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance est un don, l'égarement est une conséquence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La diversité des communautés est une manifestation de la volonté divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la guidance la trouve." }
  ],
  munajat: `Ya Hadi, guide-moi parmi les guidés. Ne permets pas que je sois parmi les égarés. Accepte ma soumission à Ta volonté.`
};

MIROIR["16:94"] = {
  reference: "16:94",
  theme: ["serment", "tromperie", "châtiment"],
  emotion: "Mise en garde, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Yamin", "Al-Talabbus"],
  mirrorVersion: `« Ne prenez pas vos serments comme un moyen de tromperie. » Le miroir me montre l'abus des serments. « La tattakhidhu aymanakum dakhalan » — ne prenez pas vos serments comme un moyen de tromperie. Le serment est sacré, pas un outil de manipulation. Le miroir m'interroge : est-ce que j'utilise mes serments pour tromper ?`,
  reflection: `Le serment est sacré. L'utiliser pour tromper est un grave péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tattakhidhu aymanakum dakhalan baynakum fa-tazilla qadamun ba'da thubutiha » — ne prenez pas vos serments comme un moyen de tromperie, de peur qu'un pied ne trébuche après être fermement établi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise mes serments pour tromper ? Ou est-ce que je les respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le serment respecté construit la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La confiance est le fondement des relations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte ses serments est digne de confiance." }
  ],
  munajat: `Ya Rabb, je respecte mes serments. Ne permets pas que je les utilise pour tromper. Donne-moi la sincérité dans mes engagements.`
};

MIROIR["16:95"] = {
  reference: "16:95",
  theme: ["alliance", "commerce", "valeur"],
  emotion: "Discernement, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Bay'", "Al-'Ahd"],
  mirrorVersion: `« Ne vendez pas le pacte d'Allah à vil prix. » Le miroir me montre la valeur de l'alliance. « La tashtaru bi-'ahdi Allahi thamanan qalilan » — ne vendez pas le pacte d'Allah à vil prix. L'alliance avec Allah est plus précieuse que tout gain matériel. Le miroir m'interroge : est-ce que je vends mon alliance pour un gain temporaire ?`,
  reflection: `L'alliance avec Allah est plus précieuse que tout gain matériel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tashtaru bi-'ahdi Allahi thamanan qalilan » — ne vendez pas le pacte d'Allah à vil prix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vends mon alliance pour un gain temporaire ? Ou est-ce que je la garde précieuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vente de l'alliance est une perte éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance divine n'a pas de prix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son alliance garde tout." }
  ],
  munajat: `Ya Rabb, je garde mon alliance précieuse. Ne permets pas que je la vende pour un gain temporaire. Donne-moi de reconnaître sa valeur.`
};

MIROIR["16:96"] = {
  reference: "16:96",
  theme: ["passage", "permanence", "récompense"],
  emotion: "Espoir, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Fani"],
  mirrorVersion: `« Ce que vous avez s'épuisera, et ce qui est auprès d'Allah durera. » Le miroir me montre la différence entre le temporel et l'éternel. « Ma 'indakum yanfadu » — ce que vous avez s'épuisera. Les biens de ce monde sont temporaires. Le miroir m'interroge : est-ce que j'investis dans l'éternel ou le temporel ?`,
  reflection: `Les biens de ce monde sont temporaires. Ce qui est auprès d'Allah est éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma 'indakum yanfadu wa ma 'inda Allahi baqin » — ce que vous avez s'épuisera, et ce qui est auprès d'Allah durera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'investis dans l'éternel ou le temporel ? Où est mon investissement principal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'investissement dans l'éternel est le seul qui rapporte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout sur terre est temporaire, tout auprès d'Allah est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui investit dans l'éternel possède l'éternité." }
  ],
  munajat: `Ya Baqi, fais que j'investisse dans l'éternel. Ne permets pas que je m'accroche au temporel. Donne-moi la perspective de l'éternité.`
};

MIROIR["16:98"] = {
  reference: "16:98",
  theme: ["protection", "satan", "lecture"],
  emotion: "Vigilance, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'awwidh", "Ash-Shaytan"],
  mirrorVersion: `« Quand tu lis le Coran, demande la protection d'Allah contre Satan le maudit. » Le miroir me montre la protection nécessaire pour la lecture. « Fa-ist'a'dh bi-Allahi » — demande la protection d'Allah. La lecture du Coran attire les perturbations sataniques. Le miroir m'interroge : est-ce que je demande la protection avant de lire ?`,
  reflection: `La protection avant la lecture du Coran est nécessaire. Satan cherche à perturber.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha qara'ta al-qur'ana fa-ist'a'dh bi-Allahi min al-shaytani al-rajim » — quand tu lis le Coran, demande la protection d'Allah contre Satan le maudit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la protection avant de lire le Coran ? Ou est-ce que je lis sans protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection prépare le cœur à recevoir la parole divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole divine attire les perturbations de l'ennemi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se protège avant la lecture reçoit la lumière." }
  ],
  munajat: `Ya Rabb, je demande Ta protection avant de lire Ton Livre. Protège-moi de Satan le maudit. Fais que ma lecture soit pure.`
};

MIROIR["16:99"] = {
  reference: "16:99",
  theme: ["pouvoir", "croyants", "satan"],
  emotion: "Confiance, sécurité",
  difficulty: "débutant",
  relatedNames: ["As-Sultan", "Al-Mu'minun"],
  mirrorVersion: `« Il n'a aucun pouvoir sur ceux qui croient et qui placent leur confiance en leur Seigneur. » Le miroir me montre la limite du pouvoir de Satan. « Innahu laysa lahu sultanun » — il n'a aucun pouvoir. Satan n'a de pouvoir que sur ceux qui ne font pas confiance à Allah. Le miroir m'interroge : est-ce que je place ma confiance en Allah ?`,
  reflection: `Satan n'a de pouvoir que sur ceux qui ne font pas confiance à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu laysa lahu sultanun 'ala alladhina amanu wa 'ala rabbihim yatawakkalun » — il n'a aucun pouvoir sur ceux qui croient et qui placent leur confiance en leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je place ma confiance en Allah ? Ou est-ce que je me fie à moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah est le bouclier contre Satan." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pouvoir de Satan est limité par la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah est protégé." }
  ],
  munajat: `Ya Rabb, je place ma confiance en Toi. Protège-moi de Satan. Ne permets pas qu'il ait un pouvoir sur moi.`
};

MIROIR["16:100"] = {
  reference: "16:100",
  theme: ["pouvoir", "associés", "satan"],
  emotion: "Vigilance, clarté",
  difficulty: "débutant",
  relatedNames: ["Ash-Shaytan", "Ash-Shuraka"],
  mirrorVersion: `« Son pouvoir ne s'exerce que sur ceux qui le prennent pour allié et qui associent d'autres à Allah. » Le miroir me montre les cibles de Satan. « Innama sultanuhu 'ala alladhina yatawallawnahu » — son pouvoir ne s'exerce que sur ceux qui le prennent pour allié. L'alliance avec Satan donne le pouvoir à Satan. Le miroir m'interroge : qui je prends comme allié ?`,
  reflection: `L'alliance avec Satan donne le pouvoir à Satan. L'alliance avec Allah donne la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama sultanuhu 'ala alladhina yatawallawnahu wa alladhina hum bihi mushrikun » — son pouvoir ne s'exerce que sur ceux qui le prennent pour allié et qui associent d'autres à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je prends comme allié ? Satan ou Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance détermine le protecteur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun a le choix de son allié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit Allah comme allié est protégé de Satan." }
  ],
  munajat: `Ya Rabb, je Te prends comme allié. Ne permets pas que je prenne Satan comme allié. Protège-moi de l'alliance avec l'ennemi.`
};

MIROIR["16:101"] = {
  reference: "16:101",
  theme: ["abrogation", "révélation", "science"],
  emotion: "Confiance, soumission",
  difficulty: "avancé",
  relatedNames: ["An-Naskh", "Al-'Ilm"],
  mirrorVersion: `« Quand Nous remplaçons un verset par un autre, ils disent : "Tu n'es qu'un faussaire." » Le miroir me montre l'accusation contre le Prophète. « Baddalna ayatan makan ayatin » — Nous remplaçons un verset par un autre. L'abrogation est une prérogative divine. Le miroir m'interroge : est-ce que j'accepte l'abrogation comme sagesse divine ?`,
  reflection: `L'abrogation est une prérogative divine. Allah sait ce qui est meilleur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha baddalna ayatan makan ayatin wa Allahu a'lamu bima yunazzilu qalu innama anta muftarin » — quand Nous remplaçons un verset par un autre, ils disent : Tu n'es qu'un faussaire. Mais Allah sait mieux ce qu'Il révèle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'abrogation comme sagesse divine ? Ou est-ce que je conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abrogation est une miséricorde, pas une faiblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah révèle selon Sa sagesse infinie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'abrogation accepte la sagesse divine." }
  ],
  munajat: `Ya 'Alim, Tu sais ce qui est meilleur. J'accepte Ton abrogation comme sagesse. Ne permets pas que je conteste Ta révélation.`
};

MIROIR["16:102"] = {
  reference: "16:102",
  theme: ["esprit", "révélation", "confirmation"],
  emotion: "Révérence, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Ruh al-Qudus", "At-Tanil"],
  mirrorVersion: `« Dis : "L'Esprit de sainteté l'a fait descendre de la part de ton Seigneur avec la vérité." » Le miroir me montre l'origine de la révélation. « Nazzalahu ruh al-qudus » — l'Esprit de sainteté l'a fait descendre. Le Coran vient de l'Esprit divin. Le miroir m'interroge : est-ce que je respecte l'origine sacrée du Coran ?`,
  reflection: `Le Coran vient de l'Esprit divin. Son origine est sacrée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul nazzalahu ruh al-qudusi min rabbika bi-al-haqqi » — dis : L'Esprit de sainteté l'a fait descendre de la part de ton Seigneur avec la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte l'origine sacrée du Coran ? Ou est-ce que je le traite comme un livre ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine sacrée exige un respect sacré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Esprit de sainteté est le messager de la révélation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'origine respecte le message." }
  ],
  munajat: `Ya Rabb, je respecte Ton Livre comme révélation de l'Esprit de sainteté. Fais que je le traite avec le respect qu'il mérite.`
};

MIROIR["16:103"] = {
  reference: "16:103",
  theme: ["accusation", "langue", "enseignement"],
  emotion: "Clarté, défense",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Lisan", "At-Ta'lim"],
  mirrorVersion: `« Nous savons qu'ils disent : "Ce n'est qu'un être humain qui l'enseigne." » Le miroir me montre l'accusation des mécréants. « Ma yu'allimuhu bashar » — ce n'est qu'un être humain qui l'enseigne. L'accusation d'enseignement humain est fausse. Le miroir m'interroge : est-ce que je crois que le Coran est d'origine humaine ?`,
  reflection: `Le Coran n'est pas d'origine humaine. Son style et son contenu prouvent son origine divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad na'lamu annahum yaqulunna innama yu'allimuhu bashar » — nous savons qu'ils disent : Ce n'est qu'un être humain qui l'enseigne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que le Coran est d'origine divine ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine divine du Coran est évidente pour celui qui réfléchit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran dépasse la capacité humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'origine divine reconnaît la vérité." }
  ],
  munajat: `Ya Rabb, je crois que le Coran est d'origine divine. Ne permets pas que je doute. Confirme ma foi en Ta révélation.`
};

MIROIR["16:104"] = {
  reference: "16:104",
  theme: ["signes", "non-croyance", "guidance"],
  emotion: "Clarté, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Hidayah"],
  mirrorVersion: `« Ceux qui ne croient pas aux signes d'Allah, Allah ne les guide pas. » Le miroir me montre la conséquence du rejet. « Inna alladhina la yu'minuna bi-ayati Allahi » — ceux qui ne croient pas aux signes d'Allah. Le rejet des signes ferme la porte de la guidance. Le miroir m'interroge : est-ce que je crois aux signes d'Allah ?`,
  reflection: `Le rejet des signes ferme la porte de la guidance. La foi aux signes ouvre la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina la yu'minuna bi-ayati Allahi la yahdihimu Allahu » — ceux qui ne croient pas aux signes d'Allah, Allah ne les guide pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux signes d'Allah ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi aux signes est la condition de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont partout pour ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux signes reçoit la guidance." }
  ],
  munajat: `Ya Rabb, je crois à Tes signes. Guide-moi par Tes signes. Ne permets pas que je les rejette et perde la guidance.`
};

MIROIR["16:105"] = {
  reference: "16:105",
  theme: ["mensonge", "signes", "accusation"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Kadhb", "Al-Ayat"],
  mirrorVersion: `« Seuls ceux qui ne croient pas aux signes d'Allah inventent le mensonge. » Le miroir me montre la source du mensonge. « Innama yaftarī al-kadhiba alladhina la yu'minuna » — seuls ceux qui ne croient pas inventent le mensonge. L'incrédulité pousse au mensonge. Le miroir m'interroge : est-ce que je mens sur Allah ?`,
  reflection: `L'incrédulité pousse au mensonge. La foi protège du mensonge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama yaftarī al-kadhiba alladhina la yu'minuna bi-ayati Allahi » — seuls ceux qui ne croient pas aux signes d'Allah inventent le mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mens sur Allah ? Ou est-ce que je suis véridique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi protège du mensonge sur Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le mensonge sur Allah est le pire mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique sur Allah est honoré." }
  ],
  munajat: `Ya Rabb, je veux être véridique sur Toi. Ne permets pas que je mente. Protège-moi du mensonge sur les signes d'Allah.`
};

MIROIR["16:107"] = {
  reference: "16:107",
  theme: ["préférence", "vie", "punition"],
  emotion: "Mise en garde, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hayat", "Al-Akhirah"],
  mirrorVersion: `« C'est parce qu'ils aiment la vie présente plus que l'au-delà. » Le miroir me montre la cause de l'égarement. « Bi-annahum istahabbu al-hayata al-dunya » — c'est parce qu'ils aiment la vie présente. L'amour de ce monde éclipse l'amour de l'au-delà. Le miroir m'interroge : qu'est-ce que j'aime plus, ce monde ou l'au-delà ?`,
  reflection: `L'amour de ce monde éclipse l'amour de l'au-delà. La préférence détermine le chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-annahum istahabbu al-hayata al-dunya 'ala al-akhirati » — c'est parce qu'ils aiment la vie présente plus que l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'aime plus, ce monde ou l'au-delà ? Où est ma préférence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour de l'au-delà illumine ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce monde est le champ de l'au-delà." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préfère l'au-delà gagne les deux." }
  ],
  munajat: `Ya Rabb, je préfère l'au-delà à ce monde. Ne permets pas que l'amour de ce monde m'éclipse. Donne-moi la préférence pour l'éternité.`
};

MIROIR["16:108"] = {
  reference: "16:108",
  theme: ["sceau", "cœurs", "ouïe"],
  emotion: "Réalité, conséquence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qulub", "Al-Khatam"],
  mirrorVersion: `« Ceux-là dont Allah a scellé les cœurs, l'ouïe et la vue. » Le miroir me montre le sceau divin. « Khatama Allahu 'ala qulubihim » — Allah a scellé leurs cœurs. Le rejet persistant entraîne le sceau. Le miroir m'interroge : est-ce que je préserve mon cœur du rejet ?`,
  reflection: `Le rejet persistant entraîne le sceau. La préservation du cœur est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika alladhina khatama Allahu 'ala qulubihim wa 'ala sam'ihim wa absarihim » — ceux-là dont Allah a scellé les cœurs, l'ouïe et la vue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve mon cœur du rejet ? Ou est-ce que je m'obstine dans le refus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur ouvert reçoit la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sceau est la conséquence du rejet persistant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préserve son cœur du rejet préserve sa guidance." }
  ],
  munajat: `Ya Rabb, préserve mon cœur du sceau. Ne permets pas que je m'obstine dans le rejet. Garde mon cœur ouvert à Ta guidance.`
};

MIROIR["16:109"] = {
  reference: "16:109",
  theme: ["perte", "certitude", "au-delà"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Khasarah", "Al-Yaqin"],
  mirrorVersion: `« Nul doute que dans l'au-delà, ce seront les perdants. » Le miroir me montre le résultat certain. « La jarama anna fi al-akhirati humu al-khasirun » — nul doute que dans l'au-delà, ce seront les perdants. La perte dans l'au-delà est la vraie perte. Le miroir m'interroge : est-ce que je crains d'être parmi les perdants ?`,
  reflection: `La perte dans l'au-delà est la vraie perte. Le gain dans l'au-delà est le vrai gain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La jarama anna fi al-akhirati humu al-khasirun » — nul doute que dans l'au-delà, ce seront les perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains d'être parmi les perdants ? Ou est-ce que je suis confiant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gain dans l'au-delà commence par la foi dans ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perte éternelle est la pire perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la perte dans ce monde évite la perte dans l'au-delà." }
  ],
  munajat: `Ya Rabb, je ne veux pas être parmi les perdants. Fais que je sois parmi les gagnants. Ne permets pas que je perde dans l'au-delà.`
};

MIROIR["16:110"] = {
  reference: "16:110",
  theme: ["épreuve", "migration", "pardon"],
  emotion: "Espoir, réconfort",
  difficulty: "débutant",
  relatedNames: ["Al-Ghafur", "Al-Muhajirun"],
  mirrorVersion: `« Quant à ceux qui ont émigré après avoir été éprouvés. » Le miroir me montre la récompense des migrants éprouvés. « Inna rabbaka min ba'diha » — certes ton Seigneur, après cela. L'émigration après l'épreuve est récompensée. Le miroir m'interroge : est-ce que je suis prêt à émigrer pour ma foi ?`,
  reflection: `L'émigration après l'épreuve est récompensée. Le pardon suit la migration sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma inna rabbaka lilladhina hajaru min ba'di ma futinu » — quant à ceux qui ont émigré après avoir été éprouvés..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à émigrer pour ma foi ? Ou est-ce que je tiens à ma terre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La migration pour Allah mérite le pardon d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'émigration est un sacrifice qui purifie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui émigre pour Allah trouve Allah." }
  ],
  munajat: `Ya Ghafur, je suis prêt à émigrer pour Toi. Pardonne mes fautes. Accepte mon sacrifice pour ma foi.`
};

MIROIR["16:111"] = {
  reference: "16:111",
  theme: ["jour", "âme", "défense"],
  emotion: "Responsabilité, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "An-Nafs"],
  mirrorVersion: `« Le jour où chaque âme viendra défendre ses propres intérêts. » Le miroir me montre la défense individuelle. « Yawma ya'ti kullu nafsin tujadilu 'an nafsiha » — le jour où chaque âme viendra défendre ses propres intérêts. Personne ne défendra pour un autre. Le miroir m'interroge : suis-je prêt à me défendre seul ?`,
  reflection: `Chacun se défendra seul. Personne ne peut prendre la place d'un autre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma ya'ti kullu nafsin tujadilu 'an nafsiha » — le jour où chaque âme viendra défendre ses propres intérêts." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à me défendre seul ? Quel sera mon argument ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La défense individuelle nécessite une préparation individuelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour est le jour de la responsabilité individuelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa défense maintenant sera prêt alors." }
  ],
  munajat: `Ya Rabb, prépare-moi pour ma défense individuelle. Ne permets pas que je sois sans argument. Donne-moi de me défendre avec succès.`
};

MIROIR["16:112"] = {
  reference: "16:112",
  theme: ["cité", "sécurité", "ingratitude"],
  emotion: "Avertissement, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Qaryah", "Al-Aman"],
  mirrorVersion: `« Allah propose une parabole : une cité qui était en sécurité et tranquille. » Le miroir me montre l'exemple de la cité. « Qaryatan kanat aminatan mutma'innatan » — une cité qui était en sécurité et tranquille. La sécurité peut être perdue par l'ingratitude. Le miroir m'interroge : est-ce que je remercie pour la sécurité que je vis ?`,
  reflection: `La sécurité peut être perdue par l'ingratitude. La gratitude préserve la sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa daraba Allahu mathalan qaryatan kanat aminatan mutma'innatan ya'tiha rizquha raghadan » — Allah propose une parabole : une cité qui était en sécurité et tranquille, à qui venait sa subsistance abondante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour la sécurité que je vis ? Ou est-ce que je suis ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude transforme la sécurité en insécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sécurité est un don fragile qui demande la gratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour la sécurité la garde." }
  ],
  munajat: `Ya Rabb, je remercie pour ma sécurité. Ne permets pas que l'ingratitude me la fasse perdre. Préserve ma sécurité par ma gratitude.`
};

MIROIR["16:113"] = {
  reference: "16:113",
  theme: ["messager", "rejet", "destruction"],
  emotion: "Leçon, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "At-Takdhib"],
  mirrorVersion: `« Leur est venu un messager des leurs, et ils l'ont traité de menteur. » Le miroir me montre le rejet du messager. « Ja'ahum rasulun minhum » — leur est venu un messager des leurs. Le rejet du messager entraîne la destruction. Le miroir m'interroge : est-ce que je rejette les messagers d'Allah ?`,
  reflection: `Le rejet du messager entraîne la destruction. L'acceptation du messager apporte la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ja'ahum rasulun minhum fa-kadhdhabuhu fa-akhadhahumu al-'adhabu wa hum zalimun » — leur est venu un messager des leurs, et ils l'ont traité de menteur. Le châtiment les a saisis injustes qu'ils étaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les messagers d'Allah ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation du messager est la sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu un messager." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le messager est sauvé." }
  ],
  munajat: `Ya Rabb, j'accepte Ton messager. Ne permets pas que je le rejette. Fais que je sois parmi ceux qui suivent le messager.`
};

MIROIR["16:114"] = {
  reference: "16:114",
  theme: ["subsistance", "gratitude", "jouissance"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rizq", "Ash-Shukr"],
  mirrorVersion: `« Mangez donc de ce qu'Allah vous a accordé de licite et de bon. » Le miroir me montre la permission de jouir. « Fa-kulu mimma razaqakumu Allahu » — mangez donc de ce qu'Allah vous a accordé. La jouissance du licite est permise avec gratitude. Le miroir m'interroge : est-ce que je remercie pour ce que je mange ?`,
  reflection: `La jouissance du licite est permise avec gratitude. L'interdit n'est pas une option.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kulu mimma razaqakumu Allahu halalan tayyiban washkuru ni'mata Allahi » — mangez donc de ce qu'Allah vous a accordé de licite et de bon, et soyez reconnaissants pour les bienfaits d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ce que je mange ? Ou est-ce que je mange sans gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude sanctifie la nourriture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La subsistance est un don à reconnaître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mange avec gratitude est béni." }
  ],
  munajat: `Ya Razzaq, merci pour ma subsistance. Fais que je mange avec gratitude. Bénis ma nourriture par ma reconnaissance.`
};

MIROIR["16:115"] = {
  reference: "16:115",
  theme: ["interdits", "nourriture", "obligation"],
  emotion: "Obéissance, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haram", "Al-Halal"],
  mirrorVersion: `« Il vous a seulement interdit la bête morte, le sang, la chair de porc et celle sur laquelle on a invoqué un autre qu'Allah. » Le miroir me montre les interdits alimentaires. « Innama harrama 'alaykumu al-maytata » — Il vous a seulement interdit la bête morte. Les interdits sont limités et clairs. Le miroir m'interroge : est-ce que j'évite les interdits ?`,
  reflection: `Les interdits sont limités et clairs. L'obéissance aux interdits est une obligation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama harrama 'alaykumu al-maytata wa al-dama wa lahma al-khinziri wa ma uhilla lighayri Allahi bihi » — Il vous a seulement interdit la bête morte, le sang, la chair de porc et celle sur laquelle on a invoqué un autre qu'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite les interdits ? Ou est-ce que je les consomme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement des interdits purifie le corps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les interdits alimentaires protègent le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite les interdits purifie son âme." }
  ],
  munajat: `Ya Rabb, j'évite Tes interdits. Ne permets pas que je les consomme. Purifie mon corps par l'évitement de l'interdit.`
};

MIROIR["16:116"] = {
  reference: "16:116",
  theme: ["mensonge", "interdiction", "innovation"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kadhb", "At-Tahrim"],
  mirrorVersion: `« Ne dites pas, en usant de mensonges de vos langues : "Ceci est licite et cela est interdit." » Le miroir me montre l'interdiction de l'innovation. « La taqulu li-alsinatikumu al-kadhiba » — ne dites pas, en usant de mensonges de vos langues. Attribuer le licite et l'interdit sans preuve est un mensonge. Le miroir m'interroge : est-ce que j'innove dans la religion ?`,
  reflection: `Attribuer le licite et l'interdit sans preuve est un mensonge. La religion est complète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqulu li-alsinatikumu al-kadhiba hadha halalun wa hadha haramun » — ne dites pas, en usant de mensonges de vos langues : Ceci est licite et cela est interdit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'innove dans la religion ? Ou est-ce que je me réfère à la révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La référence à la révélation protège de l'innovation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion est complète, elle n'a pas besoin d'innovation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la révélation sans innovation est sur la voie droite." }
  ],
  munajat: `Ya Rabb, je ne veux pas innover dans Ta religion. Ne permets pas que j'attribue sans preuve. Guide-moi vers la voie droite.`
};

MIROIR["16:117"] = {
  reference: "16:117",
  theme: ["jouissance", "temporaire", "châtiment"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mata'", "Al-'Adhab"],
  mirrorVersion: `« Une courte jouissance leur est destinée, et un châtiment douloureux les attend. » Le miroir me montre le résultat de l'innovation. « Mata'un qalilun » — une courte jouissance. L'innovation peut donner une jouissance temporaire mais un châtiment éternel. Le miroir m'interroge : est-ce que je préfère la courte jouissance ou l'éternité ?`,
  reflection: `L'innovation donne une courte jouissance et un châtiment éternel. La vérité donne l'éternité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mata'un qalilun wa lahum 'adhabun alim » — une courte jouissance leur est destinée, et un châtiment douloureux les attend." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préfère la courte jouissance ou l'éternité ? Quel est mon choix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La courte jouissance coûte cher." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'éternité vaut plus que la jouissance temporaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit l'éternité sur la jouissance gagne les deux." }
  ],
  munajat: `Ya Rabb, je choisis l'éternité sur la jouissance temporaire. Ne permets pas que je sois trompé par le court terme. Donne-moi la perspective de l'éternité.`
};

MIROIR["16:118"] = {
  reference: "16:118",
  theme: ["juifs", "interdits", "justice"],
  emotion: "Leçon, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Bani Isra'il", "Al-Adl"],
  mirrorVersion: `« Sur ceux qui sont juifs, Nous avons interdit ce que Nous t'avons raconté précédemment. » Le miroir me montre l'histoire des interdits juifs. « 'Ala alladhina hadu » — sur ceux qui sont juifs. Les interdits pour les juifs étaient une punition pour leur injustice. Le miroir m'interroge : est-ce que j'apprends de l'histoire des précédents ?`,
  reflection: `Les interdits pour les juifs étaient une punition pour leur injustice. L'histoire enseigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ala alladhina hadu harramna ma qasasna 'alayka min qablu » — sur ceux qui sont juifs, Nous avons interdit ce que Nous t'avons raconté précédemment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire des précédents ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un enseignement pour ceux qui réfléchissent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les punitions des précédents sont des leçons pour les suivants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire des précédents. Ne permets pas que je l'ignore. Enseigne-moi par l'histoire des peuples passés.`
};

MIROIR["16:119"] = {
  reference: "16:119",
  theme: ["ignorance", "repentir", "pardon"],
  emotion: "Espoir, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-Jahl", "At-Tawbah"],
  mirrorVersion: `« Puis ton Seigneur, pour ceux qui ont fait le mal par ignorance et se sont ensuite repentis. » Le miroir me montre la miséricorde pour les repentis. « Thumma inna rabbaka min ba'di al-zalami » — puis ton Seigneur, pour ceux qui ont fait le mal. Le repentir après l'ignorance est accepté. Le miroir m'interroge : est-ce que je me repends après mes erreurs ?`,
  reflection: `Le repentir après l'ignorance est accepté. La miséricorde suit le repentir sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma inna rabbaka li-lladhina 'amilu al-su'a bi-jahalatin thumma tabu min ba'di dhalika » — puis ton Seigneur, pour ceux qui ont fait le mal par ignorance et se sont ensuite repentis..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repends après mes erreurs ? Ou est-ce que je m'obstine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir sincère efface l'ignorance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est plus vaste que les péchés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent sincèrement est purifié." }
  ],
  munajat: `Ya Tawwab, je me repends de mes erreurs par ignorance. Accepte mon repentir. Purifie-moi par Ta miséricorde.`
};

MIROIR["16:120"] = {
  reference: "16:120",
  theme: ["abraham", "modèle", "soumission"],
  emotion: "Admiration, inspiration",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Ummah"],
  mirrorVersion: `« Abraham était un guide parfait, soumis à Allah. » Le miroir me montre le modèle d'Abraham. « Ibrahim kana ummatan » — Abraham était un guide parfait. La perfection d'Abraham est dans sa soumission. Le miroir m'interroge : est-ce que je suis le modèle d'Abraham ?`,
  reflection: `Abraham est le modèle de la soumission. Le suivre est le chemin de la perfection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Ibrahim kana ummatan qanitan li-Allahi hanifan » — Abraham était un guide parfait, soumis à Allah, voué exclusivement à Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le modèle d'Abraham ? Ou est-ce que je suis d'autres modèles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le modèle d'Abraham est le chemin de la perfection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Abraham est le père des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit Abraham suit la voie droite." }
  ],
  munajat: `Ya Rabb, je veux suivre le modèle d'Abraham. Donne-moi sa soumission. Fais que je sois sur sa voie.`
};

MIROIR["16:121"] = {
  reference: "16:121",
  theme: ["gratitude", "élection", "guidance"],
  emotion: "Reconnaissance, inspiration",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Muhta"],
  mirrorVersion: `« Reconnaissant pour Ses bienfaits, Allah l'a élu et guidé vers un chemin droit. » Le miroir me montre le résultat de la gratitude d'Abraham. « Shakiran li-an'umihi » — reconnaissant pour Ses bienfaits. La gratitude mène à l'élection et à la guidance. Le miroir m'interroge : est-ce que je suis reconnaissant pour les bienfaits ?`,
  reflection: `La gratitude mène à l'élection et à la guidance. Abraham a été élu par sa gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Shakiran li-an'umihi ijtabahu wa hadahu ila siratin mustaqim » — reconnaissant pour Ses bienfaits, Allah l'a élu et guidé vers un chemin droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour les bienfaits ? Ou est-ce que je suis ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude ouvre la porte de l'élection divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gratitude est la clé de la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant est élu et guidé." }
  ],
  munajat: `Ya Shakur, je suis reconnaissant pour Tes bienfaits. Élis-moi et guide-moi comme Tu as élu et guidé Abraham.`
};

MIROIR["16:122"] = {
  reference: "16:122",
  theme: ["bienfait", "vie", "au-delà"],
  emotion: "Espoir, réconfort",
  difficulty: "débutant",
  relatedNames: ["Al-Hasanah", "Al-Mahy"],
  mirrorVersion: `« Et Nous lui avons accordé une belle récompense dans ce monde, et il sera dans l'au-delà parmi les vertueux. » Le miroir me montre la récompense d'Abraham. « Wa ataynahu fi al-dunya hasanah » — et Nous lui avons accordé une belle récompense dans ce monde. La récompense d'Abraham est dans les deux mondes. Le miroir m'interroge : est-ce que je cherche la récompense dans les deux mondes ?`,
  reflection: `La récompense d'Abraham est dans les deux mondes. La fidélité donne la belle récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ataynahu fi al-dunya hasanatan wa innahu fi al-akhirati la-mina al-salihin » — et Nous lui avons accordé une belle récompense dans ce monde, et il sera dans l'au-delà parmi les vertueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la récompense dans les deux mondes ? Ou est-ce que je me limite à un seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La récompense dans les deux mondes est le don des fidèles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les fidèles reçoivent dans ce monde et l'au-delà." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est fidèle reçoit la belle récompense." }
  ],
  munajat: `Ya Rabb, je cherche la belle récompense dans les deux mondes. Donne-moi comme Tu as donné à Abraham. Fais que je sois parmi les vertueux.`
};

MIROIR["16:123"] = {
  reference: "16:123",
  theme: ["inspiration", "abraham", "monothéisme"],
  emotion: "Guidance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Hanif"],
  mirrorVersion: `« Puis Nous t'avons révélé : "Suis la religion d'Abraham, qui était voué exclusivement à Allah." » Le miroir me montre la continuation de la religion d'Abraham. « Ittabi' millata Ibrahim » — suis la religion d'Abraham. Le Prophète reçoit l'ordre de suivre Abraham. Le miroir m'interroge : est-ce que je suis la religion d'Abraham ?`,
  reflection: `Le Prophète reçoit l'ordre de suivre Abraham. La religion d'Abraham est le monothéisme pur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma awhayna ilayka ani ittabi' millata Ibrahim hanifan » — puis Nous t'avons révélé : Suis la religion d'Abraham, qui était voué exclusivement à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la religion d'Abraham ? Ou est-ce que je suis une autre voie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La religion d'Abraham est la voie droite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le monothéisme est la religion de tous les prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la religion d'Abraham suit la voie droite." }
  ],
  munajat: `Ya Rabb, je suis la religion d'Abraham. Ne permets pas que je m'écarte de sa voie. Donne-moi le monothéisme pur.`
};

MIROIR["16:124"] = {
  reference: "16:124",
  theme: ["sabbat", "différend", "punition"],
  emotion: "Leçon, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabt", "Al-Jidal"],
  mirrorVersion: `« Le Sabbat n'a été prescrit qu'à ceux qui divergeaient à son sujet. » Le miroir me montre l'histoire du Sabbat. « Innama ju'ila al-sabtu 'ala alladhina ikhtalafu » — le Sabbat n'a été prescrit qu'à ceux qui divergeaient. Le différend sur le Sabbat a entraîné sa prescription stricte. Le miroir m'interroge : est-ce que je diverge sur les prescriptions d'Allah ?`,
  reflection: `Le différend sur les prescriptions entraîne leur renforcement. L'acceptation évite la contrainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama ju'ila al-sabtu 'ala alladhina ikhtalafu fihi » — le Sabbat n'a été prescrit qu'à ceux qui divergeaient à son sujet." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je diverge sur les prescriptions d'Allah ? Ou est-ce que je les accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des prescriptions évite la contrainte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prescriptions divines sont des miséricordes pour ceux qui les acceptent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les prescriptions les trouve légères." }
  ],
  munajat: `Ya Rabb, j'accepte Tes prescriptions. Ne permets pas que je diverge sur elles. Fais que je les accepte avec soumission.`
};

MIROIR["16:126-127"] = {
  reference: "16:126-127",
  theme: ["patience", "représailles", " pardon"],
  emotion: "Sérénité, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabr", "Al-'Adl"],
  mirrorVersion: `« Si vous punissez, infligez une punition égale au tort subi. Mais si vous patientez, c'est meilleur pour ceux qui patientent. » Le miroir me montre le choix entre représailles et patience. « Wa in sabartum » — mais si vous patientez. La patience est supérieure à la représaille. Le miroir m'interroge : est-ce que je choisis la patience ou la représaille ?`,
  reflection: `La patience est supérieure à la représaille. Le pardon avec patience est le chemin des meilleurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in 'aqabtum fa'aqibu bi-mithli ma uqibtum bihi wa in sabartum lahuwa khayrun li-al-sabirin » — si vous punissez, infligez une punition égale au tort subi. Mais si vous patientez, c'est meilleur pour ceux qui patientent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis la patience ou la représaille ? Quel est mon choix face au tort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience transforme le tort en opportunité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La patience est la vertu des meilleurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente reçoit la meilleure récompense." }
  ],
  munajat: `Ya Rabb, donne-moi la patience face aux torts. Ne permets pas que je choisisse la représaille. Fais que je sois parmi les patients.`
};

// ==================== SURAH 7: AL-A'RAF - VERSETS 44-53 ====================

MIROIR["7:44"] = {
  reference: "7:44",
  theme: ["paradis", "enfer", "appel"],
  emotion: "Contraste, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jannah", "Al-Jahannam"],
  mirrorVersion: `« Les gens du Paradis crieront aux gens du Feu : Nous avons trouvé vrai ce que notre Seigneur nous avait promis. » Le miroir contraste : « Wa nada ashabu al-jannati ashaba al-nar » — les gens du Paradis crieront aux gens du Feu. L'appel entre paradis et enfer. Le miroir m'enseigne : la vérité de la promesse sera manifeste.`,
  reflection: `La vérité de la promesse sera manifeste. Ai-je trouvé vrai ce qu'Allah a promis ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nada ashabu al-jannati ashaba al-nar » — les gens du Paradis crieront aux gens du Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où serai-je ? Paradis ou enfer ? Ai-je cru à la promesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse trouvée vraie au paradis est trouvée vraie aussi en enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est toujours vraie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi en la promesse maintenant assure la reconnaissance plus tard." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les gens du paradis qui crient aux gens du feu. Fais que je trouve vrai ce que Tu as promis.`
};

MIROIR["7:45"] = {
  reference: "7:45",
  theme: ["obstacle", "chemin", "égarement"],
  emotion: "Condamnation, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sadd", "Al-Sabil"],
  mirrorVersion: `« Ceux qui obstruent le chemin d'Allah et cherchent à le rendre tortueux. » Le miroir condamne : « Alladhina yasudduna 'an sabili Allahi wa yabghunaha 'iwajan » — ceux qui obstruent le chemin d'Allah et cherchent à le rendre tortueux. L'obstruction et la déviation sont condamnées. Le miroir m'enseigne : le chemin d'Allah doit rester clair.`,
  reflection: `Le chemin d'Allah doit rester clair. Est-ce que j'obstrue ou je facilite ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yasudduna 'an sabili Allahi wa yabghunaha 'iwajan » — ceux qui obstruent le chemin d'Allah et cherchent à le rendre tortueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obstrue le chemin d'Allah ? Est-ce que je le dévie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obstruction du chemin d'Allah mène à l'enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah est droit — la déviation vient des hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui facilite le chemin d'Allah est facilité." }
  ],
  munajat: `Ya Rabb, je ne veux pas obstruer Ton chemin. Fais que je le facilite. Ne permets pas que je sois parmi les obstruants.`
};

MIROIR["7:46"] = {
  reference: "7:46",
  theme: ["voile", "mur", "limite"],
  emotion: "Séparation, attente",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hijab", "Al-Sur"],
  mirrorVersion: `« Il y aura un voile entre eux. » Le miroir sépare : « Wa baynahuma hijab » — il y aura un voile entre eux. La séparation entre paradis et enfer est absolue. Le miroir m'enseigne : le destin est définitif.`,
  reflection: `Le destin est définitif. Quel sera mon côté du voile ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa baynahuma hijab » — il y aura un voile entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel sera mon côté du voile ? Paradis ou enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile sépare pour l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La séparation est éternelle — le choix se fait maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le choix du côté se fait par les actions sur terre." }
  ],
  munajat: `Ya Rabb, fais que je sois du côté du paradis. Ne permets pas que le voile me sépare de la miséricorde.`
};

MIROIR["7:47"] = {
  reference: "7:47",
  theme: ["regard", "reconnaissance", "gratitude"],
  emotion: "Reconnaissance, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nazar", "Al-Ma'rifah"],
  mirrorVersion: `« Quand leur regard se portera vers les gens du Feu, ils diront : Seigneur, ne nous mets pas avec les gens injustes. » Le miroir prie : « Idha ra'awhum qalu rabbana la taj'alna ma'a al-qawmi al-zalimin » — quand leur regard se portera vers les gens du Feu, ils diront : Seigneur, ne nous mets pas avec les gens injustes. La peur de l'enfer persiste même au paradis. Le miroir m'enseigne : la gratitude est éternelle.`,
  reflection: `La gratitude est éternelle. Est-ce que je remercie Allah de m'avoir préservé ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha ra'awhum qalu rabbana la taj'alna ma'a al-qawmi al-zalimin » — quand leur regard se portera vers les gens du Feu, ils diront : Seigneur, ne nous mets pas avec les gens injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie Allah pour la protection de l'enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vue de l'enfer augmente la gratitude pour le paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gratitude est la réponse naturelle à la délivrance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude maintenant prépare la gratitude éternelle." }
  ],
  munajat: `Ya Rabb, préserve-moi d'être avec les injustes. Fais que je sois reconnaissant pour la protection de l'enfer.`
};

MIROIR["7:48"] = {
  reference: "7:48",
  theme: ["appel", "reconnaissance", "regret"],
  emotion: "Réalité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nida'", "Al-Ma'rifah"],
  mirrorVersion: `« Les gens du voile appelleront des hommes qu'ils reconnaîtront par leurs traits. » Le miroir identifie : « Wa nada ashabu al-a'raf » — les gens du voile appelleront. La reconnaissance des visages. Le miroir m'enseigne : les traits révèlent le destin.`,
  reflection: `Les traits révèlent le destin. Quels sont mes traits ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nada ashabu al-a'raf rijalan ya'rifunahum bi-simahum » — les gens du voile appelleront des hommes qu'ils reconnaîtront par leurs traits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont mes traits ? Que révèle mon visage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les traits du visage reflètent les traits du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le visage est le miroir du cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La beautification du cœur beautifie le visage." }
  ],
  munajat: `Ya Rabb, beautifie mon cœur pour que mon visage reflète la foi. Ne permets pas que mes traits me trahissent.`
};

MIROIR["7:49"] = {
  reference: "7:49",
  theme: ["promesse", "moquerie", "réalisation"],
  emotion: "Réalité, ironie",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wa'd", "Al-Tahawwur"],
  mirrorVersion: `« Ceux dont vous juriez qu'Allah ne leur donnerait jamais miséricorde. » Le miroir ironise : « Ha'ula'i alladhina aqsamtum » — ceux dont vous juriez. La moquerie se retourne contre les moqueurs. Le miroir m'enseigne : nul ne connaît le destin final.`,
  reflection: `Nul ne connaît le destin final. Qui ai-je jugé à tort ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha'ula'i alladhina aqsamtum la yanaluhumu Allahu bi-rahmah » — ceux dont vous juriez qu'Allah ne leur donnerait jamais miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui ai-je jugé à tort ? Ai-je juré qu'Allah ne les sauverait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement des hommes n'est pas le jugement d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah surpasse tout jugement humain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne juge pas n'est pas jugé." }
  ],
  munajat: `Ya Rabb, ne permets pas que je juge les autres. Fais que je comprenne que Ta miséricorde surpasse tout.`
};

MIROIR["7:50"] = {
  reference: "7:50",
  theme: ["enfer", "eau", "refus"],
  emotion: "Supplication, désespoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ma'", "Al-Radd"],
  mirrorVersion: `« Les gens du Feu crieront aux gens du Paradis : Déversez sur nous de l'eau. » Le miroir supplie : « Wa nada ashabu al-nar ashaba al-jannah » — les gens du Feu crieront aux gens du Paradis. La demande d'eau est refusée. Le miroir m'enseigne : les occasions manquées ne reviennent pas.`,
  reflection: `Les occasions manquées ne reviennent pas. Quelles occasions ai-je manquées ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« An afidu 'alayna min al-ma'i » — déversez sur nous de l'eau." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je manqué ? Qu'est-ce qui ne reviendra plus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau refusée est l'occasion manquée sur terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau du paradis n'est pas pour les habitants de l'enfer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'eau bue avec gratitude sur terre devient l'eau du paradis." }
  ],
  munajat: `Ya Rabb, fais que je ne manque pas les occasions. Fais que je profite de l'eau maintenant. Ne permets pas que je demande en vain plus tard.`
};

MIROIR["7:51"] = {
  reference: "7:51",
  theme: ["distraction", "jeu", "oubli"],
  emotion: "Regret, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaflah", "Al-La'ib"],
  mirrorVersion: `« Ceux qui ont pris leur religion comme distraction et jeu. » Le miroir condamne : « Alladhina ittakhadhu dinahum lahwan wa la'iban » — ceux qui ont pris leur religion comme distraction et jeu. La religion n'est pas un jeu. Le miroir m'enseigne : la religion est sérieuse.`,
  reflection: `La religion est sérieuse. Est-ce que je prends ma religion au sérieux ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina ittakhadhu dinahum lahwan wa la'iban » — ceux qui ont pris leur religion comme distraction et jeu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends ma religion au sérieux ? Ou est-ce un jeu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jeu avec la religion mène à la perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion est le chemin de la vie — pas un divertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sérieux dans la religion assure le sérieux de la récompense." }
  ],
  munajat: `Ya Rabb, fais que je prenne ma religion au sérieux. Ne permets pas que je la traite comme un jeu. Donne-moi le sérieux dans l'adoration.`
};

MIROIR["7:52"] = {
  reference: "7:52",
  theme: ["livre", "détail", "guidance"],
  emotion: "Guidance, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Tafs"],
  mirrorVersion: `« Nous leur avons apporté un Livre que Nous avons détaillé en toute connaissance. » Le miroir guide : « Wa laqad ji'nahum bi-kitabin fassalnahu 'ala 'ilmin » — nous leur avons apporté un Livre que Nous avons détaillé en toute connaissance. Le Coran est détaillé et complet. Le miroir m'enseigne : la guidance est complète.`,
  reflection: `La guidance est complète. Est-ce que je lis le Coran détaillé ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ji'nahum bi-kitabin fassalnahu 'ala 'ilmin » — nous leur avons apporté un Livre que Nous avons détaillé en toute connaissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran détaillé ? Est-ce que je cherche la guidance complète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détail du Coran montre l'attention d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran contient tout ce dont l'homme a besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La lecture détaillée du Coran révèle les secrets de la vie." }
  ],
  munajat: `Ya Rabb, fais que je lise Ton Livre détaillé. Donne-moi la compréhension de la guidance complète. Ne permets pas que je néglige le Coran.`
};

MIROIR["7:53"] = {
  reference: "7:53",
  theme: ["attente", "réalisation", "véracité"],
  emotion: "Espoir, réalisation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Intizar", "Al-Tahqiq"],
  mirrorVersion: `« Attendent-ils seulement sa réalisation ? » Le miroir questionne : « Hal yanzuruna illa ta'wilahu » — attendent-ils seulement sa réalisation ? L'attente de la réalisation est vaine si on ne croit pas. Le miroir m'enseigne : la foi doit précéder la réalisation.`,
  reflection: `La foi doit précéder la réalisation. Est-ce que je crois avant de voir ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal yanzuruna illa ta'wilahu » — attendent-ils seulement sa réalisation ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois avant de voir ? Ou est-ce que j'attends la preuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réalisation confirmera ce qui était cru ou nié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est vraie avant et après la réalisation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi sans voir est la foi la plus pure." }
  ],
  munajat: `Ya Rabb, je crois avant de voir. Fais que ma foi soit pure. Ne permets pas que j'attende la réalisation pour croire.`
};

// ==================== SURAH 7: AL-A'RAF - VERSETS MANQUANTS ====================

MIROIR["7:56"] = {
  reference: "7:56",
  theme: ["corruption", "terre", "invocation"],
  emotion: "Révérence, espoir",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "Al-Khawf"],
  mirrorVersion: `« Ne semez pas la corruption sur terre après qu'elle ait été mise en ordre. » Le miroir m'avertit : « Wa la tufsidu fi al-ardi ba'da islahiha » — ne semez pas la corruption sur terre après qu'elle ait été mise en ordre. La corruption annule l'ordre divin. Le miroir m'enseigne : la préservation de l'ordre est un devoir. « Et invoquez-Le avec crainte et espoir » — la dualité de l'invocation entre peur et espérance équilibre le cœur.`,
  reflection: `La corruption détruit l'ordre divin. L'invocation équilibre crainte et espoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tufsidu fi al-ardi ba'da islahiha wa ad'uhu khawfan wa tama'an » — ne semez pas la corruption sur terre après qu'elle ait été mise en ordre. Et invoquez-Le avec crainte et espoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve l'ordre ou je corromps ? Comment est mon invocation — équilibrée ou extrême ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La corruption de l'ordre est le désordre du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre a été créée en ordre — la corruption vient de l'homme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'invocation équilibrée entre crainte et espoir est la plus sincère." }
  ],
  munajat: `Ya Rabb, je préserve Ton ordre sur terre. Ne permets pas que je corrompe. Équilibre mon invocation entre crainte et espoir.`
};

MIROIR["7:57"] = {
  reference: "7:57",
  theme: ["vents", "miséricorde", "résurrection"],
  emotion: "Espérance, foi",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "Al-Ba'th"],
  mirrorVersion: `« C'est Lui qui envoie les vents comme annonceurs de Sa miséricorde. » Le miroir me montre les signes de la miséricorde : « Wa huwa alladhi yursilu al-riyaha bushran bayna yaday rahmatihi » — c'est Lui qui envoie les vents comme annonceurs de Sa miséricorde. Les vents annoncent la pluie, la pluie annonce la vie. « Jusqu'à ce que Nous fassions sortir la vie de ce qui est mort » — la résurrection est comme la sortie de la vie de la terre morte.`,
  reflection: `Les signes de la miséricorde précèdent la miséricorde. La résurrection est une création nouvelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi yursilu al-riyaha bushran bayna yaday rahmatihi hatta idha aqallat sahaban thiqlan » — c'est Lui qui envoie les vents comme annonceurs de Sa miséricorde, jusqu'à ce que les nuages portent une lourde charge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont les vents qui annoncent la miséricorde dans ma vie ? Est-ce que je reconnais les signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort qui précède la vie est le chemin de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de l'eau annonce le cycle de la résurrection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les signes reconnaît le Signataire." }
  ],
  munajat: `Ya Rahman, envoie Tes vents de miséricorde sur mon cœur mort. Fais sortir la vie de ce qui est mort en moi. Ressuscite-moi comme Tu ressuscites la terre.`
};

MIROIR["7:58"] = {
  reference: "7:58",
  theme: ["terre", "végétation", "parabole"],
  emotion: "Réflexion, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Balad", "An-Nabat"],
  mirrorVersion: `« La bonne terre produit sa végétation avec la permission d'Allah. » Le miroir compare : « Wa al-baladu al-tayyibu yakhruju nabatuhu bi-idhni rabbihi » — la bonne terre produit sa végétation avec la permission d'Allah. Le cœur bon produit la foi. « Celle qui est mauvaise ne produit que peu » — le cœur mauvais produit peu de bien. La parabole de la terre s'applique au cœur.`,
  reflection: `Le cœur est comme la terre — bon ou mauvais. La production spirituelle dépend de la qualité du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-baladu al-tayyibu yakhruju nabatuhu bi-idhni rabbihi wa alladhi khabuthu la yakhruju illa nakidan » — la bonne terre produit sa végétation avec la permission d'Allah, et celle qui est mauvaise ne produit que peu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la qualité de mon cœur ? Produit-il abondamment ou chichement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La qualité du cœur détermine la qualité des actions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre et le cœur suivent la même loi : ce qui est semé est récolté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La bonne terre du cœur est préparée par la purification." }
  ],
  munajat: `Ya Rabb, purifie mon cœur pour qu'il soit une bonne terre. Fais qu'il produise abondamment avec Ta permission. Ne permets pas qu'il soit mauvais et stérile.`
};

MIROIR["7:59"] = {
  reference: "7:59",
  theme: ["Noé", "monothéisme", "avertissement"],
  emotion: "Appel, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Nuh", "Al-Tawhid"],
  mirrorVersion: `« Nous avons envoyé Noé à son peuple : Ô mon peuple, adorez Allah. » Le miroir rappelle : « Laqad arsalna Nuhan ila qawmihi » — Nous avons envoyé Noé à son peuple. Le message de tous les prophètes est le même : le monothéisme. « Vous n'avez pas de divinité en dehors de Lui » — l'unicité est l'essentiel. « Je crains pour vous le châtiment d'un jour terrible » — l'avertissement précède le châtiment.`,
  reflection: `Le message prophétique est universel : l'unicité d'Allah. L'avertissement est un acte de miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad arsalna Nuhan ila qawmihi an u'budu Allaha ma lakum min ilahin ghayruhu inni akhafu 'alaykum 'adhaba yawmin 'azim » — Nous avons envoyé Noé à son peuple : Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui. Je crains pour vous le châtiment d'un jour terrible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah seul ? Ou est-ce que j'ai d'autres divinités dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement du prophète est la miséricorde d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes ont apporté le même message : l'unicité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte du châtiment pousse vers le repentir." }
  ],
  munajat: `Ya Rabb, j'adore Allah seul. Ne permets pas que j'aie d'autres divinités. Protège-moi du châtiment du jour terrible par Ton unicité.`
};

MIROIR["7:60"] = {
  reference: "7:60",
  theme: ["rejet", "égarement", "mécréance"],
  emotion: "Tristesse, constat",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'", "Al-Dalal"],
  mirrorVersion: `« Les notables de son peuple dirent : Nous te voyons dans un égarement manifeste. » Le miroir constate : « Qala al-mala'u min qawmihi » — les notables de son peuple dirent. Le rejet des notables est constant dans l'histoire prophétique. « Nous te voyons dans un égarement manifeste » — l'accusation d'égarement contre le guide. Le miroir m'enseigne : la vérité est souvent accusée d'égarement par les égarés.`,
  reflection: `Le rejet du message par les notables est une constante. L'accusation d'égarement contre le guide révèle l'égarement des accusateurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala al-mala'u min qawmihi inna naraka fi dalalin mubin » — les notables de son peuple dirent : Nous te voyons dans un égarement manifeste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que j'accuse les autres d'égarement ? Suis-je moi-même égaré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation d'égarement est souvent le signe de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les notables rejettent souvent le message qui menace leur statut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sur la vérité n'a pas besoin de l'approbation des notables." }
  ],
  munajat: `Ya Rabb, ne permets pas que je rejette Ton message. Fais que je reconnaisse la vérité même quand elle vient de l'imprévu. Préserve-moi de l'égarement.`
};

MIROIR["7:61"] = {
  reference: "7:61",
  theme: ["réponse", "guidance", "sincérité"],
  emotion: "Confiance, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Nas"],
  mirrorVersion: `« Il dit : Ô mon peuple, il n'y a pas d'égarement en moi. » Le miroir répond : « Qala ya qawmi laysa bi dalalah » — il dit : Ô mon peuple, il n'y a pas d'égarement en moi. La réponse du prophète est claire et directe. « Je suis un messager du Seigneur des mondes » — l'affirmation de sa mission. Le miroir m'enseigne : la clarté du message vient de la clarté de la source.`,
  reflection: `La réponse du prophète est ferme et claire. L'affirmation de la mission divine ne nécessite pas de justification.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ya qawmi laysa bi dalalah wa lakinni rasulun min rabbi al-'alamin » — il dit : Ô mon peuple, il n'y a pas d'égarement en moi, mais je suis un messager du Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis clair sur ma mission dans la vie ? Ou est-ce que je suis confus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté de la source produit la clarté du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Seigneur des mondes envoie des messagers pour tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de sa mission donne la force face au rejet." }
  ],
  munajat: `Ya Rabb, donne-moi la clarté de ma mission. Fais que je sois ferme comme les prophètes. Ne permets pas la confusion sur mon chemin.`
};

MIROIR["7:62"] = {
  reference: "7:62",
  theme: ["transmission", "sincérité", "connaissance"],
  emotion: "Engagement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Tabligh", "Al-Nasihah"],
  mirrorVersion: `« Je vous transmet les messages de mon Seigneur et je vous conseille sincèrement. » Le miroir engage : « Uballighukum risalati rabbi » — je vous transmet les messages de mon Seigneur. La transmission est le devoir du messager. « Et je vous conseille sincèrement » — le conseil sincère est l'essence de la prophétie. « Je sais d'Allah ce que vous ne savez pas » — la connaissance prophétique dépasse la connaissance commune.`,
  reflection: `La transmission et le conseil sincère sont les deux devoirs du messager. La connaissance divine est la source de son enseignement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uballighukum risalati rabbi wa ansahu lakum wa a'lamu mina Allahi ma la ta'lamun » — je vous transmet les messages de mon Seigneur, je vous conseille sincèrement, et je sais d'Allah ce que vous ne savez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transmets ce que je reçois ? Mon conseil est-il sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le conseil sincère vient de l'amour, pas de l'arrogance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance divine est infiniment plus vaste que la connaissance humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le conseil sincère est la plus haute forme d'amour." }
  ],
  munajat: `Ya Rabb, aide-moi à transmettre Ton message. Rends mon conseil sincère. Donne-moi de Ta connaissance ce qui me guide.`
};

MIROIR["7:63"] = {
  reference: "7:63",
  theme: ["étonnement", "rappel", "miséricorde"],
  emotion: "Questionnement, réveil",
  difficulty: "débutant",
  relatedNames: ["Al-Ta'ajjub", "Al-Tadhkirah"],
  mirrorVersion: `« Vous étonnez-vous qu'un rappel vous vienne de votre Seigneur ? » Le miroir questionne : « Awa'ajibtum an ja'atkum dhikrun min rabbikum » — vous étonnez-vous qu'un rappel vous vienne de votre Seigneur ? L'étonnement face au rappel est absurde. « Par un homme parmi vous pour vous avertir » — le messager est un homme comme eux. « Et pour que vous craigniez Allah » — la crainte est le but. « Peut-être serez-vous touchés par la miséricorde » — la miséricorde est l'espoir.`,
  reflection: `Le rappel vient d'Allah par un homme. La crainte mène à la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa'ajibtum an ja'atkum dhikrun min rabbikum 'ala rajulin minkum li-yundhirakum wa li-tattaqu la'allakum turhamun » — vous étonnez-vous qu'un rappel vous vienne de votre Seigneur, par un homme parmi vous, pour vous avertir et que vous craigniez Allah, peut-être serez-vous touchés par la miséricorde ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'étonne du rappel d'Allah ? Ou est-ce que je l'accueille naturellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement face au rappel révèle l'éloignement du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rappel est une miséricorde, pas une punition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte d'Allah ouvre la porte de Sa miséricorde." }
  ],
  munajat: `Ya Rabb, je ne m'étonne pas de Ton rappel. Je l'accueille avec reconnaissance. Fais que je craigne Allah pour que sa miséricorde m'atteigne.`
};

MIROIR["7:64"] = {
  reference: "7:64",
  theme: ["traitement", "sauvetage", "noyade"],
  emotion: "Tragédie, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Takdhib", "Al-Najat"],
  mirrorVersion: `« Ils le traitèrent de menteur. Alors Nous le sauvâmes, lui et ceux qui étaient avec lui dans l'arche. » Le miroir juge : « Fa-kadhdhabuhu » — ils le traitèrent de menteur. Le traitement de menteur est le sort du prophète. « Et Nous noyâmes ceux qui traitaient Nos signes de mensonges » — le châtiment suit le rejet. « Ils étaient un peuple aveugle » — l'aveuglement précède la destruction.`,
  reflection: `Le rejet du message mène au châtiment. Le salut est pour ceux qui croient et suivent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kadhdhabuhu fa-anjaynahu wa ma ma'ahu fi al-fulki wa aghraqna alladhina kadhdhabu bi-ayatina innahum kanu qawman 'amin » — ils le traitèrent de menteur. Alors Nous le sauvâmes, lui et ceux qui étaient avec lui dans l'arche. Et Nous noyâmes ceux qui traitaient Nos signes de mensonges. Ils étaient un peuple aveugle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite les signes d'Allah de mensonges ? Ou est-ce que je crois et suis sauvé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le traitement de menteur contre le prophète révèle le mensonge du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arche du salut est pour les croyants, pas pour les négateurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'aveuglement du cœur précède la destruction du corps." }
  ],
  munajat: `Ya Rabb, je ne traite pas Tes signes de mensonges. Je crois et je veux être sauvé. Fais que je monte dans l'arche du salut. Ne permets pas que je sois parmi les aveugles.`
};

MIROIR["7:65"] = {
  reference: "7:65",
  theme: ["Hud", "Âd", "monothéisme"],
  emotion: "Appel, avertissement",
  difficulty: "débutant",
  relatedNames: ["Hud", "Al-'Ad"],
  mirrorVersion: `« Et aux Âd, leur frère Hud. » Le miroir envoie : « Wa ila 'adin akhahum Hudan » — et aux Âd, leur frère Hud. Hud est leur frère, pas un étranger. « Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui » — le message est le même. « Ne Le craignez-vous pas ? » — la question qui interpelle.`,
  reflection: `Le prophète est le frère de son peuple. Le message du monothéisme est universel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ila 'adin akhahum Hudan an u'budu Allaha ma lakum min ilahin ghayruhu afala tattaqun » — et aux Âd, leur frère Hud : Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui. Ne Le craignez-vous pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le prophète comme frère ? Est-ce que je comprends son message ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fraternité du prophète avec son peuple est un honneur pour le peuple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message du monothéisme a été apporté à tous les peuples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La crainte d'Allah est le début de la sagesse." }
  ],
  munajat: `Ya Rabb, je reçois Ton message avec reconnaissance. Je n'ai pas d'autre divinité que Toi. Donne-moi la crainte qui mène à la sagesse.`
};

MIROIR["7:66"] = {
  reference: "7:66",
  theme: ["notables", "rejet", "accusation"],
  emotion: "Opposition, arrogance",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'", "Al-Kadhdhab"],
  mirrorVersion: `« Les notables de son peuple qui ne croyaient pas dirent : Nous te voyons plein de sottise. » Le miroir oppose : « Qala al-mala'u alladhina kafaru min qawmihi » — les notables de son peuple qui ne croyaient pas dirent. Le rejet des notables est systématique. « Nous te voyons plein de sottise et nous te croyons menteur » — l'accusation double : sottise et mensonge.`,
  reflection: `Les notables qui ne croient pas accusent le prophète de sottise et de mensonge. L'arrogance ferme les yeux sur la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala al-mala'u alladhina kafaru min qawmihi inna naraka fi safahatin wa inna la-zannuka mina al-kadhdhibin » — les notables de son peuple qui ne croyaient pas dirent : Nous te voyons plein de sottise et nous te croyons menteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que j'accuse les autres de sottise ? Est-ce que je reconnais la vérité ou je la rejette par arrogance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de sottise révèle la sottise de l'accusateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les notables s'opposent souvent au message qui menace leur position." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traite les prophètes de menteurs est lui-même le menteur." }
  ],
  munajat: `Ya Rabb, je ne veux pas être arrogant. Ouvre mes yeux à la vérité. Ne permets pas que j'accuse Tes messagers de sottise ou de mensonge.`
};

MIROIR["7:67"] = {
  reference: "7:67",
  theme: ["réponse", "sagesse", "messager"],
  emotion: "Clarté, assurance",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-'Aql"],
  mirrorVersion: `« Ô mon peuple, il n'y a pas de sottise en moi. » Le miroir répond : « Ya qawmi laysa bi safahah » — ô mon peuple, il n'y a pas de sottise en moi. La réponse est directe et claire. « Mais je suis un messager du Seigneur des mondes » — l'affirmation de sa mission. Le miroir m'enseigne : la vérité n'a pas besoin de s'excuser.`,
  reflection: `La réponse du prophète est ferme et digne. L'affirmation de sa mission divine est sans équivoque.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ya qawmi laysa bi safahah wa lakinni rasulun min rabbi al-'alamin » — il dit : Ô mon peuple, il n'y a pas de sottise en moi. Mais je suis un messager du Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réponds avec clarté quand on m'accuse ? Ou est-ce que je m'excuse injustement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeté dans la vérité n'est pas de l'arrogance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le messager du Seigneur des mondes parle avec l'autorité de sa mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La dignité du messager vient de la dignité de Celui qui l'envoie." }
  ],
  munajat: `Ya Rabb, donne-moi la clarté et la fermeté de Tes prophètes. Fais que je parle avec dignité. Ne permets pas que je sois confus sur ma mission.`
};

MIROIR["7:68"] = {
  reference: "7:68",
  theme: ["transmission", "conseil", "connaissance"],
  emotion: "Sincérité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Risalah", "Al-Amanah"],
  mirrorVersion: `« Je vous transmets les messages de mon Seigneur et je suis pour vous un conseiller fidèle. » Le miroir engage : « Uballighukum risalati rabbi » — je vous transmets les messages de mon Seigneur. La transmission est le premier devoir. « Et je suis pour vous un conseiller fidèle » — le conseil fidèle accompagne la transmission. Le miroir m'enseigne : la parole vraie doit être accompagnée du conseil sincère.`,
  reflection: `La transmission du message et le conseil fidèle vont ensemble. Le prophète est à la fois messager et conseiller.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Uballighukum risalati rabbi wa ana lakum nasihun amin » — je vous transmets les messages de mon Seigneur et je suis pour vous un conseiller fidèle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transmets ce que je reçois ? Mon conseil est-il fidèle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le conseil fidèle vient de la fidélité au message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le conseiller fidèle est celui qui veut le bien pour les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fidélité dans le conseil reflète la fidélité à Allah." }
  ],
  munajat: `Ya Rabb, rends-moi fidèle dans la transmission et le conseil. Fais que je veuille le bien pour les autres. Ne permets pas la trahison dans ma parole.`
};

MIROIR["7:69"] = {
  reference: "7:69",
  theme: ["étonnement", "guidance", "rappel"],
  emotion: "Questionnement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Huda", "Al-Ni'mah"],
  mirrorVersion: `« Vous étonnez-vous qu'un rappel vous vienne de votre Seigneur par un homme parmi vous ? » Le miroir questionne à nouveau : « Awa'ajibtum an ja'atkum dhikrun min rabbikum 'ala rajulin minkum » — vous étonnez-vous qu'un rappel vous vienne de votre Seigneur par un homme parmi vous ? L'étonnement est déplacé. « Pour qu'il vous avertisse » — l'avertissement est une miséricorde. « Et rappelez-vous quand Il vous a fait successeurs après le peuple de Noé » — le rappel des bienfaits passés renforce la gratitude.`,
  reflection: `Le rappel par un homme est une miséricorde, pas un étonnement. Les bienfaits passés sont des signes pour le présent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awa'ajibtum an ja'atkum dhikrun min rabbikum 'ala rajulin minkum li-yundhirakum wa udhkuru idh ja'alakum khulafa'a min ba'di qawmi Nuh » — vous étonnez-vous qu'un rappel vous vienne de votre Seigneur par un homme parmi vous, pour qu'il vous avertisse ? Et rappelez-vous quand Il vous a fait successeurs après le peuple de Noé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits passés dois-je me rappeler ? Est-ce que je reconnais les signes dans ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel des bienfaits passés produit la gratitude présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération succède à la précédente avec ses bienfaits et ses responsabilités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour les bienfaits passés attire de nouveaux bienfaits." }
  ],
  munajat: `Ya Rabb, je me rappelle Tes bienfaits passés. Je ne m'étonne pas de Ton rappel. Fais que je sois reconnaissant pour la guidance.`
};

MIROIR["7:70"] = {
  reference: "7:70",
  theme: ["divinités", "abandon", "condition"],
  emotion: "Exigence, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Alihah", "Al-Tawhid"],
  mirrorVersion: `« Ils dirent : Es-tu venu à nous pour que nous adorions Allah seul et que nous abandonnions ce que nos ancêtres adoraient ? » Le miroir dénonce : « A-ji'tana li-na'buda Allaha wahdahu » — es-tu venu à nous pour que nous adorions Allah seul ? L'accusation contient la vérité. « Et que nous abandonnions ce que nos ancêtres adoraient ? » — l'attachement aux traditions remplace l'attachement à la vérité. « Fais-nous venir ce dont tu nous menaces, si tu es du nombre des véridiques » — le défi précipite le châtiment.`,
  reflection: `La vérité exige l'abandon des fausses divinités. Le défi face au prophète précipite le jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu a-ji'tana li-na'buda Allaha wahdahu wa natruka ma ya'budu aba'una fa'tina bi-ma ta'iduna in kunta mina al-sadiqin » — ils dirent : Es-tu venu à nous pour que nous adorions Allah seul et que nous abandonnions ce que nos ancêtres adoraient ? Fais-nous venir ce dont tu nous menaces, si tu es du nombre des véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je n'abandonne pas par attachement aux traditions ? Est-ce que je défie Allah ou je me soumets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abandon des fausses divinités est le prix du monothéisme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les traditions des ancêtres ne sont pas une excuse pour refuser la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le défi face à la vérité est le signe de l'aveuglement." }
  ],
  munajat: `Ya Rabb, j'abandonne les fausses divinités pour T'adorer seul. Ne permets pas que je m'attache aux traditions au détriment de la vérité. Je ne Te défie pas, je me soumets.`
};

MIROIR["7:71"] = {
  reference: "7:71",
  theme: ["châtiment", "ignorance", "promesse"],
  emotion: "Avertissement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Al-Wa'd"],
  mirrorVersion: `« Il dit : Vous êtes frappés de malédiction et de colère de la part de votre Seigneur. » Le miroir avertit : « Qad waqa'at 'alaykum min rabbikum rijsun wa ghadab » — vous êtes frappés de malédiction et de colère de la part de votre Seigneur. Le rejet du message attire la colère. « Allez-vous disputer avec moi au sujet de noms que vous avez inventés ? » — les idoles ne sont que des noms vides. « Attendez ! Je suis avec vous parmi ceux qui attendent » — l'attente du châtiment est la dernière chance.`,
  reflection: `Le rejet du message attire la colère divine. Les idoles ne sont que des noms sans réalité. L'attente précède le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala qad waqa'at 'alaykum min rabbikum rijsun wa ghadabun a-tujadilunani fi asmain sammaytumuha antum wa aba'ukum ma nazzala Allahu biha min sultani intaziru inni ma'akum mina al-muntazirin » — il dit : Vous êtes frappés de malédiction et de colère de la part de votre Seigneur. Allez-vous disputer avec moi au sujet de noms que vous avez inventés, vous et vos ancêtres ? Allah n'a fait descendre aucune preuve pour eux. Attendez ! Je suis avec vous parmi ceux qui attendent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels noms vides disputent avec la vérité dans ma vie ? Suis-je en attente du châtiment ou du repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les noms inventés n'ont aucune réalité devant Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les idoles sont des créations humaines sans pouvoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attente du châtiment est le moment du repentir possible." }
  ],
  munajat: `Ya Rabb, je ne dispute pas avec Toi au sujet de noms vides. Je me repends avant le châtiment. Ne permets pas que je sois parmi les attentes de la colère.`
};

MIROIR["7:72"] = {
  reference: "7:72",
  theme: ["sauvetage", "destruction", "victoire"],
  emotion: "Justice, délivrance",
  difficulty: "débutant",
  relatedNames: ["Al-Najat", "Al-Halak"],
  mirrorVersion: `« Alors Nous le sauvâmes, lui et ceux qui étaient avec lui, par une miséricorde de Notre part. » Le miroir sauve : « Fa-anjaynahu wa ma ma'ahu bi-rahmatin minna » — alors Nous le sauvâmes, lui et ceux qui étaient avec lui, par une miséricorde de Notre part. Le salut est une miséricorde, pas un mérite. « Et Nous exterminâmes ceux qui traitaient Nos signes de mensonges » — la destruction suit le rejet. « Ils n'étaient pas croyants » — la conclusion est claire.`,
  reflection: `Le salut vient de la miséricorde d'Allah. La destruction suit le rejet des signes. La foi distingue les sauvés des détruits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anjaynahu wa ma ma'ahu bi-rahmatin minna wa qata'na dhabira alladhina kadhdhabu bi-ayatina wa ma kanu mu'minin » — alors Nous le sauvâmes, lui et ceux qui étaient avec lui, par une miséricorde de Notre part. Et Nous exterminâmes ceux qui traitaient Nos signes de mensonges. Ils n'étaient pas croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je avec les sauvés ou avec les détruits ? Ma foi est-elle vraie ou superficielle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le salut est un don, pas un droit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde sauve ceux qui croient, la justice détruit ceux qui rejettent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie foi est le seul critère du salut." }
  ],
  munajat: `Ya Rahman, sauve-moi par Ta miséricorde. Je crois en Tes signes. Ne permets pas que je sois exterminé avec ceux qui traitent Tes signes de mensonges.`
};

MIROIR["7:73"] = {
  reference: "7:73",
  theme: ["Salih", "Thamoud", "chamelle"],
  emotion: "Appel, signe",
  difficulty: "débutant",
  relatedNames: ["Salih", "Thamud", "Al-Naqah"],
  mirrorVersion: `« Et aux Thamoud, leur frère Salih. » Le miroir envoie : « Wa ila Thamuda akhahum Salihan » — et aux Thamoud, leur frère Salih. Un autre prophète, un autre peuple. « Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui » — le message est éternel. « Une preuve vous est venue de votre Seigneur : la chamelle d'Allah » — le signe visible. « Laissez-la manger sur la terre d'Allah » — le respect du signe.`,
  reflection: `Le message prophétique est universel. Le signe de la chamelle est un test de foi et de respect.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ila Thamuda akhahum Salihan an u'budu Allaha ma lakum min ilahin ghayruhu qad ja'atkum bayyinatun min rabbikum hadhihi naqatu Allahi lakum ayatan fa-dharuha ta'kul fi ardi Allahi wa la tamassuha bi-su'in fa-ya'khudhakum 'adhabun alim » — et aux Thamoud, leur frère Salih : Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui. Une preuve vous est venue de votre Seigneur : voici la chamelle d'Allah, un signe pour vous. Laissez-la manger sur la terre d'Allah et ne lui faites pas de mal, sinon un châtiment douloureux vous saisira." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes Allah a-t-Il mis dans ma vie ? Est-ce que je les respecte ou je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe d'Allah demande respect, pas négligence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple reçoit des signes adaptés à sa compréhension." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le respect des signes d'Allah est le respect d'Allah Lui-même." }
  ],
  munajat: `Ya Rabb, je respecte Tes signes. Je n'ai pas d'autre divinité que Toi. Préserve-moi du châtiment douloureux par mon respect de ce qui T'appartient.`
};

MIROIR["7:74"] = {
  reference: "7:74",
  theme: ["rappel", "bienfaits", "gratitude"],
  emotion: "Souvenance, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Tadhkirah", "Al-Ni'mah"],
  mirrorVersion: `« Et rappelez-vous quand Il vous a fait successeurs après les Âd. » Le miroir rappelle : « Wa udhkuru idh ja'alakum khulafa'a min ba'di 'Ad » — et rappelez-vous quand Il vous a fait successeurs après les Âd. La succession est un bienfait. « Et qu'Il vous a installés sur terre » — l'installation est un don. « Construisez des châteaux dans les plaines et taillez des maisons dans les montagnes » — la capacité de construction est un don. « Souvenez-vous des bienfaits d'Allah » — le devoir de gratitude.`,
  reflection: `La succession et l'installation sur terre sont des bienfaits. La capacité de construire est un don. La gratitude est le devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa udhkuru idh ja'alakum khulafa'a min ba'di 'Ad wa bawwa'akum fi al-ardi tattakhidhuna min suduriha qusuran wa tanhituna al-jibala buyutan fa-dhkuru ala Allahi wa la ta'thaw fi al-ardi mufsidin » — et rappelez-vous quand Il vous a fait successeurs après les Âd, et qu'Il vous a installés sur terre. Vous avez construit des châteaux dans les plaines et taillé des maisons dans les montagnes. Souvenez-vous des bienfaits d'Allah et ne semez pas la corruption sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits dois-je me rappeler ? Est-ce que je suis reconnaissant ou je corromps ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude pour les bienfaits passés attire les bienfaits futurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est un successeur sur terre avec des responsabilités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel des bienfaits est la protection contre l'ingratitude." }
  ],
  munajat: `Ya Rabb, je me rappelle Tes bienfaits. Merci de m'avoir installé sur terre. Je ne veux pas corrompre. Fais que je sois reconnaissant.`
};

MIROIR["7:75"] = {
  reference: "7:75",
  theme: ["notables", "faibles", "orgueil"],
  emotion: "Arrogance, division",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'", "Al-Mustad'afun"],
  mirrorVersion: `« Les notables de son peuple qui s'enflaient d'orgueil dirent à ceux qui étaient faibles et opprimés parmi ceux qui avaient cru. » Le miroir divise : « Qala al-mala'u alladhina istakbaru min qawmihi » — les notables de son peuple qui s'enflaient d'orgueil dirent. L'orgueil divise. « À ceux qui avaient cru parmi les faibles » — la foi est souvent chez les humbles. « Savez-vous que Salih est envoyé par son Seigneur ? » — la question rhétorique. « Ils dirent : Nous croyons à ce avec quoi il a été envoyé » — la foi des faibles.`,
  reflection: `L'orgueil des notables les aveugle. La foi est souvent chez les humbles et les faibles. La vérité transcende les classes sociales.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala al-mala'u alladhina istakbaru min qawmihi lilladhina istud'ifu liman amana minhum a-ta'lamuna anna Salihan mursalun min rabbihi qalu inna bima ursila bihi mu'minun » — les notables de son peuple qui s'enflaient d'orgueil dirent à ceux qui étaient faibles parmi ceux qui avaient cru : Savez-vous que Salih est envoyé par son Seigneur ? Ils dirent : Nous croyons à ce avec quoi il a été envoyé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'orgueil m'aveugle ? Est-ce que je reconnais la foi chez les humbles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi des faibles est souvent plus pure que la foi des puissants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité ne dépend pas du statut social." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'orgueil ferme la porte de la foi." }
  ],
  munajat: `Ya Rabb, guéris-moi de l'orgueil. Ouvre mes yeux à la foi des humbles. Ne permets pas que je méprise ceux qui croient sincèrement.`
};

MIROIR["7:76"] = {
  reference: "7:76",
  theme: ["orgueil", "rejet", "mécréance"],
  emotion: "Arrogance, obstination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kibr", "Al-Kufr"],
  mirrorVersion: `« Ceux qui s'enflaient d'orgueil dirent : Nous ne croyons pas en ce en quoi vous avez cru. » Le miroir rejette : « Qala alladhina istakbaru » — ceux qui s'enflaient d'orgueil dirent. L'orgueil mène au rejet. « Nous ne croyons pas en ce en quoi vous avez cru » — le rejet de la foi des autres. Le miroir m'enseigne : l'orgueil est l'ennemi de la foi.`,
  reflection: `L'orgueil mène au rejet de la foi. Le refus de croire ce que les autres croient est de l'arrogance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala alladhina istakbaru inna bima amantum bihi kafirun » — ceux qui s'enflaient d'orgueil dirent : Nous ne croyons pas en ce en quoi vous avez cru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'orgueil m'empêche de croire ? Est-ce que je rejette la foi par arrogance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil est le voile entre le cœur et la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil précède la chute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'enfle d'orgueil se coupe de la miséricorde." }
  ],
  munajat: `Ya Rabb, libère-moi de l'orgueil. Je veux croire humblement. Ne permets pas que l'arrogance me coupe de la foi.`
};

MIROIR["7:77"] = {
  reference: "7:77",
  theme: ["chamelle", "désobéissance", "challenge"],
  emotion: "Rébellion, témérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Naqah", "Al-'Isyan"],
  mirrorVersion: `« Ils tuèrent la chamelle et désobéirent à l'ordre de leur Seigneur. » Le miroir condamne : « Fa'aqaru al-naqahata wa 'ataw amra rabbihim » — ils tuèrent la chamelle et désobéirent à l'ordre de leur Seigneur. Le meurtre du signe est le comble de la rébellion. « Ils dirent : Ô Salih, fais-nous venir ce dont tu nous menaces » — le défi précipite le châtiment. « Si tu es du nombre des envoyés » — la condition qui révèle l'incrédulité.`,
  reflection: `Le meurtre du signe divin est le comble de la rébellion. Le défi face au prophète précipite le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'aqaru al-naqahata wa 'ataw amra rabbihim wa qalu ya Salihu 'tina bi-ma ta'iduna in kunta mina al-mursalina » — ils tuèrent la chamelle et désobéirent à l'ordre de leur Seigneur. Ils dirent : Ô Salih, fais-nous venir ce dont tu nous menaces, si tu es du nombre des envoyés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes d'Allah est-ce que je tue par ma désobéissance ? Est-ce que je défie Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le meurtre du signe est le meurtre de la relation avec Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le signe tué crie vengeance devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La désobéissance à l'ordre d'Allah est la rupture de l'alliance." }
  ],
  munajat: `Ya Rabb, je ne veux pas tuer Tes signes par ma désobéissance. Je ne Te défie pas. Préserve-moi de la rébellion qui précipite le châtiment.`
};

MIROIR["7:78"] = {
  reference: "7:78",
  theme: ["tremblement", "destruction", "matin"],
  emotion: "Terreur, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Rajfah", "Al-Halak"],
  mirrorVersion: `« Le tremblement de terre les saisit. » Le miroir frappe : « Fa-akhadhathumu al-rajfah » — le tremblement de terre les saisit. Le châtiment vient de la terre elle-même. « Et ils demeurèrent étendus dans leurs demeures » — la mort sur place, sans fuite possible. « Le matin » — le châtiment vient au moment inattendu.`,
  reflection: `Le châtiment vient quand on ne s'y attend pas. La terre elle-même peut devenir le instrument de la justice divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhadhathumu al-rajfah fa-asbahu fi darihim jathimin » — le tremblement de terre les saisit ; et le matin, ils gisaient dans leurs demeures, sans vie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le châtiment inattendu ? Ou est-ce que je me repends avant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment de la terre répond au crime contre la terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre obéit à Allah, même pour le châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le matin de la mort est le matin où tout compte est réglé." }
  ],
  munajat: `Ya Rabb, je me repends avant le châtiment. Ne permets pas que je sois saisi par le tremblement de Ta colère. Fais que je me repente pendant qu'il est temps.`
};

MIROIR["7:79"] = {
  reference: "7:79",
  theme: ["détournement", "regret", "transmission"],
  emotion: "Tristesse, constat",
  difficulty: "débutant",
  relatedNames: ["Al-Tawalli", "Al-Nasihah"],
  mirrorVersion: `« Il se détourna d'eux et dit : Ô mon peuple, je vous ai transmis le message de mon Seigneur. » Le miroir constate : « Fa-tawalla 'anhum » — il se détourna d'eux. Le prophète a fait son devoir. « Ô mon peuple, je vous ai transmis le message de mon Seigneur et je vous ai conseillé sincèrement » — le bilan du prophète. « Mais vous n'aimez pas les conseillers sincères » — la raison du rejet.`,
  reflection: `Le prophète a fait son devoir de transmission et de conseil. Le peuple a rejeté par aversion pour la sincérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tawalla 'anhum wa qala ya qawmi laqad ablaghtukum risalata rabbi wa nasahtu lakum wa lakin la tuhibbuna al-nasihin » — il se détourna d'eux et dit : Ô mon peuple, je vous ai transmis le message de mon Seigneur et je vous ai conseillé sincèrement. Mais vous n'aimez pas les conseillers sincères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aime les conseillers sincères ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour des conseillers sincères est le signe du cœur vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le conseil sincère est un don, pas une contrainte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rejet du conseil sincère est le rejet de la miséricorde." }
  ],
  munajat: `Ya Rabb, j'aime les conseillers sincères. Merci pour Ton message et Ton conseil. Ne permets pas que je rejette ceux qui veulent mon bien.`
};

MIROIR["7:80"] = {
  reference: "7:80",
  theme: ["Lot", "immoralité", "innovation"],
  emotion: "Appel, condamnation",
  difficulty: "intermédiaire",
  relatedNames: ["Lut", "Al-Fahishah"],
  mirrorVersion: `« Et Lot, quand il dit à son peuple : Vous commettez une turpitude que nul être au monde n'a commise avant vous. » Le miroir condamne : « Wa Lutan idh qala li-qawmihi » — et Lot, quand il dit à son peuple. Lot condamne l'innovation immorale. « Vous commettez une turpitude » — l'acte est condamné. « Que nul être au monde n'a commise avant vous » — l'innovation dans le mal.`,
  reflection: `L'innovation dans l'immoralité est condamnée. La turpitude que personne n'a commise avant est le comble de la déviance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Lutan idh qala li-qawmihi ta'tuna al-fahishata ma sabaqakum biha min ahadin mina al-'alamin » — et Lot, quand il dit à son peuple : Vous commettez une turpitude que nul être au monde n'a commise avant vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles innovations dans le mal est-ce que je commets ? Suis-je fidèle aux limites d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'innovation dans le mal est l'égarement maximal." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les limites d'Allah sont protectrices, pas contraignantes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La turpitude inédite est le signe de l'égarement profond." }
  ],
  munajat: `Ya Rabb, je ne veux pas innover dans le mal. Je respecte Tes limites. Préserve-moi de la turpitude que personne n'a commise avant.`
};

MIROIR["7:81"] = {
  reference: "7:81",
  theme: ["hommes", "désir", "femmes"],
  emotion: "Correction, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rijal", "Al-Nisa'"],
  mirrorVersion: `« Vous vous approchez des hommes par désir au lieu des femmes. » Le miroir dénonce : « Innakum la-ta'tuna al-rijala shahwatan min duni al-nisa' » — vous vous approchez des hommes par désir au lieu des femmes. L'acte est nommé clairement. « Vous êtes un peuple transgresseur » — le jugement est sans appel.`,
  reflection: `Le désir mal dirigé est une transgression. La clarté du Coran sur la moralité sexuelle est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innakum la-ta'tuna al-rijala shahwatan min duni al-nisa' bal antum qawmun musrifun » — vous vous approchez des hommes par désir, au lieu des femmes. Vous êtes un peuple transgresseur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes désirs sont dirigés selon les limites d'Allah ? Ou est-ce que je transgresse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désir mal dirigé corrompt le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les limites de la moralité sexuelle sont protectrices de la société." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La maîtrise des désirs est le chemin de la pureté." }
  ],
  munajat: `Ya Rabb, purifie mes désirs. Fais qu'ils soient dirigés selon Tes limites. Ne permets pas que je sois un transgresseur.`
};

MIROIR["7:82"] = {
  reference: "7:82",
  theme: ["réponse", "expulsion", "purification"],
  emotion: "Intolérance, arrogance",
  difficulty: "débutant",
  relatedNames: ["Al-Takhrij", "Al-Taharah"],
  mirrorVersion: `« La seule réponse de son peuple fut de dire : Expulsez-les de votre cité. » Le miroir refuse : « Wa ma kana jawba qawmihi illa an qalu akhrijuhum min qaryatikum » — la seule réponse de son peuple fut de dire : Expulsez-les de votre cité. L'intolérance face à la vérité. « Ce sont des gens qui veulent se purifier » — l'accusation de purification révèle la vraie motivation.`,
  reflection: `L'intolérance face à la vérité mène à l'expulsion. Ceux qui veulent se purifier sont perçus comme une menace.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana jawba qawmihi illa an qalu akhrijuhum min qaryatikum innahum qawmun yatatahharun » — la seule réponse de son peuple fut de dire : Expulsez-les de votre cité, car ce sont des gens qui veulent se purifier." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'expulse ceux qui me rappellent la vérité ? Ou est-ce que je les accueille ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'expulsion des purs révèle l'impureté de ceux qui expulsent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La purification est une menace pour ceux qui vivent dans l'impureté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui veut se purifier dérange ceux qui ne veulent pas." }
  ],
  munajat: `Ya Rabb, je veux me purifier. Ne permets pas que je sois expulsé par ceux qui aiment l'impureté. Fais que je sois parmi les purs.`
};

MIROIR["7:83"] = {
  reference: "7:83",
  theme: ["sauvetage", "famille", "nuit"],
  emotion: "Protection, délivrance",
  difficulty: "débutant",
  relatedNames: ["Al-Najat", "Al-Ahl"],
  mirrorVersion: `« Nous le sauvâmes, lui et sa famille, sauf sa femme qui fut du nombre des disparus. » Le miroir sauve : « Fa-anjaynahu wa ahlahu illa imra'atahu » — Nous le sauvâmes, lui et sa famille, sauf sa femme. Le salut familial avec une exception. « Qui fut du nombre des disparus » — la femme du prophète peut être perdue.`,
  reflection: `Le salat du prophète et de sa famille, sauf sa femme. La relation familiale ne garantit pas le salut spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-anjaynahu wa ahlahu illa imra'atahu kanat mina al-ghabirin » — Nous le sauvâmes, lui et sa famille, sauf sa femme qui fut du nombre des disparus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma famille sera-t-elle sauvée avec moi ? Ou est-ce que certains seront laissés derrière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité familiale ne sauve pas, la foi sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le salut est individuel, même dans le cadre familial." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La femme du prophète peut être perdue — la proximité ne suffit pas." }
  ],
  munajat: `Ya Rabb, sauve-moi et ma famille. Ne permets pas que l'un de nous soit du nombre des disparus. Fais que notre foi soit sincère, pas juste notre proximité.`
};

MIROIR["7:84"] = {
  reference: "7:84",
  theme: ["pluie", "destruction", "considération"],
  emotion: "Justice, conséquence",
  difficulty: "débutant",
  relatedNames: ["Al-Matar", "Al-'Adhab"],
  mirrorVersion: `« Et Nous fîmes pleuvoir sur eux une pluie. » Le miroir châtie : « Wa amtarna 'alayhim mataran » — et Nous fîmes pleuvoir sur eux une pluie. La pluie devient châtiment. « Regarde donc ce que fut la fin des criminels » — l'invitation à méditer sur la conséquence.`,
  reflection: `La pluie qui est normalement bénédiction devient châtiment pour les criminels. La fin des criminels est une leçon pour les vivants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amtarna 'alayhim mataran fa-unzur kayfa kana 'aqibatu al-mujrimin » — et Nous fîmes pleuvoir sur eux une pluie. Regarde donc ce que fut la fin des criminels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle sera ma fin ? Suis-je parmi les criminels ou parmi les croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pluie de miséricorde devient pluie de châtiment pour les criminels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La même création peut bénir ou châtier selon le destinataire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La méditation sur la fin des criminels est un avertissement pour les vivants." }
  ],
  munajat: `Ya Rabb, que ma fin soit bonne. Ne fais pas pleuvoir sur moi le châtiment des criminels. Fais que je sois parmi ceux qui reçoivent la pluie de miséricorde.`
};

MIROIR["7:85"] = {
  reference: "7:85",
  theme: ["Chu'ayb", "Madyan", "justice"],
  emotion: "Appel, équité",
  difficulty: "débutant",
  relatedNames: ["Shu'ayb", "Madyan", "Al-Mizan"],
  mirrorVersion: `« Et aux Madyan, leur frère Chu'ayb. » Le miroir envoie : « Wa ila Madyana akhahum Shu'ayban » — et aux Madyan, leur frère Chu'ayb. Un autre prophète, un autre peuple. « Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui » — le message éternel. « Une preuve vous est venue de votre Seigneur » — le signe visible. « Donnez la pleine mesure et le plein poids » — la justice commerciale. « Ne causez pas de corruption sur terre » — l'interdiction générale.`,
  reflection: `Le message du monothéisme inclut la justice sociale. La mesure et le poids justes sont un devoir religieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ila Madyana akhahum Shu'ayban qala ya qawmi u'budu Allaha ma lakum min ilahin ghayruhu qad ja'atkum bayyinatun min rabbikum fa-awfu al-kayla wa al-mizana wa la tabkhasu al-nasa ashya'ahum wa la tufsidu fi al-ardi ba'da islahiha » — et aux Madyan, leur frère Chu'ayb : Ô mon peuple, adorez Allah. Vous n'avez pas de divinité en dehors de Lui. Une preuve vous est venue de votre Seigneur. Donnez la pleine mesure et le plein poids, ne lésez pas les gens dans leurs droits et ne semez pas la corruption sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne la pleine mesure et le plein poids ? Est-ce que je lèse les gens dans leurs droits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice commerciale est un acte d'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mesure et le poids sont les gardiens de la justice sociale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui triche dans la mesure triche avec Allah." }
  ],
  munajat: `Ya Rabb, je donne la pleine mesure et le plein poids. Je ne lèse personne dans ses droits. Je ne corromps pas la terre. Fais que ma justice commerciale soit une adoration.`
};

MIROIR["7:86"] = {
  reference: "7:86",
  theme: ["chemin", "obstacle", "menace"],
  emotion: "Mise en garde, correction",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sabil", "Al-Tahdid"],
  mirrorVersion: `« Ne vous postez pas sur chaque chemin pour menacer. » Le miroir interdit : « Wa la taq'udu bi-kulli siratin tu'iduna » — ne vous postez pas sur chaque chemin pour menacer. L'obstruction du chemin de la vérité. « Et pour détourner du chemin d'Allah ceux qui croient en Lui » — l'entrave à la foi. « Et pour chercher la tordure du chemin » — la déformation de la vérité.`,
  reflection: `L'obstruction du chemin de la vérité est un crime. Détourner les croyants et déformer la vérité sont des péchés graves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taq'udu bi-kulli siratin tu'iduna wa tasudduna 'an sabili Allahi man amana bihi wa tabghunaha 'iwajan » — ne vous postez pas sur chaque chemin pour menacer et pour détourner du chemin d'Allah ceux qui croient en Lui, et pour chercher la tordure du chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obstrue le chemin des autres vers la vérité ? Ou est-ce que je le facilite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui obstrue le chemin d'Allah sera obstrué du chemin du paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah est pour tous, pas pour quelques-uns." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La facilitation du chemin vers Allah est la plus haute œuvre." }
  ],
  munajat: `Ya Rabb, je n'obstrue pas Ton chemin. Je ne menace pas ceux qui croient. Je ne déforme pas la vérité. Fais que je sois un facilitateur, pas un obstacle.`
};

MIROIR["7:87"] = {
  reference: "7:87",
  theme: ["souvenir", "fin", "rappel"],
  emotion: "Rappel, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Tadhkirah", "Al-'Aqibah"],
  mirrorVersion: `« Et rappelez-vous quand vous étiez peu et qu'Il vous a multipliés. » Le miroir rappelle : « Wa udhkuru idh kuntum qalilan fa-katharakum » — et rappelez-vous quand vous étiez peu et qu'Il vous a multipliés. Le souvenir des bienfaits passés. « Et regardez ce que fut la fin des corrupteurs » — la leçon de l'histoire. Le miroir m'enseigne : le rappel des bienfaits et des châtiments passés guide le présent.`,
  reflection: `Le rappel des bienfaits passés produit la gratitude. La méditation sur la fin des corrupteurs produit la crainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa udhkuru idh kuntum qalilan fa-katharakum wa unzuru kayfa kana 'aqibatu al-mufsidin » — et rappelez-vous quand vous étiez peu et qu'Il vous a multipliés. Et regardez ce que fut la fin des corrupteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quel peu Allah m'a-t-Il multiplié ? Est-ce que je me rappelle les bienfaits passés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La multiplication est un bienfait qui demande reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des corrupteurs est une leçon pour les vivants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel des bienfaits passés est la protection contre l'ingratitude présente." }
  ],
  munajat: `Ya Rabb, je me rappelle Tes bienfaits passés. Tu m'as multiplié quand j'étais peu. Je ne veux pas être parmi les corrupteurs. Préserve-moi de leur fin.`
};

MIROIR["7:88"] = {
  reference: "7:88",
  theme: ["notables", "expulsion", "menace"],
  emotion: "Intolérance, arrogance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'", "Al-Tarid"],
  mirrorVersion: `« Les notables de son peuple qui s'enflaient d'orgueil dirent : Nous vous expulserons de notre cité. » Le miroir menace : « Qala al-mala'u alladhina istakbaru min qawmihi » — les notables de son peuple qui s'enflaient d'orgueil dirent. L'orgueil mène à l'intolérance. « Ô Chu'ayb, nous ne comprenons pas grand-chose à ce que tu dis » — le mépris du message. « Et nous te considérons comme faible parmi nous » — le mépris du messager.`,
  reflection: `L'orgueil des notables mène à l'intolérance. Le mépris du message et du messager révèle l'aveuglement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala al-mala'u alladhina istakbaru min qawmihi la-nukhrijannaka ya Shu'aybu wa alladhina amanu ma'aka min qaryatina aw lata'udunna fi millatina » — les notables de son peuple qui s'enflaient d'orgueil dirent : Nous vous expulserons, toi et ceux qui ont cru avec toi, de notre cité, ou vous reviendrez à notre religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'expulse ceux qui croient différemment ? Ou est-ce que je les respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'intolérance religieuse est le signe de la faiblesse de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi sincère n'a pas besoin de forcer les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'expulsion des croyants révèle la peur de la vérité." }
  ],
  munajat: `Ya Rabb, je n'expulse pas ceux qui croient. Je ne force personne à ma religion. Fais que ma foi soit assez forte pour respecter les autres.`
};

MIROIR["7:90"] = {
  reference: "7:90",
  theme: ["notables", "mécréance", "succès"],
  emotion: "Opposition, erreur",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'", "Al-Falah"],
  mirrorVersion: `« Les notables de son peuple qui ne croyaient pas dirent : Si vous suivez Chu'ayb, vous serez perdants. » Le miroir trompe : « Wa qala al-mala'u alladhina kafaru min qawmihi » — les notables de son peuple qui ne croyaient pas dirent. L'opposition des notables. « Si vous suivez Chu'ayb, vous serez perdants » — la fausse menace. Le miroir m'enseigne : le succès est dans la foi, pas dans le statut.`,
  reflection: `Les notables menacent de perte ceux qui suivent le prophète. La vérité est que le succès est dans la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala al-mala'u alladhina kafaru min qawmihi la-in ittaba'tum Shu'ayban idhan lakhasirun » — les notables de son peuple qui ne croyaient pas dirent : Si vous suivez Chu'ayb, vous serez perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je menace ceux qui suivent la vérité ? Ou est-ce que je les encourage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte promise par les notables est le succès réel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le succès véritable est le succès spirituel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ce qui semble perte aux yeux des hommes est gain aux yeux d'Allah." }
  ],
  munajat: `Ya Rabb, je ne menace pas ceux qui Te suivent. Je sais que le succès est dans la foi. Ne permets pas que je sois parmi ceux qui promettent la perte.`
};

MIROIR["7:91"] = {
  reference: "7:91",
  theme: ["tremblement", "destruction", "justice"],
  emotion: "Terreur, châtiment",
  difficulty: "débutant",
  relatedNames: ["Al-Rajfah", "Al-'Adhab"],
  mirrorVersion: `« Le tremblement de terre les saisit. » Le miroir frappe : « Fa-akhadhathumu al-rajfah » — le tremblement de terre les saisit. Le même châtiment que les Thamoud. « Et ils demeurèrent étendus dans leurs demeures » — la mort sans évasion. La justice d'Allah est implacable pour ceux qui rejettent Ses signes.`,
  reflection: `Le tremblement de terre est un châtiment pour ceux qui rejettent. La justice divine atteint toujours son but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhadhathumu al-rajfah fa-asbahu fi darihim jathimin » — le tremblement de terre les saisit ; et le matin, ils gisaient dans leurs demeures, sans vie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le châtiment qui peut venir à tout moment ? Ou est-ce que je me repends ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment vient quand on ne s'y attend pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre elle-même obéit à Allah pour punir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le châtiment des peuples passés est un avertissement pour les présents." }
  ],
  munajat: `Ya Rabb, je me repends avant le tremblement de Ta colère. Ne permets pas que je sois saisi dans mes péchés. Fais que je me repente maintenant.`
};

MIROIR["7:92"] = {
  reference: "7:92",
  theme: ["fausseté", "destruction", "conséquence"],
  emotion: "Justice, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kadhib", "Al-Halak"],
  mirrorVersion: `« Ceux qui traitaient Chu'ayb de menteur furent comme s'ils n'y avaient jamais vécu. » Le miroir efface : « Alladhina kadhdhabu Shu'ayban ka-an lam yaghaw fiha » — ceux qui traitaient Chu'ayb de menteur furent comme s'ils n'y avaient jamais vécu. L'anéantissement total. « Ceux qui traitaient Chu'ayb de menteur furent les perdants » — la réalisation tardive.`,
  reflection: `Le traitement de menteur contre le prophète mène à l'anéantissement. Les perdants sont ceux qui rejettent la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina kadhdhabu Shu'ayban ka-an lam yaghaw fiha alladhina kadhdhabu Shu'ayban kanu humu al-khasirin » — ceux qui traitaient Chu'ayb de menteur furent comme s'ils n'y avaient jamais vécu. Ceux qui traitaient Chu'ayb de menteur furent les perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite les prophètes de menteurs ? Ou est-ce que je crois en eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'anéantissement des menteurs est la preuve de la vérité du prophète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les peuples détruits n'existent plus que dans les livres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La perte éternelle est pour ceux qui rejettent la vérité." }
  ],
  munajat: `Ya Rabb, je ne traite pas Tes prophètes de menteurs. Je crois en eux. Ne permets pas que je sois parmi les perdants. Fais que je sois parmi les croyants.`
};

MIROIR["7:93"] = {
  reference: "7:93",
  theme: ["détournement", "transmission", "regret"],
  emotion: "Tristesse, constat",
  difficulty: "débutant",
  relatedNames: ["Al-Tawalli", "Al-Risalah"],
  mirrorVersion: `« Il se détourna d'eux et dit : Ô mon peuple, je vous ai transmis les messages de mon Seigneur. » Le miroir constate : « Fa-tawalla 'anhum » — il se détourna d'eux. Le prophète a fait son devoir. « Et je vous ai conseillé sincèrement » — le bilan du messager. « Comment pourrais-je m'affliger pour un peuple mécréant ? » — la tristesse remplacée par la résignation.`,
  reflection: `Le prophète a fait son devoir de transmission et de conseil. La tristesse pour les mécréants cède la place à la résignation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tawalla 'anhum wa qala ya qawmi laqad ablaghtukum risalati rabbi wa nasahtu lakum fa-kayfa ahsa 'ala qawmin kafirin » — il se détourna d'eux et dit : Ô mon peuple, je vous ai transmis les messages de mon Seigneur et je vous ai conseillé sincèrement. Comment pourrais-je m'affliger pour un peuple mécréant ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai fait mon devoir de transmission ? Est-ce que je me résigne face au rejet ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résignation face au rejet n'est pas le désespoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le prophète fait son devoir, le peuple fait son choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'accomplissement du devoir libère de la culpabilité." }
  ],
  munajat: `Ya Rabb, je fais mon devoir de transmission. Je me résigne face au rejet. Ne permets pas que je désespère de Ta miséricorde pour moi.`
};

MIROIR["7:94"] = {
  reference: "7:94",
  theme: ["épreuve", "prophètes", "humilité"],
  emotion: "Sagesse, épreuve",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bala'", "Al-Rusul"],
  mirrorVersion: `« Nous n'avons envoyé aucun prophète dans une cité sans que Nous ayons saisi ses habitants par l'adversité et la détresse. » Le miroir éprouve : « Wa ma arsalna fi qaryatin min nabiyyin illa akhadhna ahlahu bi-al-bassa'i wa al-darra'i » — Nous n'avons envoyé aucun prophète dans une cité sans que Nous ayons saisi ses habitants par l'adversité et la détresse. L'épreuve précède la guidance. « Peut-être s'humilieront-ils » — le but de l'épreuve.`,
  reflection: `L'épreuve est le chemin vers l'humilité. L'adversité et la détresse précèdent souvent la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna fi qaryatin min nabiyyin illa akhadhna ahlahu bi-al-bassa'i wa al-darra'i la'allahum yatadarra'un » — Nous n'avons envoyé aucun prophète dans une cité sans que Nous ayons saisi ses habitants par l'adversité et la détresse, peut-être s'humilieront-ils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles épreuves Allah m'a-t-Il envoyées ? Est-ce qu'elles m'ont humilié ou endurci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve est une invitation à l'humilité, pas une punition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve accompagne toujours la guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité dans l'épreuve ouvre la porte de la miséricorde." }
  ],
  munajat: `Ya Rabb, j'accepte l'épreuve comme chemin vers l'humilité. Ne permets pas qu'elle m'endurcisse. Fais que je m'humilie devant Toi dans l'adversité.`
};

MIROIR["7:95"] = {
  reference: "7:95",
  theme: ["épreuve", "prospérité", "oubli"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Bala'", "Al-Ni'mah"],
  mirrorVersion: `« Puis Nous avons changé leur mauvaise situation en une bonne. » Le miroir transforme : « Thumma baddalna makana al-sayyi'ati al-hasanah » — puis Nous avons changé leur mauvaise situation en une bonne. Le changement peut tromper. « Ils oublièrent ce dont Nous les avions avertis » — l'oubli suit la prospérité. « Nous les saisîmes soudain » — le châtiment surprise.`,
  reflection: `La prospérité après l'épreuve peut mener à l'oubli. Le châtiment vient quand on s'y attend le moins.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma baddalna makana al-sayyi'ati al-hasanata hatta 'afaw wa qalu qad massa aba'ana al-bassa'u wa al-darra'u fa-akhadhnahum baghtatan wa hum la yash'urun » — puis Nous avons changé leur mauvaise situation en une bonne, jusqu'à ce qu'ils oublient Nos avertissements. Ils dirent : Nos ancêtres ont connu l'adversité et la prospérité. Alors Nous les saisîmes soudain, sans qu'ils s'en rendent compte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand la situation s'améliore, est-ce que j'oublie Allah ? Ou est-ce que je reste reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prospérité après l'épreuve est un test, pas une récompense." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alternance de l'épreuve et de la prospérité est la loi de la vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui oublie Allah dans la prospérité sera rappelé par le châtiment." }
  ],
  munajat: `Ya Rabb, je ne T'oublie pas dans la prospérité. Je reste reconnaissant. Ne permets pas que je sois saisi soudain dans mon oubli. Rappelle-moi toujours.`
};

MIROIR["7:96"] = {
  reference: "7:96",
  theme: ["foi", "bénédiction", "ouverture"],
  emotion: "Espérance, promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Barakah"],
  mirrorVersion: `« Si les habitants des cités avaient cru et craint Allah, Nous leur aurions ouvert des bénédictions du ciel et de la terre. » Le miroir promet : « Wa law anna ahla al-qura amanu wa ittaqaw la-fatahna 'alayhim barakatin mina al-sama'i wa al-ard » — si les habitants des cités avaient cru et craint Allah, Nous leur aurions ouvert des bénédictions. La foi et la crainte ouvrent les bénédictions. « Mais ils ont traité de mensonges » — le rejet ferme la porte.`,
  reflection: `La foi et la crainte d'Allah ouvrent les bénédictions du ciel et de la terre. Le rejet ferme la porte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law anna ahla al-qura amanu wa ittaqaw la-fatahna 'alayhim barakatin mina al-sama'i wa al-ard wa lakin kadhdhabu fa-akhadhnahum bima kanu yaksibun » — si les habitants des cités avaient cru et craint Allah, Nous leur aurions ouvert des bénédictions du ciel et de la terre. Mais ils ont traité de mensonges. Alors Nous les avons saisis pour ce qu'ils avaient acquis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois et je crains Allah ? Ou est-ce que je traite Ses signes de mensonges ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bénédictions sont ouvertes par la foi, fermées par le rejet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel et la terre sont prêts à bénir ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La bénédiction est dans la foi, pas dans les biens." }
  ],
  munajat: `Ya Rabb, je crois et je Te crains. Ouvre pour moi les bénédictions du ciel et de la terre. Ne permets pas que je ferme la porte par le rejet.`
};

MIROIR["7:97"] = {
  reference: "7:97",
  theme: ["sécurité", "châtiment", "nuit"],
  emotion: "Avertissement, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Aman", "Al-Layl"],
  mirrorVersion: `« Les habitants des cités se sentent-ils à l'abri de Notre châtiment venant à eux la nuit pendant qu'ils dorment ? » Le miroir questionne : « A-fa-amina ahlu al-qura an ya'tiyahum ba'suna bayatan wa hum ni'amun » — les habitants des cités se sentent-ils à l'abri de Notre châtiment venant à eux la nuit pendant qu'ils dorment ? La fausse sécurité. Le châtiment peut venir dans les moments les plus vulnérables.`,
  reflection: `La fausse sécurité endort la vigilance. Le châtiment peut venir la nuit, pendant le sommeil, quand on est le plus vulnérable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-amina ahlu al-qura an ya'tiyahum ba'suna bayatan wa hum ni'amun » — les habitants des cités se sentent-ils à l'abri de Notre châtiment venant à eux la nuit pendant qu'ils dorment ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je en fausse sécurité ? Ou est-ce que je reste vigilant dans la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie sécurité est dans la foi, pas dans les murs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit n'est pas une protection contre le châtiment d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vigilance constante est la protection du croyant." }
  ],
  munajat: `Ya Rabb, je ne me sens pas à l'abri de Ton châtiment. Je reste vigilant dans la foi. Protège-moi nuit et jour par ma confiance en Toi.`
};

MIROIR["7:98"] = {
  reference: "7:98",
  theme: ["sécurité", "châtiment", "jour"],
  emotion: "Avertissement, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Aman", "Al-Nahar"],
  mirrorVersion: `« Ou se sentent-ils à l'abri de Notre châtiment venant à eux le jour pendant qu'ils jouent ? » Le miroir questionne encore : « A-wa amina ahlu al-qura an ya'tiyahum ba'suna duhan wa hum yal'abun » — ou se sentent-ils à l'abri de Notre châtiment venant à eux le jour pendant qu'ils jouent ? La distraction du jour est aussi dangereuse que le sommeil de la nuit.`,
  reflection: `La distraction du jour est aussi dangereuse que le sommeil de la nuit. Le châtiment peut venir à tout moment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa amina ahlu al-qura an ya'tiyahum ba'suna duhan wa hum yal'abun » — ou se sentent-ils à l'abri de Notre châtiment venant à eux le jour pendant qu'ils jouent ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis distrait par les jeux de ce monde ? Ou est-ce que je reste conscient d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jeu du monde distrait du but éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour et la nuit, le châtiment peut venir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience constante d'Allah est la seule protection." }
  ],
  munajat: `Ya Rabb, je ne suis pas distrait par les jeux de ce monde. Je reste conscient de Toi. Protège-moi jour et nuit par ma vigilance.`
};

MIROIR["7:99"] = {
  reference: "7:99",
  theme: ["ruse", "sécurité", "perdition"],
  emotion: "Avertissement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Makr", "Al-Halak"],
  mirrorVersion: `« Se sentent-ils à l'abri de la ruse d'Allah ? » Le miroir avertit : « A-fa-amina makra Allahi » — se sentent-ils à l'abri de la ruse d'Allah ? La ruse d'Allah est Sa façon d'amener le châtiment par les chemins inattendus. « Seuls les perdants se sentent à l'abri de la ruse d'Allah » — la conclusion est sans appel.`,
  reflection: `La ruse d'Allah est Sa façon d'amener le châtiment par les chemins inattendus. Seuls les perdants se sentent à l'abri.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-amina makra Allahi fa-la ya'manu makra Allahi illa al-qawmu al-khasirun » — se sentent-ils à l'abri de la ruse d'Allah ? Seuls les perdants se sentent à l'abri de la ruse d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens à l'abri de la ruse d'Allah ? Ou est-ce que je reste humble et vigilant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fausse sécurité est le signe de la perdition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La ruse d'Allah est Sa justice déguisée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité et la vigilance sont les seules protections." }
  ],
  munajat: `Ya Rabb, je ne me sens pas à l'abri de Ta ruse. Je reste humble et vigilant. Ne permets pas que je sois parmi les perdants qui se sentent en sécurité.`
};

MIROIR["7:100"] = {
  reference: "7:100",
  theme: ["succession", "réflexion", "terre"],
  emotion: "Sagesse, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Khilafah", "Al-Tafakkur"],
  mirrorVersion: `« N'est-ce pas une guidance pour ceux qui héritent la terre après ses habitants ? » Le miroir guide : « A-wa lam yahdi lilladhina yarithuna al-arda min ba'di ahliha » — n'est-ce pas une guidance pour ceux qui héritent la terre après ses habitants ? L'histoire est une leçon. « Que si Nous voulions, Nous les aurions frappés pour leurs péchés » — la possibilité du châtiment.`,
  reflection: `L'histoire des peuples passés est une guidance pour ceux qui héritent la terre. Le châtiment est possible si nous ne nous corrigeons pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yahdi lilladhina yarithuna al-arda min ba'di ahliha anna law nasha'u asabnahum bi-dhunubihim » — n'est-ce pas une guidance pour ceux qui héritent la terre après ses habitants, que si Nous voulions, Nous les aurions frappés pour leurs péchés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'apprends de l'histoire des peuples passés ? Est-ce que je me corrige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un miroir pour le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque génération hérite de la terre et des leçons du passé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La méditation sur l'histoire évite de répéter les erreurs." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire des peuples passés. Je ne veux pas répéter leurs erreurs. Guide-moi par les leçons du passé.`
};

MIROIR["7:101"] = {
  reference: "7:101",
  theme: ["villes", "récit", "messagers"],
  emotion: "Enseignement, histoire",
  difficulty: "débutant",
  relatedNames: ["Al-Qura", "Al-Rusul"],
  mirrorVersion: `« Voilà les villes dont Nous te racontons les histoires. » Le miroir enseigne : « Tilka al-qura naqussu 'alayka min anba'iha » — voilà les villes dont Nous te racontons les histoires. Les récits sont des leçons. « Leurs messagers leur avaient apporté les preuves » — la clarté du message. « Ils n'étaient pas pour croire » — l'obstination.`,
  reflection: `Les récits des villes passées sont des leçons pour nous. Les preuves ont été apportées, mais l'obstination a empêché la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka al-qura naqussu 'alayka min anba'iha wa laqad ja'athum rusuluhum bi-al-bayyinati fa-ma kanu li-yu'minu bima kadhdhabu min qablu » — voilà les villes dont Nous te racontons les histoires. Leurs messagers leur avaient apporté les preuves, mais ils n'étaient pas pour croire ce qu'ils avaient traité de mensonge auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles leçons tire-je des récits des villes passées ? Est-ce que je crois aux preuves ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obstination ferme les yeux même sur les preuves." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les preuves d'Allah sont claires, mais les cœurs peuvent être scellés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi vient du cœur, pas seulement des preuves." }
  ],
  munajat: `Ya Rabb, je tire des leçons des récits des villes passées. Je crois aux preuves. Ne permets pas que mon cœur soit scellé par l'obstination.`
};

MIROIR["7:102"] = {
  reference: "7:102",
  theme: ["alliance", "fidélité", "peu"],
  emotion: "Constat, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ahd", "Al-Wafa'"],
  mirrorVersion: `« Nous n'avons trouvé chez la plupart d'eux aucune fidélité à leur alliance. » Le miroir constate : « Wa ma wajadna li-akhtharihim min 'ahdin » — Nous n'avons trouvé chez la plupart d'eux aucune fidélité à leur alliance. L'infidélité est la norme. « Et Nous avons trouvé la plupart d'entre eux pervers » — le jugement sur la majorité.`,
  reflection: `L'infidélité à l'alliance est courante. La perversité caractérise la majorité. La fidélité est rare.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma wajadna li-akhtharihim min 'ahdin wa in wajadna aktharahum la-fasqin » — Nous n'avons trouvé chez la plupart d'eux aucune fidélité à leur alliance. Et Nous avons trouvé la plupart d'entre eux pervers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je fidèle à mon alliance avec Allah ? Ou est-ce que je suis parmi les pervers ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fidélité à l'alliance est le signe de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance avec Allah est sacrée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fidélité dans l'alliance distingue les croyants des pervers." }
  ],
  munajat: `Ya Rabb, je suis fidèle à mon alliance avec Toi. Ne permets pas que je sois parmi les infidèles. Fais que je sois parmi les rares qui respectent leur engagement.`
};

MIROIR["7:103"] = {
  reference: "7:103",
  theme: ["Moïse", "Pharaon", "signes"],
  emotion: "Récit, mission",
  difficulty: "débutant",
  relatedNames: ["Musa", "Fir'awn", "Al-Ayat"],
  mirrorVersion: `« Puis Nous avons envoyé Moïse avec Nos signes à Pharaon et aux notables. » Le miroir envoie : « Thumma ba'athna min ba'dihim Musa bi-ayatina ila Fir'awna wa mala'ihi » — puis Nous avons envoyé Moïse avec Nos signes à Pharaon et aux notables. La mission de Moïse commence. « Ils furent injustes envers Nos signes » — le rejet malgré les preuves.`,
  reflection: `La mission de Moïse avec les signes divins. Le rejet de Pharaon et des notables malgré les preuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ba'athna min ba'dihim Musa bi-ayatina ila Fir'awna wa mala'ihi fa-zalamu biha fa-unzur kayfa kana 'aqibatu al-mufsidin » — puis Nous avons envoyé Moïse avec Nos signes à Pharaon et aux notables. Ils furent injustes envers Nos signes. Regarde donc ce que fut la fin des corrupteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux signes d'Allah ? Est-ce que je suis injuste comme Pharaon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice envers les signes d'Allah est le comble de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont des preuves pour ceux qui veulent croire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fin des corrupteurs est une leçon pour les vivants." }
  ],
  munajat: `Ya Rabb, je ne suis pas injuste envers Tes signes. Je crois en eux. Ne permets pas que je sois parmi les corrupteurs. Fais que j'apprenne de leur fin.`
};

MIROIR["7:104"] = {
  reference: "7:104",
  theme: ["Moïse", "Pharaon", "message"],
  emotion: "Courage, vérité",
  difficulty: "débutant",
  relatedNames: ["Musa", "Fir'awn"],
  mirrorVersion: `« Moïse dit : Ô Pharaon, je suis un messager du Seigneur des mondes. » Le miroir déclare : « Qala Musa ya Fir'awnu inni rasulun min rabbi al-'alamin » — Moïse dit : Ô Pharaon, je suis un messager du Seigneur des mondes. La déclaration directe et courageuse. Le prophète affirme sa mission devant le plus puissant.`,
  reflection: `La déclaration courageuse de Moïse devant Pharaon. L'affirmation de sa mission divine sans peur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Musa ya Fir'awnu inni rasulun min rabbi al-'alamin » — Moïse dit : Ô Pharaon, je suis un messager du Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai le courage de déclarer ma foi devant les puissants ? Ou est-ce que je me tais par peur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le courage du prophète vient de sa certitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le messager du Seigneur des monds n'a peur que d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La certitude de la mission donne le courage de la proclamation." }
  ],
  munajat: `Ya Rabb, donne-moi le courage de Moïse. Fais que je proclame ma foi sans peur. Ne permets pas que je me taise devant les puissants.`
};

MIROIR["7:105"] = {
  reference: "7:105",
  theme: ["vérité", "envoyé", "libération"],
  emotion: "Vérité, mission",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mab'ath"],
  mirrorVersion: `« Il m'est prescrit de ne dire sur Allah que la vérité. » Le miroir prescrit : « Haqiqun 'ala an la aqula 'ala Allahi illa al-haqq » — il m'est prescrit de ne dire sur Allah que la vérité. La véracité est obligatoire. « Je suis venu à vous avec une preuve de votre Seigneur » — le signe visible. « Laisse partir avec moi les Enfants d'Israël » — la demande de libération.`,
  reflection: `La véracité sur Allah est obligatoire. Le signe visible accompagne le message. La libération des opprimés est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Haqiqun 'ala an la aqula 'ala Allahi illa al-haqq qad ji'tukum bi-bayyinatin min rabbikum fa-arsil ma'i bani Isra'il » — il m'est prescrit de ne dire sur Allah que la vérité. Je suis venu à vous avec une preuve de votre Seigneur. Laisse partir avec moi les Enfants d'Israël." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis la vérité sur Allah ? Est-ce que je défends les opprimés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La véracité sur Allah est la base de la prophétie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La libération des opprimés est une mission divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité sur Allah reçoit Son soutien." }
  ],
  munajat: `Ya Rabb, je dis la vérité sur Toi. Je défends les opprimés. Donne-moi le courage de demander la libération des captifs. Soutiens ma véracité.`
};

MIROIR["7:106"] = {
  reference: "7:106",
  theme: ["signe", "preuve", "demande"],
  emotion: "Défi, attente",
  difficulty: "débutant",
  relatedNames: ["Al-Ayah", "Al-Burhan"],
  mirrorVersion: `« Il dit : Si tu es venu avec un signe, montre-le, si tu es véridique. » Le miroir défie : « Qala in kunta ji'ta bi-ayatin fa'ti biha in kunta mina al-sadiqin » — il dit : Si tu es venu avec un signe, montre-le, si tu es véridique. Le défi de Pharaon. La demande de preuve est une excuse pour les uns, une opportunité pour les autres.`,
  reflection: `Le défi de Pharaon pour voir le signe. La demande de preuve peut être une excuse ou une opportunité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala in kunta ji'ta bi-ayatin fa'ti biha in kunta mina al-sadiqin » — il dit : Si tu es venu avec un signe, montre-le, si tu es véridique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des signes par curiosité ou par foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe demandé par défi sera vu mais pas cru." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont pour ceux qui veulent croire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La demande de preuve par défi précède souvent le rejet." }
  ],
  munajat: `Ya Rabb, je ne demande pas de signes par défi. Je crois en Tes signes. Ne permets pas que je sois comme Pharaon qui voit mais ne croit pas.`
};

MIROIR["7:107"] = {
  reference: "7:107",
  theme: ["bâton", "serpent", "miracle"],
  emotion: "Émerveillement, puissance",
  difficulty: "débutant",
  relatedNames: ["Al-'Asa", "Al-Thu'ban"],
  mirrorVersion: `« Il jeta son bâton et ce fut un serpent évident. » Le miroir transforme : « Fa-alqa 'asahu fa-idha hiya thu'banun mubin » — il jeta son bâton et ce fut un serpent évident. Le miracle visible. Le bâton ordinaire devient serpent extraordinaire. Le signe de la puissance d'Allah sur la création.`,
  reflection: `Le miracle du bâton transformé en serpent. La puissance d'Allah transforme l'ordinaire en extraordinaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-alqa 'asahu fa-idha hiya thu'banun mubin » — il jeta son bâton et ce fut un serpent évident." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je jette devant Allah pour qu'Il le transforme ? Ma vie ordinaire peut-elle devenir extraordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transformation de l'ordinaire en extraordinaire est la marque d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création obéit à Allah sous toutes ses formes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ce qui est mort peut revivre par la volonté d'Allah." }
  ],
  munajat: `Ya Rabb, transforme ma vie ordinaire en extraordinaire par Ta puissance. Je jette mon bâton devant Toi. Fais de moi un miracle vivant.`
};

MIROIR["7:108"] = {
  reference: "7:108",
  theme: ["main", "lumière", "miracle"],
  emotion: "Émerveillement, signe",
  difficulty: "débutant",
  relatedNames: ["Al-Yad", "Al-Nur"],
  mirrorVersion: `« Et il sortit sa main et elle fut blanche pour ceux qui regardaient. » Le miroir illumine : « Wa naza'a yadahu fa-idha hiya bayda'u li-al-nazirin » — et il sortit sa main et elle fut blanche pour ceux qui regardaient. Le second miracle. La lumière sans brûlure. Le signe de la purification divine.`,
  reflection: `La main blanche lumineuse est un signe de purification. La lumière d'Allah éclaire sans brûler.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa naza'a yadahu fa-idha hiya bayda'u li-al-nazirin » — et il sortit sa main et elle fut blanche pour ceux qui regardaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma main œuvre dans la lumière d'Allah ? Ou est-ce qu'elle œuvre dans l'obscurité ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "La main blanche est la main purifiée par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière d'Allah purifie tout ce qu'elle touche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont les œuvres sont blanches dans la lumière d'Allah est béni." }
  ],
  munajat: `Ya Nur, illumine ma main et mes œuvres. Fais qu'elles soient blanches dans Ta lumière. Purifie ce que je fais par Ta présence.`
};

MIROIR["7:109"] = {
  reference: "7:109",
  theme: ["magie", "conseil", "reconnaissance"],
  emotion: "Trahison, complot",
  difficulty: "débutant",
  relatedNames: ["Al-Sihr", "Al-Mala'"],
  mirrorVersion: `« Les notables du peuple de Pharaon dirent : C'est un magicien savant. » Le miroir accuse : « Qala al-mala'u min qawmi Fir'awna » — les notables du peuple de Pharaon dirent. Le complot des notables. « C'est un magicien savant » — l'accusation pour minimiser le miracle. Le signe divin est réduit à la magie humaine.`,
  reflection: `Les notables accusent Moïse de magie pour minimiser le miracle. Le signe divin est réduit à l'artifice humain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala al-mala'u min qawmi Fir'awna inna hadha la-sahirun 'alim » — les notables du peuple de Pharaon dirent : C'est un magicien savant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis aux miracles d'Allah ? Est-ce que je les minimise ou je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de magie révèle la reconnaissance implicite du pouvoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les notables protègent leur pouvoir en niant les signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ce qui est appelé magie est souvent la vérité qui dérange." }
  ],
  munajat: `Ya Rabb, je reconnais Tes miracles. Je ne les minimise pas comme de la magie. Ouvre mes yeux à la réalité de Tes signes.`
};

MIROIR["7:110"] = {
  reference: "7:110",
  theme: ["expulsion", "magie", "politique"],
  emotion: "Complot, manipulation",
  difficulty: "débutant",
  relatedNames: ["Al-Tarid", "Al-Sihr"],
  mirrorVersion: `« Il veut vous expulser de votre terre. » Le miroir manipule : « Yuridu an yukhrijakum min ardikum » — il veut vous expulser de votre terre. La peur de l'expulsion mobilise. « Que conseillez-vous ? » — la consultation pour le complot. La peur est utilisée pour manipuler.`,
  reflection: `La peur de l'expulsion est utilisée pour mobiliser contre le prophète. La manipulation politique utilise les peurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuridu an yukhrijakum min ardikum fa-madha ta'murun » — il veut vous expulser de votre terre. Que conseillez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse manipuler par la peur ? Ou est-ce que je cherche la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La manipulation par la peur est l'arme des tyrans." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre appartient à Allah, pas aux tyrans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la vérité n'est pas manipulé par la peur." }
  ],
  munajat: `Ya Rabb, je ne me laisse pas manipuler par la peur. Je cherche la vérité. Ne permets pas que les tyrans m'effraient avec leurs mensonges.`
};

MIROIR["7:111"] = {
  reference: "7:111",
  theme: ["conseil", "délai", "magiciens"],
  emotion: "Complot, stratégie",
  difficulty: "débutant",
  relatedNames: ["Al-Mashwarah", "Al-Saharah"],
  mirrorVersion: `« Ils dirent : Fais-le attendre, lui et son frère, et envoie des recruteurs dans les villes. » Le miroir retarde : « Qalu arjih wa akhahu wa arsil fi al-mada'ini hashirin » — ils dirent : Fais-le attendre, lui et son frère. Le délai est une stratégie. « Et envoie des recruteurs dans les villes » — la mobilisation générale. « Qu'ils t'amènent tous les magiciens savants » — le défi par les magiciens.`,
  reflection: `Le délai est utilisé pour mobiliser les magiciens. Le défi sera organisé à grande échelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu arjih wa akhahu wa arsil fi al-mada'ini hashirin ya'tuka bi-kulli sahirin 'alim » — ils dirent : Fais-le attendre, lui et son frère, et envoie des recruteurs dans les villes. Qu'ils t'amènent tous les magiciens savants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande du temps pour me repentir ou pour persister dans l'erreur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai demandé par les tyrans précipite leur chute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les magiciens rassemblés seront les témoins du vrai miracle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délai accordé par Allah est une opportunité de repentir." }
  ],
  munajat: `Ya Rabb, je ne demande pas de délai pour persister dans l'erreur. Je me repens maintenant. Ne permets pas que le délai devienne une chute.`
};

MIROIR["7:112"] = {
  reference: "7:112",
  theme: ["magiciens", "savants", "rassemblement"],
  emotion: "Mobilisation, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Saharah", "Al-'Ulama'"],
  mirrorVersion: `« Qu'ils t'amènent tous les magiciens savants. » Le miroir rassemble : « Ya'tuka bi-kulli sahirin 'alim » — qu'ils t'amènent tous les magiciens savants. Le rassemblement des experts en illusion. La vérité sera opposée à l'illusion à grande échelle.`,
  reflection: `Le rassemblement des magiciens savants pour défier le miracle. L'illusion sera confrontée à la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'tuka bi-kulli sahirin 'alim » — qu'ils t'amènent tous les magiciens savants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rassemble mes forces pour défier Allah ou pour me soumettre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement des magiciens sera leur témoignage de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les experts en illusion seront confondus par la réalité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rassemblement contre la vérité précipite la victoire de la vérité." }
  ],
  munajat: `Ya Rabb, je ne rassemble pas mes forces pour Te défier. Je me soumets. Fais que mon rassemblement soit pour Ta vérité, pas contre elle.`
};

MIROIR["7:113"] = {
  reference: "7:113",
  theme: ["magiciens", "récompense", "assemblée"],
  emotion: "Attente, convoitise",
  difficulty: "débutant",
  relatedNames: ["Al-Saharah", "Al-Ajr"],
  mirrorVersion: `« Les magiciens vinrent à Pharaon et dirent : Y aura-t-il une récompense pour nous si nous sommes les vainqueurs ? » Le miroir convoite : « Wa ja'a al-saharatu Fir'awna qalu inna la-ajran in kunna nahu al-ghalibin » — les magiciens vinrent à Pharaon et dirent : Y aura-t-il une récompense pour nous si nous sommes les vainqueurs ? La motivation matérielle précède le défi.`,
  reflection: `Les magiciens sont motivés par la récompense. Le gain matériel précède leur engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'a al-saharatu Fir'awna qalu inna la-ajran in kunna nahu al-ghalibin » — les magiciens vinrent à Pharaon et dirent : Y aura-t-il une récompense pour nous si nous sommes les vainqueurs ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me motive dans mes actions ? La récompense d'Allah ou le gain matériel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La motivation matérielle des magiciens sera transformée par le miracle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ceux qui cherchent la récompense matérielle peuvent être guidés vers la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le miracle transforme les cœurs, même ceux qui sont motivés par le gain." }
  ],
  munajat: `Ya Rabb, je ne suis pas motivé par le gain matériel. Je cherche Ta récompense. Transforme mon cœur vers la vérité, même si je commence par des motivations imparfaites.`
};

MIROIR["7:114"] = {
  reference: "7:114",
  theme: ["promesse", "proximité", "récompense"],
  emotion: "Promesse, séduction",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Qurb"],
  mirrorVersion: `« Il dit : Oui, et vous serez parmi les rapprochés. » Le miroir promet : « Qala na'am wa innakum la-mina al-muqarrabin » — il dit : Oui, et vous serez parmi les rapprochés. La double promesse : récompense et proximité. Pharaon offre ce qu'il ne possède pas.`,
  reflection: `Pharaon promet récompense et proximité. Il offre ce qu'il ne possède pas — la vraie proximité est auprès d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala na'am wa innakum la-mina al-muqarrabin » — il dit : Oui, et vous serez parmi les rapprochés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je promets aux autres ? Est-ce que je promets ce que je possède ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité promise par Pharaon sera transformée en proximité d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie proximité est auprès d'Allah, pas auprès des tyrans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ceux qui cherchent la proximité des tyrans la perdent ; ceux qui la cherchent auprès d'Allah la trouvent." }
  ],
  munajat: `Ya Rabb, je cherche la proximité auprès de Toi, pas auprès des tyrans. Ne permets pas que je sois séduit par de fausses promesses. Fais que je sois parmi Tes rapprochés.`
};

MIROIR["7:115"] = {
  reference: "7:115",
  theme: ["choix", "jeter", "magiciens"],
  emotion: "Défi, confrontation",
  difficulty: "débutant",
  relatedNames: ["Al-Ikhtiyar", "Al-Ram"],
  mirrorVersion: `« Ils dirent : Ô Moïse, ou bien tu jettes, ou bien nous jetterons les premiers. » Le miroir confronte : « Qalu ya Musa imma an tulqiya wa imma an nakuna awwala man alqa » — ils dirent : Ô Moïse, ou bien tu jettes, ou bien nous jetterons les premiers. Le choix du premier jet. La confrontation est prête.`,
  reflection: `Les magiciens proposent le choix du premier jet. La confrontation est prête à commencer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ya Musa imma an tulqiya wa imma an nakuna awwala man alqa » — ils dirent : Ô Moïse, ou bien tu jettes, ou bien nous jetterons les premiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la confrontation avec la vérité ? Ou est-ce que je l'évite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix du moment de la confrontation n'appartient qu'à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La confrontation entre l'illusion et la vérité est inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le moment de la confrontation sera confondu." }
  ],
  munajat: `Ya Rabb, j'accepte la confrontation avec la vérité. Je ne la fuis pas. Fais que je sois du côté de la vérité, pas de l'illusion.`
};

MIROIR["7:116"] = {
  reference: "7:116",
  theme: ["jeter", "magie", "peur"],
  emotion: "Confrontation, illusion",
  difficulty: "débutant",
  relatedNames: ["Al-Ram", "Al-Sihr"],
  mirrorVersion: `« Il dit : Jetez. Et quand ils jetèrent, ils ensorcelèrent les yeux des gens. » Le miroir ensorcelle : « Qala alqu fa-lamma alqaw saharu a'yuna al-nas » — il dit : Jetez. Et quand ils jetèrent, ils ensorcelèrent les yeux des gens. L'illusion visuelle. « Et ils les terrorisèrent » — la peur comme arme. La magie agit sur la perception, pas sur la réalité.`,
  reflection: `La magie ensorcelle les yeux et terrorise les cœurs. L'illusion agit sur la perception, pas sur la réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala alqu fa-lamma alqaw saharu a'yuna al-nas wa istarahubuhum wa ja'u bi-sihrin 'azim » — il dit : Jetez. Et quand ils jetèrent, ils ensorcelèrent les yeux des gens, les terrorisèrent, et vinrent avec une grande magie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui ensorcelle mes yeux et me détourne de la réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illusion est puissante mais la vérité la dissipe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perception peut être trompée, mais la réalité reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont les yeux sont ouverts par Allah ne peut être ensorcelé." }
  ],
  munajat: `Ya Rabb, ouvre mes yeux à la réalité. Ne permets pas que je sois ensorcelé par les illusions. Donne-moi de voir la vérité au-delà des apparences.`
};

MIROIR["7:117"] = {
  reference: "7:117",
  theme: ["révélation", "bâton", "dévoreur"],
  emotion: "Victoire, puissance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-'Asa"],
  mirrorVersion: `« Et Nous révélâmes à Moïse : Jette ton bâton. » Le miroir révèle : « Wa awhayna ila Musa an alqi 'asak » — et Nous révélâmes à Moïse : Jette ton bâton. La révélation vient au moment crucial. « Et voilà qu'il dévore ce qu'ils avaient fabriqué » — la vérité dévore l'illusion.`,
  reflection: `La révélation à Moïse de jeter son bâton. La vérité dévore l'illusion comme le serpent dévore les illusions des magiciens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awhayna ila Musa an alqi 'asaka fa-idha hiya talqafu ma ya'fikun » — et Nous révélâmes à Moïse : Jette ton bâton. Et voilà qu'il dévore ce qu'ils avaient fabriqué." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jette ce que j'ai devant Allah ? Laisse-Il la vérité dévorer mes illusions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité dévore l'illusion sans effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La réalité d'Allah est toujours plus forte que les illusions des hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la révélation d'Allah voit la vérité dévorer l'illusion." }
  ],
  munajat: `Ya Rabb, je jette mon bâton devant Toi. Fais que Ta vérité dévore mes illusions. Révèle-moi ce que je dois faire au moment crucial.`
};

MIROIR["7:118"] = {
  reference: "7:118",
  theme: ["vérité", "vainqueur", "constat"],
  emotion: "Victoire, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Ghalab"],
  mirrorVersion: `« Et la vérité se manifesta et ce qu'ils firent fut vain. » Le miroir vainc : « Wa waqa'a al-haqqu wa batala ma kanu ya'malun » — et la vérité se manifesta et ce qu'ils firent fut vain. La manifestation de la vérité annule l'illusion. Le vainqueur n'est pas celui qui a la plus grande illusion, mais celui qui a la vérité.`,
  reflection: `La vérité se manifeste et l'illusion devient vaine. Le vainqueur est celui qui a la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa waqa'a al-haqqu wa batala ma kanu ya'malun » — et la vérité se manifesta et ce qu'ils firent fut vain." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je laisse la vérité se manifester dans ma vie ? Ou est-ce que je m'accroche à l'illusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La manifestation de la vérité est la victoire de l'homme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par triompher de l'illusion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la vérité n'a pas peur de l'illusion." }
  ],
  munajat: `Ya Haqq, manifeste Ta vérité dans ma vie. Fais que mes illusions soient vaines. Fais que je sois du côté de la vérité qui triomphe.`
};

MIROIR["7:119"] = {
  reference: "7:119",
  theme: ["vaincus", "retournés", "humiliés"],
  emotion: "Défaite, humiliation",
  difficulty: "débutant",
  relatedNames: ["Al-Hazimah", "Al-Dhillah"],
  mirrorVersion: `« Ils furent vaincus là et se trouvèrent humiliés. » Le miroir humilie : « Fa-ghulibu hunalika wa inqalabu saghirin » — ils furent vaincus là et se trouvèrent humiliés. La défaite est totale. L'humiliation suit la vanité. Les magiciens qui pensaient vaincre sont vaincus.`,
  reflection: `La défaite des magiciens et leur humiliation. La vanité précède la chute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ghulibu hunalika wa inqalabu saghirin » — ils furent vaincus là et se trouvèrent humiliés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je vaincu par la vérité ou par l'illusion ? Mon humiliation est-elle juste ou injuste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humiliation de l'illusionniste est la victoire de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vanité précède toujours la chute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humiliation acceptée mène à l'élévation." }
  ],
  munajat: `Ya Rabb, si je suis humilié, que ce soit pour la vérité. Ne permets pas que je sois humilié par mon attachement à l'illusion. Élève-moi par l'humilité.`
};

MIROIR["7:120"] = {
  reference: "7:120",
  theme: ["prosternation", "magiciens", "soumission"],
  emotion: "Soumission, conversion",
  difficulty: "débutant",
  relatedNames: ["As-Sujud", "Al-Iman"],
  mirrorVersion: `« Et les magiciens se jetèrent prosternés. » Le miroir convertit : « Wa ulqiya al-saharatu sajjudin » — et les magiciens se jetèrent prosternés. La conversion immédiate. Devant la vérité manifeste, l'illusionniste devient croyant. La prosternation est la réponse du cœur éclairé.`,
  reflection: `Les magiciens se convertissent et se prosternent. La vérité manifeste convertit instantanément.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ulqiya al-saharatu sajjudin » — et les magiciens se jetèrent prosternés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prosterne devant la vérité quand elle se manifeste ? Ou est-ce que je persiste dans l'illusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation des magiciens est la victoire de la vérité sur l'illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité manifeste convertit instantanément." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne devant la vérité reçoit la grâce de la conversion." }
  ],
  munajat: `Ya Rabb, je me prosterne devant Ta vérité. Convertis mon cœur par Ta manifestation. Ne permets pas que je persiste dans l'illusion.`
};

MIROIR["7:121"] = {
  reference: "7:121",
  theme: ["foi", "Seigneur", "mondes"],
  emotion: "Profession de foi, conversion",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Rabb al-'Alamin"],
  mirrorVersion: `« Ils dirent : Nous croyons au Seigneur des mondes. » Le miroir proclame : « Qalu amanna bi-rabbi al-'alamin » — ils dirent : Nous croyons au Seigneur des mondes. La profession de foi. La conversion complète. Le Seigneur des mondes est reconnu comme le vrai Dieu.`,
  reflection: `La profession de foi des magiciens convertis. Le Seigneur des mondes est reconnu comme le vrai Dieu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu amanna bi-rabbi al-'alamin » — ils dirent : Nous croyons au Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je proclame ma foi clairement ? Ou est-ce que je la cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La profession de foi est la victoire du cœur sur la peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Seigneur des mondes est le Dieu de tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui proclame sa foi reçoit la force de la vérité." }
  ],
  munajat: `Ya Rabb, je proclame ma foi en Toi, le Seigneur des mondes. Donne-moi la force de professer ma foi clairement. Ne permets pas que je la cache par peur.`
};

MIROIR["7:122"] = {
  reference: "7:122",
  theme: ["Moïse", "Aaron", "envoyés"],
  emotion: "Profession de foi, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Musa", "Harun", "Al-Mursalun"],
  mirrorVersion: `« Le Seigneur de Moïse et d'Aaron. » Le miroir précise : « Rabbi Musa wa Harun » — le Seigneur de Moïse et d'Aaron. La reconnaissance des prophètes. Le Dieu qui envoie Moïse et Aaron est le vrai Dieu. La foi complète inclut la reconnaissance des messagers.`,
  reflection: `La reconnaissance du Dieu de Moïse et d'Aaron. La foi inclut la reconnaissance des prophètes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi Musa wa Harun » — le Seigneur de Moïse et d'Aaron." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais les prophètes d'Allah ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des prophètes accompagne la foi en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Moïse et Aaron sont des frères dans la prophétie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les prophètes reconnaît Celui qui les envoie." }
  ],
  munajat: `Ya Rabb, je reconnais Tes prophètes, Moïse et Aaron. Je crois en Celui qui les a envoyés. Fais que ma foi soit complète en Toi et en Tes messagers.`
};

MIROIR["7:123"] = {
  reference: "7:123",
  theme: ["Pharaon", "vengeance", "ruse"],
  emotion: "Menace, tyrannie",
  difficulty: "débutant",
  relatedNames: ["Fir'awn", "Al-Intiqam"],
  mirrorVersion: `« Pharaon dit : Avez-vous cru avant que je ne vous y autorise ? » Le miroir tyrannise : « Qala Fir'awnu amantum bihi qabla an adhana lakum » — Pharaon dit : Avez-vous cru avant que je ne vous y autorise ? La prétention de contrôle sur la foi. « C'est une ruse que vous avez tramée dans la ville » — l'accusation de complot.`,
  reflection: `Pharaon prétend contrôler la foi. Il accuse les magiciens de complot. La tyrannie prétend autoriser la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Fir'awnu amantum bihi qabla an adhana lakum innahu la-kaydun kadadtumuhu fi al-madina li-tukhriju minha ahlahu » — Pharaon dit : Avez-vous cru avant que je ne vous y autorise ? C'est une ruse que vous avez tramée dans la ville pour en expulser ses habitants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prétends contrôler la foi des autres ? Ou est-ce que je la respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prétention de contrôler la foi est le signe de la tyrannie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi n'a pas besoin d'autorisation humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit sans autorisation humaine a la foi la plus pure." }
  ],
  munajat: `Ya Rabb, je crois sans demander l'autorisation des hommes. Ma foi est à Toi seul. Ne permets pas que je sois tyrannique avec la foi des autres.`
};

MIROIR["7:124"] = {
  reference: "7:124",
  theme: ["châtiment", "mains", "pieds"],
  emotion: "Menace, cruauté",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Al-Salb"],
  mirrorVersion: `« Je vais vous couper mains et pieds opposés et vous crucifierai tous. » Le miroir menace : « La-uqatti'anna aydiyakum wa arjulakum min khilafin » — je vais vous couper mains et pieds opposés. La torture promise. « Et je vous crucifierai tous » — la mort publique. La cruauté tyrannique est sans limite.`,
  reflection: `La torture et la crucifixion promises par Pharaon. La cruauté tyrannique n'a pas de limite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-uqatti'anna aydiyakum wa arjulakum min khilafin wa la-usallibannakum ajma'in » — je vais vous couper mains et pieds opposés et je vous crucifierai tous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je suis prêt à sacrifier pour ma foi ? Les magiciens ont risqué leur vie." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La menace du tyran ne peut atteindre l'âme du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La cruauté des tyrans est limitée, la miséricorde d'Allah est infinie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sacrifie sa vie pour Allah reçoit la vie éternelle." }
  ],
  munajat: `Ya Rabb, donne-moi la force de supporter les menaces pour ma foi. Ne permets pas que je renie ma foi par peur du châtiment. Accorde-moi le martyre si c'est Ton décret.`
};

MIROIR["7:125"] = {
  reference: "7:125",
  theme: ["retour", "Seigneur", "soumission"],
  emotion: "Acceptation, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Rujū'", "Ar-Rabb"],
  mirrorVersion: `« Ils dirent : Nous retournerons vers notre Seigneur. » Le miroir accepte : « Qalu inna ila rabbina munqalibun » — ils dirent : Nous retournerons vers notre Seigneur. L'acceptation du destin. La menace de mort devient promesse de retour. Le tyran menace la mort, le croyant espère le retour.`,
  reflection: `L'acceptation du destin par les magiciens. La mort menace devient promesse de retour vers le Seigneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu inna ila rabbina munqalibun » — ils dirent : Nous retournerons vers notre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte mon destin avec confiance ? Ou est-ce que je me révolte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La menace de mort du tyran est la promesse de vie auprès d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour vers le Seigneur est le destin de tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le retour vers son Seigneur ne craint personne." }
  ],
  munajat: `Ya Rabb, j'accepte mon retour vers Toi. Je ne crains pas la mort. Fais que mon retour soit dans la foi et la soumission.`
};

MIROIR["7:126"] = {
  reference: "7:126",
  theme: ["vengeance", "signes", "patience"],
  emotion: "Appel, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Intiqam", "Al-Ayat"],
  mirrorVersion: `« Tu ne nous venges que parce que nous avons cru aux signes de notre Seigneur. » Le miroir dénonce : « Wa ma tanqimu minna illa an amanna bi-ayati rabbina » — tu ne nous venges que parce que nous avons cru aux signes de notre Seigneur. La raison de la persécution. « Seigneur, déverse sur nous la patience » — la supplication pour la force.`,
  reflection: `La persécution est la conséquence de la foi. La supplication pour la patience dans l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma tanqimu minna illa an amanna bi-ayati rabbina lamma ja'atna rabbana afrigh 'alayna sabran wa tawaffana muslimin » — tu ne nous venges que parce que nous avons cru aux signes de notre Seigneur quand ils nous sont venus. Seigneur, déverse sur nous la patience et fais-nous mourir soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis persécuté pour ma foi ? Comment je réagis à la persécution ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La persécution pour la foi est un honneur, pas une punition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La patience dans l'épreuve est la plus haute vertu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La mort dans la soumission est la plus belle mort." }
  ],
  munajat: `Ya Rabb, déverse sur moi la patience dans l'épreuve. Fais que je meure dans la soumission. Ne permets pas que je renie ma foi face à la persécution.`
};

MIROIR["7:127"] = {
  reference: "7:127",
  theme: ["notables", "Moïse", "corruption"],
  emotion: "Complot, manipulation",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'", "Musa"],
  mirrorVersion: `« Les notables du peuple de Pharaon dirent : Vas-tu laisser Moïse et son peuple semer la corruption sur terre ? » Le miroir manipule : « Wa qala al-mala'u min qawmi Fir'awna a-tadharu Musa wa qawmahu li-yufsidu fi al-ard » — les notables du peuple de Pharaon dirent : Vas-tu laisser Moïse et son peuple semer la corruption sur terre ? L'accusation inversée. « Et t'abandonner, toi et tes divinités ? » — l'appel à l'orgueil.`,
  reflection: `Les notables accusent Moïs de corruption. L'appel à l'orgueil de Pharaon pour qu'il agisse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala al-mala'u min qawmi Fir'awna a-tadharu Musa wa qawmahu li-yufsidu fi al-ardi wa yadharaka wa alihatak qala sa-nuqattilu abna'ahum wa nastahyi nisa'ahum » — les notables du peuple de Pharaon dirent : Vas-tu laisser Moïse et son peuple semer la corruption sur terre et t'abandonner, toi et tes divinités ? Il dit : Nous tuerons leurs fils et laisserons vivre leurs femmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse manipuler par les accusations inversées ? Ou est-ce que je vois la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de corruption vient souvent des corrompus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les tyrans utilisent la peur pour manipuler." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vérité n'est pas manipulé par les accusations." }
  ],
  munajat: `Ya Rabb, je ne me laisse pas manipuler par les accusations inversées. Je vois la vérité. Ne permets pas que je sois du côté des corrompus qui accusent les justes.`
};

MIROIR["7:129"] = {
  reference: "7:129",
  theme: ["oppression", "espoir", "promesse"],
  emotion: "Détresse, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Zulm", "Al-Raja'"],
  mirrorVersion: `« Ils dirent : Nous avons été opprimés avant que tu ne viennes à nous et après ton arrivée. » Le miroir se plaint : « Qalu udhina min qabli an ta'tiyana wa min ba'di ma ji'tana » — ils dirent : Nous avons été opprimés avant que tu ne viennes à nous et après ton arrivée. L'oppression semble continuer. « Il dit : Votre Seigneur détruira bientôt votre ennemi » — la promesse de victoire.`,
  reflection: `L'oppression continue mais la promesse de victoire est certaine. La délivrance est proche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu udhina min qabli an ta'tiyana wa min ba'di ma ji'tana qala 'asa rabbukum an yuhlika 'aduwwakum wa yastakhlifakum fi al-ard » — ils dirent : Nous avons été opprimés avant que tu ne viennes à nous et après ton arrivée. Il dit : Votre Seigneur détruira bientôt votre ennemi et vous fera succéder sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me plains de l'oppression continue ? Ou est-ce que je fais confiance à la promesse d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oppression continue précède souvent la délivrance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est plus certaine que l'oppression présente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la promesse d'Allah supporte l'oppression." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ta promesse. L'oppression ne m'abat pas. Détruis mon ennemi et fais-moi succéder sur terre.`
};

MIROIR["7:130"] = {
  reference: "7:130",
  theme: ["années", "famine", "récolte"],
  emotion: "Épreuve, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Sinin", "Al-Ja'b"],
  mirrorVersion: `« Nous avons saisi le peuple de Pharaon par des années de disette et de manque de récolte. » Le miroir éprouve : « Wa laqad akhadhna ala Fir'awna bi-al-sinina wa naqs mina al-thamarat » — Nous avons saisi le peuple de Pharaon par des années de disette et de manque de récolte. L'épreuve économique pour les faire réfléchir. « Peut-être se rappelleront-ils » — le but de l'épreuve.`,
  reflection: `L'épreuve économique est un rappel. La disette et le manque de récoltes doivent amener à la réflexion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad akhadhna ala Fir'awna bi-al-sinina wa naqs mina al-thamarat la'allahum yadhakkarun » — Nous avons saisi le peuple de Pharaon par des années de disette et de manque de récolte, peut-être se rappelleront-ils." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis frappé par la disette, est-ce que je me rappelle d'Allah ? Ou est-ce que je me plains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve économique est un rappel, pas une punition finale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les années de disette alternent avec les années d'abondance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rappel dans l'épreuve économique ouvre le cœur." }
  ],
  munajat: `Ya Rabb, je me rappelle de Toi dans la disette. Je ne me plains pas. Fais que l'épreuve m'ouvre le cœur, pas qu'elle m'endurcisse.`
};

MIROIR["7:131"] = {
  reference: "7:131",
  theme: ["bonheur", "malheur", "attribution"],
  emotion: "Ingratitude, orgueil",
  difficulty: "débutant",
  relatedNames: ["Al-Khawf", "Al-Sarra'"],
  mirrorVersion: `« Quand le bonheur leur venait, ils disaient : Cela nous est dû. » Le miroir attribue : « Fa-idha ja'athum al-hasnatu qalu lana hadhihi » — quand le bonheur leur venait, ils disaient : Cela nous est dû. L'attribution du bonheur à eux-mêmes. « Et quand un malheur les atteignait, ils voyaient là un mauvais présage de Moïse » — l'attribution du malheur au prophète.`,
  reflection: `Le bonheur est attribué à soi-même, le malheur au prophète. L'ingratitude et la mauvaise foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha ja'athum al-hasnatu qalu lana hadhihi wa in tushihum sayyi'atun yatattayyaru bi-Musa wa man ma'ahu » — quand le bonheur leur venait, ils disaient : Cela nous est dû. Et quand un malheur les atteignait, ils voyaient là un mauvais présage de Moïse et de ceux qui étaient avec lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'attribue le bonheur et le malheur ? À Allah ou aux circonstances ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tout vient d'Allah, le bonheur comme le malheur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bonheur et le malheur sont des tests d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attribue tout à Allah est équilibré dans le bonheur et le malheur." }
  ],
  munajat: `Ya Rabb, je T'attribue tout, le bonheur comme le malheur. Je ne vois pas de mauvais présage dans les épreuves. Fais que je sois reconnaissant et patient.`
};

MIROIR["7:132"] = {
  reference: "7:132",
  theme: ["signes", "obstination", "refus"],
  emotion: "Obstination, rejet",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Sihr"],
  mirrorVersion: `« Ils dirent : Quel que soit le signe que tu nous apportes pour nous ensorceler, nous ne croirons pas en toi. » Le miroir refuse : « Wa qalu mahma ta'tina bi-ayatin li-tasaharana biha fa-ma nahnu laka bi-mu'minin » — ils dirent : Quel que soit le signe que tu nous apportes pour nous ensorceler, nous ne croirons pas en toi. Le refus systématique. L'obstination ferme le cœur à tout signe.`,
  reflection: `Le refus systématique de croire, quel que soit le signe. L'obstination ferme le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu mahma ta'tina bi-ayatin li-tasaharana biha fa-ma nahnu laka bi-mu'minin » — ils dirent : Quel que soit le signe que tu nous apportes pour nous ensorceler, nous ne croirons pas en toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je refuse de croire par obstination ? Ou est-ce que j'ouvre mon cœur aux signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obstination ferme la porte que les signes tentent d'ouvrir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont nombreux, mais les cœurs obstinés ne les voient pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit « je ne croirai pas » scelle son propre cœur." }
  ],
  munajat: `Ya Rabb, je ne refuse pas Tes signes par obstination. J'ouvre mon cœur. Ne permets pas que je sois parmi ceux qui disent « je ne croirai pas » quel que soit le signe.`
};

MIROIR["7:133"] = {
  reference: "7:133",
  theme: ["fléaux", "invasion", "continuation"],
  emotion: "Épreuve, obstination",
  difficulty: "débutant",
  relatedNames: ["Al-Tufan", "Al-Jarad"],
  mirrorVersion: `« Alors Nous avons envoyé sur eux l'inondation, les sauterelles, les poux, les grenouilles et le sang. » Le miroir frappe : « Fa-arsalna 'alayhimu al-tufana wa al-jarada wa al-qummala wa al-dafadi'a wa al-dam » — alors Nous avons envoyé sur eux l'inondation, les sauterelles, les poux, les grenouilles et le sang. Les fléaux successifs. « Signes explicites » — la clarté des signes. « Ils s'enflèrent d'orgueil » — la réaction obstinée.`,
  reflection: `Les fléaux successifs comme signes explicites. L'orgueil persiste malgré les épreuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-arsalna 'alayhimu al-tufana wa al-jarada wa al-qummala wa al-dafadi'a wa al-dama tasriful ayatin fa-stakbaru wa kanu qawman mujrimin » — alors Nous avons envoyé sur eux l'inondation, les sauterelles, les poux, les grenouilles et le sang, comme signes explicites. Mais ils s'enflèrent d'orgueil et furent un peuple criminel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels fléaux Allah m'a-t-Il envoyés ? Est-ce que je m'enfuis d'orgueil ou je me repends ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les fléaux successifs sont des opportunités de repentir successives." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature elle-même peut devenir un fléau par la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'orgueil dans le fléau précipite le châtiment final." }
  ],
  munajat: `Ya Rabb, je me repends dans les fléaux. Je ne m'enfle pas d'orgueil. Fais que les épreuves m'humilient au lieu de m'endurcir.`
};

MIROIR["7:134"] = {
  reference: "7:134",
  theme: ["supplication", "promesse", "rupture"],
  emotion: "Supplication, mauvaise foi",
  difficulty: "débutant",
  relatedNames: ["Al-Du'a'", "Al-Wa'd"],
  mirrorVersion: `« Quand le châtiment les atteignait, ils disaient : Ô Moïse, invoque pour nous ton Seigneur. » Le miroir supplie : « Wa lamma waqa'a 'alayhimu al-riju qalu ya Musa ad'u lana rabbaka » — quand le châtiment les atteignait, ils disaient : Ô Moïse, invoque pour nous ton Seigneur. La supplication dans la détresse. « D'après la promesse qu'Il t'a faite » — la reconnaissance de l'alliance. « Si tu éloignes de nous le châtiment, nous croirons » — la promesse conditionnelle.`,
  reflection: `La supplication dans la détresse mais la promesse conditionnelle. La mauvaise foi dans l'engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lamma waqaqa 'alayhimu al-riju qalu ya Musa ad'u lana rabbaka bima 'ahida 'indaka la-in kashayta 'anna al-riju la-nu'minanna laka wa la-nursalanna ma'aka bani Isra'il » — quand le châtiment les atteignait, ils disaient : Ô Moïse, invoque pour nous ton Seigneur d'après la promesse qu'Il t'a faite. Si tu éloignes de nous le châtiment, nous croirons en toi et laisserons partir avec toi les Enfants d'Israël." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je supplie seulement dans la détresse ? Est-ce que je tiens mes promesses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse dans la détresse est souvent rompue dans l'aisance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La supplication sincère n'est pas conditionnelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui promet de croire si le châtiment s'éloigne ne croit pas vraiment." }
  ],
  munajat: `Ya Rabb, je supplie dans l'aisance comme dans la détresse. Je ne pose pas de conditions à ma foi. Fais que ma promesse soit sincère, pas conditionnelle.`
};

MIROIR["7:135"] = {
  reference: "7:135",
  theme: ["éloignement", "rupture", "châtiment"],
  emotion: "Mauvaise foi, conséquence",
  difficulty: "débutant",
  relatedNames: ["Al-Kashf", "Al-Ajal"],
  mirrorVersion: `« Puis quand Nous éloignions d'eux le châtiment pour un terme qu'ils devaient atteindre, ils rompaient leur promesse. » Le miroir constate : « Falamma kashayna 'anhumu al-riju ila ajalin hum balighuhu idha hum yanthakun » — puis quand Nous éloignions d'eux le châtiment pour un terme qu'ils devaient atteindre, ils rompaient leur promesse. La mauvaise foi est manifeste. Le terme accordé est utilisé pour persister.`,
  reflection: `Le châtiment éloigné ne change pas le cœur. La promesse est rompue dès que la peur disparaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma kashayna 'anhumu al-riju ila ajalin hum balighuhu idha hum yanthakun » — puis quand Nous éloignions d'eux le châtiment pour un terme qu'ils devaient atteindre, ils rompaient leur promesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je romps mes promesses dès que la peur disparaît ? Ou est-ce que je les tiens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse rompue révèle la foi absente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le terme accordé est une miséricorde, pas une excuse pour persister." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rompt sa promesse révèle ce qui était caché dans son cœur." }
  ],
  munajat: `Ya Rabb, je tiens mes promesses, même quand la peur disparaît. Ne permets pas que je sois parmi les hypocrites qui promettent et rompent. Fais que ma foi soit constante.`
};

MIROIR["7:136"] = {
  reference: "7:136",
  theme: ["vengeance", "mer", "naufrage"],
  emotion: "Justice, destruction",
  difficulty: "débutant",
  relatedNames: ["Al-Intiqam", "Al-Bahr"],
  mirrorVersion: `« Alors Nous Nous sommes vengés d'eux et les avons noyés dans les flots. » Le miroir punit : « Fa-antaqamna minhum fa-aghraqnahum fi al-yam » — alors Nous Nous sommes vengés d'eux et les avons noyés dans les flots. La vengeance divine. La mer devient tombeau. « Parce qu'ils traitaient Nos signes de mensonges » — la raison du châtiment.`,
  reflection: `La vengeance divine noie les obstinés. La mer devient leur tombeau. Le châtiment final pour ceux qui rejettent les signes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-antaqamna minhum fa-aghraqnahum fi al-yam bi-annahum kadhdhabu bi-ayatina wa kanu 'anha ghafl » — alors Nous Nous sommes vengés d'eux et les avons noyés dans les flots, parce qu'ils traitaient Nos signes de mensonges et ne s'en souciaient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je en train de traiter les signes d'Allah de mensonges ? Quel sera mon destin final ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noyade des obstinés est le résultat de leur obstination." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mer qui sépare les croyants de leurs ennemis peut les engloutir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le châtiment final vient quand le terme est atteint." }
  ],
  munajat: `Ya Rabb, je ne traite pas Tes signes de mensonges. Je m'en soucie. Préserve-moi du châtiment final des obstinés. Sauve-moi de la noyade.`
};

MIROIR["7:137"] = {
  reference: "7:137",
  theme: ["succession", "bénédiction", "établissement"],
  emotion: "Victoire, établissement",
  difficulty: "débutant",
  relatedNames: ["Al-Khilafah", "Al-Barakah"],
  mirrorVersion: `« Et Nous avons fait hériter au peuple opprimé les contrées orientales et occidentales. » Le miroir établit : « Wa awrathna al-qawma alladhina kanu yustad'afuna mashariqa al-ard wa magharibaha » — et Nous avons fait hériter au peuple opprimé les contrées orientales et occidentales. La succession promise. « La terre bénite » — la bénédiction de l'établissement. « La promesse de ton Seigneur s'est accomplie » — la réalisation divine.`,
  reflection: `L'héritage des opprimés sur les contrées orientales et occidentales. La promesse d'Allah s'accomplit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awrathna al-qawma alladhina kanu yustad'afuna mashariqa al-ard wa magharibaha allati barakna fiha wa tammat kalimatu rabbika al-husna 'ala bani Isra'il bima sabaru » — et Nous avons fait hériter au peuple opprimé les contrées orientales et occidentales de la terre que Nous avons bénies. Et la belle promesse de ton Seigneur s'est accomplie sur les Enfants d'Israël, pour leur patience." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente dans l'oppression, sachant que la promesse d'Allah s'accomplira ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience des opprimés mène à l'héritage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'oppression temporaire précède l'établissement éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La patience dans l'oppression est la clé de la succession." }
  ],
  munajat: `Ya Rabb, je patiente dans l'oppression. Je sais que Ta promesse s'accomplira. Fais-moi hériter de la terre bénie par ma patience.`
};

MIROIR["7:138"] = {
  reference: "7:138",
  theme: ["passage", "idole", "épreuve"],
  emotion: "Épreuve, égarement",
  difficulty: "débutant",
  relatedNames: ["Al-Bahr", "Al-Asnam"],
  mirrorVersion: `« Et Nous les fîmes traverser la mer. Puis ils vinrent à un peuple attaché à ses idoles. » Le miroir traverse : « Wa jawazna bi-bani Isra'ila al-bahr » — et Nous les fîmes traverser la mer. La délivrance. « Ils vinrent à un peuple attaché à ses idoles » — l'épreuve de l'idolâtrie. « Ils dirent : Ô Moïse, désigne-nous un dieu comme ils ont des dieux » — la demande d'idole.`,
  reflection: `Après la traversée de la mer, l'épreuve de l'idolâtrie. La demande d'un dieu visible révèle la foi fragile.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa jawazna bi-bani Isra'ila al-bahr fa-ataw 'ala qawmin ya'kufuna ashnamahum qalu ya Musa ij'al lana ilahan kama lahum alihah » — et Nous les fîmes traverser la mer. Puis ils vinrent à un peuple attaché à ses idoles. Ils dirent : Ô Moïse, désigne-nous un dieu comme ils ont des dieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande des dieux visibles après avoir vu les miracles d'Allah ? Ou est-ce que je reste ferme dans l'unicité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande d'idole révèle la faiblesse de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme cherche souvent ce qu'il peut voir, pas ce qui est invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi ferme refuse l'idole même après le miracle." }
  ],
  munajat: `Ya Rabb, je ne demande pas d'idole visible. Je reste ferme dans Ton unicité. Ne permets pas que je sois égaré par les coutumes des autres peuples.`
};

MIROIR["7:139"] = {
  reference: "7:139",
  theme: ["destruction", "idolâtrie", "erreur"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Halak", "Al-Batil"],
  mirrorVersion: `« Il dit : Vous êtes un peuple ignorant. » Le miroir condamne : « Qala innakum qawmun tajhalun » — il dit : Vous êtes un peuple ignorant. L'ignorance de la demande d'idole. « Ce qu'ils font est voué à la destruction » — le destin de l'idolâtrie. « Et leurs actions sont vaines » — l'inutilité du culte des idoles.`,
  reflection: `L'ignorance de la demande d'idole. L'idolâtrie est vouée à la destruction. Les actions des idolâtres sont vaines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala innakum qawmun tajhalun hadha'un la-yubtilu ma hiya 'amilun wa batilun ma kanu ya'malun » — il dit : Vous êtes un peuple ignorant. Ce qu'ils font est voué à la destruction, et leurs actions sont vaines." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis ignorant comme eux ? Ou est-ce que je comprends que l'idolâtrie est vaine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de l'idolâtre contraste avec la connaissance du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce qui est bâti sur le faux s'effondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance du vrai Dieu protège de l'idolâtrie." }
  ],
  munajat: `Ya Rabb, je ne suis pas ignorant. Je sais que l'idolâtrie est vaine. Garde-moi dans la connaissance du vrai Dieu. Ne permets pas que mes actions soient vaines.`
};

MIROIR["7:140"] = {
  reference: "7:140",
  theme: ["exclusivité", "guide", "choix"],
  emotion: "Affirmation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Tawhid", "Al-Huda"],
  mirrorVersion: `« Il dit : Chercherais-je un autre dieu qu'Allah pour vous ? » Le miroir questionne : « Qala a-ghayra Allahi abghi ilahan » — il dit : Chercherais-je un autre dieu qu'Allah pour vous ? L'absurdité de la question. « Alors qu'Il vous a préférés à tout le monde » — la préférence divine. L'exclusivité de l'adoration.`,
  reflection: `L'absurdité de chercher un autre dieu qu'Allah. La préférence divine pour Son peuple implique l'exclusivité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala a-ghayra Allahi abghi ilahan wa huwa faddalakum 'ala al-'alamin » — il dit : Chercherais-je un autre dieu qu'Allah pour vous, alors qu'Il vous a préférés à tout le monde ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche un autre dieu qu'Allah ? Ou est-ce que je Lui suis exclusif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence divine demande l'exclusivité de l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah a préféré Son peuple — mais la préférence demande la fidélité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'exclusivité pour Allah est la reconnaissance de Sa préférence." }
  ],
  munajat: `Ya Rabb, je ne cherche pas d'autre dieu que Toi. Tu m'as préféré — je Te suis exclusif. Fais que mon adoration soit pour Toi seul.`
};

MIROIR["7:141"] = {
  reference: "7:141",
  theme: ["sauvetage", "tyrannie", "gratitude"],
  emotion: "Reconnaissance, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Najat", "Al-Shukr"],
  mirrorVersion: `« Et quand Nous vous avons sauvés des gens de Pharaon qui vous infligeaient le pire châtiment. » Le miroir rappelle : « Wa idh anjaynakum min ali Fir'awna yasumunakum su'a al-'adhab » — et quand Nous vous avons sauvés des gens de Pharaon qui vous infligeaient le pire châtiment. Le rappel du sauvetage. « Ils tuaient vos fils et laissaient vivre vos femmes » — le souvenir de l'oppression.`,
  reflection: `Le rappel du sauvetage de l'oppression de Pharaon. Le souvenir des tueries et de l'humiliation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh anjaynakum min ali Fir'awna yasumunakum su'a al-'adhab yuqattiluna abna'akum wa yastahyuna nisa'akum wa fi dhalikum bala'un min rabbikum 'azim » — et quand Nous vous avons sauvés des gens de Pharaon qui vous infligeaient le pire châtiment. Ils tuaient vos fils et laissaient vivre vos femmes. Il y avait là une épreuve terrible de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quelles oppressions Allah m'a-t-Il sauvé ? Est-ce que je me rappelle et je suis reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sauvetage de l'oppression demande la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque sauvetage d'Allah est une miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le souvenir du sauvetage est la base de la gratitude." }
  ],
  munajat: `Ya Rabb, je me rappelle Tes sauvetages. Merci de m'avoir délivré de l'oppression. Fais que je sois reconnaissant, pas oublieux.`
};

MIROIR["7:142"] = {
  reference: "7:142",
  theme: ["rendez-vous", "moi", "absence"],
  emotion: "Attente, épreuve",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mi'at", "Harun"],
  mirrorVersion: `« Et Nous donnâmes rendez-vous à Moïse pendant trente nuits. » Le miroir attend : « Wa wa'adna Musa thalathina laylah » — et Nous donnâmes rendez-vous à Moïse pendant trente nuits. Le rendez-vous divin. « Que Nous complétâmes par dix » — l'extension. « Aaron est mon lieutenant » — la désignation du successeur.`,
  reflection: `Le rendez-vous divin avec Moïse pour la révélation. L'extension du temps. La désignation d'Aaron comme lieutenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wa'adna Musa thalathina laylah wa atamnaha bi-'ashrin fatamma miqatu rabbihi arba'ina laylah wa qala Musa li-akhihi Haruni akhlufni fi qawmi » — et Nous donnâmes rendez-vous à Moïse pendant trente nuits, que Nous complétâmes par dix. Son rendez-vous avec son Seigneur s'accomplit en quarante nuits. Et Moïse dit à son frère Aaron : Remplace-moi auprès de mon peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends le rendez-vous d'Allah avec patience ? Qui me remplace dans mes responsabilités ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attente du rendez-vous divin est une préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps d'attente est le temps de préparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le lieutenant fidèle permet l'absence du chef." }
  ],
  munajat: `Ya Rabb, j'attends Ton rendez-vous avec patience. Prépare-moi pendant l'attente. Donne-moi des lieutenants fidèles pour mes responsabilités.`
};

// ==================== SURAH 14: IBRAHIM - VERSETS MANQUANTS ====================

MIROIR["14:2"] = {
  reference: "14:2",
  theme: ["Allah", "foi", "chemin"],
  emotion: "Guidance, lumière",
  difficulty: "débutant",
  relatedNames: ["Allah", "Al-Huda"],
  mirrorVersion: `« Allah, à qui appartient tout ce qui est dans les cieux et sur terre. » Le miroir affirme : « Allahi alladhi lahu ma fi al-samawati wa ma fi al-ard » — Allah, à qui appartient tout ce qui est dans les cieux et sur terre. La propriété d'Allah est totale. Le miroir m'enseigne : tout appartient à Allah.`,
  reflection: `Tout appartient à Allah. Qu'est-ce que je possède vraiment ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Allahi alladhi lahu ma fi al-samawati wa ma fi al-ard » — Allah, à qui appartient tout ce qui est dans les cieux et sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je possède ? Est-ce que je reconnais que tout est à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la propriété d'Allah libère de l'attachement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient à Allah — l'homme ne possède rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la propriété d'Allah est libéré de l'avidité." }
  ],
  munajat: `Ya Rabb, tout T'appartient. Fais que je reconnaisse Ta propriété. Ne permets pas que je m'attache à ce qui n'est pas à moi.`
};

MIROIR["14:3"] = {
  reference: "14:3",
  theme: ["mécréance", "préférence", "châtiment"],
  emotion: "Avertissement, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kufr", "Al-'Adhab"],
  mirrorVersion: `« Ceux qui préfèrent la vie d'ici-bas à l'au-delà. » Le miroir avertit : « Alladhina yastahibbuna al-hayata al-dunya 'ala al-akhirah » — ceux qui préfèrent la vie d'ici-bas à l'au-delà. La préférence pour le bas monde est condamnée. Le miroir m'enseigne : l'au-delà vaut plus que ce monde.`,
  reflection: `L'au-delà vaut plus que ce monde. Que préfère-je ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yastahibbuna al-hayata al-dunya 'ala al-akhirah » — ceux qui préfèrent la vie d'ici-bas à l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que préfère-je ? Ce monde ou l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence pour ce monde est une perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce monde est temporaire — l'au-delà est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préférence pour l'au-delà commence par le détachement de ce monde." }
  ],
  munajat: `Ya Rabb, fais que je préfère l'au-delà. Ne permets pas que ce monde me séduise. Donne-moi le détachement du bas monde.`
};

MIROIR["14:4"] = {
  reference: "14:4",
  theme: ["messagers", "langue", "peuple"],
  emotion: "Sagesse, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Rusul", "Al-Lisan"],
  mirrorVersion: `« Nous n'avons envoyé aucun messager sans qu'il parle la langue de son peuple. » Le miroir explique : « Wa ma arsalna min rasulin illa bi-lisani qawmihi » — nous n'avons envoyé aucun messager sans qu'il parle la langue de son peuple. La langue du message est la langue du peuple. Le miroir m'enseigne : le message doit être compréhensible.`,
  reflection: `Le message doit être compréhensible. Est-ce que je comprends le message d'Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalna min rasulin illa bi-lisani qawmihi » — nous n'avons envoyé aucun messager sans qu'il parle la langue de son peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends le message d'Allah ? Est-ce que je parle sa langue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La langue du peuple est le véhicule du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple a reçu un messager dans sa langue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compréhension du message est le premier pas vers la foi." }
  ],
  munajat: `Ya Rabb, merci pour le message dans ma langue. Fais que je le comprenne. Ne permets pas que la langue soit une barrière.`
};

MIROIR["14:5"] = {
  reference: "14:5",
  theme: ["Moïse", "signes", "sortie"],
  emotion: "Libération, guidance",
  difficulty: "débutant",
  relatedNames: ["Musa", "Al-Ayat"],
  mirrorVersion: `« Nous avons envoyé Moïse avec Nos signes : Fais sortir ton peuple des ténèbres vers la lumière. » Le miroir commande : « Akhriq qawmaka min al-zulumati ila al-nur » — fais sortir ton peuple des ténèbres vers la lumière. La sortie des ténèbres est la mission de chaque messager. Le miroir m'enseigne : la sortie des ténèbres est nécessaire.`,
  reflection: `La sortie des ténèbres est nécessaire. Suis-je dans les ténèbres ou dans la lumière ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Akhriq qawmaka min al-zulumati ila al-nur » — fais sortir ton peuple des ténèbres vers la lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je dans les ténèbres ou dans la lumière ? Comment sortir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lumière attend ceux qui quittent les ténèbres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple a besoin de sortir des ténèbres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sortie des ténèbres commence par la reconnaissance de l'être dans les ténèbres." }
  ],
  munajat: `Ya Rabb, fais-moi sortir des ténèbres vers la lumière. Ne permets pas que je reste dans l'obscurité. Guide-moi vers la lumière.`
};

MIROIR["14:6"] = {
  reference: "14:6",
  theme: ["Moïse", "Pharaon", "souffrance"],
  emotion: "Souvenance, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Musa", "Fir'awn"],
  mirrorVersion: `« Rappelez-vous quand Moïse dit à son peuple : Souvenez-vous du bienfait d'Allah. » Le miroir rappelle : « Udhkuru ni'mata Allahi 'alaykum » — souvenez-vous du bienfait d'Allah sur vous. Le souvenir des bienfaits est essentiel. Le miroir m'enseigne : la gratitude commence par le souvenir.`,
  reflection: `La gratitude commence par le souvenir. Quels bienfaits ai-je oubliés ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udhkuru ni'mata Allahi 'alaykum » — souvenez-vous du bienfait d'Allah sur vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits ai-je oubliés ? Comment les souvenir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souvenir des bienfaits passés augmente la gratitude présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bienfaits d'Allah sont innombrables — le souvenir les compte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude constante attire de nouveaux bienfaits." }
  ],
  munajat: `Ya Rabb, merci pour Tes bienfaits. Fais que je me souvienne toujours de Tes faveurs. Ne permets pas que j'oublie.`
};

// ==================== SURAH 15: AL-HIJR - VERSETS MANQUANTS ====================

MIROIR["15:2"] = {
  reference: "15:2",
  theme: ["désir", "soumission", "mécréance"],
  emotion: "Réalité, regret",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Raghbah", "Al-Islam"],
  mirrorVersion: `« Souvent, ceux qui ont mécru souhaiteraient avoir été musulmans. » Le miroir révèle : « Rubbama yawaddu alladhina kafaru law kanu muslimin » — souvent, ceux qui ont mécru souhaiteraient avoir été musulmans. Le regret des mécréants est constant. Le miroir m'enseigne : l'islam est le choix qu'on regrette de ne pas avoir fait.`,
  reflection: `L'islam est le choix qu'on regrette de ne pas avoir fait. Ai-je fait ce choix ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rubbama yawaddu alladhina kafaru law kanu muslimin » — souvent, ceux qui ont mécru souhaiteraient avoir été musulmans." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je fait le choix de l'islam ? Ou est-ce que je regretterai plus tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret des mécréants est la preuve de la valeur de l'islam." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'islam est le chemin — le regret est pour ceux qui l'ont manqué." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le choix de l'islam maintenant évite le regret plus tard." }
  ],
  munajat: `Ya Rabb, j'ai fait le choix de l'islam. Fais que je ne regrette pas ce choix. Ne permets pas que je sois parmi ceux qui souhaiteraient l'avoir fait.`
};

MIROIR["15:3"] = {
  reference: "15:3",
  theme: ["laisser", "manger", "jouissance"],
  emotion: "Laissez-faire, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Tarak", "Al-Tamattu'"],
  mirrorVersion: `« Laisse-les manger et jouir. » Le miroir laisse : « Dharhum ya'kulu wa yatamatta'u » — laisse-les manger et jouir. Le laisser-faire est un châtiment déguisé. Le miroir m'enseigne : la jouissance sans fin n'est pas une bénédiction.`,
  reflection: `La jouissance sans fin n'est pas une bénédiction. Est-ce que je suis dans ce laisser-faire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dharhum ya'kulu wa yatamatta'u » — laisse-les manger et jouir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis dans ce laisser-faire ? La jouissance me détourne-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le laisser-faire est un châtiment déguisé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La jouissance temporaire cache souvent la perte éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance du laisser-faire est le premier pas vers le réveil." }
  ],
  munajat: `Ya Rabb, ne me laisse pas dans le laisser-faire. Réveille-moi de ma jouissance. Ne permets pas que je sois trompé par les plaisirs.`
};

MIROIR["15:4"] = {
  reference: "15:4",
  theme: ["destruction", "cités", "décret"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Halak", "Al-Qura"],
  mirrorVersion: `« Nous n'avons détruit aucune cité sans qu'elle n'ait eu un décret connu. » Le miroir décrète : « Wa ma ahlakna min qaryatin illa wa laha kitabun ma'lum » — nous n'avons détruit aucune cité sans qu'elle n'ait eu un décret connu. La destruction suit le décret. Le miroir m'enseigne : rien n'est détruit sans raison.`,
  reflection: `Rien n'est détruit sans raison. Quelle est la raison de ma destruction potentielle ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ahlakna min qaryatin illa wa laha kitabun ma'lum » — nous n'avons détruit aucune cité sans qu'elle n'ait eu un décret connu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la raison de ma destruction potentielle ? Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le décret connu est une opportunité de repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cités détruites sont des exemples pour nous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance du décret permet l'évitement de la destruction." }
  ],
  munajat: `Ya Rabb, préserve-moi de la destruction. Fais que je connaisse le décret et que je m'y prépare. Ne permets pas que je sois détruit.`
};

MIROIR["15:5"] = {
  reference: "15:5",
  theme: ["avance", "retard", "terme"],
  emotion: "Décret, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ajal", "Al-Ta'jil"],
  mirrorVersion: `« Nulle communauté ne peut avancer ni retarder son terme. » Le miroir décrète : « Ma tasbiqu min ummatin ajalaha wa ma yasta'khirun » — nulle communauté ne peut avancer ni retarder son terme. Le terme est fixé. Le miroir m'enseigne : le temps est entre les mains d'Allah.`,
  reflection: `Le temps est entre les mains d'Allah. Comment j'utilise mon temps ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma tasbiqu min ummatin ajalaha wa ma yasta'khirun » — nulle communauté ne peut avancer ni retarder son terme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise mon temps ? Le terme est-il proche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité de changer le terme montre le pouvoir d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a son terme — chaque individu a son terme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du terme mène à l'utilisation sage du temps." }
  ],
  munajat: `Ya Rabb, mon terme est fixé. Fais que j'utilise mon temps sagement. Ne permets pas que je le gaspille.`
};

MIROIR["15:6"] = {
  reference: "15:6",
  theme: ["prophète", "accusation", "révélation"],
  emotion: "Rejet, accusation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nabi", "Al-Wahy"],
  mirrorVersion: `« Ils disent : Ô toi sur qui la révélation est descendue, tu es fou ! » Le miroir accuse : « Ya ayyuha alladhi nuzzila 'alayhi al-dhikru innaka la-majnun » — ô toi sur qui la révélation est descendue, tu es fou ! L'accusation de folie contre le prophète. Le miroir m'enseigne : le message dérange.`,
  reflection: `Le message dérange. Comment je réagis au message ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhi nuzzila 'alayhi al-dhikru innaka la-majnun » — ô toi sur qui la révélation est descendue, tu es fou !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis au message ? Est-ce que je traite le messager de fou ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation de folie est le refuge de ceux qui ne veulent pas entendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous été accusés de folie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La folie apparente du message est la sagesse cachée." }
  ],
  munajat: `Ya Rabb, fais que je ne traite pas Ton message de folie. Ouvre mon cœur à la sagesse du message. Ne permets pas que je sois parmi les accusateurs.`
};

MIROIR["15:7"] = {
  reference: "15:7",
  theme: ["anges", "demande", "condition"],
  emotion: "Exigence, défi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ikah", "Al-Shart"],
  mirrorVersion: `« Pourquoi ne fais-tu pas descendre les anges avec nous ? » Le miroir défie : « Law ma ta'tina bi-l-mala'ikati » — pourquoi ne fais-tu pas descendre les anges avec nous ? La demande des anges comme condition. Le miroir m'enseigne : les conditions sont souvent des excuses.`,
  reflection: `Les conditions sont souvent des excuses. Quelles conditions je pose pour croire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law ma ta'tina bi-l-mala'ikati » — pourquoi ne fais-tu pas descendre les anges avec nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles conditions je pose pour croire ? Sont-elles de vraies conditions ou des excuses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande des anges cache le refus de croire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges viendront — mais ce sera trop tard." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi sans condition est la foi sincère." }
  ],
  munajat: `Ya Rabb, je crois sans condition. Ne permets pas que je pose des conditions pour croire. Fais que ma foi soit sincère.`
};

MIROIR["15:8"] = {
  reference: "15:8",
  theme: ["anges", "révélation", "châtiment"],
  emotion: "Avertissement, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ikah", "Al-'Adhab"],
  mirrorVersion: `« Nous ne faisons descendre les anges qu'avec la vérité. » Le miroir avertit : « Ma nuzzilu al-mala'ikata illa bi-l-haqq » — nous ne faisons descendre les anges qu'avec la vérité. La descente des anges est sérieuse. Le miroir m'enseigne : les anges ne descendent pas pour le divertissement.`,
  reflection: `Les anges ne descendent pas pour le divertissement. Quelle est la vérité que les anges apportent ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma nuzzilu al-mala'ikata illa bi-l-haqq » — nous ne faisons descendre les anges qu'avec la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la vérité que les anges apportent ? Suis-je prêt pour cette vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La descente des anges est une miséricorde ou un châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont les messagers de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation pour la vérité évite le châtiment de la vérité." }
  ],
  munajat: `Ya Rabb, prépare-moi pour la vérité que les anges apportent. Ne permets pas que cette vérité soit un châtiment pour moi.`
};

MIROIR["17:24"] = {
  reference: "17:24",
  theme: ["parents", "compassion", "prière"],
  emotion: "Amour, humilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "Al-Walidayn"],
  mirrorVersion: `« Et par miséricorde, abaisse pour eux l'aile de l'humilité et dis : "Ô mon Seigneur, fais-leur miséricorde comme ils m'ont élevé petit." » Le miroir me montre le devoir envers les parents. « Wakhfid lahuma janaha al-dhulli » — abaisse pour eux l'aile de l'humilité. L'humilité envers les parents est un devoir. Le miroir m'interroge : est-ce que je suis humble envers mes parents ?`,
  reflection: `L'humilité envers les parents est un devoir. Leur éducation mérite reconnaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa khfid lahuma janaha al-dhulli min al-rahmati wa qul rabbirhamhuma kama rabbayani saghira » — et par miséricorde, abaisse pour eux l'aile de l'humilité et dis : Ô mon Seigneur, fais-leur miséricorde comme ils m'ont élevé petit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis humble envers mes parents ? Ou est-ce que je suis orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité envers les parents reflète la reconnaissance de leur éducation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les parents sont les premiers bienfaiteurs de l'enfant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore ses parents est honoré par Allah." }
  ],
  munajat: `Ya Rahman, fais miséricorde à mes parents comme ils m'ont élevé. Donne-moi l'humilité envers eux. Honore-les par ma reconnaissance.`
};

MIROIR["17:25"] = {
  reference: "17:25",
  theme: ["connaissance", "cœurs", "retour"],
  emotion: "Confiance, conscience",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khafiyyah"],
  mirrorVersion: `« Votre Seigneur connaît mieux ce qui est dans vos âmes. » Le miroir me montre la connaissance divine des cœurs. « Rabbukum a'lamu bima fi anfusikum » — votre Seigneur connaît mieux ce qui est dans vos âmes. Rien n'est caché d'Allah. Le miroir m'interroge : est-ce que je vis en sachant qu'Allah connaît mon intérieur ?`,
  reflection: `Allah connaît l'intérieur des cœurs. La sincérité est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbukum a'lamu bima fi anfusikum in takunu salihan fa-innahu kana lil-awwabina ghafura » — votre Seigneur connaît mieux ce qui est dans vos âmes. Si vous êtes vertueux, Il est certes Pardonneur pour ceux qui reviennent à Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant qu'Allah connaît mon intérieur ? Ou est-ce que je cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sincérité vient de la conscience de la connaissance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est caché d'Allah, même le plus secret des cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en sachant qu'Allah connaît purifie son intérieur." }
  ],
  munajat: `Ya 'Alim, Tu connais mon intérieur. Fais que je vive en sincérité. Pardonne-moi car je reviens à Toi.`
};

MIROIR["17:26"] = {
  reference: "17:26",
  theme: ["don", "proches", "gaspillage"],
  emotion: "Générosité, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ita'", "As-Safah"],
  mirrorVersion: `« Donne au proche son dû, ainsi qu'au pauvre et au voyageur. » Le miroir me montre les droits des proches et des pauvres. « Wa ati dha al-qurba haqqahu » — donne au proche son dû. Les proches ont des droits. Le miroir m'interroge : est-ce que je donne aux proches leurs droits ?`,
  reflection: `Les proches, les pauvres et les voyageurs ont des droits. Le gaspillage est interdit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ati dha al-qurba haqqahu wa al-miskina wa ibna al-sabili wa la tubadhdhir tabdhira » — donne au proche son dû, ainsi qu'au pauvre et au voyageur. Et ne gaspille pas excessivement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne aux proches leurs droits ? Ou est-ce que je les néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don aux proches renforce les liens familiaux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La générosité est une vertu qui purifie les richesses." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne aux proches reçoit la bénédiction." }
  ],
  munajat: `Ya Rabb, donne-moi de donner aux proches leurs droits. Ne permets pas le gaspillage. Bénis ma générosité envers les proches et les pauvres.`
};

MIROIR["17:27"] = {
  reference: "17:27",
  theme: ["gaspillage", "frères", "satan"],
  emotion: "Mise en garde, sagesse",
  difficulty: "débutant",
  relatedNames: ["At-Tabdhir", "Ash-Shaytan"],
  mirrorVersion: `« Ceux qui gaspillent sont les frères des démons. » Le miroir me montre la gravité du gaspillage. « Inna al-mubadhirin kanu ikhwana al-shayatin » — ceux qui gaspillent sont les frères des démons. Le gaspillage aligne avec Satan. Le miroir m'interroge : est-ce que je gaspille ou je suis économe ?`,
  reflection: `Le gaspillage aligne avec Satan. L'économie est une vertu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-mubadhirin kanu ikhwana al-shayatin » — ceux qui gaspillent sont les frères des démons." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je gaspille ou je suis économe ? Quel est mon rapport à la dépense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'économie est la vertu des sages." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ressources sont un don à gérer avec sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est économe est béni dans ses ressources." }
  ],
  munajat: `Ya Rabb, je ne veux pas gaspiller. Fais que je sois économe. Ne permets pas que je sois le frère des démons par le gaspillage.`
};

MIROIR["17:28"] = {
  reference: "17:28",
  theme: ["refus", "parole", "espérance"],
  emotion: "Sagesse, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Radd", "Al-Rahmah"],
  mirrorVersion: `« Si tu te détournes d'eux, cherchant une miséricorde de ton Seigneur, dis-leur une parole douce. » Le miroir me montre la manière de refuser. « Fa-qul lahum qawlan maysuran » — dis-leur une parole douce. Le refus doit être doux. Le miroir m'interroge : est-ce que je refuse avec douceur ?`,
  reflection: `Le refus doit être doux. La parole douce adoucit le refus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa imma tu'ridanna 'anhumu ibtigha'a rahmatin min rabbika tarjuha fa-qul lahum qawlan maysura » — si tu te détournes d'eux, cherchant une miséricorde de ton Seigneur que tu espères, dis-leur une parole douce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je refuse avec douceur ? Ou est-ce que je suis dur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parole douce fait accepter le refus." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La douceur dans le refus préserve la relation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse avec douceur est respecté." }
  ],
  munajat: `Ya Rabb, donne-moi de refuser avec douceur. Ne permets pas la dureté dans mes refus. Fais que ma parole soit douce même quand je ne peux pas donner.`
};

MIROIR["17:29"] = {
  reference: "17:29",
  theme: ["avarice", "main", "mesure"],
  emotion: "Équilibre, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Qabd", "Al-Bast"],
  mirrorVersion: `« Ne porte pas ta main enchaînée à ton cou, et ne l'étends pas non plus trop largement. » Le miroir me montre l'équilibre dans la dépense. « Wa la taj'al yadaka maghlulatan ila 'unuqika » — ne porte pas ta main enchaînée à ton cou. L'avarice et le gaspillage sont deux extrêmes à éviter. Le miroir m'interroge : est-ce que je trouve l'équilibre dans la dépense ?`,
  reflection: `L'avarice et le gaspillage sont deux extrêmes à éviter. L'équilibre est la voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taj'al yadaka maghlulatan ila 'unuqika wa la tabsutaha kulla al-basti » — ne porte pas ta main enchaînée à ton cou, et ne l'étends pas non plus trop largement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je trouve l'équilibre dans la dépense ? Ou est-ce que je tombe dans l'un des extrêmes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équilibre dans la dépense est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La voie médiane est la meilleure voie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui trouve l'équilibre est béni dans ses ressources." }
  ],
  munajat: `Ya Rabb, aide-moi à trouver l'équilibre dans la dépense. Ne permets pas l'avarice ni le gaspillage. Guide-moi vers la voie médiane.`
};

MIROIR["17:30"] = {
  reference: "17:30",
  theme: ["provision", "mesure", "sagesse"],
  emotion: "Confiance, acceptation",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Qadr"],
  mirrorVersion: `« Ton Seigneur pourvoit aux subsistances de qui Il veut et les mesure. » Le miroir me montre la distribution divine des provisions. « Yabsutu al-rizqa li-man yasha'u wa yaqdiru » — ton Seigneur pourvoit aux subsistances de qui Il veut et les mesure. La distribution suit la sagesse divine. Le miroir m'interroge : est-ce que j'accepte ma provision ?`,
  reflection: `La distribution des provisions suit la sagesse divine. L'acceptation de sa part est la paix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbaka yabsutu al-rizqa li-man yasha'u wa yaqdiru innahu kana bi-'ibadihi khabiran basira » — ton Seigneur pourvoit aux subsistances de qui Il veut et les mesure. Il est parfaitement Connaisseur et Clairvoyant sur Ses serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma provision ? Ou est-ce que je jalouse les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de sa part est le contentement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La distribution des provisions est juste et sage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa provision trouve la paix." }
  ],
  munajat: `Ya Razzaq, j'accepte ma provision. Ne permets pas la jalousie. Donne-moi le contentement de ce que Tu m'as distribué.`
};

MIROIR["17:31"] = {
  reference: "17:31",
  theme: ["enfants", "crainte", "provision"],
  emotion: "Confiance, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Awlad", "Ar-Rizq"],
  mirrorVersion: `« Ne tuez pas vos enfants par crainte de la pauvreté. » Le miroir me montre la protection des enfants. « Wa la taqtulu awladakum khashyata imlaq » — ne tuez pas vos enfants par crainte de la pauvreté. La provision des enfants est assurée par Allah. Le miroir m'interroge : est-ce que je fais confiance à Allah pour la provision ?`,
  reflection: `La provision des enfants est assurée par Allah. La crainte de la pauvreté ne doit pas mener au meurtre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqtulu awladakum khashyata imlaq nahnu narzuquhum wa iyyakum » — ne tuez pas vos enfants par crainte de la pauvreté. C'est Nous qui les nourrissons ainsi que vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Allah pour la provision ? Ou est-ce que je crains la pauvreté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah pour la provision libère de la crainte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Pourvoyeur de toute créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah pour la provision est libéré." }
  ],
  munajat: `Ya Razzaq, je fais confiance à Toi pour la provision. Ne permets pas que la crainte de la pauvreté me fasse peur. Nourris-moi et mes enfants.`
};

MIROIR["17:33"] = {
  reference: "17:33",
  theme: ["meurtre", "justice", "héritier"],
  emotion: "Justice, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qatl", "Al-Qisas"],
  mirrorVersion: `« Ne tuez pas l'âme qu'Allah a interdit de tuer, sauf à bon droit. » Le miroir me montre l'interdiction du meurtre. « Wa la taqtulu al-nafsa allati harrama Allahu » — ne tuez pas l'âme qu'Allah a interdit de tuer. La vie est sacrée. Le miroir m'interroge : est-ce que je respecte la vie sacrée ?`,
  reflection: `La vie est sacrée. Le meurtre sans droit est un grave péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqtulu al-nafsa allati harrama Allahu illa bi-al-haqqi » — ne tuez pas l'âme qu'Allah a interdit de tuer, sauf à bon droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la vie sacrée ? Ou est-ce que je la viole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect de la vie est le respect de la création divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie est un don sacré à préserver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la vie est respecté par Allah." }
  ],
  munajat: `Ya Rabb, je respecte la vie sacrée. Ne permets pas que je la viole. Protège-moi du meurtre injuste.`
};

MIROIR["17:34"] = {
  reference: "17:34",
  theme: ["orphelin", "bien", "engagement"],
  emotion: "Justice, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Yatim", "Al-'Ahd"],
  mirrorVersion: `« N'approchez des biens de l'orphelin que de la meilleure façon. » Le miroir me montre la protection des biens de l'orphelin. « Wa la taqrabu mal al-yatimi illa bi-llati hiya ahsan » — n'approchez des biens de l'orphelin que de la meilleure façon. Les biens de l'orphelin sont protégés. Le miroir m'interroge : est-ce que je protège les biens des orphelins ?`,
  reflection: `Les biens de l'orphelin sont protégés. La meilleure façon est la seule permission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqrabu mal al-yatimi illa bi-llati hiya ahsan hatta yablugha ashuddahu » — n'approchez des biens de l'orphelin que de la meilleure façon, jusqu'à ce qu'il atteigne sa maturité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je protège les biens des orphelins ? Ou est-ce que je les exploite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection des biens de l'orphelin est une obligation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orphelin est sous la protection divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège l'orphelin est protégé par Allah." }
  ],
  munajat: `Ya Rabb, je protège les biens des orphelins. Ne permets pas que je les exploite. Fais que je sois leur protecteur et non leur exploiteur.`
};

MIROIR["17:35"] = {
  reference: "17:35",
  theme: ["mesure", "justice", "équité"],
  emotion: "Justice, intégrité",
  difficulty: "débutant",
  relatedNames: ["Al-Kayl", "Al-Mizan"],
  mirrorVersion: `« Donnez la pleine mesure quand vous mesurez, et pesez avec la balance exacte. » Le miroir me montre l'équité dans les transactions. « Wa awfu al-kayla idha kiltum » — donnez la pleine mesure quand vous mesurez. L'équité dans les transactions est obligatoire. Le miroir m'interroge : est-ce que je suis équitable dans mes transactions ?`,
  reflection: `L'équité dans les transactions est obligatoire. La fraude est interdite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awfu al-kayla idha kiltum wa zinu bi-al-qistasi al-mustaqimi » — donnez la pleine mesure quand vous mesurez, et pesez avec la balance exacte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis équitable dans mes transactions ? Ou est-ce que je fraude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'équité dans les transactions purifie les gains." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice dans les transactions est la base de la confiance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est équitable dans les transactions est béni." }
  ],
  munajat: `Ya Rabb, je suis équitable dans mes transactions. Ne permets pas la fraude. Bénis mes transactions par l'équité.`
};

MIROIR["17:36"] = {
  reference: "17:36",
  theme: ["ignorance", "science", "vision"],
  emotion: "Humilité, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Jahl", "Al-'Ilm"],
  mirrorVersion: `« Ne poursuis pas ce dont tu n'as aucune connaissance. » Le miroir me montre l'interdiction de l'ignorance. « Wa la taqfu ma laysa laka bihi 'ilm » — ne poursuis pas ce dont tu n'as aucune connaissance. La parole sans science est interdite. Le miroir m'interroge : est-ce que je parle sans science ?`,
  reflection: `La parole sans science est interdite. L'audition, la vue et le cœur sont responsables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqfu ma laysa laka bihi 'ilm inna al-sam'a wa al-basara wa al-fu'ada kullu ulaika kana 'anhu mas'ula » — ne poursuis pas ce dont tu n'as aucune connaissance. L'ouïe, la vue et le cœur, tout cela sera interrogé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je parle sans science ? Ou est-ce que je me limite à ce que je sais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La limitation à ce qu'on sait est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque faculté sera interrogée sur son usage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se limite à sa science préserve son cœur." }
  ],
  munajat: `Ya Rabb, je ne veux pas parler sans science. Ne permets pas que je poursuive l'ignorance. Garde mon ouïe, ma vue et mon cœur dans Ton droit chemin.`
};

MIROIR["17:38"] = {
  reference: "17:38",
  theme: ["blâmable", "mécontentement", "voie"],
  emotion: "Mise en garde, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Qabih", "As-Sabil"],
  mirrorVersion: `« Tout cela est blâmable et détestable auprès de ton Seigneur. » Le miroir me montre le résumé des interdits. « Kullu dhalika kan sayyi'uhu 'inda rabbika makruha » — tout cela est blâmable et détestable auprès de ton Seigneur. Les interdits sont clairs. Le miroir m'interroge : est-ce que j'évite ce qu'Allah déteste ?`,
  reflection: `Les interdits sont clairs. L'évitement de ce qu'Allah déteste est la voie droite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu dhalika kan sayyi'uhu 'inda rabbika makruha » — tout cela est blâmable et détestable auprès de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite ce qu'Allah déteste ? Ou est-ce que je le pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement du blâmable est la voie droite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce qu'Allah déteste doit être évité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite ce qu'Allah déteste est agréé." }
  ],
  munajat: `Ya Rabb, j'évite ce que Tu détestes. Ne permets pas que je le pratique. Guide-moi vers ce que Tu aimes.`
};

MIROIR["17:39"] = {
  reference: "17:39",
  theme: ["sagesse", "révélation", "association"],
  emotion: "Gratitude, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hikmah", "Ash-Shirk"],
  mirrorVersion: `« Cela fait partie de la sagesse que ton Seigneur t'a révélée. » Le miroir me montre l'origine des commandements. « Dhalika mimma awha ilayka rabbuka min al-hikmati » — cela fait partie de la sagesse que ton Seigneur t'a révélée. La révélation est sagesse. Le miroir m'interroge : est-ce que je respecte la révélation comme sagesse ?`,
  reflection: `La révélation est sagesse. L'association avec Allah est le plus grand péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika mimma awha ilayka rabbuka min al-hikmati an la taj'ala ma'a Allahi ilahan akhara » — cela fait partie de la sagesse que ton Seigneur t'a révélée : ne place pas avec Allah une autre divinité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la révélation comme sagesse ? Ou est-ce que je la conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation est la sagesse divine pour guider l'homme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sagesse divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la révélation suit la sagesse." }
  ],
  munajat: `Ya Hakim, je respecte Ta révélation comme sagesse. Ne permets pas l'association. Garde-moi dans le monothéisme pur.`
};

MIROIR["17:40"] = {
  reference: "17:40",
  theme: ["fils", "anges", "préférence"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Banun", "Al-Mala'ikah"],
  mirrorVersion: `« Votre Seigneur vous aurait-Il distingués en vous donnant des fils et pris des anges pour filles ? » Le miroir me montre l'absurdité de la croyance des associateurs. « A-fa-asfakum rabbukum bi-al-banina wa ittakhadha mina al-mala'ikati banat » — votre Seigneur vous aurait-Il distingués en vous donnant des fils. L'attribution des filles à Allah est fausse. Le miroir m'interroge : est-ce que j'attribue à Allah ce qui est faux ?`,
  reflection: `L'attribution fausse à Allah est un mensonge. Dieu est au-dessus de ce qu'ils décrivent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-asfakum rabbukum bi-al-banina wa ittakhadha mina al-mala'ikati banatin innakum la-taquluna qawlan 'aziman » — votre Seigneur vous aurait-Il distingués en vous donnant des fils et pris des anges pour filles ? Vous prononcez une parole énorme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah ce qui est vrai ? Ou est-ce que j'attribue le faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie connaissance d'Allah évite les fausses attributions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est au-dessus de ce que les hommes décrivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît Allah vraiment ne Lui attribue pas le faux." }
  ],
  munajat: `Ya Rabb, je ne T'attribue que la vérité. Ne permets pas que j'attribue le faux. Fais que je Te connaisse comme Tu veux être connu.`
};

MIROIR["17:41"] = {
  reference: "17:41",
  theme: ["explication", "avertissement", "éloignement"],
  emotion: "Tristesse, patience",
  difficulty: "débutant",
  relatedNames: ["At-Tasrif", "Al-Indhar"],
  mirrorVersion: `« Nous avons expliqué dans ce Coran de diverses manières afin qu'ils se souviennent. » Le miroir me montre l'effort divin d'explication. « Wa laqad sarrafna fi hadha al-qur'ani » — nous avons expliqué dans ce Coran de diverses manières. L'explication multiple vise le rappel. Le miroir m'interroge : est-ce que je me souviens après l'explication ?`,
  reflection: `L'explication multiple vise le rappel. L'éloignement est le résultat de l'incrédulité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad sarrafna fi hadha al-qur'ani li-yadhakkaru wa ma yaziduhum illa nufura » — nous avons expliqué dans ce Coran de diverses manières afin qu'ils se souviennent. Mais cela ne fait qu'augmenter leur éloignement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens après l'explication ? Ou est-ce que je m'éloigne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel augmente la foi des croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'explication divine est parfaite pour ceux qui veulent comprendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient après l'explication est guidé." }
  ],
  munajat: `Ya Rabb, je me souviens après Ton explication. Ne permets pas que je m'éloigne. Augmente ma foi par Ton rappel.`
};

MIROIR["17:42"] = {
  reference: "17:42",
  theme: ["divinités", "ordre", "preuve"],
  emotion: "Clarté, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Alihah", "As-Sabil"],
  mirrorVersion: `« S'il y avait des divinités avec Allah, elles auraient cherché un chemin vers le Seigneur du Trône. » Le miroir me montre l'argument contre le polythéisme. « Law kana fi-hima alihatun illa Allahi » — s'il y avait des divinités avec Allah. L'unicité d'Allah est prouvée par l'impossibilité de la multiplicité. Le miroir m'interroge : est-ce que je comprends la preuve de l'unicité ?`,
  reflection: `L'unicité d'Allah est prouvée par l'impossibilité de la multiplicité des divinités.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law kana fi-hima alihatun illa Allahi la-fasadata wa la-khallaqa ila dhi al-'arshi » — s'il y avait des divinités avec Allah, elles auraient cherché un chemin vers le Seigneur du Trône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la preuve de l'unicité ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La multiplicité des divinités est impossible par la nature de la divinité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre parfait de l'univers prouve l'unicité du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'unicité adore Allah seul." }
  ],
  munajat: `Ya Ahad, je comprends Ton unicité. Ne permets pas que je doute. Fais que je T'adore seul, l'Unique et le Seul.`
};

MIROIR["17:43"] = {
  reference: "17:43",
  theme: ["gloire", "perfection", "élévation"],
  emotion: "Révérence, adoration",
  difficulty: "débutant",
  relatedNames: ["As-Subhan", "Al-Muta'ali"],
  mirrorVersion: `« Gloire à Lui ! Il est très élevé au-dessus de ce qu'ils disent. » Le miroir me montre la transcendance d'Allah. « Subhanahu wa ta'ala 'amma yaquluna 'uluwwan kabira » — gloire à Lui ! Il est très élevé au-dessus de ce qu'ils disent. Allah est transcendant. Le miroir m'interroge : est-ce que je glorifie Allah comme Il le mérite ?`,
  reflection: `Allah est transcendant. Il est au-dessus de ce que les hommes décrivent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subhanahu wa ta'ala 'amma yaquluna 'uluwwan kabira » — gloire à Lui ! Il est très élevé au-dessus de ce qu'ils disent, d'une élévation immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je glorifie Allah comme Il le mérite ? Ou est-ce que je Le limite par ma pensée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La glorification est la reconnaissance de la transcendance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transcendance d'Allah est absolue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui glorifie Allah Le connaît vraiment." }
  ],
  munajat: `Ya Subhan, Tu es glorifié et élevé. Fais que je Te glorifie comme Tu le mérites. Ne permets pas que je Te limite par ma pensée.`
};

MIROIR["15:10"] = {
  reference: "15:10",
  theme: ["messagers", "envoi", "précédents"],
  emotion: "Continuité, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Rusul", "Al-Irsal"],
  mirrorVersion: `« Nous avons envoyé avant toi des messagers parmi les anciennes communautés. » Le miroir affirme : « Wa laqad arsalna min qablika fi shiya'i al-awwalin » — nous avons envoyé avant toi des messagers parmi les anciennes communautés. L'envoi des messagers est constant. Le miroir m'enseigne : la guidance n'est jamais cessée.`,
  reflection: `La guidance n'est jamais cessée. Est-ce que j'accepte la guidance du messager ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad arsalna min qablika fi shiya'i al-awwalin » — nous avons envoyé avant toi des messagers parmi les anciennes communautés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la guidance du messager ? Ou est-ce que je rejette comme les anciens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet des messagers précédents est l'exemple à éviter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a reçu un messager." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'acceptation du messager actuel est le test de notre époque." }
  ],
  munajat: `Ya Rabb, j'accepte Ton messager. Fais que je ne sois pas comme ceux qui ont rejeté les messagers précédents. Guide-moi par la guidance.`
};

MIROIR["15:11"] = {
  reference: "15:11",
  theme: ["messager", "moquerie", "rejet"],
  emotion: "Constat, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rasul", "Al-Istihza'"],
  mirrorVersion: `« Il n'est pas venu de messager sans qu'ils ne s'en moquent. » Le miroir constate : « Wa ma ya'tihim min rasulin illa kanu bihi yastahzi'un » — il n'est pas venu de messager sans qu'ils ne s'en moquent. La moquerie est la réponse des mécréants. Le miroir m'enseigne : le message dérange.`,
  reflection: `Le message dérange. Comment je traite le messager ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ya'tihim min rasulin illa kanu bihi yastahzi'un » — il n'est pas venu de messager sans qu'ils ne s'en moquent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite le messager ? Est-ce que je me moque ou je respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie cache souvent la peur de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La moquerie des messagers est une constante historique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le respect du messager est le signe de la foi." }
  ],
  munajat: `Ya Rabb, je respecte Ton messager. Ne permets pas que je me moque du message. Fais que je sois parmi les respectueux.`
};

MIROIR["15:12"] = {
  reference: "15:12",
  theme: ["insertion", "cœurs", "criminels"],
  emotion: "Réality, conséquence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qulub", "Al-Mujrimin"],
  mirrorVersion: `« Ainsi Nous l'insérons dans les cœurs des criminels. » Le miroir insère : « Kadhalika naslukuhu fi qulubi al-mujrimin » — ainsi Nous l'insérons dans les cœurs des criminels. L'insertion de la moquerie est un châtiment. Le miroir m'enseigne : le cœur criminel attire le mal.`,
  reflection: `Le cœur criminel attire le mal. Qu'est-ce que mon cœur attire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika naslukuhu fi qulubi al-mujrimin » — ainsi Nous l'insérons dans les cœurs des criminels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon cœur attire ? Le bien ou le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur criminel est fermé à la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur attire ce qu'il contient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La purification du cœur protège de l'insertion du mal." }
  ],
  munajat: `Ya Rabb, purifie mon cœur du mal. Ne permets pas que mon cœur attire la moquerie. Fais que mon cœur attire le bien.`
};

MIROIR["15:13"] = {
  reference: "15:13",
  theme: ["incroyance", "précédents", "sunnah"],
  emotion: "Réalité, constat",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kufr", "Al-Sunnah"],
  mirrorVersion: `« Ils n'y croient pas, bien que le sort des anciens soit passé. » Le miroir constate : « La yu'minuna bihi wa qad madat sunnatu al-awwalin » — ils n'y croient pas, bien que le sort des anciens soit passé. L'histoire est un exemple. Le miroir m'enseigne : l'histoire est une leçon.`,
  reflection: `L'histoire est une leçon. Qu'ai-je appris de l'histoire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yu'minuna bihi wa qad madat sunnatu al-awwalin » — ils n'y croient pas, bien que le sort des anciens soit passé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je appris de l'histoire ? Est-ce que je crois en évitant les erreurs des anciens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sort des anciens est un avertissement pour nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire se répète pour ceux qui n'apprennent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'apprentissage de l'histoire évite la répétition des erreurs." }
  ],
  munajat: `Ya Rabb, fais que j'apprenne de l'histoire. Ne permets pas que je répète les erreurs des anciens. Guide-moi par les exemples passés.`
};

MIROIR["15:14"] = {
  reference: "15:14",
  theme: ["portes", "ciel", "ascension"],
  emotion: "Hypothèse, défi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bawwab", "Al-Sama'"],
  mirrorVersion: `« Même si Nous ouvrions pour eux une porte du ciel. » Le miroir imagine : « Wa law fatahna 'alayhim baban min al-sama'i » — même si Nous ouvrions pour eux une porte du ciel. L'impossible ne changerait rien aux cœurs fermés. Le miroir m'enseigne : le cœur fermé reste fermé malgré les signes.`,
  reflection: `Le cœur fermé reste fermé malgré les signes. Mon cœur est-il ouvert ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law fatahna 'alayhim baban min al-sama'i » — même si Nous ouvrions pour eux une porte du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il ouvert ? Ou est-ce qu'il reste fermé malgré les signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ouverture du ciel ne profite qu'aux cœurs ouverts." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont partout — le cœur ouvert les voit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'ouverture du cœur précède l'ouverture du ciel." }
  ],
  munajat: `Ya Rabb, ouvre mon cœur. Ne permets pas qu'il reste fermé malgré les signes. Fais que je voie les portes du ciel.`
};

MIROIR["15:15"] = {
  reference: "15:15",
  theme: ["vision", "illusion", "désaveu"],
  emotion: "Rejet, aveuglement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basar", "Al-Sihr"],
  mirrorVersion: `« Ils diraient : Nos yeux sont voilés, ou plutôt nous sommes ensorcelés. » Le miroir rejette : « Qalu innama sukkirat absaruna » — ils diraient : nos yeux sont voilés. Le rejet de l'évidence. Le miroir m'enseigne : l'aveuglement est un choix.`,
  reflection: `L'aveuglement est un choix. Est-ce que je choisis de voir ou d'être aveugle ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu innama sukkirat absaruna bal nahnu qawmun mashurun » — ils diraient : nos yeux sont voilés, ou plutôt nous sommes ensorcelés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis de voir ou d'être aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveuglement volontaire est le pire aveuglement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les yeux voient ce que le cœur accepte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vue du cœur précède la vue des yeux." }
  ],
  munajat: `Ya Rabb, ouvre mes yeux. Ne permets pas que je sois aveugle volontairement. Fais que je voie la vérité.`
};

MIROIR["15:16"] = {
  reference: "15:16",
  theme: ["constellations", "ciel", "beauté"],
  emotion: "Émerveillement, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Buruj", "Al-Sama'"],
  mirrorVersion: `« Nous avons placé dans le ciel des constellations et l'avons décoré. » Le miroir contemple : « Wa laqad ja'alna fi al-sama'i burujan wa zayyannaha » — nous avons placé dans le ciel des constellations et l'avons décoré. La beauté du ciel est un signe. Le miroir m'enseigne : la beauté est une invitation à la contemplation.`,
  reflection: `La beauté est une invitation à la contemplation. Est-ce que je contemple les signes d'Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ja'alna fi al-sama'i burujan wa zayyannaha li-l-nazirin » — nous avons placé dans le ciel des constellations et l'avons décoré pour ceux qui regardent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple les signes d'Allah ? La beauté du ciel m'invite-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté du ciel reflète la beauté du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel décoré est pour tous — la contemplation est pour les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation du ciel élève l'âme vers le Créateur." }
  ],
  munajat: `Ya Rabb, merci pour la beauté du ciel. Fais que je contemple Tes signes. Ne permets pas que je passe devant la beauté sans la voir.`
};

MIROIR["15:17"] = {
  reference: "15:17",
  theme: ["protection", "satans", "pierres"],
  emotion: "Sécurité, préservation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hifz", "Al-Shayatin"],
  mirrorVersion: `« Et Nous l'avons protégé contre tout diable lapidé. » Le miroir protège : « Wa hafiznan min kulli shaytanin rajim » — et Nous l'avons protégé contre tout diable lapidé. La protection du ciel est complète. Le miroir m'enseigne : la protection d'Allah est totale.`,
  reflection: `La protection d'Allah est totale. Est-ce que je demande Sa protection ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa hafiznan min kulli shaytanin rajim » — et Nous l'avons protégé contre tout diable lapidé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la protection d'Allah ? Contre quoi dois-je être protégé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah couvre ceux qui la demandent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les diables sont repoussés par la protection divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La demande de protection est le bouclier." }
  ],
  munajat: `Ya Rabb, protège-moi contre tout diable. Ne permets pas que je sois atteint par le mal. Fais que je sois sous Ta protection.`
};

MIROIR["15:18"] = {
  reference: "15:18",
  theme: ["écoute", "satans", "flamme"],
  emotion: "Avertissement, poursuite",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Istima'", "Al-Shihab"],
  mirrorVersion: `« Sauf celui qui écoute furtivement, alors une flamme brillante le poursuit. » Le miroir poursuit : « Illa man istaraqa al-sam'a fa-atba'ahu shihabun mubin » — sauf celui qui écoute furtivement, alors une flamme brillante le poursuit. L'écoute furtive est punie. Le miroir m'enseigne : l'espionnage spirituel est condamné.`,
  reflection: `L'espionnage spirituel est condamné. Est-ce que j'écoute ce qui ne me regarde pas ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa man istaraqa al-sam'a fa-atba'ahu shihabun mubin » — sauf celui qui écoute furtivement, alors une flamme brillante le poursuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute ce qui ne me regarde pas ? Suis-je un espion spirituel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La flamme poursuit celui qui écoute furtivement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les diables sont repoussés par les flammes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La pureté d'intention protège de l'écoute furtive." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'écoute ce qui ne me regarde pas. Purifie mon intention. Protège-moi de l'espionnage spirituel.`
};

MIROIR["15:19"] = {
  reference: "15:19",
  theme: ["terre", "extension", "montagnes"],
  emotion: "Création, stabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Jibal"],
  mirrorVersion: `« Et la terre, Nous l'avons étendue et y avons placé des montagnes. » Le miroir crée : « Wa al-arda madadnaha wa alqayna fiha rawasi » — et la terre, Nous l'avons étendue et y avons placé des montagnes. La terre est préparée pour la vie. Le miroir m'enseigne : la préparation précède l'habitation.`,
  reflection: `La préparation précède l'habitation. La terre est-elle préparée pour moi ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-arda madadnaha wa alqayna fiha rawasi » — et la terre, Nous l'avons étendue et y avons placé des montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre est préparée pour moi. Comment je la traite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'extension de la terre est une miséricorde pour l'homme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est préparée pour tous les êtres vivants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de la préparation divine augmente la gratitude." }
  ],
  munajat: `Ya Rabb, merci pour la terre préparée. Fais que je la traite avec respect. Ne permets pas que je détruise ce que Tu as préparé.`
};

MIROIR["15:20"] = {
  reference: "15:20",
  theme: ["provision", "vie", "créatures"],
  emotion: "Gratitude, provision",
  difficulty: "débutant",
  relatedNames: ["Al-Rizq", "Al-Hayat"],
  mirrorVersion: `« Et Nous y avons placé des provisions pour vous et pour ceux que vous ne nourrissez pas. » Le miroir pourvoit : « Wa ja'alna fiha ma'ayisha wa lakum wa li-man lastum lahu raziqin » — et Nous y avons placé des provisions pour vous et pour ceux que vous ne nourrissez pas. La provision est pour tous. Le miroir m'enseigne : Allah pourvoit à tous.`,
  reflection: `Allah pourvoit à tous. Est-ce que je reconnais Sa provision ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna fiha ma'ayisha wa lakum wa li-man lastum lahu raziqin » — et Nous y avons placé des provisions pour vous et pour ceux que vous ne nourrissez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la provision d'Allah ? Pour moi et pour les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision pour tous montre la miséricorde universelle d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature reçoit sa provision d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour la provision attire plus de provision." }
  ],
  munajat: `Ya Rabb, merci pour Ta provision. Fais que je reconnaisse ce que Tu m'as donné. Ne permets pas que je sois ingrat.`
};

// ==================== SURAH 14: IBRAHIM - VERSETS 8-23 ====================

MIROIR["14:8"] = {
  reference: "14:8",
  theme: ["gratitude", "ingratitude", "indépendance"],
  emotion: "Réalité, équilibre",
  difficulty: "débutant",
  relatedNames: ["Al-Shukr", "Al-Kufr"],
  mirrorVersion: `« Si vous êtes reconnaissants, J'augmenterai pour vous ; si vous êtes ingrats, Mon châtiment sera terrible. » Le miroir promet : « La-in shakartum la-azidannakum » — si vous êtes reconnaissants, J'augmenterai pour vous. La gratitude attire l'augmentation. Le miroir m'enseigne : la gratitude est la clé de l'abondance.`,
  reflection: `La gratitude est la clé de l'abondance. Est-ce que je remercie Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-in shakartum la-azidannakum wa la-in kafartum inna 'adhabi lashadid » — si vous êtes reconnaissants, J'augmenterai pour vous ; si vous êtes ingrats, Mon châtiment sera terrible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie Allah ? Ou est-ce que je suis ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude attire le châtiment — la gratitude attire l'abondance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi de la gratitude est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude constante transforme la vie." }
  ],
  munajat: `Ya Rabb, je Te remercie. Fais que ma gratitude soit constante. Ne permets pas que l'ingratitude m'atteigne.`
};

MIROIR["14:9"] = {
  reference: "14:9",
  theme: ["précédents", "messagers", "exemples"],
  emotion: "Rappel, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Awwalun", "Al-Rusul"],
  mirrorVersion: `« Ne connaissez-vous pas l'histoire de ceux qui vous ont précédés ? » Le miroir questionne : « Alam ya'tikum naba'u alladhina min qablikum » — ne connaissez-vous pas l'histoire de ceux qui vous ont précédés ? L'histoire est une leçon. Le miroir m'enseigne : l'histoire est un enseignement.`,
  reflection: `L'histoire est un enseignement. Qu'ai-je appris de l'histoire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam ya'tikum naba'u alladhina min qablikum qawmi Nuhin wa 'adin wa Thamud » — ne connaissez-vous pas l'histoire de ceux qui vous ont précédés ? Le peuple de Noé, des 'Ad et des Thamud." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je appris de l'histoire ? Les exemples des peuples passés m'instruisent-ils ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de l'histoire mène à la répétition des erreurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des peuples est un enseignement pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'apprentissage de l'histoire préserve de la destruction." }
  ],
  munajat: `Ya Rabb, fais que j'apprenne de l'histoire. Ne permets pas que je répète les erreurs des peuples passés. Guide-moi par leurs exemples.`
};

MIROIR["14:10"] = {
  reference: "14:10",
  theme: ["messagers", "purification", "foi"],
  emotion: "Appel, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Rusul", "Al-Tazkiyah"],
  mirrorVersion: `« Leurs messagers dirent : Y a-t-il un doute au sujet d'Allah ? » Le miroir appelle : « A-fi Allahi shakk » — y a-t-il un doute au sujet d'Allah ? Le doute est impossible quand on connaît Allah. Le miroir m'enseigne : la connaissance d'Allah dissipe le doute.`,
  reflection: `La connaissance d'Allah dissipe le doute. Est-ce que je doute d'Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fi Allahi shakkun fatiri al-samawati wa al-ard » — y a-t-il un doute au sujet d'Allah, Créateur des cieux et de la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute d'Allah ? La création prouve-t-elle le Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute est impossible devant la perfection de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création témoigne du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation de la création dissipe le doute." }
  ],
  munajat: `Ya Rabb, je ne doute pas de Toi. La création témoigne de Ton existence. Fais que ma foi soit ferme.`
};

MIROIR["14:11"] = {
  reference: "14:11",
  theme: ["messagers", "humains", "souffrance"],
  emotion: "Identification, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rusul", "Al-Bashar"],
  mirrorVersion: `« Leurs messagers leur dirent : Nous ne sommes que des humains comme vous. » Le miroir identifie : « Ma nahnu illa basharun mithlukum » — nous ne sommes que des humains comme vous. L'identification des messagers avec leur peuple. Le miroir m'enseigne : le messager est un exemple accessible.`,
  reflection: `Le messager est un exemple accessible. Est-ce que je le suis ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma nahnu illa basharun mithlukum » — nous ne sommes que des humains comme vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le messager est un humain comme moi. Est-ce que je peux le suivre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité du messager est un exemple pour tous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les messagers sont des exemples accessibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le suivi du messager est possible car il est humain." }
  ],
  munajat: `Ya Rabb, merci pour les messagers humains. Fais que je les suive. Ne permets pas que leur humanité soit un obstacle.`
};

MIROIR["14:12"] = {
  reference: "14:12",
  theme: ["confiance", "victoire", "foi"],
  emotion: "Confiance, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Tawakkul", "Al-Fath"],
  mirrorVersion: `« Pourquoi ne pas nous confier à Allah alors qu'Il nous a guidés sur notre chemin ? » Le miroir confie : « Wa ma lana alla natawakkala 'ala Allah » — pourquoi ne pas nous confier à Allah ? La confiance est la réponse naturelle à la guidance. Le miroir m'enseigne : la confiance suit la guidance.`,
  reflection: `La confiance suit la guidance. Est-ce que je me confie à Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma lana alla natawakkala 'ala Allah wa qad hadana subulana » — pourquoi ne pas nous confier à Allah alors qu'Il nous a guidés sur notre chemin ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me confie à Allah ? La guidance que j'ai reçue me pousse-t-elle à la confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah est la conséquence naturelle de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La confiance en Allah est la force des croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La confiance totale attire la victoire totale." }
  ],
  munajat: `Ya Rabb, je me confie à Toi. Tu m'as guidé, je Te fais confiance. Ne permets pas que je doute de Ta guidance.`
};

MIROIR["14:13"] = {
  reference: "14:13",
  theme: ["mécréance", "expulsion", "fermeté"],
  emotion: "Opposition, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kufr", "Al-Thabat"],
  mirrorVersion: `« Les mécréants dirent à leurs messagers : Nous vous expulserons de notre terre. » Le miroir menace : « La-nukhrijannakum min ardina » — nous vous expulserons de notre terre. L'opposition des mécréants est constante. Le miroir m'enseigne : la vérité dérange.`,
  reflection: `La vérité dérange. Est-ce que je suis prêt à tenir ferme ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala alladhina kafaru li-rusulihim la-nukhrijannakum min ardina aw la-ta'udunna fi millatina » — les mécréants dirent à leurs messagers : nous vous expulserons de notre terre ou vous reviendrez à notre religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt à tenir ferme face à l'opposition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'opposition est la preuve de la vérité du message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les messagers ont tous fait face à l'opposition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fermeté dans la vérité attire le secours divin." }
  ],
  munajat: `Ya Rabb, donne-moi la fermeté. Ne permets pas que l'opposition me fasse douter. Fais que je tienne ferme dans la vérité.`
};

MIROIR["14:14"] = {
  reference: "14:14",
  theme: ["succession", "victoire", "terre"],
  emotion: "Promesse, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Istikhlaf", "Al-Nasr"],
  mirrorVersion: `« Nous vous établirons sur leur terre après eux. » Le miroir promet : « La-nuskhinannakum al-arda min ba'dihim » — nous vous établirons sur leur terre après eux. La succession est promise aux croyants. Le miroir m'enseigne : la victoire suit la fermeté.`,
  reflection: `La victoire suit la fermeté. Est-ce que je tiens ferme pour la victoire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-nuskhinannakum al-arda min ba'dihim » — nous vous établirons sur leur terre après eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens ferme pour la victoire ? Ou est-ce que j'abandonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La succession sur la terre est la récompense de la fermeté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre appartient à Allah — Il la donne à qui Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fermeté dans la vérité attire l'établissement sur la terre." }
  ],
  munajat: `Ya Rabb, promets-moi la succession sur la terre. Donne-moi la fermeté pour l'obtenir. Ne permets pas que j'abandonne.`
};

MIROIR["14:15"] = {
  reference: "14:15",
  theme: ["invocation", "victoire", "patience"],
  emotion: "Supplication, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Du'a'", "Al-Fath"],
  mirrorVersion: `« Ils invoquèrent leur Seigneur, et Allah leur donna la victoire. » Le miroir exauce : « Wa-staftahu rabbahum » — ils invoquèrent leur Seigneur. L'invocation est la clé de la victoire. Le miroir m'enseigne : l'invocation sincère est exaucée.`,
  reflection: `L'invocation sincère est exaucée. Est-ce que j'invoque Allah ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa-staftahu rabbahum » — ils invoquèrent leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah ? Mon invocation est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation précède la victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invocation est l'arme du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'invocation sincère transforme l'impossible en possible." }
  ],
  munajat: `Ya Rabb, j'invoque Ta victoire. Exauce mon invocation. Ne permets pas que je sois vaincu.`
};

MIROIR["17:45"] = {
  reference: "17:45",
  theme: ["lecture", "voile", "protection"],
  emotion: "Réconfort, protection",
  difficulty: "débutant",
  relatedNames: ["Al-Qur'an", "Al-Hijab"],
  mirrorVersion: `« Quand tu lis le Coran, Nous plaçons entre toi et ceux qui ne croient pas en l'au-delà un voile invisible. » Le miroir me montre la protection pendant la lecture. « Ja'alna baynaka wa bayna alladhina la yu'minuna bi-al-akhirati hijaban mastura » — Nous plaçons entre toi et ceux qui ne croient pas en l'au-delà un voile invisible. La lecture est protégée. Le miroir m'interroge : est-ce que je lis le Coran avec conscience de cette protection ?`,
  reflection: `La lecture du Coran est protégée par un voile invisible. Les mécréants ne peuvent pas comprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha qara'ta al-qur'ana ja'alna baynaka wa bayna alladhina la yu'minuna bi-al-akhirati hijaban mastura » — quand tu lis le Coran, Nous plaçons entre toi et ceux qui ne croient pas en l'au-delà un voile invisible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran avec conscience de cette protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection du lecteur montre la valeur de la lecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est un livre protégé et protecteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit avec conscience de la protection reçoit la lumière." }
  ],
  munajat: `Ya Rabb, protège-moi quand je lis Ton Livre. Ne permets pas que les mécréants me perturbent. Donne-moi la conscience de Ta protection.`
};

MIROIR["17:46"] = {
  reference: "17:46",
  theme: ["voile", "cœurs", "surdité"],
  emotion: "Compassion, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Akinnah", "Al-Waqrah"],
  mirrorVersion: `« Nous avons mis des voiles sur leurs cœurs et rendu sourdes leurs oreilles. » Le miroir me montre l'état des mécréants. « Ja'alna 'ala qulubihim akinnatan » — Nous avons mis des voiles sur leurs cœurs. Le voile empêche la compréhension. Le miroir m'interroge : est-ce que je demande à Allah d'enlever les voiles de mon cœur ?`,
  reflection: `Le voile sur les cœurs empêche la compréhension. La demande d'enlèvement des voiles est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alna 'ala qulubihim akinnatan an yafqahuhu wa fi adhanhim waqran » — nous avons mis des voiles sur leurs cœurs pour qu'ils ne le comprennent pas, et dans leurs oreilles une surdité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande à Allah d'enlever les voiles de mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enlèvement des voiles vient de la volonté de comprendre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La compréhension du Coran est un don divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le cœur est ouvert comprend le Coran." }
  ],
  munajat: `Ya Rabb, enlève les voiles de mon cœur. Fais que je comprenne Ton Livre. Ne permets pas que mon cœur soit voilé.`
};

MIROIR["17:47"] = {
  reference: "17:47",
  theme: ["écoute", "mécréants", "moquerie"],
  emotion: "Patience, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sam'", "Al-Istihza'"],
  mirrorVersion: `« Nous savons le mieux comment ils écoutent quand ils t'écoutent et quand ils se consultent entre eux. » Le miroir me montre la science d'Allah sur les intentions cachées. « Na'lamu kayfa yastami'un » — nous savons le mieux comment ils écoutent. La science d'Allah englobe tout. Le miroir m'interroge : est-ce que je suis conscient qu'Allah connaît mes intentions ?`,
  reflection: `La science d'Allah englobe tout, même les intentions cachées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Na'lamu kayfa yastami'una idh yastami'unaka wa idh hum najwa » — nous savons le mieux comment ils écoutent quand ils t'écoutent et quand ils se consultent entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis conscient qu'Allah connaît mes intentions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la science divine purifie les intentions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est caché d'Allah, ni les paroles ni les intentions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en sachant qu'Allah connaît purifie ses intentions." }
  ],
  munajat: `Ya 'Alim, Tu connais mes intentions. Fais que je vive en conscience de Ta science. Purifie mes intentions par cette conscience.`
};

MIROIR["17:48"] = {
  reference: "17:48",
  theme: ["comparaison", "égarement", "prophète"],
  emotion: "Lucidité, compassion",
  difficulty: "débutant",
  relatedNames: ["Al-Mathal", "Al-Dalal"],
  mirrorVersion: `« Regarde à quoi ils te comparent ! Ils s'égarent et ne peuvent trouver aucun chemin. » Le miroir me montre l'égarement des mécréants. « Unzur ila ma darabu laka al-amthal » — regarde à quoi ils te comparent. Les fausses comparaisions révèlent l'égarement. Le miroir m'interroge : est-ce que je compare juste ou je me trompe de comparaison ?`,
  reflection: `Les fausses comparaisons révèlent l'égarement. La vraie comparaison guide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Unzur ila ma darabu laka al-amthal fa-dallu fa-la yastati'un sabilan » — regarde à quoi ils te comparent ! Ils s'égarent et ne peuvent trouver aucun chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compare juste ou je me trompe de comparaison ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La comparaison juste vient de la connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité a des comparaisons justes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compare avec vérité trouve le chemin." }
  ],
  munajat: `Ya Rabb, je veux comparer avec vérité. Ne permets pas que je me trompe de comparaison. Guide-moi vers la comparaison juste.`
};

MIROIR["17:49"] = {
  reference: "17:49",
  theme: ["résurrection", "doute", "poussière"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'th", "At-Turab"],
  mirrorVersion: `« Ils disent : "Quand nous serons ossements et poussière, serons-nous ressuscités en une nouvelle création ?" » Le miroir me montre le doute sur la résurrection. « A-idha kunna 'izaman wa rufatan » — quand nous serons ossements et poussière. Le doute sur la résurrection est courant. Le miroir m'interroge : est-ce que je crois en la résurrection ?`,
  reflection: `La résurrection est une certitude pour le croyant. Le doute vient de l'incrédulité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu a-idha kunna 'izaman wa rufatan a-inna la-mab'uthuna khalqan jadidan » — ils disent : Quand nous serons ossements et poussière, serons-nous ressuscités en une nouvelle création ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la résurrection ? Ou est-ce que je doute comme eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est la promesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création initiale prouve la recréation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection prépare son retour." }
  ],
  munajat: `Ya Rabb, je crois en la résurrection. Ne permets pas le doute dans mon cœur. Donne-moi la certitude du retour à Toi.`
};

MIROIR["17:50"] = {
  reference: "17:50",
  theme: ["pierre", "résurrection", "puissance"],
  emotion: "Certitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Hijarah", "Al-Qadir"],
  mirrorVersion: `« Dis : "Soyez pierres ou fer, ou toute autre création difficile à concevoir." » Le miroir me montre la puissance de la résurrection. « Qulu kunu hijaratan aw hadidan » — soyez pierres ou fer. Même les choses les plus dures seront ressuscitées. Le miroir m'interroge : est-ce que je doute de la puissance d'Allah ?`,
  reflection: `Même les choses les plus dures seront ressuscitées. La puissance d'Allah est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulu kunu hijaratan aw hadidan aw khalqan mimma yakburu fi al-suduri » — dis : Soyez pierres ou fer, ou toute autre création difficile à concevoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute de la puissance d'Allah ? Ou est-ce que je crois en Sa puissance absolue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance absolue d'Allah rend la résurrection certaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création de l'impossible est possible pour Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la puissance absolue croit en la résurrection." }
  ],
  munajat: `Ya Qadir, je crois en Ta puissance absolue. Ne permets pas que je doute de la résurrection. Donne-moi la certitude de Ton pouvoir.`
};

MIROIR["17:51"] = {
  reference: "17:51",
  theme: ["création", "résurrection", "promesse"],
  emotion: "Certitude, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khalq", "Al-Wa'd"],
  mirrorVersion: `« Ou toute création plus grande encore dans vos esprits. Alors ils diront : "Qui nous fera revenir ?" Dis : "Celui qui vous a créés la première fois." » Le miroir me montre la preuve de la résurrection. « Fa-yaquluna man yu'iduna » — ils diront : Qui nous fera revenir ? La création initiale est la preuve. Le miroir m'interroge : est-ce que je vois la création initiale comme preuve de la résurrection ?`,
  reflection: `La création initiale est la preuve de la résurrection. Celui qui crée peut recréer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw khalqan mimma yakburu fi al-suduri fa-yaquluna man yu'iduna qul alladhi fatarakum awwala marratin » — ou toute création plus grande encore dans vos esprits. Alors ils diront : Qui nous fera revenir ? Dis : Celui qui vous a créés la première fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la création initiale comme preuve de la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La recréation est plus facile que la création initiale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Celui qui peut créer peut ressusciter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la création comprend la résurrection." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé la première fois. Tu peux me ressusciter. Donne-moi la certitude de la résurrection par la preuve de la création.`
};

MIROIR["17:52"] = {
  reference: "17:52",
  theme: ["appel", "réponse", "résurrection"],
  emotion: "Responsabilité, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nida'", "Al-Istijabah"],
  mirrorVersion: `« Le jour où Il vous appellera et que vous répondrez en Le louant. » Le miroir me montre la résurrection comme appel. « Yawma yad'ukum fa-tastajibuna bi-hamdihi » — le jour où Il vous appellera et que vous répondrez en Le louant. La résurrection est une réponse à l'appel divin. Le miroir m'interroge : est-ce que je répondrai à l'appel ?`,
  reflection: `La résurrection est une réponse à l'appel divin. Chacun répondra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yad'ukum fa-tastajibuna bi-hamdihi wa tazunnuna in labithtum illa qalila » — le jour où Il vous appellera et que vous répondrez en Le louant, et vous croirez n'être restés qu'un peu de temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je répondrai à l'appel ? Quelle sera ma réponse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La réponse à l'appel divin est la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'appel divin est pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond maintenant à l'appel répondra facilement alors." }
  ],
  munajat: `Ya Rabb, je réponds à Ton appel maintenant. Fais que je réponde facilement le Jour. Ne permets pas que je sois parmi ceux qui tardent.`
};

MIROIR["17:53"] = {
  reference: "17:53",
  theme: ["satan", "ennemi", "protection"],
  emotion: "Vigilance, protection",
  difficulty: "débutant",
  relatedNames: ["Ash-Shaytan", "Al-'Adww"],
  mirrorVersion: `« Dis à Mes serviteurs de tenir les meilleures paroles. Satan sème la discorde parmi eux. » Le miroir me montre la stratégie de Satan. « Qul li-'ibadi yaqulu allati hiya ahsan » — dis à Mes serviteurs de tenir les meilleures paroles. La bonne parole protège de Satan. Le miroir m'interroge : est-ce que je tiens les meilleures paroles ?`,
  reflection: `La bonne parole protège de Satan. La discorde vient de Satan.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qul li-'ibadi yaqulu allati hiya ahsan inna al-shaytana yanzaghu baynahum » — dis à Mes serviteurs de tenir les meilleures paroles. Satan sème la discorde parmi eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tiens les meilleures paroles ? Ou est-ce que je laisse la discorde s'installer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne parole est le rempart contre Satan." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Satan est l'ennemi déclaré, la bonne parole est l'arme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient la bonne parole est protégé de la discorde." }
  ],
  munajat: `Ya Rabb, je tiens les meilleures paroles. Protège-moi de la discorde de Satan. Ne permets pas que Satan sème la division entre moi et les autres.`
};

MIROIR["17:54"] = {
  reference: "17:54",
  theme: ["science", "miséricorde", "punition"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Ar-Rahman"],
  mirrorVersion: `« Votre Seigneur vous connaît mieux. S'Il veut, Il vous fait miséricorde, et s'Il veut, Il vous châtie. » Le miroir me montre la connaissance d'Allah. « Rabbukum a'lamu bikum » — votre Seigneur vous connaît mieux. La décision appartient à Allah. Le miroir m'interroge : est-ce que j'accepte la décision d'Allah ?`,
  reflection: `La décision appartient à Allah. L'acceptation de Sa décision est la soumission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbukum a'lamu bikum in yasha' yarhamkum aw in yasha' yu'adhdhibkum » — votre Seigneur vous connaît mieux. S'Il veut, Il vous fait miséricorde, et s'Il veut, Il vous châtie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la décision d'Allah ? Ou est-ce que je conteste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la décision divine est la paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La décision d'Allah est juste et sage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la décision divine est en paix." }
  ],
  munajat: `Ya 'Alim, Tu me connais mieux que moi-même. J'accepte Ta décision. Fais que je sois parmi ceux qui reçoivent Ta miséricorde.`
};

MIROIR["17:55"] = {
  reference: "17:55",
  theme: ["préférence", "anges", "messagers"],
  emotion: "Humilité, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Tafdil", "Al-Mursalun"],
  mirrorVersion: `« Ton Seigneur connaît mieux ceux qui sont dans les cieux et sur la terre. Nous avons préféré certains prophètes à d'autres. » Le miroir me montre la préférence divine. « Wa laqad faddalna ba'da al-nabiyyina 'ala ba'd » — Nous avons préféré certains prophètes à d'autres. La préférence divine est par sagesse. Le miroir m'interroge : est-ce que j'accepte la préférence divine ?`,
  reflection: `La préférence divine est par sagesse. L'acceptation de sa place est la gratitude.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rabbuka a'lamu bi-man fi al-samawati wa al-ard wa laqad faddalna ba'da al-nabiyyina 'ala ba'd » — ton Seigneur connaît mieux ceux qui sont dans les cieux et sur la terre. Nous avons préféré certains prophètes à d'autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la préférence divine ? Ou est-ce que je jalouse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence divine suit la sagesse divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La préférence divine n'enlève rien à la valeur de chacun." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa place trouve sa perfection." }
  ],
  munajat: `Ya Rabb, j'accepte Ta préférence. Ne permets pas la jalousie. Donne-moi de remplir ma place avec excellence.`
};

MIROIR["17:56"] = {
  reference: "17:56",
  theme: ["intercession", "divinités", "profit"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Ash-Shafa'ah", "Al-Naf'"],
  mirrorVersion: `« Dis : "Invoquez ceux que vous prétendez en dehors de Lui. Ils ne possèdent ni le pouvoir de vous nuire ni de vous diriger." » Le miroir me montre l'impuissance des fausses divinités. « Ud'u alladhina za'amtum min dunihi » — invoquez ceux que vous prétendez en dehors de Lui. Les fausses divinités sont impuissantes. Le miroir m'interroge : est-ce que j'invoque autre qu'Allah qui est impuissant ?`,
  reflection: `Les fausses divinités sont impuissantes. Seul Allah peut nuire et diriger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ud'u alladhina za'amtum min dunihi fa-la yamlikuna darran wa la naf'an » — dis : Invoquez ceux que vous prétendez en dehors de Lui. Ils ne possèdent ni le pouvoir de vous nuire ni de vous diriger." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque autre qu'Allah qui est impuissant ? Ou est-ce que j'invoque le Tout-Puissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation de l'impuissant est temps perdu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah possède le pouvoir de nuire et de profiter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul invoque le Tout-Puissant." }
  ],
  munajat: `Ya Rabb, je T'invoque seul. Ne permets pas que j'invoque les impuissants. Donne-moi de T'invoquer, le Tout-Puissant.`
};

MIROIR["17:57"] = {
  reference: "17:57",
  theme: ["proches", "invocation", "chemin"],
  emotion: "Guidance, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muqarrabun", "At-Tariq"],
  mirrorVersion: `« Ceux qu'ils invoquent cherchent eux-mêmes le moyen de se rapprocher de leur Seigneur. » Le miroir me montre que même les anges et les prophètes cherchent à se rapprocher d'Allah. « Yabtaghuna ila rabbihimi al-wasilata » — ils cherchent le moyen de se rapprocher. Les plus proches cherchent encore plus la proximité. Le miroir m'interroge : est-ce que je cherche la proximité d'Allah ?`,
  reflection: `Les plus proches d'Allah cherchent encore plus la proximité. La quête de proximité est éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika alladhina yad'una yabtaghuna ila rabbihimi al-wasilata ayyuhum aqrabu » — ceux qu'ils invoquent cherchent eux-mêmes le moyen de se rapprocher de leur Seigneur, espérant Sa miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la proximité d'Allah ? Ou est-ce que je suis satisfait de ma distance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La quête de proximité est le chemin des plus proches." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La proximité d'Allah est le but de toute création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la proximité la trouve." }
  ],
  munajat: `Ya Rabb, je cherche Ta proximité. Ne permets pas que je sois satisfait de ma distance. Donne-moi de me rapprocher de Toi chaque jour.`
};

MIROIR["17:58"] = {
  reference: "17:58",
  theme: ["cités", "destruction", "décret"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qura", "Al-Halak"],
  mirrorVersion: `« Il n'est point de cité que Nous ne détruirons avant le Jour de la Résurrection ou que Nous ne châtierons d'un châtiment terrible. » Le miroir me montre le destin des cités. « Ma min qaryatin illa nahnu numhikuha » — il n'est point de cité que Nous ne détruirons. Toute cité a un destin. Le miroir m'interroge : est-ce que je me prépare pour le destin final ?`,
  reflection: `Toute cité a un destin. La préparation pour le destin final est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In min qaryatin illa nahnu numhikuha aw yu'adhdhibuha 'adhaban shadidan » — il n'est point de cité que Nous ne détruirons avant le Jour de la Résurrection ou que Nous ne châtierons d'un châtiment terrible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour le destin final ? Ou est-ce que je vis comme si je serai éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le destin final est inévitable, la préparation est nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose a une fin, la cité comme l'individu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour la fin vit bien le présent." }
  ],
  munajat: `Ya Rabb, je me prépare pour le destin final. Ne permets pas que je vive comme si j'étais éternel. Donne-moi la préparation pour le Jour.`
};

MIROIR["17:59"] = {
  reference: "17:59",
  theme: ["signes", "miracles", "demande"],
  emotion: "Sagesse, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ayat", "Al-Mu'jizat"],
  mirrorVersion: `« Rien ne Nous empêche d'envoyer les signes, mais les anciens les ont traités de mensonges. » Le miroir me montre la sagesse derrière l'absence de miracles demandés. « Wa ma mana'ana an nursila bi-al-ayat » — rien ne Nous empêche d'envoyer les signes. Le rejet passé enseigne la sagesse. Le miroir m'interroge : est-ce que j'accepte les signes comme Allah les envoie ?`,
  reflection: `Le rejet passé des signes enseigne la sagesse. L'acceptation des signes comme ils viennent est la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma mana'ana an nursila bi-al-ayati illa an kadhdhaba biha al-awwalun » — rien ne Nous empêche d'envoyer les signes, mais les anciens les ont traités de mensonges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les signes comme Allah les envoie ? Ou est-ce que je demande d'autres signes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des signes existants est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont envoyés selon la sagesse divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes comme ils viennent a la foi." }
  ],
  munajat: `Ya Rabb, j'accepte Tes signes comme Tu les envoies. Ne permets pas que je demande d'autres signes. Donne-moi la foi dans les signes existants.`
};

MIROIR["17:60"] = {
  reference: "17:60",
  theme: ["rêve", "épreuve", "arbre"],
  emotion: "Patience, confiance",
  difficulty: "avancé",
  relatedNames: ["Ar-Ru'ya", "Ash-Shajarah"],
  mirrorVersion: `« Et quand Nous t'avons dit : "Ton Seigneur cerne les gens." » Le miroir me montre la connaissance divine qui cerne tout. « Inna rabbaka muhitun bi-al-nasi » — ton Seigneur cerne les gens. Personne n'échappe à la connaissance d'Allah. Le miroir m'interroge : est-ce que je vis en sachant qu'Allah me cerne ?`,
  reflection: `Allah cerne les gens. Rien n'échappe à Sa connaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qulna laka inna rabbaka muhitun bi-al-nasi » — et quand Nous t'avons dit : Ton Seigneur cerne les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant qu'Allah me cerne ? Ou est-ce que je pense pouvoir me cacher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience d'être cerné par Allah purifie les actions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance divine est partout, elle cerne tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'il est cerné par Allah vit en conscience." }
  ],
  munajat: `Ya Muhit, Tu me cerne. Fais que je vive en conscience de Ta connaissance. Ne permets pas que je pense pouvoir me cacher.`
};

MIROIR["17:61"] = {
  reference: "17:61",
  theme: ["prostration", "anges", "iblis"],
  emotion: "Humilité, méditation",
  difficulty: "débutant",
  relatedNames: ["As-Sujud", "Al-Mala'ikah"],
  mirrorVersion: `« Et quand Nous avons dit aux anges : "Prosternez-vous devant Adam." Ils se prosternèrent, sauf Iblis. » Le miroir me montre l'obéissance et la désobéissance. « Usjudu li-adama » — prosternez-vous devant Adam. L'obéissance des anges contraste avec le refus d'Iblis. Le miroir m'interroge : est-ce que j'obéis aux commandements d'Allah ?`,
  reflection: `L'obéissance est la voie des anges, la désobéissance est la voie d'Iblis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh qulna li-al-mala'ikati usjudu li-adama fasajadu illa iblis » — et quand Nous avons dit aux anges : Prosternez-vous devant Adam. Ils se prosternèrent, sauf Iblis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis aux commandements d'Allah ? Ou est-ce que je refuse comme Iblis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance élève, la désobéissance abaisse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prosternation est le sommet de l'adoration." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit est honoré." }
  ],
  munajat: `Ya Rabb, je veux obéir à Tes commandements. Ne permets pas que je refuse comme Iblis. Donne-moi l'obéissance des anges.`
};

MIROIR["17:62"] = {
  reference: "17:62",
  theme: ["orgueil", "tentation", "chemin"],
  emotion: "Vigilance, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kibr", "At-Tariq"],
  mirrorVersion: `« Il dit : "Vois-Tu celui que Tu as honoré au-dessus de moi ?" » Le miroir me montre l'orgueil d'Iblis. « A-ra'aytaka hadha alladhi karramta 'alayya » — vois-Tu celui que Tu as honoré au-dessus de moi. L'orgueil refuse l'honneur accordé à un autre. Le miroir m'interroge : est-ce que j'accepte l'honneur accordé aux autres ?`,
  reflection: `L'orgueil refuse l'honneur accordé à un autre. L'humilité accepte la préférence divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala a-ra'aytaka hadha alladhi karramta 'alayya la-in akhkhartani ila yawmi al-qiyamati la-ahtanikanna dhurriyyatahu illa qalila » — il dit : Vois-Tu celui que Tu as honoré au-dessus de moi ? Si Tu me donnes un délai jusqu'au Jour de la Résurrection, j'égarerai sa descendance, à l'exception de quelques-uns." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'honneur accordé aux autres ? Ou est-ce que j'envie comme Iblis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la préférence divine est l'humilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil mène à la perte, l'humilité mène à l'honneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la préférence divine pour les autres préserve son cœur." }
  ],
  munajat: `Ya Rabb, j'accepte Ta préférence pour les autres. Ne permets pas l'envie dans mon cœur. Donne-moi l'humilité d'accepter Ta sagesse.`
};

MIROIR["17:63"] = {
  reference: "17:63",
  theme: ["permission", "tentation", "conséquence"],
  emotion: "Réalité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ibaha", "Al-Jaza'"],
  mirrorVersion: `« Va-t-en ! Quiconque d'entre eux te suivra, l'Enfer sera votre rétribution. » Le miroir me montre la permission divine et ses conséquences. « Idhhab fa-man tabi'aka minhum » — va-t-en ! Quiconque d'entre eux te suivra. Le chemin de Satan mène à l'Enfer. Le miroir m'interroge : est-ce que je suis le chemin de Satan ?`,
  reflection: `Le chemin de Satan mène à l'Enfer. Le chemin d'Allah mène au Paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala idhhab fa-man tabi'aka minhum fa-inna jahannama jazaukum jazawan mawfura » — va-t-en ! Quiconque d'entre eux te suivra, l'Enfer sera votre rétribution, une rétribution ample." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le chemin de Satan ? Ou est-ce que je suis le chemin d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conséquence du chemin détermine la valeur du chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Deux chemins, deux conséquences : Enfer ou Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le bon chemin choisit la bonne conséquence." }
  ],
  munajat: `Ya Rabb, je choisis Ton chemin. Ne permets pas que je suive le chemin de Satan. Donne-moi la rétribution du Paradis.`
};

MIROIR["17:64"] = {
  reference: "17:64",
  theme: ["tentation", "armée", "voix"],
  emotion: "Vigilance, protection",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghaww", "Al-Jaysh"],
  mirrorVersion: `« Et pousse de ta voix ceux que tu pourras. » Le miroir me montre les moyens de tentation. « Wa istafziz mani istata'ta minhum bi-sawtika » — et pousse de ta voix ceux que tu pourras. Satan utilise tous les moyens pour égarer. Le miroir m'interroge : est-ce que je me protège de la voix de Satan ?`,
  reflection: `Satan utilise tous les moyens pour égarer. La protection est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa istafziz mani istata'ta minhum bi-sawtika wa ajlib 'alayhim bi-khaylika wa rajalika » — et pousse de ta voix ceux que tu pourras, et rassemble contre eux ta cavalerie et ton infanterie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me protège de la voix de Satan ? Ou est-ce que je l'écoute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection contre Satan demande une vigilance constante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Satan a beaucoup de moyens, la protection a un seul : Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se protège par Allah est protégé de tous les moyens de Satan." }
  ],
  munajat: `Ya Rabb, je me protège de la voix de Satan par Toi. Ne permets pas que je l'écoute. Donne-moi la protection contre tous ses moyens.`
};

MIROIR["17:65"] = {
  reference: "17:65",
  theme: ["serviteurs", "pouvoir", "protection"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Ibad", "As-Sultan"],
  mirrorVersion: `« Tu n'as aucun pouvoir sur Mes serviteurs. » Le miroir me montre la limite du pouvoir de Satan. « Inna 'ibadi laysa laka 'alayhim sultan » — tu n'as aucun pouvoir sur Mes serviteurs. Les vrais serviteurs d'Allah sont protégés. Le miroir m'interroge : est-ce que je suis un vrai serviteur d'Allah ?`,
  reflection: `Les vrais serviteurs d'Allah sont protégés de Satan. La servitude est la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna 'ibadi laysa laka 'alayhim sultanun wa kafa bi-rabbika wakila » — tu n'as aucun pouvoir sur Mes serviteurs. Ton Seigneur suffit comme Protecteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis un vrai serviteur d'Allah ? Ou est-ce que je suis dominé par Satan ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La servitude sincère est la protection contre Satan." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah suffit comme Protecteur pour Ses serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vraiment serviteur d'Allah est vraiment protégé." }
  ],
  munajat: `Ya Rabb, je suis Ton serviteur. Protège-moi de Satan. Suffis-moi comme Protecteur. Ne permets pas que Satan ait du pouvoir sur moi.`
};

MIROIR["17:66"] = {
  reference: "17:66",
  theme: ["mer", "bateau", "bienfait"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Bahr", "Al-Fulk"],
  mirrorVersion: `« Votre Seigneur est Celui qui fait voguer le bateau en mer pour que vous recherchiez Sa grâce. » Le miroir me montre le bienfait de la navigation. « Rabbukumu alladhi yuzji lakumu al-fulka fi al-bahri » — votre Seigneur est Celui qui fait voguer le bateau en mer. La navigation est un bienfait divin. Le miroir m'interroge : est-ce que je remercie pour les facilités de transport ?`,
  reflection: `La navigation est un bienfait divin. Les facilités de transport sont des dons à reconnaître.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbukumu alladhi yuzji lakumu al-fulka fi al-bahri li-tabtaghu min fadlihi » — votre Seigneur est Celui qui fait voguer le bateau en mer pour que vous recherchiez Sa grâce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour les facilités de transport ? Ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude pour les facilités sanctifie leur usage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mer et le bateau sont au service de l'homme par la grâce d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour les facilités voit les bienfaits partout." }
  ],
  munajat: `Ya Rabb, merci pour les facilités de transport. Fais que je les utilise pour Ta grâce. Ne permets pas que je les prenne pour acquis.`
};

MIROIR["17:67"] = {
  reference: "17:67",
  theme: ["détresse", "invocation", "mer"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ad-Darr", "Ad-Du'a'"],
  mirrorVersion: `« Quand le malheur vous atteint en mer, ceux que vous invoquez s'éloignent, sauf Lui. » Le miroir me montre le retour à Allah dans la détresse. « Wa idha massakumu al-darru fi al-bahri dalla man tad'un » — quand le malheur vous atteint en mer, ceux que vous invoquez s'éloignent. Seul Allah répond dans la détresse. Le miroir m'interroge : est-ce que j'invoque Allah dans la détresse ?`,
  reflection: `Seul Allah répond dans la détresse. Les autres s'éloignent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha massakumu al-darru fi al-bahri dalla man tad'un illa iyyahu » — quand le malheur vous atteint en mer, ceux que vous invoquez s'éloignent, sauf Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah dans la détresse ? Ou est-ce que j'invoque d'autres qui s'éloignent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation d'Allah dans la détresse est la clé du secours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le seul qui ne s'éloigne jamais dans la détresse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah dans la détresse est secouru." }
  ],
  munajat: `Ya Rabb, je T'invoque dans la détresse. Ne permets pas que j'invoque d'autres qui s'éloignent. Sois mon seul recours dans les difficultés.`
};

MIROIR["17:68"] = {
  reference: "17:68",
  theme: ["sécurité", "engloutissement", "avertissement"],
  emotion: "Humilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Amn", "Al-Khasf"],
  mirrorVersion: `« Êtes-vous à l'abri que la terre vous engloutisse ou qu'un ouragan vous frappe ? » Le miroir me montre la fragilité de la sécurité apparente. « A-famin kum man aminun an yakhsifa bikum janiba al-barri » — êtes-vous à l'abri que la terre vous engloutisse. La sécurité n'est jamais garantie. Le miroir m'interroge : est-ce que je me sens à l'abri ou je reste vigilant ?`,
  reflection: `La sécurité n'est jamais garantie. La vigilance et la confiance en Allah sont nécessaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-famin kum man aminun an yakhsifa bikum janiba al-barri aw yursila 'alaykum hasiban » — êtes-vous à l'abri que la terre vous engloutisse ou qu'Il envoie contre vous un ouragan ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens à l'abri ou je reste vigilant ? La sécurité est-elle pour moi une certitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la fragilité de la sécurité augmente la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre et le ciel obéissent à Allah, ils peuvent engloutir ou frapper." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste vigilant remercie plus pour sa sécurité." }
  ],
  munajat: `Ya Rabb, je ne suis pas à l'abri sans Toi. Protège-moi de l'engloutissement et de l'ouragan. Fais que je reste vigilant et reconnaissant.`
};

MIROIR["17:69"] = {
  reference: "17:69",
  theme: ["retour", "châtiment", "ingratitude"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Awba", "Al-Adhab"],
  mirrorVersion: `« Ou êtes-vous à l'abri qu'Il vous y ramène une seconde fois et qu'Il envoie contre vous un ouragan ? » Le miroir me montre la possibilité du retour du châtiment. « Aw amintum an yu'idakum ilayhi maratan ukhra » — ou êtes-vous à l'abri qu'Il vous y ramène une seconde fois. L'ingratitude peut ramener le châtiment. Le miroir m'interroge : est-ce que je suis reconnaissant ou ingrat ?`,
  reflection: `L'ingratitude peut ramener le châtiment. La reconnaissance préserve les bienfaits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw amintum an yu'idakum ilayhi maratan ukhra wa yursila 'alaykum qasifan mina al-rihi » — ou êtes-vous à l'abri qu'Il vous y ramène une seconde fois et qu'Il envoie contre vous un ouragan violent ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant ou ingrat ? Mon ingratitude peut-elle ramener le châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance préserve les bienfaits, l'ingratitude les perd." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bienfaits peuvent être repris par l'ingratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant préserve ses bienfaits." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour mes bienfaits. Ne permets pas l'ingratitude qui ramène le châtiment. Préserve mes bienfaits par ma reconnaissance.`
};

MIROIR["17:71"] = {
  reference: "17:71",
  theme: ["appel", "imam", "livre"],
  emotion: "Responsabilité, réalité",
  difficulty: "débutant",
  relatedNames: ["An-Nida'", "Al-Imam"],
  mirrorVersion: `« Le jour où Nous appellerons chaque peuple avec son imam. » Le miroir me montre le rassemblement avec les leaders. « Yawma nad'u kulla unasin bi-imamihim » — le jour où Nous appellerons chaque peuple avec son imam. Chacun sera rassemblé avec son leader. Le miroir m'interroge : qui est mon leader ?`,
  reflection: `Chacun sera rassemblé avec son leader. Le choix du leader détermine le rassemblement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma nad'u kulla unasin bi-imamihim fa-man utiya kitabahu bi-yaminihi » — le jour où Nous appellerons chaque peuple avec son imam. Celui qui recevra son livre dans sa main droite..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est mon leader ? Avec qui serai-je rassemblé le Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix du leader dans ce monde détermine le rassemblement dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque peuple a son leader, chaque leader a ses suivants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit un bon leader est bien rassemblé." }
  ],
  munajat: `Ya Rabb, je choisis le Prophète comme leader. Rassemble-moi avec lui le Jour. Ne permets pas que je sois rassemblé avec les mauvais leaders.`
};

MIROIR["17:72"] = {
  reference: "17:72",
  theme: ["aveugle", "vision", "oublieux"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-A'ma", "Al-Basir"],
  mirrorVersion: `« Celui qui était aveugle ici-bas sera aveugle dans l'au-delà. » Le miroir me montre la conséquence de l'aveuglement dans ce monde. « Wa man kana fi hadhihi a'ma fa-huwa fi al-akhirati a'ma » — celui qui était aveugle ici-bas sera aveugle dans l'au-delà. L'aveuglement spirituel persiste. Le miroir m'interroge : est-ce que je suis aveugle spirituellement ?`,
  reflection: `L'aveuglement spirituel dans ce monde persiste dans l'au-delà. La vision maintenant est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man kana fi hadhihi a'ma fa-huwa fi al-akhirati a'ma wa adallu sabilan » — celui qui était aveugle ici-bas sera aveugle dans l'au-delà et plus égaré encore du chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis aveugle spirituellement ? Ou est-ce que je vois la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vision spirituelle dans ce monde prépare la vision dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aveuglement spirituel est la pire cécité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vérité maintenant verra la vérité toujours." }
  ],
  munajat: `Ya Rabb, je veux voir la vérité. Ne permets pas que je sois aveugle spirituellement. Donne-moi la vision qui persiste dans l'au-delà.`
};

MIROIR["17:73"] = {
  reference: "17:73",
  theme: ["tentation", "révélation", "échange"],
  emotion: "Vigilance, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fitnah", "Al-Tahrif"],
  mirrorVersion: `« Ils ont failli te détourner de ce que Nous t'avons révélé. » Le miroir me montre la tentation contre la révélation. « Wa in kadu la-yafutinunaka 'amma awhayna ilayka » — ils ont failli te détourner. La tentation de déformer la révélation est réelle. Le miroir m'interroge : est-ce que je reste fidèle à la révélation ?`,
  reflection: `La tentation de déformer la révélation est réelle. La fidélité à la révélation est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kadu la-yafutinunaka 'amma awhayna ilayka li-taftari 'alayna ghayra » — ils ont failli te détourner de ce que Nous t'avons révélé, pour que tu inventes sur Nous autre chose." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste fidèle à la révélation ? Ou est-ce que je me laisse tenter de la déformer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fidélité à la révélation est la fidélité à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la vérité, la déformation est le mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste fidèle à la révélation reste fidèle à Allah." }
  ],
  munajat: `Ya Rabb, je reste fidèle à Ta révélation. Ne permets pas que je la déforme. Garde-moi dans la vérité révélée.`
};

MIROIR["17:74"] = {
  reference: "17:74",
  theme: ["inclinaison", "fermeté", "châtiment"],
  emotion: "Gratitude, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mayl", "Ath-Thabat"],
  mirrorVersion: `« Si tu ne t'étais pas fermement appuyé sur Nous, tu aurais penché vers eux. » Le miroir me montre la nécessité du soutien divin. « Wa law la an thabbatnaka » — si tu ne t'étais pas fermement appuyé sur Nous. La fermeté vient du soutien d'Allah. Le miroir m'interroge : est-ce que je m'appuie sur Allah pour la fermeté ?`,
  reflection: `La fermeté vient du soutien d'Allah. Sans Lui, l'inclinaison vers le mal est possible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law la an thabbatnaka la-qad kidta tarkanu ilayhim shay'an qalila » — si tu ne t'étais pas fermement appuyé sur Nous, tu aurais penché vers eux un peu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'appuie sur Allah pour la fermeté ? Ou est-ce que je m'appuie sur moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appui sur Allah garantit la fermeté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soutien d'Allah est la seule garantie de fermeté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'appuie sur Allah reste ferme." }
  ],
  munajat: `Ya Rabb, je m'appuie sur Toi pour la fermeté. Ne permets pas que je m'appuie sur moi-même. Donne-moi la fermeté qui vient de Ton soutien.`
};

MIROIR["17:75"] = {
  reference: "17:75",
  theme: ["double", "châtiment", "vie"],
  emotion: "Mise en garde, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Ad-Di'f", "Al-Hayat"],
  mirrorVersion: `« Alors Nous t'aurions fait goûter le double de la vie et le double de la mort. » Le miroir me montre la conséquence de l'inclinaison. « Idhan adhaqnaka di'fa al-hayati wa di'fa al-mamati » — alors Nous t'aurions fait goûter le double de la vie et le double de la mort. La désobéissance double le châtiment. Le miroir m'interroge : est-ce que je crains le double châtiment ?`,
  reflection: `La désobéissance double le châtiment. L'obéissance évite le double.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idhan adhaqnaka di'fa al-hayati wa di'fa al-mamati thumma la tajidu laka 'alayna nasira » — alors Nous t'aurions fait goûter le double de la vie et le double de la mort, puis tu n'aurais trouvé personne pour te protéger contre Nous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le double châtiment ? Ou est-ce que je néglige la conséquence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du double châtiment motive l'obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment est proportionnel à la responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'inclinaison évite le double châtiment." }
  ],
  munajat: `Ya Rabb, je crains le double châtiment. Ne permets pas l'inclinaison vers le mal. Protège-moi du châtiment doublé.`
};

MIROIR["17:76"] = {
  reference: "17:76",
  theme: ["expulsion", "mécréants", "séjour"],
  emotion: "Mise en garde, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ikhraj", "Al-Makth"],
  mirrorVersion: `« Ils ont failli t'effrayer du pays pour t'en expulser. » Le miroir me montre la tentative d'expulsion. « Wa in kadu layastafizunaka mina al-ardi » — ils ont failli t'effrayer du pays. Les mécréants veulent expulser le prophète. Le miroir m'interroge : est-ce que je reste ferme face aux tentatives d'expulsion ?`,
  reflection: `Les mécréants veulent expulser le prophète. La fermeté face aux tentatives est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kadu layastafizunaka mina al-ardi li-yukhrijuka minha wa idhan la-yalabathuna khilafaka qalila » — ils ont failli t'effrayer du pays pour t'en expulser. Et alors ils ne seraient restés après toi que peu de temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste ferme face aux tentatives d'expulsion ? Ou est-ce que je me laisse effrayer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fermeté face aux menaces est la voie des prophètes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mécréants ne restent pas longtemps après le prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste ferme face aux menaces est protégé par Allah." }
  ],
  munajat: `Ya Rabb, je reste ferme face aux tentatives d'expulsion. Ne permets pas que je sois effrayé. Donne-moi la fermeté des prophètes.`
};

MIROIR["17:77"] = {
  reference: "17:77",
  theme: ["précédent", "prophètes", "sunnah"],
  emotion: "Sagesse, constance",
  difficulty: "débutant",
  relatedNames: ["As-Sunnah", "Al-Anbiya"],
  mirrorVersion: `« C'est Notre règle appliquée à Nos messagers que Nous avons envoyés avant toi. » Le miroir me montre la constance de la sunnah divine. « Sunnata man qad arsalna qablaka » — c'est Notre règle appliquée à Nos messagers. La sunnah d'Allah est constante. Le miroir m'interroge : est-ce que j'accepte la sunnah d'Allah ?`,
  reflection: `La sunnah d'Allah est constante. L'acceptation de la sunnah est la sagesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sunnata man qad arsalna qablaka wa la tajidu li-sunnatina tabdila » — c'est Notre règle appliquée à Nos messagers que Nous avons envoyés avant toi. Tu ne trouveras pas de changement à Notre règle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la sunnah d'Allah ? Ou est-ce que je veux la changer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la sunnah divine est la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sunnah d'Allah ne change pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la sunnah d'Allah est en harmonie avec l'univers." }
  ],
  munajat: `Ya Rabb, j'accepte Ta sunnah. Ne permets pas que je veuille la changer. Donne-moi la sagesse d'accepter Tes règles constantes.`
};

MIROIR["17:78"] = {
  reference: "17:78",
  theme: ["prière", "temps", "déclin"],
  emotion: "Dévotion, discipline",
  difficulty: "débutant",
  relatedNames: ["As-Salah", "Al-Waqt"],
  mirrorVersion: `« Accomplis la prière au déclin du soleil jusqu'à l'obscurité de la nuit. » Le miroir me montre les temps de prière. « Aqimi al-salata li-duluki al-shamsi » — accomplis la prière au déclin du soleil. Les temps de prière sont précis. Le miroir m'interroge : est-ce que j'accomplis la prière à ses temps ?`,
  reflection: `Les temps de prière sont précis. L'accomplissement à temps est la discipline.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aqimi al-salata li-duluki al-shamsi ila ghasiqi al-layli » — accomplis la prière au déclin du soleil jusqu'à l'obscurité de la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accomplis la prière à ses temps ? Ou est-ce que je retarde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière à temps est la meilleure prière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les temps de prière rythment la journée du croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie à temps organise sa vie autour d'Allah." }
  ],
  munajat: `Ya Rabb, j'accomplis la prière à ses temps. Ne permets pas que je retarde. Donne-moi la discipline de prier à temps.`
};

MIROIR["17:79"] = {
  reference: "17:79",
  theme: ["nuit", "tahajjud", "proximité"],
  emotion: "Intimité, dévotion",
  difficulty: "intermédiaire",
  relatedNames: ["At-Tahajjud", "Al-Layl"],
  mirrorVersion: `« Et de la nuit, consacre une partie pour la prière surérogatoire. » Le miroir me montre la prière de nuit. « Wa mina al-layli fa-tahajjad bihi » — et de la nuit, consacre une partie pour la prière surérogatoire. La prière de nuit est pour la proximité. Le miroir m'interroge : est-ce que je consacre une partie de la nuit pour la prière ?`,
  reflection: `La prière de nuit est pour la proximité avec Allah. C'est un temps d'intimité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mina al-layli fa-tahajjad bihi nafilatan laka » — et de la nuit, consacre une partie pour la prière surérogatoire, afin que ton Seigneur te ressuscite en une position honorable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je consacre une partie de la nuit pour la prière ? Ou est-ce que je dors sans prière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière de nuit est le secret de la proximité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est le temps de l'intimité avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie la nuit a une position honorable." }
  ],
  munajat: `Ya Rabb, je veux consacrer une partie de la nuit pour la prière. Donne-moi la force de me lever. Fais que je sois ressuscité en position honorable.`
};

MIROIR["17:80"] = {
  reference: "17:80",
  theme: ["entrée", "sortie", "vérité"],
  emotion: "Confiance, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Dukhul", "Al-Khruj"],
  mirrorVersion: `« Et dis : "Ô mon Seigneur, fais-moi entrer en toute vérité et fais-moi sortir en toute vérité." » Le miroir me montre la prière pour l'entrée et la sortie. « Rabbi adkhilni mudkhala sidqin » — ô mon Seigneur, fais-moi entrer en toute vérité. L'entrée et la sortie doivent être dans la vérité. Le miroir m'interroge : est-ce que j'entre et sors dans la vérité ?`,
  reflection: `L'entrée et la sortie doivent être dans la vérité. Cette prière guide tous les mouvements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qul rabbi adkhilni mudkhala sidqin wa akhrijni mukhraja sidqin wa ij'al li min ladunka sultaninan nasira » — et dis : Ô mon Seigneur, fais-moi entrer en toute vérité et fais-moi sortir en toute vérité, et accorde-moi de Ta part un pouvoir secourable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'entre et sors dans la vérité ? Ou est-ce que j'ai des intentions cachées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour l'entrée et la sortie véridiques sanctifie tous les mouvements." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout mouvement peut être sanctifié par la prière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entre et sort dans la vérité est béni dans tous ses mouvements." }
  ],
  munajat: `Ya Rabb, fais-moi entrer en toute vérité et fais-moi sortir en toute vérité. Accorde-moi un pouvoir secourable de Ta part.`
};

MIROIR["17:81"] = {
  reference: "17:81",
  theme: ["vérité", "fausseté", "lumière"],
  emotion: "Espoir, triomphe",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Et dis : "La vérité est venue et la fausseté a disparu." » Le miroir me montre le triomphe de la vérité. « Wa qul ja'a al-haqqu wa zahaqa al-batilu » — et dis : La vérité est venue et la fausseté a disparu. La vérité triomphe toujours. Le miroir m'interroge : est-ce que je suis du côté de la vérité ?`,
  reflection: `La vérité triomphe toujours. La fausseté disparaît.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qul ja'a al-haqqu wa zahaqa al-batilu inna al-batila kana zahuqan » — et dis : La vérité est venue et la fausseté a disparu. La fausseté est destinée à disparaître." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis du côté de la vérité ? Ou est-ce que je suis du côté de la fausseté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le triomphe de la vérité est certain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité et la fausseté ne peuvent coexister éternellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est du côté de la vérité triomphe avec elle." }
  ],
  munajat: `Ya Haqq, je suis du côté de la vérité. Fais que la vérité triomphe en moi. Ne permets pas que je sois du côté de la fausseté.`
};

// ==================== SURAH 38: SAD - MISSING ENTRIES ====================

MIROIR["38:2"] = {
  reference: "38:2",
  theme: ["mécréance", "orgueil", "avertissement"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kafirun", "Al-Takabbur"],
  mirrorVersion: `« Mais ceux qui ont mécru sont dans l'orgueil et le schisme. » Le miroir constate : « Bala alladhina kafaru fi 'izzatin wa shiqaq » — mais ceux qui ont mécru sont dans l'orgueil et le schisme. L'orgueil et la division sont les marques de la mécréance. Le miroir m'enseigne : l'orgueil précède la chute.`,
  reflection: `L'orgueil précède la chute. La division suit l'orgueil.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bala alladhina kafaru fi 'izzatin wa shiqaq » — mais ceux qui ont mécru sont dans l'orgueil et le schisme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel orgueil me menace ? Suis-je en schisme avec la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité et l'unité sont les marques de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil et le schisme sont des maladies spirituelles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guérison de l'orgueil est dans la reconnaissance de sa petitesse." }
  ],
  munajat: `Ya Rabb, protège-moi de l'orgueil et du schisme. Fais que je sois humble et uni. Ne permets pas que je sois parmi les orgueilleux.`
};

MIROIR["38:3"] = {
  reference: "38:3",
  theme: ["précédents", "destruction", "leçon"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Umam", "Al-Halak"],
  mirrorVersion: `« Que de générations Nous avons fait périr avant eux ! » Le miroir rappelle : « Kam ahlakna min qablihim min qarnin » — que de générations Nous avons fait périr avant eux ! L'histoire est remplie de leçons. Le miroir m'enseigne : les précédents sont des avertissements.`,
  reflection: `Les précédents sont des avertissements. L'histoire enseigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kam ahlakna min qablihim min qarnin » — que de générations Nous avons fait périr avant eux !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je appris des générations passées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des précédents est une miséricorde pour les suivants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est le témoin de la justice divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des erreurs des autres ne les répète pas." }
  ],
  munajat: `Ya Rabb, j'apprends des générations passées. Fais que je ne répète pas leurs erreurs. Ne permets pas que je sois parmi les destructibles.`
};

MIROIR["38:4"] = {
  reference: "38:4",
  theme: ["étonnement", "messager", "rejet"],
  emotion: "Étonnement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-'Ajib"],
  mirrorVersion: `« Ils s'étonnèrent qu'un avertisseur vînt à eux. » Le miroir constate : « Wa 'ajibu an ja'ahum mundhirun minhum » — ils s'étonnèrent qu'un avertisseur vînt à eux. L'avertissement est rejeté par surprise. Le miroir m'enseigne : l'étonnement du messager révèle l'égarement.`,
  reflection: `L'étonnement du messager révèle l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ajibu an ja'ahum mundhirun minhum » — ils s'étonnèrent qu'un avertisseur vînt à eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'étonne de la guidance ? Ou est-ce que je l'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement devant le messager est un signe de l'éloignement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le messager est envoyé à ceux qui en ont besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'accueil du messager avec gratitude est le signe de la foi." }
  ],
  munajat: `Ya Rabb, j'accueille Ton messager avec gratitude. Ne permets pas que je m'étonne de la guidance. Fais que je l'accepte.`
};

MIROIR["38:5"] = {
  reference: "38:5",
  theme: ["divinités", "unicité", "rejet"],
  emotion: "Questionnement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Alihah", "Al-Wahid"],
  mirrorVersion: `« A-t-il fait des divinités un seul dieu ? » Le miroir rapporte la question : « A-ja'ala al-alihata ilahan wahidan » — a-t-il fait des divinités un seul dieu ? La question révèle l'incompréhension. Le miroir m'enseigne : le tawhid dérange l'associationniste.`,
  reflection: `Le tawhid dérange l'associationniste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-ja'ala al-alihata ilahan wahidan » — a-t-il fait des divinités un seul dieu ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la proclamation de l'unicité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étonnement devant l'unicité montre le polythéisme du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est la vérité — la multiplicité des divinités est fausse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'unicité trouve la paix." }
  ],
  munajat: `Ya Wahid, j'accepte Ton unicité. Fais que je vive en tawhid. Ne permets pas que je sois troublé par la vérité.`
};

MIROIR["38:6"] = {
  reference: "38:6",
  theme: ["conseil", "rejet", "opposition"],
  emotion: "Réalité, opposition",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'", "Al-Dhahab"],
  mirrorVersion: `« Et les notables parmi eux s'en allèrent en disant : Partez et restez constants. » Le miroir décrit : « Wa intalaqa al-mala'u minhum ani imshu wa isbiru » — et les notables parmi eux s'en allèrent en disant : Partez et restez constants. L'opposition organisée. Le miroir m'enseigne : les notables peuvent être des obstacles.`,
  reflection: `Les notables peuvent être des obstacles à la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa intalaqa al-mala'u minhum ani imshu wa isbiru 'ala alihatikum » — et les notables parmi eux s'en allèrent en disant : Partez et restez constants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels notables m'influencent contre la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La constance dans l'erreur n'est pas une vertu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'opposition des notables ne change pas la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'indépendance de pensée face aux notables est nécessaire." }
  ],
  munajat: `Ya Rabb, donne-moi l'indépendance de pensée. Fais que je suive la vérité malgré les notables. Ne permets pas que je sois influencé par l'erreur.`
};

MIROIR["38:7"] = {
  reference: "38:7",
  theme: ["invention", "mensonge", "accusation"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Iftira'", "Al-Kadhib"],
  mirrorVersion: `« Nous n'avons pas entendu cela dans la dernière religion. » Le miroir rapporte : « Ma sami'na bi-hadha fi al-millati al-akhirah » — nous n'avons pas entendu cela dans la dernière religion. L'accusation d'innovation. Le miroir m'enseigne : la nouveauté de la vérité peut être accusée d'innovation.`,
  reflection: `La nouveauté de la vérité peut être accusée d'innovation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma sami'na bi-hadha fi al-millati al-akhirah » — nous n'avons pas entendu cela dans la dernière religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accuse de nouveauté ce qui est la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation d'innovation peut masquer le rejet de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est ancienne — même si elle semble nouvelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de la vérité ne dépend pas de sa familiarité." }
  ],
  munajat: `Ya Rabb, reconnais la vérité même si elle me semble nouvelle. Ne permets pas que je la rejette par habitude. Ouvre mon cœur.`
};

MIROIR["38:8"] = {
  reference: "38:8",
  theme: ["préférence", "révélation", "jalousie"],
  emotion: "Questionnement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Tanzil", "Al-Akhtar"],
  mirrorVersion: `« Le rappel a-t-il été révélé à lui parmi nous ? » Le miroir questionne : « Anuzzila 'alayhi al-dhikru min baynina » — le rappel a-t-il été révélé à lui parmi nous ? La question révèle la jalousie. Le miroir m'enseigne : la jalousie peut voiler la reconnaissance de la vérité.`,
  reflection: `La jalousie peut voiler la reconnaissance de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Anuzzila 'alayhi al-dhikru min baynina » — le rappel a-t-il été révélé à lui parmi nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je jaloux de ceux qui reçoivent des bienfaits ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jalousie ne change pas le choix divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le choix d'Allah est parfait — la jalousie est vaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour le choix d'Allah apaise le cœur." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour Ton choix. Ne permets pas la jalousie. Fais que j'accepte Ta sagesse.`
};

// ==================== SURAH 39: AZ-ZUMAR - MISSING ENTRIES ====================

MIROIR["39:3"] = {
  reference: "39:3",
  theme: ["religion", "sincérité", "adoration"],
  emotion: "Vérité, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Ikhlas"],
  mirrorVersion: `« La religion pure n'appartient-elle pas à Allah ? » Le miroir affirme : « Ala lillahi al-dinu al-khalis » — la religion pure n'appartient-elle pas à Allah ? La pureté de la religion est l'exclusivité. Le miroir m'enseigne : la religion est pour Allah seul.`,
  reflection: `La religion est pour Allah seul. La pureté est l'exclusivité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala lillahi al-dinu al-khalis » — la religion pure n'appartient-elle pas à Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma religion est pure ? Est-ce qu'elle est pour Allah seul ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté de la religion est sa force." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion pure est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sincérité dans la religion ouvre les portes." }
  ],
  munajat: `Ya Rabb, je veux une religion pure pour Toi seul. Fais que je sois sincère. Ne permets pas que je partage mon adoration.`
};

MIROIR["39:4"] = {
  reference: "39:4",
  theme: ["enfant", "famille", "unicité"],
  emotion: "Certitude, tawhid",
  difficulty: "débutant",
  relatedNames: ["Al-Walad", "Al-Wahid"],
  mirrorVersion: `« S'Il avait voulu un enfant, Il aurait choisi ce qu'Il voulut parmi Ses créatures. » Le miroir clarifie : « Law arada Allahu an yattakhidha waladan la-stafa mimma yakhluqu ma yasha'u » — s'Il avait voulu un enfant, Il aurait choisi ce qu'Il voulut parmi Ses créatures. Allah n'a pas besoin d'enfant. Le miroir m'enseigne : l'enfant est une créature, pas une nécessité divine.`,
  reflection: `Allah n'a pas besoin d'enfant. L'enfant est une créature.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Law arada Allahu an yattakhidha waladan la-stafa mimma yakhluqu ma yasha'u » — s'Il avait voulu un enfant, Il aurait choisi ce qu'Il voulut parmi Ses créatures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attribue à Allah des attributs humains ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transcendance d'Allah exclut les besoins humains." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est au-dessus de toute comparaison." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La connaissance d'Allah dans Sa transcendance est la clé." }
  ],
  munajat: `Ya Rabb, Tu es transcendant. Fais que je Te connais comme Tu es. Ne permets pas que je T'attribue des limites.`
};

MIROIR["39:5"] = {
  reference: "39:5",
  theme: ["création", "nuit", "jour"],
  emotion: "Émerveillement, tawhid",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "Al-Layl", "Al-Nahar"],
  mirrorVersion: `« Il a créé les cieux et la terre en toute vérité. » Le miroir affirme : « Khalaqa al-samawati wa al-arda bi-al-haqq » — Il a créé les cieux et la terre en toute vérité. La création est vraie. Le miroir m'enseigne : la création porte le sceau de la vérité.`,
  reflection: `La création porte le sceau de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa al-samawati wa al-arda bi-al-haqq » — Il a créé les cieux et la terre en toute vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que la création m'enseigne sur le Créateur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité de la création reflète la vérité du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création témoigne de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La contemplation de la création mène à la connaissance." }
  ],
  munajat: `Ya Khaliq, Tu as créé en toute vérité. Fais que je contemple Ta création. Ne permets pas que je sois aveugle aux signes.`
};

MIROIR["39:6"] = {
  reference: "39:6",
  theme: ["création", "âme", "provision"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Nafs", "Ar-Rizq"],
  mirrorVersion: `« Il vous a créés d'un seul être. » Le miroir rappelle : « Khalaqakum min nafsin wahidatin » — Il vous a créés d'un seul être. L'unité d'origine. Le miroir m'enseigne : l'humanité est une famille.`,
  reflection: `L'humanité est une famille. L'unité d'origine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqakum min nafsin wahidatin » — Il vous a créés d'un seul être." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite ma famille humaine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité d'origine demande l'unité de traitement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les humains sont frères et sœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de l'unité d'origine mène à la fraternité." }
  ],
  munajat: `Ya Rabb, Tu nous as créés d'un seul être. Fais que je sois fraternel. Ne permets pas la division.`
};

MIROIR["39:8"] = {
  reference: "39:8",
  theme: ["détresse", "ingratitude", "retour"],
  emotion: "Réalité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Darr", "Al-Ni'mah"],
  mirrorVersion: `« Et quand un mal touche l'homme, il invoque son Seigneur en se tournant vers Lui. » Le miroir observe : « Wa idha massa al-insana durrun da'a rabbahu muniban ilayhi » — et quand un mal touche l'homme, il invoque son Seigneur en se tournant vers Lui. La détresse ramène à Allah. Le miroir m'enseigne : l'épreuve peut être une bénédiction.`,
  reflection: `L'épreuve peut être une bénédiction. La détresse ramène à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha massa al-insana durrun da'a rabbahu muniban ilayhi » — et quand un mal touche l'homme, il invoque son Seigneur en se tournant vers Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis à la détresse ? Est-ce que je retourne à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La détresse qui ramène à Allah est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve est une invitation au retour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le retour à Allah dans la détresse prépare l'abondance." }
  ],
  munajat: `Ya Rabb, je retourne à Toi dans la détresse. Fais que je Te remercie aussi dans l'abondance. Ne permets pas l'ingratitude.`
};

MIROIR["39:11"] = {
  reference: "39:11",
  theme: ["ordre", "adoration", "sincérité"],
  emotion: "Commandement, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-'Ibadah", "Al-Ikhlas"],
  mirrorVersion: `« Il t'a été ordonné d'adorer Allah en Lui vouant un culte exclusif. » Le miroir ordonne : « Umirtu an a'buda Allaha mukhlisan lahu al-din » — il t'a été ordonné d'adorer Allah en Lui vouant un culte exclusif. L'ordre est clair. Le miroir m'enseigne : l'adoration exclusive est le commandement.`,
  reflection: `L'adoration exclusive est le commandement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Umirtu an a'buda Allaha mukhlisan lahu al-din » — il t'a été ordonné d'adorer Allah en Lui vouant un culte exclusif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon adoration est exclusive ? Ou est-elle partagée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité de l'adoration est la condition de son acceptation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le commandement d'adoration exclusive est universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'exclusivité dans l'adoration ouvre la porte de la proximité." }
  ],
  munajat: `Ya Rabb, j'adore exclusivement. Fais que mon adoration soit pure. Ne permets pas que je la partage.`
};

// ==================== SURAH 40: GHAFIR - MISSING ENTRIES ====================

MIROIR["40:5"] = {
  reference: "40:5",
  theme: ["précédents", "rejet", "messagers"],
  emotion: "Leçon, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Umam", "Al-Rusul"],
  mirrorVersion: `« Avant eux, le peuple de Noé et les coalisés après eux ont crié au mensonge. » Le miroir rappelle : « Kadhdhabat qablahumu qawmu Nuhin wa al-ahzabu min ba'dihim » — avant eux, le peuple de Noé et les coalisés après eux ont crié au mensonge. L'histoire se répète. Le miroir m'enseigne : le rejet des messagers est une tradition humaine.`,
  reflection: `Le rejet des messagers est une tradition humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat qablahumu qawmu Nuhin wa al-ahzabu min ba'dihim » — avant eux, le peuple de Noé et les coalisés après eux ont crié au mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la guidance comme les précédents ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un miroir — celui qui regarde apprend." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des peuples est un avertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui brise la tradition du rejet trouve la guidance." }
  ],
  munajat: `Ya Rabb, je ne veux pas rejeter Ta guidance. Fais que j'apprenne de l'histoire. Ne permets pas que je répète les erreurs.`
};

MIROIR["40:6"] = {
