  difficulty: "débutant",
  relatedNames: ["Al-Kufr", "Al-Istikbar"],
  mirrorVersion: `« Les mécréants sont dans l'orgueil et l'hostilité. » Le miroir me montre l'état des mécréants. « Wa al-kafiruna fi 'izzatin wa shiqaq » — les mécréants sont dans l'orgueil et l'hostilité. L'état. Le miroir m'avertit : l'orgueil et l'hostilité caractérisent les mécréants.`,
  reflection: `Les mécréants sont orgueilleux et hostiles. Ces deux traits les perdent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-kafiruna fi 'izzatin wa shiqaq » — les mécréants sont dans l'orgueil et l'hostilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai de l'orgueil ou de l'hostilité ? Ou est-ce que je suis humble et paisible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité et la paix sont les vertus des croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est humble et paisible dans sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne l'orgueil et l'hostilité est sauvé." }
  ],
  munajat: `Ya Rabb, je veux l'humilité et la paix. Enlève de moi l'orgueil et l'hostilité. Garde-moi parmi les croyants humbles.`
};

MIROIR["38:3"] = {
  reference: "38:3",
  theme: ["précédents", "destruction", "clameur"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qurun", "Al-Halak"],
  mirrorVersion: `« Combien de générations avant eux avons-Nous fait périr ! » Le miroir me montre l'histoire des destructions. « Kam ahlakna min qablihim min qarnin » — combien de générations avant eux avons-Nous fait périr ! L'histoire. Le miroir m'avertit : les générations précédentes ont été détruites.`,
  reflection: `Les générations précédentes ont été détruites pour leur mécréance. L'histoire enseigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kam ahlakna min qablihim min qarnin » — combien de générations avant eux avons-Nous fait périr !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire des générations ? Ou est-ce que je répète leurs erreurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage de l'histoire évite la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers porte les traces des générations passées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne la répète pas." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire des générations. Ne permets pas que je répète leurs erreurs. Sauve-moi de la destruction.`
};

MIROIR["38:4"] = {
  reference: "38:4",
  theme: ["étonnement", "messager", "envoi"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ajab", "Al-Rasul"],
  mirrorVersion: `« Ils s'étonnent qu'un avertisseur soit venu d'entre eux. » Le miroir me montre l'étonnement des mécréants. « Wa 'ajiba an ja'ahum mundhirun minhum » — ils s'étonnent qu'un avertisseur soit venu d'entre eux. L'étonnement. Le miroir m'enseigne : l'avertisseur est envoyé parmi les siens.`,
  reflection: `Les mécréants s'étonnent d'un avertisseur parmi eux. Mais c'est la miséricorde d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ajiba an ja'ahum mundhirun minhum » — ils s'étonnent qu'un avertisseur soit venu d'entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accueille l'avertisseur ? Ou est-ce que je m'étonne et rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accueil de l'avertisseur est la marque de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accueille les avertisseurs de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille l'avertisseur reçoit la guidance." }
  ],
  munajat: `Ya Rabb, j'accueille Ton avertisseur. Ne permets pas que je m'étonne et rejette. Donne-moi la foi en Ton messager.`
};

MIROIR["38:5"] = {
  reference: "38:5",
  theme: ["divinités", "unicité", "rejet"],
  emotion: "Mise en garde, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Alihah", "At-Tawhid"],
  mirrorVersion: `« Il a réduit les divinités à une seule divinité. » Le miroir me montre le rejet de l'unicité. « A-ja'ala al-alihata ilahan wahid » — il a réduit les divinités à une seule divinité. L'accusation. Le miroir m'enseigne : le tawhid est un scandale pour les polythéistes.`,
  reflection: `L'unicité d'Allah scandalise les polythéistes. Pourtant, c'est la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-ja'ala al-alihata ilahan wahid » — il a réduit les divinités à une seule divinité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'unicité d'Allah ? Ou est-ce que je la trouve scandaleuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unicité d'Allah est la vérité, pas un scandale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de l'unicité de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'unicité a compris l'essentiel." }
  ],
  munajat: `Ya Wahid, j'accepte Ton unicité. Ne permets pas que je la trouve scandaleuse. Donne-moi la foi en Ton unicité.`
};

MIROIR["38:6"] = {
  reference: "38:6",
  theme: ["conseil", "persévérance", "dévotion"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mala", "As-Sabarah"],
  mirrorVersion: `« Les notables parmi eux s'en allèrent en disant : 'Allez et soyez constants dans votre dévotion.' » Le miroir me montre le conseil des notables. « Wa intalaqa al-mala'u minhum an imshu wa isbiru 'ala alihatakum » — les notables parmi eux s'en allèrent en disant : allez et soyez constants dans votre dévotion. Le conseil. Le miroir m'avertit : les notables mécréants encouragent l'idolâtrie.`,
  reflection: `Les notables mécréants encouragent la persévérance dans l'idolâtrie. Leur influence est néfaste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa intalaqa al-mala'u minhum an imshu wa isbiru 'ala alihatakum » — les notables parmi eux s'en allèrent en disant : allez et soyez constants dans votre dévotion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes notables ? M'encouragent-ils dans la foi ou dans l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les notables de la foi encouragent dans la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de notables qui l'égarent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les notables de la foi est guidé." }
  ],
  munajat: `Ya Rabb, je veux suivre les notables de la foi. Ne permets pas que je sois influencé par les notables de l'égarement. Donne-moi de bons guides.`
};

MIROIR["38:7"] = {
  reference: "38:7",
  theme: ["innovation", "mensonge", "accusation"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Bid'ah", "Al-Kadhib"],
  mirrorVersion: `« Nous n'avons pas entendu cela dans la dernière religion. » Le miroir me montre le rejet de la nouveauté. « Ma sami'na bi-hadha fi al-millati al-akhirati » — nous n'avons pas entendu cela dans la dernière religion. Le rejet. Le miroir m'enseigne : la vérité peut sembler nouvelle.`,
  reflection: `Les mécréants rejettent la vérité comme nouveauté. Pourtant, c'est la religion éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma sami'na bi-hadha fi al-millati al-akhirati » — nous n'avons pas entendu cela dans la dernière religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la vérité même si elle semble nouvelle ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est éternelle, même si elle semble nouvelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers accepte la vérité éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité reçoit la guidance." }
  ],
  munajat: `Ya Rabb, j'accepte Ta vérité éternelle. Ne permets pas que je la rejette comme nouveauté. Ouvre mon cœur à la vérité.`
};

MIROIR["38:8"] = {
  reference: "38:8",
  theme: ["révélation", "envie", "question"],
  emotion: "Vérité, sagesse",
  difficulty: "débutant",
  relatedNames: ["At-Tanzil", "Al-Hasad"],
  mirrorVersion: `« Le rapple a-t-il été révélé à lui parmi nous ? » Le miroir me montre la jalousie. « A-unzila 'alayhi al-dhikru min baynina » — le rapple a-t-il été révélé à lui parmi nous ? La jalousie. Le miroir m'enseigne : la jalousie empêche de reconnaître la vérité.`,
  reflection: `Les mécréants sont jaloux de la révélation. La jalousie les aveugle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-unzila 'alayhi al-dhikru min baynina » — le rapple a-t-il été révélé à lui parmi nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis jaloux de ce que les autres reçoivent ? Ou est-ce que je me réjouis pour eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie pour les autres libère de la jalousie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas jaloux des bienfaits des autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réjouit pour les autres est libéré de la jalousie." }
  ],
  munajat: `Ya Rabb, je me réjouis pour ceux qui reçoivent Tes bienfaits. Enlève de moi la jalousie. Donne-moi la joie pour les autres.`
};

MIROIR["38:9"] = {
  reference: "38:9",
  theme: ["trésor", "miséricorde", "question"],
  emotion: "Questionnement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaza'in", "Ar-Rahmah"],
  mirrorVersion: `« Ont-ils les trésors de la miséricorde de ton Seigneur ? » Le miroir me montre la question rhétorique. « Am 'indahum khaza'inu rahmati rabbika » — ont-ils les trésors de la miséricorde de ton Seigneur ? La question. Le miroir m'enseigne : les trésors d'Allah sont entre Ses mains.`,
  reflection: `Les trésors de la miséricorde d'Allah n'appartiennent à personne d'autre. Ils sont distribués selon Sa volonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am 'indahum khaza'inu rahmati rabbika » — ont-ils les trésors de la miséricorde de ton Seigneur ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que les trésors d'Allah sont entre Ses mains ? Ou est-ce que je veux les contrôler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des trésors d'Allah mène à la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit les trésors de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les trésors d'Allah reçoit Sa miséricorde." }
  ],
  munajat: `Ya Rahman, les trésors de Ta miséricorde sont entre Tes mains. Je les reconnais. Donne-moi de Ta miséricorde selon Ta volonté.`
};

MIROIR["38:10"] = {
