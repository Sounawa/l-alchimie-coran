  emotion: "Avertissement, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Ceux-là sont les vrais mécréants. » Le miroir me montre la conséquence de la partialité. « Ula'ika humu al-kafiruna al-haqq » — ceux-là sont les véritables mécréants. La distinction dans la foi mène à la mécréance totale.`,
  reflection: `La foi partielle n'est pas la foi. Croire en certains messagers et en rejeter d'autres est une mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika humu al-kafiruna al-haqq » — ceux-là sont les vrais mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est complète ? Ou est-ce que je choisis ce qui m'arrange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moitié de la foi est l'absence de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est indivisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui divise la foi perd tout." }
  ],
  munajat: `Ya Hadi, guide-moi vers la foi complète. Ne permets pas que je choisisse dans la révélation. Donne-moi la foi totale.`
};

MIROIR["4:152"] = {
  reference: "4:152",
  theme: ["foi", "messagers", "récompense"],
  emotion: "Espoir, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Ghaffur"],
  mirrorVersion: `« Et ceux qui croient en Allah et en Ses messagers, sans faire de distinction. » Le miroir me montre la foi complète. « Yu'minuna billahi wa rusulihi » — ils croient en Allah et en Ses messagers. La foi sans distinction est la vraie foi.`,
  reflection: `La foi complète en tous les messagers est la voie de la récompense. Allah accorde Sa miséricorde aux croyants sincères.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu billahi wa rusulihi wa lam yufarriqu bayna ahadin minhum » — et ceux qui croient en Allah et en Ses messagers, sans faire de distinction entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en tous les prophètes ? Sans exception ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi totale attire la récompense totale." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les messagers sont frères dans la mission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en tous reçoit de tous." }
  ],
  munajat: `Ya Wali, je crois en tous Tes messagers. Donne-moi la récompense promise. Fais que ma foi soit sans distinction.`
};

MIROIR["4:153"] = {
  reference: "4:153",
  theme: ["révélation", "demande", "vision"],
  emotion: "Avertissement, rappel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Khabir"],
  mirrorVersion: `« Les gens du Livre te demandent de leur faire descendre du ciel un Livre. » Le miroir me montre l'excès de demande. « Yas'aluka ahlu al-kitabi an tunazzila 'alayhim kitaban » — ils te demandent de faire descendre un livre. La demande excessive cache le refus.`,
  reflection: `Les gens du Livre demandaient l'impossible pour tester le Prophète. Leur demande n'était pas sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'aluka ahlu al-kitabi an tunazzila 'alayhim kitaban mina al-sama'i » — les gens du Livre te demandent de leur faire descendre un livre du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande à Allah ? Est-ce sincère ou est-ce un test ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande sincère reçoit. La demande de test échoue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah répond à la sincérité, pas à la curiosité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande avec un cœur pur reçoit." }
  ],
  munajat: `Ya Basir, Tu vois mon cœur. Fais que ma demande soit sincère. Ne permets pas que je teste Ta puissance.`
};

MIROIR["4:154"] = {
  reference: "4:154",
  theme: ["alliance", "montagne", "engagement"],
  emotion: "Solennité, rappel",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Aziz", "Al-Jabbar"],
  mirrorVersion: `« Et Nous avons élevé au-dessus d'eux le Mont Tor. » Le miroir me montre l'alliance solennelle. « Wa rafa'na fawqahumu al-tura » — Nous avons élevé au-dessus d'eux la montagne. L'alliance était dramatique.`,
  reflection: `Allah a élevé la montagne au-dessus des Enfants d'Israël pour qu'ils prennent l'alliance au sérieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rafa'na fawqahumu al-tura bi-mithaqihim » — et Nous avons élevé au-dessus d'eux le Mont Tor en raison de leur engagement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est élevé au-dessus de moi pour que je prenne au sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gravité de l'alliance exige la gravité de l'engagement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La montagne est un rappel physique de la puissance divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte l'alliance n'a pas besoin de la montagne." }
  ],
  munajat: `Ya Aziz, Tu as élevé la montagne pour l'alliance. Fais que je respecte mon engagement sans avoir besoin de la montagne. Donne-moi la foi sérieuse.`
};

MIROIR["4:155"] = {
  reference: "4:155",
  theme: ["alliance", "violation", "mécréance"],
  emotion: "Tristesse, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Ils ont violé leur alliance, ils ont mécru aux signes d'Allah. » Le miroir me montre les conséquences de la rupture. « Naqdihimu al-mithaq » — ils ont rompu l'alliance. La rupture a des conséquences.`,
  reflection: `Les Enfants d'Israël ont rompu leur alliance avec Allah et ont mécru en Ses signes. La rupture mène à la malédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabima naqdihimu al-mithaqa wa kufruhum bi-ayati Allah » — en raison de leur rupture de l'alliance et de leur mécréance envers les signes d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte mon alliance avec Allah ? Ou est-ce que je la viole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rupture de l'alliance rompt la relation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alliance est sacrée. Sa rupture est grave." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde l'alliance garde la relation." }
  ],
  munajat: `Ya Hakam, j'ai fait alliance avec Toi. Aide-moi à la respecter. Ne permets pas que je la rompe et perds Ta faveur.`
};

MIROIR["4:156"] = {
  reference: "4:156",
  theme: ["mécréance", "calomnie", "Marie"],
  emotion: "Indignation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Bari"],
  mirrorVersion: `« Et à cause de leur mécréance et de l'énorme calomnie qu'ils prononcent contre Marie. » Le miroir me montre la gravité de la calomnie. « Wa qawlihim 'ala Maryama buhtanan 'azima » — et leur parole contre Marie est une énorme calomnie.`,
  reflection: `Les calomniateurs de Marie ont proféré une grave accusation. La calomnie contre les purs est un grand péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qawlihim 'ala Maryama buhtanan 'azima » — et à cause de leur parole contre Marie, une énorme calomnie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je calomnie ? Est-ce que j'accuse les innocents ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La calomnie contre les purs retombe sur le calomniateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté est protégée par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui défend les purs est défendu par Allah." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Protège-moi de la calomnie. Ne permets pas que j'accuse les innocents. Défends les purs.`
};

MIROIR["4:157"] = {
  reference: "4:157",
  theme: ["Jésus", "crucifixion", "illusion"],
  emotion: "Vérité, révélation",
  difficulty: "avancé",
  relatedNames: ["Al-Khaliq", "Al-Wafi"],
  mirrorVersion: `« Ils n'ont ni tué ni crucifié Jésus, mais cela leur a paru ainsi. » Le miroir me montre la vérité cachée. « Ma qataluhu wa ma salabuhu » — ils ne l'ont ni tué ni crucifié. L'apparence n'est pas la réalité.`,
  reflection: `Les Juifs croyaient avoir tué Jésus, mais Allah l'a élevé vers Lui. La réalité divine dépasse l'apparence humaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma qataluhu wa ma salabuhu wa lakin shubbiha lahum » — ils ne l'ont ni tué ni crucifié, mais cela leur a paru ainsi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'apparaît mais n'est pas ? Est-ce que je confonds apparence et réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apparence peut être une illusion. La vérité est avec Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah protège Ses messagers d'une manière que nous ne comprenons pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la vérité n'est pas trompé par l'apparence." }
  ],
  munajat: `Ya Khaliq, Tu connais la vérité. Apprends-moi à voir au-delà des apparences. Ne permets pas que je sois trompé par l'illusion.`
};

MIROIR["4:158"] = {
  reference: "4:158",
  theme: ["Jésus", "élévation", "puissance"],
  emotion: "Révérence, awe",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Rafi'", "Al-Aziz"],
  mirrorVersion: `« Mais Allah l'a élevé vers Lui. » Le miroir me montre l'élévation divine. « Bal rafa'ahu Allah ilayh » — mais Allah l'a élevé vers Lui. L'élévation est divine.`,
  reflection: `Allah a élevé Jésus vers Lui, le préservant de la mort des mains de ses ennemis. Sa puissance protège Ses élus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal rafa'ahu Allah ilayhi wa kana Allahu 'azizan hakima » — mais Allah l'a élevé vers Lui. Allah est Puissant et Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment Allah m'élève-t-Il ? Qu'est-ce qui m'élève vers Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation vers Allah précède le retour vers les hommes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah élève qui Il veut selon Sa sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est élevé par Allah ne peut être abaissé par les hommes." }
  ],
  munajat: `Ya Rafi', élève-moi vers Toi. Préserve-moi de ceux qui veulent me nuire. Fais que mon élévation vienne de Toi.`
};

MIROIR["4:159"] = {
  reference: "4:159",
  theme: ["Jésus", "retour", "témoignage"],
  emotion: "Attente, certitude",
  difficulty: "avancé",
  relatedNames: ["Al-Haqq", "Ash-Shahid"],
  mirrorVersion: `« Il n'y aura personne parmi les gens du Livre qui ne croira en lui avant sa mort. » Le miroir me montre la foi universelle à venir. « Qabl mawtihi » — avant sa mort. La foi en Jésus est inévitable.`,
  reflection: `Avant la mort de Jésus (à son retour), tous les gens du Livre croiront en lui. La vérité finit par triompher.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in min ahli al-kitabi illa la-yu'minanna bihi qabla mawtihi » — il n'y a personne parmi les gens du Livre qui ne croira en lui avant sa mort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en Jésus comme messager d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi tardive vaut mieux que l'absence de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité de Jésus sera manifestée à tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant anticipe la vérité universelle." }
  ],
  munajat: `Ya Shahid, Tu es le Témoin. Je crois en Jésus, Ton messager. Fais que ma foi soit anticipée et sincère.`
};

MIROIR["4:160"] = {
  reference: "4:160",
  theme: ["interdiction", "injustice", "punition"],
  emotion: "Rappel, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« C'est à cause des injustices des Juifs que Nous leur avons interdit les bonnes choses. » Le miroir me montre la conséquence de l'injustice. « Bi-zulmi alladhina hadu » — à cause de l'injustice des Juifs. L'injustice a des conséquences.`,
  reflection: `Allah a interdit aux Juifs certaines bonnes choses en raison de leur injustice. Le péché affecte les privilèges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabi-zulmi alladhina hadu harramna 'alayhim tayyibatin uhillat lahum » — à cause de l'injustice des Juifs, Nous leur avons interdit les bonnes choses qui leur étaient permises." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que mon injustice m'interdit ? Quels privilèges je perds par mon péché ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice ferme les portes de la provision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les interdits sont parfois des punitions pour les injustices." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste accède aux bonnes choses." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Préserve-moi de l'injustice. Ne permets pas que mes péchés me privent de Tes bienfaits.`
};

MIROIR["4:161"] = {
  reference: "4:161",
  theme: ["usure", "désobéissance", "interdiction"],
  emotion: "Rappel, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Et à cause de leur pratique de l'usure, alors qu'elle leur était interdite. » Le miroir me montre la désobéissance persistante. « Wa akhdhihimu al-riba » — et leur prise de l'usure. La désobéissance persistante attire la punition.`,
  reflection: `Les Juifs pratiquaient l'usure malgré son interdiction. La désobéissance consciente à une interdiction claire est grave.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa akhdhihimu al-riba wa nahrihim 'ani al-sabil » — et leur pratique de l'usure et leur empêchement du chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'est interdit mais que je pratique ? Y a-t-il une interdiction que je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'usure enrichit ici et appauvrit là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'usure corrompt l'économie et les relations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'usure protège sa provision." }
  ],
  munajat: `Ya Qahhar, l'usure est interdite. Préserve-moi de la pratiquer. Donne-moi une provision pure sans usure.`
};

MIROIR["4:162"] = {
  reference: "4:162",
  theme: ["foi", "science", "constance"],
  emotion: "Espoir, distinction",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Mais ceux d'entre eux qui sont enracinés dans la science. » Le miroir me montre la distinction. « Al-rasikhuna fi al-'ilm » — ceux qui sont enracinés dans la science. La science ancre la foi.`,
  reflection: `Parmi les gens du Livre, certains croient sincèrement. La science et la foi constante les distinguent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakin al-rasikhuna fi al-'ilmi minhum wa al-mu'minuna » — mais ceux d'entre eux qui sont enracinés dans la science et les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je enraciné dans la science ? Ma foi est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La science sans foi est sèche. La foi sans science est fragile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La science et la foi se renforcent mutuellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui allie science et foi est complet." }
  ],
  munajat: `Ya 'Alim, Tu es le Savant. Enracine-moi dans la science. Donne-moi une foi constante et éclairée.`
};

MIROIR["4:163"] = {
  reference: "4:163",
  theme: ["révélation", "messagers", "continuité"],
  emotion: "Reconnaissance, connexion",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Rasul"],
  mirrorVersion: `« Nous t'avons fait une révélation comme Nous fîmes à Noé et aux prophètes après lui. » Le miroir me montre la continuité. « Awhayna ilayka » — Nous t'avons révélé. La révélation continue.`,
  reflection: `La révélation à Muhammad continue la chaîne des prophètes. Il fait partie de la lignée des messagers d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna awhayna ilayka kama awhayna ila Nuhin wa al-nabiyyina min ba'dih » — Nous t'avons fait une révélation comme Nous fîmes à Noé et aux prophètes après lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la continuité de la révélation ? Le Coran fait-il partie de ma chaîne prophétique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation nouvelle confirme les anciennes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes sont reliés par la même source." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît un prophète les reconnaît tous." }
  ],
  munajat: `Ya Wahhab, Tu as révélé à tous Tes prophètes. Fais que je reconnaisse la chaîne de la révélation. Connecte-moi à tous les messagers.`
};

MIROIR["4:164"] = {
  reference: "4:164",
  theme: ["messagers", "mention", "nombre"],
  emotion: "Révérence, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Basit"],
  mirrorVersion: `« Des messagers dont Nous t'avons raconté l'histoire, et d'autres dont Nous ne t'avons pas raconté. » Le miroir me montre l'étendue cachée. « Wa rusulin qaddaqnahu 'alayka » — des messagers dont Nous t'avons parlé. Il y a plus que ce que je connais.`,
  reflection: `Tous les messagers ne sont pas mentionnés dans le Coran. La mission prophétique est vaste au-delà de notre connaissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rusulin qaddaqnahu 'alayka wa rusulin lam naqsus 'alayka » — des messagers dont Nous t'avons raconté l'histoire, et d'autres dont Nous ne t'avons pas raconté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je ne connais pas ? Comment la connaissance limitée façonne ma vision ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui n'est pas raconté n'est pas moins important." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque nation a reçu un messager." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le caché honore le manifeste." }
  ],
  munajat: `Ya Khabir, Tu connais tous les messagers. Fais que j'accepte ce que je ne connais pas. Élargis ma vision de Ta mission.`
};

MIROIR["4:165"] = {
  reference: "4:165",
  theme: ["messagers", "bonne nouvelle", "avertissement"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Nadhir"],
  mirrorVersion: `« Des messagers annonciateurs de bonne nouvelle et avertisseurs. » Le miroir me montre le double rôle. « Mubashshirina wa mundhirina » — annonceurs de bonne nouvelle et avertisseurs. Le message a deux faces.`,
  reflection: `Les messagers apportent à la fois la bonne nouvelle du paradis et l'avertissement de l'enfer. Les deux sont nécessaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mubashshirina wa mundhirina » — annonceurs de bonne nouvelle et avertisseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'entends plus ? La bonne nouvelle ou l'avertissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir sans crainte est illusion. La crainte sans espoir est désespoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message complet contient les deux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui équilibre espoir et crainte est guidé." }
  ],
  munajat: `Ya Bashir, ya Nadhir, Tu annonces et Tu avertis. Fais que j'entende les deux. Donne-moi l'équilibre entre espoir et crainte.`
};

MIROIR["4:166"] = {
  reference: "4:166",
  theme: ["coran", "témoignage", "véracité"],
  emotion: "Certitude, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Ash-Shahid", "Al-Haqq"],
  mirrorVersion: `« Mais Allah témoigne de ce qu'Il a fait descendre vers toi. » Le miroir me montre le témoignage divin. « Wa Allahu yashhadu » — Allah témoigne. Le Coran a le témoignage d'Allah.`,
  reflection: `Allah Lui-même témoigne de la véracité du Coran révélé à Muhammad. Ce témoignage est la plus haute preuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakinna Allaha yashhadu bi-ma anzala ilayk » — mais Allah témoigne de ce qu'Il a fait descendre vers toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le témoignage d'Allah sur le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le témoignage d'Allah est la preuve ultime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est attesté par son Auteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le témoignage d'Allah accepte le Coran." }
  ],
  munajat: `Ya Shahid, Tu témoignes du Coran. Fais que j'accepte Ton témoignage. Confirme ma foi en Ta révélation.`
};

MIROIR["4:167"] = {
  reference: "4:167",
  theme: ["égarement", "obstination", "péché"],
  emotion: "Avertissement, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudhill"],
  mirrorVersion: `« Ceux qui ne croient pas et qui écartent du chemin d'Allah. » Le miroir me montre l'égarement actif. « Yasudduna 'an sabil Allah » — ils écartent du chemin d'Allah. L'égarement personnel devient collectif.`,
  reflection: `Les mécréants ne se contentent pas de ne pas croire, ils empêchent les autres de croire. L'égarement actif est doublement coupable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru wa saddu 'an sabil Allah » — ceux qui ne croient pas et qui écartent du chemin d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'égare les autres ? Ou est-ce que je les guide ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Égarer les autres aggrave l'égarement personnel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le chemin d'Allah est ouvert. L'obstruction est faute." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide les autres est guidé doublement." }
  ],
  munajat: `Ya Hadi, guide-moi et ne permets pas que j'égare les autres. Fais que je sois un ouvrier du chemin, pas un obstacle.`
};

MIROIR["4:168"] = {
  reference: "4:168",
  theme: ["mécréance", "injustice", "punition"],
  emotion: "Avertissement, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Muntaqim"],
  mirrorVersion: `« Ceux qui ont mécru et qui ont été injustes, Allah ne leur accordera ni pardon ni chemin. » Le miroir me montre l'exclusion. « La yaghfira lahum » — Il ne leur pardonnera pas. L'injustice persistante ferme les portes.`,
  reflection: `La mécréance associée à l'injustice ferme la porte du pardon. La persistance dans le mal a des conséquences éternelles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru wa zalamu » — ceux qui ont mécru et qui ont été injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui ferme les portes du pardon ? La mécréance et l'injustice persistantes." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon est ouvert à celui qui se repent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est proportionnée à la persistance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la mort est pardonné." }
  ],
  munajat: `Ya Ghaffur, Tu pardonnes à qui Tu veux. Préserve-moi de la mécréance et de l'injustice. Ouvre-moi les portes du pardon.`
};

MIROIR["4:169"] = {
  reference: "4:169",
  theme: ["enfer", "éternité", "destination"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Khulud"],
  mirrorVersion: `« Sauf le chemin de l'Enfer, où ils demeureront éternellement. » Le miroir me montre la destination finale. « Illa sabil jahannam » — sauf le chemin de l'Enfer. Le refus a une conséquence.`,
  reflection: `Ceux qui persistent dans la mécréance et l'injustice ont l'Enfer comme destination éternelle. Le choix a des conséquences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa tariba jahannama khalidina fiha abadan » — sauf le chemin de l'Enfer, où ils demeureront éternellement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel chemin je prends ? Quel est ma destination finale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le chemin de l'Enfer est le refus du chemin d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque choix mène à une destination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit le chemin d'Allah évite le chemin de l'Enfer." }
  ],
  munajat: `Ya Rabb, préserve-moi de l'Enfer. Guide-moi sur le chemin droit. Fais que ma destination soit le Paradis.`
};

MIROIR["4:170"] = {
  reference: "4:170",
  theme: ["révélation", "foi", "chemin"],
  emotion: "Invitation, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Ô hommes ! Le Messager vous a apporté la vérité de votre Seigneur. » Le miroir me montre l'invitation universelle. « Ya ayyuha al-nas » — ô hommes ! L'appel est pour tous.`,
  reflection: `Le Messager a apporté la vérité à toute l'humanité. La foi en cette vérité guide vers le droit chemin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nasu qad ja'akumu al-rasulu bil-haqqi min rabbikum » — ô hommes ! Le Messager vous a apporté la vérité de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai accepté cette vérité ? Est-ce que je marche dans le droit chemin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité apportée demande une réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message est universel. La réponse est personnelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité entre dans le chemin." }
  ],
  munajat: `Ya Hadi, j'ai reçu la vérité. Aide-moi à l'accepter. Guide-moi sur le droit chemin par la foi.`
};

MIROIR["4:171"] = {
  reference: "4:171",
  theme: ["Jésus", "trinité", "unicité"],
  emotion: "Clarté, correction",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Ô gens du Livre ! N'exagérez pas dans votre religion. » Le miroir me montre la correction. « La taghlu fi dinikum » — n'exagérez pas dans votre religion. L'exagération corrompt la vérité.`,
  reflection: `Le Coran corrige les exagérations sur Jésus. Il est messager, non divin. L'unicité d'Allah doit être préservée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ahla al-kitabi la taghlu fi dinikum wa la taqulu 'ala Allahi illa al-haqq » — ô gens du Livre ! N'exagérez pas dans votre religion et ne dites sur Allah que la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'exagère dans ma religion ? Est-ce que je dis sur Allah ce qui est vrai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exagération religieuse est une forme d'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur Jésus est entre l'exagération et la négation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde l'équilibre garde la vérité." }
  ],
  munajat: `Ya Wahid, Tu es Un sans associé. Préserve-moi de l'exagération. Donne-moi la vérité sur Jésus et sur Toi.`
};

MIROIR["4:172"] = {
  reference: "4:172",
  theme: ["Jésus", "servitude", "orgueil"],
  emotion: "Humilité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Abd", "Al-Wali"],
  mirrorVersion: `« Le Messie ne trouve jamais indigne d'être serviteur d'Allah. » Le miroir me montre l'humilité du Messie. « Lan yastankifa al-masihu » — le Messie ne trouvera pas indigne. La servitude est honorable.`,
  reflection: `Jésus lui-même ne refuse pas d'être serviteur d'Allah. La plus haute position est la servitude la plus humble.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lan yastankifa al-masihu an yakuna 'abdan lillahi » — le Messie ne trouve jamais indigne d'être serviteur d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère la servitude comme honorable ? Ou est-ce que je cherche la gloire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La servitude d'Allah est l'honneur suprême." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plus proches d'Allah sont Ses meilleurs serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la servitude est élevé." }
  ],
  munajat: `Ya Rabb, je veux être Ton serviteur. Comme Jésus, je ne refuse pas la servitude. Élève-moi par mon abaissement.`
};

MIROIR["4:173"] = {
  reference: "4:173",
  theme: ["orgueil", "punition", "récompense"],
  emotion: "Avertissement, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Musta'n", "Al-Wali"],
  mirrorVersion: `« Quant à ceux qui, par orgueil, se refusent à L'adorer. » Le miroir me montre l'orgueil comme obstacle. « Yastakbiruna » — ils s'enorgueillissent. L'orgueil ferme les portes.`,
  reflection: `L'orgueil empêche l'adoration et attire la punition. L'humilité ouvre les portes de la récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma alladhina kafaru wa astakbaru » — quant à ceux qui ont mécru et se sont enorgueillis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que l'orgueil m'empêche d'adorer ? Suis-je trop fier pour me soumettre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil d'ici devient l'abaissement de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'orgueil est le premier péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'abaisse maintenant est élevé plus tard." }
  ],
  munajat: `Ya Rabb, l'orgueil m'empêche. Brise mon orgueil. Fais que je m'abaisse pour être élevé par Toi.`
};

MIROIR["4:174"] = {
  reference: "4:174",
  theme: ["preuve", "lumière", "révélation"],
  emotion: "Gratitude, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Burhan"],
  mirrorVersion: `« Ô hommes ! Une preuve vous est venue de votre Seigneur. » Le miroir me montre la preuve manifeste. « Qad ja'akum burhanun » — une preuve vous est venue. La révélation est la preuve.`,
  reflection: `Le Coran est la preuve lumineuse envoyée par Allah. Il guide ceux qui cherchent la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nasu qad ja'akum burhanun min rabbikum » — ô hommes ! Une preuve vous est venue de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais cette preuve ? Le Coran est-il ma lumière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La preuve demande une réponse. La lumière demande d'être suivie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La preuve est pour tous. L'acceptation est personnelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la lumière entre dans la lumière." }
  ],
  munajat: `Ya Nur, Tu es la Lumière. La preuve est venue. Fais que je la reconnaisse et que je la suive. Illumine mon chemin.`
};

MIROIR["4:175"] = {
  reference: "4:175",
  theme: ["foi", "récompense", "guidance"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Hadi"],
  mirrorVersion: `« Ceux qui croient en Allah et s'attachent à Lui. » Le miroir me montre l'attachement. « I'tasamu billah » — attachez-vous à Allah. L'attachement est la voie.`,
  reflection: `La foi et l'attachement à Allah mènent à Sa miséricorde et Sa guidance. L'attachement est la clé de la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma alladhina amanu billahi wa i'tasamu bihi » — quant à ceux qui croient en Allah et s'attachent à Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je m'attache ? À Allah ou aux créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attachement à Allah est la seule sécurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout s'attache à quelque chose. Seul Allah est digne d'attachement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache à Allah est attaché à l'Éternel." }
  ],
  munajat: `Ya Wali, je m'attache à Toi. Protège-moi par mon attachement. Ne permets pas que je m'attache à autre que Toi.`
};

MIROIR["4:176"] = {
  reference: "4:176",
  theme: ["héritage", "succession", "justice"],
  emotion: "Clarté, équité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-'Alim"],
  mirrorVersion: `« Ils te demandent une décision. Dis : Allah vous donne une décision sur les successions. » Le miroir me montre la justice détaillée. « Yastaftunaka » — ils te demandent une décision. La loi est précise.`,
  reflection: `Allah donne des lois précises sur l'héritage. La justice dans la succession protège les droits de tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yastaftunaka quli Allahu yuftikum fi al-kalalah » — ils te demandent une décision. Dis : Allah vous donne une décision sur les successions." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte les lois d'Allah sur l'héritage ? Suis-je équitable dans la succession ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La loi divine équilibre les droits humains." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'héritage est un test de justice et de soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la loi d'Allah sur l'héritage est béni." }
  ],
  munajat: `Ya Fattah, Tu es le Juge. Aide-moi à respecter Tes lois sur l'héritage. Donne-moi la justice dans la succession.`
};

// ==================== SURAH 56:27-62 (AL-WAQI'AH) - ADDITIONS ====================

MIROIR["56:27"] = {
  reference: "56:27",
  theme: ["jour dernier", "droite", "succès"],
  emotion: "Espoir, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Wali"],
  mirrorVersion: `« Et les gens de la droite, que sont les gens de la droite ? » Le miroir revient sur le second groupe. « Wa ashabu al-maymanati ma ashabu al-maymanah » — les gens de la droite, qui sont-ils ? Cette question répétée m'invite à l'introspection.`,
  reflection: `Les gens de la droite sont le groupe des croyants sauvés. Ils reçoivent leur livre en main droite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ashabu al-maymanati ma ashabu al-maymanah » — et les gens de la droite, que sont les gens de la droite ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi eux ? Qu'est-ce qui me distingue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droite est le résultat de la droiture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La droite est le côté de l'honneur dans toutes les cultures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre à droite dans ce monde reçoit à droite dans l'autre." }
  ],
  munajat: `Ya Mu'min, fais-moi parmi les gens de la droite. Donne-moi mon livre en main droite. Honore-moi par le succès.`
};

MIROIR["56:28"] = {
  reference: "56:28",
  theme: ["paradis", "lotus", "ombre"],
  emotion: "Sérénité, fraîcheur",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Ar-Rahim"],
  mirrorVersion: `« Parmi des lotus sans épines. » Le miroir me montre l'environnement du Paradis. « Fi sidrin makhdud » — parmi des lotus sans épines. La beauté sans danger.`,
  reflection: `Les lotus du Paradis n'ont pas d'épines. La beauté y est sans danger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi sidrin makhdud » — parmi des lotus sans épines." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle beauté je cherche ? Est-ce que je préfère la beauté sans danger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les épines d'ici-bas disparaissent là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Au Paradis, la beauté est pure, sans mélange de mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui supporte les épines ici jouit des fleurs là-bas." }
  ],
  munajat: `Ya Karim, Tu offres la beauté sans épines. Donne-moi d'y accéder. Fais que je supporte les épines d'ici pour les fleurs de là-bas.`
};

MIROIR["56:29"] = {
  reference: "56:29",
  theme: ["paradis", "bananiers", "abondance"],
  emotion: "Abondance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Et des bananiers aux régimes bien fournis. » Le miroir me montre l'abondance. « Wa talhin mandud » — et des bananiers chargés de fruits. L'abondance est visible.`,
  reflection: `Les bananiers du Paradis sont chargés de fruits. L'abondance y est visible et accessible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa talhin mandud » — et des bananiers aux régimes bien fournis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'imagine l'abondance du Paradis ? Est-ce que j'en ai faim ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faim d'ici-bas prépare la satiété de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'abondance du Paradis reflète la générosité du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne ici reçoit au-delà de là-bas." }
  ],
  munajat: `Ya Razzaq, Tu offres l'abondance. Donne-moi d'y accéder. Fais que je sois généreux ici pour recevoir là-bas.`
};

MIROIR["56:30"] = {
  reference: "56:30",
  theme: ["paradis", "ombre", "fraîcheur"],
  emotion: "Fraîcheur, confort",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Muhaymin"],
  mirrorVersion: `« Dans une ombre étendue. » Le miroir me montre le confort. « Wa zillin mamdud » — dans une ombre étendue. Le frais est perpétuel.`,
  reflection: `L'ombre du Paradis est étendue et perpétuelle. La fraîcheur y est éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa zillin mamdud » — dans une ombre étendue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où je cherche l'ombre ? Est-ce que je cherche l'ombre du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ombre d'Allah au Jour dernier vient de l'ombre qu'on a cherchée ici." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ombre est le refuge du voyageur. Le Paradis est le refuge éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche l'ombre d'Allah maintenant la trouve éternellement." }
  ],
  munajat: `Ya Salam, Tu offres l'ombre étendue. Donne-moi de m'y reposer. Fais que je cherche Ton ombre maintenant.`
};

MIROIR["56:31"] = {
  reference: "56:31",
  theme: ["paradis", "eau", "abondance"],
  emotion: "Fraîcheur, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'dhib", "Ar-Razzaq"],
  mirrorVersion: `« Dans de l'eau qui coule. » Le miroir me montre l'eau vive. « Wa ma'in mas-kub » — et de l'eau qui coule. L'eau est abondante et fraîche.`,
  reflection: `L'eau du Paradis coule perpétuellement. Elle est fraîche et pure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma'in mas-kub » — dans de l'eau qui coule." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai soif de l'eau du Paradis ? Est-ce que je la désire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La soif d'ici-bas prépare la satisfaction de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau est la source de la vie. Au Paradis, elle est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a soif d'Allah trouve l'eau éternelle." }
  ],
  munajat: `Ya Mu'dhib, Tu offres l'eau qui coule. Donne-moi d'y boire. Étanche ma soif éternelle.`
};

MIROIR["56:32"] = {
  reference: "56:32",
  theme: ["paradis", "fruits", "abondance"],
  emotion: "Satisfaction, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Parmi des fruits abondants. » Le miroir me montre la variété. « Wa fakihatin kathirah » — parmi des fruits nombreux. L'abondance est variée.`,
  reflection: `Les fruits du Paradis sont nombreux et variés. La satisfaction y est totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fakihatin kathirah » — parmi des fruits abondants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je désire comme fruit ? Est-ce que je désire les fruits du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La faim d'ici-bas prépare la satiété de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les fruits sont les dons de la terre. Au Paradis, ils sont parfaits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui partage ses fruits ici mange des fruits parfaits là-bas." }
  ],
  munajat: `Ya Razzaq, Tu offres les fruits abondants. Donne-moi d'y goûter. Fais que je partage mes fruits ici.`
};

MIROIR["56:33"] = {
  reference: "56:33",
  theme: ["paradis", "fruits", "éternité"],
  emotion: "Émerveillement, continuité",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Karim"],
  mirrorVersion: `« Ni épuisés, ni interdits. » Le miroir me montre la disponibilité perpétuelle. « La maq-tu'ah wa la mamnu'ah » — ni coupées, ni interdites. Tout est disponible.`,
  reflection: `Les fruits du Paradis ne s'épuisent jamais et ne sont jamais interdits. L'accès y est perpétuel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La maq-tu'ah wa la mamnu'ah » — ni épuisés, ni interdits." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui m'est interdit ici ? Comment je supporte la restriction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction d'ici prépare la liberté de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Au Paradis, rien n'est épuisé. Tout est renouvelé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les limites d'ici jouit de l'illimité là-bas." }
  ],
  munajat: `Ya Baqi, Tu offres l'éternel. Donne-moi d'accéder à l'abondance perpétuelle. Fais que j'accepte les limites d'ici.`
};

MIROIR["56:34"] = {
  reference: "56:34",
  theme: ["paradis", "tapis", "élévation"],
  emotion: "Confort, noblesse",
  difficulty: "débutant",
  relatedNames: ["Al-Muta'ali", "Al-Karim"],
  mirrorVersion: `« Et sur des lits élevés. » Le miroir me montre l'élévation. « Wa furushin marfu'ah » — et des lits élevés. La position est noble.`,
  reflection: `Les lits du Paradis sont élevés, symbolisant la noblesse et l'honneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa furushin marfu'ah » — et sur des lits élevés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle position je cherche ? Est-ce que je cherche l'élévation par Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité d'ici prépare l'élévation de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'élévation est le résultat de la soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'abaisse pour Allah est élevé par Lui." }
  ],
  munajat: `Ya Muta'ali, Tu élèves les humbles. Élève-moi par mon abaissement. Donne-moi la noblesse du Paradis.`
};

MIROIR["56:35"] = {
  reference: "56:35",
  theme: ["paradis", "création", "femmes"],
  emotion: "Émerveillement, perfection",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Nous les avons créées d'une création parfaite. » Le miroir me montre la création divine. « Inna ansha'nahunna insha'an » — Nous les avons créées d'une création nouvelle.`,
  reflection: `Les houris du Paradis sont une création parfaite et nouvelle d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ansha'nahunna insha'an » — Nous les avons créées d'une création parfaite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la perfection de la création divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nouvelle création répond à l'ancienne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création du Paradis dépasse celle de ce monde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui admire la création maintenant verra la création parfaite." }
  ],
  munajat: `Ya Khaliq, Tu crées la perfection. Fais que j'admire Ta création. Donne-moi de voir la création parfaite du Paradis.`
};

MIROIR["56:36"] = {
  reference: "56:36",
  theme: ["paradis", "vierges", "pureté"],
  emotion: "Pureté, innocence",
  difficulty: "débutant",
  relatedNames: ["Al-Quddus", "Al-Tahir"],
  mirrorVersion: `« Et Nous en avons fait des vierges. » Le miroir me montre la pureté originelle. « Fa-ja'alnahunna abkaran » — et Nous les avons faites vierges. La pureté est préservée.`,
  reflection: `Les houris du Paradis sont vierges, préservées dans leur pureté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ja'alnahunna abkaran » — et Nous en avons fait des vierges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préserve ma pureté ? Mon cœur est-il vierge de souillures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté préservée ici devient la pureté parfaite là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté est l'état naturel de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son cœur pur reçoit la compagnie pure." }
  ],
  munajat: `Ya Quddus, Tu es la Pureté. Préserve mon cœur pur. Donne-moi d'accéder à la pureté parfaite.`
};

MIROIR["56:37"] = {
  reference: "56:37",
  theme: ["paradis", "amour", "affection"],
  emotion: "Amour, tendresse",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Muhibb"],
  mirrorVersion: `« Aimantes et d'un même âge. » Le miroir me montre l'amour parfait. « 'Uruban atraban » — aimantes, de même âge. L'amour y est mutuel et parfait.`,
  reflection: `Les houris du Paradis sont aimantes et de même âge que leurs époux. L'amour y est parfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Uruban atraban » — aimantes et d'un même âge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aime vraiment ? Est-ce que je suis aimant envers Allah et les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour donné ici devient l'amour reçu là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amour est la langue du Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aime pour Allah reçoit l'amour parfait." }
  ],
  munajat: `Ya Wadud, Tu es l'Amour. Apprends-moi à aimer. Donne-moi l'amour parfait du Paradis.`
};

MIROIR["56:38"] = {
  reference: "56:38",
  theme: ["récompense", "droite", "mérite"],
  emotion: "Espoir, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Wali"],
  mirrorVersion: `« Pour les gens de la droite. » Le miroir me montre la destination. « Li-ashabi al-yamin » — pour les gens de la droite. La récompense est destinée.`,
  reflection: `Ces délices sont pour les gens de la droite. La récompense suit l'œuvre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-ashabi al-yamin » — pour les gens de la droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille pour être parmi les gens de la droite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La droite est le résultat de la droiture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense est proportionnelle à l'effort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre à droite reçoit la droite." }
  ],
  munajat: `Ya Shakur, Tu récompenses les œuvres. Fais-moi parmi les gens de la droite. Donne-moi la récompense promise.`
};

MIROIR["56:39"] = {
  reference: "56:39",
  theme: ["paradis", "communautés", "premiers"],
  emotion: "Appartenance, continuité",
  difficulty: "débutant",
  relatedNames: ["Al-Awwal", "Al-Jami'"],
  mirrorVersion: `« Une multitude parmi les premiers. » Le miroir me montre la multitude. « Thullatun mina al-awwalin » — un grand nombre des anciens.`,
  reflection: `Les gens de la droite incluent une multitude des anciens croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thullatun mina al-awwalin » — une multitude parmi les premiers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je marche avec la multitude des croyants ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La multitude des premiers invite la multitude des derniers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La communauté des croyants traverse les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejoint la multitude rejoint la récompense." }
  ],
  munajat: `Ya Awwal, Tu as commencé la foi. Fais que je rejoigne la multitude des croyants. Donne-moi d'être avec les premiers.`
};

MIROIR["56:40"] = {
  reference: "56:40",
  theme: ["paradis", "derniers", "continuité"],
  emotion: "Espoir, égalité",
  difficulty: "débutant",
  relatedNames: ["Al-Akhir", "Al-'Adl"],
  mirrorVersion: `« Et une multitude parmi les derniers. » Le miroir me montre l'égalité. « Wa thullatun mina al-akhirin » — et un grand nombre des derniers. La récompense est accessible.`,
  reflection: `Les gens de la droite incluent aussi une multitude des derniers croyants. La porte est ouverte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa thullatun mina al-akhirin » — et une multitude parmi les derniers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de cette multitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les derniers ne sont pas moins que les premiers." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse tous les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui arrive tard mais sincèrement est accueilli." }
  ],
  munajat: `Ya Akhir, Tu es le Dernier. Fais que je sois parmi la multitude des derniers. Accueille-moi dans Ta miséricorde.`
};

MIROIR["56:41"] = {
  reference: "56:41",
  theme: ["jour dernier", "gauche", "avertissement"],
  emotion: "Crainte, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Khafid", "Al-Mudhill"],
  mirrorVersion: `« Et les gens de la gauche, que sont les gens de la gauche ? » Le miroir revient sur le troisième groupe. « Wa ashabu al-mash'amati ma ashabu al-mash'amah » — les gens de la gauche, qui sont-ils ? L'avertissement est clair.`,
  reflection: `Les gens de la gauche sont le groupe des perdants. Ils reçoivent leur livre en main gauche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ashabu al-mash'amati ma ashabu al-mash'amah » — et les gens de la gauche, que sont les gens de la gauche ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui pourrait me placer parmi eux ? Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gauche est le résultat de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gauche est le côté de la disgrâce." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la gauche l'évite par la crainte même." }
  ],
  munajat: `Ya Khafid, préserve-moi des gens de la gauche. Ne me laisse pas recevoir mon livre à gauche. Protège-moi de l'égarement.`
};

MIROIR["56:42"] = {
  reference: "56:42",
  theme: ["enfer", "vent", "chaleur"],
  emotion: "Crainte, souffrance",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Jabbar"],
  mirrorVersion: `« Dans un vent brûlant et de l'eau bouillante. » Le miroir me montre le châtiment. « Fi samumin wa hamim » — dans un vent brûlant et de l'eau bouillante. La souffrance est décrite.`,
  reflection: `Le châtiment des gens de la gauche inclut le vent brûlant et l'eau bouillante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi samumin wa hamim » — dans un vent brûlant et de l'eau bouillante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je supporte la chaleur d'ici ? Imagine la chaleur de là-bas." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La chaleur d'ici rappelle la chaleur de l'enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chaleur et le froid sont des signes du châtiment et de la miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se rappelle le châtiment l'évite par le rappel même." }
  ],
  munajat: `Ya Qahhar, préserve-moi du châtiment. Ne me laisse pas goûter au vent brûlant ni à l'eau bouillante. Protège-moi de l'enfer.`
};

MIROIR["56:43"] = {
  reference: "56:43",
  theme: ["enfer", "ombre", "fumée"],
  emotion: "Ténèbres, souffrance",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhill", "Al-Muntaqim"],
  mirrorVersion: `« Et de l'ombre d'une fumée noire. » Le miroir me montre les ténèbres. « Wa zillin min yahmumin » — et l'ombre d'une fumée noire. L'ombre elle-même est châtiment.`,
  reflection: `L'ombre de l'enfer n'est pas fraîche — elle est fumée noire et suffocante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa zillin min yahmumin » — et de l'ombre d'une fumée noire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle ombre je cherche ? Est-ce que je fuis les ténèbres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ombre de l'enfer est le contraire de l'ombre du Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fumée et les ténèbres sont les signes de la colère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit les ténèbres ici échappe aux ténèbres de là-bas." }
  ],
  munajat: `Ya Nafi', préserve-moi des ténèbres. Ne me laisse pas dans l'ombre de la fumée. Donne-moi la lumière du Paradis.`
};

MIROIR["56:44"] = {
  reference: "56:44",
  theme: ["enfer", "froid", "inconfort"],
  emotion: "Inconfort, misère",
  difficulty: "débutant",
  relatedNames: ["Al-Mudhill", "Al-Mumit"],
  mirrorVersion: `« Ni fraîche, ni agréable. » Le miroir me montre l'absence de réconfort. « La baridin wa la karim » — ni fraîche, ni agréable. Rien n'est bon.`,
  reflection: `L'ombre de l'enfer n'offre aucun réconfort. Ni fraîcheur, ni bienvenue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La baridin wa la karim » — ni fraîche, ni agréable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me réconforte ? Est-ce que j'apprécie le réconfort d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence de réconfort est le pire châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le réconfort est une miséricorde. Son absence est un châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne reconnaît pas le réconfort ici le perd là-bas." }
  ],
  munajat: `Ya Karim, Tu es le Généreux. Ne me prive pas de Ton réconfort. Donne-moi la fraîcheur et l'agrément du Paradis.`
};

MIROIR["56:45"] = {
  reference: "56:45",
  theme: ["enfer", "rappel", "avertissement"],
  emotion: "Regret, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Hakam"],
  mirrorVersion: `« Ils vivaient auparavant dans le faste. » Le miroir me montre le contraste. « Kanu qabla dhalika mutrafin » — ils étaient avant cela dans l'aisance. Le rappel est amer.`,
  reflection: `Les gens de la gauche vivaient dans l'aisance et le faste avant leur chute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kanu qabla dhalika mutrafin » — ils vivaient auparavant dans le faste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je dans le faste ? Est-ce que j'en profite pour le bien ou pour l'oubli ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le faste d'ici peut précéder la misère de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aisance est un test. Le faste peut être un voile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise le faste pour le bien l'éternise." }
  ],
  munajat: `Ya Hakam, Tu es le Juge. Si je suis dans l'aisance, ne la laisse pas m'égarer. Fais que je l'utilise pour Toi.`
};

MIROIR["56:46"] = {
  reference: "56:46",
  theme: ["enfer", "péché", "obstination"],
  emotion: "Regret, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-'Alim"],
  mirrorVersion: `« Et ils persistaient dans le grand péché. » Le miroir me montre l'obstination. « Wa kanu yusirruna 'ala al-hinthi al-'azim » — et ils persistaient dans le péché énorme.`,
  reflection: `Les gens de la gauche persistaient dans les grands péchés sans repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kanu yusirruna 'ala al-hinthi al-'azim » — et ils persistaient dans le grand péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quoi je persiste ? Y a-t-il un péché que je refuse d'abandonner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La persistance dans le mal mène à la persistance dans le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le péché persistant endurcit le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne le péché avant la mort échappe à la persistance du châtiment." }
  ],
  munajat: `Ya Tawwab, Tu aimes le repentir. Donne-moi la force d'abandonner mes péchés. Ne me laisse pas persister dans le mal.`
};

MIROIR["56:47"] = {
  reference: "56:47",
  theme: ["mécréance", "doute", "négation"],
  emotion: "Égarement, erreur",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Haqq"],
  mirrorVersion: `« Et ils disaient : Quand nous mourrons et serons poussière et ossements, serons-nous ressuscités ? » Le miroir me montre le doute. « Wa kanu yaquluna a-idha mitna wa kunna turaban wa 'izaman a-inna la-mab'uthun » — serons-nous vraiment ressuscités ?`,
  reflection: `Les mécréants niaient la résurrection. Leur doute était leur égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kanu yaquluna a-idhna mitna wa kunna turaban wa 'izaman a-inna la-mab'uthun » — et ils disaient : quand nous mourrons et serons poussière et ossements, serons-nous ressuscités ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment en la résurrection ? Ou est-ce que j'ai des doutes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le doute sur la résurrection mène au doute sur toute la religion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est la promesse d'Allah. Sa certitude fait la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la résurrection vit pour elle." }
  ],
  munajat: `Ya Hadi, guide mon cœur vers la certitude. Confirme ma foi en la résurrection. Ne me laisse pas douter de Ta promesse.`
};

MIROIR["56:48"] = {
  reference: "56:48",
  theme: ["résurrection", "ancêtres", "questionnement"],
  emotion: "Doute, dérision",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Haqq"],
  mirrorVersion: `« Et nos anciens ancêtres ? » Le miroir me montre la dérision. « A-wa ala'una al-awwalun » — et nos anciens ancêtres aussi ? La question était moqueuse.`,
  reflection: `Les mécréants se moquaient de la résurrection, demandant si même les anciens seraient ressuscités.`,
