  difficulty: "débutant",
  relatedNames: ["Al-Akl", "Al-Tamattu'"],
  mirrorVersion: `« Mangez et jouissez un peu. » Le miroir me montre la brièveté de ce monde. « Kulu wa tamatta'u qalilan » — mangez et jouissez un peu. La brièveté. Le miroir m'avertit : ce monde est court.`,
  reflection: `Un peu de jouissance. Ce monde est temporaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu wa tamatta'u qalilan » — mangez et jouissez un peu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je jouis un peu ? Ou est-ce que je vis pour l'éternité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vision de l'éternité dépasse le peu de ce monde." },
