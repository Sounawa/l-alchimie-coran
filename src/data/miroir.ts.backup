MIROIR["78:12"] = {
  reference: "78:12",
  theme: ["cieux", "firmament", "protection"],
  emotion: "Méditation, gratitude",
  difficulty: "débutant",
  relatedNames: ["As-Samawat", "Al-Bina'"],
  mirrorVersion: `« Et construit au-dessus de vous sept cieux solides. » Le miroir me montre la grandeur de la création. « Wa banayna fawqakum sab'an shidadan » — et construit au-dessus de vous sept cieux solides. La grandeur. Le miroir m'enseigne : les cieux sont une construction divine solide.`,
  reflection: `Les sept cieux solides. La construction divine est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa banayna fawqakum sab'an shidadan » — et construit au-dessus de vous sept cieux solides." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les cieux sont au-dessus de moi. Suis-je conscient de cette grandeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la grandeur céleste mène à l'humilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sept cieux couvrent tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les cieux reconnaît le Créateur." }
  ],
  munajat: `Ya Rabb, je contemple les cieux et je Te reconnais comme Créateur. Donne-moi l'humilité devant Ta grandeur.`
};

