    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en tout ? Ou est-ce que je fais des distinctions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi complète est la foi sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les messagers viennent d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en tout a la foi complète." }
  ],
  munajat: `Ya Kitab, je crois en tout. Ne permets pas que je fasse des distinctions. Donne-moi la foi complète.`
};

