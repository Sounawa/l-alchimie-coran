  ],
  munajat: `Ya Karim, prépare pour moi un bon accueil. Ne me laisse pas recevoir l'accueil des perdants. Donne-moi l'accueil des rapprochés.`
};

MIROIR["56:57"] = {
  reference: "56:57",
  theme: ["création", "origine", "puissance"],
  emotion: "Awe, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« C'est Nous qui vous avons créés. Pourquoi ne croiriez-vous pas ? » Le miroir m'interroge sur la création. « Nahnu khalaqnakum falawla tusaddiqun » — C'est Nous qui vous avons créés. Pourquoi ne croiriez-vous pas ?`,
