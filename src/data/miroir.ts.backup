    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je m'éloigne de tout ce qui mène à l'abomination ? Ou est-ce que je m'en rapproche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éloignement préserve la pureté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté est la base de la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'éloigne de l'abomination préserve son honneur." }
  ],
  munajat: `Ya Rabb, je m'éloigne de toute abomination. Ne permets pas que je m'en rapproche. Préserve ma pureté et mon honneur.`
};

MIROIR["17:37"] = {
