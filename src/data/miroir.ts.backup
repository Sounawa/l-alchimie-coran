  difficulty: "intermédiaire",
  relatedNames: ["Al-Qasirat", "At-Tarf"],
  mirrorVersion: `« Auprès d'eux, des compagnes au regard modéré, de même âge. » Le miroir me montre la compagnie pure. Des compagnes qui préservent leur regard, de même âge — pureté et harmonie. Le miroir m'enseigne : la compagnie du Paradis est pure.`,
  reflection: `La compagnie pure élève. La pureté du regard reflète la pureté du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'indahum qasiratu at-tarfi atrab » — auprès d'eux, des compagnes au regard modéré, de même âge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle compagnie garde mon regard pur ? La compagnie d'ici-bas influence l'au-delà." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté du regard ici prépare la compagnie pure de là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La pureté est universellement recherchée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compagnie du Paradis est le reflet de la pureté du cœur." }
  ],
  munajat: `Ya Rabb, purifie mon regard et mon cœur. Donne-moi une compagnie qui m'élève vers Toi.`
};

