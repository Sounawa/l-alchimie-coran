  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mannan"],
  mirrorVersion: `« Lequel des bienfaits de votre Seigneur nierez-vous ? » Le miroir répète la question. « Fabi-ayyi ala'i rabbikuma tukadhdhiban » — après l'imploration universelle. Le miroir m'invite à reconnaître la réponse aux demandes.`,
  reflection: `La capacité d'implorer et d'être exaucé est un bienfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabi-ayyi ala'i rabbikuma tukadhdhiban » — Lequel des bienfaits de votre Seigneur nierez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La possibilité d'invoquer est-elle un bienfait que je reconnais ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "L'invitation à invoquer est un bienfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La relation d'invocation est un privilège des créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque avec reconnaissance reçoit plus." }
  ],
  munajat: `Ya Mannan, l'invitation à T'invoquer est un bienfait. Fais que je profite de cette invitation. Ne permets pas que je me taise.`
};

MIROIR["55:31"] = {
  reference: "55:31",
  theme: ["attention", "charge", "imminence"],
  emotion: "Sérieux, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kafi", "Al-Wali"],
  mirrorVersion: `« Nous allons bientôt Nous occuper de vous, ô vous les deux pesants. » Le miroir me montre l'attention divine. « Sa-nafriqu lakum ayyuha al-thaqalan » — Nous allons Nous occuper de vous. L'attention est imminente. Le miroir m'invite à me préparer.`,
  reflection: `Allah va s'occuper des humains et des djinns. Le compte approche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sa-nafriqu lakum ayyuha al-thaqalan » — Nous allons bientôt Nous occuper de vous, ô vous les deux pesants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour l'attention divine ? Qu'est-ce que je veux qu'Il trouve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attention divine peut être miséricorde ou jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le compte approche pour toutes les créatures." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare accueille l'attention avec joie." }
  ],
  munajat: `Ya Kafi, Tu vas T'occuper de moi. Prépare-moi pour ce moment. Fais que Ton attention soit miséricorde, pas jugement.`
};

MIROIR["55:32"] = {
