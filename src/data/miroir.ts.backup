    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'excuse et l'avertissement sont des miséricordes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rappel est envoyé pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le rappel reçoit la miséricorde." }
  ],
  munajat: `Ya Rabb, j'accepte Ton rappel. Soit excuse soit avertissement, je l'accepte.`
};

MIROIR["77:7"] = {
  reference: "77:7",
