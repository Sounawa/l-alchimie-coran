    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite le guet-apens de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est une réalité universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi évite le guet-apens." }
  ],
  munajat: `Ya Rabb, je veux éviter l'Enfer. Sauve-moi du guet-apens. Donne-moi la foi qui protège.`
};

MIROIR["78:22"] = {
