  theme: ["compte", "facilité", "retour"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Yasir"],
  mirrorVersion: `« Il subira un compte facile. » Le miroir promet : « Faya-siru hisaban yasira » — il subira un compte facile. Le compte facile est une miséricorde pour les croyants. Le miroir m'enseigne : la facilité du compte dépend de la piété ici-bas.`,
  reflection: `Le compte facile est une miséricorde. La facilité dépend de la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Faya-siru hisaban yasira » — il subira un compte facile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon compte sera-t-il facile ? La piété maintenant facilite le compte plus tard." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le compte facile répond à la vie facile dans l'obéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La facilité et la difficulté du compte sont proportionnées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le compte facile est le premier cadeau du Paradis." }
  ],
  munajat: `Ya Rabb, fais que mon compte soit facile. La facilité vient de la piété. Je veux un compte simple.`
};

MIROIR["84:9"] = {
  reference: "84:9",
  theme: ["retour", "joie", "famille"],
  emotion: "Joie, célébration",
  difficulty: "débutant",
  relatedNames: ["Al-Inqilab", "Al-Ahl"],
  mirrorVersion: `« Et il retournera joyeux vers les siens. » Le miroir décrit la joie : « Wa yanqalibu ila ahlihi masrura » — et il retournera joyeux vers les siens. Après le compte facile, la réunion avec les siens dans la joie. Le miroir m'enseigne : le Paradis inclut les retrouvailles.`,
  reflection: `Le Paradis inclut les retrouvailles joyeuses avec les siens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yanqalibu ila ahlihi masrura » — et il retournera joyeux vers les siens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont « les miens » que je retrouverai ? La famille au Paradis est une joie." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le retour joyeux répond aux séparations de ce monde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis rassemble les vertueux avec leurs proches vertueux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La joie du retour inclut la joie de la réunion." }
  ],
  munajat: `Ya Rabb, fais que je retourne joyeux vers les miens. Les retrouvailles au Paradis sont mon espoir. Réunis-moi avec les miens.`
};

MIROIR["84:10"] = {
  reference: "84:10",
  theme: ["livre", "dos", "honte"],
  emotion: "Crainte, honte",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Wara'"],
  mirrorVersion: `« Et quant à celui qui recevra son livre derrière son dos. » Le miroir décrit le second cas : « Wa amma man utiya kitabahu wara'a zahrih » — et quant à celui qui recevra son livre derrière son dos. Recevoir le livre derrière le dos est le signe de l'échec et de la honte. Le miroir m'avertit : le livre derrière le dos signifie un compte difficile.`,
  reflection: `Recevoir le livre derrière le dos est le signe de l'échec. La honte accompagne ce mauvais sort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma man utiya kitabahu wara'a zahrih » — et quant à celui qui recevra son livre derrière son dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon livre sera-t-il derrière mon dos ? La honte de ce sort m'avertit." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Derrière le dos est l'opposé de la main droite — honte contre honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jugement distingue nettement — la position du livre révèle tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le livre derrière le dos commence la honte éternelle." }
  ],
  munajat: `Ya Rabb, ne mets pas mon livre derrière mon dos. La honte de ce sort me terrifie. Je veux l'honneur de la main droite.`
};

MIROIR["84:11"] = {
  reference: "84:11",
  theme: ["perte", "destruction", "appel"],
  emotion: "Désespoir, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Halak", "Al-Thubur"],
  mirrorVersion: `« Il invoquera la perte sur lui-même. » Le miroir décrit le désespoir : « Fayada'u thawbahu » — il invoquera la perte, la destruction sur lui-même. Le désespoir du damné l'amène à souhaiter sa propre fin. Le miroir m'avertit : le regret du damné est extrême.`,
  reflection: `Le regret du damné est extrême. Il souhaite sa propre destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fayada'u thawbahu » — il invoquera la perte sur lui-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le regret du damné me met en garde. Je ne veux pas invoquer ma perte." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Invoquer sa propre perte est le comble du désespoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le damné préférerait ne jamais avoir existé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La perte invoquée reflète la perte éternelle." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'invoque ma perte. Le désespoir du damné m'effraie. Je veux l'espoir du croyant.`
};

MIROIR["84:12"] = {
  reference: "84:12",
  theme: ["feu", "brûlement", "entrée"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Su'ir"],
  mirrorVersion: `« Et il brûlera dans un feu ardent. » Le miroir précise le sort : « Wa yasla jahim » — et il brûlera dans un feu ardent, la Fournaise. Après la honte vient le châtiment. Le miroir m'avertit : le livre derrière le dos mène au feu.`,
  reflection: `Le livre derrière le dos mène au feu. La honte précède le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yasla jahim » — et il brûlera dans un feu ardent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le feu attend celui qui reçoit son livre derrière le dos. Je ne veux pas brûler." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le brûlement suit la honte — le châtiment complète le déshonneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu de la Fournaise est la conséquence du rejet de la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le feu brûle le corps et l'âme — le châtiment est complet." }
  ],
  munajat: `Ya Rabb, protège-moi du feu ardent. La Fournaise attend les damnés. Je ne veux pas brûler.`
};

MIROIR["84:13"] = {
  reference: "84:13",
  theme: ["joie", "famille", "ici-bas"],
  emotion: "Contraste, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Farah", "Al-Ahl"],
  mirrorVersion: `« Il était joyeux parmi les siens. » Le miroir rappelle la situation d'ici-bas : « Inna kana fi ahlihi masrura » — il était joyeux parmi les siens. Dans ce monde, le damné était joyeux avec sa famille. Le contraste est cruel — la joie d'ici-bas devient le regret de l'au-delà.`,
  reflection: `La joie d'ici-bas sans Allah devient le regret de l'au-delà. Le contraste est cruel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna kana fi ahlihi masrura » — il était joyeux parmi les siens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma joie ici-bas est-elle fondée sur Allah ? Sinon, elle sera regret." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie sans Allah est une illusion — elle devient tristesse éternelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les apparences de ce monde seront inversées dans l'autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie joie est celle qui inclut Allah." }
  ],
  munajat: `Ya Rabb, ma joie ici-bas doit inclure Toi. Je ne veux pas que ma joie devienne regret. Tu es ma vraie joie.`
};

MIROIR["84:14"] = {
  reference: "84:14",
  theme: ["retour", "pensée", "illusion"],
  emotion: "Réalité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Zann", "Al-Ruj'"],
  mirrorVersion: `« Il pensait ne jamais retourner à Allah. » Le miroir révèle l'illusion : « Zanna an lan yahura » — il pensait ne jamais retourner à Allah. L'illusion de l'éternité ici-bas aveugle le damné. Le miroir m'avertit : penser ne jamais retourner est une erreur fatale.`,
  reflection: `Penser ne jamais retourner à Allah est une erreur fatale. Le retour est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Zanna an lan yahura » — il pensait ne jamais retourner à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si je ne retournerai jamais ? Le retour est certain." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illusion de l'éternité ici-bas est la plus grande illusion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour à Allah est la destinée de toute âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Vivre avec la conscience du retour transforme chaque action." }
  ],
  munajat: `Ya Rabb, je sais que je retournerai à Toi. Fais que je vive avec cette conscience. L'illusion de l'éternité ne m'aveugle pas.`
};

MIROIR["84:15"] = {
  reference: "84:15",
  theme: ["vision", "Seigneur", "fin"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ru'ya", "Al-Rabb"],
  mirrorVersion: `« Mais si ! Son Seigneur le voyait parfaitement. » Le miroir corrige l'illusion : « Balla inna rabbahu kana bihi basira » — mais si ! Son Seigneur le voyait parfaitement. Allah voit tout — même quand l'homme pense être caché. Le miroir m'enseigne : la vision d'Allah est constante.`,
  reflection: `Allah voit tout parfaitement. Rien n'est caché à Sa vue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Balla inna rabbahu kana bihu basira » — mais si ! Son Seigneur le voyait parfaitement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Allah me voit parfaitement. Rien de ce que je fais ne Lui échappe." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illusion d'être caché est démentie par la vision parfaite d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vision d'Allah embrasse tout — le visible et l'invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de Sa vision transforme chaque instant." }
  ],
  munajat: `Ya Basir, Tu me vois parfaitement. Rien ne T'est caché. Fais que je vive sous Ton regard avec conscience.`
};

MIROIR["84:16"] = {
  reference: "84:16",
  theme: ["serment", "crépuscule", "vérité"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Aymam", "Al-Shafaq"],
  mirrorVersion: `« Non ! Je jure par le crépuscule. » Le miroir introduit un serment : « Fa-la uqsimu bil-shafaq » — non ! Je jure par le crépuscule. Le crépuscule — ce moment entre le jour et la nuit — est un signe d'Allah. Le miroir m'enseigne : Allah jure par Sa création pour confirmer la vérité.`,
  reflection: `Allah jure par le crépuscule — ce moment de transition est un signe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la uqsimu bil-shafaq » — non ! Je jure par le crépuscule." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remarque le crépuscule ? Ce moment de transition est un signe." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le crépuscule — entre lumière et ténèbres — symbolise la transition de la vie à l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le crépuscule quotidien est un rappel de la transition finale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le serment par le crépuscule confirme la vérité qui suit." }
  ],
  munajat: `Ya Rabb, le crépuscule est Ton signe. Fais que je voie la vérité dans chaque transition. Le serment confirme Ta parole.`
};

MIROIR["84:17"] = {
  reference: "84:17",
  theme: ["serment", "nuit", "assemblée"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Wasq"],
  mirrorVersion: `« Et par la nuit et ce qu'elle rassemble. » Le miroir continue : « Wa al-layli wa ma wasaq » — et par la nuit et ce qu'elle rassemble. La nuit rassemble — les étoiles, les rêves, le repos. Le miroir m'enseigne : chaque élément de la création témoigne.`,
  reflection: `La nuit rassemble les éléments de la création. Tout témoigne d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-layli wa ma wasaq » — et par la nuit et ce qu'elle rassemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que la nuit rassemble pour moi ? Le repos, les rêves, la prière nocturne." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit rassemble ce que le jour disperse — le contraste est signifiant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est le temps du rassemblement — des étoiles, des pensées, des secrets." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rassemblement de la nuit préfigure le rassemblement du Jour." }
  ],
  munajat: `Ya Rabb, la nuit rassemble tant de signes. Fais que je voie ce qu'elle contient. La nuit est Ton cadeau.`
};

MIROIR["84:18"] = {
  reference: "84:18",
  theme: ["serment", "lune", "pleine"],
  emotion: "Révérence, beauté",
  difficulty: "débutant",
  relatedNames: ["Al-Qamar", "Al-Ittasaq"],
  mirrorVersion: `« Et par la lune quand elle devient pleine. » Le miroir ajoute : « Wa al-qamari idha ittasaq » — et par la lune quand elle devient pleine, rassemblée. La pleine lune est un signe de complétude. Le miroir m'enseigne : la beauté de la création témoigne du Créateur.`,
  reflection: `La pleine lune est un signe de complétude. La beauté témoigne du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-qamari idha ittasaq » — et par la lune quand elle devient pleine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la beauté de la lune ? Elle témoigne de son Créateur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lune pleine symbolise la complétude — la perfection d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lune parcourt ses phases — la pleine lune est son apogée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La beauté de la lune reflète la beauté de Son Créateur." }
  ],
  munajat: `Ya Rabb, la pleine lune est Ta beauté. Fais que je voie Ton signe dans chaque phase. La lune témoigne de Toi.`
};

MIROIR["84:19"] = {
  reference: "84:19",
  theme: ["transition", "états", "voyage"],
  emotion: "Réalité, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Taraqi", "Al-Darajat"],
  mirrorVersion: `« Vous passerez de degré en degré. » Le miroir conclut les serments : « La-tarququn tabaqan 'an tabaq » — vous passerez de degré en degré. La vie est une ascension — de état en état. Le miroir m'enseigne : chaque moment est une transition vers le suivant.`,
  reflection: `La vie est une ascension de degré en degré. Chaque moment est une transition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-tarququn tabaqan 'an tabaq » — vous passerez de degré en degré." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon degré actuel ? Vers quel degré je me dirige ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Les degrés peuvent être ascendants ou descendants — le choix est dans les actions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier évolue de degré en degré — rien ne stagne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque degré est une opportunité — monter ou descendre." }
  ],
  munajat: `Ya Rabb, fais que je monte de degré en degré. Chaque moment est une transition. Je veux monter vers Toi.`
};

MIROIR["84:20"] = {
  reference: "84:20",
  theme: ["question", "foi", "refus"],
  emotion: "Interrogation, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Radd"],
  mirrorVersion: `« Qu'ont-ils à ne pas croire ? » Le miroir interroge : « Fa-ma lahum la yu'minun » — qu'ont-ils à ne pas croire ? Après tous les signes, pourquoi refuser ? Le miroir m'interroge : qu'est-ce qui m'empêche de croire complètement ?`,
  reflection: `Pourquoi refuser de croire après tous les signes ? Qu'est-ce qui m'empêche de croire complètement ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma lahum la yu'minun » — qu'ont-ils à ne pas croire ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma foi est-elle complète ? Ou est-ce que je refuse certains aspects ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus de croire n'a pas de raison valable — les signes sont clairs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier croit par sa soumission — seul l'homme peut refuser." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La question contient l'invitation — croyez, c'est la seule voie." }
  ],
  munajat: `Ya Rabb, je veux croire complètement. Il n'y a pas de raison de refuser. Les signes sont clairs. Ma foi est en Toi.`
};

MIROIR["84:21"] = {
  reference: "84:21",
  theme: ["coran", "prosternation", "refus"],
  emotion: "Questionnement, tristesse",
  difficulty: "débutant",
  relatedNames: ["Al-Quran", "Al-Sujud"],
  mirrorVersion: `« Et quand le Coran leur est récité, ils ne se prosternent pas. » Le miroir s'étonne : « Wa idha quri'a 'alayhimu al-qur'anu la yasjudun » — et quand le Coran leur est récité, ils ne se prosternent pas. La prosternation est la réponse naturelle à la Parole d'Allah. Le miroir m'interroge : ma réaction au Coran est-elle la prosternation ?`,
  reflection: `La prosternation est la réponse naturelle au Coran. Ma réaction est-elle l'adoration ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha quri'a 'alayhimu al-qur'anu la yasjudun » — et quand le Coran leur est récité, ils ne se prosternent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entends le Coran, est-ce que je me prosterne ? L'adoration devrait suivre l'écoute." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas se prosterner devant le Coran, c'est ne pas reconnaître sa grandeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se prosterne devant Allah — le Coran est Sa parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prosternation du cœur précède la prosternation du corps." }
  ],
  munajat: `Ya Rabb, quand j'entends Ton Coran, fais que je me prosterne. L'adoration devrait suivre l'écoute. Mon cœur se prosterne.`
};

MIROIR["84:22"] = {
  reference: "84:22",
  theme: ["mécréants", "croyance", "rejet"],
  emotion: "Réalité, diagnostic",
  difficulty: "débutant",
  relatedNames: ["Al-Kafirun", "Al-Tasdiq"],
  mirrorVersion: `« Mais ceux qui ont mécru traitent cela de mensonge. » Le miroir diagnostique : « Bal alladhina kafaru yukadhdhibun » — mais ceux qui ont mécru traitent cela de mensonge. Le rejet du Coran est le signe de la mécréance. Le miroir m'enseigne : la réaction au Coran révèle l'état du cœur.`,
  reflection: `La réaction au Coran révèle l'état du cœur. Le rejet est le signe de la mécréance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal alladhina kafaru yukadhdhibun » — mais ceux qui ont mécru traitent cela de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis au Coran ? Ma réaction révèle mon cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Traiter le Coran de mensonge, c'est se mentir à soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité du Coran reste — le rejet ne change rien." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le rejet du Coran est le rejet de la guidance." }
  ],
  munajat: `Ya Rabb, je ne veux pas traiter Ton Coran de mensonge. Ma réaction révèle mon cœur. Je crois et j'accepte.`
};

MIROIR["84:23"] = {
  reference: "84:23",
  theme: ["science", "caché", "Allah"],
  emotion: "Certitude, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Ilm", "Al-Ghayb"],
  mirrorVersion: `« Mais Allah sait bien ce qu'ils dissimulent. » Le miroir révèle : « Wa-Allahu a'lamu bima yu'un » — mais Allah sait bien ce qu'ils dissimulent. Les secrets des mécréants sont connus d'Allah. Le miroir m'enseigne : rien n'est caché à Allah — les intentions comme les actions.`,
  reflection: `Rien n'est caché à Allah. Les secrets les plus profonds sont connus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa-Allahu a'lamu bima yu'un » — mais Allah sait bien ce qu'ils dissimulent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je dissimule ? Allah le sait — je ne peux rien cacher." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les secrets dissimulés aux hommes sont manifestes à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est transparent à Allah — aucun secret ne résiste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La science d'Allah est parfaite — rien ne Lui échappe." }
  ],
  munajat: `Ya 'Alim, Tu sais ce que je dissimule. Je ne peux rien cacher. Fais que mes secrets soient purs. Tout est nu devant Toi.`
};

MIROIR["84:24"] = {
  reference: "84:24",
  theme: ["annonce", "châtiment", "douleur"],
  emotion: "Avertissement, terreur",
  difficulty: "débutant",
  relatedNames: ["Al-Bashar", "Al-'Adhab"],
  mirrorVersion: `« Annonce-leur donc un châtiment douloureux. » Le miroir avertit : « Fa-bashshirhum bi-'adhabin alim » — annonce-leur donc un châtiment douloureux. L'avertissement est clair — le châtiment attend les mécréants. Le miroir m'enseigne : l'avertissement précède le châtiment — c'est une miséricorde.`,
  reflection: `L'avertissement précède le châtiment. C'est une miséricorde avant la justice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-bashshirhum bi-'adhabin alim » — annonce-leur donc un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'avertissement est une miséricorde. Suis-je averti ? Le châtiment suit le rejet." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment douloureux répond au rejet de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine atteint tous les négateurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'avertissement est le dernier appel avant le châtiment." }
  ],
  munajat: `Ya Rabb, l'avertissement est Ta miséricorde. Je suis averti. Fais que je ne sois pas parmi les négateurs. Le châtiment m'effraie.`
};

MIROIR["84:25"] = {
  reference: "84:25",
  theme: ["exception", "croyants", "récompense"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'minun", "Al-Ajr"],
  mirrorVersion: `« Sauf ceux qui croient et font de bonnes œuvres. » Le miroir offre l'espoir : « Illa alladhina amanu wa 'amilu al-salihati » — sauf ceux qui croient et font de bonnes œuvres. L'exception est pour les croyants actifs. Le miroir m'enseigne : la foi sans œuvres n'est pas suffisante — la foi et les œuvres vont ensemble.`,
  reflection: `La foi et les œuvres vont ensemble. L'exception est pour les croyants actifs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina amanu wa 'amilu al-salihati » — sauf ceux qui croient et font de bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi l'exception ? La foi et les œuvres doivent aller ensemble." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exception sauve du châtiment — la foi et les œuvres sont la clé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense suit la foi et les œuvres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi authentique produit nécessairement de bonnes œuvres." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi l'exception. Je crois et je fais de bonnes œuvres. Les deux vont ensemble. Sauve-moi du châtiment.`
};

// ==================== SURAH 83: AL-MUTAFFIFIN - ADDITIONAL ENTRIES ====================

MIROIR["83:3"] = {
  reference: "83:3",
  theme: ["mesure", "justice", "fraude"],
  emotion: "Condamnation, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Mizan"],
  mirrorVersion: `« Et quand ils mesurent pour les autres, ils diminuent. » Le miroir décrit : « Wa idha kaluhum awzanu yukhsirun » — et quand ils mesurent pour les autres, ils diminuent. La fraude dans la mesure est condamnée. Le miroir m'interroge : est-ce que je donne moins que ce qui est dû ?`,
  reflection: `La fraude dans la mesure est une injustice. Donner moins que dû est condamnable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha kaluhum awzanu yukhsirun » — et quand ils mesurent pour les autres, ils diminuent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne ce qui est dû ? Ou est-ce que je fraude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diminution pour les autres est une augmentation pour soi — temporaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La balance juste est le fondement du commerce." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fraude dans la mesure est un vol déguisé." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Fais que je sois juste dans mes mesures. Ne permets pas que je fraude.`
};

MIROIR["83:4"] = {
  reference: "83:4",
  theme: ["résurrection", "croyance", "compte"],
  emotion: "Questionnement, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ath", "Al-Yawm"],
  mirrorVersion: `« Ces gens-là ne croient-ils pas qu'ils seront ressuscités ? » Le miroir questionne : « Ala yazunnu ula'ika annahum mab'uthun » — ces gens-là ne croient-ils pas qu'ils seront ressuscités ? La fraude vient de l'oubli de la résurrection. Si on croit au compte, on ne fraude pas. Le miroir m'enseigne : la foi au Jour prévient l'injustice.`,
  reflection: `La fraude vient de l'oubli de la résurrection. La foi au Jour prévient l'injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala yazunnu ula'ika annahum mab'uthun » — ces gens-là ne croient-ils pas qu'ils seront ressuscités ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment à la résurrection ? Mes actions le montrent-elles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection est le jour du compte — tout sera compté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La croyance en la résurrection transforme le comportement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au compte ne fraude pas." }
  ],
  munajat: `Ya Rabb, je crois en la résurrection. Fais que ma croyance se manifeste dans mes actions. Ne permets pas que je l'oublie.`
};

MIROIR["83:5"] = {
  reference: "83:5",
  theme: ["jour", "grandeur", "importance"],
  emotion: "Réalité, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-'Azim"],
  mirrorVersion: `« Pour un jour immense. » Le miroir précise : « Li-yawmin 'azim » — pour un jour immense. La résurrection n'est pas un jour ordinaire — c'est un jour immense, grandiose. Le miroir m'enseigne : le Jour est le plus grand jour — tout s'y joue.`,
  reflection: `Le Jour est immense. Tout s'y joue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yawmin 'azim » — pour un jour immense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise l'immensité du Jour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'immensité du Jour montre l'importance de la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour immense est le jour de la justice parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La grandeur du Jour doit nous pousser à la préparation." }
  ],
  munajat: `Ya Rabb, le Jour est immense. Fais que je le réalise. Prépare-moi pour ce grand jour.`
};

MIROIR["83:6"] = {
  reference: "83:6",
  theme: ["humanité", "comparution", "Allah"],
  emotion: "Humilité, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Nas", "Al-Rabb"],
  mirrorVersion: `« Le jour où les hommes se tiendront debout devant le Seigneur des mondes. » Le miroir décrit : « Yawma yaqumu al-nasu li-rabbi al-'alamin » — le jour où les hommes se tiendront debout devant le Seigneur des mondes. La comparution est totale — tous les hommes, devant Allah. Le miroir m'enseigne : ce jour-là, nous serons tous présents.`,
  reflection: `Tous les hommes se tiendront devant Allah. Personne ne manquera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yaqumu al-nasu li-rabbi al-'alamin » — le jour où les hommes se tiendront debout devant le Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment serai-je quand je me tiendrai devant Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La position debout montre le respect et la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute l'humanité sera rassemblée — du premier au dernier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Se tenir devant Allah maintenant prépare pour se tenir devant Lui alors." }
  ],
  munajat: `Ya Rabb, je me tiendrai devant Toi. Prépare-moi pour cette rencontre. Fais que je sois prêt à me tenir devant Toi.`
};

MIROIR["83:7"] = {
  reference: "83:7",
  theme: ["livre", "méchants", "enregistrement"],
  emotion: "Réalité, condamnation",
  difficulty: "débutant",
  relatedNames: ["Al-Sijjin", "Al-Fujjar"],
  mirrorVersion: `« Non ! Le livre des méchants est dans le Sijjin. » Le miroir révèle : « Kalla inna kitaba al-fujjari la-fi sijjin » — Non ! Le livre des méchants est dans le Sijjin. Le Sijjin est un registre où sont inscrits les noms et œuvres des méchants. Le miroir m'enseigne : chaque méchant a son registre.`,
  reflection: `Les méchants sont inscrits dans le Sijjin. Leur sort est scellé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla inna kitaba al-fujjari la-fi sijjin » — Non ! Le livre des méchants est dans le Sijjin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est mon nom inscrit ? Dans le Sijjin ou l'Illiyin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inscription dans le Sijjin annonce le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah tient le registre de chaque être." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le Sijjin est la prison des noms — et des âmes." }
  ],
  munajat: `Ya Rabb, ne m'inscris pas dans le Sijjin. Inscris-moi parmi les bienheureux. Ne permets pas que je sois parmi les méchants.`
};

MIROIR["83:8"] = {
  reference: "83:8",
  theme: ["question", "Sijjin", "révélation"],
  emotion: "Questionnement, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Sijjin", "Al-Ma'ruf"],
  mirrorVersion: `« Et qui te fera savoir ce qu'est le Sijjin ? » Le miroir questionne : « Wa ma adraka ma sijjin » — et qui te fera savoir ce qu'est le Sijjin ? La question souligne que le Sijjin dépasse notre compréhension. C'est un lieu terrible. Le miroir m'enseigne : la gravité du Sijjin est immense.`,
  reflection: `Le Sijjin est plus terrible que nous ne pouvons imaginer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma sijjin » — et qui te fera savoir ce qu'est le Sijjin ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le Sijjin ? Est-ce que je l'évite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gravité du Sijjin devrait nous faire peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Sijjin est le registre des perdants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur du Sijjin devrait nous pousser à la piété." }
  ],
  munajat: `Ya Rabb, je ne connais pas le Sijjin, mais je le crains. Protège-moi de l'inscription dedans. Fais que je l'évite.`
};

MIROIR["83:9"] = {
  reference: "83:9",
  theme: ["livre", "écrit", "méchants"],
  emotion: "Réalité, condamnation",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Marqum"],
  mirrorVersion: `« Un livre écrit. » Le miroir précise : « Kitabun marqum » — un livre écrit, numéroté. Le registre des méchants est complet, numéroté, sans erreur. Le miroir m'enseigne : l'enregistrement est précis.`,
  reflection: `Le livre est écrit et numéroté. Rien n'est oublié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kitabun marqum » — un livre écrit, numéroté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon livre est-il en train d'être écrit ? Que contient-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le livre numéroté montre l'exactitude du compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque action est numérotée — rien n'est oublié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La précision du livre montre la précision d'Allah." }
  ],
  munajat: `Ya Rabb, mon livre est en train d'être écrit. Fais qu'il contienne le bien. Ne permets pas qu'il contienne le mal.`
};

MIROIR["83:10"] = {
  reference: "83:10",
  theme: ["malheur", "négateurs", "jour"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Wayl", "Al-Mukadhdhibun"],
  mirrorVersion: `« Malheur, ce jour-là, à ceux qui traitent de mensonge. » Le miroir avertit : « Waylun yawma'idhin lil-mukadhdhibin » — malheur, ce jour-là, à ceux qui traitent de mensonge. Le « wayl » est une expression de malheur intense. Le miroir m'enseigne : le déni de la vérité mène au malheur.`,
  reflection: `Le malheur attend ceux qui traitent la vérité de mensonge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waylun yawma'idhin lil-mukadhdhibin » — malheur, ce jour-là, à ceux qui traitent de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite la vérité de mensonge ? Par mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déni de la vérité ne change pas la vérité — il change le sort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste vraie — même si on la nie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le « wayl » est le sort de ceux qui refusent d'accepter." }
  ],
  munajat: `Ya Rabb, ne permets pas que je traite la vérité de mensonge. Fais que j'accepte Ta parole. Épargne-moi le malheur.`
};

MIROIR["83:11"] = {
  reference: "83:11",
  theme: ["rétribution", "mensonge", "négation"],
  emotion: "Mise en garde, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Yawm"],
  mirrorVersion: `« Ceux qui traitent de mensonge le Jour de la Rétribution. » Le miroir précise : « Alladhina yukadhdhibuna bi-yawmi al-din » — ceux qui traitent de mensonge le Jour de la Rétribution. Le déni du Jour est le problème fondamental. Le miroir m'enseigne : nier le Jour ne l'empêche pas de venir.`,
  reflection: `Nier le Jour ne l'empêche pas. Le Jour viendra pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yukadhdhibuna bi-yawmi al-din » — ceux qui traitent de mensonge le Jour de la Rétribution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment au Jour ? Ou est-ce que je le traite de mensonge par mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déni du Jour est le plus grand mensonge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour viendra — même si personne n'y croit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi au Jour transforme la vie entière." }
  ],
  munajat: `Ya Rabb, je crois au Jour de la Rétribution. Fais que ma foi soit vraie. Ne permets pas que je le nie par mes actions.`
};

MIROIR["83:12"] = {
  reference: "83:12",
  theme: ["transgresseurs", "pêcheurs", "négation"],
  emotion: "Condamnation, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'tadin", "Al-Khati'in"],
  mirrorVersion: `« Et il n'y a que les transgresseurs, les pécheurs, pour le traiter de mensonge. » Le miroir identifie : « Wa ma yukadhdhibu bihi illa kulla mu'tadin athim » — et il n'y a que les transgresseurs, les pécheurs, pour le traiter de mensonge. Le déni n'est pas innocent — il vient de la transgression. Le miroir m'enseigne : le péché aveugle à la vérité.`,
  reflection: `Les transgresseurs nient le Jour. Le péché aveugle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yukadhdhibu bihi illa kulla mu'tadin athim » — et il n'y a que les transgresseurs, les pécheurs, pour le traiter de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes péchés m'aveuglent à la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transgression mène au déni — le déni mène à la perdition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cœurs purs croient — les cœurs souillés nient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La purification du cœur restaure la vue." }
  ],
  munajat: `Ya Rabb, ne permets pas que mes péchés m'aveuglent. Purifie mon cœur. Fais que je voie la vérité clairement.`
};

MIROIR["83:13"] = {
  reference: "83:13",
  theme: ["révélation", "écoute", "moquerie"],
  emotion: "Condamnation, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Sam'"],
  mirrorVersion: `« Quand Nos versets leur sont récités, ils disent : 'Des fables des anciens.' » Le miroir décrit : « Idha tutla 'alayhi ayatuna qala asatiru al-awwalin » — quand Nos versets leur sont récités, ils disent : des fables des anciens. La révélation est traitée de légende. Le miroir m'enseigne : le rejet de la révélation vient de l'orgueil.`,
  reflection: `Les versets sont traités de fables par les orgueilleux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha tutla 'alayhi ayatuna qala asatiru al-awwalin » — quand Nos versets leur sont récités, ils disent : des fables des anciens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis quand j'entends les versets d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet de la révélation est le rejet de la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la lumière — la rejeter est choisir l'obscurité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute avec le cœur ouvert reconnaît la vérité." }
  ],
  munajat: `Ya Rabb, quand j'entends Tes versets, ouvre mon cœur. Ne permets pas que je les traite de fables. Fais que je les accepte.`
};

MIROIR["83:14"] = {
  reference: "83:14",
  theme: ["cœur", "rouille", "péché"],
  emotion: "Réalité, purification",
  difficulty: "débutant",
  relatedNames: ["Al-Qalb", "Al-Ran"],
  mirrorVersion: `« Non ! Mais ce qu'ils ont acquis a mis une rouille sur leurs cœurs. » Le miroir diagnostique : « Kalla bal rana 'ala qulubihim ma kanu yaksibun » — Non ! Mais ce qu'ils ont acquis a mis une rouille sur leurs cœurs. Les péchés s'accumulent comme la rouille, couvrant le cœur. Le miroir m'enseigne : chaque péché obscurcit le cœur.`,
  reflection: `Les péchés couvrent le cœur de rouille. La purification est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla bal rana 'ala qulubihim ma kanu yaksibun » — Non ! Mais ce qu'ils ont acquis a mis une rouille sur leurs cœurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle rouille s'est accumulée sur mon cœur ? Comment la nettoyer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rouille du péché empêche la lumière de pénétrer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cœur est comme un miroir — les péchés le ternissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La purification régulière maintient le cœur brillant." }
  ],
  munajat: `Ya Tahir, les péchés ont mis de la rouille sur mon cœur. Nettoie-le. Fais que je me purifie régulièrement. Ne permets pas l'accumulation.`
};

MIROIR["83:15"] = {
  reference: "83:15",
  theme: ["voile", "vision", "Allah"],
  emotion: "Deprivation, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Hijab", "Al-Ru'yah"],
  mirrorVersion: `« Non ! Il y a un voile sur leurs cœurs ce jour-là. » Le miroir révèle : « Kalla innahum 'an rabbihim yawma'idhin la-mahjubun » — Non ! Ils seront voilés de leur Seigneur ce jour-là. Le voile n'est pas seulement sur les yeux — il est sur les cœurs. Le miroir m'enseigne : la privation de la vision d'Allah est le châtiment ultime.`,
  reflection: `Le voile sur le cœur prive de la vision d'Allah. C'est la plus grande perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla innahum 'an rabbihim yawma'idhin la-mahjubun » — Non ! Ils seront voilés de leur Seigneur ce jour-là." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce qu'il y a un voile sur mon cœur maintenant ? Comment le lever ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voile maintenant mène au voile alors — le cœur ouvert maintenant verra alors." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vision d'Allah est la plus grande récompense — la privation est le plus grand châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Lever le voile maintenant prépare la vision alors." }
  ],
  munajat: `Ya Rabb, ne permets pas que je sois voilé de Toi. Lève tout voile sur mon cœur. Fais que je Te voie — maintenant et alors.`
};

MIROIR["83:16"] = {
  reference: "83:16",
  theme: ["enfer", "entrée", "brûlement"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Nar"],
  mirrorVersion: `« Puis ils entreront dans la Fournaise. » Le miroir continue : « Thumma innahum la-salun al-jahim » — puis ils entreront dans la Fournaise. Le voile n'est qu'un début — l'entrée dans l'enfer suit. Le miroir m'avertit : la privation de la vision d'Allah n'est que le début du châtiment.`,
  reflection: `Le châtiment commence par le voile et continue par le feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma innahum la-salun al-jahim » — puis ils entreront dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que le châtiment est progressif ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'entrée dans le feu suit le voile du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu de l'enfer attend ceux qui l'ont mérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur du feu maintenant protège de l'entrée alors." }
  ],
  munajat: `Ya Rabb, protège-moi de la Fournaise. Ne permets pas que j'y entre. Le feu m'effraie — sauve-moi de lui.`
};

MIROIR["83:17"] = {
  reference: "83:17",
  theme: ["rétribution", "jugement", "châtiment"],
  emotion: "Réalité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Din", "Al-Hukm"],
  mirrorVersion: `« Puis il leur sera dit : 'C'est ce que vous traitiez de mensonge.' » Le miroir conclut : « Thumma yuqalu hadha alladhi kuntum bihi tukadhdhibun » — puis il leur sera dit : c'est ce que vous traitiez de mensonge. La réalité qu'ils niaient devient leur châtiment. Le miroir m'enseigne : nier la vérité ne l'empêche pas — elle devient notre juge.`,
  reflection: `Ce qu'on traitait de mensonge devient notre réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma yuqalu hadha alladhi kuntum bihi tukadhdhibun » — puis il leur sera dit : c'est ce que vous traitiez de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je traite de mensonge maintenant ? Cela deviendra ma réalité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge sur la vérité devient la vérité du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah confronte chaque mensonge avec la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Accepter la vérité maintenant évite la confrontation alors." }
  ],
  munajat: `Ya Rabb, je ne veux pas traiter Ta vérité de mensonge. Fais que j'accepte tout ce qui vient de Toi. Ne permets pas la confrontation.`
};

MIROIR["83:18"] = {
  reference: "83:18",
  theme: ["livre", "vertueux", "honneur"],
  emotion: "Espoir, honneur",
  difficulty: "débutant",
  relatedNames: ["Al-Illiyun", "Al-Abrar"],
  mirrorVersion: `« Non ! Le livre des vertueux est dans l'Illiyun. » Le miroir contraste : « Kalla inna kitaba al-abrari la-fi 'illiyin » — Non ! Le livre des vertueux est dans l'Illiyun. L'Illiyun est le registre des bienheureux. Le contraste est clair : Sijjin pour les méchants, Illiyun pour les vertueux. Le miroir m'enseigne : il y a deux registres — où suis-je ?`,
  reflection: `Deux registres : Sijjin et Illiyun. Où suis-je inscrit ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla inna kitaba al-abrari la-fi 'illiyin » — Non ! Le livre des vertueux est dans l'Illiyun." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon nom est-il dans l'Illiyun ? Comment y être inscrit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'Illiyun est l'opposé du Sijjin — la récompense opposée au châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les registres d'Allah sont précis — chaque nom à sa place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'inscription dans l'Illiyun commence par les actions ici-bas." }
  ],
  munajat: `Ya Rabb, inscris-moi dans l'Illiyun. Fais que je sois parmi les vertueux. Ne permets pas que je sois dans le Sijjin.`
};

MIROIR["83:19"] = {
  reference: "83:19",
  theme: ["question", "Illiyun", "grandeur"],
  emotion: "Questionnement, honneur",
  difficulty: "débutant",
  relatedNames: ["Al-Illiyun", "Al-'Aliyy"],
  mirrorVersion: `« Et qui te fera savoir ce qu'est l'Illiyun ? » Le miroir questionne : « Wa ma adraka ma 'illiyun » — et qui te fera savoir ce qu'est l'Illiyun ? La question souligne que l'Illiyun dépasse notre compréhension. C'est un lieu d'honneur sublime. Le miroir m'enseigne : l'honneur de l'Illiyun est immense.`,
  reflection: `L'Illiyun est plus magnifique que nous ne pouvons imaginer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma adraka ma 'illiyun » — et qui te fera savoir ce qu'est l'Illiyun ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à l'Illiyun ? Est-ce que je comprends son honneur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur de l'Illiyun reflète la grandeur de ses habitants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Illiyun est le registre des gagnants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'aspiration à l'Illiyun guide les actions nobles." }
  ],
  munajat: `Ya Rabb, je ne connais pas l'Illiyun, mais j'y aspire. Fais que je sois parmi ses habitants. Donne-moi l'honneur d'y être inscrit.`
};

MIROIR["83:20"] = {
  reference: "83:20",
  theme: ["livre", "écrit", "vertueux"],
  emotion: "Espoir, précision",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Marqum"],
  mirrorVersion: `« Un livre écrit. » Le miroir précise : « Kitabun marqum » — un livre écrit, numéroté. Comme le Sijjin, l'Illiyun contient un registre numéroté. Mais ici, ce sont les noms des bienheureux. Le miroir m'enseigne : la précision d'Allah est parfaite — le registre des bons comme celui des méchants.`,
  reflection: `Le registre de l'Illiyun est précis. Chaque bienheureux y est inscrit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kitabun marqum » — un livre écrit, numéroté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon nom est-il dans ce livre numéroté ? Comment y être inscrit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La précision du livre montre que chaque place est méritée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque vertueux a sa place numérotée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'inscription précise reflète le compte précis des bonnes actions." }
  ],
  munajat: `Ya Rabb, inscris mon nom dans le livre numéroté. Fais que ma place soit réservée. Prépare-moi pour l'Illiyun.`
};

MIROIR["83:21"] = {
  reference: "83:21",
  theme: ["anges", "vision", "honneur"],
  emotion: "Révérence, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Muqarrabin", "Al-Mala'ika"],
  mirrorVersion: `« Que voient ceux qui sont rapprochés. » Le miroir ajoute : « Yashhaduhu al-muqarrabun » — que voient ceux qui sont rapprochés. Les anges rapprochés témoignent de ce registre. Le miroir m'enseigne : l'honneur de l'Illiyun est attesté par les plus nobles créatures.`,
  reflection: `Les anges rapprochés témoignent de l'honneur de l'Illiyun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yashhuduhu al-muqarrabun » — que voient ceux qui sont rapprochés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les anges voient le registre — est-ce qu'ils voient mon nom ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les anges rapprochés honorent le registre des rapprochés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges les plus proches d'Allah témoignent du registre des plus proches." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Être vu par les anges rapprochés est un honneur." }
  ],
  munajat: `Ya Rabb, les anges rapprochés voient le registre. Fais qu'ils voient mon nom. Fais que je sois parmi les rapprochés.`
};

MIROIR["83:22"] = {
  reference: "83:22",
  theme: ["délices", "vertueux", "récompense"],
  emotion: "Espoir, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Na'im", "Al-Abrar"],
  mirrorVersion: `« Les vertueux seront dans des délices. » Le miroir promet : « Inna al-abrara la-fi na'im » — les vertueux seront dans des délices. Le délice n'est pas une promesse vague — c'est une certitude. Le miroir m'enseigne : la vertu mène au délice.`,
  reflection: `Les vertueux seront dans les délices. La vertu a sa récompense certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-abrara la-fi na'im » — les vertueux seront dans des délices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les vertueux ? Le délice m'attend-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délice suit la vertu — maintenant et toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah récompense chaque vertu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le délice éternel commence par le délice de la vertu ici-bas." }
  ],
  munajat: `Ya Rabb, les vertueux seront dans les délices. Fais que je sois parmi eux. Donne-moi la vertu qui mène au délice.`
};

MIROIR["83:23"] = {
  reference: "83:23",
  theme: ["trônes", "observation", "récompense"],
  emotion: "Dignité, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Ara'ik", "Al-Nazirun"],
  mirrorVersion: `« Sur des trônes, ils observeront. » Le miroir décrit : « 'Ala al-ara'iki yanzurun » — sur des trônes, ils observeront. La position est élevée — sur des trônes. L'observation est le privilège des bienheureux. Le miroir m'enseigne : les vertueux seront élevés et observeront.`,
  reflection: `Les vertueux seront sur des trônes, observant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala al-ara'iki yanzurun » — sur des trônes, ils observeront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aurai l'honneur des trônes ? D'observer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation sur les trônes suit l'élévation dans la vertu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les trônes du Paradis sont préparés pour les vertueux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'observation des bienheureux inclut l'observation du châtiment des méchants." }
  ],
  munajat: `Ya Rabb, élève-moi sur les trônes. Donne-moi l'honneur d'observer. Fais que je sois parmi les bienheureux.`
};

MIROIR["83:24"] = {
  reference: "83:24",
  theme: ["visage", "beauté", "joie"],
  emotion: "Beauté, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Wajh", "Al-Na'im"],
  mirrorVersion: `« Tu reconnaîtras sur leurs visages l'éclat de la félicité. » Le miroir décrit : « Ta'rif fi wujuhihim nadrah al-na'im » — tu reconnaîtras sur leurs visages l'éclat de la félicité. La joie intérieure se manifeste sur le visage. Le miroir m'enseigne : le bonheur du Paradis se voit.`,
  reflection: `La félicité se voit sur les visages des bienheureux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta'rif fi wujuhihim nadrah al-na'im » — tu reconnaîtras sur leurs visages l'éclat de la félicité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon visage porte-t-il l'éclat de la félicité ? Ou l'ombre du souci ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éclat du visage reflète l'éclat du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La félicité intérieure illumine l'extérieur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont le visage brille maintenant prépare son éclat alors." }
  ],
  munajat: `Ya Rabb, fais que mon visage porte l'éclat de la félicité. Illumine mon visage comme Tu illumines mes jours. Donne-moi la joie visible.`
};

MIROIR["83:25"] = {
  reference: "83:25",
  theme: ["boisson", "vin", "paradis"],
  emotion: "Délice, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Rahiq", "Al-Khamt"],
  mirrorVersion: `« Ils seront abreuvés d'un vin scellé. » Le miroir promet : « Yusqawna min rahiqin makhtumin » — ils seront abreuvés d'un vin scellé. Le vin du Paradis n'est pas le vin de ce monde — il est pur, scellé, précieux. Le miroir m'enseigne : les plaisirs du Paradis surpassent tout ce que nous connaissons.`,
  reflection: `Le vin du Paradis est pur et scellé. Les plaisirs du Paradis sont sublimes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yusqawna min rahiqin makhtumin » — ils seront abreuvés d'un vin scellé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire aux plaisirs purs du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vin pur du Paradis contraste avec les plaisirs souillés d'ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les plaisirs du Paradis sont sans conséquences néfastes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sceau du vin garantit sa pureté parfaite." }
  ],
  munajat: `Ya Rabb, donne-moi le vin pur du Paradis. Fais que j'aspire aux plaisirs purs. Prépare-moi pour les délices éternels.`
};

MIROIR["83:26"] = {
  reference: "83:26",
  theme: ["muscs", "aspiration", "paradis"],
  emotion: "Parfum, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Misk", "Al-Khitam"],
  mirrorVersion: `« Dont le cachet est de musc — que ceux qui rivalisent rivalisent pour cela. » Le miroir précise : « Khitamuhu miskun fa-fi dhalika fal-yatanafasi al-mutanafisun » — dont le cachet est de musc — que ceux qui rivalisent rivalisent pour cela. Le musc est précieux — l'invitation à rivaliser pour ce vin est un appel à l'effort. Le miroir m'enseigne : les meilleures choses méritent le plus grand effort.`,
  reflection: `Le meilleur mérite l'effort. Rivalisons pour les délices éternels.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khitamuhu miskun fa-fi dhalika fal-yatanafasi al-mutanafisun » — dont le cachet est de musc — que ceux qui rivalisent rivalisent pour cela." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pour quoi est-ce que je rivalise ? Les délices éternels ou les plaisirs temporaires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rivalisation pour le Paradis est la meilleure rivalisation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le musc symbolise la pureté et la valeur suprêmes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ceux qui rivalisent maintenant pour Allah recevront le cachet de musc." }
  ],
  munajat: `Ya Rabb, je rivalise pour Ton Paradis. Donne-moi la détermination de rivaliser pour les meilleures choses. Fais que je gagne.`
};

MIROIR["83:27"] = {
  reference: "83:27",
  theme: ["boisson", "mélange", "paradis"],
  emotion: "Délice, préciosité",
  difficulty: "débutant",
  relatedNames: ["Al-Tasnim", "Al-Mizaj"],
  mirrorVersion: `« Et dont la mixture est de Tasnim. » Le miroir précise : « Wa mizajuhu min tasnim » — et dont la mixture est de Tasnim. Le Tasnim est une source du Paradis, la plus élevée. Le miroir m'enseigne : les boissons du Paradis sont mélangées avec les meilleures sources.`,
  reflection: `Les sources du Paradis sont pures et précieuses.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa mizajuhu min tasnim » — et dont la mixture est de Tasnim." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire aux sources du Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mélange de Tasnim élève déjà le vin précieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sources du Paradis jaillissent par la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Tasnim signifie « s'élever » — les bienheureux s'élèvent vers cette source." }
  ],
  munajat: `Ya Rabb, donne-moi à boire de Tasnim. Élève-moi vers les sources du Paradis. Fais que je m'abreuve des meilleures eaux.`
};

MIROIR["83:28"] = {
  reference: "83:28",
  theme: ["source", "rapprochés", "paradis"],
  emotion: "Honneur, proximité",
  difficulty: "débutant",
  relatedNames: ["Al-Muqarrabin", "Al-'Ayn"],
  mirrorVersion: `« Une source dont boivent ceux qui sont rapprochés. » Le miroir précise : « 'Aynan yashrabu biha al-muqarrabun » — une source dont boivent ceux qui sont rapprochés. La source de Tasnim est réservée aux plus proches d'Allah. Le miroir m'enseigne : la proximité d'Allah a ses privilèges exclusifs.`,
  reflection: `Les rapprochés boivent de la meilleure source. La proximité a ses privilèges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Aynan yashrabu biha al-muqarrabun » — une source dont boivent ceux qui sont rapprochés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les rapprochés ? Comment m'en rapprocher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La proximité ici mène à la proximité là — et à ses privilèges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les rapprochés d'Allah sont les plus honorés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Boire de Tasnim est le signe de la proximité suprême." }
  ],
  munajat: `Ya Rabb, rapproche-moi de Toi. Fais que je sois parmi les muqarrabin. Donne-moi à boire de Ta source la plus élevée.`
};

MIROIR["83:29"] = {
  reference: "83:29",
  theme: ["moquerie", "coupables", "vertueux"],
  emotion: "Réalité, justice",
  difficulty: "débutant",
  relatedNames: ["Al-Mujrimun", "Al-Abrar"],
  mirrorVersion: `« Les coupables riaient de ceux qui croyaient. » Le miroir rappelle : « Inna alladhina ajramu kanu min alladhina amanu yadhakun » — les coupables riaient de ceux qui croyaient. Dans ce monde, les mécréants se moquaient des croyants. Le miroir m'enseigne : la moquerie des méchants ne diminue pas les croyants.`,
  reflection: `Les méchants se moquaient des croyants — mais qui rira le dernier ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina ajramu kanu min alladhina amanu yadhakun » — les coupables riaient de ceux qui croyaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis moqué pour ma foi ? Comment je réagis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les moqueurs d'hier seront les pleureurs de demain." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La moquerie des méchants est un honneur pour les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est moqué pour Allah sera honoré par Allah." }
  ],
  munajat: `Ya Rabb, les méchants se moquaient des croyants. Si je suis moqué, donne-moi la patience. Fais que je sois honoré par Toi.`
};

MIROIR["83:30"] = {
  reference: "83:30",
  theme: ["regard", "passage", "moquerie"],
  emotion: "Mépris, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Tawallu", "Al-Ghamz"],
  mirrorVersion: `« Et quand ils passaient près d'eux, ils se faisaient des clins d'œil. » Le miroir continue : « Wa idha marru bihim yataghamazun » — et quand ils passaient près d'eux, ils se faisaient des clins d'œil. Les mécréants se moquaient discrètement. Le miroir m'enseigne : la moquerie peut être subtile — mais Allah voit tout.`,
  reflection: `La moquerie subtile n'échappe pas à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha marru bihum yataghamazun » — et quand ils passaient près d'eux, ils se faisaient des clins d'œil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me moque discrètement des autres ? Ou est-ce que j'en suis victime ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les clins d'œil moqueurs seront des regards de regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah voit ce qui est caché — même les clins d'œil." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La patience face à la moquerie élève le croyant." }
  ],
  munajat: `Ya Rabb, Tu vois les moqueries cachées. Fais que je ne me moque pas. Donne-moi la patience face à ceux qui se moquent.`
};

MIROIR["83:31"] = {
  reference: "83:31",
  theme: ["retour", "joie", "moquerie"],
  emotion: "Mépris, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Inqilab", "Al-Farihun"],
  mirrorVersion: `« Et quand ils retournaient dans leurs familles, ils retournaient joyeux. » Le miroir continue : « Wa idha inqalabu ila ahlihim inqalabu fakiheen » — et quand ils retournaient dans leurs familles, ils retournaient joyeux. Les moqueurs trouvaient du plaisir dans leur moquerie. Le miroir m'enseigne : le plaisir du mal est temporaire.`,
  reflection: `Le plaisir de la moquerie est temporaire. Le regret sera éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha inqalabu ila ahlihim inqalabu fakiheen » — et quand ils retournaient dans leurs familles, ils retournaient joyeux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je trouve du plaisir dans le mal ? Ou dans le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie du mal se transformera en tristesse du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le plaisir temporaire du mal cache la douleur éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie joie est dans le bien — pas dans la moquerie." }
  ],
  munajat: `Ya Rabb, fais que je trouve ma joie dans le bien. Ne permets pas que je me réjouisse du mal. Donne-moi la vraie joie.`
};

MIROIR["83:32"] = {
  reference: "83:32",
  theme: ["perception", "égarement", "croyants"],
  emotion: "Réalité, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Suhh", "Al-Dalalah"],
  mirrorVersion: `« Et quand ils les voyaient, ils disaient : 'Ce sont des égarés.' » Le miroir continue : « Wa idha rawhum qalu inna ha'ula'i la-dallun » — et quand ils les voyaient, ils disaient : ce sont des égarés. La perception des mécréants était inversée — ils prenaient les croyants pour des égarés. Le miroir m'enseigne : la vérité peut sembler fausse à ceux qui sont égarés.`,
  reflection: `Les égarés prennent les guidés pour des égarés. La perspective est inversée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha rawhum qalu inna ha'ula'i la-dallun » — et quand ils les voyaient, ils disaient : ce sont des égarés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui est vraiment égaré ? Est-ce que je vois la vérité ou l'inverse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel à l'égarement est le signe de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière peut sembler aveuglante à ceux qui vivent dans l'obscurité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vrai guidance n'est pas affectée par l'accusation d'égarement." }
  ],
  munajat: `Ya Hadi, guide-moi vers la vérité. Ne permets pas que je sois parmi les égarés. Fais que je voie clairement le chemin.`
};

MIROIR["83:33"] = {
  reference: "83:33",
  theme: ["surveillance", "envoi", "responsabilité"],
  emotion: "Réalité, questionnement",
  difficulty: "débutant",
  relatedNames: ["Al-Hafizun", "Al-Mursal"],
  mirrorVersion: `« Alors qu'ils n'ont pas été envoyés pour être leurs gardiens. » Le miroir questionne : « Wa ma ursilu 'alayhim hafizin » — alors qu'ils n'ont pas été envoyés pour être leurs gardiens. Les mécréants n'étaient pas responsables des croyants. Le miroir m'enseigne : chacun est responsable de lui-même.`,
  reflection: `Chacun est responsable de lui-même. Nous ne sommes pas les gardiens des autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma ursilu 'alayhim hafizin » — alors qu'ils n'ont pas été envoyés pour être leurs gardiens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me préoccupe des autres au point d'oublier ma propre responsabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité individuelle n'exclut pas la bienveillance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque âme sera jugée pour elle-même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le vrai gardien de chacun est Allah." }
  ],
  munajat: `Ya Rabb, je suis responsable de moi-même. Aide-moi à remplir ma responsabilité. Ne permets pas que je me détourne.`
};

MIROIR["83:34"] = {
  reference: "83:34",
  theme: ["jour", "rire", "récompense"],
  emotion: "Justice, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Yawm", "Al-Dahikun"],
  mirrorVersion: `« Mais aujourd'hui, ce sont ceux qui croient qui rient des mécréants. » Le miroir renverse : « Fa-al-yawma alladhina amanu min al-kuffari yadhakun » — mais aujourd'hui, ce sont ceux qui croient qui rient des mécréants. Le rire est renversé. Les moqueurs deviennent les moqués. Le miroir m'enseigne : la justice d'Allah renverse les situations.`,
  reflection: `Les rires sont renversés. La justice d'Allah rétablit l'équilibre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-yawma alladhina amanu min al-kuffari yadhakun » — mais aujourd'hui, ce sont ceux qui croient qui rient des mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La patience face à la moquerie sera récompensée par le rire." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rire des croyants n'est pas moquerie — c'est justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour renverse toutes les situations injustes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure la moquerie pour Allah rira avec Allah." }
  ],
  munajat: `Ya Rabb, renverse ma situation si je suis moqué. Donne-moi la patience. Fais que je rie avec Toi le Jour.`
};

MIROIR["83:35"] = {
  reference: "83:35",
  theme: ["trônes", "observation", "paradis"],
  emotion: "Dignité, observation",
  difficulty: "débutant",
  relatedNames: ["Al-Ara'ik", "Al-Nazirun"],
  mirrorVersion: `« Sur des trônes, ils observeront. » Le miroir répète l'image : « 'Ala al-ara'iki yanzurun » — sur des trônes, ils observeront. La répétition souligne l'honneur. Les bienheureux sur leurs trônes observent le sort des mécréants. Le miroir m'enseigne : la dignité des bienheureux inclut l'observation de la justice.`,
  reflection: `Les bienheureux observent depuis leurs trônes. L'honneur est complet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ala al-ara'iki yanzurun » — sur des trônes, ils observeront." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aurai l'honneur des trônes ? D'observer la justice d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'observation des bienheureux est un acte de gratitude pour la justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les trônes du Paradis surplombent l'enfer — la vue est claire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Observer la justice d'Allah est une forme d'adoration." }
  ],
  munajat: `Ya Rabb, donne-moi un trône au Paradis. Fais que j'observe Ta justice. Honore-moi comme Tu honores Tes bienheureux.`
};

MIROIR["83:36"] = {
  reference: "83:36",
  theme: ["récompense", "mécréants", "question"],
  emotion: "Justice, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jaza'", "Al-Kafirun"],
  mirrorVersion: `« Les mécréants ont-ils été récompensés pour ce qu'ils faisaient ? » Le miroir questionne : « Hal suwwiba al-kafiruna ma kanu yaf'alun » — les mécréants ont-ils été récompensés pour ce qu'ils faisaient ? La question est rhétorique — oui, ils ont été récompensés. Le châtiment est la récompense des mécréants. Le miroir m'enseigne : les actions ont des conséquences.`,
  reflection: `Les mécréants sont récompensés pour leurs actions — le châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal suwwiba al-kafiruna ma kanu yaf'alun » — les mécréants ont-ils été récompensés pour ce qu'ils faisaient ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle sera ma récompense ? Le châtiment ou le délice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La « récompense » des mécréants est ironique — c'est le châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice d'Allah rend à chacun selon ses actions." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La récompense du bien est le bien — la récompense du mal est le mal." }
  ],
  munajat: `Ya Rabb, récompense-moi pour le bien. Ne permets pas que je sois récompensé pour le mal. Fais que ma récompense soit le délice.`
};

// ==================== SURAH 84: AL-INSHIQAQ - ADDITIONAL ENTRIES ====================

MIROIR["84:2"] = {
  reference: "84:2",
  theme: ["permission", "obéissance", "ciel"],
  emotion: "Obéissance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Sama", "Al-Tawwab"],
  mirrorVersion: `« Et qu'il ait exaucé son Seigneur et se soit acquitté de son devoir. » Le miroir précise : « Wa adhina li-rabbiha wa huqqat » — et qu'il ait exaucé son Seigneur et se soit acquitté de son devoir. Le ciel obéit à l'ordre d'Allah. Le miroir m'enseigne : la création obéit parfaitement — nous devrions faire de même.`,
  reflection: `Le ciel obéit parfaitement. Nous devrions imiter cette obéissance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adhina li-rabbiha wa huqqat » — et qu'il ait exaucé son Seigneur et se soit acquitté de son devoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis comme le ciel obéit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance du ciel est immédiate — la mienne devrait l'être aussi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création obéit à Allah — seul l'homme résiste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance parfaite est le devoir de toute créature." }
  ],
  munajat: `Ya Rabb, le ciel T'obéit parfaitement. Fais que je T'obéisse comme lui. Ne permets pas que je résiste.`
};

MIROIR["84:3"] = {
  reference: "84:3",
  theme: ["terre", "extension", "fin"],
  emotion: "Soumission, transformation",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Madd"],
  mirrorVersion: `« Et quand la terre sera étendue. » Le miroir continue : « Wa idha al-ardu muddat » — et quand la terre sera étendue. La terre sera étendue, aplatie pour le rassemblement. Le miroir m'enseigne : la transformation du Jour atteindra chaque élément.`,
  reflection: `La terre sera transformée. Tout sera aplani pour le jugement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha al-ardu muddat » — et quand la terre sera étendue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour la transformation de la terre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'extension de la terre prépare le rassemblement des âmes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre sera transformée pour le Jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'aplatissement de la terre révèle la puissance d'Allah." }
  ],
  munajat: `Ya Rabb, la terre sera étendue pour Ton jugement. Prépare-moi pour ce jour. Fais que je sois prêt à me présenter.`
};

MIROIR["84:4"] = {
  reference: "84:4",
  theme: ["rejet", "vide", "terre"],
  emotion: "Transformation, jugement",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Ilqa"],
  mirrorVersion: `« Et qu'elle aura rejeté ce qui est en elle. » Le miroir continue : « Wa alqat ma fiha wa takhallat » — et qu'elle aura rejeté ce qui est en elle, s'en sera vidée. La terre rejettera tout ce qu'elle contient — les morts, les trésors. Le miroir m'enseigne : rien ne restera caché.`,
  reflection: `La terre rejettera tout. Les secrets seront révélés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alqat ma fiha wa takhallat » — et qu'elle aura rejeté ce qui est en elle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Tout sera révélé le Jour." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet de la terre révèle tout — les morts et les secrets." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un contenant — le Jour, elle sera vidée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Rien ne peut rester caché d'Allah — ni dans la terre ni dans les cœurs." }
  ],
  munajat: `Ya Rabb, la terre révèlera tout. Purifie-moi de ce qui devrait être caché. Fais que je n'aie rien à cacher.`
};

MIROIR["84:5"] = {
  reference: "84:5",
  theme: ["permission", "obéissance", "terre"],
  emotion: "Soumission, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Tawwab"],
  mirrorVersion: `« Et qu'elle aura exaucé son Seigneur et se sera acquittée de son devoir. » Le miroir précise : « Wa adhinat li-rabbiha wa huqqat » — et qu'elle aura exaucé son Seigneur et se sera acquittée de son devoir. Comme le ciel, la terre obéit. Le miroir m'enseigne : la création entière obéit — seul l'homme résiste parfois.`,
  reflection: `Le ciel et la terre obéissent. Nous devrions suivre leur exemple.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adhinat li-rabbiha wa huqqat » — et qu'elle aura exaucé son Seigneur et se sera acquittée de son devoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre obéit — et moi ? Est-ce que j'obéis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance de la terre contraste avec la résistance humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création obéit — c'est sa nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'obéissance est le chemin naturel de toute créature." }
  ],
  munajat: `Ya Rabb, la terre T'obéit. Fais que je T'obéisse comme elle. Ne permets pas que je résiste à Tes ordres.`
};

MIROIR["84:7"] = {
  reference: "84:7",
  theme: ["livre", "droite", "facilité"],
  emotion: "Espoir, honneur",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Yamin"],
  mirrorVersion: `« Quant à celui qui recevra son livre en sa main droite. » Le miroir décrit : « Fa-amma man utiya kitabahu bi-yaminihi » — quant à celui qui recevra son livre en sa main droite. Recevoir le livre à droite est un signe de succès. Le miroir m'enseigne : il y a deux issues — à droite pour les gagnants.`,
  reflection: `Le livre à droite annonce le succès. Quelle sera ma réception ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma man utiya kitabahu bi-yaminihi » — quant à celui qui recevra son livre en sa main droite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je recevrai mon livre à droite ? Comment m'en assurer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La main droite symbolise l'honneur — la gauche, le déshonneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le livre à droite est le signe de la réussite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les actions de la main droite maintenant préparent la réception à droite alors." }
  ],
  munajat: `Ya Rabb, fais que je reçoive mon livre à droite. Fais que je sois parmi les gagnants. Donne-moi l'honneur de la main droite.`
};

MIROIR["84:8"] = {
  reference: "84:8",
  theme: ["compte", "facilité", "jugement"],
  emotion: "Soulagement, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Yusran"],
  mirrorVersion: `« Il sera jugé avec une grande facilité. » Le miroir promet : « Fa-yuh sabu hisaban yasira » — il sera jugé avec une grande facilité. Le compte facile est la récompense des croyants. Le miroir m'enseigne : la facilité du compte dépend de la préparation.`,
  reflection: `Le compte facile attend les bien préparés. Comment me préparer ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-yuh sabu hisaban yasira » — il sera jugé avec une grande facilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon compte sera-t-il facile ou difficile ? Comment me préparer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du compte vient de la facilité de la vie pieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le compte facile est la miséricorde d'Allah pour Ses serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation constante facilite le compte final." }
  ],
  munajat: `Ya Rabb, fais que mon compte soit facile. Prépare-moi pour la facilité. Ne permets pas que je sois parmi ceux dont le compte est difficile.`
};

MIROIR["84:9"] = {
  reference: "84:9",
  theme: ["retour", "joie", "famille"],
  emotion: "Joie, triomphe",
  difficulty: "débutant",
  relatedNames: ["Al-Inqilab", "Al-Masrur"],
  mirrorVersion: `« Et il retournera joyeux vers sa famille. » Le miroir promet : « Wa yanqalibu ila ahlihi masrura » — et il retournera joyeux vers sa famille. Le retour joyeux est la récompense du succès. Le miroir m'enseigne : la joie finale attend les croyants.`,
  reflection: `Le retour joyeux attend les croyants. La joie finale est la récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yanqalibu ila ahlihi masrura » — et il retournera joyeux vers sa famille." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon retour sera-t-il joyeux ? Vers qui retournerai-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie du retour reflète la joie du compte facile." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La famille au Paradis est la plus belle famille." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le retour vers les bien-aimés au Paradis est la plus grande joie." }
  ],
  munajat: `Ya Rabb, fais que je retourne joyeux vers les miens au Paradis. Donne-moi la joie du succès. Fais que je sois parmi les heureux.`
};

MIROIR["84:10"] = {
  reference: "84:10",
  theme: ["livre", "dos", "honte"],
  emotion: "Honte, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Wara'"],
  mirrorVersion: `« Quant à celui qui recevra son livre derrière son dos. » Le miroir contraste : « Wa amma man utiya kitabahu wara'a zahrihi » — quant à celui qui recevra son livre derrière son dos. Le livre reçu derrière le dos est un signe de honte. Le miroir m'avertit : il y a deux issues — la droite et le dos.`,
  reflection: `Le livre derrière le dos annonce le regret. Quelle sera ma réception ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma man utiya kitabahu wara'a zahrihi » — quant à celui qui recevra son livre derrière son dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment éviter que mon livre me soit donné derrière le dos ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Derrière le dos symbolise la honte et le rejet." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Deux issues — la droite pour le succès, le dos pour l'échec." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le refus de voir son livre annonce le refus d'Allah." }
  ],
  munajat: `Ya Rabb, ne permets pas que je reçoive mon livre derrière le dos. Fais que je le reçoive à droite. Épargne-moi la honte.`
};

MIROIR["84:11"] = {
  reference: "84:11",
  theme: ["destruction", "appel", "regret"],
  emotion: "Désespoir, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Thubur", "Al-Nida'"],
  mirrorVersion: `« Il appellera la destruction sur lui-même. » Le miroir continue : « Fa-yadu'u thuburan » — il appellera la destruction sur lui-même. Le regret est si grand qu'il souhaite sa propre destruction. Le miroir m'avertit : le regret du Jour sera immense pour les perdants.`,
  reflection: `Le regret du Jour sera insupportable. Les perdants souhaiteront la destruction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-yadu'u thuburan » — il appellera la destruction sur lui-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment éviter ce regret insupportable ? La préparation maintenant." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souhait de destruction montre la gravité du regret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le regret des perdants sera plus lourd que la mort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation maintenant évite le regret alors." }
  ],
  munajat: `Ya Rabb, épargne-moi le regret insupportable. Fais que je me prépare maintenant. Ne permets pas que je souhaite ma destruction.`
};

MIROIR["84:12"] = {
  reference: "84:12",
  theme: ["feu", "brûlement", "châtiment"],
  emotion: "Réalité, avertissement",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Nar"],
  mirrorVersion: `« Et il brûlera dans un feu ardent. » Le miroir ajoute : « Wa yasla jahim » — et il brûlera dans un feu ardent. Le regret sera suivi du châtiment. Le miroir m'avertit : la séquence est claire — livre derrière le dos, regret, feu.`,
  reflection: `Le regret sera suivi du feu. La séquence du châtiment est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yasla jahim » — et il brûlera dans un feu ardent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment éviter cette séquence terrible ? La foi et les œuvres." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le brûlement suit le regret — le regret suit le livre derrière le dos." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu de l'enfer est la conséquence du rejet de la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La peur du feu maintenant protège de l'entrée alors." }
  ],
  munajat: `Ya Rabb, protège-moi du feu ardent. Ne permets pas que je brûle. Fais que je sois parmi les sauvés.`
};

MIROIR["84:13"] = {
  reference: "84:13",
  theme: ["joie", "famille", "regret"],
  emotion: "Ironie, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Masrur", "Al-Ahl"],
  mirrorVersion: `« Il était joyeux parmi les siens. » Le miroir contraste : « Innahu kana fi ahlihi masrura » — il était joyeux parmi les siens. La joie temporaire dans ce monde contraste avec le regret éternel. Le miroir m'enseigne : la joie sans foi est une illusion.`,
  reflection: `La joie sans foi dans ce monde mène au regret éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu kana fi ahlihi masrura » — il était joyeux parmi les siens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma joie est-elle fondée sur la foi ? Ou sur l'illusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie sans foi n'est que tristesse différée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vraie joie est celle qui dure — dans la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La joie du croyant continue — la joie du mécréant s'arrête." }
  ],
  munajat: `Ya Rabb, fais que ma joie soit fondée sur la foi. Ne permets pas que je sois joyeux dans l'illusion. Donne-moi la vraie joie.`
};

MIROIR["84:14"] = {
  reference: "84:14",
  theme: ["retour", "croyance", "illusion"],
  emotion: "Réalité, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Ruj'", "Al-Zann"],
  mirrorVersion: `« Il pensait ne jamais retourner vers Allah. » Le miroir diagnostique : « Zanna an lan yahur » — il pensait ne jamais retourner vers Allah. L'illusion de la permanence dans ce monde mène à la négligence. Le miroir m'enseigne : le retour vers Allah est certain — ne l'oubliez pas.`,
  reflection: `Le retour vers Allah est certain. L'illusion du « jamais » est dangereuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Zanna an lan yahur » — il pensait ne jamais retourner vers Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pense que je ne retournerai jamais ? Le retour est certain." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'illusion du « jamais » crée la négligence — la vérité du « toujours » crée la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature retourne à son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le souvenir constant du retour motive la préparation." }
  ],
  munajat: `Ya Rabb, je sais que je retournerai vers Toi. Fais que ce souvenir motive ma préparation. Ne permets pas l'illusion de la permanence.`
};

MIROIR["84:15"] = {
  reference: "84:15",
  theme: ["vision", "Allah", "témoignage"],
  emotion: "Réalité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ru'yah", "Al-Shahid"],
  mirrorVersion: `« Mais si ! Son Seigneur le voyait bien. » Le miroir affirme : « Bala inna rabbahu kana bihi basira » — mais si ! Son Seigneur le voyait bien. Allah voit tout — même quand nous pensons que non. Le miroir m'enseigne : la vision d'Allah est constante — rien n'échappe.`,
  reflection: `Allah nous voit toujours. Rien n'échappe à Sa vue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bala inna rabbahu kana bihi basira » — mais si ! Son Seigneur le voyait bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant qu'Allah me voit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pensée de l'invisibilité est une illusion — Allah voit tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vue d'Allah englobe tout — le caché et le visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la vue d'Allah élève le comportement." }
  ],
  munajat: `Ya Basir, Tu me vois toujours. Fais que je vive en sachant que Tu me vois. Ne permets pas que j'oublie Ta vue.`
};

MIROIR["84:16"] = {
  reference: "84:16",
  theme: ["crépuscule", "serment", "rouge"],
  emotion: "Attention, serment",
  difficulty: "débutant",
  relatedNames: ["Al-Shafaq", "Al-Waqt"],
  mirrorVersion: `« Non ! Je jure par le crépuscule. » Le miroir introduit un serment : « Fa-la uqsimu bil-shafaq » — Non ! Je jure par le crépuscule. Le crépuscule, ce moment où le jour devient nuit, est témoin. Le miroir m'enseigne : chaque moment de la création a sa signification.`,
  reflection: `Le crépuscule est témoin. Chaque moment porte un message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la uqsimu bil-shafaq » — Non ! Je jure par le crépuscule." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prête attention au crépuscule ? À chaque moment de la création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le crépuscule marque la transition — comme le Jour marque la transition de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le crépuscule est un moment sacré — entre le jour et la nuit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Allah jure par le crépuscule — il a Son importance." }
  ],
  munajat: `Ya Rabb, le crépuscule est témoin. Fais que je sois attentif à chaque moment. Ne permets pas que j'ignore les signes de Ta création.`
};

MIROIR["84:17"] = {
  reference: "84:17",
  theme: ["nuit", "rassemblement", "serment"],
  emotion: "Mystère, contemplation",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "Al-Wasq"],
  mirrorVersion: `« Et par la nuit et ce qu'elle rassemble. » Le miroir continue : « Wa al-layli wa ma wasaq » — et par la nuit et ce qu'elle rassemble. La nuit rassemble les créatures qui cherchent le repos. Le miroir m'enseigne : la nuit a ses secrets et ses rassemblements.`,
  reflection: `La nuit rassemble. Elle porte ses secrets.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-layli wa ma wasaq » — et par la nuit et ce qu'elle rassemble." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que la nuit rassemble pour moi ? Repos, réflexion, prière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement de la nuit contraste avec la dispersion du jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est le temps de l'intériorité et du repos." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La nuit rassemble les âmes vers leur Seigneur." }
  ],
  munajat: `Ya Rabb, la nuit rassemble. Fais qu'elle me rassemble vers Toi. Bénis mes nuits de prière et de repos.`
};

MIROIR["84:18"] = {
  reference: "84:18",
  theme: ["lune", "pleine", "serment"],
  emotion: "Beauté, plénitude",
  difficulty: "débutant",
  relatedNames: ["Al-Qamar", "Al-Badr"],
  mirrorVersion: `« Et par la lune quand elle devient pleine. » Le miroir ajoute : « Wa al-qamari idha ittasaq » — et par la lune quand elle devient pleine. La pleine lune symbolise la plénitude, l'accomplissement. Le miroir m'enseigne : la création passe par des cycles de croissance et d'accomplissement.`,
  reflection: `La lune devient pleine. Les cycles de la création enseignent la patience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-qamari idha ittasaq » — et par la lune quand elle devient pleine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte les cycles ? Croissance, plénitude, déclin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La plénitude suit la croissance — la croissance demande patience." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lune pleine éclaire la nuit — comme la foi éclaire l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'accomplissement vient après les phases de croissance." }
  ],
  munajat: `Ya Rabb, la lune devient pleine. Fais que je passe par les phases de croissance. Donne-moi la patience d'atteindre la plénitude.`
};

MIROIR["84:19"] = {
  reference: "84:19",
  theme: ["transit", "montée", "étapes"],
  emotion: "Mouvement, progression",
  difficulty: "débutant",
  relatedNames: ["Al-Tabaq", "Al-Su'ud"],
  mirrorVersion: `« Vous passerez de niveau en niveau. » Le miroir affirme : « La-tarkabunna tabaqan 'an tabaq » — vous passerez de niveau en niveau. La vie est une montée par étapes. Chaque niveau est une épreuve et une opportunité. Le miroir m'enseigne : la progression est la loi de l'existence.`,
  reflection: `Nous passons de niveau en niveau. La vie est une montée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-tarkabunna tabaqan 'an tabaq » — vous passerez de niveau en niveau." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quel niveau suis-je ? Quel est le prochain ? Comment monter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque niveau est une épreuve — chaque montée une victoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création progresse — l'homme le plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La montée spirituelle est la plus grande montée." }
  ],
  munajat: `Ya Rabb, fais que je monte de niveau en niveau. Aide-moi dans les étapes. Ne permets pas que je descende.`
};

MIROIR["84:20"] = {
  reference: "84:20",
  theme: ["croyance", "révélation", "question"],
  emotion: "Questionnement, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Qur'an"],
  mirrorVersion: `« Qu'ont-ils donc à ne pas croire ? » Le miroir questionne : « Fa-ma lahum la yu'minun » — qu'ont-ils donc à ne pas croire ? La question interpelle ceux qui rejettent la foi. Le miroir m'enseigne : le rejet de la foi n'a pas de sens logique.`,
  reflection: `Le rejet de la foi n'a pas de sens. Pourquoi ne pas croire ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma lahum la yu'minun » — qu'ont-ils donc à ne pas croire ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment ? Ou est-ce que je résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question montre que la foi est la réponse logique." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière croit — seul l'homme résiste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi est la réponse naturelle du cœur sain." }
  ],
  munajat: `Ya Rabb, je crois. Fais que ma foi soit vraie. Ne permets pas que je résiste à la vérité.`
};

MIROIR["84:21"] = {
  reference: "84:21",
  theme: ["prosternation", "Coran", "adoration"],
  emotion: "Révérence, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Sujud", "Al-Qur'an"],
  mirrorVersion: `« Et à ne pas se prosterner quand on leur récite le Coran ? » Le miroir continue : « Wa idha quri'a 'alayhim al-Qur'anu la yasjudun » — et à ne pas se prosterner quand on leur récite le Coran ? La prosternation est la réponse naturelle à la Parole d'Allah. Le miroir m'enseigne : le Coran mérite notre soumission.`,
  reflection: `Le Coran mérite la prosternation. Comment je réagis quand je l'entends ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idha quri'a 'alayhim al-Qur'anu la yasjudun » — et à ne pas se prosterner quand on leur récite le Coran ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis quand j'entends le Coran ? Est-ce que je me prosterne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation est la réponse du corps à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui est dans les cieux et la terre se prosterne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prosternation du cœur précède la prosternation du corps." }
  ],
  munajat: `Ya Rabb, fais que je me prosterne devant Ton Livre. Fais que mon cœur et mon corps se soumettent. Ne permets pas que je résiste.`
};

MIROIR["84:22"] = {
  reference: "84:22",
  theme: ["mécréance", "orgueil", "rejet"],
  emotion: "Constat, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Kufr", "Al-Takabbur"],
  mirrorVersion: `« Mais ceux qui ont mécru traitent de mensonge. » Le miroir constate : « Bala alladhina kafaru yukadhdhibun » — mais ceux qui ont mécru traitent de mensonge. Le rejet n'est pas rationnel — il est spirituel. Le miroir m'enseigne : la mécréance est un choix du cœur.`,
  reflection: `Le rejet est un choix du cœur, pas une conclusion de l'esprit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bala alladhina kafaru yukadhdhibun » — mais ceux qui ont mécru traitent de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite de mensonge ce qui est vrai ? Pourquoi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le traitement de mensonge révèle le mensonge dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste vraie — même quand on la traite de mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur qui accepte reconnaît la vérité." }
  ],
  munajat: `Ya Rabb, ne permets pas que je traite Ta vérité de mensonge. Ouvre mon cœur à l'acceptation. Fais que je reconnaisse la vérité.`
};

MIROIR["84:23"] = {
  reference: "84:23",
  theme: ["science", "Allah", "cœur"],
  emotion: "Réalité, connaissance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Et Allah sait bien ce qu'ils cachent. » Le miroir révèle : « Wa-Allahu a'lamu bima yu'inun » — et Allah sait bien ce qu'ils cachent. Rien n'est caché d'Allah — même les secrets du cœur. Le miroir m'enseigne : la science d'Allah englobe tout.`,
  reflection: `Allah sait ce qui est caché. Rien ne Lui échappe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa-Allahu a'lamu bima yu'inun » — et Allah sait bien ce qu'ils cachent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je cache ? Allah le sait — pourquoi cacher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le caché est révélé à Allah — le secret est public pour Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La science d'Allah couvre tout — le caché et le visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La transparence avec Allah est la clé de la paix." }
  ],
  munajat: `Ya 'Alim, Tu sais ce que je cache. Fais que je sois transparent avec Toi. Ne permets pas que je cache ce qui devrait être révélé.`
};

MIROIR["84:24"] = {
  reference: "84:24",
  theme: ["annonce", "châtiment", "douleur"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Naba'", "Al-'Adhab"],
  mirrorVersion: `« Annonce-leur donc un châtiment douloureux. » Le miroir avertit : « Fa-bashshirhum bi-'adhabin alim » — annonce-leur donc un châtiment douloureux. L'annonce du châtiment est une miséricorde — elle permet le changement. Le miroir m'enseigne : l'avertissement précède le châtiment.`,
  reflection: `L'avertissement est une miséricorde. Le châtiment suit le rejet de l'avertissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-bashshirhum bi-'adhabin alim » — annonce-leur donc un châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute les avertissements ? Ou est-ce que je les rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'annonce du châtiment est une chance de l'éviter." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah inclut l'avertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute l'avertissement échappe au châtiment." }
  ],
  munajat: `Ya Rabb, j'écoute Ton avertissement. Fais que je change avant qu'il soit trop tard. Ne permets pas que je subisse le châtiment douloureux.`
};

MIROIR["84:25"] = {
  reference: "84:25",
  theme: ["foi", "œuvres", "récompense"],
  emotion: "Espoir, promesse",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Salihat"],
  mirrorVersion: `« Sauf ceux qui croient et font de bonnes œuvres. » Le miroir ouvre une porte : « Illa alladhina amanu wa 'amilu al-salihat » — sauf ceux qui croient et font de bonnes œuvres. L'exception est l'espoir. La foi et les œuvres sont le chemin du salut. Le miroir m'enseigne : il y a toujours une issue pour les croyants.`,
  reflection: `La foi et les œuvres ouvrent la porte du salut. Il y a toujours une issue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina amanu wa 'amilu al-salihat » — sauf ceux qui croient et font de bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi ces exceptions ? Ma foi et mes œuvres sont-elles authentiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exception est la règle pour les croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est ouverte à tous ceux qui croient et agissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La foi sans œuvres est incomplète — les œuvres sans foi sont vides." }
  ],
  munajat: `Ya Rabb, je crois et je veux faire de bonnes œuvres. Accepte ma foi et mes œuvres. Fais que je sois parmi les exceptions.`
};

// ==================== SURAH 7: AL-A'RAF - ADDITIONAL ENTRIES ====================

MIROIR["7:2"] = {
  reference: "7:2",
  theme: ["livre", "révélation", "avertissement"],
  emotion: "Gravité, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Nadh"],
  mirrorVersion: `« Un Livre qui t'a été révélé — qu'il n'y ait pas de gêne dans ton cœur à cause de lui. » Le miroir m'adresse le message : « Kitabun unzila ilayka fala yakun fi sadrika harajun minhu » — un Livre qui t'a été révélé — qu'il n'y ait pas de gêne dans ton cœur à cause de lui. Le Coran n'est pas un fardeau — il est une libération. Le miroir m'enseigne : la révélation est un cadeau, pas une contrainte.`,
  reflection: `Le Coran n'est pas un fardeau. Il est une libération.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kitabun unzila ilayka fala yakun fi sadrika harajun minhu » — un Livre qui t'a été révélé — qu'il n'y ait pas de gêne dans ton cœur à cause de lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois le Coran comme un fardeau ou une libération ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gêne dans le cœur vient de la résistance — la paix vient de l'acceptation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le guide — pas l'obstacle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur ouvert au Coran trouve la paix." }
  ],
  munajat: `Ya Rabb, fais que je voie Ton Livre comme un cadeau. Enlève toute gêne de mon cœur. Fais que je l'accepte avec joie.`
};

MIROIR["7:3"] = {
  reference: "7:3",
  theme: ["suivi", "révélation", "guidance"],
  emotion: "Obéissance, chemin",
  difficulty: "débutant",
  relatedNames: ["Al-Ittiba'", "Al-Huda"],
  mirrorVersion: `« Suivez ce qui vous a été révélé de la part de votre Seigneur. » Le miroir commande : « Ittabi'u ma unzila ilaykum min rabbikum » — suivez ce qui vous a été révélé de la part de votre Seigneur. La guidance est claire — le suivi est nécessaire. Le miroir m'enseigne : la révélation demande l'action, pas seulement la lecture.`,
  reflection: `La révélation demande le suivi. L'action suit la lecture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ittabi'u ma unzila ilaykum min rabbikum » — suivez ce qui vous a été révélé de la part de votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis ce que je lis ? Ou est-ce que je lis sans suivre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le suivi transforme la lecture en vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance est un chemin — pas une information." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit ce qu'il lit change." }
  ],
  munajat: `Ya Rabb, fais que je suive ce que Tu as révélé. Ne permets pas que je lise sans agir. Transforme ma lecture en vie.`
};

MIROIR["7:4"] = {
  reference: "7:4",
  theme: ["destruction", "cités", "précédents"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qura", "Al-Halak"],
  mirrorVersion: `« Que de cités Nous avons détruites ! » Le miroir avertit : « Wa kam min qaryatin ahlaknaha » — que de cités Nous avons détruites ! L'histoire est remplie de leçons. Les civilisations passées ont péri par leur rejet. Le miroir m'enseigne : personne n'est à l'abri du châtiment.`,
  reflection: `Les cités ont péri. Personne n'est à l'abri.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kam min qaryatin ahlaknaha » — que de cités Nous avons détruites !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui a causé la destruction des cités ? Suis-je à l'abri ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction des autres est un avertissement pour nous." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est le témoin — les ruines sont les preuves." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des erreurs des autres ne les répète pas." }
  ],
  munajat: `Ya Rabb, les cités ont péri par leur rejet. Fais que j'apprenne de leur sort. Ne permets pas que je sois parmi les destructibles.`
};

MIROIR["7:5"] = {
  reference: "7:5",
  theme: ["châtiment", "nuit", "supplication"],
  emotion: "Regret, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ba's", "Al-Du'a'"],
  mirrorVersion: `« Notre châtiment les a atteints pendant la nuit ou pendant qu'ils faisaient la sieste. » Le miroir décrit : « Fa-jaa'aha ba'suna bayatan aw hum qa'ilun » — Notre châtiment les a atteints pendant la nuit ou pendant qu'ils faisaient la sieste. Le châtiment vient à l'improviste. Le miroir m'enseigne : personne ne sait quand le châtiment viendra.`,
  reflection: `Le châtiment vient à l'improviste. La préparation est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-jaa'aha ba'suna bayatan aw hum qa'ilun » — Notre châtiment les a atteints pendant la nuit ou pendant qu'ils faisaient la sieste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt si le châtiment vient maintenant ? Cette nuit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le moment inattendu du châtiment montre qu'il n'y a pas de sécurité sans foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jour et la nuit — tous les moments sont possibles pour le châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation constante est la seule sécurité." }
  ],
  munajat: `Ya Rabb, le châtiment peut venir à tout moment. Prépare-moi. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["7:6"] = {
  reference: "7:6",
  theme: ["question", "messagers", "responsabilité"],
  emotion: "Responsabilité, examen",
  difficulty: "débutant",
  relatedNames: ["Al-Su'al", "Al-Rusul"],
  mirrorVersion: `« Nous leur demanderons compte, et Nous interrogerons les messagers. » Le miroir affirme : « Fa-lanas'alanna alladhina ursila ilayhim wa la-nas'alanna al-mursalina » — Nous leur demanderons compte, et Nous interrogerons les messagers. Le compte est pour tous — les peuples et les prophètes. Le miroir m'enseigne : personne n'échappe au compte.`,
  reflection: `Le compte est pour tous. Personne n'y échappe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-lanas'alanna alladhina ursila ilayhim wa la-nas'alanna al-mursalina » — Nous leur demanderons compte, et Nous interrogerons les messagers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le compte ? Qu'est-ce que je dirai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interrogatoire des messagers inclut l'interrogatoire sur leur transmission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le compte est universel — messagers et peuples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La préparation pour le compte commence maintenant." }
  ],
  munajat: `Ya Rabb, Tu demanderas des comptes. Prépare-moi pour l'interrogatoire. Fais que je sois prêt à répondre.`
};

MIROIR["7:7"] = {
  reference: "7:7",
  theme: ["récit", "science", "vérité"],
  emotion: "Certitude, connaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Qasas", "Al-'Ilm"],
  mirrorVersion: `« Nous leur raconterons en toute connaissance ce qu'ils faisaient. » Le miroir promet : « Fa-naqussanna 'alayhim bi-'ilmin wa ma kunna gha'ibin » — Nous leur raconterons en toute connaissance ce qu'ils faisaient. Le récit divin est basé sur la science parfaite. Le miroir m'enseigne : rien n'échappe à la connaissance d'Allah.`,
  reflection: `Allah sait tout ce que nous faisons. Le récit sera exact.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-naqussanna 'alayhim bi-'ilmin wa ma kunna gha'ibin » — Nous leur raconterons en toute connaissance ce qu'ils faisaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que le récit dira de moi ? Suis-je prêt pour la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le récit de nos actions par Allah est le plus précis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La science d'Allah englobe tout — rien n'est oublié." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vérité sur nous-même sera révélée par le Meilleur Connaisseur." }
  ],
  munajat: `Ya 'Alim, Tu connais tout ce que je fais. Fais que je vive en sachant que Tu vois. Ne permets pas que je cache ce qui sera révélé.`
};

MIROIR["7:8"] = {
  reference: "7:8",
  theme: ["balance", "poids", "jour"],
  emotion: "Justice, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Mizan", "Al-Wazn"],
  mirrorVersion: `« La balance, ce jour-là, sera la vérité. » Le miroir affirme : « Wa al-waznu yawma'idhin al-haqq » — la balance, ce jour-là, sera la vérité. La balance du Jour est juste — elle ne peut mentir. Le miroir m'enseigne : la justice d'Allah est parfaite.`,
  reflection: `La balance du Jour est la vérité. La justice est parfaite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-waznu yawma'idhin al-haqq » — la balance, ce jour-là, sera la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment sera mon poids dans la balance ? Que pèsent mes œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité de la balance montre la réalité des œuvres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La balance divine pèse avec précision et justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont les œuvres sont lourds maintenant sera léger alors." }
  ],
  munajat: `Ya Rabb, fais que mes œuvres soient lourdes dans la balance. Donne-moi les œuvres qui pèsent. Ne permets pas que je sois léger.`
};

MIROIR["7:9"] = {
  reference: "7:9",
  theme: ["légèreté", "perte", "balance"],
  emotion: "Perte, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Khaffah", "Al-Khasarah"],
  mirrorVersion: `« Ceux dont les œuvres pèseront lourd seront les gagnants. » Le miroir promet : « Fa-man thaqulat mawazinuhu fa-ula'ika hum al-muflihun » — ceux dont les œuvres pèseront lourd seront les gagnants. Le succès dépend du poids des œuvres. Le miroir m'enseigne : la réussite se mesure.`,
  reflection: `Le succès dépend du poids des œuvres. Comment alourdir mes œuvres ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man thaqulat mawazinuhu fa-ula'ika hum al-muflihun » — ceux dont les œuvres pèseront lourd seront les gagnants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment alourdir mes œuvres ? Qu'est-ce qui pèse vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La lourdeur des œuvres vient de la sincérité et de la constance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La balance divine ne trompe pas — elle révèle la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les œuvres lourdes sont celles faites pour Allah seul." }
  ],
  munajat: `Ya Rabb, fais que mes œuvres soient lourdes. Donne-moi la sincérité qui pèse. Fais que je sois parmi les gagnants.`
};

MIROIR["7:10"] = {
  reference: "7:10",
  theme: ["pouvoir", "terre", "ingratitude"],
  emotion: "Questionnement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Mulk", "Al-Ard"],
  mirrorVersion: `« Ne vous avons-Nous pas donné le pouvoir sur terre ? » Le miroir questionne : « Wa laqad makkannakum fi al-ard » — ne vous avons-Nous pas donné le pouvoir sur terre ? La question rappelle les bienfaits. Le pouvoir sur terre est un cadeau. Le miroir m'enseigne : les bienfaits doivent être reconnus.`,
  reflection: `Le pouvoir sur terre est un cadeau. Le reconnaissons-nous ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad makkannakum fi al-ard » — ne vous avons-Nous pas donné le pouvoir sur terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels pouvoirs ai-je sur terre ? Est-ce que je remercie pour eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pouvoir est un test — la gratitude est la réponse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme a reçu le pouvoir — il doit l'utiliser avec responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour le pouvoir garantit sa continuation." }
  ],
  munajat: `Ya Rabb, merci pour le pouvoir que Tu m'as donné. Fais que je l'utilise avec gratitude et responsabilité. Ne permets pas l'ingratitude.`
};

// ==================== SURAH 6: AL-AN'AM - MISSING ENTRIES ====================

MIROIR["6:130"] = {
  reference: "6:130",
  theme: ["assemblée", "djinn", "responsabilité"],
  emotion: "Responsabilité, examen",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jinn", "Al-Ins"],
  mirrorVersion: `« Ô assemblée de djinns et d'hommes ! » Le miroir convoque : « Ya ma'shara al-jinni wa al-ins » — ô assemblée de djinns et d'hommes ! L'appel est universel. Djinn et hommes sont responsables. Le miroir m'enseigne : la responsabilité concerne tous les êtres doués de raison.`,
  reflection: `L'appel est pour tous. La responsabilité est universelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ma'shara al-jinni wa al-ins » — ô assemblée de djinns et d'hommes !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour l'assemblée ? Qu'est-ce que je répondrai ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'assemblée des deux créatures montre l'égalité dans la responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Djinn et hommes partagent la même responsabilité devant Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de l'assemblée préparatoire guide l'action." }
  ],
  munajat: `Ya Rabb, prépare-moi pour l'assemblée. Fais que je sois parmi ceux qui répondent correctement. Ne permets pas que je sois parmi les perdants.`
};

MIROIR["6:131"] = {
  reference: "6:131",
  theme: ["justice", "avertissement", "messagers"],
  emotion: "Justice, miséricorde",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Rusul"],
  mirrorVersion: `« Ainsi, ton Seigneur n'est pas Celui qui détruit les cités injustement. » Le miroir clarifie : « Dhālika an lam yakun rabbuka muhlika al-qura » — ainsi, ton Seigneur n'est pas Celui qui détruit les cités injustement. La destruction ne vient qu'après l'avertissement. Le miroir m'enseigne : la justice d'Allah précède le châtiment.`,
  reflection: `Allah ne détruit pas sans raison. L'avertissement précède toujours.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhālika an lam yakun rabbuka muhlika al-qura » — ainsi, ton Seigneur n'est pas Celui qui détruit les cités injustement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je reçu des avertissements ? Les ai-je écoutés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La non-destruction injuste montre la miséricorde d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine attend que l'avertissement soit donné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'avertissement est une miséricorde avant d'être une condamnation." }
  ],
  munajat: `Ya Rabb, Tu es juste. Merci pour les avertissements. Fais que je les écoute et que je change. Ne permets pas que je les ignore.`
};

MIROIR["6:132"] = {
  reference: "6:132",
  theme: ["degrés", "œuvres", "récompense"],
  emotion: "Motivation, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Darajat", "Al-A'mal"],
  mirrorVersion: `« Pour tous, il y a des degrés selon ce qu'ils font. » Le miroir promet : « Wa likullin darajatun mimma 'amilu » — pour tous, il y a des degrés selon ce qu'ils font. Les degrés correspondent aux œuvres. Le miroir m'enseigne : l'effort est récompensé.`,
  reflection: `Les degrés sont selon les œuvres. L'effort compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa likullin darajatun mimma 'amilu » — pour tous, il y a des degrés selon ce qu'ils font." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel degré je vise ? Mes œuvres correspondent-elles à mon but ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les degrés montrent que chaque effort compte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine récompense chaque action." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le degré le plus élevé est pour les œuvres les plus sincères." }
  ],
  munajat: `Ya Rabb, je veux le degré le plus élevé. Donne-moi les œuvres qui y mènent. Fais que je ne sois pas paresseux.`
};

MIROIR["6:133"] = {
  reference: "6:133",
  theme: ["indépendance", "remplacement", "miséricorde"],
  emotion: "Humilité, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ghani", "Ar-Rahman"],
  mirrorVersion: `« Ton Seigneur est le Suffisant, le Détenteur de la miséricorde. » Le miroir révèle : « Wa rabbuka al-ghaniyyu dhu al-rahma » — ton Seigneur est le Suffisant, le Détenteur de la miséricorde. Allah n'a besoin de rien. Sa miséricorde est un don. Le miroir m'enseigne : notre existence est un cadeau, pas une nécessité.`,
  reflection: `Allah n'a pas besoin de nous. Sa miséricorde est un cadeau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa rabbuka al-ghaniyyu dhu al-rahma » — ton Seigneur est le Suffisant, le Détenteur de la miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si Allah n'a pas besoin de moi, pourquoi suis-je ici ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La suffisance d'Allah rend Sa miséricorde plus précieuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est un acte de miséricorde, pas de besoin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de la suffisance divine mène à la gratitude." }
  ],
  munajat: `Ya Ghani, Tu n'as pas besoin de moi. Merci de m'avoir créé. Fais que je vive en gratitude. Ne permets pas l'oubli.`
};

MIROIR["6:134"] = {
  reference: "6:134",
  theme: ["promesse", "menace", "question"],
  emotion: "Certitude, préparation",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Wa'id"],
  mirrorVersion: `« Ce qui vous a été promis s'approche. » Le miroir avertit : « Inna ma tu'aduna la at » — ce qui vous a été promis s'approche. La promesse est proche. Le temps presse. Le miroir m'enseigne : l'au-delà n'est pas loin.`,
  reflection: `La promesse s'approche. Le temps presse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ma tu'aduna la at » — ce qui vous a été promis s'approche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si la promesse s'approche, suis-je prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'approche de la promesse doit accélérer la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est relatif — la promesse est proche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de l'approche transforme chaque jour." }
  ],
  munajat: `Ya Rabb, la promesse s'approche. Prépare-moi. Fais que je sois prêt pour ce qui vient. Ne permets pas que je sois surpris.`
};

MIROIR["6:135"] = {
  reference: "6:135",
  theme: ["jugement", "séparation", "vérité"],
  emotion: "Résolution, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Fasl", "Al-Haqq"],
  mirrorVersion: `« Votre Seigneur tranchera entre vous le Jour de la Résurrection. » Le miroir affirme : « Sayafsilu baynakum rabbukum yawma al-qiyama » — votre Seigneur tranchera entre vous le Jour de la Résurrection. Le jugement appartient à Allah. Le miroir m'enseigne : les disputes d'ici-bas seront réglées là-bas.`,
  reflection: `Le jugement appartient à Allah. Les disputes seront réglées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sayafsilu baynakum rabbukum yawma al-qiyama » — votre Seigneur tranchera entre vous le Jour de la Résurrection." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles disputes j'attends de voir tranchées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement différé est une miséricorde pour se repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour tranchera toutes les disputes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'attente du jugement doit inspirer la justice maintenant." }
  ],
  munajat: `Ya Rabb, Tu trancheras entre nous. Fais que je sois du bon côté. Ne permets pas que je sois parmi les injustes.`
};

MIROIR["6:136"] = {
  reference: "6:136",
  theme: ["association", "partage", "égarement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shirk", "Al-Haqq"],
  mirrorVersion: `« Ils ont attribué à Allah une part de ce qu'Il a créé. » Le miroir déplore : « Wa ja'alu lillahi mimma dhara'a min al-harthi wa al-an'ami nasiban » — ils ont attribué à Allah une part de ce qu'Il a créé. L'association est l'erreur suprême. Le miroir m'enseigne : tout appartient à Allah.`,
  reflection: `Tout appartient à Allah. Lui attribuer une part est absurde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'alu lillahi mimma dhara'a min al-harthi wa al-an'ami nasiban » — ils ont attribué à Allah une part de ce qu'Il a créé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je partage ce qui appartient entièrement à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La part attribuée à Allah devrait être tout, pas une portion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création entière appartient au Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La reconnaissance de la propriété d'Allah libère." }
  ],
  munajat: `Ya Rabb, tout T'appartient. Fais que je reconnaisse Ta souveraineté totale. Ne permets pas que je partage ce qui est Tien.`
};

MIROIR["6:137"] = {
  reference: "6:137",
  theme: ["égarement", "enfants", "satan"],
  emotion: "Horreur, protection",
  difficulty: "avancé",
  relatedNames: ["Al-Shaytan", "Al-Walad"],
  mirrorVersion: `« Ainsi, leurs associés ont rendu belles à leurs yeux le meurtre de leurs enfants. » Le miroir révèle : « Wa kadhalika zayyana likathirin min al-mushrikin qatla awladihim » — ainsi, leurs associés ont rendu belles à leurs yeux le meurtre de leurs enfants. L'égarement peut aller jusqu'à l'infanticide. Le miroir m'enseigne : le mal peut se déguiser en bien.`,
  reflection: `Le mal peut sembler bon. La guidance est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika zayyana likathirin min al-mushrikin qatla awladihim » — ainsi, leurs associés ont rendu belles à leurs yeux le meurtre de leurs enfants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles choses mauvaises me semblent bonnes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'embellissement du mal montre la puissance de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance protège du mal déguisé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière pour la protection contre l'égarement est vitale." }
  ],
  munajat: `Ya Rabb, protège-moi de l'égarement. Ne permets pas que je voie le mal comme bien. Guide-moi vers la vérité.`
};

MIROIR["6:138"] = {
  reference: "6:138",
  theme: ["interdits", "innovation", "fausses croyances"],
  emotion: "Mise en garde, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hurum", "Al-Bid'ah"],
  mirrorVersion: `« Ils disent : ces bêtes et ces récoltes sont interdites. » Le miroir rapporte : « Wa qalu hadhihi an'amun wa harthun hijrun » — ils disent : ces bêtes et ces récoltes sont interdites. Les interdits inventés sont des mensonges. Le miroir m'enseigne : seul Allah peut interdire.`,
  reflection: `Seul Allah peut interdire. Les innovations sont des mensonges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu hadhihi an'amun wa harthun hijrun » — ils disent : ces bêtes et ces récoltes sont interdites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels interdits ai-je inventés ? Qu'ai-je rajouté à la religion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invention d'interdits est un vol de l'autorité divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La loi appartient à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La soumission implique l'acceptation des limites divines seulement." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'invente des interdits. Fais que je me soumette à Ta loi seule. Éloigne-moi des innovations.`
};

MIROIR["6:139"] = {
  reference: "6:139",
  theme: ["mensonge", "interdits", "invention"],
  emotion: "Réalité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kadhib", "Al-Halal"],
  mirrorVersion: `« Ils disent : ce qui est dans le ventre de ces bêtes est réservé à nos hommes. » Le miroir dénonce : « Wa qalu ma fi butuni hadhihi al-an'ami khalisatun li-dhukurina » — ils disent : ce qui est dans le ventre de ces bêtes est réservé à nos hommes. Les inventions religieuses sont des mensonges. Le miroir m'enseigne : la religion n'est pas un jouet.`,
  reflection: `La religion n'est pas un jouet. Les inventions sont des mensonges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu ma fi butuni hadhihi al-an'ami khalisatun li-dhukurina » — ils disent : ce qui est dans le ventre de ces bêtes est réservé à nos hommes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles inventions ai-je acceptées comme religion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invention religieuse est une forme d'association." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion est pure — les inventions la souillent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le retour à la source est la protection contre l'invention." }
  ],
  munajat: `Ya Rabb, protège-moi des inventions. Fais que je retourne à Ta source pure. Ne permets pas que j'ajoute à Ta religion.`
};

MIROIR["6:140"] = {
  reference: "6:140",
  theme: ["perdition", "interdits", "égarement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khasarah", "Al-Halal"],
  mirrorVersion: `« Ceux qui ont tué leurs enfants foolishly sont perdus. » Le miroir condamne : « Qad khasira alladhina qatalu awladahum saya'an » — ceux qui ont tué leurs enfants foolishly sont perdus. La perte est le sort de l'égarement. Le miroir m'enseigne : l'égarement mène à la perdition.`,
  reflection: `L'égarement mène à la perdition. La guidance est le salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad khasira alladhina qatalu awladahum saya'an » — ceux qui ont tué leurs enfants foolishly sont perdus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles formes de perte menace ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte est le résultat de l'éloignement d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La perdition attend ceux qui s'égarent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience de la perte potentielle guide vers le salut." }
  ],
  munajat: `Ya Rabb, je cherche la protection contre la perdition. Guide-moi. Ne permets pas que je sois parmi les perdants.`
};

MIROIR["6:142"] = {
  reference: "6:142",
  theme: ["bétail", "provision", "gratitude"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-An'am"],
  mirrorVersion: `« Et parmi les bestiaux, certains portent des fardeaux et d'autres servent à la viande. » Le miroir énumère : « Wa min al-an'ami hamulatan wa farshan » — et parmi les bestiaux, certains portent des fardeaux et d'autres servent à la viande. La diversité des bienfaits est manifeste. Le miroir m'enseigne : chaque créature a sa fonction.`,
  reflection: `La diversité des créatures montre la sagesse du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min al-an'ami hamulatan wa farshan » — et parmi les bestiaux, certains portent des fardeaux et d'autres servent à la viande." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits divers ai-je reçus ? Est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité des fonctions montre la sagesse de l'organisation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature a sa place dans le plan divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude pour chaque fonction mène à la compréhension." }
  ],
  munajat: `Ya Razzaq, merci pour les bestiaux et leurs diverses fonctions. Fais que je sois reconnaissant. Ne permets pas l'ingratitude.`
};

MIROIR["6:143"] = {
  reference: "6:143",
  theme: ["paires", "interdits", "question"],
  emotion: "Interrogation, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Thamaniyat", "Al-Azwaj"],
  mirrorVersion: `« Huit paires : deux brebis et deux chèvres. » Le miroir détaille : « Thamaniyata azwajin mina al-da'ni athnayni » — huit paires : deux brebis et deux chèvres. La création est organisée en paires. Le miroir m'enseigne : l'organisation divine est parfaite.`,
  reflection: `La création en paires montre l'ordre divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thamaniyata azwajin mina al-da'ni athnayni » — huit paires : deux brebis et deux chèvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment cette organisation me parle-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les paires montrent la dualité dans l'unité de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est organisée avec sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'ordre dans la création reflète l'Ordronnateur." }
  ],
  munajat: `Ya Rabb, merci pour l'ordre dans la création. Fais que je voie Ta sagesse partout. Ne permets pas que je sois aveugle.`
};

MIROIR["6:144"] = {
