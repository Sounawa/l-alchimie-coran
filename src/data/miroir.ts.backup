  difficulty: "débutant",
  relatedNames: ["Al-Qulub", "Al-Ikhwan"],
  mirrorVersion: `« Nous aurons retiré la rancune de leurs cœurs, et ils seront comme frères sur des lits. » Le miroir me montre la purification des cœurs au paradis. « Wa naza'na ma fi sudurihim min ghillin » — nous aurons retiré la rancune de leurs cœurs. La purification est totale. Le miroir m'interroge : est-ce que je purifie mon cœur maintenant ?`,
  reflection: `La purification des cœurs commence maintenant. Le paradis en est l'accomplissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa naza'na ma fi sudurihim min ghillin ikhwanan 'ala sururin mutaqabilin » — nous aurons retiré la rancune de leurs cœurs, et ils seront comme frères sur des lits, face à face." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je purifie mon cœur maintenant ? Ou est-ce que je garde la rancune ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La purification du cœur commence par le pardon." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cœurs purs sont des frères au paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui purifie son cœur goûte au paradis dès maintenant." }
  ],
  munajat: `Ya Rabb, je veux purifier mon cœur. Ne permets pas la rancune en moi. Donne-moi un cœur pur qui aime et pardonne.`
};

MIROIR["15:48"] = {
  reference: "15:48",
  theme: ["fatigue", "paradis", "éternité"],
  emotion: "Espérance, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Khulud"],
  mirrorVersion: `« Nulle fatigue ne les y touchera, et ils ne seront jamais évincés. » Le miroir me montre le repos éternel. « La yamassuhum fiha nasab » — nulle fatigue ne les y touchera. Le repos est éternel. Le miroir m'interroge : est-ce que j'œuvre pour ce repos ?`,
  reflection: `Le repos éternel attend les croyants. Œuvrer pour ce repos est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yamassuhum fiha nasabun wa ma hum minha bi-mukhrajin » — nulle fatigue ne les y touchera, et ils ne seront jamais évincés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'œuvre pour ce repos ? Ou est-ce que je me fatigue pour ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir du repos éternel motive l'effort temporaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La fatigue de ce monde prépare le repos de l'au-delà." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le repos éternel ne se fatigue pas en vain." }
  ],
  munajat: `Ya Rabb, j'œuvre pour le repos éternel. Ne permets pas que je me fatigue pour ce monde. Donne-moi la force de travailler pour Ton paradis.`
};

MIROIR["15:50"] = {
  reference: "15:50",
  theme: ["châtiment", "mécréance", "certitude"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Al-Kufr"],
  mirrorVersion: `« Et que Mon châtiment est le châtiment douloureux. » Le miroir me montre la réalité du châtiment. « Wa anna 'adhabi huwa al-'adhabu al-alim » — et que Mon châtiment est le châtiment douloureux. Le châtiment est certain pour les mécréants. Le miroir m'interroge : est-ce que je crains ce châtiment ?`,
  reflection: `Le châtiment est certain pour les mécréants. La foi est la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa anna 'adhabi huwa al-'adhabu al-alim » — et que Mon châtiment est le châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce châtiment ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du châtiment motive la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment est le destin des mécréants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit est protégé du châtiment." }
  ],
  munajat: `Ya Rabb, je crains Ton châtiment. Ne permets pas l'insouciance dans mon cœur. Protège-moi par la foi.`
};

MIROIR["15:51"] = {
  reference: "15:51",
  theme: ["ibrahim", "hôtes", "bonne nouvelle"],
  emotion: "Espérance, bénédiction",
  difficulty: "débutant",
  relatedNames: ["Ibrahim", "Al-Dhayf"],
  mirrorVersion: `« Informe-les des hôtes d'Abraham. » Le miroir me montre l'hospitalité d'Abraham. « Wa nabbi'hum 'an dayfi ibrahim » — informe-les des hôtes d'Abraham. L'hospitalité est bénie. Le miroir m'interroge : est-ce que j'honore mes hôtes ?`,
  reflection: `L'hospitalité d'Abraham est un modèle. Honorer les hôtes est une bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa nabbi'hum 'an dayfi ibrahim » — informe-les des hôtes d'Abraham." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'honore mes hôtes ? Ou est-ce que je néglige ce devoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hospitalité est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les hôtes d'Abraham étaient des anges." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore ses hôtes reçoit des bénédictions." }
  ],
  munajat: `Ya Rabb, je veux honorer mes hôtes comme Abraham. Ne permets pas que je néglige ce devoir. Bénis mon hospitalité.`
};

MIROIR["15:52"] = {
  reference: "15:52",
  theme: ["anges", "salutation", "paix"],
  emotion: "Paix, bénédiction",
  difficulty: "débutant",
  relatedNames: ["Al-Mala'ikah", "As-Salam"],
  mirrorVersion: `« Quand ils entrèrent chez lui et dirent : "Salam", il dit : "Nous avons peur de vous." » Le miroir me montre la rencontre d'Abraham avec les anges. « Idh dakhalu 'alayhi fa-qalu salam » — quand ils entrèrent chez lui et dirent : Salam. La salutation de paix. Le miroir m'interroge : est-ce que je salue par la paix ?`,
  reflection: `La salutation de paix est une bénédiction. La pratiquer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh dakhalu 'alayhi fa-qalu salaman qala inna minnakum wajilun » — quand ils entrèrent chez lui et dirent : Salam, il dit : Nous avons peur de vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je salue par la paix ? Ou est-ce que je néglige cette sunnah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La salutation de paix apaise les cœurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges saluent par la paix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui salue par la paix reçoit la paix." }
  ],
  munajat: `Ya Salam, je veux saluer par la paix. Ne permets pas que je néglige cette sunnah. Donne-moi la paix dans mes salutations.`
};

// ==================== SURAH 40 (GHAFIR) - COMPLETE COVERAGE ====================

MIROIR["40:1"] = {
  reference: "40:1",
  theme: ["révélation", "méricorde", "sagesse"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Aziz"],
  mirrorVersion: `« Ha, Mim. La révélation du Livre vient d'Allah, le Puissant, le Savant, le Grand Pardonneur. » Le miroir me montre l'ouverture majestueuse. « Tanilu al-kitabi min Allahi al-azizi al-alimi al-ghaffari » — la révélation du Livre vient d'Allah, le Puissant, le Savant, le Grand Pardonneur. Les attributs sont réunis. Le miroir m'interroge : est-ce que je connais ces attributs ?`,
  reflection: `Le Livre vient d'Allah le Puissant, le Savant et le Grand Pardonneur. La révélation est un don de miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ha Mim tanilu al-kitabi min Allahi al-azizi al-alimi al-ghaffari » — Ha, Mim. La révélation du Livre vient d'Allah, le Puissant, le Savant, le Grand Pardonneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais ces attributs d'Allah ? La puissance, la science, le pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance des attributs divins élève le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est un don de miséricorde pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les attributs d'Allah L'aime." }
  ],
  munajat: `Ya Ghaffar, Tu es le Puissant, le Savant, le Grand Pardonneur. Ne permets pas que je T'oublie. Donne-moi de Te connaître dans Tes attributs.`
};

MIROIR["40:2"] = {
  reference: "40:2",
  theme: ["révélation", "guidance", "avertissement"],
  emotion: "Gratitude, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Akhirah"],
  mirrorVersion: `« Révélation du Livre venant d'Allah, le Puissant, le Savant, qui pardonne le péché et accepte le repentir. » Le miroir me montre la dualité de l'avertissement et de l'espoir. « Ghafiri al-dhanbi wa qabili al-tawbi » — qui pardonne le péché et accepte le repentir. Le pardon est possible. Le miroir m'interroge : est-ce que j'espère ce pardon ?`,
  reflection: `Allah pardonne le péché et accepte le repentir. Mais Il est aussi sévère en punition.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ghafiri al-dhanbi wa qabili al-tawbi shadidi al-iqabi dhi al-tawli » — qui pardonne le péché et accepte le repentir, Sévère en punition, Détenteur des faveurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère ce pardon ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir du pardon ne doit pas faire oublier la punition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il n'y a de divinité que Lui. Tout retourne vers Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère le pardon et craint la punition est sur la voie." }
  ],
  munajat: `Ya Ghafir, j'espère Ton pardon et je crains Ta punition. Ne permets pas que je désespère ou que je sois insouciant. Donne-moi l'équilibre de l'espoir et de la crainte.`
};

MIROIR["40:3"] = {
  reference: "40:3",
  theme: ["pardon", "repentir", "punition"],
  emotion: "Espoir, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Tawwab"],
  mirrorVersion: `« Il n'y a de divinité que Lui. C'est vers Lui qu'est le retour. » Le miroir me montre la destination finale. « La ilaha illa huwa ilayhi al-masir » — il n'y a de divinité que Lui. C'est vers Lui qu'est le retour. La destinée est claire. Le miroir m'interroge : vers qui vais-je retourner ?`,
  reflection: `Il n'y a de divinité qu'Allah. Tout retourne vers Lui. La destination est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ilaha illa huwa ilayhi al-masir » — il n'y a de divinité que Lui. C'est vers Lui qu'est le retour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers qui vais-je retourner ? Est-ce que je prépare ce retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation du retour est le sens de la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose retourne à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son retour retourne en paix." }
  ],
  munajat: `Ya Ghafur, je prépare mon retour vers Toi. Ne permets pas que je sois surpris. Donne-moi de retourner en paix.`
};

MIROIR["40:4"] = {
  reference: "40:4",
  theme: ["argumentation", "mésiance", "signes"],
  emotion: "Vérité, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Bayyinah"],
  mirrorVersion: `« Seuls ceux qui ont mécru discutent les signes d'Allah. » Le miroir me montre l'attitude des négateurs. « Ma yujadilu fi ayati Allahi illa alladhina kafaru » — seuls ceux qui ont mécru discutent les signes d'Allah. L'argumentation est le signe de la mécréance. Le miroir m'interroge : comment je réagis face aux signes ?`,
  reflection: `Ceux qui mécroient discutent les signes d'Allah. Leur argumentation dans les villes ne les sauvera pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma yujadilu fi ayati Allahi illa alladhina kafaru fala yaghurka taqallubuhum fi al-bilad » — seuls ceux qui ont mécru discutent les signes d'Allah. Que leur agitation dans les villes ne te trompe pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face aux signes ? Est-ce que je les discute ou est-ce que je les accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des signes est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'argumentation des mécréants ne les sauve pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes avec humilité est guidé." }
  ],
  munajat: `Ya Haqq, j'accepte Tes signes. Ne permets pas que je les discute. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["40:5"] = {
  reference: "40:5",
  theme: ["nations", "messagers", "leçons"],
  emotion: "Méditation, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Adl"],
  mirrorVersion: `« Avant eux, le peuple de Noé et les factions après eux ont traité de mensonges. » Le miroir me montre l'histoire des nations. « Kadhdhabat qablahum qawmu nuhin wa al-ahzabu min ba'dihim » — avant eux, le peuple de Noé et les factions après eux ont traité de mensonges. L'histoire se répète. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `Les nations passées ont traité leurs messagers de menteurs. Chaque nation a comploté contre son messager.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat qablahum qawmu nuhin wa al-ahzabu min ba'dihim wa hammat kullu ummatin bi-rasulihim li-yakhudhuhu » — avant eux, le peuple de Noé et les factions après eux ont traité de mensonges. Chaque nation a projeté de se saisir de son messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je la répète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage de l'histoire est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les nations passées ont été détruites pour leur négation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Adl, j'apprends de l'histoire. Ne permets pas que je répète les erreurs. Donne-moi la sagesse du passé.`
};

MIROIR["40:6"] = {
  reference: "40:6",
  theme: ["décret", "mésiance", "enfer"],
  emotion: "Réalité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qadi", "Al-Jahim"],
  mirrorVersion: `« Ainsi s'est réalisée la parole de ton Seigneur contre ceux qui ont mécru : Ils seront les gens du feu. » Le miroir me montre le décret réalisé. « Wa kadhalika haqqat kalimatu rabbika 'ala alladhina kafaru annahum ashabu al-nar » — ainsi s'est réalisée la parole de ton Seigneur contre ceux qui ont mécru : Ils seront les gens du feu. Le décret est sans appel. Le miroir m'interroge : est-ce que je crains ce décret ?`,
  reflection: `La parole d'Allah s'est réalisée contre les mécréants. Ils seront les gens du feu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kadhalika haqqat kalimatu rabbika 'ala alladhina kafaru annahum ashabu al-nar » — ainsi s'est réalisée la parole de ton Seigneur contre ceux qui ont mécru : Ils seront les gens du feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce décret ? Ou est-ce que je suis insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi protège de ce décret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret divin est sans appel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit n'est pas concerné par ce décret." }
  ],
  munajat: `Ya Qadi, je crains Ton décret. Ne permets pas que je sois parmi les gens du feu. Donne-moi la foi qui protège.`
};

MIROIR["40:7"] = {
  reference: "40:7",
  theme: ["anges", "trône", "prière"],
  emotion: "Émerveillement, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Arsh", "Al-Mala'ika"],
  mirrorVersion: `« Ceux qui portent le Trône et ceux qui l'entourent célèbrent les louanges de leur Seigneur. » Le miroir me montre la prière des anges. « Alladhina yahmiluna al-arsha wa man hawlahu yusabbihuna bi-hamdi rabbihim » — ceux qui portent le Trône et ceux qui l'entourent célèbrent les louanges de leur Seigneur. La prière angélique est constante. Le miroir m'interroge : est-ce que je me joins à cette prière ?`,
  reflection: `Les anges qui portent le Trône et ceux qui l'entourent célèbrent les louanges d'Allah et croient en Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yahmiluna al-arsha wa man hawlahu yusabbihuna bi-hamdi rabbihim wa yu'minuna bihi » — ceux qui portent le Trône et ceux qui l'entourent célèbrent les louanges de leur Seigneur et croient en Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me joins à cette prière ? Ou est-ce que je reste silencieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière constante est l'héritage des croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges demandent pardon pour les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie comme les anges est proche d'eux." }
  ],
  munajat: `Ya Rabb al-arsh, je me joins à la prière des anges. Ne permets pas que je reste silencieux. Donne-moi la prière constante.`
};

MIROIR["40:8"] = {
  reference: "40:8",
  theme: ["paradis", "prière", "récompense"],
  emotion: "Espoir, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Firdaws", "Al-Wa'ad"],
  mirrorVersion: `« Seigneur ! Fais-les entrer aux jardins d'Eden que Tu leur as promis ! » Le miroir me montre la prière des anges pour les croyants. « Rabbana wa adkhilhum jannati adnin allati wa'adtahum » — Seigneur ! Fais-les entrer aux jardins d'Eden que Tu leur as promis ! La prière des anges est pour nous. Le miroir m'interroge : suis-je digne de cette prière ?`,
  reflection: `Les anges prient pour l'entrée des croyants aux jardins d'Eden. Leurs prières incluent les croyants vertueux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbana wa adkhilhum jannati adnin allati wa'adtahum wa man salaha min aba'ihim wa azwajihim wa dhurriyyatihim » — Seigneur ! Fais-les entrer aux jardins d'Eden que Tu leur as promis, ainsi que les vertueux parmi leurs ancêtres, leurs épouses et leurs descendants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je digne de cette prière des anges ? Ou suis-je négligent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu rend digne de la prière des anges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Puissant, le Sage." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vertueux reçoit la prière des anges." }
  ],
  munajat: `Ya Wa'ad, je veux être digne de la prière des anges. Ne permets pas que je sois négligent. Donne-moi la vertu qui mène aux jardins d'Eden.`
};

MIROIR["40:9"] = {
  reference: "40:9",
  theme: ["protection", "méricorde", "prière"],
  emotion: "Espoir, supplication",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Ar-Rahim"],
  mirrorVersion: `« Et protège-les du mal ! Ce jour-là, celui que Tu protèges du mal, Tu lui fais miséricorde. » Le miroir me montre la protection divine. « Wa qihimu al-sayyi'at » — et protège-les du mal. La protection est demandée par les anges. Le miroir m'interroge : est-ce que je demande cette protection ?`,
  reflection: `Les anges demandent la protection contre le mal. La miséricorde est accordée à ceux qui sont protégés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qihimu al-sayyi'at wa man taqi al-sayyi'ati yawma'idhin fa-qad rahimtahu » — et protège-les du mal ! Ce jour-là, celui que Tu protèges du mal, Tu lui fais miséricorde. Et c'est là l'énorme succès." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande cette protection ? Ou est-ce que je cours vers le mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection du mal est le succès énorme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah est pour ceux qu'Il protège." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est protégé du mal a réussi." }
  ],
  munajat: `Ya Hafiz, protège-moi du mal. Ne permets pas que je sois perdu. Donne-moi Ta miséricorde et le succès énorme.`
};

MIROIR["40:10"] = {
  reference: "40:10",
  theme: ["mésissance", "regret", "punition"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jalil", "Al-Ghadab"],
  mirrorVersion: `« Ceux qui ont mécru seront interpellés : L'aversion d'Allah est plus grande que votre aversion envers vous-mêmes. » Le miroir me montre l'aversion divine. « Inna alladhina kafaru yunadawna lamakratu Allahi akbaru min makratikum anfusikum » — ceux qui ont mécru seront interpellés : L'aversion d'Allah est plus grande. L'aversion est réciproque. Le miroir m'interroge : est-ce que j'évite cette aversion ?`,
  reflection: `L'aversion d'Allah envers les mécréants est plus grande que leur aversion envers eux-mêmes. Ils refusaient la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina kafaru yunadawna lamakratu Allahi akbaru min makratikum anfusikum idh tud'awna ila al-imani fa-takfurun » — ceux qui ont mécru seront interpellés : L'aversion d'Allah est plus grande que votre aversion envers vous-mêmes, quand vous étiez appelés à la foi et que vous mécroyiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite cette aversion ? Ou est-ce que je refuse la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite l'aversion divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le refus de la foi mène à l'aversion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la foi évite l'aversion." }
  ],
  munajat: `Ya Jalil, j'accepte la foi. Ne permets pas que je sois parmi les avérés. Donne-moi la foi qui mène à Ton agrément.`
};

MIROIR["40:11"] = {
  reference: "40:11",
  theme: ["mort", "résurrection", "regret"],
  emotion: "Réalité, effroi",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ath"],
  mirrorVersion: `« Ils diront : Seigneur, Tu nous as fait mourir deux fois et Tu nous as fait revivre deux fois. » Le miroir me montre le cycle de la vie et de la mort. « Qalu rabbana amattana ithnayni wa ahyaytana ithnayni » — ils diront : Seigneur, Tu nous as fait mourir deux fois et Tu nous as fait revivre deux fois. Le cycle est terrifiant. Le miroir m'interroge : est-ce que je me prépare à la résurrection ?`,
  reflection: `Les mécréants reconnaissent le cycle de la mort et de la vie. Mais leur reconnaissance vient trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu rabbana amattana ithnayni wa ahyaytana ithnayni fa'tarafna bi-dhunubina » — ils diront : Seigneur, Tu nous as fait mourir deux fois et Tu nous as fait revivre deux fois. Nous reconnaissons nos péchés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare à la résurrection ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance avant la mort vaut mieux qu'après." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Y a-t-il un moyen de sortir ? La réponse est non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare à la résurrection n'a pas besoin de demander une sortie." }
  ],
  munajat: `Ya Mumit, je me prépare à la résurrection. Ne permets pas que je sois surpris. Donne-moi de me préparer avant qu'il ne soit trop tard.`
};

MIROIR["40:12"] = {
  reference: "40:12",
  theme: ["unicité", "mésiance", "conséquence"],
  emotion: "Réalité, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Shirk"],
  mirrorVersion: `« Cela vous arrive parce que quand on invoquait Allah seul, vous mécroyiez. » Le miroir me montre la conséquence de l'association. « Dhalikum bi-annahu idha du'iya Allahu wahdahu kafartum » — cela vous arrive parce que quand on invoquait Allah seul, vous mécroyiez. L'association a des conséquences. Le miroir m'interroge : est-ce que j'invoque Allah seul ?`,
  reflection: `Le châtiment vient parce que quand Allah était invoqué seul, ils mécroyaient. Et quand on Lui associait, ils croyaient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalikum bi-annahu idha du'iya Allahu wahdahu kafartum wa idha yushraku bihi tu'minun » — cela vous arrive parce que quand on invoquait Allah seul, vous mécroyiez. Et quand on Lui associait, vous croyiez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah seul ? Ou est-ce que je Lui associe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation d'Allah seul est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement appartient à Allah, le Très-Haut, le Grand." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul est sauvé." }
  ],
  munajat: `Ya Wahid, j'invoque Toi seul. Ne permets pas que je T'associe. Donne-moi la foi en l'unicité parfaite.`
};

MIROIR["40:13"] = {
  reference: "40:13",
  theme: ["signes", "provision", "méricorde"],
  emotion: "Gratitude, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muhyi"],
  mirrorVersion: `« C'est Lui qui vous fait voir Ses signes et fait descendre du ciel une provision pour vous. » Le miroir me montre la générosité divine visible. « Huwa alladhi yurikum ayatihi wa yunazzilu mina al-sama'i rizqan » — c'est Lui qui vous fait voir Ses signes et fait descendre du ciel une provision. Les signes et la provision sont visibles. Le miroir m'interroge : est-ce que je vois ces signes ?`,
  reflection: `Allah montre Ses signes et envoie la provision. Seul se rappelle celui qui se repent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi yurikum ayatihi wa yunazzilu mina al-sama'i rizqan wa ma yatadhakkaru illa munib » — c'est Lui qui vous fait voir Ses signes et fait descendre du ciel une provision pour vous. Seul se rappelle celui qui se repent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois ces signes ? Ou est-ce que je suis aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir ouvre les yeux sur les signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision du ciel est un don visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent voit les signes partout." }
  ],
  munajat: `Ya Razzaq, je vois Tes signes et Ta provision. Ne permets pas que je sois aveugle. Donne-moi le repentir qui ouvre les yeux.`
};

MIROIR["40:14"] = {
  reference: "40:14",
  theme: ["invocation", "méricance", "sincérité"],
  emotion: "Supplication, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Da'wah", "Al-Kafirun"],
  mirrorVersion: `« Invoquez Allah en Lui vouant un culte exclusif, même si cela déplaît aux mécréants. » Le miroir me montre l'invocation malgré l'opposition. « Fa'du Allaha mukhlisina lahu al-din wa law kariha al-kafirun » — invoquez Allah en Lui vouant un culte exclusif, même si cela déplaît aux mécréants. L'opposition ne doit pas arrêter. Le miroir m'interroge : est-ce que j'invoque malgré l'opposition ?`,
  reflection: `L'invocation exclusive doit continuer malgré le déplaisir des mécréants. La sincérité est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa'du Allaha mukhlisina lahu al-din wa law kariha al-kafirun » — invoquez Allah en Lui vouant un culte exclusif, même si cela déplaît aux mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque malgré l'opposition ? Ou est-ce que je me cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation sincère transcende l'opposition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mécréants n'aiment pas l'invocation exclusive." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque malgré l'opposition est fort." }
  ],
  munajat: `Ya Rabb, j'invoque exclusivement. Ne permets pas que je me cache. Donne-moi la sincérité qui transcende l'opposition.`
};

MIROIR["40:15"] = {
  reference: "40:15",
  theme: ["élévation", "trône", "révélation"],
  emotion: "Révérence, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Ali", "Al-Wahy"],
  mirrorVersion: `« Élevé en degrés, Détenteur du Trône, Il envoie l'Esprit par Son ordre sur qui Il veut parmi Ses serviteurs. » Le miroir me montre l'élévation divine. « Rafi'u al-darajati dhu al-arshi yulqi al-ruha min amrihi » — élevé en degrés, Détenteur du Trône, Il envoie l'Esprit. L'élévation et la révélation sont liées. Le miroir m'interroge : est-ce que je reconnais cette élévation ?`,
  reflection: `Allah est élevé en degrés et détient le Trône. Il envoie la révélation à qui Il veut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rafi'u al-darajati dhu al-arshi yulqi al-ruha min amrihi 'ala man yasha'u min 'ibadihi li-yundhira yawma al-talaq » — élevé en degrés, Détenteur du Trône, Il envoie l'Esprit par Son ordre sur qui Il veut parmi Ses serviteurs, pour avertir du Jour de la Rencontre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais cette élévation ? Ou est-ce que je rabaisse Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'élévation élève le croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour de la Rencontre est certain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'élévation d'Allah s'élève." }
  ],
  munajat: `Ya Ali, je reconnais Ton élévation. Ne permets pas que je Te rabaisse. Donne-moi de m'élever par la reconnaissance.`
};

MIROIR["40:16"] = {
  reference: "40:16",
  theme: ["jugement", "manifestation", "justice"],
  emotion: "Crainte, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Zahir", "Al-Hakam"],
  mirrorVersion: `« Le jour où ils comparaîtront, rien d'eux ne sera caché à Allah. » Le miroir me montre la manifestation totale. « Yawma hum barizun la yakhfa 'ala Allahi minhum shay' » — le jour où ils comparaîtront, rien d'eux ne sera caché à Allah. Tout sera visible. Le miroir m'interroge : qu'est-ce qui sera visible de moi ?`,
  reflection: `Au Jour du Jugement, rien ne sera caché à Allah. À qui appartient la royauté ce jour-là ? À Allah, l'Unique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma hum barizun la yakhfa 'ala Allahi minhum shay'un li-man al-mulku al-yawma lillahi al-wahidi al-qahhar » — le jour où ils comparaîtront, rien d'eux ne sera caché à Allah. À qui appartient la royauté aujourd'hui ? À Allah, l'Unique, le Dominateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui sera visible de moi ? Mes secrets seront-ils exposés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour ce jour protège de la honte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La royauté appartient à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare ce jour n'a pas à craindre la manifestation." }
  ],
  munajat: `Ya Qahhar, à Toi appartient la royauté. Ne permets pas que mes secrets soient honteux. Donne-moi de me préparer pour le Jour de la Rencontre.`
};

MIROIR["40:17"] = {
  reference: "40:17",
  theme: ["rétribution", "justice", "annonce"],
  emotion: "Certitude, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Hasib"],
  mirrorVersion: `« Aujourd'hui, chaque âme sera rétribuée selon ce qu'elle a acquis. » Le miroir me montre la rétribution immédiate. « Al-yawma tujza kullu nafsin bima kasabat » — aujourd'hui, chaque âme sera rétribuée selon ce qu'elle a acquis. Le jour du compte est arrivé. Le miroir m'interroge : que serai-je rétribué ?`,
  reflection: `Chaque âme sera rétribuée selon ses acquis. Pas d'injustice aujourd'hui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-yawma tujza kullu nafsin bima kasabat la zhalma al-yawm » — aujourd'hui, chaque âme sera rétribuée selon ce qu'elle a acquis. Pas d'injustice aujourd'hui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que serai-je rétribué ? Ma rétribution sera-t-elle bonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne action aujourd'hui mène à la bonne rétribution." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est prompt dans les comptes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien aujourd'hui sera bien rétribué." }
  ],
  munajat: `Ya Hasib, je veux une bonne rétribution. Ne permets pas que je sois lésé. Donne-moi d'agir pour le bien.`
};

MIROIR["40:18"] = {
  reference: "40:18",
  theme: ["jugement", "crainte", "secrets"],
  emotion: "Effroi, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Khafi", "Al-Ilahi"],
  mirrorVersion: `« Et avertis-les du Jour qui approche, où les cœurs remonteront aux gorges, terrifiés. » Le miroir me montre la terreur du Jour. « Wa andhirhum yawma al-azifati idhi al-qulubu lada al-hanajiri kazimin » — et avertis-les du Jour qui approche, où les cœurs remonteront aux gorges, terrifiés. L'image est saisissante. Le miroir m'interroge : est-ce que je prépare ce Jour ?`,
  reflection: `Le Jour approche. Les cœurs seront terrifiés. Les injustes n'auront ni ami ni intercesseur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa andhirhum yawma al-azifati idhi al-qulubu lada al-hanajiri kazimin ma li-l-zalimina min hamimin wa la shafi'in yuta' » — et avertis-les du Jour qui approche, où les cœurs remonteront aux gorges, terrifiés. Les injustes n'auront ni ami ni intercesseur exaucé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare ce Jour ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation du Jour est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour approche, il n'est pas loin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare ce Jour n'est pas terrifié." }
  ],
  munajat: `Ya Khafi, je prépare le Jour qui approche. Ne permets pas que je sois terrifié. Donne-moi un ami et un intercesseur au Jour du Jugement.`
};

MIROIR["40:19"] = {
  reference: "40:19",
  theme: ["connaissance", "trahison", "secrets"],
  emotion: "Vérité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Khabir"],
  mirrorVersion: `« Il connaît la trahison des regards et ce que les poitrines cachent. » Le miroir me montre la connaissance absolue d'Allah. « Ya'lamu khainata al-a'yunu wa ma tukhfi al-sudur » — Il connaît la trahison des regards et ce que les poitrines cachent. Rien n'est caché. Le miroir m'interroge : que cache ma poitrine ?`,
  reflection: `Allah connaît la trahison des regards et les secrets des cœurs. Rien ne Lui échappe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya'lamu khainata al-a'yunu wa ma tukhfi al-sudur » — Il connaît la trahison des regards et ce que les poitrines cachent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Que cache ma poitrine ? Mes secrets sont-ils purs ou souillés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La pureté des secrets est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah juge avec équité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui dont les secrets sont purs n'a rien à cacher." }
  ],
  munajat: `Ya Alim, Tu connais mes secrets. Ne permets pas qu'ils soient souillés. Donne-moi la pureté du cœur.`
};

MIROIR["40:20"] = {
  reference: "40:20",
  theme: ["jugement", "fausses divinités", "vérité"],
  emotion: "Certitude, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Adl"],
  mirrorVersion: `« Allah juge en toute équité, tandis que ceux qu'ils invoquent en dehors de Lui ne jugent rien. » Le miroir me montre la différence entre Allah et les idoles. « Wallahu yaqdi bi-al-haqqi wa alladhina yad'una min dunihi la yaqduna bi-shay' » — Allah juge en toute équité, tandis que ceux qu'ils invoquent en dehors de Lui ne jugent rien. Le contraste est frappant. Le miroir m'interroge : à qui je fais confiance pour le jugement ?`,
  reflection: `Allah juge avec vérité. Les idoles ne jugent rien. Seul Allah entend et voit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wallahu yaqdi bi-al-haqqi wa alladhina yad'una min dunihi la yaqduna bi-shay'in inna Allaha huwa al-sami'u al-basir » — Allah juge en toute équité, tandis que ceux qu'ils invoquent en dehors de Lui ne jugent rien. Allah est l'Audient, le Clairvoyant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je fais confiance pour le jugement ? À Allah ou aux idoles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confiance en Allah pour le jugement est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah entend et voit tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah pour le jugement est en sécurité." }
  ],
  munajat: `Ya Haqq, je fais confiance à Ton jugement. Ne permets pas que je fasse confiance aux idoles. Donne-moi la foi en Ton équité parfaite.`
};

MIROIR["15:53"] = {
  reference: "15:53",
  theme: ["bonne nouvelle", "anges", "enfant"],
  emotion: "Espérance, surprise",
  difficulty: "débutant",
  relatedNames: ["Al-Bisharah", "Ishaq"],
  mirrorVersion: `« Ils dirent : "N'aie pas peur, Nous t'annonçons une bonne nouvelle : un garçon plein de science." » Le miroir me montre la bonne nouvelle des anges. « Qalu la takhaf inna nubashshiruka bi-ghulamin 'alim » — ils dirent : N'aie pas peur, Nous t'annonçons une bonne nouvelle. La bonne nouvelle vient d'Allah. Le miroir m'interroge : est-ce que j'espère la bonne nouvelle d'Allah ?`,
  reflection: `La bonne nouvelle vient d'Allah. L'espérer est un acte de foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu la takhaf inna nubashshiruka bi-ghulamin 'alim » — ils dirent : N'aie pas peur, Nous t'annonçons une bonne nouvelle : un garçon plein de science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère la bonne nouvelle d'Allah ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir de la bonne nouvelle maintient la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bonnes nouvelles viennent d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère reçoit au moment voulu." }
  ],
  munajat: `Ya Rabb, j'espère Ta bonne nouvelle. Ne permets pas le désespoir dans mon cœur. Donne-moi d'espérer en Toi toujours.`
};

MIROIR["15:54"] = {
  reference: "15:54",
  theme: ["vieillesse", "enfant", "étonnement"],
  emotion: "Surprise, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Walad", "Ibrahim"],
  mirrorVersion: `« Il dit : "M'annoncez-vous cette bonne nouvelle alors que la vieillesse m'a touché ?" » Le miroir me montre l'étonnement d'Abraham. « Qala a-bashshartumuni 'ala an massaniya al-kibar » — il dit : M'annoncez-vous cette bonne nouvelle alors que la vieillesse m'a touché ? Rien n'est impossible à Allah. Le miroir m'interroge : est-ce que je crois que rien n'est impossible à Allah ?`,
  reflection: `Rien n'est impossible à Allah. Croire en Sa puissance est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala a-bashshartumuni 'ala an massaniya al-kibar » — il dit : M'annoncez-vous cette bonne nouvelle alors que la vieillesse m'a touché ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que rien n'est impossible à Allah ? Ou est-ce que je limite Sa puissance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La croyance en la puissance totale d'Allah ouvre les portes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah peut tout, même ce qui semble impossible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la puissance d'Allah voit l'impossible se réaliser." }
  ],
  munajat: `Ya Rabb, je crois que rien ne T'est impossible. Ne permets pas que je limite Ta puissance. Ouvre les portes de l'impossible pour moi.`
};

MIROIR["15:55"] = {
  reference: "15:55",
  theme: ["vérité", "promesse", "certitude"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wa'd"],
  mirrorVersion: `« Ils dirent : "Nous t'annonçons la vérité, ne sois pas de ceux qui désespèrent." » Le miroir me montre l'invitation à l'espoir. « Qalu nubashshiruka bi-al-haqqi fala takun mina al-qanitin » — ils dirent : Nous t'annonçons la vérité, ne sois pas de ceux qui désespèrent. La vérité apporte l'espoir. Le miroir m'interroge : est-ce que je désespère ou j'espère ?`,
  reflection: `La vérité apporte l'espoir. Ne pas désespérer est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu nubashshiruka bi-al-haqqi fala takun mina al-qanitin » — ils dirent : Nous t'annonçons la vérité, ne sois pas de ceux qui désespèrent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désespère ou j'espère ? Quel est mon état face aux promesses d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir dans la vérité d'Allah est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité d'Allah est la source de l'espoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère dans la vérité ne désespère jamais." }
  ],
  munajat: `Ya Haqq, j'espère en Ta vérité. Ne permets pas le désespoir dans mon cœur. Donne-moi l'espoir constant en Tes promesses.`
};

MIROIR["15:56"] = {
  reference: "15:56",
  theme: ["désespoir", "miséricorde", "guidance"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahmah", "Ad-Dal"],
  mirrorVersion: `« Et qui désespère de la miséricorde de son Seigneur, sinon les égarés ? » Le miroir me montre le danger du désespoir. « Wa man yaqnatu min rahmati rabbi illa al-dallun » — et qui désespère de la miséricorde de son Seigneur, sinon les égarés ? Le désespoir est le signe de l'égarement. Le miroir m'interroge : est-ce que j'espère toujours en Sa miséricorde ?`,
  reflection: `Le désespoir est le signe de l'égarement. Espérer en Sa miséricorde est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man yaqnatu min rahmati rabbi illa al-dallun » — et qui désespère de la miséricorde de son Seigneur, sinon les égarés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère toujours en Sa miséricorde ? Ou est-ce que je désespère parfois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'espoir en Sa miséricorde est la marque du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah embrasse toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère en Sa miséricorde la reçoit." }
  ],
  munajat: `Ya Rahman, j'espère toujours en Ta miséricorde. Ne permets pas le désespoir dans mon cœur. Donne-moi l'espoir constant en Toi.`
};

MIROIR["15:57"] = {
  reference: "15:57",
  theme: ["mission", "anges", "question"],
  emotion: "Curiosité, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ikah", "Al-Mursalun"],
  mirrorVersion: `« Il dit : "Quelle est donc votre mission, ô envoyés ?" » Le miroir me montre la curiosité d'Abraham. « Qala fa-ma khatbukum ayyuha al-mursalun » — il dit : Quelle est donc votre mission, ô envoyés ? La question précède la compréhension. Le miroir m'interroge : est-ce que je pose des questions pour comprendre ?`,
  reflection: `La question précède la compréhension. Poser des questions est essentiel pour apprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala fa-ma khatbukum ayyuha al-mursalun » — il dit : Quelle est donc votre mission, ô envoyés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pose des questions pour comprendre ? Ou est-ce que je reste dans l'ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question ouvre la porte de la connaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les messagers d'Allah ont des missions précises." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pose des questions apprend et comprend." }
  ],
  munajat: `Ya Rabb, je veux poser des questions pour comprendre. Ne permets pas que je reste dans l'ignorance. Donne-moi la soif de connaître la vérité.`
};

MIROIR["15:58"] = {
  reference: "15:58",
  theme: ["mission", "châtiment", "vérité"],
  emotion: "Réalité, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mursalun", "Al-Mujrimun"],
  mirrorVersion: `« Ils dirent : "Nous sommes envoyés à un peuple de criminels." » Le miroir me montre la mission des anges. « Qalu inna ursilna ila qawmin mujrimin » — ils dirent : Nous sommes envoyés à un peuple de criminels. Le châtiment vient aux criminels. Le miroir m'interroge : est-ce que j'évite le crime ?`,
  reflection: `Le châtiment vient aux criminels. Éviter le crime est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu inna ursilna ila qawmin mujrimin » — ils dirent : Nous sommes envoyés à un peuple de criminels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite le crime ? Ou est-ce que je me rapproche de ce qui mène au châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évitement du crime protège du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les criminels reçoivent le châtiment mérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite le crime évite le châtiment." }
  ],
  munajat: `Ya Rabb, je veux éviter le crime sous toutes ses formes. Ne permets pas que je m'en rapproche. Protège-moi du châtiment des criminels.`
};

MIROIR["15:59"] = {
  reference: "15:59",
  theme: ["lot", "sauvetage", "croyants"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Lut", "Al-Mu'minun"],
  mirrorVersion: `« Sauf la famille de Lot, nous les sauverons tous. » Le miroir me montre l'exception au châtiment. « Ila ali lutin innahu la-muhayjirun » — sauf la famille de Lot, nous les sauverons tous. La foi sauve. Le miroir m'interroge : est-ce que ma famille est sur la voie du salut ?`,
  reflection: `La foi sauve du châtiment. Inviter sa famille à la foi est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila ali lutin innahu la-muhayjirun » — sauf la famille de Lot, nous les sauverons tous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma famille est sur la voie du salut ? Ou est-ce que je les laisse dans l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi de la famille est le plus grand trésor." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le salut vient aux familles croyantes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui guide sa famille vers la foi les sauve." }
  ],
  munajat: `Ya Rabb, je veux que ma famille soit sauvée. Ne permets pas qu'ils soient dans l'égarement. Guide-les vers la foi et le salut.`
};

MIROIR["15:60"] = {
  reference: "15:60",
  theme: ["épouse", "destin", "châtiment"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Imra'at Lut", "Al-Ghabirin"],
  mirrorVersion: `« Sauf sa femme qui a décrété qu'elle sera du nombre des disparus. » Le miroir me montre le destin de l'épouse de Lot. « Ila imra'atahu qaddarna innaha lamina al-ghabirin » — sauf sa femme qui a décrété qu'elle sera du nombre des disparus. La proximité d'un prophète ne sauve pas sans foi. Le miroir m'interroge : est-ce que ma foi est personnelle ?`,
  reflection: `La proximité d'un prophète ne sauve pas sans foi personnelle. La foi doit être sincère et personnelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila imra'atahu qaddarna innaha lamina al-ghabirin » — sauf sa femme qui a décrété qu'elle sera du nombre des disparus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est personnelle ? Ou est-ce que je compte sur la foi des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi personnelle est la seule qui sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun sera jugé selon sa propre foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a une foi personnelle est sauvé." }
  ],
  munajat: `Ya Rabb, je veux une foi personnelle et sincère. Ne permets pas que je compte sur la foi des autres. Donne-moi ma propre conviction.`
};

MIROIR["15:61"] = {
  reference: "15:61",
  theme: ["arrivée", "anges", "lot"],
  emotion: "Événement, sollicitude",
  difficulty: "débutant",
  relatedNames: ["Lut", "Al-Mala'ikah"],
  mirrorVersion: `« Quand les envoyés vinrent à la famille de Lot. » Le miroir me montre l'arrivée des anges. « Fa-lamma ja'a ali luti al-mursalun » — quand les envoyés vinrent à la famille de Lot. L'arrivée des anges est un moment crucial. Le miroir m'interroge : est-ce que je suis prêt pour la visite d'Allah ?`,
  reflection: `L'arrivée des anges est un moment crucial. Être prêt pour la visite d'Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-lamma ja'a ali luti al-mursalun » — quand les envoyés vinrent à la famille de Lot." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour la visite d'Allah ? Ou est-ce que je suis pris au dépourvu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation constante est la clé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges viennent avec la volonté d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est toujours prêt accueille les signes d'Allah." }
  ],
  munajat: `Ya Rabb, je veux être toujours prêt pour Ta visite. Ne permets pas que je sois pris au dépourvu. Prépare mon cœur pour chaque rencontre avec Toi.`
};

MIROIR["15:62"] = {
  reference: "15:62",
  theme: ["inquiétude", "accueil", "protection"],
  emotion: "Préoccupation, hospitalité",
  difficulty: "débutant",
  relatedNames: ["Lut", "Al-Dhayf"],
  mirrorVersion: `« Il dit : "Vous êtes des gens que je ne connais pas." » Le miroir me montre l'inquiétude de Lot. « Qala innakum qawmun munkarun » — il dit : Vous êtes des gens que je ne connaît pas. L'inquiétude précède la reconnaissance. Le miroir m'interroge : est-ce que je protège ma famille des inconnus ?`,
  reflection: `L'inquiétude précède la reconnaissance. Protéger sa famille est un devoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala innakum qawmun munkarun » — il dit : Vous êtes des gens que je ne connais pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je protège ma famille des inconnus ? Ou est-ce que je suis négligent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection de la famille est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges peuvent venir sous forme humaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa famille reçoit la protection d'Allah." }
  ],
  munajat: `Ya Rabb, je veux protéger ma famille. Ne permets pas que je sois négligent. Donne-moi la sagesse de discerner le bien du mal.`
};

MIROIR["15:63"] = {
  reference: "15:63",
  theme: ["révélation", "certitude", "vérité"],
  emotion: "Soulagement, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-Haqq"],
  mirrorVersion: `« Ils dirent : "Nous sommes venus à toi avec ce dont ils doutent." » Le miroir me montre la révélation de la vérité. « Qalu bal ji'naka bima kanu fihi yamtarun » — ils dirent : Nous sommes venus à toi avec ce dont ils doutent. La vérité vient à ceux qui doutent. Le miroir m'interroge : est-ce que j'accepte la vérité quand elle vient ?`,
  reflection: `La vérité vient à ceux qui doutent. L'accepter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu bal ji'naka bima kanu fihi yamtarun » — ils dirent : Nous sommes venus à toi avec ce dont ils doutent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la vérité quand elle vient ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation de la vérité est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par arriver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la vérité la reconnaît quand elle vient." }
  ],
  munajat: `Ya Haqq, j'accepte la vérité quand elle vient. Ne permets pas que je la rejette. Donne-moi le courage de voir la vérité.`
};

MIROIR["15:64"] = {
  reference: "15:64",
  theme: ["vérité", "mission", "certitude"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["As-Sadiqun", "Al-Mursalun"],
  mirrorVersion: `« Nous venons avec la vérité et nous sommes vraiment véridiques. » Le miroir me montre l'affirmation de la vérité. « Wa ataynaka bi-al-haqqi wa inna la-sadiqun » — nous venons avec la vérité et nous sommes vraiment véridiques. La vérité est affirmée avec certitude. Le miroir m'interroge : est-ce que je parle avec vérité ?`,
  reflection: `La vérité doit être affirmée avec certitude. Parler avec vérité est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ataynaka bi-al-haqqi wa inna la-sadiqun » — nous venons avec la vérité et nous sommes vraiment véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je parle avec vérité ? Ou est-ce que je mélange le vrai et le faux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La véridicité est le propre du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité vient d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité honore Allah." }
  ],
  munajat: `Ya Rabb, je veux parler avec vérité. Ne permets pas que je mélange le vrai et le faux. Donne-moi la force d'être toujours véridique.`
};

MIROIR["15:65"] = {
  reference: "15:65",
  theme: ["départ", "nuit", "obéissance"],
  emotion: "Urgence, obéissance",
  difficulty: "débutant",
  relatedNames: ["As-Subh", "At-Tawwaf"],
  mirrorVersion: `« Pars donc avec ta famille dans une partie de la nuit, et suis leur arrière-garde. » Le miroir me montre l'instruction du départ. « Fa-asri bi-ahlika bi-qit'in mina al-layli » — pars donc avec ta famille dans une partie de la nuit. L'obéissance immédiate est requise. Le miroir m'interroge : est-ce que j'obéis immédiatement aux ordres d'Allah ?`,
  reflection: `L'obéissance immédiate est requise. Ne pas hésiter est essentiel.`,
  tajalli: [
