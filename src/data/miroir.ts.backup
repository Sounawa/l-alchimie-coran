  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Mila'"],
  mirrorVersion: `« J'emplirai certainement l'Enfer de toi et de ceux qui t'auront suivi. » Le miroir prononce le châtiment. L'Enfer sera rempli d'Iblis et de ses suivants. Le miroir m'avertit : suivre Iblis mène à l'Enfer.`,
  reflection: `Suivre Iblis mène à l'Enfer. Suis-je en train de le suivre ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-amla'anna jahannama minka wa mimman tabi'aka minhum ajma'in » — j'emplirai certainement l'Enfer de toi et de ceux qui t'auront suivi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je en train de suivre Iblis ? Ou est-ce que je le résiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre Iblis est le chemin de l'Enfer — le résister est le chemin du Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer attend ceux qui choisissent Iblis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La résistance à Iblis est la clé du salut." }
  ],
  munajat: `Ya Rabb, je ne veux pas suivre Iblis. Donne-moi la force de lui résister. Ne permets pas que je sois parmi les remplisseurs de l'Enfer.`
};

MIROIR["38:86"] = {
  reference: "38:86",
  theme: ["récompense", "liberté", "message"],
  emotion: "Liberté, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Ajr", "Al-Risalah"],
  mirrorVersion: `« Dis : Je ne vous demande aucune récompense, et je ne suis pas un imposteur. » Le miroir clarifie la mission du Prophète. Pas de récompense demandée — le message est libre. Le miroir m'invite à recevoir le message sans suspicion.`,
  reflection: `Le Prophète ne demande rien. Le message est pur. Comment je le reçois ?`,
  tajalli: [
