  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qadayna ilayhi dhalika al-amra anna dabira ha'ula'i maqtu'un musbihi » — et Nous lui annonçâmes ce décret : que ces gens-là, au matin, seront anéantis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte le décret d'Allah ? Ou est-ce que je le refuse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation du décret est la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret d'Allah est toujours juste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le décret trouve la paix." }
  ],
  munajat: `Ya Rabb, j'accepte Ton décret. Ne permets pas que je le refuse. Donne-moi la soumission à Ta volonté.`
};

MIROIR["15:67"] = {
  reference: "15:67",
  theme: ["ville", "joie", "ignorance"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Madina", "Al-Farah"],
  mirrorVersion: `« Les habitants de la ville vinrent en se réjouissant. » Le miroir me montre la réaction des habitants. « Wa ja'a ahlu al-madina yastabshirun » — les habitants de la ville vinrent en se réjouissant. La joie ignorante précède la destruction. Le miroir m'interroge : est-ce que ma joie est dans la vérité ou l'ignorance ?`,
  reflection: `La joie ignorante précède la destruction. La joie dans la vérité est essentielle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ja'a ahlu al-madina yastabshirun » — les habitants de la ville vinrent en se réjouissant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma joie est dans la vérité ou l'ignorance ? Quelle est la source de ma joie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La joie dans la vérité est bénie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La joie ignorante est un signe de destruction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réjouit dans la vérité est sauvé." }
  ],
  munajat: `Ya Rabb, je veux me réjouir dans la vérité. Ne permets pas que ma joie soit ignorante. Fais que ma joie soit en Toi.`
};

MIROIR["15:68"] = {
  reference: "15:68",
  theme: ["protection", "hôtes", "pudeur"],
  emotion: "Protection, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Lut", "Al-Dhayf"],
  mirrorVersion: `« Il dit : "Ce sont mes hôtes, ne me déshonorez pas." » Le miroir me montre la protection de Lot pour ses hôtes. « Qala ha'ula'i dayfi fala tafda'un » — il dit : Ce sont mes hôtes, ne me déshonorez pas. Protéger ses hôtes est un devoir. Le miroir m'interroge : est-ce que je protège ceux qui sont sous ma responsabilité ?`,
  reflection: `Protéger ses hôtes est un devoir. L'honneur est dans la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ha'ula'i dayfi fala tafda'un » — il dit : Ce sont mes hôtes, ne me déshonorez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je protège ceux qui sont sous ma responsabilité ? Ou est-ce que je les laisse vulnérables ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection des vulnérables est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Protéger l'hôte est un devoir sacré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège les siens reçoit la protection d'Allah." }
  ],
  munajat: `Ya Rabb, je veux protéger ceux qui sont sous ma responsabilité. Ne permets pas que je les laisse vulnérables. Donne-moi le courage de la protection.`
};

MIROIR["40:21"] = {
  reference: "40:21",
  theme: ["nations", "leçons", "voyage"],
  emotion: "Méditation, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qasas", "Al-Ibra"],
  mirrorVersion: `« N'ont-ils pas voyagé sur la terre pour voir ce qu'il est advenu de ceux qui ont vécu avant eux ? » Le miroir me montre l'importance du voyage et de l'histoire. « A-wa lam yasiru fi al-ardi fa-yanzuru kayfa kana 'aqibatu alladhina kanu min qablihim » — n'ont-ils pas voyagé sur la terre pour voir ce qu'il est advenu de ceux qui ont vécu avant eux ? L'histoire est un enseignement. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `Voyager sur la terre et voir le destin des nations passées est un enseignement. Ils étaient plus forts et ont plus laissé sur terre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yasiru fi al-ardi fa-yanzuru kayfa kana 'aqibatu alladhina kanu min qablihim kanu hum ashadda minhum quwwatan wa atharan fi al-ard » — n'ont-ils pas voyagé sur la terre pour voir ce qu'il est advenu de ceux qui ont vécu avant eux ? Ils étaient plus forts qu'eux et ont plus laissé de traces sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage de l'histoire est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah les a saisis pour leurs péchés et il n'y avait pour eux aucun protecteur contre Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire évite le destin des passés." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire. Ne permets pas que je l'ignore. Donne-moi la sagesse du voyage et de la méditation.`
};

MIROIR["40:22"] = {
  reference: "40:22",
  theme: ["messagers", "négation", "punition"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Bayan"],
  mirrorVersion: `« Cela parce que leurs messagers leur avaient apporté les preuves et qu'ils avaient mécru. » Le miroir me montre la raison de la punition. « Dhalika bi-annahum kanat ta'tihim rusuluhum bi-al-bayyinati » — cela parce que leurs messagers leur avaient apporté les preuves et qu'ils avaient mécru. La raison est claire. Le miroir m'interroge : est-ce que je mécrois face aux preuves ?`,
  reflection: `Les nations ont été punies parce qu'elles ont mécru face aux preuves apportées par les messagers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-annahum kanat ta'tihim rusuluhum bi-al-bayyinati fa-kafaru fa-akhadhahumu Allahu » — cela parce que leurs messagers leur avaient apporté les preuves et qu'ils avaient mécru. Alors Allah les a saisis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mécrois face aux preuves ? Ou est-ce que j'accepte avec humilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'acceptation des preuves est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est Fort et sévère en punition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les preuves avec humilité est guidé." }
  ],
  munajat: `Ya Rabb, j'accepte Tes preuves. Ne permets pas que je mécroie. Donne-moi la foi qui accepte la vérité.`
};

MIROIR["40:23"] = {
  reference: "40:23",
  theme: ["mousa", "pharaon", "signes"],
  emotion: "Histoire, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Bayan", "Al-Sultan"],
  mirrorVersion: `« Nous avons envoyé Moïse avec Nos signes et une autorité évidente. » Le miroir me montre l'histoire de Moïse. « Wa laqad arsalna Musa bi-ayatina wa sultanin mubin » — Nous avons envoyé Moïse avec Nos signes et une autorité évidente. L'histoire est un exemple. Le miroir m'interroge : est-ce que j'apprends de l'histoire de Moïse ?`,
  reflection: `Moïse a été envoyé avec des signes et une autorité évidente vers Pharaon, Haman et Qarun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad arsalna Musa bi-ayatina wa sultanin mubin ila fir'awna wa hamana wa qaruna » — Nous avons envoyé Moïse avec Nos signes et une autorité évidente, vers Pharaon, Haman et Qarun." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire de Moïse ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage des histoires prophétiques est la guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ils dirent : C'est un magicien menteur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des prophètes est guidé." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire de Moïse. Ne permets pas que je l'oublie. Donne-moi la guidance à travers les histoires prophétiques.`
};

MIROIR["40:24"] = {
  reference: "40:24",
  theme: ["mousa", "opposition", "négation"],
  emotion: "Méditation, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Vers Pharaon, Haman et Qarun, mais ils dirent : C'est un magicien menteur. » Le miroir me montre l'opposition des tyrans. « Ila fir'awna wa hamana wa qaruna fa-qalu sahirun kazzab » — vers Pharaon, Haman et Qarun, mais ils dirent : C'est un magicien menteur. L'accusation est typique. Le miroir m'interroge : est-ce que j'accuse les véridiques ?`,
  reflection: `Les tyrans ont accusé Moïse d'être un magicien menteur. L'accusation ne change pas la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila fir'awna wa hamana wa qaruna fa-qalu sahirun kazzab » — vers Pharaon, Haman et Qarun, mais ils dirent : C'est un magicien menteur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accuse les véridiques ? Ou est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance des véridiques est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'accusation ne change pas la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît les véridiques est sur la bonne voie." }
  ],
  munajat: `Ya Haqq, je reconnais les véridiques. Ne permets pas que je les accuse. Donne-moi la foi qui reconnaît la vérité.`
};

MIROIR["40:25"] = {
  reference: "40:25",
  theme: ["opposition", "croyants", "persécution"],
  emotion: "Tristesse, résistance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nasr", "Al-Sabr"],
  mirrorVersion: `« Puis quand il leur eut apporté la vérité de Notre part, ils dirent : Tuez les fils de ceux qui ont cru avec lui. » Le miroir me montre la persécution des croyants. « Falamma ja'ahum bi-al-haqqi min 'indina qalu uqtulu abna'a alladhina amanu ma'ahu » — puis quand il leur eut apporté la vérité, ils dirent : Tuez les fils de ceux qui ont cru avec lui. La persécution est cruelle. Le miroir m'interroge : comment je réagis face à la persécution ?`,
  reflection: `Les croyants ont été persécutés pour leur foi. Allah protège les croyants et détruit les mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ja'ahum bi-al-haqqi min 'indina qalu uqtulu abna'a alladhina amanu ma'ahu wa astahyu nisa'ahum » — puis quand il leur eut apporté la vérité de Notre part, ils dirent : Tuez les fils de ceux qui ont cru avec lui, et laissez vivre leurs femmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face à la persécution ? Est-ce que je suis patient ou je renonce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience face à la persécution est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le stratagème des mécréants n'est qu'erreur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est patient face à la persécution est récompensé." }
  ],
  munajat: `Ya Nasr, donne-moi la patience face à la persécution. Ne permets pas que je renonce. Donne-moi la foi qui résiste à l'épreuve.`
};

MIROIR["40:26"] = {
  reference: "40:26",
  theme: ["pharaon", "mousa", "menace"],
  emotion: "Tension, dramatique",
  difficulty: "débutant",
  relatedNames: ["Al-Mawt", "Al-Hayat"],
  mirrorVersion: `« Et Pharaon dit : Laissez-moi tuer Moïse, et qu'il invoque son Seigneur ! » Le miroir me montre l'arrogance de Pharaon. « Wa qala fir'awnu daruni aqtul Musa wa li-yad'u rabbahu » — et Pharaon dit : Laissez-moi tuer Moïse, et qu'il invoque son Seigneur ! L'arrogance est extrême. Le miroir m'interroge : est-ce que je crains Allah ou je suis arrogant ?`,
  reflection: `Pharaon voulait tuer Moïse par arrogance. Il craignait que Moïse ne change la religion ou ne fasse apparaître la corruption.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala fir'awnu daruni aqtul Musa wa li-yad'u rabbahu inni akhafu an yubaddila dinakum aw an yuzhira fi al-ardi al-fasad » — et Pharaon dit : Laissez-moi tuer Moïse, et qu'il invoque son Seigneur ! Je crains qu'il ne change votre religion ou qu'il ne fasse apparaître la corruption sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah ou je suis arrogant ? Suis-je comme Pharaon ou comme Moïse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité face à Allah est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arrogance de Pharaon l'a conduit à sa perte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est humble face à Allah est protégé." }
  ],
  munajat: `Ya Rabb, je suis humble face à Toi. Ne permets pas que je sois arrogant. Donne-moi la crainte qui mène à l'humilité.`
};

MIROIR["40:27"] = {
  reference: "40:27",
  theme: ["mousa", "confiance", "protection"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Wakil", "Al-Dayyan"],
  mirrorVersion: `« Et Moïse dit : Je cherche protection auprès de mon Seigneur et votre Seigneur, contre tout orgueilleux qui ne croit pas au Jour du Compte. » Le miroir me montre la confiance de Moïse. « Wa qala Musa inni 'udhu bi-rabbi wa rabbikum min kulli mutakabbirin la yu'minu bi-yawmi al-hisab » — et Moïse dit : Je cherche protection auprès de mon Seigneur contre tout orgueilleux qui ne croit pas au Jour du Compte. La confiance est totale. Le miroir m'interroge : est-ce que je cherche la protection d'Allah ?`,
  reflection: `Moïse cherchait protection auprès d'Allah contre les orgueilleux. La protection divine est pour les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala Musa inni 'udhu bi-rabbi wa rabbikum min kulli mutakabbirin la yu'minu bi-yawmi al-hisab » — et Moïse dit : Je cherche protection auprès de mon Seigneur et votre Seigneur, contre tout orgueilleux qui ne croit pas au Jour du Compte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la protection d'Allah ? Ou est-ce que je me repose sur moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection d'Allah est le refuge du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les orgueilleux qui ne croient pas au Jour du Compte sont perdus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la protection d'Allah est en sécurité." }
  ],
  munajat: `Ya Wakil, je cherche Ta protection. Ne permets pas que je sois parmi les orgueilleux. Donne-moi la foi au Jour du Compte.`
};

MIROIR["40:28"] = {
  reference: "40:28",
  theme: ["croyant", "conseil", "courage"],
  emotion: "Inspiration, admiration",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'min", "Al-Nasihah"],
  mirrorVersion: `« Un homme croyant, de la famille de Pharaon, qui cachait sa foi, dit : Tuez-vous un homme parce qu'il dit : Mon Seigneur est Allah ? » Le miroir me montre le courage du croyant caché. « Wa qala rajulun mu'minun min ali fir'awna yaktumu imanahu » — un homme croyant, de la famille de Pharaon, qui cachait sa foi, dit... Le courage est admirable. Le miroir m'interroge : est-ce que j'ai le courage de parler pour la vérité ?`,
  reflection: `Le croyant de la famille de Pharaon a eu le courage de parler pour Moïse. Son conseil était sage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala rajulun mu'minun min ali fir'awna yaktumu imanahu a-taqtuluna rajulan an yaqula rabiyya Allahu » — un homme croyant, de la famille de Pharaon, qui cachait sa foi, dit : Tuez-vous un homme parce qu'il dit : Mon Seigneur est Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai le courage de parler pour la vérité ? Ou est-ce que je me tais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le courage de la vérité est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Il vous est venu avec les preuves évidentes de votre Seigneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a le courage de la vérité est honoré par Allah." }
  ],
  munajat: `Ya Mu'min, donne-moi le courage de la vérité. Ne permets pas que je me taise. Donne-moi la foi qui parle pour la justice.`
};

MIROIR["40:29"] = {
  reference: "40:29",
  theme: ["conseil", "nations", "prospérité"],
  emotion: "Sagesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nasihah", "Al-Ibra"],
  mirrorVersion: `« Ô mon peuple ! Aujourd'hui la royauté vous appartient et vous dominez sur la terre. » Le miroir me montre le conseil du croyant. « Ya qawmi lakumu al-mulku al-yawma zahirina fi al-ardi » — ô mon peuple ! Aujourd'hui la royauté vous appartient et vous dominez sur la terre. La prospérité est temporaire. Le miroir m'interroge : est-ce que je me souviens que la prospérité est temporaire ?`,
  reflection: `Le croyant conseille son peuple : la prospérité actuelle ne durera pas si Allah nous atteint par Son châtiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya qawmi lakumu al-mulku al-yawma zahirina fi al-ardi fa-man yansuruna min ba'si Allahi in ja'ana » — ô mon peuple ! Aujourd'hui la royauté vous appartient et vous dominez sur la terre. Mais qui nous protégera contre le châtiment d'Allah s'il nous atteint ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens que la prospérité est temporaire ? Ou est-ce que je m'y attache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souvenir de la fragilité de la prospérité est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Pharaon dit : Je ne vous montre que ce que je vois et je ne vous guide que sur le chemin de la droiture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute le conseil est protégé." }
  ],
  munajat: `Ya Rabb, je me souviens de la fragilité de la prospérité. Ne permets pas que je m'y attache. Donne-moi la sagesse du conseil.`
};

MIROIR["40:30"] = {
  reference: "40:30",
  theme: ["conseil", "nations", "châtiment"],
  emotion: "Mise en garde, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Ibra", "Al-Adab"],
  mirrorVersion: `« Et celui qui croyait dit : Ô mon peuple, je crains pour vous un jour semblable à celui des coalisés. » Le miroir me montre la crainte du croyant pour son peuple. « Wa qala alladhi amana ya qawmi inni akhafu 'alaykum mithla yawmi al-ahzab » — et celui qui croyait dit : Ô mon peuple, je crains pour vous un jour semblable à celui des coalisés. La crainte est pour les autres. Le miroir m'interroge : est-ce que je crains pour les autres ?`,
  reflection: `Le croyant craignait pour son peuple le sort des nations passées. L'exemple des coalisés est un avertissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala alladhi amana ya qawmi inni akhafu 'alaykum mithla yawmi al-ahzab » — et celui qui croyait dit : Ô mon peuple, je crains pour vous un jour semblable à celui des coalisés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains pour les autres ? Ou est-ce que je suis indifférent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte pour les autres est la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sort des coalisés est un avertissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint pour les autres est miséricordieux." }
  ],
  munajat: `Ya Rabb, je crains pour les autres. Ne permets pas que je sois indifférent. Donne-moi la miséricorde qui craint pour autrui.`
};

MIROIR["40:31"] = {
  reference: "40:31",
  theme: ["nations", "exemples", "destruction"],
  emotion: "Mise en garde, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Qasas", "Al-Ibra"],
  mirrorVersion: `« Comme le sort du peuple de Noé, des Aad, des Thamoud et de ceux qui vinrent après eux. » Le miroir me montre les exemples historiques. « Mithla da'bi qawmi nuhin wa 'adin wa thamuda wa alladhina min ba'dihim » — comme le sort du peuple de Noé, des Aad, des Thamoud et de ceux qui vinrent après eux. Les exemples sont nombreux. Le miroir m'interroge : est-ce que j'apprends de ces exemples ?`,
  reflection: `Les nations passées ont été détruites pour leur négation. Allah ne veut pas l'injustice pour les serviteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mithla da'bi qawmi nuhin wa 'adin wa thamuda wa alladhina min ba'dihim wa ma Allahu yuridu zhalman lil-'ibad » — comme le sort du peuple de Noé, des Aad, des Thamoud et de ceux qui vinrent après eux. Allah ne veut pas l'injustice pour les serviteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de ces exemples ? Ou est-ce que je les oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'apprentissage des exemples est la protection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah ne veut pas l'injustice pour les serviteurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des exemples est protégé." }
  ],
  munajat: `Ya Rabb, j'apprends des exemples des nations passées. Ne permets pas que je les oublie. Donne-moi la protection par la sagesse.`
};

MIROIR["40:32"] = {
  reference: "40:32",
  theme: ["jugement", "appel", "crise"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Da'wah", "Al-Qiyamah"],
  mirrorVersion: `« Ô mon peuple, je crains pour vous le jour de l'appel mutuel. » Le miroir me montre la crainte du Jour du Jugement. « Ya qawmi inni akhafu 'alaykum yawma al-tanad » — ô mon peuple, je crains pour vous le jour de l'appel mutuel. Le Jour est terrifiant. Le miroir m'interroge : est-ce que je crains ce Jour ?`,
  reflection: `Le jour de l'appel mutuel est le Jour du Jugement. C'est un jour de détresse pour les injustes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya qawmi inni akhafu 'alaykum yawma al-tanad yawma tuwalluna mudbirin » — ô mon peuple, je crains pour vous le jour de l'appel mutuel, le jour où vous tournerez le dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains ce Jour ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte du Jour est la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce Jour nul protecteur contre Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint ce Jour se prépare." }
  ],
  munajat: `Ya Rabb, je crains le Jour de l'appel mutuel. Ne permets pas que je l'oublie. Donne-moi la préparation pour ce Jour.`
};

MIROIR["40:33"] = {
  reference: "40:33",
  theme: ["fuite", "désespoir", "protection"],
  emotion: "Effroi, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Mawt", "Al-Hisab"],
  mirrorVersion: `« Le jour où vous tournerez le dos, nul protecteur pour vous contre Allah. » Le miroir me montre la fuite sans protection. « Yawma tuwalluna mudbirin ma lakum mina Allahi min 'asim » — le jour où vous tournerez le dos, nul protecteur pour vous contre Allah. La fuite est vaine. Le miroir m'interroge : est-ce que je me prépare pour éviter cette fuite ?`,
  reflection: `Le Jour du Jugement, les injustes fuiront sans protecteur. Et quiconque Allah égare n'a pas de guide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma tuwalluna mudbirin ma lakum mina Allahi min 'asim wa man yudlili Allahu fa-ma lahu min had » — le jour où vous tournerez le dos, nul protecteur pour vous contre Allah. Et quiconque Allah égare n'a pas de guide." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour éviter cette fuite ? Ou serai-je parmi les fuyards ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation évite la fuite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nul protecteur contre Allah ce Jour-là." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas besoin de fuir." }
  ],
  munajat: `Ya Hadi, je me prépare pour le Jour du Jugement. Ne permets pas que je fuie. Donne-moi un guide vers Toi.`
};

MIROIR["15:69"] = {
  reference: "15:69",
  theme: ["piété", "commandement", "ignorance"],
  emotion: "Supplication, gravité",
  difficulty: "débutant",
  relatedNames: ["At-Taqwa", "Al-Jahalah"],
  mirrorVersion: `« Craignez Allah et ne me déshonorez pas. » Le miroir me montre l'appel à la piété. « Attaquna Allahi wa la tukhzun » — craignez Allah et ne me déshonorez pas. La piété protège du déshonneur. Le miroir m'interroge : est-ce que je crains Allah dans mes actes ?`,
  reflection: `La piété protège du déshonneur. Craindre Allah est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Attaquna Allahi wa la tukhzun » — craignez Allah et ne me déshonorez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah dans mes actes ? Ou est-ce que je L'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte d'Allah purifie les actes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La piété est la protection contre le déshonneur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah préserve son honneur." }
  ],
  munajat: `Ya Rabb, je Te crains dans mes actes. Ne permets pas que je T'oublie. Préserve mon honneur par ma piété.`
};

MIROIR["15:70"] = {
  reference: "15:70",
  theme: ["interdiction", "hôtes", "ignorance"],
  emotion: "Défi, ignorance",
  difficulty: "débutant",
  relatedNames: ["An-Nahy", "Al-Jahalah"],
  mirrorVersion: `« Ils dirent : "Ne t'avions-nous pas interdit de recevoir qui que ce soit ?" » Le miroir me montre l'ignorance des habitants. « Qalu a-wa lam nahaka 'ani al-'alamin » — ils dirent : Ne t'avions-nous pas interdit de recevoir qui que ce soit ? L'interdiction injuste. Le miroir m'interroge : est-ce que j'interdis ce qui est bon ?`,
  reflection: `L'interdiction injuste est le signe de l'ignorance. Permettre le bien est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu a-wa lam nahaka 'ani al-'alamin » — ils dirent : Ne t'avions-nous pas interdit de recevoir qui que ce soit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'interdis ce qui est bon ? Ou est-ce que je permets le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Permettre le bien est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'interdiction injuste mène à la destruction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui permet le bien participe à la miséricorde." }
  ],
  munajat: `Ya Rabb, je veux permettre le bien. Ne permets pas que j'interdisse ce qui est bon. Donne-moi la sagesse de discerner le bien du mal.`
};

MIROIR["15:71"] = {
  reference: "15:71",
  theme: ["offrande", "filles", "protection"],
  emotion: "Désespoir, protection",
  difficulty: "avancé",
  relatedNames: ["Lut", "Al-Banat"],
  mirrorVersion: `« Il dit : "Voici mes filles, mariez-les si vous voulez le faire." » Le miroir me montre l'extrême de Lot. « Qala ha'ula'i banati in kuntum fa'ilin » — il dit : Voici mes filles, mariez-les si vous voulez le faire. La protection extrême. Le miroir m'interroge : jusqu'où suis-je prêt à aller pour protéger ?`,
  reflection: `La protection des valeurs est un sacrifice. Être prêt à sacrifier est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ha'ula'i banati in kuntum fa'ilin » — il dit : Voici mes filles, mariez-les si vous voulez le faire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Jusqu'où suis-je prêt à aller pour protéger ? Suis-je prêt à sacrifier ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice pour protéger est un acte de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La protection des valeurs demande du sacrifice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sacrifie pour la vérité est honoré par Allah." }
  ],
  munajat: `Ya Rabb, je suis prêt à sacrifier pour la vérité. Ne permets pas que je recule. Donne-moi le courage de la protection.`
};

MIROIR["15:72"] = {
  reference: "15:72",
  theme: ["vie", "égarement", "aveuglement"],
  emotion: "Tristesse, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hayah", "At-Tayh"],
  mirrorVersion: `« Par ta vie ! Ils étaient dans leur égarement aveuglés. » Le miroir me montre l'état des égarés. « La'amruka innahum la-fi sakratihim ya'mahun » — par ta vie ! Ils étaient dans leur égarement aveuglés. L'égarement rend aveugle. Le miroir m'interroge : est-ce que je suis aveuglé par mon égarement ?`,
  reflection: `L'égarement rend aveugle. Chercher la vision est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La'amruka innahum la-fi sakratihim ya'mahun » — par ta vie ! Ils étaient dans leur égarement aveuglés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis aveuglé par mon égarement ? Ou est-ce que je cherche la vision ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La recherche de la vision libère de l'égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'égarement est une forme d'aveuglement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la vision trouve la vérité." }
  ],
  munajat: `Ya Rabb, je cherche la vision. Ne permets pas que je sois aveuglé par l'égarement. Ouvre mes yeux à Ta vérité.`
};

MIROIR["15:73"] = {
  reference: "15:73",
  theme: ["châtiment", "matin", "révélation"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["As-Subh", "As-Sayhah"],
  mirrorVersion: `« Le Cri les saisit au lever du soleil. » Le miroir me montre le moment du châtiment. « Fa-akhadhathumu al-sayhatu mushriqin » — le Cri les saisit au lever du soleil. Le châtiment vient au moment prévu. Le miroir m'interroge : suis-je prêt pour le moment du châtiment ?`,
  reflection: `Le châtiment vient au moment prévu. Être prêt est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhadhathumu al-sayhatu mushriqin » — le Cri les saisit au lever du soleil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le moment du châtiment ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation constante protège du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment vient au moment décidé par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'est pas pris au dépourvu." }
  ],
  munajat: `Ya Rabb, je veux être prêt. Ne permets pas l'insouciance. Prépare-moi pour chaque moment décisif.`
};

MIROIR["15:74"] = {
  reference: "15:74",
  theme: ["renversement", "destruction", "punition"],
  emotion: "Mise en garde, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'tafikah", "Al-Ghayth"],
  mirrorVersion: `« Nous renversâmes la ville et fîmes pleuvoir sur eux des pierres d'argile. » Le miroir me montre la destruction totale. « Fa-ja'alna 'aliyaha safilaha wa amtarna 'alayhim hijaratan min sijjil » — Nous renversâmes la ville et fîmes pleuvoir sur eux des pierres d'argile. La destruction est totale. Le miroir m'interroge : est-ce que je crains une telle destruction ?`,
  reflection: `La destruction des criminels est totale. La craindre motive la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ja'alna 'aliyaha safilaha wa amtarna 'alayhim hijaratan min sijjil » — Nous renversâmes la ville et fîmes pleuvoir sur eux des pierres d'argile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains une telle destruction ? Ou suis-je insouciant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété protège de la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La destruction vient aux criminels." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux n'a pas à craindre la destruction." }
  ],
  munajat: `Ya Rabb, je crains la destruction. Ne permets pas l'insouciance. Protège-moi par ma piété.`
};

MIROIR["15:75"] = {
  reference: "15:75",
  theme: ["signes", "contemplation", "réflexion"],
  emotion: "Sagesse, méditation",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-I'tibar"],
  mirrorVersion: `« Il y a là des signes pour ceux qui méditent. » Le miroir me montre l'invitation à la méditation. « Inna fi dhalika la-ayatin li-l-mutawassimin » — il y a là des signes pour ceux qui méditent. La méditation révèle les signes. Le miroir m'interroge : est-ce que je médite sur les signes ?`,
  reflection: `La méditation révèle les signes. Méditer est essentiel pour comprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fi dhalika la-ayatin li-l-mutawassimin » — il y a là des signes pour ceux qui méditent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les signes ? Ou est-ce que je passe sans réfléchir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation ouvre les yeux aux signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout pour ceux qui méditent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite découvre la sagesse." }
  ],
  munajat: `Ya Rabb, je veux méditer sur Tes signes. Ne permets pas que je passe sans réfléchir. Ouvre mon cœur à la contemplation.`
};

MIROIR["15:76"] = {
  reference: "15:76",
  theme: ["route", "passage", "témoignage"],
  emotion: "Réalité, leçon",
  difficulty: "débutant",
  relatedNames: ["As-Sabil", "Al-Ibhar"],
  mirrorVersion: `« Elle est sur une route bien connue. » Le miroir me montre la visibilité du châtiment. « Wa innaha la-bi-sabilin muqim » — elle est sur une route bien connue. Les ruines sont visibles. Le miroir m'interroge : est-ce que je tire leçon des ruines visibles ?`,
  reflection: `Les ruines sont visibles. En tirer leçon est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa innaha la-bi-sabilin muqim » — elle est sur une route bien connue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je tire leçon des ruines visibles ? Ou est-ce que je passe sans réfléchir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La leçon des ruines protège de la même fin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les ruines sont des témoins pour les générations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire leçon des ruines est sauvé." }
  ],
  munajat: `Ya Rabb, je tire leçon des ruines visibles. Ne permets pas que je passe sans réfléchir. Ouvre mes yeux aux leçons du passé.`
};

MIROIR["15:77"] = {
  reference: "15:77",
  theme: ["signes", "croyants", "foi"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Mu'minun"],
  mirrorVersion: `« Il y a là un signe pour les croyants. » Le miroir me montre le signe pour les croyants. « Inna fi dhalika la-ayatan li-l-mu'minin » — il y a là un signe pour les croyants. Les croyants voient les signes. Le miroir m'interroge : est-ce que je suis de ceux qui voient les signes ?`,
  reflection: `Les croyants voient les signes. Avoir la foi qui voit est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fi dhalika la-ayatan li-l-mu'minin » — il y a là un signe pour les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis de ceux qui voient les signes ? Ou est-ce que je suis aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi ouvre les yeux aux signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont pour les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi voit les signes partout." }
  ],
  munajat: `Ya Rabb, je veux avoir la foi qui voit les signes. Ne permets pas que je sois aveugle. Ouvre mes yeux par ma foi.`
};

MIROIR["15:78"] = {
  reference: "15:78",
  theme: ["habitants", "forêt", "injustice"],
  emotion: "Mise en garde, réalité",
  difficulty: "débutant",
  relatedNames: ["Ashab Al-Aykah", "Ath-Thamud"],
  mirrorVersion: `« Les habitants du bois furent aussi injustes. » Le miroir me montre l'exemple des habitants du bois. « Wa in kana ashabu al-aykati la-zalimin » — les habitants du bois furent aussi injustes. L'injustice mène à la destruction. Le miroir m'interroge : est-ce que j'évite l'injustice ?`,
  reflection: `L'injustice mène à la destruction. L'éviter est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kana ashabu al-aykati la-zalimin » — les habitants du bois furent aussi injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'évite l'injustice ? Ou est-ce que je la pratique ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice est le chemin du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'injustice attire la destruction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique la justice est sauvé." }
  ],
  munajat: `Ya Rabb, je veux éviter l'injustice. Ne permets pas que je la pratique. Guide-moi sur le chemin de la justice.`
};

