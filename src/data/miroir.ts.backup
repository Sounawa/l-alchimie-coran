    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La guidance sur le chemin droit est le plus grand don." }
  ],
  munajat: `Ya Hadi, guide-moi sur le chemin droit. Ne me laisse pas dévier.`
};

