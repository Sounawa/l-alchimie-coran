    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la grandeur se prépare." }
  ],
  munajat: `Ya Rabb, fais que je réalise la grandeur du Jour. Prépare-moi pour la Décision.`
};

MIROIR["77:15"] = {
