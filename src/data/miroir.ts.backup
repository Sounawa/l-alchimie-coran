    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la transgression évite l'Enfer." }
  ],
  munajat: `Ya Rabb, j'évite la transgression. Ne permets pas que je sois parmi les transgresseurs. Sauve-moi de l'Enfer.`
};

