    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels débats dois-je abandonner devant la vérité divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argument décisif clôture les disputes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité d'Allah est finale et parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La soumission à l'argument divin apaise le cœur." }
  ],
  munajat: `Ya Rabb, Ton argument est décisif. Fais que je me soumette à Ta vérité. Ne permets pas que je dispute inutilement.`
};

MIROIR["6:150"] = {
  reference: "6:150",
  theme: ["témoins", "interdits", "innovation"],
  emotion: "Défi, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shuhada'", "Al-Haram"],
  mirrorVersion: `« Dis : Amenez vos témoins qui témoigneraient qu'Allah a interdit ceci. » Le miroir défie : « Qul halumma shuhada'akum » — dis : Amenez vos témoins qui témoigneraient qu'Allah a interdit ceci. Le défi est lancé aux inventeurs. Le miroir m'enseigne : la charge de la preuve est sur celui qui interdit.`,
  reflection: `La charge de la preuve est sur celui qui interdit.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul halumma shuhada'akum » — dis : Amenez vos témoins qui témoigneraient qu'Allah a interdit ceci." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles preuves ai-je pour mes interdits inventés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'absence de preuve montre l'invention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah a le droit d'interdire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité devant le Texte protège de l'invention." }
  ],
  munajat: `Ya Rabb, je ne veux pas interdire ce que Tu n'as pas interdit. Fais que je reste dans les limites de Ta loi. Ne permets pas l'excès.`
};

MIROIR["6:151"] = {
  reference: "6:151",
  theme: ["commandements", "parents", "meurtre"],
  emotion: "Gravité, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Walidayn", "Al-Qatl"],
  mirrorVersion: `« Dis : Venez, je vais réciter ce que votre Seigneur vous a interdit : ne Lui associez rien. » Le miroir énonce : « Qul ta'alaw atlu ma harrama rabbukum » — dis : Venez, je vais réciter ce que votre Seigneur vous a interdit. Les commandements sont clairs. Le miroir m'enseigne : les fondements sont simples.`,
  reflection: `Les fondements sont simples : tawhid, bonté envers les parents, préservation de la vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ta'alaw atlu ma harrama rabbukum » — dis : Venez, je vais réciter ce que votre Seigneur vous a interdit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais les interdits fondamentaux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté des interdits montre la facilité de la religion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ces commandements sont universels." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La simplicité des fondements permet l'application." }
  ],
  munajat: `Ya Rabb, merci pour la clarté des commandements. Fais que je les observe. Ne permets pas que je les oublie.`
};

MIROIR["6:152"] = {
  reference: "6:152",
  theme: ["justice", "orphelins", "balance"],
  emotion: "Justice, intégrité",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Yatim"],
  mirrorVersion: `« Et ne vous approchez des biens de l'orphelin que de la meilleure façon. » Le miroir protège : « Wa la taqrabu mala al-yatimi illa bi-allati hiya ahsan » — et ne vous approchez des biens de l'orphelin que de la meilleure façon. La protection des vulnérables est sacrée. Le miroir m'enseigne : la société se mesure à son traitement des faibles.`,
  reflection: `La société se mesure à son traitement des faibles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqrabu mala al-yatimi illa bi-allati hiya ahsan » — et ne vous approchez des biens de l'orphelin que de la meilleure façon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite les vulnérables ? Les orphelins ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection des faibles est un test de foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque société est jugée sur son traitement des vulnérables." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le soin des orphelins est un chemin vers le Paradis." }
  ],
  munajat: `Ya Rabb, protège les orphelins à travers moi. Fais que je sois juste avec les vulnérables. Ne permets pas l'injustice.`
};

MIROIR["6:153"] = {
