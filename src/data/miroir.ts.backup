    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est la grande nouvelle pour moi ? Est-ce que je la prends au sérieux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prise au sérieux de la grande nouvelle change la vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grande nouvelle concerne tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prend au sérieux la grande nouvelle se prépare." }
  ],
  munajat: `Ya Rabb, je prends au sérieux la grande nouvelle. Prépare-moi pour le Jour du Jugement.`
};

MIROIR["78:3"] = {
  reference: "78:3",
  theme: ["division", "controversé", "discussion"],
  emotion: "Méditation, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ikhtilaf", "Al-Mukhatalif"],
  mirrorVersion: `« Sur laquelle ils divergent. » Le miroir me montre la divergence humaine. « Alladhi hum fihi mukhtalifun » — sur laquelle ils divergent. La divergence. Le miroir m'enseigne : les humains divergent sur la vérité.`,
  reflection: `La divergence sur la grande nouvelle. Certains croient, d'autres non.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi hum fihi mukhtalifun » — sur laquelle ils divergent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quel côté suis-je ? Crois-je ou diverge-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi unit au lieu de diverger." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une, même si les opinions divergent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit ne diverge pas de la vérité." }
  ],
  munajat: `Ya Rabb, je crois et je ne diverge pas. Donne-moi la foi qui unit à la vérité.`
};

MIROIR["78:4"] = {
  reference: "78:4",
  theme: ["savoir", "connaissance", "certitude"],
  emotion: "Assurance, conviction",
  difficulty: "débutant",
  relatedNames: ["Al-Ilm", "Al-Yaqin"],
  mirrorVersion: `« Non ! Ils vont savoir. » Le miroir me montre la certitude à venir. « Kalla sawfa ya'lamun » — non ! Ils vont savoir. La certitude. Le miroir m'avertit : les négateurs sauront bientôt.`,
  reflection: `Ils sauront. La connaissance viendra, peut-être trop tard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalla sawfa ya'lamun » — non ! Ils vont savoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sais maintenant ? Ou est-ce que j'attends de savoir trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le savoir maintenant évite le savoir trop tard." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La connaissance de la vérité est certaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait maintenant est sage." }
  ],
  munajat: `Ya Rabb, je veux savoir maintenant. Ne permets pas que j'attende de savoir trop tard. Donne-moi la connaissance de la vérité.`
};

MIROIR["78:5"] = {
