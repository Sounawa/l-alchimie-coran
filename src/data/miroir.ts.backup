  theme: ["ciel", "transformation", "jour"],
  emotion: "Émerveillement, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mutahawwil", "Al-Bari"],
  mirrorVersion: `« Quand le ciel se fendra et deviendra rose, comme du cuir rouge. » Le miroir me montre la transformation cosmique. « Fa-idha inshaqqati al-sama'u fa-kanat wardatan ka-al-dihan » — quand le ciel se fendra et deviendra rose. La transformation est saisissante. Le miroir m'invite à anticiper ce jour.`,
  reflection: `Le ciel se transformera au Jour du Jugement. La beauté sera terrifiante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha inshaqqati al-sama'u fa-kanat wardatan ka-al-dihan » — quand le ciel se fendra et deviendra rose, comme du cuir rouge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour ce jour de transformation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La beauté du ciel transformé peut être terreur pour les uns, merveille pour les autres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel qui nous protège se transformera." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est transformé maintenant ne craint pas la transformation." }
  ],
  munajat: `Ya Mutahawwil, le ciel se transformera. Prépare-moi pour ce jour. Fais que je sois transformé maintenant pour ne pas craindre alors.`
};

