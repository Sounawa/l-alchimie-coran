// ==================== SURAH 68: AL-QALAM - COMPLETION (68:32-68:34, 68:37-68:50) ====================

MIROIR["68:32"] = {
  reference: "68:32",
  theme: ["espoir", "remplacement", "meilleur"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahhab", "Al-Karim"],
  mirrorVersion: `« Peut-être notre Seigneur nous donnera-t-il en échange quelque chose de meilleur. » Le miroir me montre l'espoir après la perte. « 'Asa rabbuna an yubdilana khayran minha » — peut-être notre Seigneur nous donnera-t-il en échange quelque chose de meilleur. Les propriétaires du jardin repenti espèrent un meilleur. Le miroir m'interroge : est-ce que j'ai de l'espoir après la perte ?`,
  reflection: `L'espoir en Allah après une perte est un signe de foi. Il peut remplacer par mieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Asa rabbuna an yubdilana khayran minha » — peut-être notre Seigneur nous donnera-t-il en échange quelque chose de meilleur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai de l'espoir après la perte ? Est-ce que je fais confiance au remplacement divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte peut être le prélude à un gain meilleur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah peut remplacer toute chose par meilleure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère après la perte reçoit le meilleur." }
  ],
  munajat: `Ya Wahhab, Tu donnes et Tu remplaces. J'espère un meilleur après ma perte. Ne permets pas que je désespère.`
};

MIROIR["68:33"] = {
  reference: "68:33",
  theme: ["châtiment", "ignoble", "avertissement"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Tel est le châtiment. Et le châtiment de l'au-delà est plus grand, s'ils savaient. » Le miroir me montre la comparaison des châtiments. « Kadhalika al-'adhabu wa la'adhabu al-akhirati akbaru law kanu ya'lamun » — tel est le châtiment. Et le châtiment de l'au-delà est plus grand, s'ils savaient. Le châtiment terrestre n'est rien comparé à celui de l'au-delà. Le miroir m'interroge : est-ce que je crains le châtiment éternel ?`,
  reflection: `Le châtiment de l'au-delà dépasse tout châtiment terrestre. La conscience de ce fait doit motiver la piété.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika al-'adhabu wa la'adhabu al-akhirati akbaru law kanu ya'lamun » — tel est le châtiment. Et le châtiment de l'au-delà est plus grand, s'ils savaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment éternel ? Est-ce que je réalise sa gravité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment terrestre est un avertissement. Le châtiment éternel est la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite dans les deux mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise la gravité du châtiment éternel se repent." }
  ],
  munajat: `Ya Jabbar, je crains le châtiment éternel. Préserve-moi du châtiment de l'au-delà. Ne permets pas que je le mérite.`
};

MIROIR["68:34"] = {
  reference: "68:34",
  theme: ["paradis", "pieux", "récompense"],
  emotion: "Espoir, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wadud"],
  mirrorVersion: `« Les pieux auront auprès de leur Seigneur des jardins de délices. » Le miroir me montre la récompense. « Inna lil-muttaqina 'inda rabbihim jannati al-na'im » — les pieux auront des jardins de délices. La récompense est pour les pieux. Le miroir m'interroge : est-ce que je suis des pieux ?`,
  reflection: `Les jardins de délices sont la récompense des pieux. La piété mène au paradis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna lil-muttaqina 'inda rabbihim jannati al-na'im » — les pieux auront auprès de leur Seigneur des jardins de délices." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis des pieux ? Est-ce que je mérite les jardins de délices ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La piété ici-bas mène aux délices là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jardins du paradis dépassent toute imagination." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est pieux goûte déjà au paradis ici-bas." }
  ],
  munajat: `Ya Karim, les jardins de délices sont pour les pieux. Fais que je sois des pieux. Donne-moi les jardins du paradis.`
};

MIROIR["68:37"] = {
  reference: "68:37",
  theme: ["livre", "lecture", "question"],
  emotion: "Interpellation, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hakim"],
  mirrorVersion: `« Ou avez-vous un livre où vous apprenez ? » Le miroir me pose la question de la source. « Am lakum kitabun fihi tadrusun » — ou avez-vous un livre où vous apprenez ? Les mécréants prétendent sans preuve. Le miroir m'interroge : quelle est ma source de connaissance ?`,
  reflection: `La vérité vient d'Allah, pas des prétentions humaines. Un livre divin est nécessaire pour la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lakum kitabun fihi tadrusun » — ou avez-vous un livre où vous apprenez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma source de connaissance ? Est-ce la révélation ou mes prétentions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Sans livre divin, les prétentions sont vides." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la seule source fiable de vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le livre divin est guidé." }
  ],
  munajat: `Ya Haqq, Ton livre est ma source. Fais que je l'étudie et le suive. Ne permets pas que je suive mes prétentions.`
};

MIROIR["68:38"] = {
  reference: "68:38",
  theme: ["choix", "prétention", "réalité"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Haqq"],
  mirrorVersion: `« Vous avez certes ce que vous choisissez. » Le miroir me montre la prétention des mécréants. « Inna lakum fihi la-ma takhayyarun » — vous avez certes ce que vous choisissez. Ils prétendent pouvoir choisir leur destin. Le miroir m'interroge : est-ce que je prétends contrôler mon destin ?`,
  reflection: `L'homme ne choisit pas son destin. Allah décide de tout. La prétention est une illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna lakum fihi la-ma takhayyarun » — vous avez certes ce que vous choisissez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prétends contrôler mon destin ? Ou est-ce que je soumets à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix apparent cache la réalité du décret." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est le Décideur. L'homme est le soumis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soumet son choix à Allah est libre." }
  ],
  munajat: `Ya Hakam, Tu décides de tout. Je soumets mon choix à Toi. Ne permets pas que je prétende contrôler mon destin.`
};

MIROIR["68:39"] = {
  reference: "68:39",
  theme: ["serment", "engagement", "question"],
  emotion: "Interpellation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Qahhar"],
  mirrorVersion: `« Ou avez-vous reçu de Nous des engagements valables jusqu'au Jour de la Résurrection ? » Le miroir pose la question des engagements. « Am lakum aymamun 'alayna balighatun ila yawmi al-qiyamah » — ou avez-vous des engagements valables jusqu'au Jour ? Les mécréants n'ont aucun engagement d'Allah. Le miroir m'interroge : est-ce que j'ai un engagement avec Allah ?`,
  reflection: `Allah n'a promis le paradis qu'aux croyants. Les mécréants n'ont aucun engagement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lakum aymamun 'alayna balighatun ila yawmi al-qiyamah » — ou avez-vous reçu de Nous des engagements valables jusqu'au Jour de la Résurrection ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai un engagement avec Allah ? Est-ce que je suis les conditions de Son engagement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'engagement d'Allah est pour les croyants, pas les mécréants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est vraie pour ceux qui croient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore l'engagement reçoit la promesse." }
  ],
  munajat: `Ya Wahid, Ton engagement est pour les croyants. Fais que je sois des croyants. Honore Ton engagement envers moi.`
};

MIROIR["68:40"] = {
  reference: "68:40",
  theme: ["question", "véracité", "défi"],
  emotion: "Interpellation, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Shahid"],
  mirrorVersion: `« Demande-leur lequel d'entre eux en est garant. » Le miroir me montre le défi. « Salahum ayyuhum bi-dhalika za'im » — demande-leur lequel d'entre eux en est garant. Personne ne peut garantir les prétentions des mécréants. Le miroir m'interroge : est-ce que je peux garantir mes prétentions ?`,
  reflection: `Les prétentions sans preuve sont vides. Seul Allah peut garantir la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salahum ayyuhum bi-dhalika za'im » — demande-leur lequel d'entre eux en est garant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je peux garantir mes prétentions ? Ou est-ce que je parle sans preuve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La garantie vient de la vérité, pas de la prétention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Seul Allah garantit la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garantit la vérité est véridique." }
  ],
  munajat: `Ya Haqq, Tu es la vérité. Fais que je ne prétende que ce qui est vrai. Ne permets pas que je parle sans garantie.`
};

MIROIR["68:41"] = {
  reference: "68:41",
  theme: ["associés", "vérité", "question"],
  emotion: "Interpellation, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Ou ont-ils des associés ? Qu'ils fassent donc venir leurs associés. » Le miroir me montre l'absurdité de l'association. « Am lahum shuraka'u fa-laya'tu bi-shuraka'ihim » — ou ont-ils des associés ? Qu'ils les fassent venir. Les associés n'existent pas. Le miroir m'interroge : est-ce que j'associe à Allah ?`,
  reflection: `Les associés sont une illusion. Seul Allah existe et peut aider.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am lahum shuraka'u fa-laya'tu bi-shuraka'ihim in kanu sadiqin » — ou ont-ils des associés ? Qu'ils fassent donc venir leurs associés, s'ils sont véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'associe à Allah ? Quels sont mes faux associés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les associés ne peuvent rien. Allah seul peut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'unicité est la vérité. L'association est le mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui abandonne les associés trouve Allah." }
  ],
  munajat: `Ya Ahad, Tu es l'Unique. Je n'ai pas d'associés. Fais que je T'invoque seul, sans rien associer.`
};

MIROIR["68:42"] = {
  reference: "68:42",
  theme: ["jambe", "jour", "révélation"],
  emotion: "Crainte, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jalil", "Al-Jabbar"],
  mirrorVersion: `« Le jour où la jambe sera découverte et où ils seront appelés à se prosterner. » Le miroir me montre le Jour redoutable. « Yawma yukshafu 'an saqin wa yud'awna ila al-sujud » — le jour où la jambe sera découverte. Ce jour sera terrifiant. Le miroir m'interroge : est-ce que je suis prêt pour ce jour ?`,
  reflection: `Le Jour où la jambe sera découverte est un jour de terreur. La prosternation sera demandée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yukshafu 'an saqin wa yud'awna ila al-sujud » — le jour où la jambe sera découverte et où ils seront appelés à se prosterner." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour ce jour ? Est-ce que je peux me prosterner ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation maintenant prépare pour ce jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce jour révélera la vraie nature de chacun." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne maintenant se prosterner là-bas." }
  ],
  munajat: `Ya Jalil, ce jour sera terrifiant. Prépare-moi pour la prosternation. Ne permets pas que je sois incapable de me prosterner.`
};

MIROIR["68:43"] = {
  reference: "68:43",
  theme: ["regard", "humiliation", "incapacité"],
  emotion: "Honte, terreur",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Mutakabbir"],
  mirrorVersion: `« Leurs regards seront baissés, l'avilissement les couvrira. » Le miroir me montre l'humiliation. « Khasi'atin absaruhum tarhaquhum dhillah » — leurs regards seront baissés, l'avilissement les couvrira. Les mécréants seront humiliés. Le miroir m'interroge : est-ce que je veux éviter cette humiliation ?`,
  reflection: `L'humiliation des mécréants sera totale. Leurs regards baissés, couverts d'avilissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khasi'atin absaruhum tarhaquhum dhillah wa qad kanu yud'awna ila al-sujud wa hum salimun » — leurs regards seront baissés, l'avilissement les couvrira. Ils étaient appelés à se prosterner quand ils étaient sains." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux éviter cette humiliation ? Est-ce que je me prosterne maintenant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation quand on est sain évite l'humiliation quand on est jugé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humiliation suit le refus de se prosterner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne maintenant sera élevé là-bas." }
  ],
  munajat: `Ya Jabbar, je ne veux pas être humilié. Fais que je me prosterne maintenant. Ne permets pas que je refuse la prosternation.`
};

MIROIR["68:44"] = {
  reference: "68:44",
  theme: ["égarement", "châtiment", "incrédulité"],
  emotion: "Crainte, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mudill", "Al-Jabbar"],
  mirrorVersion: `« Laisse-Moi donc avec celui qui traite ce discours de mensonge. » Le miroir me montre la menace. « Fadharni wa man yukadhdhibu bi-hadha al-hadith » — laisse-Moi avec celui qui traite ce discours de mensonge. Allah s'occupera des négateurs. Le miroir m'interroge : est-ce que je traite le Coran de mensonge ?`,
  reflection: `Ceux qui nient le Coran seront traités par Allah. Laissez-les à leur sort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fadharni wa man yukadhdhibu bi-hadha al-hadith » — laisse-Moi donc avec celui qui traite ce discours de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite le Coran de mensonge ? Ou est-ce que je le respecte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déni du Coran mène au châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah est la vérité. La nier est l'égarement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le Coran est sauvé." }
  ],
  munajat: `Ya Rabb, je ne traite pas Ton discours de mensonge. Je l'accepte et le respecte. Préserve-moi du sort des négateurs.`
};

MIROIR["68:45"] = {
  reference: "68:45",
  theme: ["délai", "ruse", "patience"],
  emotion: "Lucidité, prudence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halim", "Al-Muhlik"],
  mirrorVersion: `« Nous leur donnons du délai, car Mon ruse est solide. » Le miroir me montre la stratégie divine. « Wa mustadrijuhim min haythu la ya'lamun » — Nous leur donnons du délai. Ma ruse est solide. Le délai n'est pas l'oubli. Le miroir m'interroge : est-ce que j'utilise le délai pour me repentir ?`,
  reflection: `Le délai d'Allah est une opportunité de repentir, pas une preuve de Sa négligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa umli lahum inna kaydi matin » — et Je leur donne du délai, car Mon ruse est solide." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise le délai pour me repentir ? Ou est-ce que je m'enfonce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde cachée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ruse d'Allah attrape les négateurs au moment imprévu." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le délai se repent rapidement." }
  ],
  munajat: `Ya Halim, Tu donnes du délai. Je me repends pendant ce délai. Ne permets pas que je sois attrapé par Ton ruse.`
};

MIROIR["68:46"] = {
  reference: "68:46",
  theme: ["récompense", "dette", "question"],
  emotion: "Interpellation, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Karim"],
  mirrorVersion: `« Ou leur demandes-tu un salaire, de sorte qu'ils soient chargés d'une dette ? » Le miroir me montre la gratuité du message. « Am tas'aluhum ajran fahum min maghramin muthqalun » — ou leur demandes-tu un salaire ? Le Prophète ne demandait rien. Le miroir m'interroge : est-ce que je comprends que la vérité est gratuite ?`,
  reflection: `Le message du Prophète était gratuit. Il ne demandait rien en échange.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am tas'aluhum ajran fahum min maghramin muthqalun » — ou leur demandes-tu un salaire, de sorte qu'ils soient chargés d'une dette ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la vérité est gratuite ? Ou est-ce que je m'attends à une récompense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est offerte. La recevoir est une grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est un don, pas une transaction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit gratuitement donne gratuitement." }
  ],
  munajat: `Ya Ghani, Tu offres la vérité gratuitement. Je la reçois avec gratitude. Ne permets pas que je la marchande.`
};

MIROIR["68:47"] = {
  reference: "68:47",
  theme: ["invisible", "science", "question"],
  emotion: "Lucidité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Ou détiennent-ils l'Invisible, pour pouvoir écrire ? » Le miroir me montre la limite de la connaissance. « 'Indahumu al-ghaybu fahum yaktubun » — ou détiennent-ils l'Invisible ? Ils ne peuvent pas écrire ce qu'ils ne savent pas. Le miroir m'interroge : est-ce que je connais l'Invisible ?`,
  reflection: `L'Invisible appartient à Allah seul. L'homme ne peut pas le connaître.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Indahumu al-ghaybu fahum yaktubun » — ou détiennent-ils l'Invisible, pour pouvoir écrire ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je connais l'Invisible ? Ou est-ce que je parle sans savoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La science de l'Invisible est réservée à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a ses secrets que seul Allah connaît." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son ignorance est sur la voie de la connaissance." }
  ],
  munajat: `Ya 'Alim, Tu connais l'Invisible. Je ne connais que ce que Tu m'as révélé. Ne permets pas que je prétende connaître ce que je ne sais pas.`
};

MIROIR["68:48"] = {
  reference: "68:48",
  theme: ["patience", "Yunus", "exemple"],
  emotion: "Patience, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Sabur", "Al-Halim"],
  mirrorVersion: `« Endure donc avec patience le jugement de ton Seigneur, et ne sois pas comme l'homme au poisson. » Le miroir me donne l'exemple de Yunus. « Fa-isbir li-hukmi rabbika wa la takun kasahibi al-hut » — endure et ne sois pas comme l'homme au poisson. Yunus a perdu patience. Le miroir m'interroge : est-ce que j'endure avec patience ?`,
  reflection: `Yunus a perdu patience dans le ventre du poisson. La patience est essentielle pour le croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-isbir li-hukmi rabbika wa la takun kasahibi al-hut » — endure donc avec patience le jugement de ton Seigneur, et ne sois pas comme l'homme au poisson." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'endure avec patience ? Ou est-ce que je m'impatiente comme Yunus ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impatience de Yunus a mené au poisson. Sa patience l'en a sorti." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La patience est une qualité universelle des prophètes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure avec patience reçoit la délivrance." }
  ],
  munajat: `Ya Sabur, enseigne-moi la patience. Fais que je ne sois pas comme l'homme au poisson. Donne-moi la patience d'endurer Ton jugement.`
};

MIROIR["68:49"] = {
  reference: "68:49",
  theme: ["miséricorde", "Yunus", "grâce"],
  emotion: "Gratitude, espoir",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ar-Rahim"],
  mirrorVersion: `« Si une grâce de son Seigneur ne l'avait pas atteint, il aurait été rejeté sur la terre nue, blâmable. » Le miroir me montre la grâce pour Yunus. « Lawla an tadarakahu ni'matun min rabbihi la-nubudha bi-l-'ara'i wa huwa madhmum » — sans la grâce, il aurait été rejeté, blâmable. La grâce d'Allah a sauvé Yunus. Le miroir m'interroge : est-ce que je reconnais la grâce qui me sauve ?`,
  reflection: `La grâce d'Allah sauve de situations désespérées. Sans elle, nous serions perdus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawla an tadarakahu ni'matun min rabbihi la-nubudha bi-l-'ara'i wa huwa madhmum » — si une grâce de son Seigneur ne l'avait pas atteint, il aurait été rejeté sur la terre nue, blâmable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la grâce qui me sauve ? Combien de fois m'a-t-elle sauvé ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce précède le repentir et le suit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grâce d'Allah atteint chaque créature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la grâce reçoit plus de grâce." }
  ],
  munajat: `Ya Rahman, Ta grâce m'a sauvé maintes fois. Je reconnais Ta grâce. Ne permets pas que je sois rejeté, blâmable.`
};

MIROIR["68:50"] = {
  reference: "68:50",
  theme: ["élection", "Yunus", "bien"],
  emotion: "Gratitude, élection",
  difficulty: "débutant",
  relatedNames: ["Al-Mustafa", "Al-Mu'min"],
  mirrorVersion: `« Mais son Seigneur l'a élu et l'a mis au nombre des justes. » Le miroir me montre l'élection de Yunus. « Fa-ijtabahu rabbuhu fa-ja'alahu mina al-salihin » — son Seigneur l'a élu et l'a mis au nombre des justes. Après l'erreur vient l'élection. Le miroir m'interroge : est-ce que j'espère l'élection après mes erreurs ?`,
  reflection: `L'élection d'Allah peut suivre l'erreur si le repentir est sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ijtabahu rabbuhu fa-ja'alahu mina al-salihin » — mais son Seigneur l'a élu et l'a mis au nombre des justes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère l'élection après mes erreurs ? Est-ce que je me repens sincèrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'erreur suivie de repentir mène à l'élection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah élit qui Il veut parmi les repentants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est élu par Allah est honoré." }
  ],
  munajat: `Ya Rabb, élis-moi après mes erreurs. Fais que je sois du nombre des justes. Accepte mon repentir et élis-moi.`
};

MIROIR["10:35"] = {
  reference: "10:35",
  theme: ["guidance", "égarement", "choix"],
  emotion: "Lucidité, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Dis : Est-ce que parmi vos associés, il en est qui guide vers la vérité ? » Le miroir me montre la question divine. « A-yahdi ila al-haqq » — guide vers la vérité ? Seul Allah guide vers la vérité. Les associés ne peuvent pas guider. Le miroir m'interroge : vers qui je me tourne pour la guidance ?`,
  reflection: `Seul Allah guide vers la vérité. Les fausses divinités ne peuvent pas guider.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul hal min shuraka'ikum man yahdi ila al-haqq » — dis : Est-ce que parmi vos associés, il en est qui guide vers la vérité ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Vers qui je me tourne pour la guidance ? Est-ce que je cherche la guidance auprès d'Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie guidance ne vient que d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout chemin de guidance mène à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la guidance auprès d'Allah la trouve." }
  ],
  munajat: `Ya Hadi, Tu es le seul Guide. Je cherche Ta guidance. Ne permets pas que je cherche la guidance ailleurs. Guide-moi vers la vérité.`
};

MIROIR["10:36"] = {
  reference: "10:36",
  theme: ["conjecture", "vérité", "jugement"],
  emotion: "Lucidité, remise en question",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Alim"],
  mirrorVersion: `« La plupart d'entre eux ne suivent que la conjecture. » Le miroir me montre le danger de la conjecture. « In yattabi'u illa al-zann » — ne suivent que la conjecture. La conjecture ne remplace pas la vérité. Le miroir m'interroge : est-ce que je suis la conjecture ou la vérité ?`,
  reflection: `La conjecture ne sert à rien contre la vérité. Allah sait ce que font les gens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma yattabi'u aktharuhum illa zannan inna al-zanna la yughni min al-haqq shay'an » — la plupart d'entre eux ne suivent que la conjecture. La conjecture ne sert à rien contre la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la conjecture ou la vérité ? Mes croyances sont-elles fondées sur la connaissance ou l'opinion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est plus solide que la conjecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La conjecture est incertaine, la vérité est certaine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la vérité suit le chemin sûr." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Ne permets pas que je suive la conjecture. Donne-moi la connaissance certaine et la vérité claire.`
};

MIROIR["10:37"] = {
  reference: "10:37",
  theme: ["coran", "révélation", "véracité"],
  emotion: "Certitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "An-Nur"],
  mirrorVersion: `« Ce Coran ne peut être forgé par personne en dehors d'Allah. » Le miroir me montre l'origine divine du Coran. « Ma kana hadha al-Qur'an an yuftara » — ce Coran ne peut être forgé. La révélation est divine. Le miroir m'interroge : est-ce que je reconnais l'origine divine du Coran ?`,
  reflection: `Le Coran est la parole d'Allah, confirmant les écritures précédentes. Il est la guidance et la miséricorde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana hadha al-Qur'an an yuftara min duni Allahi wa lakin tasdiqa alladhi bayna yadayhi wa tafsila al-kitab » — ce Coran ne peut être forgé par personne en dehors d'Allah. Mais il confirme ce qui était avant lui et explique en détail l'Écriture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais l'origine divine du Coran ? Est-ce que je le traite comme la parole d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran est la vérité qui confirme les vérités précédentes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le guide pour tous les mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Coran comme parole d'Allah trouve la guidance." }
  ],
  munajat: `Ya Rabb, je reconnais que le Coran est Ta parole. Ne permets pas que je doute de Ta révélation. Fais que le Coran soit ma guidance et ma lumière.`
};

MIROIR["10:38"] = {
  reference: "10:38",
  theme: ["coran", "défi", "miracle"],
  emotion: "Défi, certitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'jiz", "Al-Qadir"],
  mirrorVersion: `« Ou bien disent-ils : Il l'a forgé. Dis : Apportez donc une sourate semblable. » Le miroir me montre le défi divin. « Fa'tu bi-suratin mithlihi » — apportez donc une sourate semblable. Le défi reste ouvert. Le miroir m'interroge : est-ce que je reconnais le miracle du Coran ?`,
  reflection: `Le défi du Coran reste sans réponse. Personne ne peut apporter quelque chose de semblable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Am yaqulun aftara qul fa'tu bi-suratin mithlihi wa ad'u man istata'tum min duni Allahi in kuntum sadiqin » — ou bien disent-ils : Il l'a forgé. Dis : Apportez donc une sourate semblable et appelez qui vous pourrez en dehors d'Allah, si vous êtes véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais le miracle du Coran ? Est-ce que je comprends que personne ne peut imiter le Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité d'imiter le Coran prouve son origine divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le miracle éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le miracle du Coran reconnaît la vérité." }
  ],
  munajat: `Ya Rabb, je reconnais le miracle du Coran. Ne permets pas que je doute de Ta révélation. Fais que le Coran soit mon guide et mon miracle.`
};

MIROIR["10:39"] = {
  reference: "10:39",
  theme: ["mécréance", "jugement", "réalité"],
  emotion: "Avertissement, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hakam"],
  mirrorVersion: `« Ils ont traité de mensonge ce qu'ils n'embrassent pas de leur science. » Le miroir me montre le rejet aveugle. « Kadhdhabu bima lam yuhitu bi-'ilmihi » — ils ont traité de mensonge ce qu'ils n'embrassent pas de leur science. Le rejet sans connaissance est l'aveuglement. Le miroir m'interroge : est-ce que je rejette sans connaître ?`,
  reflection: `Le rejet sans connaissance est l'aveuglement. La réalisation viendra quand le châtiment arrivera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal kadhdhabu bima lam yuhitu bi-'ilmihi wa lamma ya'tihim ta'wiluh » — mais ils ont traité de mensonge ce qu'ils n'embrassent pas de leur science. Son interprétation ne leur est pas encore venue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette sans connaître ? Ou est-ce que je cherche à comprendre avant de juger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet aveugle précède la réalisation douloureuse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par triompher." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît avant de juger suit la vérité." }
  ],
  munajat: `Ya Rabb, ne permets pas que je rejette sans connaître. Donne-moi la connaissance avant le jugement. Fais que je réalise la vérité avant qu'il ne soit trop tard.`
};

MIROIR["10:40"] = {
  reference: "10:40",
  theme: ["foi", "mécréance", "connaissance"],
  emotion: "Espoir, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Alim", "Al-Bashir"],
  mirrorVersion: `« Parmi eux, il en est qui croient en lui, et il en est qui ne croient pas. » Le miroir me montre la division des réponses. « Minhum man yu'minu bihi wa minhum man la yu'minu » — parmi eux, il en est qui croient et il en est qui ne croient pas. La foi est un choix. Le miroir m'interroge : est-ce que je fais partie de ceux qui croient ?`,
  reflection: `La foi et la mécréance sont deux choix. Allah connaît les corrupteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Minhum man yu'minu bihi wa minhum man la yu'minu bihi wa rabbuka a'lamu bi-al-mufsidin » — parmi eux, il en est qui croient en lui, et il en est qui ne croient pas en lui. Ton Seigneur connaît bien les corrupteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de ceux qui croient ? Ma foi est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi et la mécréance séparent les chemins." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît les intentions de chacun." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit avec sincérité est sauvé." }
  ],
  munajat: `Ya Rabb, je veux faire partie de ceux qui croient. Ne permets pas que je sois parmi les corrupteurs. Donne-moi une foi sincère et véridique.`
};

MIROIR["10:41"] = {
  reference: "10:41",
  theme: ["témoignage", "responsabilité", "séparation"],
  emotion: "Sérénité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Ash-Shahid", "Al-Kafi"],
  mirrorVersion: `« S'ils te traitent de menteur, dis : À moi mon œuvre, et à vous votre œuvre. » Le miroir me montre la séparation des responsabilités. « In kadhdhabuka fa-qul 'amali wa lakum 'amalukum » — s'ils te traitent de menteur, dis : À moi mon œuvre, et à vous votre œuvre. Chacun est responsable. Le miroir m'interroge : est-ce que j'accepte ma responsabilité ?`,
  reflection: `Chacun est responsable de ses actes. La séparation des œuvres est une séparation des destinées.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in kadhdhabuka fa-qul 'amali wa lakum 'amalukum antum bari'una mimma a'malu wa ana bari'un mimma ta'malun » — s'ils te traitent de menteur, dis : À moi mon œuvre, et à vous votre œuvre. Vous êtes innocents de ce que je fais, et je suis innocent de ce que vous faites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ma responsabilité ? Ou est-ce que je blâme les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité individuelle est la base du jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chacun porte son propre fardeau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte sa responsabilité trouve la paix." }
  ],
  munajat: `Ya Rabb, j'accepte ma responsabilité. Ne permets pas que je blâme les autres. Donne-moi la force de porter mon fardeau et de faire mon œuvre.`
};

MIROIR["10:42"] = {
  reference: "10:42",
  theme: ["écoute", "compréhension", "cœur"],
  emotion: "Tristesse, espoir",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sami'", "Al-Qalb"],
  mirrorVersion: `« Parmi eux, il en est qui t'écoutent. Est-ce que tu peux faire entendre les sourds ? » Le miroir me montre l'écoute sans compréhension. « Minhum man yastami'unaka » — parmi eux, il en est qui t'écoutent. L'écoute physique ne suffit pas. Le miroir m'interroge : est-ce que j'écoute avec mon cœur ?`,
  reflection: `L'écoute physique sans compréhension du cœur est comme la surdité. Allah guide les cœurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa minhum man yastami'unaka a-fa-anta tusmi'u al-summa wa la yu'minun » — parmi eux, il en est qui t'écoutent. Est-ce que tu peux faire entendre les sourds alors qu'ils ne raisonnent pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute avec mon cœur ? Ou est-ce que j'entends sans comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie écoute est l'écoute du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les sourds de cœur n'entendent pas la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui écoute avec son cœur entend la guidance." }
  ],
  munajat: `Ya Sami', ouvre mon cœur à l'écoute. Ne permets pas que je sois sourd de cœur. Donne-moi l'écoute qui comprend et la compréhension qui guide.`
};

MIROIR["10:43"] = {
  reference: "10:43",
  theme: ["vision", "guidance", "aveuglement"],
  emotion: "Tristesse, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Hadi"],
  mirrorVersion: `« Parmi eux, il en est qui te regardent. Est-ce que tu peux guider les aveugles ? » Le miroir me montre le regard sans vision. « Minhum man yanzuru ilayka » — parmi eux, il en est qui te regardent. Le regard physique ne suffit pas. Le miroir m'interroge : est-ce que je vois avec mon cœur ?`,
  reflection: `La vue physique sans vision du cœur est comme l'aveuglement. Allah guide les aveugles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa minhum man yanzuru ilayka a-fa-tahdi al-umya wa la yubSirun » — parmi eux, il en est qui te regardent. Est-ce que tu peux guider les aveugles alors qu'ils ne voient pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois avec mon cœur ? Ou est-ce que je regarde sans voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie vision est la vision du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les aveugles de cœur ne voient pas la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec son cœur voit la guidance." }
  ],
  munajat: `Ya Basir, ouvre mon cœur à la vision. Ne permets pas que je sois aveugle de cœur. Donne-moi la vue qui comprend et la compréhension qui guide.`
};

MIROIR["10:44"] = {
  reference: "10:44",
  theme: ["injustice", "création", "justice divine"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Al-Khaliq"],
  mirrorVersion: `« Certes, Allah ne lèse point les gens, mais ce sont les gens qui se lèsent eux-mêmes. » Le miroir me montre la justice parfaite. « Inna Allaha la yazlimu al-nasa shay'an » — certes, Allah ne lèse point les gens. L'injustice vient des hommes. Le miroir m'interroge : est-ce que je me lèse moi-même ?`,
  reflection: `Allah est juste. L'injustice vient des hommes qui se lèsent eux-mêmes par leurs péchés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha la yazlimu al-nasa shay'an wa lakinna al-nasa anfusahum yazlimun » — certes, Allah ne lèse point les gens, mais ce sont les gens qui se lèsent eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me lèse moi-même par mes péchés ? Ou est-ce que je me préserve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice contre soi-même est le pire des injustices." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se préserve se fait justice." }
  ],
  munajat: `Ya Adl, Tu es le Juste. Ne permets pas que je me lèse moi-même. Donne-moi la force de me préserver et de suivre Ta justice.`
};

MIROIR["10:45"] = {
  reference: "10:45",
  theme: ["jugement", "temps", "réalité"],
  emotion: "Humilité, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hashr", "Al-Hisab"],
  mirrorVersion: `« Le jour où Il les rassemblera, ce sera comme s'ils n'étaient restés qu'une heure d'un jour. » Le miroir me montre la relativité du temps. « Ka-annahum lam yalbathu illa sa'atan min nahar » — comme s'ils n'étaient restés qu'une heure d'un jour. La vie est courte. Le miroir m'interroge : comment je vais paraître ce jour-là ?`,
  reflection: `Le Jour du Rassemblement, la vie semblera courte. Ceux qui ont mécru seront perdants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma yahshuruhum ka-annahum lam yalbathu illa sa'atan min al-nahari yata'arafuna baynahum » — le jour où Il les rassemblera, ce sera comme s'ils n'étaient restés qu'une heure d'un jour. Ils se reconnaîtront entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vais paraître ce jour-là ? Ma vie sera-t-elle brève ou éternelle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La brièveté de la vie révèle la réalité de l'éternité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps est relatif, l'éternité est absolue." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son jour le passe en paix." }
  ],
  munajat: `Ya Rabb, la vie est courte. Ne permets pas que je la gaspille. Donne-moi la préparation pour ce jour et la réussite au rassemblement.`
};

MIROIR["10:46"] = {
  reference: "10:46",
  theme: ["promesse", "châtiment", "réalisation"],
  emotion: "Espoir, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wa'id", "Al-Haqq"],
  mirrorVersion: `« Soit que Nous te ferons voir une partie de ce que Nous leur promettons, soit que Nous te ferons mourir. » Le miroir me montre les deux possibilités. « Nuriyannaka ba'da alladhi wa'adnahum aw natawaffayannaka » — soit que Nous te ferons voir une partie de ce que Nous leur promettons, soit que Nous te ferons mourir. La promesse est vraie. Le miroir m'interroge : est-ce que je crois en la promesse ?`,
  reflection: `La promesse d'Allah est vraie. Le retour vers Allah est inévitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw nuriyannaka ba'da alladhi wa'adnahum aw natawaffayannaka fa-ilayna yurja'un » — soit que Nous te ferons voir une partie de ce que Nous leur promettons, soit que Nous te ferons mourir. C'est vers Nous qu'ils seront ramenés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en la promesse d'Allah ? Suis-je prêt pour le retour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse s'accomplit toujours." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le retour vers Allah est le destin de tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en la promesse la voit s'accomplir." }
  ],
  munajat: `Ya Rabb, je crois en Ta promesse. Ne permets pas que je doute. Donne-moi la certitude de la promesse et la préparation pour le retour.`
};

MIROIR["10:47"] = {
  reference: "10:47",
  theme: ["prophète", "communauté", "justice"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Adl", "Ar-Rasul"],
  mirrorVersion: `« À chaque communauté un messager. » Le miroir me montre la justice dans la guidance. « Li-kulli ummatin rasul » — à chaque communauté un messager. La guidance est offerte à tous. Le miroir m'interroge : est-ce que je suis le messager qui m'a été envoyé ?`,
  reflection: `Chaque communauté a reçu un messager. Le jugement sera équitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-kulli ummatin rasul fa-idha ja'a rasuluhum qudiya baynahum bi-al-qisti wa hum la yazlamun » — à chaque communauté un messager. Puis, quand leur messager vient, on décide entre eux en toute équité, et ils ne sont point lésés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis le messager qui m'a été envoyé ? Ma communauté a-t-elle entendu le message ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le messager est le témoignage pour la communauté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance a été offerte à chaque communauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le messager suit la guidance." }
  ],
  munajat: `Ya Rabb, merci pour le messager. Ne permets pas que je l'ignore. Donne-moi la capacité de suivre le messager et d'être parmi les bien-guidés.`
};

MIROIR["10:48"] = {
  reference: "10:48",
  theme: ["question", "jour dernier", "promesse"],
  emotion: "Impatience, défi",
  difficulty: "débutant",
  relatedNames: ["Al-Sa'ah", "Al-Wa'id"],
  mirrorVersion: `« Ils disent : À quand cette promesse, si vous êtes véridiques ? » Le miroir me montre le défi des mécréants. « Mata hadha al-wa'du » — à quand cette promesse ? L'impatience cache le déni. Le miroir m'interroge : est-ce que je prépare la promesse ?`,
  reflection: `La question sur le Jour Dernier est un défi des mécréants. La promesse viendra à son heure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna mata hadha al-wa'du in kuntum sadiqin » — ils disent : À quand cette promesse, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare la promesse ? Ou est-ce que je la repousse par négligence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impatience cache le déni de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse viendra à son heure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare la promesse l'attend avec sérénité." }
  ],
  munajat: `Ya Rabb, je prépare Ta promesse. Ne permets pas que je la repousse par négligence. Donne-moi la préparation et l'attente sereine.`
};

MIROIR["10:49"] = {
  reference: "10:49",
  theme: ["destin", "impuissance", "réalité"],
  emotion: "Humilité, acceptation",
  difficulty: "débutant",
  relatedNames: ["Al-Qadar", "Al-Mumit"],
  mirrorVersion: `« Dis : Je ne possède pour moi-même ni profit ni nuisance, sauf ce qu'Allah veut. » Le miroir me montre l'impuissance humaine. « La amliku li-nafsi darran wa la naf'an » — je ne possède pour moi-même ni profit ni nuisance. La puissance appartient à Allah. Le miroir m'interroge : est-ce que je reconnais mon impuissance ?`,
  reflection: `L'être humain ne possède ni profit ni nuisance pour lui-même. Allah décide de tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul la amliku li-nafsi darran wa la naf'an illa ma sha'a Allahu li-kulli ummatin ajalun » — dis : Je ne possède pour moi-même ni profit ni nuisance, sauf ce qu'Allah veut. À chaque communauté un terme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais mon impuissance ? Ou est-ce que je prétends maîtriser ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de l'impuissance est le début de la puissance en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le destin appartient à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet au destin trouve la liberté." }
  ],
  munajat: `Ya Rabb, je reconnais mon impuissance. Ne permets pas que je prétende maîtriser ma vie. Donne-moi la soumission au destin et la confiance en Toi.`
};

MIROIR["10:50"] = {
  reference: "10:50",
  theme: ["châtiment", "nuit", "question"],
  emotion: "Avertissement, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Azab", "Al-Layl"],
  mirrorVersion: `« Dis : Voyez-vous ? Si Son châtiment vous atteint de nuit ou de jour, les criminels pourront-ils le hâter ? » Le miroir me montre l'inévitable. « A-ra'aytum in atakum 'adhabuhu bayanan aw naharan » — voyez-vous ? Si Son châtiment vous atteint de jour ou de nuit. Le miroir m'interroge : suis-je prêt ?`,
  reflection: `Le châtiment peut venir de jour ou de nuit. Les criminels ne peuvent pas le hâter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul a-ra'aytum in atakum 'adhabuhu bayanan aw naharan madha yasta'jilu minhu al-mujrimun » — dis : Voyez-vous ? Si Son châtiment vous atteint de jour ou de nuit, que feront hâter les criminels ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt si le châtiment vient ? Ma préparation est-elle suffisante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impatience des criminels n'avance rien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment vient à son heure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas peur du châtiment." }
  ],
  munajat: `Ya Rabb, je me prépare. Ne permets pas que je sois pris au dépourvu. Donne-moi la préparation qui sauve du châtiment.`
};

MIROIR["10:51"] = {
  reference: "10:51",
  theme: ["foi", "châtiment", "réalisation"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Azab"],
  mirrorVersion: `« Est-ce quand il arrivera que vous croirez ? Maintenant ? » Le miroir me montre la foi tardive. « A-fa-idha ma waqa'a amantum » — est-ce quand il arrivera que vous croirez ? La foi au moment du châtiment est tardive. Le miroir m'interroge : est-ce que je crois maintenant ?`,
  reflection: `La foi au moment du châtiment est tardive. Il faut croire avant que le châtiment n'arrive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-fa-idha ma waqa'a amantum al-ana wa qad kuntum bi-hi tasta'jilun » — est-ce quand il arrivera que vous croirez ? Maintenant ? Alors que vous cherchiez à le hâter ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois maintenant ? Ou est-ce que j'attends que le châtiment arrive ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi tardive ne sauve pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi avant le châtiment est la vraie foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant est sauvé." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que j'attende le châtiment pour croire. Donne-moi la foi avant l'épreuve et la préparation avant le danger.`
};

MIROIR["10:52"] = {
  reference: "10:52",
  theme: ["injustice", "châtiment", "réalisation"],
  emotion: "Tristesse, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Zalim", "Al-Adl"],
  mirrorVersion: `« Il sera dit aux injustes : Goûtez au châtiment éternel. » Le miroir me montre le sort des injustes. « Dudhu 'adaba al-khuldi » — goûtez au châtiment éternel. L'injustice mène au châtiment. Le miroir m'interroge : suis-je juste ?`,
  reflection: `Les injustes goûteront au châtiment éternel. Ils sont rétribués pour ce qu'ils ont gagné.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma qila li-al-zalimina dudhu 'adaba al-khuldi hal tujzawna illa ma kuntum takasibun » — puis, il sera dit aux injustes : Goûtez au châtiment éternel ! Êtes-vous rétribués autrement que selon ce que vous avez acquis ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je juste ? Mes actions mènent-elles au châtiment ou à la récompense ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice mène au châtiment éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste évite le châtiment." }
  ],
  munajat: `Ya Rabb, je veux être juste. Ne permets pas que je sois parmi les injustes. Donne-moi la justice qui sauve du châtiment éternel.`
};

MIROIR["10:53"] = {
  reference: "10:53",
  theme: ["question", "vérité", "certitude"],
  emotion: "Réalité, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Yaqin"],
  mirrorVersion: `« Ils s'informent : Est-ce vrai ? Dis : Oui, par mon Seigneur, c'est la vérité. » Le miroir me montre la question des douteurs. « A-innahu la-haqq » — est-ce vrai ? La réponse est certaine. Le miroir m'interroge : est-ce que je suis certain de la vérité ?`,
  reflection: `La vérité du Jour Dernier est certaine. Allah est le témoin de cette vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yastaftunaka a-innahu la-haqq qul i wa rabbi innahu la-haqq » — ils s'informent auprès de toi : Est-ce vrai ? Dis : Oui, par mon Seigneur, c'est la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis certain de la vérité ? Ou est-ce que je doute encore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de la vérité est la base de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est inévitable." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est certain de la vérité la suit." }
  ],
  munajat: `Ya Rabb, je suis certain de la vérité. Ne permets pas que je doute. Donne-moi la certitude qui guide et la vérité qui sauve.`
};

MIROIR["10:54"] = {
  reference: "10:54",
  theme: ["rachat", "âme", "regret"],
  emotion: "Tristesse, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nafs", "Al-Tawbah"],
  mirrorVersion: `« Si chaque âme injuste possédait ce qui est sur terre, elle le donnerait pour se racheter. » Le miroir me montre le regret des injustes. « Law anna li-kulli nafsin zalamat » — si chaque âme injuste. Le regret est tardif. Le miroir m'interroge : est-ce que je me rachète maintenant ?`,
  reflection: `Le rachat au Jour Dernier est impossible. Il faut se repentir maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law anna li-kulli nafsin zalamat ma fi al-ardi la-ftadat bihi » — si chaque âme injuste possédait ce qui est sur terre, elle le donnerait pour se racheter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me rachète maintenant ? Ou est-ce que j'attends le jour où le rachat sera impossible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rachat tardif est impossible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repentir maintenant est le seul rachat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent maintenant se rachète." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que j'attende le jour du regret. Donne-moi le repentir qui rachète et la miséricorde qui sauve.`
};

MIROIR["10:55"] = {
  reference: "10:55",
  theme: ["promesse", "vérité", "certitude"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wa'd"],
  mirrorVersion: `« Certes, à Allah appartient ce qui est dans les cieux et sur terre. » Le miroir me montre la possession d'Allah. « Ala inna li-Allahi ma fi al-samawati wa al-ardi » — certes, à Allah appartient ce qui est dans les cieux et sur terre. Tout Lui appartient. Le miroir m'interroge : est-ce que je reconnais que tout Lui appartient ?`,
  reflection: `Tout appartient à Allah. La promesse d'Allah est vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala inna li-Allahi ma fi al-samawati wa al-ardi ala inna wa'da Allahi haqqun wa lakinna aktharahum la ya'lamun » — certes, à Allah appartient ce qui est dans les cieux et sur terre. Certes, la promesse d'Allah est vérité. Mais la plupart d'entre eux ne savent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que tout Lui appartient ? Ma vie est-elle consacrée à Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance de la possession d'Allah est la base de la soumission." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui existe appartient à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît que tout Lui appartient se soumet." }
  ],
  munajat: `Ya Rabb, je reconnais que tout T'appartient. Ne permets pas que j'oublie. Donne-moi la reconnaissance qui soumet et la certitude qui guide.`
};

MIROIR["10:56"] = {
  reference: "10:56",
  theme: ["vie", "mort", "pouvoir"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« C'est Lui qui donne la vie et qui donne la mort. » Le miroir me montre le pouvoir absolu. « Huwa yuhyi wa yumitu » — c'est Lui qui donne la vie et qui donne la mort. La vie et la mort sont entre Ses mains. Le miroir m'interroge : est-ce que je remets ma vie et ma mort à Allah ?`,
  reflection: `Allah donne la vie et la mort. Le retour vers Lui est inévitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa yuhyi wa yumitu wa ilayhi turja'un » — c'est Lui qui donne la vie et qui donne la mort. Et c'est vers Lui que vous serez ramenés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remets ma vie et ma mort à Allah ? Ou est-ce que j'essaie de les contrôler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La remise de la vie et de la mort à Allah est la confiance absolue." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie et la mort sont entre les mains d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remet sa vie et sa mort à Allah trouve la paix." }
  ],
  munajat: `Ya Muhyi, Ya Mumit, je remets ma vie et ma mort à Toi. Ne permets pas que j'essaie de les contrôler. Donne-moi la confiance qui accepte et la paix qui suit.`
};

MIROIR["10:57"] = {
  reference: "10:57",
  theme: ["guérison", "miséricorde", "coran"],
  emotion: "Espoir, guérison",
  difficulty: "débutant",
  relatedNames: ["Ash-Shifa", "Ar-Rahmah"],
  mirrorVersion: `« Ô hommes ! Une exhortation de votre Seigneur vous est venue, une guérison de ce qui est dans les poitrines. » Le miroir me montre la guérison divine. « Shifa'un li-ma fi al-sudur » — une guérison de ce qui est dans les poitrines. Le Coran est la guérison. Le miroir m'interroge : est-ce que je cherche la guérison dans le Coran ?`,
  reflection: `Le Coran est la guérison des cœurs. C'est une miséricorde pour les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nasu qad ja'atkum maw'izatun min rabbikum wa shifa'un li-ma fi al-sudur wa hudan wa rahmatun li-al-mu'minin » — ô hommes ! Une exhortation de votre Seigneur vous est venue, une guérison de ce qui est dans les poitrines, un guide et une miséricorde pour les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la guérison dans le Coran ? Ou est-ce que je cherche ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guérison des cœurs est dans le Coran." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est la guérison pour tous les maux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la guérison dans le Coran la trouve." }
  ],
  munajat: `Ya Shafi, je cherche la guérison dans Ton Coran. Ne permets pas que je cherche ailleurs. Donne-moi la guérison du cœur et la miséricorde qui accompagne.`
};

MIROIR["10:58"] = {
  reference: "10:58",
  theme: ["joie", "miséricorde", "grâce"],
  emotion: "Joie, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Fadl", "Ar-Rahmah"],
  mirrorVersion: `« Dis : C'est par la grâce d'Allah et Sa miséricorde. Qu'ils se réjouissent donc ! » Le miroir me montre la source de la joie. « Bi-fadli Allahi wa rahmatihi » — c'est par la grâce d'Allah et Sa miséricorde. La vraie joie vient d'Allah. Le miroir m'interroge : est-ce que je me réjouis de la grâce d'Allah ?`,
  reflection: `La grâce et la miséricorde d'Allah sont la source de la vraie joie. C'est mieux que ce qu'ils amassent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul bi-fadli Allahi wa bi-rahmatihi fa-bi-dhalika fal-yafrahu huwa khayrun mimma yajma'un » — dis : C'est par la grâce d'Allah et Sa miséricorde. Qu'ils se réjouissent donc ! C'est bien mieux que ce qu'ils amassent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me réjouis de la grâce d'Allah ? Ou est-ce que je me réjouis des biens de ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie joie vient de la grâce d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La grâce d'Allah est la meilleure des joies." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se réjouit de la grâce d'Allah trouve la joie éternelle." }
  ],
  munajat: `Ya Dha al-Fadl, je me réjouis de Ta grâce. Ne permets pas que je me réjouisse des biens de ce monde. Donne-moi la joie qui vient de Toi et la gratitude qui accompagne.`
};

MIROIR["10:59"] = {
  reference: "10:59",
  theme: ["licite", "illicite", "innovation"],
  emotion: "Question, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halal", "Al-Haram"],
  mirrorVersion: `« Dis : Que dire des provisions qu'Allah a fait descendre et que vous avez partagées en licite et illicite ? » Le miroir me montre l'innovation religieuse. « Ja'ala Allahu lakum min rizqin » — des provisions qu'Allah a fait descendre. Qui a le droit de déclarer licite ou illicite ? Le miroir m'interroge : est-ce que je suis les lois d'Allah ou mes propres innovations ?`,
  reflection: `Allah a descendu les provisions. Personne n'a le droit de déclarer licite ou illicite sans Sa permission.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul a-ra'aytum ma anzala Allahu lakum min rizqin fa-ja'altum minhu haraman wa halilan » — dis : Que dire des provisions qu'Allah a fait descendre et que vous avez partagées en licite et illicite ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis les lois d'Allah ou mes propres innovations ? Ma pratique est-elle conforme à Sa révélation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'innovation religieuse est un égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le licite et l'illicite sont définis par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les lois d'Allah suit la vérité." }
  ],
  munajat: `Ya Rabb, je suis Tes lois. Ne permets pas que j'innove dans la religion. Donne-moi la conformité à Ta révélation et la vérité qui guide.`
};

MIROIR["10:60"] = {
  reference: "10:60",
  theme: ["mensonge", "jugement", "rétribution"],
  emotion: "Avertissement, crainte",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Kadhib", "Al-Hisab"],
  mirrorVersion: `« Que penseront ceux qui forgent le mensonge contre Allah, au Jour de la Résurrection ? » Le miroir me montre le sort des menteurs. « Alladhina yaftaruna 'ala Allahi al-kadhib » — ceux qui forgent le mensonge contre Allah. Le mensonge contre Allah est grave. Le miroir m'interroge : est-ce que je forge des mensonges contre Allah ?`,
  reflection: `Le mensonge contre Allah est un péché grave. Allah a une grâce pour les gens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma zanna alladhina yaftaruna 'ala Allahi al-kadhib yawma al-qiyamah » — que penseront ceux qui forgent le mensonge contre Allah, au Jour de la Résurrection ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je forge des mensonges contre Allah ? Mes paroles sont-elles véridiques ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge contre Allah mène à la perdition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est la parole d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité sur Allah est sauvé." }
  ],
  munajat: `Ya Rabb, je dis la vérité sur Toi. Ne permets pas que je forge des mensonges. Donne-moi la vérité qui sauve et l'honnêteté qui guide.`
};

MIROIR["10:61"] = {
  reference: "10:61",
  theme: ["présence", "connaissance", "coran"],
  emotion: "Révérence, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Shahid", "Al-Muhit"],
  mirrorVersion: `« Tu ne te trouves dans aucune situation, tu ne récite rien du Coran, vous n'accomplissez aucun acte sans que Nous ne soyons témoin. » Le miroir me montre la présence divine constante. « Nahnu shuhada'un » — Nous sommes témoins. Rien n'échappe à Allah. Le miroir m'interroge : est-ce que je vis avec cette conscience ?`,
  reflection: `Allah est témoin de tout. Rien n'échappe à Sa connaissance, même le poids d'un atome.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma takunu fi sha'n wa ma tatlu minhu min Qur'an wa la ta'maluna min 'amalin illa kunna 'alaykum shuhada'an » — tu ne te trouves dans aucune situation, tu ne récite rien du Coran, vous n'accomplissez aucun acte sans que Nous ne soyons témoin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la conscience que Allah est témoin ? Mes actes sont-ils conformes à cette présence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La conscience de la présence divine transforme l'action." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est témoin de tout dans l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec cette conscience trouve la transcendance." }
  ],
  munajat: `Ya Shahid, Tu es témoin de tout. Ne permets pas que j'oublie Ta présence. Donne-moi la conscience qui élève et la transcendance qui rapproche.`
};

MIROIR["10:63"] = {
  reference: "10:63",
  theme: ["amis d'Allah", "foi", "crainte"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Awliya", "Al-Mu'minun"],
  mirrorVersion: `« Les amis d'Allah sont ceux qui croient et qui sont pieux. » Le miroir me montre le chemin de l'amitié divine. « Alladhina amanu wa kanu yattaqun » — ceux qui croient et qui sont pieux. La foi et la piété ouvrent l'amitié d'Allah. Le miroir m'interroge : suis-je un ami d'Allah ?`,
  reflection: `Les amis d'Allah sont les croyants pieux. Ils n'ont pas de crainte ni de chagrin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala inna awliya'a Allahi la khawfun 'alayhim wa la hum yahzanun alladhina amanu wa kanu yattaqun » — en vérité, les amis d'Allah n'ont pas de crainte ni de chagrin. Ceux qui croient et qui sont pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un ami d'Allah ? Ma foi et ma piété sont-elles sincères ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "L'amitié d'Allah s'obtient par la foi et la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les amis d'Allah sont protégés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est ami d'Allah n'a pas de crainte." }
  ],
  munajat: `Ya Wali, je veux être Ton ami. Ne permets pas que je m'éloigne. Donne-moi la foi et la piété qui ouvrent Ton amitié.`
};

MIROIR["10:64"] = {
  reference: "10:64",
  theme: ["bonne nouvelle", "parole", "stabilité"],
  emotion: "Joie, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Bushra", "Al-Haqq"],
  mirrorVersion: `« Pour eux, la bonne nouvelle dans la vie d'ici-bas et dans l'au-delà. » Le miroir me montre la promesse de la bonne nouvelle. « Lahumu al-bushra fi al-hayati al-dunya wa fi al-akhirah » — pour eux, la bonne nouvelle dans la vie d'ici-bas et dans l'au-delà. La promesse d'Allah est stable. Le miroir m'interroge : est-ce que je fais partie de ceux qui reçoivent la bonne nouvelle ?`,
  reflection: `La bonne nouvelle est pour les croyants. La parole d'Allah ne change pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahumu al-bushra fi al-hayati al-dunya wa fi al-akhirah la tabdila li-kalimati Allahi dhalika huwa al-fawzu al-azim » — pour eux, la bonne nouvelle dans la vie d'ici-bas et dans l'au-delà. Il n'y a pas de changement aux paroles d'Allah. C'est là l'énorme succès." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de ceux qui reçoivent la bonne nouvelle ? Ma foi me qualifie-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne nouvelle est le succès éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah ne change jamais." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la bonne nouvelle a réussi." }
  ],
  munajat: `Ya Rabb, je veux la bonne nouvelle. Ne permets pas que je sois privé de Ta bonne nouvelle. Donne-moi la foi qui qualifie et le succès qui suit.`
};

MIROIR["10:65"] = {
  reference: "10:65",
  theme: ["parole", "création", "pouvoir"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Amr"],
  mirrorVersion: `« Que leur parole ne t'afflige pas. La puissance appartient à Allah. » Le miroir me montre la consolation divine. « La yahzunka qawluhum » — que leur parole ne t'afflige pas. La puissance appartient à Allah seul. Le miroir m'interroge : est-ce que je me laisse affliger par les paroles des autres ?`,
  reflection: `Les paroles des mécréants ne doivent pas affliger le croyant. La puissance appartient à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yahzunka qawluhum inna al-izzata li-Allahi jami'an huwa al-sami'u al-alim » — que leur parole ne t'afflige pas. La puissance appartient à Allah. C'est Lui l'Audient, l'Omniscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse affliger par les paroles des autres ? Ma confiance est-elle en Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance d'Allah dépasse toutes les paroles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La puissance appartient à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah n'est pas affligé." }
  ],
  munajat: `Ya Aziz, Ta puissance dépasse toutes les paroles. Ne permets pas que je sois affligé par les paroles des autres. Donne-moi la confiance qui élève et la sérénité qui calme.`
};

MIROIR["10:66"] = {
  reference: "10:66",
  theme: ["création", "obéissance", "repli"],
  emotion: "Humilité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Mulk"],
  mirrorVersion: `« À Allah appartient ce qui est dans les cieux et ce qui est sur terre. » Le miroir me montre la possession universelle. « Li-Allahi ma fi al-samawati wa ma fi al-ardi » — à Allah appartient ce qui est dans les cieux et ce qui est sur terre. Tous se replient vers Lui. Le miroir m'interroge : est-ce que je me replie vers Allah ?`,
  reflection: `Tout appartient à Allah. Ceux qui invoquent en dehors d'Allah ne suivent que des conjectures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala inna li-Allahi man fi al-samawati wa man fi al-ardi wa ma yattabi'u alladhina yad'una min duni Allahi shuraka'a in yattabi'una illa al-zanna » — certes, à Allah appartient ce qui est dans les cieux et sur terre. Ceux qui invoquent des associés en dehors d'Allah ne suivent que la conjecture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me replie vers Allah ? Ou est-ce que je suis les conjectures des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repli vers Allah est le chemin de vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout se replie vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se replie vers Allah suit la vérité." }
  ],
  munajat: `Ya Rabb, je me replie vers Toi. Ne permets pas que je suive les conjectures. Donne-moi le repli qui sauve et la vérité qui guide.`
};

MIROIR["10:67"] = {
  reference: "10:67",
  theme: ["nuit", "jour", "provision"],
  emotion: "Gratitude, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "An-Nahar"],
  mirrorVersion: `« C'est Lui qui a créé pour vous la nuit pour que vous vous y reposiez, et le jour pour que vous voyiez. » Le miroir me montre les bienfaits du cycle. « Ja'ala lakumu al-layla li-taskunu fiha » — Il a créé pour vous la nuit pour que vous vous y reposiez. Le cycle jour-nuit est un bienfait. Le miroir m'interroge : est-ce que je remercie pour ce bienfait ?`,
  reflection: `La nuit pour le repos et le jour pour l'action. Les signes sont pour ceux qui entendent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi ja'ala lakumu al-layla li-taskunu fiha wa al-nahara mubsiran inna fi dhalika la-ayatin li-qawmin yasma'un » — c'est Lui qui a créé pour vous la nuit pour que vous vous y reposiez, et le jour pour que vous voyiez. Il y a là des signes pour des gens qui entendent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ce bienfait ? Ou est-ce que je le prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cycle jour-nuit est un signe de la miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle du jour et de la nuit sert toute la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour ce bienfait reconnaît le Créateur." }
  ],
  munajat: `Ya Rabb, je Te remercie pour la nuit et le jour. Ne permets pas que je l'oublie. Donne-moi la gratitude qui reconnaît et la reconnaissance qui élève.`
};

MIROIR["10:68"] = {
  reference: "10:68",
  theme: ["fils", "enfant", "transcendance"],
  emotion: "Révérence, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "As-Samad"],
  mirrorVersion: `« Ils ont dit : Allah S'est donné un fils. Gloire à Lui ! Il Se suffit à Lui-même. » Le miroir me montre la transcendance absolue. « Subhanahu » — gloire à Lui ! Allah n'a pas besoin de fils. Le miroir m'interroge : est-ce que je reconnais la transcendance d'Allah ?`,
  reflection: `Allah n'a pas de fils. Il Se suffit à Lui-même. Tout Lui appartient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu ittakhadha Allahu waladan subhanahu huwa al-ghaniyyu lahu ma fi al-samawati wa ma fi al-ardi » — ils ont dit : Allah S'est donné un fils. Gloire à Lui ! Il Se suffit à Lui-même. À Lui appartient ce qui est dans les cieux et sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la transcendance d'Allah ? Ou est-ce que j'attribue des limites à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transcendance d'Allah Le distingue de toute création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah est au-dessus de tout ce qu'ils décrivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la transcendance connaît la vérité." }
  ],
  munajat: `Ya Rabb, je reconnais Ta transcendance. Ne permets pas que j'attribue des limites à Toi. Donne-moi la connaissance de Ta grandeur et la vérité qui sauve.`
};

MIROIR["10:69"] = {
  reference: "10:69",
  theme: ["mensonge", "invention", "avertissement"],
  emotion: "Avertissement, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Kadhib"],
  mirrorVersion: `« Dis : Ceux qui forgent le mensonge contre Allah ne réussiront pas. » Le miroir me montre l'échec des menteurs. « Inna alladhina yaftaruna 'ala Allahi al-kadhiba la yuflihun » — ceux qui forgent le mensonge contre Allah ne réussiront pas. Le mensonge contre Allah est grave. Le miroir m'interroge : est-ce que je dis la vérité sur Allah ?`,
  reflection: `Le mensonge contre Allah mène à l'échec. La jouissance dans ce monde est temporaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul inna alladhina yaftaruna 'ala Allahi al-kadhiba la yuflihuna mata'un fi al-dunya thumma ilayna marji'uhum » — dis : Ceux qui forgent le mensonge contre Allah ne réussiront pas. C'est une jouissance dans ce monde, puis vers Nous sera leur retour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis la vérité sur Allah ? Ou est-ce que j'ajoute des inventions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge contre Allah mène au châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité sur Allah est le seul chemin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité sur Allah réussit." }
  ],
  munajat: `Ya Rabb, je dis la vérité sur Toi. Ne permets pas que j'invente. Donne-moi la véracité qui sauve et la vérité qui guide.`
};

MIROIR["10:70"] = {
  reference: "10:70",
  theme: ["jouissance", "châtiment", "douleur"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mata", "Al-Azab"],
  mirrorVersion: `« Puis Nous leur ferons goûter un dur châtiment. » Le miroir me montre la conséquence du mensonge. « Thumma nut'imuhu 'adaban shadidan » — puis Nous leur ferons goûter un dur châtiment. La jouissance temporaire mène au châtiment. Le miroir m'interroge : est-ce que je préfère la jouissance temporaire ou la récompense éternelle ?`,
  reflection: `La jouissance dans ce monde est suivie du châtiment pour les menteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nut'imuhu 'adaban shadidan bima kanu yakfurun » — puis Nous leur ferons goûter un dur châtiment pour ce qu'ils ont mécru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je préfère la jouissance temporaire ou la récompense éternelle ? Mon choix est-il clair ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La jouissance temporaire cache le châtiment éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment suit la mécréance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit la récompense éternelle est sauvé." }
  ],
  munajat: `Ya Rabb, je choisis la récompense éternelle. Ne permets pas que je choisisse la jouissance temporaire. Donne-moi la perspicacité qui distingue et le choix qui sauve.`
};

MIROIR["10:71"] = {
  reference: "10:71",
  theme: ["avertissement", "consultation", "décision"],
  emotion: "Défi, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Nadhar", "Al-Amr"],
  mirrorVersion: `« Récite-leur l'histoire de Noé, quand il dit à son peuple : Ô mon peuple, si ma présence et mon rappel vous sont insupportables... » Le miroir me montre la décision du prophète. « Qawmi in kana maqami » — ô mon peuple, si ma présence. Noé a averti son peuple. Le miroir m'interroge : est-ce que j'accepte l'avertissement ?`,
  reflection: `Noé a averti son peuple malgré leur rejet. Il s'est remis à Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa utlu 'alayhim naba'a Nuhin idh qala li-qawmihi ya qawmi in kana maqamu wa tadhkiri bi-ayati Allahi 'alaykum qaliyan » — récite-leur l'histoire de Noé, quand il dit à son peuple : Ô mon peuple, si ma présence et mon rappel des signes d'Allah vous sont insupportables..." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte l'avertissement ? Ou est-ce que la présence du rappel m'est insupportable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est une miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont averti tous les peuples." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'avertissement est guidé." }
  ],
  munajat: `Ya Rabb, j'accepte Ton avertissement. Ne permets pas que le rappel me soit insupportable. Donne-moi l'acceptation qui guide et la guidance qui sauve.`
};

MIROIR["10:72"] = {
  reference: "10:72",
  theme: ["récompense", "désintéressement", "tawhid"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Ajr", "At-Tawhid"],
  mirrorVersion: `« Je ne vous demande pas de récompense. Ma récompense n'incombe qu'à Allah. » Le miroir me montre le désintéressement du prophète. « Ma as'alukum 'alayhi min ajrin » — je ne vous demande pas de récompense. Le prophète ne cherche que Allah. Le miroir m'interroge : est-ce que je cherche ma récompense auprès d'Allah ?`,
  reflection: `Le prophète ne demande pas de récompense aux hommes. Sa récompense vient d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma as'alukum 'alayhi min ajrin in ajriya illa 'ala Allahi wa umirtu an akuna mina al-muslimin » — je ne vous demande pas de récompense. Ma récompense n'incombe qu'à Allah. Et il m'a été ordonné d'être du nombre des soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche ma récompense auprès d'Allah ? Ou est-ce que je la cherche auprès des hommes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie récompense vient d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont tous enseigné le désintéressement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche sa récompense auprès d'Allah la trouve." }
  ],
  munajat: `Ya Rabb, je cherche ma récompense auprès de Toi. Ne permets pas que je la cherche auprès des hommes. Donne-moi le désintéressement qui élève et la soumission qui sauve.`
};

MIROIR["10:73"] = {
  reference: "10:73",
  theme: ["sauvetage", "châtiment", "signe"],
  emotion: "Gratitude, avertissement",
  difficulty: "débutant",
  relatedNames: ["An-Najat", "Al-Ayah"],
  mirrorVersion: `« Ils le traitèrent de menteur. Alors Nous le sauvâmes, lui et ceux qui étaient avec lui dans l'arche. » Le miroir me montre le sauvetage divin. « Fa-anjaynahu » — Nous le sauvâmes. Le châtiment a frappé ceux qui ont traité de menteur. Le miroir m'interroge : est-ce que je suis parmi ceux qui seront sauvés ?`,
  reflection: `Noé et ses compagnons ont été sauvés. Les autres ont été noyés. C'est un signe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-kadhdhabuhu fa-anjaynahu wa man ma'ahu fi al-fulki wa ja'alnahum khala'ifa wa aghraqna alladhina kadhdhabu bi-ayatina » — ils le traitèrent de menteur. Alors Nous le sauvâmes, lui et ceux qui étaient avec lui dans l'arche. Et Nous en fîmes des califes, et Nous noyâmes ceux qui traitaient de mensonges Nos signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi ceux qui seront sauvés ? Ma foi me qualifie-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sauvetage vient de la foi, la noyade vient de la mécréance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont clairs pour ceux qui réfléchissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux signes d'Allah est sauvé." }
  ],
  munajat: `Ya Rabb, je veux être sauvé. Ne permets pas que je sois parmi les noyés. Donne-moi la foi qui sauve et la reconnaissance des signes qui guide.`
};

MIROIR["10:74"] = {
  reference: "10:74",
  theme: ["prophète", "rejet", "patience"],
  emotion: "Tristesse, détermination",
  difficulty: "débutant",
  relatedNames: ["Ar-Rasul", "As-Sabr"],
  mirrorVersion: `« Puis Nous envoyâmes après lui des messagers à leurs peuples. Ils leur vinrent avec les preuves. » Le miroir me montre la continuité de la guidance. « Arsalna min ba'dihi rusulan » — Nous envoyâmes après lui des messagers. Les messagers ont été envoyés avec des preuves. Le miroir m'interroge : est-ce que je crois aux messagers ?`,
  reflection: `Les messagers ont apporté des preuves. Les peuples ont rejeté malgré les preuves.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ba'athna min ba'dihi rusulan ila qawmihim fa-jauhum bi-al-bayyinati fama kanu li-yu'minu bima kadhdhabu bihi min qabl » — puis Nous envoyâmes après lui des messagers à leurs peuples. Ils leur vinrent avec les preuves. Mais ils ne crurent pas à ce qu'ils avaient traité de mensonge auparavant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux messagers ? Ou est-ce que je suis le chemin du rejet ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rejet des preuves scelle le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La guidance a été offerte par les messagers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux messagers suit la guidance." }
  ],
  munajat: `Ya Rabb, je crois aux messagers. Ne permets pas que je rejette les preuves. Donne-moi la foi qui accepte et le cœur qui s'ouvre.`
};

MIROIR["10:75"] = {
  reference: "10:75",
  theme: ["moïse", "aaron", "pharaon"],
  emotion: "Espoir, défi",
  difficulty: "débutant",
  relatedNames: ["Musa", "Harun"],
  mirrorVersion: `« Puis Nous envoyâmes après eux Moïse et Aaron, avec Nos signes, à Pharaon et ses notables. » Le miroir me montre le défi des prophètes. « Musa wa Haruna » — Moïse et Aaron. Les prophètes ont défié les tyrans. Le miroir m'interroge : est-ce que je soutiens la vérité contre l'injustice ?`,
  reflection: `Moïse et Aaron ont été envoyés à Pharaon. Les notables ont été orgueilleux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma ba'athna min ba'dihim Musa wa Haruna ila Fir'awna wa mala'ihi bi-ayatina fastakbaru wa kanu qawman mujrimina » — puis Nous envoyâmes après eux Moïse et Aaron, avec Nos signes, à Pharaon et ses notables. Mais ils s'enflèrent d'orgueil et ils étaient peuples de criminels." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je soutiens la vérité contre l'injustice ? Ou est-ce que je me tais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil des tyrans précède leur chute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont toujours défié les tyrans." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soutient la vérité est avec les prophètes." }
  ],
  munajat: `Ya Rabb, je soutiens la vérité. Ne permets pas que je me tais devant l'injustice. Donne-moi le courage des prophètes et la détermination qui sauve.`
};

MIROIR["10:76"] = {
  reference: "10:76",
  theme: ["vérité", "magie", "reconnaissance"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "As-Sihr"],
  mirrorVersion: `« Quand la vérité leur vint de Nous, ils dirent : C'est de la magie manifeste. » Le miroir me montre le rejet de la vérité. « Hadha sihrun mubin » — c'est de la magie manifeste. La vérité a été rejetée. Le miroir m'interroge : est-ce que je reconnais la vérité quand elle vient ?`,
  reflection: `La vérité a été appelée magie par les mécréants. Le rejet est la réponse des orgueilleux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ja'ahumu al-haqqu min 'indina qalu hadha sihrun mubin » — quand la vérité leur vint de Nous, ils dirent : C'est de la magie manifeste." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité quand elle vient ? Ou est-ce que je la rejette ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'appel de magie est le refus de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est reconnue par les cœurs sincères." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité la suit." }
  ],
  munajat: `Ya Rabb, je reconnais la vérité. Ne permets pas que je la rejette. Donne-moi la reconnaissance qui accepte et le cœur qui s'ouvre.`
};

MIROIR["10:77"] = {
  reference: "10:77",
  theme: ["question", "vérité", "mécréance"],
  emotion: "Défi, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Kufr"],
  mirrorVersion: `« Moïse dit : Dites-vous de la vérité quand elle vous est venue : Est-ce de la magie ? » Le miroir me montre la réponse du prophète. « A-taquluna li-al-haqq » — dites-vous de la vérité ? La question interpelle. Le miroir m'interroge : est-ce que je reconnais la vérité comme vérité ?`,
  reflection: `Moïse a questionné leur rejet. Les magiciens ne réussissent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala Musa a-taquluna li-al-haqqi lamma ja'akum a-sihrun hadha wa la yuflihu al-sahirun » — Moïse dit : Dites-vous de la vérité quand elle vous est venue : Est-ce de la magie ? Alors que les magiciens ne réussissent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la vérité comme vérité ? Ou est-ce que je la maquille en autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question de Moïse révèle leur mensonge." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité reste vérité malgré le rejet." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité comme vérité est guidé." }
  ],
  munajat: `Ya Rabb, je reconnais la vérité comme vérité. Ne permets pas que je la maquille. Donne-moi la clarté qui distingue et le cœur qui accepte.`
};

MIROIR["10:78"] = {
  reference: "10:78",
  theme: ["accusation", "enseignement", "politique"],
  emotion: "Lucidité, détermination",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ta'lim", "Al-Siyasa"],
  mirrorVersion: `« Ils dirent : Es-tu venu à nous pour nous détourner de ce que nous avons trouvé nos ancêtres ? » Le miroir me montre l'accusation. « A-ji'tana li-talifana » — es-tu venu pour nous détourner ? L'accusation cache la peur. Le miroir m'interroge : est-ce que je me laisse détourner par les accusations ?`,
  reflection: `L'accusation des mécréants vise à détourner de la vérité. La supériorité est un désir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu a-ji'tana li-talifana 'amma wajadna 'alayhi aba'ana wa takuna lakuma al-kibriya'u fi al-ardi wa ma nahnu lakuma bi-mu'minin » — ils dirent : Es-tu venu à nous pour nous détourner de ce que nous avons trouvé nos ancêtres pratiquer, et pour que la grandeur vous appartienne sur terre ? Et nous ne croyons pas en vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me laisse détourner par les accusations ? Ma détermination est-elle ferme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'accusation révèle la faiblesse des accusateurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes ont toujours été accusés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste ferme face aux accusations triomphe." }
  ],
  munajat: `Ya Rabb, je reste ferme face aux accusations. Ne permets pas que je me laisse détourner. Donne-moi la détermination qui résiste et la vérité qui guide.`
};

MIROIR["10:79"] = {
  reference: "10:79",
  theme: ["défi", "magie", "rassemblement"],
  emotion: "Défi, détermination",
  difficulty: "débutant",
  relatedNames: ["As-Sihr", "Al-Jam"],
  mirrorVersion: `« Pharaon dit : Amenez-moi tout magicien savant. » Le miroir me montre le défi du tyran. « I'tuni bi-kulli sahirin 'alim » — amenez-moi tout magicien savant. Le tyran rassemble ses forces. Le miroir m'interroge : est-ce que je rassemble pour le bien ou pour le mal ?`,
  reflection: `Pharaon a rassemblé les magiciens pour le défi. La confrontation est inévitable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala Fir'awnu i'tuni bi-kulli sahirin 'alim » — Pharaon dit : Amenez-moi tout magicien savant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rassemble pour le bien ou pour le mal ? Mon rassemblement sert-il la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rassemblement pour le mal précède la défaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours du mal." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rassemble pour le bien triomphe." }
  ],
  munajat: `Ya Rabb, je rassemble pour le bien. Ne permets pas que je rassemble pour le mal. Donne-moi le rassemblement qui sert la vérité et la détermination qui triomphe.`
};

MIROIR["10:80"] = {
  reference: "10:80",
  theme: ["défi", "jeter", "corde"],
  emotion: "Tension, anticipation",
  difficulty: "débutant",
  relatedNames: ["As-Sihr", "Al-Habl"],
  mirrorVersion: `« Puis, quand les magiciens vinrent, Moïse leur dit : Jetez ce que vous avez à jeter. » Le miroir me montre le moment du défi. « Ilqa ma antum mulqun » — jetez ce que vous avez à jeter. Le moment de vérité arrive. Le miroir m'interroge : suis-je prêt pour le moment de vérité ?`,
  reflection: `Les magiciens ont jeté leurs cordes et bâtons. L'illusion a semblé réelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma ja'a al-saharatu qala lahum Musa alqu ma antum mulqun » — puis, quand les magiciens vinrent, Moïse leur dit : Jetez ce que vous avez à jeter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt pour le moment de vérité ? Ma préparation est-elle suffisante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le moment de vérité révèle le vrai du faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité triomphe toujours de l'illusion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour le moment de vérité triomphe." }
  ],
  munajat: `Ya Rabb, je suis prêt pour le moment de vérité. Ne permets pas que je sois pris au dépourvu. Donne-moi la préparation qui triomphe et la vérité qui éclaire.`
};

MIROIR["10:81"] = {
  reference: "10:81",
  theme: ["vérité", "nullité", "triomphe"],
  emotion: "Triomphe, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Batil"],
  mirrorVersion: `« Quand ils eurent jeté, Moïse dit : Ce que vous avez produit est magie. Allah l'annulera. » Le miroir me montre le triomphe de la vérité. « Inna Allaha sayubtiluh » — Allah l'annulera. Le faux sera annihilé. Le miroir m'interroge : est-ce que je fais confiance à Allah pour annuler le faux ?`,
  reflection: `Allah annule le faux et établit la vérité. Le faux est destiné à disparaître.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falamma alqaw qala Musa ma ji'tum bihi al-sihru inna Allaha sayubtiluhu inna Allaha la yuslihu 'amala al-mufsidin » — quand ils eurent jeté, Moïse dit : Ce que vous avez produit est magie. Allah l'annulera. Allah ne corrige pas l'œuvre des corrupteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Allah pour annuler le faux ? Ou est-ce que je doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le triomphe de la vérité est assuré par Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité annihile le faux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah pour annuler le faux triomphe." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ta capacité d'annuler le faux. Ne permets pas que je doute. Donne-moi la confiance qui triomphe et la vérité qui éclaire.`
};

MIROIR["10:82"] = {
  reference: "10:82",
  theme: ["parole", "vérité", "établissement"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Kalimah", "Al-Haqq"],
  mirrorVersion: `« Allah établit la vérité par Ses paroles. » Le miroir me montre l'établissement divin. « Wa yuhiqqa Allahu al-haqqa » — Allah établit la vérité. La vérité triomphe malgré les criminels. Le miroir m'interroge : est-ce que je soutiens l'établissement de la vérité ?`,
  reflection: `Allah établit la vérité par Ses paroles, même si les criminels détestent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yuhiqqa Allahu al-haqqa bi-kalimatihi wa law kariha al-mujrimun » — et Allah établit la vérité par Ses paroles, même si les criminels le détestent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je soutiens l'établissement de la vérité ? Ou est-ce que je me tais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'établissement de la vérité se fait malgré les criminels." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par triompher." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soutient l'établissement de la vérité est avec Allah." }
  ],
  munajat: `Ya Rabb, je soutiens l'établissement de Ta vérité. Ne permets pas que je me tais. Donne-moi le soutien qui triomphe et la vérité qui éclaire.`
};

MIROIR["10:83"] = {
  reference: "10:83",
  theme: ["foi", "peur", "minorité"],
  emotion: "Courage, espoir",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "Al-Khawf"],
  mirrorVersion: `« Personne ne crut en Moïse, sauf quelques jeunes de son peuple, dans la peur de Pharaon. » Le miroir me montre la foi courageuse. « Fa-ma amana li-Musa illa dhurriyyatun » — personne ne crut en Moïse, sauf quelques jeunes. La foi dans la peur est courageuse. Le miroir m'interroge : est-ce que je crois même dans la peur ?`,
  reflection: `La foi dans la peur est un défi. Pharaon était tyrannique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma amana li-Musa illa dhurriyyatun min qawmihi 'ala khawfin min Fir'awna wa mala'ihim an yaftinahum » — personne ne crut en Moïse, sauf quelques jeunes de son peuple, dans la peur de Pharaon et de leurs notables, de les éprouver." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois même dans la peur ? Mon courage est-il à la hauteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi dans la peur est la foi la plus pure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les croyants courageux sont les vrais croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit dans la peur est le plus courageux." }
  ],
  munajat: `Ya Rabb, je crois même dans la peur. Ne permets pas que la peur m'arrête. Donne-moi le courage de croire et la foi qui triomphe.`
};

MIROIR["10:84"] = {
  reference: "10:84",
  theme: ["foi", "soumission", "remise"],
  emotion: "Confiance, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Iman", "At-Tawakkul"],
  mirrorVersion: `« Moïse dit : Ô mon peuple, si vous croyez en Allah, remettez-vous à Lui. » Le miroir me montre le chemin de la remise. « In kuntum amantum bi-Allahi fa-'alayhi tawakkalu » — si vous croyez en Allah, remettez-vous à Lui. La remise suit la foi. Le miroir m'interroge : est-ce que je me remets vraiment à Allah ?`,
  reflection: `La remise à Allah est la suite de la foi. Les croyants se remettent à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala Musa ya qawmi in kuntum amantum bi-Allahi fa-'alayhi tawakkalu in kuntum muslimin » — Moïse dit : Ô mon peuple, si vous croyez en Allah, remettez-vous à Lui, si vous êtes soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me remets vraiment à Allah ? Ma foi est-elle suivie de remise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La remise à Allah est le signe de la vraie foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les croyants se remettent à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se remet à Allah trouve la paix." }
  ],
  munajat: `Ya Rabb, je me remets à Toi. Ne permets pas que je retienne ma remise. Donne-moi la foi qui remet et la paix qui suit.`
};

MIROIR["10:85"] = {
  reference: "10:85",
  theme: ["remise", "retour", "jugement"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["At-Tawakkul", "Al-Masir"],
  mirrorVersion: `« Ils dirent : En Allah nous nous remettons. Ô notre Seigneur, ne nous expose pas aux injustices de ce peuple. » Le miroir me montre la prière des croyants. « 'Ala Allahi tawakkalna » — en Allah nous nous remettons. La remise est suivie de la prière. Le miroir m'interroge : est-ce que je prie après la remise ?`,
  reflection: `Les croyants se remettent à Allah et prient pour être protégés des injustes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-qalu 'ala Allahi tawakkalna rabbana la taj'alna fitnatan li-al-qawmi al-zalimina » — ils dirent : En Allah nous nous remettons. Ô notre Seigneur, ne nous expose pas aux injustices de ce peuple." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie après la remise ? Ma prière est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière après la remise est la plus belle prière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les croyants prient pour la protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie après la remise est exaucé." }
  ],
  munajat: `Ya Rabb, je me remets à Toi et je Te prie. Ne permets pas que je sois exposé aux injustices. Donne-moi la protection que j'implore et la paix que je cherche.`
};

MIROIR["10:86"] = {
  reference: "10:86",
  theme: ["salut", "mécréants", "prière"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Najat", "Al-Kafirun"],
  mirrorVersion: `« Et sauve-nous par Ta miséricorde des gens mécréants. » Le miroir me montre la prière du salut. « Wa najjina bi-rahmatika mina al-qawmi al-kafirin » — et sauve-nous par Ta miséricorde des gens mécréants. Le salut vient de la miséricorde. Le miroir m'interroge : est-ce que je demande le salut ?`,
  reflection: `Le salut vient de la miséricorde d'Allah. Les croyants demandent d'être sauvés des mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa najjina bi-rahmatika mina al-qawmi al-kafirin » — et sauve-nous par Ta miséricorde des gens mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande le salut ? Ma prière est-elle pour le salut ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière pour le salut est la prière du croyant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah sauve les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande le salut est sauvé." }
  ],
  munajat: `Ya Rabb, sauve-moi par Ta miséricorde. Ne permets pas que je sois parmi les perdants. Donne-moi le salut que j'implore et la miséricorde qui sauve.`
};

MIROIR["10:87"] = {
  reference: "10:87",
  theme: ["maison", "prière", "inspiration"],
  emotion: "Obéissance, dévotion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Buyut", "As-Salah"],
  mirrorVersion: `« Nous révélâmes à Moïse et à son frère : Prenez pour votre peuple des maisons en Égypte. » Le miroir me montre l'inspiration divine. « Awhayna ila Musa wa akhihi » — Nous révélâmes à Moïse et à son frère. L'inspiration guide les détails. Le miroir m'interroge : est-ce que j'écoute l'inspiration d'Allah ?`,
  reflection: `Allah a inspiré Moïse et Aaron pour qu'ils prennent des maisons et y accomplissent la prière.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa awhayna ila Musa wa akhihi an tabawwa'a li-qawmikuma bi-Misra buyutan wa i'jalu buyutakum qiblatan wa aqimu al-salata » — Nous révélâmes à Moïse et à son frère : Prenez pour votre peuple des maisons en Égypte, et faites de vos maisons une direction de prière et accomplissez la prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute l'inspiration d'Allah ? Ou est-ce que j'ignore les détails ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inspiration divine guide même les détails." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière dans les maisons est une bénédiction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit l'inspiration divine est guidé." }
  ],
  munajat: `Ya Rabb, j'écoute Ton inspiration. Ne permets pas que j'ignore les détails. Donne-moi l'obéissance qui suit et la prière qui élève.`
};

MIROIR["10:88"] = {
  reference: "10:88",
  theme: ["prière", "richesse", "égarement"],
  emotion: "Tristesse, intercession",
  difficulty: "intermédiaire",
  relatedNames: ["Ad-Du'a", "Al-Mal"],
  mirrorVersion: `« Moïse dit : Seigneur, Tu as donné à Pharaon et à ses notables des parures et des biens. » Le miroir me montre la prière contre l'égarement. « Atayta Fir'awna » — Tu as donné à Pharaon. La richesse peut égarer. Le miroir m'interroge : est-ce que je demande la protection contre l'égarement de la richesse ?`,
  reflection: `Moïse prie contre l'égarement des riches. La richesse sans foi mène à l'égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qala Musa rabbana innaka atayta Fir'awna wa mala'ahu zinatan wa amwalan fi al-hayati al-dunya rabbana li-yudillu 'an sabilik » — Moïse dit : Seigneur, Tu as donné à Pharaon et à ses notables des parures et des biens dans la vie présente. Seigneur, pour qu'ils s'égarent de Ton chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la protection contre l'égarement de la richesse ? Ou est-ce que je la recherche aveuglément ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse sans foi est un égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La richesse peut être une épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande protection contre l'égarement est protégé." }
  ],
  munajat: `Ya Rabb, je demande protection contre l'égarement de la richesse. Ne permets pas que les biens m'éloignent de Toi. Donne-moi la richesse qui guide et la protection qui sauve.`
};

MIROIR["10:89"] = {
  reference: "10:89",
  theme: ["exaucement", "prière", "certitude"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Istijabah", "Ad-Du'a"],
  mirrorVersion: `« Il dit : Votre prière est exaucée. Restez tous deux sur le chemin droit. » Le miroir me montre l'exaucement divin. « Qad ujibat da'watukuma » — votre prière est exaucée. L'exaucement vient avec la direction. Le miroir m'interroge : est-ce que je reste sur le chemin droit après l'exaucement ?`,
  reflection: `La prière est exaucée. Il faut rester sur le chemin droit et ne pas suivre l'ignorance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala qad ujibat da'watukuma fa-istaqima wa la tattabi'anni sabila alladhina la ya'lamun » — Il dit : Votre prière est exaucée. Restez tous deux sur le chemin droit et ne suivez pas le chemin de ceux qui ne savent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste sur le chemin droit après l'exaucement ? Ou est-ce que je m'égare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exaucement demande la constance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La prière exaucée est suivie de guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste sur le chemin après l'exaucement réussit." }
  ],
  munajat: `Ya Rabb, merci pour l'exaucement. Ne permets pas que je m'égare après. Donne-moi la constance sur le chemin et la guidance qui maintient.`
};

MIROIR["10:90"] = {
  reference: "10:90",
  theme: ["noyade", "foi tardive", "réalisation"],
  emotion: "Tragédie, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Gharq", "Al-Iman"],
  mirrorVersion: `« Nous fîmes traverser la mer aux Enfants d'Israël. Pharaon les poursuivit. Puis, quand la noyade l'atteignit, il dit : Je crois. » Le miroir me montre la foi tardive. « Aman tu annahu la ilaha illa alladhi amanat bihi Bani Isra'il » — je crois qu'il n'y a de divinité que Celui en qui les Enfants d'Israël croient. La foi au moment de la mort est trop tard. Le miroir m'interroge : est-ce que je crois maintenant ?`,
  reflection: `Pharaon a cru quand la noyade l'a atteint. La foi tardive ne sauve pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa jawazna bi-Bani Isra'ila al-bahra fa-atba'ahum Fir'awnu wa junuduhu baghyan wa 'adwan hatta idha adrakahu al-gharaqu qala amantu annahu la ilaha illa alladhi amanat bihi Bani Isra'il » — Nous fîmes traverser la mer aux Enfants d'Israël. Pharaon et ses armées les poursuivirent par tyrannie et hostilité. Puis, quand la noyade l'atteignit, il dit : Je crois qu'il n'y a de divinité que Celui en qui les Enfants d'Israël croient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois maintenant ? Ou est-ce que j'attends le moment où il sera trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi tardive ne sauve pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi au bon moment sauve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant est sauvé." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que j'attende le moment de la noyade. Donne-moi la foi qui sauve et la croyance qui guide.`
};

MIROIR["10:91"] = {
  reference: "10:91",
  theme: ["rejet", "orgueil", "jugement"],
  emotion: "Réalité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Radd", "Al-Kibr"],
  mirrorVersion: `« Maintenant ? Alors qu'auparavant tu as désobéi et que tu as été parmi les corrupteurs. » Le miroir me montre le rejet de la foi tardive. « Al-ana wa qad 'asayta » — maintenant ? Alors qu'auparavant tu as désobéi. La foi après la désobéissance prolongée est rejetée. Le miroir m'interroge : est-ce que je me repens maintenant ?`,
  reflection: `La foi tardive après une vie de désobéissance et de corruption est rejetée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-ana wa qad 'asayta qablu wa kunta mina al-mufsidin » — maintenant ? Alors qu'auparavant tu as désobéi et que tu as été parmi les corrupteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens maintenant ? Ou est-ce que j'attends le rejet ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le repentir tardif après la désobéissance est inacceptable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repentir au bon moment est accepté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent maintenant est accepté." }
  ],
  munajat: `Ya Rabb, je me repens maintenant. Ne permets pas que j'attende le rejet. Donne-moi le repentir qui sauve et la foi qui guide.`
};

MIROIR["10:92"] = {
  reference: "10:92",
  theme: ["corps", "signe", "préservation"],
  emotion: "Avertissement, signe",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jasad", "Al-Ayah"],
  mirrorVersion: `« Aujourd'hui, Nous allons épargner ton corps pour que tu sois un signe pour ceux qui viendront après toi. » Le miroir me montre la préservation divine. « Nujjika bi-badanika » — Nous allons épargner ton corps. Le corps de Pharaon est préservé comme signe. Le miroir m'interroge : est-ce que je réfléchis aux signes ?`,
  reflection: `Le corps de Pharaon a été préservé comme signe pour les générations futures.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-yawma nunajjika bi-badanika li-takuna li-man khalfaka ayatan wa inna kathiran mina al-nasi 'an ayatina laghafilun » — aujourd'hui, Nous allons épargner ton corps pour que tu sois un signe pour ceux qui viendront après toi. Mais beaucoup de gens ne prêtent aucune attention à Nos signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réfléchis aux signes ? Ou est-ce que je suis parmi les inattentifs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont préservés pour ceux qui réfléchissent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque signe est un rappel pour les croyants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réfléchit aux signes est guidé." }
  ],
  munajat: `Ya Rabb, je réfléchis à Tes signes. Ne permets pas que je sois parmi les inattentifs. Donne-moi la réflexion qui guide et l'attention qui sauve.`
};

MIROIR["10:93"] = {
  reference: "10:93",
  theme: ["établissement", "désaccord", "jugement"],
  emotion: "Avertissement, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Istiqar", "Al-Hukm"],
  mirrorVersion: `« Nous avons établi les Enfants d'Israël dans un lieu sûr et Nous leur avons attribué des nourritures excellentes. » Le miroir me montre la grâce divine. « Bawwa'na Bani Isra'ila mawtin amin » — Nous avons établi les Enfants d'Israël dans un lieu sûr. La grâce a été suivie de désaccord. Le miroir m'interroge : est-ce que je suis reconnaissant pour la grâce ?`,
  reflection: `Les Enfants d'Israël ont reçu une grâce mais ils ont divergé. Le jugement d'Allah tranchera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad bawwa'na Bani Isra'ila mawtin aminin wa razaqnahum mina al-tayyibati fama ikhtalafu hatta ja'ahumu al-'ilm » — Nous avons certainement établi les Enfants d'Israël dans un lieu sûr et Nous leur avons attribué des nourritures excellentes. Ils n'ont divergé qu'après que la science leur fut venue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la grâce ? Ou est-ce que je diverge après la grâce ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La divergence après la grâce est un égarement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah tranche les divergences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste uni après la grâce est guidé." }
  ],
  munajat: `Ya Rabb, je suis reconnaissant pour la grâce. Ne permets pas que je diverge après. Donne-moi la reconnaissance qui unit et la foi qui maintient.`
};

MIROIR["10:94"] = {
  reference: "10:94",
  theme: ["question", "révélation", "certitude"],
  emotion: "Certitude, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qur'an", "Al-Yaqin"],
  mirrorVersion: `« Si tu es en doute sur ce que Nous avons fait descendre, interroge ceux qui lisent l'Écriture avant toi. » Le miroir me montre la confirmation. « Fa-s'al man yaqra'u al-kitaba min qablik » — interroge ceux qui lisent l'Écriture avant toi. La vérité est confirmée. Le miroir m'interroge : est-ce que je cherche la confirmation de la vérité ?`,
  reflection: `La vérité du Coran est confirmée par les écritures précédentes. Le Prophète ne doit pas douter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-in kunta fi shakkin mimma anzalna ilayka fa-s'al alladhina yaqra'una al-kitaba min qablik » — si tu es en doute sur ce que Nous avons fait descendre, interroge ceux qui lisent l'Écriture avant toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la confirmation de la vérité ? Ou est-ce que je doute sans chercher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La confirmation est là pour ceux qui cherchent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est confirmée par toutes les révélations." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la confirmation trouve la certitude." }
  ],
  munajat: `Ya Rabb, je cherche la confirmation de la vérité. Ne permets pas que je doute sans chercher. Donne-moi la certitude qui guide et la vérité qui sauve.`
};

MIROIR["10:95"] = {
  reference: "10:95",
  theme: ["désaveu", "mécréance", "perdition"],
  emotion: "Avertissement, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Kufr", "Al-Khasara"],
  mirrorVersion: `« Ne sois pas parmi ceux qui traitent de mensonge les signes d'Allah, sinon tu serais parmi les perdants. » Le miroir me montre l'avertissement. « La takunanna mina alladhina kadhdhabu » — ne sois pas parmi ceux qui traitent de mensonge. Le déni mène à la perdition. Le miroir m'interroge : est-ce que je traite les signes de mensonge ?`,
  reflection: `Le déni des signes d'Allah mène à la perdition. La foi sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la takunanna mina alladhina kadhdhabu bi-ayati Allahi fa-takuna mina al-khasirin » — ne sois pas parmi ceux qui traitent de mensonge les signes d'Allah, sinon tu serais parmi les perdants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite les signes de mensonge ? Ou est-ce que je crois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déni mène à la perdition, la foi mène au succès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes d'Allah sont vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aux signes n'est pas perdant." }
  ],
  munajat: `Ya Rabb, je crois à Tes signes. Ne permets pas que je les traite de mensonge. Donne-moi la foi qui sauve et la croyance qui guide.`
};

MIROIR["10:96"] = {
  reference: "10:96",
  theme: ["décret", "signes", "rejet"],
  emotion: "Réalité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qada", "Al-Ayat"],
  mirrorVersion: `« Ceux contre qui la parole de ton Seigneur s'est accomplie ne croiront pas. » Le miroir me montre le décret. « Haqqat 'alayhim kalimatu rabbika » — la parole de ton Seigneur s'est accomplie sur eux. Le décret scelle leur sort. Le miroir m'interroge : est-ce que je crains le décret ?`,
  reflection: `Le décret d'Allah s'accomplit sur ceux qui ont rejeté les signes malgré les avertissements.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina haqqat 'alayhim kalimatu rabbika la yu'minun » — ceux contre qui la parole de ton Seigneur s'est accomplie ne croiront pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le décret ? Ou est-ce que je continue à rejeter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le décret scelle le sort des obstinés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le décret d'Allah est irréversible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant le décret est sauvé." }
  ],
  munajat: `Ya Rabb, je crains Ton décret. Ne permets pas que je sois scellé dans le rejet. Donne-moi le repentir qui sauve et la foi qui guide.`
};

MIROIR["10:97"] = {
  reference: "10:97",
  theme: ["signes", "foi", "obstination"],
  emotion: "Tristesse, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "Al-Iman"],
  mirrorVersion: `« Même si tous les signes leur venaient, ils ne croiront pas. » Le miroir me montre l'obstination. « Wa law atahum kullu ayatin » — même si tous les signes leur venaient. L'obstination empêche la foi. Le miroir m'interroge : est-ce que je suis obstiné ou ouvert ?`,
  reflection: `Les signes ne profitent pas aux obstinés. Ils ne croient pas jusqu'à voir le châtiment douloureux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law atahum kullu ayatin hatta yarawu al-'adhaba al-alim » — même si tous les signes leur venaient, ils ne croiront pas, jusqu'à ce qu'ils voient le châtiment douloureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis obstiné ou ouvert ? Mon cœur est-il prêt à croire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obstination empêche la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont pour les cœurs ouverts." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ouvre son cœur aux signes croit." }
  ],
  munajat: `Ya Rabb, j'ouvre mon cœur à Tes signes. Ne permets pas que je sois obstiné. Donne-moi l'ouverture qui croit et la foi qui sauve.`
};

MIROIR["10:98"] = {
  reference: "10:98",
  theme: ["cité", "foi", "utilité"],
  emotion: "Espoir, repentir",
  difficulty: "débutant",
  relatedNames: ["Al-Qaryah", "At-Tawbah"],
  mirrorVersion: `« Si seulement il y avait une cité qui ait cru et à qui sa foi ait profité ! » Le miroir me montre l'exception de Yunus. « Law anna qaryatan amanat » — si seulement il y avait une cité qui ait cru. La foi peut sauver. Le miroir m'interroge : est-ce que ma foi est utile ?`,
  reflection: `Le peuple de Yunus a cru et sa foi lui a profité. La foi au bon moment sauve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Falawla kanat qaryatun amanat fa-nafa'aha imanuha illa qawma Yunus lamma amanu kashafna 'anhum 'adhaba al-khayzi fi al-hayati al-dunya » — si seulement il y avait une cité qui ait cru et à qui sa foi ait profité ! À part le peuple de Yunus : quand ils crurent, Nous leur épargnâmes le châtiment d'ignominie dans la vie présente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi est utile ? Est-ce que je crois au bon moment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi au bon moment sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est bénéfique quand elle est sincère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit avec sincérité en profite." }
  ],
  munajat: `Ya Rabb, je crois avec sincérité. Ne permets pas que ma foi soit inutile. Donne-moi la foi qui sauve et le repentir qui profite.`
};

MIROIR["10:99"] = {
  reference: "10:99",
  theme: ["volonté", "foi", "coercition"],
  emotion: "Liberté, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mashi'ah", "Al-Iman"],
  mirrorVersion: `« Si ton Seigneur l'avait voulu, tous ceux qui sont sur terre auraient cru. » Le miroir me montre la volonté divine. « Law sha'a rabbuka » — si ton Seigneur l'avait voulu. La foi est un choix libre. Le miroir m'interroge : est-ce que je choisis librement de croire ?`,
  reflection: `Allah aurait pu forcer la foi de tous. Mais la foi libre a plus de valeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law sha'a rabbuka la-amana man fi al-ardi kulluhum ajma'in » — si ton Seigneur l'avait voulu, tous ceux qui sont sur terre auraient cru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis librement de croire ? Ma foi est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi forcée n'a pas de valeur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi libre est la vraie foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit librement est le vrai croyant." }
  ],
  munajat: `Ya Rabb, je choisis librement de croire. Ne permets pas que ma foi soit forcée. Donne-moi la foi sincère et le choix qui honore.`
};

MIROIR["10:100"] = {
  reference: "10:100",
  theme: ["permission", "foi", "signes"],
  emotion: "Vérité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Idhn", "Al-Ayat"],
  mirrorVersion: `« Il n'appartient à personne de croire sans la permission d'Allah. » Le miroir me montre la permission divine. « Ma kana li-nafsin an tu'mina illa bi-idhni Allah » — il n'appartient à personne de croire sans la permission d'Allah. La foi est un don. Le miroir m'interroge : est-ce que je demande la permission de croire ?`,
  reflection: `La foi vient par la permission d'Allah. Les impurs sont rejetés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana li-nafsin an tu'mina illa bi-idhni Allahi wa yaj'alu al-rijsa 'ala alladhina la ya'qilun » — il n'appartient à personne de croire sans la permission d'Allah. Et Il impose l'impureté à ceux qui ne raisonnent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la permission de croire ? Ou est-ce que je pense que la foi m'appartient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La permission d'Allah est le don de la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foi est un don d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la permission de croire la reçoit." }
  ],
  munajat: `Ya Rabb, je demande Ta permission de croire. Ne permets pas que je sois parmi les impurs. Donne-moi la foi qui vient de Toi et la permission qui honore.`
};

MIROIR["10:101"] = {
  reference: "10:101",
  theme: ["signes", "avertissement", "réflexion"],
  emotion: "Invitation, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Ayat", "An-Nadhar"],
  mirrorVersion: `« Dis : Regardez ce qui est dans les cieux et sur terre. » Le miroir me montre l'invitation à la réflexion. « Unzuru madha fi al-samawati wa al-ardi » — regardez ce qui est dans les cieux et sur terre. L'univers est un signe. Le miroir m'interroge : est-ce que je regarde les signes ?`,
  reflection: `Les signes sont dans les cieux et sur terre. Les avertissements ne profitent pas aux mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul unzuru madha fi al-samawati wa al-ardi wa ma tughni al-ayatu wa al-nudhuru 'an qawmin la yu'minun » — dis : Regardez ce qui est dans les cieux et sur terre. Mais les signes et les avertissements ne servent à rien pour des gens qui ne croient pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je regarde les signes ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les signes sont là pour ceux qui regardent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est rempli de signes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regarde les signes trouve la foi." }
  ],
  munajat: `Ya Rabb, je regarde Tes signes. Ne permets pas que je les ignore. Donne-moi la vue qui voit et la foi qui suit.`
};

MIROIR["10:102"] = {
  reference: "10:102",
  theme: ["attente", "jours", "châtiment"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Intizar", "Al-Ayyam"],
  mirrorVersion: `« Attendent-ils que leur arrive des jours semblables à ceux de ceux qui ont vécu avant eux ? » Le miroir me montre l'avertissement de l'histoire. « Fahal yantaziruna illa mithla ayyami » — attendent-ils que leur arrive des jours semblables à ceux de ceux qui ont vécu avant eux ? L'histoire se répète. Le miroir m'interroge : est-ce que j'apprends de l'histoire ?`,
  reflection: `Les peuples précédents ont été châtiés. L'histoire est un avertissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fahal yantaziruna illa mithla ayyami alladhina khalaw min qablihim qul fa-intaziru inni ma'akum mina al-muntazirin » — attendent-ils autre chose que des jours semblables à ceux de ceux qui ont vécu avant eux ? Dis : Attendez donc ! Moi aussi, je suis avec vous, parmi ceux qui attendent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de l'histoire ? Ou est-ce que j'attends la répétition ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire est un avertissement pour ceux qui réfléchissent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jours des peuples précédents sont des leçons." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend de l'histoire est sauvé." }
  ],
  munajat: `Ya Rabb, j'apprends de l'histoire. Ne permets pas que j'attende la répétition. Donne-moi la sagesse qui sauve et la foi qui guide.`
};

MIROIR["10:103"] = {
  reference: "10:103",
  theme: ["sauvetage", "prophète", "foi"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Najat", "Al-Iman"],
  mirrorVersion: `« Puis Nous sauverons Nos messagers et ceux qui ont cru. » Le miroir me montre la promesse du sauvetage. « Thumma nunajji rusulana » — puis Nous sauverons Nos messagers. Le sauvetage est une promesse. Le miroir m'interroge : est-ce que je crois à la promesse du sauvetage ?`,
  reflection: `Allah sauve les messagers et les croyants. C'est une obligation pour Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma nunajji rusulana wa alladhina amanu kadhalika haqqan 'alayna nunji al-mu'minin » — puis Nous sauverons Nos messagers et ceux qui ont cru. C'est ainsi qu'il Nous est obligatoire de sauver les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois à la promesse du sauvetage ? Ma foi me qualifie-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sauvetage est promis aux croyants." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le sauvetage est une obligation pour Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au sauvetage sera sauvé." }
  ],
  munajat: `Ya Rabb, je crois à Ta promesse de sauvetage. Ne permets pas que je sois parmi les perdants. Donne-moi la foi qui qualifie et le sauvetage qui sauve.`
};

MIROIR["10:104"] = {
  reference: "10:104",
  theme: ["adoration", "sincérité", "direction"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Ibadah", "Al-Ikhlas"],
  mirrorVersion: `« Dis : Ô hommes, si vous doutez de ma religion, je n'adore pas ceux que vous adorez en dehors d'Allah. » Le miroir me montre la sincérité de l'adoration. « La a'budu ma ta'buduna » — je n'adore pas ce que vous adorez. L'adoration est exclusive. Le miroir m'interroge : est-ce que mon adoration est exclusive à Allah ?`,
  reflection: `Le Prophète adore Allah seul. Il ne suit pas les idoles des mécréants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ayyuha al-nasu in kuntum fi shakkin min dini fa-la a'budu alladhina ta'buduna min duni Allahi wa lakin a'budu Allaha alladhi yatawaffakum » — dis : Ô hommes, si vous doutez de ma religion, je n'adore pas ceux que vous adorez en dehors d'Allah. Mais j'adore Allah, qui vous fera mourir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mon adoration est exclusive à Allah ? Ou est-ce que je partage mon adoration ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration exclusive est la vraie adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'adoration est due à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul est sincère." }
  ],
  munajat: `Ya Rabb, mon adoration est exclusive à Toi. Ne permets pas que je la partage. Donne-moi la sincérité qui élève et l'adoration qui sauve.`
};

MIROIR["10:105"] = {
  reference: "10:105",
  theme: ["direction", "pureté", "croyant"],
  emotion: "Obéissance, dévotion",
  difficulty: "débutant",
  relatedNames: ["Al-Qiblah", "Al-Hanif"],
  mirrorVersion: `« Dirige ton visage vers la religion en pur croyant. » Le miroir me montre la direction. « Wa an aqim wajhaka li-al-dini hanifan » — dirige ton visage vers la religion en pur croyant. La direction est claire. Le miroir m'interroge : est-ce que je dirige mon visage vers la religion pure ?`,
  reflection: `La direction vers la religion pure est un commandement. Il ne faut pas être associateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa an aqim wajhaka li-al-dini hanifan wa la takunanna mina al-mushrikina » — et dirige ton visage vers la religion en pur croyant. Et ne sois pas parmi les associateurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dirige mon visage vers la religion pure ? Ou est-ce que je suis les associateurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La direction vers la religion pure est le chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La religion pure est pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se dirige vers la religion pure est guidé." }
  ],
  munajat: `Ya Rabb, je me dirige vers Ta religion pure. Ne permets pas que je sois parmi les associateurs. Donne-moi la direction qui guide et la pureté qui sauve.`
};

MIROIR["10:106"] = {
  reference: "10:106",
  theme: ["invocation", "profit", "nuisance"],
  emotion: "Avertissement, vérité",
  difficulty: "débutant",
  relatedNames: ["Ad-Du'a", "Al-Darr"],
  mirrorVersion: `« N'invoque pas, en dehors d'Allah, ce qui ne peut ni te profiter ni te nuire. » Le miroir me montre l'interdiction. « Wa la tad'u min duni Allahi ma la yanfa'uka » — n'invoque pas en dehors d'Allah ce qui ne peut te profiter. L'invocation est pour Allah seul. Le miroir m'interroge : est-ce que j'invoque Allah seul ?`,
  reflection: `L'invocation des autres qu'Allah est inutile. Si on le fait, on est parmi les injustes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tad'u min duni Allahi ma la yanfa'uka wa la yaduruka fa-in fa'alta fa-innaka idhan mina al-zalimin » — n'invoque pas, en dehors d'Allah, ce qui ne peut ni te profiter ni te nuire. Si tu le fais, tu seras alors parmi les injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invoque Allah seul ? Ou est-ce que j'invoque d'autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invocation des autres qu'Allah est injustice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invocation est due à Allah seul." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah seul est juste." }
  ],
  munajat: `Ya Rabb, j'invoque Toi seul. Ne permets pas que j'invoque d'autres. Donne-moi l'invocation qui élève et la justice qui sauve.`
};

MIROIR["10:107"] = {
  reference: "10:107",
  theme: ["bienfait", "malheur", "permission"],
  emotion: "Confiance, soumission",
  difficulty: "débutant",
  relatedNames: ["An-Na'ma", "Ad-Darr"],
  mirrorVersion: `« Si Allah te touche par un malheur, nul ne peut l'écarter que Lui. » Le miroir me montre le pouvoir exclusif. « In yamsaska Allahu bi-durrin » — si Allah te touche par un malheur. Seul Allah peut écarter le malheur. Le miroir m'interroge : est-ce que je me tourne vers Allah pour écarter le malheur ?`,
  reflection: `Allah seul peut écarter le malheur et apporter le bienfait. Il est capable de toute chose.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in yamsaska Allahu bi-durrin fa-la kashifa lahu illa huwa wa in yuridka bi-khayrin fa-la radda li-fadlihi » — si Allah te touche par un malheur, nul ne peut l'écarter que Lui. Et s'Il veut pour toi un bien, nul ne peut repousser Sa grâce." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me tourne vers Allah pour écarter le malheur ? Ou est-ce que je cherche ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Seul Allah peut écarter le malheur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le bien et le mal sont entre les mains d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se tourne vers Allah pour tout est guidé." }
  ],
  munajat: `Ya Rabb, je me tourne vers Toi pour tout. Ne permets pas que je cherche ailleurs. Donne-moi la confiance qui sauve et la soumission qui élève.`
};

MIROIR["10:108"] = {
  reference: "10:108",
  theme: ["vérité", "égarement", "responsabilité"],
  emotion: "Clarté, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Dalal"],
  mirrorVersion: `« Dis : Ô hommes, la vérité vous est venue de votre Seigneur. Quiconque se guide, se guide pour lui-même. » Le miroir me montre la responsabilité individuelle. « Man ihtada » — quiconque se guide. La guidance est personnelle. Le miroir m'interroge : est-ce que je me guide ?`,
  reflection: `La vérité est venue de Allah. Chacun est responsable de sa guidance ou de son égarement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul ya ayyuha al-nasu qad ja'akumu al-haqqu min rabbikum fa-man ihtada fa-innama yahtadi li-nafsihi wa man dalla fa-innama yadillu 'alayha » — dis : Ô hommes, la vérité vous est venue de votre Seigneur. Quiconque se guide, ne se guide que pour lui-même. Et quiconque s'égare, ne s'égare qu'à son propre détriment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me guide ? Ou est-ce que je m'égare ? Mon choix est-il clair ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La responsabilité individuelle est la base du jugement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est offerte à tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se guide est vraiment guidé." }
  ],
  munajat: `Ya Rabb, je me guide vers Toi. Ne permets pas que je m'égare. Donne-moi la guidance qui sauve et la responsabilité qui honore.`
};

MIROIR["10:109"] = {
  reference: "10:109",
  theme: ["suivi", "révélation", "patience"],
  emotion: "Obéissance, patience",
  difficulty: "débutant",
  relatedNames: ["At-Taba'", "Al-Wahy"],
  mirrorVersion: `« Suis ce qui t'est révélé et sois patient. » Le miroir me montre le commandement final. « Wa ittabi' ma yuha ilayka » — suis ce qui t'est révélé. Le suivi demande la patience. Le miroir m'interroge : est-ce que je suis la révélation avec patience ?`,
  reflection: `Le suivi de la révélation demande la patience jusqu'au jugement d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ittabi' ma yuha ilayka wa isbir hatta yahkuma Allahu wa huwa khayru al-hakimin » — suis ce qui t'est révélé et sois patient jusqu'à ce qu'Allah juge. Et Il est le meilleur des juges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la révélation avec patience ? Ou est-ce que je suis impatient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience dans le suivi est la clé du succès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement d'Allah est le meilleur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit avec patience triomphe." }
  ],
  munajat: `Ya Rabb, je suis Ta révélation avec patience. Ne permets pas que je sois impatient. Donne-moi le suivi qui obéit et la patience qui sauve.`
};

// ==================== SURAH 69: AL-HAQQAH - COMPLETION (69:4-69:52) ====================

MIROIR["69:4"] = {
  reference: "69:4",
  theme: ["peuples", "mensonge", "châtiment"],
  emotion: "Avertissement, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Muntaqim"],
  mirrorVersion: `« Thamud et 'Ad ont traité de mensonge le Fracas. » Le miroir me montre le destin des peuples passés. « Kadhdhabat Thamudu wa 'Adun bi-l-qari'ah » — Thamud et 'Ad ont traité de mensonge le Fracas. Ces peuples ont été détruits. Le miroir m'interroge : est-ce que je traite de mensonge les avertissements ?`,
  reflection: `Les peuples passés ont péri pour avoir nié la vérité. Leur exemple doit nous instruire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhdhabat Thamudu wa 'Adun bi-l-qari'ah » — Thamud et 'Ad ont traité de mensonge le Fracas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite de mensonge les avertissements ? Ou est-ce que j'en tire des leçons ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation des avertissements mène à la destruction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire des peuples est une leçon pour l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire des leçons du passé évite son sort." }
  ],
  munajat: `Ya Haqq, je ne traite pas Tes avertissements de mensonge. Donne-moi la sagesse d'apprendre du passé. Préserve-moi du sort des négateurs.`
};

MIROIR["69:5"] = {
  reference: "69:5",
  theme: ["destruction", "thamud", "terreur"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Quant aux Thamud, ils furent détruits par le fracas. » Le miroir me montre la destruction de Thamud. « Fa-amma Thamudu fa-uhliku bi-l-taghiyah » — Thamud fut détruit par le fracas. Le châtiment fut terrifiant. Le miroir m'interroge : est-ce que je crains un tel châtiment ?`,
  reflection: `La destruction de Thamud fut soudaine et terrifiante. Leur arrogance les a perdus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma Thamudu fa-uhliku bi-l-taghiyah » — quant aux Thamud, ils furent détruits par le fracas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains un tel châtiment ? Mon arrogance me mènera-t-elle au même sort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction suit l'arrogance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre porte les traces des peuples détruits." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment se protège par la piété." }
  ],
  munajat: `Ya Qahhar, Tu détruis les arrogants. Fais que je ne sois pas arrogant. Préserve-moi de la destruction des négateurs.`
};

MIROIR["69:6"] = {
  reference: "69:6",
  theme: ["destruction", "'ad", "vent"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Et quant aux 'Ad, ils furent détruits par un vent mugissant et impétueux. » Le miroir me montre la destruction de 'Ad. « Wa amma 'Adun fa-uhliku bi-rihin sarsarin 'atiyah » — 'Ad fut détruit par un vent mugissant. La nature fut l'instrument du châtiment. Le miroir m'interroge : est-ce que je respecte la puissance d'Allah dans la nature ?`,
  reflection: `Le vent peut être une bénédiction ou un châtiment selon la volonté d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma 'Adun fa-uhliku bi-rihin sarsarin 'atiyah » — et quant aux 'Ad, ils furent détruits par un vent mugissant et impétueux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la puissance d'Allah dans la nature ? Ou est-ce que je m'y expose par mon arrogance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nature obéit à Allah. Elle peut détruire ou bénir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les éléments sont des serviteurs d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la nature respecte son Créateur." }
  ],
  munajat: `Ya Qadir, Tu contrôles les éléments. Fais que je respecte Ta puissance dans la nature. Préserve-moi des châtiments naturels.`
};

MIROIR["69:7"] = {
  reference: "69:7",
  theme: ["durée", "châtiment", "nuit"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muntaqim"],
  mirrorVersion: `« Qu'Il fit souffler contre eux pendant sept nuits et huit jours consécutifs. » Le miroir me montre la durée du châtiment. « Sakhkhraha 'alayhim sab'a layalin wa thamaniyata ayyamin husuman » — sept nuits et huit jours. Le châtiment fut prolongé. Le miroir m'interroge : est-ce que je réalise l'intensité du châtiment ?`,
  reflection: `Le châtiment peut être prolongé. La souffrance s'étend quand la rébellion persiste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sakhkhraha 'alayhim sab'a layalin wa thamaniyata ayyamin husuman » — qu'Il fit souffler contre eux pendant sept nuits et huit jours consécutifs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise l'intensité du châtiment ? Puis-je endurer sept nuits et huit jours de souffrance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La durée du châtiment reflète la gravité de la rébellion." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps peut être une bénédiction ou un châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la durée du châtiment se repent." }
  ],
  munajat: `Ya Rabb, le châtiment peut être prolongé. Fais que je me repente avant qu'il ne soit trop tard. Ne permets pas que je subisse un châtiment prolongé.`
};

MIROIR["69:8"] = {
  reference: "69:8",
  theme: ["survie", "trace", "destruction"],
  emotion: "Solennité, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Baqi"],
  mirrorVersion: `« Tu n'en vois aucun survivant. » Le miroir me montre l'anéantissement total. « Fa-tara al-qawma fiha sar'a min sdaqin » — tu ne vois aucun survivant. La destruction fut totale. Le miroir m'interroge : est-ce que je réalise que la destruction peut être totale ?`,
  reflection: `La destruction peut être totale. Personne ne survit au châtiment d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tara al-qawma fiha sar'a min sdaqin » — tu n'en vois aucun survivant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise que la destruction peut être totale ? Que personne ne peut y échapper ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La survie n'est pas garantie. La destruction peut être complète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les traces des peuples détruits témoignent de leur sort." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les traces des détruits se protège." }
  ],
  munajat: `Ya Mumit, Tu anéantis totalement les négateurs. Préserve-moi de l'anéantissement. Ne permets pas que je sois parmi les détruits.`
};

MIROIR["69:9"] = {
  reference: "69:9",
  theme: ["pharaon", "châtiment", "exemple"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahhar", "Al-Muntaqim"],
  mirrorVersion: `« Et Pharaon, ceux qui vécurent avant lui et les villes renversées. » Le miroir me montre d'autres exemples. « Wa Pharaunu wa man qablahu wa al-mu'tafikatu » — Pharaon et ceux avant lui. Les exemples sont nombreux. Le miroir m'interroge : est-ce que j'apprends de ces exemples ?`,
  reflection: `Pharaon et les peuples passés sont des exemples. Leur sort doit instruire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Pharaunu wa man qablahu wa al-mu'tafikatu bi-l-khati'ah » — et Pharaon, ceux qui vécurent avant lui et les villes renversées commirent le péché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprends de ces exemples ? Ou est-ce que je les ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les exemples du passé sont des avertissements pour le présent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un maître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprend des exemples évite leur sort." }
  ],
  munajat: `Ya Rabb, les exemples sont nombreux. Fais que j'en tire des leçons. Ne permets pas que je suive le chemin des détruits.`
};

MIROIR["69:10"] = {
  reference: "69:10",
  theme: ["désobéissance", "messager", "châtiment"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Muntaqim"],
  mirrorVersion: `« Ils désobéirent au messager de leur Seigneur, et Il les saisit d'une saisie redoutable. » Le miroir me montre la cause du châtiment. « 'Asaw rasula rabbihim fa-akhadhahum akhdhatan rabiyyah » — ils désobéirent au messager. La désobéissance mène au châtiment. Le miroir m'interroge : est-ce que j'obéis au messager ?`,
  reflection: `La désobéissance au messager d'Allah mène au châtiment. L'obéissance est la voie du salut.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Asaw rasula rabbihim fa-akhadhahum akhdhatan rabiyyah » — ils désobéirent au messager de leur Seigneur, et Il les saisit d'une saisie redoutable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis au messager d'Allah ? Ou est-ce que je désobéis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance au messager est l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les messagers sont envoyés pour guider." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit au messager est guidé." }
  ],
  munajat: `Ya Rabb, j'obéis à Ton messager. Ne permets pas que je désobéisse. Donne-moi l'obéissance qui sauve du châtiment.`
};

MIROIR["69:11"] = {
  reference: "69:11",
  theme: ["noé", "déluge", "arche"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "Al-Hafiz"],
  mirrorVersion: `« Quand l'eau déborda, Nous vous avons portés sur le flottant. » Le miroir me montre le sauvetage de Noé. « Inna lamma tagha al-ma'u hamalnakum fi al-jariyah » — quand l'eau déborda, Nous vous avons portés. L'arche fut le salut. Le miroir m'interroge : est-ce que je monte dans l'arche du salut ?`,
  reflection: `L'arche de Noé fut le salut du déluge. L'obéissance à Allah est notre arche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna lamma tagha al-ma'u hamalnakum fi al-jariyah » — quand l'eau déborda, Nous vous avons portés sur le flottant." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je monte dans l'arche du salut ? Ou est-ce que je reste à périr ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'arche du salut est l'obéissance à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le déluge fut universel, l'arche fut le refuge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui monte dans l'arche est sauvé." }
  ],
  munajat: `Ya Munji, Tu as sauvé Noé et les croyants. Fais que je monte dans l'arche du salut. Préserve-moi du déluge du châtiment.`
};

MIROIR["69:12"] = {
  reference: "69:12",
  theme: ["rappel", "mémoire", "leçon"],
  emotion: "Conscience, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Pour que Nous en fassions pour vous un rappel, et que l'oreille consciente le retienne. » Le miroir me montre le but du récit. « Li-naj'alaha lakum tadhkiratan wa ta'i'aha udhunun wa'iyah » — pour que Nous en fassions un rappel. L'histoire est une leçon. Le miroir m'interroge : est-ce que j'écoute avec une oreille consciente ?`,
  reflection: `L'histoire des peuples est un rappel. L'oreille consciente retient les leçons.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-naj'alaha lakum tadhkiratan wa ta'i'aha udhunun wa'iyah » — pour que Nous en fassions pour vous un rappel, et que l'oreille consciente le retienne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute avec une oreille consciente ? Est-ce que je retiens les leçons ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oreille consciente transforme l'écoute en sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est un maître universel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui retient les leçons est sage." }
  ],
  munajat: `Ya Hakim, fais que j'écoute avec une oreille consciente. Donne-moi la sagesse de retenir les leçons. Ne permets pas que j'oublie.`
};

MIROIR["69:13"] = {
  reference: "69:13",
  theme: ["trompette", "jour", "fras"],
  emotion: "Solennité, urgence",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Ba'ith"],
  mirrorVersion: `« Puis, quand le Fracas viendra, au Jour... » Le miroir me place au moment du Fracas. « Fa-iza nufikha fi al-suri nafkhatun wahidah » — quand on soufflera dans la trompette d'un seul coup. Le moment sera terrible. Le miroir m'interroge : est-ce que je suis prêt pour ce moment ?`,
  reflection: `Le Fracas viendra sans préavis. La trompette sonnera et tout sera bouleversé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-iza nufikha fi al-suri nafkhatun wahidah » — puis, quand on soufflera dans la trompette d'un seul coup." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour ce moment ? La trompette sonnera-t-elle pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour ce moment commence maintenant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La trompette touchera tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas peur du Fracas." }
  ],
  munajat: `Ya Qari'a, le Fracas viendra sans préavis. Prépare-moi pour ce moment. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["69:14"] = {
  reference: "69:14",
  theme: ["terre", "montagnes", "effondrement"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Jabbar"],
  mirrorVersion: `« Et que la terre et les montagnes seront soulevées et pulvérisées d'un seul coup. » Le miroir me montre l'effondrement cosmique. « Wa humilati al-ardu wa al-jibalu fa-dukkata dakkatan wahidah » — la terre et les montagnes seront soulevées et pulvérisées. Le monde physique s'effondrera. Le miroir m'interroge : sur quoi je compte dans ce monde qui s'effondrera ?`,
  reflection: `La terre et les montagnes, si stables, s'effondreront. Rien ne reste sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa humilati al-ardu wa al-jibalu fa-dukkata dakkatan wahidah » — et que la terre et les montagnes seront soulevées et pulvérisées d'un seul coup." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi je compte dans ce monde qui s'effondrera ? Mes repères sont-ils solides ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effondrement du monde révèle ce qui est éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers lui-même s'effondrera." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur l'éternel n'a pas peur de l'effondrement." }
  ],
  munajat: `Ya Qadir, la terre et les montagnes s'effondreront. Fais que je compte sur Toi, l'Éternel. Ne permets pas que je m'attache à ce qui s'effondrera.`
};

MIROIR["69:15"] = {
  reference: "69:15",
  theme: ["inévitable", "jour", "réalité"],
  emotion: "Solennité, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Waqi'ah"],
  mirrorVersion: `« Ce Jour-là, l'Inévitable se réalisera. » Le miroir me montre la certitude. « Fa-yawma'idhin waqa'ati al-waqi'ah » — ce Jour-là, l'Inévitable se réalisera. Ce qui était promis arrive. Le miroir m'interroge : est-ce que je crois à l'inévitable ?`,
  reflection: `L'Inévitable viendra. La promesse d'Allah est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-yawma'idhin waqa'ati al-waqi'ah » — ce Jour-là, l'Inévitable se réalisera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois à l'inévitable ? Ma vie reflète-t-elle cette certitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'inévitable transforme le présent en préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La promesse d'Allah est inscrite dans l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à l'inévitable se prépare." }
  ],
  munajat: `Ya Haqq, l'Inévitable viendra. Je crois à Ta promesse. Fais que je me prépare pour ce Jour certain.`
};

MIROIR["69:16"] = {
  reference: "69:16",
  theme: ["ciel", "fissure", "fragilité"],
  emotion: "Awe, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Fatir", "Al-Qadir"],
  mirrorVersion: `« Le ciel se fendra et sera fragile ce Jour-là. » Le miroir me montre la fragilité du ciel. « Wa inshaqqati al-sama'u fa-hiya yawma'idhin wahiyah » — le ciel se fendra et sera fragile. Ce qui semblait solide deviendra fragile. Le miroir m'interroge : où est ma sécurité ?`,
  reflection: `Le ciel lui-même deviendra fragile. Rien n'est solide sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inshaqqati al-sama'u fa-hiya yawma'idhin wahiyah » — le ciel se fendra et sera fragile ce Jour-là." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est ma sécurité ? Sur quoi je compte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fragilité du ciel révèle la solidité d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel qui nous protège s'ouvrira." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah pour refuge n'a pas peur." }
  ],
  munajat: `Ya Rabb, le ciel deviendra fragile. Toi seul es solide. Fais que je me réfugie en Toi. Ne permets pas que je compte sur ce qui est fragile.`
};

MIROIR["69:17"] = {
  reference: "69:17",
  theme: ["anges", "trône", "honneur"],
  emotion: "Awe, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-'Arsh"],
  mirrorVersion: `« Les anges seront sur ses confins, et huit porteront le Trône de ton Seigneur au-dessus d'eux. » Le miroir me montre la majesté divine. « Wa al-mala'ikatu 'ala arja'iha wa yahmilu 'arsha rabbika fawqahum yawma'idhin thamaniyah » — les anges seront aux confins et huit porteront le Trône. La majesté d'Allah sera manifeste. Le miroir m'interroge : est-ce que je réalise Sa majesté ?`,
  reflection: `Les anges porteront le Trône d'Allah. Sa majesté dépasse tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-mala'ikatu 'ala arja'iha wa yahmilu 'arsha rabbika fawqahum yawma'idhin thamaniyah » — les anges seront sur ses confins, et huit porteront le Trône de ton Seigneur au-dessus d'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je réalise Sa majesté ? Suis-je émerveillé par Sa grandeur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La majesté d'Allah relativise toute grandeur humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Trône d'Allah est au-dessus de toute création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise Sa majesté est humble." }
  ],
  munajat: `Ya 'Azim, les anges portent Ton Trône. Je suis émerveillé par Ta majesté. Fais que je sois humble devant Toi.`
};

MIROIR["69:18"] = {
  reference: "69:18",
  theme: ["présentation", "jugement", "secret"],
  emotion: "Crainte, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-Shahid"],
  mirrorVersion: `« Ce Jour-là, vous serez exposés, et rien de vous ne sera caché. » Le miroir me montre l'exposition totale. « Yawma'idhin tu'raduna la takhfa minkum khafiyyah » — vous serez exposés, rien ne sera caché. Tout sera révélé. Le miroir m'interroge : qu'est-ce qui sera révélé de moi ?`,
  reflection: `Rien ne sera caché ce Jour-là. Nos secrets seront exposés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma'idhin tu'raduna la takhfa minkum khafiyyah » — ce Jour-là, vous serez exposés, et rien de vous ne sera caché." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui sera révélé de moi ? Mes secrets sont-ils dignes d'être cachés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exposition totale purifie ou condamne." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est caché à Allah, même maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a rien à cacher n'a pas peur de l'exposition." }
  ],
  munajat: `Ya Shahid, tout sera exposé ce Jour-là. Purifie-moi de ce qui devrait être caché. Fais que je n'aie rien à cacher.`
};

MIROIR["69:19"] = {
  reference: "69:19",
  theme: ["livre", "droite", "récompense"],
  emotion: "Joie, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Hasanah", "Al-Muhsin"],
  mirrorVersion: `« Quant à celui qui recevra son livre en sa main droite, il dira : Prenez, lisez mon livre. » Le miroir me montre la joie du succès. « Fa-amma man utiya kitabahu bi-yaminihi fa-yaqulu ha'umu iqra'u kitabiyah » — celui qui reçoit son livre en main droite sera joyeux. Le miroir m'interroge : est-ce que je serai parmi ceux-là ?`,
  reflection: `Recevoir le livre en main droite est le signe du succès. La joie sera immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma man utiya kitabahu bi-yaminihi fa-yaqulu ha'umu iqra'u kitabiyah » — quant à celui qui recevra son livre en sa main droite, il dira : Prenez, lisez mon livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi ceux-là ? Mon livre sera-t-il digne d'être lu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La main droite reçoit, la main gauche rejette." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le livre des œuvres est le témoignage de chaque vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre bien reçoit bien." }
  ],
  munajat: `Ya Muhsin, je veux recevoir mon livre en main droite. Fais que mes œuvres soient bonnes. Donne-moi la joie du succès.`
};

MIROIR["69:20"] = {
  reference: "69:20",
  theme: ["certitude", "jugement", "réussite"],
  emotion: "Joie, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Muwaffiq", "Al-Fattah"],
  mirrorVersion: `« Je pensais que je rencontrerais mon jugement. » Le miroir me montre la certitude du croyant. « Inna zanantu anni mulaqin hisabiyah » — je pensais que je rencontrerais mon jugement. La certitude a précédé le résultat. Le miroir m'interroge : est-ce que j'ai cette certitude ?`,
  reflection: `La certitude du jugement prépare le croyant. La rencontre est attendue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna zanantu anni mulaqin hisabiyah » — je pensais que je rencontrerais mon jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai cette certitude ? Est-ce que j'attends le jugement avec préparation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude du jugement mène à la préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement est la rencontre avec la vérité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est certain du jugement se prépare." }
  ],
  munajat: `Ya Rabb, je suis certain du jugement. Fais que je me prépare. Donne-moi la certitude qui mène à la réussite.`
};

MIROIR["69:21"] = {
  reference: "69:21",
  theme: ["vie", "contentement", "paradis"],
  emotion: "Joie, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Il sera dans une vie satisfaite. » Le miroir me montre la récompense. « Fahuwa fi 'ishatin radiyah » — il sera dans une vie satisfaite. La satisfaction est le sommet. Le miroir m'interroge : est-ce que je cherche la satisfaction ?`,
  reflection: `La vie satisfaite est la récompense suprême. Le contentement dépasse les biens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fahuwa fi 'ishatin radiyah » — il sera dans une vie satisfaite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cherche la satisfaction ? Ou est-ce que je poursuis sans fin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La satisfaction vient du contentement, pas de l'accumulation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie satisfaite est le but de l'existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est satisfait a tout." }
  ],
  munajat: `Ya Razzaq, je veux la vie satisfaite. Fais que je sois content. Donne-moi la satisfaction qui dépasse les biens.`
};

MIROIR["69:22"] = {
  reference: "69:22",
  theme: ["jardin", "hauteur", "paradis"],
  emotion: "Joie, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wadud"],
  mirrorVersion: `« Dans un jardin élevé. » Le miroir me montre l'élévation. « Fi jannatin 'aliyah » — dans un jardin élevé. Le paradis est élevé, au-dessus de tout. Le miroir m'interroge : est-ce que j'aspire à l'élévation ?`,
  reflection: `Le jardin élevé est la récompense des élus. L'élévation est spirituelle et physique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fi jannatin 'aliyah » — dans un jardin élevé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aspire à l'élévation ? Ou est-ce que je me complais dans le bas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation du paradis répond à l'élévation spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis est au-dessus des cieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'élève ici-bas sera élevé là-bas." }
  ],
  munajat: `Ya Karim, je veux le jardin élevé. Élève-moi vers Toi. Donne-moi l'élévation qui mène au paradis.`
};

MIROIR["69:23"] = {
  reference: "69:23",
  theme: ["fruits", "proximité", "facilité"],
  emotion: "Désir, facilité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Wahhab"],
  mirrorVersion: `« Ses fruits sont à portée de main. » Le miroir me montre la proximité des délices. « Qutufuha danin » — ses fruits sont proches. Tout est accessible. Le miroir m'interroge : est-ce que je comprends que le paradis est facilité ?`,
  reflection: `Les fruits du paradis sont à portée de main. Rien n'est difficile pour les élus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qutufuha danin » — ses fruits sont à portée de main." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que le paradis est facilité ? Ou est-ce que je crains la difficulté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité du paradis répond à l'effort ici-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le paradis est le lieu de la facilité éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait l'effort maintenant jouit de la facilité plus tard." }
  ],
  munajat: `Ya Wahhab, les fruits du paradis sont proches. Fais que je fasse l'effort pour les atteindre. Donne-moi la facilité après l'effort.`
};

MIROIR["69:24"] = {
  reference: "69:24",
  theme: ["nourriture", "boisson", "récompense"],
  emotion: "Gratitude, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Al-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Mangez et buvez en paix, pour ce que vous avez fait auparavant. » Le miroir me montre la récompense des œuvres. « Kulu wa sharbu hanian bima aslaftum fi al-ayyami al-khaliyah » — mangez et buvez en paix, pour ce que vous avez fait. Le miroir m'interroge : qu'ai-je fait pour mériter cette récompense ?`,
  reflection: `La récompense du paradis est la conséquence des œuvres. La paix accompagne la nourriture.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu wa sharbu hanian bima aslaftum fi al-ayyami al-khaliyah » — mangez et buvez en paix, pour ce que vous avez fait auparavant, aux jours passés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'ai-je fait pour mériter cette récompense ? Mes œuvres sont-elles dignes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nourriture du paradis est la récompense de l'effort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nourriture et la boisson sont des dons d'Allah dans les deux mondes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui œuvre pour le paradis y mange et boit." }
  ],
  munajat: `Ya Razzaq, la nourriture du paradis est la récompense des œuvres. Fais que mes œuvres soient dignes. Donne-moi de manger et boire en paix.`
};

MIROIR["69:25"] = {
  reference: "69:25",
  theme: ["livre", "gauche", "regret"],
  emotion: "Tristesse, regret",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hasib"],
  mirrorVersion: `« Quant à celui qui recevra son livre en sa main gauche, il dira : Que je n'aie pas reçu mon livre. » Le miroir me montre le regret du perdant. « Wa amma man utiya kitabahu bi-shimalihi fa-yaqulu ya laytani lam uta kitabiyah » — celui qui reçoit son livre en main gauche regrettera. Le miroir m'interroge : est-ce que je veux éviter ce regret ?`,
  reflection: `Recevoir le livre en main gauche est le signe de l'échec. Le regret sera immense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma man utiya kitabahu bi-shimalihi fa-yaqulu ya laytani lam uta kitabiyah » — quant à celui qui recevra son livre en sa main gauche, il dira : Que je n'aie pas reçu mon livre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux éviter ce regret ? Mon livre sera-t-il dans ma main gauche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret de la main gauche est l'opposé de la joie de la main droite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La main gauche reçoit le témoignage de l'échec." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint la main gauche œuvre pour la main droite." }
  ],
  munajat: `Ya 'Adl, je ne veux pas recevoir mon livre en main gauche. Fais que mes œuvres soient bonnes. Épargne-moi le regret du perdant.`
};

MIROIR["69:26"] = {
  reference: "69:26",
  theme: ["ignorance", "jugement", "regret"],
  emotion: "Désespoir, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Hisab", "Al-'Alim"],
  mirrorVersion: `« Et que je n'aie pas su mon jugement. » Le miroir me montre l'ignorance regrettée. « Wa lam adri ma hisabiyah » — et que je n'aie pas su mon jugement. L'ignorance du résultat serait préférable. Le miroir m'interroge : est-ce que je veux savoir mon jugement maintenant ?`,
  reflection: `L'ignorance du résultat serait un soulagement pour le perdant. Mais le jugement est certain.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lam adri ma hisabiyah » — et que je n'aie pas su mon jugement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux savoir mon jugement maintenant ? Ou est-ce que je préfère l'ignorance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance du jugement est un fardeau pour le perdant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement est la vérité que nul ne peut éviter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son jugement maintenant peut le changer." }
  ],
  munajat: `Ya 'Alim, Tu connais mon jugement. Fais que je le connaisse maintenant pour me préparer. Ne permets pas que je le découvre avec regret.`
};

MIROIR["69:27"] = {
  reference: "69:27",
  theme: ["mort", "fin", "souhait"],
  emotion: "Désespoir, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Ba'ith"],
  mirrorVersion: `« Que ma mort avait été la fin ! » Le miroir me montre le désespoir. « Ya laytaha kanati al-qadiyah » — que ma mort avait été la fin ! La résurrection est devenue un fardeau. Le miroir m'interroge : est-ce que je regrette d'être ressuscité ?`,
  reflection: `Le mécréant regrette la résurrection. La mort aurait été préférable à l'enfer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya laytaha kanati al-qadiyah » — que ma mort avait été la fin !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je regrette d'être ressuscité ? Mon jugement sera-t-il si terrible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort n'est pas la fin, mais le passage." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La résurrection est la vérité que nul ne peut éviter." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare n'a pas peur de la résurrection." }
  ],
  munajat: `Ya Mumit, la mort n'est pas la fin. Fais que je me prépare pour la résurrection. Ne permets pas que je regrette d'être ressuscité.`
};

MIROIR["69:28"] = {
  reference: "69:28",
  theme: ["richesse", "inutilité", "réalité"],
  emotion: "Regret, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Haqq"],
  mirrorVersion: `« Ma richesse ne m'a servi à rien. » Le miroir me montre l'inutilité des biens. « Ma aghna 'anni maliah » — ma richesse ne m'a servi à rien. Les biens ne sauvent pas. Le miroir m'interroge : est-ce que je compte sur ma richesse ?`,
  reflection: `La richesse ne sert à rien au jugement. Seules les œuvres comptent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma aghna 'anni maliah » — ma richesse ne m'a servi à rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur ma richesse ? Ou est-ce que je compte sur mes œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La richesse est utile ici-bas, inutile là-bas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens restent sur terre. Les œuvres suivent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur ses œuvres ne compte pas sur sa richesse." }
  ],
  munajat: `Ya Ghani, la richesse ne sert à rien au jugement. Fais que je compte sur mes œuvres. Ne permets pas que je sois trompé par les biens.`
};

MIROIR["69:29"] = {
  reference: "69:29",
  theme: ["pouvoir", "perte", "réalité"],
  emotion: "Regret, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Malik"],
  mirrorVersion: `« Mon pouvoir a péri. » Le miroir me montre la perte du pouvoir. « Halaka 'anni sultaniyah » — mon pouvoir a péri. Le pouvoir temporel disparaît. Le miroir m'interroge : sur quel pouvoir je compte ?`,
  reflection: `Le pouvoir disparaît au jugement. Seul le pouvoir d'Allah reste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Halaka 'anni sultaniyah » — mon pouvoir a péri." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quel pouvoir je compte ? Mon pouvoir est-il éternel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pouvoir temporel périt. Le pouvoir divin reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout pouvoir périt sauf le pouvoir d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur le pouvoir d'Allah ne perd rien." }
  ],
  munajat: `Ya Qadir, mon pouvoir périt. Fais que je compte sur Ton pouvoir. Ne permets pas que je sois trompé par le pouvoir temporel.`
};

MIROIR["69:30"] = {
  reference: "69:30",
  theme: ["saisissez", "enchaînez", "châtiment"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Saisissez-le, puis enchaînez-le. » Le miroir me montre l'ordre du châtiment. « Khudhuhu fa-ghulluh » — saisissez-le, puis enchaînez-le. L'ordre est exécuté immédiatement. Le miroir m'interroge : est-ce que je veux être saisi ?`,
  reflection: `L'ordre de châtiment est exécuté sans délai. Les anges exécutent la sentence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khudhuhu fa-ghulluh » — saisissez-le, puis enchaînez-le." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux être saisi ? Ou est-ce que je veux éviter ce sort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enchaînement suit la désobéissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges exécutent les ordres d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit n'est pas enchaîné." }
  ],
  munajat: `Ya Jabbar, je ne veux pas être enchaîné. Fais que j'obéisse. Préserve-moi de l'ordre de châtiment.`
};

MIROIR["11:1"] = {
  reference: "11:1",
  theme: ["révélation", "sagesse", "détail"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Alif, Lam, Ra. Un Livre dont les versets sont parfaits, puis détaillés. » Le miroir me montre la perfection du Coran. « Kitabun uhkimat ayatuhu » — un Livre dont les versets sont parfaits. La perfection est dans le détail. Le miroir m'interroge : est-ce que je lis le Coran avec attention au détail ?`,
  reflection: `Le Coran est parfait dans ses versets et détaillé dans sa sagesse. Il vient d'un Sage et Informé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alif Lam Ra kitabun uhkimat ayatuhu thumma fussilat min ladun hakimin khabir » — Alif, Lam, Ra. Un Livre dont les versets sont parfaits, puis détaillés, de la part d'un Sage, Parfaitement Informé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran avec attention au détail ? Ou est-ce que je lis superficiellement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perfection du Coran reflète la perfection d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La sagesse d'Allah se manifeste dans chaque détail." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite chaque détail trouve la profondeur." }
  ],
  munajat: `Ya Hakim, Ton Livre est parfait. Ne permets pas que je le lise superficiellement. Donne-moi l'attention au détail qui révèle la sagesse.`
};

MIROIR["11:2"] = {
  reference: "11:2",
  theme: ["adoration", "unicité", "avertissement"],
  emotion: "Sérieux, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Akhir"],
  mirrorVersion: `« N'adorez qu'Allah. Je suis pour vous un avertisseur et un annonciateur. » Le miroir me montre le message central. « An ta'budu illa Allah » — n'adorez qu'Allah. L'unicité est le cœur du message. Le miroir m'interroge : est-ce que j'adore Allah seul ?`,
  reflection: `Le message de tous les prophètes est l'unicité. Adorer Allah seul est le chemin vers le succès.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alla ta'budu illa Allaha innani lakum minhu nadhirun wa bashir » — n'adorez qu'Allah. Je suis pour vous, de Sa part, un avertisseur et un annonciateur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah seul ? Ou est-ce que j'adore d'autres choses à côté de Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration exclusive est le chemin de la liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création adore Allah par sa soumission." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore Allah seul trouve la paix." }
  ],
  munajat: `Ya Wahid, je T'adore seul. Ne permets pas que j'adore autre chose. Donne-moi l'adoration exclusive qui libère.`
};

MIROIR["11:3"] = {
  reference: "11:3",
  theme: ["repentir", "pardon", "provision"],
  emotion: "Espoir, miséricorde",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghafur"],
  mirrorVersion: `« Demandez pardon à votre Seigneur, puis repentez-vous. » Le miroir me montre le chemin du repentir. « Istaghfiru rabbakum » — demandez pardon à votre Seigneur. Le pardon ouvre la provision. Le miroir m'interroge : est-ce que je demande pardon régulièrement ?`,
  reflection: `Le repentir apporte la provision et la miséricorde. Allah est Pardonneur et Miséricordieux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ani istaghfiru rabbakum thumma tubu ilayhi yumatti'kum mata'an hasanan ila ajalin musamman » — demandez pardon à votre Seigneur, puis repentez-vous à Lui, pour qu'Il vous accorde une belle jouissance jusqu'à un terme fixé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande pardon régulièrement ? Ou est-ce que j'oublie le repentir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon ouvre les portes de la provision." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le repentir est la clé de la miséricorde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent constamment est proche d'Allah." }
  ],
  munajat: `Ya Ghafur, je demande Ton pardon. Ne permets pas que j'oublie le repentir. Donne-moi le pardon qui ouvre et le repentir qui rapproche.`
};

MIROIR["11:4"] = {
  reference: "11:4",
  theme: ["retour", "jugement", "réalité"],
  emotion: "Humilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Masir", "Al-Hashir"],
  mirrorVersion: `« C'est vers Allah qu'est votre retour. Il est Omnipotent. » Le miroir me montre le retour inévitable. « Ila Allahi marji'ukum » — c'est vers Allah qu'est votre retour. Le retour est certain. Le miroir m'interroge : est-ce que je prépare mon retour ?`,
  reflection: `Le retour vers Allah est inévitable. Il est capable de toute chose.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ila Allahi marji'ukum wa huwa 'ala kulli shay'in qadir » — c'est vers Allah qu'est votre retour. Et Il est Omnipotent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare mon retour ? Ou est-ce que j'oublie que le retour est certain ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le retour est la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout retourne vers Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare son retour le rencontre en paix." }
  ],
  munajat: `Ya Rabb, je prépare mon retour vers Toi. Ne permets pas que je l'oublie. Donne-moi la préparation qui honore et le retour qui sauve.`
};

MIROIR["11:5"] = {
  reference: "11:5",
  theme: ["cachette", "secret", "science"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khafi", "Al-Alim"],
  mirrorVersion: `« C'est ainsi qu'ils replient leurs poitrines pour se cacher de Lui. » Le miroir me montre l'impossibilité de se cacher. « Yathnuna sudurahum » — ils replient leurs poitrines. Personne ne peut se cacher d'Allah. Le miroir m'interroge : est-ce que j'essaie de me cacher d'Allah ?`,
  reflection: `Nul ne peut se cacher d'Allah. Même quand on se couvre de vêtements, Il connaît les secrets.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala innahum yathnuna sudurahum li-yastakhfu minhu ala hina yastaghshuna thiyabahum ya'lamu ma yusirruna wa ma yu'linun » — c'est ainsi qu'ils replient leurs poitrines pour se cacher de Lui. Quand ils se couvrent de leurs vêtements, Il sait ce qu'ils cachent et ce qu'ils divulguent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'essaie de me cacher d'Allah ? Ou est-ce que je sais qu'Il connaît tout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tentative de se cacher révèle l'ignorance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah connaît tout, visible et caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'Allah connaît tout vit dans la vérité." }
  ],
  munajat: `Ya Alim, Tu connais tout de moi. Ne permets pas que j'essaie de me cacher. Donne-moi la transparence qui honore et la vérité qui sauve.`
};

MIROIR["11:6"] = {
  reference: "11:6",
  theme: ["provision", "créature", "connaissance"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Muhit"],
  mirrorVersion: `« Il n'est point de bête sur terre dont Allah ne s'occupe. » Le miroir me montre la provision universelle. « Ma min dabbatin 'ala al-ardi illa 'ala Allahi rizquha » — il n'est point de bête sur terre dont Allah ne s'occupe. La provision est garantie. Le miroir m'interroge : est-ce que je fais confiance à Allah pour ma provision ?`,
  reflection: `Allah pourvoit à toutes les créatures. Il connaît leur demeure et leur dépôt.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma min dabbatin 'ala al-ardi illa 'ala Allahi rizquha wa ya'lamu mustaqarraha wa mustawda'aha kullun fi kitabin mubin » — il n'est point de bête sur terre dont Allah ne s'occupe. Il connaît son gîte et son dépôt. Tout est dans un Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Allah pour ma provision ? Ou est-ce que je m'inquiète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision est garantie par le Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature reçoit sa provision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah pour sa provision trouve la paix." }
  ],
  munajat: `Ya Razzaq, Tu pourvois à toutes mes besoins. Ne permets pas que je m'inquiète. Donne-moi la confiance qui apaise et la gratitude qui élève.`
};

MIROIR["11:7"] = {
  reference: "11:7",
  theme: ["création", "trône", "épreuve"],
  emotion: "Émerveillement, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Arsh"],
  mirrorVersion: `« C'est Lui qui a créé les cieux et la terre en six jours, alors que Son Trône était sur l'eau. » Le miroir me montre la grandeur de la création. « Khalaqa al-samawati wa al-arda fi sittati ayyam » — Il a créé les cieux et la terre en six jours. Le Trône sur l'eau montre Sa souveraineté. Le miroir m'interroge : est-ce que je contemple la grandeur de la création ?`,
  reflection: `La création en six jours montre la puissance ordonnée. L'épreuve détermine qui est le meilleur en action.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi khalaqa al-samawati wa al-arda fi sittati ayyamin wa kana 'arshuhu 'ala al-ma'i li-yabluwakum ayyukum ahsanu 'amalan » — c'est Lui qui a créé les cieux et la terre en six jours, alors que Son Trône était sur l'eau, pour vous éprouver : qui de vous est le meilleur en action." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple la grandeur de la création ? Ou est-ce que je la prends pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur de la création révèle la grandeur du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve est le but de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la création trouve le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu as créé les cieux et la terre. Ne permets pas que je l'oublie. Donne-moi la contemplation qui révèle et l'action qui honore.`
};

MIROIR["11:8"] = {
  reference: "11:8",
  theme: ["châtiment", "délai", "impatience"],
  emotion: "Avertissement, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Azab", "Al-Ajal"],
  mirrorVersion: `« Et si Nous différons pour eux le châtiment jusqu'à une période déterminée, ils diront : Qu'est-ce qui le retient ? » Le miroir me montre l'impatience des mécréants. « In nu'akhkhira 'anhumu al-'adhab » — si Nous différons pour eux le châtiment. Le délai n'est pas l'annulation. Le miroir m'interroge : est-ce que j'interprète le délai comme une absence de châtiment ?`,
  reflection: `Le délai du châtiment n'est pas son annulation. Quand il viendra, personne ne pourra le repousser.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in akhkharna 'anhumu al-'adhaba ila ummatin ma'dudatin la-yaqulunna ma yahbisuhu ala yawma ya'tihim la yasarifu 'anhum » — et si Nous différons pour eux le châtiment jusqu'à une période déterminée, ils diront : Qu'est-ce qui le retient ? Le jour où il leur viendra, rien ne le détournera d'eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'interprète le délai comme une absence de châtiment ? Ou est-ce que je sais qu'il viendra ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une miséricorde et une épreuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le châtiment différée n'est pas annulé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui saisit le délai pour se repentir est sauvé." }
  ],
  munajat: `Ya Rabb, je saisis le délai pour me repentir. Ne permets pas que je l'interprète comme une absence de châtiment. Donne-moi le repentir qui sauve et la conscience qui éveille.`
};

MIROIR["11:9"] = {
  reference: "11:9",
  theme: ["épreuve", "ingratitude", "désespoir"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Mudill", "Ar-Rahman"],
  mirrorVersion: `« Si Nous faisons goûter à l'homme une miséricorde de Notre part, puis que Nous la lui retirions, il est désespéré et ingrat. » Le miroir me montre la fragilité de l'homme. « La-in massa al-insana » — si Nous faisons goûter à l'homme. L'ingratitude suit le retrait de la miséricorde. Le miroir m'interroge : est-ce que je suis reconnaissant même quand la miséricorde se retire ?`,
  reflection: `L'homme est ingrat quand la miséricorde se retire. Le croyant reste reconnaissant dans l'épreuve.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in adhaqna al-insana minna rahmatan thumma naza'navaha minhu innahu yau'usun kafur » — si Nous faisons goûter à l'homme une miséricorde de Notre part, puis que Nous la lui retirions, il est désespéré et ingrat." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant même quand la miséricorde se retire ? Ou est-ce que je deviens ingrat ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La reconnaissance dans l'épreuve est la vraie gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La miséricorde d'Allah alterne pour éprouver." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste reconnaissant dans l'épreuve est le vrai croyant." }
  ],
  munajat: `Ya Rahman, je suis reconnaissant même quand Ta miséricorde se retire. Ne permets pas que je devienne ingrat. Donne-moi la reconnaissance constante et la patience qui élève.`
};

MIROIR["11:10"] = {
  reference: "11:10",
  theme: ["épreuve", "joie", "orgueil"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'ti", "Al-Khaliq"],
  mirrorVersion: `« Et si Nous lui faisons goûter un bonheur après un malheur, il dit : Les maux se sont éloignés de moi. » Le miroir me montre l'orgueil dans l'aisance. « La-in massahu al-khayru » — si Nous lui faisons goûter un bonheur. L'orgueil suit l'aisance. Le miroir m'interroge : est-ce que je reste humble dans l'aisance ?`,
  reflection: `L'homme s'enorgueillit dans l'aisance et oublie Allah. Le croyant reste humble dans le bonheur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la-in adhaqnahu na'ma'a ba'da darra'a massat-hu la-yaqulanna dhahaba al-sayyi'atu 'anni innahu la-farihun fakhur » — et si Nous lui faisons goûter un bonheur après un malheur qui l'a touché, il dit : Les maux se sont éloignés de moi. Et il est exultant et orgueilleux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reste humble dans l'aisance ? Ou est-ce que je deviens orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans l'aisance est la vraie noblesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alternance des états éprouve le croyant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste humble dans l'aisance est préservé." }
  ],
  munajat: `Ya Rabb, je reste humble dans l'aisance. Ne permets pas que je devienne orgueilleux. Donne-moi l'humilité qui préserve et la gratitude qui élève.`
};

MIROIR["11:11"] = {
  reference: "11:11",
  theme: ["patience", "œuvre", "réussite"],
  emotion: "Espoir, persévérance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Muflah"],
  mirrorVersion: `« Sauf ceux qui endurent avec patience et accomplissent les bonnes œuvres. » Le miroir me montre l'exception bénie. « Illa alladhina sabaru » — sauf ceux qui endurent avec patience. La patience et les bonnes œuvres ouvrent la réussite. Le miroir m'interroge : est-ce que je suis parmi les patients ?`,
  reflection: `Les patients qui font de bonnes œuvres obtiennent le pardon et une grande récompense.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina sabaru wa 'amilu al-salihati ula'ika lahum maghfiratun wa ajrun kabir » — sauf ceux qui endurent avec patience et accomplissent les bonnes œuvres. Ceux-là obtiennent pardon et une immense récompense." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis parmi les patients ? Ma patience est-elle suivie de bonnes œuvres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience avec les bonnes œuvres est le chemin de la réussite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La récompense des patients est immense." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui endure avec patience et agit bien réussit." }
  ],
  munajat: `Ya Rabb, je veux être parmi les patients. Ne permets pas que je sois ingrat. Donne-moi la patience qui élève et les bonnes œuvres qui sauvent.`
};

MIROIR["69:31"] = {
  reference: "69:31",
  theme: ["brûlement", "fournaise", "châtiment"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jabbar", "Al-Muntaqim"],
  mirrorVersion: `« Puis brûlez-le dans la Fournaise. » Le miroir me montre l'ordre du brûlement. « Thumma fi al-jahimi saluh » — puis brûlez-le dans la Fournaise. L'enfer est la destination finale. Le miroir m'interroge : est-ce que je crains la Fournaise ?`,
  reflection: `La Fournaise est le châtiment éternel pour les mécréants. Le brûlement est éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Thumma fi al-jahimi saluh » — puis brûlez-le dans la Fournaise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains la Fournaise ? Mon sort sera-t-il le brûlement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le brûlement suit la mécréance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Fournaise est préparée pour les mécréants." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit n'entre pas dans la Fournaise." }
  ],
  munajat: `Ya Rabb, je ne veux pas être brûlé. Fais que je croie. Préserve-moi de la Fournaise éternelle.`
};

MIROIR["69:33"] = {
  reference: "69:33",
  theme: ["mécréance", "grandeur", "cause"],
  emotion: "Lucidité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Kabir", "Al-Haqq"],
  mirrorVersion: `« Il ne croyait pas en Allah, le Très Grand. » Le miroir me montre la cause du châtiment. « Innahu kana la yu'minu bi-Allahi al-'Azim » — il ne croyait pas en Allah, le Très Grand. La mécréance est la cause. Le miroir m'interroge : est-ce que je crois vraiment ?`,
  reflection: `La mécréance en Allah le Très Grand est la cause du châtiment éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu kana la yu'minu bi-Allahi al-'Azim » — il ne croyait pas en Allah, le Très Grand." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment ? Ma foi est-elle sincère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi en Allah le Très Grand sauve du châtiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah le Très Grand est le centre de la foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment est sauvé." }
  ],
  munajat: `Ya 'Azim, je crois en Toi. Fais que ma foi soit sincère. Ne permets pas que je sois parmi les mécréants.`
};

MIROIR["69:34"] = {
  reference: "69:34",
  theme: ["pauvre", "nourriture", "négligence"],
  emotion: "Tristesse, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Il n'incitait pas à nourrir le pauvre. » Le miroir me montre l'égoïsme. « Wa la yahuddu 'ala ta'ami al-miskin » — il n'incitait pas à nourrir le pauvre. L'égoïsme est condamné. Le miroir m'interroge : est-ce que je nourris le pauvre ?`,
  reflection: `Nourrir le pauvre est un devoir. L'égoïsme est un péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la yahuddu 'ala ta'ami al-miskin » — il n'incitait pas à nourrir le pauvre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je nourris le pauvre ? Ou est-ce que je suis égoïste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La générosité envers le pauvre est la voie du salut." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le pauvre a des droits sur le riche." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui nourrit le pauvre est nourri par Allah." }
  ],
  munajat: `Ya Razzaq, je veux nourrir le pauvre. Fais que je sois généreux. Ne permets pas que je sois égoïste.`
};

MIROIR["69:35"] = {
  reference: "69:35",
  theme: ["argument", "amis", "châtiment"],
  emotion: "Solitude, regret",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Al-Haqq"],
  mirrorVersion: `« Il n'a ici aujourd'hui aucun ami chaleureux. » Le miroir me montre la solitude. « Fa-laysa lahu al-yawma hahuna hamim » — il n'a ici aujourd'hui aucun ami chaleureux. Les amis du monde ont disparu. Le miroir m'interroge : qui sera mon ami ce Jour-là ?`,
  reflection: `Les amis du monde disparaissent au Jour du jugement. Seul Allah reste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-laysa lahu al-yawma hahuna hamim » — il n'a ici aujourd'hui aucun ami chaleureux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sera mon ami ce Jour-là ? Ai-je des amis sincères ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les amis du monde sont temporaires. Allah est éternel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'amitié véritable est celle avec Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a Allah pour ami n'est jamais seul." }
  ],
  munajat: `Ya Wali, sois mon ami ce Jour-là. Fais que je ne sois pas seul. Donne-moi Ton amitié éternelle.`
};

MIROIR["69:36"] = {
  reference: "69:36",
  theme: ["nourriture", "enfer", "pus"],
  emotion: "Dégoût, terreur",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Jabbar"],
  mirrorVersion: `« Ni nourriture, sauf un pus. » Le miroir me montre la nourriture de l'enfer. « Wa la ta'amun illa min ghislin » — ni nourriture, sauf un pus. La nourriture de l'enfer est répugnante. Le miroir m'interroge : est-ce que je veux manger du pus ?`,
  reflection: `La nourriture de l'enfer est répugnante. Le pus est la seule option.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la ta'amun illa min ghislin » — ni nourriture, sauf un pus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je veux manger du pus ? Mon sort sera-t-il l'enfer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pus de l'enfer est l'opposé des délices du paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nourriture reflète le destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'enfer évite le pus." }
  ],
  munajat: `Ya Rabb, je ne veux pas manger du pus. Préserve-moi de l'enfer. Donne-moi les délices du paradis.`
};

MIROIR["69:37"] = {
  reference: "69:37",
  theme: ["pécheurs", "nourriture", "répugnance"],
  emotion: "Dégoût, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Que seuls les pécheurs mangent. » Le miroir me montre les mangeurs. « La ya'kuluha illa al-khati'un » — que seuls les pécheurs mangent. Seuls les pécheurs en mangent. Le miroir m'interroge : suis-je un pécheur qui mangera cela ?`,
  reflection: `Le pus est réservé aux pécheurs. Les innocents ne le mangent pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ya'kuluha illa al-khati'un » — que seuls les pécheurs mangent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un pécheur qui mangera cela ? Ou suis-je innocent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les pécheurs mangent le pus. Les innocents mangent les délices." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nourriture est le témoignage du destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent n'est plus un pécheur." }
  ],
  munajat: `Ya Ghaffar, je me repens de mes péchés. Ne permets pas que je sois parmi les pécheurs. Préserve-moi de la nourriture de l'enfer.`
};

MIROIR["69:38"] = {
  reference: "69:38",
  theme: ["serment", "vision", "témoignage"],
  emotion: "Solennité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Shahid", "Al-Haqq"],
  mirrorVersion: `« Non ! Je jure par ce que vous voyez. » Le miroir me montre un autre serment. « Fa-la uqsimu bima tubsirun » — Je jure par ce que vous voyez. Le visible témoigne. Le miroir m'interroge : est-ce que je vois les signes ?`,
  reflection: `Le visible témoigne de la vérité d'Allah. Les signes sont partout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-la uqsimu bima tubsirun » — Non ! Je jure par ce que vous voyez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les signes ? Ou est-ce que je suis aveugle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le visible est un témoignage pour ceux qui voient." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers témoigne d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit les signes voit Allah." }
  ],
  munajat: `Ya Shahid, le visible témoigne de Toi. Fais que je voie les signes. Ouvre mes yeux à Ta présence.`
};

MIROIR["69:39"] = {
  reference: "69:39",
  theme: ["serment", "invisible", "témoignage"],
  emotion: "Solennité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghayb", "Al-'Alim"],
  mirrorVersion: `« Et par ce que vous ne voyez pas. » Le miroir me montre le serment sur l'invisible. « Wa ma la tubsirun » — et par ce que vous ne voyez pas. L'invisible témoigne aussi. Le miroir m'interroge : est-ce que je crois en l'invisible ?`,
  reflection: `L'invisible témoigne aussi de la vérité. La foi inclut ce qu'on ne voit pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma la tubsirun » — et par ce que vous ne voyez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois en l'invisible ? Ou est-ce que je ne crois que ce que je vois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invisible est plus vaste que le visible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invisible contient les anges, le paradis, l'enfer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit en l'invisible a la foi complète." }
  ],
  munajat: `Ya 'Alim, Tu connais l'invisible. Fais que je croie en l'invisible. Donne-moi la foi qui voit au-delà du visible.`
};

MIROIR["69:40"] = {
  reference: "69:40",
  theme: ["coran", "messager", "vérité"],
  emotion: "Certitude, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Rasul", "Al-Haqq"],
  mirrorVersion: `« C'est la parole d'un noble messager. » Le miroir me montre l'origine du Coran. « Innahu la-qawlu rasulin karim » — c'est la parole d'un noble messager. Le Coran vient d'un messager noble. Le miroir m'interroge : est-ce que je respecte cette noble parole ?`,
  reflection: `Le Coran est la parole d'un messager noble. Il mérite le plus grand respect.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innahu la-qawlu rasulin karim » — c'est la parole d'un noble messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte cette noble parole ? Ou est-ce que je la néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La noblesse du messager rejaillit sur le message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran est le message le plus noble de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le messager respecte le message." }
  ],
  munajat: `Ya Rabb, le Coran est la parole d'un noble messager. Fais que je le respecte. Donne-moi la révérence pour Ta parole.`
};

MIROIR["69:41"] = {
  reference: "69:41",
  theme: ["poète", "parole", "réalité"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Hakim"],
  mirrorVersion: `« Ce n'est point la parole d'un poète. » Le miroir me montre la distinction. « Wa ma huwa bi-qawli sha'ir » — ce n'est point la parole d'un poète. Le Coran n'est pas de la poésie humaine. Le miroir m'interroge : est-ce que je distingue la parole divine de la parole humaine ?`,
  reflection: `Le Coran n'est pas une poésie humaine. Il est la parole d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma huwa bi-qawli sha'ir » — ce n'est point la parole d'un poète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je distingue la parole divine de la parole humaine ? Reconnaîs-je la source du Coran ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La poésie humaine est limitée. La parole divine est infinie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Coran dépasse toute création littéraire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la source du Coran est guidé." }
  ],
  munajat: `Ya Haqq, le Coran n'est pas une poésie humaine. Fais que je reconnaisse Ta parole. Donne-moi la distinction entre le divin et l'humain.`
};

MIROIR["69:42"] = {
  reference: "69:42",
  theme: ["devin", "parole", "réalité"],
  emotion: "Clarté, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Alim"],
  mirrorVersion: `« Ni la parole d'un devin. » Le miroir me montre une autre distinction. « Wa la bi-qawli kahin » — ni la parole d'un devin. Le Coran n'est pas de la divination. Le miroir m'interroge : est-ce que je vois le Coran comme une révélation ?`,
  reflection: `Le Coran n'est pas une divination. Il est une révélation claire.`,
