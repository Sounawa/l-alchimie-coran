    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne par amour reçoit l'amour." }
  ],
  munajat: `Ya Rabb, je donne par amour pour Toi. Accepte ma charité.`
};

MIROIR["76:10"] = {
  reference: "76:10",
  theme: ["crainte", "jour", "charité"],
  emotion: "Crainte, générosité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khashyah", "Al-Wa'id"],
  mirrorVersion: `« Nous vous nourrissons pour la face d'Allah, sans vouloir de vous ni récompense ni gratitude. » La charité désintéressée. Le miroir m'enseigne : la vraie charité ne cherche rien en retour.`,
  reflection: `La vraie charité ne cherche rien en retour.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama nut'imukum li-wajhi Allahi la nuridu minkum jaza'an wa la shukura » — nous vous nourrissons pour la face d'Allah, sans vouloir de vous ni récompense ni gratitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma charité est désintéressée ? Ou est-ce que j'attends quelque chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La charité désintéressée est la plus pure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La charité pure est la charité divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne sans attente reçoit tout." }
  ],
  munajat: `Ya Rabb, je donne sans attente. Accepte ma charité désintéressée.`
};

