  theme: ["création", "difficulté", "ciel"],
  emotion: "Méditation, grandeur",
  difficulty: "débutant",
  relatedNames: ["Al-Khalq", "As-Sama'"],
  mirrorVersion: `« Êtes-vous plus difficiles à créer que le ciel ? » Le miroir me montre la grandeur de la création. Le ciel est plus grand que l'homme. La création du ciel est plus impressionnante. Le miroir m'enseigne : la résurrection est facile pour le Créateur du ciel.`,
  reflection: `Le ciel est plus difficile à créer. La résurrection de l'homme est facile pour Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-antum ashaddu khalqan ami al-sama' » — êtes-vous plus difficiles à créer que le ciel ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La création du ciel est plus impressionnante. Comment puis-je douter de la résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grandeur de la création garantit la facilité de la résurrection." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel est la preuve de la puissance du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple le ciel ne doute pas de la résurrection." }
  ],
  munajat: `Ya Rabb, je contemple le ciel et je ne doute pas. Ta puissance est évidente. Fais que je sois ressuscité facilement.`
};

MIROIR["79:28"] = {
  reference: "79:28",
  theme: ["ciel", "élévation", "perfection"],
  emotion: "Méditation, ordre",
  difficulty: "débutant",
  relatedNames: ["As-Sama'", "Ar-Raf'"],
  mirrorVersion: `« Il l'a élevé et l'a perfectionné. » Le miroir me montre la construction divine. Le ciel est élevé et parfait. L'ordre est parfait. Le miroir m'enseigne : la création divine est ordonnée et parfaite.`,
  reflection: `Le ciel est élevé et parfait. La création divine est ordonnée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rafa'aha fa-sawwaha » — Il l'a élevé et l'a perfectionné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La perfection du ciel. Comment est ma vie ? Ordre ou chaos ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'élévation et la perfection sont les attributs de la création divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est parfait dans son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ordonne sa vie selon Allah participe à la perfection." }
  ],
  munajat: `Ya Rabb, Ton ciel est parfait. Ordonne ma vie selon Ta perfection. Fais que je participe à l'ordre divin.`
};

MIROIR["79:29"] = {
  reference: "79:29",
  theme: ["nuit", "jour", "révélation"],
  emotion: "Méditation, alternance",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "An-Nahar"],
  mirrorVersion: `« Il a obscurci sa nuit et fait sortir son jour. » Le miroir me montre l'alternance divine. La nuit est obscure, le jour est clair. L'alternance est un signe. Le miroir m'enseigne : l'alternance est une miséricorde.`,
  reflection: `La nuit et le jour alternent. Le signe est évident.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aghtasha laylaha wa akhraja duhaha » — Il a obscurci sa nuit et fait sortir son jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La nuit et le jour alternent dans ma vie. Comment je le vis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alternance est nécessaire pour la croissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'alternance du jour et de la nuit est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte l'alternance grandit." }
  ],
  munajat: `Ya Rabb, j'accepte l'alternance de ma vie. Donne-moi la patience dans la nuit et la gratitude dans le jour.`
};

MIROIR["79:30"] = {
  reference: "79:30",
  theme: ["terre", "extension", "création"],
  emotion: "Méditation, provision",
  difficulty: "débutant",
  relatedNames: ["Al-Ard", "Al-Madd"],
  mirrorVersion: `« Et la terre, Il l'a étendue. » Le miroir me montre l'extension divine. La terre est étendue pour nous. L'espace est créé. Le miroir m'enseigne : la terre est préparée pour notre vie.`,
  reflection: `La terre est étendue. L'espace est préparé pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-arda ba'da dhalika dahaha » — et la terre, Il l'a étendue." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La terre est étendue pour moi. Comment je l'utilise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'extension de la terre est une provision divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est étendue pour toute l'humanité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la provision de la terre est reconnaissant." }
  ],
  munajat: `Ya Rabb, merci pour la terre étendue. Fais que je l'utilise selon Ta volonté. Donne-moi la gratitude pour Ta provision.`
};

MIROIR["79:31"] = {
  reference: "79:31",
  theme: ["eau", "pâturage", "provision"],
  emotion: "Gratitude, provision",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'", "Al-Mar'a"],
  mirrorVersion: `« Il en a fait sortir son eau et son pâturage. » Le miroir me montre la provision de la terre. L'eau et le pâturage sortent de la terre. La provision est abondante. Le miroir m'enseigne : la terre produit par l'ordre d'Allah.`,
  reflection: `L'eau et le pâturage sortent de la terre. La provision est divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aakhraja minha ma'aha wa mar'aha » — Il en a fait sortir son eau et son pâturage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'eau et le pâturage sont mes provisions. Suis-je reconnaissant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision vient d'Allah à travers la terre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision de la terre est universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour la provision reçoit plus." }
  ],
  munajat: `Ya Rabb, merci pour l'eau et le pâturage. Donne-moi la gratitude pour Ta provision. Multiplie Tes faveurs sur moi.`
};

MIROIR["79:32"] = {
  reference: "79:32",
  theme: ["montagnes", "stabilité", "ancrage"],
  emotion: "Méditation, solidité",
  difficulty: "débutant",
  relatedNames: ["Al-Jibal", "Al-Rasakh"],
  mirrorVersion: `« Et les montagnes, Il les a fixées. » Le miroir me montre la stabilisation divine. Les montagnes sont fixées pour la stabilité de la terre. L'ancrage est nécessaire. Le miroir m'enseigne : la stabilité est un don d'Allah.`,
  reflection: `Les montagnes sont fixées. La stabilité est divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-jibala arsaha » — et les montagnes, Il les a fixées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Les montagnes sont fixes. Comment est ma stabilité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi est la montagne qui fixe le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les montagnes stabilisent la terre entière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi est fixé comme les montagnes." }
  ],
  munajat: `Ya Rabb, fixe mon cœur comme les montagnes. Donne-moi la stabilité de la foi. Ne permets pas que je chancelle.`
};

MIROIR["79:33"] = {
  reference: "79:33",
  theme: ["provision", "bétail", "vie"],
  emotion: "Gratitude, bénédictions",
  difficulty: "débutant",
  relatedNames: ["Al-Mata'", "Al-An'am"],
  mirrorVersion: `« Pour que vous en profitiez, vous et vos troupeaux. » Le miroir me montre le but de la provision. Tout est créé pour notre bénéfice. Les troupeaux et nous. Le miroir m'enseigne : la provision est un don à utiliser avec gratitude.`,
  reflection: `La provision est pour nous et nos troupeaux. Le bénéfice est divin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Matalan lakum wa li-an'amikum » — pour que vous en profitiez, vous et vos troupeaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La provision est pour moi. Comment je l'utilise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'utilisation avec gratitude est la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision est universelle pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise avec gratitude reçoit plus." }
  ],
  munajat: `Ya Rabb, merci pour la provision. Fais que je l'utilise avec gratitude. Multiplie Tes bénédictions sur moi.`
};

MIROIR["79:34"] = {
  reference: "79:34",
  theme: ["calamité", "arrivée", "jour"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ghashiyah", "Al-Azifah"],
  mirrorVersion: `« Puis, quand viendra la grande calamité. » Le miroir me montre l'imminence de la fin. La grande calamité arrive. Le moment est certain. Le miroir m'avertit : la fin est proche.`,
  reflection: `La grande calamité viendra. La fin est certaine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-idha ja'ati al-ghashiyah » — puis, quand viendra la grande calamité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La calamité viendra. Suis-je prêt ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour la calamité est la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La calamité concernera tout l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est préparé par la foi affronte la calamité." }
  ],
  munajat: `Ya Rabb, la calamité viendra. Prépare-moi par la foi. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["79:35"] = {
  reference: "79:35",
  theme: ["souvenir", "effort", "jour"],
  emotion: "Rappel, réalité",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikra", "An-Nus"],
  mirrorVersion: `« Le jour où l'homme se souviendra de ce qu'il a fait. » Le miroir me montre le rappel total. L'homme se souvient de tout. Les efforts sont rappelés. Le miroir m'avertit : tout sera rappelé.`,
  reflection: `L'homme se souviendra de tout. Les efforts seront rappelés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma yatadhakkaru al-insanu ma sa'na » — le jour où l'homme se souviendra de ce qu'il a fait." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quoi me souviendrai-je ? Quels sont mes efforts ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Les bons efforts font de bons souvenirs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le rappel est universel pour tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait de bons efforts a de bons souvenirs." }
  ],
  munajat: `Ya Rabb, fais que mes efforts soient bons. Donne-moi de bons souvenirs ce jour-là. Ne permets pas que je regrette.`
};

MIROIR["79:36"] = {
  reference: "79:36",
  theme: ["enfer", "révélation", "vision"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Izhar"],
  mirrorVersion: `« L'Enfer sera dévoilé pour qui veut voir. » Le miroir me montre la vision de l'Enfer. L'Enfer est révélé. La vision est possible pour tous. Le miroir m'avertit : l'Enfer est une réalité visible.`,
  reflection: `L'Enfer sera dévoilé. La vision est pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa burrizati al-jahimu li-man yara » — l'Enfer sera dévoilé pour qui veut voir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "L'Enfer sera visible. Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite la vision de l'Enfer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'Enfer est une réalité universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi n'entrera pas en Enfer." }
  ],
  munajat: `Ya Rabb, je veux éviter l'Enfer. Donne-moi la foi qui sauve. Ne permets pas que je voie l'Enfer de l'intérieur.`
};

MIROIR["79:37"] = {
  reference: "79:37",
  theme: ["transgression", "préférence", "vie"],
  emotion: "Avertissement, réalité",
  difficulty: "débutant",
  relatedNames: ["At-Tagha", "Al-Hayat"],
  mirrorVersion: `« Quant à celui qui a transgressé. » Le miroir me montre le cas du transgresseur. Celui qui a préféré cette vie. La transgression est un choix. Le miroir m'avertit : choisir cette vie au lieu de l'au-delà est une perte.`,
  reflection: `Le transgresseur a préféré cette vie. Le choix est déterminant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-amma man tagha » — quant à celui qui a transgressé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je transgresse ? Ou est-ce que je préfère l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence de l'au-delà évite la transgression." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La transgression est le choix de cette vie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préfère l'au-delà évite la transgression." }
  ],
  munajat: `Ya Rabb, je préfère l'au-delà. Ne permets pas que je transgresse. Donne-moi la préférence de l'éternité.`
};

MIROIR["79:38"] = {
  reference: "79:38",
  theme: ["vie", "préférence", "au-delà"],
  emotion: "Avertissement, choix",
  difficulty: "débutant",
  relatedNames: ["Al-Hayat", "Ad-Dunya"],
  mirrorVersion: `« Et a préféré la vie présente. » Le miroir me montre le choix fatal. Préférer cette vie à l'au-delà. Le choix est clair. Le miroir m'avertit : le mauvais choix a des conséquences.`,
  reflection: `Préférer cette vie est le mauvais choix. L'au-delà est meilleur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa athara al-hayata al-dunya » — et a préféré la vie présente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je préfère ? Cette vie ou l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préférence de l'au-delà est le bon choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Cette vie est temporaire, l'au-delà est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préfère l'au-delà gagne l'éternité." }
  ],
  munajat: `Ya Rabb, je préfère l'au-delà. Ne permets pas que je préfère cette vie. Donne-moi la vision de l'éternité.`
};

MIROIR["79:39"] = {
  reference: "79:39",
  theme: ["enfer", "destination", "transgresseur"],
  emotion: "Terreur, conséquence",
  difficulty: "débutant",
  relatedNames: ["Al-Jahim", "Al-Ma'wa"],
  mirrorVersion: `« L'Enfer sera son refuge. » Le miroir me montre la destination finale du transgresseur. L'Enfer l'attend. Le refuge est terrible. Le miroir m'avertit : la transgression mène à l'Enfer.`,
  reflection: `L'Enfer est le refuge du transgresseur. La conséquence est terrible.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-inna al-jahima hiya al-ma'wa » — l'Enfer sera son refuge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel sera mon refuge ? L'Enfer ou le Paradis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi change le refuge de l'Enfer au Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le refuge est déterminé par les choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi a le Paradis comme refuge." }
  ],
  munajat: `Ya Rabb, je veux le Paradis comme refuge. Ne permets pas que mon refuge soit l'Enfer. Donne-moi la foi qui sauve.`
};

// ==================== SURAH 80: ABASA (42 verses) ====================

MIROIR["80:1"] = {
  reference: "80:1",
  theme: ["aveugle", "prophète", "correction"],
  emotion: "Correction, humilité",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Hadi"],
  mirrorVersion: `« Il s'est renfrogné et il a tourné le dos, parce que l'aveugle est venu à lui. » Le miroir me montre la correction divine du Prophète. Il s'est occupé d'un riche au lieu de l'aveugle qui cherchait la guidance. Allah corrige immédiatement. Le miroir m'interroge : est-ce que je privilégie les apparences sur la sincérité ?`,
  reflection: `La correction du Prophète montre que personne n'est au-dessus de la guidance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Abasa wa tawalla » — il s'est renfrogné et a tourné le dos." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je privilégie les apparences ? Ou est-ce que je vois la sincérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'aveugle voyait avec son cœur. Le riche était aveugle avec ses yeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La valeur d'une personne n'est pas dans ses apparences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la sincérité voit avec les yeux d'Allah." }
  ],
  munajat: `Ya Rabb, ne permets pas que je juge par les apparences. Donne-moi la vision du cœur. Fais que je voie la sincérité.`
};

// ==================== SURAH 81: AT-TAKWIR (29 verses) ====================

MIROIR["81:1"] = {
  theme: ["soleil", "fin", "châtiment"],
  emotion: "Terreur, fin",
  difficulty: "débutant",
  relatedNames: ["Al-Khafid", "Al-Qari'a"],
  reference: "81:1",
  mirrorVersion: `« Quand le soleil sera enveloppé. » Le miroir me montre la fin du monde. Le soleil, cette source de lumière, sera enveloppé de ténèbres. Les signes cosmiques de la fin. Le miroir m'interroge : est-ce que je prépare cette fin ?`,
  reflection: `Le soleil sera enveloppé. La lumière disparaîtra. La fin approche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha al-shamsu kuwwirat » — quand le soleil sera enveloppé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prépare la fin ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'enveloppement du soleil signifie que la lumière de ce monde s'éteint." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil est une création. Il finira comme tout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la lumière d'Allah n'a pas peur des ténèbres." }
  ],
  munajat: `Ya Rabb, la fin approche. Prépare-moi. Donne-moi Ta lumière pour ne pas craindre les ténèbres.`
};

// ==================== SURAH 82: AL-INFITAR (19 verses) ====================

MIROIR["82:1"] = {
  reference: "82:1",
  theme: ["ciel", "fissure", "fin"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Fatir", "Al-Qari'a"],
  mirrorVersion: `« Quand le ciel se fendra. » Le miroir me montre un autre signe de la fin. Le ciel, ce dôme protecteur, sera fendu. La protection s'effondre. Le miroir m'interroge : est-ce que je compte sur la protection d'Allah avant que tout s'effondre ?`,
  reflection: `Le ciel sera fendu. Les protections s'effondreront. Seule la protection d'Allah restera.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha al-sama'u infatarat » — quand le ciel se fendra." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je compte sur la protection d'Allah ? Ou est-ce que je compte sur ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fissure du ciel révèle ce qui était caché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel protège maintenant. Il sera ouvert alors." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est protégé par Allah ne craint pas l'effondrement." }
  ],
  munajat: `Ya Rabb, protège-moi. Quand tout s'effondrera, Tu seras ma protection. Ne permets pas que je compte sur ce monde.`
};

// ==================== SURAH 83: AL-MUTAFFIFIN (36 verses) ====================

MIROIR["83:2"] = {
  reference: "83:2",
  theme: ["fraude", "mesure", "justice"],
  emotion: "Mise en garde, justice",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Hasib"],
  mirrorVersion: `« Ceux qui, quand ils font mesurer pour eux, exigent la mesure pleine. » Le miroir me montre l'injustice dans les transactions. Frauder dans la mesure — exiger plein quand on reçoit, donner court quand on donne. Le miroir m'interroge : est-ce que je suis juste dans mes transactions ?`,
  reflection: `La fraude dans la mesure est un péché grave. La justice est obligatoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina idha iktalu 'ala al-nasi yastawfun » — ceux qui exigent la mesure pleine." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis juste dans mes transactions ? Ou est-ce que je fraude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui fraude dans la mesure se fraude lui-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La balance juste est le fondement du commerce. La fraude détruit la confiance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste dans la mesure reçoit la bénédiction." }
  ],
  munajat: `Ya 'Adl, Tu es le Juste. Fais que je sois juste dans mes transactions. Ne permets pas que je fraude.`
};

// ==================== SURAH 84: AL-INSHIQAQ (25 verses) ====================

MIROIR["84:1"] = {
  reference: "84:1",
  theme: ["ciel", "déchirement", "fin"],
  emotion: "Terreur, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'a", "Al-Ba'ith"],
  mirrorVersion: `« Quand le ciel se déchirera. » Le miroir me montre un autre signe de la fin. Le déchirement du ciel — plus violent que la fissure. La révélation totale. Le miroir m'interroge : est-ce que je suis prêt pour la révélation de tout ?`,
  reflection: `Le ciel se déchirera. Tout sera révélé. Rien ne sera caché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha al-sama'u inshaqqat » — quand le ciel se déchirera." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour la révélation ? Qu'est-ce qui sera révélé de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le déchirement révèle ce qui était caché derrière le ciel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel cache ce qui est au-delà. Son déchirement révèle l'invisible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui n'a rien à cacher n'a pas peur de la révélation." }
  ],
  munajat: `Ya Rabb, le ciel se déchirera et tout sera révélé. Purifie-moi de ce qui devrait être caché. Fais que je n'aie rien à cacher.`
};

// ==================== SURAH 8: AL-ANFAL (75 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["8:1"] = {
  reference: "8:1",
  theme: ["butin", "foi", "obéissance"],
  emotion: "Questionnement, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-Fattah"],
  mirrorVersion: `« Ils t'interrogent au sujet du butin. Dis : 'Le butin appartient à Allah et au Messager.' » Le miroir me place au cœur d'une question humaine : à qui appartient le gain ? Après Badr, les croyants se disputaient les spoils de guerre. Allah répond non par une règle de partage, mais par un rappel : tout appartient à Allah. Le butin n'est pas une propriété à revendiquer — c'est une trust divine. Le miroir m'interroge : comment est-ce que je gère ce que je « possède » ? Est-ce que je vois mes biens comme une trust d'Allah ?`,
  reflection: `La question du butin révèle une tendance humaine : revendiquer ce qui vient de la victoire divine. Allah replace la propriété dans Sa souveraineté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'alunaka 'ani al-anfal » — ils t'interrogent sur le butin. Une question pratique reçoit une réponse spirituelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme « mien » ? Mon argent, mon temps, mes talents ? Le miroir me montre que tout est prêté." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Si le butin appartient à Allah, alors moi aussi je Lui appartient. Je ne suis pas propriétaire — je suis gérant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création est butin divin. Allah a créé et tout Lui appartient. L'homme est le seul à prétendre posséder." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand on réalise que tout appartient à Allah, le attachement disparaît. On donne facilement, on partage naturellement." }
  ],
  munajat: `Ya Malik, tout T'appartient et je ne suis qu'un gérant. Apprends-moi à voir mes biens comme une trust, pas une propriété. Fais que je sois un bon gérant.`
};

MIROIR["8:2"] = {
  reference: "8:2",
  theme: ["foi", "cœur", "révélation"],
  emotion: "Révérence, éveil",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Ar-Rahman"],
  mirrorVersion: `« Seuls sont croyants ceux dont les cœurs frémissent quand on évoque Allah, et quand on leur récite Ses signes, cela augmente leur foi. » Le miroir me pose une question directe : mon cœur frémit-il ? L'évocation d'Allah devrait produire un mouvement intérieur — pas une émotion fabriquée, mais une réponse naturelle du cœur qui reconnaît son Seigneur. Et les signes d'Allah, augmentent-ils ma foi ? Ou est-ce que je les lis comme des textes ordinaires ? Le miroir m'interroge sur la qualité de ma foi, pas sa quantité.`,
  reflection: `La foi n'est pas statique — elle augmente avec la récitation des signes divins. Un cœur vivant frémit, un cœur endurci reste froid.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama al-mu'minuna alladhina idha dhukira Allahu wajilat qulubuhum » — les croyants sont ceux dont les cœurs frémissent à l'évocation d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entends le Coran, que se passe-t-il en moi ? Un frémissement ? Une habitude ? Le miroir mesure l'état de mon cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "C'est aussi Allah qui évoque le cœur — le dhikr est une rencontre, pas une performance. L'évocation vient de Lui avant de venir de moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création frémit à l'évocation de son Créateur. La montagne tremble, la mer s'agite. Seul l'homme peut choisir de rester froid." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le frémissement du cœur est la preuve de sa vie spirituelle. Un cœur qui ne frémit plus est un cœur qui s'est endurci." }
  ],
  munajat: `Ya Allah, fais que mon cœur frémisse à Ton évocation. Ne permets pas qu'il s'endurcisse. Réveille-le par Tes signes.`
};

MIROIR["8:3"] = {
  reference: "8:3",
  theme: ["prière", "dépense", "confiance"],
  emotion: "Engagement, détermination",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Ceux qui accomplissent la prière et dépensent de ce que Nous leur avons donné. » Après le frémissement du cœur vient l'action des membres. La foi commence à l'intérieur mais se manifeste à l'extérieur. La prière est le pilier vertical, la dépense est le pilier horizontal. Les deux ensemble forment une croix spirituelle. Le miroir me montre que ma foi doit sortir du domaine privé — elle doit devenir prière régulière et générosité concrète.`,
  reflection: `La prière et la dépense sont les deux marqueurs visibles de la foi intérieure. Un cœur croyant produit des actions croyantes.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yuqimuna al-salata wa mimma razaqnahum yunfiqun » — ils établissent la prière et dépensent de ce que Nous leur avons donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi se voit dans ma prière et ma générosité ? Le miroir vérifie l'alignement entre mon intérieur et mon extérieur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dépense vient de « ce que Nous leur avons donné » — tout est don. Je ne donne pas de mon bien, je redonne de Son bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier « prie » et « dépense ». La pluie est une prière qui répond à la terre. Le soleil dépense sa lumière." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand la prière et la dépense deviennent naturelles, la foi n'est plus un effort — elle est une respiration." }
  ],
  munajat: `Ya Rabb, ma foi doit se manifester. Aide-moi à établir ma prière et à donner de ce que Tu m'as donné. Fais que ma foi soit visible.`
};

MIROIR["8:4"] = {
  reference: "8:4",
  theme: ["foi", "vrai", "récompense"],
  emotion: "Espérance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Ghaffur"],
  mirrorVersion: `« Ceux-là sont les vrais croyants. Ils auront des degrés auprès de leur Seigneur, un pardon et une généreuse provision. » Le miroir me montre la distinction entre dire « je crois » et être « un vrai croyant ». Les vrais croyants ne sont pas définis par leurs paroles mais par leurs caractéristiques : cœurs frémissants, prière établie, générosité active. La récompense est triple : des degrés (élévation), un pardon (purification), une généreuse provision (satisfaction).`,
  reflection: `Le terme « ula'ika hum al-mu'minuna haqqan » — ceux-là sont les vrais croyants — implique qu'il existe des croyants « de nom ». La vraie foi se prouve par les fruits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika hum al-mu'minuna haqqan » — ceux-là sont les vrais croyants. L'insistance sur « haqqan » (vraiment) est significative." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un croyant de nom ou un croyant vrai ? Le miroir me montre la différence dans ma vie quotidienne." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les degrés ne sont pas gagnés par perfection — ils sont donnés par miséricorde. Le pardon précède l'élévation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute création occupe un degré. L'ange est au-dessus de l'homme, l'homme au-dessus de l'animal. Les croyants s'élèvent encore plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La généreuse provision (rizq karim) inclut le contentement. Le vrai croyant est riche par le cœur, pas par les biens." }
  ],
  munajat: `Ya Allah, je veux être un vrai croyant, pas un croyant de nom. Donne-moi les caractéristiques des vrais croyants et élève-moi vers Toi.`
};

MIROIR["8:5"] = {
  reference: "8:5",
  theme: ["obéissance", "épreuve", "victoire"],
  emotion: "Détermination, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fattah", "Al-Muhaymin"],
  mirrorVersion: `« De même que ton Seigneur t'a fait sortir de ta maison avec la vérité, bien qu'un groupe de croyants l'ait répugné. » Le miroir me place sur le chemin de Badr. Le Prophète sortait pour une caravane, Allah avait planifié une bataille. Certains croyants n'étaient pas prêts — la contradiction entre leurs plans et le plan divin les troublait. Le miroir m'interroge : quand mes plans entrent en conflit avec le plan d'Allah, est-ce que je m'ajuste ? L'obéissance n'est pas confortable quand elle contredit mes attentes.`,
  reflection: `La sortie pour Badr révèle la tension entre les plans humains et le décret divin. Les croyants voulaient la caravane, Allah voulait la bataille. La vraie foi accepte le changement de plan.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kama akhrajaka rabbuka min baytika bi-al-haqq » — comme ton Seigneur t'a fait sortir de ta maison avec la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand Allah change mes plans, comment réagis-je ? Avec résistance ou avec soumission ? Le miroir teste ma flexibilité spirituelle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les croyants répugnaient — mais leur répugnance ne changeait pas le décret. L'acceptation vient après, pas avant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création suit le plan divin. L'oiseau migre quand Dieu le veut. Seul l'homme résiste au changement de plan." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La répugnance initiale des croyants est devenue victoire finale. Ce qu'on répugne parfois nous sauve." }
  ],
  munajat: `Ya Rabb, quand mes plans changent, aide-moi à accepter Ton plan. Ne permets pas que ma répugnance m'empêche de voir Ta sagesse.`
};

MIROIR["8:6"] = {
  reference: "8:6",
  theme: ["doute", "vrai", "discorde"],
  emotion: "Trouble, résolution",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Fattah"],
  mirrorVersion: `« Ils discutent avec toi au sujet de la vérité après qu'elle fut devenue évidente, comme si on les emmenait à la mort enchaînés. » Le miroir me montre le contraste saisissant : la vérité est devenue claire, mais ils continuent de débattre. C'est comme s'ils étaient traînés vers la mort — alors qu'ils allaient vers la vie ! La résistance au décret divin transforme la victoire potentielle en mort perçue. Le miroir m'interroge : où est-ce que je débat encore alors que la vérité est claire ?`,
  reflection: `Le débat après la clarté est un symptôme de l'attachement à ses propres plans. Le cœur qui a vu la vérité cesse de débattre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yujadilunaka fi al-haqqi ba'da ma tabayyana » — ils discutent avec toi au sujet de la vérité après qu'elle fut devenue évidente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui est clair pour moi mais que je refuse d'accepter ? Le miroir révèle mes zones de débat inutile." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ils voyaient la mort — Allah avait planifié la vie. La perception inverse la réalité quand le cœur résiste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. Le débat naît de l'ego qui refuse de s'incliner. L'univers entier s'incline, l'homme débat." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La mort qu'ils craignaient était une illusion. La vraie vie se trouve dans la soumission au décret divin." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Quand Tu rends quelque chose clair, aide-moi à cesser de débattre. Fais que je voie la vie là où je crois voir la mort.`
};

MIROIR["8:9"] = {
  reference: "8:9",
  theme: ["secours", "anges", "victoire"],
  emotion: "Espérance, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Nasir", "Al-Malak"],
  mirrorVersion: `« Quand vous imploriez le secours de votre Seigneur, et qu'Il vous a exaucés : 'Je vais vous renforcer de mille anges déferlant les uns après les autres.' » Le miroir me montre le lien entre l'imploration et l'exaucement. Les croyants ont demandé — Allah a répondu avec mille anges. La réponse divine dépasse toujours la demande. Le renfort n'était pas visible — mille anges ne se voient pas — mais il était réel. Le miroir m'interroge : est-ce que je crois au secours invisible ?`,
  reflection: `Les anges de Badr étaient invisibles mais présents. Le secours divin arrive souvent sous des formes qu'on ne peut pas voir mais qu'on peut ressentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha tastaghituna rabbakum » — quand vous imploriez le secours de votre Seigneur. L'imploration précède le secours." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que j'ai vraiment imploré le secours d'Allah ? Et ai-je reconnu la réponse quand elle est venue ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Mille anges — la réponse dépasse la demande. Allah donne plus que ce qu'on demande, plus que ce qu'on imagine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges sont partout, même quand on ne les voit pas. Chaque croyant a des anges qui l'accompagnent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'ange ne se voit pas — mais son effet se voit. Le secours divin est pareil : invisible à l'œil, visible dans le résultat." }
  ],
  munajat: `Ya Nasir, je T'implore aujourd'hui. Envoie Ton secours, visible ou invisible. Fais-moi confiance que Tu exauces, même quand je ne vois pas comment.`
};

MIROIR["8:11"] = {
  reference: "8:11",
  theme: ["paix", "sommeil", "purification"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Mutahhir"],
  mirrorVersion: `« Et quand Il vous couvrit de sommeil comme d'une sécurité de Sa part, et fit descendre sur vous une eau du ciel pour vous purifier. » Le miroir me montre trois dons de Badr : le sommeil comme sécurité, l'eau comme purification, la tranquillité comme préparation. Avant la bataille, Allah a donné le repos. Le sommeil n'était pas une faiblesse — c'était une grâce. L'eau purifiait les corps et les cœurs. Le miroir m'interroge : comment est-ce que je prépare mes batailles spirituelles ?`,
  reflection: `La préparation divine à l'épreuve inclut le repos et la purification. Allah ne teste pas sans d'abord préparer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yughashshikum al-nu'asa amnatan minhu » — Il vous couvrit de sommeil comme une sécurité de Sa part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Avant mes épreuves, est-ce que je me repose en Allah ? Le repos n'est pas paresse — c'est préparation divine." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'eau purifie les corps et les cœurs. La purification précède la victoire — on ne gagne pas avec un cœur impur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est un sommeil pour la terre. La pluie est une purification pour le sol. Allah prépare toute Sa création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le sommeil avant la bataille est le signe que la victoire vient d'Allah, pas des efforts humains." }
  ],
  munajat: `Ya Salam, donne-moi Ton repos avant mes épreuves. Purifie mon cœur pour que je sois prêt. Prépare-moi comme Tu as préparé Tes serviteurs à Badr.`
};

MIROIR["8:15"] = {
  reference: "8:15",
  theme: ["courage", "foi", "fermeté"],
  emotion: "Détermination, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Qawiyy", "Al-Matin"],
  mirrorVersion: `« Ô vous qui croyez ! Quand vous rencontrez ceux qui ont mécru en rangs serrés, ne leur tournez pas le dos. » Le miroir me montre l'ordre divin de tenir bon. La fuite n'est pas une option pour le croyant face à l'ennemi. « Ne tournez pas le dos » — c'est un commandement physique qui devient spirituel. Dans la vie, quand les difficultés s'avancent en rangs serrés, est-ce que je tiens bon ou est-ce que je fuis ? Le miroir teste ma fermeté.`,
  reflection: `L'interdiction de fuir est aussi spirituelle : face aux difficultés, le croyant ne fuit pas — il affronte avec confiance en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idha laqaytumu alladhina kafaru zahfan » — quand vous rencontrez ceux qui ont mécru en rangs serrés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand les problèmes s'avancent en rangs serrés dans ma vie, est-ce que je tiens bon ou est-ce que je fuis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Tourner le dos à l'ennemi, c'est tourner le dos à la victoire. La fuite précède la défaite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, tout affronte. L'arbre affronte le vent. La rivière affronte l'obstacle. La fuite n'existe pas dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La fermeté n'est pas courage humain — c'est confiance divine. Je tiens parce qu'Il tient." }
  ],
  munajat: `Ya Qawiyy, donne-moi la fermeté face à mes ennemis visibles et invisibles. Ne permets pas que je fuie. Fais que je tienne bon en Toi.`
};

MIROIR["8:24"] = {
  reference: "8:24",
  theme: ["réponse", "vie", "obéissance"],
  emotion: "Urgence, éveil",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hayy", "Al-Mujib"],
  mirrorVersion: `« Ô vous qui croyez ! Répondez à Allah et au Messager quand Il vous appelle à ce qui vous donne la vie. » Le miroir me montre un appel à la vie. L'obéissance à Allah n'est pas une contrainte — c'est une résurrection. Quand Il appelle, Il appelle à la vie. Et le verset continue : « Allah s'interpose entre l'homme et son cœur. » Le cœur n'est pas autonome — Allah est entre moi et mes propres pensées. Le miroir m'interroge : est-ce que je réponds à l'appel à la vie ?`,
  reflection: `L'appel divin est un appel à la vie véritable. Répondre n'est pas obéir à un ordre — c'est accepter de vivre vraiment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yuhayyikum » — ce qui vous donne la vie. L'appel divin est une invitation à la vie, pas une contrainte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qu'Allah m'appelle à faire maintenant ? Est-ce que je réponds ? Le miroir mesure ma réactivité spirituelle." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Allah s'interpose entre moi et mon cœur — je ne suis pas maître de mes propres pensées. Il est plus proche de moi que moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création répond à l'appel divin. L'univers entier obéit. Seul l'homme peut choisir de ne pas répondre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vie véritable commence quand on répond à l'appel. Avant la réponse, on existe — on ne vit pas vraiment." }
  ],
  munajat: `Ya Hayy, Tu m'appelles à la vie. Fais que je réponde. Ne permets pas que je reste dans la mort spirituelle. Interviens entre moi et mon cœur.`
};

MIROIR["8:29"] = {
  reference: "8:29",
  theme: ["crainte", "discernement", "pardon"],
  emotion: "Humilité, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Alim", "Al-Khabir"],
  mirrorVersion: `« Ô vous qui croyez ! Si vous craignez Allah, Il vous accordera un discernement et vous effacera vos mauvaises actions. » Le miroir me montre le lien entre la crainte et la clarté. La taqwa n'est pas la peur paranoïaque — c'est la conscience de Sa présence. Et cette conscience produit le furqan : la capacité de distinguer le vrai du faux, le bien du mal. La taqwa nettoie les lentilles du cœur. Le miroir m'interroge : est-ce que je demande le discernement ?`,
  reflection: `Le furqan (discernement) est un don lié à la taqwa. Plus je crains Allah, plus je vois clair dans ma vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yaj'al lakum furqana » — Il vous accordera un discernement. Le furqan distingue la vérité de l'erreur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans mes décisions, est-ce que je vois clair ? Le manque de discernement peut venir d'un manque de taqwa." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effacement des mauvaises actions accompagne le discernement. La clarté vient avec la purification." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière distingue les objets. La taqwa est une lumière intérieure qui permet de voir la différence entre les chemins." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le discernement n'est pas intellectuel — il est spirituel. Un cœur pur voit ce qu'un intellect trouble ne peut pas voir." }
  ],
  munajat: `Ya 'Alim, donne-moi le discernement. Augmente ma taqwa et nettoie mon cœur pour que je voie clair dans mes chemins.`
};

MIROIR["8:33"] = {
  reference: "8:33",
  theme: ["punition", "miséricorde", "prophète"],
  emotion: "Soulagement, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Ra'uf", "Ar-Rahim"],
  mirrorVersion: `« Mais Allah n'allait pas les châtier tant que tu étais parmi eux, et Allah n'allait pas les châtier alors qu'ils demandaient pardon. » Le miroir me montre la présence du Prophète comme protection pour toute une communauté. Sa présence était une barrière contre le châtiment. Et même sans lui, le pardon demandé suffisait. Le miroir m'interroge : est-ce que je réalise que ma présence peut être une bénédiction pour les autres ? Et est-ce que je demande pardon suffisamment ?`,
  reflection: `La présence du Prophète et la demande de pardon sont deux protections divines. Le croyant peut aussi être une protection pour son entourage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma kana Allahu li yu'adhdhibahum wa anta fihim » — Allah n'allait pas les châtier tant que tu étais parmi eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma présence dans un lieu est-elle une bénédiction ou une malédiction ? Le croyant devrait être une source de bien." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de pardon est une protection. Tant que je demande pardon, je suis protégé du pire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont des protecteurs pour leurs communautés. Les croyants peuvent aussi protéger par leur présence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le châtiment est retenu par deux choses : la présence du juste et le pardon du pécheur. Ces deux portes sont toujours ouvertes." }
  ],
  munajat: `Ya Ra'uf, merci pour Ta retenue du châtiment. Fais que ma présence soit une bénédiction pour les autres. Et apprends-moi à demander pardon sans cesse.`
};

MIROIR["8:39"] = {
  reference: "8:39",
  theme: ["combat", "religion", "liberté"],
  emotion: "Détermination, justice",
  difficulty: "avancé",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Combattez-les jusqu'à ce qu'il n'y ait plus de sédition et que la religion soit entièrement à Allah. » Le miroir me place devant un verset souvent mal compris. Le combat n'est pas pour la domination — il est contre la sédition (fitna). La fitna est plus grave que le combat. Quand la religion est « entièrement à Allah », cela signifie la liberté de culte pour tous. Le miroir m'interroge : quelles fitnas est-ce que je combat dans ma vie ?`,
  reflection: `La fitna (sédition/persecution) est un crime contre la liberté religieuse. Combattre la fitna établit la liberté pour tous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta la takuna fitnatun » — jusqu'à ce qu'il n'y ait plus de sédition. Le but est la fin de la persecution." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles fitnas (troubles/internal conflicts) est-ce que je tolère dans ma vie ? Le miroir m'appelle à les combattre." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« La religion à Allah » signifie la liberté pour tous de pratiquer. La fin de la fitna est le début de la liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en ordre parce qu'il n'y a pas de fitna. Les planètes ne se combattent pas. L'harmonie naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie victoire n'est pas la conquête — c'est la disparition de la fitna. Quand le trouble cesse, la paix règne naturellement." }
  ],
  munajat: `Ya 'Adl, Tu détestes la fitna. Aide-moi à combattre les troubles dans ma vie et dans le monde. Établis Ta paix.`
};

MIROIR["8:46"] = {
  reference: "8:46",
  theme: ["obéissance", "division", "force"],
  emotion: "Unité, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Jami'", "Al-Qawiyy"],
  mirrorVersion: `« Obéissez à Allah et à Son Messager, et ne vous disputez pas, sinon vous fléchirez et vous perdrez votre force. » Le miroir me montre le lien direct entre la dispute et la faiblesse. La division est l'arme la plus efficace contre une communauté. Les disputes ne sont pas des désaccords intellectuels — elles sont des pertes d'énergie. « Vous fléchirez » — la dispute épuise. « Vous perdrez votre force » — la division affaiblit. Le miroir m'interroge : où est-ce que je perds ma force dans des disputes inutiles ?`,
  reflection: `La force d'une communauté est dans son unité. Les disputes, même mineures, érodent l'énergie collective.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tanaza'u fatafshalu » — ne vous disputez pas, sinon vous fléchirez. La dispute mène à la faiblesse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles disputes est-ce que j'entretiens ? À quelles divisions est-ce que je participe ? Le miroir montre mes pertes d'énergie." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'unité n'est pas l'uniformité — c'est l'harmonie dans la différence. Les musulmans peuvent différer sans se disputer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Un corps en bonne santé fonctionne en harmonie. Quand les cellules se battent entre elles, c'est la maladie auto-immune." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La force perdue dans les disputes ne se récupère pas facilement. L'énergie dépensée en conflits est perdue pour la construction." }
  ],
  munajat: `Ya Jami', unit ma communauté. Ne permets pas que je participe aux divisions. Fais que je sois un facteur d'unité, pas de dispute.`
};

MIROIR["8:53"] = {
  reference: "8:53",
  theme: ["changement", "bénédiction", "gratitude"],
  emotion: "Vigilance, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nafi'", "Al-Mudhill"],
  mirrorVersion: `« Cela parce qu'Allah n'est point tel qu'Il change un bienfait qu'Il a accordé à un peuple, tant que ce peuple ne change pas ce qui est en lui-même. » Le miroir me montre une loi divine immuable : les bénédictions sont maintenues tant que l'état intérieur est maintenu. Le changement extérieur suit le changement intérieur. Si je perds une bénédiction, c'est que quelque chose en moi a changé en premier. Le miroir m'interroge : qu'est-ce qui a changé en moi ?`,
  reflection: `La loi du changement divin est claire : on perd ce qu'on ne préserve pas intérieurement. La gratitude maintient, l'ingratitude perd.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hatta yughayyira ma bi-anfusihim » — tant que ce peuple ne change pas ce qui est en lui-même. Le changement vient de l'intérieur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai perdu ? Et qu'est-ce qui a changé en moi avant cette perte ? Le miroir cherche la racine intérieure." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le bienfait n'est pas perdu par Allah — il est abandonné par l'homme. Le retrait suit l'abandon intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création suit cette loi. Un sol négligé perd sa fertilité. Un corps négligé perd sa santé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude est le gardien des bénédictions. Celui qui est reconnaissant protège ce qu'il a." }
  ],
  munajat: `Ya Rabb, ne retire pas Tes bienfaits. Fais que je change intérieurement pour les maintenir. Apprends-moi la gratitude qui protège.`
};

MIROIR["8:60"] = {
  reference: "8:60",
  theme: ["préparation", "force", "dissuasion"],
  emotion: "Détermination, prudence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qawiyy", "Al-Mani'"],
  mirrorVersion: `« Et préparez contre eux tout ce que vous pouvez comme force et comme cavalerie équipée, afin d'effrayer l'ennemi d'Allah et l'ennemi vôtre. » Le miroir me montre le principe de la préparation. La paix n'est pas l'absence de force — c'est la présence de la force qui dissuade. La force préparée effraie l'ennemi avant même le combat. La dissuasion est une forme de victoire sans combat. Le miroir m'interroge : comment est-ce que je prépare mes forces spirituelles ?`,
  reflection: `La préparation est une obligation. La force qui n'est pas préparée n'est pas disponible au moment critique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa a'iddu lahum ma istata'tum min quwwatin » — préparez contre eux tout ce que vous pouvez comme force." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles forces spirituelles est-ce que je prépare ? La prière, le jeûne, la lecture du Coran sont des forces à préparer." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La force préparée effraie l'ennemi. Le démon fuit devant le croyant fort, pas devant le croyant faible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, le fort n'attaque pas — il dissuade. L'animal qui montre ses griffes n'a souvent pas besoin de se battre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La meilleure force est celle qui n'a pas besoin d'être utilisée. La préparation est la victoire silencieuse." }
  ],
  munajat: `Ya Qawiyy, aide-moi à préparer mes forces. Ne permets pas que je sois pris au dépourvu. Fais que ma force spirituelle dissuade mes ennemis.`
};

MIROIR["8:70"] = {
  reference: "8:70",
  theme: ["captifs", "merci", "liberté"],
  emotion: "Espoir, miséricorde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'ti", "Al-Mannan"],
  mirrorVersion: `« Ô Prophète ! Dis aux captifs qui sont entre vos mains : 'Si Allah sait qu'il y a du bien dans vos cœurs, Il vous accordera mieux que ce qui vous a été pris.' » Le miroir me montre une espérance extraordinaire offerte aux captifs. La perte actuelle peut devenir gain futur — si le cœur change. « Mieux que ce qui vous a été pris » — Allah remplace la perte par quelque chose de supérieur. Le miroir m'interroge : est-ce que je crois qu'Allah peut transformer mes pertes en gains ?`,
  reflection: `Le bien dans le cœur change le destin. Même un captif peut recevoir mieux que ce qu'il a perdu — si son cœur s'ouvre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yu'tikum khayran mimma ukhida minkum » — Il vous accordera mieux que ce qui vous a été pris." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai perdu ? Et est-ce que je crois qu'Allah peut me donner mieux ? Le miroir teste mon espérance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte n'est pas finale. Elle peut être le début d'un gain supérieur — si le cœur contient du bien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La graine doit perdre sa forme pour devenir plante. La perte apparente cache souvent un gain réel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le « mieux » d'Allah dépasse toujours ce qu'on a perdu. Sa compensation est toujours supérieure à la perte." }
  ],
  munajat: `Ya Mu'ti, j'ai perdu des choses. Mais Tu peux me donner mieux. Ouvre mon cœur au bien pour que Tu puisses compenser mes pertes.`
};

MIROIR["8:72"] = {
  reference: "8:72",
  theme: ["allégeance", "migration", "fraternité"],
  emotion: "Solidarité, engagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Waliyy", "Al-Wakil"],
  mirrorVersion: `« Ceux qui ont cru, émigré et lutté dans le sentier d'Allah, ainsi que ceux qui ont donné asile et secouru, ceux-là sont les alliés les uns des autres. » Le miroir me montre les liens de fraternité créés par la foi et l'action. L'émigration (hijra) et le jihad créent une parenté spirituelle. Ceux qui accueillent (Ansar) et ceux qui migrent (Muhajirun) deviennent alliés. Le miroir m'interroge : avec qui suis-je vraiment allié ? Sur la base de quoi ?`,
  reflection: `L'alliance des croyants est fondée sur la foi partagée et l'action commune. Le sang ne crée pas la plus forte parenté — l'engagement spirituel la crée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika ba'duhum awliya'u ba'd » — ceux-là sont les alliés les uns des autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes vrais alliés ? Sur la base de la foi ou sur la base des intérêts ? Le miroir examine mes alliances." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La migration n'est pas seulement géographique — elle est spirituelle. Chaque pas vers Allah est une hijra." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les animaux migrent ensemble. Les oiseaux volent en formation. L'union est une loi de survie dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie fraternité survit à la distance et au temps. Les alliés en Allah sont unis au-delà des circonstances." }
  ],
  munajat: `Ya Waliyy, unit moi à Tes alliés. Fais que mes alliances soient fondées sur la foi et l'action, pas sur l'intérêt.`
};

// ==================== SURAH 9: AT-TAWBAH (129 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["9:1"] = {
  reference: "9:1",
  theme: ["désaveu", "alliance", "traité"],
  emotion: "Séparation, clarté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Fattah"],
  mirrorVersion: `« Désaveu de la part d'Allah et de Son Messager envers les associateurs avec qui vous avez conclu un pacte. » Le miroir me montre le début de la sourate la plus sévère. Pas de basmala — c'est un désaveu, pas une invitation. Les pactes avec les associateurs avaient été rompus par eux. Ce verset annonce la fin des traités violés. Le miroir m'interroge : quels traités ai-je violés dans ma vie ? Et comment réagis-je quand on rompt les traités avec moi ?`,
  reflection: `L'absence de basmala au début de cette sourate signale son caractère sévère. La fidélité aux traités est fondamentale — leur violation justifie le désaveu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bara'atun min Allahi wa rasulihi » — désaveu de la part d'Allah et de Son Messager." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je tenu mes promesses ? Les traités que j'ai faits, les ai-je honorés ? Le miroir vérifie ma fidélité." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désaveu vient après la violation. Allah n'est pas celui qui rompt — Il répond à la rupture par la rupture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute relation est fondée sur la confiance. Quand la confiance est rompue, la relation se dissout naturellement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le désaveu n'est pas une punition — c'est une clarification. Il révèle ce qui était déjà caché : la relation était morte." }
  ],
  munajat: `Ya Haqq, Tu es fidèle à Tes traités. Aide-moi à être fidèle aux miens. Ne permets pas que je sois de ceux qui rompent leurs promesses.`
};

MIROIR["9:3"] = {
  reference: "9:3",
  theme: ["annonce", "pèlerinage", "avertissement"],
  emotion: "Sérieux, solennité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khabir", "Al-Hasib"],
  mirrorVersion: `« Et proclamation d'Allah et de Son Messager aux gens le jour du Grand Pèlerinage : Allah et Son Messager désavouent les associateurs. » Le miroir me place au cœur de la Kaaba, pendant le Hajj. L'annonce est publique, solennelle, sans équivoque. Le désaveu est proclamé au moment où le monde converge vers la Maison d'Allah. Le miroir m'interroge : qu'est-ce que je proclame publiquement ? Est-ce que mon désaveu du mal est aussi clair ?`,
  reflection: `Le jour du Grand Pèlerinage (Yawm al-Hajj al-Akbar) est le moment choisi pour la proclamation. La clarté publique accompagne la gravité du message.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Adhanun min Allahi wa rasulihi ila al-nasi yawma al-hajji al-akbar » — proclamation d'Allah et de Son Messager aux gens le jour du Grand Pèlerinage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon désaveu du mal est-il clair et public ? Ou est-ce que je reste dans l'ambiguïté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le choix du jour du Hajj n'est pas anodin. La Maison d'Allah doit être pure de toute association." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Kaaba est le centre de l'unicité. L'annonce à cet endroit signifie la purification de l'espace sacré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le désaveu public du mal purifie la communauté. L'ambiguïté est la mère de la confusion." }
  ],
  munajat: `Ya Khabir, Tu connais mes ambiguités. Aide-moi à clarifier mes positions. Fais que mon désaveu du mal soit visible comme la proclamation à la Kaaba.`
};

MIROIR["9:18"] = {
  reference: "9:18",
  theme: ["mosquée", "prière", "pureté"],
  emotion: "Révérence, appartenance",
  difficulty: "débutant",
  relatedNames: ["Al-Bari'", "Al-Mutahhir"],
  mirrorVersion: `« Ne peupleront les mosquées d'Allah que celui qui croit en Allah et au Jour dernier, accomplit la prière, acquitte l'aumône et ne craint qu'Allah. » Le miroir me montre les conditions pour fréquenter les maisons d'Allah. Ce n'est pas un lieu touristique — c'est un espace sacré pour les croyants purs. Quatre conditions : foi, prière, aumône, crainte exclusive. Le miroir m'interroge : avec quel état est-ce que j'entre dans les mosquées ?`,
  reflection: `Les mosquées sont peuplées par les cœurs purs, pas par les corps seulement. La fréquentation des maisons d'Allah demande une préparation intérieure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama ya'muru masajida Allahi man amana billahi » — ne peupleront les mosquées d'Allah que celui qui croit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entre dans une mosquée, quel état j'apporte ? Suis-je de ceux qui la « peuplent » vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte exclusive d'Allah est une condition. Celui qui craint les gens ne peut pas fréquenter vraiment les mosquées." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute maison a ses habitants appropriés. La maison d'Allah demande des habitants à Sa mesure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Peupler la mosquée n'est pas seulement physique — c'est spirituel. On la peuple par la présence du cœur, pas du corps seul." }
  ],
  munajat: `Ya Rabb, je veux être de ceux qui peuplent Tes maisons. Purifie mon cœur pour que je puisse entrer avec les bonnes conditions.`
};

MIROIR["9:23"] = {
  reference: "9:23",
  theme: ["alliance", "famille", "foi"],
  emotion: "Tension, choix",
  difficulty: "avancé",
  relatedNames: ["Al-Waliyy", "Al-Hadi"],
  mirrorVersion: `« Ô vous qui croyez ! Ne prenez pas pour alliés vos pères et vos frères s'ils préfèrent la mécréance à la foi. » Le miroir me place devant un choix douloureux. La famille, le lien le plus fort, peut devenir un obstacle spirituel. L'amour pour les proches ne doit pas surpasser l'amour pour la vérité. Le miroir m'interroge : qu'est-ce que je priorise quand ma famille et ma foi sont en conflit ?`,
  reflection: `L'alliance avec les proches mécréants n'est pas interdite par lien de sang — elle est interdite quand ils préfèrent la mécréance. Le critère est la priorité spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tattakhidhu aba'akum wa ikhwankum awliya'a » — ne prenez pas pour alliés vos pères et vos frères." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand ma famille s'oppose à ma foi, qui est-ce que je choisis ? Le miroir révèle ma hiérarchie de valeurs." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction n'est pas contre l'amour familial — elle est contre l'alliance qui compromet la foi. On peut aimer sans s'allier." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, le petit quitte le nid pour suivre sa nature. La croissance implique parfois la séparation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le choix de la foi sur la famille n'est pas rejet de la famille — c'est priorité de l'éternel sur le temporel." }
  ],
  munajat: `Ya Hadi, les liens familiaux sont forts. Mais Tu es plus fort. Aide-moi à Te prioriser quand le conflit arrive. Ne permets pas que l'amour des proches m'éloigne de Toi.`
};

MIROIR["9:36"] = {
  reference: "9:36",
  theme: ["temps", "mois", "sacré"],
  emotion: "Révérence, ordre",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Hakim"],
  mirrorVersion: `« Le nombre de mois auprès d'Allah est de douze, dans la prescription d'Allah le jour où Il créa les cieux et la terre. » Le miroir me montre l'ordre divin du temps. Douze mois, dont quatre sacrés. Le temps n'est pas une construction humaine — c'est une structure divine. Les mois sacrés sont des temps de pause, de réflexion, de non-violence. Le miroir m'interroge : comment est-ce que je structure mon temps ?`,
  reflection: `Le temps est créé par Allah avec une structure sacrée. Les quatre mois sacrés (Rajab, Dhul-Qa'da, Dhul-Hijja, Muharram) sont des temps de heightened awareness.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna 'idata al-shuhuri 'inda Allahi ithna 'ashara shahran » — le nombre de mois auprès d'Allah est de douze." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la structure divine du temps ? Comment est-ce que je vis les mois sacrés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les mois sacrés ne sont pas des règles arbitraires — ils sont des respirations dans le temps pour revenir à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lune marque les mois. Le soleil marque les saisons. L'univers entier suit un calendrier divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le temps sacré transforme le temps ordinaire. Les mois sacrés sont des fenêtres sur l'éternité." }
  ],
  munajat: `Ya Khaliq, Tu as créé le temps avec sagesse. Aide-moi à honorer les mois sacrés et à structurer mon temps selon Ton ordre.`
};

MIROIR["9:40"] = {
  reference: "9:40",
  theme: ["caverne", "secours", "confiance"],
  emotion: "Espoir, sécurité",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Nasir"],
  mirrorVersion: `« Si vous ne lui portez pas secours, Allah l'a déjà secouru quand les mécréants l'avaient banni, deuxième de deux, dans la caverne. » Le miroir me place dans la caverne avec le Prophète et Abu Bakr. Deux hommes, une caverne, des ennemis à quelques mètres. Le Prophète dit : « Ne t'attriste pas, Allah est avec nous. » La présence d'Allah était leur sécurité. Le miroir m'interroge : dans ma caverne, est-ce que je sens la présence d'Allah ?`,
  reflection: `La caverne de Thawr est l'archétype de la situation désespérée où la présence d'Allah est la seule ressource. « Allah est avec nous » suffit pour la sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ith huwa thani ithnayni fi al-ghar » — deuxième de deux, dans la caverne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis dans une situation désespérée, est-ce que je dis « Allah est avec moi » ? Le miroir teste ma confiance." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ils étaient deux physiquement — mais Allah faisait le troisième. Sa présence invisible était plus réelle que l'ennemi visible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La caverne est un symbole universel de retraite et de protection. Le fœtus est dans une caverne. La graine est dans une caverne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La présence d'Allah dans la caverne est la même présence partout. La caverne ne La cache pas — elle La révèle." }
  ],
  munajat: `Ya Waliyy, sois avec moi dans mes cavernes. Quand tout semble désespéré, rappelle-moi que Ta présence suffit. Ne permets pas que je m'attriste.`
};

MIROIR["9:60"] = {
  reference: "9:60",
  theme: ["aumône", "bénéficiaires", "justice"],
  emotion: "Clarté, organisation",
  difficulty: "intermédiaire",
  relatedNames: ["Ar-Razzaq", "Al-'Adl"],
  mirrorVersion: `« Les aumônes sont pour les pauvres, les nécessiteux, ceux qui les collectent, ceux dont les cœurs sont à rallier, l'affranchissement des esclaves, les endettés, le chemin d'Allah et le voyageur. » Le miroir me montre huit catégories de bénéficiaires de la zakat. La charité n'est pas arbitraire — elle est structurée. Du pauvre au voyageur, chaque catégorie a ses droits. Le miroir m'interroge : comment est-ce que je distribue mes aumônes ?`,
  reflection: `Les huit catégories de la zakat forment un système complet de redistribution sociale. Personne n'est oublié — du pauvre local au voyageur de passage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innama al-sadaqatu lil-fuqara'i wa al-masakini » — les aumônes sont pour les pauvres et les nécessiteux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que je donne ? Est-ce que je connais les huit catégories ? Le miroir vérifie ma conscience sociale." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "« Ceux dont les cœurs sont à rallier » — la zakat peut être utilisée pour attirer les cœurs vers la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Dans la nature, l'excédent d'un nourrit le besoin d'un autre. L'écosystème est un système de redistribution." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La zakat purifie le bien en le faisant circuler. L'argent bloqué pourrit, l'argent qui circule bénit." }
  ],
  munajat: `Ya Razzaq, guide-moi dans ma charité. Fais que je donne aux bonnes personnes et que je ne néglige aucune catégorie qui a droit à l'aumône.`
};

MIROIR["9:71"] = {
  reference: "9:71",
  theme: ["fraternité", "commandement", "interdiction"],
  emotion: "Solidarité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Hadi"],
  mirrorVersion: `« Les croyants et les croyantes sont alliés les uns des autres. Ils commandent le convenable, interdisent le blâmable, accomplissent la prière, acquittent l'aumône et obéissent à Allah et à Son Messager. » Le miroir me montre le portrait complet de la communauté croyante. L'alliance est mutuelle — hommes et femmes ensemble. Cinq caractéristiques définissent cette fraternité : commandement du bien, interdiction du mal, prière, aumône, obéissance. Le miroir m'interroge : est-ce que je suis un bon allié pour mes frères et sœurs ?`,
  reflection: `La fraternité croyante est active — pas seulement sentimentale. Elle se manifeste par le commandement du bien et l'interdiction du mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-mu'minuna wa al-mu'minatu ba'duhum awliya'u ba'd » — les croyants et les croyantes sont alliés les uns des autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je commande le bien autour de moi ? Est-ce que j'interdis le mal ? Le miroir vérifie mon engagement actif." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance n'est pas passive — elle est active. Un allié qui ne conseille pas n'est pas un vrai allié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cellules d'un corps s'entraident. L'une commande à l'autre, l'autre corrige. La santé est une fraternité cellulaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Commander le bien n'est pas contrôle — c'est soin. Interdire le mal n'est pas jugement — c'est protection." }
  ],
  munajat: `Ya Waliyy, fais que je sois un vrai allié pour les croyants. Aide-moi à commander le bien et interdire le mal avec sagesse et amour.`
};

MIROIR["9:80"] = {
  reference: "9:80",
  theme: ["pardon", "hypocrites", "prière"],
  emotion: "Tristesse, réalité",
  difficulty: "avancé",
  relatedNames: ["Al-Ghaffar", "Al-'Alim"],
  mirrorVersion: `« Tu demanderas pardon pour eux ou tu ne demanderas pas pardon — s'il te plaît soixante-dix fois, Allah ne leur pardonnera pas. » Le miroir me montre les limites du pardon. Soixante-dix fois — un chiffre symbolique de complétude. Mais même une prière complète ne peut pas forcer le pardon pour ceux qui ont choisi la mécréance. Le pardon divin a des conditions, et le refus obstiné de croire ferme la porte. Le miroir m'interroge : est-ce que je comprends la gravité du refus de croire ?`,
  reflection: `Le pardon n'est pas automatique — il demande un cœur ouvert. Ceux qui rejettent la foi obstinément se ferment eux-mêmes la porte du pardon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tastağfir lahum sab'ina marratan falan yaghfira Allahu lahum » — si tu demandes pardon pour eux soixante-dix fois, Allah ne leur pardonnera pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande pardon pour ceux qui ne veulent pas être pardonnés ? Le miroir m'apprend la sagesse dans l'intercession." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refus du pardon vient du pécheur, pas d'Allah. Allah veut pardonner — mais Il ne force pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière existe — mais l'aveugle ne peut pas la voir. Le pardon existe — mais le cœur fermé ne peut pas le recevoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Soixante-dix fois est un chiffre de complétude. Même une intercession complète ne peut pas ouvrir une porte fermée de l'intérieur." }
  ],
  munajat: `Ya Ghaffar, Tu veux pardonner. Ne permets pas que je ferme ma porte à Ton pardon. Et enseigne-moi la sagesse dans mes prières pour les autres.`
};

MIROIR["9:97"] = {
  reference: "9:97",
  theme: ["bédouins", "foi", "hypocrisie"],
  emotion: "Discernement, prudence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Basir", "Al-Khabir"],
  mirrorVersion: `« Les bédouins sont plus forts dans la mécréance et l'hypocrisie, et les plus enclins à ignorer les limites de ce qu'Allah a révélé à Son Messager. » Le miroir me montre que la foi n'est pas égale selon les contextes. Les bédouins, isolés dans le désert, avaient moins accès à la révélation et à la pratique communautaire. L'ignorance n'est pas une excuse — mais elle est un facteur. Le miroir m'interroge : quels facteurs influencent ma foi ? Mon environnement renforce-t-il ou affaiblit-il ma pratique ?`,
  reflection: `L'environnement affecte la foi. Les bédouins n'étaient pas condamnés — mais leur contexte rendait la foi plus difficile. L'accessibilité à la révélation compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-a'rabu ashaddu kufran wa nifaqan » — les bédouins sont plus forts dans la mécréance et l'hypocrisie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon environnement renforce-t-il ma foi ? Ou l'affaiblit-il ? Le miroir m'invite à évaluer mes contextes." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance des limites n'est pas innocente — elle est dangereuse. Ne pas connaître les règles n'empêche pas les conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Une plante dans un environnement hostile grandit difficilement. La foi a besoin d'un contexte nourricier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le bédouin peut devenir un modèle de foi — mais il doit compenser son isolation par un effort plus grand." }
  ],
  munajat: `Ya Basir, Tu connais mon environnement. Aide-moi à compenser ses faiblesses et à profiter de ses forces. Ne permets pas que l'ignorance m'éloigne de Toi.`
};

MIROIR["9:111"] = {
  reference: "9:111",
  theme: ["commerce", "sacrifice", "paradis"],
  emotion: "Engagement total, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bari'", "Al-Wadud"],
  mirrorVersion: `« Allah a acheté des croyants leurs personnes et leurs biens, en échange du Paradis. » Le miroir me montre le marché divin. Allah achète — et le prix est le Paradis. Ce commerce est sans perte : on donne une vie limitée, on reçoit une vie illimitée. Le croyant se donne entièrement — personne et biens — et reçoit l'éternité. Le miroir m'interroge : ai-je fait ce commerce ? Me suis-je vendu à Allah ?`,
  reflection: `Le « commerce avec Allah » (tujarat) est le meilleur investissement. On donne ce qui est temporaire pour recevoir ce qui est éternel. Personne ne perd dans ce marché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha ishtara mina al-mu'minina anfusahum wa amwalahum » — Allah a acheté des croyants leurs personnes et leurs biens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Me suis-je vendu à Allah ? Ou est-ce que je garde des réserves ? Le miroir vérifie la complétude de ma transaction." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas un prix — c'est un don. Le « prix » qu'on paie (nos vies) n'a pas de valeur comparable." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute graine « vend » sa forme actuelle pour devenir plante. Le sacrifice de la forme est la loi de la croissance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Quand le cœur accepte ce commerce, la mort devient gain. La perte n'existe plus — tout est investissement." }
  ],
  munajat: `Ya Rabb, je veux conclure ce marché. Prends ma personne et mes biens. Donne-moi le Paradis en échange. Fais que je sois un vendeur sincère.`
};

MIROIR["9:119"] = {
  reference: "9:119",
  theme: ["vérité", "compagnie", "droiture"],
  emotion: "Clarté, détermination",
  difficulty: "débutant",
  relatedNames: ["As-Siddiq", "Al-Hadi"],
  mirrorVersion: `« Ô vous qui croyez ! Craignez Allah et soyez avec les véridiques. » Le miroir me montre une instruction en deux parties : la crainte d'Allah (vertical) et la compagnie des véridiques (horizontal). Les deux sont liés. On ne peut pas craindre Allah isolé des gens de vérité. La compagnie des siddiqin (véridiques) renforce la taqwa. Le miroir m'interroge : qui sont mes compagnons ? Sont-ils véridiques ?`,
  reflection: `La compagnie influence l'état spirituel. Être avec les véridiques est un commandement divin. La solitude spirituelle est dangereuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa kunu ma' al-sadiqin » — et soyez avec les véridiques." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes compagnons ? M'approchent-ils d'Allah ou m'en éloignent-ils ? Le miroir évalue mes fréquentations." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les véridiques ne sont pas parfaits — ils sont sincères. La sincérité, pas la perfection, est le critère de la bonne compagnie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les oiseaux de même espèce volent ensemble. L'humain est influencé par son entourage — c'est une loi naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La compagnie des véridiques est une grâce. Les chercher est un devoir. Les trouver est une bénédiction." }
  ],
  munajat: `Ya Hadi, mets-moi sur le chemin des véridiques. Éloigne-moi des compagnies qui m'éloignent de Toi. Fais que je sois moi-même véridique.`
};

MIROIR["9:128"] = {
  reference: "9:128",
  theme: ["prophète", "compassion", "amour"],
  emotion: "Tendresse, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Ra'uf", "Ar-Rahim"],
  mirrorVersion: `« Certes, un Messager est venu à vous, de parmi vous, auquel pèsent les difficultés que vous subissez, qui est avide de votre bien, qui est compatissant et miséricordieux envers les croyants. » Le miroir me montre le cœur du Prophète. Il est « de parmi vous » — proche, accessible. Il souffre de vos souffrances. Il désire votre bien. Il est ra'uf (compatissant) et rahim (miséricordieux). Le miroir m'interroge : est-ce que je connais vraiment le Prophète ?`,
  reflection: `Le Prophète n'est pas un juge distant — il est un frère proche qui souffre avec sa communauté. Son amour pour les croyants est intense et personnel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Azizun 'alayhi ma 'anittum harisun 'alaykum bi al-mu'minina ra'ufun rahim » — il lui pèse vos difficultés, il est avide de votre bien, compatissant et miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je perçois le Prophète ? Comme un juge ou comme un frère compatissant ? Le miroir révèle ma relation avec lui." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Prophète souffre de nos souffrances. Notre peine est sa peine. Notre bien est son désir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Un bon leader porte le fardeau de son peuple. Le Prophète est le meilleur leader — son fardeau est l'amour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Aimer le Prophète, c'est répondre à son amour. Il nous aime — l'aimer en retour est la moindre reconnaissance." }
  ],
  munajat: `Ya Rabb, merci pour Ton Prophète compatissant. Fais que je le connaisse vraiment et que je l'aime comme il m'aime. Bénis-le et bénis sa communauté.`
};

// ==================== SURAH 31-50 EXPANSION ====================
// Complete coverage for Surahs 31-50
// Task ID: surahs31-50

// ==================== SURAH 31: LUQMAN (34 verses) - Additional ====================

MIROIR["31:2"] = {
  reference: "31:2",
  theme: ["guidance", "coran", "sagesse"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Hakim"],
  mirrorVersion: `« Voici les versets du Livre plein de sagesse, une guidance et une miséricorde pour les bienfaiteurs. » Le miroir me montre que le Coran est à la fois guidance et miséricorde. Pour qui ? Pour « les bienfaiteurs » — muhsinin. Ceux qui font le bien, qui excellent dans leurs actions. Le Coran n'est pas seulement un livre à lire — c'est une lumière pour ceux qui agissent bien.`,
  reflection: `La guidance du Coran se dévoile à celui qui fait le bien. L'action précède la compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hudan wa rahmatan li-l-muhsinin » — guidance et miséricorde pour les bienfaiteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un bienfaiteur ? Est-ce que j'exelle dans mes actions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance n'est pas un don passif — elle répond à l'effort d'excellence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers récompense l'excellence. La nature ne connaît que la perfection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le bien reçoit la lumière pour faire encore mieux." }
  ],
  munajat: `Ya Hadi, fais de moi un bienfaiteur. Donne-moi Ta guidance pour exceller dans tout ce que je fais.`
};

MIROIR["31:3"] = {
  reference: "31:3",
  theme: ["guidance", "prière", "charité"],
  emotion: "Engagement, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Muqsit", "Al-Wali"],
  mirrorVersion: `« Qui accomplissent la prière, font l'aumône et croient fermement en l'au-delà. » Le miroir me montre les trois piliers du bienfaiteur : la prière verticale vers Allah, l'aumône horizontale vers les autres, et la foi en l'au-delà qui donne sens à tout. Ces trois éléments ne sont pas séparés — ils forment un tout. La prière sans charité est vide. La charité sans foi est superficielle.`,
  reflection: `La spiritualité complète lie le vertical et l'horizontal. La prière, la charité et la foi forment un triangle sacré.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yuqimuna as-salata wa yu'tuna az-zakata » — qui prient et donnent l'aumône." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma prière se traduit en charité ? Ma charité vient-elle de ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui prie vraiment ne peut pas ne pas donner. Celui qui croit vraiment ne peut pas être avare." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne sans cesse. Le soleil donne sa lumière, la terre donne sa nourriture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La prière, la charité et la foi sont les trois visages d'une même vérité : le don de soi." }
  ],
  munajat: `Ya Rabb, unifie ma vie. Fais que ma prière nourrisse ma charité, que ma charité renforce ma foi.`
};

MIROIR["31:6"] = {
  reference: "31:6",
  theme: ["égarement", "distraction", "parole"],
  emotion: "Mise en garde, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« Parmi les gens, il y a celui qui achète de vaines paroles pour égarer du chemin d'Allah. » Le miroir me montre le danger des distractions. « Lahw al-hadith » — paroles futiles, divertissements vains. Certains achètent ces distractions pour s'égarer et égarer les autres. Le miroir m'interroge : quelles distractions achète-je ? Qu'est-ce qui m'éloigne du chemin d'Allah ?`,
  reflection: `Les distractions sont des achats. Chaque moment passé dans le futile est un investissement perdu.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yashtari lahwa al-hadith » — achète de vaines paroles. Le divertissement comme marchandise." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de temps je passe dans des divertissements qui m'éloignent d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le divertissement n'est pas interdit — mais quand il égare, il devient poison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas le divertissement futile. Chaque créature est alignée sur son but." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se protège des vaines paroles protège son cœur de l'égarement." }
  ],
  munajat: `Ya Haqq, protège-moi des distractions qui m'éloignent de Toi. Fais que chaque parole compte.`
};

MIROIR["31:14"] = {
  reference: "31:14",
  theme: ["parents", "gratitude", "devoir"],
  emotion: "Reconnaissance, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Walid"],
  mirrorVersion: `« Nous avons enjoint l'homme à être bon envers ses père et mère. » Le miroir me place devant le devoir filial. La bonté envers les parents est mentionnée juste après la gratitude envers Allah. Les parents sont le canal par lequel Allah nous donne la vie. Être bon envers eux, c'est reconnaître ce don. Le miroir m'interroge : comment je traite mes parents ?`,
  reflection: `Les parents sont le premier cadeau d'Allah après la vie elle-même. Les honorer, c'est honorer le Donateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wassayna al-insana bi-walidayhi » — Nous avons enjoint l'homme envers ses parents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite mes parents ? Suis-je reconnaissant pour leur sacrifice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce que je fais pour mes parents, mes enfants le feront pour moi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature vient de parents. Le respect des parents est une loi naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La baraka des parents ouvre les portes du Paradis." }
  ],
  munajat: `Ya Rahman, merci pour mes parents. Aide-moi à être bon envers eux comme Tu es bon envers moi.`
};

MIROIR["31:18"] = {
  reference: "31:18",
  theme: ["orgueil", "modestie", "sagesse"],
  emotion: "Humilité, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Mutakabbir", "Al-Khaliq"],
  mirrorVersion: `« Ne détourne pas ton visage des gens par orgueil et ne marche pas avec insolence sur la terre. » Le miroir me montre deux manifestations de l'orgueil : le visage détourné et la marche insolente. L'orgueil ne se voit pas seulement dans les grands actes — il se trahit dans les gestes quotidiens. Comment je regarde les gens ? Comment je marche ? Le miroir m'interroge : mon corps trahit-il mon orgueil ?`,
  reflection: `L'orgueil s'insinue dans les gestes les plus simples. L'humilité commence par le corps.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tu'ssid khaddaka » — ne détourne pas ton visage. « La tamshi fi al-ardi maraha » — ne marche pas avec insolence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je regarde les autres ? Comment je me déplace ? Ces détails révèlent mon cœur." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le visage humble ouvre les cœurs. La marche posée ouvre les portes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas l'orgueil. Chaque créature occupe sa place sans se comparer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'humilité n'est pas de se sous-estimer — c'est de connaître sa vraie place." }
  ],
  munajat: `Ya Rabb, purifie mes gestes de tout orgueil. Fais que mon corps reflète un cœur humble.`
};

MIROIR["31:21"] = {
  reference: "31:21",
  theme: ["tradition", "vérité", "questionnement"],
  emotion: "Interpellation, réflexion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Hadi"],
  mirrorVersion: `« Et quand on leur dit : 'Suivez ce qu'Allah a fait descendre', ils disent : 'Nous suivons ce que nous avons trouvé chez nos ancêtres.' » Le miroir me montre l'obstacle de la tradition aveugle. Suivre les ancêtres sans questionner, c'est abdiquer sa responsabilité. La vérité n'est pas héréditaire — elle doit être découverte. Le miroir m'interroge : que suis-je par tradition plutôt que par conviction ?`,
  reflection: `L'héritage n'est pas une vérité. Ce que je reçois doit être vérifié par ma propre recherche.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nattabi'u ma wajadna 'alayhi aba'ana » — nous suivons ce que nous avons trouvé chez nos ancêtres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais par tradition sans savoir pourquoi ? Qu'est-ce que je dois remettre en question ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie tradition transmet la vérité. La fausse tradition transmet l'habitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas de traditions — il a des lois. Les lois ne changent pas par habitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne sa tradition l'honore — car il la fait sienne." }
  ],
  munajat: `Ya Haqq, ne permets pas que je suive aveuglément. Fais que chaque croyance soit ma conviction, pas seulement mon héritage.`
};

MIROIR["31:22"] = {
  reference: "31:22",
  theme: ["soumission", "confiance", "guidance"],
  emotion: "Paix, abandon",
  difficulty: "débutant",
  relatedNames: ["Al-Muslim", "Al-Hadi"],
  mirrorVersion: `« Quiconque soumet son être à Allah tout en étant bienfaisant s'accroche à l'anse la plus solide. » Le miroir me montre le chemin de la sécurité : « aslama wajhahu » — soumettre son être, son visage, tout soi-même à Allah. Et « muhsin » — en étant bienfaisant. La soumission avec excellence. « Al-'urwa al-wuthqa » — l'anse la plus solide. Un point d'ancrage inébranlable.`,
  reflection: `La soumission à Allah n'est pas une perte — c'est un ancrage. Se suspendre à Lui, c'est ne jamais tomber.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa qad istamsaka bi-l-'urwa al-wuthqa » — il s'est accroché à l'anse la plus solide." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je m'accroche vraiment ? À Allah ou à des anses fragiles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'anse la plus solide est invisible. La voir, c'est avoir la foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers est accrochée à Allah par sa soumission naturelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tient l'anse d'Allah est tenu par Lui." }
  ],
  munajat: `Ya Muslim, je me soumets à Toi. Tiens-moi par Ton anse solide. Ne me laisse pas tomber.`
};

MIROIR["31:23"] = {
  reference: "31:23",
  theme: ["mécréance", "patience", "jugement"],
  emotion: "Sérénité, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Hakam"],
  mirrorVersion: `« Que ne t'afflige point leur mécréance. Vers Nous est leur retour et Nous les informerons de leurs actes. » Le miroir me montre la bonne attitude face à la mécréance des autres : ne pas s'affliger. Pourquoi ? Parce que leur retour est vers Allah. Le jugement Lui appartient. Mon rôle est de transmettre, pas de convertir. Le miroir m'interroge : suis-je affligé par la mécréance des autres ?`,
  reflection: `La mécréance des autres n'est pas mon fardeau. Mon fardeau est ma propre foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La yahzunka kufruhu » — que ne t'afflige point leur mécréance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis affligé par la mécréance des autres ? Ou est-ce que je la remets à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le croyant n'est pas triste pour les autres — il est patient et confiant en Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'est pas affligé par l'ingratitude — il continue son cours." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remet le jugement à Allah trouve la paix." }
  ],
  munajat: `Ya Hakam, je remets le jugement à Toi. Aide-moi à ne pas être affligé mais à faire mon devoir avec patience.`
};

MIROIR["31:33"] = {
  reference: "31:33",
  theme: ["tromperie", "désillusion", "vie"],
  emotion: "Lucidité, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Mawt"],
  mirrorVersion: `« Ô hommes ! Craignez votre Seigneur et redoutez un jour où le père ne répondra pas pour son fils. » Le miroir me place devant la solitude du Jour dernier. Les liens les plus forts — père et fils — seront rompus. Chacun sera seul avec ses actes. La tromperie de ce monde est de croire qu'on peut compter sur les autres. Le miroir m'interroge : sur qui je compte vraiment ?`,
  reflection: `Au Jour dernier, je serai seul avec mes choix. Les relations d'ici-bas ne sauveront personne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawman la yajzi waladun 'an walidihi » — un jour où le fils ne répondra pas pour son père." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si j'étais seul avec mes actes aujourd'hui, comment serais-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La solitude du Jugement n'est pas une punition — c'est la vérité de l'individualité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature meurt seule. Chaque âme sera jugée seule." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare à la solitude du Jugement n'a pas peur de la mort." }
  ],
  munajat: `Ya Rabb, le Jour viendra où je serai seul avec mes actes. Prépare-moi. Fais que ce soit une rencontre paisible.`
};

// ==================== SURAH 32: AS-SAJDAH (30 verses) - Additional ====================

MIROIR["32:5"] = {
  reference: "32:5",
  theme: ["commandement", "création", "temps"],
  emotion: "Émerveillement, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Amr", "Al-Khaliq"],
  mirrorVersion: `« Il dirige l'affaire du ciel vers la terre, ensuite elle monte vers Lui en un jour équivalant à mille ans de votre calcul. » Le miroir me place devant la relativité du temps divin. Un jour pour Allah équivaut à mille ans pour nous. Le temps n'est pas absolu — il est relatif à la perspective. Allah voit l'histoire entière en un instant. Le miroir m'invite à relativiser ma perspective temporelle.`,
  reflection: `Notre temps est limité, Sa vue est éternelle. Ce qui nous semble long pour Lui est court.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yudabbir al-amr » — Il dirige l'affaire. « Min al-sama'i ila al-ard » — du ciel vers la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois ma vie dans la perspective de l'éternité ou seulement du moment présent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui me semble une éternité d'attente est un instant pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a son temps. Allah est au-delà du temps. Le temps est Sa création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec les yeux d'Allah voit l'éternité dans l'instant." }
  ],
  munajat: `Ya Khaliq, Ton temps n'est pas le mien. Aide-moi à patienter en sachant que tout est dans Ta vue éternelle.`
};

MIROIR["32:7"] = {
  reference: "32:7",
  theme: ["création", "perfection", "méditation"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Qui a bien fait tout ce qu'Il a créé. » Le miroir me place devant la perfection de la création. « Ahsana kulla shay'in khalaqahu » — Il a rendu excellent tout ce qu'Il a créé. Chaque créature, chaque atome est parfaitement fait. La création n'a pas de défaut — c'est notre regard qui voit des défauts. Le miroir m'invite à voir la perfection dans tout.`,
  reflection: `La création est parfaite. Ce qui semble imparfait est souvent notre incompréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhi ahsana kulla shay'in khalaqahu » — qui a bien fait tout ce qu'Il a créé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois comme imparfait ? Et si je le voyais avec les yeux d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'imperfection apparente cache souvent une perfection plus profonde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est parfaitement équilibré. Chaque chose a sa place et sa fonction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la perfection partout voit la main du Créateur partout." }
  ],
  munajat: `Ya Musawwir, Tu as bien fait tout ce que Tu as créé. Ouvre mes yeux sur la perfection qui m'entoure et qui m'habite.`
};

MIROIR["32:8"] = {
  reference: "32:8",
  theme: ["création", "humanité", "origine"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Puis Il tira sa descendance d'un élément d'un vil liquide. » Le miroir me montre mon origine humble. « Ma'in mahin » — un liquide vil, méprisable. L'être humain, avec toute sa grandeur, vient d'une goutte de liquide insignifiant. Cette origine humble devrait nous garder dans l'humilité. Le miroir m'interroge : suis-je conscient de mon origine ?`,
  reflection: `Notre grandeur vient d'Allah, pas de nous. Notre origine est humble — notre destinée dépend de Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Min sulaatin min ma'in mahin » — d'un élément d'un liquide vil." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "D'où je viens ? D'une goutte insignifiante. Qui je suis ? La créature d'Allah." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité de l'origine n'enlève rien à la dignité de la créature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie commence petite et humble. La grandeur est dans le développement, pas l'origine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine ne s'enorgueillit jamais." }
  ],
  munajat: `Ya Khaliq, je viens d'une goutte insignifiante. Garde-moi humble. Mais fais de moi quelque chose de beau pour Toi.`
};

MIROIR["32:15"] = {
  reference: "32:15",
  theme: ["prosternation", "coran", "humilité"],
  emotion: "Révérence, abandon",
  difficulty: "débutant",
  relatedNames: ["As-Sajid", "Al-Hakim"],
  mirrorVersion: `« Seuls croient en Nos versets ceux qui, lorsqu'ils sont rappelés, tombent prosternés. » Le miroir me montre la réaction juste face au Coran : la prosternation. Pas intellectuelle, mais physique. Le corps entier répond à la Parole. Les croyants ne discutent pas — ils se prosternent. Le miroir m'interroge : comment je réagis face au Coran ?`,
  reflection: `La prosternation est la réponse du corps à la vérité. L'intellect discute, le cœur se soumet.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kharru sujjadan » — ils tombent prosternés. « Wa sabbahu bi-hamdi rabbihim » — et glorifient par la louange de leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je lis le Coran, est-ce que je me prosterné ? Mon corps répond-il à la Parole ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation n'est pas une humiliation — c'est une élévation vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature se soumet à son Créateur. La prosternation est notre manière de le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prosterne vraiment touche la terre et le ciel en même temps." }
  ],
  munajat: `Ya Sajid, mon corps veut se prosterner devant Ta Parole. Fais que chaque prosternation soit un rapprochement vers Toi.`
};

MIROIR["32:18"] = {
  reference: "32:18",
  theme: ["comparaison", "foi", "mécréance"],
  emotion: "Clarté, discernement",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Fasiq"],
  mirrorVersion: `« Le croyant est-il semblable au pervers ? Ils ne sont pas égaux. » Le miroir me montre l'inégalité fondamentale entre le croyant et le pervers. La foi transforme la personne. Le croyant et le mécréant peuvent se ressembler extérieurement, mais ils sont fondamentalement différents. Le miroir m'interroge : à quel groupe j'appartiens vraiment ?`,
  reflection: `La foi n'est pas une étiquette — c'est une transformation. Le croyant n'est pas semblable au pervers.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal yastawi alladhina amanu wa alladhina asau » — le croyant est-il semblable au pervers ? Non." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si on me comparait à un pervers, quelle serait la différence visible ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La différence n'est pas toujours visible — mais elle est réelle aux yeux d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers distingue le positif du négatif. Le bien et le mal ne sont pas égaux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La vraie différence est dans le cœur — et le cœur se voit dans les actes." }
  ],
  munajat: `Ya Rabb, fais que je sois du côté des croyants. Transforme mon cœur pour que la différence soit visible.`
};

MIROIR["32:24"] = {
  reference: "32:24",
  theme: ["patience", "guidance", "direction"],
  emotion: "Espérance, persévérance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-Hadi"],
  mirrorVersion: `« Nous avons désigné parmi eux des dirigeants qui guidaient selon Notre ordre, parce qu'ils avaient persévéré. » Le miroir me montre le chemin vers le leadership spirituel : la patience. « Sabaru » — ils ont persévéré. Les dirigeants spirituels ne sont pas choisis par hasard. Ils sont ceux qui ont tenu bon. Le miroir m'interroge : est-ce que je persévère ? Suis-je capable de tenir ?`,
  reflection: `Le leadership spirituel vient de la persévérance. La patience est le laboratoire des guides.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-ma sabaru » — à cause de leur persévérance. La patience comme condition du leadership." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je persévère dans les difficultés ? Ou est-ce que j'abandonne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience n'est pas passive — elle est une force active qui construit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est patient. La montagne attend. L'arbre grandit lentement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui persévère reçoit la direction. La patience ouvre les portes." }
  ],
  munajat: `Ya Sabur, apprends-moi la persévérance. Fais que je tienne bon pour devenir celui qui peut guider les autres.`
};

// ==================== SURAH 12: YUSUF (111 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["12:1"] = {
  reference: "12:1",
  theme: ["révélation", "coran", "signes"],
  emotion: "Ouverture, éveil",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Alif, Lam, Ra. Voici les versets du Livre explicite. » Le miroir m'ouvre la plus belle histoire du Coran. « Kitab mubin » — un Livre explicite, clair. L'histoire de Yusuf est la plus détaillée, la plus cohérente, la plus belle des histoires coraniques. Elle parle de trahison, de tentation, de prison, de victoire. Le miroir m'invite à entrer dans ce récit comme dans un miroir de ma propre vie.`,
  reflection: `L'histoire de Yusuf est un miroir pour chaque croyant. Elle montre comment Allah transforme les épreuves en victoires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu al-kitabi al-mubin » — voici les versets du Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que l'histoire de Yusuf me dit de ma propre vie ? Des trahisons, des tentations, des prisons, des victoires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Yusuf a été trahi, tenté, emprisonné — puis élevé. Mon histoire peut suivre le même chemin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de Yusuf est universelle. Chaque culture a des histoires similaires de triomphe après l'épreuve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le sens profond de l'histoire de Yusuf comprend sa propre vie." }
  ],
  munajat: `Ya Hakim, ouvre-moi le sens de l'histoire de Yusuf. Fais que j'y trouve guidance pour ma propre vie.`
};

MIROIR["12:4"] = {
  reference: "12:4",
  theme: ["rêve", "vision", "destin"],
  emotion: "Émerveillement, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Basir", "Al-Khaliq"],
  mirrorVersion: `« Quand Yusuf dit à son père : 'Ô mon père, j'ai vu onze étoiles, et le soleil et la lune se prosternant devant moi.' » Le miroir me place dans le rêve de Yusuf. Onze étoiles = ses frères. Soleil et lune = ses parents. Le rêve annonçait sa future elevation. Mais le chemin vers l'accomplissement du rêve passerait par la trahison et la prison. Le miroir m'interroge : quels rêves Allah a-t-Il mis dans mon cœur ?`,
  reflection: `Les rêves d'Allah s'accomplissent, mais le chemin n'est pas toujours direct. L'épreuve précède l'élévation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innì ra'aytu ahada 'ashara kawkaban » — j'ai vu onze étoiles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle vision Allah a-t-Il mise dans mon cœur ? Suis-je prêt pour le chemin vers son accomplissement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prosternation devant Yusuf n'était pas de l'adoration — c'était de la reconnaissance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les étoiles, le soleil et la lune sont les luminaires du ciel. Ils indiquent la grandeur du destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Les rêves d'Allah s'accomplissent toujours — mais selon Son timing, pas le nôtre." }
  ],
  munajat: `Ya Basir, Tu connais mes rêves. Accompagne-moi vers leur accomplissement. Ne permets pas que je désespère du chemin.`
};

MIROIR["12:18"] = {
  reference: "12:18",
  theme: ["trahison", "patience", "confiance"],
  emotion: "Douleur, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-'Alim"],
  mirrorVersion: `« Et ils apportèrent sa tunique avec une fausse sang. Son père dit : 'Plutôt, vos âmes vous ont suggéré quelque chose. Quelle belle patience !' » Le miroir me place dans le cœur de Ya'qub. Ses fils ont tué son fils préféré — ou du moins il le croit. Et pourtant il dit : « Sabrun jamil » — quelle belle patience. La patience face à la trahison des plus proches. Le miroir m'interroge : comment je réagis à la trahison ?`,
  reflection: `La belle patience (sabrun jamil) est une patience sans plainte amère, sans désespoir, avec confiance en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Sabrun jamil » — belle patience. « Wa Allahu al-musta'an » — et Allah est Celui dont on cherche l'aide." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand on me trahit, est-ce que je patiente avec beauté ? Ou est-ce que je me plains amèrement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La trahison des proches fait plus mal que celle des étrangers. Mais Allah est plus proche que les proches." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre supporte tout ce qu'on lui fait. Elle ne se plaint pas. La patience est une loi de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La belle patience transforme la trahison en élévation." }
  ],
  munajat: `Ya Sabur, apprends-moi la belle patience. Quand on me trahit, fais que je me tourne vers Toi, pas vers l'amertume.`
};

MIROIR["12:23"] = {
  reference: "12:23",
  theme: ["tentation", "chasteté", "refuge"],
  emotion: "Tension, fermeté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Tahhir"],
  mirrorVersion: `« Celle qui le désirait chercha à le séduire. Elle ferma les portes et dit : 'Viens !' Il dit : 'Qu'Allah me protège !' » Le miroir me place dans la tentation. La femme du ministre ferme les portes et invite Yusuf. L'isolement, l'opportunité, la beauté — tout invite au péché. Et Yusuf répond : « Ma'adha Allah » — qu'Allah me protège. Le refuge en Allah avant la tentation. Le miroir m'interroge : où est mon refuge ?`,
  reflection: `La protection d'Allah est invoquée avant la tentation, pas après. La prévention spirituelle précède la lutte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma'adha Allah » — qu'Allah me protège. « Innahu rabbi ahssana mawaya » — c'est mon maître qui m'a fait une bonne demeure." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand la tentation vient, quelle est ma première réponse ? Le refuge en Allah ou l'engagement avec la tentation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Yusuf a refusé par reconnaissance, pas par peur. Son maître l'avait bien traité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature a des limites. Les respecter est une protection, pas une restriction." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le premier « ma'adha Allah » est le bouclier. Le deuxième vient trop tard." }
  ],
  munajat: `Ya Hafiz, protège-moi de la tentation. Fais que mon premier réflexe soit le refuge en Toi. Ne permets pas que je succombe.`
};

MIROIR["12:33"] = {
  reference: "12:33",
  theme: ["prison", "choix", "prière"],
  emotion: "Abandon, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujib", "Al-Fattah"],
  mirrorVersion: `« Il dit : 'Seigneur, la prison m'est plus chère que ce à quoi elles m'invitent.' » Le miroir me montre le choix impossible de Yusuf. L'adultère ou la prison. L'humiliation ou l'incarcération. Et Yusuf choisit la prison plutôt que le péché. Il prie : « Rabbi al-sijnu ahabbu ilayya » — Seigneur, la prison m'est plus chère. Le miroir m'interroge : qu'est-ce que je préfère au péché ?`,
  reflection: `Le choix de la prison plutôt que du péché montre la priorité spirituelle. La souffrance juste vaut mieux que le plaisir injuste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi al-sijnu ahabbu ilayya mimma yad'ununi ilayh » — Seigneur, la prison m'est plus chère que ce à quoi elles m'invitent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je préfère au péché ? Quelle souffrance juste accepterais-je plutôt que le plaisir coupable ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prison apparente peut être une libération spirituelle. Le péché apparent peut être une prison spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chenille dans son cocon est en prison apparente. Elle en sort papillon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui préfère la prison au péché transforme sa prison en palais." }
  ],
  munajat: `Ya Rabb, la prison est plus chère que le péché. Donne-moi la force de choisir la souffrance juste plutôt que le plaisir injuste.`
};

MIROIR["12:56"] = {
  reference: "12:56",
  theme: ["élevation", "autorité", "sagesse"],
  emotion: "Gratitude, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mu'izz", "Al-Hakim"],
  mirrorVersion: `« Ainsi avons-nous donné pouvoir à Yusuf sur le pays. Il y disposait comme il voulait. » Le miroir me montre l'accomplissement du rêve. De la prison au palais. Du puits au trône. L'élevation vient après l'épreuve. « Nusibi fi al-ardi haythu nasha' » — il disposait comme il voulait. Le miroir m'interroge : si j'étais élevé, comment utiliserais-je mon pouvoir ?`,
  reflection: `L'élevation divine vient après l'épreuve. Le pouvoir est un test autant qu'une bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika numkinu li-yusufa fi al-ardi » — ainsi avons-nous donné pouvoir à Yusuf sur le pays." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utiliserais le pouvoir si Allah m'en donnait ? Pour moi ou pour les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Yusuf a utilisé son pouvoir pour sauver les gens de la famine. Le pouvoir est un service." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau élevée dans le ciel retombe en pluie pour nourrir. L'élévation est pour le service." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est élevé par Allah utilise son élévation pour élever les autres." }
  ],
  munajat: `Ya Mu'izz, si Tu m'élèves, fais que j'utilise mon élévation pour le bien. Ne permets pas que le pouvoir me corrompe.`
};

MIROIR["12:64"] = {
  reference: "12:64",
  theme: ["confiance", "protection", "famille"],
  emotion: "Inquiétude, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Wakil"],
  mirrorVersion: `« Votre père a dit : 'Comment vous confierai-je celui-ci, quand je ne vous ai confié son frère que précédemment ?' » Le miroir me place dans le dilemme de Ya'qub. Il doit envoyer Benjamin avec ses frères, mais il a peur. La confiance a été trahie avant. Et pourtant, il finit par confier. « F Allahu khayrun hafizan » — Allah est le meilleur des protecteurs. Le miroir m'interroge : à qui je confie ce qui m'est cher ?`,
  reflection: `La protection d'Allah est la meilleure. Même quand les humains trahissent, Allah ne trahit pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« F Allahu khayrun hafizan wa huwa arhamu al-rahimin » — Allah est le meilleur des protecteurs, et Il est le plus Miséricordieux des miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je confie ce qui m'est cher ? Aux humains qui peuvent trahir, ou à Allah qui ne trahit jamais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Confier à Allah ne signifie pas l'absence de précaution humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mère oiseau confie ses œufs au nid. Mais Allah les protège vraiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui confie à Allah retrouve ce qu'il a confié, amélioré." }
  ],
  munajat: `Ya Hafiz, je Te confie ce qui m'est cher. Protège-le mieux que je ne pourrais le faire. Tu es le meilleur des protecteurs.`
};

MIROIR["12:87"] = {
  reference: "12:87",
  theme: ["espoir", "désespoir", "miséricorde"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Fattah"],
  mirrorVersion: `« Ô mes fils, allez vous informer de Yusuf et de son frère, et ne désespérez pas de la miséricorde d'Allah. » Le miroir me montre la réponse au désespoir. Ya'qub a perdu Yusuf, puis Benjamin. Et pourtant il dit : « La ta'sasu min rawhi Allahi » — ne désespérez pas de la miséricorde d'Allah. L'espoir persiste même quand tout semble perdu. Le miroir m'interroge : où est mon espoir quand tout semble perdu ?`,
  reflection: `Le désespoir de la miséricorde d'Allah est interdit. Tant qu'il y a Allah, il y a espoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hu la ya'sasu min rawhi Allahi illa al-qawmu al-kafirun » — ne désespèrent de la miséricorde d'Allah que les gens mécréants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand tout semble perdu, est-ce que j'espère encore ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le désespoir est un manque de foi, pas un réalisme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'hiver le plus long se termine par le printemps. La nuit la plus sombre précède l'aube." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère en Allah ne perd jamais vraiment." }
  ],
  munajat: `Ya Rahman, je ne désespère pas de Ta miséricorde. Même quand tout semble perdu, Tu peux tout restaurer. Fais que j'espère toujours.`
};

MIROIR["12:90"] = {
  reference: "12:90",
  theme: ["reconnaissance", "révélation", "pardon"],
  emotion: "Stupéfaction, émotion",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mannan", "Al-Ghaffur"],
  mirrorVersion: `« Ils dirent : 'Est-ce que tu es vraiment Yusuf ?' Il dit : 'Je suis Yusuf, et voici mon frère. Allah nous a favorisés.' » Le miroir me place dans le moment de la reconnaissance. Les frères découvrent que le ministre d'Égypte est leur frère vendu. La stupéfaction. Et Yusuf répond par la reconnaissance : « Allah has favorisés » — pas « vous m'avez fait du mal ». Le miroir m'interroge : comment je réponds à ceux qui m'ont fait du mal ?`,
  reflection: `La reconnaissance à Allah transforme le ressentiment en gratitude. Yusuf voit la main d'Allah derrière tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ana Yusufu wa hadha akhi » — je suis Yusuf et voici mon frère. « Qad mannana Allahu 'ala al-muhsinin » — Allah nous a favorisés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je traite ceux qui m'ont fait du mal ? Avec vengeance ou avec reconnaissance à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mal que les frères ont fait à Yusuf, Allah l'a transformé en bien. C'est pourquoi Yusuf n'a pas de ressentiment." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La graine doit être enterrée et « tuée » pour devenir plante. Le mal apparent devient le bien réel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la main d'Allah derrière tout n'a pas de ressentiment envers personne." }
  ],
  munajat: `Ya Mannan, Tu as transformé le mal en bien dans ma vie. Aide-moi à voir Ta main derrière tout. Ne permets pas que le ressentiment m'habite.`
};

MIROIR["12:92"] = {
  reference: "12:92",
  theme: ["pardon", "reproche", "générosité"],
  emotion: "Libération, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Al-Karim"],
  mirrorVersion: `« Il dit : 'Aucun reproche contre vous aujourd'hui. Qu'Allah vous pardonne. C'est Lui le plus Miséricordieux des miséricordieux.' » Le miroir me montre le pardon total. Les frères ont vendu Yusuf, menti à leur père pendant des années. Et Yusuf dit : « La tathriba 'alaykum al-yawm » — aucun reproche aujourd'hui. Le pardon complet, sans conditions, sans arrière-pensées. Le miroir m'interroge : qu'est-ce que je retiens contre les autres ?`,
  reflection: `Le pardon sans reproche est le pardon divin. Il libère le pardonné et le pardonneur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tathriba 'alaykum al-yawm » — aucun reproche contre vous aujourd'hui. « Yaghfira Allahu lakum » — qu'Allah vous pardonne." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui est-ce que je fais des reproches ? Qu'est-ce que je n'ai pas pardonné ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'efface pas le passé — il libère l'avenir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau nettoie les traces. Le pardon nettoie les cœurs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne vraiment oublie le reproche, pas l'enseignement." }
  ],
  munajat: `Ya Ghaffur, Tu me pardonnes sans reproche. Apprends-moi à faire de même. Libère-moi du ressentiment et du désir de reproche.`
};

MIROIR["12:111"] = {
  reference: "12:111",
  theme: ["histoire", "leçon", "guidance"],
  emotion: "Gratitude, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Dans leurs récits, il y a une leçon pour les doués d'intelligence. Ce n'est pas un récit inventé. » Le miroir me montre la conclusion de l'histoire de Yusuf. Les récits des prophètes ne sont pas des histoires pour divertir — ils sont des leçons. « Laqad kana fi qasasihim 'ibratun » — dans leurs récits, il y a une leçon. Le miroir m'interroge : qu'est-ce que j'ai appris de l'histoire de Yusuf ?`,
  reflection: `Les récits coraniques sont des leçons vivantes. Chaque histoire est un miroir pour notre propre vie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Laqad kana fi qasasihim 'ibratun li-uli al-albab » — dans leurs récits, il y a une leçon pour les doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai retenu de l'histoire de Yusuf ? Comment elle s'applique à ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'histoire n'est pas du passé — elle est vivante pour qui sait lire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de l'humanité est une répétition de thèmes universels. Les leçons traversent les temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les histoires des prophètes trouve la guidance pour sa propre histoire." }
  ],
  munajat: `Ya Hakim, merci pour les récits des prophètes. Fais que j'y trouve des leçons pour ma vie. Ne permets pas que je les lise comme de simples histoires.`
};

// ==================== SURAH 33: AL-AHZAB (73 verses) - Additional ====================

MIROIR["33:4"] = {
  reference: "33:4",
  theme: ["vérité", "adoption", "famille"],
  emotion: "Clarté, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khaliq"],
  mirrorVersion: `« Allah n'a pas mis deux cœurs dans la poitrine d'un homme. » Le miroir me montre l'unité de la personne. Un homme n'a pas deux cœurs — il est un. De même, Allah n'a pas fait de vos fils adoptifs vos vrais fils. La vérité des relations doit être respectée. Le miroir m'interroge : est-ce que je vis dans la vérité de mes relations ou dans des fictions ?`,
  reflection: `La vérité des relations ne peut être changée par des mots. L'adoption ne change pas la filiation biologique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma ja'ala Allahu li-rajulin min qalbayni fi jawfihi » — Allah n'a pas mis deux cœurs dans la poitrine d'un homme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles fictions je maintiens dans mes relations ? Quelles vérités j'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité est dure mais libératrice. Le mensonge est doux mais emprisonnant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas. Chaque chose est ce qu'elle est." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit dans la vérité n'a pas peur de la découverte." }
  ],
  munajat: `Ya Haqq, fais que je vive dans la vérité. Ne permets pas que je me mente à moi-même ou aux autres.`
};

MIROIR["33:6"] = {
  reference: "33:6",
  theme: ["prophète", "famille", "priorité"],
  emotion: "Amour, respect",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Wali"],
  mirrorVersion: `« Le Prophète a plus de droit sur les croyants qu'ils n'en ont sur eux-mêmes. » Le miroir me montre la place centrale du Prophète dans la vie du croyant. Il a plus de droit sur nous que nous-mêmes. Son amour, son respect, son obéissance sont prioritaires. Le miroir m'interroge : est-ce que je donne au Prophète la place qu'il mérite dans ma vie ?`,
  reflection: `Le Prophète est le modèle et le guide. L'aimer, c'est l'écouter et le suivre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-nabi awla bi-l-mu'minina min anfusihim » — le Prophète a plus de droit sur les croyants qu'eux-mêmes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'aime le Prophète plus que moi-même ? Est-ce que je le priorise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner la priorité au Prophète n'est pas une perte — c'est un gain de direction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur. Le croyant obéit au Prophète du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète atteint ce que le Prophète a atteint." }
  ],
  munajat: `Ya Rabb, fais que j'aime Ton Prophète plus que moi-même. Donne-lui la première place dans ma vie.`
};

MIROIR["33:22"] = {
  reference: "33:22",
  theme: ["épreuve", "foi", "confiance"],
  emotion: "Courage, foi",
  difficulty: "débutant",
  relatedNames: ["Al-Mu'min", "Al-Wakil"],
  mirrorVersion: `« Quand les croyants virent les coalisés, ils dirent : 'C'est ce qu'Allah et Son messager nous avaient promis.' » Le miroir me montre la foi face à l'épreuve. Les croyants ont vu l'ennemi et ont reconnu la promesse d'Allah. Pas de panique — de la confiance. L'épreuve confirmait la promesse. Le miroir m'interroge : comment je réagis face aux épreuves ? Avec panique ou avec confiance ?`,
  reflection: `L'épreuve n'est pas une surprise pour le croyant — elle est l'accomplissement de la promesse divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu hadha ma wa'adana Allahu wa rasuluhu » — c'est ce qu'Allah et Son messager nous avaient promis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand l'épreuve arrive, est-ce que je vois la promesse ou seulement le problème ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve qui effraie le mécréant rassure le croyant — car elle confirme la promesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une épreuve pour l'être humain. Chaque moment teste notre foi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la promesse dans l'épreuve passe l'épreuve avec succès." }
  ],
  munajat: `Ya Rabb, quand l'épreuve vient, fais que je voie Ta promesse. Donne-moi la confiance des croyants.`
};

MIROIR["33:41"] = {
  reference: "33:41",
  theme: ["rappel", "dhikr", "présence"],
  emotion: "Ferveur, constance",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhakir", "Al-Madhkur"],
  mirrorVersion: `« Ô vous qui croyez ! Evoquez Allah d'une façon abondante. » Le miroir me place devant l'invitation au dhikr constant. « Kathiran » — abondamment, beaucoup. Pas une fois par jour, mais constamment. Le rappel d'Allah devrait être l'arrière-plan de toute notre journée. Le miroir m'interroge : combien de fois par jour j'évoque Allah ?`,
  reflection: `Le dhikr est l'oxygène de l'âme. Sans rappel constant, l'âme s'étouffe.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udhkuru Allaha dhikran kathiran » — évoquez Allah d'une façon abondante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de fois aujourd'hui j'ai pensé à Allah ? Est-ce abondant ou rare ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'évocation d'Allah n'est pas pour Lui — elle est pour nous. Elle nous maintient connectés." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier évoque Allah par son existence. L'homme le fait consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évoque Allah constamment vit en Sa présence constante." }
  ],
  munajat: `Ya Rabb, fais que mon cœur T'évoque sans cesse. Que chaque souffle soit un dhikr, chaque instant un rappel.`
};

MIROIR["33:42"] = {
  reference: "33:42",
  theme: ["dhikr", "constance", "temps"],
  emotion: "Persévérance, présence",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhakir", "As-Subuh"],
  mirrorVersion: `« Et glorifiez-Le à la pointe et au cœur de la journée. » Le miroir me montre les moments du dhikr : « bukratan wa asilan » — le matin et le soir, le début et la fin. Toute la journée est encadrée par le rappel. Le miroir m'invite à rythmer ma journée par le dhikr.`,
  reflection: `La journée du croyant commence et finit par le rappel. Le dhikr est le battement de cœur spirituel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa sabbihuhu bukratan wa asilan » — et glorifiez-Le le matin et le soir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je commence et finis ma journée ? Par le rappel ou par les distractions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le dhikr du matin illumine la journée. Le dhikr du soir apaise la nuit." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube et le crépuscule sont des moments de transition. Allah nous invite à les marquer par le rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui encadre sa journée par le dhikr vit dans le flux du rappel constant." }
  ],
  munajat: `Ya Rabb, fais que ma journée soit encadrée par Ton rappel. Le matin, je Te glorifie. Le soir, je Te remercie.`
};

// ==================== SURAH 34: SABA (54 verses) - Additional ====================

MIROIR["34:3"] = {
  reference: "34:3",
  theme: ["science", "infini", "certitude"],
  emotion: "Émerveillement, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Khabir"],
  mirrorVersion: `« Ceux qui ne croient pas disent : 'L'Heure ne nous viendra pas.' Dis : 'Si, par mon Seigneur, elle vous viendra certainement.' » Le miroir me place devant la certitude de l'Heure. Les négateurs doutent, mais le croyant sait. « La yu'jizu » — rien ne L'empêche. Allah connaît tout, même ce qui est caché dans les cieux et la terre. Le miroir m'invite à la certitude.`,
  reflection: `L'Heure viendra certainement. La certitude du croyant contraste avec le doute du mécréant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La ya'lamu al-ghayba illa Allah » — nul ne connaît l'invisible excepté Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec la certitude de l'Heure ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de l'Heure transforme le présent. Chaque moment devient précieux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier tend vers sa fin. L'Heure est inscrite dans le temps lui-même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit certain de l'Heure vit chaque instant comme s'il était le dernier." }
  ],
  munajat: `Ya 'Alim, je suis certain de l'Heure. Fais que cette certitude transforme ma vie aujourd'hui.`
};

MIROIR["34:15"] = {
  reference: "34:15",
  theme: ["signes", "gratitude", "jardin"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Il y avait pour Saba un signe dans leur habitation : deux jardins, l'un à droite et l'autre à gauche. » Le miroir me montre les signes dans les bénédictions. Saba avait deux jardins — une abondance visible. « Mangez de ce que votre Seigneur vous a attribué et remerciez-Le. » Le signe appelle à la gratitude. Le miroir m'interroge : quels jardins Allah m'a-t-Il donnés ? Est-ce que je les vois et les remercie ?`,
  reflection: `Les bénédictions sont des signes qui appellent à la gratitude. Les ignorer, c'est ignorer le Donateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatani 'an yaminin wa shamili » — deux jardins, à droite et à gauche." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont mes « jardins » ? Les bénédictions que je prends pour acquises ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les jardins peuvent devenir un test. L'ingratitude peut les transformer en désert." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est un jardin pour l'humanité. La reconnaître, c'est reconnaître le Jardinier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le signe dans la bénédiction reçoit la bénédiction dans le signe." }
  ],
  munajat: `Ya Razzaq, Tu m'as donné des jardins. Ouvre mes yeux pour les voir et ma langue pour Te remercier.`
};

MIROIR["34:33"] = {
  reference: "34:33",
  theme: ["excuse", "responsabilité", "jugement"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Les faibles diront aux orgueilleux : 'C'est votre ruse de nuit et de jour qui nous a égarés.' » Le miroir me montre le moment où les excuses s'effondrent. Les faibles blâment les forts, mais les forts rétorquent : « Vous ne croyiez pas. » Au final, chacun est responsable de ses choix. Le miroir m'interroge : qui je blâme pour mes propres erreurs ?`,
  reflection: `Les excuses ne fonctionneront pas au Jour dernier. Chacun est responsable de ses propres choix.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma kuntum tu'minun » — vous ne croyiez pas. La responsabilité individuelle est claire." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui je blâme pour mes erreurs ? Les autres, les circonstances, ou moi-même ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Blâmer les autres ne change rien. Assumer sa responsabilité, c'est le premier pas vers le changement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne connaît pas les excuses. Chaque action a une conséquence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui assume sa responsabilité maintenant n'aura pas à s'excuser au Jour dernier." }
  ],
  munajat: `Ya Rabb, je prends la responsabilité de mes choix. Ne permets pas que je blâme les autres. Aide-moi à changer.`
};

// ==================== SURAH 35: FATIR (45 verses) - Additional ====================

MIROIR["35:3"] = {
  reference: "35:3",
  theme: ["faveur", "gratitude", "bienfait"],
  emotion: "Reconnaissance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Karim"],
  mirrorVersion: `« Ô hommes ! La faveur d'Allah sur vous est immense. Y a-t-il un autre créateur qu'Allah qui vous attribue du ciel et de la terre ? » Le miroir me place devant l'immensité des faveurs divines. Tout ce que nous avons vient d'Allah. Nul autre ne peut donner. Le miroir m'interroge : est-ce que je reconnais la source de tout ce que j'ai ?`,
  reflection: `Toute faveur vient d'Allah. Reconnaître la source, c'est ouvrir la porte à plus de faveurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ni'ma Allah » — la faveur d'Allah. « Hal min khaliqin ghayru Allah » — y a-t-il un créateur autre qu'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai qui ne vient pas d'Allah ? La réponse est : rien." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Reconnaître la source ne diminue pas le don — elle le magnifie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une faveur d'Allah. Chaque créature reçoit Sa grâce." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la faveur d'Allah reçoit Sa gratitude en retour." }
  ],
  munajat: `Ya Mannan, Ta faveur sur moi est immense. Ouvre mes yeux sur tout ce que Tu m'as donné. Fais que je sois reconnaissant.`
};

MIROIR["35:5"] = {
  reference: "35:5",
  theme: ["promesse", "tromperie", "monde"],
  emotion: "Lucidité, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wa'd", "Al-Haqq"],
  mirrorVersion: `« Ô hommes ! La promesse d'Allah est vérité. Que la vie présente ne vous trompe pas. » Le miroir me place devant le contraste entre la promesse d'Allah et les illusions de ce monde. « La yaghurannakumu al-hayat ad-dunya » — que la vie présente ne vous trompe pas. Ce monde est un leurre. La vraie vie est ailleurs. Le miroir m'interroge : qu'est-ce qui me trompe dans ce monde ?`,
  reflection: `Ce monde est une illusion passagère. La promesse d'Allah est la réalité éternelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna wa'da Allahi haqq » — la promesse d'Allah est vérité. « La yaghurannakumu al-hayat ad-dunya » — que la vie présente ne vous trompe pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me trompe dans ce monde ? L'argent, le statut, les plaisirs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le monde trompe ceux qui s'y attachent. Il éclaire ceux qui le traversent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers passe. Seul Allah reste. La promesse d'Allah est ancrée dans l'éternité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la tromperie du monde ne s'y laisse pas prendre." }
  ],
  munajat: `Ya Rabb, ne permets pas que ce monde me trompe. Ancre-moi dans Ta promesse éternelle.`
};

MIROIR["35:29"] = {
  reference: "35:29",
  theme: ["lecture", "prière", "charité"],
  emotion: "Engagement, constance",
  difficulty: "débutant",
  relatedNames: ["Al-Qari", "Al-Musalli"],
  mirrorVersion: `« Ceux qui récitent le Livre d'Allah, accomplissent la prière et dépensent de ce que Nous leur avons attribué. » Le miroir me montre les trois pratiques du croyant : la lecture du Coran, la prière, et la charité. Ces trois actes forment un tout. La lecture nourrit, la prière connecte, la charité partage. Le miroir m'interroge : est-ce que je pratique ces trois ?`,
  reflection: `La vie spirituelle est un équilibre entre recevoir (lecture, prière) et donner (charité).`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatluna kitaba Allah » — récitent le Livre d'Allah. « Wa aqamu as-salata » — accomplissent la prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran ? Est-ce que je prie ? Est-ce que je donne ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Lire sans prier est incomplet. Prier sans donner est égoïste. Donner sans lire est aveugle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit et donne en permanence. Le croyant fait de même consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Ces trois pratiques sont les piliers d'une vie équilibrée et connectée à Allah." }
  ],
  munajat: `Ya Rabb, fais que je lise Ton Livre, que je prie avec constance, que je donne généreusement. Unifie ces pratiques en moi.`
};

// ==================== SURAH 36: YA-SIN (83 verses) - Additional ====================

MIROIR["36:7"] = {
  reference: "36:7",
  theme: ["décret", "parole", "certitude"],
  emotion: "Humilité, acceptation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadar", "Al-Qa'il"],
  mirrorVersion: `« La parole a été réalisée contre la plupart d'entre eux : ils ne croiront pas. » Le miroir me place devant le décret divin. Certains sont destinés à ne pas croire. Ce n'est pas une injustice — c'est la conséquence de leurs choix accumulés. Le miroir m'invite à la gratitude : je suis parmi ceux qui croient.`,
  reflection: `La foi est un don. Être parmi les croyants n'est pas un mérite mais une grâce.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La qada al-qawlu 'ala aktharihim » — la parole a été réalisée contre la plupart d'entre eux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je reconnaissant d'être parmi les croyants ? Est-ce que je considère la foi comme un don ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le décret sur les autres m'apprend la gratitude pour mon propre sort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit au décret. Chaque chose suit son destin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend le décret ne s'enorgueillit pas de sa foi — il remercie." }
  ],
  munajat: `Ya Rabb, merci pour la foi. Fais que je ne la prenne jamais pour acquise. Protège mon cœur de l'égarement.`
};

MIROIR["36:33"] = {
  reference: "36:33",
  theme: ["résurrection", "signes", "vie"],
  emotion: "Émerveillement, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Ba'ith"],
  mirrorVersion: `« Et un signe pour eux est la terre morte que Nous avons fait revivre. » Le miroir me montre la résurrection dans la nature. La terre morte devient vivante. La mort précède la vie. La résurrection est inscrite dans le cycle naturel. Le miroir m'invite à voir le signe de la résurrection partout.`,
  reflection: `La nature meurt et ressuscite chaque année. La résurrection n'est pas un miracle isolé — c'est une loi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-ardu al-maytatu » — la terre morte. « Ahyaynaha » — Nous l'avons fait revivre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois la nature revivre au printemps, est-ce que je pense à ma propre résurrection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort de la terre n'est pas une fin — c'est une préparation à la nouvelle vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier connaît le cycle mort-résurrection. Le grain meurt pour devenir épi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la résurrection dans la nature croit en sa propre résurrection." }
  ],
  munajat: `Ya Muhyi, Tu fais revivre la terre morte. Fais revivre mon cœur aussi. Donne-moi la certitude de ma résurrection.`
};

MIROIR["36:60"] = {
  reference: "36:60",
  theme: ["alliance", "iblis", "obéissance"],
  emotion: "Rappel, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Wali", "Ash-Shaytan"],
  mirrorVersion: `« Ne vous ai-Je pas engagés, enfants d'Adam, à ne pas adorer le Diable ? » Le miroir me place devant l'alliance primordiale. Allah a demandé aux humains de ne pas suivre Iblis. Pourquoi ? « Innehu aduwun mubin » — il est un ennemi déclaré. Le chemin d'Iblis est le chemin de l'égarement. Le miroir m'interroge : qui je suis ?`,
  reflection: `L'ennemi est clairement identifié. Le suivre, c'est s'égarer. Le rejeter, c'est se protéger.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam a'had ilaykum ya bani Adama » — ne vous ai-Je pas engagés, enfants d'Adam ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis les suggestions d'Iblis ? Ses murmures sont-ils mes guides ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Iblis promet le plaisir mais mène à la perte. Allah commande l'effort mais mène au Paradis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a qu'un seul ennemi : le désordre. Iblis est le désordre dans le monde spirituel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît Iblis comme ennemi se protège de lui." }
  ],
  munajat: `Ya Rabb, je Te promets de ne pas suivre Iblis. Protège-moi de ses suggestions. Guide-moi vers Toi seul.`
};

// ==================== SURAH 37: AS-SAFFAT (182 verses) - Additional ====================

MIROIR["37:1"] = {
  reference: "37:1",
  theme: ["anges", "rang", "adoration"],
  emotion: "Révérence, émerveillement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "As-Saffat"],
  mirrorVersion: `« Par ceux qui sont rangés en rangs ! » Le miroir me place devant l'armée céleste. Les anges en rangs, en ordre parfait. « As-saffat » — ceux qui se rangent. L'ordre est une caractéristique de la création céleste. Le miroir m'invite à l'ordre dans ma propre vie spirituelle.`,
  reflection: `L'ordre est une forme d'adoration. Les anges adorent en rangs. L'humain adore avec discipline.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa as-saffati saffa » — par ceux qui sont rangés en rangs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma vie est ordonnée ? Ou est-ce que le chaos domine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ordre n'est pas une contrainte — c'est une forme de beauté et d'efficacité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est ordonné. Les planètes suivent leurs orbites. Les anges suivent leurs rangs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui met de l'ordre dans sa vie participe à l'ordre universel." }
  ],
  munajat: `Ya Rabb, les anges sont rangés en ordre parfait. Fais que ma vie soit ordonnée comme la leur.`
};

MIROIR["37:84"] = {
  reference: "37:84",
  theme: ["ibrahim", "pureté", "foi"],
  emotion: "Admiration, aspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Khalil", "Al-Hanif"],
  mirrorVersion: `« Quand il vint à son Seigneur avec un cœur pur. » Le miroir me place devant l'exemple d'Ibrahim. « Qalbin salim » — un cœur pur, sain, sans maladie spirituelle. Ibrahim est venu à Allah avec ce cœur pur. Le miroir m'interroge : avec quel cœur je viens à Allah ?`,
  reflection: `Le cœur pur est le plus grand trésor. Tout le reste est secondaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bi-qalbin salim » — avec un cœur pur. Le cœur sain, sans maladie spirituelle." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui souille mon cœur ? La rancune, l'envie, l'orgueil, le doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cœur pur n'est pas un cœur parfait — c'est un cœur qui se tourne sincèrement vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est pur par nature. Le cœur humain peut le redevenir par la grâce d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur pur voit Allah. Le cœur souillé ne voit que lui-même." }
  ],
  munajat: `Ya Rabb, purifie mon cœur. Enlève la rouille des péchés et des mauvaises intentions. Fais que je vienne à Toi comme Ibrahim.`
};

MIROIR["37:180"] = {
  reference: "37:180",
  theme: ["gloire", "transcendance", "pureté"],
  emotion: "Adoration, révérence",
  difficulty: "débutant",
  relatedNames: ["As-Subuh", "Al-'Azim"],
  mirrorVersion: `« Gloire à ton Seigneur, le Seigneur de la puissance, Il est au-dessus de ce qu'ils décrivent. » Le miroir me place devant la transcendance absolue d'Allah. « Subhana » — gloire, pureté. « Ta'ama » — Il est au-dessus. Les descriptions humaines ne peuvent L'atteindre. Le miroir m'invite à l'adoration silencieuse.`,
  reflection: `Allah est au-dessus de toute description. L'adoration est la meilleure réponse à Sa transcendance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subhana rabbika rabb al-'izzati 'amma yasifun » — gloire à ton Seigneur, le Seigneur de la puissance." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je décris Allah ? Mes mots sont-ils à la hauteur de Sa réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incapacité à décrire n'est pas une limite — c'est une invitation à l'adoration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier témoigne de la gloire d'Allah sans pouvoir La décrire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le silence d'adoration dit plus que mille mots sur Allah." }
  ],
  munajat: `Ya Subuh, Tu es au-dessus de tout ce que je peux dire. Je me tais et j'adore. Gloire à Toi.`
};

// ==================== SURAH 38: SAD (88 verses) - Additional ====================

MIROIR["38:1"] = {
  reference: "38:1",
  theme: ["rappel", "coran", "serment"],
  emotion: "Attention, révérence",
  difficulty: "intermédiaire",
  relatedNames: ["Adh-Dhikr", "Al-Qur'an"],
  mirrorVersion: `« Sad. Par le Coran, au rappel. » Le miroir me place devant le Coran comme rappel. « Dhikr » — rappel, mention. Le Coran nous rappelle ce que nous avons oublié : notre origine, notre but, notre relation avec Allah. Le miroir m'interroge : de quoi le Coran me rappelle-t-il aujourd'hui ?`,
  reflection: `Le Coran est un rappel constant. L'oubli est notre état naturel ; le rappel est notre remède.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-Qur'ani dhi al-dhikr » — par le Coran, au rappel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai oublié que le Coran devrait me rappeler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le rappel n'est pas une contrainte — c'est un retour à ce qui est essentiel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'oublie pas. Chaque créature accomplit sa fonction. L'homme oublie et a besoin du rappel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le rappel se souvient de son essence." }
  ],
  munajat: `Ya Rabb, fais que le Coran soit mon rappel constant. Ne permets pas que j'oublie ce qui est essentiel.`
};

MIROIR["38:29"] = {
  reference: "38:29",
  theme: ["méditation", "coran", "rappel"],
  emotion: "Réflexion, application",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Hikmah"],
  mirrorVersion: `« Un Livre béni que Nous avons fait descendre sur toi, pour qu'ils méditent ses versets et que les doués d'intelligence réfléchissent. » Le miroir me montre le but du Coran : la méditation et la réflexion. Pas seulement la lecture, mais la contemplation profonde. « Li-yatadabbaru » — pour qu'ils méditent. Le miroir m'interroge : est-ce que je médite le Coran ?`,
  reflection: `Le Coran demande plus que la lecture — il demande la méditation profonde.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yatadabbaru ayatihi » — pour qu'ils méditent ses versets. « Wa li-tazakkara ulu al-albab » — et que se rappellent les doués d'intelligence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je lis le Coran ? Vite ou avec méditation ? Pour la récitation ou pour la compréhension ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La méditation du Coran est un dialogue — le Texte parle, le cœur répond." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un livre à méditer. Le Coran en est le résumé et le guide." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite le Coran avec le cœur reçoit des secrets inaccessibles à l'intellect seul." }
  ],
  munajat: `Ya Rabb, fais que je médite Ton Livre. Ouvre mon cœur à Ses secrets. Fais que chaque verset transforme ma vie.`
};

// ==================== SURAH 39: AZ-ZUMAR (75 verses) - Additional ====================

MIROIR["39:2"] = {
  reference: "39:2",
  theme: ["religion", "sincérité", "monothéisme"],
  emotion: "Engagement, vérité",
  difficulty: "débutant",
  relatedNames: ["Ad-Din", "Al-Hanif"],
  mirrorVersion: `« Nous avons fait descendre sur toi le Livre avec la vérité. Adore donc Allah en Lui vouant un culte exclusif. » Le miroir me place devant l'exigence de la sincérité. « Mukhlisan » — sincère, exclusif. L'adoration d'Allah doit être pure, sans mélange. Le miroir m'interroge : mon adoration est-elle exclusive à Allah ?`,
  reflection: `La sincérité est la clé de l'acceptation. Une adoration mélangée n'est pas une adoration.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa u'budu Allahi mukhlisan lahu ad-din » — adore Allah en Lui vouant un culte exclusif." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À qui je voue mon adoration ? À Allah seul ou à d'autres avec Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité n'est pas une fermeture — c'est une ouverture totale vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers adore Allah exclusivement. Chaque créature accomplit sa fonction sans détour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'adoration exclusive ouvre la porte de l'intimité divine." }
  ],
  munajat: `Ya Rabb, je veux T'adorer exclusivement. Purifie mon intention de tout mélange. Fais que je sois à Toi seul.`
};

MIROIR["39:7"] = {
  reference: "39:7",
  theme: ["indépendance", "reconnaissance", "mécréance"],
  emotion: "Humilité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ghani", "Al-Hamid"],
  mirrorVersion: `« Si vous êtes ingrats, Allah Se suffit à Lui-même. » Le miroir me place devant l'indépendance absolue d'Allah. « Ghani » — riche, indépendant. Il n'a besoin de rien. Ma gratitude est pour moi, pas pour Lui. Mon ingratitude ne L'affecte pas. Le miroir m'invite à la gratitude pour mon propre bien.`,
  reflection: `Allah n'a pas besoin de ma gratitude. Moi, j'ai besoin de L'être reconnaissant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In takfuru fa inna Allaha ghaniyyun 'ankum » — si vous êtes ingrats, Allah Se suffit à Lui-même." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pourquoi je suis reconnaissant ? Par devoir ou par compréhension que c'est pour mon bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ingratitude ne blesse pas Allah — elle blesse celui qui est ingrat." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas besoin d'être remercié. Mais le remerciement élève celui qui remercie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La gratitude est le pont entre la créature et le Créateur." }
  ],
  munajat: `Ya Ghani, Tu n'as pas besoin de moi, mais j'ai besoin de Toi. Fais que je sois reconnaissant pour mon propre bien.`
};

MIROIR["39:10"] = {
  reference: "39:10",
  theme: ["piété", "récompense", "promesse"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Muttaqi", "Al-Wa'd"],
  mirrorVersion: `« Dis : Ô Mes serviteurs qui avez cru, craignez votre Seigneur. Ceux qui font le bien ici-bas auront une bonne récompense. » Le miroir me montre la promesse d'Allah aux croyants. La taqwa — la crainte révérencielle — ouvre la porte à la récompense. « Husnan » — une bonne récompense. Le miroir m'invite à la piété.`,
  reflection: `La piété n'est pas une peur — c'est une conscience qui guide vers le bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya 'ibadi alladhina amanu ittaqu rabbakum » — ô Mes serviteurs qui avez cru, craignez votre Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains Allah comme Il le mérite ? Ma crainte me pousse-t-elle vers le bien ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La crainte qui paralyse n'est pas la taqwa. La taqwa est la crainte qui motive." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier « craint » Allah en Lui obéissant parfaitement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La taqwa est la clé qui ouvre toutes les portes du bien." }
  ],
  munajat: `Ya Rabb, enseigne-moi la taqwa. Fais que ma crainte de Toi me pousse vers le bien et la récompense.`
};

// ==================== SURAH 40: GHAFIR (85 verses) - Additional ====================

MIROIR["40:2"] = {
  reference: "40:2",
  theme: ["révélation", "puissance", "connaissance"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-'Alim"],
  mirrorVersion: `« La révélation du Livre vient d'Allah, le Puissant, l'Omniscient. » Le miroir me place devant l'origine du Coran. « 'Aziz » — Puissant, Invincible. « 'Alim » — Omniscient, Tout-Connaissant. Le Coran vient de cette Source. Le miroir m'invite à recevoir le Coran avec la révérence qu'il mérite.`,
  reflection: `Le Coran n'est pas un livre ordinaire. Il vient du Puissant Omniscient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitabi min Allahi al-'azizi al-'alim » — révélation du Livre d'Allah, le Puissant, l'Omniscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je reçois le Coran ? Comme un livre parmi d'autres ou comme la parole du Puissant Omniscient ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance du Créateur donne autorité à Sa parole. La connaissance du Créateur donne profondeur à Sa parole." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit au Puissant. Le Coran nous invite à faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran comme venant du Puissant Omniscient reçoit puissance et connaissance." }
  ],
  munajat: `Ya 'Aziz, Ya 'Alim, Ton Livre est révélé. Fais que je le reçoive avec la révérence qu'il mérite.`
};

MIROIR["40:4"] = {
  reference: "40:4",
  theme: ["argumentation", "mécréance", "signes"],
  emotion: "Sérénité, lucidité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Burhan", "Al-Haqq"],
  mirrorVersion: `« Seuls argumentent au sujet des signes d'Allah ceux qui ont mécru. » Le miroir me montre que l'argumentation sur les signes d'Allah est un signe de mécréance. Le croyant accepte. Le mécréant argue. Le miroir m'interroge : est-ce que j'argumente sur les signes d'Allah ou est-ce que je les accepte ?`,
  reflection: `L'argumentation sur les signes révèle un cœur fermé. L'acceptation révèle un cœur ouvert.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma yujadilu fi ayati Allahi illa alladhina kafaru » — seuls argumentent sur les signes d'Allah ceux qui ont mécru." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'argumente au lieu d'accepter ? Où est mon doute au lieu de ma confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argumentation n'est pas une quête de vérité — c'est souvent une résistance à la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'argumente pas avec son Créateur. Il obéit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes sans argumenter reçoit leur lumière." }
  ],
  munajat: `Ya Rabb, ne permets pas que j'argumente sur Tes signes. Fais que je les accepte avec un cœur ouvert.`
};

MIROIR["40:13"] = {
  reference: "40:13",
  theme: ["signes", "vie", "mort"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Muhyi", "Al-Mumit"],
  mirrorVersion: `« C'est Lui qui vous fait voir Ses signes et fait descendre du ciel une provision pour vous. » Le miroir me montre les signes visibles d'Allah. « Yurikum ayatihi » — Il vous fait voir Ses signes. « Yunazzilu mina as-sama'i rizqan » — Il fait descendre du ciel une provision. Les signes et la provision sont liés. Le miroir m'invite à voir les signes dans la provision.`,
  reflection: `Chaque bénédiction est un signe. Chaque signe est une bénédiction. Les voir, c'est reconnaître le Donateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi yurikum ayatihi » — c'est Lui qui vous fait voir Ses signes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes je vois aujourd'hui ? La pluie, le soleil, la nourriture — tous sont Ses signes." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision ne vient pas du ciel par hasard — elle vient d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est provision et signe. Chaque créature reçoit et témoigne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit le signe dans la provision ne manque jamais de reconnaissance." }
  ],
  munajat: `Ya Rabb, montre-moi Tes signes. Fais que je voie Ta provision comme un don de Ton amour.`
};

// ==================== SURAH 41: FUSSILAT (54 verses) - Additional ====================

MIROIR["41:2"] = {
  reference: "41:2",
  theme: ["révélation", "miséricorde", "avertissement"],
  emotion: "Attention, espérance",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "An-Nadhir"],
  mirrorVersion: `« Révélation du Tout-Miséricordieux, du Très-Miséricordieux. » Le miroir me montre la double nature du Coran : miséricorde et avertissement. « Rahman » et « Rahim » — les deux noms de miséricorde. Le Coran est une miséricorde qui avertit. Le miroir m'invite à recevoir la miséricorde et à entendre l'avertissement.`,
  reflection: `La miséricorde d'Allah inclut l'avertissement. Avertir, c'est protéger de la perte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzilun min ar-rahmani ar-rahim » — révélation du Tout-Miséricordieux, du Très-Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je reçois l'avertissement du Coran ? Comme une contrainte ou comme une protection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement est la forme la plus haute de la miséricorde — elle prévient la perte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers avertit par ses lois. Qui les ignore souffre. Le Coran avertit par ses versets." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entend l'avertissement comme miséricorde se protège du mal." }
  ],
  munajat: `Ya Rahman, Ya Rahim, Ton Coran est miséricorde. Fais que j'entende Ton avertissement comme Ton amour.`
};

MIROIR["41:33"] = {
  reference: "41:33",
  theme: ["invitation", "bien", "modèle"],
  emotion: "Aspiration, motivation",
  difficulty: "débutant",
  relatedNames: ["Ad-Da'i", "Al-Hasan"],
  mirrorVersion: `« Qui profère une meilleure parole que celui qui appelle à Allah, fait le bien et dit : 'Je suis des musulmans' ? » Le miroir me montre le meilleur discours : l'appel à Allah. « Ahsanu qawlan » — la meilleure parole. Appeler à Allah, faire le bien, se déclarer musulman. Le miroir m'interroge : quelle est ma parole ?`,
  reflection: `La meilleure parole est celle qui appelle à Allah. Le meilleur acte est celui qui Le sert.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man ahsanu qawlan » — qui profère une meilleure parole ? « Da'iyan ila Allah » — appelant à Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma parole quotidienne ? Appelle-t-elle à Allah ou à autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Appeler à Allah n'est pas seulement parler — c'est vivre en exemple." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier « appelle » à Allah par son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle à Allah par sa parole et ses actes devient un guide pour les autres." }
  ],
  munajat: `Ya Rabb, fais que ma parole soit la meilleure : un appel à Toi. Fais que ma vie soit une invitation.`
};

// ==================== SURAH 42: ASH-SHURA (53 verses) - Additional ====================

MIROIR["42:2"] = {
  reference: "42:2",
  theme: ["mystère", "révélation", "sagesse"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Aziz"],
  mirrorVersion: `« 'Ayn, Sin, Qaf. » Le miroir me place devant les lettres mystérieuses du Coran. Ces lettres isolées nous rappellent que tout n'est pas accessible à la raison humaine. Il y a des mystères. Le Coran commence par ces mystères pour nous inviter à l'humilité. Le miroir m'invite à accepter le mystère.`,
  reflection: `Les mystères du Coran ne sont pas des obstacles — ils sont des invitations à la foi au-delà de la raison.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Ayn Sin Qaf » — trois lettres mystérieuses." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face aux mystères du Coran ? Avec frustration ou avec acceptation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mystère n'est pas un vide de sens — c'est un sens au-delà de notre compréhension actuelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères que la science découvre progressivement. Le Coran aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère s'ouvre à des compréhensions que la raison seule ne peut atteindre." }
  ],
  munajat: `Ya Rabb, il y a des mystères que je ne comprends pas. Fais que je les accepte avec foi. Ouvre-moi à leur sens caché.`
};

MIROIR["42:11"] = {
  reference: "42:11",
  theme: ["créateur", "création", "couples"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Créateur des cieux et de la terre, Il a fait de vous, de vous-mêmes, des couples. » Le miroir me montre la créativité d'Allah. Les cieux et la terre, et les couples parmi les humains. « Azwaj » — couples. La dualité est partout. Le miroir m'invite à voir la beauté dans la complémentarité.`,
  reflection: `La création est faite de couples. L'opposition crée l'harmonie. La complémentarité est la loi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fatir as-samawati wa al-ard » — créateur des cieux et de la terre. « Ja'ala lakum min anfusikum azwajan » — Il a fait de vous des couples." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vis la complémentarité ? Est-ce que j'accepte mon besoin de l'autre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dualité n'est pas une division — c'est une complémentarité nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait de couples : masculin/féminin, positif/négatif, jour/nuit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la complémentarité comprend sa place dans le tout." }
  ],
  munajat: `Ya Khaliq, Tu as créé les couples. Fais que je voie la beauté de la complémentarité et que j'accepte ma place.`
};

// ==================== SURAH 43: AZ-ZUKHRUF (89 verses) - Additional ====================

MIROIR["43:2"] = {
  reference: "43:2",
  theme: ["coran", "lumière", "clarté"],
  emotion: "Révérence, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Mubin"],
  mirrorVersion: `« Par le Livre explicite ! » Le miroir me place devant la clarté du Coran. « Mubin » — clair, explicite, évident. Le Coran n'est pas obscur. Il est lumière sur lumière. Le miroir m'invite à lire le Coran comme un livre clair qui éclaire.`,
  reflection: `Le Coran est explicite. L'obscurité n'est pas dans le Livre — elle est dans notre compréhension.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-kitabi al-mubin » — par le Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran comme un livre clair ? Ou est-ce que je le rends obscur par mes préjugés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté du Coran n'est pas simplification — c'est lumière qui révèle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est claire par nature. Le Coran est lumière pour l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme Livre explicite reçoit sa clarté." }
  ],
  munajat: `Ya Rabb, Ton Livre est explicite. Fais que je le lise avec un cœur clair pour recevoir Sa lumière.`
};

MIROIR["43:68"] = {
  reference: "43:68",
  theme: ["amis", "ennemis", "jugement"],
  emotion: "Lucidité, vérité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-'Aduw"],
  mirrorVersion: `« Les amis proches ce jour-là seront ennemis les uns des autres, excepté les pieux. » Le miroir me montre le retournement des relations au Jour dernier. Les amis deviennent ennemis. Pourquoi ? Parce que l'amour du monde les a unis, et le jugement les sépare. Seuls les pieux restent amis. Le miroir m'interroge : sur quoi reposent mes amitiés ?`,
  reflection: `Les amitiés basées sur le monde s'effondrent. Les amitiés basées sur Allah durent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-akhilla'u yawma'idhin ba'duhum li-ba'din aduw » — les amis proches ce jour-là seront ennemis les uns des autres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur quoi reposent mes amitiés ? Sur le plaisir du monde ou sur l'amour d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amitié qui unit dans le mal devient haine au Jugement. L'amitié qui unit dans le bien devient joie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers connaît des alliances temporaires. Seule l'alliance dans le bien est éternelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lie amitié dans Allah lie pour l'éternité." }
  ],
  munajat: `Ya Rabb, fais que mes amitiés soient fondées en Toi. Ne permets pas que je m'unisse dans le mal.`
};

// ==================== SURAH 44: AD-DUKHAN (59 verses) - Additional ====================

MIROIR["44:2"] = {
  reference: "44:2",
  theme: ["coran", "révélation", "clarté"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Mubin"],
  mirrorVersion: `« Par le Livre explicite ! » Le miroir me place encore devant la clarté du Coran. « Mubin » — explicite. Le Coran se présente comme clair, évident. Pas caché, pas obscur. Le miroir m'invite à lire avec des yeux clairs.`,
  reflection: `Le Coran est explicite. La difficulté n'est pas dans le texte — elle est dans notre réception.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-kitabi al-mubin » — par le Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran pour le comprendre ou pour confirmer mes préjugés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté du Coran dérange ceux qui préfèrent l'obscurité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière est claire. Ceux qui l'évitent choisissent l'ombre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche la clarté trouve le Coran clair." }
  ],
  munajat: `Ya Rabb, Ton Livre est clair. Purifie mon cœur pour recevoir Sa clarté sans obstacle.`
};

MIROIR["44:38"] = {
  reference: "44:38",
  theme: ["création", "but", "réflexion"],
  emotion: "Humilité, questionnement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Nous n'avons créé les cieux et la terre et ce qui est entre eux qu'en toute vérité. » Le miroir me montre le but de la création : « bi-l-haqq » — en toute vérité, avec justice, avec sagesse. La création n'est pas un jeu. Elle a un but. Le miroir m'interroge : est-ce que je vis selon ce but ?`,
  reflection: `La création a un but. Chaque créature a une raison d'être. Le but de l'homme est de connaître et adorer Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma khalaqna as-samawati wa al-arda wa ma baynahuma la'ibin » — Nous n'avons pas créé les cieux et la terre par jeu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma raison d'être ? Est-ce que je vis selon le but de ma création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Vivre sans but, c'est vivre contre le but de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a un but. Chaque créature accomplit sa fonction. L'homme doit choisir d'accomplir la sienne." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le but de sa création vit avec intention." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé avec un but. Révèle-moi ce but. Fais que je vive selon Ta vérité.`
};

// ==================== SURAH 45: AL-JATHIYAH (37 verses) - Additional ====================

MIROIR["45:2"] = {
  reference: "45:2",
  theme: ["révélation", "puissance", "sagesse"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« La révélation du Livre vient d'Allah, le Puissant, le Sage. » Le miroir me place devant l'origine du Coran. « 'Aziz » — Puissant. « Hakim » — Sage. Puissance et sagesse ensemble. Le Coran vient de cette Source parfaite. Le miroir m'invite à recevoir le Coran avec confiance.`,
  reflection: `Le Coran vient du Puissant Sage. Sa puissance garantit Son autorité. Sa sagesse garantit Son bienfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitabi min Allahi al-'azizi al-hakim » — révélation du Livre d'Allah, le Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois le Coran comme venant du Puissant Sage ? Avec quelle attitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La puissance sans sagesse est tyrannie. La sagesse sans puissance est impuissance. Allah est les deux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers manifeste la puissance et la sagesse d'Allah. Le Coran les articule." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran du Puissant Sage reçoit puissance et sagesse." }
  ],
  munajat: `Ya 'Aziz, Ya Hakim, Ton Livre est révélé. Fais que je le reçoive avec confiance et révérence.`
};

MIROIR["45:5"] = {
  reference: "45:5",
  theme: ["signes", "nuit", "jour"],
  emotion: "Émerveillement, attention",
  difficulty: "débutant",
  relatedNames: ["Al-Layl", "An-Nahar"],
  mirrorVersion: `« Dans l'alternance de la nuit et du jour, dans ce qu'Allah fait descendre du ciel comme provision, il y a des signes. » Le miroir me montre les signes quotidiens. La nuit suit le jour. La pluie descend du ciel. Tout cela est signe. Le miroir m'invite à voir les signes dans le quotidien.`,
  reflection: `Les signes d'Allah sont partout dans le quotidien. Les voir, c'est vivre en conscience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ikhtilafi al-layli wa al-nahari » — dans l'alternance de la nuit et du jour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois dans l'alternance du jour et de la nuit ? Une routine ou un signe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La routine cache le signe. L'attention révèle le signe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers alterne nuit et jour, été et hiver. Chaque cycle est un signe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit les signes dans le quotidien ne s'ennuie jamais." }
  ],
  munajat: `Ya Rabb, ouvre mes yeux sur les signes quotidiens. Fais que chaque alternance soit un rappel de Toi.`
};

// ==================== SURAH 46: AL-AHQAF (35 verses) - Additional ====================

MIROIR["46:2"] = {
  reference: "46:2",
  theme: ["révélation", "puissance", "sagesse"],
  emotion: "Révérence, attention",
  difficulty: "débutant",
  relatedNames: ["Al-'Aziz", "Al-Hakim"],
  mirrorVersion: `« La révélation du Livre vient d'Allah, le Puissant, le Sage. » Le miroir me place à nouveau devant l'origine du Coran. Même refrain que les sourates précédentes — une insistance. Le Coran vient d'Allah, pas d'une source humaine. Le miroir m'invite à prendre cette origine au sérieux.`,
  reflection: `La répétition dans le Coran n'est pas redondance — c'est insistance. Ce qui est répété est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzil al-kitabi min Allahi al-'azizi al-hakim » — révélation du Livre d'Allah, le Puissant, le Sage." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux l'origine divine du Coran ? Comment ma lecture le reflète-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine divine du Coran devrait transformer notre lecture." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit au Puissant Sage. Le Coran nous invite à faire de même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran comme venant d'Allah le reçoit comme une lettre personnelle." }
  ],
  munajat: `Ya Rabb, Ton Livre vient de Toi. Fais que je le lise comme Ton message personnel à moi.`
};

MIROIR["46:35"] = {
  reference: "46:35",
  theme: ["patience", "prophètes", "victoire"],
  emotion: "Persévérance, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "An-Nasr"],
  mirrorVersion: `« Supporte donc patiemment comme ont patienté les messagers doués de fermeté. » Le miroir me montre le chemin des prophètes : la patience. « Ulu al-'azm » — les messagers doués de fermeté. Ils ont patienté jusqu'à la victoire. Le miroir m'interroge : est-ce que je patiente comme eux ?`,
  reflection: `La victoire vient après la patience. Les prophètes ont patienté avant de triompher.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa isbir kama sabara ulu al-'azmi mina ar-rusul » — supporte patiemment comme ont patienté les messagers doués de fermeté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente dans les épreuves ? Ou est-ce que j'abandonne trop vite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience n'est pas passive — c'est une position active d'attente confiante." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers patiente. La graine attend la pluie. L'arbre attend le printemps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui patiente comme les prophètes reçoit leur victoire." }
  ],
  munajat: `Ya Sabur, enseigne-moi la patience des prophètes. Donne-moi leur fermeté. Fais que je tienne jusqu'à la victoire.`
};

// ==================== SURAH 47: MUHAMMAD (38 verses) - Additional ====================

MIROIR["47:2"] = {
  reference: "47:2",
  theme: ["foi", "œuvres", "pardon"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffar", "Al-Hadi"],
  mirrorVersion: `« Ceux qui ont cru et accompli de bonnes œuvres, et qui ont cru en ce qui a été descendu sur Muhammad... Allah effacera leurs mauvaises actions. » Le miroir me montre le chemin du pardon : foi, œuvres, acceptation de la révélation. Les trois ensemble. Et le résultat : « Yukaffir 'anhum sayyi'atihim » — Allah effacera leurs mauvaises actions. Le miroir m'invite à ce chemin.`,
  reflection: `Le pardon d'Allah répond à la foi vécue. Croire, agir, accepter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa alladhina amanu wa 'amilu as-salihati » — ceux qui ont cru et accompli de bonnes œuvres." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi se traduit en œuvres ? Est-ce que j'accepte la révélation sur Muhammad ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas automatique — il répond à l'effort sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers efface le passé par le renouveau. Allah efface les péchés par le repentir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit ce chemin voit ses mauvaises actions transformées." }
  ],
  munajat: `Ya Ghaffar, je crois, j'agis, j'accepte. Efface mes mauvaises actions. Fais que je sois parmi les pardonnés.`
};

MIROIR["47:7"] = {
  reference: "47:7",
  theme: ["soutien", "victoire", "foi"],
  emotion: "Motivation, confiance",
  difficulty: "débutant",
  relatedNames: ["An-Nasir", "Al-Mu'min"],
  mirrorVersion: `« Ô vous qui croyez ! Si vous soutenez Allah, Il vous soutiendra et affermira vos pas. » Le miroir me montre le contrat divin : nous soutenons Allah, Il nous soutient. « Tansuruna Allah » — si vous soutenez Allah. Comment ? En appliquant Sa loi, en défendant Sa cause. Et la réponse : « Yansurkum » — Il vous soutiendra. Le miroir m'interroge : est-ce que je soutiens la cause d'Allah ?`,
  reflection: `Le soutien d'Allah répond à notre soutien à Sa cause. C'est un partenariat.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« In tansuru Allaha yansurkum » — si vous soutenez Allah, Il vous soutiendra." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je soutiens la cause d'Allah ? Dans mes choix, mes paroles, mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Soutenir Allah n'est pas pour Lui — c'est pour nous. Il n'a pas besoin de notre soutien." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers soutient Allah par son existence. L'homme Le soutient par son choix conscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui soutient Allah reçoit Son soutien visible et invisible." }
  ],
  munajat: `Ya Rabb, je veux Te soutenir. Donne-moi la force de défendre Ta cause. Soutiens-moi en retour.`
};

// ==================== SURAH 48: AL-FATH (29 verses) - Additional ====================

MIROIR["48:1"] = {
  reference: "48:1",
  theme: ["victoire", "promesse", "réalisation"],
  emotion: "Gratitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Fattah", "An-Nasr"],
  mirrorVersion: `« Nous t'avons accordé une victoire éclatante. » Le miroir me place devant la promesse accomplie. « Fathun mubin » — une victoire évidente, claire. Allah promet et accomplit. Cette sourate a été révélée après le traité d'Hudaybiyah, apparemment une défaite mais en réalité une victoire. Le miroir m'invite à voir la victoire dans ce qui semble une défaite.`,
  reflection: `La victoire d'Allah peut venir sous des formes inattendues. Le croyant voit la main d'Allah même dans les apparences.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna fatahna laka fathan mubinan » — Nous t'avons accordé une victoire éclatante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui ressemble à une défaite dans ma vie mais qui pourrait être une victoire déguisée ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie victoire n'est pas toujours visible immédiatement. Elle se révèle avec le temps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers connaît des cycles de victoire apparente et cachée. La graine doit être enterrée pour germer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit avec les yeux d'Allah voit la victoire dans chaque situation." }
  ],
  munajat: `Ya Fattah, Tu accordes la victoire. Ouvre mes yeux sur les victoires cachées. Fais que je voie Ta main partout.`
};

MIROIR["48:4"] = {
  reference: "48:4",
  theme: ["paix", "révélation", "foi"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sakinah", "Al-Mu'min"],
  mirrorVersion: `« C'est Lui qui a fait descendre la tranquillité dans les cœurs des croyants. » Le miroir me montre le don de la « sakinah » — la tranquillité, la paix intérieure. Allah fait descendre cette paix dans les cœurs des croyants. Pas la paix extérieure, mais la paix intérieure. Le miroir m'interroge : ai-je cette tranquillité dans mon cœur ?`,
  reflection: `La tranquillité est un don d'Allah. Elle ne s'achète pas — elle se reçoit par la foi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Huwa alladhi anzala as-sakinata fi qulubi al-mu'minin » — c'est Lui qui a fait descendre la tranquillité dans les cœurs des croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai cette tranquillité ? Ou est-ce que mon cœur est agité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tranquillité ne vient pas de l'absence de problèmes — elle vient de la présence d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en mouvement mais obéit à des lois stables. La foi donne cette stabilité intérieure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la sakinah ne craint rien, car il sait qu'Allah est avec lui." }
  ],
  munajat: `Ya Rabb, fais descendre la tranquillité dans mon cœur. Calme mes agitations. Donne-moi Ta paix.`
};

// ==================== SURAH 49: AL-HUJURAT (18 verses) - Additional ====================

MIROIR["49:2"] = {
  reference: "49:2",
  theme: ["respect", "prophète", "voix"],
  emotion: "Humilité, révérence",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "Al-Mukarram"],
  mirrorVersion: `« Ô vous qui croyez ! N'élevez pas vos voix au-dessus de la voix du Prophète. » Le miroir me montre le respect dû au Prophète. Ne pas élever sa voix au-dessus de la sienne. Pas de familiarité excessive. Le respect est la base de la relation avec le Messager d'Allah. Le miroir m'interroge : est-ce que je respecte le Prophète comme il le mérite ?`,
  reflection: `Le respect du Prophète n'est pas une formalité — c'est la reconnaissance de son statut de Messager d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tarfa'u aswatakum fawqa sawti an-nabi » — n'élevez pas vos voix au-dessus de la voix du Prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je parle du Prophète ? Avec quel respect ? Quelle est ma attitude envers ses enseignements ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le respect n'est pas distance — c'est reconnaissance et amour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers respecte son Créateur par son obéissance. Nous respectons le Prophète en suivant sa guidance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte le Prophète reçoit son intercession." }
  ],
  munajat: `Ya Rabb, enseigne-moi le véritable respect pour Ton Prophète. Fais que je l'honore en parole et en acte.`
};

MIROIR["49:13"] = {
  reference: "49:13",
  theme: ["égalité", "diversité", "piété"],
  emotion: "Fraternité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "At-Taqwa"],
  mirrorVersion: `« Ô hommes ! Nous vous avons créés d'un mâle et d'une femelle, et Nous avons fait de vous des nations et des tribus pour que vous vous entre-connaissiez. Le plus noble d'entre vous auprès d'Allah est le plus pieux. » Le miroir me montre l'égalité fondamentale de tous les humains. Nous venons tous d'Adam et Ève. La diversité est pour la connaissance mutuelle. Le critère de noblesse n'est pas la race, la richesse ou le statut — c'est la piété. Le miroir m'interroge : par quel critère je juge les autres ?`,
  reflection: `La vraie noblesse est la piété. Tout le reste est illusion.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna akramakum 'inda Allahi atqakum » — le plus noble d'entre vous auprès d'Allah est le plus pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Par quel critère je juge les gens ? L'apparence, la richesse, ou la piété du cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité humaine n'est pas une division — c'est une richesse à découvrir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est divers dans son unité. Chaque créature a sa place." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui juge par la piété juge comme Allah juge." }
  ],
  munajat: `Ya Rabb, fais que je juge par la piété et non par les apparences. Unifie mon cœur avec tous les croyants.`
};

// ==================== SURAH 50: QAF (45 verses) - Additional ====================

MIROIR["50:1"] = {
  reference: "50:1",
  theme: ["coran", "serment", "gloire"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Majid", "Al-Qur'an"],
  mirrorVersion: `« Qaf. Par le Coran glorieux ! » Le miroir me place devant la gloire du Coran. « Majid » — glorieux, noble, majestueux. Le Coran n'est pas un livre ordinaire — il est glorieux. Le serment par le Coran souligne son importance. Le miroir m'invite à lire le Coran comme un livre glorieux.`,
  reflection: `Le Coran est glorieux. Sa lecture devrait être empreinte de révérence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qaf. Wa al-Qur'ani al-majid » — Qaf. Par le Coran glorieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je lis le Coran ? Comme un livre glorieux ou comme un texte ordinaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gloire du Coran n'est pas dans son papier — elle est dans son contenu et son origine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est majestueux. Le Coran est la parole du Majestueux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme glorieux reçoit sa gloire dans le cœur." }
  ],
  munajat: `Ya Rabb, Ton Coran est glorieux. Fais que je le lise avec la révérence qu'il mérite. Donne-moi de goûter à Sa gloire.`
};

MIROIR["50:6"] = {
  reference: "50:6",
  theme: ["ciel", "création", "méditation"],
  emotion: "Émerveillement, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "As-Sama'"],
  mirrorVersion: `« N'ont-ils donc pas observé le ciel au-dessus d'eux, comment Nous l'avons construit et embelli ? » Le miroir me lève les yeux vers le ciel. Le ciel est un livre ouvert. Sa construction, sa beauté — tout est signe. Le miroir m'interroge : est-ce que je regarde le ciel ? Est-ce que je contemple sa construction et sa beauté ?`,
  reflection: `Le ciel est un signe visible. Le contempler, c'est contempler la main du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afalam yanzuru ila as-sama'i fawqahum » — n'ont-ils pas observé le ciel au-dessus d'eux ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand est-ce que je regarde le ciel la dernière fois ? Qu'est-ce que j'y ai vu ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le ciel n'est pas un plafond vide — c'est une voûte de signes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel couvre la terre comme la miséricorde d'Allah couvre toute chose." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple le ciel avec le cœur contemple Allah." }
  ],
  munajat: `Ya Khaliq, le ciel est Ton œuvre. Ouvre mes yeux sur sa beauté. Fais que chaque regard vers le ciel soit un rappel de Toi.`
};

// ==================== SURAH 31: LUQMAN - MISSING VERSES ====================

MIROIR["31:4"] = {
  reference: "31:4",
  theme: ["prière", "aumône", "au-delà"],
  emotion: "Dévotion, certitude",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Akhirah"],
  mirrorVersion: `« Ceux qui accomplissent la prière, acquittent l'aumône et croient fermement en l'au-delà. » Le miroir me montre les trois piliers du croyant sincère. La prière (« salat ») — le lien vertical avec Allah. L'aumône (« zakat ») — le lien horizontal avec les autres. La foi en l'au-delà (« al-akhirah ») — l'horizon temporel de l'existence. Ces trois éléments forment une structure spirituelle complète. Le miroir m'interroge : ces trois piliers sont-ils équilibrés dans ma vie ?`,
  reflection: `La prière sans aumône devient égoïste. L'aumône sans prière devient ostentatoire. Les deux sans foi en l'au-delà deviennent sans horizon.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina yuqimuna as-salata wa yu'tuna az-zakata wa hum bi-al-akhirati hum yuqinun » — ceux qui accomplissent la prière, donnent l'aumône, et ont la certitude de l'au-delà." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ma prière m'amène-t-elle à donner ? Mon don m'amène-t-il à prier ? Ma foi en l'au-delà donne-t-elle sens aux deux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La certitude de l'au-delà n'est pas une fuite — c'est la fondation de l'action présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne et reçoit en équilibre. L'homme doit participer à cet équilibre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unit ces trois piliers a une foi complète et une vie équilibrée." }
  ],
  munajat: `Ya Rabb, fais que ma prière m'ouvre au don, que mon don m'ouvre à la prière, et que ma certitude en l'au-delà donne sens à tout.`
};

MIROIR["31:5"] = {
  reference: "31:5",
  theme: ["guidance", "succès", "droiture"],
  emotion: "Confiance, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Rashad"],
  mirrorVersion: `« Ceux-là sont sur la guidance de leur Seigneur, et ce sont eux les réussis. » Le miroir me montre la promesse divine. La guidance (« hudan ») mène au succès (« muflihun »). Le succès n'est pas une coïncidence — c'est le fruit de la guidance. Et la guidance n'est pas une théorie — c'est un chemin (« 'ala »). Le miroir m'interroge : suis-je sur ce chemin ou à côté ?`,
  reflection: `Le succès réel n'est pas matériel — c'est d'être guidé vers Allah. Tout le reste n'est qu'illusion de réussite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika 'ala hudan min rabbihim wa ula'ika hum al-muflihun » — ceux-là sont sur la guidance de leur Seigneur, et ce sont eux les réussis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mesure le succès par les critères du monde ou par la guidance d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le succès n'est pas d'atteindre, mais d'être guidé. Le chemin lui-même est le succès." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers suit sa guidance naturelle. L'homme a le choix de suivre ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui réalise que la guidance est le succès a déjà réussi." }
  ],
  munajat: `Ya Hadi, guide-moi vers Toi. Fais que je comprenne que le vrai succès est d'être sur Ton chemin.`
};

MIROIR["31:7"] = {
  reference: "31:7",
  theme: ["orgueil", "injustice", "égarement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Adl", "Al-Kibar"],
  mirrorVersion: `« Quand nos versets lui sont récités, il tourne le dos par orgueil, comme s'il ne les avait pas entendus. » Le miroir me montre le visage de l'orgueil. Pas l'orgueil de s'affirmer — mais l'orgueil de se fermer. « Kibar » — grandeur, mais une grandeur mal placée. Celui qui s'estime trop grand pour écouter les versets d'Allah s'estime plus grand qu'Allah. Le miroir m'interroge : quelles parties de moi tournent le dos aux versets ?`,
  reflection: `L'orgueil n'est pas de se connaître — c'est de se croire au-dessus de la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tawalla kibaran » — il tourne le dos par orgueil. Le retrait du cœur précède le retrait du corps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'entends un verset qui me dérange, est-ce que je l'accueille ou est-ce que je tourne le dos ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le plus humble est celui qui écoute le plus. L'orgueil ferme les oreilles du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers écoute son Créateur par son obéissance naturelle. L'orgueil est une anomalie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît son orgueil a commencé à s'en libérer." }
  ],
  munajat: `Ya Rabb, je Te demande protection contre l'orgueil qui ferme le cœur. Ouvre mes oreilles à Tes versets, même quand ils me dérangent.`
};

MIROIR["31:8"] = {
  reference: "31:8",
  theme: ["paradis", "foi", "récompense"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'ud"],
  mirrorVersion: `« Ceux qui croient et accomplissent les œuvres pies, ils auront les jardins du délice. » Le miroir me montre la promesse. La foi (« amanu ») et l'action (« salihat ») mènent aux jardins (« jannat »). Le Paradis n'est pas un hasard — c'est une destination préparée pour ceux qui la méritent. « Na'im » — délice, félicité, bonheur intense. Le miroir m'interroge : est-ce que je vis en direction de ces jardins ?`,
  reflection: `Le Paradis n'est pas seulement une récompense — c'est la manifestation de la miséricorde d'Allah envers ceux qui L'ont choisi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa 'amilu as-salihati lahum jannatu an-na'im » — ceux qui croient et font le bien auront les jardins du délice." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes actions quotidiennes m'orientent vers ces jardins ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les jardins du délice ne sont pas une échappatoire — ils sont l'accomplissement de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jardin terrestre est un signe du jardin éternel. Chaque fleur est une promesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte au délice de la foi a déjà goûté au délice du Paradis." }
  ],
  munajat: `Ya Rabb, fais que ma foi et mes actions soient dignes de Tes jardins. Ne me prive pas du délice éternel.`
};

MIROIR["31:9"] = {
  reference: "31:9",
  theme: ["éternité", "paradis", "promesse"],
  emotion: "Espérance profonde",
  difficulty: "débutant",
  relatedNames: ["Al-Khuld", "As-Sadiq"],
  mirrorVersion: `« Ils y demeureront éternellement. La promesse d'Allah est vérité. » Le miroir me montre l'éternité. « Khalidina » — ils demeurent, ils restent, ils ne partent pas. Dans un monde où tout passe, le Paradis offre ce qui ne passe pas. « Wa'du Allahi haqqa » — la promesse d'Allah est vérité. Le miroir m'invite à faire confiance à cette promesse.`,
  reflection: `L'éternité du Paradis n'est pas une durée infinie — c'est un état où le temps cesse d'être un fardeau.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalidina fiha wa'da Allahi haqqa » — ils y demeureront éternellement. La promesse d'Allah est vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis avec l'éternité en perspective, ou suis-je absorbé par le temporel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'éternité n'est pas l'absence de temps — c'est la plénitude du temps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'énergie ne se perd pas. L'âme non plus. L'éternité est une loi cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit pour l'éternité possède déjà un cœur éternel." }
  ],
  munajat: `Ya Rabb, Ta promesse est vérité. Fais que je vive pour l'éternité et non pour le moment qui passe.`
};

MIROIR["31:10"] = {
  reference: "31:10",
  theme: ["création", "signes", "montagnes"],
  emotion: "Émerveillement, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Il a créé les cieux sans piliers que vous pouvez voir. Et Il a jeté sur la terre des montagnes pour qu'elle ne branle pas avec vous. » Le miroir me montre l'architecture divine. Les cieux sans piliers visibles — une invitation à voir au-delà du visible. Les montagnes comme ancrages — la stabilité de la terre. « An takida bikum » — pour qu'elle ne branle pas avec vous. Allah pense à notre stabilité. Le miroir m'invite à contempler cette architecture.`,
  reflection: `La création n'est pas seulement belle — elle est fonctionnelle. Chaque élément a sa raison d'être.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa as-samawati bi-gayri 'amadin tarawnaha » — Il a créé les cieux sans piliers que vous pouvez voir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je regarde le ciel, est-ce que je vois les piliers invisibles qui le soutiennent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invisible est plus solide que le visible. La foi voit ce que l'œil ne voit pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La gravité, les forces atomiques — ce sont les piliers invisibles de l'univers." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'invisible dans la création comprend l'invisible de la foi." }
  ],
  munajat: `Ya Khaliq, Ta création est merveilleuse. Ouvre mes yeux sur les signes visibles et invisibles. Fais que je contemple avec le cœur.`
};

MIROIR["31:11"] = {
  reference: "31:11",
  theme: ["tawhid", "créateur", "idolâtrie"],
  emotion: "Clarté, conviction",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Wahid"],
  mirrorVersion: `« Voici la création d'Allah. Montrez-moi donc ce qu'ont créé ceux qui sont en dehors de Lui. » Le miroir me place devant un défi divin. « Hadha khalqu Allah » — voici la création d'Allah. « Fa aruni » — montrez-moi donc. Le défi est lancé aux idolâtres : qu'ont créé vos idoles ? Rien. Le miroir m'interroge : à quoi attribué-je ma vie ? À Allah ou à autre chose ?`,
  reflection: `Tout ce qui existe est création d'Allah. Ce qui n'est pas Lui ne crée rien — il ne peut que détourner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadha khalqu Allahi fa aruni matha khalaqa alladhina min dunihi » — voici la création d'Allah. Montrez-moi ce qu'ont créé ceux qui sont en dehors de Lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "À quoi je donne du pouvoir dans ma vie ? Qu'est-ce que je considère comme source de création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'idole n'est pas forcément une statue — c'est tout ce qui prend la place d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers témoigne du Créateur unique. Rien d'autre ne peut créer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne voit qu'Allah comme Créateur a purifié son tawhid." }
  ],
  munajat: `Ya Khaliq, Tu es l'unique Créateur. Purifie mon cœur de toute idole. Fais que je n'attribue rien à d'autre qu'à Toi.`
};

MIROIR["31:13"] = {
  reference: "31:13",
  theme: ["tawhid", "parents", "shirk"],
  emotion: "Sagesse, loyauté",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Walidayn"],
  mirrorVersion: `« Ô mon fils ! N'associe rien à Allah. Le polythéisme est une injustice énorme. » Le miroir me montre l'enseignement de Luqman à son fils. « Ya bunayya » — ô mon fils — l'adresse est tendre. Le conseil est clair : « la tushrik » — n'associe rien. Pourquoi ? « Inna ash-shirka la zulmun 'azim » — le polythéisme est une injustice énorme. Le shirk est injustice envers Allah — et injustice envers soi-même. Le miroir m'interroge : quelles associations cachées nourris-je ?`,
  reflection: `Le shirk est la plus grande injustice car il nie le Créateur et trahit la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya bunayya la tushrik bi-Allahi inna ash-shirka la zulmun 'azim » — ô mon fils, n'associe rien à Allah. Le polythéisme est une injustice énorme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'associe à Allah dans mon cœur ? L'argent, le statut, l'image de moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'injustice du shirk n'est pas contre les idoles — elle est contre l'âme elle-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est unifié par le tawhid. Le shirk est une fragmentation de cette unité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde son cœur pur de toute association a compris l'essentiel." }
  ],
  munajat: `Ya Wahid, garde mon cœur pur de toute association. Fais que je neassocie rien à Toi, ni visible ni invisible.`
};

MIROIR["31:15"] = {
  reference: "31:15",
  theme: ["parents", "obéissance", "limites"],
  emotion: "Équilibre, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Walidayn", "Al-Haqq"],
  mirrorVersion: `« Et si tous deux te forcent à M'associer ce dont tu n'as aucune connaissance, alors ne leur obéis pas. Et accompagne-les en ce monde avec bonté. » Le miroir me montre l'équilibre délicat. L'obéissance aux parents est fondamentale — mais elle a une limite : le shirk. « Fa la tuti'huma » — alors ne leur obéis pas. La limite est claire. Mais « wa sahhibhuma fi ad-dunya ma'rufan » — accompagne-les avec bonté dans ce monde. La désobéissance sur le religieux n'annule pas la bonté sur le relationnel. Le miroir m'invite à tenir les deux.`,
  reflection: `La bonté envers les parents ne dépend pas de leur croyance. Elle dépend de leur statut de parents.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa la tuti'huma wa sahhibhuma fi ad-dunya ma'rufan » — ne leur obéis pas (dans le shirk), mais accompagne-les avec bonté dans ce monde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je gère les conflits entre ma foi et mes relations ? Est-ce que je garde la bonté ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La désobéissance religieuse n'est pas rupture relationnelle — elle est fidélité à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'ordre des valeurs est cosmique : Allah d'abord, puis les relations qu'Il a créées." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui garde la bonté tout en refusant le shirk a compris l'équilibre de la foi." }
  ],
  munajat: `Ya Rabb, donne-moi la sagesse de tenir la bonté envers mes parents tout en préservant ma foi. Ne permets pas que l'un annule l'autre.`
};

MIROIR["31:19"] = {
  reference: "31:19",
  theme: ["modération", "voix", "comportement"],
  emotion: "Modestie, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Latif", "Al-Qasd"],
  mirrorVersion: `« Modère ta marche et baisse ta voix, car la plus détestable des voix est bien la voix des ânes. » Le miroir me montre l'enseignement de Luqman sur le comportement. « Aqsid » — modère, tiens le juste milieu. « Ighdud » — baisse, diminue. La voix haute n'est pas force — elle est ânerie. « Sawtu al-hamir » — la voix des ânes. L'âne crie fort mais ne dit rien. L'homme sage parle bas mais dit l'essentiel. Le miroir m'interroge : comment je me déplace et comment je parle ?`,
  reflection: `La grandeur n'est pas dans le volume — elle est dans le contenu et la mesure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa aqsid fi mashyika waghdud min sawtik » — modère ta marche et baisse ta voix." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je parle fort pour me faire remarquer ? Est-ce que je marche avec ostentation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La voix basse peut porter plus loin que la voix haute si elle vient du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne dans la modération. L'excès détruit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a compris la modération a compris la sagesse." }
  ],
  munajat: `Ya Latif, enseigne-moi la modération dans ma marche et ma parole. Fais que je ne sois pas comme l'âne qui crie.`
};

MIROIR["31:20"] = {
  reference: "31:20",
  theme: ["bénédictions", "cieux", "terre", "gratitude"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Ne voyez-vous pas qu'Allah vous a soumis ce qui est dans les cieux et sur la terre ? » Le miroir me montre l'abondance divine. « Sakhkhara » — Il a soumis, mis à disposition. Les cieux, la terre, le soleil, la lune, l'eau, l'air — tout est là pour nous. « Wa asbagha 'alaykum ni'amahu » — Il a répandu sur vous Ses bienfaits. Apparents et cachés. Le miroir m'invite à reconnaître cette abondance.`,
  reflection: `Chaque souffle est un bienfait. Chaque battement de cœur est un don. Nous vivons dans l'abondance sans la voir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam taraw anna Allaha sakhkhara lakum ma fi as-samawati wa ma fi al-ard » — ne voyez-vous pas qu'Allah vous a soumis ce qui est dans les cieux et sur la terre ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits ai-je aujourd'hui ? Est-ce que je les vois ou est-ce que je les prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les bienfaits cachés sont peut-être plus nombreux que les apparents. La santé invisible, la paix intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un système de bienfaits interconnectés. Chaque élément sert les autres." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit les bienfaits partout ne peut qu'être reconnaissant." }
  ],
  munajat: `Ya Mannan, Tu as répandu Tes bienfaits sur moi. Ouvre mes yeux pour les voir et mon cœur pour les reconnaître.`
};

MIROIR["31:24"] = {
  reference: "31:24",
  theme: ["délai", "justice", "épreuve"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Halim", "Al-Adl"],
  mirrorVersion: `« Nous leur donnons un bref délai, puis Nous les contraindrons à un dur châtiment. » Le miroir me montre la patience divine. « Numli » — Nous donnons un délai, Nous accordons du temps. Pourquoi ? La sagesse d'Allah dépasse notre compréhension. Mais la conclusion est certaine : « Sa nudrihim » — Nous les contraindrons. Le délai n'est pas l'oubli. Le miroir m'invite à comprendre que la justice différée n'est pas justice annulée.`,
  reflection: `Le délai divin est une miséricorde pour se repentir. Celui qui abuse du délai s'abuse lui-même.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Numli lahum qalilan thumma nadarruuhum ila 'adhabin ghaliz » — Nous leur donnons un bref délai, puis Nous les contraindrons à un dur châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise le délai qu'Allah m'accorde ? Pour me repentir ou pour persister ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai est une opportunité — pas une impunité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des cycles de temps. La justice aussi a son cycle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la valeur du délai se repent avant l'échéance." }
  ],
  munajat: `Ya Halim, Tu me donnes du délai. Fais que je l'utilise pour me repentir et non pour persister. Ne permets pas que le délai devienne piège.`
};

MIROIR["31:25"] = {
  reference: "31:25",
  theme: ["création", "tawhid", "réponse"],
  emotion: "Humilité, vérité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Si tu leur demandes : Qui a créé les cieux et la terre ? Ils diront certes : Allah. » Le miroir me montre la reconnaissance instinctive du Créateur. Même ceux qui associent savent, au fond, que Allah est le Créateur. « Layaqulunna Allah » — ils diront certes Allah. La vérité est inscrite dans la fitra. Le miroir m'interroge : est-ce que ma vie est cohérente avec cette reconnaissance ?`,
  reflection: `La connaissance du Créateur est naturelle. C'est l'oubli qui est contre-nature.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La-in sa'altahum man khalaqa as-samawati wa al-arda layaqulunna Allah » — si tu leur demandes qui a créé les cieux et la terre, ils diront certes : Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis selon la vérité que je reconnais ? Ou est-ce que je la nie par mes actes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Dire la vérité ne suffit pas — il faut la vivre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création proclame le Créateur par son existence même." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit selon la vérité qu'il connaît a unifié sa parole et son action." }
  ],
  munajat: `Ya Khaliq, je reconnais que Tu es le Créateur. Fais que ma vie soit cohérente avec cette vérité. Ne permets pas que mes actes la contredisent.`
};

MIROIR["31:26"] = {
  reference: "31:26",
  theme: ["propriété", "soumission", "tawhid"],
  emotion: "Humilité, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Hamd"],
  mirrorVersion: `« À Allah appartient ce qui est dans les cieux et sur la terre. Allah est le Riche, le Digne de louanges. » Le miroir me montre la seigneurie absolue d'Allah. « Lillahi » — à Allah appartient. Tout. Pas une partie, pas la plupart. Tout. « Al-Ghani » — le Riche. Il n'a besoin de rien. « Al-Hamid » — le Digne de louanges. Tout Le loue, consciemment ou non. Le miroir m'invite à reconnaître ma position : je suis propriétaire de rien, gestionnaire de tout.`,
  reflection: `Je ne possède rien — je gère ce qui appartient à Allah. Cette reconnaissance libère de l'attachement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lillahi ma fi as-samawati wa al-ard » — à Allah appartient ce qui est dans les cieux et sur la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je considère comme « mien » ? Et si tout appartient à Allah, qu'est-ce que cela change ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie richesse est de reconnaître que tout appartient à Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier appartient à son Créateur. L'homme est le seul à prétendre possession." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît qu'il ne possède rien possède la liberté du détachement." }
  ],
  munajat: `Ya Malik, tout T'appartient. Apprends-moi à être un bon gestionnaire. Ne permets pas que je prétende posséder ce qui est à Toi.`
};

MIROIR["31:28"] = {
  reference: "31:28",
  theme: ["création", "résurrection", "facilité"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Qadir"],
  mirrorVersion: `« Votre création et votre résurrection sont pour Allah comme une seule âme. » Le miroir me montre la facilité divine. « Mithla nafsin wahida » — comme une seule âme. Créer l'humanité entière ou la ressusciter — pour Allah, c'est pareil. Pas plus difficile de ressusciter que de créer. Le miroir m'invite à comprendre que la résurrection n'est pas un problème pour Allah.`,
  reflection: `Ce qui nous semble impossible est pour Allah aussi simple qu'un souffle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma khalqukum wa la ba'thukum illa ka-nafsin wahida » — votre création et votre résurrection ne sont pour Allah que comme une seule âme." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je doute de la résurrection ? Et si créer et ressusciter sont pareils pour Allah, quel est mon doute ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La difficulté n'existe pas pour Allah. Elle n'existe que dans notre perception limitée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a été créé et sera renouvelé. La résurrection est dans l'ordre naturel des choses divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la facilité divine pour le tout comprend Sa toute-puissance." }
  ],
  munajat: `Ya Qadir, créer et ressusciter sont pour Toi également faciles. Renforce ma foi en la résurrection et fais que je vive en sa perspective.`
};

MIROIR["31:29"] = {
  reference: "31:29",
  theme: ["puissance", "signes", "nuit"],
  emotion: "Humilité, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Khaliq"],
  mirrorVersion: `« N'as-tu pas vu qu'Allah fait pénétrer la nuit dans le jour et le jour dans la nuit ? » Le miroir me montre les cycles divins. « Yuliju » — Il fait pénétrer, insérer. La nuit dans le jour, le jour dans la nuit. La transition n'est pas brutale — elle est progressive, douce. Le miroir m'invite à observer ces cycles qui témoignent de la puissance d'Allah.`,
  reflection: `Le cycle jour-nuit est une des manifestations les plus évidentes de la puissance et de la douceur divines.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna Allaha yuliju al-layla fi an-nahari wa yuliju an-nahara fi al-layl » — n'as-tu pas vu qu'Allah fait pénétrer la nuit dans le jour et le jour dans la nuit ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends le temps d'observer le passage de la nuit au jour et du jour à la nuit ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transition douce est un enseignement : le changement peut être progressif et bienveillant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les cycles cosmiques rythment l'existence. L'alternance est la loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui observe les cycles comprend les rythmes de sa propre vie." }
  ],
  munajat: `Ya Rabb, les cycles de Ta création sont des signes. Ouvre mes yeux sur la pénétration de la nuit dans le jour. Fais que chaque cycle me rappelle Toi.`
};

MIROIR["31:30"] = {
  reference: "31:30",
  theme: ["tawhid", "vérité", "fausseté"],
  emotion: "Clarté, conviction",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Wahid"],
  mirrorVersion: `« C'est ainsi qu'Allah est la Vérité et que ce qu'ils invoquent en dehors de Lui est le Faux. » Le miroir me montre l'opposition fondamentale. « Allah huwa al-haqq » — Allah est la Vérité. « Wa ma yad'una min dunihi al-batil » — ce qu'ils invoquent en dehors de Lui est le Faux. Vérité contre Faux. Allah contre les idoles. Pas de troisième terme. Le miroir m'invite à vérifier : où se trouve mon invocation ?`,
  reflection: `Tout ce qui n'est pas Allah est faux en tant qu'objet d'adoration. La vérité est unique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhalika bi-anna Allaha huwa al-haqqu wa anna ma yad'una min dunihi huwa al-batil » — c'est ainsi qu'Allah est la Vérité et que ce qu'ils invoquent en dehors de Lui est le Faux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'invoque en dehors d'Allah ? L'argent, le statut, l'approbation ? Tout cela est faux." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le faux n'est pas seulement les statues — c'est tout ce qui remplace Allah dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne fonctionne que par la vérité. Les lois naturelles ne mentent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque le Véridique en tout a purifié son adoration." }
  ],
  munajat: `Ya Haqq, Tu es la Vérité. Fais que je n'invoque que Toi. Détourne mon cœur de tout faux objet d'adoration.`
};

MIROIR["31:31"] = {
  reference: "31:31",
  theme: ["signes", "voyage", "gratitude"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Muhaymin", "Al-Jalil"],
  mirrorVersion: `« N'as-tu pas vu que le vaisseau vogue sur la mer par la grâce d'Allah ? » Le miroir me montre les bienfaits cachés dans l'ordinaire. Le navire sur la mer — une image de voyage et de commerce. Mais derrière, la grâce d'Allah (« bi-fadli Allah »). Ce qui semble normal est en fait extraordinaire. Le miroir m'invite à voir la grâce derrière chaque mouvement de la vie.`,
  reflection: `Chaque voyage, chaque commerce, chaque mouvement de la vie est soutenu par la grâce invisible d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alam tara anna al-fulka tajri fi al-bahri bi-fadli Allah » — n'as-tu pas vu que le vaisseau vogue sur la mer par la grâce d'Allah ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels « vaisseaux » voguent dans ma vie par la grâce d'Allah ? Est-ce que je les vois ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La grâce n'est pas visible — elle se voit dans les effets. Le navire flotte par la grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création « vogue » par la grâce d'Allah. Rien ne se maintient sans Lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la grâce partout ne peut qu'être reconnaissant partout." }
  ],
  munajat: `Ya Rabb, chaque mouvement de ma vie est par Ta grâce. Ouvre mes yeux sur Tes bienfaits. Fais que je ne les prenne jamais pour acquis.`
};

MIROIR["31:32"] = {
  reference: "31:32",
  theme: ["détresse", "invocation", "ingratitude"],
  emotion: "Vérité, avertissement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mujib", "Al-Munji"],
  mirrorVersion: `« Quand une vague les recouvre comme des ombres, ils invoquent Allah en Lui vouant un culte sincère. » Le miroir me montre la vérité de la détresse. Dans la tempête, l'invocation devient pure. « Mukhlisina lahu ad-din » — vouant un culte sincère. Plus d'associations, plus de doutes — juste Allah. Mais une fois sauvés ? « Qala minhum » — certains parmi eux retournent à l'ingratitude. Le miroir m'interroge : suis-je constant dans mon invocation ou seulement dans la tempête ?`,
  reflection: `La détresse révèle le culte sincère. La sécurité révèle l'ingratitude. Lequel des deux est mon état naturel ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ida ghashiyahum mawjun ka al-zalali da'u Allaha mukhlisina lahu ad-din » — quand une vague les recouvre comme des ombres, ils invoquent Allah en Lui vouant un culte sincère." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je n'invoque Allah sincèrement que dans la tempête ? Qu'en est-il dans le calme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La tempête purifie l'invocation. Le calme devrait la maintenir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature ne connaît pas l'ingratitude. Elle adore constamment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maintient l'invocation sincère dans le calme a compris l'essentiel." }
  ],
  munajat: `Ya Rabb, dans la tempête je T'invoque sincèrement. Aide-moi à le faire aussi dans le calme. Ne permets pas que la sécurité me rende ingrat.`
};

// ==================== SURAH 32: AS-SAJDAH - MISSING VERSES ====================

MIROIR["32:2"] = {
  reference: "32:2",
  theme: ["révélation", "coran", "seigneur"],
  emotion: "Révérence, certitude",
  difficulty: "débutant",
  relatedNames: ["An-Nuzul", "Ar-Rabb"],
  mirrorVersion: `« La révélation du Livre, pas de doute à son sujet, venant du Seigneur des mondes. » Le miroir me place devant l'origine du Coran. « Tanzilu » — descente, révélation. Pas une invention humaine, mais une descente divine. « La rayba fihi » — pas de doute à son sujet. L'origine claire élimine le doute. « Min rabbi al-'alamin » — du Seigneur des mondes. Le miroir m'invite à recevoir le Coran comme ce qu'il est : une descente du Seigneur.`,
  reflection: `Le doute sur le Coran vient de l'oubli de son origine. Se souvenir de l'origine dissout le doute.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tanzilu al-kitabi la rayba fihi min rabbi al-'alamin » — la révélation du Livre, pas de doute à son sujet, venant du Seigneur des mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je reçois le Coran ? Comme un livre ordinaire ou comme une révélation du Seigneur des mondes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La descente du Coran n'est pas mouvement vers le bas — elle est rapprochement de l'humanité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est le point de contact entre le divin et l'humain." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran comme une descente du Seigneur en reçoit la lumière." }
  ],
  munajat: `Ya Rabb, Ton Livre est descendu de Toi. Fais que je le reçoive avec la révérence due à Son origine. Ne permets pas que le doute s'installe.`
};

MIROIR["32:3"] = {
  reference: "32:3",
  theme: ["prophète", "révélation", "avertissement"],
  emotion: "Gratitude, attention",
  difficulty: "débutant",
  relatedNames: ["An-Nabi", "An-Nadhir"],
  mirrorVersion: `« Ou diront-ils : Il l'a inventé ? C'est la vérité venant de ton Seigneur, pour que tu avertisses un peuple auquel aucun avertisseur n'est venu avant toi. » Le miroir me montre la finalité de la révélation. « Li-tundhira » — pour que tu avertisses. La révélation n'est pas un luxe — elle est une nécessité. « Ma atahum min nadhir » — aucun avertisseur n'est venu à eux. Le Coran vient combler un vide. Le miroir m'invite à reconnaître la chance d'avoir reçu cet avertissement.`,
  reflection: `La révélation est une miséricorde pour ceux qui n'en avaient pas. L'avertissement est un don.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Bal huwa al-haqqu min rabbika li-tundhira qawman ma atahum min nadhirin min qablika » — c'est la vérité venant de ton Seigneur, pour que tu avertisses un peuple auquel aucun avertisseur n'est venu avant toi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la valeur de l'avertissement ? Ou est-ce que je le prends pour acquis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'avertissement n'est pas menace — il est guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation est la lumière qui guide dans l'obscurité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la valeur de l'avertissement en est reconnaissant." }
  ],
  munajat: `Ya Rabb, Tu as envoyé un avertisseur à ceux qui n'en avaient pas. Fais que je reconnaisse la valeur de cet avertissement. Ne permets pas que je le néglige.`
};

MIROIR["32:6"] = {
  reference: "32:6",
  theme: ["connaissance", "invisible", "science"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Le Connaisseur de l'invisible et du visible, le Puissant, le Miséricordieux. » Le miroir me montre l'étendue de la connaissance divine. « 'Alimu al-ghaybi wa ash-shahadah » — Connaisseur de l'invisible et du visible. Rien ne Lui échappe — ni ce qui est caché, ni ce qui est apparent. « Al-'Aziz » — le Puissant. « Ar-Rahim » — le Miséricordieux. La connaissance s'accompagne de puissance et de miséricorde. Le miroir m'invite à faire confiance à Celui qui sait tout.`,
  reflection: `Allah connaît ce que je cache et ce que je montre. Sa connaissance n'est pas menace — elle est réconfort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Alimu al-ghaybi wa ash-shahadah al-'aziz al-rahim » — Connaisseur de l'invisible et du visible, le Puissant, le Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis comme si Allah savait tout de moi ? Ou est-ce que je cache ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invisible pour moi est visible pour Lui. Ma cachette n'est pas cachette pour Lui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'invisible et le visible sont tous deux créations d'Allah. Il connaît les deux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit avec la conscience de la connaissance divine a un cœur transparent." }
  ],
  munajat: `Ya 'Alim, Tu connais mon invisible et mon visible. Fais que je vive dans cette conscience. Ne permets pas que je cache ce que Tu connais déjà.`
};

MIROIR["32:9"] = {
  reference: "32:9",
  theme: ["création", "âme", "souffle"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Ruh"],
  mirrorVersion: `« Puis Il lui donna sa forme parfaite et lui insuffla de Son esprit. » Le miroir me montre le couronnement de la création. « Sawwahu » — Il lui donna sa forme parfaite. L'humain n'est pas bricolage — il est œuvre achevée. « Nafakha fihi min ruhihi » — Il lui insuffla de Son esprit. Le souffle divin dans l'argile humaine. L'âme est cette étincelle divine. Le miroir m'invite à honorer cette origine.`,
  reflection: `L'âme humaine porte le souffle divin. Chaque être humain est porteur de cette noblesse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa sawwahu wa nafakha fihi min ruhihi » — puis Il lui donna sa forme parfaite et lui insuffla de Son esprit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je traite mon âme comme ce qu'elle est — une étincelle divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le souffle divin est en moi. Mon essence est noble, même si mes actes peuvent ne pas l'être." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'âme humaine est unique dans la création — elle porte le souffle du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui honore son âme honore Celui qui l'a insufflée." }
  ],
  munajat: `Ya Khaliq, Tu as insufflé de Ton esprit en moi. Fais que j'honore cette origine. Ne permets pas que je salisse ce que Tu as rendu noble.`
};

MIROIR["32:10"] = {
  reference: "32:10",
  theme: ["résurrection", "doute", "création"],
  emotion: "Espérance, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ba'ith", "Al-Qadir"],
  mirrorVersion: `« Ils disent : Quand nous serons perdus dans la terre, serons-nous créés à nouveau ? » Le miroir me montre le doute sur la résurrection. « A-idha » — quand donc ? Une question de mécréance, pas de curiosité. « Dhalalna » — nous sommes perdus. Le corps devient poussière, dispersé. Comment pourrait-il revenir ? Le miroir me montre que ce doute vient de l'oubli du Créateur initial.`,
  reflection: `Celui qui a créé la première fois peut créer la deuxième. Le doute sur la résurrection est oubli de la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qalu a-idha dalalna fi al-ardi a-inna lafi khalqin jadid » — ils disent : quand nous serons perdus dans la terre, serons-nous créés à nouveau ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que la résurrection n'est pas plus difficile que la création ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dispersion de la poussière n'est pas obstacle pour Celui qui a créé du néant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature montre le cycle de la vie et de la renaissance. La résurrection est dans l'ordre naturel des choses divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend que créer du néant est plus impressionnant que ressusciter a compris la puissance divine." }
  ],
  munajat: `Ya Ba'ith, Tu m'as créé du néant. Fais que je croie que Tu me ressusciteras de la poussière. Ne permets pas que le doute s'installe.`
};

MIROIR["32:12"] = {
  reference: "32:12",
  theme: ["jugement", "regret", "humilité"],
  emotion: "Crainte, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hashr", "Al-Hisab"],
  mirrorVersion: `« Si tu voyais les criminels baisser la tête devant leur Seigneur : Notre Seigneur, nous avons vu et entendu, laisse-nous revenir ! » Le miroir me montre la scène du Jugement. « Kassi'a » — baisser la tête, s'humilier. Les arrogants deviennent humbles. « Rabbana » — notre Seigneur. Le mécréant invoque enfin. « Absarna wa sami'na » — nous avons vu et entendu. La vérité devient évidente. « Fa irji'na » — laisse-nous revenir. Mais il est trop tard. Le miroir m'avertit : le regret doit venir maintenant.`,
  reflection: `Le regret du Jour dernier est inutile. Le vrai regret est celui qui vient avant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law tara idha al-mujrimuna nakisu ru'usihim 'inda rabbihim » — si tu voyais les criminels baisser la tête devant leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je regrette maintenant ou vais-je regretter trop tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité forcée du Jour dernier n'est pas l'humilité choisie d'aujourd'hui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par apparaître. Mieux vaut la reconnaître maintenant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui regrette maintenant n'aura pas à regretter trop tard." }
  ],
  munajat: `Ya Rabb, fais que je regrette maintenant et non trop tard. Ouvre mes yeux sur la vérité avant le Jour où les criminels baisseront la tête.`
};

MIROIR["32:13"] = {
  reference: "32:13",
  theme: ["volonté", "délai", "justice"],
  emotion: "Humilité, confiance",
  difficulty: "avancé",
  relatedNames: ["Al-Murid", "Al-Hakim"],
  mirrorVersion: `« Si Nous avions voulu, Nous aurions donné à chaque âme sa guidance. Mais Ma parole s'est réalisée : J'emplirai l'Enfer de djinns et d'humains. » Le miroir me montre le mystère de la volonté divine. « Law shi'na » — si Nous avions voulu. Allah aurait pu guider tout le monde. Mais « haqqat kalimati » — Ma parole s'est réalisée. La justice implique le choix — et le choix implique la possibilité de l'erreur. Le miroir m'invite à accepter ce mystère avec humilité.`,
  reflection: `La guidance est un don, pas un droit. Le délai est une miséricorde, pas une injustice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa law shi'na la-atayna kulla nafsin hudaha wa lakin haqqat kalimati » — si Nous avions voulu, Nous aurions donné à chaque âme sa guidance. Mais Ma parole s'est réalisée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte que la guidance est un don ? Est-ce que j'utilise ce don ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La possibilité de l'erreur est le prix de la liberté." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit la loi. L'homme a le choix. La justice suit le choix." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la volonté divine avec humilité a compris sa place." }
  ],
  munajat: `Ya Murid, Ta volonté est juste. Fais que j'accepte le mystère de la guidance. Fais que j'utilise le don que Tu m'as fait.`
};

MIROIR["32:14"] = {
  reference: "32:14",
  theme: ["jugement", "oubli", "conséquence"],
  emotion: "Mise en garde, sobriété",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hasib", "Al-Maw'id"],
  mirrorVersion: `« Goûtez donc pour avoir oublié la rencontre de ce jour ! Nous vous oublions aussi. » Le miroir me montre la conséquence de l'oubli. « Fa dhuqu » — goûtez donc. La conséquence est à goûter. « Bi-ma nasitum » — pour avoir oublié. L'oubli de la rencontre entraîne l'oubli divin. « Fa qad nasinakum » — Nous vous oublions aussi. La rétribution est proportionnelle. Le miroir m'interroge : est-ce que j'oublie la rencontre avec Allah ?`,
  reflection: `L'oubli de l'au-delà entraîne l'oubli dans l'au-delà. La mémoire présente est la garantie de la mémoire future.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa dhuqu bi-ma nasitum liqa'a yawmikum hadha inna nasinakum » — goûtez donc pour avoir oublié la rencontre de ce jour ! Nous vous oublions aussi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de la rencontre avec Allah ? Ou est-ce que je l'oublie dans mes occupations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'oubli divin n'est pas absence de connaissance — c'est absence de miséricorde." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mémoire est le fondement de la relation. L'oubli est la rupture." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient d'Allah maintenant sera rappelé par Lui plus tard." }
  ],
  munajat: `Ya Rabb, je me souviens de la rencontre avec Toi. Ne m'oublie pas ce jour-là. Fais que ma mémoire présente soit ma garantie future.`
};

MIROIR["32:16"] = {
  reference: "32:16",
  theme: ["prière", "nuit", "craigte"],
  emotion: "Dévotion, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qiyam", "Al-Layl"],
  mirrorVersion: `« Leurs flancs se détachent de leurs lits pour invoquer leur Seigneur par crainte et par espoir. » Le miroir me montre la prière nocturne des croyants. « Tatajafa » — se détacher, quitter avec effort. Le lit est chaud, le sommeil doux — mais ils se lèvent. « Yadh'aruna » — ils invoquent. La nuit est pour l'intimité avec Allah. « Khawfan » — par crainte. « Tama'an » — par espoir. Les deux ailes de l'adoration. Le miroir m'interroge : est-ce que mes flancs se détachent de leur lit ?`,
  reflection: `La prière nocturne est l'indicateur de l'amour sincère. On quitte le confort pour l'Aimé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tatajafa junubuhum 'ani al-madaji'i yad'una rabbahum khawfan wa tama'an » — leurs flancs se détachent de leurs lits pour invoquer leur Seigneur par crainte et par espoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me lève la nuit pour Allah ? Ou est-ce que le lit est plus attractif que l'invocation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La nuit est le moment le plus intime. Le lever est l'effort le plus sincère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est le voile de l'intimité. Les élus se lèvent quand les autres dorment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui quitte son lit pour Allah trouve un repos plus grand dans Sa présence." }
  ],
  munajat: `Ya Rabb, aide-moi à me lever la nuit. Donne-moi la force de quitter le confort pour l'intimité avec Toi. Fais que ma crainte et mon espoir m'y poussent.`
};

MIROIR["32:19"] = {
  reference: "32:19",
  theme: ["récompense", "paradis", "foi"],
  emotion: "Espérance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Mu'min"],
  mirrorVersion: `« Quant à ceux qui croient et accomplissent les œuvres pies, ils auront les jardins du refuge. » Le miroir me montre la récompense de la foi et de l'action. « Jannatu al-ma'wa » — les jardins du refuge. « Ma'wa » — lieu de retour, d'asile, de repos. Le Paradis est le retour à la maison, l'asile après l'exil, le repos après l'effort. Le miroir m'invite à œuvrer pour ce refuge.`,
  reflection: `Le Paradis est le retour à la maison. Tout le reste est exil temporaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amma alladhina amanu wa 'amilu as-salihati falahum jannatu al-ma'wa » — quant à ceux qui croient et accomplissent les œuvres pies, ils auront les jardins du refuge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je travaille pour ce refuge ? Ou est-ce que je m'installe dans l'exil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le refuge n'est pas une fuite — c'est le retour à la maison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'âme cherche son refuge. Le Paradis est ce refuge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui travaille pour le refuge y trouve sa place préparée." }
  ],
  munajat: `Ya Rabb, je travaille pour le refuge. Prépare ma place dans les jardins du retour. Ne permets pas que je m'installe dans l'exil.`
};

MIROIR["32:20"] = {
  reference: "32:20",
  theme: ["châtiment", "mécréance", "justice"],
  emotion: "Mise en garde, sobriété",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nar", "Al-Fasiqun"],
  mirrorVersion: `« Quant aux pervers, leur refuge sera le Feu. » Le miroir me montre la conséquence de la perversité. « Al-fasiqun » — les pervers, les débauchés, ceux qui sortent de l'obéissance. « Mawahumu » — leur refuge. Le même mot que pour le Paradis, mais un refuge tout autre. « An-nar » — le Feu. Le refuge des pervers est le feu. Le miroir m'avertit : le choix d'aujourd'hui détermine le refuge de demain.`,
  reflection: `Le refuge n'est pas toujours paix. Pour les pervers, le refuge est le feu. Le choix est maintenant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa amma al-fasiquna fa mawahumu an-nar » — quant aux pervers, leur refuge sera le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends garde de ne pas être du nombre des pervers ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perversité n'est pas toujours visible — elle commence dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu purifie dans ce monde et punir dans l'autre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite la perversité maintenant évite son refuge plus tard." }
  ],
  munajat: `Ya Rabb, préserve-moi de la perversité. Ne permets pas que mon refuge soit le feu. Fais que je sois du nombre de ceux qui entrent dans les jardins.`
};

MIROIR["32:22"] = {
  reference: "32:22",
  theme: ["injustice", "signes", "châtiment"],
  emotion: "Mise en garde, sérieux",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Ayat"],
  mirrorVersion: `« Qui est plus injuste que celui à qui les signes d'Allah sont rappelés et qui s'en détourne ? » Le miroir me montre l'injustice suprême. « A-zalamu » — qui est plus injuste ? Une question rhétorique — il n'y en a pas de plus injuste. « Tuddila lahu » — lui sont rappelées. Il connaît les signes. « A'rada » — il s'en détourne. Le plus grand crime n'est pas l'ignorance — c'est le refus conscient. Le miroir m'interroge : comment je réagis quand les signes me sont rappelés ?`,
  reflection: `L'injustice n'est pas de ne pas savoir — c'est de savoir et de se détourner.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa man azlamu mimman tuddila bi-ayati Rabbihi thumma a'rada 'anha » — qui est plus injuste que celui à qui les signes d'Allah sont rappelés et qui s'en détourne ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand les signes me sont rappelés, est-ce que je me détourne ou est-ce que j'accepte ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détourneur connaît mieux que quiconque — c'est pourquoi son crime est plus grand." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout. Se détourner est un choix conscient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les signes quand ils lui sont rappelés est sur le chemin de la guidance." }
  ],
  munajat: `Ya Rabb, quand Tes signes me sont rappelés, fais que je ne me détourne pas. Ouvre mon cœur à l'acceptation. Ne permets pas que je sois le plus injuste.`
};

MIROIR["32:23"] = {
  reference: "32:23",
  theme: ["livre", "moïse", "révélation"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Tawrah", "Musa"],
  mirrorVersion: `« Nous avons donné le Livre à Moïse. Ne doute donc pas de ta rencontre avec lui. » Le miroir me montre la continuité de la révélation. « La qad atayna Musa al-kitab » — Nous avons donné le Livre à Moïse. La révélation n'est pas nouvelle — elle est continue. « Fala takun » — ne sois donc pas. Le doute sur la rencontre n'est pas justifié. L'histoire de Moïse confirme la vérité. Le miroir m'invite à faire confiance à la continuité de la révélation.`,
  reflection: `La révélation à Moïse est confirmation de la révélation à Muhammad. La même source, le même but.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad atayna Musa al-kitab » — Nous avons donné le Livre à Moïse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la continuité de la révélation ? À l'unité du message divin ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La révélation n'est pas fragmentée — elle est un fleuve continu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation suit l'humanité depuis le début. Elle ne s'arrête qu'avec le sceau." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la continuité de la révélation a compris son unité." }
  ],
  munajat: `Ya Rabb, Tu as donné le Livre à Moïse et à Muhammad. Fais que je fasse confiance à la continuité de Ta révélation. Ne permets pas que le doute s'installe.`
};

MIROIR["32:25"] = {
  reference: "32:25",
  theme: ["jugement", "différends", "justice"],
  emotion: "Confiance, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakam", "Al-Qadi"],
  mirrorVersion: `« Ton Seigneur tranchera entre eux, au Jour de la Résurrection, concernant ce sur quoi ils divergeaient. » Le miroir me montre la résolution finale. « Yahkumu » — Il jugera, tranchera. Les différends de ce monde trouveront leur résolution. « Yawma al-qiyamah » — au Jour de la Résurrection. Le grand tribunal. « Fi ma kanu fihi yakhtalifun » — concernant ce sur quoi ils divergeaient. Tout ce qui est en litige sera clarifié. Le miroir m'invite à faire confiance à la justice finale.`,
  reflection: `Les injustices de ce monde seront résolues dans l'autre. La patience est de faire confiance au Juge final.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna rabbaka yahkumu baynahum yawma al-qiyamati fi ma kanu fihi yakhtalifun » — ton Seigneur tranchera entre eux, au Jour de la Résurrection, concernant ce sur quoi ils divergeaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la justice finale ? Ou est-ce que je veux justice immédiate ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jugement différé n'est pas injustice — c'est patience pour la vérité complète." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par triompher. Le Jour de la Résurrection est la vérité complète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la justice finale n'est pas troublé par les injustices présentes." }
  ],
  munajat: `Ya Hakam, Tu trancheras entre nous au Jour de la Résurrection. Fais que je fasse confiance à Ta justice. Ne permets pas que les injustices présentes me troublent.`
};

MIROIR["32:26"] = {
  reference: "32:26",
  theme: ["histoire", "signes", "résurrection"],
  emotion: "Réflexion, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Tarikh", "Al-Ba'ith"],
  mirrorVersion: `« N'ont-ils pas vu combien de générations Nous avons fait périr avant eux ? Ils marchent sur leurs demeures. » Le miroir me montre l'histoire comme avertissement. « A-wa lam yahdi » — ne les a-t-elle pas guidés ? L'histoire est guide. « Ahlakna » — Nous avons fait périr. Les civilisations passent. « Yamshuna » — ils marchent. Les ruines sont là, visibles. « Masakinahim » — leurs demeures. Les palais deviennent ruines. Le miroir m'invite à méditer sur les traces du passé.`,
  reflection: `Les ruines des civilisations passées sont des leçons visibles. Celui qui ne médite pas répète les erreurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yahdi lahum kam ahlakna qablahum min al-quruni yamshuna fi masakinahim » — ne les a-t-elle pas guidés, combien de générations Nous avons fait périr avant eux ? Ils marchent sur leurs demeures." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je médite sur les traces du passé ? Ou est-ce que je marche sur les ruines sans voir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ruines ne sont pas que pierres — elles sont avertissements." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire est cyclique. Les leçons sont répétées pour qui veut entendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur les ruines des nations passées ne répète pas leurs erreurs." }
  ],
  munajat: `Ya Rabb, les ruines des nations passées sont des signes. Ouvre mes yeux sur leurs leçons. Ne permets pas que je marche sur les traces de leur destruction.`
};

MIROIR["32:27"] = {
  reference: "32:27",
  theme: ["provision", "signes", "gratitude"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Ma'"],
  mirrorVersion: `« N'ont-ils pas vu que Nous poussons l'eau vers une terre stérile et que Nous en faisons sortir une récolte ? » Le miroir me montre la transformation divine. « Nasuqu » — Nous poussons, dirigeons. L'eau vers une terre morte. « Juruz » — stérile, nue, sans vie. Et de cette mort sort la vie. « Zar'an » — récolte, culture. La mort devient vie par l'eau d'Allah. Le miroir m'invite à voir cette transformation partout.`,
  reflection: `L'eau transforme la mort en vie. La révélation fait de même avec les cœurs morts.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-wa lam yaraw anna nasuqu al-ma'a ila ardi juruzin fa nukhriju bihi zar'an » — n'ont-ils pas vu que Nous poussons l'eau vers une terre stérile et que Nous en faisons sortir une récolte ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il une terre stérile ou fertile ? L'eau de la révélation y pénètre-t-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stérilité n'est pas définitive — l'eau d'Allah peut tout transformer." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le désert fleurit avec l'eau. Le cœur mort fleurit avec la révélation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui laisse l'eau de la révélation pénétrer son cœur voit la vie pousser." }
  ],
  munajat: `Ya Razzaq, fais que l'eau de Ta révélation pénètre mon cœur. Transforme ma stérilité en récolte. Ne permets pas que je reste terre morte.`
};

MIROIR["32:28"] = {
  reference: "32:28",
  theme: ["jugement", "question", "doute"],
  emotion: "Impatience, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Fath", "Al-Qada'"],
  mirrorVersion: `« Et ils disent : Quand donc ce jugement, si vous êtes véridiques ? » Le miroir me montre l'impatience des mécréants. « Mata » — quand donc ? Une question qui n'est pas quête de vérité mais défi. « Al-fath » — le jugement, la victoire, l'ouverture. « In kuntum sadiqin » — si vous êtes véridiques. Le défi est lancé aux croyants. Le miroir m'avertit : cette impatience cache souvent l'incrédulité.`,
  reflection: `Demander « quand » peut être quête sincère ou défi arrogant. Le cœur connaît la différence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yaquluna mata hadha al-fathu in kuntum sadiqin » — et ils disent : quand donc ce jugement, si vous êtes véridiques ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande « quand » par impatience sincère ou par défi caché ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le jugement vient au moment d'Allah. L'impatience ne l'accélère pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout vient en son temps. Le jugement a son heure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance au timing d'Allah n'est pas troublé par l'attente." }
  ],
  munajat: `Ya Rabb, fais que je fasse confiance à Ton timing. Ne permets pas que l'impatience cache l'incrédulité. Donne-moi la patience de l'attente.`
};

MIROIR["32:29"] = {
  reference: "32:29",
  theme: ["jugement", "tard", "impossibilité"],
  emotion: "Mise en garde, sérieux",
  difficulty: "débutant",
  relatedNames: ["Al-Qada'", "Al-Iman"],
  mirrorVersion: `« Dis : Au Jour du Jugement, la foi de ceux qui n'auront pas cru ne leur servira à rien. » Le miroir me montre l'inutilité de la foi tardive. « Yawma al-fath » — au Jour du Jugement. « La yanfa'u » — elle ne servira à rien. « Alladhina kafaru » — ceux qui auront cru (tard). « La humu nnazara » — pas de délai pour eux. Le moment de la foi est maintenant. Après le jugement, c'est trop tard. Le miroir m'invite à croire maintenant.`,
  reflection: `La foi a un moment. Après la certitude du jugement, croire n'est plus un choix — c'est une constatation.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul yawma al-fathi la yanfa'u alladhina kafaru imanahum » — dis : au Jour du Jugement, la foi de ceux qui n'auront pas cru ne leur servira à rien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois maintenant ? Ou est-ce que je remets à plus tard ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi tardive n'est pas foi — c'est constatation de l'évidence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps de la foi est le temps de l'incertitude. Après la certitude, le choix n'est plus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant, avant la certitude, a fait le choix sincère." }
  ],
  munajat: `Ya Rabb, je crois maintenant. Ne permets pas que je remette à plus tard. Fais que ma foi soit du temps de l'incertitude, pas du temps de la certitude forcée.`
};

MIROIR["32:30"] = {
  reference: "32:30",
  theme: ["détachement", "attente", "témoin"],
  emotion: "Patience, confiance",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabr", "Ash-Shahid"],
  mirrorVersion: `« Détourne-toi d'eux donc et attends. Ils attendent, eux aussi. » Le miroir me montre la position du prophète face au rejet. « Fa a'rid » — détourne-toi. Pas d'insistance forcée. « Wa tantazir » — et attends. L'attente est active, pas passive. « Innahum muntazirun » — eux aussi attendent. Que attendent-ils ? Le jugement, la preuve, la fin. Le miroir m'invite à adopter cette posture : détourne-toi du rejet et attends avec confiance.`,
  reflection: `Face au rejet, la réponse n'est pas la force mais l'attente confiante. Le jugement viendra.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa a'rid 'anhum wa tantazir innahum muntazirun » — détourne-toi d'eux donc et attends. Ils attendent, eux aussi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Face au rejet de mon message, est-ce que j'insiste ou est-ce que j'attends avec confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'attente n'est pas passivité — c'est confiance dans le jugement à venir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire juge. Le temps révèle. L'attente est le témoin silencieux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait attendre avec confiance a compris que le jugement n'est pas loin." }
  ],
  munajat: `Ya Rabb, fais que je sache me détourner du rejet et attendre avec confiance. Ne permets pas que l'impatience me fasse perdre la posture correcte. Le jugement est à Toi.`
};

// ==================== SURAH 33: AL-AHZAB - MISSING VERSES ====================

MIROIR["33:1"] = {
  reference: "33:1",
  theme: ["piété", "obéissance", "prophète"],
  emotion: "Détermination, confiance",
  difficulty: "débutant",
  relatedNames: ["At-Taqwa", "An-Nabi"],
  mirrorVersion: `« Ô Prophète ! Crains Allah et n'obéis pas aux mécréants et aux hypocrites. » Le miroir me montre la position du Prophète face à la pression. « Ittiqi Allah » — crains Allah. La priorité est claire : Allah d'abord. « Wa la tuti' al-kafirin » — n'obéis pas aux mécréants. L'obéissance à Allah exclut l'obéissance à ceux qui Le rejettent. « Wa al-munafiqin » — et aux hypocrites. Le danger intérieur est aussi grand que le danger extérieur. Le miroir m'interroge : à qui j'obéis quand la pression monte ?`,
  reflection: `La crainte d'Allah est la boussole qui oriente toutes les autres obéissances.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha an-nabiyyu ittiqi Allaha wa la tuti' al-kafirina wa al-munafiqin » — ô Prophète ! Crains Allah et n'obéis pas aux mécréants et aux hypocrites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je suis sous pression, à qui j'obéis ? À Allah ou aux opinions des autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obéissance aux mécréants n'est pas toujours visible — elle peut être subtile, intérieure." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à son Créateur. L'homme a le choix — et la responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah vraiment ne craint personne d'autre." }
  ],
  munajat: `Ya Rabb, fais que je Te craigne plus que les opinions des autres. Ne permets pas que j'obéisse aux pressions des mécréants et des hypocrites. Donne-moi la force de la piété.`
};

MIROIR["33:2"] = {
  reference: "33:2",
  theme: ["révélation", "guidance", "science"],
  emotion: "Confiance, certitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahy", "Al-'Alim"],
  mirrorVersion: `« Et suis ce qui t'est révélé de la part d'Allah. Allah est Parfaitement Connaisseur de ce que vous faites. » Le miroir me montre la source de la guidance. « Wa ittabi' ma yuha ilayka » — suis ce qui t'est révélé. La révélation est le chemin. « Min rabbik » — de la part de ton Seigneur. L'origine est divine. « Inna Allaha khabirun » — Allah est Parfaitement Connaisseur. Il sait ce que je fais — et pourquoi je le fais. Le miroir m'invite à suivre la révélation avec confiance.`,
  reflection: `La révélation n'est pas une suggestion — elle est le chemin tracé par le Connaisseur de tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ittabi' ma yuha ilayka min rabbik inna Allaha khabirun bima ta'malun » — et suis ce qui t'est révélé de la part d'Allah. Allah est Parfaitement Connaisseur de ce que vous faites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la révélation ? Ou est-ce que je la négocie avec mes préférences ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Suivre la révélation n'est pas contrainte — c'est guidance vers le meilleur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout l'univers suit les lois divines. L'homme a reçu la révélation comme loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la révélation sans négocier a compris la confiance." }
  ],
  munajat: `Ya Rabb, fais que je suive Ta révélation sans négocier. Tu sais ce que je fais. Guide-moi par ce qui T'a été révélé.`
};

MIROIR["33:5"] = {
  reference: "33:5",
  theme: ["parenté", "adoption", "vérité"],
  emotion: "Honnêteté, justice",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "An-Nasab"],
  mirrorVersion: `« Appelez-les du nom de leurs pères. C'est plus équitable devant Allah. » Le miroir me montre l'importance de la vérité dans les liens familiaux. « Ud'uhum li-abaihim » — appelez-les du nom de leurs pères. La vérité de l'origine. « Huwa aqsatu 'inda Allah » — c'est plus équitable devant Allah. L'équité est dans la vérité, pas dans le sentiment. Le miroir m'invite à respecter les liens de parenté véritables.`,
  reflection: `La vérité de l'origine est plus juste que le sentiment de l'adoption. L'équité divine prime sur les arrangements humains.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ud'uhum li-abaihim huwa aqsatu 'inda Allah » — appelez-les du nom de leurs pères. C'est plus équitable devant Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la vérité de mes liens familiaux ? Ou est-ce que je les manipule ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoption spirituelle n'est pas adoption biologique. L'amour peut exister sans falsifier l'origine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature porte l'empreinte de son origine. La vérité de l'origine est cosmique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la vérité de l'origine respecte la création d'Allah." }
  ],
  munajat: `Ya Rabb, fais que je respecte la vérité des liens de parenté. Ne permets pas que je falsifie les origines. Donne-moi l'équité de la vérité.`
};

MIROIR["33:7"] = {
  reference: "33:7",
  theme: ["alliance", "prophètes", "engagement"],
  emotion: "Solennité, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mithaq", "Al-Anbiya"],
  mirrorVersion: `« Et quand Nous avons pris des prophètes leur engagement, de même que de toi, de Noé, d'Abraham, de Moïse et de Jésus fils de Marie. » Le miroir me montre la continuité de l'alliance prophétique. « Akhadhna » — Nous avons pris. L'initiative est divine. « Minka » — de toi. Muhammad est dans la lignée. « Min Nuhin » — de Noé. « Wa Ibrahim » — et d'Abraham. « Wa Musa » — et de Moïse. « Wa 'Isa » — et de Jésus. Les grands prophètes sont tous liés par cette alliance. Le miroir m'invite à comprendre ma place dans cette chaîne.`,
  reflection: `L'alliance prophétique est unique. Tous les messagers portent le même engagement : transmettre la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa idh akhadhna mina an-nabiyyina mithaqahum wa minka wa min Nuhin wa Ibrahim wa Musa wa 'Isa ibni Maryam » — et quand Nous avons pris des prophètes leur engagement, de même que de toi, de Noé, d'Abraham, de Moïse et de Jésus fils de Marie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends que je suis lié à cette chaîne prophétique par ma foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'alliance n'est pas avec des individus — elle est avec le message qu'ils portent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'humanité est unie par cette alliance prophétique à travers le temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend l'alliance comprend son appartenance à la communauté des croyants de tous les temps." }
  ],
  munajat: `Ya Rabb, Tu as pris l'engagement des prophètes. Fais que je sois fidèle à leur message. Inscris-moi dans la chaîne de l'alliance.`
};

MIROIR["33:8"] = {
  reference: "33:8",
  theme: ["vérité", "question", "responsabilité"],
  emotion: "Sérieux, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sadiq", "Al-Hisab"],
  mirrorVersion: `« Afin qu'Il questionne les véridiques sur leur sincérité. » Le miroir me montre la question finale. « Li-yas'ala » — afin qu'Il questionne. Le questionnement divin. « As-sadiqin » — les véridiques. Même les véridiques seront questionnés. « An sidqihim » — sur leur sincérité. La question porte sur le cœur, pas sur l'apparence. Le miroir m'interroge : suis-je préparé à cette question ?`,
  reflection: `La question finale ne porte pas sur le résultat — elle porte sur la sincérité du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-yas'ala as-sadiqina 'an sidqihim » — afin qu'Il questionne les véridiques sur leur sincérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si je suis questionné sur ma sincérité, que répondrai-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les véridiques sont questionnés — que dire de ceux qui ne le sont pas ?" },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La question finale révélera ce qui était caché. Rien ne restera voilé." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prépare sa réponse maintenant n'aura pas à préparer plus tard." }
  ],
  munajat: `Ya Rabb, Tu questionneras les véridiques sur leur sincérité. Prépare mon cœur pour cette question. Fais que ma sincérité soit réelle.`
};

MIROIR["33:9"] = {
  reference: "33:9",
  theme: ["gratitude", "bataille", "vents"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["An-Ni'mah", "Al-Riyah"],
  mirrorVersion: `« Ô vous qui croyez ! Rappelez-vous le bienfait d'Allah sur vous, quand des armées vinrent contre vous et que Nous envoyâmes contre elles un vent et des armées que vous ne voyiez pas. » Le miroir me montre l'aide invisible d'Allah. « Udhkuru ni'mata Allah » — rappelez-vous le bienfait d'Allah. La gratitude comme devoir. « Fa arsalna 'alayhim riha » — Nous envoyâmes contre elles un vent. L'arme divine est invisible. « Wa junudan » — et des armées. Les anges combattent pour les croyants. « La tarawnaha » — que vous ne voyiez pas. Le miroir m'invite à reconnaître l'aide invisible dans ma vie.`,
  reflection: `L'aide d'Allah peut prendre des formes invisibles. Le vent, les anges — des forces au-delà de notre perception.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha alladhina amanu udhkuru ni'mata Allahi 'alaykum idh ja'atkum junudun fa arsalna 'alayhim riha wa junudan lam tarawha » — ô vous qui croyez ! Rappelez-vous le bienfait d'Allah sur vous, quand des armées vinrent contre vous et que Nous envoyâmes contre elles un vent et des armées que vous ne voyiez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles aides invisibles Allah m'a-t-Il envoyées ? Est-ce que je les reconnais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'invisible est plus puissant que le visible. Les anges sont une armée réelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vent est une force cosmique. Allah l'utilise comme Il veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'aide invisible voit la main d'Allah partout." }
  ],
  munajat: `Ya Rabb, Tu m'as aidé par des forces invisibles. Ouvre mes yeux sur Ton aide. Fais que je sois reconnaissant pour ce que je ne vois pas.`
};

MIROIR["33:10"] = {
  reference: "33:10",
  theme: ["épreuve", "craigte", "confusion"],
  emotion: "Introspection, gratitude",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Bala'", "Al-Khawf"],
  mirrorVersion: `« Quand ils vinrent à vous par en haut et par en bas, et que les regards étaient troublés et les cœurs remontaient aux gorges. » Le miroir me montre l'intensité de l'épreuve. « Min fawqikum » — par en haut. « Wa min asfal » — et par en bas. L'encerclement. « Tazaghu al-absar » — les regards étaient troublés. La peur aveugle. « Al-qulubu ila al-hanajir » — les cœurs remontaient aux gorges. L'angoisse extrême. Le miroir me rappelle que même dans l'épreuve la plus intense, Allah était là.`,
  reflection: `L'épreuve peut être totale — encerclement, peur, angoisse. Mais la présence d'Allah est aussi totale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Idh ja'ukum min fawqikum wa min asfal minkum wa idh zaghati al-absaru wa al-qulubu ila al-hanajir » — quand ils vinrent à vous par en haut et par en bas, et que les regards étaient troublés et les cœurs remontaient aux gorges." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je vécu des moments où les cœurs remontaient aux gorges ? Comment ai-je réagi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'épreuve extrême révèle ce qui est vraiment dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'épreuve est universelle. Chaque être humain connaît l'angoisse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui traverse l'épreuve avec Allah en sort transformé." }
  ],
  munajat: `Ya Rabb, dans l'épreuve extrême, Tu étais là. Fais que je me souvienne de Ta présence dans les moments d'angoisse. Ne permets pas que la peur m'aveugle.`
};

// ==================== SURAH 13: AR-RA'D (43 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["13:1"] = {
  reference: "13:1",
  theme: ["révélation", "foi", "signes"],
  emotion: "Révérence, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Alif, Lam, Mim, Ra. Voici les versets du Livre. Ce qui t'est révélé par ton Seigneur est la vérité. » Le miroir me place devant la véracité du Coran. « Haqqu min rabbika » — c'est la vérité de ton Seigneur. Dans un monde de mensonges et d'illusions, le Coran est ancrage de vérité. Le miroir m'interroge : est-ce que je reconnais la vérité du Coran ?`,
  reflection: `Le Coran est la vérité. Le reconnaître, c'est s'ancrer dans la réalité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu al-kitabi » — voici les versets du Livre. « Wa alladhi unzila ilayka min rabbika al-haqq » — ce qui t'est révélé est la vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis selon la vérité du Coran ? Ou est-ce que je vis dans mes illusions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité n'est pas toujours confortable, mais elle libère." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne selon la vérité. Les lois naturelles ne mentent pas." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la vérité du Coran trouve la vérité de sa propre existence." }
  ],
  munajat: `Ya Haqq, Ton Livre est la vérité. Fais que je vive selon cette vérité. Ne permets pas que je me perde dans les illusions.`
};

MIROIR["13:3"] = {
  reference: "13:3",
  theme: ["création", "signes", "réflexion"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« C'est Lui qui a étendu la terre, placé des montagnes et des rivières, et de chaque fruit Il a placé deux espèces. » Le miroir me montre la diversité dans la création. La terre étendue — un tapis de vie. Les montagnes — des piquets d'ancrage. Les rivières — des veines nourricières. Les fruits par paires — diversité dans l'unité. Le miroir m'invite à voir les signes partout.`,
  reflection: `La création est diversifiée et équilibrée. Chaque élément a sa fonction et sa beauté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huwa alladhi madda al-arda » — c'est Lui qui a étendu la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je vois quand je regarde la nature ? Des signes ou du décor ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La diversité des fruits en paires enseigne la complémentarité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'équilibre de la création est fragile et parfait à la fois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la création voit le Créateur." }
  ],
  munajat: `Ya Khaliq, Ta création est merveilleuse. Ouvre mes yeux sur Ses signes. Fais que chaque élément de la nature me rappelle Toi.`
};

MIROIR["13:11"] = {
  reference: "13:11",
  theme: ["anges", "protection", "changement"],
  emotion: "Sécurité, responsabilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Malak"],
  mirrorVersion: `« Il a des anges qui se succèdent devant et derrière lui, gardant par le commandement d'Allah. Allah ne change pas ce qui est dans un peuple tant qu'ils ne changent pas ce qui est en eux-mêmes. » Le miroir me montre la protection angélique et la responsabilité humaine. Les anges gardent — mais la protection dépend de l'état intérieur. « Ma bi-anfusihim » — ce qui est en eux-mêmes. Le changement extérieur suit le changement intérieur. Le miroir m'interroge : qu'est-ce que je dois changer en moi ?`,
  reflection: `La protection divine est réelle, mais elle répond à notre état intérieur. Changer intérieurement attire la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lahu mu'aqqibatun min bayni yadayhi wa min khalfihi » — il a des anges qui se succèdent devant et derrière lui." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel changement dois-je opérer en moi pour attirer la protection d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les anges nous protègent — mais nous pouvons nous exclure de leur protection par nos actes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est gardé par des forces invisibles. L'homme est le seul à pouvoir s'exclure de cette garde." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui change son intérieur change son extérieur. La protection suit la transformation." }
  ],
  munajat: `Ya Hafiz, Tes anges me protègent. Aide-moi à changer ce qui doit changer en moi. Ne permets pas que je m'exclue de Ta protection.`
};

MIROIR["13:22"] = {
  reference: "13:22",
  theme: ["patience", "prière", "dépense"],
  emotion: "Persévérance, générosité",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Ar-Razzaq"],
  mirrorVersion: `« Ceux qui patientent en recherchant le visage de leur Seigneur, accomplissent la prière et dépensent de ce que Nous leur avons donné. » Le miroir me montre trois piliers spirituels : la patience (« sabaru »), la prière (« aqamu al-salat »), et la dépense (« anfaqu »). La patience est pour Allah, la prière est pour Allah, la dépense est pour Allah. Trois dimensions : temporelle, relationnelle, sociale. Le miroir m'interroge : ces trois piliers sont-ils présents dans ma vie ?`,
  reflection: `La patience, la prière, et la dépense forment un trépied spirituel stable.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina sabaru wajha rabbihim » — ceux qui patientent en recherchant le visage de leur Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je patiente ? Est-ce que je prie ? Est-ce que je donne ? Le miroir vérifie mon trépied spirituel." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience pour le visage d'Allah n'est pas une attente passive — c'est une recherche active." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers patiente, prie (dans sa langue), et donne. L'homme doit le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui maintient ces trois piliers a une vie spirituellement stable." }
  ],
  munajat: `Ya Rabb, aide-moi à patienter, à prier, et à donner. Ces trois piliers maintiennent ma vie spirituelle. Ne permets pas qu'ils s'effondrent.`
};

MIROIR["13:24"] = {
  reference: "13:24",
  theme: ["paix", "accueil", "récompense"],
  emotion: "Sérénité, appartenir",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Jannah"],
  mirrorVersion: `« Paix sur vous pour ce que vous avez patienté ! » Le miroir me montre l'accueil du Paradis. « Salamun 'alaykum » — paix sur vous. La récompense de la patience est la paix. Les anges accueillent les patients avec cette salutation. La patience terrestre devient paix éternelle. Le miroir m'interroge : est-ce que je patiente pour cette paix ?`,
  reflection: `La patience sur terre se convertit en paix au Paradis. Chaque moment de patience est un investissement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Salamun 'alaykum bi-ma sabartum » — paix sur vous pour ce que vous avez patienté." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Pourquoi je patiente ? Pour la paix éternelle ou pour les résultats immédiats ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La paix n'est pas seulement une récompense future — elle commence dans la patience présente." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers patiente et reçoit sa paix. L'ordre est la paix de l'univers patient." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte la paix dans la patience a déjà goûté au Paradis." }
  ],
  munajat: `Ya Salam, je patiente pour Ta paix. Accueille-moi avec « salamun 'alaykum » au Jour dernier. Fais que ma patience présente soit un investissement pour la paix éternelle.`
};

MIROIR["13:28"] = {
  reference: "13:28",
  theme: ["cœur", "paix", "rappel"],
  emotion: "Sérénité, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Adh-Dhikr"],
  mirrorVersion: `« Ceux qui ont cru et dont les cœurs se tranquillisent par le rappel d'Allah. N'est-ce point par le rappel d'Allah que les cœurs se tranquillisent ? » Le miroir me montre la formule de la paix intérieure. « Tatma'innu qulubuhum » — leurs cœurs se tranquillisent. Comment ? « Bi dhikri Allah » — par le rappel d'Allah. L'agitation du cœur n'est pas résolue par les distractions — elle est résolue par le rappel. Le miroir m'interroge : quand mon cœur s'agite, où vais-je ?`,
  reflection: `Le rappel d'Allah est la seule tranquillité durable. Les autres apaisements sont temporaires.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ala bi dhikri Allahi tatma'innu al-qulub » — n'est-ce point par le rappel d'Allah que les cœurs se tranquillisent ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand mon cœur s'agite, est-ce que je me tourne vers le dhikr ? Ou vers les distractions ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'agitation est le symptôme de l'oubli. La tranquillité est le symptôme du rappel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est en état de dhikr constant. Son ordre est sa tranquillité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique le dhikr constamment a un cœur constamment tranquille." }
  ],
  munajat: `Ya Rabb, mon cœur s'agite. Mais le dhikr le tranquillise. Apprends-moi à me tourner vers Toi dans l'agitation. Fais que mon cœur trouve sa paix en Toi.`
};

MIROIR["13:35"] = {
  reference: "13:35",
  theme: ["paradis", "promesse", "espérance"],
  emotion: "Espérance, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Wa'ud"],
  mirrorVersion: `« Voici la description du Paradis promis aux pieux : des jardins sous lesquels coulent les rivières. » Le miroir me montre la promesse du Paradis. « Jannat » — jardins. « Tajri min tahtiha al-anhar » — sous lesquels coulent les rivières. L'eau, la végétation, l'abondance. Le Paradis n'est pas abstrait — il est concret, sensoriel, désirable. Le miroir m'invite à espérer ce Paradis.`,
  reflection: `Le Paradis est une réalité concrète et désirable. L'espérer motive la piété présente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalu al-jannati allati wu'ida al-muttaqun » — voici la description du Paradis promis aux pieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le Paradis ? Ou est-ce que les plaisirs de ce monde me suffisent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas une compensation pour les souffrances — c'est l'accomplissement de la création." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jardins terrestres sont des échos du Paradis. Chaque jardin est une invitation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire vraiment le Paradis y travaille vraiment." }
  ],
  munajat: `Ya Rabb, je désire Ton Paradis. Fais que ce désir m'inspire à la piété. Ne permets pas que les plaisirs de ce monde me suffisent.`
};

// ==================== SURAH 14: IBRAHIM (52 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["14:1"] = {
  reference: "14:1",
  theme: ["révélation", "lumière", "guidance"],
  emotion: "Ouverture, clarté",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Livre que Nous avons fait descendre vers toi pour faire sortir les gens des ténèbres vers la lumière. » Le miroir me montre la mission du Coran. « Nukhrija al-nasa min al-zulumati ila al-nur » — faire sortir les gens des ténèbres vers la lumière. Le Coran n'est pas un texte — c'est un passage. Des ténèbres de l'égarement vers la lumière de la guidance. Le miroir m'interroge : de quelles ténèbres le Coran me fait-il sortir ?`,
  reflection: `Le Coran est un passage des ténèbres vers la lumière. Chaque verset est une étape.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-tukhrija al-nasa min al-zulumati ila al-nuri » — pour faire sortir les gens des ténèbres vers la lumière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quelles ténèbres le Coran me fait-il sortir ? Vers quelle lumière me guide-t-il ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les ténèbres ne sont pas seulement extérieures — elles sont intérieures. Le Coran éclaire de l'intérieur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La lumière physique permet de voir. La lumière du Coran permet de comprendre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est sorti des ténèbres ne veut plus y retourner." }
  ],
  munajat: `Ya Nur, fais-moi sortir des ténèbres vers Ta lumière. Ton Coran est le chemin. Ne permets pas que je reste dans l'obscurité.`
};

MIROIR["14:7"] = {
  reference: "14:7",
  theme: ["gratitude", "bénédiction", "ingratitude"],
  emotion: "Reconnaissance, vigilance",
  difficulty: "débutant",
  relatedNames: ["Ash-Shakur", "Al-Mannan"],
  mirrorVersion: `« Et quand votre Seigneur proclama : 'Si vous êtes reconnaissants, J'augmenterai pour vous. Si vous êtes ingrats, Mon châtiment est terrible.' » Le miroir me montre la loi de la gratitude. « La'in shakartum la-azidannakum » — si vous êtes reconnaissants, J'augmenterai. La gratitude n'est pas une parole — c'est un état qui attire l'augmentation. L'ingratitude attire le retrait. Le miroir m'interroge : suis-je dans la gratitude ou dans l'ingratitude ?`,
  reflection: `La gratitude attire l'augmentation. L'ingratitude attire la perte. C'est une loi spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La'in shakartum la-azidannakum » — si vous êtes reconnaissants, J'augmenterai pour vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour ce que j'ai ? Ou est-ce que je me plains de ce que je n'ai pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude n'est pas ressentir — c'est reconnaître. Reconnaître le Donateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne à ceux qui reçoivent avec reconnaissance. La nature abonde pour le cœur reconnaissant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est reconnaissant pour le peu reçoit beaucoup. Celui qui est ingrat pour le beaucoup perd tout." }
  ],
  munajat: `Ya Shakur, je suis reconnaissant pour tout ce que Tu m'as donné. Augmente mes bénédictions. Ne permets pas que l'ingratitude s'installe dans mon cœur.`
};

MIROIR["14:24"] = {
  reference: "14:24",
  theme: ["parole", "arbre", "bonté"],
  emotion: "Espérance, fertilité",
  difficulty: "débutant",
  relatedNames: ["Al-Barr", "Al-Karim"],
  mirrorVersion: `« N'as-tu pas vu comment Allah propose en parabole une bonne parole comme un bel arbre ? » Le miroir me montre la parabole de la bonne parole. « Kalimatan tayyibatan » — une bonne parole. « Ka-shajaratin tayyibatin » — comme un bel arbre. La bonne parole a des racines profondes et des branches élevées. Elle produit des fruits. Elle donne de l'ombre. Le miroir m'interroge : quelles paroles je prononce ? Sont-elles de bons arbres ?`,
  reflection: `Les bonnes paroles sont comme des arbres : elles s'enracinent, s'élèvent, et produisent des fruits.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kalimatan tayyibatan ka-shajaratin tayyibatin » — une bonne parole comme un bel arbre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles paroles je prononce ? Sont-elles des arbres qui portent des fruits ou des plantes qui se fanent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les racines profondes, c'est la sincérité. Les branches élevées, c'est l'impact. Les fruits, ce sont les conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'arbre est le symbole de la croissance et de la contribution. La bonne parole participe à l'ordre de la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui plante de bonnes paroles récolte de bons fruits." }
  ],
  munajat: `Ya Rabb, fais que mes paroles soient de bons arbres. Donne-leur des racines profondes et des branches élevées. Fais qu'elles portent des fruits pour les autres.`
};

MIROIR["14:34"] = {
  reference: "14:34",
  theme: ["bénédictions", "gratitude", "incomptable"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Et si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer. » Le miroir me place devant l'incomptable. « In ta'uddu ni'mata Allahi la tuhsuha » — si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer. Chaque souffle est un bienfait. Chaque battement de cœur. Chaque cellule qui fonctionne. Les bienfaits invisibles sont plus nombreux que les visibles. Le miroir m'interroge : est-ce que j'essaie de compter ?`,
  reflection: `Les bienfaits d'Allah sont incomptables. La gratitude est pour ce qu'on connaît, mais aussi pour ce qu'on ne connaît pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in ta'uddu ni'mata Allahi la tuhsuha » — si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Combien de bienfaits je connais ? Combien m'échappent ? Le miroir m'invite à la gratitude pour l'inconnu." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incapacité de compter n'est pas une frustration — c'est une invitation à la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un bienfait. Chaque atome, chaque force, chaque loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui essaie de compter reconnaît l'infinité du Donateur." }
  ],
  munajat: `Ya Mannan, Tes bienfaits sont incomptables. Je suis reconnaissant pour ce que je connais et pour ce que je ne connais pas. Fais que je vive dans cette reconnaissance constante.`
};

MIROIR["14:42"] = {
  reference: "14:42",
  theme: ["justice", "patience", "compte"],
  emotion: "Confiance, espérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Adl", "Al-Hasib"],
  mirrorVersion: `« Ne pense pas qu'Allah soit inattentif à ce que font les injustes. » Le miroir me rassure sur la justice d'Allah. « La tahsabanna Allaha ghaflan » — ne pense pas qu'Allah soit inattentif. L'injustice apparente n'est pas l'injustice réelle. Allah voit tout, enregistre tout, et jugera tout. Le délai n'est pas l'oubli. Le miroir m'interroge : est-ce que je fais confiance à la justice d'Allah ?`,
  reflection: `La justice d'Allah est certaine. Le délai est une miséricorde, pas une négligence.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tahsabanna Allaha ghaflan 'amma ya'malu al-zalimun » — ne pense pas qu'Allah soit inattentif à ce que font les injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois l'injustice, est-ce que je désespère de la justice d'Allah ? Ou est-ce que je fais confiance à Son timing ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai de la justice est un temps de repentir pour l'injuste et de patience pour la victime." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par équilibre. Toute perturbation finit par être corrigée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la justice d'Allah ne cherche pas sa propre vengeance." }
  ],
  munajat: `Ya 'Adl, Ta justice est certaine. Quand je vois l'injustice, aide-moi à faire confiance à Ton timing. Ne permets pas que je désespère.`
};

// ==================== SURAH 15: AL-HIJR (99 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["15:1"] = {
  reference: "15:1",
  theme: ["révélation", "signes", "foi"],
  emotion: "Révérence, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Khabir"],
  mirrorVersion: `« Alif, Lam, Ra. Voici les versets du Livre et d'une récitation explicite. » Le miroir m'ouvre la sourate Al-Hijr. « Kitab » — Livre. « Quran mubin » — récitation explicite. Le Coran est à la fois écrit (Livre) et récité (Quran). Sa clarté est son identité. Le miroir m'invite à lire ce Livre comme une récitation claire.`,
  reflection: `Le Coran est Livre et Récitation. Écrit et oral. Clair et profond.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tilka ayatu al-kitabi wa qur'anin mubin » — voici les versets du Livre et d'une récitation explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'approche le Coran ? Comme un Livre à lire ou comme une Récitation à entendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La clarté du Coran n'est pas simplification — c'est accessibilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est à la fois visible et audible. Le Coran rejoint cette double nature." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit et écoute le Coran reçoit sa double bénédiction." }
  ],
  munajat: `Ya Rabb, Ton Coran est Livre et Récitation. Fais que je Le lise et L'entende. Ne permets pas que je m'approche que d'un seul côté.`
};

MIROIR["15:9"] = {
  reference: "15:9",
  theme: ["préservation", "coran", "promesse"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hafiz", "Al-Haqq"],
  mirrorVersion: `« C'est Nous qui avons fait descendre le Rappel, et c'est Nous qui en sommes les gardiens. » Le miroir me montre la promesse de préservation. « Nahnu nazzalna al-dhikra » — c'est Nous qui avons fait descendre le Rappel. « Wa inna lahu la-hafizun » — et c'est Nous qui en sommes les gardiens. Le Coran est préservé de toute altération. Cette promesse est tenue depuis 1400 ans. Le miroir m'invite à faire confiance à cette préservation.`,
  reflection: `Le Coran est préservé par Allah. Sa conservation à travers les siècles est un miracle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna nahnu nazzalna al-dhikra wa inna lahu la-hafizun » — c'est Nous qui avons fait descendre le Rappel, et c'est Nous qui en sommes les gardiens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la préservation du Coran ? Est-ce que je Le considère comme non altéré ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préservation du Coran n'est pas passive — elle est active par la mémorisation de millions." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est préservé par des lois constantes. Le Coran est préservé par la promesse d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui mémorise le Coran participe à Sa préservation." }
  ],
  munajat: `Ya Hafiz, Tu préserves Ton Coran. Merci pour cette promesse tenue. Fais que je participe à Sa préservation par ma mémorisation.`
};

MIROIR["15:49"] = {
  reference: "15:49",
  theme: ["pardon", "miséricorde", "annonce"],
  emotion: "Espoir, soulagement",
  difficulty: "débutant",
  relatedNames: ["Al-Ghaffur", "Ar-Rahim"],
  mirrorVersion: `« Annonce à Mes serviteurs que Je suis le Pardonneur, le Miséricordieux. » Le miroir me montre l'annonce de la miséricorde. « Nabbih 'ibadi » — annonce à Mes serviteurs. Quoi ? « Anni ana al-ghaffuru al-rahim » — que Je suis le Pardonneur, le Miséricordieux. Cette annonce est pour tous. Le pardon et la miséricorde sont disponibles. Le miroir m'invite à recevoir cette annonce et à la propager.`,
  reflection: `Allah annonce Lui-même Sa miséricorde. Recevoir cette annonce, c'est recevoir l'espoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nabbih 'ibadi annani ana al-ghaffuru al-rahim » — annonce à Mes serviteurs que Je suis le Pardonneur, le Miséricordieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai entendu cette annonce ? Est-ce que je la crois ? Est-ce que je la propage ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde est annoncée avant le châtiment. L'espoir précède la crainte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait de miséricorde avant d'être fait de jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit vraiment cette annonce ne désespère jamais." }
  ],
  munajat: `Ya Ghaffur, Tu annonces Ton pardon et Ta miséricorde. Je reçois cette annonce. Fais que je ne désespère jamais. Aide-moi à annoncer cette bonne nouvelle aux autres.`
};

MIROIR["15:85"] = {
  reference: "15:85",
  theme: ["création", "but", "miséricorde"],
  emotion: "Paix, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Ar-Rahman"],
  mirrorVersion: `« Nous n'avons créé les cieux et la terre et ce qui est entre eux qu'en toute vérité. L'Heure arrive. Pardonne donc de belle façon. » Le miroir me montre le but de la création et la réponse appropriée. « Bi-al-haqq » — en toute vérité. La création n'est pas un jeu — elle a un sens. Et la réponse du croyant face à ce sens : « Fasfah al-safh al-jamil » — pardonne donc de belle façon. Le miroir m'interroge : est-ce que je pardonne de belle façon ?`,
  reflection: `La création a un sens. Le croyant répond par le pardon, reflétant la miséricorde du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma khalaqna al-samawati wa al-arda wa ma baynahuma illa bi-al-haqq » — nous n'avons créé les cieux et la terre qu'en toute vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je pardonne de belle façon ? Ou est-ce que je garde rancune ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas oubli — c'est relâchement du droit de punir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne garde pas rancune. Il continue à donner malgré les abus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne de belle façon participe à l'ordre de la création." }
  ],
  munajat: `Ya Khaliq, Tu as créé en vérité. Aide-moi à pardonner de belle façon. Ne permets pas que la rancune m'alourdisse.`
};

MIROIR["15:99"] = {
  reference: "15:99",
  theme: ["adoration", "mort", "certitude"],
  emotion: "Détermination, priorité",
  difficulty: "débutant",
  relatedNames: ["Al-'Abd", "Al-Mawt"],
  mirrorVersion: `« Et adore ton Seigneur jusqu'à ce que te vienne la certitude. » Le miroir me montre la durée de l'adoration. « Hatta ya'tiyaka al-yaqin » — jusqu'à ce que te vienne la certitude. La « certitude » ici signifie la mort. L'adoration dure jusqu'à la mort. Pas de retraite spirituelle. Pas de pause. L'adoration est un état continu jusqu'à la fin. Le miroir m'interroge : est-ce que j'adore jusqu'à la mort ?`,
  reflection: `L'adoration est un état continu. Elle ne connaît pas de pause avant la mort.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'bud rabbaka hatta ya'tiyaka al-yaqin » — et adore ton Seigneur jusqu'à ce que te vienne la certitude." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je peux dire que j'adore jusqu'à la mort ? Ou est-ce que je prévois des pauses ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mort est la seule certitude. L'adoration est la préparation à cette certitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature adore jusqu'à sa mort. L'arbre donne jusqu'à ce qu'il meure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore jusqu'à la mort rencontre la mort en adoration." }
  ],
  munajat: `Ya Rabb, je veux T'adorer jusqu'à ma mort. Ne permets pas que je m'arrête avant. Fais que ma dernière heure soit une heure d'adoration.`
};

// ==================== SURAH 51: ADH-DHARIYAT (60 verses) - COMPREHENSIVE COVERAGE ====================

MIROIR["51:2"] = {
  reference: "51:2",
  theme: ["nuages", "provision", "création"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Khaliq"],
  mirrorVersion: `« Par les nuages chargés de fardeau ! » Le miroir contemple les nuages. « Al-hamilat » — celles qui portent. « Wiqran » — un fardeau, une charge. Les nuages portent l'eau, la provision de la terre. Ils sont les porteurs de la miséricorde divine. Le miroir m'interroge : est-ce que je vois les nuages comme des porteurs de bénédiction ?`,
  reflection: `Les nuages portent l'eau qui donne la vie. Ils sont les serviteurs invisibles de la provision d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-hamilati wiqran » — par les nuages chargés de fardeau." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je vois les nuages, est-ce que je pense à la provision qu'ils portent ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le fardeau du nuage devient bénédiction pour la terre. Mon fardeau peut devenir bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'eau circule dans l'univers. Les nuages sont une étape de ce cycle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les nuages contemple la provision d'Allah qui descend du ciel." }
  ],
  munajat: `Ya Razzaq, Tu envoies la provision par les nuages. Ouvre mes yeux sur Tes bienfaits. Fais que chaque nuage me rappelle Ta générosité.`
};

MIROIR["51:3"] = {
  reference: "51:3",
  theme: ["navigation", "facilité", "guidance"],
  emotion: "Confiance, sérénité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Musahhil"],
  mirrorVersion: `« Par les navires qui naviguent aisément ! » Le miroir contemple les navires. « Al-jariyat » — celles qui naviguent. « Yusra » — aisément, avec facilité. Les bateaux glissent sur la mer par la permission d'Allah. La création est faite pour la facilité, pas la difficulté. Le miroir m'interroge : est-ce que je navigue dans ma vie avec aisance ou avec lutte ?`,
  reflection: `La facilité est inscrite dans la création. Les navires glissent parce qu'Allah l'a permis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-jariyati yusra » — par les navires qui naviguent aisément." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis ma vie avec aisance ou avec lutte constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La facilité demande de suivre le courant divin, pas de nager à contre-courant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait pour faciliter la vie. L'eau porte le navire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance d'Allah navigue avec aisance dans l'existence." }
  ],
  munajat: `Ya Musahhil, facilite ma vie. Fais que je navigue avec aisance sur la mer de l'existence. Guide-moi vers le courant de Ta volonté.`
};

MIROIR["51:4"] = {
  reference: "51:4",
  theme: ["anges", "distribution", "ordre"],
  emotion: "Révérence, conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mala'ika", "Al-Mudabbir"],
  mirrorVersion: `« Par les distributeurs selon un ordre ! » Le miroir contemple les anges. « Al-muqassimat » — les distributeurs. « Amran » — un ordre, un commandement. Les anges distribuent les décrets d'Allah. Ils sont les agents de Sa volonté dans la création. Le miroir m'interroge : est-ce que je reconnais l'ordre divin derrière les événements de ma vie ?`,
  reflection: `Les anges exécutent l'ordre d'Allah. Rien n'est laissé au hasard.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-al-muqassimati amran » — par les distributeurs selon un ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois l'ordre divin derrière les événements de ma vie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La distribution n'est pas aléatoire — elle suit un ordre parfait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est géré par des lois précises. Les anges sont les agents de ces lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'ordre divin accepte tout avec gratitude." }
  ],
  munajat: `Ya Mudabbir, Tu ordonnes et les anges exécutent. Fais que je reconnaisse Ton ordre dans ma vie. Aide-moi à accepter Ta distribution.`
};

MIROIR["51:5"] = {
  reference: "51:5",
  theme: ["promesse", "vérité", "foi"],
  emotion: "Certitude, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Wa'ud"],
  mirrorVersion: `« Ce qui vous est promis est certainement vrai. » Le miroir affirme la promesse. « Ma tu'adun » — ce qui vous est promis. « La-haqq » — est certainement vrai. La promesse d'Allah est vérité. Le Paradis, le Jugement, la Résurrection — tout est vrai. Le miroir m'interroge : est-ce que je crois vraiment à la promesse d'Allah ?`,
  reflection: `La promesse d'Allah ne faillit jamais. Ce qu'Il dit arrive.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna ma tu'adun la-haqq » — ce qui vous est promis est certainement vrai." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment à la promesse d'Allah ? Est-ce que j'agis en conséquence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La promesse est vraie même quand je ne la vois pas encore." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers témoigne de la véracité d'Allah. Ses signes confirment Sa parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la promesse vit déjà dans sa réalité." }
  ],
  munajat: `Ya Sadiq, Ta promesse est vraie. Renforce ma foi en Ta parole. Fais que je vive comme si la promesse était déjà accomplie.`
};

MIROIR["51:6"] = {
  reference: "51:6",
  theme: ["jugement", "rétribution", "justice"],
  emotion: "Responsabilité, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Hakam", "Al-'Adl"],
  mirrorVersion: `« Et le Jugement aura lieu certainement. » Le miroir me place devant le Jugement. « Ad-din » — le Jugement, la rétribution. « La-waqi' » — aura certainement lieu. Le Jour du Jugement est une certitude. Chaque action sera examinée. Le miroir m'interroge : est-ce que je vis en sachant que je serai jugé ?`,
  reflection: `Le Jugement est certain. Chaque action compte. La justice sera faite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa inna al-dina la-waqi' » — et le Jugement aura lieu certainement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en sachant que je serai jugé sur chaque action ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Jugement n'est pas une menace — c'est une justice." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est justicier. Chaque cause a un effet. Le Jugement en est l'aboutissement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le Jugement vit avec intégrité." }
  ],
  munajat: `Ya Hakam, le Jugement est certain. Aide-moi à vivre en sachant que je Te rencontrerai. Fais que chaque action soit conforme à Ta volonté.`
};

MIROIR["51:7"] = {
  reference: "51:7",
  theme: ["ciel", "perfection", "ordre"],
  emotion: "Émerveillement, humilité",
  difficulty: "débutant",
  relatedNames: ["As-Sama'", "Al-Musawwir"],
  mirrorVersion: `« Par le ciel aux voies parfaites ! » Le miroir contemple le ciel. « Dhi al-hubuk » — aux voies parfaites, aux orbites. Le ciel est parfait dans son ordre. Les étoiles suivent leurs orbites. Rien n'est laissé au hasard. Le miroir m'interroge : est-ce que je contemple la perfection du ciel ?`,
  reflection: `Le ciel est parfait. Son ordre témoigne de la perfection du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa as-sama'i dhi al-hubuk » — par le ciel aux voies parfaites." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je regarde le ciel, est-ce que je vois sa perfection ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perfection du ciel m'invite à chercher la perfection dans ma vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est parfaitement ordonné. Le ciel en est le témoignage visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple la perfection du ciel contemple la perfection d'Allah." }
  ],
  munajat: `Ya Musawwir, le ciel est parfait. Fais que je voie Ta perfection dans chaque aspect de la création. Invite-moi à chercher l'excellence.`
};

MIROIR["51:8"] = {
  reference: "51:8",
  theme: ["discours", "contradiction", "vérité"],
  emotion: "Lucidité, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Furqan"],
  mirrorVersion: `« Vous tenez des discours contradictoires. » Le miroir expose la contradiction. « Lafi » — discours, paroles. « Mukhtalif » — contradictoires. Les gens parlent de tout, se contredisent, changent d'avis. Mais la vérité reste une. Le miroir m'interroge : est-ce que mes paroles sont cohérentes avec mes actes ?`,
  reflection: `Les discours humains sont contradictoires. La vérité d'Allah est constante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innakum lafi qawlin mukhtalif » — vous tenez des discours contradictoires." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que mes paroles sont cohérentes ? Est-ce que je me contredis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contradiction des hommes contraste avec la constance d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se contredit pas. Ses lois sont constantes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui aligne ses paroles sur la vérité d'Allah trouve l'unité." }
  ],
  munajat: `Ya Haqq, Tes paroles sont vérité. Aide-moi à aligner mes paroles sur les Tiennes. Ne permets pas que je me contredise.`
};

MIROIR["51:9"] = {
  reference: "51:9",
  theme: ["égarement", "guidance", "choix"],
  emotion: "Humilité, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Mudill"],
  mirrorVersion: `« Est détourné de la vérité celui qui est détourné. » Le miroir montre la conséquence du choix. « Yu'faku » — est détourné. L'égarement n'est pas imposé — il est le résultat de nos choix. Celui qui se détourne de la vérité finit par être détourné. Le miroir m'interroge : est-ce que je me détourne de la vérité ?`,
  reflection: `L'égarement est une conséquence, pas une condamnation. Le choix nous appartient.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yu'faku 'anhu man ufika » — est détourné celui qui est détourné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me détourne de la vérité ? Qu'est-ce qui m'éloigne d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détournement est un choix. Le retour est aussi un choix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne se détourne pas de son Créateur. Il reste aligné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui revient vers Allah trouve la porte ouverte." }
  ],
  munajat: `Ya Hadi, ne permets pas que je me détourne de la vérité. Quand je m'éloigne, ramène-moi. Guide-moi vers le droit chemin.`
};

MIROIR["51:10"] = {
  reference: "51:10",
  theme: ["mensonge", "hypocrisie", "perdition"],
  emotion: "Tristesse, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Khabir"],
  mirrorVersion: `« Que périssent les menteurs ! » Le miroir maudit le mensonge. « Qutila » — que périssent. « Al-kharrasun » — les menteurs, ceux qui spéculent sans preuve. Le mensonge mène à la perdition. La spéculation sans vérité est dangereuse. Le miroir m'interroge : est-ce que je mens ? Est-ce que je spécule sans preuve ?`,
  reflection: `Le mensonge est destructeur. La vérité est salvatrice.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qutila al-kharrasun » — que périssent les menteurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mens ? Est-ce que je spécule sans preuve sur les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mensonge peut sembler profitable, mais il mène à la perdition." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas. Il est vrai dans sa manifestation." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité vit dans la lumière." }
  ],
  munajat: `Ya Haqq, je veux vivre dans la vérité. Préserve-moi du mensonge et de la spéculation. Fais que mes paroles soient vraies.`
};

MIROIR["51:11"] = {
  reference: "51:11",
  theme: ["insouciance", "distraction", "égarement"],
  emotion: "Tristesse, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Munabbi", "Al-Ghafil"],
  mirrorVersion: `« Ceux qui sont plongés dans l'insouciance et la distraction. » Le miroir décrit l'état des égarés. « Ghafilat » — insouciants. « Hum » — dans une distraction. L'insouciance est le voile qui cache la vérité. La distraction éloigne d'Allah. Le miroir m'interroge : suis-je insouciant ? Suis-je distrait ?`,
  reflection: `L'insouciance est l'ennemie de la conscience. La distraction voile la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina hum fi ghamratin yal'abun » — ceux qui sont plongés dans l'insouciance et jouent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je insouciant ? Qu'est-ce qui me distrait d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'insouciance n'est pas l'innocence — c'est le refus de voir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne joue pas — il est sérieux dans son existence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sort de l'insouciance entre dans la présence." }
  ],
  munajat: `Ya Rabb, je ne veux pas être insouciant. Réveille-moi de ma distraction. Fais que je sois présent à Toi dans chaque moment.`
};

MIROIR["51:12"] = {
  reference: "51:12",
  theme: ["jugement", "questionnement", "moquerie"],
  emotion: "Sérieux, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qa'im", "Al-Hakam"],
  mirrorVersion: `« Ils demandent : "À quand le Jour du Jugement ?" » Le miroir entend leur question. « Ayyana » — quand. « Yawm al-din » — le Jour du Jugement. Ils demandent par moquerie, pas par foi. Ils veulent prouver que c'est faux. Le miroir m'interroge : est-ce que je demande par foi ou par défi ?`,
  reflection: `La question peut être sincère ou moqueuse. L'intention détermine la valeur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yas'aluna ayyana yawm al-din » — ils demandent : quand est le Jour du Jugement ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je pose mes questions à Allah ? Avec foi ou avec défi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question moqueuse devient accusation le Jour venu." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers n'a pas besoin de demander quand — il obéit à son heure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui questionne avec foi reçoit la réponse. Celui qui défie reste sans réponse." }
  ],
  munajat: `Ya Rabb, je pose mes questions avec foi. Ne permets pas que je sois moqueur. Fais que je cherche la vérité avec humilité.`
};

MIROIR["51:13"] = {
  reference: "51:13",
  theme: ["châtiment", "feu", "réalité"],
  emotion: "Crainte, prise de conscience",
  difficulty: "débutant",
  relatedNames: ["An-Nar", "Al-Jahim"],
  mirrorVersion: `« C'est le jour où ils seront éprouvés dans le Feu. » Le miroir révèle la réalité. « Yawm » — le jour. « Yunawwan » — ils seront éprouvés, tourmentés. « Fi al-nar » — dans le Feu. Le châtiment est réel. Le Feu attend les égarés. Le miroir m'interroge : est-ce que je prends au sérieux la réalité du Feu ?`,
  reflection: `Le Feu est réel. Il n'est pas une métaphore. Il attend ceux qui s'égarent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma hum 'ala al-nar yuftanun » — le jour où ils seront éprouvés dans le Feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prends au sérieux la réalité du Feu ? Est-ce que j'agis en conséquence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Feu est évitable. Il est le résultat des choix, pas une fatalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu existe dans l'univers comme énergie. Le Feu de l'au-delà est sa manifestation ultime." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le Feu maintenant sera protégé du Feu alors." }
  ],
  munajat: `Ya Rabb, je crains Ton Feu. Préserve-moi de l'épreuve du Feu. Guide-moi vers le Paradis. Ne permets pas que je sois parmi les égarés.`
};

MIROIR["51:14"] = {
  reference: "51:14",
  theme: ["ironie", "rétribution", "réalité"],
  emotion: "Stupéfaction, prise de conscience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-Hakam"],
  mirrorVersion: `« Goûtez votre épreuve ! Voici ce que vous cherchiez à hâter. » Le miroir ironise sur leur sort. « Dhuqu » — goûtez. « Fitnatakum » — votre épreuve, votre tourment. « Alladhi kuntum bihi tasta'jilun » — ce que vous cherchiez à hâter. Ils demandaient le Jour par moquerie — ils le reçoivent dans le châtiment. Le miroir m'interroge : qu'est-ce que je cherche à hâter ?`,
  reflection: `Ce qu'on cherche par moquerie peut devenir notre réalité. L'ironie du destin.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Dhuqu fitnatakum hadha alladhi kuntum bihi tasta'jilun » — goûtez votre épreuve, voici ce que vous cherchiez à hâter." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je demande à Allah ? Est-ce que je réalise ce que je demande ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La moquerie se retourne contre le moqueur. Le défi devient condamnation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas. La réalité rattrape toujours la moquerie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah ne défie pas Son ordre." }
  ],
  munajat: `Ya Rabb, je ne veux pas défier Ton ordre. Je prends au sérieux Tes promesses et Tes menaces. Préserve-moi de l'ironie du sort.`
};

MIROIR["51:15"] = {
  reference: "51:15",
  theme: ["paradis", "récompense", "piété"],
  emotion: "Espérance, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Jannah", "Al-Jannat"],
  mirrorVersion: `« Les pieux seront dans des jardins et des sources. » Le miroir change de ton — du châtiment à la récompense. « Al-muttaqun » — les pieux, ceux qui craignent Allah. « Fi jannatin » — dans des jardins. « Wa 'uyun » — et des sources. La piété mène au Paradis. Le miroir m'interroge : suis-je parmi les pieux ?`,
  reflection: `La piété est le chemin vers le Paradis. Les jardins et les sources attendent les croyants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna al-muttaqina fi jannatin wa 'uyun » — les pieux seront dans des jardins et des sources." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les pieux ? Est-ce que ma vie reflète la taqwa ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le Paradis n'est pas un hasard — c'est le fruit de la piété." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les jardins sur terre sont des signes des jardins du Paradis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui goûte à la piété goûte déjà au Paradis." }
  ],
  munajat: `Ya Rabb, je veux être parmi les pieux. Fais que ma vie soit marquée par la taqwa. Accorde-moi les jardins et les sources du Paradis.`
};

MIROIR["51:16"] = {
  reference: "51:16",
  theme: ["contentement", "délasse", "récompense"],
  emotion: "Joie, satisfaction",
  difficulty: "débutant",
  relatedNames: ["Ar-Razi", "Al-Mut'im"],
  mirrorVersion: `« Prenant ce que leur Seigneur leur a donné. » Le miroir montre la satisfaction. « Akhidhina » — prenant, recevant. « Ma atahum » — ce que leur Seigneur leur a donné. Les habitants du Paradis reçoivent avec joie les dons d'Allah. Le miroir m'interroge : est-ce que je reçois les dons d'Allah avec gratitude ?`,
  reflection: `Les dons d'Allah sont reçus avec joie au Paradis. Sur terre aussi, la gratitude est la clé.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Akhidhina ma atahum rabbuhum » — prenant ce que leur Seigneur leur a donné." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois les dons d'Allah avec gratitude ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le don n'est pas un droit — c'est une grâce." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne abondamment à ceux qui savent recevoir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour le peu recevra le beaucoup." }
  ],
  munajat: `Ya Razzaq, je remercie pour Tes dons. Fais que je reçoive avec gratitude ce que Tu m'accordes. Prépare-moi pour les dons du Paradis.`
};

MIROIR["51:17"] = {
  reference: "51:17",
  theme: ["prière", "nuit", "dévotion"],
  emotion: "Intimité, paix",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qa'im", "Al-Munajji"],
  mirrorVersion: `« Ils dormaient peu la nuit. » Le miroir montre la dévotion nocturne. « Kanu qalilan mina al-layli » — ils dormaient peu la nuit. Les croyants préféraient la prière au sommeil. La nuit est le temps de l'intimité avec Allah. Le miroir m'interroge : est-ce que je sacrifie mon sommeil pour Allah ?`,
  reflection: `La nuit est le temps de l'intimité. Ceux qui prient la nuit goûtent à une proximité spéciale.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kanu qalilan mina al-layli ma yahja'un » — ils dormaient peu la nuit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je prie la nuit ? Suis-je prêt à sacrifier mon sommeil pour Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sacrifice du sommeil n'est pas une perte — c'est un gain spirituel." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nuit est faite pour le repos, mais aussi pour la prière des élus." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie la nuit goûte à une intimité qu'il ne trouve pas le jour." }
  ],
  munajat: `Ya Rabb, aide-moi à prier la nuit. Donne-moi la force de sacrifier mon sommeil pour Toi. Fais que je goûte à l'intimité nocturne.`
};

MIROIR["51:18"] = {
  reference: "51:18",
  theme: ["repentir", "aube", "pardon"],
  emotion: "Espoir, renouveau",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffar"],
  mirrorVersion: `« Et aux dernières heures de la nuit, ils imploraient le pardon. » Le miroir montre le repentir matinal. « Bi-al-ashar » — aux dernières heures de la nuit, avant l'aube. « Yastaghfirun » — ils imploraient le pardon. L'aube est le temps du pardon. Le cœur se purifie avant le jour. Le miroir m'interroge : est-ce que je me repens à l'aube ?`,
  reflection: `L'aube est le temps du pardon. Le repentir à ce moment purifie le cœur pour la journée.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa bi-al-ashar hum yastaghfirun » — et aux dernières heures de la nuit, ils imploraient le pardon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens à l'aube ? Est-ce que je commence ma journée par le pardon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon de l'aube prépare le cœur pour le jour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'aube est le moment où la lumière succède à l'obscurité. Le pardon succède au péché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent à l'aube commence sa journée purifié." }
  ],
  munajat: `Ya Ghaffar, je me repens à l'aube. Pardonne-moi mes fautes. Fais que chaque aube soit un nouveau départ dans Ta miséricorde.`
};

MIROIR["51:19"] = {
  reference: "51:19",
  theme: ["charité", "droit", "générosité"],
  emotion: "Compassion, solidarité",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Karim"],
  mirrorVersion: `« Et dans leurs biens, il y avait une part pour le mendiant et le démuni. » Le miroir montre la générosité. « Fi amwalihim haqq » — dans leurs biens, un droit. « Li-ssa'ili wa al-mahrum » — pour le mendiant et le démuni. La charité n'est pas optionnelle — c'est un droit des pauvres dans les biens des riches. Le miroir m'interroge : est-ce que je donne aux nécessiteux ?`,
  reflection: `Les pauvres ont un droit sur les biens des riches. La charité est une obligation, pas une option.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi amwalihim haqqun li-ssa'ili wa al-mahrum » — et dans leurs biens, un droit pour le mendiant et le démuni." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne aux nécessiteux ? Est-ce que je reconnais leur droit sur mes biens ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Donner n'appauvrit pas — c'est un investissement dans l'au-delà." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers donne sans compter. Le soleil éclaire gratuitement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne aux pauvres donne à Allah." }
  ],
  munajat: `Ya Razzaq, fais que je sois généreux. Aide-moi à reconnaître le droit des pauvres sur mes biens. Accepte ma charité et multiplie-la.`
};

MIROIR["51:21"] = {
  reference: "51:21",
  theme: ["signes", "création", "foi"],
  emotion: "Émerveillement, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Et aussi en vous-mêmes. Ne voyez-vous donc pas ? » Le miroir se tourne vers l'intérieur. « Wa fi anfusikum » — et en vous-mêmes. Les signes d'Allah ne sont pas seulement dans la création extérieure — ils sont en nous. Notre corps, notre esprit, notre cœur sont des signes. Le miroir m'interroge : est-ce que je contemple les signes en moi-même ?`,
  reflection: `L'être humain est un univers en miniature. Chaque cellule est un signe du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi anfusikum afala tubsirun » — et en vous-mêmes, ne voyez-vous pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels signes d'Allah vois-je en moi-même ? Mon corps, mon esprit, mon cœur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le signe le plus proche est en moi. Je n'ai pas besoin de chercher loin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est dans l'homme. L'homme est un microcosme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se connaît lui-même connaît son Seigneur." }
  ],
  munajat: `Ya Khaliq, Tu as mis des signes en moi. Ouvre mes yeux sur ces signes. Fais que je me connaisse pour Te connaître.`
};

MIROIR["51:22"] = {
  reference: "51:22",
  theme: ["provision", "ciel", "confiance"],
  emotion: "Sérénité, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Munazzil"],
  mirrorVersion: `« Et dans le ciel, il y a votre provision et ce qui vous est promis. » Le miroir lève les yeux vers le ciel. « Fi as-sama'i rizqukum » — dans le ciel, votre provision. La provision vient d'Allah, du ciel. La pluie, la lumière, l'air — tout vient d'en haut. Le miroir m'interroge : est-ce que je fais confiance à Allah pour ma provision ?`,
  reflection: `La provision vient du ciel. Allah pourvoit à tous Ses serviteurs.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi as-sama'i rizqukum wa ma tu'adun » — et dans le ciel, votre provision et ce qui vous est promis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à Allah pour ma provision ? Ou est-ce que je m'inquiète ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision est assurée. L'inquiétude ne l'augmente pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le ciel donne sans compter. La terre reçoit avec gratitude." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à la provision du ciel ne s'inquiète jamais." }
  ],
  munajat: `Ya Razzaq, Tu es la Source de toute provision. Je fais confiance à Ta générosité. Ne permets pas que je m'inquiète pour mon subsistance.`
};

MIROIR["51:23"] = {
  reference: "51:23",
  theme: ["serment", "promesse", "résurrection"],
  emotion: "Certitude, espérance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Ba'ith"],
  mirrorVersion: `« Par le Seigneur des cieux et de la terre, c'est bien la vérité, comme vous parlez. » Le miroir scelle la promesse. « Fa-rabbi as-sama'i wa al-ard » — par le Seigneur des cieux et de la terre. « Innahu la-haqq » — c'est bien la vérité. La résurrection est vraie. Le miroir m'interroge : est-ce que je crois à la résurrection comme je crois à ma propre parole ?`,
  reflection: `La résurrection est aussi certaine que notre existence présente.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-rabbi as-sama'i wa al-ard innahu la-haqqun mithla ma antum tantiqun » — par le Seigneur des cieux et de la terre, c'est la vérité comme vous parlez." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois à la résurrection ? Est-ce que ma vie reflète cette croyance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La résurrection n'est pas une nouveauté — c'est un retour à l'origine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers meurt et renaît en cycles. La résurrection est inscrite dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à la résurrection vit chaque jour comme une préparation." }
  ],
  munajat: `Ya Ba'ith, Tu ressusciteras les morts. Je crois en Ta promesse. Prépare-moi pour ce jour. Fais que je sois parmi les ressuscités dans Ta miséricorde.`
};

MIROIR["51:24"] = {
  reference: "51:24",
  theme: ["histoire", "hôtes", "Ibrahim"],
  emotion: "Curiosité, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Dayyif"],
  mirrorVersion: `« Est-ce que tu as reçu le récit des hôtes honorés d'Ibrahim ? » Le miroir introduit une histoire. « Hal ataka hadith » — est-ce que tu as reçu le récit. « Dayf » — hôtes, invités. « Ibrahim » — Abraham. Les anges sont venus voir Ibrahim. Le miroir m'invite à écouter cette histoire avec attention.`,
  reflection: `Les histoires du Coran sont des leçons. Ibrahim a reçu des hôtes qui étaient des anges.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal ataka hadith dayfi Ibrahim al-mukramin » — as-tu reçu le récit des hôtes honorés d'Ibrahim ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis les histoires du Coran avec attention ? Qu'est-ce que j'apprends d'Ibrahim ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'hôte peut être un ange. L'étranger peut être une bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les anges parcourent la terre. Ils visitent qui Allah veut." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accueille l'étranger peut accueillir un ange sans le savoir." }
  ],
  munajat: `Ya Rabb, ouvre mon cœur aux histoires du Coran. Fais que j'apprenne des prophètes. Apprends-moi l'hospitalité d'Ibrahim.`
};

MIROIR["51:25"] = {
  reference: "51:25",
  theme: ["salutation", "paix", "hospitalité"],
  emotion: "Paix, bienveillance",
  difficulty: "débutant",
  relatedNames: ["As-Salam", "Al-Karim"],
  mirrorVersion: `« Quand ils entrèrent chez lui et dirent : "Paix !", il dit : "Paix ! Des gens inconnus." » Le miroir montre la salutation. « Salamun » — paix. Ibrahim répond par la même salutation. Il reconnaît qu'ils sont étrangers mais les accueille avec paix. Le miroir m'interroge : comment est-ce que j'accueille les étrangers ?`,
  reflection: `La salutation de paix est le premier geste d'hospitalité. Elle ouvre la porte à la bénédiction.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Id dakhulu 'alayhi fa qalu salaman qala salamun qawmun munkarun » — quand ils entrèrent et dirent 'Paix', il dit 'Paix, des gens inconnus'." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que j'accueille les étrangers ? Est-ce que je salue par la paix ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'étranger qui salue par la paix apporte une bénédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La paix est la langue universelle. Elle unit au-delà des différences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui offre la paix reçoit la paix." }
  ],
  munajat: `Ya Salam, fais que je sois un porteur de paix. Fais que ma salutation soit sincère. Ouvre mon cœur à l'hospitalité.`
};

MIROIR["51:26"] = {
  reference: "51:26",
  theme: ["hospitalité", "générosité", "service"],
  emotion: "Générosité, discrétion",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mut'im"],
  mirrorVersion: `« Il se glissa alors discrètement vers sa famille et apporta un veau gras. » Le miroir montre l'action discrète. « Ra'gha » — se glissa discrètement. « 'Ijl » — veau. « Samin » — gras, de bonne qualité. Ibrahim prépare un repas de qualité pour ses hôtes, sans ostentation. Le miroir m'interroge : est-ce que je donne avec discrétion et qualité ?`,
  reflection: `La vraie générosité est discrète. Elle donne le meilleur sans attirer l'attention.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa ragha ila ahlihi fa ja'a bi-'ijlin samim » — il se glissa vers sa famille et apporta un veau gras." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je donne le meilleur ? Est-ce que je donne avec discrétion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La discrétion n'est pas hésitation — c'est pureté d'intention." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature donne sans ostentation. L'arbre donne ses fruits en silence." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui donne discrètement reçoit la récompense d'Allah." }
  ],
  munajat: `Ya Karim, apprends-moi la générosité discrète. Fais que je donne le meilleur sans ostentation. Accepte mon service.`
};

MIROIR["51:27"] = {
  reference: "51:27",
  theme: ["offrande", "invitation", "respect"],
  emotion: "Hospitalité, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mut'im"],
  mirrorVersion: `« Il le plaça devant eux et dit : "Ne mangez-vous pas ?" » Le miroir montre l'invitation respectueuse. « Qarrabahu » — il le plaça devant eux. « Ala ta'kulun » — ne mangez-vous pas ? Ibrahim offre la nourriture et invite poliment. Le miroir m'interroge : est-ce que j'invite poliment à partager ?`,
  reflection: `L'invitation à manger est un acte d'amour. Elle crée le lien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa qarrabahu ilayhim qala ala ta'kulun » — il le plaça devant eux et dit : ne mangez-vous pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'invite les autres à partager ? Est-ce que je suis généreux avec ma nourriture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Offrir à manger est offrir sa vie. C'est un acte de confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature partage la nourriture avec ses petits. C'est la loi du care." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui nourrit les autres nourrit son âme." }
  ],
  munajat: `Ya Mut'im, Tu nourris toutes les créatures. Apprends-moi à partager ma nourriture. Fais que ma table soit ouverte.`
};

MIROIR["51:28"] = {
  reference: "51:28",
  theme: ["crainte", "protection", "réconfort"],
  emotion: "Peur, puis soulagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hafiz", "Al-Mu'min"],
  mirrorVersion: `« Il ressentit une crainte d'eux. Ils dirent : "N'aie pas peur." » Le miroir montre la transition de la peur à la paix. « Awja'sa » — il ressentit une crainte. « La takhaf » — n'aie pas peur. Ibrahim avait peur parce qu'ils ne mangeaient pas. Les anges le rassurent. Le miroir m'interroge : qu'est-ce qui me fait peur ? Est-ce que j'entends la voix qui dit 'n'aie pas peur' ?`,
  reflection: `La peur peut être dissipée par la bonne parole. Les anges viennent pour rassurer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa awjasa minhum khifatan qalu la takhaf » — il ressentit une crainte d'eux. Ils dirent : n'aie pas peur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui me fait peur ? Est-ce que j'entends la voix qui dit 'n'aie pas peur' ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La peur est souvent fondée sur l'inconnu. La connaissance dissipe la peur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait pour la sécurité. La peur est une protection, mais elle peut être dépassée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah n'a pas peur de l'inconnu." }
  ],
  munajat: `Ya Hafiz, Tu es ma protection. Quand j'ai peur, rappelle-moi que Tu es là. Dissipe mes craintes par Ta présence.`
};

MIROIR["51:29"] = {
  reference: "51:29",
  theme: ["bonne nouvelle", "étonnement", "stérilité"],
  emotion: "Surprise, joie",
  difficulty: "débutant",
  relatedNames: ["Al-Wahab", "Al-Muhyi"],
  mirrorVersion: `« Sa femme s'avança en criant, se frappant le visage, et dit : "Une vieille femme stérile !" » Le miroir montre la réaction humaine. « Fa aqbalati imra'atuhu » — sa femme s'avança. « Fi sarrah » — en criant. Le miroir m'interroge : quand j'ai une bonne nouvelle, quelle est ma réaction ?`,
  reflection: `La bonne nouvelle peut sembler impossible. Mais Allah peut tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa aqbalati imra'atuhu fi sarrah fa wakhat wajhaha wa qalam ya waylata a'alqun wa ana 'ajuz » — sa femme s'avança en criant, se frappant le visage : une vieille femme stérile !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'ai une bonne nouvelle, comment réagis-je ? Avec foi ou avec incrédulité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossible devient possible par la volonté d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vie surgit là où on ne l'attend pas. Le désert fleurit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit à l'impossible le voit se réaliser." }
  ],
  munajat: `Ya Wahab, Tu donnes sans compter. Quand je doute, rappelle-moi que Tu peux tout. Fais que ma stérilité devienne fertilité.`
};

MIROIR["51:30"] = {
  reference: "51:30",
  theme: ["promesse", "vérité", "power"],
  emotion: "Assurance, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sadiq", "Al-Qadir"],
  mirrorVersion: `« Ils dirent : "Ainsi dit ton Seigneur. C'est Lui le Sage, l'Omniscient." » Le miroir affirme la source. « Qala rabbuki » — ainsi dit ton Seigneur. « Al-Hakim » — le Sage. « Al-'Alim » — l'Omniscient. La promesse vient d'Allah, le Sage, l'Omniscient. Le miroir m'interroge : est-ce que je fais confiance à la sagesse d'Allah ?`,
  reflection: `La sagesse d'Allah dépasse notre compréhension. Sa promesse est vraie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu kadhaliki qala rabbuki innahu huwa al-hakimu al-'alim » — ils dirent : ainsi dit ton Seigneur. C'est Lui le Sage, l'Omniscient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais confiance à la sagesse d'Allah même quand je ne comprends pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui semble impossible est facile pour Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à la sagesse d'Allah. Chaque loi est un signe de Sa sagesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la sagesse d'Allah sans comprendre goûte à la paix." }
  ],
  munajat: `Ya Hakim, Ta sagesse est parfaite. J'accepte Ta décision même quand je ne comprends pas. Fais que je Te fasse confiance complètement.`
};

MIROIR["51:31"] = {
  reference: "51:31",
  theme: ["question", "curiosité", "mission"],
  emotion: "Curiosité, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Mursal", "Al-Wahy"],
  mirrorVersion: `« Il dit : "Quelle est donc votre mission, ô envoyés ?" » Le miroir montre la question directe. « Ma gharadukum » — quelle est votre mission. « Ayyuha al-mursalun » — ô envoyés. Ibrahim veut savoir pourquoi ils sont venus. Le miroir m'interroge : est-ce que je demande le but des événements de ma vie ?`,
  reflection: `Chaque événement a un but. Demander, c'est chercher à comprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala ma gharadukum ayyuha al-mursalun » — il dit : quelle est donc votre mission, ô envoyés ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande le but des événements de ma vie ? Est-ce que je cherche à comprendre ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La question n'est pas un doute — c'est une recherche." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque événement dans l'univers a un but. Rien n'est sans raison." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande le but reçoit la compréhension." }
  ],
  munajat: `Ya Rabb, révèle-moi le but de mes épreuves. Aide-moi à comprendre Ta volonté. Ne permets pas que je reste dans l'ignorance.`
};

MIROIR["51:32"] = {
  reference: "51:32",
  theme: ["mission", "punition", "justice"],
  emotion: "Sérieux, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muntaqim", "Al-'Adl"],
  mirrorVersion: `« Ils dirent : "Nous avons été envoyés vers un peuple criminel." » Le miroir révèle la mission. « Innahum qawm » — nous avons été envoyés vers un peuple. « Mujrimin » — criminel, pécheur. Les anges viennent pour punir le peuple de Lot. Le miroir m'interroge : quel est mon rapport avec le péché ?`,
  reflection: `La punition d'Allah atteint les criminels. Le croyant se préserve du péché.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qalu inna ursilna ila qawm mujrimin » — ils dirent : nous avons été envoyés vers un peuple criminel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon rapport avec le péché ? Est-ce que je me préserve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La punition n'est pas immédiate — elle laisse le temps du repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers punit le déséquilibre. La justice est inscrite dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent avant la punition est sauvé." }
  ],
  munajat: `Ya Rabb, préserve-moi du péché. Quand je pèche, donne-moi le repentir avant que Ta punition n'arrive. Sauve-moi de moi-même.`
};

MIROIR["51:33"] = {
  reference: "51:33",
  theme: ["punition", "pierres", "châtiment"],
  emotion: "Crainte, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qahir", "Al-Jabbar"],
  mirrorVersion: `« Pour lancer sur eux des pierres d'argile. » Le miroir décrit le châtiment. « Li-nursila » — pour lancer. « 'Alayhim hijarah » — sur eux des pierres. « Min tin » — d'argile. Les anges lancent des pierres sur le peuple criminel. Le miroir m'interroge : est-ce que je crains le châtiment d'Allah ?`,
  reflection: `Le châtiment d'Allah est réel. Il atteint ceux qui persistent dans le mal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Li-nursila 'alayhim hijaratan min tin » — pour lancer sur eux des pierres d'argile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains le châtiment d'Allah ? Est-ce que je m'en préserve ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment est évitable par le repentir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut devenir instrument de châtiment. Les éléments obéissent à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint le châtiment se préserve du mal." }
  ],
  munajat: `Ya Qahir, Ton châtiment est redoutable. Préserve-moi de ce qui T'offense. Fais que je Te craigne avant de Te rencontrer.`
};

MIROIR["51:34"] = {
  reference: "51:34",
  theme: ["décret", "châtiment", "transgresseurs"],
  emotion: "Crainte, gravité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qadi", "Al-Muhit"],
  mirrorVersion: `« Marquées auprès de ton Seigneur pour les transgresseurs. » Le miroir montre la précision du décret. « Musawwamah » — marquées, inscrites. « 'Inda rabbik » — auprès de ton Seigneur. « Lil-musrifin » — pour les transgresseurs. Le châtiment est préparé et marqué pour les transgresseurs. Le miroir m'interroge : suis-je un transgresseur ?`,
  reflection: `Le châtiment est préparé pour les transgresseurs. La précision d'Allah est absolue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Musawwamatan 'inda rabbika lil-musrifin » — marquées auprès de ton Seigneur pour les transgresseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je un transgresseur ? Est-ce que je dépasse les limites d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transgression a des limites. Le châtiment suit la transgression." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des limites. Les transgresser a des conséquences." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste dans les limites d'Allah est protégé." }
  ],
  munajat: `Ya Rabb, garde-moi dans Tes limites. Ne permets pas que je sois un transgresseur. Protège-moi du châtiment marqué.`
};

MIROIR["51:35"] = {
  reference: "51:35",
  theme: ["sauvetage", "croyants", "séparation"],
  emotion: "Soulagement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Munji", "An-Najat"],
  mirrorVersion: `« Et Nous en fîmes sortir ceux qui croyaient. » Le miroir montre le sauvetage. « Fa-akhrajna » — et Nous fîmes sortir. « Man kana fiha » — ceux qui étaient dedans. « Min al-mu'minin » — des croyants. Les croyants sont sauvés du châtiment. Le miroir m'interroge : suis-je parmi les croyants qui seront sauvés ?`,
  reflection: `Les croyants sont épargnés du châtiment. La foi est la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhrajna man kana fiha min al-mu'minin » — et Nous en fîmes sortir ceux qui croyaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les croyants ? Est-ce que ma foi me protégera du châtiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment épargne les croyants. La foi est la frontière." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers protège ceux qui sont en harmonie avec lui." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment est déjà sauvé." }
  ],
  munajat: `Ya Munji, sauve-moi du châtiment. Fais que ma foi soit sincère. Compte-moi parmi les croyants qui seront épargnés.`
};

MIROIR["51:36"] = {
  reference: "51:36",
  theme: ["minorité", "foi", "société"],
  emotion: "Solitude, persévérance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Mais Nous n'y trouvâmes qu'une seule maison de soumis. » Le miroir montre la minorité des croyants. « Illa baytan » — sauf une maison. « Wahidan » — seule, unique. « Muslimin » — de soumis. Il n'y avait qu'une seule maison de croyants. Le miroir m'interroge : suis-je prêt à être seul dans ma foi ?`,
  reflection: `Les croyants peuvent être minoritaires. La vérité n'est pas dans le nombre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Famaa wajadna fiha ghara baytin min al-muslimin » — mais Nous n'y trouvâmes qu'une seule maison de soumis." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je prêt à être seul dans ma foi ? Est-ce que je suis la majorité ou la vérité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La minorité peut avoir la vérité. Le nombre n'est pas la preuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est une. L'erreur est multiple." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est seul avec Allah n'est jamais vraiment seul." }
  ],
  munajat: `Ya Rabb, donne-moi la force d'être seul si nécessaire. Fais que je suive la vérité, pas la foule. Compte-moi parmi les soumis.`
};

MIROIR["51:37"] = {
  reference: "51:37",
  theme: ["signe", "avertissement", "mémoire"],
  emotion: "Sérieux, souvenir",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-'Abir"],
  mirrorVersion: `« Et Nous y laissâmes un signe pour ceux qui craignent le douloureux châtiment. » Le miroir montre le signe laissé. « Tarakna fiha » — Nous y laissâmes. « Ayatan » — un signe. « Li-alladhina yakhafun » — pour ceux qui craignent. Les ruines sont un signe pour les croyants. Le miroir m'interroge : est-ce que je vois les ruines comme des signes ?`,
  reflection: `Les ruines des peuples passés sont des signes pour les vivants.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa tarakna fiha ayatan li-alladhina yakhafuna al-'adhaba al-alim » — et Nous y laissâmes un signe pour ceux qui craignent le douloureux châtiment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois les ruines de l'histoire comme des signes ? Est-ce que j'en tire des leçons ?" },
    { label: "L'Inversion", ar: "القلb", color: "var(--purple)", text: "Le signe est pour celui qui craint. La crainte ouvre les yeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers garde la mémoire des civilisations disparues." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui tire des leçons de l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, fais que je voie les signes de l'histoire. Fais que j'apprenne des peuples passés. Préserve-moi de leur sort.`
};

MIROIR["51:38"] = {
  reference: "51:38",
  theme: ["Moussa", "Pharaon", "mission"],
  emotion: "Courage, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mursal", "Al-'Aziz"],
  mirrorVersion: `« Et en Moïse, quand Nous l'envoyâmes à Pharaon avec une autorité évidente. » Le miroir montre la mission de Moïse. « Wa fi Musa » — et en Moïse. « Id arsalnahu » — quand Nous l'envoyâmes. « Ila Fir'awn » — à Pharaon. « Bi-sultanin mubin » — avec une autorité évidente. Moïse affronte le tyran avec la puissance d'Allah. Le miroir m'interroge : est-ce que j'ai le courage de dire la vérité aux puissants ?`,
  reflection: `Moïse a affronté le plus grand tyran de son temps avec la confiance en Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi Musa id arsalnahu ila Fir'awn bi-sultanin mubin » — et en Moïse, quand Nous l'envoyâmes à Pharaon avec une autorité évidente." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai le courage de dire la vérité ? À qui dois-je parler ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie force n'est pas dans le pouvoir — elle est dans la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité finit toujours par triompher du mensonge." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit la vérité avec autorité divine ne craint personne." }
  ],
  munajat: `Ya Rabb, donne-moi le courage de Moïse. Fais que je dise la vérité même aux puissants. Accorde-moi une autorité évidente.`
};

MIROIR["51:39"] = {
  reference: "51:39",
  theme: ["orgueil", "rejet", "magie"],
  emotion: "Tristesse, persévérance",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-Mubin"],
  mirrorVersion: `« Mais il se détoura avec son armée et dit : "C'est un magicien ou un fou !" » Le miroir montre le rejet orgueilleux. « Tawalla » — il se détourna. « Bi-junudihi » — avec son armée. « Sahir aw majnun » — magicien ou fou. Pharaon rejette la vérité par orgueil. Le miroir m'interroge : est-ce que je rejette la vérité quand elle me déplaît ?`,
  reflection: `L'orgueil empêche de voir la vérité. Pharaon préfère accuser que d'accepter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa tawalla bi-rushnihi fa qala sahir aw majnun » — mais il se détourna avec ses armées et dit : un magicien ou un fou !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je rejette la vérité quand elle me déplaît ? Comment réagis-je à la correction ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accuser l'autre est plus facile que de se remettre en question." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers ne ment pas. Rejeter la vérité ne la fait pas disparaître." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui rejette la vérité par orgueil finit par être rejeté." }
  ],
  munajat: `Ya Haqq, préserve-moi de l'orgueil qui rejette la vérité. Quand Tu me corriges, aide-moi à accepter avec humilité.`
};

MIROIR["51:40"] = {
  reference: "51:40",
  theme: ["punition", "mer", "exemple"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Muntaqim", "Al-Qahir"],
  mirrorVersion: `« Alors Nous le saisîmes ainsi que ses armées, et les jetâmes dans les flots. Regarde ce qu'est devenu le sort des injustes. » Le miroir montre la punition finale. « Fa-akhadhnahu » — Nous le saisîmes. « Wa junudahu » — et ses armées. « Fa-nabadhnahum » — et les jetâmes. « Fi al-yamm » — dans la mer. Pharaon est noyé. Le miroir m'interroge : quel sera mon sort ?`,
  reflection: `La punition de Pharaon est un exemple pour tous les tyrans. Personne n'échappe à la justice d'Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhadhnahu wa junudahu fa-nabadhnahum fi al-yamm fa-unzur kayfa kana 'aqibat al-zalimin » — Nous le saisîmes avec ses armées et les jetâmes dans les flots. Vois le sort des injustes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel sera mon sort ? Est-ce que je suis parmi les justes ou les injustes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La mer qui noya Pharaon est la même qui s'ouvrit pour Moïse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La mer obéit à Allah. Elle peut être salut ou châtiment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui refuse de se soumettre à Allah finit par être soumis de force." }
  ],
  munajat: `Ya Qahir, Ton châtiment atteint les injustes. Préserve-moi de l'injustice. Fais que mon sort soit avec les croyants, pas avec Pharaon.`
};

MIROIR["51:41"] = {
  reference: "51:41",
  theme: ["'Ad", "vent", "punition"],
  emotion: "Crainte, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Ar-Rih"],
  mirrorVersion: `« Et en 'Ad, quand Nous envoyâmes contre eux le vent stérile. » Le miroir montre le châtiment par le vent. « Wa fi 'Ad » — et en 'Ad. « Id arsalna » — quand Nous envoyâmes. « 'Alayhimu ar-rih » — contre eux le vent. « Al-'aqim » — stérile, destructeur. Le vent qui est normalement bénéfique devient destructeur pour les injustes. Le miroir m'interroge : quel est mon rapport avec les signes de la nature ?`,
  reflection: `La même création peut être bénédiction ou châtiment selon notre attitude envers le Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi 'Ad id arsalna 'alayhimu ar-riha al-'aqim » — et en 'Ad, quand Nous envoyâmes contre eux le vent stérile." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La nature m'entoure. Est-ce qu'elle est bénédiction ou menace pour moi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le vent qui porte les nuages peut aussi détruire. Tout dépend de la volonté d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le vent est une force de la nature. Il peut construire ou détruire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est en harmonie avec Allah est protégé même du vent destructeur." }
  ],
  munajat: `Ya Rabb, protège-moi des forces destructrices. Fais que la nature soit pour moi une bénédiction, pas une menace.`
};

MIROIR["51:42"] = {
  reference: "51:42",
  theme: ["destruction", "vent", "résidu"],
  emotion: "Crainte, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Mumit", "Al-Qahir"],
  mirrorVersion: `« Qui ne laissait rien sur quoi elle passait sans le réduire en poussière. » Le miroir décrit la destruction totale. « La tada'u » — ne laissait pas. « Shay'an » — chose. « Atat 'alayhi » — sur quoi elle passait. « Illa ja'alathu » — sans l'avoir fait. « Ka-al-ramim » — comme poussière. Le vent destructeur ne laisse rien. Le miroir m'interroge : qu'est-ce qui reste de moi face à la puissance d'Allah ?`,
  reflection: `La puissance d'Allah est absolue. Rien ne résiste à Sa volonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma tada'u shay'an atat 'alayhi illa ja'alathu ka-al-ramim » — elle ne laissait rien sur quoi elle passait sans le réduire en poussière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce qui reste de moi face à la puissance d'Allah ? Suis-je prêt à Le rencontrer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La destruction totale est aussi une purification. Rien ne reste du faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers peut tout effacer. La puissance de la nature n'est qu'un reflet de la puissance d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'est soumis à Allah est déjà en poussière devant Lui — et c'est là sa force." }
  ],
  munajat: `Ya Qahir, Ta puissance est absolue. Je m'incline devant Toi. Réduis mon ego en poussière pour que seul Tu restes.`
};

MIROIR["51:43"] = {
  reference: "51:43",
  theme: ["Thamud", "avertissement", "orgueil"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["An-Nadhir", "Al-Bashir"],
  mirrorVersion: `« Et en Thamud, quand il leur fut dit : "Profitez de vos biens un certain temps." » Le miroir montre le délai accordé. « Wa fi Thamud » — et en Thamud. « Id qila lahum » — quand il leur fut dit. « Tamatta'u » — profitez. « Hatta hin » — jusqu'à un certain temps. Le délai n'est pas l'oubli. C'est une dernière chance. Le miroir m'interroge : comment profite-je du temps qui m'est accordé ?`,
  reflection: `Le temps accordé n'est pas une éternité. C'est une opportunité pour le repentir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa fi Thamud id qila lahum tamatta'u hatta hin » — et en Thamud, quand il leur fut dit : profitez jusqu'à un certain temps." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment profite-je du temps accordé ? En jouissant ou en me repentant ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le délai peut être une miséricorde ou un piège selon ce qu'on en fait." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers a des cycles. Chaque temps a sa fin. Le temps accordé à l'homme aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui profite du délai pour se repentir le transforme en éternité." }
  ],
  munajat: `Ya Rabb, le temps m'est accordé. Fais que je ne le gaspille pas. Donne-moi le repentir avant que le délai ne s'achève.`
};

MIROIR["51:44"] = {
  reference: "51:44",
  theme: ["désobéissance", "punition", "foudre"],
  emotion: "Crainte, effroi",
  difficulty: "débutant",
  relatedNames: ["As-Sa'iqa", "Al-Qahir"],
  mirrorVersion: `« Mais ils se rebellèrent contre l'ordre de leur Seigneur. Le châtiment les saisit au moment où ils regardaient. » Le miroir montre la punition soudaine. « 'Ataw » — ils se rebellèrent. « 'An amri rabbihim » — contre l'ordre de leur Seigneur. « Fa-akhadhatuhum as-sa'iqatu » — le châtiment les saisit. « Wa hum yanzurun » — pendant qu'ils regardaient. Le miroir m'interroge : est-ce que j'obéis à l'ordre d'Allah ?`,
  reflection: `La désobéissance attire le châtiment. Il peut venir à tout moment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-'ataw 'an amri rabbihim fa-akhadhatuhum as-sa'iqatu wa hum yanzurun » — ils se rebellèrent contre l'ordre de leur Seigneur. Le châtiment les saisit pendant qu'ils regardaient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'obéis à l'ordre d'Allah ? Quel ordre est-ce que je néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le châtiment visible pendant qu'on regarde est pire que le châtiment invisible." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La foudre frappe soudainement. L'univers peut punir à tout moment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui obéit à Allah n'a pas à craindre le châtiment soudain." }
  ],
  munajat: `Ya Rabb, je veux obéir à Ton ordre. Préserve-moi de la rébellion. Ne permets pas que je sois saisi par Ton châtiment.`
};

MIROIR["51:45"] = {
  reference: "51:45",
  theme: ["impuissance", "fuite", "châtiment"],
  emotion: "Désespoir, crainte",
  difficulty: "débutant",
  relatedNames: ["Al-Qahir", "Al-Mumit"],
  mirrorVersion: `« Ils ne purent ni se mettre debout ni être secourus. » Le miroir montre l'impuissance totale. « Fa-ma istata'u » — ils ne purent pas. « Min qiyam » — se mettre debout. « Wa ma hum muntasirun » — ni être secourus. Face au châtiment d'Allah, nul secours n'est possible. Le miroir m'interroge : sur qui est-ce que je compte pour m'aider ?`,
  reflection: `Face à Allah, nous sommes impuissants. Seule Sa miséricorde peut nous sauver.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-ma istata'u min qiyam wa ma hum muntasirun » — ils ne purent ni se mettre debout ni être secourus." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur qui est-ce que je compte ? Qui peut m'aider face à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impuissance face au châtiment est le fruit de l'orgueil face à l'ordre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Nulle créature ne peut résister au décret divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'est soumis volontairement sera élevé; celui qui refuse sera abaissé." }
  ],
  munajat: `Ya Rabb, je suis impuissant devant Toi. Je ne peux me sauver moi-même. Je cherche refuge dans Ta miséricorde seule.`
};

MIROIR["51:46"] = {
  reference: "51:46",
  theme: ["Nuh", "peuple", "histoire"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Nuh", "Al-Munji"],
  mirrorVersion: `« Et le peuple de Noé auparavant. Ils étaient des gens pervers. » Le miroir continue la série des punitions. « Wa qawma Nuhin » — et le peuple de Noé. « Min qabl » — auparavant. « Innahum kanu » — ils étaient. « Qawman fasigin » — des gens pervers. L'histoire se répète. Les peuples pervers sont punis. Le miroir m'interroge : quelle leçon est-ce que je tire de l'histoire ?`,
  reflection: `L'histoire est un enseignement. Les peuples passés sont des exemples.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa qawma Nuhin min qabl innahum kanu qawman fasigin » — et le peuple de Noé auparavant. Ils étaient des gens pervers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle leçon est-ce que je tire de l'histoire ? Est-ce que je m'en instruis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perversité d'autrefois ressemble à la perversité d'aujourd'hui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire de l'humanité est remplie de leçons. Les cycles se répètent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît l'histoire ne répète pas les erreurs." }
  ],
  munajat: `Ya Rabb, enseigne-moi par l'histoire. Fais que je ne sois pas parmi les pervers. Sauve-moi comme Tu as sauvé Noé.`
};

MIROIR["51:47"] = {
  reference: "51:47",
  theme: ["ciel", "construction", "expansion"],
  emotion: "Émerveillement, humilité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Le ciel, Nous l'avons construit avec puissance. Et Nous l'étendons constamment. » Le miroir contemple la création du ciel. « As-sama' » — le ciel. « Bina'aha » — sa construction. « Bi-aydin » — avec puissance. « Wa inna » — et Nous. « Lamusi'un » — l'étendons constamment. L'expansion de l'univers est inscrite dans le Coran. Le miroir m'interroge : est-ce que je contemple la grandeur de la création ?`,
  reflection: `L'univers est en expansion. Cette vérité scientifique est inscrite dans le Coran depuis 1400 ans.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa as-sama' bina'aha bi-aydin wa inna lamusri'un » — le ciel, Nous l'avons construit avec puissance. Et Nous l'étendons constamment." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple la grandeur de la création ? Est-ce que je vois le signe dans la science ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'expansion de l'univers reflète l'expansion de la connaissance humaine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est en mouvement constant. L'expansion est une de ses lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple l'expansion du ciel contemple la puissance infinie d'Allah." }
  ],
  munajat: `Ya Khaliq, Tu as créé le ciel avec puissance. Ouvre mon esprit à la grandeur de Ta création. Fais que chaque découverte scientifique renforce ma foi.`
};

MIROIR["51:48"] = {
  reference: "51:48",
  theme: ["terre", "tapis", "réflexion"],
  emotion: "Gratitude, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musahhil"],
  mirrorVersion: `« Et la terre, Nous l'avons étendue. Comme de vastes tapis ! » Le miroir contemple la terre. « Wa al-ard » — et la terre. « Farashnaha » — Nous l'avons étendue. « Fa-ni'ma » — comme de vastes tapis. « Al-mahidun » — ceux qui font des tapis. La terre est comme un tapis étendu pour nous. Le miroir m'interroge : est-ce que je suis reconnaissant pour la terre sur laquelle je vis ?`,
  reflection: `La terre est aménagée pour nous. Elle est un tapis de vie et de provision.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa al-ard farashnaha fa-ni'ma al-mahidun » — et la terre, Nous l'avons étendue. Comme de vastes tapis !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis reconnaissant pour la terre ? Comment est-ce que je la traite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le tapis peut être enroulé. La terre peut être transformée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre est notre tapis, notre maison, notre provision." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui marche sur la terre en reconnaissant le don marche avec gratitude." }
  ],
  munajat: `Ya Rabb, merci pour la terre. Fais que je la respecte. Fais que je marche sur ce tapis avec reconnaissance et non avec ingratitude.`
};

MIROIR["51:49"] = {
  reference: "51:49",
  theme: ["dualité", "création", "réflexion"],
  emotion: "Émerveillement, méditation",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "Al-Muthanna"],
  mirrorVersion: `« Et de toute chose Nous avons créé deux éléments de couple. Peut-être vous rappellerez-vous. » Le miroir contemple la dualité. « Min kulli shay'in » — de toute chose. « Khalaqna zawjayn » — Nous avons créé deux éléments de couple. « La'allakum tadhakkarun » — peut-être vous rappellerez-vous. La dualité est partout : masculin/féminin, jour/nuit, positif/négatif. Le miroir m'interroge : est-ce que je vois la dualité dans la création ?`,
  reflection: `La dualité est le principe de la création. L'unité est le principe du Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa min kulli shay'in khalaqna zawjayn la'allakum tadhakkarun » — et de toute chose Nous avons créé deux éléments de couple. Peut-être vous rappellerez-vous." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vois la dualité dans la création ? Jour et nuit, homme et femme ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La dualité de la création pointe vers l'unicité du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait de paires. L'électron et le positron, le jour et la nuit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple les paires découvre l'Unique." }
  ],
  munajat: `Ya Ahad, Tu es Un au-delà de toute dualité. Fais que la création me ramène à Ton unicité. Fais que je me rappelle.`
};

MIROIR["51:50"] = {
  reference: "51:50",
  theme: ["fuite", "Allah", "retour"],
  emotion: "Urgence, détermination",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'ab", "Al-Farra"],
  mirrorVersion: `« Fuyez donc vers Allah. Je suis pour vous, de Sa part, un avertisseur explicite. » Le miroir appelle à la fuite vers Allah. « Fa-firru » — fuyez donc. « Ila Allah » — vers Allah. « Inni » — je suis. « Lakhirun » — un avertisseur. « Mubin » — explicite. La seule fuite valable est vers Allah. Tout autre fuite est égarement. Le miroir m'interroge : où est-ce que je fuis ?`,
  reflection: `Fuir vers Allah est le seul mouvement qui rapproche. Toute autre fuite éloigne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-firru ila Allah inni lakhirun mubin » — fuyez donc vers Allah. Je suis pour vous, de Sa part, un avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je fuis ? Vers Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fuite vers Allah est un mouvement paradoxal — on fuit vers ce qu'on craint pour y trouver la paix." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature retourne à sa source. L'homme peut le faire consciemment." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fuit vers Allah trouve en Lui son refuge éternel." }
  ],
  munajat: `Ya Allah, je fuis vers Toi. Tu es mon refuge, mon retour, ma destination. Accueille ma fuite et transforme-la en approche.`
};

MIROIR["51:51"] = {
  reference: "51:51",
  theme: ["unicité", "divinités", "exclusivité"],
  emotion: "Détermination, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Ahad", "Al-Wahid"],
  mirrorVersion: `« Ne placez pas une autre divinité avec Allah. Je suis pour vous, de Sa part, un avertisseur explicite. » Le miroir appelle à l'exclusivité. « La taj'alun » — ne placez pas. « Ma'a Allah » — avec Allah. « Ilahan akhar » — une autre divinité. L'unicité d'Allah demande l'exclusivité totale. Le miroir m'interroge : quelle 'divinité' est-ce que je place à côté d'Allah ?`,
  reflection: `L'unicité n'accepte pas de partage. L'amour d'Allah est exclusif.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taj'alun ma'a Allah ilahan akhar inni lakhirun mubin » — ne placez pas une autre divinité avec Allah. Je suis un avertisseur explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle 'divinité' est-ce que je place à côté d'Allah ? L'argent ? L'image ? Le pouvoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Placer une divinité avec Allah, c'est ne reconnaître ni l'un ni l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers obéit à un seul Créateur. Il n'y a pas de division dans Sa création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unifie son cœur pour Allah reçoit l'unicité en don." }
  ],
  munajat: `Ya Ahad, Tu es le Seul. Je retire toute autre divinité de mon cœur. Sois le seul Maître de mon cœur.`
};

MIROIR["51:52"] = {
  reference: "51:52",
  theme: ["prophètes", "rejet", "histoire"],
  emotion: "Tristesse, persévérance",
  difficulty: "débutant",
  relatedNames: ["An-Nabiyyun", "Ar-Rasul"],
  mirrorVersion: `« Ainsi, aucun messager n'est venu à ceux qui les ont précédés sans qu'ils aient dit : "C'est un magicien ou un fou !" » Le miroir montre la constante du rejet. « Kadhalika » — ainsi. « Ma atah » — n'est venu. « Min rasulin » — de messager. « Illa qalu » — sans qu'ils aient dit. « Sahir aw majnun » — magicien ou fou. L'histoire du rejet des prophètes est constante. Le miroir m'interroge : comment est-ce que je réagis à la vérité ?`,
  reflection: `Les prophètes ont toujours été rejetés. La vérité dérange les confortables.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kadhalika ma atah min rasulin min qablikum illa qalu sahir aw majnun » — ainsi, aucun messager n'est venu à leurs prédécesseurs sans qu'ils aient dit : magicien ou fou !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je réagis à la vérité ? Est-ce que je rejette ce qui me dérange ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Accuser le messager évite d'écouter le message." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité est toujours dérangeante pour le mensonge établi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le messager reconnaît le message." }
  ],
  munajat: `Ya Rabb, je veux reconnaître Tes messagers. Ne permets pas que je rejette la vérité sous prétexte qu'elle me dérange. Ouvre mon cœur au message.`
};

MIROIR["51:53"] = {
  reference: "51:53",
  theme: ["héritage", "rejet", "tentation"],
  emotion: "Sérieux, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["An-Nas", "Al-Wasi'a"],
  mirrorVersion: `« Se sont-ils transmis cela comme un héritage ? Ce sont des gens transgresseurs. » Le miroir montre l'héritage du rejet. « A-tawasaw » — se sont-ils transmis. « Bihi » — cela. « Bal » — plutôt. « Qawmun taghun » — des gens transgresseurs. Le rejet des prophètes se transmet de génération en génération. Le miroir m'interroge : quel héritage est-ce que je transmets ?`,
  reflection: `Le rejet de la vérité peut devenir un héritage culturel. Il faut briser la chaîne.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« A-tawasaw bihi bal hum qawmun taghun » — se sont-ils transmis cela ? Ce sont des gens transgresseurs." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel héritage est-ce que je reçois ? Quel héritage est-ce que je transmets ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'héritage du rejet peut être brisé par l'acceptation individuelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les chaînes du passé peuvent être brisées par la conscience du présent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui brise la chaîne du rejet ouvre une nouvelle lignée de foi." }
  ],
  munajat: `Ya Rabb, je veux briser la chaîne du rejet. Je veux transmettre la foi, pas le doute. Fais de moi un point de rupture vers la vérité.`
};

MIROIR["51:54"] = {
  reference: "51:54",
  theme: ["détachement", "relation", "responsabilité"],
  emotion: "Sérénité, lâcher-prise",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wali", "Al-Mawla"],
  mirrorVersion: `« Détourne-toi d'eux, tu n'en seras pas blâmé. » Le miroir montre le détachement. « Fa-tawalla » — détourne-toi. « 'Anhum » — d'eux. « Fa-ma anta » — tu n'es pas. « Bi-malum » — blâmé. Le Prophète n'est pas responsable de ceux qui refusent. Il doit se détacher. Le miroir m'interroge : est-ce que je me sens responsable de ce qui ne dépend pas de moi ?`,
  reflection: `Nous ne sommes responsables que de nous-mêmes. Le détachement est parfois nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-tawalla 'anhum fa-ma anta bi-malum » — détourne-toi d'eux, tu n'en seras pas blâmé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me sens responsable de ce qui ne dépend pas de moi ? Qu'est-ce que je dois lâcher ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le détachement n'est pas l'abandon — c'est la reconnaissance des limites." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers continue son cours. Il ne se préoccupe pas de ceux qui refusent de suivre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lâche ce qui ne lui appartient pas trouve la légèreté." }
  ],
  munajat: `Ya Rabb, apprends-moi le détachement juste. Ce que je ne peux pas changer, aide-moi à l'accepter. Ce que je peux, aide-moi à le faire.`
};

MIROIR["51:55"] = {
  reference: "51:55",
  theme: ["rappel", "avertissement", "opportunité"],
  emotion: "Espoir, persévérance",
  difficulty: "débutant",
  relatedNames: ["Adh-Dhikra", "An-Nadhir"],
  mirrorVersion: `« Et rappelle, car le rappel profite aux croyants. » Le miroir montre l'utilité du rappel. « Wa dhakkir » — et rappelle. « Fa-inna al-dhikra » — car le rappel. « Tanfa'u al-mu'minin » — profite aux croyants. Le rappel n'est pas pour tous — il profite à ceux qui croient. Le miroir m'interroge : est-ce que le rappel me profite ?`,
  reflection: `Le rappel est une miséricorde pour les croyants. Il réveille ceux qui dorment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dhakkir fa-inna al-dhikra tanfa'u al-mu'minin » — et rappelle, car le rappel profite aux croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que le rappel me profite ? Ou est-ce que je l'entends sans le recevoir ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le même rappel peut profiter ou non selon l'état du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rappelle constamment son Créateur. Les signes sont partout." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le rappel avec un cœur ouvert est déjà en chemin." }
  ],
  munajat: `Ya Rabb, envoie-moi des rappels. Fais que mon cœur soit ouvert à les recevoir. Chaque rappel est une miséricorde pour moi.`
};

MIROIR["51:57"] = {
  reference: "51:57",
  theme: ["provision", "indépendance", "richesse"],
  emotion: "Humilité, confiance",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Ghani"],
  mirrorVersion: `« Je ne leur demande point de provision, et Je ne leur demande point qu'ils Me nourrissent. » Le miroir montre l'indépendance d'Allah. « Ma a-staaghfiruhum » — Je ne leur demande point. « Min rizq » — de provision. « Wa ma uridu » — et Je ne veux pas. « An yut'imun » — qu'ils Me nourrissent. Allah n'a besoin de rien. Nous avons besoin de Lui. Le miroir m'interroge : de qui est-ce que je dépends vraiment ?`,
  reflection: `Allah est le Riche, nous sommes les pauvres. Il n'a besoin de rien, nous avons besoin de tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ma astaghfiruhum min rizq wa ma uridu an yut'imun » — Je ne leur demande point de provision, et Je ne veux pas qu'ils Me nourrissent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De qui est-ce que je dépends ? Est-ce que je reconnais que tout vient d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le riche est celui qui n'a besoin de personne. Allah est le seul Vraiment Riche." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers reçoit tout d'Allah. Il ne peut rien Lui donner." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa pauvreté devant Allah reçoit Sa richesse." }
  ],
  munajat: `Ya Ghani, Tu n'as besoin de rien. J'ai besoin de tout. Je viens à Toi avec ma pauvreté. Comble-moi de Ta richesse.`
};

MIROIR["51:58"] = {
  reference: "51:58",
  theme: ["provision", "force", "créateur"],
  emotion: "Confiance, gratitude",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Qawiyy", "Al-Matin"],
  mirrorVersion: `« En vérité, Allah est le Grand Pourvoyeur, le Détenteur de la force, l'Inébranlable. » Le miroir affirme les attributs d'Allah. « Inna Allaha » — en vérité, Allah. « Huwa ar-Razzaq » — est le Grand Pourvoyeur. « Dhu al-quwwah » — Détenteur de la force. « Al-Matin » — l'Inébranlable. La provision, la force, la stabilité — tout vient de Lui. Le miroir m'interroge : où est-ce que je cherche ma provision, ma force, ma stabilité ?`,
  reflection: `Allah est la source de tout. Pourvoyeur, Fort, Inébranlable — Ses attributs sont notre refuge.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha huwa ar-Razzaq dhu al-quwwah al-Matin » — en vérité, Allah est le Grand Pourvoyeur, le Détenteur de la force, l'Inébranlable." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche ma provision, ma force, ma stabilité ? En Allah ou ailleurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui cherche ailleurs qu'Allah cherche dans le vide." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est soutenu par la force d'Allah. Il est inébranlable dans Son ordre." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'appuie sur l'Inébranlable devient inébranlable." }
  ],
  munajat: `Ya Razzaq, ya Qawiyy, ya Matin, Tu es ma provision, ma force, ma stabilité. Je m'appuie sur Toi seul. Ne permets pas que je cherche ailleurs.`
};

MIROIR["51:59"] = {
  reference: "51:59",
  theme: ["part", "châtiment", "justice"],
  emotion: "Sérieux, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Qasim", "Al-'Adl"],
  mirrorVersion: `« Ceux qui ont commis des injustices auront une part comme celle de leurs compagnons. Qu'ils ne hâtent donc pas Mon châtiment ! » Le miroir montre l'égalité du châtiment. « Inna lilladhina » — certes, pour ceux qui. « Zalamu » — ont commis des injustices. « Nasiban » — une part. « Mithla nasabi » — comme la part. « Ashabihim » — de leurs compagnons. Le châtiment est égal pour tous les injustes. Le miroir m'interroge : quelle est ma part ?`,
  reflection: `Le châtiment est juste et égal. Chaque groupe d'injustes reçoit sa part.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna lilladhina zalamu nasiban mithla nasabi ashabihim fala yasta'jilun » — ceux qui ont commis des injustices auront une part comme celle de leurs compagnons. Qu'ils ne hâtent pas !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelle est ma part ? Est-ce que je suis parmi les justes ou les injustes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La part est déterminée par les actes, pas par les intentions seules." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers rend à chacun selon ses actes. La justice est inscrite dans la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui évite l'injustice évite la part des injustes." }
  ],
  munajat: `Ya 'Adl, Ta justice est parfaite. Préserve-moi de l'injustice. Fais que ma part soit avec les croyants, pas avec les injustes.`
};

MIROIR["51:60"] = {
  reference: "51:60",
  theme: ["malheur", "mécréants", "jour"],
  emotion: "Crainte, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'ah", "Al-Haqqah"],
  mirrorVersion: `« Malheur, ce jour-là, aux mécréants ! » Le miroir conclut par l'avertissement. « Waylun » — malheur. « Yawma'idhin » — ce jour-là. « Lilladhina kafaru » — aux mécréants. Le Jour du Jugement sera terrible pour ceux qui ont refusé de croire. Le miroir m'interroge : suis-je parmi les croyants ou les mécréants ?`,
  reflection: `Le malheur du Jour est pour les mécréants. La foi est la protection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Waylun yawma'idhin lilladhina kafaru » — malheur, ce jour-là, aux mécréants !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je parmi les croyants ? Est-ce que ma foi me protégera du malheur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le malheur annoncé peut être évité par la foi aujourd'hui." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Jour vient. L'univers se prépare. L'homme doit se préparer aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit aujourd'hui échappera au malheur de demain." }
  ],
  munajat: `Ya Rabb, je crois en Toi. Préserve-moi du malheur du Jour. Fais que je sois parmi les croyants, pas parmi les mécréants. Accorde-moi Ta miséricorde.`
};

// ==================== SURAH 16: AN-NAHL (The Bee) - 128 verses - EXPANDED COVERAGE ====================

MIROIR["16:1"] = {
  reference: "16:1",
  theme: ["commandement", "jugement", "soumission"],
  emotion: "Révérence, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Malik"],
  mirrorVersion: `« L'ordre d'Allah vient, ne le hâtez donc pas. » Le miroir m'invite à la patience face au décret divin. « Ata amru Allahi » — l'ordre d'Allah vient. C'est une certitude, pas une possibilité. « Fala tasta'jiluh » — ne le hâtez donc pas. L'impatience humaine rencontre la souveraineté divine. Le miroir m'interroge : est-ce que j'essaie de précipiter ce qu'Allah a décrété ?`,
  reflection: `Le décret d'Allah vient en Son temps. L'impatience ne change rien — elle ajoute seulement du trouble.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ata amru Allahi fala tasta'jiluh » — l'ordre d'Allah vient, ne le hâtez donc pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans ma vie, qu'est-ce que j'essaie de hâter ? Pourquoi est-ce que je n'arrive pas à attendre le temps d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impatience est une forme de rébellion subtile contre le timing divin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne selon des cycles précis. La graine ne devient pas arbre en un jour." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le timing d'Allah reçoit Ses dons au moment parfait." }
  ],
  munajat: `Ya Rabb, Ton ordre vient en Son temps. Aide-moi à ne pas Le hâter. Apprends-moi la patience active qui attend tout en travaillant.`
};

MIROIR["16:3"] = {
  reference: "16:3",
  theme: ["création", "vérité", "but"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Il a créé les cieux et la terre en toute vérité. » Le miroir me place devant la création. « Khalaqa al-samawati wa al-arda bi-al-haqq » — Il a créé les cieux et la terre en toute vérité. La création n'est pas un jeu ou un hasard — elle a un sens, une direction, une finalité. Le miroir m'invite à contempler cette vérité dans tout ce qui m'entoure.`,
  reflection: `La création porte la signature de la vérité. Chaque atome témoigne de son Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa al-samawati wa al-arda bi-al-haqq » — Il a créé les cieux et la terre en toute vérité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je regarde la création, est-ce que je vois la vérité ? Ou est-ce que je vois seulement le matériel ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vérité de la création n'est pas seulement son existence — c'est son sens." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers proclame la vérité de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui voit la vérité dans la création voit le Créateur Lui-même." }
  ],
  munajat: `Ya Khaliq, Tu as créé en vérité. Ouvre mes yeux pour voir cette vérité dans tout ce qui m'entoure.`
};

MIROIR["16:18"] = {
  reference: "16:18",
  theme: ["bénédictions", "incomptable", "gratitude"],
  emotion: "Reconnaissance, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Ar-Razzaq", "Al-Mannan"],
  mirrorVersion: `« Et si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer. » Le miroir m'invite à l'impuissance reconnaissante. « In ta'uddu ni'mata Allahi la tuhsuha » — si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer. L'infini des bienfaits rencontre le fini de ma capacité de compter. Je ne peux pas tout énumérer — mais je peux tout reconnaître.`,
  reflection: `L'incapacité de compter les bienfaits est elle-même un bienfait — un rappel de ma dépendance.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in ta'uddu ni'mata Allahi la tuhsuha » — si vous comptez les bienfaits d'Allah, vous ne saurez pas les dénombrer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Ai-je essayé de compter ? Ai-je réalisé l'impossibilité de la tâche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ne pas pouvoir compter n'est pas une frustration — c'est une invitation à la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque chose dans l'univers est un bienfait. L'air, l'eau, la lumière — tout est don." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui essaie de compter découvre l'infinité du Donateur." }
  ],
  munajat: `Ya Mannan, je ne peux pas compter Tes bienfaits. Mais je peux Te remercier pour chaque un. Fais que ma gratitude soit constante.`
};

MIROIR["16:36"] = {
  reference: "16:36",
  theme: ["prophètes", "invitation", "monothéisme"],
  emotion: "Clarté, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Wahid"],
  mirrorVersion: `« Nous avons envoyé dans chaque communauté un messager : 'Adorez Allah et écartez-vous du Taghut.' » Le miroir me montre la mission universelle des prophètes. « Wa laqad ba'athna fi kulli ummatin rasulan » — Nous avons envoyé dans chaque communauté un messager. Le message est universel : « U'budu Allaha wa ijtanibu al-taghut » — adorez Allah et écartez-vous du Taghut. Toutes les nations ont reçu la guidance. Le miroir m'interroge : est-ce que j'adore Allah et m'écarte du faux ?`,
  reflection: `Chaque nation a reçu un guide. Le message est toujours le même : adorer le Vrai, rejeter le faux.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad ba'athna fi kulli ummatin rasulan an u'budu Allaha wa ijtanibu al-taghut » — Nous avons envoyé dans chaque communauté un messager : adorez Allah et écartez-vous du Taghut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels sont les Taghut (faux dieux) dans ma vie ? Est-ce que je m'en écarte vraiment ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'adoration d'Allah n'est pas complète sans le rejet du faux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'histoire humaine est parsemée de guides envoyés par Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son messager connaît son chemin." }
  ],
  munajat: `Ya Hadi, Tu as envoyé des messagers à chaque nation. Fais que je connaisse Ton message et que je l'accepte. Aide-moi à m'écarter du Taghut et à T'adorer seul.`
};

MIROIR["16:51"] = {
  reference: "16:51",
  theme: ["unicité", "adoration", "exclusivité"],
  emotion: "Révérence, engagement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Wahid", "Al-Ahad"],
  mirrorVersion: `« Allah a dit : 'Ne prenez pas deux divinités. Il n'est qu'un seul Dieu.' » Le miroir m'invite à l'exclusivité. « La tattakhidhu ilahayni ithnayn » — ne prenez pas deux divinités. « Innama huwa ilahun wahid » — Il n'est qu'un seul Dieu. Le cœur ne peut pas être divisé. Soit il est tourné vers l'Un, soit il est éparpillé. Le miroir m'interroge : mon cœur est-il unifié ?`,
  reflection: `L'unicité de Dieu demande l'unicité du cœur. La division de l'adoration affaiblit le croyant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tattakhidhu ilahayni ithnayn innama huwa ilahun wahid » — ne prenez pas deux divinités. Il n'est qu'un seul Dieu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon cœur est-il tourné vers l'Un ? Ou est-il divisé entre plusieurs maîtres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'exclusivité de l'adoration n'est pas limitation — c'est concentration." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier proclame l'unicité. La diversité cache l'unité fondamentale." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui unifie son cœur trouve la paix de l'unicité." }
  ],
  munajat: `Ya Wahid, Tu es l'Unique. Unifie mon cœur vers Toi seul. Ne permets pas que je me divise entre plusieurs amours.`
};

MIROIR["16:68-69"] = {
  reference: "16:68-69",
  theme: ["création", "guidance", "guérison"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Ash-Shafi"],
  mirrorVersion: `« Ton Seigneur a inspiré à l'abeille : 'Prends des demeures dans les montagnes, les arbres et les treillages. Puis mange de tous les fruits et suis les chemins de ton Seigneur.' » Le miroir me montre la guidance divine même pour les plus petites créatures. « Awha rabbuka ila al-nahl » — ton Seigneur a inspiré à l'abeille. L'abeille suit la guidance et produit du miel. « Fihi shifa'un li-al-nas » — en lui, il y a une guérison pour les gens. Le miroir m'invite à voir la guidance et la guérison dans chaque détail de la création.`,
  reflection: `La plus petite créature suit la guidance divine. Le résultat est la guérison pour les autres.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Awha rabbuka ila al-nahl... fihi shifa'un li-al-nas » — ton Seigneur a inspiré à l'abeille... en lui, il y a une guérison pour les gens." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis la guidance comme l'abeille ? Est-ce que je produis du miel pour les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidance n'est pas seulement pour les grands prophètes — elle est pour chaque créature." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute la création suit la guidance divine. Seul l'homme a le choix de la suivre ou non." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit la guidance produit de la guérison pour les autres." }
  ],
  munajat: `Ya Hadi, Tu guides même l'abeille. Guide-moi comme Tu la guides. Fais que je produise du miel pour les autres, pas du poison.`
};

MIROIR["16:90"] = {
  reference: "16:90",
  theme: ["justice", "bonté", "éthique"],
  emotion: "Engagement, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-'Adl", "Al-Barr"],
  mirrorVersion: `« Allah commande la justice, la bienfaisance et l'assistance aux proches. Et Il interdit la turpitude, l'acte répréhensible et la rébellion. » Le miroir me montre le code éthique complet. « Ya'muru bi-al-'adli wa al-ihsani » — Allah commande la justice et la bienfaisance. « Wa nah'an 'ani al-fahsha'i wa al-munkari wa al-baghyi » — et Il interdit la turpitude, l'acte répréhensible et la rébellion. Trois commandements positifs, trois interdits négatifs. L'éthique complète en un verset.`,
  reflection: `La justice, la bienfaisance, l'entraide — voilà le programme. La turpitude, le mal, l'oppression — voilà ce qu'il faut éviter.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha ya'muru bi-al-'adli wa al-ihsani wa ita'i dhi al-qurba » — Allah commande la justice, la bienfaisance et l'assistance aux proches." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Mon quotidien reflète-t-il ces trois commandements ? Ou est-ce que je néglige l'un d'eux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les interdits ne sont pas arbitraires — ils protègent ce qui est sacré." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par équilibre et don. La justice et la bienfaisance sont des lois cosmiques." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pratique ces trois commandements participe à l'ordre divin." }
  ],
  munajat: `Ya 'Adl, Tu commandes la justice et la bienfaisance. Aide-moi à vivre ces commandements chaque jour. Éloigne-moi de tout ce que Tu interdis.`
};

MIROIR["16:106"] = {
  reference: "16:106",
  theme: ["foi", "épreuve", "coeur"],
  emotion: "Gravité, vigilance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Batin", "Al-Hakam"],
  mirrorVersion: `« Quiconque a renié Allah après avoir cru — sauf celui qui y a été contraint alors que son cœur demeure plein de la sérénité de la foi. » Le miroir me montre la gravité de la apostasie et l'exception de la contrainte. « Man kafara bi-Allahi min ba'di imanihi » — quiconque a renié Allah après avoir cru. C'est grave. Mais « illa man ukriha wa qalbuhu mutma'innun bi-al-iman » — sauf celui qui y a été contraint alors que son cœur demeure plein de la sérénité de la foi. Le cœur compte plus que les paroles sous la contrainte.`,
  reflection: `La foi est d'abord dans le cœur. Les circonstances extrêmes peuvent forcer les mots, mais le cœur reste libre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man kafara bi-Allahi... illa man ukriha wa qalbuhu mutma'innun bi-al-iman » — quiconque a renié... sauf celui qui y a été contraint alors que son cœur demeure serein dans la foi." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quelles circonstances est-ce que je pourrais être testé ? Mon cœur est-il assez fort ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La contrainte extérieure ne peut pas toucher la sérénité intérieure si la foi est vraie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers extérieur peut contraindre le corps, mais pas le cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La sérénité du cœur dans la foi est la forteresse indestructible." }
  ],
  munajat: `Ya Batin, Tu connais mon cœur. Préserve-le dans la foi même dans les pires circonstances. Ne permets pas que je sois testé au-delà de mes forces.`
};

MIROIR["16:125"] = {
  reference: "16:125",
  theme: ["da'wa", "sagesse", "dialogue"],
  emotion: "Bienveillance, patience",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Hadi"],
  mirrorVersion: `« Par la sagesse et la bonne exhortation appelle au chemin de ton Seigneur. Et discute avec eux de la meilleure façon. » Le miroir me montre la méthode de la da'wa. « Udu ila sabili rabbika bi-al-hikmati wa al-maw'izati al-hasana » — appelle au chemin de ton Seigneur par la sagesse et la bonne exhortation. « Wa jadilhum bi-allati hiya ahsan » — et discute avec eux de la meilleure façon. La méthode compte autant que le message. Le miroir m'interroge : comment est-ce que j'appelle les autres vers Allah ?`,
  reflection: `La sagesse, la bienveillance, le beau discours — voilà la méthode prophétique. Pas la contrainte, pas la colère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udu ila sabili rabbika bi-al-hikmati wa al-maw'izati al-hasana wa jadilhum bi-allati hiya ahsan » — appelle par la sagesse et la bonne exhortation, et discute de la meilleure façon." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'appelle les autres ? Avec sagesse ou avec impatience ? Avec bienveillance ou avec jugement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La meilleure discussion n'est pas celle qui gagne l'argument — c'est celle qui gagne le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création elle-même est une invitation douce. Le soleil ne force personne à voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle avec sagesse voit les cœurs s'ouvrir naturellement." }
  ],
  munajat: `Ya Hakim, apprends-moi à appeler les autres avec sagesse et bienveillance. Ne permets pas que mon impatience ferme les cœurs que Tu veux ouvrir.`
};

MIROIR["16:126"] = {
  reference: "16:126",
  theme: ["patience", "justice", "rétribution"],
  emotion: "Endurance, équité",
  difficulty: "intermédiaire",
  relatedNames: ["As-Sabur", "Al-'Adl"],
  mirrorVersion: `« Et si vous punissez, infligez la même punition que celle que vous avez reçue. Mais si vous patientez, cela est meilleur pour ceux qui patientent. » Le miroir me montre la permission de la rétribution égale et la supériorité du pardon. « Wa in 'aqabtum fa-'aqibu bi-mithli ma 'uqibtum bihi » — si vous punissez, punissez de la même façon. « Wa la-in sabartum lahuwa khayrun lil-sabirin » — mais si vous patientez, c'est mieux pour ceux qui patientent. Le miroir m'interroge : est-ce que je choisis la justice ou le pardon ?`,
  reflection: `La rétribution égale est permise, mais le pardon est plus élevé. La patience transforme l'offense en élévation spirituelle.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa in 'aqabtum fa-'aqibu bi-mithli ma 'uqibtum bihi wa la-in sabartum lahuwa khayrun lil-sabirin » — si vous punissez, infligez la même punition. Mais si vous patientez, c'est meilleur pour ceux qui patientent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand on me fait du mal, est-ce que je réclame justice ou est-ce que je pardonne ? Quel est mon premier réflexe ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le pardon n'est pas de la faiblesse — c'est une force qui élève au-dessus de la vengeance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La nature suit le cycle action-réaction. L'être humain peut le transcender par le pardon." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui pardonne libère son cœur du fardeau de la rancœur." }
  ],
  munajat: `Ya Sabur, apprends-moi la patience face aux offenses. Donne-moi la force de pardonner quand la justice me donne raison.`
};

MIROIR["16:127"] = {
  reference: "16:127",
  theme: ["patience", "confiance", "sérénité"],
  emotion: "Paix intérieure, confiance",
  difficulty: "débutant",
  relatedNames: ["As-Sabur", "Al-Wakil"],
  mirrorVersion: `« Et prends patience, et ta patience ne vient que d'Allah. » Le miroir me montre la source de la patience. « Wa isbir wa ma sabruka illa bi-Allah » — prends patience, et ta patience ne vient que d'Allah. La patience n'est pas une capacité humaine autonome — elle est un don divin. Je ne peux pas être patient par ma propre force. Le miroir m'invite à demander la patience à Allah plutôt qu'à essayer de la fabriquer moi-même.`,
  reflection: `La patience est un don d'Allah. Celui qui veut être patient doit le demander à Celui qui donne la patience.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa isbir wa ma sabruka illa bi-Allah » — prends patience, et ta patience ne vient que d'Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'essaie d'être patient par mes propres forces ? Ou est-ce que je demande la patience à Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La patience n'est pas de l'endurcissement — c'est de l'ouverture à la force divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute chose dans l'univers patiente naturellement. L'être humain a besoin de se reconnecter à cette source." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que sa patience vient d'Allah ne s'épuise jamais." }
  ],
  munajat: `Ya Allah, je ne peux pas être patient par moi-même. Donne-moi la patience qui vient de Toi. Fais que je m'appuie sur Ta force et non sur la mienne.`
};

MIROIR["16:128"] = {
  reference: "16:128",
  theme: ["présence", "piété", "assurance"],
  emotion: "Confiance, paix",
  difficulty: "débutant",
  relatedNames: ["Al-Ma'a", "Al-Waliyy"],
  mirrorVersion: `« En vérité, Allah est avec ceux qui Le craignent et qui font le bien. » Le miroir me montre la présence divine. « Inna Allaha ma'a alladhina ittaqaw wa alladhina hum muhsinun » — Allah est avec ceux qui Le craignent et qui font le bien. La présence d'Allah n'est pas universelle de la même façon — elle est spéciale pour ceux qui Le craignent et font le bien. Le miroir m'invite à faire partie de ces gens-là.`,
  reflection: `La présence spéciale d'Allah est pour ceux qui L'honorent par leur crainte et leurs actions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna Allaha ma'a alladhina ittaqaw wa alladhina hum muhsinun » — Allah est avec ceux qui Le craignent et qui font le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie de ces gens ? Ma crainte et mes actions me qualifient-elles pour cette présence spéciale ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La présence divine n'est pas une récompense passivement reçue — elle est activement cultivée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est avec ceux qui sont en harmonie avec lui. La présence divine suit la même loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait qu'Allah est avec lui ne craint rien d'autre." }
  ],
  munajat: `Ya Ma'a, Tu es avec ceux qui Te craignent et font le bien. Fais que je sois parmi eux. Fais que je vive dans Ta présence spéciale.`
};

// ==================== SURAH 17: AL-ISRA (The Night Journey) - 111 verses - EXPANDED COVERAGE ====================

MIROIR["17:1"] = {
  reference: "17:1",
  theme: ["miracle", "voyage", "bénédiction"],
  emotion: "Émerveillement, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Mubin"],
  mirrorVersion: `« Gloire à Celui qui a fait voyager de nuit Son serviteur de la Mosquée sacrée à la Mosquée la plus éloignée. » Le miroir m'ouvre au miracle du Mi'raj. « Subhana alladhi asra bi-'abdihi laylan » — gloire à Celui qui a fait voyager de nuit Son serviteur. Le voyage nocturne n'est pas un déplacement physique ordinaire — c'est une transcendance de l'espace et du temps. Le Prophète a voyagé de La Mecque à Jérusalem en une nuit. Le miroir m'invite à méditer sur la puissance d'Allah qui peut faire ce qu'Il veut.`,
  reflection: `Le Mi'raj montre qu'Allah n'est pas limité par les lois de la physique. Ses miracles sont des signes de Sa souveraineté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Subhana alladhi asra bi-'abdihi laylan min al-masjidi al-harami ila al-masjidi al-aqsa » — gloire à Celui qui a fait voyager de nuit Son serviteur de la Mosquée sacrée à la Mosquée la plus éloignée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois aux miracles d'Allah ? Ou est-ce que je les rationalise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le voyage nocturne n'est pas seulement spatial — c'est aussi spirituel. L'âme peut voyager plus loin que le corps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est un voyage vers Allah. Le Mi'raj en est le prototype." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Chaque croyant a son propre Mi'raj — l'ascension dans la prière." }
  ],
  munajat: `Ya Qadir, Tu as fait voyager Ton Prophète dans la nuit. Fais voyager mon cœur vers Toi dans chaque prière.`
};

MIROIR["17:9"] = {
  reference: "17:9",
  theme: ["coran", "guidance", "droiture"],
  emotion: "Espérance, clarté",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "An-Nur"],
  mirrorVersion: `« Ce Coran guide vers ce qui est le plus droit. » Le miroir me montre la fonction du Coran. « Inna hadha al-qur'ana yahdi li-allati hiya aqwamu » — ce Coran guide vers ce qui est le plus droit. Pas seulement droit — le plus droit. Il y a des chemins droits, et il y a le chemin le plus droit. Le Coran distingue entre les options morales et guide vers la meilleure. Le miroir m'interroge : est-ce que je consulte le Coran pour mes décisions ?`,
  reflection: `Le Coran ne donne pas n'importe quelle direction — il donne la meilleure direction. Chaque verset est un guide vers l'optimal.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna hadha al-qur'ana yahdi li-allati hiya aqwamu » — ce Coran guide vers ce qui est le plus droit." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est-ce que je prends mes décisions ? Est-ce que le Coran est ma référence ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le « plus droit » n'est pas toujours le plus facile — mais c'est toujours le meilleur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit des lois optimales. Le Coran guide l'homme vers son optimum." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Coran ne se perd jamais — même quand le chemin semble tortueux." }
  ],
  munajat: `Ya Hadi, Ton Coran guide vers le plus droit. Fais que je Le consulte pour chaque décision. Ne permets pas que je choisisse le moins bon quand Tu me montres le meilleur.`
};

MIROIR["17:32"] = {
  reference: "17:32",
  theme: ["chasteté", "interdit", "protection"],
  emotion: "Vigilance, pureté",
  difficulty: "débutant",
  relatedNames: ["Al-Tahhir", "Al-Hafiz"],
  mirrorVersion: `« N'approchez pas la fornication, c'est une turpitude et quel mauvais chemin. » Le miroir me montre la protection de la chasteté. « Wa la taqrabu al-zina » — n'approchez pas la fornication. Pas seulement « ne commettez pas » — « n'approchez pas ». La prévention commence avant l'acte. « Inneha kana fahishatan » — c'est une turpitude. « Wa sa'a sabila » — et quel mauvais chemin. Le miroir m'invite à protéger mes yeux, mes pensées, pas seulement mes actes.`,
  reflection: `La protection commence par l'éloignement. N'approchez pas — c'est plus préventif que ne commettez pas.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqrabu al-zina inneha kana fahishatan wa sa'a sabila » — n'approchez pas la fornication, c'est une turpitude et quel mauvais chemin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'approche qui m'éloigne de la chasteté ? Quels chemins je prends qui mènent au danger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdit de l'approche est une miséricorde — il protège avant que le problème ne commence." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La chasteté protège la famille, la société, et l'âme. C'est une loi universelle de protection." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui protège sa chasteté protège son cœur et son destin." }
  ],
  munajat: `Ya Tahhir, protège ma chasteté. Éloigne-moi de tout ce qui peut mener à l'illicite. Donne-moi la force de regarder ailleurs et de fermer les portes du danger.`
};

MIROIR["17:37"] = {
  reference: "17:37",
  theme: ["orgueil", "modestie", "mesure"],
  emotion: "Humilité, sobriété",
  difficulty: "débutant",
  relatedNames: ["Al-Khafiyy", "Al-Mutin"],
  mirrorVersion: `« Ne marche pas sur terre avec arrogance. Tu ne saurais fendre la terre ni atteindre les montagnes en hauteur. » Le miroir m'invite à la modestie. « Wa la tamshi fi al-ardi marahan » — ne marche pas sur terre avec arrogance. « Inneka lan takhriqa al-arda » — tu ne saurais fendre la terre. « Wa lan tablagha al-jibala tulan » — ni atteindre les montagnes en hauteur. L'homme n'est ni le plus vaste ni le plus haut de la création. Le miroir m'invite à marcher humblement.`,
  reflection: `L'orgueil est une illusion de grandeur. La terre est plus vaste que moi, les montagnes plus hautes. Je ne suis qu'un passant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la tamshi fi al-ardi marahan inneka lan takhriqa al-arda wa lan tablagha al-jibala tulan » — ne marche pas avec arrogance, tu ne peux fendre la terre ni atteindre les montagnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je marche dans la vie ? Avec arrogance ou avec humilité ? Suis-je conscient de ma petitesse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La modestie n'est pas abaissement — c'est reconnaissance de la réalité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est vaste et l'homme est petit. Cette vérité devrait inspirer l'humilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui marche humblement sur terre s'élève auprès d'Allah." }
  ],
  munajat: `Ya Rabb, je suis petit dans Ta création. Aide-moi à marcher humblement. Ne permets pas que l'orgueil me fasse oublier ma place.`
};

MIROIR["17:44"] = {
  reference: "17:44",
  theme: ["gloire", "création", "louange"],
  emotion: "Émerveillement, louange",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Subbuh", "Al-Quddus"],
  mirrorVersion: `« Les sept cieux, la terre et ce qui s'y trouve Le glorifient. Et il n'existe rien qui ne Le glorifie par Sa louange. Mais vous ne comprenez pas leur glorification. » Le miroir m'ouvre à la louange universelle. « Tusabbihu lahu al-samawatu al-sab'u wa al-ardu » — les sept cieux et la terre Le glorifient. « Wa in min shay'in illa yusabbihu bi-hamdihi » — il n'existe rien qui ne Le glorifie. « Wa lakin la tafqahuna tasbihahum » — mais vous ne comprenez pas leur glorification. Toute la création prie — mais nous ne l'entendons pas.`,
  reflection: `La création entière est en état de prière continue. L'homme est invité à rejoindre cette symphonie silencieuse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tusabbihu lahu al-samawatu al-sab'u... wa in min shay'in illa yusabbihu bi-hamdihi » — les cieux, la terre et tout ce qui existe Le glorifient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'écoute la louange de la création ? Ou est-ce que je suis trop occupé par mes propres paroles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incompréhension de la louange de la création n'est pas une incapacité — c'est une invitation à l'écoute." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier est une mosquée où chaque créature prie." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entre dans la louange de la création entend le chant de l'univers." }
  ],
  munajat: `Ya Subbuh, toute la création Te glorifie. Ouvre mes oreilles pour entendre leur louange. Fais que je me joigne à cette symphonie universelle.`
};

MIROIR["17:70"] = {
  reference: "17:70",
  theme: ["dignité", "honneur", "création"],
  emotion: "Gratitude, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mukrim"],
  mirrorVersion: `« Nous avons honoré les enfants d'Adam. Nous les avons transportés sur terre et sur mer. » Le miroir me montre la dignité humaine. « Wa laqad karramna bani Adama » — Nous avons honoré les enfants d'Adam. « Wa hamalnahum fi al-barri wa al-bahri » — Nous les avons transportés sur terre et sur mer. L'homme est honoré par sa création même. Cette dignité n'est pas gagnée — elle est donnée. Le miroir m'invite à respecter cette dignité en moi et chez les autres.`,
  reflection: `La dignité humaine est un don divin. Elle n'est pas basée sur le mérite mais sur la création. Chaque être humain mérite le respect.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa laqad karramna bani Adama wa hamalnahum fi al-barri wa al-bahri » — Nous avons honoré les enfants d'Adam et les avons transportés sur terre et sur mer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je respecte la dignité de chaque être humain ? Est-ce que je respecte ma propre dignité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'honneur n'est pas une raison pour l'orgueil — c'est une responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est le seul être honoré de cette façon dans la création visible." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte la dignité humaine respecte le Créateur qui l'a donnée." }
  ],
  munajat: `Ya Karim, Tu m'as honoré par ma création. Aide-moi à respecter cette dignité en moi et chez chaque être humain. Ne permets pas que je la gaspille.`
};

MIROIR["17:110"] = {
  reference: "17:110",
  theme: ["noms divins", "adoration", "modération"],
  emotion: "Révérence, équilibre",
  difficulty: "débutant",
  relatedNames: ["Allah", "Ar-Rahman"],
  mirrorVersion: `« Dites : 'Invoquez Allah ou invoquez le Tout-Miséricordieux. Quel que soit le nom par lequel vous L'invoquez, c'est Lui qui a les plus beaux noms.' » Le miroir me montre l'importance des noms divins. « Qulu id'u Allaha aw id'u al-rahman » — invoquez Allah ou invoquez le Tout-Miséricordieux. « Ayyama ma tad'u falahu al-asma'u al-husna » — quel que soit le nom par lequel vous L'invoquez, c'est Lui qui a les plus beaux noms. Les noms sont multiples, mais le Nommé est Un. Le miroir m'invite à connaître et invoquer les plus beaux noms.`,
  reflection: `Les noms d'Allah sont des portes vers Sa connaissance. Chaque nom révèle un aspect de Sa perfection.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qulu id'u Allaha aw id'u al-rahman ayyama ma tad'u falahu al-asma'u al-husna » — invoquez Allah ou le Tout-Miséricordieux, tous Ses noms sont les plus beaux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels noms d'Allah est-ce que j'invoque le plus ? Est-ce que je connais les plus beaux noms ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La multiplicité des noms ne divise pas l'Unité — elle La révèle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame les noms divins par ses attributs." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît les noms d'Allah connaît Allah." }
  ],
  munajat: `Ya Allah, Ya Rahman, Tu as les plus beaux noms. Apprends-moi à T'invoquer par tous Tes noms. Fais que je Te connaisse à travers chacun d'eux.`
};

// ==================== SURAH 18: AL-KAHF (The Cave) - 110 verses - EXPANDED COVERAGE ====================

MIROIR["18:1"] = {
  reference: "18:1",
  theme: ["révélation", "louange", "guidance"],
  emotion: "Gratitude, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Hamid", "Al-Hadi"],
  mirrorVersion: `« Louange à Allah qui a fait descendre sur Son serviteur le Livre sans y apporter de tort. » Le miroir m'ouvre la sourate Al-Kahf. « Al-hamdu lillahi alladhi anzala 'ala 'abdihi al-kitaba » — louange à Allah qui a fait descendre sur Son serviteur le Livre. « Wa lam yaj'al lahu 'iwaja » — sans y apporter de tort. Le Coran est parfait, sans défaut, sans contradiction. Le miroir m'invite à lire ce Livre parfait.`,
  reflection: `Le Coran est descendu parfait. Il n'a pas besoin de correction ou d'amendement.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-hamdu lillahi alladhi anzala 'ala 'abdihi al-kitaba wa lam yaj'al lahu 'iwaja » — louange à Allah qui a fait descendre le Livre sans y apporter de tort." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je lis le Coran comme un Livre parfait ? Ou est-ce que je cherche des défauts qui n'existent pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perfection du Coran n'est pas une fierté — c'est une responsabilité de Le lire correctement." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La révélation parfaite correspond à la création parfaite." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lit le Coran comme parfait reçoit sa perfection." }
  ],
  munajat: `Ya Hamid, Ton Coran est parfait. Fais que je Le lise avec cette conviction. Ne permets pas que j'y cherche des défauts.`
};

MIROIR["18:10"] = {
  reference: "18:10",
  theme: ["refuge", "jeunes", "foi"],
  emotion: "Espoir, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Mawla"],
  mirrorVersion: `« Quand les jeunes se réfugièrent dans la caverne et dirent : 'Notre Seigneur, donne-nous de Ta part une miséricorde.' » Le miroir m'ouvre l'histoire des Gens de la Caverne. « Ith awa al-fityatu ila al-kahfi » — quand les jeunes se réfugièrent dans la caverne. « Fa-qalu rabbana atina min ladunka rahmatan » — ils dirent : Notre Seigneur, donne-nous de Ta part une miséricorde. Le refuge physique et le refuge spirituel se rejoignent. Le miroir m'invite à chercher refuge en Allah.`,
  reflection: `Les jeunes ont fui la persécution en cherchant refuge. Ils ont trouvé la protection d'Allah — et un sommeil de siècles.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ith awa al-fityatu ila al-kahfi fa-qalu rabbana atina min ladunka rahmatan » — les jeunes se réfugièrent dans la caverne et dirent : Notre Seigneur, donne-nous de Ta part une miséricorde." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que je cherche refuge ? Est-ce que je me tourne vers Allah comme ces jeunes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La caverne physique n'est rien sans la miséricorde divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être cherche refuge quelque part. Les croyants le cherchent en Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui cherche refuge en Allah trouve la miséricorde qu'il demande." }
  ],
  munajat: `Ya Waliyy, je cherche refuge en Toi comme les jeunes de la caverne. Donne-moi de Ta part une miséricorde. Protège-moi de tout mal.`
};

MIROIR["18:23-24"] = {
  reference: "18:23-24",
  theme: ["intention", "inshallah", "humble"],
  emotion: "Humilité, rappel",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Murid"],
  mirrorVersion: `« Et ne dis jamais à propos d'une chose : 'Je ferai cela demain' sans dire : 'Si Allah le veut.' » Le miroir me montre l'humilité du planning. « Wa la taqulanna li-shay'in inni fa'ilun dhalika ghadan » — ne dis jamais : je ferai cela demain. « Illa an yasha'a Allahu » — sans dire : si Allah le veut. L'avenir n'est pas entre mes mains. Je peux planifier, mais le résultat appartient à Allah. Le miroir m'invite à ajouter « inshallah » à chaque projet.`,
  reflection: `« Inshallah » n'est pas une superstition — c'est une reconnaissance de la souveraineté d'Allah sur l'avenir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa la taqulanna li-shay'in inni fa'ilun dhalika ghadan illa an yasha'a Allahu » — ne dis jamais : je ferai cela demain, sans dire : si Allah le veut." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je dis « inshallah » par habitude ou par conviction ? Est-ce que je reconnais vraiment que l'avenir est entre les mains d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'incertitude de l'avenir n'est pas une angoisse — c'est une invitation à la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier fonctionne par la volonté divine. L'homme est le seul à prétendre contrôler son avenir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit « inshallah » avec conviction vit en paix avec l'incertitude." }
  ],
  munajat: `Ya Qadir, l'avenir T'appartient. Fais que je dise « inshallah » avec conviction. Aide-moi à planifier tout en Te faisant confiance pour le résultat.`
};

MIROIR["18:39"] = {
  reference: "18:39",
  theme: ["gratitude", "bénédiction", "humilité"],
  emotion: "Reconnaissance, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Mu'ti"],
  mirrorVersion: `« Pourquoi, en entrant dans ton jardin, n'as-tu pas dit : 'Ce qu'Allah a voulu ! Il n'y a de force qu'en Allah.' » Le miroir me montre l'attitude correcte face aux bienfaits. « Lawla idha dakhalta jannataka qulta ma sha'a Allahu » — pourquoi n'as-tu pas dit : ce qu'Allah a voulu. « La quwwata illa bi-Allahi » — il n'y a de force qu'en Allah. Le propriétaire orgueilleux a oublié que son jardin était un don. Le miroir m'invite à reconnaître la source de mes bienfaits.`,
  reflection: `« Ma sha'a Allah » — ce qu'Allah a voulu. Reconnaître que tout bienfait est par Sa volonté, pas par mon mérite.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lawla idha dakhalta jannataka qulta ma sha'a Allahu la quwwata illa bi-Allahi » — pourquoi n'as-tu pas dit : ce qu'Allah a voulu, il n'y a de force qu'en Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand je reçois un bienfait, est-ce que je dis « ma sha'a Allah » ? Ou est-ce que je m'attribue le mérite ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil face aux bienfaits les transforme en pièges." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est « ma sha'a Allah ». Rien n'existe sans Sa volonté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui dit « ma sha'a Allah » garde ses bienfaits et en reçoit plus." }
  ],
  munajat: `Ya Mannan, tout ce que j'ai est par Ta volonté. Fais que je dise « ma sha'a Allah » face à chaque bienfait. Ne permets pas que je m'attribue ce qui vient de Toi.`
};

MIROIR["18:45"] = {
  reference: "18:45",
  theme: ["monde", "temporaire", "parabole"],
  emotion: "Sobriété, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Fani"],
  mirrorVersion: `« Propose leur l'exemple de la vie de ce monde : elle est comme une eau que Nous faisons descendre du ciel. » Le miroir me montre la parabole du monde. « Mathalu al-hayati al-dunya » — l'exemple de la vie de ce monde. « Ka-ma'in anzalnahu min al-sama'i » — comme une eau que Nous faisons descendre du ciel. L'eau tombe, fait pousser, puis sèche. La vie du monde est belle, puis disparaît. Le miroir m'invite à ne pas m'attacher à ce qui est temporaire.`,
  reflection: `La vie du monde est comme la pluie : elle vient, elle nourrit, puis elle s'en va. Seul ce qui est planté pour l'au-delà dure.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Mathalu al-hayati al-dunya ka-ma'in anzalnahu min al-sama'i » — l'exemple de la vie de ce monde est comme une eau que Nous faisons descendre du ciel." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je vois la vie du monde ? Comme permanente ou comme temporaire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La temporalité du monde n'est pas une punition — c'est un rappel de sa valeur relative." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers visible est temporaire. Seul l'Invisible est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la temporalité du monde ne s'y attache pas excessivement." }
  ],
  munajat: `Ya Baqi, ce monde est temporaire et Toi Tu es éternel. Fais que je m'attache à l'éternel, pas au temporaire. Ne permets pas que je me perde dans ce qui passe.`
};

MIROIR["18:65"] = {
  reference: "18:65",
  theme: ["sagesse", "connaissance", "serviteur"],
  emotion: "Révérence, curiosité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-'Alim", "Al-Hakim"],
  mirrorVersion: `« Ils trouvèrent un de Nos serviteurs à qui Nous avions donné une miséricorde de Notre part et à qui Nous avions enseigné une science émanant de Nous. » Le miroir m'ouvre l'histoire de Al-Khidr. « Wajada 'abdan min 'ibadina » — ils trouvèrent un de Nos serviteurs. « Ataynahu rahmatan min 'indina » — à qui Nous avions donné une miséricorde. « Wa 'allamnahu min ladunna 'ilman » — et à qui Nous avions enseigné une science de Notre part. Al-Khidr a une connaissance divine spéciale. Le miroir m'invite à reconnaître qu'il y a des connaissances au-delà de ma compréhension.`,
  reflection: `La connaissance divine n'est pas limitée à ce qui est révélé publiquement. Il y a des mystères pour les serviteurs élus.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wajada 'abdan min 'ibadina ataynahu rahmatan min 'indina wa 'allamnahu min ladunna 'ilman » — ils trouvèrent un serviteur à qui Nous avions donné miséricorde et science de Notre part." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que je ne sais pas tout ? Est-ce que j'accepte les mystères de la connaissance divine ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance spéciale n'est pas pour l'orgueil — elle est pour le service." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers cache des mystères que seuls les élus connaissent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la connaissance divine doit l'utiliser avec sagesse." }
  ],
  munajat: `Ya 'Alim, Tu enseignes qui Tu veux. Fais que j'accepte ce que je connais et ce que je ne connais pas. Donne-moi la connaissance qui me rapproche de Toi.`
};

MIROIR["18:110"] = {
  reference: "18:110",
  theme: ["prophète", "adoration", "unicité"],
  emotion: "Clarification, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-'Abd"],
  mirrorVersion: `« Dis : Je ne suis qu'un homme comme vous, à qui il a été révélé que votre Dieu est un Dieu unique. » Le miroir me montre l'humanité du Prophète. « Qul innama ana basharun mithlukum » — dis : je ne suis qu'un homme comme vous. « Yuha ilayya annama ilahukum ilahun wahid » — il m'a été révélé que votre Dieu est un Dieu unique. Le Prophète n'est pas divin — il est un serviteur qui a reçu la révélation. Le miroir m'invite à adorer le Dieu unique, pas le messager.`,
  reflection: `Le Prophète est un homme, pas un dieu. Sa mission est de transmettre l'unicité, pas de la partager.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qul innama ana basharun mithlukum yuha ilayya annama ilahukum ilahun wahid » — dis : je ne suis qu'un homme comme vous, à qui il a été révélé que votre Dieu est un Dieu unique." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'adore Allah seul ? Ou est-ce que je divinise d'autres que Lui ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humanité du Prophète est une miséricorde — il montre le chemin en le vivant." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tous les prophètes sont des hommes. Seul Allah est divin." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui adore le Dieu unique suit le chemin de tous les prophètes." }
  ],
  munajat: `Ya Wahid, Tu es le seul Dieu. Je T'adore Toi seul. Merci pour Ton Prophète qui m'a montré le chemin. Fais que je le suive sans le diviniser.`
};

MIROIR["18:25"] = {
  reference: "18:25",
  theme: ["temps", "mystère", "perspective"],
  emotion: "Humilité, émerveillement",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Ils demeurèrent dans leur caverne trois cents ans, auxquels en ajoutent neuf. » Le miroir me montre le mystère du temps. « Wa labithu fi kahfihim thalathumi'atin sanatin wa izdadu tis'an » — ils demeurèrent trois cents ans et neuf. Le temps peut s'écouler différemment pour Allah et pour nous. Ce qui semble long pour les hommes est court pour Lui. Le miroir m'invite à relativiser ma perception du temps.`,
  reflection: `Le temps est relatif. Allah est le Maître du temps, pas son serviteur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa labithu fi kahfihim thalathumi'atin sanatin wa izdadu tis'an » — ils demeurèrent dans leur caverne trois cents ans et neuf." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je perçois le temps ? Est-ce que je m'impatiente ou est-ce que je fais confiance au timing d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le temps long pour moi peut être court pour Allah. L'inverse est aussi vrai." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le temps fait partie de la création. Le Créateur n'est pas soumis au temps." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la relativité du temps vit dans la patience." }
  ],
  munajat: `Ya Khaliq, Tu es le Maître du temps. Fais que je ne m'impatiente pas. Aide-moi à faire confiance à Ton timing parfait.`
};

MIROIR["18:26"] = {
  reference: "18:26",
  theme: ["connaissance", "secret", "tawhid"],
  emotion: "Révérence, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-'Alim", "Al-Ghayb"],
  mirrorVersion: `« Dis : Allah sait mieux combien de temps ils demeurèrent. À Lui appartient le secret des cieux et de la terre. » Le miroir me ramène à l'essentiel. « Quli Allahu a'lamu bima labithu » — dis : Allah sait mieux. « Lahu ghaybu al-samawati wa al-ard » — à Lui appartient le secret des cieux et de la terre. Les détails appartiennent à Allah. Ce que je dois retenir, c'est la leçon, pas les chiffres. Le miroir m'invite à me concentrer sur l'essentiel.`,
  reflection: `Allah connaît ce que nous ignorons. Notre ignorance est une invitation à l'humilité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Quli Allahu a'lamu bima labithu lahu ghaybu al-samawati wa al-ard » — dis : Allah sait mieux, à Lui appartient le secret des cieux et de la terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ce que je ne sais pas ? Ou est-ce que je prétends tout connaître ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance n'est pas une faiblesse — c'est un rappel de notre dépendance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères. Allah les connaît tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte son ignorance s'ouvre à la connaissance." }
  ],
  munajat: `Ya 'Alim, Tu connais tout. Moi, je connais si peu. Fais que j'accepte mon ignorance avec humilité. Apprends-moi ce que j'ai besoin de savoir.`
};

MIROIR["18:27"] = {
  reference: "18:27",
  theme: ["coran", "récitation", "éternité"],
  emotion: "Dévotion, révérence",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Hafiz"],
  mirrorVersion: `« Récite ce qui t'a été révélé du Livre de ton Seigneur. Nul ne peut changer Ses paroles. » Le miroir me montre la constance du Coran. « Wa utlu ma uhiya ilayka min kitabi rabbika » — récite ce qui t'a été révélé. « La mubaddila li-kalimatihi » — nul ne peut changer Ses paroles. Le Coran est éternel, immuable. Le miroir m'invite à le réciter avec conviction.`,
  reflection: `Le Coran ne change pas. C'est nous qui changeons en le récitant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa utlu ma uhiya ilayka min kitabi rabbika la mubaddila li-kalimatihi » — récite ce qui t'a été révélé du Livre de ton Seigneur. Nul ne peut changer Ses paroles." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je récite le Coran régulièrement ? Ou est-ce que je le néglige ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Coran ne change pas, mais il me transforme quand je le récite." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La parole d'Allah traverse le temps sans s'altérer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui récite le Coran avec présence reçoit sa lumière." }
  ],
  munajat: `Ya Rabb, Ton Livre est éternel. Fais que je le récite avec conviction. Ne permets pas que je le néglige ou l'oublie.`
};

MIROIR["18:28"] = {
  reference: "18:28",
  theme: ["compagnonnage", "prière", "constance"],
  emotion: "Fidélité, amour",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Mu'min"],
  mirrorVersion: `« Fais preuve de patience en compagnie de ceux qui invoquent leur Seigneur matin et soir, recherchant Sa face. » Le miroir me montre l'importance des bons compagnons. « Wa isbir nafsaka ma'a alladhina yad'una rabbahum bi-al-ghadati wa al-'ashiyyi » — fais preuve de patience avec ceux qui invoquent leur Seigneur matin et soir. La compagnie des croyants renforce la foi. Le miroir m'invite à choisir mes compagnons avec sagesse.`,
  reflection: `Les compagnons façonnent le cœur. Bonne compagnie = bon cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa isbir nafsaka ma'a alladhina yad'una rabbahum bi-al-ghadati wa al-'ashiyyi » — fais preuve de patience en compagnie de ceux qui invoquent leur Seigneur matin et soir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qui sont mes compagnons ? Est-ce qu'ils m'aident à me rapprocher d'Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La bonne compagnie n'est pas un luxe — c'est une nécessité spirituelle." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les êtres s'influencent mutuellement. L'entourage façonne le caractère." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fréquente les saints devient saint." }
  ],
  munajat: `Ya Waliyy, donne-moi de bons compagnons. Ceux qui T'invoquent matin et soir. Ne permets pas que les mauvaises fréquentations m'éloignent de Toi.`
};

MIROIR["18:29"] = {
  reference: "18:29",
  theme: ["liberté", "choix", "responsabilité"],
  emotion: "Lucidité, gravité",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Adl"],
  mirrorVersion: `« Et dis : La vérité émane de votre Seigneur. Quiconque le veut, qu'il croie, et quiconque le veut, qu'il mécroie. » Le miroir me montre la liberté absolue. « Fa-man sha'a fal-yu'min wa man sha'a fal-yakfur » — quiconque le veut, qu'il croie, et quiconque le veut, qu'il mécroie. La foi ne peut être forcée. Le miroir m'interroge : est-ce que je choisis la foi librement ?`,
  reflection: `La foi est un choix libre. Personne ne peut croire sous la contrainte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-man sha'a fal-yu'min wa man sha'a fal-yakfur » — quiconque le veut, qu'il croie, et quiconque le veut, qu'il mécroie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je choisis la foi ? Ou est-ce que je la subis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté de croire implique la liberté de ne pas croire. Chaque choix a ses conséquences." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'homme est libre. Cette liberté est son honneur et sa responsabilité." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui choisit librement la foi possède une foi vivante." }
  ],
  munajat: `Ya Haqq, Tu m'as donné la liberté. Fais que je choisisse la foi chaque jour. Ne permets pas que je la prenne pour acquise.`
};

MIROIR["18:30"] = {
  reference: "18:30",
  theme: ["récompense", "foi", "œuvres"],
  emotion: "Espoir, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Shakur", "Al-Karim"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, Nous ne laisserons pas perdre la récompense de celui qui fait le mieux. » Le miroir me montre la justice divine. « Inna alladhina amanu wa 'amilu al-salihati » — ceux qui croient et font de bonnes œuvres. « Inna la nudī'u ajra man ahsana 'amalan » — Nous ne laisserons pas perdre la récompense de celui qui fait le mieux. La foi sans œuvres est incomplète. Le miroir m'invite à joindre l'acte à la croyance.`,
  reflection: `La foi et les œuvres sont inséparables. L'une sans l'autre est incomplète.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa 'amilu al-salihati inna la nudī'u ajra man ahsana 'amalan » — ceux qui croient et font de bonnes œuvres, Nous ne laisserons pas perdre la récompense de celui qui fait le mieux." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que ma foi se traduit en œuvres ? Ou est-ce qu'elle reste dans ma tête ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les œuvres sans foi sont vides. La foi sans œuvres est morte." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par l'action. La foi aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui joint la foi aux œuvres reçoit la récompense complète." }
  ],
  munajat: `Ya Shakur, Tu ne laisses rien perdre. Fais que ma foi se traduise en œuvres. Accepte mon petit effort et multiplie-le.`
};

MIROIR["18:31"] = {
  reference: "18:31",
  theme: ["paradis", "récompense", "éternité"],
  emotion: "Espoir, désir",
  difficulty: "débutant",
  relatedNames: ["Al-Karim", "Al-Mawla"],
  mirrorVersion: `« Voilà ceux qui auront les jardins d'Éden sous lesquels coulent les rivières. » Le miroir me montre la promesse du Paradis. « Ula'ika lahum jannatu 'adnin tajri min tahtihimu al-anhar » — ils auront les jardins d'Éden sous lesquels coulent les rivières. Le Paradis n'est pas une récompense abstraite — c'est une réalité concrète. Le miroir m'invite à désirer cette récompense éternelle.`,
  reflection: `Le Paradis est la destination finale du croyant. Le désirer, c'est s'y préparer.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ula'ika lahum jannatu 'adnin tajri min tahtihimu al-anhar » — ils auront les jardins d'Éden sous lesquels coulent les rivières." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je désire le Paradis ? Ou est-ce que je suis attaché à ce monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Paradis n'est pas cher — mais il demande tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Ce monde est temporaire. Le Paradis est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui désire le Paradis sincèrement y travaille." }
  ],
  munajat: `Ya Karim, Tu as promis le Paradis. Fais que je le désire plus que tout. Ne permets pas que les biens de ce monde me le fassent oublier.`
};

MIROIR["18:32"] = {
  reference: "18:32",
  theme: ["parabole", "jardin", "comparaison"],
  emotion: "Attention, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Muthul", "Al-Hakim"],
  mirrorVersion: `« Donne-leur l'exemple de deux hommes : à l'un d'eux Nous avons assigné deux jardins de raisins. » Le miroir m'ouvre une parabole. « Wadrib lahum mathalan rajulayni ja'alna li-ahadihima jannatayni min a'nabin » — donne-leur l'exemple de deux hommes. L'un a reçu deux jardins de raisins. L'autre n'a rien. Le miroir m'invite à réfléchir sur les bienfaits et leur reconnaissance.`,
  reflection: `Les parables du Coran enseignent par l'image. L'image reste dans le cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wadrib lahum mathalan rajulayni ja'alna li-ahadihima jannatayni min a'nabin » — donne-leur l'exemple de deux hommes : à l'un Nous avons assigné deux jardins de raisins." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel jardin ai-je reçu ? Est-ce que je le reconnais comme un don ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le jardin n'est pas le problème — c'est l'attitude envers le jardin." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bienfaits sont des tests. La gratitude les préserve." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Donateur dans le don garde le don." }
  ],
  munajat: `Ya Hakim, Tes parables enseignent. Fais que je comprenne celle-ci. Ne permets pas que les bienfaits me fassent oublier le Donateur.`
};

MIROIR["18:33"] = {
  reference: "18:33",
  theme: ["bienfait", "abondance", "gratitude"],
  emotion: "Reconnaissance, humilité",
  difficulty: "débutant",
  relatedNames: ["Al-Mannan", "Al-Razzaq"],
  mirrorVersion: `« Les deux jardins produisirent leurs fruits et ne subirent aucune perte. » Le miroir me montre l'abondance. « Jannatani a'tat ukulahuma wa lam tazlim minhu shay'an » — les deux jardins produisirent leurs fruits sans rien perdre. L'abondance est un signe de la générosité divine. Le miroir m'interroge : comment je réagis à l'abondance ?`,
  reflection: `L'abondance peut être une bénédiction ou un test selon l'attitude du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Jannatani a'tat ukulahuma wa lam tazlim minhu shay'an » — les deux jardins produisirent leurs fruits et ne subirent aucune perte." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quand j'ai l'abondance, est-ce que je remercie ? Ou est-ce que je m'enorgueillis ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'abondance sans gratitude devient une malédiction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'abondance est un don, pas un droit." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie pour l'abondance en reçoit plus." }
  ],
  munajat: `Ya Mannan, Tu donnes l'abondance. Fais que je remercie et que je ne m'enorgueillis pas. Ne permets pas que les bienfaits deviennent un voile entre Toi et moi.`
};

MIROIR["18:34"] = {
  reference: "18:34",
  theme: ["orgueil", "companion", "discussion"],
  emotion: "Mise en garde, réflexion",
  difficulty: "débutant",
  relatedNames: ["Al-Khabir", "Al-Basir"],
  mirrorVersion: `« Il avait des fruits. Il dit alors à son compagnon tout en discutant avec lui : Je suis plus riche que toi et ma tribu est plus nombreuse. » Le miroir me montre l'orgueil des biens. « Ana aktharu minka malan wa a'azzu nafaran » — je suis plus riche que toi et ma tribu est plus nombreuse. L'orgueilleux compare ses biens pour se sentir supérieur. Le miroir m'avertit contre cette attitude.`,
  reflection: `Comparer ses biens pour se sentir supérieur est une maladie du cœur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ana aktharu minka malan wa a'azzu nafaran » — je suis plus riche que toi et ma tribu est plus nombreuse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me compare aux autres pour me sentir supérieur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vraie richesse n'est pas dans les biens — elle est dans le cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens sont temporaires. Le cœur est éternel." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît la vraie valeur ne se compare pas." }
  ],
  munajat: `Ya Khabir, Tu connais mon cœur. Préserve-moi de l'orgueil des biens. Fais que je ne me compare pas pour me sentir supérieur.`
};

MIROIR["18:35"] = {
  reference: "18:35",
  theme: ["orgueil", "injustice", "aveuglement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Munir"],
  mirrorVersion: `« Il entra dans son jardin en se faisant du tort à lui-même. Il dit : Je ne pense pas que cela périra jamais. » Le miroir me montre l'aveuglement de l'orgueil. « Wa dakhala jannatahu wa huwa zalimun li-nafsihi » — il entra dans son jardin en se faisant du tort. « Ma azunnu an tabida hathihi abadan » — je ne pense pas que cela périra jamais. L'orgueilleux croit que ses biens sont éternels. Le miroir m'avertit contre cette illusion.`,
  reflection: `Croire que les biens sont éternels est une illusion. Tout périra sauf Allah.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa dakhala jannatahu wa huwa zalimun li-nafsihi qala ma azunnu an tabida hathihi abadan » — il entra dans son jardin en se faisant du tort. Il dit : Je ne pense pas que cela périra jamais." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois que mes biens dureront toujours ? Ou est-ce que je sais qu'ils sont temporaires ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui croit que tout périra détache son cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers visible est temporaire." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que tout périra s'attache à l'Éternel." }
  ],
  munajat: `Ya Hadi, guide-moi. Ne permets pas que je croie que mes biens sont éternels. Rappelle-moi que tout périra sauf Toi.`
};

MIROIR["18:36"] = {
  reference: "18:36",
  theme: ["négation", "résurrection", "aveuglement"],
  emotion: "Tristesse, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Haqq"],
  mirrorVersion: `« Je ne pense pas que l'Heure viendra. Et si je suis ramené vers mon Seigneur, je trouverai certainement meilleur que cela. » Le miroir me montre le déni de la résurrection. « Wa ma azunnu al-sa'ata qa'imatan » — je ne pense pas que l'Heure viendra. L'orgueilleux nie le jugement ou pense qu'il sera épargné. Le miroir m'avertit contre cette arrogance.`,
  reflection: `Nier le jugement ou penser qu'on sera épargné est une double erreur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma azunnu al-sa'ata qa'imatan wa la-in rudidtu ila rabbi la-ajidanna khayran minha muqalaban » — je ne pense pas que l'Heure viendra. Et si je suis ramené vers mon Seigneur, je trouverai certainement meilleur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crois vraiment à la résurrection ? Ou est-ce que je vis comme si elle n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Celui qui nie le jugement se prépare une mauvaise surprise." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le jugement est certain. La mort est la porte." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit au jugement vit chaque jour comme le dernier." }
  ],
  munajat: `Ya Ba'ith, Tu ressusciteras les morts. Fais que je croie vraiment à la résurrection. Ne permets pas que je vive comme si elle n'existait pas.`
};

MIROIR["18:37"] = {
  reference: "18:37",
  theme: ["rappel", "création", "foi"],
  emotion: "Sagesse, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Razzaq"],
  mirrorVersion: `« Son compagnon lui dit tout en discutant avec lui : Serais-tu mécréant envers Celui qui t'a créé de terre puis de sperme ? » Le miroir me montre le rappel du compagnon croyant. « Afakarta bi-lladhi khalaqaka min turabin thumma min nutfatin » — serais-tu mécréant envers Celui qui t'a créé de terre puis de sperme ? Le compagnon rappelle l'origine de l'homme. Le miroir m'invite à me souvenir de mon origine.`,
  reflection: `Se souvenir de son origine, c'est se souvenir de son Créateur.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afakarta bi-lladhi khalaqaka min turabin thumma min nutfatin » — serais-tu mécréant envers Celui qui t'a créé de terre puis de sperme ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine ? Ou est-ce que je l'oublie dans l'orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'origine humble rappelle la grandeur du Créateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être vivant vient de l'humble et retourne à l'humble." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son origine ne s'enorgueillit pas." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé de terre. Fais que je me souvienne de mon origine. Ne permets pas que l'orgueil me fasse oublier ma petitesse.`
};

MIROIR["18:38"] = {
  reference: "18:38",
  theme: ["tawhid", "reconnaissance", "foi"],
  emotion: "Foi, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Rabb"],
  mirrorVersion: `« Mais Lui, c'est Allah, mon Seigneur, et je n'associe personne à mon Seigneur. » Le miroir me montre la proclamation de foi. « Lakinna Allahu rabbi wa la ushriku bi-rabbi ahadan » — mais Lui, c'est Allah, mon Seigneur, et je n'associe personne. Le compagnon proclame le tawhid. Le miroir m'invite à proclamer ma foi sans compromis.`,
  reflection: `La foi sans association est la foi pure. Tout le reste est compromis.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Lakinna Allahu rabbi wa la ushriku bi-rabbi ahadan » — mais Lui, c'est Allah, mon Seigneur, et je n'associe personne à mon Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je proclame ma foi sans compromis ? Ou est-ce que je fais des associations cachées ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'association peut être subtile. L'argent, le statut, l'ego peuvent être des idoles." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le tawhid est la vérité de l'univers. L'association est l'illusion." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui ne associe rien à Allah possède le cœur pur." }
  ],
  munajat: `Ya Wahid, Tu es mon Seigneur. Je n'associe personne à Toi. Purifie mon cœur de toute association cachée.`
};

MIROIR["18:40"] = {
  reference: "18:40",
  theme: ["châtiment", "humilité", "avertissement"],
  emotion: "Crainte, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-'Aziz"],
  mirrorVersion: `« Peut-être que mon Seigneur me donnera quelque chose de meilleur que ton jardin. » Le miroir me montre l'espoir du croyant face à la perte. « 'Asa rabbi an yu'tiyani khayran min jannatika » — peut-être que mon Seigneur me donnera mieux. Le croyant espère en Allah même quand il n'a rien. Le miroir m'invite à espérer en Allah dans toutes les circonstances.`,
  reflection: `L'espoir en Allah est plus précieux que n'importe quel bien.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« 'Asa rabbi an yu'tiyani khayran min jannatika » — peut-être que mon Seigneur me donnera quelque chose de meilleur que ton jardin." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'espère en Allah quand je perds ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La perte dans ce monde peut être le gain dans l'autre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les biens de ce monde sont limités. Les biens d'Allah sont illimités." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui espère en Allah ne perd jamais." }
  ],
  munajat: `Ya Qadir, Tu peux me donner mieux que ce que je perds. Fais que j'espère en Toi dans toutes les circonstances. Ne permets pas que la perte me fasse désespérer.`
};

MIROIR["18:41"] = {
  reference: "18:41",
  theme: ["perte", "impuissance", "rappel"],
  emotion: "Humilité, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Qadir", "Al-Muhlik"],
  mirrorVersion: `« Ou bien son eau sera engloutie, et tu ne pourras jamais la retrouver. » Le miroir me montre la fragilité des bienfaits. « Aw yusbiha ma'uha ghawran falan tasti'a lahu talaban » — ou bien son eau sera engloutie et tu ne pourras la retrouver. Les bienfaits peuvent disparaître instantanément. Le miroir m'invite à ne pas m'y attacher.`,
  reflection: `Les bienfaits sont fragiles. Allah peut les reprendre à tout moment.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Aw yusbiha ma'uha ghawran falan tasti'a lahu talaban » — ou bien son eau sera engloutie et tu ne pourras jamais la retrouver." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je sais que mes bienfaits peuvent disparaître ? Ou est-ce que je les crois éternels ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La fragilité des bienfaits devrait nous attacher au Donateur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans ce monde peut disparaître en un instant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui sait que tout peut disparaître détache son cœur." }
  ],
  munajat: `Ya Rabb, tout peut disparaître. Fais que je ne m'attache pas aux bienfaits mais au Donateur. Ne permets pas que leur perte me détruisse.`
};

MIROIR["18:42"] = {
  reference: "18:42",
  theme: ["destruction", "regret", "réalité"],
  emotion: "Tristesse, leçon",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "Al-Muntaqim"],
  mirrorVersion: `« Ses fruits furent détruits. Il se mit alors à se tordre les mains à cause de ce qu'il y avait dépensé. » Le miroir me montre la destruction inévitable. « Wa uhitat thamaruhu » — ses fruits furent détruits. « Fa-asbaha yuqallibu kaffayhi 'ala ma anfaqa fiha » — il se tordait les mains sur ce qu'il y avait dépensé. L'orgueilleux regrette quand tout disparaît. Le miroir m'avertit : ne pas attendre la perte pour regretter.`,
  reflection: `Le regret après la perte est inutile. La gratitude avant la perte est sage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa uhitat thamaruhu fa-asbaha yuqallibu kaffayhi 'ala ma anfaqa fiha » — ses fruits furent détruits. Il se mit à se tordre les mains sur ce qu'il y avait dépensé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie avant de perdre ? Ou est-ce que je regrette après ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le regret vient trop tard. La gratitude vient à temps." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La destruction des biens est une leçon universelle." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remercie avant la perte n'a pas de regret après." }
  ],
  munajat: `Ya Hakim, Tu donnes et Tu reprends. Fais que je remercie avant de perdre. Ne permets pas que j'attende la destruction pour regretter.`
};

MIROIR["18:43"] = {
  reference: "18:43",
  theme: ["abandon", "impuissance", "solitude"],
  emotion: "Lucidité, désillusion",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Nasir"],
  mirrorVersion: `« Il n'eut personne pour le secourir en dehors d'Allah, et il ne put pas se venger lui-même. » Le miroir me montre l'abandon final. « Wa lam takun lahu fi'atun yansurunahu min duni Allahi » — il n'eut personne pour le secourir en dehors d'Allah. « Wa ma kana muntasiran » — et il ne put se venger. Les faux alliés disparaissent dans l'épreuve. Le miroir m'invite à compter sur Allah seul.`,
  reflection: `Dans l'épreuve, seuls les vrais alliés restent. Allah est le seul vrai allié.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa lam takun lahu fi'atun yansurunahu min duni Allahi wa ma kana muntasiran » — il n'eut personne pour le secourir en dehors d'Allah, et il ne put se venger." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Sur qui je compte vraiment ? Est-ce sur Allah ou sur les créatures ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les créatures abandonnent. Allah ne quitte jamais." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout soutien autre qu'Allah est fragile." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui compte sur Allah seul n'est jamais abandonné." }
  ],
  munajat: `Ya Waliyy, Tu es mon seul allié. Fais que je compte sur Toi seul. Ne permets pas que je cherche du secours ailleurs.`
};

MIROIR["18:44"] = {
  reference: "18:44",
  theme: ["allié", "victoire", "tawhid"],
  emotion: "Foi, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Haqq"],
  mirrorVersion: `« C'est là que la protection appartient à Allah, le Vrai. C'est Lui le meilleur en récompense et le meilleur en denouement. » Le miroir me montre la vérité finale. « Hunalika al-wilayatu li-Allahi al-haqqi » — c'est là que la protection appartient à Allah, le Vrai. « Huwa khayrun thawaban wa khayrun 'uqban » — Il est le meilleur en récompense et en dénouement. Allah est le seul vrai allié. Le miroir m'invite à m'attacher à Lui seul.`,
  reflection: `Allah est le Vrai, le Meilleur allié, la Meilleure récompense. Tout le reste est illusoire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hunalika al-wilayatu li-Allahi al-haqqi huwa khayrun thawaban wa khayrun 'uqban » — c'est là que la protection appartient à Allah, le Vrai. Il est le meilleur en récompense et le meilleur en dénouement." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère Allah comme mon allié principal ? Ou est-ce que je cherche d'autres alliés ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les alliés humains sont limités. L'alliance divine est illimitée." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers dépend d'Allah. Seul Lui est indépendant." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui s'attache à Allah seul possède tout." }
  ],
  munajat: `Ya Haqq, Tu es le Vrai. Fais que je m'attache à Toi seul. Ne permets pas que je cherche d'autres alliés qui ne peuvent rien.`
};

MIROIR["18:46"] = {
  reference: "18:46",
  theme: ["enfants", "biens", "parure"],
  emotion: "Lucidité, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Baqi", "Al-Zinah"],
  mirrorVersion: `« Les biens et les enfants sont l'ornement de la vie de ce monde. Mais les bonnes œuvres qui persistent sont meilleures auprès de ton Seigneur. » Le miroir me montre la vraie valeur. « Al-malu wa al-banuna zinatu al-hayati al-dunya » — les biens et les enfants sont l'ornement de la vie de ce monde. « Wa al-baqiyatu al-salihatu khayrun 'inda rabbika » — les bonnes œuvres qui persistent sont meilleures. Les biens et les enfants sont une parure, pas un but. Le miroir m'invite à investir dans ce qui persiste.`,
  reflection: `Les biens et les enfants sont une parure. Les bonnes œuvres sont un investissement éternel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Al-malu wa al-banuna zinatu al-hayati al-dunya wa al-baqiyatu al-salihatu khayrun 'inda rabbika » — les biens et les enfants sont l'ornement de la vie de ce monde. Les bonnes œuvres qui persistent sont meilleures auprès de ton Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que j'investis ? Dans la parure ou dans ce qui persiste ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La parure passe. Ce qui persiste reste." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui brille dans ce monde s'estompe." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui investit dans ce qui persiste gagne l'éternel." }
  ],
  munajat: `Ya Baqi, les biens et les enfants sont une parure. Fais que j'investisse dans ce qui persiste. Ne permets pas que je me perds dans l'ornement.`
};

MIROIR["18:47"] = {
  reference: "18:47",
  theme: ["résurrection", "montagnes", "jugement"],
  emotion: "Crainte, réalité",
  difficulty: "débutant",
  relatedNames: ["Al-Ba'ith", "Al-Hashir"],
  mirrorVersion: `« Le jour où Nous ferons marcher les montagnes, où tu verras la terre nivelée. » Le miroir me montre le Jour du Jugement. « Wa yawma nusayyiru al-jibala » — le jour où Nous ferons marcher les montagnes. « Wa tara al-arda barizatan » — où tu verras la terre nivelée. Les montagnes, symboles de stabilité, seront ébranlées. Le miroir m'invite à me préparer pour ce jour.`,
  reflection: `Les montagnes bougeront. Qu'en sera-t-il de ma fragile existence ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa yawma nusayyiru al-jibala wa tara al-arda barizatan » — le jour où Nous ferons marcher les montagnes, où tu verras la terre nivelée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me prépare pour le Jour où les montagnes bougeront ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La stabilité de ce monde est illusoire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier sera transformé au Jour du Jugement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se prépare pour ce jour n'a pas peur." }
  ],
  munajat: `Ya Ba'ith, les montagnes bougeront. Fais que je me prépare pour ce jour. Ne permets pas que je sois pris au dépourvu.`
};

MIROIR["18:48"] = {
  reference: "18:48",
  theme: ["comparution", "nuditée", "individualité"],
  emotion: "Crainte, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Hashir", "Al-Shahid"],
  mirrorVersion: `« Ils comparaîtront devant ton Seigneur en rangs. Nous vous avons créés la première fois. » Le miroir me montre la comparution finale. « Wa huziru ila rabbika suffan » — ils comparaîtront en rangs. « Qad ji'nakum kama khalaqnakum awwala marratin » — Nous vous avons créés comme la première fois. L'homme se retrouvera seul face à son Créateur. Le miroir m'invite à vivre en tenant compte de cette rencontre.`,
  reflection: `Nous comparaîtrons seuls. Ni biens, ni enfants ne nous accompagneront.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa huziru ila rabbika suffan qad ji'nakum kama khalaqnakum awwala marratin » — ils comparaîtront devant ton Seigneur en rangs. Nous vous avons créés comme la première fois." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis en pensant à cette comparution ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vie est un examen. La comparution est la remise des copies." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque être comparaîtra. Personne n'y échappera." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui vit en pensant à la comparution comparaît en paix." }
  ],
  munajat: `Ya Hashir, je comparaîtrai devant Toi. Fais que je vive en pensant à cette rencontre. Ne permets pas que je l'oublie dans les distractions.`
};

MIROIR["18:49"] = {
  reference: "18:49",
  theme: ["livre", "œuvres", "témoignage"],
  emotion: "Crainte, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Kitab", "Al-Shahid"],
  mirrorVersion: `« Le livre sera déposé. Tu verras les criminels effrayés par ce qu'il contient. » Le miroir me montre le livre des œuvres. « Wa wudi'a al-kitabu » — le livre sera déposé. « Fa-tara al-mujrimina mushfiqina mimma fih » — tu verras les criminels effrayés par ce qu'il contient. Chaque action est enregistrée. Le miroir m'invite à me demander : que contient mon livre ?`,
  reflection: `Chaque action est écrite. Le livre sera ouvert. Que contient-il ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa wudi'a al-kitabu fa-tara al-mujrimina mushfiqina mimma fih » — le livre sera déposé. Tu verras les criminels effrayés par ce qu'il contient." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Si mon livre était ouvert aujourd'hui, que verrais-je ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le livre ne peut être modifié qu'avant la mort." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est oublié. Tout est enregistré." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui remplit son livre de bonnes œuvres l'ouvre avec joie." }
  ],
  munajat: `Ya Shahid, Tu enregistres tout. Fais que je remplisse mon livre de bonnes œuvres. Ne permets pas que je sois effrayé par ce qu'il contient.`
};

MIROIR["18:50"] = {
  reference: "18:50",
  theme: ["iblis", "désobéissance", "ennemi"],
  emotion: "Vigilance, mise en garde",
  difficulty: "débutant",
  relatedNames: ["Al-'Aduww", "Al-Khannas"],
  mirrorVersion: `« Quand Nous dîmes aux anges : Prosternez-vous devant Adam, ils se prosternèrent, sauf Iblis. Il était du nombre des djinns. » Le miroir me montre l'origine de l'ennemi. « Fa-sajadu illa Iblisa kana min al-jinni » — ils se prosternèrent, sauf Iblis qui était du nombre des djinns. Iblis a refusé par orgueil. Il est devenu l'ennemi déclaré de l'homme. Le miroir m'avertit contre lui.`,
  reflection: `Iblis est l'ennemi éternel. Sa ruse est constante. La vigilance est nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-sajadu illa Iblisa kana min al-jinni fa-fasaqa 'an amri rabbihi » — ils se prosternèrent, sauf Iblis qui était du nombre des djinns et qui se rebella contre l'ordre de son Seigneur." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je considère Iblis comme mon ennemi ? Ou est-ce que je baisse ma garde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'orgueil d'Iblis est la même maladie qui peut nous atteindre." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le combat contre Iblis dure depuis la création d'Adam." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît son ennemi peut se défendre." }
  ],
  munajat: `Ya Rabb, Iblis est mon ennemi. Protège-moi de ses ruses. Ne permets pas que je baisse ma garde contre lui.`
};

// ==================== SURAH 19: MARYAM - 98 verses - EXPANDED COVERAGE ====================

MIROIR["19:1"] = {
  reference: "19:1",
  theme: ["mystère", "révélation", "attention"],
  emotion: "Révérence, curiosité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Kaf, Ha, Ya, 'Ayn, Sad. » Le miroir me place devant les lettres mystérieuses. « Kaf Ha Ya 'Ayn Sad » — cinq lettres qui ouvrent la sourate. Leur sens exact nous échappe, mais leur présence nous interpelle. Il y a des mystères dans le Coran que notre raison ne peut pas atteindre. Le miroir m'invite à accepter le mystère avec humilité.`,
  reflection: `Les lettres mystérieuses nous rappellent que tout n'est pas accessible à notre compréhension. La foi accepte le mystère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kaf Ha Ya 'Ayn Sad » — cinq lettres mystérieuses qui ouvrent la sourate." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je réagis face aux mystères du Coran ? Avec frustration ou avec acceptation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mystère n'est pas un obstacle — c'est une invitation à dépasser la raison." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères. Le Coran aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère s'ouvre à des compréhensions profondes." }
  ],
  munajat: `Ya 'Alim, Tu connais le sens de ces lettres. Fais que j'accepte ce que je ne comprends pas. Ouvre-moi à la compréhension que Tu veux me donner.`
};

MIROIR["19:41"] = {
  reference: "19:41",
  theme: ["ibrahim", "prophète", "sagesse"],
  emotion: "Révérence, inspiration",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Khalil"],
  mirrorVersion: `« Mentionne dans le Livre Abraham. C'était un véridique et un prophète. » Le miroir m'ouvre l'histoire d'Abraham. « Wa-dhkur fi al-kitabi Ibrahim » — mentionne dans le Livre Abraham. « Inneka kana siddiqan nabiyyan » — il était un véridique et un prophète. « Siddiq » — véridique — celui qui dit la vérité et vit dans la vérité. Abraham est le modèle de la sincérité absolue. Le miroir m'invite à suivre son exemple.`,
  reflection: `Abraham est appelé « siddiq » — véridique. La vérité n'est pas seulement dans les paroles, mais dans la vie entière.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa-dhkur fi al-kitabi Ibrahim inneka kana siddiqan nabiyyan » — mentionne Abraham, il était un véridique et un prophète." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis véridique comme Abraham ? Est-ce que ma vie reflète mes paroles ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La véracité n'est pas seulement dire vrai — c'est être vrai." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est vrai par nature. L'homme est appelé à l'être aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est véridique dans sa vie atteint la proximité divine." }
  ],
  munajat: `Ya Siddiq, Abraham était véridique. Fais que je sois véridique comme lui. Aide-moi à dire la vérité et à vivre dans la vérité.`
};

MIROIR["19:96"] = {
  reference: "19:96",
  theme: ["amour", "foi", "œuvres"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Wadud", "Al-Muhibb"],
  mirrorVersion: `« Ceux qui croient et font de bonnes œuvres, le Tout-Miséricordieux leur accordera Son amour. » Le miroir me montre la promesse de l'amour divin. « Inna alladhina amanu wa 'amilu al-salihati » — ceux qui croient et font de bonnes œuvres. « Sayaj'alu lahum al-rahmanu wuddan » — le Tout-Miséricordieux leur accordera Son amour. L'amour d'Allah n'est pas arbitraire — il est le fruit de la foi et des bonnes œuvres. Le miroir m'invite à cultiver ce qui attire Son amour.`,
  reflection: `L'amour d'Allah s'acquiert par la foi et les actions. Ce n'est pas un don aveugle — c'est une réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Inna alladhina amanu wa 'amilu al-salihati sayaj'alu lahum al-rahmanu wuddan » — ceux qui croient et font de bonnes œuvres, le Tout-Miséricordieux leur accordera Son amour." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je cultive ce qui attire l'amour d'Allah ? Ma foi et mes actions sont-elles dignes de Son amour ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'amour d'Allah n'est pas un sentiment passif — c'est une relation active." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait d'amour divin. Les croyants y participent activement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qu'Allah aime est aimé de toute la création." }
  ],
  munajat: `Ya Wadud, je veux Ton amour. Fais que je croie et fasse de bonnes œuvres. Accorde-moi Ton amour — c'est le plus grand trésor.`
};

// ==================== SURAH 20: TA-HA - 135 verses - EXPANDED COVERAGE ====================

MIROIR["20:1"] = {
  reference: "20:1",
  theme: ["mystère", "révélation", "attention"],
  emotion: "Révérence, curiosité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-'Alim"],
  mirrorVersion: `« Ta, Ha. » Le miroir m'ouvre la sourate Ta-Ha. Deux lettres mystérieuses. « Ta Ha » — leur sens nous échappe, mais leur présence nous éveille. Le Coran commence parfois par ces lettres pour nous rappeler notre ignorance face à la science divine. Le miroir m'invite à l'humilité intellectuelle.`,
  reflection: `Les lettres mystérieuses sont des rappels : nous ne savons pas tout. La foi commence par accepter ses limites.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta Ha » — deux lettres mystérieuses qui ouvrent la sourate." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte ce que je ne comprends pas ? Ou est-ce que je rejette par orgueil ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'ignorance de ces lettres n'est pas une faiblesse — c'est une invitation à la confiance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est plein de mystères que nous ne comprendrons jamais complètement." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte le mystère reçoit la paix de l'acceptation." }
  ],
  munajat: `Ya 'Alim, Tu connais le sens de ces lettres. Fais que j'accepte mes limites. Ouvre-moi à ce que Tu veux me révéler.`
};

MIROIR["20:14"] = {
  reference: "20:14",
  theme: ["unicité", "adoration", "prière"],
  emotion: "Révérence, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Wahid", "Al-Hayy"],
  mirrorVersion: `« En vérité, Je suis Allah. Point de divinité à part Moi. Adore-Moi donc et accomplis la prière pour M'invoquer. » Le miroir me montre l'essence du message. « Innani ana Allahu la ilaha illa ana » — en vérité, Je suis Allah, point de divinité à part Moi. « Fa'budni » — adore-Moi donc. « Wa-aqimi al-salata li-dhikri » — et accomplis la prière pour M'invoquer. L'unicité, l'adoration, la prière — le programme complet en un verset. Le miroir m'invite à vivre ce programme.`,
  reflection: `L'unicité mène à l'adoration, et l'adoration s'exprime par la prière. C'est un enchaînement logique.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Innani ana Allahu la ilaha illa ana fa'budni wa-aqimi al-salata li-dhikri » — Je suis Allah, point de divinité à part Moi. Adore-Moi et accomplis la prière pour M'invoquer." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je vis ce programme ? Mon unicité mène-t-elle à l'adoration ? Mon adoration s'exprime-t-elle par la prière ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La prière n'est pas une obligation — elle est une réponse à l'unicité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier adore Allah par son existence. L'homme l'adore par la prière consciente." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie vraiment goûte à l'unicité dans chaque prosternation." }
  ],
  munajat: `Ya Allah, Tu es l'Unique. Je T'adore. Aide-moi à accomplir la prière pour T'invoquer. Fais que chaque prière soit une rencontre avec Toi.`
};

MIROIR["20:114"] = {
  reference: "20:114",
  theme: ["coran", "humilité", "révélation"],
  emotion: "Révérence, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Haqq", "Al-'Aliyy"],
  mirrorVersion: `« Seigneur, augmente ma science ! » Le miroir me montre la prière du Prophète pour la connaissance. « Rabbi zidni 'ilman » — Seigneur, augmente ma science. Même le Prophète demandait plus de connaissance. La science n'est jamais suffisante — elle doit toujours croître. Le miroir m'invite à demander plus de science à Allah.`,
  reflection: `La demande de science n'a pas de fin. Plus on apprend, plus on réalise qu'il y a à apprendre.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi zidni 'ilman » — Seigneur, augmente ma science." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande plus de science ? Ou est-ce que je me contente de ce que je sais ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La demande de science n'est pas un aveu d'ignorance — c'est une reconnaissance de l'infinité du savoir." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est un livre de science. Chaque page révèle plus de Son créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la science reçoit les clés de la compréhension." }
  ],
  munajat: `Ya 'Alim, augmente ma science. Ne permets pas que je me contente de ce que je sais. Ouvre-moi à de nouvelles compréhensions chaque jour.`
};

// ==================== SURAH 21: AL-ANBIYA (The Prophets) - 112 verses - EXPANDED COVERAGE ====================

MIROIR["21:1"] = {
  reference: "21:1",
  theme: ["jugement", "compte", "inattention"],
  emotion: "Vigilance, réveil",
  difficulty: "débutant",
  relatedNames: ["Al-Hasib", "Al-Qari'ah"],
  mirrorVersion: `« Le compte des hommes approche, alors que dans leur inattention ils se détournent. » Le miroir m'ouvre la sourate Al-Anbiya. « Iqtaraba li-al-nasi hisabuhum » — le compte des hommes approche. « Wa hum fi ghaflatin mu'ridun » — alors que dans leur inattention ils se détournent. Le compte approche, mais les gens sont distraits. Le miroir m'interroge : suis-je parmi les distraits ou les éveillés ?`,
  reflection: `Le Jour du Jugement approche à chaque seconde. L'inattention est l'état normal de la plupart des gens.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Iqtaraba li-al-nasi hisabuhum wa hum fi ghaflatin mu'ridun » — le compte des hommes approche, alors que dans leur inattention ils se détournent." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Suis-je attentif au compte qui approche ? Ou suis-je détourné par les distractions du monde ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'approche du compte n'est pas une menace — c'est un rappel de préparation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier se prépare au Jugement. L'homme seul peut choisir de l'ignorer." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reste éveillé au compte qui approche le rencontre en paix." }
  ],
  munajat: `Ya Hasib, le compte approche. Réveille-moi de mon inattention. Fais que je me prépare chaque jour à Te rencontrer.`
};

MIROIR["21:35"] = {
  reference: "21:35",
  theme: ["mort", "épreuve", "vie"],
  emotion: "Acceptation, lucidité",
  difficulty: "débutant",
  relatedNames: ["Al-Mumit", "Al-Muhyi"],
  mirrorVersion: `« Toute âme goûtera la mort. Nous vous éprouvons par le mal et par le bien comme tentation. » Le miroir me place devant l'inévitable. « Kullu nafsin dha'iqatu al-mawt » — toute âme goûtera la mort. « Wa nablukum bi-al-sharri wa al-khayri fitnatan » — Nous vous éprouvons par le mal et par le bien. La mort est certaine, les épreuves sont variables. Le miroir m'invite à accepter la mort et à traverser les épreuves.`,
  reflection: `La mort est le rendez-vous certain. Les épreuves sont les variations. Les deux sont divinement ordonnés.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kullu nafsin dha'iqatu al-mawt wa nablukum bi-al-sharri wa al-khayri fitnatan » — toute âme goûtera la mort. Nous vous éprouvons par le mal et par le bien." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'accepte la mort comme certaine ? Comment je traverse les épreuves du bien et du mal ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Goûter la mort n'est pas une punition — c'est une transition vers la vraie vie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers meurt et renaît. L'âme aussi passe par cette transition." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte la mort vit vraiment." }
  ],
  munajat: `Ya Mumit, je goûterai la mort. Aide-moi à l'accepter. Fais que je traverse les épreuves avec patience et confiance.`
};

MIROIR["21:107"] = {
  reference: "21:107",
  theme: ["prophète", "miséricorde", "mission"],
  emotion: "Gratitude, amour",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Ar-Rahim"],
  mirrorVersion: `« Et Nous ne t'avons envoyé qu'en miséricorde pour les mondes. » Le miroir me montre la mission du Prophète. « Wa ma arsalnaka illa rahmatan li-al-'alamin » — Nous ne t'avons envoyé qu'en miséricorde pour les mondes. Le Prophète n'est pas un juge sévère — il est une miséricorde. Pour tous les mondes, pas seulement les humains. Le miroir m'invite à recevoir cette miséricorde et à la partager.`,
  reflection: `Le Prophète est miséricorde. Sa vie, ses paroles, son exemple — tout est miséricorde pour nous.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa ma arsalnaka illa rahmatan li-al-'alamin » — Nous ne t'avons envoyé qu'en miséricorde pour les mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je reçois la miséricorde du Prophète ? Comment je la partage avec les autres ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La miséricorde du Prophète n'est pas exclusive — elle est pour tous les mondes." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les mondes entiers bénéficient de la miséricorde prophétique." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit le Prophète avec amour reçoit sa part de cette miséricorde." }
  ],
  munajat: `Ya Rahman, merci pour Ton Prophète, miséricorde pour les mondes. Fais que je le suive avec amour et que je partage cette miséricorde avec tous.`
};

// ==================== SURAH 22: AL-HAJJ (The Pilgrimage) - 78 verses - EXPANDED COVERAGE ====================

MIROIR["22:1"] = {
  reference: "22:1",
  theme: ["jugement", "terre", "ébranlement"],
  emotion: "Crainte, vigilance",
  difficulty: "débutant",
  relatedNames: ["Al-Qari'ah", "Al-Zalzalah"],
  mirrorVersion: `« Ô hommes ! Craignez votre Seigneur. Le séisme de l'Heure sera une chose terrible. » Le miroir m'ouvre la sourate Al-Hajj. « Ya ayyuha al-nasu ittaqu rabbakum » — ô hommes, craignez votre Seigneur. « Inna zalzalata al-sa'ati shay'un 'azim » — le séisme de l'Heure sera une chose terrible. L'Heure vient avec un ébranlement cosmique. Le miroir m'invite à la crainte qui prépare.`,
  reflection: `Le séisme de l'Heure est physique et spirituel. La terre tremblera et les cœurs aussi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ayyuha al-nasu ittaqu rabbakum inna zalzalata al-sa'ati shay'un 'azim » — ô hommes, craignez votre Seigneur. Le séisme de l'Heure sera une chose terrible." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je crains vraiment Allah ? Ou est-ce que je vis comme si l'Heure n'existait pas ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le séisme de l'Heure n'est pas qu'une destruction — c'est une révélation de la vérité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers sera ébranlé ce Jour-là. Rien ne restera caché." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui craint Allah maintenant n'a rien à craindre du séisme." }
  ],
  munajat: `Ya Rabb, je Te crains. Prépare-moi au séisme de l'Heure. Fais que ma crainte aujourd'hui me protège de la terreur de ce Jour.`
};

MIROIR["22:27"] = {
  reference: "22:27",
  theme: ["hajj", "appel", "pèlerinage"],
  emotion: "Espérance, obéissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hadi", "Al-Bayt"],
  mirrorVersion: `« Et annonce aux hommes le Hajj. Ils viendront vers toi à pied et sur toute monture. » Le miroir me montre l'appel au Hajj. « Wa adhdhin fi-al-nasi bi-al-hajji » — annonce aux hommes le Hajj. « Ya'tuka rijalan wa 'ala kulli dhamirin » — ils viendront vers toi à pied et sur toute monture. Le Hajj est un rassemblement universel. Des gens de tous horizons convergent vers un point. Le miroir m'invite à répondre à cet appel.`,
  reflection: `Le Hajj est le voyage vers la Maison d'Allah. C'est le rassemblement de l'humanité croyante.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa adhdhin fi-al-nasi bi-al-hajji ya'tuka rijalan wa 'ala kulli dhamirin » — annonce le Hajj aux hommes, ils viendront à pied et sur toute monture." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'ai répondu à l'appel du Hajj ? Si je peux, qu'est-ce qui m'en empêche ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Hajj n'est pas un voyage touristique — c'est un voyage vers Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La Kaaba est le centre vers lequel convergent les croyants du monde entier." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait le Hajj avec sincérité revient purifié." }
  ],
  munajat: `Ya Hadi, appelle-moi à Ta Maison. Si je peux faire le Hajj, facilite-le pour moi. Si je ne peux pas, accepte mon intention sincere.`
};

MIROIR["22:78"] = {
  reference: "22:78",
  theme: ["effort", "nom", "sunnah"],
  emotion: "Engagement, identité",
  difficulty: "débutant",
  relatedNames: ["Al-Muslim", "Al-Haqq"],
  mirrorVersion: `« Et luttez pour Allah comme Il se doit d'être lutté pour. C'est Lui qui vous a élus et ne vous a imposé aucune gêne dans la religion. » Le miroir me montre l'effort requis. « Wa jahidu fi Allahi haqqa jihadih » — luttez pour Allah comme Il se doit d'être lutté pour. « Huwa ijtabakum » — c'est Lui qui vous a élus. « Wa ma ja'ala 'alaykum fi al-dini min haraj » — et ne vous a imposé aucune gêne dans la religion. Le jihad est un effort, pas une oppression. La religion est facile, pas difficile. Le miroir m'invite à l'effort sans complication.`,
  reflection: `Le jihad est l'effort sincère pour Allah. La religion est facilité, pas difficulté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa jahidu fi Allahi haqqa jihadih... wa ma ja'ala 'alaykum fi al-dini min haraj » — luttez pour Allah comme Il se doit... Il ne vous a imposé aucune gêne dans la religion." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel effort est-ce que je fais pour Allah ? Est-ce que je complique ma religion inutilement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'effort pour Allah n'est pas une charge — c'est un honneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'islam est la religion de la nature. La facilité est sa marque." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui lutte pour Allah comme Il se doit trouve la facilité dans la religion." }
  ],
  munajat: `Ya Rabb, je lutte pour Toi. Fais que mon effort soit à la hauteur de Ta grandeur. Ne permets pas que je complique ce que Tu as facilité.`
};

// ==================== SURAH 23: AL-MU'MINUN (The Believers) - 118 verses - EXPANDED COVERAGE ====================

MIROIR["23:1"] = {
  reference: "23:1",
  theme: ["foi", "succès", "humilité"],
  emotion: "Espérance, motivation",
  difficulty: "débutant",
  relatedNames: ["Al-Muflih", "Al-Mu'min"],
  mirrorVersion: `« Bienheureux sont les croyants. » Le miroir m'ouvre la sourate Al-Mu'minun. « Qad aflaha al-mu'minun » — bienheureux sont les croyants. « Aflaha » — ils ont réussi, ils ont prospéré. Le succès n'est pas matériel — il est spirituel. Les croyants sont les vrais gagnants. Le miroir m'invite à rejoindre ce groupe des bienheureux.`,
  reflection: `Le vrai succès est la foi. Les biens de ce monde passent, la foi reste.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qad aflaha al-mu'minun » — bienheureux sont les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je fais partie des croyants bienheureux ? Mon succès est-il défini par la foi ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le succès des croyants n'est pas visible maintenant — il sera manifeste alors." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers proclame la foi par son existence. Les croyants l'articulent par leur parole." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit vraiment a déjà réussi." }
  ],
  munajat: `Ya Muflih, je veux être parmi les bienheureux. Fais que ma foi soit vraie. Définis mon succès par ma relation avec Toi.`
};

MIROIR["23:2"] = {
  reference: "23:2",
  theme: ["prière", "humilité", "présence"],
  emotion: "Recueillement, concentration",
  difficulty: "débutant",
  relatedNames: ["Al-Khashi'", "Al-Muqim"],
  mirrorVersion: `« Ceux qui sont humbles dans leur prière. » Le miroir me montre la qualité de la prière. « Alladhina hum fi salatihim khashi'un » — ceux qui sont humbles dans leur prière. « Khashi'un » — humbles, concentrés, présents. La prière n'est pas des mouvements — c'est un état du cœur. Le miroir m'invite à la prière avec présence.`,
  reflection: `L'humilité dans la prière est la qualité essentielle. Sans elle, la prière est vide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Alladhina hum fi salatihim khashi'un » — ceux qui sont humbles dans leur prière." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment est ma prière ? Suis-je présent ou distrait ? Humble ou distancié ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'humilité dans la prière n'est pas une technique — c'est un état du cœur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier prie par son existence. L'homme prie par sa conscience." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui prie avec humilité goûte à la présence divine." }
  ],
  munajat: `Ya Khashi', apprends-moi l'humilité dans la prière. Ne permets pas que je me tienne devant Toi avec distraction. Fais que chaque prière soit une rencontre.`
};

MIROIR["23:115"] = {
  reference: "23:115",
  theme: ["création", "but", "responsabilité"],
  emotion: "Lucidité, responsabilité",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Haqq"],
  mirrorVersion: `« Pensiez-vous que Nous vous avions créés sans but et que vous ne seriez pas ramenés vers Nous ? » Le miroir me place devant la question du sens. « Afahasibtum annama khalaqnakum 'abathan » — pensiez-vous que Nous vous avions créés sans but ? « Wa annakum ilayna la turja'un » — et que vous ne seriez pas ramenés vers Nous. La création a un sens. Le retour vers Allah est certain. Le miroir m'invite à vivre en conscient de ce sens et de ce retour.`,
  reflection: `La vie n'est pas un hasard. Elle a un sens : connaître Allah et retourner à Lui.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afahasibtum annama khalaqnakum 'abathan wa annakum ilayna la turja'un » — pensiez-vous que Nous vous avions créés sans but et que vous ne seriez pas ramenés vers Nous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel sens je donne à ma vie ? Est-ce que je vis en conscient du retour vers Allah ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le but de la création n'est pas une contrainte — c'est une direction." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers a un but. L'homme a le plus grand but : connaître son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui connaît le but de sa vie le poursuit avec détermination." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé avec un but. Fais que je le connaisse et le poursuive. Prépare-moi pour le retour vers Toi.`
};

// ==================== SURAH 24: AN-NUR (The Light) - 64 verses - EXPANDED COVERAGE ====================

MIROIR["24:1"] = {
  reference: "24:1",
  theme: ["révélation", "obligation", "lumière"],
  emotion: "Révérence, ouverture",
  difficulty: "débutant",
  relatedNames: ["An-Nur", "Al-Hadi"],
  mirrorVersion: `« Une sourate que Nous avons fait descendre et que Nous avons imposée. » Le miroir m'ouvre la sourate An-Nur. « Suratun anzalnaha » — une sourate que Nous avons fait descendre. « Wa faradnaha » — et que Nous avons imposée. Les commandements de cette sourate sont obligatoires, pas optionnels. Le miroir m'invite à prendre ces commandements au sérieux.`,
  reflection: `La révélation est un don et une obligation. Elle guide et elle engage.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Suratun anzalnaha wa faradnaha » — une sourate que Nous avons fait descendre et que Nous avons imposée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je prends les commandements du Coran ? Comme suggestions ou comme obligations ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'obligation divine n'est pas une charge — c'est une guidance." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers suit des lois obligatoires. L'homme est appelé à suivre les lois divines." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui suit les obligations divines marche dans la lumière." }
  ],
  munajat: `Ya Nur, Tu as révélé cette sourate et l'as imposée. Fais que je la prenne au sérieux. Aide-moi à respecter toutes Ses obligations.`
};

MIROIR["24:55"] = {
  reference: "24:55",
  theme: ["promesse", "autorité", "foi"],
  emotion: "Espérance, engagement",
  difficulty: "débutant",
  relatedNames: ["Al-Waliyy", "Al-Nasir"],
  mirrorVersion: `« Allah a promis à ceux d'entre vous qui ont cru et fait de bonnes œuvres qu'Il leur donnerait la succession sur terre. » Le miroir me montre la promesse d'autorité. « Wa'ada Allahu alladhina amanu minkum wa 'amilu al-salihati » — Allah a promis à ceux qui ont cru et fait de bonnes œuvres. « Layastakhlifannahum fi al-ardi » — qu'Il leur donnerait la succession sur terre. L'autorité sur terre vient de la foi et des œuvres. Le miroir m'invite à cultiver ce qui attire cette promesse.`,
  reflection: `La promesse d'autorité est conditionnée par la foi et les actions. La responsabilité précède le pouvoir.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa'ada Allahu alladhina amanu... layastakhlifannahum fi al-ardi » — Allah a promis aux croyants... qu'Il leur donnerait la succession sur terre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je mérite cette promesse ? Ma foi et mes actions sont-elles à la hauteur ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'autorité n'est pas un droit — c'est une responsabilité." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'autorité sur la création appartient à ceux qui se soumettent au Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui gère bien ce qu'il a reçoit plus." }
  ],
  munajat: `Ya Waliyy, Tu as promis l'autorité aux croyants. Fais que je sois parmi eux. Donne-moi la foi et les œuvres qui attirent Ta promesse.`
};

// ==================== SURAH 25: AL-FURQAN (The Criterion) - 77 verses - EXPANDED COVERAGE ====================

MIROIR["25:1"] = {
  reference: "25:1",
  theme: ["révélation", "critère", "avertissement"],
  emotion: "Révérence, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Furqan", "Al-Munazzil"],
  mirrorVersion: `« Béni soit Celui qui a fait descendre le Critère sur Son serviteur pour avertir les mondes. » Le miroir m'ouvre la sourate Al-Furqan. « Tabaraka alladhi nazzala al-furqana 'ala 'abdihi » — béni soit Celui qui a fait descendre le Critère sur Son serviteur. « Li-yundhira al-'alamin » — pour avertir les mondes. « Al-Furqan » — le Critère — distingue le vrai du faux. Le Coran est le standard de vérité. Le miroir m'invite à utiliser ce critère.`,
  reflection: `Le Coran est le critère entre le vrai et le faux. Il tranche les débats et guide les décisions.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Tabaraka alladhi nazzala al-furqana 'ala 'abdihi li-yundhira al-'alamin » — béni soit Celui qui a fait descendre le Critère sur Son serviteur pour avertir les mondes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'utilise le Coran comme critère ? Ou est-ce que j'utilise d'autres standards ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le Critère n'est pas seulement pour juger les autres — il est d'abord pour se juger soi-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers fonctionne par des critères précis. Le Coran est le critère pour l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui utilise le Coran comme critère ne se perd jamais." }
  ],
  munajat: `Ya Furqan, Tu as donné le Critère. Fais que je l'utilise pour chaque décision. Ne permets pas que je me base sur d'autres standards.`
};

MIROIR["25:63"] = {
  reference: "25:63",
  theme: ["humilité", "ignorants", "caractère"],
  emotion: "Dignité, patience",
  difficulty: "débutant",
  relatedNames: ["Al-Hannah", "Al-Sabur"],
  mirrorVersion: `« Les serviteurs du Tout-Miséricordieux sont ceux qui marchent humblement sur terre et qui, quand les ignorants s'adressent à eux, disent : 'Paix.' » Le miroir me montre le caractère des serviteurs d'Allah. « Wa 'ibad al-rahman alladhina yamshuna 'ala al-ardi hawnan » — les serviteurs du Tout-Miséricordieux marchent humblement sur terre. « Wa idha khatabahum al-jahiluna qalu salaman » — et quand les ignorants s'adressent à eux, ils disent : paix. L'humilité dans la marche, la paix dans la réponse. Le miroir m'invite à ce caractère noble.`,
  reflection: `La réponse aux ignorants n'est pas l'engagement — c'est la paix. La dignité se montre dans la retenue.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'ibad al-rahman alladhina yamshuna 'ala al-ardi hawnan wa idha khatabahum al-jahiluna qalu salaman » — les serviteurs du Tout-Miséricordieux marchent humblement et disent paix aux ignorants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je marche sur terre ? Comment je réponds aux ignorants ? Suis-je parmi ces serviteurs ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Dire paix n'est pas une faiblesse — c'est une force qui refuse l'escalade." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers répond par l'équilibre, pas par l'agression." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond par la paix gagne sans combattre." }
  ],
  munajat: `Ya Rahman, je veux être Ton serviteur. Fais que je marche humblement et que je réponde par la paix. Ne permets pas que je tombe dans l'escalade.`
};

MIROIR["25:70"] = {
  reference: "25:70",
  theme: ["repentir", "pardon", "transformation"],
  emotion: "Espoir, soulagement",
  difficulty: "débutant",
  relatedNames: ["At-Tawwab", "Al-Ghaffur"],
  mirrorVersion: `« Sauf celui qui se repent, croit et fait une bonne œuvre : ceux-là, Allah changera leurs mauvaises actions en bonnes. » Le miroir me montre la promesse de transformation. « Illa man taba wa amana wa 'amila 'amalan salihan » — sauf celui qui se repent, croit et fait une bonne œuvre. « Fa-ula'ika yubaddilu Allahu sayyi'atihim hasanat » — Allah changera leurs mauvaises actions en bonnes. Le repentir sincère transforme le passé. Le miroir m'invite à ce repentir transformateur.`,
  reflection: `Le repentir n'efface pas seulement — il transforme. Les mauvaises actions deviennent bonnes par le repentir sincère.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa man taba wa amana wa 'amila 'amalan salihan fa-ula'ika yubaddilu Allahu sayyi'atihim hasanat » — sauf celui qui se repent, croit et fait une bonne œuvre, Allah changera leurs mauvaises actions en bonnes." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me repens sincèrement ? Est-ce que je crois que mes mauvaises actions peuvent devenir bonnes ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La transformation n'est pas magique — elle vient du repentir, de la foi et des œuvres." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers transforme constamment. Le repentir transforme l'âme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent vraiment voit son passé transformé." }
  ],
  munajat: `Ya Tawwab, je me repens. Change mes mauvaises actions en bonnes. Accepte mon repentir et transforme mon passé.`
};

// ==================== SURAH 26: ASH-SHU'ARA (The Poets) - 227 verses - EXPANDED COVERAGE ====================

MIROIR["26:1"] = {
  reference: "26:1",
  theme: ["mystère", "révélation", "clarté"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mubin"],
  mirrorVersion: `« Ta, Sin, Mim. Voici les versets du Livre explicite. » Le miroir m'ouvre la sourate Ash-Shu'ara. « Ta Sin Mim » — lettres mystérieuses. « Tilka ayatu al-kitabi al-mubin » — voici les versets du Livre explicite. Les mystères et la clarté coexistent. Le Coran est profond et accessible. Le miroir m'invite à entrer dans ce Livre avec humilité et confiance.`,
  reflection: `Le Coran est mystère et clarté. Ce qui nous échappe nous attire ; ce qui est clair nous guide.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta Sin Mim tilka ayatu al-kitabi al-mubin » — Ta Sin Mim, voici les versets du Livre explicite." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'aborde le Coran ? Avec quel mélange d'humilité et de confiance ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le mystère et la clarté ne s'opposent pas — ils se complètent." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est à la fois mystérieux et explicite dans ses lois." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui entre dans le Coran avec les deux attitudes reçoit les deux bénédictions." }
  ],
  munajat: `Ya Mubin, Ton Livre est explicite et mystérieux. Fais que je l'approche avec humilité et confiance. Guide-moi dans Sa lecture.`
};

MIROIR["26:88"] = {
  reference: "26:88",
  theme: ["jugement", "richesse", "enfants"],
  emotion: "Lucidité, perspective",
  difficulty: "débutant",
  relatedNames: ["Al-Malik", "Al-Hasib"],
  mirrorVersion: `« Le Jour où ni les biens ni les enfants ne seront d'aucune utilité. » Le miroir me montre ce qui compte vraiment. « Yawma la yanfa'u malun wa la banun » — le Jour où ni les biens ni les enfants ne seront d'aucune utilité. Ce que nous valorisons dans ce monde perd sa valeur ce Jour-là. Le miroir m'interroge : qu'est-ce qui compte vraiment ?`,
  reflection: `Les biens et les enfants sont des bénédictions, mais elles ne sauvent pas. Seul ce qui est fait pour Allah compte.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yawma la yanfa'u malun wa la banun » — le Jour où ni les biens ni les enfants ne seront d'aucune utilité." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je valorise ? Est-ce que je m'appuie sur ce qui passera ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Ce qui ne sauve pas n'est pas inutile — il faut l'utiliser pour ce qui sauve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers passe. Seul ce qui est fait pour l'éternel demeure." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui investit dans ce qui compte vraiment trouve son investissement multiplier." }
  ],
  munajat: `Ya Malik, les biens et les enfants ne sauveront pas. Fais que j'investisse dans ce qui compte vraiment. Aide-moi à voir au-delà des apparences.`
};

MIROIR["26:227"] = {
  reference: "26:227",
  theme: ["poètes", "foi", "action"],
  emotion: "Clarté, discernement",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Haqq", "Al-Basir"],
  mirrorVersion: `« Sauf ceux qui croient, font de bonnes œuvres et invoquent souvent Allah. » Le miroir me montre l'exception honorable. « Illa alladhina amanu wa 'amilu al-salihati » — sauf ceux qui croient et font de bonnes œuvres. « Wa dhakaru Allaha kathiran » — et invoquent souvent Allah. L'art n'est pas condamné s'il est au service de la foi et de la vertu. Le miroir m'invite à mettre mes talents au service d'Allah.`,
  reflection: `L'art et la poésie peuvent être déviants ou guides. La différence est dans l'intention et l'action qui les accompagnent.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Illa alladhina amanu wa 'amilu al-salihati wa dhakaru Allaha kathiran » — sauf ceux qui croient, font de bonnes œuvres et invoquent souvent Allah." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment j'utilise mes talents ? Au service de quoi ? De la foi ou de l'égarement ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'art n'est ni bon ni mauvais en soi — c'est l'intention qui le qualifie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La beauté de l'univers est un art qui glorifie son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui met son art au service d'Allah transforme l'éphémère en éternel." }
  ],
  munajat: `Ya Basir, Tu vois mes intentions. Fais que je mette mes talents à Ton service. Ne permets pas que je les utilise pour l'égarement.`
};

// ==================== SURAH 27: AN-NAML (The Ant) - 93 verses - EXPANDED COVERAGE ====================

MIROIR["27:1"] = {
  reference: "27:1",
  theme: ["révélation", "foi", "bonne nouvelle"],
  emotion: "Espérance, ouverture",
  difficulty: "débutant",
  relatedNames: ["Al-Bashir", "Al-Hadi"],
  mirrorVersion: `« Ta, Sin. Voici les versets du Coran et d'un Livre explicite, une guidée et une bonne nouvelle pour les croyants. » Le miroir m'ouvre la sourate An-Naml. « Ta Sin » — lettres mystérieuses. « Ayatu al-qur'ani wa kitabin mubin » — versets du Coran et d'un Livre explicite. « Hudan wa bushra li-al-mu'minin » — une guidée et une bonne nouvelle pour les croyants. Le Coran guide et annonce la bonne nouvelle. Le miroir m'invite à recevoir cette guidée et cette annonce.`,
  reflection: `Le Coran est guidée et bonne nouvelle. Il montre le chemin et promet le succès.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ta Sin ayatu al-qur'ani wa kitabin mubin hudan wa bushra li-al-mu'minin » — Ta Sin, versets du Coran et d'un Livre explicite, guidée et bonne nouvelle pour les croyants." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reçois le Coran comme guidée et bonne nouvelle ? Ou comme autre chose ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La guidée et la bonne nouvelle sont pour les croyants — les autres ne les reçoivent pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est guidée et bonne nouvelle pour ceux qui savent voir." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit le Coran comme guidée et bonne nouvelle trouve les deux." }
  ],
  munajat: `Ya Bashir, Ton Coran est guidée et bonne nouvelle. Fais que je Le reçois ainsi. Guide-moi et annonce-moi la bonne nouvelle.`
};

MIROIR["27:19"] = {
  reference: "27:19",
  theme: ["sagesse", "gratitude", "prière"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Hakim", "An-Ni'mah"],
  mirrorVersion: `« Seigneur, inspire-moi de rendre grâce pour le bienfait que Tu m'as accordé. » Le miroir me montre la prière de Salomon. « Rabbi awzi'ni an ashkura ni'mataka allati an'amta 'alayya » — Seigneur, inspire-moi de rendre grâce pour le bienfait que Tu m'as accordé. Même un prophète demande l'aide pour être reconnaissant. La gratitude n'est pas automatique — elle demande de l'inspiration divine. Le miroir m'invite à demander cette inspiration.`,
  reflection: `La gratitude est un bienfait qui demande un autre bienfait : la capacité d'être reconnaissant.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbi awzi'ni an ashkura ni'mataka allati an'amta 'alayya » — Seigneur, inspire-moi de rendre grâce pour le bienfait que Tu m'as accordé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande l'aide pour être reconnaissant ? Ou est-ce que je prends la gratitude pour acquise ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La gratitude n'est pas un devoir — c'est une grâce qui se demande." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers est bienfait. La gratitude est la réponse appropriée." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la capacité d'être reconnaissant reçoit plus de bienfaits." }
  ],
  munajat: `Ya Mannan, inspire-moi la gratitude. Je ne peux pas Te remercier assez sans Ton aide. Fais que chaque bienfait augmente ma reconnaissance.`
};

MIROIR["27:62"] = {
  reference: "27:62",
  theme: ["détresse", "réponse", "espoir"],
  emotion: "Espérance, confiance",
  difficulty: "débutant",
  relatedNames: ["Al-Mujib", "Al-Fattah"],
  mirrorVersion: `« Qui répond à l'appel du désespéré et qui dissipe le mal ? » Le miroir me montre la miséricorde d'Allah. « Amman yujibu al-mudtarra idha da'ahu » — qui répond à l'appel du désespéré. « Wa yakshifu al-sun » — et qui dissipe le mal. Allah répond à celui qui n'a plus d'autre recours. Le désespoir humain rencontre la réponse divine. Le miroir m'invite à invoquer Allah dans ma détresse.`,
  reflection: `Allah répond particulièrement à celui qui n'a plus d'espoir ailleurs. La détresse est l'antichambre de la réponse.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Amman yujibu al-mudtarra idha da'ahu wa yakshifu al-sun » — qui répond à l'appel du désespéré et dissipe le mal ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans ma détresse, est-ce que j'invoque Allah ? Est-ce que je fais confiance à Sa réponse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La détresse n'est pas un abandon — c'est une invitation à l'invocation." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque créature dans la détresse se tourne instinctivement vers son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui invoque Allah dans la détresse reçoit Sa réponse." }
  ],
  munajat: `Ya Mujib, Tu réponds au désespéré. Dans ma détresse, je T'invoque. Réponds-moi et dissipe mon mal.`
};

// ==================== SURAH 28: AL-QASAS (The Stories) - 88 verses - EXPANDED COVERAGE ====================

MIROIR["28:1"] = {
  reference: "28:1",
  theme: ["mystère", "révélation", "clarté"],
  emotion: "Révérence, attention",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hakim", "Al-Mubin"],
  mirrorVersion: `« Ta, Sin, Mim. Voici les versets du Livre explicite. » Le miroir m'ouvre la sourate Al-Qasas. « Ta Sin Mim » — lettres mystérieuses. « Ayatu al-kitabi al-mubin » — versets du Livre explicite. Le mystère et la clarté s'ouvrent ensemble. Le miroir m'invite à entrer dans le Livre avec cette double conscience.`,
  reflection: `Les lettres mystérieuses nous rappellent notre ignorance. Le Livre explicite nous guide dans notre quête.`,
  tajalli: [
