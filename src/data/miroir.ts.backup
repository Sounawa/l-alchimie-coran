MIROIR["55:43"] = {
  reference: "55:43",
  theme: ["enfer", "accueil", "ironie"],
  emotion: "Crainte, mise en garde",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Hakam"],
  mirrorVersion: `« Voici l'Enfer que les criminels traitaient de mensonge. » Le miroir me montre l'ironie tragique. « Hadhihi jahannamu allati yukadhdhibu biha al-mujrimun » — voici l'Enfer que les criminels traitaient de mensonge. La réalité qu'ils niaient. Le miroir m'invite à croire maintenant.`,
  reflection: `Ce qu'ils niaient est devenu leur réalité. La négation ne change rien à la vérité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hadhihi jahannamu allati yukadhdhibu biha al-mujrimun » — voici l'Enfer que les criminels traitaient de mensonge." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je nie maintenant qui deviendra réalité ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation de la vérité ne l'annule pas." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La vérité existe indépendamment de notre croyance." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui croit maintenant évite la rencontre forcée." }
  ],
  munajat: `Ya Haqq, l'Enfer est vérité. Fais que j'y croie maintenant. Ne permets pas que je le nie pour le rencontrer.`
};

MIROIR["55:44"] = {
  reference: "55:44",
  theme: ["enfer", "feu", "cycle"],
  emotion: "Crainte, effroi",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Muhit"],
  mirrorVersion: `« Ils feront le tour entre le feu et une eau bouillante. » Le miroir me montre le cycle du châtiment. « Yatufuna baynaha wa bayna hamin an » — ils feront le tour entre le feu et l'eau bouillante. Le cycle est éternel. Le miroir m'invite à éviter ce cycle.`,
  reflection: `Le cycle entre le feu et l'eau bouillante est sans fin. Éviter le cycle est la priorité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yatufuna baynaha wa bayna hamin an » — ils feront le tour entre le feu et une eau bouillante." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels cycles je veux éviter ? Comment puis-je le faire ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le cycle du châtiment vient du cycle du péché." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le cycle de la souffrance est éternel pour les damnés." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui brise le cycle du péché évite le cycle du châtiment." }
  ],
  munajat: `Ya Muhit, préserve-moi du cycle du châtiment. Brise mes cycles de péché. Ne permets pas que je entre dans le cycle éternel.`
};

MIROIR["55:45"] = {
