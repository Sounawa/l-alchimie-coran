  theme: ["Noé", "sauvetage", "mécréants"],
  emotion: "Gratitude, confiance",
  difficulty: "débutant",
  relatedNames: ["Nuh", "An-Najat"],
  mirrorVersion: `« Et Nous le sauvâmes, lui et sa famille, de la grande détresse. » Le miroir me montre le sauvetage de Noé. « Wa najjaynahu wa ahlahu mina al-karbi al-'azim » — Nous le sauvâmes, lui et sa famille, de la grande détresse. Le sauvetage vient après l'épreuve. Le miroir m'interroge : est-ce que j'attends le sauvetage d'Allah ?`,
  reflection: `Le sauvetage vient après la grande détresse. Patienter et faire confiance est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa najjaynahu wa ahlahu mina al-karbi al-'azim » — Nous le sauvâmes, lui et sa famille, de la grande détresse." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'attends le sauvetage d'Allah ? Ou est-ce que je désespère ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le sauvetage vient après l'épreuve." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah sauve les croyants de toute détresse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend le sauvetage d'Allah est sauvé." }
  ],
  munajat: `Ya Rabb, j'attends Ton sauvetage. Ne permets pas le désespoir. Sauve-moi de ma grande détresse.`
};

MIROIR["21:78"] = {
  reference: "21:78",
  theme: ["David", "Salomon", "jugement"],
  emotion: "Sagesse, justice",
  difficulty: "débutant",
  relatedNames: ["Dawud", "Sulayman", "Al-Hukm"],
  mirrorVersion: `« Et David et Salomon, quand ils jugèrent au sujet d'un champ. » Le miroir me montre le jugement des prophètes. « Wa Dawuda wa Sulaymana idh yahkumani fi harthin » — et David et Salomon, quand ils jugèrent au sujet d'un champ. La justice est la mission des prophètes. Le miroir m'interroge : est-ce que je suis juste dans mes jugements ?`,
  reflection: `David et Salomon ont jugé avec justice. Être juste dans ses jugements est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa Dawuda wa Sulaymana idh yahkumani fi harthin » — et David et Salomon, quand ils jugèrent au sujet d'un champ." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis juste dans mes jugements ? Ou est-ce que je faillis à la justice ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La justice est le fondement de la prophétie." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes sont des exemples de justice." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est juste dans ses jugements est proche d'Allah." }
  ],
  munajat: `Ya Hakam, aide-moi à être juste. Ne permets pas l'injustice. Guide-moi vers le jugement équitable.`
};

MIROIR["21:79"] = {
  reference: "21:79",
  theme: ["compréhension", "sagesse", "montagnes"],
  emotion: "Émerveillement, sagesse",
  difficulty: "débutant",
  relatedNames: ["Al-Fahm", "Al-Jibal"],
  mirrorVersion: `« Et Nous fîmes comprendre cela à Salomon. » Le miroir me montre la compréhension accordée. « Fa fahhamnaha Sulayman » — Nous fîmes comprendre cela à Salomon. « Wa kullan atayna hukman wa 'ilman » — et à tous deux Nous donnâmes le jugement et le savoir. La compréhension est un don. Le miroir m'interroge : est-ce que je demande la compréhension ?`,
  reflection: `La compréhension est un don d'Allah. La demander et l'utiliser sagement est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa fahhamnaha Sulayman wa kullan atayna hukman wa 'ilman » — Nous fîmes comprendre cela à Salomon. Et à tous deux Nous donnâmes le jugement et le savoir." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je demande la compréhension ? Ou est-ce que je reste dans la confusion ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La compréhension est la clé de la sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les prophètes reçoivent la compréhension divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui demande la compréhension la reçoit." }
  ],
  munajat: `Ya Rabb, donne-moi la compréhension. Ne permets pas la confusion. Illumine mon esprit par Ta sagesse.`
};

MIROIR["21:80"] = {
  reference: "21:80",
  theme: ["David", "armure", "protection"],
  emotion: "Gratitude, protection",
  difficulty: "débutant",
  relatedNames: ["Dawud", "Al-Labus"],
  mirrorVersion: `« Et Nous lui apprîmes la fabrication des cottes de mailles. » Le miroir me montre l'enseignement divin. « Wa 'allamnahu sana'a al-labus » — Nous lui apprîmes la fabrication des cottes de mailles. « Lakum tuhsinukum min basikum » — pour vous protéger de votre violence. La protection est un don. Le miroir m'interroge : est-ce que je remercie pour la protection ?`,
  reflection: `La protection est un don d'Allah. La chercher et la reconnaître est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa 'allamnahu sana'a al-labus lakum tuhsinukum min basikum » — Nous lui apprîmes la fabrication des cottes de mailles pour vous protéger de votre violence." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour la protection ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La protection vient d'Allah par Ses dons." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Allah enseigne aux prophètes ce qui protège les hommes." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la protection d'Allah est protégé." }
  ],
  munajat: `Ya Rabb, je remercie pour Ta protection. Ne permets pas l'ingratitude. Protège-moi de tout mal.`
};

MIROIR["21:81"] = {
  reference: "21:81",
  theme: ["Salomon", "vent", "soumission"],
  emotion: "Émerveillement, puissance",
  difficulty: "débutant",
  relatedNames: ["Sulayman", "Ar-Rih"],
  mirrorVersion: `« Et pour Salomon, le vent violent, qui souffle par Son ordre. » Le miroir me montre la soumission des éléments. « Wa li-Sulaymana al-riha 'asifatan tajri bi-amrihi » — et pour Salomon, le vent violent, qui souffle par Son ordre. Les éléments obéissent aux prophètes. Le miroir m'interroge : est-ce que je comprends la soumission des éléments ?`,
  reflection: `Les éléments obéissent aux prophètes par l'ordre d'Allah. Tout est soumis à Sa volonté.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-Sulaymana al-riha 'asifatan tajri bi-amrihi » — et pour Salomon, le vent violent, qui souffle par Son ordre." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je comprends la soumission des éléments ? Ou est-ce que je l'ignore ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Les éléments sont soumis à la volonté d'Allah." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers entier obéit au commandement d'Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui comprend la soumission universelle se soumet." }
  ],
  munajat: `Ya Rabb, je comprends la soumission des éléments. Ne permets pas l'aveuglement. Fais que je me soumette à Ta volonté.`
};

MIROIR["21:82"] = {
