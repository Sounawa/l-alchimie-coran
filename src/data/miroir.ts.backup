    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'ai avancé ? Qu'est-ce que j'ai retardé ? Le compte sera-t-il bon ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'annonce des œuvres motive la préparation." },
