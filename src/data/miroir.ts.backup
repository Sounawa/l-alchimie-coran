  theme: ["attente", "signes", "foi"],
  emotion: "Urgence, réalité",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Ayat", "Al-Iman"],
  mirrorVersion: `« Attendent-ils que les anges viennent à eux, ou que ton Seigneur vienne ? » Le miroir interroge : « Hal yanzuruna illa an ta'tiyahumu al-mala'ikatu aw ya'tiya rabbuka » — attendent-ils que les anges viennent à eux, ou que ton Seigneur vienne ? L'attente du miracle est un délai. Le miroir m'enseigne : la foi n'a pas besoin de voir.`,
  reflection: `La foi n'a pas besoin de voir. L'attente du miracle est un délai.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Hal yanzuruna illa an ta'tiyahumu al-mala'ikatu aw ya'tiya rabbuka » — attendent-ils que les anges viennent à eux, ou que ton Seigneur vienne ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'attends pour croire ? Le miracle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi avant le signe est la vraie foi." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les signes sont partout — il suffit d'ouvrir les yeux." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui attend le signe a déjà reçu le signe." }
  ],
  munajat: `Ya Rabb, je crois sans attendre le miracle. Fais que ma foi soit sincère. Ne permets pas que je retarde.`
};

