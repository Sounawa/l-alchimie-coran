    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'apprécie la diversité des provisions divines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le grain pour le corps, le parfum pour l'âme." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La terre produit nourriture et beauté." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui apprécie la provision reçoit plus." }
  ],
  munajat: `Ya Munbit, Tu fais pousser les grains et les parfums. Fais que j'apprécie chaque provision. Ne permets pas que j'oublie la Source.`
};

MIROIR["55:14"] = {
  reference: "55:14",
  theme: ["création", "argile", "origine"],
  emotion: "Humilité, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Bari"],
  mirrorVersion: `« Il a créé l'homme d'argile comme la poterie. » Le miroir me montre l'humble origine. « Khalaqa al-insana min salsalin ka-al-fakhkhar » — Il a créé l'homme d'argile comme la poterie. L'argile est humble, l'homme peut être orgueilleux. Le miroir m'invite à l'humilité.`,
  reflection: `L'argile modelée devient homme par le souffle divin. L'origine rappelle l'humilité nécessaire.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Khalaqa al-insana min salsalin ka-al-fakhkhar » — Il a créé l'homme d'argile comme la poterie." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je me souviens de mon origine d'argile ? Ou est-ce que je suis orgueilleux ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'argile devient noble par le Créateur, pas par elle-même." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La poterie est fragile, l'homme doit le rester dans son cœur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se souvient de l'argile reste humble." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé d'argile. Fais que je reste humble. Ne permets pas que l'orgueil s'installe là où l'argile devrait être.`
};

MIROIR["55:15"] = {
  reference: "55:15",
  theme: ["djinns", "feu", "création"],
  emotion: "Émerveillement, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Khaliq", "An-Nur"],
  mirrorVersion: `« Et Il a créé les djinns d'un feu sans fumée. » Le miroir me montre la création des djinns. « Wa khalaqa al-janna min marijin min nar » — et Il a créé les djinns d'un feu sans fumée. Les créations sont diverses. Le miroir m'invite à reconnaître la diversité créative.`,
  reflection: `Les djinns sont créés de feu, les hommes d'argile. La diversité des créations révèle la créativité divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa khalaqa al-janna min marijin min nar » — et Il a créé les djinns d'un feu sans fumée." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais la diversité des créations divines ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu pur et l'argile humble sont tous deux créations divines." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La création est diverse et merveilleuse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît la diversité reconnaît le Créateur." }
  ],
  munajat: `Ya Khaliq, Tu as créé les djinns de feu. Je reconnais Ta créativité infinie. Aide-moi à accepter ce que je ne vois pas.`
};

MIROIR["55:16"] = {
  reference: "55:16",
  theme: ["faveur", "question", "dénégation"],
  emotion: "Gratitude, interrogation",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mannan"],
  mirrorVersion: `« Lequel des bienfaits de votre Seigneur nierez-vous ? » Le miroir pose la question. « Fabi-ayyi ala'i rabbikuma tukadhdhiban » — lequel des bienfaits nierez-vous ? La question est posée aux deux mondes. Le miroir m'invite à compter les bienfaits.`,
  reflection: `La question se répète 31 fois. Chaque fois, elle demande une réponse : aucun.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabi-ayyi ala'i rabbikuma tukadhdhiban » — Lequel des bienfaits de votre Seigneur nierez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels bienfaits je nie par mon ingratitude ? La question m'est posée." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La négation du bienfait est un bienfait nié." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bienfaits sont innombrables, la gratitude est due." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond « aucun » reconnaît tous les bienfaits." }
  ],
  munajat: `Ya Mannan, je ne nie aucun de Tes bienfaits. Ouvre mes yeux pour les voir tous. Fais que ma gratitude soit proportionnée à Tes dons.`
};

MIROIR["55:17"] = {
  reference: "55:17",
  theme: ["orient", "occident", "maîtrise"],
  emotion: "Émerveillement, soumission",
  difficulty: "débutant",
  relatedNames: ["Al-Mashriq", "Al-Maghrib"],
  mirrorVersion: `« Seigneur des deux Orients et Seigneur des deux Occidents. » Le miroir me montre la maîtrise des directions. « Rabbu al-mashriqayni wa rabbu al-maghribayn » — Seigneur des deux Orients et deux Occidents. Les directions sont à Lui. Le miroir m'invite à reconnaître Sa maîtrise sur tout l'espace.`,
  reflection: `Les deux Orients et deux Occidents représentent toute l'étendue spatiale. Allah est Seigneur de tout.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Rabbu al-mashriqayni wa rabbu al-maghribayn » — Seigneur des deux Orients et Seigneur des deux Occidents." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Dans quelle direction je vais, Allah y est Seigneur. Est-ce que je Le reconnais partout ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Il n'y a pas de direction sans Seigneur." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le soleil se lève à l'orient et se couche à l'occident, tous deux soumis." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît le Seigneur des directions ne s'égare jamais." }
  ],
  munajat: `Ya Rabb, Tu es Seigneur de toutes les directions. Fais que je Te reconnaisse où que j'aille. Ne permets pas que je m'égare.`
};

MIROIR["55:18"] = {
  reference: "55:18",
  theme: ["faveur", "question", "répétition"],
  emotion: "Gratitude, interrogation",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mannan"],
  mirrorVersion: `« Lequel des bienfaits de votre Seigneur nierez-vous ? » Le miroir répète la question. « Fabi-ayyi ala'i rabbikuma tukadhdhiban » — la question revient. La répétition insiste. Le miroir m'invite à répondre à chaque mention d'un bienfait.`,
  reflection: `La répétition de la question souligne l'importance de la reconnaissance de chaque bienfait.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fabi-ayyi ala'i rabbikuma tukadhdhiban » — Lequel des bienfaits de votre Seigneur nierez-vous ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "La question revient. Ma réponse est-elle constante ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Chaque mention d'un bienfait est suivie de la question." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bienfaits sont continus, la gratitude doit l'être aussi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui répond à chaque question maintient la reconnaissance." }
  ],
  munajat: `Ya Mannan, je réponds : aucun. Fais que ma réponse soit constante. Ne permets pas que j'oublie même un instant.`
};

MIROIR["55:19"] = {
  reference: "55:19",
  theme: ["mers", "rencontre", "séparation"],
  emotion: "Émerveillement, sagesse",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Fasil", "Al-Hakim"],
  mirrorVersion: `« Il a fait confluer les deux mers. » Le miroir me montre la rencontre des eaux. « Maraja al-bahrayni yaltaqiyani » — Il a fait confluer les deux mers. Les eaux se rencontrent mais ne se mélangent pas. Le miroir m'invite à contempler les limites divines.`,
  reflection: `Les deux mers se rencontrent sans se mélanger. La frontière est divine.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Maraja al-bahrayni yaltaqiyani » — Il a fait confluer les deux mers." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles frontières dans ma vie sont divines ? Qu'est-ce qui ne doit pas se mélanger ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La rencontre sans mélange est une sagesse." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les océans ont des frontières invisibles." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les frontières divines ne les transgresse pas." }
  ],
  munajat: `Ya Fasil, Tu sépares ce qui doit l'être. Fais que je respecte les frontières. Ne permets pas que je mélange ce qui ne doit pas l'être.`
};

MIROIR["55:20"] = {
  reference: "55:20",
  theme: ["barrière", "limite", "protection"],
  emotion: "Émerveillement, respect",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Hajiz", "Al-Hafiz"],
  mirrorVersion: `« Entre elles, une barrière qu'elles ne dépassent pas. » Le miroir me montre la barrière. « Baynahuma barzakhun la yabghiyan » — entre elles, une barrière qu'elles ne dépassent pas. La limite est respectée. Le miroir m'invite à respecter les limites.`,
  reflection: `Les mers respectent la barrière divine. Les hommes devraient respecter les limites morales.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Baynahuma barzakhun la yabghiyan » — entre elles, une barrière qu'elles ne dépassent pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quelles barrières je dois respecter ? Est-ce que je les dépasse ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La barrière protège autant qu'elle sépare." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est fait de barrières qui protègent." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui respecte les barrières est protégé." }
  ],
  munajat: `Ya Hajiz, Tu places des barrières. Fais que je les respecte. Ne permets pas que je les dépasse par transgression.`
};

