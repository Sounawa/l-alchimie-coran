  theme: ["châtiment", "exemple", "vie"],
  emotion: "Terreur, justice",
  difficulty: "débutant",
  relatedNames: ["Al-'Adhab", "Al-Ibrah"],
  mirrorVersion: `« Allah le saisit du châtiment de l'au-delà et de celui d'ici-bas. » Le miroir me montre la justice divine. Pharaon est châtié ici-bas et dans l'au-delà. L'exemple est fait. Le miroir m'avertit : le châtiment est réel et double.`,
  reflection: `Pharaon est châtié ici-bas et dans l'au-delà. L'exemple est établi.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Fa-akhadhahu Allahu nakala al-akhirati wa al-ula » — Allah le saisit du châtiment de l'au-delà et de celui d'ici-bas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Le châtiment est double. Comment l'éviter ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La foi évite le châtiment double." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La justice divine est complète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui a la foi évite le double châtiment." }
  ],
  munajat: `Ya Rabb, je veux éviter le châtiment. Donne-moi la foi qui sauve. Ne permets pas que je sois châtié comme Pharaon.`
};

