    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je reçois le message ? Avec suspicion ou avec ouverture ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La liberté du message invite à la liberté de la réception." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le message universel est offert gratuitement à tous." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Le cœur libre reçoit le message libre." }
  ],
  munajat: `Ya Rabb, je reçois Ton message avec un cœur ouvert. Le Prophète ne demande rien. Je crois en sa sincérité.`
};

MIROIR["38:87"] = {
