    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui médite sur la dispersion comprend le pouvoir." }
  ],
  munajat: `Ya Rabb, les vents dispersent selon Ton ordre. Je médite sur Ta puissance.`
};

MIROIR["77:4"] = {
  reference: "77:4",
