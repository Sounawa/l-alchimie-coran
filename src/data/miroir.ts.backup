  theme: ["appel", "sagesse", "belle exhortation"],
  emotion: "Sagesse, bienveillance",
  difficulty: "débutant",
  relatedNames: ["Ad-Da'wah", "Al-Hikmah"],
  mirrorVersion: `« Appelle vers le chemin de ton Seigneur avec sagesse et belle exhortation. » Le miroir me montre la méthode de l'appel. « Udu ila sabili rabbika bi-al-hikmati wa al-maw'izati al-hasana » — appelle vers le chemin de ton Seigneur avec sagesse et belle exhortation. La méthode compte autant que le message. Le miroir m'interroge : est-ce que j'appelle avec sagesse ?`,
  reflection: `La méthode compte autant que le message. Appeler avec sagesse est essentiel.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Udu ila sabili rabbika bi-al-hikmati wa al-maw'izati al-hasana » — appelle vers le chemin de ton Seigneur avec sagesse et belle exhortation." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que j'appelle avec sagesse ? Ou est-ce que je suis brusque ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La sagesse dans l'appel attire les cœurs." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La meilleure méthode est celle du Prophète." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui appelle avec sagesse touche les cœurs." }
  ],
  munajat: `Ya Rabb, je veux appeler avec sagesse. Ne permets pas la brutalité. Donne-moi la bienveillance dans l'appel.`
};

MIROIR["16:128"] = {
