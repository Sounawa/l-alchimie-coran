  theme: ["nourriture", "modération", "beauté"],
  emotion: "Équilibre, guidance",
  difficulty: "débutant",
  relatedNames: ["Al-Ta'am", "Al-Wasat"],
  mirrorVersion: `« Mangez et buvez, mais ne gaspillez pas. » Le miroir enseigne : « Kulu wa-shrabu wa la tusrif » — mangez et buvez, mais ne gaspillez pas. La modération est ordonnée. Le miroir m'enseigne : le gaspillage est interdit.`,
  reflection: `La modération est ordonnée. Comment je mange et bois ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Kulu wa-shrabu wa la tusrif » — mangez et buvez, mais ne gaspillez pas." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Comment je mange ? Est-ce avec modération ou excès ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le gaspillage est le contraire de la gratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La modération est universelle — l'excès est condamné." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La modération dans la nourriture reflète la modération dans tout." }
  ],
  munajat: `Ya Rabb, apprends-moi la modération. Ne permets pas que je gaspille. Fais que je mange et boive avec gratitude.`
};

MIROIR["7:32"] = {
  reference: "7:32",
  theme: ["bienfaits", "interdiction", "jouissance"],
  emotion: "Liberté, gratitude",
  difficulty: "débutant",
  relatedNames: ["Al-Ni'am", "Al-Tayyibat"],
  mirrorVersion: `« Qui a interdit les parures d'Allah qu'Il a produites pour Ses serviteurs ? » Le miroir questionne : « Man harrama zinata-Allahi allati akhraja li-'ibadihi » — qui a interdit les parures d'Allah qu'Il a produites pour Ses serviteurs ? Les bienfaits sont licites. Le miroir m'enseigne : l'interdiction arbitraire est fausse.`,
  reflection: `Les bienfaits sont licites. Qui interdit ce qu'Allah a permis ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Man harrama zinata-Allahi allati akhraja li-'ibadihi » — qui a interdit les parures d'Allah qu'Il a produites pour Ses serviteurs ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'interdis à tort ? Quels bienfaits je refuse par fausse piété ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction des bienfaits est une ingratitude." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les bienfaits d'Allah sont pour tous — pas seulement pour certains." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La jouissance des bienfaits avec gratitude est une adoration." }
  ],
  munajat: `Ya Rabb, merci pour les bienfaits que Tu as permis. Fais que je les utilise avec gratitude. Ne permets pas que je les interdise à tort.`
};

MIROIR["7:33"] = {
  reference: "7:33",
  theme: ["interdits", "péchés", "injustice"],
  emotion: "Avertissement, limites",
  difficulty: "débutant",
  relatedNames: ["Al-Haram", "Al-Fawahish"],
  mirrorVersion: `« Dis : Mon Seigneur a interdit les turpitudes, apparentes ou cachées. » Le miroir avertit : « Qala innama harrama rabbi al-fawahisha ma zahara minha wa ma batana » — dis : mon Seigneur a interdit les turpitudes, apparentes ou cachées. Les péchés sont interdits. Le miroir m'enseigne : l'interdiction couvre le visible et le caché.`,
  reflection: `Les péchés sont interdits, visibles ou cachés. Quels péchés dois-je abandonner ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Qala innama harrama rabbi al-fawahisha ma zahara minha wa ma batana » — dis : mon Seigneur a interdit les turpitudes, apparentes ou cachées." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quels péchés apparents dois-je abandonner ? Quels péchés cachés dois-je avouer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'interdiction du caché montre qu'Allah voit tout." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Les interdits sont universels — personne n'est au-dessus de la loi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "L'évitement des interdits apparents et cachés est la clé de la pureté." }
  ],
  munajat: `Ya Rabb, Tu as interdit les turpitudes. Aide-moi à les éviter, apparentes et cachées. Purifie mon cœur de tout péché.`
};

MIROIR["7:34"] = {
  reference: "7:34",
  theme: ["communautés", "terme", "retard"],
  emotion: "Réalité, décret",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Umam", "Al-Ajal"],
  mirrorVersion: `« Pour chaque communauté, un terme est fixé. » Le miroir déclare : « Wa li-kulli ummatin ajal » — pour chaque communauté, un terme est fixé. Le terme est inévitable. Le miroir m'enseigne : personne ne peut avancer ni retarder le décret.`,
  reflection: `Le terme est inévitable. Suis-je prêt pour mon terme ?`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Wa li-kulli ummatin ajal » — pour chaque communauté, un terme est fixé." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Quel est mon terme ? Suis-je prêt à le rencontrer ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le terme fixé ne peut être ni avancé ni retardé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Chaque communauté a son terme — chaque individu a son terme." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "La conscience du terme mène à la préparation." }
  ],
  munajat: `Ya Rabb, mon terme est fixé. Prépare-moi à le rencontrer. Ne permets pas que je sois pris au dépourvu.`
};

