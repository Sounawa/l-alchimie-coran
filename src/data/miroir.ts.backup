    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La connaissance divine est protection pour les sincères." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Rien n'est caché à Allah." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se repent profite de la connaissance divine." }
  ],
  munajat: `Ya Mannan, Tu connais tout de moi. Fais que cette connaissance soit ma protection. Ne permets pas qu'elle soit mon accusation.`
