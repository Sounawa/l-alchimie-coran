  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Nahnu khalaqnakum falawla tusaddiqun » — C'est Nous qui vous avons créés. Pourquoi ne croiriez-vous pas ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je remercie pour ma création ? Ou est-ce que je l'oublie ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La création est un don. L'incrédulité est un refus du don." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout ce qui existe témoigne du Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît sa création reconnaît son Créateur." }
  ],
  munajat: `Ya Khaliq, Tu m'as créé. Fais que je reconnaisse ce don. Ne me laisse pas être ingrat envers ma propre existence.`
};

MIROIR["56:58"] = {
  reference: "56:58",
  theme: ["création", "semen", "miracle"],
  emotion: "Awe, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Musawwir"],
  mirrorVersion: `« Avez-vous vu ce que vous éjaculez ? » Le miroir m'interroge sur l'origine. « Afara'aytum ma tumnun » — avez-vous vu ce que vous émettez ? La question invite à l'observation.`,
  reflection: `L'être humain est créé d'une goutte de liquide insignifiant. Le miracle de la création.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Afara'aytum ma tumnun » — avez-vous vu ce que vous éjaculez ?" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je contemple ma propre origine ? Est-ce que je reconnais le miracle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Du petit vient le grand. De l'insignifiant vient le miraculeux." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute vie commence petite. La grandeur vient de la petitesse." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui contemple son origine comprend sa destination." }
  ],
  munajat: `Ya Musawwir, Tu formes la créature de la goutte. Fais que je contemple ce miracle. Donne-moi de reconnaître Ta puissance dans ma création.`
};

MIROIR["56:59"] = {
  reference: "56:59",
  theme: ["création", "auteur", "puissance"],
  emotion: "Awe, reconnaissance",
  difficulty: "débutant",
  relatedNames: ["Al-Khaliq", "Al-Qadir"],
  mirrorVersion: `« Est-ce vous qui le créez ou sommes-Nous les Créateurs ? » Le miroir me place devant l'évidence. « A-antum takhluqunahu am nahn al-khaliqun » — est-ce vous qui le créez ou sommes-Nous les Créateurs ?`,
  reflection: `La création de l'être humain n'est pas son œuvre mais l'œuvre d'Allah.`,
