    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "De quelle provision ai-je besoin ? Celle d'ici-bas ou celle de l'au-delà ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La provision éternelle vaut plus que la provision temporaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "La provision d'Allah est inépuisable pour toute la création." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reçoit la provision éternelle ne manque de rien." }
  ],
  munajat: `Ya Raziq, Ta provision ne s'épuise pas. Donne-moi de Ta provision éternelle. Comble-moi de Tes dons.`
};

MIROIR["38:55"] = {
