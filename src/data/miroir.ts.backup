    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je serai parmi les vertueux ? La coupe m'attend-elle ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La vertu mène à la coupe." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le Paradis est rempli de délices." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est vertueux goûte la coupe." }
  ],
  munajat: `Ya Rabb, fais que je sois parmi les vertueux. Donne-moi la coupe du Paradis.`
};

