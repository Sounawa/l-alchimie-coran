    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je reconnais que l'attention d'Allah est un bienfait ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Être ignoré serait pire que d'être jugé." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Toute créature compte pour le Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui reconnaît l'attention divine se prépare mieux." }
  ],
  munajat: `Ya Mannan, Ton attention est un bienfait. Fais que je la reconnaisse comme telle. Ne permets pas que je la craigne sans la reconnaître.`
};

MIROIR["55:33"] = {
  reference: "55:33",
  theme: ["ciel", "impossibilité", "puissance"],
  emotion: "Humilité, reconnaissance",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Muta'ali", "Al-Qawiyy"],
  mirrorVersion: `« Ô assemblée de djinns et d'hommes, si vous pouvez sortir des limites des cieux et de la terre, sortez ! » Le miroir me montre l'impossibilité. « Ya ma'shara al-janni wa al-insi ini istata'tum an tanfudu min aqtari al-samawati wa al-ardi fa-nfudu » — si vous pouvez sortir, sortez ! L'impossibilité est totale. Le miroir m'invite à l'humilité.`,
  reflection: `Nul ne peut échapper aux limites divines. La tentative est vaine. La soumission est la voie.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Ya ma'shara al-janni wa al-insi ini istata'tum an tanfudu min aqtari al-samawati wa al-ardi fa-nfudu » — Ô assemblée de djinns et d'hommes, si vous pouvez sortir des limites des cieux et de la terre, sortez !" },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Où est-ce que j'essaie de fuir ? Est-ce que je reconnais les limites ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'impossibilité de fuir est une miséricorde qui force le retour." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est une prison pour celui qui fuit, une maison pour celui qui reste." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte les limites les transforme en liberté." }
  ],
  munajat: `Ya Muta'ali, je ne peux pas Te fuir. Fais que je cesse de fuir. Transforme ma fuite en retour.`
};

MIROIR["55:34"] = {
  reference: "55:34",
  theme: ["pouvoir", "autorisation", "impossibilité"],
  emotion: "Humilité, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Sultan", "Al-Qadir"],
  mirrorVersion: `« Vous ne sortirez que si vous y êtes autorisés. » Le miroir me montre la condition. « La tanfuduna illa bi-sultan » — vous ne sortirez que si vous y êtes autorisés. L'autorisation est divine. Le miroir m'invite à demander l'autorisation.`,
  reflection: `Sortir des limites nécessite une autorisation divine que nul n'a.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« La tanfuduna illa bi-sultan » — vous ne sortirez que si vous y êtes autorisés." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que je fais sans autorisation ? Est-ce que je demande la permission ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "L'autorisation que nul n'a montre la toute-puissance divine." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Tout dans l'univers nécessite l'autorisation divine." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui accepte de rester avec autorisation reste librement." }
  ],
  munajat: `Ya Sultan, Tu détiens toute autorisation. Fais que j'accepte mes limites. Ne permets pas que j'essaie de les dépasser sans permission.`
};

MIROIR["55:35"] = {
  reference: "55:35",
  theme: ["feu", "flamme", "châtiment"],
  emotion: "Crainte, soumission",
  difficulty: "intermédiaire",
  relatedNames: ["Al-Jahim", "Al-Qahhar"],
  mirrorVersion: `« Seront lancés contre vous des flammes de feu et de fumée. » Le miroir me montre le châtiment des fuyards. « Yursalu 'alaykuma shuwazun min nar » — seront lancés contre vous des flammes de feu. La fuite attire le châtiment. Le miroir m'invite à ne pas fuir.`,
  reflection: `Essayer de fuir attire le châtiment. La soumission est la voie de la sécurité.`,
  tajalli: [
    { label: "La Forme", ar: "الأصل", color: "var(--gold)", text: "« Yursalu 'alaykuma shuwazun min nar » — seront lancés contre vous des flammes de feu." },
    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Qu'est-ce que j'essaie de fuir ? Le feu m'attend si je continue." },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "Le feu pour les fuyards, la paix pour les soumis." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "Le feu est un serviteur d'Allah, pas un ennemi." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui se soumet ne craint pas le feu." }
  ],
  munajat: `Ya Jahim, le feu attend les fuyards. Fais que je me soumette. Ne permets pas que je sois parmi ceux qui fuient et brûlent.`
};

MIROIR["55:36"] = {
  reference: "55:36",
  theme: ["faveur", "question", "répétition"],
  emotion: "Gratitude, interrogation",
  difficulty: "débutant",
  relatedNames: ["Ar-Rahman", "Al-Mannan"],
  mirrorVersion: `« Lequel des bienfaits de votre Seigneur nierez-vous ? » Le miroir répète la question. « Fabi-ayyi ala'i rabbikuma tukadhdhiban » — après la menace du feu. Le miroir m'invite à reconnaître que même la menace est bienfait.`,
