    { label: "Le Reflet", ar: "المرصاد", color: "var(--mirror)", text: "Est-ce que je suis prêt pour le cri ? Ou est-ce que je l'attends sans préparation ?" },
    { label: "L'Inversion", ar: "القلب", color: "var(--purple)", text: "La préparation pour le cri est nécessaire." },
    { label: "L'Universel", ar: "الكون", color: "#34d399", text: "L'univers est prêt pour le commandement de son Créateur." },
    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui est prêt pour le cri n'est pas surpris." }
  ],
  munajat: `Ya Rabb, je me prépare pour le cri. Ne permets pas que je l'attende sans préparation. Donne-moi la préparation complète.`
};

