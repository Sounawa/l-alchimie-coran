    { label: "Le Secret", ar: "السر", color: "#fb7185", text: "Celui qui fait confiance à Allah reçoit parfaitement." }
  ],
  munajat: `Ya Rabb, je fais confiance à Ta révélation. Apprends-moi la patience.`
};

MIROIR["75:17"] = {
